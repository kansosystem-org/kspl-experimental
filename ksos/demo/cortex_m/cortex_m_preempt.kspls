//< A demo of ARM Cortex-M pre-emptive scheduling
//<
//< The SysTick interrupt calls ksos_tick() at a fixed rate and forces tasks of the same priority
//< to switch on a time slice. Tasks A and B are endless loops that never yield, so under
//< cooperative scheduling A would hog the CPU and the others could never run. If both run
//< (g_ran_a/b set) and monitor wakes from its Task.delay and ends, pre-emption and the
//< timer-driven clock work. startup.S calls ksos_main on the PSP, and PendSV (switch.S) switches.
import "ksos/demo/common/semihost_console" as con
import "ksos/kernel/task" + { Task }

priv const monitor_wait: U64 = 20

$g_ran_a: I32 = 0
$g_ran_b: I32 = 0

$tcb_a: Task
$tcb_b: Task
$tcb_m: Task
$stack_a: U8[4096]
$stack_b: U8[4096]
$stack_m: U8[4096]
fn task_a(_arg: Void$@): Void //< a computing task that never yields
    for
        g_ran_a = 1

fn task_b(_arg: Void$@): Void
    for
        g_ran_b = 1
fn monitor(_arg: Void$@): Void //< the monitoring task
    //<
    //< It sleeps 20 ticks on Task.delay. Meanwhile SysTick forces A and B, which never yield, to
    //< switch, the clock advances and monitor wakes. That it wakes at all shows the pre-emptive
    //< tick works; it then checks that A and B both had the CPU, and ends QEMU.
    from: = task.current_tick()
    Task.delay(monitor_wait)
    con.puts("=== Kanso OS (Cortex-M) preemptive scheduling ===\n")
    con.check("monitor woke from its delay while A and B never yield",
        task.current_tick() - from >= monitor_wait)
    // Caution: **Check that both A and B ran too**: waking alone does not show the case where one
    // task hogs the CPU while only the clock advances (a gap in the round robin).
    con.check("task A got the CPU", g_ran_a == 1)
    con.check("task B got the CPU", g_ran_b == 1)
    con.print_summary("Cortex-M preemptive scheduling")
    con.exit()
// The bare-metal entry, called on the PSP from startup.S.
#export
fn ksos_main()
    // The monitor is registered first, so a scheduler that takes the table's order instead of
    // turning round still wakes it at the top of the table: it then reports the task left out,
    // rather than the run hanging behind A.
    tcb_m.create(U8$[]::stack_m, monitor, null, 1, "m")
    tcb_a.create(U8$[]::stack_a, task_a, null, 1, "a")
    tcb_b.create(U8$[]::stack_b, task_b, null, 1, "b")
    // Start SysTick (the first interrupt comes one reload period later, after the scheduler
    // starts).
    task.enable_preemption(50000)
    task.start_scheduler()
    for {}

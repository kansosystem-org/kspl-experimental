//< ARM Cortex-M: unlocking a mutex inside an interrupt handler panics
//< An ISR holds no mutex, but the interrupted task may. Allowed, the handler's unlock would release
//< that task's mutex behind its back, and mutual exclusion would lapse with no diagnosis. The task
//< here locks a mutex and raises IRQ0 from software (setting it pending in the NVIC), and the
//< handler unlocks. Success is the panic, so panic_hook matches the message and prints the summary.
import "ksos/demo/common/semihost_console" as con
import "ksos/drivers/cortex_m/scs"
import "ksos/kernel/sync"
import "ksos/kernel/task" + { Task }
import "std/chars"

const IRQ0: U32 = 0 //< the interrupt raised: no hardware of either QEMU board raises it here
const EXPECTED: U8[] = "ksos: task-only call inside an ISR"

$g_mutex: sync.Mutex
$tcb: Task
$stack: U8[1024]

fn on_panic(msg: U8$[]) //< Check that the panic message is the kernel's refusal, and end
    con.puts("PANIC: ")
    con.puts(msg)
    con.puts("\n")
    con.check("an unlock inside an ISR stops with the kernel's panic",
        msg.starts_with(EXPECTED))
    con.print_summary("Cortex-M ISR unlock")
    con.exit()

// IRQ0's handler (#export overrides the vector table's weak default, the same wiring as the mps2
// UART driver). Unlocking here is the misuse; returning from it is a failure.
#export
fn uart0_irq0_handler()
    g_mutex.unlock()
    con.check("unlock inside the ISR returned instead of stopping", false)
    con.print_summary("Cortex-M ISR unlock")
    con.exit()

fn trigger(_arg: Void$@): Void
    con.puts("=== Kanso OS (Cortex-M) unlocking inside an ISR ===\n")
    g_mutex.lock() // the interrupted task holds it, so only the ISR check can stop the unlock
    scs.enable_irq(IRQ0)
    scs.set_pending(IRQ0) // the core enters IRQ0 within a few instructions
    for {}

#export
fn ksos_main()
    panic_hook = on_panic
    g_mutex.init()
    tcb.create(U8$[]::stack, trigger, null, 1, "trig")
    task.start_scheduler()
    for {}

//< ARM Cortex-M: waiting with a timeout under pre-emption
//<
//< POSIX's `ksos-timeout` tests the path where tickless idle moves the clock forward. This tests
//< the opposite: **a spinner that never yields holds the CPU**, so SysTick's ticks alone carry the
//< timeout: 1. `take_for(5)` on a semaphore nobody gives returns false after 5 or more ticks (the
//< spinner keeps running, so nothing else moves the clock forward). 2. When the low-priority giver
//< gives after 3 ticks, `take_for(100)` returns true without waiting out the timeout.
import "ksos/demo/common/semihost_console" as con
import "ksos/kernel/sync"
import "ksos/kernel/task" + { Task }

$g_sem: sync.Sem

$tcb_co: Task
$tcb_spin: Task
$tcb_giver: Task
$stack_co: U8[4096]
$stack_spin: U8[4096]
$stack_giver: U8[4096]

priv const give_after: U64 = 3
priv const long_deadline: U64 = 100

fn spinner(_arg: Void$@): Void //< Never lets go of the CPU (SysTick does the switching)
  for {}

fn giver(_arg: Void$@): Void //<
  //< Runs at the spinner's priority, waits for SysTick to switch to it, then gives
  Task.delay(give_after)
  g_sem.give()

fn coordinator(_arg: Void$@): Void //< High-priority waiter with a timeout; checks both results
  con.puts("=== Kanso OS (Cortex-M) timeout under preemption ===\n")
  before1: = task.current_tick()
  got1: = g_sem.take_for(5)
  waited1: = task.current_tick() - before1
  con.check("take_for(5) gives up with false while a spinner holds the CPU", !got1)
  con.check("the deadline was carried by at least 5 SysTick ticks", waited1 >= 5)

  tcb_giver.create(U8$[]::stack_giver, giver, null, 1, "giver")
  before2: = task.current_tick()
  got2: = g_sem.take_for(long_deadline)
  waited2: = task.current_tick() - before2
  con.check("take_for(100) returns true once the giver gives", got2)
  con.check("it returned before the deadline", waited2 < long_deadline)

  con.print_summary("Cortex-M timeout")
  con.exit()

#export
fn ksos_main()
  g_sem.init(0)
  // coordinator has the higher priority (2), so it runs first and blocks with a timeout.
  tcb_co.create(U8$[]::stack_co, coordinator, null, 2, "co")
  tcb_spin.create(U8$[]::stack_spin, spinner, null, 1, "spin")
  // SysTick's reload value: any value that causes pre-emption will do.
  task.enable_preemption(50000)
  task.start_scheduler()
  // The spinner never yields, so start_scheduler() never returns (coordinator calls con.exit()).
  for {}

//< ARM Cortex-M (mps2-an385) bare metal: a probe showing an interrupt-driven UART0 RX echo
//<
//< What it verifies: the task waits for each byte in `getc`, blocked on a semaphore the RX
//< interrupt gives. Meanwhile the scheduler sleeps on WFI with nothing else to run. There is no
//< busy-polling fallback. So if the NVIC/ISR does not work, the wait never ends and the run hangs.
//< It reads a whole line before echoing any of it. So the bytes that arrive meanwhile queue in
//< the driver's ring rather than overwrite each other.
import "ksos/demo/common/semihost_console" as con
import "ksos/drivers/mps2/uart_irq" as uart
import "ksos/kernel/task" + { Task }
import "std/chars" // slicing the line

$tcb_probe: Task
$stack_probe: U8[4096]

priv const line_max: Sz = 32 //< the longest line it keeps (`tests/uart_probe.py irq` sends less)
$line: U8[line_max]

fn uart_irq_echo_task(_arg: Void$@): Void
    con.puts("[semihosting] Kanso OS UART0 interrupt-driven RX echo probe starting...\n")

    uart.init()
    con.puts("[IRQ] waiting for a line in getc (the scheduler sleeps on WFI; hangs forever\n")
    con.puts("[IRQ] here if NVIC/ISR is not actually wired correctly)...\n")

    $n: Sz = 0
    $got_newline: = false
    for n < line_max
        c: = uart.getc()
        line[n] = c
        n += 1
        if c == '\n'
            got_newline = true
            break

    con.out().s("[IRQ] received \{n\} bytes (ISR fire count: \{uart.irq_count()\})\n")
    con.puts("[IRQ] echoing them back...\n")
    $echoed: = true
    uart.puts((U8[]::line).sub(0, n)) catch
        con.puts("[IRQ] UART0 putc() timed out\n")
        echoed = false

    con.puts("[semihosting] UART0 interrupt-driven RX echo probe done.\n")
    // The bytes themselves are matched outside (`tests/uart_probe.py`), which holds the verdict the
    // gate reads; these say what the probe saw from its side.
    con.check("the line ended in a newline within the buffer", got_newline)
    con.check("the bytes came in through the RX interrupt", uart.irq_count() > 0)
    con.check("the handler took every byte the task read", uart.received() == U32::n)
    con.check("no byte was dropped for want of room", uart.dropped() == 0)
    con.check("it went back out", echoed)
    con.print_summary("UART0 RX interrupt echo, the probe's side")
// The bare-metal entry called from startup.S.
#export
fn ksos_main()
    task.run_single_task(tcb_probe@, U8$[]::stack_probe, uart_irq_echo_task, "uart-irq", con.exit)

//< ARM Cortex-M: a waiting call inside an interrupt handler panics, even where it need not wait
//< It panics rather than silently stopping another task.
//< An ISR has no task to switch to, so a `take` inside a handler would block the interrupted task
//< instead (a failure with no diagnosis). The kernel checks the IPSR and stops at once. **The
//< semaphore holds a count**, so this `take` would not wait. A check made only on the way to
//< waiting would let it through. The misuse would then surface only on the day the count is 0. The
//< demo raises IRQ0 from software (setting it pending in the NVIC) and calls `Sem.take` in its
//< handler. Success is the panic, so panic_hook matches the message and prints the summary.
import "ksos/demo/common/semihost_console" as con
import "ksos/drivers/cortex_m/scs"
import "ksos/kernel/sync"
import "ksos/kernel/task" + { Task }
import "std/chars"

const IRQ0: U32 = 0 //< the interrupt raised: no hardware of either QEMU board raises it here
const EXPECTED: U8[] = "ksos: task-only call inside an ISR"

$g_sem: sync.Sem
$tcb: Task
$stack: U8[1024]

fn on_panic(msg: U8$[]) //< Check that the panic message is the kernel's refusal, and end
    con.puts("PANIC: ")
    con.puts(msg)
    con.puts("\n")
    con.check("a take inside an ISR stops with the kernel's panic, though a count is there",
        msg.starts_with(EXPECTED))
    con.print_summary("Cortex-M ISR block")
    con.exit()

// IRQ0's handler (#export overrides the vector table's weak default). A waiting call here is the
// misuse; returning from it is a failure.
#export
fn uart0_irq0_handler()
    g_sem.take()
    con.check("take inside the ISR returned instead of stopping", false)
    con.print_summary("Cortex-M ISR block")
    con.exit()

fn trigger(_arg: Void$@): Void
    con.puts("=== Kanso OS (Cortex-M) blocking inside an ISR ===\n")
    scs.enable_irq(IRQ0)
    scs.set_pending(IRQ0) // the core enters IRQ0 within a few instructions
    for {}

#export
fn ksos_main()
    panic_hook = on_panic
    g_sem.init(1) // available: only the ISR check can stop the take
    tcb.create(U8$[]::stack, trigger, null, 1, "trig")
    task.start_scheduler()
    for {}

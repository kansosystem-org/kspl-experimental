//< A probe showing that the freestanding heap really works on Cortex-M bare metal
//<
//< It runs under QEMU (mps2-an385). It runs the free-list allocator of `std/mem.kspl` through
//< `ksos/kernel/heap.kspl` (the counterpart of `pvPortMalloc`, safe from a task and an ISR by
//< irq_save/irq_restore). It runs `Arc<T>` on top of it. It makes and deletes tasks on it
//< (`ksos/kernel/dynamic.kspl`) far more times than the port has contexts.
import "ksos/demo/common/semihost_console" as con
import "ksos/kernel/dynamic" as dyn
import "ksos/kernel/heap"
import "ksos/kernel/task" + { Task }
import "std/mem" { Arena, heap_used_bytes }
import "std/refcount" { Arc }

$heap_buf: U8[8192]
// Caution: Do not make it a local. Cortex-M's stack is small.
$arena_buf: U8[1024]

// 7's tasks: each round makes one of each way a task ends. Suppose one of them fails to return a
// context or a slot. The port's 33 contexts then run out within a dozen rounds.
priv const churn_rounds: I32 = 40
priv const churn_stack: Sz = 1024
priv const churn_low: I32 = 1 // below the coordinator's 2: it never runs before its delete
priv const churn_high: I32 = 3 // above it: it runs inside create_dyn
$churn_made: I32 = 0
$churn_ran: I32 = 0
$tcb_churn: Task
$stack_churn: U8[4096]

fn churn_never(_arg: Void$@): Void //<
    //< deleted by the coordinator before it runs; running is a fault
    churn_ran += 1000
fn churn_self(_arg: Void$@): Void //< deletes itself, inside its create_dyn; the next one reaps it
    churn_ran += 1
    Task.current().delete_dyn()
fn churn_return(_arg: Void$@): Void //< returns from its entry; the coordinator deletes it then
    churn_ran += 1

fn churn_coord(_arg: Void$@): Void
    for $i: I32 = 0; i < churn_rounds; i += 1
        switch Task.create_dyn(churn_never, null, churn_low, "never", churn_stack)
        case .some(t)
            churn_made += 1
            t.delete_dyn()
        case .none {}
        switch Task.create_dyn(churn_self, null, churn_high, "self", churn_stack)
        case .some
            churn_made += 1
        case .none {}
        switch Task.create_dyn(churn_return, null, churn_high, "return", churn_stack)
        case .some(t)
            churn_made += 1
            t.delete_dyn()
        case .none {}

#export
fn ksos_main()
    con.puts("=== Cortex-M freestanding heap probe ===\n")
    heap.heap_init(U8$[]::heap_buf)

    // 1. The basics: separate blocks must point at independent regions.
    p1: = heap.heap_alloc(64)
    p2: = heap.heap_alloc(128)
    p3: = heap.heap_alloc(32)
    (U8$@::p1)$ = 0xAAU8
    (U8$@::p2)$ = 0xBBU8
    (U8$@::p3)$ = 0xCCU8
    con.check("basic alloc independence",
        (U8$@::p1)$ == 0xAAU8 && (U8$@::p2)$ == 0xBBU8 && (U8$@::p3)$ == 0xCCU8)

    // 2. A freed block must be reused by a later allocation of the same size.
    // Take the address before freeing; a freed p2 cannot be read.
    p2_addr: = p2
    heap.heap_free(p2)
    p4: = heap.heap_alloc(128)
    con.check("freed block reused by same-size alloc", p4 == p2_addr)
    heap.heap_free(p4)

    // 3. Adjacent free blocks must be merged when freed, so their total can be allocated again as
    //    a single block.
    heap.heap_free(p1)
    heap.heap_free(p3)
    big: = heap.heap_alloc(64 + 128 + 32)
    con.check("adjacent free blocks coalesce into one", big != null)
    heap.heap_free(big)

    // 4. The heap must survive many random-ish alloc/free rounds (the canaries stay intact).
    $stress_ptrs: Void$@[8] = ::{}
    $seed: U32 = 12345U32
    $stress_ok: = true
    for $round: I32 = 0; round < 200; round += 1
        seed = seed * 1103515245U32 + 12345U32
        slot: = Sz::(seed >> 16) % 8
        existing: = stress_ptrs[slot]
        if existing != null
            if (U8$@::existing)$ != U8::(slot + 1)
                stress_ok = false
            heap.heap_free(existing)
            stress_ptrs[slot] = null
        else
            sz: = 8 + Sz::((seed >> 8) % 200)
            np: = heap.heap_alloc(sz)
            (U8$@::np)$ = U8::(slot + 1)
            stress_ptrs[slot] = np
    for p in Void$@[]::stress_ptrs
        if p != null
            heap.heap_free(p)
    con.check("200-round randomized alloc/dealloc stress", stress_ok)

    // 5. Arc<T>: kspl_atomic_add/cas must link and work freestanding, and new/clone/get/release must
    //    not crash or hang. The release is the automatic one at the block's exit, the path real code
    //    takes (retain/release by hand would double the compiler's).
    release_on_exit:
        $a: = Arc<|I32|>.new(42)
        $b: = a.clone()
        con.check("Arc<T> new/clone/get", a.get()$ == 42 && b.get()$ == 42)

    // 6. The allocated region must be 8-byte aligned.
    // **It only breaks on a 32-bit target** (F64 / I64 / U64 need 8 under AAPCS). On 64-bit, the
    // header is already a multiple of 8, so no hosted test catches it.
    $align_ok: = true
    for i in Range.asc(8)
        q: = heap.heap_alloc(1 + i * 3)
        if Sz::q % 8 != 0
            align_ok = false
        heap.heap_free(q)
    con.check("heap_alloc returns 8-byte aligned blocks", align_ok)

    // The arena too (arena_chunk_header_size in std/mem.kspl is rounded up to 8).
    $ar: = Arena.from_buffer(Void$@::arena_buf@, 1024)
    $arena_align_ok: = true
    for i in Range.asc(8)
        a: = ar.alloc(1 + i * 3)
        if Sz::a % 8 != 0
            arena_align_ok = false
    con.check("Arena.alloc returns 8-byte aligned blocks", arena_align_ok)

    // Caution: **The returned addresses must be aligned even when the buffer's start is not.**
    // .bss's layout can put `arena_buf` at an odd address. An alignment fault then hangs in the
    // default handler without printing any mark.
    $ar_odd: = Arena.from_buffer(Void$@::((arena_buf@) + 1), 1023)
    $odd_align_ok: = true
    for i in Range.asc(8)
        a: = ar_odd.alloc(1 + i * 3)
        if a == null || Sz::a % 8 != 0
            odd_align_ok = false
    con.check("Arena.from_buffer aligns an unaligned buffer", odd_align_ok)

    // 7. Dynamic tasks ended every way (deleted by another, deleting itself, returning) give back
    //    their context, slot, Task and stack. A context kept would make a later create hand out
    //    none, and the first switch to that task would fault.
    used_before: = heap_used_bytes()
    tcb_churn.create(U8$[]::stack_churn, churn_coord, null, 2, "churn")
    task.start_scheduler() // returns once churn_coord has returned
    dyn.reap_pending() // the last self-deleted task waits for this
    con.check("120 create_dyn / delete_dyn against 33 contexts all succeed",
        churn_made == 3 * churn_rounds)
    con.check("each churned task ran exactly as its kind should", churn_ran == 2 * churn_rounds)
    con.check("every churned Task and stack went back to the heap",
        heap_used_bytes() == used_before)

    con.print_summary("heap probe done")
    con.exit()
    for {}

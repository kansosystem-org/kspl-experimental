//< The smallest ARM Cortex-M bare-metal demo
//< It prints through ARM semihosting (QEMU -semihosting) and does not depend on std/io. It runs the
//< same kernel core as the POSIX demos (ksos/kernel/task.kspl) unchanged on the Cortex-M port. It
//< checks cooperative scheduling with priority, Task.delay (tickless idle) and Task.yield. Run it
//< under QEMU to verify it: mps2-an385 for the Cortex-M3, microbit for the Cortex-M0.
//<
//< **The order the tasks run in is the check.** B is registered before A. So a scheduler that took
//< the table's order instead of the priority runs B first. A delay that returned at once lets A
//< run its three rounds in a row. A task that never ran leaves its rounds out.
import "ksos/demo/common/semihost_console" as con
import "ksos/kernel/task" + { Task }

$tcb_a: Task
$tcb_b: Task
$stack_a: U8[1024]
$stack_b: U8[1024]

// Each round appends its task's digit (A = 1, B = 2), so the order the rounds ran in is one number.
$g_trace: U32 = 0
$g_rounds: I32 = 0
$g_a_ticks: U64[3] // the tick each of A's rounds ran at
$g_a_done: Bool = false
$g_b_done: Bool = false

fn round(who: U32)
    g_trace = g_trace * 10 + who
    g_rounds += 1

fn task_a(_arg: Void$@): Void
    for $i: I32 = 0; i < 3; i += 1
        con.puts("[A] run\n")
        g_a_ticks[i] = task.current_tick()
        round(1)
        Task.delay(1) // sleep one tick: it blocks and yields to B
    con.puts("[A] done\n")
    g_a_done = true

fn task_b(_arg: Void$@): Void
    for $i: I32 = 0; i < 3; i += 1
        con.puts("[B] run\n")
        round(2)
        Task.yield() // yield explicitly (cooperative: nothing else takes the CPU from B)
    con.puts("[B] done\n")
    g_b_done = true
// The bare-metal entry called from startup.S.
#export
fn ksos_main()
    con.puts("=== Kanso OS (Cortex-M / QEMU) ===\n")
    // A has priority 2 and B 1, registered in the other order. A runs first and blocks on the
    // delay. B, the only task ready, runs all its rounds meanwhile (its yields find nobody else).
    // Then the clock moves on to A's wake-ups.
    tcb_b.create(U8$[]::stack_b, task_b, null, 1, "b")
    tcb_a.create(U8$[]::stack_a, task_a, null, 2, "a")
    task.start_scheduler()
    con.puts("=== scheduler finished ===\n")
    con.check("both tasks ran to their end", g_a_done && g_b_done)
    con.check("they ran A, B, B, B, A, A: priority first, B alone while A sleeps",
        g_rounds == 6 && g_trace == 122211)
    con.check("each of A's delays lasted one tick (rounds at ticks 0, 1, 2)",
        g_a_ticks[0] == 0 && g_a_ticks[1] == 1 && g_a_ticks[2] == 2)
    con.print_summary("cooperative scheduler")
    con.exit() // end QEMU
    for {}

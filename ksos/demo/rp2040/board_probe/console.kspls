//< USB CDC's send queue (stage 2b in ksos/docs/HOWTO-bring-up.md)
//<
//< **Queue all three lines, then send them.**
//< The output **keeps flowing** as the sign of life (rather than appearing once and stopping).
//<   [1][3] … short lines that fit one packet; it checks that the order holds
//<   [2]    … a line over 64 bytes, sent split; reaching the `<END` at its end shows that the split
//<            and the PID alternation are right. Lines 2 and 3 are queued while line 1 is sent.
import "ksos/demo/rp2040/common/bringup" as boot
import "ksos/drivers/rp2040/usb_cdc" as usb

const line_interval_ms: U32 = 500 //<
  //< The interval between lines, and how many times they are sent
  //<
  //< Any faster and the Serial Monitor cannot be read.
const repeats: U32 = 4

fn run()
  for _i in Range.asc(Sz::repeats)
    // write only queues; poll_once inside pump does the actual sending, one packet at a time. It
    // returns false when the queue is full, but a dropped line is simply written again next round,
    // so nothing is resent here (not flooding the queue comes first).
    _a: = usb.write("ksos: [1] hello from RP2040 over USB CDC\r\n")
    _b: = usb
      .write("ksos: [2] \
        START>0123456789012345678901234567890123456789012345678901234567890123456789<END\r\n")
    _c: = usb.write("ksos: [3] hello from RP2040 over USB CDC\r\n")
    boot.pump(line_interval_ms)

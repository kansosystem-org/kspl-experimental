//< Keeps what the car must remember across a power cut
//< The policy that was handed out, into and out of the record on the board (ksdb).
//< **The record kinds' numbers are set here and nowhere else.** Assigned in two places, one number
//< would get a second meaning, and what the previous start-up wrote would be read as another type.
//< **Every one of them is on the "keep running even if it cannot be saved" side.** When the
//< record is full or a write fails, neither driving nor deciding stops. The caller shows in the
//< report how many times it could save.
import "ksdb/log" as ksdblog
import "ksos/demo/rp2040/common/console" as con
import "ksos/demo/rp2040/common/records"
import "ksos/demo/rp2040/common/sample" as csample

const KIND_POLICY: U16 = 1 //< the record kinds
    //< 0 is the marker, so it is not used (`records.KIND_MARKER`).
const KIND_SAMPLE: U16 = 2

fn wipe(marker: U8[], blob: U8[]): Bool //<
    //< Erases the record, and writes back only the marker and the policy
    //< **true if they were written back.**
    //< Caution: **Do not erase the policy too.** It is in the same region. A naive erase leaves
    //< the car unable to move at all on the next start-up with no PC there. **The observations do
    //< go.**
    if !records.ok()
        return false
    lg: = records.handle()
    lg.reset() catch
        return false
    // The observations are gone, so the recorder starts again, whatever the write-back does.
    csample.restart()
    lg.append(records.KIND_MARKER, marker) catch
        return false
    if blob.len == 0
        return true
    lg.append(KIND_POLICY, blob) catch
        return false
    return true

fn save_policy(ln: con.Line$@, blob: U8[]) //< saves the downloaded policy
    //< **If it is the same one, it is not rewritten.** The record only appends, so a rewrite uses
    //< up that much room. One file is 2KB, so writing every time fills it in a few dozen
    //< start-ups.
    if !records.ok()
        return
    lg: = records.handle()
    if lg.last_equals(KIND_POLICY, blob)
        con.say(ln, "[car]", "policy unchanged — kept the stored one")
        return
    lg.append(KIND_POLICY, blob) catch e
        // Print the reason too. Full (expected) and a failed write (something wrong with the
        // region) are different things.
        ln.reset()
        ln.str("[car] FAILED to store the policy: ")
        ln.str(e.variant_name())
        _sent: = ln.flush()
        return
    con.say(ln, "[car]", "policy stored on board")

fn stored_policy(buf: U8$[]): U8[]!ksdblog.Ksdb_error //<
    //< Reads the policy saved in the record into `buf`, and returns its body
    //< `not_found` where none is stored or the record is not open. **`too_small` where the one
    //< stored is larger than `buf`.** That is not "none": it was saved, and cannot be read here.
    //< **The result is a slice pointing into `buf`.** The policy's weights point straight into it
    //< (see load in ksos/demo/common/pilot_policy.kspl), so leave `buf` alone while it runs.
    if !records.ok()
        throw .not_found
    n: = records.handle().last(KIND_POLICY, buf)!
    return U8[]::{ .ptr = buf.ptr, .len = n }

//< The car **downloads a policy once, closes the link and decides for itself**
//< The car is the Freenove 4WD mecanum one (Pico W); the steps are stage 7 in
//< `ksos/docs/HOWTO-bring-up.md`.

// ==========================================
// "What the self-driving probe does, and where its judgement lives" in ksos/docs/DESIGN-rtos.md
// gives what it does each round. It gives the three safety timeouts decided outside the policy.
// It says where its decisions live, and what the PC needs first.
// ==========================================

// Caution: **Test it with the wheels off the ground.** Nobody drives it, and a hand is too slow
// to catch a wrong start.

// How to use it: `make ksos-rp2040-car-pilot` → copy the UF2 with BOOTSEL → Serial Monitor
// (115200).
import "ksdb/log" as ksdblog
import "ksos/boards/freenove_4wd_pico/board"
import "ksos/boards/freenove_4wd_pico/motor"
import "ksos/boards/freenove_4wd_pico/range"
import "ksos/boards/freenove_4wd_pico/status"
import "ksos/boards/freenove_4wd_pico/track"
import "ksos/demo/common/pilot_policy" as policy
import "ksos/demo/rp2040/common/battery"
import "ksos/demo/rp2040/common/bringup" as boot
import "ksos/demo/rp2040/common/console" as con
import "ksos/demo/rp2040/common/net_client" as nc
import "ksos/demo/rp2040/common/pilot_boot"
import "ksos/demo/rp2040/common/records"
import "ksos/demo/rp2040/common/sample" as csample
import "ksos/demo/rp2040/common/store"
import "ksos/drivers/rp2040/ir_nec" as ir
import "ksos/drivers/rp2040/timer"
import "ksos/drivers/rp2040/usb_cdc" as usb
import "ksos/drivers/rp2040/watchdog"
import "ksos/kernel/task" + { Task }
import "std/mem" { Arena }

$tcb_car: Task
// The task stack for the driving loop.
$stack_car: U8[2560]

// The policy's body, and the working space for one round.
// **Once the policy is loaded, do not reset to before it.** The weights point straight into the
// copy of the body (zero copy).
$arena_buf: U8[24576]

const RECORD_MARKER: U8[] = "car1" //< the marker that identifies this writer
    //< Caution: **Give it a different name from the other firmwares.** They share the region, and
    //< with the same name each reads another's record as its own (a different marker erases it
    //< once).
const SAMPLE_EVERY: U32 = 50 //<
    //< How many rounds between saving one observation
    //< A round where the manoeuvre changed is always saved as well. **Not every round**: at 16
    //< bytes per 100ms round, 64KB lasts minutes; changes plus a heartbeat last hours.

// --- the safety timeouts for stopping remotely / not running too long ---
const IR_REARM_ROUNDS: U32 = 8 //<
    //< How long a press must be held to re-arm the car [rounds]
    //< **These three are outside the policy**: like the battery and point-blank range, the car
    //< decides them alone, with no link.
    //< Caution: **Only a held press may re-arm it**; a brief press would set it off in the hand
    //< picking it up. A repeat comes about every 108ms, one per round (8 rounds ≈ 0.8s held).
const IR_RELEASE_ROUNDS: U32 = 3 //< how many rounds with no frame count as released
    //< Longer than the repeat interval (108ms), or a gap in a held press restarts the count.

const IR_DUMP_ROUNDS: U32 = 25 //< how long a press must be held to dump the record [rounds]
    //< **Make it longer than re-arming**, the everyday action (about three times). **Do not read it
    //< as seconds** — a round stretches by up to 70ms while it receives an IR frame.
const IR_WIPE_ROUNDS: U32 = 60 //< how long a press must be held to erase the record [rounds]
    //< **Make it longer than dumping**, since erasing cannot be undone. **It is decided by the
    //< press's length at release**, so it cannot trigger dumping partway (`watch_remote`).
// The limit on driving [rounds]; 0 is unlimited. **The only stop that works while nobody is
// watching** (IR needs line of sight). A held press re-arms it.
const MAX_DRIVING_ROUNDS: U32 = 600 // 60 seconds at a 100ms period

const CONSOLE_TIMEOUT_MS: U32 = 8000 //< the limit on waiting for the console to become usable
    //< Caution: **Wait before the very first line.** A `write` before USB is configured drops the
    //< line uncounted (not in `tx_dropped`). Keep it finite — with no USB it never gets configured.

const LOOP_INTERVAL_MS: U32 = 100 //< the control period [ms]
    //< The ultrasonic measurement takes up to 36ms, so keep this well above that.
const LINE_INTERVAL_MS: U32 = 10 //<
    //< The interval for reading only the line partway through a round and steering again [ms]
    //< **Two or more reads while turning across the line**, or the crossing goes unnoticed.
    //< **Make it divide loop_interval_ms** — otherwise the remainder goes unsteered.
const EMERGENCY_MM: U32 = 100 //<
    //< The distance at which it backs off, before the policy's decision [mm]

const WATCHDOG_MS: U32 = 1000 //< how long the loop may go without feeding the watchdog [ms]
    //< **Longer than the longest step between two feeds**: a lap (100ms, stretched by IR frames
    //< and a report line to about 300ms) and one Flash sector erase (at most 400ms). **Short enough
    //< to stop quickly**: at the speed cap the car rolls well under a metre in a second. The
    //< reasons are in "The watchdog (`watchdog.kspl`)" in ksos/docs/DESIGN-rtos.md.
const HANG_AFTER_ROUNDS: U32 = 0 //< a test build's forced hang: the loop stops after this many
    //< driving rounds; 0 is never
    //< **Only for the on-car check of the watchdog** (stage 7 in ksos/docs/HOWTO-bring-up.md).
    //< Caution: **Build with it at 0 for every other use**: set, the car stops answering on
    //< purpose.

// Set once anything has failed; it stays stopped from then on.
$halted: Bool = false
// Why it is stopped. **The text and the colour are `status`'s** alone.
$halt_state: status.State = .driving

// Whether only the remote can bring it back from this stop.
// Caution: **Keep it apart from the battery**, whose way back is the switch, not a held press.
// Running out of time also counts here.
$halt_needs_remote: Bool = false
// Whether an IR frame was received this round (`pump_watch` sets it, `watch_remote` clears it).
$ir_seen_in_round: Bool = false
// How many rounds frames came in a row, and how many since they stopped (a held press).
$ir_hold: U32 = 0
$ir_quiet_rounds: U32 = 0
// Whether the button was seen released after the stop. **Re-arming counts only after that**, or
// the finger that stopped it would set it off.
$ir_released: Bool = false
// The running total of frames received, showing that reception works.
$ir_frames: U32 = 0
// The last command received. A repeat does not update it (a repeat carries no cmd).
$last_ir_cmd: U32 = 0
// How many rounds since it set off.
$driving_rounds: U32 = 0

// Whether a dump of the record was requested; **the loop dumps, not the watch** (it takes seconds).
$dump_requested: Bool = false
// Whether erasing the record was requested (the loop does it, as with dumping).
$wipe_requested: Bool = false
// The body of the policy in force (the link's copy or a slice into the record). **Kept to write it
// back when the record is erased**, or a start-up with no PC cannot move.
$policy_bytes: U8[] = ""

// The running totals for the Serial Monitor.
$loops: U32 = 0
$decisions: U32 = 0
$emergencies: U32 = 0
// How many times the line moved partway through a round and it steered again.
// Caution: **Count it apart from `decisions`**, or the report cannot show the quick steering.
$steers: U32 = 0

// The observation the latest **decision used**.
// **Do not read it again at reporting time**, or one line mixes a later observation with another
// round's manoeuvre.
$last_dist: U32 = 0
$last_line: U32 = 0

// The latest manoeuvre decided, and the time deciding took [us].
// Caution: **Print the decision time.** Deciding in the car is worth it only within the period,
// and only a measurement shows that (24 SiLUs in soft float).
$last_lon: I32 = 0
$last_lat: I32 = 0
$last_rot: I32 = 0
$last_decide_us: U32 = 0
// Who issued the latest command.
// Caution: **Set it only inside `apply`**, with the triple, or the record names a wrong source.
$last_by: csample.Author = .safety

priv fn apply(lon: I32, lat: I32, rot: I32, by: csample.Author) //<
    //< The only function that sends a command to the wheels
    //< It records the capped value, the command actually sent, and its source together, so they
    //< never come from different rounds.
    d: = motor.divisor(lon, lat, rot)
    last_lon = lon * motor.CAP / d
    last_lat = lat * motor.CAP / d
    last_rot = rot * motor.CAP / d
    last_by = by
    motor.drive(last_lon, last_lat, last_rot)

priv fn halt(why: status.State) //< stops from then on
    //< **It does not resume by itself**; setting off unasked is worse than staying stopped. Only
    //< the battery's minimum (halt_battery / watch_battery) and the remote have a way back.
    halted = true
    halt_state = why
    // A stop here is always a safety one; the policy's own "stop" is one_round's 0,0,0.
    apply(0, 0, 0, .safety)

priv fn halt_battery() //< stops at the battery's minimum
    //< **This one resumes when a person turns the switch off and on** (watch_battery;
    //< `common/battery.kspl` records the voltage and the flag).
    halt(.battery)

priv fn watch_battery(ln: con.Line$@): Bool //<
    //< Checks the battery for one round and returns whether a decision may be made this round
    //< **The rules are `common/battery.kspl`'s**; only how this car stops and resets the budget is
    //< here.
    //< Caution: **Call it while stopped too** (the reason is at `battery.Watch.look`).
    $may: = false
    switch battery.watch.look(halted)
    case .go
        may = true
    case .low
        halt_battery()
    case .back
        halted = false
        // Caution: Reset the driving-time budget too, or it runs out of time again at once.
        driving_rounds = 0
        con.say(ln, "[car]", battery.BACK_NOTE)
    default {}
    return may

priv fn halt_remote(why: status.State) //< stops from the remote
    //< Caution: **Restart the held-press count**, or the finger that stopped it re-arms it without
    //< a release being seen.
    halt_needs_remote = true
    ir_hold = 0
    // A stop with no press (running out of time) waits for no release; a press's caller clears it.
    ir_released = true
    halt(why)

priv fn watch_remote(ln: con.Line$@): Bool //<
    //< Checks the remote's stop and returns whether a decision may be made this round
    //< Caution: **Call it while stopped too**, or it misses the held press, the only way back.
    //< **While it runs any button stops it** (a repeat carries no cmd to tell them apart).
    seen: = ir_seen_in_round
    ir_seen_in_round = false
    if seen
        ir_quiet_rounds = 0
        ir_hold += 1
        if !halted
            halt_remote(.remote)
            // **The press that stopped it does not count towards re-arming**; counting restarts
            // after a release.
            ir_released = false
            return false
        return false
    ir_quiet_rounds += 1
    if ir_quiet_rounds != IR_RELEASE_ROUNDS
        return !halted // neither released, nor the moment of release
    // --- the moment the button is released. Re-arming is decided here and only here ---
    //
    // Caution: **It must not resume while the button is held.** The finger's next frames hit "any
    // button stops it", and it "resumed but does not run".
    held: = ir_hold
    ir_hold = 0
    if !halted || !halt_needs_remote
        return !halted
    if !ir_released
        ir_released = true // the press that stopped it was released; no resuming here
        return false
    // **Check the longer press first**, or a long press would trigger re-arming. Dumping does not
    // lift the stop.
    if held >= IR_WIPE_ROUNDS
        wipe_requested = true
        return false
    if held >= IR_DUMP_ROUNDS
        dump_requested = true
        return false
    if held < IR_REARM_ROUNDS
        return false // a short press does not bring it back
    halted = false
    halt_needs_remote = false
    // Caution: Reset the driving-time budget too (the reason is in `watch_battery`).
    driving_rounds = 0
    con.say(ln, "[car]", "remote re-armed — deciding again")
    return false // this round is skipped (from the next round it runs as usual)

priv fn watch_run_time(): Bool //<
    //< Checks the driving-time limit and returns whether a decision may be made this round
    //< **The only stop that works while nobody is watching**; a held press re-arms it.
    if halted
        return false
    driving_rounds += 1
    if MAX_DRIVING_ROUNDS > 0 && driving_rounds >= MAX_DRIVING_ROUNDS
        halt_remote(.time_limit)
        return false
    return true

priv fn pump_watch(ms: U32) //< waits while running USB, checking IR as well
    //< Caution: **Check IR on a 1ms tick**; once per 100ms period misses a NEC frame's start
    //< (67.5ms). While receiving, the driver holds the CPU for up to 70ms and USB waits; only
    //< output is delayed.
    for $i: U32 = 0; i < ms; i += 1
        boot.pump(1)
        f: = ir.try_receive(board.IR_RECEIVER)
        if f.ok
            ir_frames += 1
            ir_seen_in_round = true
            if !f.repeat
                last_ir_cmd = f.cmd

priv fn one_round(p: policy.Policy$@, arena: Arena$@) //< runs one round
    //< Caution: **Whichever path it takes, set the wheels' state at the end**, or the last command
    //< keeps running when nothing was decided.
    raw: = range.read_mm()
    // **Update the median every round**, including the early return below.
    steady: = range.steady_mm(raw)
    line: = track.read_bits()
    last_line = line

    // Point-blank range is decided here, not by a learned function. **On the raw reading**: the
    // median notices an approach a round or two late, and a false alarm is on the safe side.
    if raw > 0 && raw < EMERGENCY_MM
        last_dist = raw
        emergencies += 1
        apply(-45, 0, 0, .safety)
        return

    last_dist = steady
    t0: = timer.now_us()
    d: = policy.decide(p, steady, line, arena)
    last_decide_us = timer.elapsed_us(t0)
    apply(d.lon, d.lat, d.rot, .policy)
    decisions += 1

priv fn track_while_pumping(p: policy.Policy$@, arena: Arena$@, driving: Bool) //<
    //< Spends one round's waiting time running USB and IR
    //< **The ultrasonic is not read again** (too slow for `LINE_INTERVAL_MS`). **A round it may not
    //< drive on is left alone**, or steering would overwrite the command that stopped it.
    mark: = arena.save()
    $waited: U32 = 0
    for waited + LINE_INTERVAL_MS <= LOOP_INTERVAL_MS
        pump_watch(LINE_INTERVAL_MS)
        waited += LINE_INTERVAL_MS
        if !driving || (last_dist > 0 && last_dist < EMERGENCY_MM)
            continue
        line: = track.read_bits()
        if line == last_line
            continue // if the line has not moved, the same observation gives the same manoeuvre
        last_line = line
        t0: = timer.now_us()
        d: = policy.decide(p, last_dist, line, arena)
        last_decide_us = timer.elapsed_us(t0)
        apply(d.lon, d.lat, d.rot, .policy)
        arena.restore(mark)
        steers += 1
    // Caution: Wait out the remainder too, or the period shrinks and the round limit comes early.
    if waited < LOOP_INTERVAL_MS
        pump_watch(LOOP_INTERVAL_MS - waited)

priv fn report(ln: con.Line$@) //< prints one line
    //< Not every round, or USB's send queue drops lines. One line describes **one moment**: the
    //< values the latest decision used.
    dist: = last_dist
    line: = last_line
    mv: = battery.watch.last_mv
    ln.reset()
    ln.str("car t=")
    ln.u32(loops)
    ln.str(" dist=")
    if dist == 0
        ln.str("----")
    else
        ln.u32_pad(dist, 4)
        ln.str("mm")
    ln.str(" line=")
    ln.u32(line)
    ln.str(" bat=")
    ln.u32_milli(mv)
    // No manoeuvre name: that would copy the PC side's table.
    ln.str("V drive=(")
    ln.i32(last_lon)
    ln.str(",")
    ln.i32(last_lat)
    ln.str(",")
    ln.i32(last_rot)
    ln.str(") n=")
    ln.u32(decisions)
    ln.str(" trk=")
    ln.u32(steers)
    ln.str(" us=")
    ln.u32(last_decide_us)
    ln.str(" emerg=")
    ln.u32(emergencies)
    ln.str(" drop=")
    ln.u32(usb.tx_dropped())
    ln.str(" ir=")
    ln.u32(ir_frames)
    ln.str(" run=")
    ln.u32(driving_rounds)
    ln.str(" rec=")
    ln.u32(csample.count())
    if csample.stopped().len > 0
        ln.str("(stopped: ")
        ln.str(csample.stopped())
        ln.str(")")
    if halted
        battery.watch.halt_note(ln, halt_state.text())
    _sent: = ln.flush()

priv fn take_policy( //< loads blob as the policy in force; true if it loaded
    //< **It does not halt**: a refused fresh policy still leaves the stored one to try, so the
    //< caller decides.
    ln: con.Line$@,
    p: policy.Policy$@,
    blob: U8[],
    which: U8[], //< "fresh" or "stored", named on the refusal's line
    arena: Arena$@,
): Bool
    mark: = arena.save()
    $took: = true
    p$ = policy.load(blob, arena) catch e
        // **Print which policy and which check refused it.** Each check has its own cause: a file
        // that is not safetensors, another version, a shape.
        ln.reset()
        ln.str("[car] ")
        ln.str(which)
        ln.str(" policy refused: ")
        ln.str(e.variant_name())
        _sent: = ln.flush()
        took = false
        fallback policy.empty()
    if !took
        // What the refused one left on the arena goes, so the next one has the room.
        arena.restore(mark)
        return false
    policy_bytes = blob
    return true

priv fn decide_once(p: policy.Policy$@, arena: Arena$@) //< makes one decision and throws it away
    //< **Run it before saving a fresh policy.** A file that loads but stops the program at its
    //< first decision is then never saved, so the next start still has the stored one.
    mark: = arena.save()
    _first: = policy.decide(p, 0I64, 0I64, arena)
    arena.restore(mark)

priv fn stop_wheels(_msg: U8$[]) //< the panic hook: the wheels stop before the program does
    //< Caution: **A freestanding panic loops for ever, and the PWM keeps its last duty.** With no
    //< hook a panic while driving leaves the car running with nothing deciding.
    //< An index out of range or a division by zero stops in the runtime without calling this
    //< hook. So `policy.load` still has to refuse every file that could cause one.
    motor.stop()

priv fn say_restart(ln: con.Line$@, why: watchdog.Reset_reason) //<
    //< Says on the console why the chip started, and the panic left by the run before, if any
    //< **A watchdog restart is the only trace of a hang**: the run that hung could print nothing.
    if why == watchdog.Reset_reason.watchdog
        con.say(ln, "[car]", "restarted by the watchdog: the program had stopped answering")
    else if why == watchdog.Reset_reason.other
        con.say(ln, "[car]", "restarted by a reboot (boot ROM or debugger)")
    switch take_panic_record()
    case .some(info)
        ln.reset()
        ln.str("[car] the run before panicked: ")
        ln.str(info.msg)
        _sent: = ln.flush()
    case .none {}

fn car_task(_arg: Void$@): Void
    // Read why it started **before arming**, which leaves the mark again. **Stop a watchdog left
    // running first**: start-up takes far longer than its timeout, and nothing feeds it yet.
    started_by: = watchdog.last_reset()
    watchdog.disarm()
    if !pilot_boot.bring_up()
        return
    // From here the motors are set up, so stopping them in a panic is safe.
    panic_hook = stop_wheels
    $ln: = con.Line()
    abuf: = U8$[]::arena_buf
    $arena: = Arena.from_buffer(Void$@::abuf.ptr, abuf.len)
    $p: policy.Policy = policy.empty()
    $ready: = false

    // **Wait for the console to become usable** first: a line before that is lost (`Line.flush` in
    // `ksos/demo/rp2040/common/console`). **Run even if the record cannot be opened.**
    // Caution: But limit the wait — on battery alone it never gets configured, and it would never
    // set off.
    $console_wait: U32 = 0
    for !usb.is_configured() && console_wait < CONSOLE_TIMEOUT_MS
        boot.pump(100)
        console_wait += 100
        // **Keep it lit through the wait** (seconds on battery).
        status.State.starting.show(false)

    say_restart(ln@, started_by)
    if !records.claim(RECORD_MARKER)
        con.say(ln@, "[car]", "no on-board records (flash region unavailable)")
    else if records.wiped()
        con.say(ln@, "[car]", "records erased (first use, or another firmware was here)")
    else
        csample.say_last(ln@, store.KIND_SAMPLE)

    // What halts it if no policy can be used: the PC's was refused, the stored one was, or there
    // is none.
    $why_none: status.State = .no_policy
    if pilot_boot.connect(ln@)
        blob: = pilot_boot.fetch_policy(ln@, arena@)
        // Caution: Read it to the end before closing (the reason is at nc.drain_stream).
        _rest: = nc.drain_stream(pilot_boot.FETCH_IDLE_MS)
        nc.close_conn()
        if blob.len > 0
            ready = take_policy(ln@, p@, blob, "fresh", arena@)
            if ready
                decide_once(p@, arena@)
                store.save_policy(ln@, blob)
                con.say(ln@, "[car]", "using the fresh policy")
            else
                why_none = .bad_policy

    // With no usable fresh policy it starts with the saved one: **the point of the record**,
    // deciding with no link or kssrv. **A refused fresh one falls back to it too**; the saved one
    // was taken by an earlier start, and stopping would gain nothing.
    // Caution: **Read the record only after a refusal or no download.** It is read into the buffer
    // the fresh policy's weights point into (`pilot_boot.stored_policy`).
    if !ready
        // One stored but larger than the buffer is a bad stored policy, not "no policy".
        kept: = pilot_boot.stored_policy() catch e
            if e == ksdblog.Ksdb_error.too_small
                con.say(ln@, "[car]", "stored policy refused: larger than its buffer")
                if why_none == status.State.no_policy
                    why_none = .bad_stored_policy
            fallback ""
        if kept.len > 0
            ready = take_policy(ln@, p@, kept, "stored", arena@)
            if ready && why_none == status.State.bad_policy
                con.say(ln@, "[car]", "fresh policy refused — using the one stored on board")
            else if ready
                con.say(ln@, "[car]", "no fresh policy — using the one stored on board")
            else if why_none == status.State.no_policy
                why_none = .bad_stored_policy
    if !ready
        halt(why_none)
    else if started_by == watchdog.Reset_reason.watchdog
        // **It does not set off again by itself after a hang**: whatever hung may hang again, and a
        // car that restarts and drives in fits is worse than one that waits. A held press brings
        // it back.
        halt_remote(.watchdog)

    if ready
        // No exchange with the PC from here on: driving with no link is what this stage claims.
        con.say(ln@, "[car]", "policy on board, link closed — deciding here from now on")
    else
        con.say(ln@, "[car]", "no policy — staying put")
    // After the policy: resetting to before here loses what the weights point at.
    work: = arena.save()

    // **Armed only here, where the wheels can first turn.** Start-up (the console, the link and
    // the download) waits up to tens of seconds, past the watchdog's longest timeout, while the
    // wheels stay stopped. The motor stop is what the watchdog is for.
    watchdog.arm(WATCHDOG_MS) catch
        con.say(ln@, "[car]", "FAILED to arm the watchdog")

    // It does not return; the lines **that keep flowing** are the sign of life.
    for
        // **Fed once per lap, here in the loop**, not from an interrupt or a timer, which keep
        // running while the loop is stuck. The record's steps feed too (`records`).
        watchdog.feed()
        loops += 1
        // Caution: **Call all three every round, stopped too**, or a way back goes unnoticed.
        // **If any one is false it does not drive.**
        may_battery: = watch_battery(ln@)
        may_remote: = watch_remote(ln@)
        may_time: = watch_run_time()

        // **Dump outside the watch**; its seconds would drop the stop signal meanwhile.
        if dump_requested
            dump_requested = false
            csample.dump(ln@, store.KIND_SAMPLE)
        if wipe_requested
            wipe_requested = false
            if store.wipe(RECORD_MARKER, policy_bytes)
                con.say(ln@, "[car]", "records erased — the policy was written back")
            else
                con.say(ln@, "[car]", "FAILED to erase the records")
        driving: = ready && may_battery && may_remote && may_time
        if driving
            prev_lon: = last_lon
            prev_lat: = last_lat
            prev_rot: = last_rot
            one_round(p@, arena@)
            arena.restore(work)
            if HANG_AFTER_ROUNDS > 0 && driving_rounds >= HANG_AFTER_ROUNDS
                for {} // the forced hang of a test build; the watchdog must reset the chip
            // Caution: **Always save a round that changed**, or the change itself goes missing.
            changed: = last_lon != prev_lon || last_lat != prev_lat || last_rot != prev_rot
            if changed || loops % SAMPLE_EVERY == 0
                // **Save it after the command is on the wheels** (interrupts stop during the
                // write), with the decision's observation and command together.
                csample.append(store.KIND_SAMPLE,
                    csample.Sample::{
                    .dist_mm = last_dist,
                    .bat_mv = battery.watch.last_mv,
                    .line = last_line,
                    .lon = last_lon,
                    .lat = last_lat,
                    .rot = last_rot,
                    .by = last_by,
                })
        // One line every 10 rounds.
        // **Do not read the sensors again here**, or dist/line and drive come from different
        // moments.
        if loops % 10 == 0
            report(ln@)
        // **Show it every round**: the blinking is the evidence that the loop runs.
        (status.State.driving if !halted else halt_state).show(last_by == csample.Author.safety)
        // Keep running USB, or the host detaches it and the Serial Monitor dies. **IR is checked in
        // here too** (pump_watch).
        track_while_pumping(p@, arena@, driving)

// The on_idle for `task.run_single_task`: semihosting's exit is not available, so it does nothing.
priv fn park() {}

#export
fn ksos_main()
    task.run_single_task(tcb_car@, U8$[]::stack_car, car_task, "car", park)

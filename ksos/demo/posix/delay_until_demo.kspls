//< Keeping a periodic task from drifting with Task.delay_until
//<
//< In a loop of "wake, work, sleep a relative time", Task.delay (a relative time) makes the cycle
//< drift late by the work's duration. With Task.delay_until (an absolute tick) the caller keeps the
//< next absolute time, so the cycle does not drift even when the work's duration varies each round.
//< This matters where the cycle must be exact, such as a physical AI control loop.
import "ksos/kernel/task" + { Task }
import "std/io"

const period: U64 = 10
// A different mock work time each cycle (all under period, so every deadline is met).
$work_ticks: I32[5] = ::{ 1, 4, 0, 7, 2 }

$tcb: Task
$stack: U8[65536]

fn periodic(_arg: Void$@): Void
  io.out().s("=== Kanso OS (POSIX) task_delay_until drift-free periodic task ===\n")
  $next: U64 = task.current_tick()
  for wt in I32[]::work_ticks
    next += period
    // The mock work, of varying length. It uses Task.delay, but the time it takes does not move
    // the caller's next (Task.delay_until absorbs it).
    Task.delay(U64::wt)
    woke_at: = task.current_tick()
    io.out().s("[periodic] work done at tick \{I32::woke_at\}, sleeping until \{I32::next\}\n")
    Task.delay_until(next)
    actual: = task.current_tick()
    io.out().s("[periodic] woke at tick \{I32::actual\} (expected \{I32::next\})\n")
    assert(actual == next, "task_delay_until: drift detected")
  io.out().s("[periodic] all 5 periods landed exactly on schedule -> OK\n")
  io.out().s("=== done ===\n")

fn main()
  tcb.create(U8$[]::stack, periodic, null, 1, "periodic")
  task.start_scheduler()
  io.out().s("=== scheduler finished (all tasks done) ===\n")

//< A priority lent through one mutex outlives the release of another
//<
//< low holds two mutexes at once, and a higher-priority task waits on each. Releasing either one
//< must leave low at the highest priority still waiting on the one it keeps, whatever the order
//< of the releases, and only the last release returns it to its own priority.

// ==========================================
//   Round 1, the inner one first: low holds m1 and m2, high (5) waits on m1 and mid (3) on m2.
//     Releasing m2 keeps 5 (high still waits on m1); releasing m1 returns 1.
//   Round 2, the outer one first: the same waits, released the other way round.
//     Releasing m1 drops to 3 (mid still waits on m2), not to 1; releasing m2 returns 1.
// ==========================================
import "ksos/demo/common/task_end"
import "ksos/kernel/sync"
import "ksos/kernel/task" + { Task }
import "std/verdict"

priv const low_prio: I32 = 1
priv const mid_prio: I32 = 3
priv const high_prio: I32 = 5

$g_m1: sync.Mutex
$g_m2: sync.Mutex

$tcb_low: Task
$tcb_mid: Task
$tcb_high: Task
$tcb_mid2: Task
$tcb_high2: Task
$stack_low: U8[65536]
$stack_mid: U8[65536]
$stack_high: U8[65536]
$stack_mid2: U8[65536]
$stack_high2: U8[65536]

fn wait_m1(arg: Void$@): Void //< waits on m1 from the tick given, and lets it go once it has it
    Task.delay_until((U64$@::arg)$)
    g_m1.lock()
    g_m1.unlock()
fn wait_m2(arg: Void$@): Void //< waits on m2 from the tick given, and lets it go once it has it
    Task.delay_until((U64$@::arg)$)
    g_m2.lock()
    g_m2.unlock()
// The ticks the waiters start on: round 1's at 1, round 2's at 3 (low holds both by then).
$g_round1: U64 = 1
$g_round2: U64 = 3

fn low(_arg: Void$@): Void
    // --- Round 1 ---
    verdict.start("[ksos] the inner unlock keeps a priority lent through the outer mutex")
    g_m1.lock()
    g_m2.lock()
    Task.delay_until(2) // high and mid start waiting at tick 1
    assert(tcb_low.get_prio() == high_prio, "mutex_nested: high's wait did not lend its priority")
    g_m2.unlock()
    assert(tcb_low.get_prio() == high_prio,
        "mutex_nested: releasing m2 dropped the priority high lends through m1")
    g_m1.unlock()
    assert(tcb_low.get_prio() == low_prio, "mutex_nested: the last release kept a lent priority")
    verdict.pass("releasing m2 keeps 5 while high waits on m1; releasing m1 returns 1.")

    // --- Round 2 ---
    verdict.start("[ksos] the outer unlock drops to the priority still lent through the inner one")
    g_m1.lock()
    g_m2.lock()
    Task.delay_until(4) // high2 and mid2 start waiting at tick 3
    assert(tcb_low.get_prio() == high_prio, "mutex_nested: high2's wait did not lend its priority")
    g_m1.unlock()
    assert(tcb_low.get_prio() == mid_prio,
        "mutex_nested: releasing m1 did not fall to the priority mid lends through m2")
    g_m2.unlock()
    assert(tcb_low.get_prio() == low_prio, "mutex_nested: the last release kept a lent priority")
    verdict
        .pass("releasing m1 first falls to 3 while mid waits on m2, not to 1; releasing m2 returns \
            1.")

fn main(): I32
    g_m1.init()
    g_m2.init()
    tcb_low.create(U8$[]::stack_low, low, null, low_prio, "low")
    tcb_high.create(U8$[]::stack_high, wait_m1, Void$@::g_round1@, high_prio, "high")
    tcb_mid.create(U8$[]::stack_mid, wait_m2, Void$@::g_round1@, mid_prio, "mid")
    tcb_high2.create(U8$[]::stack_high2, wait_m1, Void$@::g_round2@, high_prio, "high2")
    tcb_mid2.create(U8$[]::stack_mid2, wait_m2, Void$@::g_round2@, mid_prio, "mid2")
    task.start_scheduler()
    task_end.require_all_ended()
    return verdict.finish()

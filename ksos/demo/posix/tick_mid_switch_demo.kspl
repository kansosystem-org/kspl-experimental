//< A tick that lands while the kernel switches into a task waits for the switch's end
//<
//< A tick handled mid-switch finds the next task already counted as current. Its own switch then
//< saves the wrong state as that task's context, and the task never runs its own code. The demo
//< makes that moment happen two ways.
//< * **Held ticks**: one is raised inside a critical section. The kernel then switches into a task
//<   that has never run. That task takes the tick and must still run its own code.
//< * **A live tick on each start**: a tick every few microseconds while `start_scheduler` runs over
//<   and over. So some tick lands between its choice of the first task and the switch into it.

// ==========================================
//   start     main switches into the first task (start_scheduler) with a tick held.
//   yield     the second task yields into the third, which has never run, with a tick held.
//   restart   main starts the scheduler many times over under a fast tick, with no critical
//             section of its own.
// The timer is set too slow to fire during the first two, so every tick there is one raised here.
// ==========================================
import "ksos/kernel/task" + { Task }
import "std/sys"
import "std/verdict"

const sigalrm: I32 = 14 // assumes Linux, as the POSIX port does

// The starts the third case makes. A start_scheduler that lets a tick into its gap breaks within
// the first thousand or so; a passing run takes about a second.
const restarts: I32 = 20000

$g_ran: I32[3]
$g_restart_ran: I32[2]

$tcb_1: Task
$tcb_2: Task
$tcb_3: Task
$stack_1: U8[65536]
$stack_2: U8[65536]
$stack_3: U8[65536]

fn first(_arg: Void$@): Void //< the task main's start_scheduler switches into with a tick held
    g_ran[0] = 1

fn second(_arg: Void$@): Void //< switches into third, which has never run, with a tick held
    s: = task.irq_save()
    sys.raise_signal(sigalrm)
    Task.yield()
    task.irq_restore(s)
    g_ran[1] = 1

fn third(_arg: Void$@): Void
    g_ran[2] = 1

fn restart_a(_arg: Void$@): Void
    g_restart_ran[0] += 1

fn restart_b(_arg: Void$@): Void
    g_restart_ran[1] += 1

fn held_ticks() //< the start and the yield, each with a tick held over its switch
    tcb_1.create(U8$[]::stack_1, first, null, 1, "first")
    tcb_2.create(U8$[]::stack_2, second, null, 1, "second")
    tcb_3.create(U8$[]::stack_3, third, null, 1, "third")
    // It installs the tick's handler; at 1000 s the timer never fires during the run.
    task.enable_preemption(1000000000)
    s: = task.irq_save()
    sys.raise_signal(sigalrm)
    task.start_scheduler() // returns once every task is done
    task.irq_restore(s)
    assert(g_ran[0] == 1, "tick_mid_switch: the task started with a tick held never ran its code")
    assert(g_ran[1] == 1, "tick_mid_switch: the task that yielded with a tick held never resumed")
    assert(g_ran[2] == 1, "tick_mid_switch: the task yielded into with a tick held never ran")
    assert(task.current_tick() == 2, "tick_mid_switch: each held tick must arrive exactly once")
    tcb_1.delete()
    tcb_2.delete()
    tcb_3.delete()

fn live_tick_restarts() //< start_scheduler called many times over under a tick every 30 us
    task.enable_preemption(30)
    $n: I32 = 0
    for n < restarts
        tcb_1.create(U8$[]::stack_1, restart_a, null, 1, "restart a")
        tcb_2.create(U8$[]::stack_2, restart_b, null, 1, "restart b")
        task.start_scheduler()
        tcb_1.delete()
        tcb_2.delete()
        n += 1
        assert(g_restart_ran[0] == n && g_restart_ran[1] == n,
            "tick_mid_switch: a task started under a live tick never ran its code")

fn main(): I32
    verdict.start("[ksos] a tick landing in a switch into a task waits for the switch's end")
    held_ticks()
    live_tick_restarts()
    verdict
        .pass("every task ran its code, each held tick arrived once after its switch, and every \
            start under a live tick ran both tasks.")
    return verdict.finish()

//< The scheduler sleeping while every task waits on an interrupt, and waking with it
//<
//< Three tasks block on a semaphore that only an interrupt handler gives (SIGUSR1, raised from
//< outside by a child process half a second later). The scheduler must neither return then, which
//< no handler could undo, nor spin: it sleeps until the signal, and the woken tasks run. "Did not
//< spin" is measured as the process's CPU time over that half second. The second round does the
//< same with the idle task on, which must sleep too; it never ends, so the last task stops the
//< scheduler (`task.stop_scheduler`).
import "ksos/kernel/sync"
import "ksos/kernel/task" + { Task }
import "std/io"
import "std/libc"
import "std/subproc"
import "std/sys"
import "std/verdict"

extern "C"
    fn clock(): I64 //< the process's CPU time, in CLOCKS_PER_SEC units (10^6 on POSIX)

const SIGUSR1: I32 = 10 // assumes Linux (30 on macOS/BSD; this demo only runs on a POSIX host)
const WAITERS: I32 = 3
const RAISE_AFTER_MS: I64 = 500 //< how long the child waits before raising the interrupt
    //<
    //< Keep `RAISE_AFTER` below in step: the child's shell takes it in seconds.
const RAISE_AFTER: U8[] = "sleep 0.5; kill -USR1 $PPID"

$g_sem: sync.Sem
$g_irqs: I32 = 0
$g_blocked_at_irq: I32 = 0 // how many waiters the handler found blocked
$g_woken: I32 = 0
$g_wall_start: I64 = 0
$g_cpu_start: I64 = 0
$g_wall_waited: I64 = 0 // µs from before the child started to the first wake
$g_cpu_used: I64 = 0 // µs of this process's CPU time over the same stretch
$g_stop_at_end: Bool = false

$tcbs: Task[3]
$stacks: U8[196608] // 3 * 65536
$stack_idle: U8[65536]

fn on_irq(_sig: I32): Void //< the stand-in interrupt handler: one give per waiter
    //<
    //< It does only what is async-signal-safe (gives and counters). It registers itself again, as
    //< glibc's signal() under -std=c99 resets the action after one delivery.
    g_irqs += 1
    for i in Range.asc(WAITERS)
        if tcbs[i].get_state() == .blocked
            g_blocked_at_irq += 1
    for _ in Range.asc(WAITERS)
        g_sem.give()
    libc.signal(SIGUSR1, on_irq)

fn waiter(_arg: Void$@): Void
    g_sem.take()
    if g_woken == 0 // the highest priority runs first; it measures the wait for the round
        g_wall_waited = sys.mono_us() - g_wall_start
        g_cpu_used = clock() - g_cpu_start
    g_woken += 1
    if g_woken == WAITERS && g_stop_at_end
        task.stop_scheduler()

fn round(title: U8[]) //< blocks three waiters, raises the interrupt from outside, and checks
    verdict.start(title)
    g_irqs = 0
    g_blocked_at_irq = 0
    g_woken = 0
    for i in Range.asc(WAITERS)
        stack: = U8$[]::{ .ptr = stacks[0]@ + i * 65536, .len = 65536 }
        tcbs[i].create(stack, waiter, null, I32::i + 1, "waiter")
    g_wall_start = sys.mono_us()
    g_cpu_start = clock()
    $child: = subproc.spawn_async(U8[][]::{ "sh", "-c", RAISE_AFTER }, "") catch
        panic("sleep: could not start the child that raises the interrupt")
    task.start_scheduler()
    _code: = child.wait()
    io.out().s("[sleep] waited \{g_wall_waited / 1000\} ms, CPU used \{g_cpu_used / 1000\} ms\n")
    assert(g_irqs == 1, "sleep: the interrupt did not arrive exactly once")
    assert(g_blocked_at_irq == WAITERS, "sleep: the waiters were not all blocked at the interrupt")
    assert(g_woken == WAITERS, "sleep: the scheduler returned before the interrupt woke its tasks")
    assert(g_wall_waited >= RAISE_AFTER_MS * 1000I64 * 4I64 / 5I64,
        "sleep: the tasks woke before the interrupt could have come")
    // Spinning would use about as much CPU as the time waited; a sleep uses next to none.
    assert(g_cpu_used * 4I64 < g_wall_waited, "sleep: the CPU was kept busy while every task waited")
    for i in Range.asc(WAITERS)
        tcbs[i].delete() // gives the slots and contexts back for the next round
    verdict.pass("it slept through the wait and woke the tasks on the interrupt.")

fn main(): I32
    g_sem.init(0)
    libc.signal(SIGUSR1, on_irq)
    round("[ksos] start_scheduler sleeps while every task waits on an interrupt")
    io.out().s("=== the idle task on ===\n")
    task.enable_idle_task(U8$[]::stack_idle, task.Idle_hook::null)
    g_stop_at_end = true
    round("[ksos] the idle task sleeps too, and stop_scheduler returns past it")
    $left: I32 = 0
    for i in Range.asc(Task.count())
        t: = Task.at(i)
        if t != null && t.get_state() != .done
            left += 1
    assert(left == 1, "sleep: only the idle task should remain once stop_scheduler has returned")
    return verdict.finish()

//< The entry point that runs ksos's tests together
//< **This is the only `pub` declaration in this package.** The tests inside `ksos/` reach what
//< they check unqualified (`ksplc.cfg`'s [I0402]). Only `tests/debug/main.kspl`, another unit,
//< needs this entry point.
//< Caution: **Do not add a checking function here.** Each one added is one more contract exposed
//< outside the unit.
import "ksos/tests/console_test"
import "ksos/tests/ncm_test"
import "ksos/tests/net_test"
import "std/suite"

priv enum Tests //< ksos's tests that run on the host, which take nothing
    all

impl Tests: suite.Suite {}

pub fn run_ksos() //< runs every ksos test that runs on the host
    $t: = Tests.all
    t.run()

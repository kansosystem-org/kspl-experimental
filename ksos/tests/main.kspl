//< ksos's tests, run as a program of their own (`make test` in this package's folder)
//< **This is the only way to run ksos's tests alone.** The unit tests are `all.kspl`'s. Besides
//< them, its own suite runs the two tests that need the tests' working directory and a compiler.
//< One reads the USB driver as text. One runs elf2uf2 on ELFs it must refuse to place.
import "ksos/tests/all"
import "ksos/tests/elf2uf2"
import "ksos/tests/usb_descriptors"
import "std/io"
import "std/mem" { Arena }
import "std/suite"
import "std/sys"
import "std/verdict"

priv const USAGE: U8[] = "usage: ksplc run tests/main.kspl <ksplc> <work_dir>" //<
    //< the arguments, in that order (`make test` in `ksos/Makefile` passes them)

priv struct Tests //< what the two tests run from here take
    ksplc: U8[] //< the compiler that builds what elf2uf2 is given
    work: U8[] //< the folder the tests write in
    arena: Arena$@

impl Tests: suite.Suite {}

fn main(): I32
    // Line-buffered, so a run that dies shows how far it got.
    io.set_line_buffered()
    defer arena: = Arena.new(64 * 1024 * 1024)
    argv: = sys.args()
    if argv.len != 3
        panic(arena.dup_str(USAGE))
    ksplc: = arena.dup_str(argv.get(1))
    work: = arena.dup_str(argv.get(2))
    all.run_ksos()
    $t: = Tests::{ .ksplc = ksplc, .work = work, .arena = arena }
    t.run()
    return verdict.finish()

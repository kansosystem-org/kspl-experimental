//< The entry point that runs ksos's tests together
//<
//< **This is the only `pub` declaration in this package**: the tests inside `ksos/` reach what they
//< check unqualified (`ksplc.cfg`'s [I0402]), and only `tests/debug/parts.kspls`, another unit,
//< needs this entry point.
//< Caution: **Do not add a checking function here** — each one added is one more contract exposed
//< outside the unit.
import "ksos/tests/console_test"
import "ksos/tests/ncm_test"
import "ksos/tests/net_test"

pub fn run_ksos() //< runs every ksos test that runs on the host
  console_test.test_console_prints_i32_min()
  ncm_test.test_ncm()
  net_test.test_tcp_conn_segment_larger_than_buffer()
  net_test.test_tcp_conn_rejects_wrong_seq()
  net_test.test_tcp_conn_send_is_partial()
  net_test.test_tcp_conn_send_failure_does_not_advance_seq()
  net_test.test_frame_builders_pad_to_min()
  net_test.test_frame_builders_refuse_a_small_buffer()
  net_test.test_mqtt_build_refuses_a_small_buffer()
  net_test.test_tcp_parse_ignores_ethernet_padding()
  net_test.test_tcp_parse_rejects_malformed_headers()
  net_test.test_tcp_parse_follows_ip_options()

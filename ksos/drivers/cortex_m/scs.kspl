//< The Cortex-M core's own registers, in the System Control Space (shared by every Cortex-M)
//<
//< The SCS (0xE000E000-0xE000EFFF) sits in every Cortex-M whatever the chip: here the NVIC's
//< interrupt enable and set-pending, and SCB->AIRCR's system reset. Only what this project uses
//< is written, and only registers Armv6-M (Cortex-M0/M0+) has too, so one file serves every port.
import "ksos/drivers/mmio"

// ==========================================
// The NVIC. This project only uses external interrupts 0 to 31. So it writes ISER0 and ISPR0
// alone (Interrupt Set-Enable / Set-Pending Register 0). Priorities, IRQs 32 and above, and
// disabling (ICER) are not implemented.
// ==========================================
const ISER0: U32 = 0xE000E100
const ISPR0: U32 = 0xE000E200

fn enable_irq(irq: U32) //< enables external interrupt number irq (0 to 31, the NVIC IRQn)
    //<
    //< The vector table's exception number is irq+16.
    mmio.write32(ISER0, 1U32 << irq)

fn set_pending(irq: U32) //< makes external interrupt number irq pending, as its hardware would
    //<
    //< Enabled and above the running priority, it is taken once the write reaches the NVIC (a
    //< `dsb` then an `isb` make that happen before the next instruction). Armv7-M's STIR does the
    //< same, but Armv6-M has no STIR.
    mmio.write32(ISPR0, 1U32 << irq)

// ==========================================
// The system reset: a write of SYSRESETREQ (bit2) of SCB->AIRCR with the key VECTKEY
// (bit[31:16]=0x05FA) restarts from Reset_Handler at once. Power stays on. The architecture
// requires the key; it ignores a write without it. RAM keeps its content, so the next start-up can
// read a panic's crash record (`take_panic_record` in std/lang.kspl).
// ==========================================
const AIRCR: U32 = 0xE000ED0C
const AIRCR_VECTKEY: U32 = 0x05FAU32 << 16
const AIRCR_SYSRESETREQ: U32 = 1U32 << 2

fn system_reset() //<
    //< Requests a system reset; it does not return to the caller
    //<
    //< The CPU is reset right after the write.
    mmio.write32(AIRCR, AIRCR_VECTKEY | AIRCR_SYSRESETREQ)
    for {} // spin for the few instructions until the reset takes effect (should not be reached)

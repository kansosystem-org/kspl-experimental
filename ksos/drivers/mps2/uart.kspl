//< The UART0 driver for the ARM MPS2 FPGA prototyping board (the CMSDK APB UART IP)

// ==========================================
//   0x00 DATA     : the data sent and received (only the low 8 bits are meaningful)
//   0x04 STATE    : bit0=TX_FULL bit1=RX_FULL bit2=TX_OVERRUN bit3=RX_OVERRUN
//   0x08 CTRL     : bit0=TX_ENABLE bit1=RX_ENABLE (the interrupt bits are unused here)
//   0x0C INTSTATUS: the interrupt cause (unused)
//   0x10 BAUDDIV  : the baud rate divisor (must be 16 or more for PCLK. QEMU ignores it, but a
//                   valid value is set for compatibility with real hardware)
// ==========================================
import "ksos/drivers/mmio"

const UART0_DATA: U32 = 0x40004000
const UART0_STATE: U32 = 0x40004004
const UART0_CTRL: U32 = 0x40004008
const UART0_BAUDDIV: U32 = 0x40004010

const STATE_TX_FULL: U32 = 0x1
const STATE_RX_FULL: U32 = 0x2
const CTRL_TX_ENABLE: U32 = 0x1
const CTRL_RX_ENABLE: U32 = 0x2

fn init() //< initializes UART0 (enabling both TX and RX)
    mmio.write32(UART0_BAUDDIV, 16U32)
    mmio.write32(UART0_CTRL, CTRL_TX_ENABLE | CTRL_RX_ENABLE)

fn putc(c: U8): Void!mmio.Driver_error //< sends one byte, busy-waiting for room in TX
    //< On a timeout the byte is not sent.
    mmio.wait(UART0_STATE, STATE_TX_FULL, false)!
    mmio.write32(UART0_DATA, c)

fn puts(s: U8[]): Void!mmio.Driver_error //< sends a string a byte at a time
    //< A timeout partway stops it there.
    for c in s
        putc(c)!

fn getc(): U8? //<
    //< Receives one byte (busy-waits until data arrives in the RX buffer)
    //< On a timeout it returns none.
    mmio.wait(UART0_STATE, STATE_RX_FULL, true) catch
        return .none
    return .some(U8::mmio.read32(UART0_DATA))

//< Initializing the clock tree for the real Raspberry Pi Pico / Pico W (RP2040) chip
//<
//< Out of reset the RP2040 runs on the built-in ROSC (about 6.5MHz, drifting), but **USB needs
//< exactly 48MHz on clk_usb**. This starts the crystal (XOSC at 12MHz) and moves each clock to a
//< fixed value through the two PLLs.

// ==========================================
// The clock tree and the register map are in ksos/docs/DESIGN-rtos.md.
// Caution: **Calling this changes the time scale by about 19 times** (from the ROSC's 6.5MHz to
// clk_sys's 125MHz). Everything that waits by iteration count (gpio.spin), SysTick's reload and
// PWM's divisor need review; after it, use rp2040/timer's real microseconds.
// ==========================================

// QEMU has no RP2040 model: a real Pico W's buzzer sounding **a calibrated 2kHz** verifies it
// (ksos/docs/HOWTO-bring-up.md).
import "ksos/drivers/mmio"
import "ksos/drivers/rp2040/resets"

// The frequencies this driver sets, from which callers compute their divisors.
const REF_HZ: U32 = 12000000 // = XOSC, the crystal's own frequency
const SYS_HZ: U32 = 125000000 // clk_sys (= the source of the CPU / SysTick / PWM)
const USB_HZ: U32 = 48000000 // clk_usb (USB is fixed at 48MHz; it must not change)
const ADC_HZ: U32 = 48000000 // clk_adc (the ADC expects 48MHz, at 96 cycles per conversion)
const RTC_HZ: U32 = 46875 //< clk_rtc
    //<
    //< The RTC divides this by CLKDIV_M1 + 1 to get 1Hz, so `RTC_HZ - 1` is passed to rtc.init
    //< (48MHz / 1024, as in pico-sdk).
const RTC_DIV: U32 = USB_HZ / RTC_HZ

const RESET_PLL_SYS: U32 = 1U32 << 12
const RESET_PLL_USB: U32 = 1U32 << 13

const XOSC_CTRL: U32 = 0x40024000
const XOSC_STATUS: U32 = 0x40024004
const XOSC_STARTUP: U32 = 0x4002400c
const XOSC_FREQ_RANGE_1_15MHZ: U32 = 0xaa0
const XOSC_ENABLE: U32 = 0xfabU32 << 12
const XOSC_STABLE: U32 = 1U32 << 31

const XOSC_STARTUP_DELAY: U32 = 47 //< how long to wait for XOSC to start and settle
    //<
    //< One count of STARTUP.DELAY is 256 cycles. It is pico-sdk's formula ((XOSC_HZ / 1000) + 128)
    //< / 256 with 12MHz (= 47).

const PLL_SYS_BASE: U32 = 0x40028000
const PLL_USB_BASE: U32 = 0x4002c000
const PLL_CS_LOCK: U32 = 1U32 << 31
const PLL_PWR_PD: U32 = 1U32 << 0
const PLL_PWR_POSTDIVPD: U32 = 1U32 << 3
const PLL_PWR_VCOPD: U32 = 1U32 << 5

const CLK_REF_CTRL: U32 = 0x40008030
const CLK_REF_DIV: U32 = 0x40008034
const CLK_REF_SELECTED: U32 = 0x40008038
const CLK_SYS_CTRL: U32 = 0x4000803c
const CLK_SYS_DIV: U32 = 0x40008040
const CLK_SYS_SELECTED: U32 = 0x40008044
const CLK_PERI_CTRL: U32 = 0x40008048
const CLK_USB_CTRL: U32 = 0x40008054
const CLK_USB_DIV: U32 = 0x40008058
const CLK_ADC_CTRL: U32 = 0x40008060
const CLK_ADC_DIV: U32 = 0x40008064
const CLK_RTC_CTRL: U32 = 0x4000806c
const CLK_RTC_DIV: U32 = 0x40008070
const CLK_SYS_RESUS_CTRL: U32 = 0x40008078

const CTRL_SRC_BITS: U32 = 0x3U32 //< the CTRL register's shared bits
    //<
    //< SRC is the glitchless mux (clk_ref/clk_sys only), and AUXSRC is common to every clock.
const CTRL_AUXSRC_BITS: U32 = 0x7U32 << 5
const CTRL_ENABLE: U32 = 1U32 << 11

const CLK_REF_SRC_XOSC: U32 = 2
const CLK_SYS_SRC_AUX: U32 = 1
const CLK_SYS_AUXSRC_PLL_SYS: U32 = 0
const CLK_USB_AUXSRC_PLL_USB: U32 = 0
const CLK_ADC_AUXSRC_PLL_USB: U32 = 0
const CLK_RTC_AUXSRC_PLL_USB: U32 = 0
const CLK_PERI_AUXSRC_CLK_SYS: U32 = 0

const DIV_BY_ONE: U32 = 1U32 << 8 //< DIV is 24.8 fixed point (the integer part is bit[31:8])
    //<
    //< No division = 1.0.

const WATCHDOG_TICK: U32 = 0x4005802c
const WATCHDOG_TICK_ENABLE: U32 = 1U32 << 9

// ==========================================
// The parts. pll_start starts a PLL with refdiv/fbdiv/postdiv and waits for it to lock.
// vco = (XOSC / refdiv) * fbdiv, and the output = vco / (postdiv1 * postdiv2).
// Caution: Keep the order. Set the dividers before powering the VCO, and power the postdiv up
// after the lock.
// ==========================================
priv fn pll_start(base: U32, refdiv: U32, fbdiv: U32, postdiv1: U32, postdiv2: U32):
    Void!mmio.Driver_error
    cs_addr: = base
    pwr_addr: = base + 0x04
    fbdiv_addr: = base + 0x08
    prim_addr: = base + 0x0c

    mmio.write32(cs_addr, refdiv)
    mmio.write32(fbdiv_addr, fbdiv)

    // Power up the PLL and the VCO (PD/VCOPD are "power down" bits, so write 0).
    pwr: = mmio.read32(pwr_addr)
    mmio.write32(pwr_addr, pwr & ~(PLL_PWR_PD | PLL_PWR_VCOPD))
    mmio.wait(cs_addr, PLL_CS_LOCK, true)!

    mmio.write32(prim_addr, (postdiv1 << 16) | (postdiv2 << 12))
    pwr2: = mmio.read32(pwr_addr)
    mmio.write32(pwr_addr, pwr2 & ~PLL_PWR_POSTDIVPD)

priv fn switch_glitchless(ctrl: U32, selected: U32, div: U32, src: U32, auxsrc: U32):
    Void!mmio.Driver_error //<
        //< Switches a clock that has a glitchless mux (clk_ref / clk_sys)
        //<
        //< Caution: When moving to the aux source, **set SRC to 0 first** and then write AUXSRC, so
        //< the aux mux's switching glitch does not reach downstream. SELECTED (one-hot) shows it
        //< finished.
    mmio.write32(div, DIV_BY_ONE)

    cur: = mmio.read32(ctrl)
    mmio.write32(ctrl, cur & ~CTRL_SRC_BITS)
    mmio.wait(selected, 1U32, true)!

    c1: = mmio.read32(ctrl)
    mmio.write32(ctrl, (c1 & ~CTRL_AUXSRC_BITS) | (auxsrc << 5))
    c2: = mmio.read32(ctrl)
    mmio.write32(ctrl, (c2 & ~CTRL_SRC_BITS) | src)
    mmio.wait(selected, 1U32 << src, true)!

priv fn switch_aux_only(ctrl: U32, div: U32, divisor: U32, auxsrc: U32) //<
    //< Switches a clock that has no glitchless mux (clk_peri / clk_usb / clk_adc / clk_rtc)
    //<
    //< This one **clears ENABLE to stop it** before changing AUXSRC (while running, it glitches).
    //< Caution: **When div is 0, do not write to it.** clk_peri has no DIV register, and that
    //< address is the read-only SELECTED. The divisor is written while the clock is stopped.
    cur: = mmio.read32(ctrl)
    mmio.write32(ctrl, cur & ~CTRL_ENABLE)
    if divisor != 0
        mmio.write32(div, divisor << 8)
    c1: = mmio.read32(ctrl)
    mmio.write32(ctrl, (c1 & ~CTRL_AUXSRC_BITS) | (auxsrc << 5))
    c2: = mmio.read32(ctrl)
    mmio.write32(ctrl, c2 | CTRL_ENABLE)

// ==========================================
// The main part. init moves the clock tree to its final values. Call it **once right after
// start-up, before any other driver**.
// It is not idempotent: called twice, clk_sys drops to clk_ref (12MHz) for a while.
// ==========================================
fn init(): Void!mmio.Driver_error //< runs clk_sys at 125MHz, and clk_usb / clk_adc at 48MHz
    // Stop the recovery mechanism (resus), or it takes clk_sys's switch for a fault and returns to
    // the ROSC.
    mmio.write32(CLK_SYS_RESUS_CTRL, 0U32)

    // --- start the crystal ---
    mmio.write32(XOSC_CTRL, XOSC_FREQ_RANGE_1_15MHZ)
    mmio.write32(XOSC_STARTUP, XOSC_STARTUP_DELAY)
    ctrl: = mmio.read32(XOSC_CTRL)
    mmio.write32(XOSC_CTRL, ctrl | XOSC_ENABLE)
    mmio.wait(XOSC_STATUS, XOSC_STABLE, true)!

    // --- before touching the PLLs, move both clocks to a source that does not depend on them ---
    // Resetting a PLL while clk_sys still runs from PLL_SYS stops the CPU's clock.
    s: = mmio.read32(CLK_SYS_CTRL)
    mmio.write32(CLK_SYS_CTRL, s & ~CTRL_SRC_BITS) // clk_sys ← clk_ref
    mmio.wait(CLK_SYS_SELECTED, 1U32, true)!
    r: = mmio.read32(CLK_REF_CTRL)
    mmio.write32(CLK_REF_CTRL, r & ~CTRL_SRC_BITS) // clk_ref ← ROSC
    mmio.wait(CLK_REF_SELECTED, 1U32, true)!

    // --- the two PLLs ---
    // 12MHz * 125 = 1500MHz, /6/2 = 125MHz. 12MHz * 100 = 1200MHz, /5/5 = 48MHz.
    resets.reset_then_unreset(RESET_PLL_SYS | RESET_PLL_USB)!
    pll_start(PLL_SYS_BASE, 1, 125, 6, 2)!
    pll_start(PLL_USB_BASE, 1, 100, 5, 5)!

    // --- each clock to its final source ---
    switch_glitchless(CLK_REF_CTRL, CLK_REF_SELECTED, CLK_REF_DIV, CLK_REF_SRC_XOSC, 0)!
    switch_glitchless(CLK_SYS_CTRL, CLK_SYS_SELECTED, CLK_SYS_DIV, CLK_SYS_SRC_AUX,
        CLK_SYS_AUXSRC_PLL_SYS)!
    switch_aux_only(CLK_USB_CTRL, CLK_USB_DIV, 1, CLK_USB_AUXSRC_PLL_USB)
    // The ADC runs on clk_adc. Without it READY is never set while the registers still read
    // (nothing looks broken, yet only 0 comes back).
    switch_aux_only(CLK_ADC_CTRL, CLK_ADC_DIV, 1, CLK_ADC_AUXSRC_PLL_USB)
    // The RTC runs on clk_rtc; without it, it stays at the value SETUP loaded.
    switch_aux_only(CLK_RTC_CTRL, CLK_RTC_DIV, RTC_DIV, CLK_RTC_AUXSRC_PLL_USB)
    switch_aux_only(CLK_PERI_CTRL, 0, 0, CLK_PERI_AUXSRC_CLK_SYS)

    // --- feed TIMER a 1MHz tick ---
    // TIMER takes its 1µs pulse from **the watchdog's tick generator**; without it TIMER silently
    // stands still. clk_ref's frequency in MHz goes into CYCLES.
    mmio.write32(WATCHDOG_TICK, (REF_HZ / 1000000) | WATCHDOG_TICK_ENABLE)

//< The ADC (successive-approximation, 12-bit) for the real Raspberry Pi Pico / Pico W (RP2040) chip
//< **Channels 0 to 3 are GPIO 26 to 29** (pin_channel() converts), and channel 4 is the built-in
//< temperature sensor.
//< Caution: **Call clocks.init() first.** Without clk_adc, READY is never set while the registers
//< still read: nothing looks broken, yet only 0 comes back.

// ==========================================
// **Call gpio.init_analog(pin) before reading**, or the readings drift.
// The three things to set up, the 12-bit resolution (not Arduino's 10) and the register map are
// in "The ADC (`adc.kspl`)" in ksos/docs/DESIGN-rtos.md.
// ==========================================
import "ksos/drivers/mmio"
import "ksos/drivers/rp2040/resets"

const RESET_ADC: U32 = 1U32 << 0

const ADC_CS: U32 = 0x4004c000
const ADC_RESULT: U32 = 0x4004c004

const CS_EN: U32 = 1U32 << 0
const CS_START_ONCE: U32 = 1U32 << 2
const CS_READY: U32 = 1U32 << 8
const CS_ERR: U32 = 1U32 << 9
const CS_AINSEL_BITS: U32 = 0x7U32 << 12

const MAX_VALUE: U32 = 4095 //< the conversion result's range
    //< Not Arduino's 10 bits (1023).

const FIRST_ADC_GPIO: U32 = 26 //< the first GPIO the ADC input is connected to
    //< Channel n = GPIO (first_adc_gpio + n).
const CHANNEL_COUNT: U32 = 4 // channel 4 is the temperature sensor; only external inputs here

fn pin_channel(pin: U32): U32 //< turns a GPIO number into the ADC's channel number
    //< Caution: Pass only 26 to 29 (out of range it returns 0, which cannot be told apart from
    //< "channel 0 was read").
    if pin < FIRST_ADC_GPIO || pin >= FIRST_ADC_GPIO + CHANNEL_COUNT
        return 0
    return pin - FIRST_ADC_GPIO

fn init(): Void!mmio.Driver_error //< starts the ADC block
    //< Call it once after clocks.init() and before reading; gpio.init_analog is needed separately.
    resets.unreset(RESET_ADC)!
    mmio.write32(ADC_CS, CS_EN)
    // READY stays clear from power-on until the ADC is usable.
    mmio.wait(ADC_CS, CS_READY, true)!

struct Reading
    ok: Bool //< false means the conversion did not finish, or a conversion error (value is 0)
    value: U32 //< 0 to 4095

fn read_channel(ch: U32): Reading //< converts a channel once
    //< **Do not read RESULT while converting (READY=0).** It returns the previous value.
    cur: = mmio.read32(ADC_CS)
    mmio.write32(ADC_CS, (cur & ~CS_AINSEL_BITS) | ((ch & 0x7) << 12))
    started: = mmio.read32(ADC_CS)
    mmio.write32(ADC_CS, started | CS_START_ONCE)
    mmio.wait(ADC_CS, CS_READY, true) catch
        return Reading::{ .ok = false, .value = 0 }
    st: = mmio.read32(ADC_CS)
    if (st & CS_ERR) != 0
        return Reading::{ .ok = false, .value = 0 }
    return Reading::{ .ok = true, .value = mmio.read32(ADC_RESULT) & MAX_VALUE }

fn read_pin(pin: U32): Reading //< reads once by GPIO number
    return read_channel(pin_channel(pin))

fn read_pin_avg(pin: U32, n: U32): Reading //< reads n times and returns the average
    //< One reading varies by a few LSB; average where it meets a threshold. n = 0 counts as once.
    count: = 1U32 if n == 0 else n
    ch: = pin_channel(pin)
    $sum: U32 = 0
    for $i: U32 = 0; i < count; i += 1
        r: = read_channel(ch)
        if !r.ok
            return r
        sum += r.value
    return Reading::{ .ok = true, .value = sum / count }

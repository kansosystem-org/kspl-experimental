import "ksos/drivers/mmio"

// ==========================================
// Kanso OS — the RP2040's RESETS block. It takes a peripheral out of reset and waits for it.
// **It holds no state at all** (for the same reason as `usb_hw.kspl`), so every driver can
// import it and the imports stay one-way.
// The driver that uses a bit names which peripheral it is (`RESET_ADC` in `adc.kspl` and the
// like).
// ==========================================

const RESETS_RESET: U32 = 0x4000c000
const RESETS_RESET_DONE: U32 = 0x4000c008

fn unreset(bits: U32): Void!mmio.Driver_error //< takes bits out of reset, waiting for them
    //< **The wait has a timeout** (the policy of `wait` in `ksos/drivers/mmio.kspl`).
    cur: = mmio.read32(RESETS_RESET)
    mmio.write32(RESETS_RESET, cur & ~bits)
    mmio.wait(RESETS_RESET_DONE, bits, true)!

fn reset_then_unreset(bits: U32): Void!mmio.Driver_error //< puts bits into reset once, then out
    //< **Which of the two to call is decided per peripheral.**
    //< **Do not copy either one into a driver**: the reasons for choosing would scatter across the
    //< drivers.
    cur: = mmio.read32(RESETS_RESET)
    mmio.write32(RESETS_RESET, cur | bits)
    cur2: = mmio.read32(RESETS_RESET)
    mmio.write32(RESETS_RESET, cur2 & ~bits)
    mmio.wait(RESETS_RESET_DONE, bits, true)!

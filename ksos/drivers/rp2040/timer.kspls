//< A microsecond timer for the real Raspberry Pi Pico / Pico W (RP2040) chip
//<
//< The RP2040's TIMER is a 64-bit free-running counter that ticks **exactly every 1µs**.
//< Caution: **Call clocks.init() first**: it sets up the watchdog's tick generator TIMER counts.
//< Only the raw low 32 bits (TIMERAWL) are used here.

// ==========================================
//   TIMER_BASE = 0x40054000
//     +0x24 TIMERAWH / +0x28 TIMERAWL ... the raw high/low 32 bits
//     +0x08 TIMEHR   / +0x0c TIMELR   ... the latched read (reading the low word latches the high)
// ==========================================

import "ksos/drivers/mmio"
const timer_rawl: U32 = 0x40054028

fn now_us(): U32 //< the microseconds elapsed since start-up (the low 32 bits)
  //<
  //< It wraps in about 71.6 minutes.
  return mmio.read32(timer_rawl)

fn elapsed_us(since: U32): U32 //< the microseconds elapsed from since to now
  //<
  //< It is correct across a wrap (U32 subtraction is modulo 2^32).
  return now_us() - since

fn delay_us(us: U32) //< waits for us microseconds
  //<
  //< A busy wait: it does not give up the CPU.
  start: = now_us()
  for elapsed_us(start) < us {}

fn delay_ms(ms: U32)
  for $i: U32 = 0; i < ms; i += 1
    delay_us(1000)

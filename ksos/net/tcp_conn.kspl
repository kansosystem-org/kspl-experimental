//< Sends and receives bytes while keeping one TCP connection's seq/ack state
//<
//< Built on `build_tcp_segment` / `parse_tcp_segment` in `ksos/net/mini_ipv4.kspl`, which hold
//< no state; this file holds it. send's and recv's signatures match mbedtls_ssl_send_t's and
//< mbedtls_ssl_recv_t's, so they can be passed to mbedtls_ssl_set_bio as they are (no trampoline).
import "ksos/net/link" as netlink
import "ksos/net/mini_ipv4" as net
import "std/bytes"
import "std/chars"

const mbedtls_err_ssl_want_read: I32 = -0x6900 //<
    //< The constant mbedtls_ssl_recv_t uses to say "there is no data to read right now"
    //<
    //< It is MBEDTLS_ERR_SSL_WANT_READ, from mbedtls/ssl.h; the caller reads again later. This file
    //< includes none of mbedTLS's headers.

const mbedtls_err_net_conn_reset: I32 = -0x0050 //<
    //< What recv returns once the peer has reset the connection (RST)
    //<
    //< It is MBEDTLS_ERR_NET_CONN_RESET, from mbedtls/net_sockets.h. The peer's FIN reads as 0
    //< instead, the end of the stream in mbedtls_ssl_recv_t's contract.

const max_frame_payload: Sz = 1400 //<
    //< The limit on a send payload that fits one Ethernet frame
    //<
    //< It is the MTU of 1500 minus the headers, with a margin.
    //< Beyond it, tcp_stream_send sends part (send_t allows it) and the caller calls again.

enum Peer_state //< how far the peer's side of the stream has gone
    open
    fin_after_pending //< its FIN follows the payload held in rx_scratch
    closed //< its FIN was taken: recv reads 0 (the end of the stream) from then on
    reset //< it sent RST: recv reads mbedtls_err_net_conn_reset from then on

struct Tcp_conn
    // Where frames go in and out. The upper layers touch the hardware nowhere else.
    link: netlink.Link
    ends: net.Ends //< from us (src) to the peer (dst)
    our_seq: U32 //< the sequence number of the next byte to send
    peer_seq: U32 //< the sequence number of the byte expected next from the peer (= the ack value)
    tx_scratch: U8[1500]
    rx_scratch: U8[1500]
    // The payload left in rx_scratch because it did not fit the caller's buffer.
    // Caution: **Do not truncate a segment to the buffer's size.** Losing the rest makes every
    // later segment fail the seq check, and the connection can never be read again; so the rest is
    // kept here for the next call.
    rx_pending_off: Sz
    rx_pending_len: Sz
    peer_state: Peer_state

fn make(link: netlink.Link, ends: net.Ends, our_seq: U32, peer_seq: U32): Tcp_conn //<
    //< Builds the state right after the 3-way handshake
    //<
    //< The caller resolves ARP and does the handshake with `ksos/net/mini_ipv4.kspl` (see
    //< `ksos/demo/rp2040/rp2040_net_probe.kspl`).
    //< Pass our_seq and peer_seq as they are after each side's SYN has used one.
    return Tcp_conn::{
        .link = link,
        .ends = ends,
        .our_seq = our_seq,
        .peer_seq = peer_seq,
        .tx_scratch = ::{},
        .rx_scratch = ::{},
        .rx_pending_off = 0,
        .rx_pending_len = 0,
        .peer_state = .open,
    }

// Compatible with mbedtls_ssl_send_t: ctx is taken as a Tcp_conn@. It sends buf[0..min(len,1400))
// as a PSH|ACK segment and returns how many bytes it actually sent (a partial send is allowed).
// **If the link cannot send right now it returns 0**, and the caller calls again with the same
// data.
#export
fn tcp_stream_send(ctx: Void$@, buf: U8@, len: Sz): I32
    conn: = Tcp_conn$@::ctx
    n: Sz = len if len <= max_frame_payload else max_frame_payload
    payload: = U8[]::{ .ptr = buf, .len = n }
    seg_len: = net.build_tcp_segment(U8$[]::conn.tx_scratch, conn.ends, conn.our_seq,
        conn.peer_seq, net.tcp_flag_ack | net.tcp_flag_psh, payload)
    // Caution: **If it could not send, do not advance our_seq**, or it claims bytes the peer can
    // never ACK, and with no retransmit the connection breaks silently. A build that returns 0 (it
    // does not fit the scratch buffer) is treated the same way.
    if seg_len == 0 || !conn.link.send_frame(U8[]::conn.tx_scratch, seg_len)
        return 0
    conn.our_seq += U32::n
    return I32::n

priv fn send_ack(conn: Tcp_conn$@) //< tells the peer everything before peer_seq has arrived
    //<
    //< Without it the peer resends what it sent, and stops sending once its window is full. The
    //< outcome is not waited on: a lost ACK is sent again when the peer's resend arrives.
    seg_len: = net.build_tcp_segment(U8$[]::conn.tx_scratch, conn.ends, conn.our_seq,
        conn.peer_seq, net.tcp_flag_ack, "")
    if seg_len > 0
        _sent: = conn.link.send_frame(U8[]::conn.tx_scratch, seg_len)

priv fn take_pending(conn: Tcp_conn$@, buf: U8$@, len: Sz): Sz //<
    //< Returns as much of the payload left in rx_scratch as fits the buffer
    //<
    //< It keeps the rest for later.
    //< peer_seq advances **only by what was actually returned**, and the ACK goes once the whole
    //< segment has: only then is rx_scratch free for the next one.
    // copy_from truncates what does not fit and returns how many it copied; the caller's raw
    // pointer is wrapped in a view first.
    dst: = U8$[]::{ .ptr = buf, .len = len }
    src: = U8[]::conn.rx_scratch
    n: = dst.copy_from(0, src.sub(conn.rx_pending_off, conn.rx_pending_len))
    conn.rx_pending_off += n
    conn.rx_pending_len -= n
    conn.peer_seq += U32::n
    if conn.rx_pending_len == 0
        if conn.peer_state == .fin_after_pending
            conn.peer_seq += 1 // a FIN takes one sequence number
            conn.peer_state = .closed
        send_ack(conn)
    return n

// Compatible with mbedtls_ssl_recv_t: ctx is taken as a Tcp_conn@. It receives one frame and, if
// it is this connection's next data segment, copies it into buf[0..min(len,payload_len)) and
// returns that count; otherwise it returns mbedtls_err_ssl_want_read at once. Once the peer's FIN
// has been taken it returns 0 (the end of the stream), and after its RST
// mbedtls_err_net_conn_reset, on every call.
#export
fn tcp_stream_recv(ctx: Void$@, buf: U8$@, len: Sz): I32
    conn: = Tcp_conn$@::ctx
    // Leftover data goes out before a new frame is read, or the stream's order would be swapped.
    if conn.rx_pending_len > 0
        return I32::take_pending(conn, buf, len)
    switch conn.peer_state
    case .closed
        return 0
    case .reset
        return mbedtls_err_net_conn_reset
    case .open {}
    case .fin_after_pending {} // unreachable: it turns closed as the held payload runs out
    if !conn.link.rx_available()
        return mbedtls_err_ssl_want_read
    rx_len: = conn.link.recv_frame(U8$[]::conn.rx_scratch)
    seg: = net.parse_tcp_segment(U8[]::conn.rx_scratch, rx_len, conn.ends.dst_ip,
        conn.ends.dst_port, conn.ends.src_port)
    if !seg.ok
        return mbedtls_err_ssl_want_read
    fin: = (seg.flags & net.tcp_flag_fin) != 0
    if seg.seq != conn.peer_seq
        // A resend of what was taken (our ACK was lost), or a segment past one lost: the ACK
        // repeated tells the peer where the stream stands. A bare ACK is not answered, or two ends
        // would ACK each other's ACKs for ever.
        if seg.payload_len > 0 || fin
            send_ack(conn)
        return mbedtls_err_ssl_want_read
    // Caution: **Take RST only at the expected seq.** At any other a third party could guess one
    // into the window and cut the connection.
    if (seg.flags & net.tcp_flag_rst) != 0
        conn.peer_state = .reset
        return mbedtls_err_net_conn_reset
    if seg.payload_len == 0
        if !fin
            return mbedtls_err_ssl_want_read // a bare ACK
        conn.peer_seq += 1
        conn.peer_state = .closed
        send_ack(conn)
        return 0
    conn.rx_pending_off = seg.payload_off
    conn.rx_pending_len = seg.payload_len
    if fin
        conn.peer_state = .fin_after_pending
    return I32::take_pending(conn, buf, len)

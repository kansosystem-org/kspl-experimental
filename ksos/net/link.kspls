//< The swappable link layer (sending and receiving raw Ethernet frames)
//<
//< **It is a struct of function pointers rather than an interface (dynamic dispatch)**, so the
//< caller names the implementation in one place and no hidden vtable is involved.

// ==========================================
//   import "ksos/drivers/rp2040/usb_cdc" as eth;
//   link: = netlink.Link::{
//     .send_frame = eth.send_frame,
//     .rx_available = eth.rx_available,
//     .recv_frame = eth.recv_frame,
//   };
// ==========================================

typedef Send_frame = fn(frame: U8[], len: Sz): Bool //< sends one frame
  //<
  //< len is the actual byte count from the start of frame. **true if it sent.**
  //< Caution: **Always return the outcome**, or the upper layers take an unsent frame as "sent".
  //< false means "not right now": the caller retries (running a polling link's poll meanwhile).

typedef Rx_available = fn(): Bool //< whether received frames are waiting (it must not block)

typedef Recv_frame = fn(out: U8$[]): Sz //< takes one frame and returns its actual byte count
  //<
  //< Caution: Call it only if rx_available is true.

struct Link
  send_frame: Send_frame
  rx_available: Rx_available
  recv_frame: Recv_frame

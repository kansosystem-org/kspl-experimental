//< The smallest ARP/IPv4/UDP/TCP stack
//<
//< It only builds and parses raw Ethernet frames: no fragmentation, no IP options, no routing
//< table, one default gateway. **This file knows nothing of the hardware.** Sending and receiving
//< are the caller's, through the `Link` in `ksos/net/link.kspls`.
//< How the bytes are built, and what the TCP leaves out, are in "How the bytes are assembled" in
//< ksos/docs/DESIGN.md.

// ==========================================
// Caution: **Copy bytes with `copy_from` in `std/bytes` and fill with `fill`** — with your own
// index loop, what happens on an overrun (a panic, or truncation) differs from place to place.
// ==========================================
// **Pass a received frame as `(buf, len)` with `len <= buf.len`** (the caller's promise, not
// checked here): the checks use `len` while the reads index `buf`, so a larger `len` reads bytes
// that never arrived.
// ==========================================
import "std/bytes"
import "std/chars"

const ethertype_arp: U16 = 0x0806
const ethertype_ipv4: U16 = 0x0800
const arp_hw_ethernet: U16 = 1
const arp_op_request: U16 = 1
const arp_op_reply: U16 = 2
const ip_proto_udp: U8 = 17
const ip_proto_tcp: U8 = 6

const tcp_flag_fin: U8 = 0x01
const tcp_flag_syn: U8 = 0x02
const tcp_flag_rst: U8 = 0x04
const tcp_flag_psh: U8 = 0x08
const tcp_flag_ack: U8 = 0x10

fn ip4(a: U8, b: U8, c: U8, d: U8): U32 //<
  //< Builds a 32-bit IPv4 address value from the four octets a.b.c.d
  return (U32::a << 24) | (U32::b << 16) | (U32::c << 8) | U32::d

fn put_mac(buf: U8$[], off: Sz, mac_hi: U32, mac_lo: U32) //<
  //< Writes a MAC held as two U32 into buf at off
  //<
  //< Inside this file a MAC (6 bytes) is split into two U32 (mac_hi = the top 2 bytes, mac_lo =
  //< the bottom 4).
  //<
  //< **It uses the _le writers, not _be**: this writes that internal form back in the original
  //< byte order, not in network order (get_mac reads it back the same way).
  buf.put_u32_le(off, mac_lo)
  buf.put_u16_le(off + 4, U16::mac_hi)

fn get_mac_lo(buf: U8[], off: Sz): U32 //< reads back a MAC in the form put_mac wrote
  //<
  //< off is the start of the MAC. It is also how a 6-byte MAC (a driver's mac_addr) is split into
  //< hi/lo, so no caller writes the shifts again.
  return buf.get_u32_le(off)

fn get_mac_hi(buf: U8[], off: Sz): U32
  return buf.get_u16_le(off + 4)

fn checksum16_step(acc: U32, buf: U8[], off: Sz, len: Sz): U32 //<
  //< Continues the unfinished 16-bit one's-complement sum defined by RFC 1071
  //<
  //< It adds [off, off+len) into acc without folding the carry or inverting, so a sum can span
  //< separate buffers (TCP's pseudo header plus the segment) with no copy. A single region
  //< needs only checksum16.
  $sum: U32 = acc
  for $i: Sz = 0; i < len; i += 2
    $word: U32 = buf[off + i] << 8
    if i + 1 < len
      word |= buf[off + i + 1]
    sum += word
  return sum

fn checksum16_finish(acc: U32): U16 //<
  //< Turns the sum built by checksum16_step into the checksum
  //<
  //< It folds in the carry and takes the one's complement.
  $sum: U32 = acc
  for (sum >> 16) != 0
    sum = (sum & 0xFFFF) + (sum >> 16)
  return U16::(~sum & 0xFFFF)

fn checksum16(buf: U8[], off: Sz, len: Sz): U16 //<
  //< Computes the 16-bit one's-complement checksum of RFC 1071 over the range [off, off+len)
  return checksum16_finish(checksum16_step(0, buf, off, len))

const eth_hdr_len: Sz = 14
const eth_min_frame: Sz = 60

priv fn pad_to_min(out: U8$[], len: Sz): Sz //<
  //< Pads with 0 to Ethernet's minimum frame length and returns the full length after padding
  //<
  //< Caution: A frame under 60 bytes breaks the standard, and some peers silently drop it.
  //< **Every function that builds a frame goes through this just before returning**, rather
  //< than padding in each place.
  if len >= eth_min_frame
    return len
  tail: = out.sub_mut(len, eth_min_frame - len)
  tail.fill(0)
  return eth_min_frame

priv fn fits(out: U8$[], need: Sz): Bool //<
  //< Whether a frame of need bytes (plus the 0 padding to the minimum length) fits out
  //<
  //< Caution: **Check it before starting to write.** `copy_from` and `sub_mut` silently truncate
  //< what does not fit, so the full length is returned for a partial frame and the caller sends
  //< bytes from outside the buffer onto the wire.
  want: = need if need > eth_min_frame else eth_min_frame
  return out.len >= want

const ipv4_hdr_len: Sz = 20 // with no options, as every frame built here has
const eth_ipv4_len: Sz = eth_hdr_len + ipv4_hdr_len

priv fn put_eth_ipv4(buf: U8$[], dst_mac_hi: U32, dst_mac_lo: U32, src_mac_hi: U32, src_mac_lo: U32,
  src_ip: U32, dst_ip: U32, proto: U8, ip_payload_len: Sz) //<
    //< Writes the Ethernet header and an IPv4 header with no options, checksum and all
    //<
    //< ip_payload_len is what follows the IPv4 header (the UDP or TCP header plus its payload);
    //< the caller has checked with fits that it all fits.
  const ip_off: Sz = eth_hdr_len
  put_mac(buf, 0, dst_mac_hi, dst_mac_lo)
  put_mac(buf, 6, src_mac_hi, src_mac_lo)
  buf.put_u16_be(12, ethertype_ipv4)
  buf[ip_off] = 0x45 // version=4, IHL=5 (20 bytes, no options)
  buf[ip_off + 1] = 0 // DSCP/ECN
  buf.put_u16_be(ip_off + 2, U16::(ipv4_hdr_len + ip_payload_len))
  buf.put_u16_be(ip_off + 4, 0) // identification
  buf.put_u16_be(ip_off + 6, 0) // flags/fragment offset
  buf[ip_off + 8] = 64 // TTL
  buf[ip_off + 9] = proto
  buf.put_u16_be(ip_off + 10, 0) // checksum (computed below)
  buf.put_u32_be(ip_off + 12, src_ip)
  buf.put_u32_be(ip_off + 16, dst_ip)
  ip_csum: = checksum16(buf, ip_off, ipv4_hdr_len)
  buf.put_u16_be(ip_off + 10, ip_csum)

priv struct Ipv4_view //< what ipv4_view found
  ok: Bool
  hdr_len: Sz //< from the IHL, options included
  total: Sz //< IP's Total Length: the header plus what follows it, without Ethernet's padding

priv fn ipv4_view(buf: U8[], len: Sz, proto: U8, min_payload: Sz): Ipv4_view //<
  //< Whether a received frame holds a whole, unfragmented IPv4 packet of proto
  //<
  //< min_payload is the least that must follow the IPv4 header (the next header's fixed part).
  //< Caution: **Take the header's length from the IHL**, or IP options make the next header be
  //< read from their middle. **Drop a fragment**: a later one has no next header, so its payload
  //< would be read as one (an ICMP "echo request" sending the peer's data back under our IP).
  none: Ipv4_view = ::{ .ok = false, .hdr_len = 0, .total = 0 }
  if len < eth_ipv4_len + min_payload || buf.get_u16_be(12) != ethertype_ipv4
    return none
  ver_ihl: = buf[eth_hdr_len]
  hdr_len: Sz = (ver_ihl & 0x0f) * 4
  if (ver_ihl >> 4) != 4 || hdr_len < ipv4_hdr_len
    return none
  // The low 13 bits are the fragment offset and the bit above them MF; either set means a fragment.
  if (buf.get_u16_be(eth_hdr_len + 6) & 0x3fff) != 0
    return none
  total: Sz = buf.get_u16_be(eth_hdr_len + 2)
  // Drop it if the declared length has not arrived (reading further goes outside the buffer).
  if total < hdr_len + min_payload || eth_hdr_len + total > len
    return none
  if buf[eth_hdr_len + 9] != proto
    return none
  return ::{ .ok = true, .hdr_len = hdr_len, .total = total }

// ==========================================
// The answering side (answering what arrives, rather than speaking first)
// These two are the side **the PC talks to** over USB Ethernet. Both return 0 if the frame is not
// addressed to us.
// ==========================================

const arp_frame_len: Sz = 42
const ip_proto_icmp: U8 = 1
const icmp_echo_request: U8 = 8
const icmp_echo_reply: U8 = 0

fn build_arp_reply(out: U8$[], req: U8[], len: Sz, our_ip: U32, our_mac_hi: U32, our_mac_lo: U32):
  Sz //<
    //< Answers an ARP request. 0 if it is not asking about our_ip.
  if len < arp_frame_len || !fits(out, arp_frame_len)
    return 0
  if req.get_u16_be(12) != ethertype_arp || req.get_u16_be(20) != arp_op_request
    return 0 // not ARP, or not a request
  // Caution: **Check the declared sizes before reading by offset.** The offsets 22, 28 and 38 hold
  // only for hwlen=6 / protolen=4; otherwise unrelated bytes go out as "that peer's address".
  if req.get_u16_be(14) != arp_hw_ethernet || req.get_u16_be(16) != ethertype_ipv4 ||
    req[18] != 6 || req[19] != 4
    return 0
  if req.get_u32_be(38) != our_ip
    return 0 // it is asking about another host
  out.copy_from(0, req.sub(6, 6)) // the destination = the requester
  out.copy_from(32, req.sub(22, 6)) // target MAC = the requester
  put_mac(out, 6, our_mac_hi, our_mac_lo)
  out.put_u16_be(12, ethertype_arp)
  out.put_u16_be(14, 1) // htype: Ethernet
  out.put_u16_be(16, ethertype_ipv4) // ptype
  out[18] = 6
  out[19] = 4
  out.put_u16_be(20, 2) // oper: a reply
  put_mac(out, 22, our_mac_hi, our_mac_lo)
  out.put_u32_be(28, our_ip)
  out.copy_from(38, req.sub(28, 4)) // target IP = the requester
  return pad_to_min(out, arp_frame_len)

fn build_icmp_echo_reply(out: U8$[], req: U8[], len: Sz, our_ip: U32, our_mac_hi: U32,
  our_mac_lo: U32): Sz //<
    //< Answers an ICMP echo request (a ping)
    //<
    //< 0 if it is not an echo request addressed to our_ip.
    //< Caution: **Return the identifier, the sequence number and the payload unchanged**, or the
    //< peer cannot match them and the ping looks unanswered.
  ip: = ipv4_view(req, len, ip_proto_icmp, 8)
  if !ip.ok || req.get_u32_be(eth_hdr_len + 16) != our_ip
    return 0
  ihl: = ip.hdr_len
  ip_total: = ip.total
  if req[eth_hdr_len + ihl] != icmp_echo_request
    return 0
  total: = eth_hdr_len + ip_total
  if !fits(out, total)
    return 0
  out.copy_from(0, req.sub(6, 6)) // the destination = the sender
  put_mac(out, 6, our_mac_hi, our_mac_lo)
  out.put_u16_be(12, ethertype_ipv4)
  // Copy the IP packet as it is, then rewrite only the direction and the type.
  out.copy_from(eth_hdr_len, req.sub(eth_hdr_len, ip_total))
  out[eth_hdr_len + 8] = 64 // a fresh TTL
  out.put_u32_be(eth_hdr_len + 12, our_ip)
  out.copy_from(eth_hdr_len + 16, req.sub(eth_hdr_len + 12, 4)) // the destination = the sender
  // Caution: **Zero the checksum before recomputing it**, or it is added in twice (IP and ICMP
  // each have one).
  out.put_u16_be(eth_hdr_len + 10, 0)
  ip_sum: = checksum16(out, eth_hdr_len, ihl)
  out.put_u16_be(eth_hdr_len + 10, ip_sum)
  out[eth_hdr_len + ihl] = icmp_echo_reply
  out.put_u16_be(eth_hdr_len + ihl + 2, 0)
  icmp_sum: = checksum16(out, eth_hdr_len + ihl, ip_total - ihl)
  out.put_u16_be(eth_hdr_len + ihl + 2, icmp_sum)
  return pad_to_min(out, total)

fn build_arp_request(buf: U8$[], sender_mac_hi: U32, sender_mac_lo: U32, sender_ip: U32,
  target_ip: U32): Sz //<
    //< Builds a broadcast ARP request (who-has target_ip? tell sender_ip) into buf
    //<
    //< It returns the full length after padding, or 0 if it does not fit (see fits).
  if !fits(buf, arp_frame_len)
    return 0
  bcast: = buf.sub_mut(0, 6)
  bcast.fill(0xFF) // the destination = the broadcast
  put_mac(buf, 6, sender_mac_hi, sender_mac_lo)
  buf.put_u16_be(12, ethertype_arp)

  buf.put_u16_be(14, arp_hw_ethernet)
  buf.put_u16_be(16, ethertype_ipv4) // ARP's proto field is the protocol's EtherType
  buf[18] = 6 // hwlen
  buf[19] = 4 // protolen
  buf.put_u16_be(20, arp_op_request)
  put_mac(buf, 22, sender_mac_hi, sender_mac_lo)
  buf.put_u32_be(28, sender_ip)
  target_mac: = buf.sub_mut(32, 6)
  target_mac.fill(0) // target MAC (unknown on a request, so 0)
  buf.put_u32_be(38, target_ip)

  return pad_to_min(buf, arp_frame_len)

struct Arp_reply
  ok: Bool
  sender_mac_hi: U32
  sender_mac_lo: U32

fn frame_ethertype(buf: U8[], len: Sz): U16 //<
  //< Returns a received frame's EtherType unchanged (0 = too short)
  //<
  //< For diagnosis: with mDNS/LLMNR/IPv6 frames mixed in, it tells "nothing arrived" apart from
  //< "it is being skipped".
  if len < 14
    return 0
  return buf.get_u16_be(12)

struct Arp_probe
  is_arp: Bool
  op: U16 //< 1 = request, 2 = reply
  sender_ip: U32
  sender_mac_hi: U32
  sender_mac_lo: U32

fn probe_arp(buf: U8[], len: Sz): Arp_probe //<
  //< If it is an ARP frame, returns its content unchanged, **without matching it**
  //<
  //< For diagnosis: parse_arp_reply says nothing when the expected peer itself is wrong, so this
  //< shows who sent the ARP that arrived.
  none: Arp_probe = ::{ .is_arp = false, .op = 0, .sender_ip = 0, .sender_mac_hi = 0,
    .sender_mac_lo = 0 }
  if len < arp_frame_len || buf.get_u16_be(12) != ethertype_arp
    return none
  mac_lo: = get_mac_lo(buf, 22)
  mac_hi: = get_mac_hi(buf, 22)
  return ::{ .is_arp = true, .op = buf.get_u16_be(20), .sender_ip = buf.get_u32_be(28),
    .sender_mac_hi = mac_hi, .sender_mac_lo = mac_lo }

fn parse_arp_reply(buf: U8[], len: Sz, expect_sender_ip: U32): Arp_reply //<
  //< Returns the sender MAC if buf[0..len) is an ARP reply from expect_sender_ip
  //<
  //< If it is not, the result's ok is false.
  arp: = probe_arp(buf, len)
  ok: = arp.is_arp && arp.op == arp_op_reply && arp.sender_ip == expect_sender_ip
  if !ok
    return ::{ .ok = false, .sender_mac_hi = 0, .sender_mac_lo = 0 }
  return ::{ .ok = true, .sender_mac_hi = arp.sender_mac_hi, .sender_mac_lo = arp.sender_mac_lo }

fn build_udp_packet(buf: U8$[], dst_mac_hi: U32, dst_mac_lo: U32, src_mac_hi: U32, src_mac_lo: U32,
  src_ip: U32, dst_ip: U32, src_port: U16, dst_port: U16, payload: U8[]): Sz //<
    //< Builds Ethernet (14) + IPv4 (20, no options) + UDP (8) + payload
    //<
    //< The UDP checksum is 0 (allowed on IPv4). It returns the padded full length, or 0 if it
    //< does not fit (see fits).
  const udp_off: Sz = eth_ipv4_len
  const payload_off: Sz = udp_off + 8
  udp_len: Sz = 8 + payload.len
  if !fits(buf, eth_ipv4_len + udp_len)
    return 0
  put_eth_ipv4(buf, dst_mac_hi, dst_mac_lo, src_mac_hi, src_mac_lo, src_ip, dst_ip, ip_proto_udp,
    udp_len)

  buf.put_u16_be(udp_off, src_port)
  buf.put_u16_be(udp_off + 2, dst_port)
  buf.put_u16_be(udp_off + 4, U16::udp_len)
  buf.put_u16_be(udp_off + 6, 0) // checksum=0 (optional on IPv4)

  buf.copy_from(payload_off, payload)

  return pad_to_min(buf, payload_off + payload.len)

struct Tcp_segment
  ok: Bool
  flags: U8
  seq: U32
  ack: U32
  payload_off: Sz
  payload_len: Sz

fn build_tcp_segment(buf: U8$[], dst_mac_hi: U32, dst_mac_lo: U32, src_mac_hi: U32, src_mac_lo: U32,
  src_ip: U32, dst_ip: U32, src_port: U16, dst_port: U16, seq: U32, ack: U32, flags: U8,
  payload: U8[]): Sz //<
    //< Builds Ethernet (14) + IPv4 (20, no options) + TCP (20, no options) + payload
    //<
    //< The caller manages seq/ack; flags combines tcp_flag_* (tcp_flag_syn to open,
    //< tcp_flag_ack|tcp_flag_psh for data). The window is fixed (no congestion or flow control).
  const tcp_off: Sz = eth_ipv4_len
  const tcp_hdr_len: Sz = 20 // fixed, with no options
  const payload_off: Sz = tcp_off + tcp_hdr_len
  tcp_total_len: Sz = tcp_hdr_len + payload.len
  if !fits(buf, eth_ipv4_len + tcp_total_len)
    return 0
  put_eth_ipv4(buf, dst_mac_hi, dst_mac_lo, src_mac_hi, src_mac_lo, src_ip, dst_ip, ip_proto_tcp,
    tcp_total_len)

  buf.put_u16_be(tcp_off, src_port)
  buf.put_u16_be(tcp_off + 2, dst_port)
  buf.put_u32_be(tcp_off + 4, seq)
  buf.put_u32_be(tcp_off + 8, ack)
  buf[tcp_off + 12] = 0x50 // data offset=5 words (20 bytes, no options), reserved=0
  buf[tcp_off + 13] = flags
  buf.put_u16_be(tcp_off + 14, 4096) // window (fixed; no congestion or flow control)
  buf.put_u16_be(tcp_off + 16, 0) // checksum (computed later)
  buf.put_u16_be(tcp_off + 18, 0) // urgent pointer (unused)

  buf.copy_from(payload_off, payload)

  // TCP's pseudo header (RFC 793): src_ip (4) + dst_ip (4) + zero (1) + proto (1) + the TCP
  // length (2), summed with the segment through checksum16_step.
  $pseudo: U8[12] = ::{}
  // Bind one descriptor and reuse it: a writer called on a cast's temporary is rejected with "a
  // temporary's address cannot be taken" (the receiver is `Self@`).
  ps: = U8$[]::pseudo
  ps.put_u32_be(0, src_ip)
  ps.put_u32_be(4, dst_ip)
  pseudo[8] = 0
  pseudo[9] = ip_proto_tcp
  ps.put_u16_be(10, U16::tcp_total_len)
  tcp_csum_acc: = checksum16_step(0, U8[]::pseudo, 0, 12)
  tcp_csum: = checksum16_finish(checksum16_step(tcp_csum_acc, buf, tcp_off, tcp_total_len))
  buf.put_u16_be(tcp_off + 16, tcp_csum)

  return pad_to_min(buf, payload_off + payload.len)

fn parse_tcp_segment(buf: U8[], len: Sz, expect_src_ip: U32, expect_src_port: U16,
  expect_dst_port: U16): Tcp_segment //<
    //< Whether a received frame is a TCP segment matching src_ip/src_port/dst_port
    //<
    //< It returns the flags, seq, ack and payload position; the checksum is not checked.
    //< Caution: **Take the payload's length from IP's Total Length** — the frame's length includes
    //< Ethernet's padding of short frames, so a pure ACK would add 6 zero bytes, peer_seq would run
    //< ahead, and every later segment would be dropped on a seq mismatch.
  none: Tcp_segment = ::{ .ok = false, .flags = 0, .seq = 0, .ack = 0, .payload_off = 0,
    .payload_len = 0 }
  const min_tcp_hdr: Sz = 20
  ip: = ipv4_view(buf, len, ip_proto_tcp, min_tcp_hdr)
  if !ip.ok || buf.get_u32_be(eth_hdr_len + 12) != expect_src_ip
    return none
  ip_hdr_len: = ip.hdr_len
  ip_total: = ip.total
  tcp_off: = eth_hdr_len + ip_hdr_len
  if buf.get_u16_be(tcp_off) != expect_src_port ||
    buf.get_u16_be(tcp_off + 2) != expect_dst_port
    return none
  // Caution: **Take the TCP header's length from its data offset**, or TCP options make the
  // payload start in the middle of them. Drop a data offset < 5.
  tcp_hdr_len: Sz = (buf[tcp_off + 12] >> 4) * 4
  if tcp_hdr_len < min_tcp_hdr || ip_hdr_len + tcp_hdr_len > ip_total
    return none
  return ::{
    .ok = true,
    .flags = buf[tcp_off + 13],
    .seq = buf.get_u32_be(tcp_off + 4),
    .ack = buf.get_u32_be(tcp_off + 8),
    .payload_off = tcp_off + tcp_hdr_len,
    .payload_len = ip_total - ip_hdr_len - tcp_hdr_len,
  }

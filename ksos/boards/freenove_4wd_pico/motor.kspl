//< The driving control for a Freenove 4WD mecanum car
//< A speed per wheel, and a mecanum's motion (forward-back, sideways, turning). The H bridge is
//< two PWMs per motor: the duty on one and 0 on the other, swapped for negative; both 0
//< freewheels. Each motor's pins are **the A/B channels of one PWM slice** (shared period,
//< separate duty; ksos/drivers/rp2040/pwm.kspl).
import "ksos/boards/freenove_4wd_pico/board"
import "ksos/drivers/mmio"
import "ksos/drivers/rp2040/pwm"
import "ksos/drivers/rp2040/timer"
import "std/math"

const SPEED_MAX: I32 = 100 //< the limit on a requested speed (as an absolute value)
    //< The same scale as the duty percentage.

fn init(): Void!mmio.Driver_error //<
    //< Initializes the PWM block, makes the eight motor pins PWM outputs and sets the period
    //< On a failure the PWM block did not leave reset, and no command takes effect. Every wheel is
    //< left stopped (the duty is written 0 here, since config_slice does not set it).
    pwm.init()!
    for w in Range.asc(board.WHEEL_COUNT)
        a: = board.MOTOR_PIN_A[w]
        b: = board.MOTOR_PIN_B[w]
        pwm.init_pin(a)
        pwm.init_pin(b)
        // The two pins share a slice; one period setting covers both.
        pwm.config_slice(pwm.slice_of(a), board.MOTOR_PWM_DIV_INT, 0, board.MOTOR_PWM_TOP)
    stop()

fn set_wheel(w: Sz, speed: I32) //< turns wheel w at speed `speed` (-100 to 100)
    //< board.wheel_polarity absorbs each wheel's actual direction of rotation.
    s: = speed * board.WHEEL_POLARITY[w]
    capped: = SPEED_MAX if s > SPEED_MAX else (-SPEED_MAX if s < -SPEED_MAX else s)
    // **Raise it to the duty at which the wheel starts turning** (the reason is at
    // `board.WHEEL_MIN_PERCENT`). 0 stays 0.
    $clamped: I32 = capped
    if capped > 0 && capped < board.WHEEL_MIN_PERCENT
        clamped = board.WHEEL_MIN_PERCENT
    else if capped < 0 && capped > 0 - board.WHEEL_MIN_PERCENT
        clamped = 0 - board.WHEEL_MIN_PERCENT
    a: = board.MOTOR_PIN_A[w]
    b: = board.MOTOR_PIN_B[w]
    top: = board.MOTOR_PWM_TOP
    if clamped >= 0
        pwm.set_percent(a, U32::clamped, top)
        pwm.set_percent(b, 0, top)
    else
        pwm.set_percent(a, 0, top)
        pwm.set_percent(b, U32::(-clamped), top)

// Whether the previous command left it stopped.
// Caution: **`stop` must update this too**, or the kick is missed after a stop.
priv $was_stopped: Bool = true

fn stop()
    for w in Range.asc(board.WHEEL_COUNT)
        set_wheel(w, 0)
    was_stopped = true

priv fn spread(longitudinal: I32, lateral: I32, rotation: I32, gain: I32) //<
    //< Mixes the triple and distributes it to the four wheels
    //< With `rotation` positive **the left two go forward and the right two back** (clockwise from
    //< above); reversed, line following turns **the wrong way**. **The sideways direction cannot be
    //< determined on paper** (the Arduino sample inverts its sign first).
    set_wheel(board.WHEEL_FRONT_LEFT, (longitudinal + lateral + rotation) * gain)
    set_wheel(board.WHEEL_BACK_LEFT, (longitudinal - lateral + rotation) * gain)
    set_wheel(board.WHEEL_BACK_RIGHT, (longitudinal + lateral - rotation) * gain)
    set_wheel(board.WHEEL_FRONT_RIGHT, (longitudinal - lateral - rotation) * gain)

fn drive(longitudinal: I32, lateral: I32, rotation: I32) //< combines a mecanum's motion
    //< longitudinal **positive = forward**, lateral **positive = right**, rotation **positive =
    //< clockwise**. A total over speed_max is clamped per wheel and the ratio is lost; normalize
    //< first to keep it.
    moving: = longitudinal != 0 || lateral != 0 || rotation != 0
    // **It kicks only when starting from a standstill** (the reason is at `board.KICK_GAIN`).
    if moving && was_stopped
        spread(longitudinal, lateral, rotation, board.KICK_GAIN)
        timer.delay_ms(board.KICK_MS)
    was_stopped = !moving
    spread(longitudinal, lateral, rotation, 1)

// ==========================================
// Scales the command sent to the wheels down to the speed cap
// The triple is forward-back, sideways and turning.
// **Do not clamp each component separately.**
// `CAP` is returned even when no scaling is needed, so callers need no special case.
// ==========================================
// ==========================================
// How it is used:
//   d: = cap.divisor(lon, lat, rot);
//   out: = lon * cap.cap / d;
// ==========================================

const CAP: I32 = 20 //< the cap in % on the size of the command sent to the wheels
    //< **This is the only value that sets the car's speed** (the manoeuvre table sets only how
    //< sharp a turn is). Lower, the line stays longer under the sensors: more reads, less
    //< overshoot.
    //< Caution: **Keep it just above `board.WHEEL_MIN_PERCENT`**: at that floor a wheel stalls, and
    //< higher the car overshoots the line.

fn divisor(lon: I32, lat: I32, rot: I32): I32 //< the divisor that brings the triple within `CAP`
    //< **If no scaling is needed it returns `CAP`.**
    m: = math.max(math.max(math.abs(lon), math.abs(lat)), math.abs(rot))
    return math.max(m, CAP)

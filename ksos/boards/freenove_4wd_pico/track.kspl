//< The three reflective sensors for line tracking on a Freenove 4WD mecanum car
//< It packs the three readings into the three bits **left<<2 | centre<<1 | right** (**white = 0 /
//< black = 1**).
//<
//< **This is the only function that reads them.** A caller could copy the packing. A fix to the
//< left-right swap (`board.LINE_SENSOR_SWAPPED`) in one copy only would then split the rule, and
//< nothing would show it. The packed bits go unchanged into both the policy's features and the
//< record. So a split would change what "the left is black" means on each path.
import "ksos/boards/freenove_4wd_pico/board"
import "ksos/drivers/rp2040/gpio"

fn init() //< sets up the three inputs
    //< **No pull is set** (the sensor board drives High/Low itself). All three are initialized
    //< whether or not they are swapped, so the order does not matter here.
    gpio.init_in(board.LINE_SENSOR_LEFT)
    gpio.init_in(board.LINE_SENSOR_MID)
    gpio.init_in(board.LINE_SENSOR_RIGHT)

priv fn left_pin(): U32 //<
    //< the pins of the leftmost and rightmost sensors as the car sees them
    //< Caution: **Do not read `board.LINE_SENSOR_LEFT` directly.** On a unit where left and right
    //< are swapped, the pin with that name is on the rightmost sensor.
    return board.LINE_SENSOR_RIGHT if board.LINE_SENSOR_SWAPPED else board.LINE_SENSOR_LEFT

priv fn right_pin(): U32
    return board.LINE_SENSOR_LEFT if board.LINE_SENSOR_SWAPPED else board.LINE_SENSOR_RIGHT

fn read_bits(): U32 //< packs the three readings into left<<2 | centre<<1 | right
    //< **1 = black.**
    $bits: U32 = 0
    if gpio.read(left_pin())
        bits |= 4
    if gpio.read(board.LINE_SENSOR_MID)
        bits |= 2
    if gpio.read(right_pin())
        bits |= 1
    return bits

//< The servo swinging the ultrasonic's head, held to the range the mechanism allows
//<
//< **Call `clocks.init()` first** (the servo's period comes from clk_sys).
import "ksos/boards/freenove_4wd_pico/board"
import "ksos/drivers/rp2040/servo"

fn init() //< sets up the head's servo pin
    servo.init(board.SERVO_HEAD_PIN)

fn clamp_angle(angle: I32): I32 //< clamps an angle in degrees to the head's range of motion
    //<
    //< Caution: **Do not widen it.** Beyond its range of motion the mechanism collides with itself
    //< (the range is `board.SERVO_ANGLE_MIN` / `max`).
    lo: = I32::board.SERVO_ANGLE_MIN
    hi: = I32::board.SERVO_ANGLE_MAX
    return lo if angle < lo else (hi if angle > hi else angle)

fn set_angle(angle: I32) //< points the head at an angle in degrees, clamped first
    servo.set_angle(board.SERVO_HEAD_PIN, clamp_angle(angle))

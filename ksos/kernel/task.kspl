//< The portable RTOS kernel core
//< Besides tasks (the `Task` struct), the priority scheduler and the cooperative yield and delay,
//< it offers preemptive round-robin on a periodic timer (`ksos_tick` / `enable_preemption`). The
//< port layer supplies the context switch at link time (the `ksos_port_*` C ABI). It depends on
//< neither hardware nor libc (the caller allocates the stacks and each `Task` statically).

// ==========================================
// `Task.delete()` **does not free the receiver's memory** (see `Task.delete`), so the
// use-after-free check and [W0107] do not apply to it.
// ==========================================
##lint(W0107 = off)

typedef Task_fn = fn(arg: Void$@): Void

enum Task_state //<
    //< pub because files outside that show the state, such as a task manager, read it
    ready
    running
    blocked
    delayed
    done
    suspended //< paused by Task.suspend (skipped by pick_next until Task.resume lets it run)

impl Task_state
    fn name(r: Self): U8$[] //< turns a task's state into a string for display
        switch r
        case .ready
            return "ready"
        case .running
            return "running"
        case .blocked
            return "blocked"
        case .delayed
            return "delayed"
        case .done
            return "done"
        case .suspended
            return "suspended"
        return "?" // unreachable (every variant is handled); written for the flow analysis

priv const STACK_GUARD_BYTES: Sz = 16 //<
    //< The known bytes Task.create writes at the stack's lowest address (a canary)
    //< Every schedule() checks them; if they are damaged, it is an overflow and it panics at once.
priv const STACK_GUARD_BYTE: U8 = 0xa5

struct Task
    priv ctx: Void$@ //< the context handle the port owns (opaque)
    priv entry: Task_fn
    priv arg: Void$@
    priv state: Task_state
    prio: I32 //< the priority it runs at: base_prio, raised while a mutex it holds is waited on
    base_prio: I32 //< its own priority, from Task.create (lent_prio returns prio to it)
    priv held: Holding$@ //< the mutexes it holds, a list Holding keeps (null if none)
    priv delay_until: U64 //<
        //< when a delayed task wakes; when blocked, the timeout (if deadline_set)
    priv deadline_set: Bool //< whether blocked has a timeout (without one it waits until woken)
    priv delay_kept: Bool //< whether it was suspended in a delay, which `resume` goes back to
    priv wait_obj: Void$@ //<
        //< the synchronization object waited on while blocked (null if none)
    priv wait_seq: U64 //< when it began its wait, as a count of waits (wake takes the lowest)
    priv woken_from: Void$@ //<
        //< what a single wake made it ready from, until it runs its recheck (null otherwise)
        //< Suspending or deleting it before then passes that wake on (`pass_on_wake`).
    wait_note: Void$@ //<
        //< the waiter's own record of its wait, for a primitive that decides at the wake (Event)
        //< It points into the waiter's frame, so read it only while `waits_on` says it is blocked.
    priv name: U8[]
    priv stack_guard: U8$@ //< its stack's lowest address (holding stack_guard_bytes of canary)
    priv cpu_ticks: U64 //< how many ticks found this task running (its CPU use)

priv const MAX_TASKS: Sz = 32

priv $g_tasks: Task$@[32]
priv $g_task_count: Sz = 0
$g_current: Task$@ = null // sync.kspl (Mutex.lock/unlock) uses it
priv $g_running: Bool = false // from start_scheduler's entry to its return
priv $g_stop: Bool = false // stop_scheduler asked start_scheduler to return
priv $g_tick: U64 = 0
priv $g_rr_start: Sz = 0 // where the search starts, for round-robin among equal priorities
priv $g_wait_seq: U64 = 0 // how many waits have begun (block_current stamps each wait with it)
priv $g_main_ctx: Void$@ = null
// --- The port ABI (each port implements it; POSIX: ksos/port/posix/ksos_port_posix.c) ---
extern "C"
    fn ksos_port_ctx_create(stack: U8$@, stack_size: Sz): Void$@ //< null when none is left
    fn ksos_port_ctx_create_main(): Void$@
    fn ksos_port_ctx_free(ctx: Void$@) //<
        //< returns a deleted task's context; it may be the running one, which a switch then leaves
    fn ksos_port_switch(from_ctx: Void$@, to_ctx: Void$@) //<
        //< saves the running task and runs to; a null from (a deleted task) saves none
        //< A port that records the running context itself (Cortex-M) does not read from.
    fn ksos_port_tick_start(reload: U32) //<
        //< starts the periodic timer (preemption); the port implements it
    fn ksos_port_irq_save(): U32 //<
        //< disables interrupts and returns the prior state (a critical section begins)
    fn ksos_port_irq_restore(state: U32) //< restores the interrupt state (a critical section ends)
    fn ksos_port_in_isr(): U32 //< non-zero inside an interrupt handler (0 with no handler mode)
    fn ksos_port_wait_irq() //<
        //< [Call it inside a critical section] sleeps until an interrupt, and lets its handler run
        //< It returns inside the critical section again. Opening the section and sleeping are one
        //< step, so an interrupt arriving after the caller's last look still wakes it.

priv fn find_task_slot(): Sz //<
    //< Reuses a free slot (a null slot released by Task.delete), or else adds one at the end
    //< It returns the g_tasks index to use, or max_tasks when the capacity is exceeded.
    $slot: Sz = g_task_count
    $found: = false
    for i in Range.asc(g_task_count)
        if !found && g_tasks[i] == null
            slot = i
            found = true
    if !found && g_task_count >= MAX_TASKS
        return MAX_TASKS
    return slot

// When the task table or the port's contexts are full, it touches neither tcb nor the stack. It
// then returns false (a caller can ignore that where the capacity is never reached). Task.delete
// returns both the slot and the context, so repeated create/delete never runs out. Called from a
// running task, a new task that outranks it runs before create returns (preempt_if_outranked).
impl Task
    fn create(r: Self$@, stack: U8$[], entry: Task_fn, arg: Void$@, prio: I32, name: U8[]): Bool
        // A stack too small to hold the canary is a configuration mistake. No run-time check can
        // catch it, so this check catches it here (like Queue.init's cap==0 check).
        assert(stack.len > STACK_GUARD_BYTES,
            "Task.create: the stack is too small for the overflow guard")
        // One critical section chooses and fills the slot. Otherwise a tick or another task between
        // the two would take the same slot, or schedule a task half written.
        s: = ksos_port_irq_save()
        defer ksos_port_irq_restore(s)
        slot: = find_task_slot()
        if slot >= MAX_TASKS
            return false
        ctx: = ksos_port_ctx_create(stack.ptr, stack.len)
        if ctx == null
            return false
        r.ctx = ctx
        r.entry = entry
        r.arg = arg
        r.state = .ready
        r.prio = prio
        r.base_prio = prio
        r.held = null
        r.delay_until = 0
        r.deadline_set = false
        r.delay_kept = false
        r.wait_obj = null
        r.wait_seq = 0
        r.woken_from = null
        r.wait_note = null
        r.name = name
        r.stack_guard = stack.ptr
        r.cpu_ticks = 0
        for i in Range.asc(STACK_GUARD_BYTES)
            stack[i] = STACK_GUARD_BYTE
        g_tasks[slot] = r
        if slot == g_task_count
            g_task_count += 1
        preempt_if_outranked()
        return true

priv fn slot_of(t: Task$@): Sz //< t's index in g_tasks, or max_tasks if it is not there
    $slot: Sz = MAX_TASKS
    for i in Range.asc(g_task_count)
        if g_tasks[i] == t
            slot = i
    return slot

priv fn end_task(t: Task$@) //< [Call it inside a critical section] makes t done
    //< Its entry returned, or Task.delete ended it.
    //< Caution: **A task ending with a mutex held is stopped.** Nobody could unlock that mutex, so
    //< every later lock would wait forever, and after delete_dyn it would name freed memory.
    if t.held != null
        panic("ksos: a task ended holding a mutex (unlock it before Task.delete or returning)")
    t.state = .done

priv fn check_stack_guard(t: Task$@) //< checks that t's stack guard is still as written
    //< If it is damaged, that is an overflow and it panics at once.
    for i in Range.asc(STACK_GUARD_BYTES)
        if (t.stack_guard + i)$ != STACK_GUARD_BYTE
            panic("ksos: stack overflow detected")
// The trampoline each port's initial context (from ksos_port_ctx_create) calls. It runs the
// current task's entry, marks it done and switches away for good. The task keeps its slot and
// context until Task.delete returns them.
// Caution: **Switch away inside the section that marks it done**, as Task.delete does. Outside it,
// a tick can run schedule() after an outer one chose the next task but before it switched. That
// saves this stack as the next task's context, so two tasks run on one stack.
#export
fn ksos_trampoline()
    t: = g_current
    if t != null
        e: = t.entry
        e(t.arg)
        s: = ksos_port_irq_save()
        end_task(t)
        schedule() // POSIX switches here; Cortex-M switches as the section ends
        ksos_port_irq_restore(s)
    // Unreachable (pick_next never picks a done task): a guard for a path that is never taken.
    for
        s: = ksos_port_irq_save()
        schedule()
        ksos_port_irq_restore(s)

priv fn wake_delayed_to(now: U64) //< makes ready every task that should wake by time now
    //< That covers both an expired delay and **the timeout of a task waiting with one**. A task
    //< woken by its timeout loses what it waited on. Its wake-and-recheck tells which it was.
    for i in Range.asc(g_task_count)
        t: = g_tasks[i]
        // t == null: a deleted slot waiting for reuse (see find_task_slot).
        if t == null || t.delay_until > now
            continue
        if t.state == .delayed
            t.state = .ready
        else if t.state == .blocked && t.deadline_set
            t.wait_obj = null
            t.deadline_set = false
            t.state = .ready

priv fn wakes_by_clock(t: Task$@): Bool //<
    //< Whether it is in a wait that ends by time (a delay, or blocked with a timeout)
    //< tickless idle uses it to find the next time to move the clock to.
    return t.state == .delayed || (t.state == .blocked && t.deadline_set)
priv fn pick_next(): Task$@? //< picks the runnable task with the highest priority
    //< **With none runnable it moves the clock forward without waiting in real time**, decoupling
    //< g_tick from real time, even with preemption enabled. That buys determinism, and under
    //< cooperative scheduling it is the only path that advances g_tick (without it no delay ends).
    for
        $best: Task$@ = null
        $best_prio: I32 = 0
        $best_idx: Sz = 0
        // Compare with ">", not ">=": the first highest-priority task from g_rr_start must win, or
        // round-robin among equal priorities breaks.
        for k in Range.asc(g_task_count)
            idx: = (g_rr_start + k) % g_task_count
            t: = g_tasks[idx]
            if t != null && t.state == .ready && (best == null || t.prio > best_prio)
                best = t
                best_prio = t.prio
                best_idx = idx
        if best != null
            g_rr_start = (best_idx + 1) % g_task_count
            return .some(best)
        // No runnable task: move the clock to the nearest expiry and wake that task
        $earliest: U64 = 0
        $have_delayed: = false
        for i in Range.asc(g_task_count)
            t: = g_tasks[i]
            if t != null && wakes_by_clock(t) && (!have_delayed || t.delay_until < earliest)
                earliest = t.delay_until
                have_delayed = true
        if !have_delayed
            return .none
        g_tick = earliest
        wake_delayed_to(g_tick)
priv fn schedule() //< switches from the current task to the next
    //< When no task is runnable it switches to start_scheduler, which sleeps until an interrupt
    //< or returns (see there).
    prev: = g_current
    if prev != null
        // prev's stack guard is checked at this single place, so it is checked even when
        // next==prev and the switch is skipped.
        check_stack_guard(prev)
    if prev != null && prev.state == .running
        // An explicit yield or preemption makes it a candidate again (block and delay have already
        // set the state).
        prev.state = .ready

    $next: Task$@ = null
    if t: = pick_next()
        next = t
    from_ctx: = prev.ctx if prev != null else g_main_ctx

    if next == null
        switch_to_main(from_ctx)
        return
    if next == prev
        next.state = .running
        return // the same task carries on: no context switch is needed
    g_current = next
    next.state = .running
    ksos_port_switch(from_ctx, next.ctx)

priv fn switch_to_main(from_ctx: Void$@) //< [Call it inside a critical section]
    //< Hands the CPU back to start_scheduler's loop, with no task current.
    g_current = null
    ksos_port_switch(from_ctx, g_main_ctx)

impl Task
    fn yield() //< the current task gives up the CPU voluntarily (a cooperative yield)
        //< It acts on the running task and takes no Task@ (like Java's `Thread.yield()`). From an
        //< ISR it panics: there it would switch the interrupted task out behind its back.
        refuse_in_isr()
        s: = ksos_port_irq_save()
        defer ksos_port_irq_restore(s) // restoring PRIMASK fires the pending PendSV and switches
        schedule()

    fn delay(ticks: U64) //<
        //< the current task sleeps for the given number of ticks (a relative time)
        //< **ticks are logical ticks, not real time.** It never wakes before the expiry, but when
        //< no other task is runnable it returns in zero real time. For a real-time period on
        //< hardware, use a hardware timer (`ksos/drivers/rp2040/timer.kspl` and the like).
        refuse_in_isr()
        s: = ksos_port_irq_save()
        defer ksos_port_irq_restore(s)
        if g_current != null
            g_current.state = .delayed
            g_current.delay_until = deadline_after(ticks)
        schedule()

    fn delay_until(wake_tick: U64) //<
        //< Unlike delay (a relative time), it sleeps until the absolute tick wake_tick
        //< A periodic task sleeping a relative time drifts by the length of its work; this does not
        //< (next += period; Task.delay_until(next);).
        refuse_in_isr()
        s: = ksos_port_irq_save()
        defer ksos_port_irq_restore(s)
        if g_current != null && wake_tick > g_tick
            g_current.state = .delayed
            g_current.delay_until = wake_tick
        schedule()

fn current_tick(): U64
    return g_tick

priv const LAST_TICK: U64 = 0xFFFFFFFFFFFFFFFFU64

fn deadline_after(ticks: U64): U64 //< the absolute tick ticks from now, for a delay or a timeout
    //< Caution: **It saturates at the last tick.** A plain `current_tick() + ticks` wraps for a
    //< huge ticks to a deadline already passed, and the wait meant to be long ends at once.
    d: = g_tick + ticks
    if d < g_tick
        return LAST_TICK
    return d

fn deadline_passed(deadline: U64?): Bool //<
    //< whether a wait's deadline has come (none: no deadline)
    if d: = deadline
        return g_tick >= d
    return false

impl Task
    fn suspend(r: Self$@) //<
        //< Takes r out of scheduling; it can be paused from any state (ready, delayed or blocked)
        //< Paused while blocked, it keeps what it waits on. But it lends a mutex's holder nothing
        //< while paused. Paused in a delay, it keeps the delay's expiry. A wake it had not yet
        //< acted on goes to the next waiter. If done or already paused, it does nothing. Pausing
        //< the current task, or a holder dropping below a ready task, switches at once.
        s: = ksos_port_irq_save()
        defer ksos_port_irq_restore(s)
        if r.state == .done || r.state == .suspended
            return
        was_current: = r == g_current
        r.delay_kept = r.state == .delayed
        r.state = .suspended
        pass_on_wake(r)
        if r.wait_obj != null // a paused waiter no longer counts among the holder's lenders
            relend_all()
        if was_current
            schedule()
        else
            preempt_if_outranked()

    fn resume(r: Self$@) //< lets a paused r run again
        //< **A delay not yet expired goes on to its expiry**, since `delay` never returns early;
        //< one that expired while paused wakes at once. It does not recheck a wait's condition; the
        //< wake-and-recheck loop in Sem.take and the like does that when it next runs. From any
        //< state other than suspended it does nothing.
        s: = ksos_port_irq_save()
        defer ksos_port_irq_restore(s)
        if r.state != .suspended
            return
        if r.delay_kept && r.delay_until > g_tick
            r.state = .delayed
            return
        r.state = .ready
        preempt_if_outranked()

    fn delete(r: Self$@) //<
        //< Makes r done and returns its g_tasks slot and its port context for a later create
        //< The Task's and the stack's memory stay the caller's (static, or from create_dyn in
        //< ksos/kernel/dynamic.kspl). This method does not free them. A task whose entry
        //< returned is done but keeps both until deleted. Deleting again does nothing. A deleted
        //< waiter leaves its wait, and the kernel takes back what it lent a mutex's holder. A wake
        //< it had not yet acted on goes to the next waiter.
        s: = ksos_port_irq_save()
        defer ksos_port_irq_restore(s)
        slot: = slot_of(r)
        if slot >= MAX_TASKS
            return // deleted already
        if r.state != .done
            end_task(r)
        g_tasks[slot] = null
        pass_on_wake(r)
        waited: = r.wait_obj != null // blocked, or suspended while blocked
        r.wait_obj = null
        if waited
            relend_all()
        // The context goes back now even for the running task: schedule() then switches with a
        // null from, which saves nothing into it.
        ksos_port_ctx_free(r.ctx)
        r.ctx = null
        if r == g_current
            schedule()
        else
            preempt_if_outranked()

    fn get_name(r: Self$@): U8[] //<
        //< The getters for the name, the priority, the state and the CPU use (ticks accumulated)
        //< The fields are visible only inside ksos/kernel/; these methods expose them to other
        //< files.
        return r.name
    fn get_prio(r: Self$@): I32
        return r.prio
    fn get_state(r: Self$@): Task_state
        return r.state
    fn waits_on(r: Self$@, obj: Void$@): Bool //< whether r is blocked waiting on obj
        //< [Call it inside a critical section] Only then is r's `wait_note` its live record.
        return r.state == .blocked && r.wait_obj == obj
    fn get_cpu_ticks(r: Self$@): U64 //<
        //< How many of ksos_tick()'s firings found r as g_current (accumulated)
        //< Its ratio to current_tick() gives a rough CPU use (`cpu_percent`).
        return r.cpu_ticks
    fn cpu_percent(r: Self$@): I32 //< CPU use (%, an approximate integer from 0 to 100)
        //< ksos_tick() samples it per tick. Without enable_preemption() (cooperative only)
        //< current_tick() does not advance, and it always returns 0. **Heap use is not offered
        //< here**: call `heap_used_bytes` / `heap_peak_used_bytes` in `std/mem.kspl` directly, as
        //< a pass-through would be a second entry point for one question.
        total: = current_tick()
        if total == 0
            return 0
        return I32::((r.get_cpu_ticks() * 100) / total)
impl Task
    // --- Reading the task listing and the states (a task manager and the rest use it) ---
    fn current(): Task$@ //<
        //< Returns the running task's own Task@ (like Java's `Thread.currentThread()`)
        //< g_tasks is priv, so files that walk every task use count and at, a read-only snapshot.
        //< at can return null for a deleted slot, so always check for null.
        return g_current
    fn count(): Sz
        return g_task_count
    fn at(i: Sz): Task$@
        return g_tasks[i]
// --- The critical section (the synchronization primitives and the drivers use it) ---
fn irq_save(): U32 //< the port's interrupt disable, offered as a kernel API
    //< Caution: **Do not copy the port's names around**: an `extern "C"` declaration in each file
    //< multiplies the places that know the ABI. task.kspl itself calls ksos_port_irq_save/restore
    //< directly.
    return ksos_port_irq_save()
fn irq_restore(state: U32) //< ends the critical section the matching irq_save began
    //< Caution: **Between a give and this restore, do not act on the running task.** Do not call
    //< Task.current, a delay, a yield, a lock or a take. A give that woke a higher-priority task
    //< has already made it current, and on Cortex-M the switch to it waits for this restore.
    ksos_port_irq_restore(state)
// --- The blocking helpers shared by the synchronization primitives (sem and msgq use them) ---
priv fn block_current(obj: Void$@) //<
    //< Blocks the current task on obj and pends the switch to the next task
    //< Call it inside a critical section. The switch happens when the caller's irq_restore ends the
    //< critical section, so "check the condition, then block" is indivisible and no wakeup is
    //< lost. Each wait carries the time it began, so wake can take the longest waiter. A task
    //< that wakes and waits again goes to the back.
    cur: = g_current
    if cur != null
        g_wait_seq += 1
        cur.wait_seq = g_wait_seq
        cur.wait_obj = obj
        cur.state = .blocked
        schedule()
fn refuse_in_isr() //<
    //< Precondition (1) for a task-only operation: it is not inside an interrupt handler
    //< What an ISR may call is what does not wait (give / set / try_send / try_recv / try_take).
    //< Caution: **Call it before anything that depends on the resource's state**, or the misuse
    //< passes whenever the call would not have had to wait. Keep the message a fixed string
    //< (building a Str_builder on a panic's path allocates).
    if ksos_port_in_isr() != 0
        panic("ksos: task-only call inside an ISR (an ISR cannot wait; use give / set / try_ there)")
fn require_current(): Task$@ //<
    //< Precondition (2) for a task-only operation: a task is running
    //< Caution: **Do not start a wait without going through here.** block_current silently ignores
    //< null, and the wake-and-recheck loop spins forever (a hang with no diagnostic). Keep the
    //< message a fixed string (see refuse_in_isr).
    refuse_in_isr()
    cur: = g_current
    if cur == null
        panic("blocking sync op without a running scheduler (before start_scheduler, or after all \
            tasks ended)")
    return cur
fn wake(obj: Void$@, all: Bool) //<
    //< [Call it inside a critical section] Makes the tasks waiting on obj ready
    //< One is the highest-priority waiter, the longest waiting among equals. A woken task that
    //< outranks the running one runs before this returns (preempt_if_outranked), so call it last.
    make_ready_waiters(obj, all)
    preempt_if_outranked()

priv fn make_ready_waiters(obj: Void$@, all: Bool) //<
    //< [Call it inside a critical section] wake without the switch
    //< The one waiter that a single wake picks keeps obj in woken_from until it runs its recheck.
    //< It takes the resource only then. So a waiter stopped before that must hand the wake on
    //< (pass_on_wake). Waking all needs no record, as every waiter checks again.
    $best: Task$@ = null
    // Caution: **Do not pick one by table order.** A low-priority waiter earlier in the table would
    // take the resource while the high-priority one waits (priority inversion again). Among
    // equals, the earlier one would take every give while the later one starves.
    for i in Range.asc(g_task_count)
        t: = g_tasks[i]
        if t == null || t.state != .blocked || t.wait_obj != obj
            continue
        if all
            t.wait_obj = null
            t.deadline_set = false
            t.state = .ready
        else if best == null || t.prio > best.prio ||
            (t.prio == best.prio && t.wait_seq < best.wait_seq)
            best = t
    if best != null
        best.wait_obj = null
        best.deadline_set = false
        best.state = .ready
        best.woken_from = obj

priv fn pass_on_wake(t: Task$@) //<
    //< [Call it inside a critical section] Hands a wake t has not acted on to the next waiter
    //< For a task leaving the run (suspended or deleted) between its wake and its recheck. Without
    //< it the resource stays free while the next waiter waits for ever. If the resource is gone by
    //< then, the waiter woken here checks again and waits again. It does not switch; the caller
    //< does, once t is out of the way.
    obj: = t.woken_from
    if obj != null
        t.woken_from = null
        make_ready_waiters(obj, false)

priv fn preempt_if_outranked() //<
    //< [Call it in a critical section] Switches to a ready task that outranks the running one
    //< It compares every ready task. One can have just become ready. Or the running task can
    //< have just dropped below one (a lent priority returned). Equal priority does not cut in.
    //< The switch runs before the interrupted code goes on, timer or not ("Which task runs" in
    //< ksos/docs/DESIGN-rtos.md says when, per port).
    cur: = g_current
    if cur == null
        return
    for i in Range.asc(g_task_count)
        t: = g_tasks[i]
        if t != null && t.state == .ready && t.prio > cur.prio
            schedule()
            return

priv fn highest_waiter_prio(obj: Void$@): I32 //<
    //< [Call it inside a critical section] The highest priority among the tasks waiting on obj
    //< 0 if nobody waits (an application's tasks have 1 or more). lent_prio is built on it.
    $top: I32 = 0
    for i in Range.asc(g_task_count)
        t: = g_tasks[i]
        if t != null && t.state == .blocked && t.wait_obj == obj && t.prio > top
            top = t.prio
    return top
// ============================ Who holds which mutex ============================
// The kernel core keeps each mutex's holder, and each holder's list of what it holds. (sync.kspl's
// Mutex embeds a Holding, and waits on its address.) So Task.delete can refuse a holder, and can
// take back what a deleted waiter lent.
struct Holding //< one mutex's ownership: its holder, and the next mutex in that holder's list
    priv holder: Task$@ //< null when free
    priv next: Holding$@

impl Holding
    fn init(r: Self$@)
        r.holder = null
        r.next = null
    fn get_holder(r: Self$@): Task$@ //< the holder (null when free)
        return r.holder
    fn take(r: Self$@, me: Task$@) //<
        //< [Call it inside a critical section] Makes me the holder, and adds r to me's list
        r.holder = me
        r.next = me.held
        me.held = r
    fn release(r: Self$@) //<
        //< [Call it inside a critical section] Frees r and takes it out of its holder's list
        //< It then sets the holder's priority to what the mutexes it still holds lend it.
        h: = r.holder
        $prev: Holding$@ = null
        $m: = h.held
        for m != null && m != r
            prev = m
            m = m.next
        if prev == null
            h.held = r.next
        else
            prev.next = r.next
        r.next = null
        r.holder = null
        h.prio = lent_prio(h)

fn lent_prio(h: Task$@): I32 //<
    //< [Call it inside a critical section] The priority h runs at for the mutexes it holds
    //< The highest of its own priority and of every task waiting on one of them. A single
    //< per-mutex saved priority cannot give this: releasing one mutex would drop a priority still
    //< lent through another.
    $top: = h.base_prio
    $m: = h.held
    for m != null
        w: = highest_waiter_prio(Void$@::m)
        if w > top
            top = w
        m = m.next
    return top

priv fn relend_all() //<
    //< [Call it inside a critical section] sets each holder's priority to lent_prio
    //< For a waiter that left without its lock loop (a deleted one), whose holder is not kept.
    for i in Range.asc(g_task_count)
        t: = g_tasks[i]
        if t != null && t.held != null
            t.prio = lent_prio(t)

fn block_and_rearm(obj: Void$@, deadline: U64?, state: U32): U32 //<
    //< [Call it inside a critical section] Blocks on obj and returns the new state once woken
    //< It is the shared part of the wake-and-recheck loop of sem, msgq, mutex and event. If no one
    //< wakes it by deadline, the clock (ksos_tick / tickless idle) does; none waits until woken.
    //< Caution: Take an absolute time (deadline_after), not a relative tick; a relative one
    //< restarted on every re-wait lets the timeout run on forever.
    cur: = g_current
    if cur != null
        cur.deadline_set = false
        if d: = deadline
            cur.delay_until = d
            cur.deadline_set = true
    block_current(obj)
    ksos_port_irq_restore(state) // ending the critical section performs the switch (the block)
    s: = ksos_port_irq_save() // enter the critical section again once woken
    if cur != null
        cur.woken_from = null // its recheck runs next, in this critical section: the wake is used
    return s
fn enable_preemption(reload: U32) //< turns preemption on
    //< It starts the port's periodic timer (SysTick on Cortex-M, SIGALRM/setitimer on POSIX), which
    //< calls ksos_tick() and forces task switches on the time slice. Not on a port with no timer.
    ksos_port_tick_start(reload)

// ============================ Converting to real time ============================
// A tick is logical time (like FreeRTOS's tick). **The kernel does not know how long a tick is**:
// the reload is in the port's unit, so **the application declares** the ticks per second.
priv $g_tick_hz: U32 = 0

fn declare_tick_hz(hz: U32)
    assert(hz > 0, "declare_tick_hz: hz must be greater than 0")
    g_tick_hz = hz

fn ms_to_ticks(ms: U32): U64 //< converts ms to ticks
    //< **It rounds up**: rounding down would make a short ms 0 ticks, which gives up without
    //< waiting.
    if g_tick_hz == 0
        panic("ms_to_ticks: call declare_tick_hz first (the kernel does not know the tick rate)")
    hz: U64 = g_tick_hz
    return (hz * ms + 999) / 1000

// ============================ The idle task ============================
typedef Idle_hook = fn(): Void //<
    //< The function the idle task calls on every round
    //< The idle task is the lowest-priority task (prio=0), which runs only while no other task is
    //< runnable. The hook is mainly reap_pending in ksos/kernel/dynamic.kspl.

priv $g_idle_tcb: Task
priv $g_idle_hook: Idle_hook = Idle_hook::null

fn idle_entry(_arg: Void$@): Void
    for
        h: = g_idle_hook
        if h != null
            h()
        idle_rest()

priv fn idle_rest() //< the idle task's pause between two calls of its hook
    //< **With no other task ready and none waiting on the clock, it sleeps until an interrupt.**
    //< Going round again would spin the CPU at full use for as long as the rest stay blocked.
    //< Otherwise it sleeps one tick, so tickless idle moves the clock to the next expiry.
    s: = ksos_port_irq_save()
    defer ksos_port_irq_restore(s)
    me: = g_current
    for i in Range.asc(g_task_count)
        t: = g_tasks[i]
        if t != null && t != me && (t.state == .ready || wakes_by_clock(t))
            me.state = .delayed
            me.delay_until = deadline_after(1)
            schedule()
            return
    ksos_port_wait_irq()

fn enable_idle_task(stack: U8$[], hook: Idle_hook) //<
    //< The caller allocates stack statically (as with the other create APIs)
    //< Call it once only. The idle task never ends, so start_scheduler then returns only on
    //< stop_scheduler.
    g_idle_hook = hook
    g_idle_tcb.create(stack, idle_entry, null, 0, "idle")

// The tick work, called from the periodic timer's interrupt (the ISR).
// No other tick can re-enter it. The Cortex-M port gives SysTick and PendSV the same priority (see
// ksos_port_cm.c). The POSIX port blocks SIGALRM inside its own handler (see
// ksos_port_posix.c). It still takes the critical section. An interrupt of higher priority than
// SysTick can give, and that give's schedule must not run in the middle of this one.
#export
fn ksos_tick()
    s: = ksos_port_irq_save()
    defer ksos_port_irq_restore(s)
    g_tick += 1
    if g_current == null
        return // before the scheduler starts, or while it sleeps, only the clock advances
    // Count one tick for g_current: CPU use by sampling, like top and ps, at the tick's resolution.
    g_current.cpu_ticks += 1
    wake_delayed_to(g_tick)
    schedule()
fn start_scheduler() //< runs the registered tasks until none remains or stop_scheduler is called
    //< **While the tasks left are all blocked with no deadline, it sleeps until an interrupt**
    //< and looks again. Once it returned, no handler's give could start it again. A task remains
    //< until it is done or deleted. A later call carries on the tasks a stop_scheduler left.
    s: = ksos_port_irq_save()
    if g_main_ctx == null
        g_main_ctx = ksos_port_ctx_create_main() // made once: a second start reuses it
    g_running = true
    g_stop = false
    ksos_port_irq_restore(s)
    // One critical section runs from choosing a task to the switch into it, as in schedule(). A
    // tick between the two would save this loop's state as the task's context. The task would then
    // never run its own code. The switch happens as the section ends (Cortex-M) or under the port's
    // own mask (POSIX). So a tick held meanwhile arrives on the task's stack, after the switch.
    for
        st: = ksos_port_irq_save()
        if g_stop || !any_task_left()
            g_running = false
            ksos_port_irq_restore(st)
            return
        if t: = pick_next()
            g_current = t
            t.state = .running
            ksos_port_switch(g_main_ctx, t.ctx) // comes back here once no task is runnable
        else
            ksos_port_wait_irq()
        ksos_port_irq_restore(st)

priv fn any_task_left(): Bool //< whether any task has not ended (a blocked or paused one counts)
    for i in Range.asc(g_task_count)
        t: = g_tasks[i]
        if t != null && t.state != .done
            return true
    return false

fn stop_scheduler() //< makes start_scheduler return, leaving every task where it is
    //< From a task, it switches to start_scheduler's caller at once. The task stays ready, and a
    //< later start_scheduler carries it on from here. From an interrupt handler, it switches as
    //< the handler returns. It panics while no scheduler runs, where it would have nothing to stop.
    s: = ksos_port_irq_save()
    defer ksos_port_irq_restore(s)
    if !g_running
        panic("ksos: stop_scheduler while no scheduler runs")
    g_stop = true
    cur: = g_current
    if cur == null
        return // start_scheduler is between tasks (an ISR while it sleeps): it looks next
    check_stack_guard(cur)
    cur.state = .ready
    switch_to_main(cur.ctx)

fn run_single_task(tcb: Task$@, stack: U8$[], entry: Task_fn, name: U8[], on_idle: fn(): Void) //<
    //< Runs a single task at priority 1, then calls on_idle and loops forever
    //< It registers the task and starts the scheduler; on_idle is called once the task is done.
    //< It serves as a single-task demo's ksos_main. on_idle, not this file, knows how to end the
    //< run, so this file depends on no layer above.
    tcb.create(stack, entry, null, 1, name)
    start_scheduler()
    on_idle()
    for {}

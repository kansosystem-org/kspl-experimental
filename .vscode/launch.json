{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "▶ Debug Current KSPL File",
            "program": "${workspaceFolder}/out/${fileBasenameNoExtension}.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "ASAN_OPTIONS": "detect_leaks=0"
            },
            "preLaunchTask": "build-current-file",
            "initCommands": [
                "command script import ${workspaceFolder}/tools/kspl_lldb.py"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "⚙️ Debug KSPL Compiler",
            "program": "${workspaceFolder}/out/ksplc_stage1.exe",
            "args": [
                "tests/debug/main.kspls",
                "out/test_debug.c"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "ASAN_OPTIONS": "detect_leaks=0"
            },
            "preLaunchTask": "build-compiler",
            "initCommands": [
                "command script import ${workspaceFolder}/tools/kspl_lldb.py"
            ]
        }
    ]
}
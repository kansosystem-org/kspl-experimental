{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "kspeg Grammar",
	"scopeName": "source.kspeg",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#keywords" },
		{ "include": "#charClasses" },
		{ "include": "#definitions" },
		{ "include": "#operators" },
		{ "include": "#identifiers" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.kspeg",
					"match": "//.*$"
				},
				{
					"name": "comment.block.kspeg",
					"begin": "/\\*",
					"end": "\\*/",
					"patterns": [
						{ "include": "#comments" }
					]
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.kspeg",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.kspeg",
					"match": "\\\\[nrt\"'\\\\\\[\\]\\-]"
				}
			]
		},
		"keywords": {
			"name": "string.quoted.single.kspeg",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.kspeg",
					"match": "\\\\[nrt\"'\\\\\\[\\]\\-]"
				}
			]
		},
		"charClasses": {
			"name": "string.regexp.kspeg",
			"begin": "\\[",
			"end": "\\]",
			"patterns": [
				{
					"name": "constant.character.escape.kspeg",
					"match": "\\\\[nrt\"'\\\\\\[\\]\\-]"
				},
				{
					"name": "constant.range.kspeg",
					"match": "\\-"
				}
			]
		},
		"definitions": {
			"match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
			"captures": {
				"1": { "patterns": [{ "include": "#identifiers" }] },
				"2": { "name": "keyword.operator.assignment.kspeg" }
			}
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.control.kspeg",
					"match": "\\||\\&|\\!|\\*|\\?|\\+"
				},
				{
					"name": "constant.language.wildcard.kspeg",
					"match": "\\."
				},
				{
					"name": "meta.brace.round.kspeg",
					"match": "\\(|\\)"
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"match": "\\b_\\b",
					"name": "keyword.language.skip.kspeg"
				},
				{
					"match": "\\b_[A-Z][A-Za-z0-9_]*\\b",
					"name": "support.class.kspeg"
				},
				{
					"match": "\\b_[a-z][A-Za-z0-9_]*\\b",
					"name": "support.function.kspeg"
				},
				{
					"match": "\\b[A-Z][A-Za-z0-9_]*\\b",
					"name": "entity.name.type.class.kspeg"
				},
				{
					"match": "\\b[a-z][A-Za-z0-9_]*\\b",
					"name": "entity.name.function.kspeg"
				}
			]
		}
	}
}
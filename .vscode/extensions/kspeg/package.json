{
    "name": "kspeg",
    "publisher": "kanso",
    "displayName": "Kanso PEG (KSPEG)",
    "description": "Grammar support for Kanso Parsing Expression Grammar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/kansosystem-org/kspl-experimental"
    },
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.46.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:kspeg"
    ],
    "contributes": {
        "languages": [{
            "id": "kspeg",
            "aliases": ["kspeg", "KSPEG"],
            "extensions": [".kspeg"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "kspeg",
            "scopeName": "source.kspeg",
            "path": "./tmLanguage.json"
        }]
    }
}
{
    "name": "kspl",
    "publisher": "kanso",
    "displayName": "Kanso Programming Language",
    "description": "Language support for Kanso (KSPL)",
    "icon": "icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/kansosystem-org/kspl-experimental"
    },
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.67.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:kspl"
    ],
    "contributes": {
        "configuration": {
            "title": "Kanso",
            "properties": {
                "kspl.serverPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "description": "Path to the Kanso LSP server executable.\nIf empty, the bundled server is used.\nMachine-scoped on purpose: a workspace must not be able to point this at another program, because VS Code launches it when the folder is opened."
                },
                "kspl.trace.server": {
                    "type": "string",
                    "enum": ["off", "messages", "verbose"],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the Kanso LSP server."
                },
                "kspl.defines": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "description": "#cfg() flags to assume while analyzing, same as the compiler's -D (e.g. [\"blas\"]).\nDeclarations guarded by a flag you do not list are dropped before analysis, exactly as the compiler drops them, so hover and go-to-definition return nothing there."
                }
            }
        },
        "languages": [{
            "id": "kspl",
            "aliases": ["KSPL", "Kanso"],
            "extensions": [".kspl"],
            "icon": { "light": "./kspl-file.svg", "dark": "./kspl-file.svg" },
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "kspl",
            "scopeName": "source.kspl",
            "path": "./tmLanguage.json"
        }]
    }
}
{
    "comments": {
        "lineComment": "//"
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<|", "|>"]
    ],
    "colorizedBracketPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<|", "|>"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "<|", "close": "|>", "notIn": ["string", "comment"] },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "\"\"\"", "close": "\"\"\"", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<|", "|>"],
        ["\"", "\""],
        ["'", "'"],
        ["\"\"\"", "\"\"\""]
    ],
    "$comment": "Caution: **kspl and kspls both point at this same file.** The brackets, the auto-closing and the note notation are the same for both, so no copy is held (see languages in package.json).",
    "indentationRules": {
        "$comment": "The second branch is the heading of a block in the notation written by indentation (.kspls). **It is safe on .kspl too** — that side's headings always end in `{`, so the first branch matches first, and a declaration with no body ends in `;`, so it falls outside this branch.",
        "increaseIndentPattern": "^.*(\\{[^}\"']*|\\([^)\"']*|\\[[^\\]\"']*|<\\|[^|>\"']*)$|^\\s*(pub |priv )?(fn|struct|enum|trait|impl|extern|if|else|for|switch|case|default|defer)\\b.*[^;{,]$",
        "decreaseIndentPattern": "^\\s*(\\}|\\)|\\]|\\|>)"
    },
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\$\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
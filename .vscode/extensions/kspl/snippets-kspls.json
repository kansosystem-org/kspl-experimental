{
    "$comment": "Caution: **These are not a copy of snippets.json.** They are the templates for the notation written by indentation (.kspls): the braces and the `;` disappearing is what this notation is, so the body is always different. tests/suite/vscode_test.kspls guards that the set of prefixes agrees across both.",
    "Main Function": {
        "prefix": "main",
        "body": [
            "fn main(): I32",
            "\t$0"
        ],
        "description": "A Kanso program's entry point"
    },
    "Function Definition": {
        "prefix": "fn",
        "body": [
            "fn ${1:name}(${2:args})${3:: RetType}",
            "\t$0"
        ],
        "description": "An ordinary function definition"
    },
    "Method Definition": {
        "prefix": "mfn",
        "body": [
            "fn ${1:name}(r: Self@${2:, args})${3:: RetType}",
            "\t$0"
        ],
        "description": "A method definition with a pointer receiver"
    },
    "Struct Definition": {
        "prefix": "struct",
        "body": [
            "struct ${1:Name}",
            "\t${2:field}: ${3:Type}",
            "\t$0"
        ],
        "description": "A struct definition"
    },
    "Enum (Tagged Union)": {
        "prefix": "enum",
        "body": [
            "enum ${1:Name}",
            "\t${2:variant}",
            "\t$0"
        ],
        "description": "An enum / tagged-union definition"
    },
    "Impl Block": {
        "prefix": "impl",
        "body": [
            "impl ${1:Type}",
            "\t$0"
        ],
        "description": "An implementation block of methods for a type"
    },
    "Loop (C-Style)": {
        "prefix": "forc",
        "body": [
            "for ${1:i}: Sz = 0; ${1:i} < ${2:len}; ${1:i} += 1",
            "\t$0"
        ],
        "description": "A C-style loop"
    },
    "Loop (While-Style)": {
        "prefix": "forw",
        "body": [
            "for ${1:condition}",
            "\t$0"
        ],
        "description": "A while-style loop"
    },
    "Loop (Infinite)": {
        "prefix": "fori",
        "body": [
            "for",
            "\t$0"
        ],
        "description": "An infinite loop"
    },
    "Match Statement": {
        "prefix": "switch",
        "body": [
            "switch ${1:expr}",
            "\tcase .${2:variant}",
            "\t\t$3",
            "\tdefault",
            "\t\t$0"
        ],
        "description": "Pattern matching"
    },
    "Catch Block": {
        "prefix": "catch",
        "body": [
            "catch ${1:e}",
            "\tthrow ${1:e}$0"
        ],
        "description": "Catching and propagating an error from an Error Union type"
    },
    "Defer Statement": {
        "prefix": "defer",
        "body": [
            "defer",
            "\t${1:free}(${2:ptr})",
            "\t$0"
        ],
        "description": "A deferred block, for releasing a resource and the like"
    },
    "Embed Resource": {
        "prefix": "embed",
        "body": [
            "embed \"${1:assets/file.bin}\" as ${2:NAME}"
        ],
        "description": "Embedding an external file as a byte array"
    },
    "Extern Block": {
        "prefix": "extern",
        "body": [
            "extern \"C\"",
            "\tfn ${1:function_name}(${2:args}): ${3:RetType}",
            "\t$0"
        ],
        "description": "An external function declaration block, for interoperating with C"
    },
    "Catch Fallback Expression": {
        "prefix": "catchf",
        "body": [
            "catch ${1:fallback_value}"
        ],
        "description": "Returning a fallback value directly from an Error Union (expression form)"
    },
    "Sizeof Expression": {
        "prefix": "sizeof",
        "body": [
            "sizeof(${1:TypeOrExpr})"
        ],
        "description": "Taking the memory size of a type or an expression"
    }
}

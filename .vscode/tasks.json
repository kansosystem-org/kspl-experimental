// Caution: **Each problem matcher captures `info`, not `information`.** VS Code knows only
// `error`, `warning`, `info` and `hint`, and turns any other word into an error. `[a-z]*` takes
// the rest of ksplc's word.
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-current-file",
            "type": "process",
            "command": "make",
            "args": ["debug-file", "SRC_KSPL=${relativeFile}"],
            "group": "build",
            "problemMatcher": [
                {
                    "owner": "kanso",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning|info|hint)[a-z]*:\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "build-compiler",
            "type": "shell",
            "command": "make stage1",
            "group": "build",
            "problemMatcher": [
                {
                    "owner": "kanso",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning|info|hint)[a-z]*:\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "KSPL: Lint",
            "type": "shell",
            "command": "make lint",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            },
            "problemMatcher": [
                {
                    "owner": "kanso",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning|info|hint)[a-z]*:\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        }
    ]
}
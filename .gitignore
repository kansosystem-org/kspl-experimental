*.exe
*.o
*.d
out/
.venv/
__pycache__/
*.pyc
# Large files that take long to get again: downloaded models and weights made here. The folder's
# README says which and how; `make clean` keeps them.
/data/*
!/data/README.md

# Secrets.
# Caution: **Write them down even when there is nothing to hide yet.** This prevents the shape of
# noticing only after one has been committed (the published copy is built from the last commit,
# so whatever a commit holds goes out with it).
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
secrets.*

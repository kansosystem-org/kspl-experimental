//< The endpoints under `/api/`
//<
//< To add an endpoint, add one row to `ROUTES` and one case to `Api.queue`. How a response is
//< queued (`conn.queue_response`) lives in `kssrv/conn.kspl`.
//< **Do not mix the local-use endpoints (`--local`) with the outward-facing ones.** The file
//< endpoints read and write under the root, so facing outward they **do not exist**. The car's
//< endpoints have nothing to answer with for local use (`Reach`).
import "kssrv/conn"
import "kssrv/pilot"
import "std/chars"
import "std/fs"
import "std/http"
import "std/io"
import "std/json" + { Json_builder }
import "std/mem" { heap_used_bytes }
import "std/str" { Str_builder }
import "std/sys"
import "std/url"

const API_PREFIX: U8[] = "/api/" //< the JSON API's prefix
    //<
    //< Below it a routing table answers, not static serving.

const BEARER: U8[] = "Bearer " //< the prefix before the token in the `Authorization` header

fn queue_json(c: conn.Conn$@, status: I32, val: json.Value, keep: Bool, allow: U8[] = "") //<
    //< Builds one JSON value and queues it as the response; `allow` is a 405's `Allow`
    $body: = Str_builder.new()
    val.dump(body@)
    conn.queue_response(c, status, "application/json", body.slice(), keep, allow)

fn queue_json_error(c: conn.Conn$@, status: I32, allow: U8[] = "") //<
    //< Queues an error answer in JSON; `allow` is a 405's `Allow`
    reason: = http.reason_phrase(status).unwrap_or("")
    $b: = Json_builder.new(c.arena)
    val: = b.obj().set("error", b.str_val(reason)).set("status", b.int_val(status)).build()
    // An error response closes (the same reason as `queue_error` on the static side).
    queue_json(c, status, val, false, allow)

fn queue_api_status(c: conn.Conn$@, ctx: conn.Ctx$@, keep: Bool) //<
    //< `GET /api/status`: returns that it is running, and how much it has handled
    $b: = Json_builder.new(c.arena)
    // The car's steering policy does not change after `build()`, so it is read directly. **For
    // local use there is none**, and `pilot` is null.
    $pilot_val: = b.null_val()
    if ctx.p != null
        pilot_val = b.obj().set("params", b.int_val(ctx.p.params))
            .set("samples", b.int_val(ctx.p.samples))
            .set("train_cpu_ms", b.int_val(ctx.p.train_ms))
            .set("agreement", b.float_val(ctx.p.agreement))
            .set("agreement_checked", b.int_val(ctx.p.checked))
            .set("command_valid_ms", b.int_val(pilot.COMMAND_VALID_MS)).build()
    // Caution: **Say whether it is for local use.** Otherwise the page shows the local tools even
    // where there are no file endpoints: buttons that do nothing. Without the token this is a 401,
    // so nothing leaks.
    // **The root is told only for local use**, to the holder of the token. Facing outward, its
    // absolute path would tell anyone who asks how this machine's folders are laid out.
    val: = b.obj().set("root", b.str_val(ctx.root if ctx.is_local() else ""))
        .set("local", b.bool_val(ctx.is_local()))
        .set("uptime_s", b.int_val(sys.wall_seconds() - conn.stats.started_s))
        .set("requests", b.int_val(conn.stats.requests))
        .set("commands", b.int_val(conn.stats.commands))
        .set("connections_total", b.int_val(conn.stats.connections_total))
        .set("connections_open", b.int_val(conn.stats.connections_open))
        .set("connections_refused", b.int_val(conn.stats.connections_refused))
        .set("max_connections", b.int_val(conn.MAX_CONNS))
        .set("heap_bytes", b.int_val(heap_used_bytes())).set("pilot", pilot_val).build()
    queue_json(c, 200, val, keep)

fn rel_or_refuse(c: conn.Conn$@, query: U8[], root: U8[]): U8[]? //<
    //< Takes the relative path under the root from `path=`; empty means none, or the root itself
    //<
    //< Caution: **Run the value through static serving's check (`rel_checked`), after the decode**
    //< ("The path is checked after the decode" in `kssrv/docs/DESIGN-server.md`). **But keep a
    //< leading `/`.** Only a URL's path opens with one. So here `/etc/passwd` is an absolute path,
    //< refused, never `etc/passwd` under the root.
    params: = url.parse_query(query, c.arena) catch _e
        queue_json_error(c, 400)
        return .none
    got: = rel_checked(root, params.find("path").unwrap_or(""))
    if !got.is_some()
        queue_json_error(c, 403)
    return got

fn rel_under(root: U8[], path: U8[]): U8[]? //<
    //< A URL's path with its leading `/`s dropped, if it stays under the root (`rel_checked`)
    //<
    //< Empty means the root itself. Static serving asks this: a URL's path always opens with `/`.
    $rel: = path
    for rel.len > 0 && rel[0] == '/'
        rel = rel.sub_from(1)
    return rel_checked(root, rel)

priv fn rel_checked(root: U8[], rel: U8[]): U8[]? //<
    //< The path itself, if it stays under the root (`fs.stays_under`)
    //<
    //< **Empty means the root itself.** An absolute path in any OS's spelling (`/x`, `\\x`, `C:x`)
    //< is refused by `fs.stays_under`'s text check, on every OS.
    if rel.len > 0 && !fs.stays_under(root, rel)
        return .none
    return .some(rel)

// ==========================================
// The local-use endpoints (files, and whether something changed)
// **These endpoints do not exist facing outward**: without `--local`, `queue_api` answers them
// with a 404. `GET /api/file?path=<p>` returns that file's bytes; `PUT /api/file?path=<p>` writes
// the body.
// ==========================================
fn queue_api_file(c: conn.Conn$@, t: conn.Target, req: http.Request$@, root: U8[], keep: Bool)
    $rel: U8[] = ""
    switch rel_or_refuse(c, t.query, root)
    case .some(r)
        rel = r
    case .none
        return
    if rel.len == 0
        // The root itself is not a file; this endpoint needs a name.
        queue_json_error(c, 400)
        return
    path: = fs.join(root, rel, c.arena)
    // Only GET and PUT come here (`ROUTES`).
    if req.method.equals("GET")
        queue_get_file(c, path, keep)
        return
    queue_put_file(c, path, req.body, keep)

fn queue_get_file(c: conn.Conn$@, path: U8[], keep: Bool) //<
    //< Queues the file at `path` as the response, typed octet-stream
    //<
    //< **The type is not guessed from the content**, since a receiver trusts a guessed type.
    //< Reading it as UTF-8 is the caller's job; the server does not guess the encoding.
    $size: Sz = 0
    if found: = conn.regular_file_size(path)
        size = found
    else
        queue_json_error(c, 404)
        return
    file: = io.open(path, "rb") catch _e
        queue_json_error(c, 500)
        return
    conn.queue_file(c, "application/octet-stream", file, size, keep)

fn queue_put_file(c: conn.Conn$@, path: U8[], body: U8[], keep: Bool) //<
    //< Writes `body` to the file at `path` and queues a response saying how much was written
    //<
    //< Caution: **Answer 200 only once the body is on the disk** (`fs.replace_file`). An editor
    //< told "saved" drops its copy. So a save that a power cut then loses is lost for good. The
    //< file keeps its mode. The body's cap is in `kssrv/main.kspl` (a 413 never reaches here).
    fs.replace_file(path, body, .kept) catch _e
        // No folder, or not writable: not a missing name, so not a 404.
        queue_json_error(c, 500)
        return
    $b: = Json_builder.new(c.arena)
    val: = b.obj().set("wrote", b.int_val(body.len)).build()
    queue_json(c, 200, val, keep)

fn queue_api_stat(c: conn.Conn$@, query: U8[], root: U8[], keep: Bool) //<
    //< `GET /api/stat?path=<p>`: returns whether something changed
    //<
    //< Caution: **Do not return the content**, or it arrives by two paths (the file endpoint reads
    //< it). **Nothing is missed**: it returns "how things are now", not "how many times it
    //< changed", so it catches up however many changes happen in between.
    $rel: U8[] = ""
    switch rel_or_refuse(c, query, root)
    case .some(r)
        rel = r
    case .none
        return
    target: = root if rel.len == 0 else fs.join(root, rel, c.arena)
    info: = fs.stat(target) catch _e
        queue_json_error(c, 404)
        return
    $b: = Json_builder.new(c.arena)
    val: = b.obj().set("size", b.int_val(info.size))
        .set("changed_at", b.int_val(info.mtime)).build()
    queue_json(c, 200, val, keep)

// ==========================================
// The token
// ==========================================

fn token_matches(given: U8[], want: U8[]): Bool //<
    //< Whether `given` is the token `want`, compared in a time that does not depend on the bytes
    //<
    //< Caution: **Do not return at the first differing byte**, or the response times reveal the
    //< token one byte at a time. Another site's page in the browser can reach the loopback too.
    if given.len != want.len
        return false
    $diff: U8 = 0U8
    for i in Range.asc(want.len)
        diff |= given[i] ^ want[i]
    return diff == 0U8

fn authorized(req: http.Request$@, token: U8[]): Bool
    if v: = req.headers.find("Authorization")
        given: = v
        if !given.starts_with(BEARER)
            return false
        return token_matches(given.sub_from(BEARER.len), token)
    return false

fn queue_api_car(c: conn.Conn$@, req: http.Request$@, p: pilot.Pilot$@, keep: Bool) //<
    //< `POST /api/car`: takes the distance and line the car measured and returns one manoeuvre
    //<
    //< `{"dist_mm":250,"line":2,"seq":17}` goes in, and
    //< `{"seq":17,"cmd":"strafe_right","lon":0,"lat":50,"rot":0,"valid_ms":500}` comes back.
    //< A few hundred weights, read-only after `build()`, so it answers on the accepting thread.
    //< Caution: **Return `seq` unchanged**: it is the car's only way to tell that the answer is for
    //< its latest request.
    doc: = json.parse(req.body, c.arena) catch _e
        queue_json_error(c, 400)
        return
    // Caution: **Do not default a missing `dist_mm` to 0**, which means "it could not be measured".
    // As a default, it would turn a broken request into a valid observation.
    dist: = doc.val.get("dist_mm").as_int64().unwrap_or(-1I64)
    line: = doc.val.get("line").as_int64().unwrap_or(-1I64)
    if dist < 0I64 || line < 0I64 || line >= I64::pilot.LINE_PATTERNS
        queue_json_error(c, 400)
        return
    seq: = doc.val.get("seq").as_int64().unwrap_or(0I64)
    obs: = pilot.Obs::{ .dist_mm = dist, .line = line }
    // The work uses the connection's arena, which `conn_build` rewinds per request.
    act: = pilot.decide(p, obs, c.arena)
    m: = pilot.MANEUVERS[act]
    conn.stats.commands += 1I64
    $b: = Json_builder.new(c.arena)
    val: = b.obj().set("seq", b.int_val(seq)).set("cmd", b.str_val(m.name))
        .set("lon", b.int_val(m.lon)).set("lat", b.int_val(m.lat))
        .set("rot", b.int_val(m.rot)).set("valid_ms", b.int_val(pilot.COMMAND_VALID_MS)).build()
    queue_json(c, 200, val, keep)

fn queue_api_pilot(c: conn.Conn$@, p: pilot.Pilot$@, keep: Bool) //<
    //< `GET /api/pilot`: returns one whole steering policy as safetensors
    //<
    //< The policy is the weights, the manoeuvre table and the preprocessing constants. A car that
    //< has it decides for itself without asking per observation; the same weights answer
    //< `POST /api/car`. **The type is octet-stream** (no MIME type is registered for safetensors).
    $blob: = pilot.export(p, c.arena)
    defer blob.free()
    conn.queue_response(c, 200, "application/octet-stream", blob.slice(), keep)

priv enum Reach //< in which mode an endpoint exists
    both
    local //< only for local use
        //<
        //< **Facing outward it does not**: with no token, anyone could read and write under the
        //< root.
    outward //< only facing outward
        //<
        //< **For local use it does not**: the car cannot reach the loopback, so no policy is
        //< trained there (`main` in `kssrv/main.kspl`).

priv fn reaches(c: conn.Conn$@, ctx: conn.Ctx$@, r: Reach): Bool //<
    //< Whether the endpoint exists in this mode
    //<
    //< Where it does not, the 404 is already queued.
    local: = ctx.is_local()
    $here: = true
    switch r
    case .both {}
    case .local
        here = local
    case .outward
        here = !local
    if !here
        queue_json_error(c, 404)
    return here

priv fn queue_ok(c: conn.Conn$@, keep: Bool) //< returns only "it took effect"
    //<
    //< **A response with no content is JSON too**, so the page need not branch on the format.
    $b: = Json_builder.new(c.arena)
    queue_json(c, 200, b.obj().build(), keep)

fn queue_api_here(c: conn.Conn$@) //<
    //< `GET /api/here`: the page holds this connection open for as long as the page is open
    //<
    //< **Nothing is ever sent on it.** The connection itself is the message, and closing the tab
    //< closes it, so the server learns the moment the page goes, with no timer.
    //< Caution: **Do not answer and close.** Then the server would know only "someone asked a while
    //< ago", and how long ago is the guess this avoids.
    conn.queue_stream_head(c)
    c.holding = true

fn queue_api_stop(c: conn.Conn$@) //<
    //< `POST /api/stop`: answers, and the server stops once the answer has gone out
    //<
    //< **The answer comes first**, so the asker tells "it stopped" from "the connection broke". The
    //< accept loop does the stopping (`conn.stop_asked_by`).
    conn.stop_asked_by = c.serial
    queue_ok(c, false)

// ==========================================
// The dispatch under `/api/`, checked before static serving (a file named `api` under the root
// loses)
// ==========================================

priv enum Api //< the endpoint a route reaches
    file
    stat
    here
    stop
    status
    car
    pilot

priv struct Route //< one entry point under `/api/`
    path: U8[] //< the path
    reach: Reach //< in which mode it exists; in the other it is a 404 (`reaches`)
    methods: U8[] //< the methods it takes, as a 405's `Allow` names them; another one is a 405
    api: Api //< the endpoint it reaches

priv const ROUTES: Route[7] = ::{ //<
    //< Every entry point, with who may reach it and by which methods
    //<
    //< **The guards run once, here, for every row**: decided per endpoint, a new one forgets one.
    //< `/api/file` has no `HEAD`: `/api/stat` gives the size and whether it exists (Principle 6).
    Route::{ .path = "/api/file", .reach = .local, .methods = "GET, PUT", .api = .file },
    Route::{ .path = "/api/stat", .reach = .local, .methods = "GET", .api = .stat },
    Route::{ .path = "/api/here", .reach = .local, .methods = "GET", .api = .here },
    Route::{ .path = "/api/stop", .reach = .local, .methods = "POST", .api = .stop },
    Route::{ .path = "/api/status", .reach = .both, .methods = "GET", .api = .status },
    Route::{ .path = "/api/car", .reach = .outward, .methods = "POST", .api = .car },
    Route::{ .path = "/api/pilot", .reach = .outward, .methods = "GET", .api = .pilot },
}

priv fn takes(r: Route, method: U8[]): Bool //< whether the route takes that method
    $rest: = r.methods
    for rest.len > 0
        cut: = rest.find_char(',').unwrap_or(rest.len)
        if rest.sub(0, cut).trim_spaces().equals(method)
            return true
        rest = rest.sub_from(cut + 1) if cut < rest.len else ""
    return false

fn queue_api(c: conn.Conn$@, t: conn.Target, req: http.Request$@, ctx: conn.Ctx$@, keep: Bool)
    // **For local use, all of `/api/` needs a token**; decided per endpoint, a new one forgets it.
    // Only static serving, which passes the token on, needs none.
    if ctx.is_local() && !authorized(req, ctx.token)
        queue_json_error(c, 401)
        return
    for r in ROUTES
        if !t.path.equals(r.path)
            continue
        if !reaches(c, ctx, r.reach)
            return
        if !takes(r, req.method)
            queue_json_error(c, 405, r.methods)
            return
        r.api.queue(c, t, req, ctx, keep)
        return
    queue_json_error(c, 404)

impl Api
    priv fn queue(r: Self, c: conn.Conn$@, t: conn.Target, req: http.Request$@, ctx: conn.Ctx$@,
        keep: Bool) //<
            //< Hands one request to this endpoint, once `queue_api`'s guards have passed
        switch r
        case .file
            queue_api_file(c, t, req, ctx.root, keep)
        case .stat
            queue_api_stat(c, t.query, ctx.root, keep)
        case .here
            queue_api_here(c)
        case .stop
            queue_api_stop(c)
        case .status
            queue_api_status(c, ctx, keep)
        case .car
            queue_api_car(c, req, ctx.p, keep)
        case .pilot
            queue_api_pilot(c, ctx.p, keep)

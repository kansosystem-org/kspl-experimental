//< The endpoints under `/api/`
//< To add an endpoint, add one row to `ROUTES` and one case to `Api.queue`. How a response is
//< queued (`conn.queue_response`) lives in `kssrv/conn.kspl`.
//< **Do not let the local-use endpoints (`--local`) face outward.** The file endpoints read and
//< write under the root, so facing outward they **do not exist** (`Reach`).
import "kssrv/conn"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/http"
import "std/io"
import "std/json" + { Json_builder }
import "std/mem" { Arena, heap_used_bytes }
import "std/seq"
import "std/sha256" + { Sha256 }
import "std/str" { Str_builder }
import "std/subproc"
import "std/sys"
import "std/url"

const API_PREFIX: U8[] = "/api/" //< the JSON API's prefix
    //< Below it a routing table answers, not static serving.

const BEARER: U8[] = "Bearer " //< the prefix before the token in the `Authorization` header

fn queue_json(c: conn.Conn$@, status: I32, val: json.Value, keep: Bool, allow: U8[] = "") //<
    //< Builds one JSON value and queues it as the response; `allow` is a 405's `Allow`
    defer $body: = Str_builder()
    val.dump(body@)
    conn.queue_response(c, status, "application/json", body.slice(), keep, allow)

fn queue_json_error(c: conn.Conn$@, status: I32, allow: U8[] = "") //<
    //< Queues an error answer in JSON; `allow` is a 405's `Allow`
    reason: = http.reason_phrase(status).unwrap_or("")
    $b: = Json_builder(c.arena)
    val: = b.obj().set("error", b.str_val(reason)).set("status", b.int_val(status)).build()
    // An error response closes (the same reason as `queue_error` on the static side).
    queue_json(c, status, val, false, allow)

fn queue_api_status(c: conn.Conn$@, ctx: conn.Ctx@, keep: Bool) //<
    //< `GET /api/status`: returns that it is running, and how much it has handled
    $b: = Json_builder(c.arena)
    // Caution: **Say whether it is for local use.** Otherwise the page shows the local tools even
    // where there are no file endpoints: buttons that do nothing. Without the token this is a 401,
    // so nothing leaks.
    // **The root is told only for local use**, to the holder of the token. Facing outward, its
    // absolute path would tell anyone who asks how this machine's folders are laid out.
    val: = b.obj().set("root", b.str_val(ctx.root if ctx.is_local() else ""))
        .set("local", b.bool_val(ctx.is_local()))
        .set("conditional_writes", b.bool_val(ctx.is_local()))
        .set("uptime_s", b.int_val(sys.wall_seconds() - conn.stats.started_s))
        .set("requests", b.int_val(conn.stats.requests))
        .set("connections_total", b.int_val(conn.stats.connections_total))
        .set("connections_open", b.int_val(conn.stats.connections_open))
        .set("connections_refused", b.int_val(conn.stats.connections_refused))
        .set("max_connections", b.int_val(conn.MAX_CONNS))
        .set("heap_bytes", b.int_val(heap_used_bytes())).build()
    queue_json(c, 200, val, keep)

fn path_or_refuse(c: conn.Conn$@, query: U8[], root: U8[], need_name: Bool, dots: fs.Dot_names):
    U8[]? //<
        //< The path that a query's `?path=` names under the root, the root joined in, or none
        //< None means a 400 or a 403 is queued. An empty path is the root itself. A write refuses a
        //< dot name through `dots` ("`/api/` does not go through static serving" in
        //< `kssrv/docs/DESIGN-server.md`).
        //< Caution: **Check the value after the decode, but keep a leading `/`.** Only a URL's path
        //< opens with one. So here `/etc/passwd` is an absolute path, refused, never under the
        //< root.
    params: = url.parse_query(query, c.arena) catch _e
        queue_json_error(c, 400)
        return .none
    rel: = params.find("path").unwrap_or("")
    if need_name && rel.len == 0
        // The root itself is not a file; this endpoint needs a name.
        queue_json_error(c, 400)
        return .none
    path: = fs.join_under(root, rel, dots, c.arena) catch _why
        queue_json_error(c, 403)
        return .none
    return .some(path)

fn url_rel(path: U8[]): U8[] //< a URL's path as a path under the root
    //< **Its leading `/`s are dropped, and one at its end**: `/docs/` names the folder `docs`, as
    //< `/docs` does. A second `/` at the end stays, and `fs.join_under` refuses the empty step.
    $rel: = path
    for rel.len > 0 && rel[0] == '/'
        rel = rel.sub_from(1)
    return rel.sub(0, rel.len - 1) if rel.len > 0 && rel[rel.len - 1] == '/' else rel

// ==========================================
// The local-use endpoints (files, and whether something changed)
// **These endpoints do not exist facing outward**: without `--local`, `queue_api` answers them
// with a 404. `GET /api/file?path=<p>` returns that file's bytes; `PUT /api/file?path=<p>` writes
// the body.
// ==========================================
fn queue_api_file(c: conn.Conn$@, t: conn.Target, req: http.Request@, root: U8[], keep: Bool)
    // Caution: **A write never reaches a dot name.** A write to `.git/config` can set a command
    // that the next `git status` runs. A read of a dot name is let through.
    reads: = req.method.equals("GET")
    dots: fs.Dot_names = .allowed if reads else .refused(U8[][]::{})
    path: U8[] = path_or_refuse(c, t.query, root, true, dots) catch
        return
    // Only GET and PUT come here (`ROUTES`).
    if reads
        queue_get_file(c, path, keep)
        return
    if expected: = req.headers.find("X-Kanso-If-Content")
        status: = check_content(path, expected, c.arena)
        if status != 200
            queue_json_error(c, status)
            return
    queue_put_file(c, path, req.body, keep)

fn queue_get_file(c: conn.Conn$@, path: U8[], keep: Bool) //<
    //< Queues the file at `path` as the response, typed octet-stream
    //< **The type is not guessed from the content**, since a receiver trusts a guessed type.
    //< Reading it as UTF-8 is the caller's job; the server does not guess the encoding.
    $size: Sz = 0
    if found: = conn.regular_file_size(path)
        size = found
    else
        queue_json_error(c, 404)
        return
    file: = io.open(path, "rb") catch _e
        queue_json_error(c, 500)
        return
    conn.queue_file(c, "application/octet-stream", file, size, keep)

priv fn check_content(path: U8[], expected: U8[], arena: Arena$@): I32 //<
    //< checks a conditional write's baseline
    //< The event loop checks and replaces without yielding to another request.
    //< This orders writes through this server; it cannot lock out unrelated filesystem writers.
    if expected.equals("missing")
        return 409 if fs.exists(path) else 200
    if !is_digest(expected)
        return 400
    if conn.regular_file_size(path).is_none()
        return 409
    now: U8[] = content_digest(path, arena) catch
        return 500
    return 200 if now.equals(expected) else 409

priv fn is_digest(text: U8[]): Bool //< whether `text` is a SHA-256 digest in lowercase hex
    if text.len != sha256.HEX_LEN
        return false
    for c in text
        if !(c >= '0' && c <= '9') && !(c >= 'a' && c <= 'f')
            return false
    return true

priv fn content_digest(path: U8[], arena: Arena$@): U8[]? //<
    //< The SHA-256 of a file's bytes in lowercase hex; none where it cannot be read
    //< Caution: **Only an ordinary file is opened**, as for a GET (`conn.regular_file_size`): a
    //< FIFO's read waits for ever and holds the server.
    if conn.regular_file_size(path).is_none()
        return .none
    defer $file: = io.open(path, "rb") catch
        return .none
    $hash: = Sha256()
    $buf: U8[8192] = ::{}
    for
        n: = file.read(U8$[]::buf) catch
            return .none
        if n == 0
            break
        hash.update((U8[]::buf).sub(0, n))
    return .some(hex_of(hash.finalize(), arena))

priv fn hex_of(digest: U8[sha256.DIGEST_SIZE], arena: Arena$@): U8[] //< a digest as 64 hex digits
    $hex: U8[sha256.HEX_LEN] = ::{}
    sha256.write_hex(digest, U8$[]::hex)
    return arena.dup_str(U8[]::hex)

fn queue_put_file(c: conn.Conn$@, path: U8[], body: U8[], keep: Bool) //<
    //< Writes `body` to the file at `path` and queues a response saying how much was written
    //< Caution: **Answer 200 only once the body is on the disk** (`fs.replace_file`). An editor
    //< told "saved" drops its copy. So a save that a power cut then loses is lost for good. The
    //< file keeps its mode. The body's cap is in `kssrv/main.kspl` (a 413 never reaches here).
    // A write into a folder that is not there yet makes that one folder first, as a page's
    // images go into a folder named for their document. Its own folder must stand already.
    if !make_folder_for(path)
        queue_json_error(c, 500)
        return
    fs.replace_file(path, body, .kept) catch _e
        // No folder, or not writable: not a missing name, so not a 404.
        queue_json_error(c, 500)
        return
    $b: = Json_builder(c.arena)
    val: = b.obj().set("wrote", b.int_val(body.len)).build()
    queue_json(c, 200, val, keep)

priv fn make_folder_for(path: U8[]): Bool //<
    //< makes the one missing folder a file goes in; false if it cannot
    parent: = sys.get_dir_name(path)
    if parent.len == 0 || fs.exists(parent)
        return true
    fs.mkdir(parent) catch _e
        return false
    return true

fn queue_api_move(c: conn.Conn$@, query: U8[], root: U8[], keep: Bool) //<
    //< `POST /api/move?from=<p>&to=<q>`: renames a file under the root, never over another one
    //< Both names go through a write's refusals, so neither is a dot name nor leaves the root. A
    //< target already standing is 409, and an absent source 404. The target's one missing folder
    //< is made first, as for a write.
    params: = url.parse_query(query, c.arena) catch _e
        queue_json_error(c, 400)
        return
    from_rel: = params.find("from").unwrap_or("")
    to_rel: = params.find("to").unwrap_or("")
    if from_rel.len == 0 || to_rel.len == 0
        queue_json_error(c, 400)
        return
    dots: fs.Dot_names = .refused(U8[][]::{})
    from: = fs.join_under(root, from_rel, dots, c.arena) catch _why
        queue_json_error(c, 403)
        return
    to: = fs.join_under(root, to_rel, dots, c.arena) catch _why
        queue_json_error(c, 403)
        return
    if conn.regular_file_size(from).is_none()
        queue_json_error(c, 404)
        return
    if fs.exists(to)
        queue_json_error(c, 409)
        return
    if !make_folder_for(to)
        queue_json_error(c, 500)
        return
    fs.rename_path(from, to) catch _e
        queue_json_error(c, 500)
        return
    $b: = Json_builder(c.arena)
    val: = b.obj().set("moved", b.bool_val(true)).build()
    queue_json(c, 200, val, keep)

fn queue_api_stat(c: conn.Conn$@, query: U8[], root: U8[], keep: Bool) //<
    //< `GET /api/stat?path=<p>`: returns whether something changed
    //< Caution: **Do not return the content**, or it arrives by two paths (the file endpoint reads
    //< it). **Nothing is missed**: it returns "how things are now", not "how many times it
    //< changed", so it catches up however many changes happen in between.
    target: U8[] = path_or_refuse(c, query, root, false, .allowed) catch
        return
    info: = fs.stat(target) catch _e
        queue_json_error(c, 404)
        return
    $b: = Json_builder(c.arena)
    val: = b.obj().set("size", b.int_val(info.size))
        .set("changed_at", b.int_val(info.mtime)).build()
    queue_json(c, 200, val, keep)

priv const MAX_LISTED: Sz = 2000 //< the most names one listing returns

fn queue_api_list(c: conn.Conn$@, query: U8[], root: U8[], keep: Bool) //<
    //< `GET /api/list?path=<folder>`: the names in one folder under the root, for a Save As dialog
    //< `{"folders":[…],"files":[…],"more":false}`, each list sorted. An empty path is the root.
    //< Caution: **Names only, and only what the page could open anyway.** No content and no size.
    //< A link is left out, so the dialog never offers a way out of the root, and so is a hidden
    //< name (`.git`, `.ksmd-workspace`). So is anything neither a folder nor an ordinary file.
    //< At most `MAX_LISTED` names come back; `more` says that others stand there.
    // **No link check here**: `path_or_refuse` refused any below the root, and a root can be one.
    folder: U8[] = path_or_refuse(c, query, root, false, .allowed) catch
        return
    if !fs.is_dir(folder)
        queue_json_error(c, 404)
        return
    names: = fs.read_dir(folder, c.arena) catch _e
        queue_json_error(c, 404)
        return
    sorted: = names.order_by(fn(a: U8[]@, b: U8[]@; ): I32 {
        return a.compare(b$);
    }, c.arena)
    $b: = Json_builder(c.arena)
    $folders: = b.arr()
    $files: = b.arr()
    $listed: Sz = 0
    $more: = false
    for name in sorted
        // **A name the file endpoint would refuse is left out**, by the same check: a dot name, a
        // link, a `\` (only POSIX allows one), a short name's form and the rest.
        full: =
            fs.join_under(folder, name, .refused(U8[][]::{}), c.arena) catch _why
            continue
        is_folder: = fs.is_dir(full)
        if !is_folder && conn.regular_file_size(full).is_none()
            continue
        if listed == MAX_LISTED
            more = true
            break
        listed += 1
        if is_folder
            folders = folders.push(b.str_val(name))
        else
            files = files.push(b.str_val(name))
    val: = b.obj().set("folders", folders.build()).set("files", files.build())
        .set("more", b.bool_val(more)).build()
    queue_json(c, 200, val, keep)

// ==========================================
// The token
// ==========================================

fn token_matches(given: U8[], want: U8[]): Bool //<
    //< Whether `given` is the token `want`, compared in a time that does not depend on the bytes
    //< Caution: **Do not return at the first differing byte**, or the response times reveal the
    //< token one byte at a time. Another site's page in the browser can reach the loopback too.
    if given.len != want.len
        return false
    $diff: U8 = 0U8
    for i in Range.asc(want.len)
        diff |= given[i] ^ want[i]
    return diff == 0U8

fn authorized(req: http.Request@, token: U8[]): Bool
    if given: = req.headers.find("Authorization")
        if !given.starts_with(BEARER)
            return false
        return token_matches(given.sub_from(BEARER.len), token)
    return false

priv enum Reach //< in which mode an endpoint exists
    both
    local //< only for local use
        //< **Facing outward it does not**: with no token, anyone could read and write under the
        //< root.

priv fn reaches(c: conn.Conn$@, ctx: conn.Ctx@, r: Reach): Bool //<
    //< Whether the endpoint exists in this mode
    //< Where it does not, the 404 is already queued.
    local: = ctx.is_local()
    $here: = true
    switch r
    case .both {}
    case .local
        here = local
    if !here
        queue_json_error(c, 404)
    return here

priv fn queue_ok(c: conn.Conn$@, keep: Bool) //< returns only "it took effect"
    //< **A response with no content is JSON too**, so the page need not branch on the format.
    $b: = Json_builder(c.arena)
    queue_json(c, 200, b.obj().build(), keep)

fn queue_api_here(c: conn.Conn$@) //<
    //< `GET /api/here`: the page holds this connection open for as long as the page is open
    //< **Nothing is ever sent on it.** The connection itself is the message, and closing the tab
    //< closes it, so the server learns the moment the page goes, with no timer.
    //< Caution: **Do not answer and close.** Then the server would know only "someone asked a while
    //< ago", and how long ago is the guess this avoids.
    conn.queue_stream_head(c)
    c.holding = true

fn queue_api_stop(c: conn.Conn$@) //<
    //< `POST /api/stop`: answers, and the server stops once the answer has gone out
    //< **The answer comes first**, so the asker tells "it stopped" from "the connection broke". The
    //< accept loop does the stopping (`conn.stop_asked_by`).
    conn.stop_asked_by = c.serial
    queue_ok(c, false)

// ==========================================
// A page's own functions: which files the person allowed, and the build
// **Nothing is built until the person allows that exact file.** The record (`--allowed`) keeps,
// for each functions file, the SHA-256 of its path and of the bytes the person allowed. A file
// whose bytes changed since is not allowed, so it asks again. Each line is `<path> <content>`.
// ==========================================
priv const MAX_ALLOWED: Sz = 1024 //< the most files the record keeps; past it the oldest goes
priv const MAX_RECORD: Sz = MAX_ALLOWED * (2 * sha256.HEX_LEN + 2) //< the record's most bytes

priv fn record_lines(ctx: conn.Ctx@, arena: Arena$@): U8[][]? //<
    //< The record's well-formed lines, oldest first; none where it stands but cannot be read
    if !fs.exists(ctx.allowed)
        return .some(U8[][]::{})
    text: = io.read_file_capped(ctx.allowed, MAX_RECORD, arena) catch
        return .none
    $kept: = List<|U8[]|>(arena)
    for line in text.lines(arena)
        if line.len == 2 * sha256.HEX_LEN + 1 && line[sha256.HEX_LEN] == ' ' &&
            is_digest(line.sub(0, sha256.HEX_LEN)) &&
            is_digest(line.sub_from(sha256.HEX_LEN + 1))
            kept.push(line)
    return .some(kept.slice())

priv fn is_allowed(ctx: conn.Ctx@, path: U8[], content: U8[], arena: Arena$@): Bool //<
    //< Whether the person allowed the file at `path` holding the bytes whose digest is `content`
    key: = hex_of(sha256.hash(path), arena)
    lines: U8[][] = record_lines(ctx, arena) catch
        return false
    for line in lines
        if line.starts_with(key) && line.sub_from(sha256.HEX_LEN + 1).equals(content)
            return true
    return false

priv fn record(ctx: conn.Ctx@, path: U8[], content: U8[]?, arena: Arena$@): Bool //<
    //< Records that the file at `path` may be built with the bytes `content` names, or with none
    //< **One line per file**: an allow replaces the file's earlier one. False where the record
    //< cannot be read or written; the record then stays as it was.
    key: = hex_of(sha256.hash(path), arena)
    lines: U8[][] = record_lines(ctx, arena) catch
        return false
    $kept: = List<|U8[]|>(arena)
    for line in lines
        if !line.starts_with(key)
            kept.push(line)
    if now: = content
        kept.push(arena.text().s(key).c(' ').s(now).take())
    text: = arena.text()
    first: = kept.len - MAX_ALLOWED if kept.len > MAX_ALLOWED else 0
    for i in Range(first, kept.len, 1)
        text.s(kept.get(i)).c('\n')
    fs.replace_file(ctx.allowed, text.take(), .owner_only) catch
        return false
    return true

fn queue_api_allow(c: conn.Conn$@, query: U8[], req: http.Request@, ctx: conn.Ctx@, keep: Bool) //<
    //< `/api/allow?path=<file>`: whether the person allowed a functions file's bytes to be built
    //< GET answers `{"allowed":…}` for the bytes the file holds now. POST allows the bytes that
    //< `X-Kanso-If-Content` names, and refuses with 409 when the file holds others. DELETE takes
    //< the allow back. With no builder it is a 404, as `/api/build` is.
    //< Caution: **Only the person's own act on the page sends a POST.** The token keeps every
    //< other program out; a document's content never reaches this endpoint.
    if ctx.builder.len == 0
        queue_json_error(c, 404)
        return
    path: U8[] = path_or_refuse(c, query, ctx.root, true, .allowed) catch
        return
    if req.method.equals("DELETE")
        if !record(ctx, path, .none, c.arena)
            queue_json_error(c, 500)
            return
        queue_allowed(c, false, keep)
        return
    if conn.regular_file_size(path).is_none()
        queue_json_error(c, 404)
        return
    content: U8[] = content_digest(path, c.arena) catch
        queue_json_error(c, 500)
        return
    if req.method.equals("GET")
        queue_allowed(c, is_allowed(ctx, path, content, c.arena), keep)
        return
    expected: = req.headers.find("X-Kanso-If-Content").unwrap_or("")
    if !is_digest(expected)
        queue_json_error(c, 400)
        return
    if !expected.equals(content)
        queue_json_error(c, 409)
        return
    if !record(ctx, path, .some(content), c.arena)
        queue_json_error(c, 500)
        return
    queue_allowed(c, true, keep)

priv fn queue_allowed(c: conn.Conn$@, allowed: Bool, keep: Bool) //< `{"allowed":…}`
    $b: = Json_builder(c.arena)
    queue_json(c, 200, b.obj().set("allowed", b.bool_val(allowed)).build(), keep)

priv fn queue_refusal(c: conn.Conn$@, status: I32, why: U8[]) //<
    //< A refusal whose JSON `error` says why in words the page shows as they are
    $b: = Json_builder(c.arena)
    val: = b.obj().set("error", b.str_val(why)).set("status", b.int_val(status)).build()
    queue_json(c, status, val, false)

priv const BUILD_MS: I32 = 60000 //< how long one build may take
priv const MAX_BUILT: Sz = 16 * 1024 * 1024 //< the most bytes of wasm, or of a message, kept

fn queue_api_build(c: conn.Conn$@, query: U8[], ctx: conn.Ctx@, keep: Bool) //<
    //< `POST /api/build?path=<file>`: the wasm of a person's own functions in that file
    //< `--builder` builds it (`kssrv/main.kspl`); the answer is the wasm, or a 422 whose JSON
    //< `error` is the builder's message. With no builder it is a 404, as with no such endpoint.
    //< A file whose bytes the person has not allowed is a 403, and nothing starts.
    //< **The server waits for the build**, since it holds no request open while a child runs.
    //< Only this page waits; `BUILD_MS` bounds it.
    if ctx.builder.len == 0
        queue_json_error(c, 404)
        return
    path: U8[] = path_or_refuse(c, query, ctx.root, true, .allowed) catch
        return
    if conn.regular_file_size(path).is_none()
        queue_json_error(c, 404)
        return
    content: U8[] = content_digest(path, c.arena) catch
        queue_json_error(c, 500)
        return
    if !is_allowed(ctx, path, content, c.arena)
        queue_refusal(c, 403, "this file's functions are not allowed to run")
        return
    // **Messages name the file as the page does**, by its path from the root.
    shown: = url.parse_query(query, c.arena) catch
        queue_json_error(c, 400)
        return
    // Caution: **The builder gets the digest too**, and builds only bytes that match it. A file
    // changed between this check and the builder's read is then refused, not built.
    got: =
        subproc.run_capture(U8[][]::{ ctx.builder, path, shown.find("path").unwrap_or(""), content },
        "", BUILD_MS, MAX_BUILT, c.arena) catch
        queue_json_error(c, 500)
        return
    // Caution: **A module cut at the cap is no module**: sent with 200, the page would fail to
    // load it with no reason given.
    if got.exited_with(0) && !got.output_cut
        conn.queue_response(c, 200, "application/wasm", got.stdout_data, keep)
        return
    $why: = "the build took longer than 60 s"
    if !got.exited_with(0) && got.exit_code.is_some()
        why = got.text(c.arena)
    else if got.output_cut
        why = "the built module is larger than 16 MiB"
    queue_refusal(c, 422, why)

// ==========================================
// The dispatch under `/api/`, checked before static serving (a file named `api` under the root
// loses)
// ==========================================

priv enum Api //< the endpoint a route reaches
    file
    stat
    list
    move
    here
    stop
    allow
    build
    status

priv struct Route //< one entry point under `/api/`
    path: U8[] //< the path
    reach: Reach //< in which mode it exists; in the other it is a 404 (`reaches`)
    methods: U8[] //< the methods it takes, as a 405's `Allow` names them; another one is a 405
    api: Api //< the endpoint it reaches

priv const ROUTES: Route[9] = ::{ //<
    //< Every entry point, with who may reach it and by which methods
    //< **The guards run once, here, for every row**: decided per endpoint, a new one forgets one.
    //< `/api/file` has no `HEAD`: `/api/stat` gives the size and whether it exists (Principle 6).
    Route::{ .path = "/api/file", .reach = .local, .methods = "GET, PUT", .api = .file },
    Route::{ .path = "/api/stat", .reach = .local, .methods = "GET", .api = .stat },
    Route::{ .path = "/api/list", .reach = .local, .methods = "GET", .api = .list },
    Route::{ .path = "/api/move", .reach = .local, .methods = "POST", .api = .move },
    Route::{ .path = "/api/here", .reach = .local, .methods = "GET", .api = .here },
    Route::{ .path = "/api/stop", .reach = .local, .methods = "POST", .api = .stop },
    Route::{ .path = "/api/allow", .reach = .local, .methods = "GET, POST, DELETE",
        .api = .allow },
    Route::{ .path = "/api/build", .reach = .local, .methods = "POST", .api = .build },
    Route::{ .path = "/api/status", .reach = .both, .methods = "GET", .api = .status },
}

priv fn takes(r: Route, method: U8[]): Bool //< whether the route takes that method
    $rest: = r.methods
    for rest.len > 0
        cut: = rest.find_char(',').unwrap_or(rest.len)
        if rest.sub(0, cut).trim_spaces().equals(method)
            return true
        rest = rest.sub_from(cut + 1) if cut < rest.len else ""
    return false

fn queue_api(c: conn.Conn$@, t: conn.Target, req: http.Request$@, ctx: conn.Ctx$@, keep: Bool)
    // The connection pump authorizes the head before reading its body.
    for r in ROUTES
        if !t.path.equals(r.path)
            continue
        if !reaches(c, ctx, r.reach)
            return
        if !takes(r, req.method)
            queue_json_error(c, 405, r.methods)
            return
        r.api.queue(c, t, req, ctx, keep)
        return
    queue_json_error(c, 404)

impl Api
    priv fn queue(r: Self, c: conn.Conn$@, t: conn.Target, req: http.Request$@, ctx: conn.Ctx$@,
        keep: Bool) //<
            //< Hands one request to this endpoint, once `queue_api`'s guards have passed
        switch r
        case .file
            queue_api_file(c, t, req, ctx.root, keep)
        case .stat
            queue_api_stat(c, t.query, ctx.root, keep)
        case .list
            queue_api_list(c, t.query, ctx.root, keep)
        case .move
            queue_api_move(c, t.query, ctx.root, keep)
        case .here
            queue_api_here(c)
        case .stop
            queue_api_stop(c)
        case .allow
            queue_api_allow(c, t.query, req, ctx, keep)
        case .build
            queue_api_build(c, t.query, ctx, keep)
        case .status
            queue_api_status(c, ctx, keep)

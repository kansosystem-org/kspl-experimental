//< Every request's first step, and static serving: which file a request names under the root
//< **`queue_for_request` takes each whole request**: it sends `/api/` to `kssrv/api.kspl` and
//< serves the rest as a file. The accept loop in `kssrv/main.kspl` calls it.
//< **Every check on a static path is here**: the page, the dot names and the climbs out of the
//< root.
import "kssrv/api"
import "kssrv/conn"
import "std/chars"
import "std/ds"
import "std/fs"
import "std/http"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/sys"
import "std/url"

const LOCAL_HOST: U8[] = "127.0.0.1" //< the loopback address that local use listens on
    //< `names_this_server` accepts it as a `Host`, as it does `localhost`.

priv const INDEX_NAME: U8[] = "index.html" //<
    //< the file looked for when the root itself is requested

// ==========================================
// Resolving a static file
// ==========================================

priv fn content_type_for(path: U8[]): U8[] //< looks the Content-Type up from the extension
    //< An unknown extension is not guessed but given `application/octet-stream`: a receiver trusts
    //< a wrong type (misread as HTML, a script runs).
    //< **The extension's letter case does not count**: a camera on Windows names its files
    //< `PHOTO.JPG`, and a browser downloads a page or refuses a module sent as octet-stream.
    $ext: U8[] = ""
    if dot: = path.rfind_char('.')
        ext = path.sub_from(dot)
    if ext.equals_ignore_case(".html") || ext.equals_ignore_case(".htm")
        return "text/html; charset=utf-8"
    if ext.equals_ignore_case(".css")
        return "text/css; charset=utf-8"
    if ext.equals_ignore_case(".js") || ext.equals_ignore_case(".mjs")
        return "text/javascript; charset=utf-8"
    if ext.equals_ignore_case(".json")
        return "application/json"
    if ext.equals_ignore_case(".txt") || ext.equals_ignore_case(".md")
        return "text/plain; charset=utf-8"
    if ext.equals_ignore_case(".svg")
        return "image/svg+xml"
    if ext.equals_ignore_case(".png")
        return "image/png"
    if ext.equals_ignore_case(".jpg") || ext.equals_ignore_case(".jpeg")
        return "image/jpeg"
    if ext.equals_ignore_case(".gif")
        return "image/gif"
    if ext.equals_ignore_case(".webp")
        return "image/webp"
    if ext.equals_ignore_case(".ico")
        return "image/vnd.microsoft.icon"
    if ext.equals_ignore_case(".wasm")
        return "application/wasm"
    return "application/octet-stream"

priv enum Rel_path //< what a percent-decoded path names under the root
    ok(path: U8[]) //< the file to serve, the root joined in, on the arena
    // A path not accepted as a name under the root (a `..` step, a NUL, a Windows device name or
    // short name, a link in an intermediate folder: everything `fs.join_under` refuses).
    rejected
    hidden //< a name in it starts with a dot (`fs.join_under`'s `hidden`): answered as absent

priv const SHOWN_DOT_NAMES: U8[][_] = ::{ ".well-known" } //< the one dot folder served (RFC 8615)
    //< Certificate issuance (ACME) and other discovery read under it, so hiding it would break
    //< them.

fn asks_for_page(decoded: U8[]): Bool //<
    //< Whether a decoded path names the page: the root itself, or `index.html` in it
    //< **Decided from the text alone.** So a caller can ask it before looking at anything under the
    //< root (the reason is at the token's check in `accept_head`).
    $rest: = decoded
    for rest.len > 0 && rest[0] == '/'
        rest = rest.sub_from(1)
    return rest.len == 0 || rest.equals(INDEX_NAME)

priv fn path_to_rel(decoded: U8[], root: U8[], is_page: Bool, arena: Arena$@): Rel_path
    // **The page is the root's index file and nothing else** (`asks_for_page`). Otherwise a folder
    // standing at that name would have its own index served as the page, without the token.
    if is_page
        return under(root, INDEX_NAME, arena)
    // The root itself is the page, so the path is never empty here.
    t: = api.url_rel(decoded)
    // Caution: **Check the name that is served, not the one asked for.** A folder gives its index.
    // Checked before the index is added, a link at a folder's index would serve its target for the
    // folder's own path. Yet the server refuses the index asked for by name.
    got: = under(root, t, arena)
    switch got
    case .ok(path)
        if fs.is_dir(path)
            return under(root, arena.text().s(t).c('/').s(INDEX_NAME).take(), arena)
    default {}
    return got

priv fn under(root: U8[], rel: U8[], arena: Arena$@): Rel_path //< `rel` checked and joined
    // Caution: **Do not serve a name starting with a dot.** A root that is a checkout or holds
    // settings has `.git/` and `.env`, and anyone the server faces could read them. Answered as
    // absent (404), so a probe learns nothing of what is there.
    path: =
        fs.join_under(root, rel, .refused(U8[][]::SHOWN_DOT_NAMES), arena) catch why
            return .hidden if why == .hidden else .rejected
    return .ok(path)

fn names_this_server(req: http.Request@): Bool //<
    //< Whether the `Host` header names this machine's loopback, as the token's URL does
    //< **The port is not compared**: a re-pointed page always sends its own name, so the name alone
    //< tells it apart. `http.parse_request` refuses a second `Host`, so the one found is the only
    //< one.
    host: = req.headers.find("Host").unwrap_or("")
    name: = host.sub(0, host.find_char(':').unwrap_or(host.len))
    return name.equals(LOCAL_HOST) || name.equals_ignore_case("localhost")

// ==========================================
// Static files
// ==========================================

fn queue_for_request(c: conn.Conn$@, req: http.Request$@, ctx: conn.Ctx$@) //<
    //< Builds the response to one complete request
    conn.stats.requests += 1I64
    // **Every request shows someone is still there.** Stamped per endpoint, the next endpoint added
    // would forget it.
    conn.used_us = sys.mono_us()
    is_head: = req.method.equals("HEAD")
    is_get: = req.method.equals("GET")
    keep_alive: = !req.wants_close()
    t: = conn.split_target(req.target)
    // **Under `/api/` every answer is JSON, a refusal's included**: an API client reads one form.
    is_api: = t.path.starts_with(api.API_PREFIX)
    if is_api
        api.queue_api(c, t, req, ctx, keep_alive)
        return
    // Static serving is GET/HEAD only (the API's POST branched off before this).
    if !is_get && !is_head
        conn.queue_error(c, 405, "GET, HEAD")
        return

    // **Use `decode_component`**, which keeps a `+`: a space written as `+` is a query's
    // convention, not a path's (see std/url.kspl). The decode happens only once.
    decoded: = url.decode_component(t.path, c.arena) catch _e
        conn.queue_error(c, 400)
        return
    // **Only the named page may be outside the root** (`--page`). Only `/` and `/index.html` are
    // replaced, and **the client cannot choose it with a string it wrote** (`path_to_rel` refuses a
    // `..` or an absolute path). The agreement is "Where it listens" in
    // `docs/SPEC-local-server.md`.
    is_page: = asks_for_page(decoded)
    // A directory becomes its index (`/docs` and `/docs/` alike) in `path_to_rel`.
    $target_path: U8[] = ""
    if is_page && ctx.page.len > 0
        // **The named page replaces the root's index, so that index is not checked.** Checked, a
        // link standing at `index.html` in the root refused the page with a 403.
        target_path = ctx.page
    else
        switch path_to_rel(decoded, ctx.root, is_page, c.arena)
        case .ok(path)
            target_path = path
        case .rejected
            // A path let through could return a file outside the root, or one Windows reads as
            // another name. A 403, not a 404: the form was refused, and whether the name exists is
            // not checked.
            conn.queue_error(c, 403)
            return
        case .hidden
            conn.queue_error(c, 404)
            return

    $size: Sz = 0
    if found: = conn.regular_file_size(target_path)
        size = found
    else
        conn.queue_error(c, 404)
        return

    ctype: = content_type_for(target_path)
    if is_head
        // A HEAD's Content-Length names the real length; 0 would read as "an empty file".
        conn.queue_to_head(c, 200, ctype, size, keep_alive)
        return

    // The stat found it, so an open that fails is the server's fault, not a missing name.
    file: = io.open(target_path, "rb") catch _e
        conn.queue_error(c, 500)
        return
    conn.queue_file(c, ctype, file, size, keep_alive)

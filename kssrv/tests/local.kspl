//< Tests the file endpoints of `kssrv --local`
//< For local use; not a suite; part of `kssrv/tests/main.kspl`.
//< **It can only be tested in a separate process.** Local or outward-facing is chosen at start-up,
//< so one process cannot show both. Starting the server is the caller's job; this file holds only
//< the checks after connecting. **A second endpoint is the same hole again**, so this checks that
//< a path the static serving refuses is refused by the file endpoint too.
import "kssrv/tests/client"
import "std/chars"
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/sha256"
import "std/str"
import "std/strfmt" as _strfmt
import "std/subproc"
import "std/verdict"

priv const PUT_BODY: U8[] = "かんそ\nwritten\n" //< the body written back
    //< **Include something outside ASCII.** If anything on the way treats the bytes as a string,
    //< only this shows it.

priv const CEILING: Sz = 8 * 1024 * 1024 //< the protocol's ceiling on a written file
    //< It is the number "Files" in `docs/SPEC-local-server.md` sets, which a page relies on, so
    //< the check holds the server to the protocol rather than to its own constant.

fn make_link(root: U8[], name: U8[], target: U8[], arena: Arena$@): Bool //<
    //< A link inside the root pointing outside
    //< **A name check alone cannot block it**: `link.txt` is a legitimate name, so looking for `..`
    //< misses it. False where it cannot be made, and the case becomes a `skip` (Windows has no
    //< `ln -s`, and `mklink` needs privileges).
    at: = fs.join(root, name, arena)
    r: =
        subproc.run_capture(U8[][]::{ "ln", "-s", target, at }, "", 10000, 4096, arena) catch
        return false
    return r.exited_with(0) && fs.is_link(at)

fn mode_column(path: U8[], mode: U8[], arena: Arena$@): U8[] //<
    //< Sets a file's mode with `chmod`, then reads it back as `ls -l` prints it (`-rwx------`)
    //< Empty where either cannot run (Windows has no mode), and the case becomes a `skip`. **Read
    //< through `ls -l`**, the one way POSIX prints it (`stat`'s options differ between systems).
    if mode.len > 0
        set: =
            subproc.run_capture(U8[][]::{ "chmod", mode, path }, "", 10000, 4096, arena) catch
            return ""
        if !set.exited_with(0)
            return ""
    r: =
        subproc.run_capture(U8[][]::{ "ls", "-l", path }, "", 10000, 4096, arena) catch
        return ""
    if !r.exited_with(0) || r.stdout_data.len < 10
        return ""
    return arena.dup_str(r.stdout_data.sub(0, 10))

fn cases(port: I32, token: U8[], root: U8[], arena: Arena$@): Void!client.Http_end //<
    //< Runs every check on the local-use server, one topic after another
    auth: = client.bearer_head(token, arena)
    early_cases(port, auth, arena)!
    token_cases(port, auth, root, arena)!
    host_cases(port, auth, arena)!
    early_head_cases(port, auth, arena)!
    refusal_cases(port, token, arena)!
    status_cases(port, auth, arena)!
    read_cases(port, auth, arena)!
    stat_cases(port, auth, arena)!
    list_cases(port, auth, root, arena)!
    write_cases(port, auth, root, arena)!
    conditional_cases(port, auth, arena)!
    cap_cases(port, auth, arena)!
    files_only_cases(port, auth, arena)!

priv fn early_head_cases(port: I32, auth: U8[], arena: Arena$@): Void!client.Http_end
    defer $valid: = client.Conn.open(port)!
    // Split the last CRLF too, so checking a partial head cannot lose authentication.
    valid
        .send(arena.text().s("PUT /api/file?path=early.txt HTTP/1.1\r\nHost: 127.0.0.1\r\n").s(auth)
        .s("Content-Length: 5\r\n\r").take())!
    valid.send("\nhe")!
    $waiting: = false
    _early: = valid.next(false, 50, arena) catch e
        if e != .timed_out
            throw e
        waiting = true
    verdict.check("an authorized upload waits for its remaining bytes", waiting, "")
    valid.send("llo")!
    saved: = valid.next(false, 3000, arena)!
    client.expect_status("an authorized partial upload completes", saved, 200, arena)
    read: = client.get(port, "/api/file?path=early.txt", auth, arena)!
    verdict.check("the partial upload keeps all its bytes", read.body.equals("hello"), "")
    // A token on the first request must not authorize the next one on that connection.
    valid
        .send("PUT /api/file?path=early.txt HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: \
            200000\r\n\r\n")!
    again: = valid.next(false, 3000, arena)!
    client.expect_status("each keep-alive request needs its own token", again, 401, arena)

priv fn token_cases(port: I32, auth: U8[], root: U8[], arena: Arena$@): Void!client.Http_end //<
    //< which files need the token
    // **The page itself needs no token.** The page is how the token is passed on,
    // so requiring one there leaves no way to pass it.
    page: = client.get(port, "/", "", arena)!
    ok1: = page.status == 200 && page.body.equals("root index\n")
    verdict.check("even on --local the page is handed out without a token", ok1,
        client.shown(page, arena))
    // **Every other file needs the token.** From the token's origin, an HTML file in the root could
    // read it. And any program on this machine could read the root. The page reads its pictures
    // through `/api/file`.
    for target in U8[][]::{ "/sub/one.txt", "/sub/", "/style.css" }
        other: = client.get(port, target, "", arena)!
        nm_o: = arena.text().s("--local hands out no file but the page without a token: ").s(target)
            .take()
        client.expect_status(nm_o, other, 401, arena)
    // **Without the token, a link answers as every other name does.** Resolved before the token is
    // checked, a link answers 403 and any other name 401. A client without the token then learns
    // which names under the root are links.
    if make_link(root, "peek.txt", "../secret.txt", arena)
        for target in U8[][]::{ "/peek.txt", "/no-such.txt", "/.hidden" }
            r: = client.get(port, target, "", arena)!
            nm_p: = arena.text().s("--local answers a name without the token as any other: ")
                .s(target).take()
            client.expect_status(nm_p, r, 401, arena)
    else
        verdict.skip_check("--local answers a link without the token as any other name",
            "a link cannot be made with `ln -s` in this environment")
    with_token: = client.get(port, "/sub/one.txt", auth, arena)!
    verdict.check("--local hands out a file under the root to the token",
        with_token.status == 200 && with_token.body.equals("one\n"),
        client.shown(with_token, arena))

priv fn host_cases(port: I32, auth: U8[], arena: Arena$@): Void!client.Http_end //<
    //< the `Host` a request names
    // **A page whose name is re-pointed at 127.0.0.1 (DNS rebinding) sends its own name.** So the
    // server refuses a request naming another host, even for the page or with the token.
    rebound: = "Host: attacker.example\r\n"
    r_page: = client.get(port, "/", rebound, arena)!
    client.expect_status("--local refuses a Host other than the loopback: the page", r_page, 403,
        arena)
    r_api: = client.get(port, "/api/status",
        arena.text().s(rebound).s(auth).take(), arena)!
    verdict.check("--local refuses a Host other than the loopback: with the token, in JSON",
        r_api.status == 403 && client.is_json(r_api), client.shown(r_api, arena))

    // **A second `Host` is refused whichever comes first.** Taking the first, a request naming the
    // loopback and then another host would pass as this server's.
    host_names: U8[][2] = ::{ "two names", "one name twice" }
    host_heads: U8[][2] = ::{ "Host: 127.0.0.1\r\nHost: attacker.example\r\n",
        "Host: 127.0.0.1\r\nHost: 127.0.0.1\r\n" }
    for i in Range.asc(2)
        r: = client.get(port, "/", host_heads[i], arena)!
        nm_h: = arena.text().s("--local refuses a request naming Host twice: ").s(host_names[i])
            .take()
        client.expect_status(nm_h, r, 400, arena)

priv fn refusal_cases(port: I32, token: U8[], arena: Arena$@): Void!client.Http_end //<
    //< a missing or wrong token
    // Caution: **Do not decide per endpoint whether a token is needed**, or a new endpoint forgets.
    // This also checks that the existing endpoints need one.
    for target in U8[][]::{ "/api/status", "/api/file?path=sub/one.txt",
        "/api/stat?path=sub/one.txt" }
        r: = client.get(port, target, "", arena)!
        nm: = arena.text().s("--local refuses a request with no token: ").s(target).take()
        client.expect_status(nm, r, 401, arena)
    // Caution: **Do not put the raw header in the check's name.** A CRLF in it breaks the output's
    // lines, so what was tried is described in words.
    bad_names: U8[][3] = ::{ "an empty token", "a different token", "a token with no Bearer" }
    bad_heads: U8[][3] = ::{ "Authorization: Bearer \r\n", "Authorization: Bearer deadbeef\r\n",
        "Authorization: deadbeef\r\n" }
    for i in Range.asc(3)
        r: = client.get(port, "/api/file?path=sub/one.txt", bad_heads[i], arena)!
        nm: = arena.text().s("--local refuses a token that does not match: ").s(bad_names[i]).take()
        client.expect_status(nm, r, 401, arena)
    // Caution: A token that merely **starts with** the real one must not pass (a prefix match would
    // let it through).
    longer: = client.bearer_head(arena.text().s(token).c('x').take(), arena)
    extra: = client.get(port, "/api/file?path=sub/one.txt", longer, arena)!
    client.expect_status("--local refuses characters appended behind the token", extra, 401, arena)

priv fn status_cases(port: I32, auth: U8[], arena: Arena$@): Void!client.Http_end //<
    //< what `/api/status` declares
    // **It must declare that it is for local use.** The page reads this and shows the local tools
    // (rather than having to probe the server to find out).
    st0: = client.get(port, "/api/status", auth, arena)!
    verdict.check("--local's status declares it is for local use",
        client.doc_of(st0, arena).get("local").as_bool().unwrap_or(false),
        client.shown(st0, arena))

priv fn read_cases(port: I32, auth: U8[], arena: Arena$@): Void!client.Http_end //< reading a file
    got: = client.get(port, "/api/file?path=sub/one.txt", auth, arena)!
    ok2: = got.status == 200 && got.body.equals("one\n")
    verdict.check("GET /api/file returns the content", ok2, client.shown(got, arena))
    // Caution: **Do not guess the type from the content.** The receiver trusts a guessed type and
    // interprets the content by it.
    ctype: = client.header(got.head, "content-type")
    verdict.check("/api/file returns as octet-stream", ctype.equals("application/octet-stream"),
        ctype)

    // A path the static serving refuses must be refused here too.
    for q in U8[][]::{ "path=../secret.txt", "path=%2e%2e/secret.txt", "path=sub/../../secret.txt" }
        r: = client.get(port, arena.text().s("/api/file?\{q\}").take(), auth, arena)!
        nm: = arena.text().s("/api/file refuses outside the root too: \{q\}").take()
        client.expect_status(nm, r, 403, arena)
    // **`path=` is relative to the root.** So an absolute path in any OS's spelling is refused. It
    // is never looked up under the root with its leading separator dropped.
    for q in U8[][]::{ "path=/etc/passwd", "path=%2Fetc%2Fpasswd", "path=//sub/one.txt",
        "path=C:%5CWindows%5Cwin.ini", "path=C:sub/one.txt", "path=%5C%5Cserver%5Cshare%5Cx" }
        r: = client.get(port, arena.text().s("/api/file?\{q\}").take(), auth, arena)!
        nm: = arena.text().s("/api/file refuses an absolute path: \{q\}").take()
        client.expect_status(nm, r, 403, arena)
    abs_stat: = client.get(port, "/api/stat?path=/sub/one.txt", auth, arena)!
    client.expect_status("/api/stat refuses an absolute path too", abs_stat, 403, arena)
    missing: = client.get(port, "/api/file?path=nope.txt", auth, arena)!
    client.expect_status("a name that is not there is 404", missing, 404, arena)
    // On some OSes `fopen` succeeds on a folder. Judged by the read result alone, it looks like a
    // broken file.
    folder: = client.get(port, "/api/file?path=sub", auth, arena)!
    client.expect_status("a folder is not returned as a file", folder, 404, arena)
    named: = client.get(port, "/api/file", auth, arena)!
    client.expect_status("/api/file with no name is 400", named, 400, arena)
    head_raw: = client.raw("HEAD", "/api/file?path=sub/one.txt", auth, "", arena)
    heads: = client.request(port, head_raw, 1, client.DEFAULT_TIMEOUT_MS, true, arena)!
    client.check_405("there is no HEAD on /api/file", heads.get(0), "GET, PUT", arena)
    verdict.check("the HEAD refused on /api/file is JSON's", client.is_json(heads.get(0)),
        heads.get(0).head)

priv fn stat_cases(port: I32, auth: U8[], arena: Arena$@): Void!client.Http_end //<
    //< whether a file has changed
    st: = client.get(port, "/api/stat?path=sub/one.txt", auth, arena)!
    doc: = client.doc_of(st, arena)
    ok3: =
        st.status == 200 && doc.get("size").as_int().unwrap_or(-1) == 4 &&
        doc.get("changed_at").as_int64().unwrap_or(0I64) > 0I64
    verdict.check("/api/stat returns the size and the time", ok3, client.shown(st, arena))
    // Caution: **Do not return the content.** Returned here, the same content comes by two paths.
    verdict.check("/api/stat does not return the content",
        st.body.find_str("one").is_none(), client.shown(st, arena))
    st_gone: = client.get(port, "/api/stat?path=nope.txt", auth, arena)!
    client.expect_status("/api/stat on a name that is not there is 404", st_gone, 404, arena)

priv const LISTED_MAX: Sz = 2000 //< the most names one listing returns, as the protocol sets it

priv fn list_cases(port: I32, auth: U8[], root: U8[], arena: Arena$@): Void!client.Http_end //<
    //< the names in one folder, for a Save As dialog
    listed: = fs.join(root, "listed", arena)
    fs.mkdir_all(fs.join(listed, "c", arena)) catch
        verdict.check("/api/list names the folders and files", false, "the folder cannot be made")
        return
    fs.write_tree(listed, U8[][]::{ "b.txt", "a.txt", ".hid" }, U8[][]::{ "b", "a", "h" }, arena)
        catch
        verdict.check("/api/list names the folders and files", false, "the files cannot be made")
        return
    // **A link is left out**, so the dialog never offers a way out of the root.
    linked: = make_link(listed, "d", "..", arena)
    r: = client.get(port, "/api/list?path=listed", auth, arena)!
    want: = "{\"folders\":[\"c\"],\"files\":[\"a.txt\",\"b.txt\"],\"more\":false}"
    verdict.check("/api/list names the folders and files, sorted, hidden names left out",
        r.status == 200 && r.body.equals(want), client.shown(r, arena))
    if !linked
        verdict.skip_check("/api/list leaves a link out",
            "a link cannot be made with `ln -s` in this environment")
    top: = client.get(port, "/api/list", auth, arena)!
    verdict.check("/api/list with no path names the root",
        top.status == 200 && top.body.find_str("\"listed\"").is_some(),
        client.shown(top, arena))
    for q in U8[][]::{ "path=..", "path=listed/../..", "path=/etc" }
        out: = client.get(port, arena.text().s("/api/list?\{q\}").take(), auth, arena)!
        nm: = arena.text().s("/api/list refuses outside the root: \{q\}").take()
        client.expect_status(nm, out, 403, arena)
    file: = client.get(port, "/api/list?path=listed/a.txt", auth, arena)!
    client.expect_status("/api/list on a file is 404", file, 404, arena)
    none: = client.get(port, "/api/list?path=listed", "", arena)!
    client.expect_status("/api/list needs the token", none, 401, arena)
    // **One more name than the cap** shows that `more` tells the page others stand there.
    many: = fs.join(root, "many", arena)
    fs.mkdir_all(many) catch
        verdict.check("/api/list stops at its cap", false, "the folder cannot be made")
        return
    for i in Range.asc(LISTED_MAX + 1)
        io.write_file(fs.join(many, arena.text().s("f\{i\}").take(), arena), "") catch
            verdict.check("/api/list stops at its cap", false, "the files cannot be made")
            return
    capped: = client.get(port, "/api/list?path=many", auth, arena)!
    verdict.check("/api/list stops at its cap and says more stand there",
        capped.status == 200 && capped.body.ends_with("\"more\":true}"),
        client.shown(capped, arena))

priv fn conditional_cases(port: I32, auth: U8[], arena: Arena$@): Void!client.Http_end //<
    //< A stale writer and a second creator must leave the first writer's bytes intact.
    path: = "/api/file?path=conditional.txt"
    missing: = arena.text().s(auth).s("X-Kanso-If-Content: missing\r\n").take()
    first: = client.put_file(port, path, missing, "original", arena)!
    client.expect_status("conditional creation succeeds once", first, 200, arena)
    second: = client.put_file(port, path, missing, "overwrite", arena)!
    client.expect_status("conditional creation refuses an existing file", second, 409, arena)
    $hex: U8[sha256.HEX_LEN] = ::{}
    sha256.write_hex(sha256.hash("original"), U8$[]::hex)
    expected: = arena.text().s(auth).s("X-Kanso-If-Content: ").s(U8[]::hex).s("\r\n").take()
    saved: = client.put_file(port, path, expected, "winner", arena)!
    client.expect_status("matching content allows the write", saved, 200, arena)
    stale: = client.put_file(port, path, expected, "loser", arena)!
    client.expect_status("a stale baseline refuses the write", stale, 409, arena)
    got: = client.get(port, path, auth, arena)!
    verdict.check("the first writer's bytes survive", got.body.equals("winner"),
        client.shown(got, arena))
    bad: = arena.text().s(auth).s("X-Kanso-If-Content: invalid\r\n").take()
    refused: = client.put_file(port, path, bad, "bad", arena)!
    client.expect_status("malformed content guards are refused", refused, 400, arena)

priv fn write_cases(port: I32, auth: U8[], root: U8[], arena: Arena$@): Void!client.Http_end //<
    //< writing a file
    put: = client.put_file(port, "/api/file?path=sub/two.txt", auth, PUT_BODY, arena)!
    ok4: =
        put.status == 200 &&
        client.doc_of(put, arena).get("wrote").as_int().unwrap_or(-1) == PUT_BODY.len
    verdict.check("PUT /api/file returns the length written", ok4, client.shown(put, arena))
    // Caution: **Compare the written string byte by byte.** A length check alone passes even with
    // the encoding broken.
    back: = client.get(port, "/api/file?path=sub/two.txt", auth, arena)!
    ok5: = back.status == 200 && back.body.equals(PUT_BODY)
    verdict.check("the string written comes back byte for byte", ok5,
        client.shown(back, arena))
    // Caution: **Leave no half-written file.** The body is written beside the file first, under a
    // name of its own, and that name must be gone once the write is done.
    $parts: Sz = 0
    names: = fs.read_dir(fs.join(root, "sub", arena), arena) catch panic("sub/ must be readable")
    for name in names
        if name.ends_with(".part")
            parts += 1
    verdict.check("no half-written file is left", parts == 0, "a .part file stands in sub/")
    // Writing twice adds no file (it replaces the one of the same name).
    again: = client.put_file(port, "/api/file?path=sub/two.txt", auth, "second\n", arena)!
    twice: = client.get(port, "/api/file?path=sub/two.txt", auth, arena)!
    ok6: = again.status == 200 && twice.body.equals("second\n")
    verdict.check("writing twice replaces", ok6, client.shown(twice, arena))
    // Caution: **Hold the reading connection open while writing**, as a page does. An empty file
    // read on it stayed open in the server, and Windows cannot replace an open file. Only
    // Windows shows it: elsewhere the rename goes through.
    empty: = fs.join(root, "sub/empty.txt", arena)
    io.write_file(empty, "") catch panic("sub/ must be writable")
    defer $held: = client.Conn.open(port)!
    held.send(client.raw("GET", "/api/file?path=sub/empty.txt", auth, "", arena))!
    read: = held.next(false, client.DEFAULT_TIMEOUT_MS, arena)!
    client.expect_status("an empty file is read", read, 200, arena)
    over: = client.put_file(port, "/api/file?path=sub/empty.txt", auth, "now\n", arena)!
    client.expect_status("an empty file read on an open connection can be written", over, 200,
        arena)
    // Caution: **A write keeps the file's mode.** Suppose it is written to another name and renamed
    // over the file. A file only its owner can read would then be readable by others. A script
    // would lose its execute bit.
    two: = fs.join(root, "sub/two.txt", arena)
    if mode_column(two, "700", arena).equals("-rwx------")
        _kept: = client.put_file(port, "/api/file?path=sub/two.txt", auth, "third\n", arena)!
        after: = mode_column(two, "", arena)
        verdict.check("a write keeps the file's mode", after.equals("-rwx------"), after)
    else
        verdict.skip_check("a write keeps the file's mode",
            "this system has no POSIX mode for `chmod` to set and `ls -l` to read")
    // Caution: Apply the root check to writing too (fix reading alone and a path outside the root
    // can still be written).
    out: = client.put_file(port, "/api/file?path=%2e%2e/secret.txt", auth, "x", arena)!
    client.expect_status("PUT refuses outside the root too", out, 403, arena)

priv fn cap_cases(port: I32, auth: U8[], arena: Arena$@): Void!client.Http_end //< the cap on a body
    // **Check both sides of the ceiling.** Below it, a document cannot be written back whole;
    // without it, one client fills the memory.
    base: = arena.save()
    big: = client.filler(CEILING, arena)
    whole: = client.put_file(port, "/api/file?path=sub/big.txt", auth, big, arena)!
    ok7: =
        whole.status == 200 &&
        client.doc_of(whole, arena).get("wrote").as_int().unwrap_or(-1) == CEILING
    verdict.check("--local writes a body of exactly the protocol's 8 MiB", ok7,
        client.shown(whole, arena))
    arena.restore(base)
    past: = client.filler(CEILING + 1, arena)
    over: = client.put_file(port, "/api/file?path=sub/over.txt", auth, past, arena)!
    client.expect_status("--local refuses one byte past 8 MiB with a 413", over, 413, arena)
    arena.restore(base)

priv fn files_only_cases(port: I32, auth: U8[], arena: Arena$@): Void!client.Http_end //<
    //< files, and nothing else
    // No endpoint starts a program, even for the token.
    for gone in U8[][]::{ "/api/run", "/api/plugins" }
        r: = client.get(port, gone, auth, arena)!
        nm_g: = arena.text().s("--local answers files only: ").s(gone).s(" is not there").take()
        client.expect_status(nm_g, r, 404, arena)

priv fn early_cases(port: I32, auth: U8[], arena: Arena$@): Void!client.Http_end //<
    //< refuses a head before its body
    for which in Range.asc(3)
        defer $c: = client.Conn.open(port)!
        host: = "untrusted.example" if which == 1 else "localhost"
        target: = "/" if which == 2 else "/api/file?path=early.txt"
        method: = "GET" if which == 2 else "PUT"
        head: = arena.text().s(method).s(" ").s(target).s(" HTTP/1.1\r\nHost: ").s(host)
            .s("\r\nContent-Length: 200000\r\nConnection: close\r\n")
        if which == 1
            head.s(auth)
        c.send(head.s("\r\n").take())!
        got: = c.next(false, client.DEFAULT_TIMEOUT_MS, arena)!
        client.expect_status("a refused head needs no body", got, 403 if which == 1 else 401, arena)

//< Tests that files asked for in turn on one kept connection come at once
//< For local use; not a suite; part of `kssrv/tests/main.kspl`, which serves `sub/one.txt`.
//< A file's head sent alone waited for the client's delayed ACK, about 40 ms a file
//< (`conn_send` in `kssrv/main.kspl`).
import "kssrv/tests/client"
import "std/ds"
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

priv const KEPT_ROUNDS: Sz = 10 //< how many answers one kept connection asks for in turn

priv fn writes_now(port: I32, arena: Arena$@): I64!client.Http_end //<
    //< The server's writes to sockets so far (`writes` in `/api/status`); -1 where not told
    st: = client.get(port, "/api/status", "", arena)!
    return client.doc_of(st, arena).get("writes").as_int64().unwrap_or(-1I64)

priv fn kept_round(port: I32, whole: Bool$@, arena: Arena$@): Void!client.Http_end //<
    //< Asks for `KEPT_ROUNDS` files in turn on one kept connection
    //< `whole` turns false if one answer is not the file with a 200.
    defer $c: = client.Conn.open(port)!
    for _i in Range.asc(KEPT_ROUNDS)
        c.send(client.raw("GET", "/sub/one.txt", "", "", arena))!
        got: = c.next(false, client.DEFAULT_TIMEOUT_MS, arena)!
        if got.status != 200 || !got.body.equals("one\n")
            whole$ = false

fn file_cases(port: I32, arena: Arena$@): Void!client.Http_end //<
    //< Files asked for one after another on one kept connection come at once, not 40 ms apart
    //< **The server's writes are counted, not the time taken.** A head written alone waits for the
    //< client's delayed ACK, so each answer must go out in one write. A count is the same on every
    //< machine; a time on a busy runner moved 5 times with no fault.
    $whole: = true
    before: = writes_now(port, arena)!
    kept_round(port, whole@, arena)!
    after: = writes_now(port, arena)!
    verdict.check("files asked for in turn each come whole", whole, "")
    // **One more write is the answer that told `before`**: the count was read before it went.
    verdict.check("each file asked for in turn on one connection goes out in one write",
        before >= 0I64 && after - before == I64::KEPT_ROUNDS + 1I64,
        arena.text().s("\{after - before\} writes for \{KEPT_ROUNDS\} files").take())

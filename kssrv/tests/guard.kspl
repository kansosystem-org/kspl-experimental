//< What a client facing the server from outside cannot take from it
//< The names it does not hand out, the memory a large file costs, and the slots one address may
//< hold. Run by `kssrv/tests/main.kspl` against the outward-facing server.
import "kssrv/tests/client"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/sys"
import "std/verdict"

// The names served or not, placed by `place`. **A name starting with a dot is answered as absent,
// `.well-known` aside** (`hides_name` in `kssrv/main.kspl`).
priv const DOT_RELS: U8[][4] = ::{ ".env", ".git/config", "sub/.hidden.txt",
    ".well-known/acme.txt" }
priv const DOT_BODIES: U8[][4] = ::{ "SECRET=1\n", "[core]\n", "hidden\n", "well known\n" }
priv const HIDDEN_TARGETS: U8[][5] = ::{ "/.env", "/.git/config", "/sub/.hidden.txt", "/%2eenv",
    "/sub//.hidden.txt" }

priv const SLASHES: Sz = 3900 //< how many `/` follow `/sub` in the request whose cost is bounded
    //< The path stays short of the 4 KiB one lookup takes, so a walk that looked up every
    //< segment, the empty ones included, would look up each of them.
priv const SLASH_ROUNDS: Sz = 100 //< how many times the request with many `/` and the plain one go
priv const SLASH_RATIO: I64 = 4I64 //< how many times longer the many `/` may take than the plain
priv const SLASH_SLACK_US: I64 = 500000I64 //< the time added to that bound, for a busy machine

priv const BIG_REL: U8[] = "big.bin" //< larger than the chunks the server sends a file in
priv const BIG_BYTES: Sz = 3 * 1024 * 1024 + 7 //< not a multiple of a chunk, so the last is short

priv const READERS: Sz = 4 //< how many readers hold the large file unread at once

priv const ALONE_POLL_MS: I32 = 10 //< how often `alone` asks again

priv const PER_PEER: Sz = 16 //< `MAX_CONNS_PER_PEER` in `kssrv/conn.kspl`
    //< The server is driven from outside, so the figure is stated here. A change there fails the
    //< check on the cap rather than passing it silently.

fn place(root: U8[], arena: Arena$@): Bool //< puts this file's fixtures under the root
    fs.write_tree(root, U8[][]::DOT_RELS, U8[][]::DOT_BODIES, arena) catch
        return false
    io.write_file(fs.join(root, BIG_REL, arena), client.filler(BIG_BYTES, arena)) catch
        return false
    // Elsewhere a `\` is part of a name, so the file Windows reaches by `sub\.hidden.txt` is
    // made under that name: the request then finds a file, and only the refusal keeps it back.
    if !sys.is_windows()
        literal: = arena.text().s(root).s("/sub\\.hidden.txt").take()
        io.write_file(literal, "SECRET=2\n") catch
            return false
    return true

fn cases(port: I32, arena: Arena$@): Void!client.Http_end //< every check in this file, in turn
    dot_cases(port, arena)!
    slash_cases(port, arena)!
    big_cases(port, arena)!
    trickle_cases(port, arena)!
    peer_cases(port, arena)!

priv fn dot_cases(port: I32, arena: Arena$@): Void!client.Http_end //<
    //< A name starting with a dot is a 404, and `.well-known` is served
    for target in HIDDEN_TARGETS
        r: = client.get(port, target, "", arena)!
        nm: = arena.text().s("a name starting with a dot is not served: \{target\}").take()
        verdict.check(nm, r.status == 404 && r.body.find_str("SECRET").is_none(),
            client.shown(r, arena))
    // **On POSIX a `\` is refused outright** (403), since no file named with one can be saved.
    // Windows reads it as `sub/.hidden.txt`, a hidden name.
    back: = client.get(port, "/sub%5c.hidden.txt", "", arena)!
    want: = 404 if sys.is_windows() else 403
    verdict.check("a path holding a `\\` is refused on POSIX and hidden on Windows",
        back.status == want && back.body.find_str("SECRET").is_none(),
        client.shown(back, arena))
    wk: = client.get(port, "/.well-known/acme.txt", "", arena)!
    verdict.check("`.well-known` is still served",
        wk.status == 200 && wk.body.equals("well known\n"), client.shown(wk, arena))

priv fn slash_cases(port: I32, arena: Arena$@): Void!client.Http_end //<
    //< An empty segment is skipped: `a//b` is `a/b`, and many `/` cost no more than one
    //< Caution: **Measure the cost against the plain request on the same server**, so a slow
    //< machine or a sanitizer slows both. One lookup per `/` takes hundreds of times as long.
    one: = client.get(port, "/sub//one.txt", "", arena)!
    verdict.check("a path with an empty segment is served as if it had none",
        one.status == 200 && one.body.equals("one\n"), client.shown(one, arena))
    b: = arena.text().s("/sub")
    for _i in Range.asc(SLASHES)
        b.c('/')
    many: = b.take()
    plain_us: = rounds_us(port, "/sub/", arena)!
    many_us: = rounds_us(port, many, arena)!
    last: = client.get(port, many, "", arena)!
    verdict.check("a folder's path followed by many `/` is still its index",
        last.status == 200 && last.body.equals("sub index\n"), client.shown(last, arena))
    verdict.check("many `/` in a row cost the server about what one costs",
        many_us <= plain_us * SLASH_RATIO + SLASH_SLACK_US,
        arena.text()
        .s("\{SLASH_ROUNDS\} requests took \{many_us\} us; with one `/`, \{plain_us\} us").take())

priv fn rounds_us(port: I32, target: U8[], arena: Arena$@): I64!client.Http_end //<
    //< How long `SLASH_ROUNDS` requests for `target`, sent at once on one connection, take
    //< **They are sent together**, so the time is the server's work. One at a time, each would
    //< also wait out the network's delays, which are longer than the work measured.
    one: = client.raw("GET", target, "", "", arena)
    all: = arena.text()
    for _i in Range.asc(SLASH_ROUNDS)
        all.s(one)
    raw: = all.take()
    from: = sys.mono_us()
    client.request(port, raw, SLASH_ROUNDS, client.DEFAULT_TIMEOUT_MS, false, arena)!
    return sys.mono_us() - from

priv fn big_cases(port: I32, arena: Arena$@): Void!client.Http_end //<
    //< A file sent in chunks arrives whole, and its length is the one the head names
    r: = client.get(port, arena.text().c('/').s(BIG_REL).take(), "", arena)!
    want: = client.filler(BIG_BYTES, arena)
    named: = client.header(r.head, "content-length")
    d: = arena.text().s("\{r.status\}, \{r.body.len\} bytes, Content-Length ").s(named).take()
    verdict.check("a file larger than a chunk arrives whole and in order",
        r.status == 200 && r.body.equals(want), d)
    // **A download nobody reads holds a chunk, not the file.** Held whole, `READERS` slow readers
    // hold `READERS` copies, and enough of them run the server out of memory.
    first: = client.get(port, "/api/status", "", arena)!
    before: = client.doc_of(first, arena).get("heap_bytes").as_int64().unwrap_or(-1I64)
    asked: = client.doc_of(first, arena).get("requests").as_int64().unwrap_or(-1I64)
    $slow: = List<|client.Conn$@|>(arena)
    defer free_all(slow@)
    for _i in Range.asc(READERS)
        one: = client.Conn.open_in(port, arena)!
        one
            .send(client.raw("GET", arena.text().c('/').s(BIG_REL).take(), "", "", arena))!
        slow.push(one)
    during: = heap_once_served(port, asked + I64::READERS, arena)!
    grown: = during - before
    bound: = I64::BIG_BYTES
    verdict.check("a large file held unread by several readers costs less than one copy of it",
        before > 0I64 && during > 0I64 && grown < bound,
        arena.text().s("the heap grew by \{grown\} bytes; one copy is \{bound\}").take())

priv fn trickle_cases(port: I32, arena: Arena$@): Void!client.Http_end //<
    //< A request sent a byte at a time is answered; a bare LF is still refused at once
    //< Caution: **Split the head's end between sends too**: the server looks for it only where it
    //< can newly be (`head_decided` in `kssrv/main.kspl`).
    defer $conn: = client.Conn.open(port)!
    raw: = client.raw("GET", "/style.css", "", "", arena)
    for i in Range.asc(raw.len)
        conn.send(raw.sub(i, 1))!
        sys.sleep_ms(1)
    got: = conn.next(false, client.DEFAULT_TIMEOUT_MS, arena)!
    verdict.check("a request sent a byte at a time is answered",
        got.status == 200 && got.body.equals("body{}\n"), client.shown(got, arena))
    bare: = client.request(port, "GET / HTTP/1.1\nHost: 127.0.0.1\n\n", 1,
        client.DEFAULT_TIMEOUT_MS, false, arena)!
    verdict.check("a head ending in bare LFs is still refused with a 400",
        bare.len == 1 && bare.get(0).status == 400, client.shown(bare.get(0), arena))

priv fn peer_cases(port: I32, arena: Arena$@): Void!client.Http_end //<
    //< One address holds at most `PER_PEER` connections; one closing makes room again
    //< Caution: **Start from none held**: one left from an earlier case takes a place among them.
    verdict.check("the server holds nothing from earlier cases before the cap is filled",
        alone(port, arena)!, "a connection from an earlier case stayed open")
    // **The connection asking how many are open is one of those held**: a further one would be
    // past the cap itself.
    $held: = List<|client.Conn$@|>(arena)
    defer free_all(held@)
    asker: = client.Conn.open_in(port, arena)!
    held.push(asker)
    for _i in Range.asc(PER_PEER - 1)
        held.push(client.Conn.open_in(port, arena)!)
    verdict.check("the server has accepted every connection held",
        open_reaches(asker, PER_PEER, arena)!, "it never counted them all open")
    defer $over: = client.Conn.open(port)!
    over.send(client.raw("GET", "/style.css", "", "", arena)) catch {}
    none: client.Resp = ::{ .status = 0, .head = "", .body = "" }
    refused: = over.next(false, 2000, arena) catch none
    nm: = arena.text().s("the connection past \{PER_PEER\} from one address is refused").take()
    client.expect_status(nm, refused, 0, arena)
    held.get(1).free()
    held.set(1, held.get(held.len - 1))
    held.len -= 1
    // The refused connection is still open on this side, but the server let it go.
    verdict.check("the server lets go of the connection closed",
        open_reaches(asker, PER_PEER - 1, arena)!, "it never counted one fewer open")
    again: = client.get(port, "/style.css", "", arena)!
    client.expect_status("once one closes, a new connection from it is served", again, 200, arena)

priv fn alone(port: I32, arena: Arena$@): Bool!client.Http_end //<
    //< Whether the server comes to hold only the connection asking, within the usual timeout
    deadline: = sys.mono_us() + I64::client.DEFAULT_TIMEOUT_MS * 1000I64
    for sys.mono_us() < deadline
        st: = client.get(port, "/api/status", "", arena)!
        if client.doc_of(st, arena).get("connections_open").as_int64().unwrap_or(-1I64) == 1I64
            return true
        sys.sleep_ms(ALONE_POLL_MS)
    return false

priv fn heap_once_served(port: I32, want: I64, arena: Arena$@): I64!client.Http_end //<
    //< The heap `/api/status` names once the server has answered `want` requests besides these
    //< Each status request counts itself too, so the figure is checked against `want` plus the
    //< polls so far. -1 where it does not get there within the usual timeout.
    deadline: = sys.mono_us() + I64::client.DEFAULT_TIMEOUT_MS * 1000I64
    $polls: I64 = 0I64
    for sys.mono_us() < deadline
        st: = client.get(port, "/api/status", "", arena)!
        polls += 1I64
        doc: = client.doc_of(st, arena)
        if doc.get("requests").as_int64().unwrap_or(-1I64) >= want + polls
            return doc.get("heap_bytes").as_int64().unwrap_or(-1I64)
        sys.sleep_ms(ALONE_POLL_MS)
    return -1I64

priv fn open_reaches(asker: client.Conn$@, want: Sz, arena: Arena$@): Bool!client.Http_end //<
    //< Whether `/api/status`, asked on `asker`, comes to name `want` connections open
    //< **It asks on a connection already held**, so asking adds none.
    deadline: = sys.mono_us() + I64::client.DEFAULT_TIMEOUT_MS * 1000I64
    for sys.mono_us() < deadline
        asker.send(client.raw("GET", "/api/status", "", "", arena))!
        st: = asker.next(false, client.DEFAULT_TIMEOUT_MS, arena)!
        if client.doc_of(st, arena).get("connections_open").as_int64().unwrap_or(-1I64) == I64::want
            return true
        sys.sleep_ms(ALONE_POLL_MS)
    return false

priv fn free_all(held: List<|client.Conn$@|>$@) //< closes every connection still held
    for c in held@
        c.free()

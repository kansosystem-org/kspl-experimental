//< The product's name, and the one logger it speaks through
//<
//< Caution: **Do not write the name into a message as literal text**, or renaming it means editing
//< every file. **Do not use `sys.program_name()` in its place**: that is the name the program was
//< started as (`main.kspls` through `ksplc run`), not the product's name.
//< This is a file of its own because of the reference direction: `model` / `pilot` / `proc`,
//< which import nothing else, use the name too.
import "std/io"
import "std/log" { Level, Log }

const name: U8[] = "kssrv" //< the logger's tag heading each line, before the separator's `:`

// The one logger a run speaks through. **The level, the destination and the tag are set here**,
// so no caller chooses any of them ("One buffered logger" in `kssrv/docs/DESIGN.md`).
// Caution: **Do not hold it here as a file-level variable.** `Log`'s fields belong to `std/log`,
// so only a null pointer filled in later could be held: a server that is up but may not be able
// to speak, which the command line's rule refuses. `main` makes it once.
fn log_new(): Log //< makes the run's logger: the standard output, down to information
  return Log.new(io.out(), Level.information, name)

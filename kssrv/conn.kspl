//< One connection's state, and how a response is queued
//< **Every socket is non-blocking**, so a send may be partial and `Conn` records how far it got.
//< **The code here only builds responses**; the accept loop in `kssrv/main.kspl` sends them.
//< **`Rc<|Conn|>` manages only the memory's lifetime.** `conn_close` frees the socket, the arena
//< and the two buffers explicitly.
import "kstls/tls_server" { Tls_session }
import "std/chars"
import "std/ds"
import "std/fs"
import "std/http"
import "std/io"
import "std/log" { Log }
import "std/mem" { Arena }
import "std/net"
import "std/refcount" { Rc }
import "std/str" { Str_builder }
import "std/sys"

const MAX_CONNS: Sz = 128 //< the cap on connections open at once
    //< The table is fixed-length; a free slot is an ARC handle's zero value (`Rc.empty()`).

const MAX_CONNS_PER_PEER: Sz = 16 //< the cap on connections from one address, facing outward
    //< Without it one machine takes every slot and shuts everyone else out. A browser opens six
    //< per host, so the rest leaves room for several behind one address (a NAT).

const CONN_ARENA_CHUNK: Sz = 16 * 1024 //< how far each connection's working arena grows
    //< It is rewound per request, so the size of the largest single request is enough.

// ==========================================
// The counters reported by `/api/status`.
//
// **No lock is needed** (they are written and read only inside the same loop).
// ==========================================
struct Stats
    started_s: I64 //< wall-clock time (sys.clock is CPU time, so it cannot measure uptime)
    requests: I64
    connections_total: I64
    connections_open: I64
    connections_refused: I64 //< how many arrived while every slot was taken
    writes: I64 //< the writes to sockets, each counted once (`conn_send` in `kssrv/main.kspl`)
$stats: Stats = ::{}

$stop_asked_by: I64 = 0I64 //< the serial of the connection that asked the server to stop
    //< **0 while nobody has asked** (`POST /api/stop`). The accept loop stops once that connection
    //< is gone (`open_serial`), so the answer has gone out first.

$used_us: I64 = 0I64 //< when someone last used the server, on the monotonic clock
    //< **A request arriving sets it, and so does a page letting go of its hold** (`table_drop`).
    //< `--idle` counts from it (`serve` in `kssrv/main.kspl`), so its wait starts when the last
    //< page closes, however long that page held the server.

// ==========================================
// Everything needed to handle a request; the accept loop holds one and passes it down.
// Caution: **Do not put per-connection state here**, only the read-only references every connection
// shares; the partial read, the partial send and the serial belong to `Conn`.
// ==========================================
struct Ctx
    root: U8[]
    // The run's one logger, made in `main`. **Every line written while serving goes through it.**
    // Caution: **Only the accepting thread uses it**, so no lock is needed. Passed to a second
    // thread, a line would be cut in two.
    lg: Log$@
    // The token for local use. **Empty means the server faces outward**, with no file endpoints
    // either (one decision; `--local` in `kssrv/main.kspl`).
    token: U8[]
    // The file returned for `/` and `/index.html`. **Empty means the `index.html` under the root.**
    // Only whoever starts the server names it (`--page` in `kssrv/main.kspl`; the agreement is
    // "Where it listens" in `docs/SPEC-local-server.md`).
    page: U8[]
    // The program that builds a page's own functions (`--builder` in `kssrv/main.kspl`). **Empty
    // means `/api/build` is a 404.**
    builder: U8[]
    // The file that records which functions files the person allowed to build (`--allowed`). It
    // stands outside the root, so no page and no document can write it through the file endpoints.
    allowed: U8[]

// ==========================================
// One connection's state.
// The socket, the arena and the buffers are not ARC, so the last `Rc<|Conn|>` does not free them;
// `conn_close` does.
// ==========================================
struct Conn
    stream: net.Tcp_stream$@
    arena: Arena$@
    // The partly read request. drop_prefix discards what each finished parse used.
    inbuf: Str_builder
    // The built, partly sent response. `sent` is the length already sent.
    outbuf: Str_builder
    sent: Sz
    // Closes once it is all sent (on `Connection: close`, and after a refusal that closes,
    // `keeps_after`).
    close_after_send: Bool
    // This connection's serial. **The slot number alone is not enough**: once the client hangs up,
    // the slot may go to another connection (`stop_asked_by` names the one that asked).
    serial: I64
    // The peer closed **only its sending side** (our read hit EOF).
    // Caution: **Do not take this as "the connection is over".** The peer is waiting for the
    // response. When set: do not read (`conn_pump`), do not watch for reading
    // (`rebuild_interests`), and close once there is nothing left to send (`sweep_done`).
    peer_done: Bool
    // Requests already read wait in `inbuf` for their answers, left there by the cap on requests
    // per notification. **No notification comes for bytes already read**, so the loop drives it
    // itself (`drive_backlog` in `kssrv/main.kspl`), and it is neither read nor swept away
    // meanwhile.
    backlog: Bool
    // The request being answered is a HEAD: every answer to it names its body's length and carries
    // none (`queue_response`). `conn_build` in `kssrv/main.kspl` sets it for each request it
    // reads.
    answers_head: Bool
    // When its last answer went out and its sending side was closed, on the monotonic clock; 0
    // while it still answers. From then on what the peer sends is read and thrown away until the
    // peer closes, or `LINGER_US` passes (`conn_read` in `kssrv/main.kspl`).
    // Caution: **Do not close the socket with the peer's bytes unread.** The OS then answers with a
    // reset. On Windows, a reset throws away the answer the peer has not read yet. So a client
    // still sending a body past the cap never sees its 413.
    lingering_since_us: I64
    // A page holds this connection open to say it is still there (`GET /api/here`). **Nothing more
    // is ever sent on it**; closing the tab ends it.
    // Caution: **Do not sweep it away for having nothing to send.** It has nothing to send by
    // design, so the sweep's usual reason does not apply (`sweep_done` in `kssrv/main.kspl`).
    holding: Bool
    // When a byte last went either way, on the monotonic clock; set at accept. A connection quiet
    // for `IDLE_CONN_US` is dropped (`sweep_done` in `kssrv/main.kspl`), a holding one excepted.
    moved_us: I64
    // When the first byte of the request still arriving came, on the monotonic clock; 0 while no
    // request is partly read. **A request must arrive whole within `REQUEST_TIME_US`**, however
    // its bytes trickle in (`sweep_done` in `kssrv/main.kspl`).
    request_since_us: I64
    // How long `inbuf` must be before the request in it is parsed again; 0 until its head ends.
    // Caution: **Do not parse on every read.** Parsed from the start each time, a request arriving
    // a byte at a time costs its length squared (`conn_build` in `kssrv/main.kspl`).
    need: Sz
    head_from: Sz //< where the search for the head's end resumes in `inbuf`
    // The peer's address as text, for the cap on connections from one address
    // (`MAX_CONNS_PER_PEER`).
    peer: U8[net.ADDR_TEXT_MAX]
    peer_len: Sz
    // The file whose bytes still go out after `outbuf` (`queue_file`); its stream is null when
    // none. **Read a chunk at a time as the connection drains**, so a large file is never held
    // whole (`conn_send` in `kssrv/main.kspl`).
    file: io.File_stream
    file_left: Sz //< how many of the file's bytes, of the length the head named, are still to go
    // The connection's TLS; null for plain HTTP. **Every byte goes through it**
    // (`kssrv/https.kspl`), so `outbuf` and `inbuf` hold plain HTTP either way.
    tls: Tls_session$@
    tls_closed: Bool //< whether its close_notify is queued (`https.close_notify`)
    accepted_us: I64 //< when it was accepted, on the monotonic clock; the handshake counts from it
    local: Bool //< whether the server is for local use (`--local`), which adds headers (`guarded`)

struct Conn_table //< the connection table
    //< Caution: **Put the array in a struct's field.** `@` on an array makes a pointer to the first
    //< element, which cannot be subscripted. Through the struct, `t.slots[i]` stays a place
    //< expression and overwriting a slot releases the old value.
    slots: Rc<|Conn|>[MAX_CONNS]

impl Ctx
    fn is_local(r: Self@): Bool //< whether it serves one user on this machine (`--local`)
        return r.token.len > 0

fn regular_file_size(path: U8[]): Sz? //<
    //< a regular file's size; none where it is absent or not one
    //< Caution: **Check this before opening.** On some OSes `fopen` opens a folder, which reads as
    //< "a broken file". A FIFO's read waits for a writer that can never come, and holds the server.
    //< A device's read never ends.
    info: = fs.stat(path) catch _e
        return .none
    if info.kind != fs.File_kind.file
        return .none
    return .some(Sz::info.size)

struct File_facts //< what an answer names of a file besides its bytes
    size: Sz
    modified_s: I64 //< when it was last changed, in whole seconds since 1970 (`Last-Modified`)
    modified_ns: I64 //< the same as fine as the file system keeps it, for the `ETag`

fn regular_file(path: U8[]): File_facts? //<
    //< A regular file's size and times; none where it is absent or not one
    //< It asks `regular_file_size` first, for the reasons given there.
    size: = regular_file_size(path) catch
        return .none
    // **The time to the nanosecond, not the second**: two saves of one length within a second
    // would otherwise keep one `ETag`, and a browser would keep showing the first.
    ns: = fs.mtime_ns(path) catch _e
        return .none
    return .some(File_facts::{ .size = size, .modified_s = ns / NS_PER_S, .modified_ns = ns })

priv const NS_PER_S: I64 = 1000000000I64

fn conn_new(stream: net.Tcp_stream$@, serial: I64, local: Bool): Rc<|Conn|>
    fresh: Conn = ::{
        .stream = stream,
        .arena = Arena(CONN_ARENA_CHUNK),
        .inbuf = Str_builder(),
        .outbuf = Str_builder(),
        .serial = serial,
        .moved_us = sys.mono_us(),
        .accepted_us = sys.mono_us(),
        .local = local,
    }
    return Rc<|Conn|>(fresh)

fn conn_close(connection: Conn$@) //< frees a connection's resources
    //< Caution: Call it before emptying the slot, or the socket and the buffers leak.
    if connection.tls != null
        connection.tls.free()
    connection.stream.free()
    connection.arena.free()
    connection.inbuf.free()
    connection.outbuf.free()
    connection.file.free()

fn any_holding(table: Conn_table@): Bool //< whether a page is holding the server open
    //< **This is what "someone is using me" means.** Stopping when nobody is depends on it alone
    //< ("Keeping the server alive while a page is open" in `../docs/SPEC-local-server.md`).
    for i in Range.asc(MAX_CONNS)
        if !table.slots[i].is_empty() && table.slots[i].get().holding
            return true
    return false

fn open_serial(table: Conn_table@, serial: I64): Bool //< whether that connection is still open
    //< **A connection is dropped only once its answer is sent or it broke** (`conn_send` in
    //< `kssrv/main.kspl`), so false means nothing is left to send on it. **One lingering after its
    //< last answer counts as closed**: everything has been sent on it.
    for i in Range.asc(MAX_CONNS)
        if !table.slots[i].is_empty() && table.slots[i].get().serial == serial
            return table.slots[i].get().lingering_since_us == 0I64
    return false

fn table_find_free(table: Conn_table@): Sz //< looks for a free slot
    //< -1 if there is none.
    for i in Range.asc(MAX_CONNS)
        if table.slots[i].is_empty()
            return i
    return -1

fn table_drop(table: Conn_table$@, slot: Sz, lg: Log$@) //<
    //< closes a slot's connection and empties it
    if table.slots[slot].is_empty()
        return
    serial: = table.slots[slot].get().serial
    // Caution: **A page letting go counts as a use.** Counted from the page's last request
    // instead, a page held open past `--idle` stops the server the moment it closes, even for a
    // reload.
    if table.slots[slot].get().holding
        used_us = sys.mono_us()
    conn_close(table.slots[slot].get())
    // Assigning the empty value releases the stored handle.
    table.slots[slot] = Rc<|Conn|>.empty()
    stats.connections_open -= 1I64
    // The close is logged under the open's serial, to match the accept line.
    if ln: = lg.at(.information)
        ln.s("conn #\{serial\} closed (open \{stats.connections_open\})")

fn queue_response( //< queues one answer with `body` as its body; to a HEAD, it names the length
    //< **The socket must not be written here** (the reason is in this file's header). The length
    //< goes in from the body (`http.format_response`).
    connection: Conn$@,
    status: I32,
    ctype: U8[],
    body: U8[],
    keep: Bool,
    allow: U8[] = "", //< a 405's `Allow` (`answer_head`); empty for any other answer
)
    queue_answer(connection, status, ctype, body, keep, allow, no_more(connection))

priv fn queue_answer( //< `queue_response` with `more`, the headers this one answer adds
    connection: Conn$@,
    status: I32,
    ctype: U8[],
    body: U8[],
    keep: Bool,
    allow: U8[],
    more: http.Headers,
)
    if connection.answers_head
        head_only(connection, status, ctype, body.len, keep, allow, more)
        return
    head: = answer_head(connection, ctype, keep, allow, more)
    http.format_response(connection.outbuf@, status, head, body) catch _e
        unbuilt(connection)
        return
    if !keep
        connection.close_after_send = true

priv fn no_more(connection: Conn$@): http.Headers //< the headers an answer adds when it adds none
    return http.headers(connection.arena).build()

fn queue_file( //< queues an answer whose body is `length` bytes of `file` from `start` on
    //< The body is sent as the connection drains. **The connection then holds one chunk at a time,
    //< not the file** (`conn_send` in `kssrv/main.kspl`). It owns `file` from here on; a HEAD's
    //< answer takes a closed one (`::{}`), as it sends no byte.
    connection: Conn$@,
    status: I32, //< 200 for the whole file, 206 for a part of it (`more` then names which)
    ctype: U8[],
    file: io.File_stream,
    start: Sz, //< the first byte sent
    length: Sz, //< how many are sent; the head names it
    keep: Bool,
    more: http.Headers, //< what this answer adds: the validators, and a part's `Content-Range`
)
    $owned: = file
    // Caution: **Move to the first byte before the head is queued.** A seek that fails can still
    // become a 500, where after the head it could only cut the answer short.
    if !connection.answers_head && length > 0 && start > 0
        owned.seek_to(start) catch _e
            owned.free()
            queue_error(connection, 500)
            return
    before: = connection.outbuf.len
    head_only(connection, status, ctype, length, keep, "", more)
    // A HEAD names the length and takes no body; a head the builder refused added nothing.
    // Caution: **Close a file no byte of which goes out** (an empty file too). Only a chunk read
    // closes it later (`refill_from_file`). On Windows an open file cannot be replaced, so a
    // page holding the connection made every save of that file fail.
    if connection.answers_head || connection.outbuf.len == before || length == 0
        owned.free()
        return
    connection.file = owned
    connection.file_left = length

fn peer_count(table: Conn_table@, peer: U8[]): Sz //<
    //< how many open connections come from that address
    $n: Sz = 0
    for i in Range.asc(MAX_CONNS)
        if table.slots[i].is_empty()
            continue
        if from_peer(table.slots[i].get(), peer)
            n += 1
    return n

fn from_peer(connection: Conn@, peer: U8[]): Bool //< whether the connection comes from that address
    return U8[]::{ .ptr = connection.peer[0]@, .len = connection.peer_len }.equals(peer)

fn queue_to_head( //< queues the answer to a HEAD: the head a GET would get, and no body
    //< **A body is never sent after it**: the client reads the next answer where the head ends.
    connection: Conn$@,
    status: I32,
    ctype: U8[],
    length: Sz, //< the length the head names
    keep: Bool,
    allow: U8[] = "", //< a 405's `Allow`, as at `queue_response`
)
    head_only(connection, status, ctype, length, keep, allow, no_more(connection))

priv fn head_only(connection: Conn$@, status: I32, ctype: U8[], length: Sz, keep: Bool,
    allow: U8[], more: http.Headers) //<
        //< `queue_to_head` with `more`, the headers this one answer adds
    head: = answer_head(connection, ctype, keep, allow, more)
    http.format_response_to_head(connection.outbuf@, status, head, length) catch _e
        unbuilt(connection)
        return
    if !keep
        connection.close_after_send = true

priv fn answer_head(connection: Conn$@, ctype: U8[], keep: Bool, allow: U8[], more: http.Headers):
    http.Headers //<
        //< The headers every answer carries, then `more`; the length is the builder's to add
        //< `allow` non-empty adds `Allow`, which a 405 must carry (RFC 9110 §15.5.6): without it
        //< the client cannot tell which method would have been taken.
    $b: = guarded(connection,
        dated(connection, http.headers(connection.arena)).add("Content-Type", ctype)).add("Connection",
        "keep-alive" if keep else "close")
    if allow.len > 0
        b = b.add("Allow", allow)
    for h in more.each()
        b = b.add(h.name, h.value)
    return b.build()

priv fn dated(connection: Conn$@, headers: http.Header_builder): http.Header_builder //<
    //< `headers` with `Date`, the time the answer is made
    //< **Every answer carries it**: RFC 9110 §6.6.1 asks it of a server that has a clock. A cache
    //< reads the age of what it keeps from it, and `Last-Modified` is judged against it.
    now: = connection.arena.text().s("\{http.Http_date::{ .unix_s = sys.wall_seconds() }\}").take()
    return headers.add("Date", now)

// **Every answer says that its type is the one named**, so a browser never runs a file as a type it
// guessed. Caution: **Facing outward, add nothing more**: framing and the referrer are a public
// site's own choice ("Headers on every answer" in `kssrv/docs/SPEC-api.md`).
priv const NOSNIFF: U8[] = "nosniff"

// **A local answer also refuses every frame and sends no referrer.** The page holds the token and
// writes files, so another site must not frame it and lure a press. No script policy is sent:
// only the page knows what it runs, so a page sets one in a `<meta>`.
priv const FRAMES: U8[] = "frame-ancestors 'none'"

priv fn guarded(connection: Conn@, headers: http.Header_builder): http.Header_builder //<
    //< `headers` with the headers that guard the answer: `NOSNIFF` always, and `FRAMES` with no referrer
    //< for local use
    $out: = headers.add("X-Content-Type-Options", NOSNIFF)
    if connection.local
        out = out.add("Content-Security-Policy", FRAMES).add("Referrer-Policy", "no-referrer")
    return out

priv fn unbuilt(connection: Conn$@) //<
    //< gives up an answer the builder refused, closing without sending
    //< A CRLF in a header or similar is this server's mistake, not the client's. The builder left
    //< `outbuf` as it was, so what was queued before still goes out.
    connection.close_after_send = true

fn queue_stream_head(connection: Conn$@) //<
    //< The head of a response that keeps the connection open without a stated length
    //< **Closing the connection marks the end** (the only way when the length is not known).
    //< `GET /api/here` sends this and nothing more.
    //< Caution: **Do not make it `keep-alive`.** With no length, only the close tells the client
    //< where the response ends.
    typed: = dated(connection, http.headers(connection.arena)).add("Content-Type",
        "application/octet-stream")
    head: = guarded(connection, typed).add("Connection", "close").build()
    // **Do not write it with the function that sets a length.** `format_response` fills in
    // `Content-Length: 0`, and a client that follows the protocol then reads not one byte of the
    // body.
    http.format_response_head(connection.outbuf@, 200, head) catch _e
        unbuilt(connection)

fn queue_error( //< queues an error answer in plain text
    connection: Conn$@,
    status: I32,
    allow: U8[] = "", //< a 405's `Allow`
    keep: Bool = false, //< whether the request was read whole and its client keeps the connection
    why: U8[] = "", //< a sentence after the status saying what to change; empty for none
)
    defer $b: = Str_builder()
    b.s("\{status\} ").s(http.reason_phrase(status).unwrap_or("")).s("\n")
    if why.len > 0
        b.s(why).s("\n")
    queue_response(connection, status, "text/plain; charset=utf-8", b.slice(),
        keep && keeps_after(status), allow)

fn keeps_after(status: I32): Bool //<
    //< Whether a refusal leaves the connection open for the client's next request
    //< **Only a refusal of what was asked for**: the path is refused or absent, the method is not
    //< taken, or a condition or a range cannot be met. The request was read whole, so the next one
    //< starts where it ended. Caution: **Close after any other**: after a request that could not
    //< be read (a 400), there is no telling where the next one starts.
    return status == 403 || status == 404 || status == 405 || status == 412 || status == 416

fn queue_unchanged(connection: Conn$@, ctype: U8[], keep: Bool, more: http.Headers) //<
    //< Queues a 304: the client's copy is the file as it stands, so no body goes
    //< `more` names the validators again (RFC 9110 §15.4.5), so a cache keeps them up to date.
    head_only(connection, 304, ctype, 0, keep, "", more)

fn queue_unsatisfiable(connection: Conn$@, size: Sz, keep: Bool) //<
    //< Queues a 416: the range asked for holds no byte of the file, which is `size` bytes long
    //< **It names the file's length** (`Content-Range: bytes */<size>`, RFC 9110 §15.5.17), so a
    //< client resuming a download it already has whole can tell that it is done.
    more: = http.headers(connection.arena)
        .add("Content-Range", connection.arena.text().s("bytes */\{size\}").take()).build()
    body: = connection.arena.text().s("416 ").s(http.reason_phrase(416).unwrap_or("")).s("\n")
        .take()
    queue_answer(connection, 416, "text/plain; charset=utf-8", body, keep && keeps_after(416), "",
        more)

fn queue_redirect(connection: Conn$@, location: U8[], keep: Bool) //<
    //< Queues a 301 to `location`, with a line naming it for a client that does not follow it
    more: = http.headers(connection.arena).add("Location", location).build()
    body: = connection.arena.text().s("301 Moved Permanently: ").s(location).s("\n").take()
    queue_answer(connection, 301, "text/plain; charset=utf-8", body, keep, "", more)

struct Target //< splits the request target (`/a/b?x=1#f`) into the path part and the query part
    //< Both are still raw, not yet percent-decoded.
    path: U8[] //< with the leading `/` (`/a/b`)
    query: U8[] //< without the `?` (`x=1`); empty if there is none
    // The host and port an absolute target names (`http://127.0.0.1:8080/a`), which stands in for
    // `Host` (RFC 9112 §3.2.2); none for the usual target, which names only the path.
    authority: U8[]?

fn split_target(target: U8[]): Target
    $t: = target
    if h: = t.find_char('#')
        t = t.sub(0, h) // a fragment should not reach the server; one that does is dropped
    // **A target may name the server too** (the absolute form), as a request to a proxy does. RFC
    // 9112 §3.2.2 asks a server to take it. Its scheme is `http` or `https`, in any case.
    $authority: U8[]? = .none
    for scheme in U8[][]::{ "http://", "https://" }
        if t.len >= scheme.len && t.sub(0, scheme.len).equals_ignore_case(scheme)
            rest: = t.sub_from(scheme.len)
            $end: = rest.len
            for i in Range.asc(rest.len)
                if rest[i] == '/' || rest[i] == '?'
                    end = i
                    break
            authority = .some(rest.sub(0, end))
            t = rest.sub_from(end)
            break
    // The absolute form's path may be empty (`http://a?x`), which names the root.
    $path: = t
    $query: U8[] = ""
    if q: = t.find_char('?')
        path = t.sub(0, q)
        query = t.sub_from(q + 1)
    if path.len == 0 && authority.is_some()
        path = "/"
    return Target::{ .path = path, .query = query, .authority = authority }

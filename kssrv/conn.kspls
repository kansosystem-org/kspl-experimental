//< One connection's state, and how a response is queued
//<
//< **Every socket is non-blocking**, so a send may be partial and `Conn` records how far it got.
//< **The code here only builds responses**; the accept loop in `kssrv/main.kspls` sends them.
//< **`Rc<|Conn|>` manages only the memory's lifetime.** `conn_close` frees the socket, the arena
//< and the two buffers explicitly.
import "kssrv/pilot"
import "std/chars"
import "std/fs"
import "std/http"
import "std/io"
import "std/log" { Log }
import "std/mem" { Arena }
import "std/net"
import "std/refcount" { Rc }
import "std/str" { Str_builder }
import "std/sys"

const max_conns: Sz = 128 //< the cap on connections open at once
    //<
    //< The table is fixed-length; a free slot is an ARC handle's zero value (`Rc.empty()`).

const max_conns_per_peer: Sz = 16 //< the cap on connections from one address, facing outward
    //<
    //< Without it one machine takes every slot and shuts everyone else out. A browser opens six
    //< per host, so the rest leaves room for several behind one address (a NAT).

const conn_arena_chunk: Sz = 16 * 1024 //< how far each connection's working arena grows
    //<
    //< It is rewound per request, so the size of the largest single request is enough.

// ==========================================
// The counters reported by `/api/status`.
//
// **No lock is needed** (they are written and read only inside the same loop).
// ==========================================
struct Stats
    started_s: I64 //< wall-clock time (sys.clock is CPU time, so it cannot measure uptime)
    requests: I64
    commands: I64 //< how many manoeuvres were returned to the car
    connections_total: I64
    connections_open: I64
    connections_refused: I64 //< how many arrived while every slot was taken
$stats: Stats = ::{}

$stop_asked_by: I64 = 0I64 //< the serial of the connection that asked the server to stop
    //<
    //< **0 while nobody has asked** (`POST /api/stop`). The accept loop stops once that connection
    //< is gone (`open_serial`), so the answer has gone out first.

// ==========================================
// Everything needed to handle a request; the accept loop holds one and passes it down.
// Caution: **Do not put per-connection state here**, only the read-only references every connection
// shares; the partial read, the partial send and the serial belong to `Conn`.
// ==========================================
struct Ctx
    root: U8[]
    // The run's one logger, made in `main`. **Every line written while serving goes through it.**
    // Caution: **Only the accepting thread uses it**, so no lock is needed. Passed to a second
    // thread, a line would be cut in two.
    lg: Log$@
    // The token for local use. **Empty means the server faces outward**, with no file endpoints
    // either (one decision; `--local` in `kssrv/main.kspls`).
    token: U8[]
    p: pilot.Pilot$@ //< the policy that chooses the manoeuvre returned to the car
        //<
        //< **Null for local use**, which trains none (`main` in `kssrv/main.kspls`); the car's
        //< endpoints are then a 404 (`Reach` in `kssrv/api.kspls`).
    // The file returned for `/` and `/index.html`. **Empty means the `index.html` under the root.**
    // Only whoever starts the server names it (`--page` in `kssrv/main.kspls`; the agreement is
    // "Where it listens" in `docs/SPEC-local-server.md`).
    page: U8[]

// ==========================================
// One connection's state.
// The socket, the arena and the buffers are not ARC, so the last `Rc<|Conn|>` does not free them;
// `conn_close` does.
// ==========================================
struct Conn
    stream: net.Tcp_stream$@
    arena: Arena$@
    // The partly read request. drop_prefix discards what each finished parse used.
    inbuf: Str_builder
    // The built, partly sent response. `sent` is the length already sent.
    outbuf: Str_builder
    sent: Sz
    // Closes once it is all sent (on `Connection: close`, and for an error response).
    close_after_send: Bool
    // This connection's serial. **The slot number alone is not enough**: once the client hangs up,
    // the slot may go to another connection (`stop_asked_by` names the one that asked).
    serial: I64
    // The peer closed **only its sending side** (our read hit EOF).
    // Caution: **Do not take this as "the connection is over".** The peer is waiting for the
    // response. When set: do not read (`conn_pump`), do not watch for reading
    // (`rebuild_interests`), and close once there is nothing left to send (`sweep_done`).
    peer_done: Bool
    // Requests already read wait in `inbuf` for their answers, left there by the cap on requests
    // per notification. **No notification comes for bytes already read**, so the loop drives it
    // itself (`drive_backlog` in `kssrv/main.kspls`), and it is neither read nor swept away
    // meanwhile.
    backlog: Bool
    // The request being answered is a HEAD: every answer to it names its body's length and carries
    // none (`queue_response`). `conn_build` in `kssrv/main.kspls` sets it for each request it
    // reads.
    answers_head: Bool
    // When its last answer went out and its sending side was closed, on the monotonic clock; 0
    // while it still answers. From then on what the peer sends is read and thrown away until the
    // peer closes, or `linger_us` passes (`conn_linger` in `kssrv/main.kspls`).
    // Caution: **Do not close the socket with the peer's bytes unread.** The OS then answers with a
    // reset, and on Windows a reset throws away the answer the peer has not read yet: a client
    // still sending a body past the cap never sees its 413.
    lingering_since_us: I64
    // A page holds this connection open to say it is still there (`GET /api/here`). **Nothing more
    // is ever sent on it**; closing the tab ends it.
    // Caution: **Do not sweep it away for having nothing to send.** It has nothing to send by
    // design, so the sweep's usual reason does not apply (`sweep_done` in `kssrv/main.kspls`).
    holding: Bool
    // When a byte last went either way, on the monotonic clock; set at accept. A connection quiet
    // for `idle_conn_us` is dropped (`sweep_done` in `kssrv/main.kspls`), a holding one excepted.
    moved_us: I64
    // When the first byte of the request still arriving came, on the monotonic clock; 0 while no
    // request is partly read. **A request must arrive whole within `request_time_us`**, however
    // its bytes trickle in (`sweep_done` in `kssrv/main.kspls`).
    request_since_us: I64
    // How long `inbuf` must be before the request in it is parsed again; 0 until its head ends.
    // Caution: **Do not parse on every read.** Parsed from the start each time, a request arriving
    // a byte at a time costs its length squared (`conn_build` in `kssrv/main.kspls`).
    need: Sz
    head_from: Sz //< where the search for the head's end resumes in `inbuf`
    // The peer's address as text, for the cap on connections from one address
    // (`max_conns_per_peer`).
    peer: U8[net.addr_text_max]
    peer_len: Sz
    // The file whose bytes still go out after `outbuf` (`queue_file`); its stream is null when
    // none. **Read a chunk at a time as the connection drains**, so a large file is never held
    // whole (`conn_send` in `kssrv/main.kspls`).
    file: io.File_stream
    file_left: Sz //< how many of the file's bytes, of the length the head named, are still to go

struct Conn_table //< the connection table
    //<
    //< Caution: **Put the array in a struct's field.** `@` on an array makes a pointer to the first
    //< element, which cannot be subscripted. Through the struct, `t.slots[i]` stays a place
    //< expression and overwriting a slot releases the old value.
    slots: Rc<|Conn|>[max_conns]

impl Ctx
    fn is_local(r: Self$@): Bool //< whether it serves one user on this machine (`--local`)
        return r.token.len > 0

fn regular_file_size(path: U8[]): Sz? //<
    //< a regular file's size; none where it is absent or not one
    //<
    //< Caution: **Check this before opening.** On some OSes `fopen` opens a folder, which reads as
    //< "a broken file"; a FIFO's read waits for a writer that may never come, holding the server,
    //< and a device's never ends.
    info: = fs.stat(path) catch _e
        return .none
    if info.kind != fs.File_kind.file
        return .none
    return .some(Sz::info.size)

fn conn_new(stream: net.Tcp_stream$@, serial: I64): Rc<|Conn|>
    fresh: Conn = ::{
        .stream = stream,
        .arena = Arena.new(conn_arena_chunk),
        .inbuf = Str_builder.new(),
        .outbuf = Str_builder.new(),
        .sent = 0,
        .close_after_send = false,
        .serial = serial,
        .peer_done = false,
        .backlog = false,
        .answers_head = false,
        .lingering_since_us = 0I64,
        .holding = false,
        .moved_us = sys.mono_us(),
        .request_since_us = 0I64,
        .need = 0,
        .head_from = 0,
        .peer = ::{},
        .peer_len = 0,
        .file = io.File_stream::{ .stream = null },
        .file_left = 0,
    }
    return Rc<|Conn|>.new(fresh)

fn conn_close(c: Conn$@) //< frees a connection's resources
    //<
    //< Caution: Call it before emptying the slot, or the socket and the buffers leak.
    c.stream.free()
    c.arena.free()
    c.inbuf.free()
    c.outbuf.free()
    c.file.free()

fn any_holding(t: Conn_table$@): Bool //< whether a page is holding the server open
    //<
    //< **This is what "someone is using me" means**; stopping when nobody is depends on it alone
    //< ("Keeping the server alive while a page is open" in `../docs/SPEC-local-server.md`).
    for i in Range.asc(max_conns)
        if !t.slots[i].is_empty() && t.slots[i].get().holding
            return true
    return false

fn open_serial(t: Conn_table$@, serial: I64): Bool //< whether that connection is still open
    //<
    //< **A connection is dropped only once its answer is sent or it broke** (`conn_send` in
    //< `kssrv/main.kspls`), so false means nothing is left to send on it. **One lingering after its
    //< last answer counts as closed**: everything has been sent on it.
    for i in Range.asc(max_conns)
        if !t.slots[i].is_empty() && t.slots[i].get().serial == serial
            return t.slots[i].get().lingering_since_us == 0I64
    return false

fn table_find_free(t: Conn_table$@): Sz //< looks for a free slot
    //<
    //< -1 if there is none.
    for i in Range.asc(max_conns)
        if t.slots[i].is_empty()
            return i
    return -1

fn table_drop(t: Conn_table$@, slot: Sz, lg: Log$@) //< closes a slot's connection and empties it
    if t.slots[slot].is_empty()
        return
    serial: = t.slots[slot].get().serial
    conn_close(t.slots[slot].get())
    // Assigning the empty value releases the stored handle.
    t.slots[slot] = Rc<|Conn|>.empty()
    stats.connections_open -= 1I64
    // The close is logged under the open's serial, to match the accept line.
    if ln: = lg.at(.information)
        ln.s("conn #\{serial\} closed (open \{stats.connections_open\})")

fn queue_response( //< queues one answer with `body` as its body; to a HEAD, it names the length
    //<
    //< **The socket must not be written here** (the reason is in this file's header). The length
    //< goes in from the body (`http.format_response`).
    c: Conn$@,
    status: I32,
    ctype: U8[],
    body: U8[],
    keep: Bool,
    allow: U8[] = "", //< a 405's `Allow` (`answer_head`); empty for any other answer
)
    if c.answers_head
        queue_to_head(c, status, ctype, body.len, keep, allow)
        return
    http.format_response(c.outbuf@, status, answer_head(c, ctype, keep, allow), body) catch _e
        unbuilt(c)
        return
    if !keep
        c.close_after_send = true

fn queue_file(c: Conn$@, ctype: U8[], file: io.File_stream, length: Sz, keep: Bool) //<
    //< Queues a 200 whose body is `length` bytes of `file`, sent as the connection drains
    //<
    //< The head names `length` (the size `stat` gave). **The connection then holds one chunk at a
    //< time, not the file** (`conn_send` in `kssrv/main.kspls`). It owns `file` from here on.
    before: = c.outbuf.len
    queue_to_head(c, 200, ctype, length, keep)
    // A HEAD names the length and takes no body; a head the builder refused added nothing.
    if c.answers_head || c.outbuf.len == before
        $f: = file
        f.free()
        return
    c.file = file
    c.file_left = length

fn peer_count(t: Conn_table$@, peer: U8[]): Sz //<
    //< how many open connections come from that address
    $n: Sz = 0
    for i in Range.asc(max_conns)
        if t.slots[i].is_empty()
            continue
        c: = t.slots[i].get()
        if U8[]::{ .ptr = c.peer[0]@, .len = c.peer_len }.equals(peer)
            n += 1
    return n

fn queue_to_head( //< queues the answer to a HEAD: the head a GET would get, and no body
    //<
    //< **A body is never sent after it**: the client reads the next answer where the head ends.
    c: Conn$@,
    status: I32,
    ctype: U8[],
    length: Sz, //< the length the head names
    keep: Bool,
    allow: U8[] = "", //< a 405's `Allow`, as at `queue_response`
)
    http.format_response_to_head(c.outbuf@, status, answer_head(c, ctype, keep, allow), length)
        catch _e
        unbuilt(c)
        return
    if !keep
        c.close_after_send = true

priv fn answer_head(c: Conn$@, ctype: U8[], keep: Bool, allow: U8[]): http.Header$@ //<
    //< The headers every answer carries; the length is the builder's to add
    //<
    //< `allow` non-empty adds `Allow`, which a 405 must carry (RFC 9110 §15.5.6): without it the
    //< client cannot tell which method would have been taken.
    $b: = http.headers(c.arena).add("Content-Type", ctype)
        .add("Connection", "keep-alive" if keep else "close")
    if allow.len > 0
        b = b.add("Allow", allow)
    return b.build()

priv fn unbuilt(c: Conn$@) //< gives up an answer the builder refused, closing without sending
    //<
    //< A CRLF in a header or similar is this server's mistake, not the client's. The builder left
    //< `outbuf` as it was, so what was queued before still goes out.
    c.close_after_send = true

fn queue_stream_head(c: Conn$@) //<
    //< The head of a response that keeps the connection open without a stated length
    //<
    //< **Closing the connection marks the end** (the only way when the length is not known).
    //< `GET /api/here` sends this and nothing more.
    //< Caution: **Do not make it `keep-alive`.** With no length, only the close tells the client
    //< where the response ends.
    head: = http.headers(c.arena).add("Content-Type", "application/octet-stream")
        .add("Connection", "close").build()
    // **Do not write it with the function that sets a length.** `format_response` fills in
    // `Content-Length: 0`, and a client that follows the protocol then reads not one byte of the
    // body.
    http.format_response_head(c.outbuf@, 200, head) catch _e
        unbuilt(c)

fn queue_error(c: Conn$@, status: I32, allow: U8[] = "") //<
    //< Queues an error answer in plain text; `allow` is a 405's `Allow`
    $b: = Str_builder.new()
    defer b.free()
    b.s("\{status\} ").s(http.reason_phrase(status)).s("\n")
    // An error response always closes: after a broken request, there is no telling where the next
    // one starts in the remaining bytes.
    queue_response(c, status, "text/plain; charset=utf-8", b.slice(), false, allow)

struct Target //< splits the request target (`/a/b?x=1#f`) into the path part and the query part
    //<
    //< Both are still raw, not yet percent-decoded.
    path: U8[] //< with the leading `/` (`/a/b`)
    query: U8[] //< without the `?` (`x=1`); empty if there is none

fn split_target(target: U8[]): Target
    $t: = target
    if h: = t.find_char('#')
        t = t.sub(0, h) // a fragment should not reach the server; one that does is dropped
    if q: = t.find_char('?')
        return Target::{ .path = t.sub(0, q), .query = t.sub_from(q + 1) }
    return Target::{ .path = t, .query = "" }

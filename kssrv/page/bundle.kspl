//< Builds a page that `kssrv --page` serves as one file, with its style and scripts inside
//< The local server hands out one file for the page and nothing else without the token
//< (`kssrv --page`), and a browser fetches nothing beside a page opened from a file. So the page
//< holds everything itself. A line `<script src="NAME"></script>` takes that script, and a line
//< `<link rel="stylesheet" href="NAME">` that style. `NAME` stands in the page's folder or in a
//< folder given with `--from`, such as this one, which holds the protocol's client (`client.js`).
//< `__MARK__` in the page takes a file as base64, given as `--base64=MARK=<file>`.

// ==========================================
// Usage:
//     ksplc run kssrv/page/bundle.kspl <page.html> <out.html> [--from=<folder>]...
//         [--base64=<MARK>=<file>]...
// ==========================================
import "std/base64"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/sys"

priv const SCRIPT_HEAD: U8[] = "<script src=\""
priv const SCRIPT_TAIL: U8[] = "\"></script>"
priv const STYLE_HEAD: U8[] = "<link rel=\"stylesheet\" href=\""
priv const STYLE_TAIL: U8[] = "\">"
priv const FROM: U8[] = "--from="
priv const BASE64: U8[] = "--base64="

priv enum Stopped //< the bundle is not written; the reason is printed
    stopped

fn main(): I32
    args: = sys.args()
    if args.len < 3
        return usage()
    defer arena: = Arena(1024 * 1024)
    $page: = read(args.get(1), arena) catch
        return 1
    $folders: = List<|U8[]|>(arena)
    folders.push(sys.get_dir_name(args.get(1)))
    for i in Range(3, args.len, 1)
        arg: = args.get(i)
        given: = arg.sub_from(BASE64.len) if arg.starts_with(BASE64) else ""
        if arg.starts_with(FROM) && arg.len > FROM.len
            folders.push(arg.sub_from(FROM.len))
        else if at: = given.find_char('=')
            mark: = arena.text().s("__").s(given.sub(0, at)).s("__").take()
            if at == 0 || page.count_str(mark) != 1
                io.err().s("bundle: the page must hold \{mark\} once: \{args.get(1)\}\n")
                return 1
            bytes: = read(given.sub_from(at + 1), arena) catch
                return 1
            page = page.replace(mark, base64.encode(bytes, arena), arena)
        else
            return usage()
    defer $built: = Str_builder()
    for line in page.lines(arena)
        within: = line.trim_spaces()
        if name: = between(within, SCRIPT_HEAD, SCRIPT_TAIL)
            inline(built@, "script", folders.slice(), name, arena) catch
                return 1
        else if name: = between(within, STYLE_HEAD, STYLE_TAIL)
            inline(built@, "style", folders.slice(), name, arena) catch
                return 1
        else
            built.s(line).c('\n')
    io.write_file(args.get(2), built.slice()) catch
        io.err().s("bundle: cannot write: \{args.get(2)\}\n")
        return 1
    return 0

priv fn usage(): I32
    io.err().s("usage: bundle.kspl <page.html> <out.html> [--from=<folder>]... ")
        .s("[--base64=<MARK>=<file>]...\n")
    return 1

priv fn read(path: U8[], arena: Arena$@): U8[]!Stopped
    return io.read_file(path, arena) catch
        io.err().s("bundle: cannot read: \{path\}\n")
        throw .stopped

priv fn between(line: U8[], head: U8[], tail: U8[]): U8[]? //< what a whole line wraps, if it does
    if line.len > head.len + tail.len && line.starts_with(head) && line.ends_with(tail)
        return .some(line.sub(head.len, line.len - head.len - tail.len))
    return .none

priv fn inline(built: Str_builder$@, tag: U8[], folders: U8[][], name: U8[], arena: Arena$@):
    Void!Stopped //<
        //< Writes one file, from the page's folder or a `--from` one, inside its tag
        //< Caution: **Refuse a name with a folder in it, a name two folders hold, and text that
        //< ends the tag early**: the page would take a file from elsewhere, or run the rest of a
        //< script as HTML.
    for c in name
        if !c.is_alnum() && c != '.' && c != '-' || name[0] == '.'
            io.err().s("bundle: the page names a file outside its folder: \{name\}\n")
            throw .stopped
    $path: U8[] = ""
    for folder in folders
        here: = fs.join(folder, name, arena)
        if fs.exists(here)
            if path.len > 0
                io.err().s("bundle: two folders hold \{name\}\n")
                throw .stopped
            path = here
    if path.len == 0
        io.err().s("bundle: no folder holds \{name\}\n")
        throw .stopped
    text: = read(path, arena)!
    if text.find_str(arena.text().s("</").s(tag).take()).is_some()
        io.err().s("bundle: \{name\} holds the text that would end its <\{tag\}>\n")
        throw .stopped
    built.c('<').s(tag).s(">\n").s(text).s("</").s(tag).s(">\n")

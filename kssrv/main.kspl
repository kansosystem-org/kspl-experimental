#!/usr/bin/env -S ksplc run
//< An HTTP server that returns static files
//<
//< It returns the files under `<root>` for GET/HEAD, and JSON under `/api/`, multiplexing the
//< connections on one thread with `std/reactor` and keeping them alive (HTTP/1.1's default).
//< `--local` makes it **for local use**; `--page` names the file for `/` and `/index.html`.
//< **Every socket is non-blocking.**

// ==========================================
// Usage:
//     kssrv <port> <root> [--local] [--page=<file>] [--idle=<seconds>]
// ==========================================
import "kssrv/api"
import "kssrv/conn"
import "kssrv/pilot"
import "std/argp"
import "std/chars" // single-character tests and slicing
import "std/fs"
import "std/http"
import "std/io"
import "std/log" { Log }
import "std/mem" { Arena }
import "std/net"
import "std/rand"
import "std/reactor"
import "std/str" { Str_builder }
import "std/strfmt"
import "std/strnum" // `to_i64` / `to_f64` / `parse_size`
import "std/sys"
import "std/time"
import "std/url"

// The product's name, the logger's tag before the separator's `:`.
// Caution: **Do not write it into a message as literal text**, and do not use
// `sys.program_name()` in its place: that is the name the program was started as.
priv const name: U8[] = "kssrv"

// The one logger a run speaks through. **The level, the destination and the tag are set here**,
// so no caller chooses any of them ("One buffered logger" in `kssrv/docs/DESIGN-server.md`).
// Caution: **Do not hold it as a file-level variable**: only a null pointer filled in later could
// be held, a server that is up but may not be able to speak. `main` makes it once.
priv fn log_new(): Log //< makes the run's logger: the standard output, down to information
    return Log.new(io.out(), .information, name)

priv const listener_token: Sz = conn.max_conns //< the token given to the listening socket
    //<
    //< It cannot collide with a slot number (0..max_conns-1).

priv const max_request_body: Sz = 64 * 1024 //< the cap allowed on one request's body
    //<
    //< **Only local use accepts a large one**, for writing a document back. The outward-facing cap
    //< stays small because each connection holds its partial read.
priv const max_local_body: Sz = 4 * 1024 * 1024

priv fn body_limit(ctx: conn.Ctx$@): Sz //< the body cap for this mode
    return max_local_body if ctx.is_local() else max_request_body

priv const io_chunk: Sz = 16 * 1024 //< how many bytes one read/write moves

priv const max_read_rounds: Sz = 8 //< the cap on repeats per notification
    //<
    //< It limits both repeated reads and how many requests are handled in a row.

priv const linger_us: I64 = 5000000I64 //<
    //< How long a connection whose last answer went out keeps reading what its peer still sends
    //<
    //< Long enough for a client to finish sending a body it started (nginx's `lingering_timeout` is
    //< the same 5 seconds), short enough that a client that never stops cannot hold a slot.

priv const idle_conn_us: I64 = 30000000I64 //<
    //< How long a connection may pass no byte either way before it is dropped
    //<
    //< Without it a client that connects and goes quiet holds one of the `max_conns` slots for
    //< good, and that many such clients shut everyone out. A page's hold (`GET /api/here`) is quiet
    //< by design and is not dropped.

priv const request_time_us: I64 = 30000000I64 //<
    //< How long one request may take to arrive whole, from its first byte to its last
    //<
    //< Caution: **The idle timer alone does not bound it.** It restarts on every byte, so a client
    //< sending one byte every few seconds holds its slot for good, and `max_conns` such clients
    //< shut everyone out (Slowloris). The bodies taken are small (`max_request_body`), so a client
    //< that can send at all sends one well within it.

priv const poll_timeout_ms: I32 = 1000 //< `wait()`'s wait time
    //<
    //< It returns even with no connection, so a request to stop is noticed.

priv const index_name: U8[] = "index.html" //<
    //< the file looked for when the root itself is requested

priv const us_per_s: I64 = 1000000I64 //< what `--idle`'s seconds are measured against

priv const flush_gap_us: I64 = 200000I64 //<
    //< The interval (microseconds) at which the buffered log is flushed
    //<
    //< **It goes out at this interval rather than per line** (the reason is in the loop below).
    //< Caution: **Keep it short enough for a person to wait out**, or an idle server's log lags.

// ==========================================
// Resolving a static file
// ==========================================

priv fn content_type_for(path: U8[]): U8[] //< looks the Content-Type up from the extension
    //<
    //< An unknown extension is not guessed but given `application/octet-stream`: a receiver trusts
    //< a wrong type (misread as HTML, a script runs).
    if path.ends_with(".html") || path.ends_with(".htm")
        return "text/html; charset=utf-8"
    if path.ends_with(".css")
        return "text/css; charset=utf-8"
    if path.ends_with(".js")
        return "text/javascript; charset=utf-8"
    // **`.kspage` is JSON too** (a kspage document's JSON); the same content gets the same type.
    if path.ends_with(".json") || path.ends_with(".kspage")
        return "application/json"
    if path.ends_with(".txt") || path.ends_with(".md")
        return "text/plain; charset=utf-8"
    if path.ends_with(".svg")
        return "image/svg+xml"
    if path.ends_with(".png")
        return "image/png"
    if path.ends_with(".jpg") || path.ends_with(".jpeg")
        return "image/jpeg"
    if path.ends_with(".ico")
        return "image/vnd.microsoft.icon"
    if path.ends_with(".wasm")
        return "application/wasm"
    return "application/octet-stream"

priv enum Rel_path //< makes a relative path under the root from a percent-decoded path
    //<
    //< Caution: **Pass the root.** A check on the path string alone (`fs.is_safe_relative`) leaves
    //< a way out through a link inside the root.
    ok(rel: U8[]) //< the path under the root, on the arena
    // A path not accepted as a name under the root (`..` steps, a NUL, a Windows device name, a
    // link in an intermediate folder: everything `fs.stays_under` refuses).
    rejected
    hidden //< a name in it starts with a dot (`hides_name`), so it is answered as absent

priv const well_known: U8[] = ".well-known" //< the one dot folder served (RFC 8615)
    //<
    //< Certificate issuance (ACME) and other discovery read under it, so hiding it would break
    //< them.

priv fn hides_name(rel: U8[]): Bool //<
    //< whether a name in rel starts with a dot, `.well-known` aside
    //<
    //< Caution: **Do not serve them.** A root that is a checkout or holds settings has `.git/`,
    //< `.env` and the like, and anyone the server faces could read them (`/.git/config`).
    //< Answered as absent (404), so a probe learns nothing of what is there.
    $at: Sz = 0
    for at < rel.len
        end: = at + rel.sub_from(at).find_char('/').unwrap_or(rel.len - at)
        name: = rel.sub(at, end - at)
        if name.starts_with(".") && !name.equals(well_known)
            return true
        at = end + 1
    return false

priv fn asks_for_page(decoded: U8[]): Bool //<
    //< Whether a decoded path names the page: the root itself, or `index.html` in it
    //<
    //< **Decided from the text alone**, so it can be asked before anything under the root is looked
    //< at (the reason is at the token's check in `queue_for_request`).
    $rest: = decoded
    for rest.len > 0 && rest[0] == '/'
        rest = rest.sub_from(1)
    return rest.len == 0 || rest.equals(index_name)

priv fn path_to_rel(decoded: U8[], root: U8[], is_page: Bool, arena: Arena$@): Rel_path
    // **The page is the root's index file and nothing else** (`asks_for_page`): a folder standing
    // at that name would otherwise have its own index served as the page, without the token.
    if is_page
        return .ok(index_name) if api.rel_under(root, index_name).is_some() else .rejected
    $t: U8[] = ""
    switch api.rel_under(root, decoded)
    case .some(r)
        t = r
    case .none
        return .rejected
    // Caution: **Check the name that is served, not the one asked for.** A folder gives its index,
    // and checked before the index was added, a link standing at a folder's index served what it
    // points at for the folder's own path, though the index asked for by name was refused.
    // The root itself is the page, so `t` is never empty here.
    if fs.is_dir(fs.join(root, t, arena))
        served: = arena.text().s(t).c('/').s(index_name).take()
        switch api.rel_under(root, served)
        case .some(r)
            t = r
        case .none
            return .rejected
    if hides_name(t)
        return .hidden
    return .ok(t)

priv fn names_this_server(req: http.Request$@): Bool //<
    //< Whether the `Host` header names this machine's loopback, as the token's URL does
    //<
    //< **The port is not compared**: a re-pointed page always sends its own name, so the name alone
    //< tells it apart. `http.parse_request` refuses a second `Host`, so the one found is the only
    //< one.
    host: = req.headers.find("Host").unwrap_or("")
    name: = host.sub(0, host.find_char(':').unwrap_or(host.len))
    return name.equals(local_host) || name.equals_ignore_case("localhost")

priv fn wants_close(req: http.Request$@): Bool //<
    //< Whether the connection closes after this answer (RFC 9112 §9.3)
    //<
    //< `close` among the `Connection` tokens closes it. Otherwise HTTP/1.1 stays open, and
    //< HTTP/1.0 only when it lists `keep-alive`. Caution: **Do not keep a 1.0 client open
    //< unasked**: it reads the answer to the close, so it waits until `idle_conn_us` drops it.
    $close: = false
    $keep: = false
    for h in req.headers.each()
        if h.name.equals_ignore_case("Connection")
            close = close || lists_token(h.value, "close")
            keep = keep || lists_token(h.value, "keep-alive")
    return close || !(http.is_1_1_or_later(req.version) || keep)

priv fn lists_token(list: U8[], want: U8[]): Bool //<
    //< Whether a comma-separated header value holds `want`, in any case (`close, TE` holds `close`)
    $rest: = list
    for
        cut: = rest.find_char(',').unwrap_or(rest.len)
        if rest.sub(0, cut).trim_spaces().equals_ignore_case(want)
            return true
        if cut >= rest.len
            return false
        rest = rest.sub_from(cut + 1)

// ==========================================
// Static files
// ==========================================

priv fn queue_for_request(c: conn.Conn$@, req: http.Request$@, ctx: conn.Ctx$@) //<
    //< Builds the response to one complete request
    conn.stats.requests += 1I64
    // **Every request shows someone is still there.** Stamped per endpoint, the next endpoint added
    // would forget it.
    asked_us = sys.mono_us()
    is_head: = req.method.equals("HEAD")
    is_get: = req.method.equals("GET")
    keep_alive: = !wants_close(req)
    t: = conn.split_target(req.target)
    // **Under `/api/` every answer is JSON, a refusal's included**: an API client reads one form.
    is_api: = t.path.starts_with(api.api_prefix)
    // Caution: **For local use, answer only a request that names this server.** A web page whose
    // name is re-pointed at 127.0.0.1 (DNS rebinding) reaches the port as its own origin, and
    // without this would read every file the page can, the page itself included.
    if ctx.is_local() && !names_this_server(req)
        if is_api
            api.queue_json_error(c, 403)
        else
            conn.queue_error(c, 403)
        return
    if is_api
        api.queue_api(c, t, req, ctx, keep_alive)
        return
    // Static serving is GET/HEAD only (the API's POST branched off before this).
    if !is_get && !is_head
        conn.queue_error(c, 405, "GET, HEAD")
        return

    // **Use `decode_component`**, which keeps a `+`: a space written as `+` is a query's
    // convention, not a path's (see std/url.kspl). The decode happens only once.
    decoded: = url.decode_component(t.path, c.arena) catch _e
        conn.queue_error(c, 400)
        return
    // **Only the named page may be outside the root** (`--page`). Only `/` and `/index.html` are
    // replaced, and **the client cannot choose it with a string it wrote** (`path_to_rel` refuses a
    // `..` or an absolute path). The agreement is "Where it listens" in
    // `docs/SPEC-local-server.md`.
    is_page: = asks_for_page(decoded)
    // Caution: **For local use, hand out only the page without the token** (where the token is
    // handed over). Any other file comes from the origin that keeps the token, so served freely, an
    // HTML file in the root opened in the page's tab could read it, and any program on this machine
    // could read the root. The page reads its pictures through `/api/file`, with the token.
    // **Check it before the path is resolved**: resolving answers a link with 403, so a client
    // without the token would learn which names under the root are links.
    if ctx.is_local() && !is_page && !api.authorized(req, ctx.token)
        conn.queue_error(c, 401)
        return
    $rel: U8[] = ""
    switch path_to_rel(decoded, ctx.root, is_page, c.arena)
    case .ok(r)
        rel = r
    case .rejected
        // `fs.join` does not resolve `..`, so a path let through would return a file outside the
        // root. A 403, not a 404: the form was refused, and whether the name exists is not checked.
        conn.queue_error(c, 403)
        return
    case .hidden
        conn.queue_error(c, 404)
        return

    // A directory has already become its index (`/docs` and `/docs/` alike) in `path_to_rel`.
    target_path: =
        ctx.page if ctx.page.len > 0 && is_page else fs.join(ctx.root, rel, c.arena)

    $size: Sz = 0
    if found: = conn.regular_file_size(target_path)
        size = found
    else
        conn.queue_error(c, 404)
        return

    keep: = keep_alive
    ctype: = content_type_for(target_path)
    if is_head
        // A HEAD's Content-Length names the real length; 0 would read as "an empty file".
        conn.queue_to_head(c, 200, ctype, size, keep)
        return

    // The stat found it, so an open that fails is the server's fault, not a missing name.
    file: = io.open(target_path, "rb") catch _e
        conn.queue_error(c, 500)
        return
    conn.queue_file(c, ctype, file, size, keep)

// ==========================================
// How one connection is driven
// ==========================================

priv fn conn_build(c: conn.Conn$@, ctx: conn.Ctx$@) //<
    //< Builds the response to the next complete request in `inbuf`
    //<
    //< Caution: Do not move on to the next request until `outbuf` is empty, or two responses mix.
    if c.outbuf.len > 0 || c.inbuf.len == 0
        return
    // Caution: **Parse only once there is something new to decide.** Parsed from the start on
    // every read, a request trickling in a byte at a time costs its length squared.
    if c.inbuf.len < c.need || (c.need == 0 && !head_decided(c))
        return
    base: = c.arena.save()
    c.answers_head = false
    req: =
        http.parse_request(c.inbuf.slice(), body_limit(ctx), c.arena) catch e
        c.arena.restore(base)
        switch e
        case .incomplete
            // The head is whole and the body is not: wait until all of it is there.
            whole: =
                http.request_length(c.inbuf.slice(), body_limit(ctx), c.arena) catch 0
            c.need = whole if whole > 0 else c.inbuf.len + 1
            c.arena.restore(base)
            return
        case .head_too_large
            conn.queue_error(c, 431)
            return
        case .body_too_large
            conn.queue_error(c, 413)
            return
        default
            conn.queue_error(c, 400)
            return
    c.answers_head = req.method.equals("HEAD")
    queue_for_request(c, req, ctx)
    // Caution: Drop only what the finished parse used. Emptied completely, the start of the next
    // request that came in the same read is lost.
    c.inbuf.drop_prefix(req.consumed)
    // What is left is the next request, already arriving.
    c.need = 0
    c.head_from = 0
    c.request_since_us = sys.mono_us() if c.inbuf.len > 0 else 0I64
    // The response is in `outbuf` (on the heap) by now. Without the rewind, a keep-alive
    // connection's arena grows with every request.
    c.arena.restore(base)

priv fn head_decided(c: conn.Conn$@): Bool //<
    //< Whether `inbuf` holds what decides its head: its end, a line break it refuses, or its cap
    //<
    //< The search resumes where the last one stopped (`head_from`), so a head arriving a byte at a
    //< time is searched once. A bare LF or CR is refused by `http.parse_request`, so it decides
    //< too: waited past, it would hold the client until its time is up rather than answer 400.
    s: = c.inbuf.slice()
    if s.len > http.max_head_bytes
        return true
    $i: = c.head_from
    for i < s.len
        if s[i] == '\n' && (i == 0 || s[i - 1] != '\r')
            return true
        if s[i] == '\r' && i + 1 < s.len && s[i + 1] != '\n'
            return true
        if s[i] == '\n' && i >= 3 && s[i - 1] == '\r' && s[i - 2] == '\n' && s[i - 3] == '\r'
            return true
        i += 1
    // The last byte is looked at again: a CR there is decided by what follows it.
    c.head_from = s.len - 1
    return false

priv fn conn_send(c: conn.Conn$@): Bool //< sends as much of `outbuf` as can be sent
    //<
    //< False means close.
    $refills: Sz = 0
    for
        for c.sent < c.outbuf.len
            rest: = c.outbuf.slice().sub(c.sent, c.outbuf.len - c.sent)
            n: =
                c.stream.write(rest.sub(0, io_chunk) if rest.len > io_chunk else rest) catch e
                switch e
                case .would_block
                    return true // wait for writable
                default
                    return false
            if n == 0
                return false // no progress (the peer closed)
            c.sent += n
            c.moved_us = sys.mono_us()
        c.outbuf.clear()
        c.sent = 0
        if c.file_left == 0
            break
        if !refill_from_file(c)
            return false
        // Caution: **Cap the chunks per notification**, or one fast download makes everyone else
        // wait. **Stop with a chunk queued**: an empty `outbuf` is not watched for writable, so
        // the rest would never go.
        refills += 1
        if refills >= max_read_rounds
            return true
    if !c.close_after_send
        return true
    // A peer that closed its sending side has nothing left to drain.
    if c.peer_done
        return false
    // Close the sending side and read on until the peer closes (`conn.Conn.lingering_since_us`).
    c.stream.shut_write() catch
        return false
    c.lingering_since_us = sys.mono_us()
    c.inbuf.clear()
    return true

priv fn refill_from_file(c: conn.Conn$@): Bool //< moves the file's next chunk into `outbuf`
    //<
    //< False means close: the read failed, or the file ended before the length the head named (it
    //< shrank since the stat). **The client then sees the connection close short**, which tells it
    //< the body is cut; padding it out would hand over bytes that are not the file.
    $chunk: U8[io_chunk] = ::{}
    want: = c.file_left if c.file_left < io_chunk else io_chunk
    n: = c.file.read(U8$[]::{ .ptr = chunk[0]@, .len = want }) catch _e
        return false
    if n == 0
        return false
    c.outbuf.s(U8[]::{ .ptr = chunk[0]@, .len = n })
    c.file_left -= n
    if c.file_left == 0
        c.file.free()
    return true

priv fn conn_read(c: conn.Conn$@, ctx: conn.Ctx$@): Bool //< reads from the socket
    //<
    //< False means close.
    //< Caution: **Cap the reads per notification**, or one client that keeps sending makes everyone
    //< else wait (the rest comes back as readable at the next `wait()`).
    $chunk: U8[io_chunk] = ::{}
    for _round in Range.asc(max_read_rounds)
        n: = c.stream.read(U8$[]::chunk) catch e
            switch e
            case .would_block
                return true
            default
                return false
        if n == 0
            // Before lingering, EOF closes only the peer's sending side: its answer may still
            // be waiting. During lingering the answer is out, so EOF completes the close.
            c.peer_done = true
            return c.lingering_since_us == 0I64
        if c.lingering_since_us != 0I64
            continue // a lingering connection drains the peer's remaining bytes
        if c.inbuf.len == 0
            c.request_since_us = sys.mono_us()
        c.inbuf.s(U8$[]::{ .ptr = chunk@, .len = n })
        c.moved_us = sys.mono_us()
        // **Without a cap, one client that never ends its request uses up the memory.**
        if c.inbuf.len > http.max_head_bytes + body_limit(ctx)
            conn.queue_error(c, 431)
            c.inbuf.clear()
            return true
        if n < io_chunk
            return true // everything there is has been read
    return true

priv fn conn_pump(c: conn.Conn$@, ctx: conn.Ctx$@, can_read: Bool): Bool //<
    //< Drives read -> build -> send as far as it will go
    //<
    //< False means close.
    //< The table owns the connection for the whole pass; the caller drops its slot afterwards.
    c.backlog = false
    if c.lingering_since_us != 0I64
        return !can_read || conn_read(c, ctx)
    // **Do not read once `peer_done` is set.** EOF stays readable, so reading would spin.
    if can_read && !c.peer_done && c.outbuf.len == 0 && !conn_read(c, ctx)
        return false
    // The requests per notification are capped too (the reason is at `conn_read`).
    for _round in Range.asc(max_read_rounds)
        conn_build(c, ctx)
        if c.outbuf.len == 0
            return true // nothing to build (the request has not arrived)
        if !conn_send(c)
            return false
        if c.outbuf.len > 0
            return true // not all sent; wait for writable
        if c.inbuf.len == 0
            return true
    // Caution: **Mark what the cap left.** The requests are already read, so no notification comes
    // for them: unmarked, the client waits forever, or is swept away unanswered once it
    // half-closes.
    c.backlog = true
    return true

priv fn drive_backlog(t: conn.Conn_table$@, ctx: conn.Ctx$@): Bool //<
    //< Drives each connection the cap left with requests already read (`conn.Conn.backlog`)
    //<
    //< True means one still has some, so the next `wait()` must not sleep.
    $left: = false
    for i in Range.asc(conn.max_conns)
        if t.slots[i].is_empty() || !t.slots[i].get().backlog
            continue
        if !conn_pump(t.slots[i].get(), ctx, false)
            conn.table_drop(t, i, ctx.lg)
            continue
        left = left || t.slots[i].get().backlog
    return left

// ==========================================
// Accepting
// ==========================================
priv $refused_said: I64 = 0I64 //< the refusals already told of when a slot came free again

priv fn say_refused(lg: Log$@, per_peer: Bool) //<
    //< Counts one refused connection, and says why only for the first of a stretch
    //<
    //< **Not per refusal**: a flood would bury the log. The next accepted connection closes the
    //< stretch (`accept_all`). `per_peer` is the cap on one address, else the table is full.
    if conn.stats.connections_refused == refused_said
        if ln: = lg.at(.warning)
            if per_peer
                ln
                    .s("a peer holds \{conn.max_conns_per_peer\} connections already; more from it \
                        are refused until one closes")
            else
                ln
                    .s("every one of the \{conn.max_conns\} connection slots is taken; new \
                        connections are refused until one closes")
    conn.stats.connections_refused += 1I64

priv fn accept_all(listener: net.Tcp_listener$@, t: conn.Conn_table$@, lg: Log$@, outward: Bool) //<
    //< Accepts every pending connection into a free slot, or refuses it
    //<
    //< Facing outward, one address may hold at most `conn.max_conns_per_peer` of the slots.
    for
        stream: = listener.accept() catch e
            switch e
            case .would_block { // every pending connection is accepted.
            } default
                if ln: = lg.at(.error)
                    ln.s("accept failed: \{e\}")
            return
        stream.set_nonblocking() catch
            lg.say(.error, "cannot set the accepted socket nonblocking")
            stream.free()
            continue
        $host: U8[net.addr_text_max] = ::{}
        p: = stream.peer(U8$[]::host) catch net.Peer_addr::{ .host_len = 0, .port = 0 }
        peer: = U8[]::{ .ptr = host[0]@, .len = p.host_len }
        // Caution: **Count by address before taking a slot**, or one machine holding them all shuts
        // everyone else out however short the time it may hold each.
        if outward && conn.peer_count(t, peer) >= conn.max_conns_per_peer
            say_refused(lg, true)
            stream.free()
            continue
        slot: = conn.table_find_free(t)
        if slot < 0
            // The cap is reached. Refusing holds less state than waiting for a free slot.
            say_refused(lg, false)
            stream.free()
            continue
        if conn.stats.connections_refused > refused_said
            meanwhile: = conn.stats.connections_refused - refused_said
            if ln: = lg.at(.information)
                ln.s("a connection slot is free again (\{meanwhile\} refused meanwhile)")
            refused_said = conn.stats.connections_refused
        conn.stats.connections_total += 1I64
        conn.stats.connections_open += 1I64
        // The address is logged at accept, not after the request: spotting "it connected, yet no
        // request comes" needs the connection line alone.
        who: = peer if p.host_len > 0 else "(unknown)"
        if ln: = lg.at(.information)
            ln
                .s("conn #\{conn.stats.connections_total\} from \{who\}:\{p.port\} (open \
                    \{conn.stats.connections_open\})")
        t.slots[slot] = conn.conn_new(stream, conn.stats.connections_total)
        fresh: = t.slots[slot].get()
        fresh.peer = host
        fresh.peer_len = p.host_len

priv fn rebuild_interests(r: reactor.Reactor$@, listener: net.Tcp_listener$@,
    t: conn.Conn_table$@) //<
        //< Rebuilds the watch set and the interests from the table, every time it is called
        //<
        //< Caution: **Rebuild them from scratch.** Updated incrementally, a closed peer's
        //< registration stays and an interest is not switched back from partly sent to partly read.
    r.clear()
    r.register(listener.raw_handle(), reactor.readable, listener_token)
    for i in Range.asc(conn.max_conns)
        if t.slots[i].is_empty()
            continue
        c: = t.slots[i].get()
        // Caution: **Do not watch a connection whose peer closed its sending side while there is
        // nothing to send.** EOF is always readable, so `wait()` returns at once and burns the CPU.
        if c.peer_done && c.outbuf.len == 0
            continue
        // **Do not read more while requests already read wait** (`drive_backlog` drives them): TCP
        // then holds the client back, rather than its requests piling up here.
        if c.backlog
            continue
        // **Watch for writable only while partly sent.** An empty send buffer is always writable,
        // so `wait()` would return at once and burn the CPU.
        interest: = reactor.writable if c.outbuf.len > 0 else reactor.readable
        r.register(c.stream.raw_handle(), interest, i)

priv fn sweep_done(t: conn.Conn_table$@, ctx: conn.Ctx$@) //<
    //< Clears away the connections that are done: nothing left to send, or lingered their time
    //<
    //< A connection is done when its peer stopped sending and nothing is left to send or answer,
    //< when it lingered its full time (`linger_us`), or when it passed nothing for `idle_conn_us`.
    //< **This is needed because such a connection is not watched for reading** (the reason is at
    //< `rebuild_interests`).
    for i in Range.asc(conn.max_conns)
        if t.slots[i].is_empty()
            continue
        c: = t.slots[i].get()
        // Caution: **Drop it even with a partial read left**, once no whole request waits there
        // (`backlog`). No notification comes after EOF, so what is left is a request cut off
        // partway, which cannot be answered.
        // **A lingering connection is dropped once its time is up**, whatever its peer still sends.
        now: = sys.mono_us()
        lingered: = c.lingering_since_us != 0I64 && now - c.lingering_since_us >= linger_us
        idle: =
            !c.holding && c.lingering_since_us == 0I64 && now - c.moved_us >= idle_conn_us
        // A request still arriving, with nothing to answer yet, past its time.
        slow: =
            c.request_since_us != 0I64 && c.inbuf.len > 0 && c.outbuf.len == 0 && !c.backlog &&
            c.lingering_since_us == 0I64 && now - c.request_since_us >= request_time_us
        if idle
            if ln: = ctx.lg.at(.information)
                ln.s("conn #\{c.serial\} passed nothing for \{idle_conn_us / us_per_s\} s; closed")
        else if slow
            if ln: = ctx.lg.at(.information)
                ln
                    .s("conn #\{c.serial\} did not send a whole request in \
                        \{request_time_us / us_per_s\} s; closed")
        else if !lingered && (!c.peer_done || c.outbuf.len > 0 || c.backlog)
            continue
        conn.table_drop(t, i, ctx.lg)

// ==========================================
// The token
// ==========================================

$asked_us: I64 = 0I64 //< when the last request arrived, on the monotonic clock
    //<
    //< Also set at start-up, so the wait for the first page is like any other.

priv const any_host: U8[] = "0.0.0.0" //< the address listened on
    //<
    //< **Local use listens on the loopback only.** It is built so that it cannot be reached from
    //< outside ("Where it listens" in `docs/SPEC-local-server.md`).
priv const local_host: U8[] = "127.0.0.1"

priv const token_bytes: Sz = 24 //< the token's byte count
    //<
    //< Caution: **Make it long enough that brute force cannot find it**: it is what makes knowing
    //< the address alone not enough to make requests.

priv fn make_token(out: U8$[]): Bool //< makes one token and fills `out`
    //<
    //< `out` needs `token_bytes * 2` bytes.
    //< Caution: **Do not take it as a parameter.** The command line is visible through `ps` to
    //< anyone on the same machine, so a token passed in has already leaked. **Use a
    //< cryptographically secure random source** (`std/rand` reads the OS's).
    $raw: U8[token_bytes] = ::{}
    rand.fill(U8$[]::raw) catch _e
        return false
    for i in Range.asc(token_bytes)
        out[i * 2] = (raw[i] >> 4U8).to_hex_lower()
        out[i * 2 + 1] = (raw[i] & 0x0fU8).to_hex_lower()
    return true

fn main(): I32
    // **The logger is made before anything can go wrong**, so every exit from here writes its line
    // through it. `done` on the way out closes any open line and flushes it.
    $lg: = log_new()
    defer lg.done()
    $local: = false
    $page: U8[] = ""
    $idle_s: I64 = 0I64
    arg_arena: = Arena.new(4 * 1024)
    defer arg_arena.free()
    cli: = argp.Parser
        .create("kssrv", "serves the files under <root>, and JSON under /api/", arg_arena)
    cli.positional("<port> <root>")
    cli.flag("--local", local@, "serve 127.0.0.1 only, make a token, open the file endpoints")
    cli.str_opt("--page", page@,
        "answer / and /index.html with this file (it may sit outside <root>)")
    // **Absent means it stays up.** Facing outward there is no page to hold it, so a server given
    // no option must not stop itself ("Keeping the server alive while a page is open" in
    // `../docs/SPEC-local-server.md`).
    cli.int_opt("--idle", idle_s@,
        "stop once no page has held it this many seconds (absent: stay up)")
    cli.parse_or_exit(sys.args(), arg_arena)
    if cli.rest.len != 2
        cli.print_usage(io.err())
        return 2
    port_text: = cli.rest.get(0)
    root: = cli.rest.get(1)
    // Caution: **Do not start at all unless the named page is a file it can serve.** A 404 later
    // leaves "the page is blank" with no visible reason, and a folder would be a second root (the
    // same section of the agreement). Serving asks `conn.regular_file_size` too, so the two agree.
    if page.len > 0 && conn.regular_file_size(page).is_none()
        if ln: = lg.at(.error)
            if fs.is_dir(page)
                ln.s("the page must be a file, not a folder: \{page\}")
            else if fs.exists(page)
                ln.s("the page must be a regular file, not a pipe or a device: \{page\}")
            else
                ln.s("no such page: \{page\}")
        return 1

    // **The token lives in main's memory**, not in an arena that is rewound per request.
    $token_buf: U8[token_bytes*2] = ::{}
    $token: U8[] = ""
    if local
        if !make_token(U8$[]::token_buf)
            lg.say(.error, "cannot generate a token from the OS random source")
            return 1
        token = U8[]::{ .ptr = token_buf@, .len = token_bytes * 2 }

    port64: = port_text.to_i64() catch _e
        if ln: = lg.at(.error)
            ln.s("port must be a number: \{port_text\}")
        return 1
    if port64 < 1I64 || port64 > 65535I64
        if ln: = lg.at(.error)
            ln.s("port out of range (1-65535): \{port_text\}")
        return 1
    port: = I32::port64

    if !fs.is_dir(root)
        if ln: = lg.at(.error)
            ln.s("not a directory: \{root\}")
        return 1

    host: = local_host if local else any_host
    listener: = net.Tcp_listener.bind(host, port) catch e
        if ln: = lg.at(.error)
            ln.s("cannot listen on port \{port\}: \{e\}")
        return 1
    defer listener.free()
    listener.set_nonblocking() catch
        lg.say(.error, "cannot set the listening socket nonblocking")
        return 1

    $r: = reactor.Reactor.new()
    defer r.free()
    // Zero-initialized: a free slot is an ARC handle's zero value, which the release at scope exit
    // treats as owning nothing.
    $table: conn.Conn_table = ::{}
    defer
        for i in Range.asc(conn.max_conns)
            conn.table_drop(table@, i, lg@)

    // Facing outward, the car's steering policy trains before accepting starts, **after the bind**,
    // so a port clash shows before training. A connect meanwhile succeeds in the kernel's backlog,
    // so **a successful connect does not mean it can answer**; the "listening on" line below does
    // (`kssrv/tests/start.kspl` waits for it). If you move the line, fix that file too.
    // **Local use trains nothing**: it listens on the loopback, which the car cannot reach, and a
    // page opening a document should not wait on it.
    $p: pilot.Pilot$@ = null
    if !local
        build_arena: = Arena.new(1024 * 1024)
        p = pilot.build(build_arena)
        build_arena.free()
        pilot.print_summary(p, lg@)
    defer
        if p != null
            pilot.free(p)
    $ctx: conn.Ctx = ::{ .root = root, .lg = lg@, .token = token, .p = p, .page = page }

    conn.stats.started_s = time.now()
    if ln: = lg.at(.information)
        ln.s("listening on \{host\}:\{port\}, root=\{root\}")
    // Caution: **Log the named page on one line**, or nobody can confirm which file `/` returns.
    if page.len > 0
        if ln: = lg.at(.information)
            ln.s("page=\{page\}")
    if local
        // **The token goes in the fragment (`#`)**, which is not sent to the server, so another
        // process's `GET /` cannot get it; in the query (`?`) it would stay in the log. **It is
        // printed only once**: an endpoint returning it would give it to anyone who does not know
        // it.
        if ln: = lg.at(.information)
            ln.s("open http://\{host\}:\{port\}/#t=\{token\}")

    // Caution: **Do not enter the loop with the lines the waiters read still buffered.** The
    // waiters for `kssrv: I: listening on` (`kssrv/tests/start.kspl`) and for `kssrv: I: open `
    // (`kspage/Makefile`) would both fail, never seeing them.
    lg.done()

    // Caution: **Flush in this one place, not per line.** A flush blocks the accepting thread, and
    // it **would happen twice per connection** (a line at accept and at close). `flush_gap_us` is
    // checked **before entering the wait**, so when idle a line just written goes out in that pass.
    $flushed_us: = sys.mono_us()
    asked_us = flushed_us
    for
        backlogged: = drive_backlog(table@, ctx@)
        rebuild_interests(r@, listener, table@)
        now_us: = sys.mono_us()
        if now_us - flushed_us >= flush_gap_us
            lg.done()
            flushed_us = now_us
        // **Asked to stop, it stops once the answer has gone out** (`api.queue_api_stop`), whoever
        // holds it: the person asked.
        if conn.stop_asked_by != 0I64 && !conn.open_serial(table@, conn.stop_asked_by)
            lg.say(.information, "asked to stop: stopping")
            return 0
        // **No holder means "nobody is using me".**
        if idle_s > 0I64 && !conn.any_holding(table@) && now_us - asked_us >= idle_s * us_per_s
            if ln: = lg.at(.information)
                ln.s("no page has held it for \{idle_s\} seconds: stopping")
            return 0
        $ready: = r.wait(0 if backlogged else poll_timeout_ms) catch e
            if ln: = lg.at(.error)
                ln.s("poll failed: \{e\}")
            continue
        // Caution: **Accept last**, after this wakeup's closes and the sweep: accepted first, a
        // connection already gone still counts against its address and the table's cap.
        $accepting: = false
        for ev in ready
            if ev.token == listener_token
                accepting = true
                continue
            if table.slots[ev.token].is_empty()
                continue
            // Caution: **Keep "it became unusable" apart from "the peer closed its sending side".**
            // The latter is `read` returning 0, and dropping it loses an answer still to come (see
            // `conn_read`). Which flag it arrives under differs by environment, so `conn_read`
            // decides.
            $keep: = (ev.revents & reactor.err_or_closed) == 0
            if keep
                woke: = ev.revents & (reactor.readable | reactor.hangup)
                keep = conn_pump(table.slots[ev.token].get(), ctx@, woke != 0)
            if !keep
                conn.table_drop(table@, ev.token, lg@)
        ready.free()
        sweep_done(table@, ctx@)
        if accepting
            accept_all(listener, table@, lg@, !ctx.is_local())

//< The entry points that touch a style
//< Note: **In kspage, `face` means a style** (as in `Block_face_op` in `write/record.kspl`).
//< It is not a typeface — a typeface is `Font` and `Style.family`, and the screen's CSS calls it
//< `--font`.
//< Applying a style, changing its contents, number formats, a paragraph's alignment. Split from
//< [`bridge.kspl`](bridge.kspl) for the 1000-line-per-file cap, and follows its boundary rules.
import "kspage/lay/caret"
import "kspage/model/collect" + { Collect }
import "kspage/model/doc" { Rect }
import "kspage/model/paint"
import "kspage/model/run"
import "kspage/model/style"
import "kspage/port/web/state" + { ed, ensure, in_ptr, page, sheet }
import "kspage/write/block"
import "kspage/write/insert"
import "kspage/write/shape"
import "std/chars" as _chars // tests and cuts single characters

// ---- Applying a style ----

// Writes the style name of the cursor's inline and returns the length. Empty means the parent's.
#export
fn kspage_web_style(): Sz
    ensure()
    return state.say(ed.caret.inline.style if ed.caret.inline != null else "")

// Applies the `len` bytes in the typing arena to the selection as a style name; 1 if applied. An
// empty name reverts to the parent's; **with nothing selected it applies to the whole inline.**
#export
fn kspage_web_set_style(len: Sz): I32
    if name: = state.typed(len)
        return 1 if ed.set_style(name) else 0
    return 0

// The number of names in the style table (for the screen's "Style" list).
#export
fn kspage_web_style_count(): Sz
    ensure()
    return sheet.styles.len

// Writes style `i`'s name and returns the length.
#export
fn kspage_web_style_name(i: Sz): Sz
    ensure()
    return state.say(sheet.styles.get(i).name if state.has_style(i) else "")

// Applies a color style to the selection; 1 if applied. **It replaces everything** — fields not
// passed are dropped, and with none set it reverts to the parent's. The style name is built from
// the settings, so the same settings again add no style.
#export
fn kspage_web_paint_span(has_color: I32, color: F32, has_back: I32, back: F32, has_under: I32,
    under: I32, has_strike: I32, strike: I32, has_bold: I32, bold: I32, has_italic: I32,
    italic: I32): I32
    ensure()
    $ink: paint.Ink = paint.inherit_ink()
    if has_color != 0
        ink.color = .some(U32::color)
    if has_back != 0
        ink.background = .some(U32::back)
    if has_under != 0
        ink.underline = .some(under != 0)
    if has_strike != 0
        ink.strike = .some(strike != 0)
    $accent: paint.Accent = paint.inherit_accent()
    if has_bold != 0
        accent.bold = .some(bold != 0)
    if has_italic != 0
        accent.italic = .some(italic != 0)
    return 1 if ed.paint_span(sheet, ink, accent) else 0

// Writes 12 values into out for the color and emphasis of the cursor's inline. Each of text
// color, background, underline, strikethrough, bold, italic comes as "whether set" and the value.
// **Both are replaced whole**, so to change one field, read here first. Unread, the other fields
// are dropped. It returns the inline's own settings (not what it inherits from the parent).
#export
fn kspage_web_span_ink(out: F32$@)
    state.clear_out(out, 12)
    ensure()
    if ed.caret.inline == null
        return
    if s: = sheet.find(ed.caret.inline.style)
        state.color_into(out, s.ink.color)
        state.color_into(out + 2, s.ink.background)
        switch s.ink.underline
        case .some(v)
            (out + 4)$ = 1.0
            (out + 5)$ = 1.0 if v else 0.0
        case .none {}
        switch s.ink.strike
        case .some(v)
            (out + 6)$ = 1.0
            (out + 7)$ = 1.0 if v else 0.0
        case .none {}
        // Bold is derived from the weight (a style holds the weight; emphasis says whether it is
        // bold).
        switch s.font.weight
        case .some(v)
            (out + 8)$ = 1.0
            (out + 9)$ = 1.0 if v >= paint.BOLD_WEIGHT else 0.0
        case .none {}
        switch s.font.italic
        case .some(v)
            (out + 10)$ = 1.0
            (out + 11)$ = 1.0 if v else 0.0
        case .none {}

// ---- Shapes ----

// Adds one shape to the cursor's container from `shape\tname` in the typing arena; 1 if added. The
// shape is `style.Shape`'s variant name, and the name the style it is drawn in. **Inside a slide it
// goes to the slide itself**, even when clicked on a frame's text: a shape is the frame's sibling.
// Otherwise it goes to the paragraph or cell, not to a grid or a collecting block. A missing style
// is made; for an existing one only the shape is changed.
#export
fn kspage_web_insert_shape(len: Sz): I32
    ensure()
    // Caution: **Take the text from the typing arena** (the loading arena is for an image's
    // source).
    two: = state.split_input(len)
    if !two.found || two.tail.len <= 0
        return 0
    return 1 if ed.insert_shape(page, sheet, two.tail, style.shape_from(two.head)) else 0

// Draws one shape of w × h from screen position (x, y) onto the clicked slide, from
// `shape\tname` in the typing arena (as `kspage_web_insert_shape`); 1 if drawn. **The cursor is
// ignored** (this is picking a tool and dragging). **0 where the press was not on a slide** (flow
// and grid layouts read no position). The core turns screen coordinates into the frame's position.
#export
fn kspage_web_draw_shape(len: Sz, x: F32, y: F32, w: F32, h: F32): I32
    ensure()
    two: = state.split_input(len)
    if !two.found || two.tail.len <= 0
        return 0
    return (1
        if ed.draw_shape(page, sheet, two.tail, style.shape_from(two.head), x, y, w, h) else 0)

// Removes the selected frame if it holds no text; 1 if removed. **On a frame with text it is 0**,
// and the key handler then deletes one character (otherwise Delete would stop working mid-typing).
#export
fn kspage_web_drop_picked(): I32
    ensure()
    return 1 if ed.drop_picked(sheet) else 0

// ---- A paragraph's style ----

// Writes the style name of the cursor's paragraph and returns the length. Empty means the parent's.
// **It is separate from the inline's style** (`kspage_web_style`); the marker and the arrangement
// belong here.
#export
fn kspage_web_block_style(): Sz
    ensure()
    return state.say(ed.block_style_at())

// Makes the `len` bytes in the typing arena the style of the selected paragraphs. **Only
// paragraphs** (cells and containers in the range are untouched). **A style with a different
// arrangement is not applied** (a table's style on a paragraph leaves the text nowhere to go).
// Empty removes it, a list's marker included. Writes the result's variant name
// (`block.Block_style_end`) and returns its length.
// Caution: **Pass the reason out** — a single false leaves the page no fitting message.
#export
fn kspage_web_set_block_style(len: Sz): Sz
    ensure()
    if page != null
        if name: = state.typed(len)
            return state.say(ed.set_block_style(page, sheet, name).variant_name())
    return state.say(block.Block_style_end.no_paragraph.variant_name())

// Whether style `i` can be applied to a paragraph. **Only the core's `style.fits_block` decides**
// (a separate check in the page could refuse a listed style).
#export
fn kspage_web_style_fits_block(i: Sz): I32
    ensure()
    if !state.has_style(i)
        return 0
    return 1 if style.fits_block(sheet.styles.get(i)) else 0

// ---- Names ----

// Writes the name of the cursor's place and returns the length. **Empty means none** (it cannot
// be pointed at). What it attaches to follows the table of `named_at` in `../../write/block.kspl`.
#export
fn kspage_web_name(): Sz
    ensure()
    return state.say(ed.name_at(page))

// Makes the `len` bytes in the typing arena the name of the current place. Empty removes it. It
// is separate from a style's name. Writes what happened and returns its length: `done`, `nowhere`
// where there is no place to name, or **the reason a formula could not reach a table by that name**
// (`calc.Name_fault`'s variant name).
// Caution: **Refuse before layout.** Layout decides whether it is a cell. Before it, **a name
// meant for the table attaches to the cell** while the screen says "set".
#export
fn kspage_web_set_name(len: Sz): Sz
    ensure()
    if page != null
        if name: = state.typed(len)
            fault: = ed.name_fault_at(page, name)
            if !fault.reachable()
                return state.say(fault.variant_name())
            if ed.set_name(page, name)
                return state.say("done")
    return state.say("nowhere")

// Inserts the `len`-byte name in the typing arena as an inline that refers from the body; 1 if
// inserted. Only a block with a running number can be referred to. The number is recounted at
// every layout; the document stores only the name.
#export
fn kspage_web_insert_refer(len: Sz): I32
    ensure()
    if page == null
        return 0
    if name: = state.typed(len)
        return 1 if ed.insert_refer(page, sheet, name) else 0
    return 0

// ---- Links ----

// Writes the link target of the cursor's inline and returns the length. Empty means none.
#export
fn kspage_web_href(): Sz
    ensure()
    return state.say(ed.caret.inline.href if ed.caret.inline != null else "")

// Makes the selection (with nothing selected, the whole inline) a link; 1 if applied. **Empty text
// removes it**, and the link's look reverts to the parent's too.
#export
fn kspage_web_set_href(len: Sz): I32
    ensure()
    if href: = state.typed(len)
        // Caution: **Do not accept a scheme that cannot be opened** (`safe_href` in
        // `model/run.kspl`) — accepted but never opened, it is a field that does nothing
        // (Principle 5). Empty means "remove the link".
        if href.len > 0 && !run.safe_href(href)
            return 0
        return 1 if ed.link_span(sheet, href) else 0
    return 0

// Writes the link target of the text exactly at (x, y) and returns the length. **It is not moved
// to what is nearby**, or a click in the margin would follow the link. Empty outside.
// Caution: **Call it after layout** (with no boxes nothing is at any point).
#export
fn kspage_web_href_at(x: F32, y: F32): Sz
    ensure()
    state.out.clear()
    if page != null
        if n: = caret.inline_under(page, x, y)
            // Caution: **Do not pass a scheme that cannot be opened** (`safe_href` in
            // `model/run.kspl`) — the page opens it on a click.
            if run.safe_href(n.href)
                state.out.s(n.href)
    return state.out.len
// ---- Images ----

// The number of laid-out images, **after layout.**
#export
fn kspage_web_picture_count(): Sz
    if page == null
        return 0
    return page.pictures.len

// Writes four values for image `i` into out (x / y / w / h); four 0s when absent.
#export
fn kspage_web_picture(i: Sz, out: F32$@)
    $spot: = Rect::{ .x = 0.0, .y = 0.0, .w = 0.0, .h = 0.0 }
    if page != null && i >= 0 && i < page.pictures.len
        spot = page.pictures.get(i).rect
    state.rect_into(out, spot)

// Writes image `i`'s source and returns the length. The image itself is not held (loading and
// drawing happen outside).
#export
fn kspage_web_picture_src(i: Sz): Sz
    return state
        .say(page.pictures.get(i).block.image if page != null && i >= 0 && i < page.pictures.len
        else "")

// Inserts one image after the cursor's paragraph, with the `len` bytes in the loading arena as its
// source; 1 if inserted.
// Caution: **Use the loading arena, not the typing arena** (`kspage_web_load_buffer`) — the typing
// arena has a fixed size, so a long source is silently cut. The caller passes the size (the core
// cannot read an image).
#export
fn kspage_web_insert_image(len: Sz, w: F32, h: F32): I32
    ensure()
    if page == null || in_ptr == null || len <= 0
        return 0
    return 1 if ed.insert_image(page, U8[]::{ .ptr = in_ptr, .len = len }, w, h) else 0
// Inserts a collecting block after the cursor's paragraph from `kind\tname` in the typing arena;
// 1 if inserted. The kind is `Collect`'s variant name: `notes` a list of notes, anything else a
// table of contents. **The contents are not inserted** (they are built at every layout); a missing
// style is made.
#export
fn kspage_web_insert_gathered(len: Sz): I32
    ensure()
    two: = state.split_input(len)
    if page == null || !two.found || two.tail.len <= 0
        return 0
    $what: Collect = .contents
    switch collect.collect_from(two.head)
    case .notes
        what = .notes
    default {}
    return 1 if ed.insert_gathered(page, sheet, two.tail, what) else 0

// ---- Charts ----

// Inserts a chart after the cursor's paragraph from `kind\tname\trange` in the typing arena; 1 if
// inserted. The kind is `Collect`'s variant name (`bars`, `lines`). **The range needs the table's
// name** (`Details!C2:C4`), as a chart in the flow has none of its own. The contents are not
// inserted (they are built from the range at layout time).
#export
fn kspage_web_insert_chart(len: Sz): I32
    ensure()
    two: = state.split_input(len)
    if page == null || !two.found
        return 0
    cut: = state.split_at_tab(two.tail)
    if cut >= two.tail.len
        return 0
    name: = two.tail.sub(0, cut)
    range: = two.tail.sub_from(cut + 1)
    return (1
        if ed.insert_chart(page, sheet, name, range, collect.collect_from(two.head)) else 0)

// ---- Notes ----

// Writes the note on the cursor's inline and returns the length. Empty means none.
#export
fn kspage_web_note(): Sz
    ensure()
    return state.say(ed.caret.inline.note if ed.caret.inline != null else "")

// Makes the `len` bytes in the typing arena the note at the cursor; 1 if set. Empty removes it.
// It stores no number (numbers are counted where notes are listed).
#export
fn kspage_web_set_note(len: Sz): I32
    ensure()
    if note: = state.typed(len)
        return 1 if ed.set_note(note) else 0
    return 0

// ---- Comments ----

// Writes the comment on the cursor's inline and returns the length. Empty means none.
#export
fn kspage_web_remark(): Sz
    ensure()
    return state.say(ed.caret.inline.remark if ed.caret.inline != null else "")

// Writes who wrote the comment on the cursor's inline and returns the length, **separately from
// the words** (the words can hold any separator).
#export
fn kspage_web_remark_by(): Sz
    ensure()
    return state.say(ed.caret.inline.remark_by if ed.caret.inline != null else "")

// Makes the `len` bytes (`who\tthe words`) in the typing arena the comment on the selection; 1 if
// set. **Without a tab it does nothing** (an empty who and a forgotten tab look alike).
// Caution: **Put the who first** — the first tab separates them, so the words may hold tabs. Empty
// words remove the comment, and the who with it.
#export
fn kspage_web_set_remark(len: Sz): I32
    ensure()
    two: = state.split_input(len)
    if !two.found
        return 0
    return 1 if ed.set_remark(two.tail, two.head) else 0

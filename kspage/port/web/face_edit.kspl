//< The entry points that change a style's contents
//< **A style crosses as its saved text** (`kspage/share/store.kspl`): one entry point writes it
//< out, one reads it back and puts it in place. So the page edits the same shape a document saves,
//< and what is edited gets the checks a document read from a file gets. No state is kept here.
import "kspage/model/style"
import "kspage/port/web/state" + { doc_arena, ed, ensure, in_ptr, sheet }
import "kspage/share/store"
import "kspage/write/shape"

// Writes style `i` as its saved text (a JSON object) and returns the length; 0 when there is no
// style `i`. **A field left out is unset or holds its default**, as in a saved document.
#export
fn kspage_web_style_text(i: Sz): Sz
    ensure()
    state.out.clear()
    if state.has_style(i)
        store.style_text(sheet.styles.get(i), state.out)
    return state.out.len

// Replaces style `i` with the `len` bytes in the loading arena, read as a saved style is; 1 if
// replaced, 0 where there is no style `i` or the text is refused. **A field left out is unset or
// holds its default**, so the page passes back the whole style it read, changed where it changes.
// **The name is kept** (`style.put_face`), and the change is one undo step.
// Caution: **Use the loading arena** — a style's text is longer than the typing arena holds.
#export
fn kspage_web_set_style_text(i: Sz, len: Sz): I32
    ensure()
    if !state.has_style(i) || in_ptr == null || len <= 0
        return 0
    // Caution: **Read it into the document's arena**: the style's texts point into what is
    // parsed, and the undo record keeps them as long as the document.
    src: = U8[]::{ .ptr = in_ptr, .len = len }
    fresh: = store.style_from_text(src, doc_arena) catch
        return 0
    ed.set_look(sheet.styles.get(i), fresh)
    return 1

// Adds one style named by the `len` bytes in the typing arena and returns its index. **Where the
// name exists, it returns that index**, since a second style of the name could never be looked up.
// Caution: **Return the reason as a number** below 0: -1 "no name", **-2 "the name holds
// whitespace"**. With one number, the screen asks for a name that was already typed.
#export
fn kspage_web_add_style(len: Sz): Sz
    ensure()
    if name: = state.typed_nonempty(len)
        if !style.name_plain(name)
            return -2
        if made: = ed.add_style(sheet, name, .flow)
            for $i: Sz = 0; i < sheet.styles.len; i += 1
                if sheet.styles.get(i) == made
                    return i
    return -1

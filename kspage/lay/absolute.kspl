//< Laying out at absolute coordinates
//< One of the three layout strategies (shared the same way as `grid.kspl`); a frame's contents
//< use the flow layout. A presentation slide is this: a slide's size is set, and a frame's
//< position is its own `frame`, not the elements before and after.
//< **The entry point is not here but `lay/flow.kspl`** (it calls here for `Arrange.absolute`).
import "kspage/lay/flow"
import "kspage/lay/page" { Framed, Page, Surface }
import "kspage/model/doc" { Block, Rect }
import "kspage/model/style" { Look, Sheet }
import "std/mem" { Arena }

priv fn shown(sheet: Sheet$@, child: Block$@): Bool //<
    //< Whether that frame is shown at the current step
    //< **Where no step is selected it is always shown.**
    if upto: = sheet.over.reveal
        return child.step <= upto
    return true

fn place_surface(dst: Page$@, slide: Block$@, sheet: Sheet$@, at: Rect, width: F32, height: F32,
    look: Look, arena: Arena$@): F32 //<
        //< Lays out one slide of `width` × `height` from `at`'s upper left
        //< It adds what was laid out to dst. **The height returned is `height`, not the contents'**
        //< (it does not stretch for something sticking out). **`at.h` is ignored**; the style sets
        //< the size (`Style.width` / `Style.height`). **A width of 0 means "not set"**: the
        //< container's width.
    wide: = width if width > 0.0 else at.w
    // Caution: **Keep the slide itself first**, or a slide inside a frame comes before it and the
    // slides are out of document order.
    spot: = Rect::{ .x = at.x, .y = at.y, .w = wide, .h = height }
    surface: = arena.create(Surface::{ .rect = spot, .block = slide })
    dst.surfaces.push(surface)
    for $i: Sz = 0; i < slide.children.len; i += 1
        child: = slide.children.get(i)
        // Where a step is selected, a frame not yet shown is not laid out.
        // Caution: **Filter it in the layout.** Hidden only by the drawing code, a hidden frame's
        // text could still be selected and searched.
        if !shown(sheet, child)
            continue
        place_one(dst, surface, child, sheet, look, arena)
    return height

priv fn place_one(dst: Page$@, holder: Surface$@, child: Block$@, sheet: Sheet$@, look: Look,
    arena: Arena$@) //<
        //< Lays out one frame from the upper left of its container
        //< The container's own position is known only once it is laid out. **A child with no
        //< position is laid over the whole container**; dropped, what was written would silently
        //< vanish.
    spot: = holder.rect
    $put: Rect = spot
    if f: = child.frame
        put = Rect::{ .x = spot.x + f.x, .y = spot.y + f.y, .w = f.w, .h = f.h }
    // Caution: **Keep it before the contents**, or the innermost frame could not be found by
    // searching from the end (the same as `Page.cells`).
    dst.frames
        .push(arena.create(Framed::{ .rect = put, .block = child, .surface = holder }))
    // **Pass the frame's bottom**, so the fill and the line cover the frame, not the contents.
    // Without it, a figure with no contents gets height 0 and vanishes.
    flow.place_framed_block(dst, child, sheet, put, look, put.y + put.h, arena)

fn hang_framed(dst: Page$@, b: Block$@, sheet: Sheet$@, box: Rect, look: Look, arena: Arena$@) //<
    //< Lays out the positioned children of a block in the flow, from that block's upper left
    //< Caution: **Do not put them into the flow**: inserted between the lines, a figure would move
    //< the text. **Call it after the contents are laid out**, so a figure appears over the text.
    //< **Where it has no children, drop the container** (otherwise a click has more to search).
    $any: = false
    for $i: Sz = 0; i < b.children.len; i += 1
        if _f: = b.children.get(i).frame
            any = true
    if !any
        return
    // Caution: **Do not add it to the list** that clicks are searched against; it serves only as
    // the source of a frame's position (`Framed.surface`).
    holder: = arena.create(Surface::{ .rect = box, .block = b })
    for $i: Sz = 0; i < b.children.len; i += 1
        child: = b.children.get(i)
        if _f: = child.frame
            place_one(dst, holder, child, sheet, look, arena)

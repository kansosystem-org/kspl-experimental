//< The entry points the round-trip gate calls
//<
//< They are called by `tests/suite/textrip_test.kspl`.
//< **All they do is "one round trip the way a person opens a file".**
//< Caution: **Do not add an entry point beyond these two.** Kept here, the inside of `kspage/`
//< stays unmarked (`pub` is only a contract with outside the unit, ksplc.cfg's [I0402]).
import "kspage/share/text"
import "kspage/tests/base"
import "std/mem" { Arena }
import "std/str" { Str_builder }

pub fn is_texty(src: U8[]): Bool //< whether that text can be opened as a text form
    //<
    //< What cannot be opened is not round-tripped.
    return text.texty(src)

pub fn text_trip(src: U8[], out: Str_builder$@, arena: Arena$@) //< round-trips the text form once
    //<
    //< Caution: **Use the same table as when a person opens it** (`text.sheet_for`).
    sheet: = text.sheet_for(base.root_font(), "", arena)
    text.write(text.read(src, sheet, arena), out)

//< kspage's tests, run as a program of their own (`make test` in this package's folder)
//<
//< **This is the only way kspage's tests run on their own.** `all.kspl` holds them; this file
//< gives them a `main`.
import "kspage/tests/all"
import "std/io"
import "std/verdict"

fn main(): I32
    // Line by line, so a run that dies shows how far it got.
    io.set_line_buffered()
    all.run_kspage()
    return verdict.finish()

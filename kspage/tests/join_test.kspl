//< kspage: splitting, joining and deleting across paragraphs, and splitting into pages
import "kspage/lay/caret"
import "kspage/lay/chrome"
import "kspage/lay/flow"
import "kspage/lay/page" { Page }
import "kspage/model/doc" { Chrome, Doc }
import "kspage/model/fixed_font" as fixed
import "kspage/model/paint"
import "kspage/model/style" { Sheet }
import "kspage/tests/base"
import "kspage/write/block"
import "kspage/write/edit"
import "kspage/write/typing"
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

// ==========================================
// kspage: checks splitting, joining and deleting across paragraphs (a golden test).
// **The metrics are fixed (`kspage/model/fixed_font`)**: ASCII 8px, a Japanese character 16px, a
// line 19.2px.
// ==========================================

fn test_a_paragraph_splits_at_the_caret(arena: Arena$@) //< splits a paragraph in two
    //<
    //< **The cursor moves to the second paragraph** (typing can continue right away).
    verdict.start("[kspage/shape] a paragraph splitting at the cursor test...")
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("abcd")
    sheet: = Sheet.new(base.root_font(), arena)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, 2)
    assert(ed.split_block(page, sheet), "it splits")
    assert(d.blocks.len == 2, "the paragraphs become two")
    assert(d.blocks.get(0).inlines.get(0).text().equals("ab"), "the front runs to the break")
    assert(d.blocks.get(1).inlines.get(0).text().equals("cd"), "the back runs from the break")
    tail: = d.blocks.get(1).inlines.get(0)
    assert(ed.caret.inline == tail && ed.caret.offset == 0,
        "the cursor is at the back paragraph's head")
    verdict.pass("a paragraph splits in two at the cursor.")

fn test_a_style_names_what_follows_it(arena: Arena$@) //<
    //< Enter at a heading's end continues in the style the heading names
    verdict.start("[kspage/shape] the style a paragraph ended goes on in test...")
    sheet: = Sheet.new(base.root_font(), arena)
    head: = sheet.add("heading", paint.inherit_all())
    head.outline = 1
    head.next = "body"
    sheet.add("body", paint.inherit_all())

    d: = Doc.new(arena)
    n: = d.add_block("heading").add_text("Title")
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, n.text().len)
    assert(ed.split_block(page, sheet), "it splits")
    // **If the style were copied, the outline and the contents would each gain an empty entry.**
    assert(d.blocks.get(1).style.equals("body"), "the paragraph made goes on in the style named")
    assert(d.blocks.get(0).style.equals("heading"), "and the heading is left as it was")

    // Split partway, the halves are one paragraph cut in two.
    mid: = d.blocks.get(0).inlines.get(0)
    ed.caret = caret.at(mid, 2)
    page2: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    assert(ed.split_block(page2, sheet), "it splits in the middle too")
    assert(d.blocks.get(1).style.equals("heading"), "split part way along, the style is kept")
    verdict.pass("a style names what follows it, and it acts at the paragraph's end alone.")

fn test_a_style_naming_none_is_copied_as_before(arena: Arena$@) //<
    //< A style that names nothing continues in itself
    verdict.start("[kspage/shape] a style naming none being copied test...")
    sheet: = Sheet.new(base.root_font(), arena)
    sheet.add("body", paint.inherit_all())
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("ab")
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, n.text().len)
    assert(ed.split_block(page, sheet), "it splits")
    assert(d.blocks.get(1).style.equals("body"), "the same style again")
    verdict.pass("a style naming nothing goes on in itself.")

fn test_splitting_at_an_edge_leaves_both_paragraphs_usable(arena: Arena$@) //<
    //< Split at an edge, each paragraph still keeps one text
    //<
    //< Otherwise the cursor could not stand there.
    verdict.start("[kspage/shape] both paragraphs being usable even split at an edge test...")
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("ab")
    sheet: = Sheet.new(base.root_font(), arena)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, 2)
    assert(ed.split_block(page, sheet), "it splits at the end too")
    assert(d.blocks.get(1).inlines.len == 1, "the back paragraph holds one text too")
    assert(d.blocks.get(1).inlines.get(0).text().len == 0, "that text is empty")

    // Split at the start, the text goes to the second paragraph and the first is left empty.
    ed.caret = caret.at(d.blocks.get(0).inlines.get(0), 0)
    page2: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    assert(ed.split_block(page2, sheet), "it splits at the head too")
    assert(d.blocks.get(0).inlines.len == 1, "the front paragraph holds one text too")
    assert(d.blocks.get(0).inlines.get(0).text().len == 0, "that text is empty")
    assert(d.blocks.get(1).inlines.get(0).text().equals("ab"),
        "the text moves to the back paragraph")
    verdict.pass("split at an edge, one text is left in each paragraph.")

priv fn press_backspace(ed: edit.Editor$@, page: Page$@) //<
    //< Joins paragraphs, and falls back to Backspace where it could not join
    //<
    //< Caution: **Call them in the same order as the page does** (`kspage_web_backspace` in
    //< `kspage/port/web/bridge`).
    if ed.join_prev(page)
        return
    ed.backspace()

fn test_backspace_at_a_cell_head_leaves_the_cell_before_it(arena: Arena$@) //<
    //< Backspace at a cell's start takes no text from the cell before it
    //<
    //< Where it cannot join (a cell, a container's first child), doing nothing is right. Deleting
    //< across the break would take a character from a text not visible from the clicked place.
    verdict
        .start("[kspage/edit] a Backspace at a cell's head not shrinking the cell in front test...")
    d: = Doc.new(arena)
    sheet: = Sheet.new(base.root_font(), arena)
    base.table_style(sheet)
    table: = d.add_block("table")
    row: = table.add_child("")
    head: = row.add_child("").add_text("あ")
    next: = row.add_child("").add_text("い")
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(next, 0)
    press_backspace(ed, page)
    assert(head.text().equals("あ"), "the cell in front does not shrink")
    assert(next.text().equals("い"), "the cell one is in does not change either")
    verdict.pass("at a cell's head the cell in front is not deleted.")

fn test_backspace_at_the_first_child_leaves_the_paragraph_before_it(arena: Arena$@) //<
    //< Backspace at a container's first child's start takes no text from the paragraph before it
    //<
    //< A list's first item is one (what it would join onto is not in its list).
    verdict
        .start("[kspage/edit] a Backspace at the first child not shrinking the paragraph in front \
            test...")
    d: = Doc.new(arena)
    sheet: = Sheet.new(base.root_font(), arena)
    item: = sheet.add("item", paint.inherit_all())
    item.marker = .bullet("• ")
    ahead: = d.add_block("body").add_text("before.")
    first: = d.add_block("body").add_child("item").add_text("item")
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(first, 0)
    press_backspace(ed, page)
    assert(ahead.text().equals("before."), "the paragraph in front does not shrink")
    assert(first.text().equals("item"), "the item's text does not change either")
    verdict.pass("at the first child's head the paragraph in front is not deleted.")

fn test_a_paragraph_joins_the_previous_one(arena: Arena$@) //<
    //< Joined at a paragraph's start, it goes onto the end of the paragraph before
    verdict.start("[kspage/shape] a paragraph joining onto the one in front test...")
    d: = Doc.new(arena)
    head: = d.add_block("body").add_text("ab")
    tail: = d.add_block("body").add_text("cd")
    page: = flow.layout(d, Sheet.new(base.root_font(), arena), fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(tail, 0)
    assert(ed.join_prev(page), "it joins")
    assert(d.blocks.len == 1, "the paragraphs become one")
    // Inlines with the same style are merged; else splitting and joining would multiply them.
    assert(d.blocks.get(0).inlines.len == 1, "the texts are brought together too")
    assert(head.text().equals("abcd"), "the text behind goes onto the front one's end")
    assert(ed.caret.inline == head && ed.caret.offset == 2, "the cursor stands at the joint")
    verdict.pass("joined at a paragraph's head it goes onto the end of the paragraph in front.")

fn test_joining_needs_the_start_of_a_paragraph(arena: Arena$@) //<
    //< anywhere but the start it does not join
    //<
    //< Joined, what is before the clicked place would move.
    verdict.start("[kspage/shape] not joining unless at the head test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("ab")
    tail: = d.add_block("body").add_text("cd")
    page: = flow.layout(d, Sheet.new(base.root_font(), arena), fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(tail, 1)
    assert(!ed.join_prev(page), "mid-text it does not join")
    // The very first paragraph has nothing to join onto.
    ed.caret = caret.at(d.blocks.get(0).inlines.get(0), 0)
    assert(!ed.join_prev(page), "with nothing in front it does not join")
    assert(d.blocks.len == 2, "the paragraphs stay two")
    verdict.pass("it joins at a paragraph's head, and only where a paragraph in front is there.")

fn test_splitting_then_joining_restores_the_paragraph(arena: Arena$@) //<
    //< Split and then joined, it comes back as it was
    //<
    //< Going back gives the same result (one undo of the split).
    verdict.start("[kspage/shape] splitting and joining coming back as it was test...")
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("abcd")
    sheet: = Sheet.new(base.root_font(), arena)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, 2)
    assert(ed.split_block(page, sheet), "it splits")
    page2: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    assert(ed.join_prev(page2), "it joins")
    assert(d.blocks.len == 1, "the paragraphs go back to one")
    assert(d.blocks.get(0).inlines.get(0).text().equals("abcd"), "the text is as it was too")

    ed.caret = caret.at(d.blocks.get(0).inlines.get(0), 2)
    assert(ed.split_block(page2, sheet), "it can be split again")
    assert(ed.undo(), "it can be put back")
    assert(d.blocks.len == 1, "one step puts the paragraphs back to one")
    assert(d.blocks.get(0).inlines.get(0).text().equals("abcd"), "the text comes back too")
    verdict.pass("split and joined it comes back as it was, and the way back gives the same shape.")

// ---- deleting a selection including whole paragraphs ----

priv fn three_items(d: Doc$@, arena: Arena$@): Page$@ //<
    //< A document of three list items in a row, and its layout
    sheet: = Sheet.new(base.root_font(), arena)
    sheet.add("item", paint.inherit_all()).marker = .bullet("• ")
    d.add_block("item").add_text("abc")
    d.add_block("item").add_text("def")
    d.add_block("item").add_text("ghi")
    return flow.layout(d, sheet, fixed.make(), 200.0, arena)

fn test_deleting_across_paragraphs_joins_them(arena: Arena$@) //<
    //< Deleted across paragraphs, the spanned paragraphs join into one
    //<
    //< **Not joined, the emptied paragraph's marker (a bullet's "•") would be left.**
    verdict.start("[kspage/shape] the paragraphs joining when it is deleted across them test...")
    d: = Doc.new(arena)
    page: = three_items(d, arena)
    head: = d.blocks.get(0).inlines.get(0)
    last: = d.blocks.get(2).inlines.get(0)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(head, 1)
    ed.caret.anchor = last
    ed.caret.anchor_offset = 2
    assert(ed.delete_span(page), "it is deleted")
    assert(d.blocks.len == 1, "the paragraphs become one")
    assert(d.blocks.get(0).inlines.get(0).text().equals("ai"), "the edges join to each other")
    assert(ed.caret.inline == head && ed.caret.offset == 1, "the cursor stands at the joint")
    verdict.pass("deleted across paragraphs, the paragraphs crossed join into one.")

fn test_undoing_a_joined_delete_restores_every_paragraph(arena: Arena$@) //<
    //< Deleting and joining are one undo
    //<
    //< Split into two, one undo would leave the paragraph still split.
    verdict.start("[kspage/shape] the deleting and joining going back in one test...")
    d: = Doc.new(arena)
    page: = three_items(d, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(d.blocks.get(0).inlines.get(0), 1)
    ed.caret.anchor = d.blocks.get(2).inlines.get(0)
    ed.caret.anchor_offset = 2
    assert(ed.delete_span(page), "it is deleted")
    assert(ed.undo(), "it can be put back")
    assert(d.blocks.len == 3, "the paragraphs go back to three")
    assert(d.blocks.get(0).inlines.get(0).text().equals("abc"), "the first text comes back")
    assert(d.blocks.get(1).inlines.get(0).text().equals("def"), "the second text comes back")
    assert(d.blocks.get(2).inlines.get(0).text().equals("ghi"), "the third text comes back")
    assert(!ed.undo(), "there is one step to go back by and no more")
    verdict.pass("what was deleted and joined comes back in one undo.")

fn test_deleting_across_cells_keeps_the_table(arena: Arena$@) //<
    //< Where it spans table cells, only the contents are deleted
    //<
    //< Joined, the cell would disappear and the table would break.
    verdict.start("[kspage/shape] the table not falling apart even across cells test...")
    d: = Doc.new(arena)
    sheet: = Sheet.new(base.root_font(), arena)
    base.table_style(sheet)
    table: = d.add_block("table")
    row: = table.add_child("row")
    a: = row.add_child("cell").add_text("ab")
    b: = row.add_child("cell").add_text("cd")
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(a, 1)
    ed.caret.anchor = b
    ed.caret.anchor_offset = 1
    assert(ed.delete_span(page), "it is deleted")
    assert(table.children.get(0).children.len == 2, "the cells stay two")
    assert(a.text().equals("a"), "the cell in front loses what was selected")
    assert(b.text().equals("d"), "the cell behind loses what was selected too")
    verdict.pass("deleted across cells, no cell goes.")

fn test_delete_takes_the_next_character_then_the_break(arena: Arena$@) //<
    //< Delete removes the one character after the cursor
    //<
    //< At a paragraph's end it joins the next paragraph.
    verdict
        .start("[kspage/shape] Delete deleting the next character and a paragraph's break test...")
    d: = Doc.new(arena)
    sheet: = Sheet.new(base.root_font(), arena)
    head: = d.add_block("body").add_text("あい")
    d.add_block("body").add_text("cd")
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(head, 0)
    // **The three-byte characters are deliberate**: deleting one byte alone breaks the text, so
    // this pins that a whole character is removed.
    assert(ed.delete_ahead(page), "the next character is deleted")
    assert(head.text().equals("い"), "it deletes to the character's boundary")

    ed.caret = caret.at(head, head.text().len)
    page2: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    assert(ed.delete_ahead(page2), "it deletes at a paragraph's end too")
    assert(d.blocks.len == 1, "the next paragraph joins")
    assert(head.text().equals("いcd"), "the next paragraph's text goes onto the end")
    assert(ed.caret.inline == head && ed.caret.offset == 3, "the cursor stays at the joint")

    page3: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed.caret = caret.at(head, head.text().len)
    assert(!ed.delete_ahead(page3), "at the document's end nothing is deleted")
    verdict
        .pass("Delete deletes the next character, and at a paragraph's end joins the next \
            paragraph.")

fn test_joining_stops_at_a_table(arena: Arena$@) //<
    //< a paragraph holding a table or a slide is not joined
    //<
    //< Joined, it would move its children too, with nothing to decide whose children come first.
    verdict.start("[kspage/shape] the joining stopping at a table test...")
    d: = Doc.new(arena)
    sheet: = Sheet.new(base.root_font(), arena)
    base.table_style(sheet)
    head: = d.add_block("body").add_text("ab")
    table: = d.add_block("table")
    table.add_child("row").add_child("cell").add_text("x")
    tail: = d.add_block("body").add_text("cd")
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(head, 1)
    ed.caret.anchor = tail
    ed.caret.anchor_offset = 1
    assert(ed.delete_span(page), "it is deleted")
    assert(d.blocks.len == 3, "the paragraphs stay three")
    assert(head.text().equals("a"), "what was selected is deleted")
    assert(tail.text().equals("d"), "the paragraph behind loses what was selected too")
    verdict.pass("where a table is held it does not join, and the contents alone are deleted.")
// ---- deleting a whole container ----

priv fn head_table_image(d: Doc$@, arena: Arena$@): Page$@ //<
    //< A document with one table and one picture, and its layout
    sheet: = Sheet.new(base.root_font(), arena)
    base.table_style(sheet)
    d.add_block("body").add_text("ab")
    table: = d.add_block("table")
    table.add_child("row").add_child("cell").add_text("x")
    pic: = d.add_block("")
    pic.image = "picture.png"
    pic.image_w = 40.0
    pic.image_h = 20.0
    pic.add_text("")
    d.add_block("body").add_text("cd")
    return flow.layout(d, sheet, fixed.make(), 200.0, arena)

fn test_a_table_is_dropped_whole_from_inside_a_cell(arena: Arena$@) //<
    //< Deletes the whole table from inside a cell
    //<
    //< **The cursor moves to after the removed place.** Typing on while it points at a deleted
    //< text would make text that is nowhere in the document.
    verdict.start("[kspage/shape] a table being deletable whole from inside a cell test...")
    d: = Doc.new(arena)
    page: = head_table_image(d, arena)
    cell: = d.blocks.get(1).children.get(0).children.get(0).inlines.get(0)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(cell, 0)
    assert(ed.drop_holder(page), "it is deleted")
    assert(d.blocks.len == 3, "the table itself comes off the row")
    assert(d.blocks.get(0).inlines.get(0).text().equals("ab"), "the paragraph in front is left")
    after: = d.blocks.get(1).inlines.get(0)
    assert(ed.caret.inline == after, "the cursor stands behind the place taken off")
    assert(ed.undo(), "it can be put back in one")
    assert(d.blocks.len == 4, "the table comes back")
    verdict.pass("a table can be deleted whole from inside a cell.")

fn test_a_picture_is_dropped_but_a_paragraph_is_not(arena: Arena$@) //<
    //< a picture is a container too
    //<
    //< An ordinary paragraph is not a container, so it is not removed this way.
    verdict.start("[kspage/shape] the picture going and the paragraph not test...")
    d: = Doc.new(arena)
    page: = head_table_image(d, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(d.blocks.get(2).inlines.get(0), 0)
    assert(ed.drop_holder(page), "the picture goes")
    assert(d.blocks.len == 3, "the picture's block comes off the row")

    page2: = flow.layout(d, Sheet.new(base.root_font(), arena), fixed.make(), 200.0, arena)
    ed.caret = caret.at(d.blocks.get(0).inlines.get(0), 0)
    assert(!ed.drop_holder(page2), "an ordinary paragraph does not go")
    assert(d.blocks.len == 3, "the row does not change either")
    verdict.pass("a holder goes whole, and an ordinary paragraph does not.")

fn test_joining_stops_at_a_picture(arena: Arena$@) //<
    //< a picture's block is not joined as a paragraph
    //<
    //< Joined, another paragraph's text would land where the picture is.
    verdict.start("[kspage/shape] the joining stopping at a picture test...")
    d: = Doc.new(arena)
    page: = head_table_image(d, arena)
    pic: = d.blocks.get(2).inlines.get(0)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(pic, 0)
    assert(!ed.delete_ahead(page), "at a picture it does not join the next paragraph")
    assert(d.blocks.len == 4, "the row stays four")
    verdict.pass("at a picture no paragraph is joined.")

// ==========================================
// kspage: checks the code that splits a document into pages, pinned by value (a golden test).
// **The metrics are fixed (`kspage/model/fixed_font`).**
// **The fixture texts are one-em characters (16px) on purpose**, so the arithmetic is exact and a
// wrap can fall between any two characters. It does not split mid-line, mid-table-row or
// mid-slide, and a block that fits on a page moves whole to the next page.
// ==========================================

priv fn paper(lines: Sz, arena: Arena$@): Sheet$@ //< one line is 19.2px
    //<
    //< A page `lines` lines tall.
    sheet: = Sheet.new(base.root_font(), arena)
    sheet.paper.height = 19.2 * F32::lines
    return sheet

fn test_without_a_page_height_nothing_is_split(arena: Arena$@) //<
    //< A document with no page height is one continuous run
    verdict.start("[kspage/print] with no page height test...")
    d: = Doc.new(arena)
    // A width of 32px = two characters. Six characters, so three lines.
    d.add_block("body").add_text("あいうえおか")

    page: = flow.layout(d, Sheet.new(base.root_font(), arena), fixed.make(), 32.0, arena)
    assert(page.boxes.len == 3, "it breaks into three rows")
    assert(base.near(page.boxes.get(2).rect.y, 38.4), "the third row is two rows lower down")
    verdict.pass("write no page height and it is one run, unsplit.")

fn test_a_line_is_never_split_across_papers(arena: Arena$@) //< it does not split mid-line
    //<
    //< A line that does not fit starts whole at the top of the next page.
    verdict.start("[kspage/print] not splitting mid-row test...")
    d: = Doc.new(arena)
    // Three paragraphs of two lines, so moving whole and splitting can be told apart.
    for $i: Sz = 0; i < 3; i += 1
        d.add_block("body").add_text("あいうえ")
    // The page is two lines tall; the first paragraph fills one page.
    page: = flow.layout(d, paper(2, arena), fixed.make(), 32.0, arena)
    assert(page.boxes.len == 6, "there are six rows")
    assert(base.near(page.boxes.get(2).rect.y, 38.4),
        "the second paragraph starts from the second sheet's head")
    assert(base.near(page.boxes.get(4).rect.y, 76.8), "the third is from the third sheet's head")
    verdict.pass("a row does not cross a page, and starts from the next page's head.")

fn test_a_block_that_fits_moves_whole(arena: Arena$@) //< a block that fits on a page moves whole
    //<
    //< Split to leave one line alone, the reader could not follow the paragraph.
    verdict.start("[kspage/print] sending a lump that fits over whole test...")
    d: = Doc.new(arena)
    // A paragraph of one line and a paragraph of two. The page is two lines tall.
    d.add_block("body").add_text("あい")
    d.add_block("body").add_text("うえおか")

    page: = flow.layout(d, paper(2, arena), fixed.make(), 32.0, arena)
    assert(page.boxes.len == 3, "there are three rows")
    assert(base.near(page.boxes.get(0).rect.y, 0.0),
        "the first paragraph is at the first sheet's head")
    // Split, one line would fit in the first page's second line; moved whole, it starts page two.
    assert(base.near(page.boxes.get(1).rect.y, 38.4),
        "the second paragraph is sent whole to the second sheet")
    assert(base.near(page.boxes.get(2).rect.y, 57.6), "what carries on from it is on the same page")
    verdict.pass("a lump that fits a page is sent whole to the next page, unsplit.")

fn test_a_block_taller_than_a_paper_is_not_moved(arena: Arena$@) //<
    //< A block that does not fit on one page is not moved
    //<
    //< Moved, it would not fit either, and would only waste the rest of the page.
    verdict.start("[kspage/print] a lump that does not fit one sheet test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("あい")
    // A paragraph of four lines on a page of two, so it fits nowhere it could move.
    d.add_block("body").add_text("うえおかきくけこ")

    page: = flow.layout(d, paper(2, arena), fixed.make(), 32.0, arena)
    // After the one-line paragraph it continues right from the second line.
    assert(base.near(page.boxes.get(1).rect.y, 19.2), "it lays on from the row left over")
    // From there on it splits line by line.
    assert(base.near(page.boxes.get(2).rect.y, 38.4),
        "a row crossing a page is from the next page's head")
    verdict
        .pass("a lump that does not fit one sheet is not sent, and is split at the grain of a row.")

fn test_a_table_row_is_never_split(arena: Arena$@) //< it does not split mid-table-row
    //<
    //< Where a row crosses a page once laid out, it is laid out again.
    verdict.start("[kspage/print] a table's row not splitting test...")
    d: = Doc.new(arena)
    sheet: = paper(3, arena)
    base.table_style(sheet)
    table: = d.add_block("table")
    // Two table rows of two lines each, on a page of three.
    for $r: Sz = 0; r < 2; r += 1
        row: = table.add_child("")
        row.add_child("").add_text("あいうえ")

    page: = flow.layout(d, sheet, fixed.make(), 32.0, arena)
    assert(page.cells.len == 2, "the cells are two")
    assert(base.near(page.cells.get(0).rect.y, 0.0), "the first row is at the first sheet's head")
    // A row is not split, so the second goes to the top of the second page.
    assert(base.near(page.cells.get(1).rect.y, 57.6),
        "the second row starts from the second sheet's head")
    assert(base.near(page.cells.get(1).rect.h, 38.4), "the height stays two rows")
    verdict.pass("a table's row does not cross a page, and is sent whole to the next page.")

fn test_a_moved_block_leaves_no_panel_behind(arena: Arena$@) //<
    //< A moved block's band is laid out again with it; left behind, the fill would be stranded
    verdict.start("[kspage/print] the band of a lump sent over not being left test...")
    d: = Doc.new(arena)
    sheet: = paper(2, arena)
    sheet.add("lit", paint.inherit_all()).fill = .some(0xeeeeeeU32)
    d.add_block("body").add_text("あい")
    d.add_block("lit").add_text("うえおか")

    page: = flow.layout(d, sheet, fixed.make(), 32.0, arena)
    assert(page.panels.len == 1, "there is one band and no more")
    assert(base.near(page.panels.get(0).rect.y, 38.4),
        "the band starts from the second sheet's head too")
    verdict.pass("the band of a lump sent over is not left on the page it came from.")

fn test_margins_narrow_the_column_and_the_band(arena: Arena$@) //<
    //< The margin narrows the column, and also lowers the height that fits on one page
    verdict.start("[kspage/print] the margin narrowing the column and the page's contents test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("あいうえおかきく")
    sheet: = Sheet.new(base.root_font(), arena)
    // The page is 64px wide and four lines tall; 16px margins each side leave 32px = two
    // characters.
    sheet.paper.width = 64.0
    sheet.paper.height = 76.8
    sheet.paper.left = 16.0
    sheet.paper.right = 16.0
    sheet.paper.top = 19.2
    sheet.paper.bottom = 19.2

    // **The container's width (300) is ignored** where the paper's width is set.
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(page.boxes.len == 4, "the column is two characters wide, so it breaks into four rows")
    assert(base.near(page.boxes.get(0).rect.w, 32.0), "the column is the width less the margin")
    // What fits on a page is 4 lines minus one line above and below = two lines.
    assert(base.near(sheet.column_height(), 38.4), "what fits a page is the height less the margin")
    assert(base.near(page.boxes.get(2).rect.y, 38.4),
        "the third row starts from the second sheet's head")
    verdict.pass("the margin narrows the column, and lowers the height that fits one page.")

fn test_the_reading_width_stops_and_centers_the_column(arena: Arena$@) //<
    //< The body's width limits the column there, and splits the rest evenly left and right
    //<
    //< **It has no effect where the paper's width is set**, or two settings would decide a line's
    //< length.
    verdict.start("[kspage/print] stopping the column at the body's width test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("あいうえおかきく")
    sheet: = Sheet.new(base.root_font(), arena)
    // Limited to two characters (32px); unlimited, the 300px container would fit one line.
    sheet.paper.reading = 32.0
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(page.boxes.len == 4, "it wraps at the width it was stopped at")
    assert(base.near(page.boxes.get(0).rect.w, 32.0), "the column is the width it was stopped at")
    // Half of the 268px left over. Left-aligned, the body would stick to one side of a wide window.
    assert(base.near(page.boxes.get(0).rect.x, 134.0), "the rest is parted evenly left and right")
    assert(base.near(sheet.column_left(300.0), 134.0),
        "the column's left edge is worked out from the same place")
    // **In a container narrower than the limit, it is not moved inward** (it would lose width).
    assert(base.near(sheet.column_width(20.0), 20.0), "in a narrow holder it is the holder's width")
    assert(base.near(sheet.column_left(20.0), 0.0), "then it is not moved in")
    // **It limits after the margins are removed**, so the field matches the width the eye sees.
    sheet.paper.left = 50.0
    sheet.paper.right = 50.0
    padded: = sheet.column_width(300.0)
    assert(base.near(padded, 32.0),
        "with a margin there, the body's width is still the number written")
    assert(base.near(sheet.column_left(300.0), 84.0),
        "the rest is parted from what is left after the margin")
    // Set the paper's width and the body's width has no effect.
    sheet.paper.width = 164.0
    papered: = sheet.column_width(300.0)
    assert(base.near(papered, 64.0), "set the paper's width and it is the width less the margin")
    from: = sheet.column_left(300.0)
    assert(base.near(from, 0.0),
        "then it is not moved in (taking off the margin is left to the printer)")
    verdict.pass("the body's width stops the column and parts the rest evenly left and right.")

fn test_margins_taller_than_the_paper_stop_the_split(arena: Arena$@) //<
    //< Where the margins alone fill the page it does not split
    //<
    //< Moved, it would never fit, and it would loop forever.
    verdict.start("[kspage/print] where the margin fills the page test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("あいうえおか")
    sheet: = Sheet.new(base.root_font(), arena)
    sheet.paper.height = 19.2
    sheet.paper.top = 19.2
    sheet.paper.bottom = 19.2

    assert(base.near(sheet.column_height(), 0.0), "there are no contents that fit a page")
    page: = flow.layout(d, sheet, fixed.make(), 32.0, arena)
    assert(base.near(page.boxes.get(2).rect.y, 38.4), "it stacks in one run, unsplit")
    verdict.pass("where the margin alone fills the page it does not split.")

fn test_a_surface_is_never_split(arena: Arena$@) //< a slide does not split
    //<
    //< Its size is known in advance, so where it does not fit it moves whole to the next page.
    verdict.start("[kspage/print] a slide not splitting test...")
    d: = Doc.new(arena)
    sheet: = paper(4, arena)
    s: = sheet.add("slide", paint.inherit_all())
    s.arrange = .absolute
    s.height = 48.0
    d.add_block("body").add_text("あい")
    slide: = d.add_block("slide")
    slide.add_child("").add_text("か")

    // The page is 76.8px. After one line (19.2px) a 48px slide fits, the next does not.
    page: = flow.layout(d, sheet, fixed.make(), 64.0, arena)
    assert(page.surfaces.len == 1, "there is one slide")
    assert(base.near(page.surfaces.get(0).rect.y, 19.2), "where it fits it is not sent over")

    slide2: = d.add_block("slide")
    slide2.add_child("").add_text("き")
    two: = flow.layout(d, sheet, fixed.make(), 64.0, arena)
    assert(two.surfaces.len == 2, "there are two slides")
    // The first slide spans 19.2 to 67.2; the second, from 67.2, does not fit.
    second: = two.surfaces.get(1).rect.y
    assert(base.near(second, 76.8), "a slide that does not fit is sent whole to the next page")
    verdict.pass("a slide does not split, and where it does not fit it is sent to the next page.")

priv fn band(d: Doc$@, which: Chrome, sheet: Sheet$@, no: Sz, of: Sz, arena: Arena$@): Page$@
    return chrome.layout_chrome(d, sheet, fixed.make(), which, no, of, arena)

priv fn bordered(arena: Arena$@): Sheet$@ //< a page with margins
    sheet: = Sheet.new(base.root_font(), arena)
    sheet.paper.width = 64.0
    sheet.paper.height = 76.8
    sheet.paper.left = 16.0
    sheet.paper.right = 16.0
    sheet.paper.top = 19.2
    sheet.paper.bottom = 19.2
    return sheet

fn test_the_page_marks_are_filled_when_the_band_is_placed(arena: Arena$@) //<
    //< The band's page mark is filled in at every layout
    //<
    //< **The document's text does not change** (it stays `{page}`).
    verdict.start("[kspage/print] the band's page mark test...")
    d: = Doc.new(arena)
    d.footer.inlines.get(0).insert(0, "{page}/{pages}")

    one: = band(d, .footer, bordered(arena), 2, 5, arena)
    assert(one.boxes.len == 1, "the band is one row")
    assert(one.boxes.get(0).text.equals("2/5"),
        "the mark becomes the page as it is now and the count of all the sheets")
    // Laid out for one more page, the document's text is still the mark.
    two: = band(d, .footer, bordered(arena), 3, 5, arena)
    assert(two.boxes.get(0).text.equals("3/5"), "on the next page the number alone changes")
    kept: = d.footer.inlines.get(0).text()
    assert(kept.equals("{page}/{pages}"), "the document's text is still the mark")
    verdict
        .pass("the band's mark is handed out every time it is laid, and the document's text does \
            not change.")

fn test_the_band_sits_inside_the_paper_margins(arena: Arena$@) //<
    //< the band sits inside the page's margin
    //<
    //< **The coordinates are from the page's top left.**
    verdict.start("[kspage/print] where the band lives test...")
    d: = Doc.new(arena)
    d.header.inlines.get(0).insert(0, "あい")
    d.footer.inlines.get(0).insert(0, "うえ")
    sheet: = bordered(arena)

    top: = band(d, .header, sheet, 1, 1, arena)
    assert(base.near(top.boxes.get(0).rect.x, 16.0), "the band's left is inside by the left margin")
    assert(base.near(top.boxes.get(0).rect.y, 0.0), "the header starts from the page's top edge")
    assert(base.near(top.boxes.get(0).rect.w, 32.0), "the band's width is the same as the column's")

    bottom: = band(d, .footer, sheet, 1, 1, arena)
    // The page is 76.8px and the bottom margin 19.2px, so it is below 57.6.
    assert(base.near(bottom.boxes.get(0).rect.y, 57.6),
        "the footer starts from the head of the bottom margin")
    verdict
        .pass("the band is laid inside the page's margin, with the page's top left as the origin.")

fn test_an_empty_band_places_nothing(arena: Arena$@) //< an empty band is not laid out
    //<
    //< Lay out an empty band at the page's edge and the margin looks narrower by that much.
    verdict.start("[kspage/print] an empty band test...")
    d: = Doc.new(arena)

    empty: = band(d, .header, bordered(arena), 1, 1, arena)
    assert(empty.boxes.len == 0, "empty, there is no box")
    // With no margin there is nowhere to put it, text or not.
    d.header.inlines.get(0).insert(0, "あい")
    flat: = Sheet.new(base.root_font(), arena)
    flat.paper.width = 64.0
    flat.paper.height = 76.8
    tight: = band(d, .header, flat, 1, 1, arena)
    assert(tight.boxes.len == 0, "with no margin it is not laid")
    // With no paper size set, neither the header nor the footer is laid out (they appear per page).
    loose: = Sheet.new(base.root_font(), arena)
    loose.paper.top = 19.2
    loose.paper.bottom = 19.2
    free: = band(d, .header, loose, 1, 1, arena)
    assert(free.boxes.len == 0, "with no page it is not laid")
    verdict
        .pass("on an empty band, a page with no margin, and a document with no page, no band is \
            laid.")
fn test_a_picture_is_never_split(arena: Arena$@) //< a picture does not split
    //<
    //< Its size is known in advance, so where it does not fit it moves whole to the next page.
    verdict.start("[kspage/print] a picture not splitting test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("あい")
    shot: = d.add_block("body")
    shot.image = "picture.png"
    shot.image_w = 32.0
    shot.image_h = 48.0

    // The page is 76.8px. After one line (19.2px) 48px fits, the second does not.
    page: = flow.layout(d, paper(4, arena), fixed.make(), 64.0, arena)
    assert(base.near(page.pictures.get(0).rect.y, 19.2), "where it fits it is not sent over")

    second: = d.add_block("body")
    second.image = "other.png"
    second.image_w = 32.0
    second.image_h = 48.0
    two: = flow.layout(d, paper(4, arena), fixed.make(), 64.0, arena)
    assert(two.pictures.len == 2, "there are two pictures")
    next_top: = two.pictures.get(1).rect.y
    assert(base.near(next_top, 76.8), "a picture that does not fit is sent whole to the next page")
    verdict.pass("a picture does not split, and where it does not fit it is sent to the next page.")

fn test_a_document_that_just_fits_is_one_paper(arena: Arena$@) //<
    //< A document that fits one page exactly is one page
    //<
    //< **Do not count the space after the last block** (`Page.height` includes it). 81.6px of
    //< contents on an 81.6px band would come out as **two** pages, the second blank.
    verdict.start("[kspage/print] the count of sheets of a document that fits exactly test...")
    d: = Doc.new(arena)
    for $i: Sz = 0; i < 3; i += 1
        d.add_block("body").add_text("\u3042\u3044")
    // Laid out without splitting first, to measure where the contents end.
    loose: = spaced(arena)
    one: = flow.layout(d, loose, fixed.make(), 320.0, arena)
    tail: = one.boxes.get(one.boxes.len - 1)
    bottom: = tail.rect.y + tail.rect.h
    assert(one.filled < one.height, "the height is larger by the space behind")
    assert(base.near(one.filled, bottom),
        "the height where the contents end is the last box's bottom edge")

    // Laid out onto paper of that height it is one page.
    fits: = spaced(arena)
    fits.paper.height = bottom
    page: = flow.layout(d, fits, fixed.make(), 320.0, arena)
    assert(flow.paper_count(page, fits.column_height()) == 1, "fitting exactly it is one sheet")
    // On paper one line shorter it is two pages (the partial page is not dropped).
    short: = spaced(arena)
    short.paper.height = bottom - F32::19.2
    two: = flow.layout(d, short, fixed.make(), 320.0, arena)
    assert(flow.paper_count(two, short.column_height()) == 2, "not fitting it is two sheets")
    verdict
        .pass("a document that fits exactly is one sheet, the space behind does not grow it, and \
            what does not fit is counted.")

fn test_a_zero_band_is_one_paper(arena: Arena$@) //<
    //< A band of 0 means no split, so the page count is 1 (nothing divides by 0)
    verdict.start("[kspage/print] one sheet where the band is 0 test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("abc")
    d.add_block("body").add_text("def")
    page: = flow.layout(d, spaced(arena), fixed.make(), 320.0, arena)
    assert(flow.paper_count(page, 0.0) == 1,
        "with the band at 0 it does not split, so it is one sheet")
    verdict.pass("a paper whose band is 0 does not split, and the count of sheets is 1.")

priv fn spaced(arena: Arena$@): Sheet$@ //< a table with one style that has space after
    //<
    //< **Without the space this fault does not show.**
    sheet: = Sheet.new(base.root_font(), arena)
    body: = sheet.add("body", paint.inherit_all())
    body.space_after = 12.0
    return sheet

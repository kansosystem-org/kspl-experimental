import "kspage/lay/ask"
import "kspage/lay/caret"
import "kspage/lay/flow"
import "kspage/model/doc" + { Block, Doc, Rect }
import "kspage/model/fixed_font" as fixed
import "kspage/model/paint"
import "kspage/model/style" { Sheet, Arrange, Shape }
import "kspage/tests/base"
import "kspage/write/block"
import "kspage/write/edit"
import "kspage/write/insert" + { Sketch }
import "kspage/write/shape"
import "kspage/write/typing"
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

// ==========================================
// kspage: checks absolute-coordinate layout (a presentation slide), pinned by value (a golden
// test).
// **The metrics are fixed (`kspage/model/fixed_font`).** The grid side is
// [`grid_test.kspls`](grid_test.kspls).
// **The two texts with multi-byte characters have them on purpose.**
// ==========================================

priv fn slide_sheet(name: U8[], arena: Arena$@): Sheet$@ //<
  //< A sheet where only the style `name` is a 240px-high slide placing each child on its own
  sheet: = Sheet.new(base.root_font(), arena)
  s: = sheet.add(name, paint.inherit_all())
  s.arrange = Arrange.absolute
  s.height = 240.0
  return sheet

fn test_frames_land_where_they_say()
  verdict.start("[kspage/absolute] a frame landing at the place it says test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  at1: = Rect::{ .x = 10.0, .y = 20.0, .w = 100.0, .h = 50.0 }
  at2: = Rect::{ .x = 200.0, .y = 150.0, .w = 100.0, .h = 50.0 }
  doc.add_framed_child(slide, "frame", at1).add_text("a")
  doc.add_framed_child(slide, "frame", at2).add_text("b")

  page: = flow.layout(d, slide_sheet("slide", arena), fixed.make(), 320.0, arena)
  assert(page.boxes.len == 2, "the frames are two")
  first: = page.boxes.get(0).rect
  second: = page.boxes.get(1).rect
  assert(base.near(first.x, 10.0) && base.near(first.y, 20.0), "the first is as it says")
  assert(base.near(second.x, 200.0) && base.near(second.y, 150.0), "the second is as it says too")
  // A slide's height does not depend on its contents.
  assert(base.near(page.height, 240.0), "the height is the slide's height the style says")
  verdict.pass("a frame's place is decided by its own frame, not by what comes before or behind.")

fn test_frame_contents_wrap_inside_the_frame() //< a frame's contents wrap at that frame's width
  verdict.start("[kspage/absolute] a frame's contents wrapping at the frame's width test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  at: = Rect::{ .x = 10.0, .y = 20.0, .w = 40.0, .h = 100.0 }
  doc.add_framed_child(slide, "frame", at).add_text("あいうえお")

  page: = flow.layout(d, slide_sheet("slide", arena), fixed.make(), 320.0, arena)
  assert(page.boxes.len == 3, "it breaks into three rows at the frame's width of 40px")
  assert(base.near(page.boxes.get(0).rect.y, 20.0), "the first row starts at the frame's top edge")
  assert(base.near(page.boxes.get(1).rect.y, 39.2), "the second row is one row lower")
  assert(base.near(page.boxes.get(1).rect.x, 10.0),
    "wrapped, it comes back to the frame's left edge")
  verdict.pass("a frame's contents wrap at the frame's width and line up on the frame's left edge.")

fn test_a_child_without_a_frame_fills_the_surface() //<
  //< A child with no position does not disappear, and is laid out over the whole slide
  verdict.start("[kspage/absolute] a child with no place not going away test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  slide.add_child("frame").add_text("a")

  page: = flow.layout(d, slide_sheet("slide", arena), fixed.make(), 320.0, arena)
  assert(page.boxes.len == 1, "it is not dropped")
  only: = page.boxes.get(0).rect
  assert(base.near(only.x, 0.0) && base.near(only.y, 0.0), "it is laid from the slide's top left")
  verdict
    .pass("a child with no frame does not go away in silence, and is laid across the whole slide.")

fn test_a_surface_sits_in_the_flow() //< a slide sits in the flow
  verdict.start("[kspage/absolute] a slide going into the flow test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  d.add_block("body").add_text("front")
  slide: = d.add_block("slide")
  at: = Rect::{ .x = 10.0, .y = 20.0, .w = 100.0, .h = 50.0 }
  doc.add_framed_child(slide, "frame", at).add_text("mid")
  d.add_block("body").add_text("behind")

  page: = flow.layout(d, slide_sheet("slide", arena), fixed.make(), 320.0, arena)
  assert(page.boxes.len == 3, "the three of front, mid and behind")
  assert(base.near(page.boxes.get(0).rect.y, 0.0), "the paragraph in front is the topmost")
  // **A frame's position is from the slide's top left**, one line below the paragraph before.
  assert(base.near(page.boxes.get(1).rect.y, 39.2F32),
    "the frame is laid at a place measured from the slide's top left")
  assert(base.near(page.boxes.get(1).rect.x, 10.0), "across, it is from the slide's top left too")
  // The style decides the height, so the paragraph after starts the slide's height lower.
  assert(base.near(page.boxes.get(2).rect.y, 259.2F32),
    "the paragraph behind carries on below the slide's height")
  assert(base.near(page.height, 278.4F32), "the height is the paragraphs and the slide added up")
  verdict
    .pass("a slide takes room as part of the flow, for the worth of the height the style says.")

fn test_a_table_nests_inside_a_surface() //<
  //< A table can be laid out inside a slide too (the three arrangements nest in one another)
  verdict.start("[kspage/absolute] a table going inside a slide test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  at: = Rect::{ .x = 40.0, .y = 30.0, .w = 200.0, .h = 100.0 }
  frame: = doc.add_framed_child(slide, "frame", at)
  table: = frame.add_child("table")
  row: = table.add_child("row")
  row.add_child("cell").add_text("a")
  row.add_child("cell").add_text("b")

  sheet: = slide_sheet("slide", arena)
  base.table_style(sheet)

  page: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  assert(page.cells.len == 2, "a table inside a slide is laid as cells too")
  assert(base.near(page.boxes.get(0).rect.x, 40.0), "the table starts at the frame's left edge")
  assert(base.near(page.boxes.get(1).rect.x, 48.0),
    "the second column starts right by the first column's width")
  assert(base.near(page.boxes.get(0).rect.y, 30.0), "it starts at the frame's top edge")
  verdict.pass("a table can be laid as it stands inside a slide's frame too.")

fn test_the_same_tree_works_under_every_strategy() //<
  //< One tree is laid out differently depending on the style's arrangement
  verdict.start("[kspage] one tree being laid under all three arrangements test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  base.two_by_two(d)
  plain: = Sheet.new(base.root_font(), arena)

  // The document says neither "this is a table" nor "this is one slide"; only the style changes.
  as_text: = flow.layout(d, plain, fixed.make(), 200.0, arena)
  as_grid: = flow.layout(d, base.grid_sheet(arena), fixed.make(), 200.0, arena)
  as_slide: = flow.layout(d, slide_sheet("table", arena), fixed.make(), 320.0, arena)
  assert(as_text.boxes.len == 4, "flowing lays the same four characters")
  assert(as_grid.boxes.len == 4, "as a grid they become four cells")
  assert(as_slide.boxes.len == 4, "absolute coordinates lay the same four characters")
  assert(base.near(as_grid.boxes.get(1).rect.x, 8.0), "as a grid it goes into the second column")
  assert(base.near(as_text.boxes.get(1).rect.y, 19.2), "flowing stacks it below")
  assert(base.near(as_slide.boxes.get(1).rect.y, 19.2), "absolute coordinates stack it below too")
  verdict
    .pass("one tree can be laid out differently by changing only the arrangement the style says.")
// ---- a slide's size, and grabbing a frame to move it ----

priv fn sized_slide_sheet(arena: Arena$@): Sheet$@ //<
  //< A slide with both width and height set
  sheet: = Sheet.new(base.root_font(), arena)
  s: = sheet.add("slide", paint.inherit_all())
  s.arrange = Arrange.absolute
  s.width = 160.0
  s.height = 240.0
  return sheet

fn test_a_surface_takes_the_width_the_style_asks_for() //<
  //< A child with no position covers the whole slide, which has the style's width
  verdict.start("[kspage/absolute] a slide taking the width the style asks for test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  // A one-em character is 16px, so 15 characters = 240px, broken after ten by a 160px slide.
  slide.add_child("").add_text("あいうえおかきくけこさしすせそ")

  // 320px is given, but the slide is the 160px the style sets.
  page: = flow.layout(d, sized_slide_sheet(arena), fixed.make(), 320.0, arena)
  assert(page.boxes.len == 2, "it wraps at the slide's width")
  assert(base.near(page.boxes.get(0).rect.w, 160.0), "the first row is the slide's whole width")
  verdict.pass("a slide's width is decided by the style, not by the holder.")

fn test_a_surface_without_a_width_fills_its_container() //< a width of 0 means "not set"
  verdict.start("[kspage/absolute] a slide with no width written test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  slide.add_child("").add_text("あいうえおかきくけこさしすせそ")

  // The contents are 240px, inside the container's 320px.
  page: = flow.layout(d, slide_sheet("slide", arena), fixed.make(), 320.0, arena)
  assert(page.boxes.len == 1, "it does not break within the holder's width")
  assert(base.near(page.boxes.get(0).rect.w, 240.0), "it stays the contents' width")
  verdict.pass("a slide with no width written becomes the holder's width.")

fn test_a_frame_is_grabbed_at_its_corners_and_body() //<
  //< The size changes at a corner or an edge's middle, and it moves at the rest of the edge
  verdict.start("[kspage/absolute] a frame being grasped at its corners and inside test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  at: = Rect::{ .x = 40.0, .y = 60.0, .w = 100.0, .h = 50.0 }
  framed: = doc.add_framed_child(slide, "", at)
  framed.add_text("a")

  page: = flow.layout(d, sized_slide_sheet(arena), fixed.make(), 320.0, arena)
  // **The size changes at any corner.** The opposite corner stays fixed.
  head: = ask.grip_at(page, 40.0, 60.0)
  assert(head.found && head.resize && head.left && head.top,
    "the top left is a handle that changes the size")
  assert(head.block == framed, "what was grasped is that frame")
  tail: = ask.grip_at(page, 140.0, 110.0)
  assert(tail.found && tail.resize && !tail.left && !tail.top, "the bottom right is the same")
  assert(tail.wide && tail.tall, "a corner changes both measurements")
  // **An edge's middle changes only one dimension** (the eight handles every other product has).
  side: = ask.grip_at(page, 140.0, 85.0)
  assert(side.found && side.resize && side.wide && !side.tall,
    "the right edge changes the width alone")
  assert(!side.left, "what does not move is the edge opposite")
  crown: = ask.grip_at(page, 90.0, 60.0)
  assert(crown.found && crown.resize && !crown.wide && crown.tall,
    "the top edge changes the height alone")
  assert(crown.top, "what was grasped is the top edge")
  // **The edge outside the handles is where it is moved from.**
  body: = ask.grip_at(page, 70.0, 110.0)
  assert(body.found && !body.resize, "the edge outside the handles is a handle that moves it")
  assert(base.near(body.dx, 30.0) && base.near(body.dy, 50.0),
    "the gap to the point grasped is remembered")
  // **A frame with contents cannot be grabbed inside.** Grabbed there, the text inside the frame
  // could not be selected.
  assert(!ask.grip_at(page, 70.0, 85.0).found,
    "inside a frame that holds contents nothing is grasped")
  verdict.pass("both at a corner, one at an edge's middle, and it moves at the rest of the edge.")

fn test_one_frame_is_picked_at_a_time() //<
  //< Each click chooses the selected frame anew, and selecting another deselects the previous one
  //<
  //< There is no multiple selection (`../docs/DESIGN.md`, "One frame is selected at a time").
  verdict.start("[kspage/slide] one frame picked at a time test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  a: = doc.add_framed_child(slide, "", Rect::{ .x = 10.0, .y = 10.0, .w = 40.0, .h = 20.0 })
  b: = doc.add_framed_child(slide, "", Rect::{ .x = 60.0, .y = 10.0, .w = 40.0, .h = 20.0 })
  ed: = edit.new_editor(d)

  ed.pick_only(a)
  assert(ed.holds_pick(a) && !ed.holds_pick(b), "it holds the frame picked and no other")
  ed.pick_only(b)
  assert(ed.holds_pick(b) && !ed.holds_pick(a), "picking another takes the one before off")
  assert(ed.picked() == b, "and that one is the frame picked")
  ed.pick_only(null)
  assert(ed.picked() == null && !ed.holds_pick(b), "null takes the selection off")
  verdict.pass("one frame is picked at a time, and picking another takes the one before off.")

fn test_a_ratio_drag_keeps_the_shape() //<
  //< Drag a corner with Shift held and the aspect ratio stays
  //<
  //< **It has no effect on an edge handle** (if it did, the edge not grabbed would move too), as in
  //< every other product.
  verdict.start("[kspage/absolute] dragging while keeping the ratio of the sides test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  // Caution: The shape must have a readable ratio (a square would not show whether it was kept).
  at: = Rect::{ .x = 20.0, .y = 20.0, .w = 80.0, .h = 40.0 }
  framed: = doc.add_framed_child(slide, "", at)
  framed.add_text("a")
  sheet: = sized_slide_sheet(arena)
  ed: = edit.new_editor(d)
  page: = flow.layout(d, sheet, fixed.make(), 320.0, arena)

  corner: = ask.grip_at(page, 100.0, 60.0)
  assert(corner.found && corner.resize, "the bottom-right corner can be grasped")
  ed.drag_frame(page, corner, 140.0, 65.0, true)
  ed.break_group()
  switch framed.frame case .some(f)
    assert(base.near(f.w, 120.0), "the width stays as it was dragged")
    assert(base.near(f.h, 60.0), "the height follows by the ratio")
  case .none
    assert(false, "it holds a frame's place")
  wide: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  side: = ask.grip_at(wide, 140.0, 50.0)
  assert(side.found && side.wide && !side.tall, "the right edge can be grasped")
  ed.drag_frame(wide, side, 100.0, 50.0, true)
  ed.break_group()
  switch framed.frame case .some(f)
    assert(base.near(f.w, 80.0), "the width goes as far as it was dragged")
    assert(base.near(f.h, 60.0), "the height does not move")
  case .none
    assert(false, "it holds a frame's place")
  verdict.pass("Shift keeps the ratio at a corner alone, and at an edge one measurement moves.")

fn test_dragging_a_frame_moves_and_resizes_it() //<
  //< Drag it by its edge and the frame moves; drag a corner and the size changes
  verdict.start("[kspage/absolute] dragging a frame to move it test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  at: = Rect::{ .x = 40.0, .y = 60.0, .w = 100.0, .h = 50.0 }
  framed: = doc.add_framed_child(slide, "", at)
  framed.add_text("a")
  sheet: = sized_slide_sheet(arena)
  ed: = edit.new_editor(d)

  // **The offset from the grab point must be kept.** Otherwise the top left would jump to the
  // pointer the moment it is grabbed.
  page: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  // **Grab the edge outside the handles** (an edge's middle changes one dimension).
  grip: = ask.grip_at(page, 70.0, 110.0)
  ed.drag_frame(page, grip, 100.0, 140.0, false)
  ed.break_group()
  moved: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  assert(base.near(moved.boxes.get(0).rect.x, 70.0), "it moves by what was dragged")
  assert(base.near(moved.boxes.get(0).rect.y, 90.0), "down it is the same")

  // **The opposite corner stays fixed.**
  corner: = ask.grip_at(moved, 70.0, 90.0)
  assert(corner.found && corner.resize && corner.left && corner.top,
    "the top left where it moved to can be grasped")
  ed.drag_frame(moved, corner, 90.0, 100.0, false)
  ed.break_group()
  sized: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  assert(ask.grip_at(sized, 90.0, 100.0).resize, "where it was dragged to becomes the top left")
  assert(ask.grip_at(sized, 170.0, 140.0).resize, "the bottom right does not move")

  assert(ed.undo(), "it can be put back in one")
  back: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  assert(base.near(back.boxes.get(0).rect.x, 70.0), "the size returns to what it was")
  assert(ed.undo(), "it can be put back once more")
  first: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  assert(base.near(first.boxes.get(0).rect.x, 40.0), "the place returns to what it was too")
  verdict.pass("a frame moves from inside, changes size at a corner, and is put back in one.")

fn test_one_frame_drag_undoes_in_one_step() //<
  //< One drag is undone in one step, however many intermediate positions were passed
  verdict.start("[kspage/absolute] one frame drag being one step test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  at: = Rect::{ .x = 40.0, .y = 60.0, .w = 100.0, .h = 50.0 }
  doc.add_framed_child(slide, "", at).add_text("a")
  sheet: = sized_slide_sheet(arena)
  ed: = edit.new_editor(d)

  page: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  grip: = ask.grip_at(page, 40.0, 60.0)
  ed.drag_frame(page, grip, 50.0, 70.0, false)
  ed.drag_frame(page, grip, 60.0, 80.0, false)
  ed.drag_frame(page, grip, 70.0, 90.0, false)
  ed.break_group()

  assert(ed.undo(), "it can be put back in one")
  back: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  assert(base.near(back.boxes.get(0).rect.x, 40.0), "it returns to the place it had before the drag")
  assert(!ed.undo(), "there is nothing left to put back")
  verdict.pass("one drag is one step, and the middle of it does not grow the record.")

fn test_a_frameless_child_cannot_be_grabbed() //< a frame with no position cannot be grabbed
  //<
  //< It only covers the whole slide, and there is nowhere to move it to.
  verdict.start("[kspage/absolute] a child with no place not being grasped test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  slide.add_child("").add_text("a")

  page: = flow.layout(d, sized_slide_sheet(arena), fixed.make(), 320.0, arena)
  assert(page.frames.len == 1, "as a frame it is left")
  assert(!ask.grip_at(page, 0.0, 0.0).found, "not even the top left is grasped")
  verdict.pass("a frame with no place written cannot be grasped.")
// ---- presenting one at a time ----

fn test_surfaces_are_recorded_in_document_order() //< the slides are listed in document order
  //<
  //< Out of that order, stepping through them would get out of step with the text.
  verdict.start("[kspage/absolute] the slides standing in the document's order test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  first: = d.add_block("slide")
  first.add_child("").add_text("a")
  d.add_block("body").add_text("the paragraph in between")
  second: = d.add_block("slide")
  second.add_child("").add_text("b")

  page: = flow.layout(d, sized_slide_sheet(arena), fixed.make(), 320.0, arena)
  assert(page.surfaces.len == 2, "the slides are two")
  assert(page.surfaces.get(0).block == first, "the first is the one written first")
  assert(page.surfaces.get(1).block == second, "the second is the one written later")
  head: = page.surfaces.get(0).rect
  assert(base.near(head.w, 160.0) && base.near(head.h, 240.0), "the size is as the style says")
  assert(page.surfaces.get(1).rect.y > head.y, "the second lies below")
  verdict.pass("the slides stand in the document's order, at the size the style says.")

fn test_a_surface_inside_a_frame_is_counted_too() //< a slide inside a frame counts too
  //<
  //< If a nested one could not be reached, what was written could not be presented.
  verdict.start("[kspage/absolute] a slide inside a frame being counted too test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  outer: = d.add_block("slide")
  at: = Rect::{ .x = 10.0, .y = 10.0, .w = 120.0, .h = 100.0 }
  inner: = doc.add_framed_child(outer, "slide", at)
  inner.add_child("").add_text("a")

  page: = flow.layout(d, sized_slide_sheet(arena), fixed.make(), 320.0, arena)
  assert(page.surfaces.len == 2, "two, the outer and the inner")
  assert(page.surfaces.get(0).block == outer, "the outer comes first")
  assert(page.surfaces.get(1).block == inner, "the inner follows it")
  verdict.pass("a slide inside a frame is counted as one too.")

fn test_a_document_without_surfaces_has_none() //<
  //< In a document with no slide it is 0, the count saying there is nothing to present
  verdict.start("[kspage/absolute] a document with no slide test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  base.two_by_two(d)
  page: = flow.layout(d, base.grid_sheet(arena), fixed.make(), 200.0, arena)
  assert(page.surfaces.len == 0, "a document holding tables alone has no slide")
  verdict.pass("in a document with no slide it is 0.")
fn test_a_surface_is_inserted_after_the_caret() //<
  //< One presentation slide can be inserted after the paragraph the cursor is in
  //<
  //< **The slide's style must exist first**: the style decides the size, not the core.
  verdict.start("[kspage/absolute] a slide being inserted test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  head: = d.add_block("body").add_text("body")
  sheet: = sized_slide_sheet(arena)
  ed: = edit.new_editor(d)
  page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
  ed.caret = caret.at(head, 0)

  assert(ed.insert_surface(page, sheet, "slide", Sketch.whole).surfaced(), "it can be inserted")
  assert(d.blocks.len == 2, "one grows behind the paragraph")
  made: = d.blocks.get(1)
  assert(made.children.len == 1, "the frame inside is one")
  box: = made.children.get(0)
  assert(ed.caret.inline == box.inlines.get(0), "the cursor goes into that frame")
  // The frame is the whole slide; a child with no position could not be grabbed or moved.
  switch box.frame case .some(f)
    assert(base.near(f.w, 160.0) && base.near(f.h, 240.0),
      "the frame is the whole size the style says")
  case .none
    assert(false, "a frame's place goes in")
  after: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
  assert(after.surfaces.len == 1, "it is counted as one")

  assert(ed.undo(), "it can be put back in one")
  assert(d.blocks.len == 1, "the slide comes off")
  verdict.pass("a slide goes in behind the cursor's paragraph, and is put back in one.")

fn test_a_surface_needs_a_style_that_says_its_size() //< it does not create a missing style
  //<
  //< Create a slide whose size is not set and it cannot be seen even after layout.
  verdict.start("[kspage/absolute] a slide wanting a style test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  head: = d.add_block("body").add_text("body")
  ed: = edit.new_editor(d)

  bare: = Sheet.new(base.root_font(), arena)
  page: = flow.layout(d, bare, fixed.make(), 300.0, arena)
  ed.caret = caret.at(head, 0)
  no_name: = ed.insert_surface(page, bare, "slide", Sketch.whole)
  assert(no_name.variant_name().equals("no_style"),
    "with a name that is not there it says the style is missing")
  // A width of 0 means "the container's width", so before layout the frame's size is unknown.
  wide: = slide_sheet("slide", arena)
  no_width: = ed.insert_surface(page, wide, "slide", Sketch.whole)
  assert(no_width.variant_name().equals("no_style"),
    "with a style holding no width it says the same")
  assert(d.blocks.len == 1, "with either, the document does not change")
  verdict.pass("a slide is inserted only with a style whose size is set.")

fn test_a_refused_slide_says_why() //< each refusal carries its own reason
  //<
  //< One message for a missing style and the cursor's position sends the reader the wrong way.
  verdict.start("[kspage/slide] the reason a slide was refused test...")
  arena: = Arena.new(256 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  head: = d.add_block("body").add_text("body")
  table: = d.add_block("table")
  row: = table.add_child("")
  cell: = row.add_child("cell").add_text("in a cell")
  sheet: = slide_sheet("slide", arena)
  if s: = sheet.find("slide")
    s.width = 320.0
    s.height = 180.0
  base.table_style(sheet)
  ed: = edit.new_editor(d)
  page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
  ed.caret = caret.at(cell, 0)
  assert(ed.insert_surface(page, sheet, "slide", Sketch.whole).variant_name().equals("in_cell"),
    "inside a table's cell it says so")
  ed.caret = caret.nowhere()
  assert(ed.insert_surface(page, sheet, "slide", Sketch.whole).variant_name().equals("nowhere"),
    "with the cursor in no paragraph it says so")
  ed.caret = caret.at(head, 0)
  assert(ed.insert_surface(page, sheet, "slide", Sketch.whole).surfaced(), "in the body it goes in")
  verdict.pass("a refused slide names its reason.")

priv fn frame_of(b: Block$@): Rect //< a frame's position
  //<
  //< **There is no child without a position** (a sketch gives every child a frame).
  switch b.frame case .some(f)
    return f
  case .none
    assert(false, "a frame's place goes in")
    return Rect::{ .x = 0.0, .y = 0.0, .w = 0.0, .h = 0.0 }

fn test_a_sketch_lays_out_the_frames_of_a_new_surface() //<
  //< A sketch only decides the frame layout
  //<
  //< **It applies no style name** (another action does). On a 160 × 240 slide the margin is a
  //< sixteenth (10 across, 15 down) and the title's height a fifth (48).
  verdict.start("[kspage/absolute] a slide's sketch test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  head: = d.add_block("body").add_text("body")
  sheet: = sized_slide_sheet(arena)
  ed: = edit.new_editor(d)
  page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
  ed.caret = caret.at(head, 0)

  assert(ed.insert_surface(page, sheet, "slide", Sketch.titled).surfaced(),
    "it can be inserted as a title and a body")
  titled: = d.blocks.get(1)
  assert(titled.children.len == 2, "the frames are two")
  title: = frame_of(titled.children.get(0))
  body: = frame_of(titled.children.get(1))
  assert(base.near(title.x, 10.0) && base.near(title.w, 140.0),
    "the title is laid with room left and right")
  assert(base.near(title.y, 15.0) && base.near(title.h, 48.0),
    "the title's height is a fifth of the slide's")
  assert(base.near(body.y, 78.0), "the body carries on below the title, with room left between")
  assert(base.near(body.h, 147.0), "the body takes up to the room at the bottom")
  for $i: Sz = 0; i < titled.children.len; i += 1
    kid: = titled.children.get(i)
    assert(kid.style.len == 0, "no style's name is put on a frame")
    assert(kid.inlines.len == 1, "one text goes into a frame")
  first: = titled.children.get(0).inlines.get(0)
  assert(ed.caret.inline == first, "the cursor goes into the first frame")
  assert(ed.undo(), "it can be put back in one")

  assert(ed.insert_surface(page, sheet, "slide", Sketch.halved).surfaced(),
    "it can be inserted as a title and two columns")
  halved: = d.blocks.get(1)
  assert(halved.children.len == 3, "the frames are three")
  left: = frame_of(halved.children.get(1))
  right: = frame_of(halved.children.get(2))
  assert(base.near(left.w, right.w), "left and right are the same width")
  assert(base.near(left.y, right.y) && base.near(left.h, right.h),
    "left and right stand at the same height")
  assert(base.near(right.x, left.x + left.w + 10.0F32), "room is left between them too")
  assert(base.near(right.x + right.w, 150.0), "the right end fits inside the slide")
  verdict.pass("a sketch builds the row of frames alone, and leaves the style to what lays one on.")

fn test_one_frame_is_dropped_from_the_surface() //< one frame can be removed from the slide
  //<
  //< **The last frame is not removed** (a slide with no frame lays out no box to click into).
  verdict.start("[kspage/shape] taking one frame off test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  head: = d.add_block("body").add_text("body")
  sheet: = sized_slide_sheet(arena)
  ed: = edit.new_editor(d)
  page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
  ed.caret = caret.at(head, 0)
  assert(ed.insert_surface(page, sheet, "slide", Sketch.halved).surfaced(),
    "it can be inserted as a title and two columns")
  made: = d.blocks.get(1)

  // It removes nothing in the flow. Backspace and Delete are what delete a paragraph.
  ed.caret = caret.at(head, 0)
  outside: = ed.drop_frame(sheet)
  assert(!outside, "outside a slide nothing comes off")
  // **Only the one frame the cursor is in is removed.**
  ed.caret = caret.at(made.children.get(2).inlines.get(0), 0)
  assert(ed.drop_frame(sheet), "inside a slide it comes off")
  assert(made.children.len == 2, "the frames fall by one")
  assert(ed.caret.inline != null, "the cursor moves to the frame left")
  assert(ed.undo(), "it can be put back in one")
  assert(made.children.len == 3, "the frame taken off comes back")

  ed.caret = caret.at(made.children.get(2).inlines.get(0), 0)
  assert(ed.drop_frame(sheet), "the second can be taken off")
  ed.caret = caret.at(made.children.get(1).inlines.get(0), 0)
  assert(ed.drop_frame(sheet), "the third can be taken off too")
  assert(made.children.len == 1, "one frame is left")
  ed.caret = caret.at(made.children.get(0).inlines.get(0), 0)
  last: = ed.drop_frame(sheet)
  assert(!last, "the last frame is not taken off")
  verdict.pass("a frame comes off one at a time, and the last one is kept.")

fn test_dropping_a_frame_from_inside_a_table_drops_the_whole_frame() //<
  //< Even from deep inside, what is removed is the frame directly under the slide
  //<
  //< In a table inside a frame, the frame is removed, table and all.
  verdict.start("[kspage/shape] taking it off from a table inside a frame test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  at: = Rect::{ .x = 0.0, .y = 0.0, .w = 80.0, .h = 120.0 }
  doc.add_framed_child(slide, "", at).add_text("title")
  frame: = doc.add_framed_child(slide, "", at)
  frame.add_text("")
  row: = frame.add_child("table").add_child("")
  cell: = row.add_child("cell").add_text("cell")
  sheet: = sized_slide_sheet(arena)
  base.table_style(sheet)
  ed: = edit.new_editor(d)

  ed.caret = caret.at(cell, 0)
  assert(ed.drop_frame(sheet), "it comes off even from inside a cell")
  assert(slide.children.len == 1, "the frame comes off, table and all")
  verdict
    .pass("what comes off is the frame right below the slide, and its contents come with it whole.")
// ---- the memo beside a slide (the speaker's notes) ----

fn test_an_aside_sticks_to_the_holder_and_undoes_as_one_step() //< a memo goes beside a container
  verdict.start("[kspage/shape] putting an aside beside a slide test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  sheet: = slide_sheet("slide", arena)
  made: = d.add_block("slide")
  box: = doc.add_framed_child(made, "", Rect::{ .x = 0.0, .y = 0.0, .w = 100.0, .h = 40.0 })
  n: = box.add_text("front")
  page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

  ed: = edit.new_editor(d)
  ed.caret = caret.at(n, 0)
  assert(ed.aside_at(page).len == 0, "at first there is no aside")
  assert(ed.set_aside(page, "pause here"), "it can be put beside")
  assert(made.aside.equals("pause here"), "the aside is put on the slide itself")
  before: = page.boxes.len
  after: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
  assert(after.boxes.len == before, "putting an aside beside grows no box")
  assert(ed.undo(), "it can be put back in one")
  assert(made.aside.len == 0, "the aside comes off")
  verdict.pass("an aside goes beside the holder, and does not come out in the flow.")

fn test_an_aside_needs_a_holder() //< it cannot be added outside a container
  //<
  //< There is no way to show on screen which paragraph it belongs to, so nobody could notice it was
  //< there.
  verdict.start("[kspage/shape] not putting an aside beside outside a holder test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  n: = d.add_block("body").add_text("body")
  page: = flow.layout(d, slide_sheet("slide", arena), fixed.make(), 200.0, arena)

  ed: = edit.new_editor(d)
  ed.caret = caret.at(n, 0)
  assert(!ed.set_aside(page, "wanted"), "nothing can be put beside an ordinary paragraph")
  assert(ed.aside_at(page).len == 0, "read, it is empty")
  verdict.pass("an aside is put beside inside a holder and nowhere else.")

fn test_a_shape_lands_in_the_slide_and_undoes_as_one_step() //<
  //< A shape goes into the slide's middle, and appears as a band of the frame's size
  //<
  //< **It holds no text.** Close the band at anything but the frame's height and it comes out with
  //< height 0: added, and nothing to see.
  verdict.start("[kspage/insert] a shape being added to a slide test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  head: = d.add_block("body").add_text("body")
  sheet: = sized_slide_sheet(arena)
  ed: = edit.new_editor(d)
  page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
  ed.caret = caret.at(head, 0)
  assert(ed.insert_surface(page, sheet, "slide", Sketch.whole).surfaced(),
    "the slide can be inserted")
  slide: = d.blocks.get(1)
  placed: = flow.layout(d, sheet, fixed.make(), 300.0, arena)

  assert(ed.insert_shape(placed, sheet, "figure", Shape.fall_arrow), "the shape can be added")
  assert(slide.children.len == 2, "the slide's children grow by one")
  made: = slide.children.get(1)
  assert(made.inlines.len == 0, "it holds no text")
  // The slide is 160 × 240, so the middle half is 80 × 120 from (40, 60).
  switch made.frame case .some(f)
    assert(base.near(f.x, 40.0) && base.near(f.y, 60.0), "it comes out at the slide's middle")
    assert(base.near(f.w, 80.0) && base.near(f.h, 120.0), "the size is half the slide's")
  case .none
    assert(false, "a frame's place goes in")

  drawn: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
  $found: = false
  for $i: Sz = 0; i < drawn.panels.len; i += 1
    one: = drawn.panels.get(i)
    if one.block == made
      found = true
      assert(base.near(one.rect.h, 120.0), "the band is the frame's height")
      assert(one.width > 0.0, "one line goes in so that it can be seen")
      assert(one.shape.same_shape(Shape.fall_arrow), "the shape reaches the band")
  assert(found, "one band comes out")

  assert(ed.undo(), "it can be put back in one")
  assert(slide.children.len == 1, "the shape comes off")
  verdict
    .pass("a shape goes into the slide's middle, and comes out as a band of the frame's height.")

fn test_a_shape_hangs_on_a_paragraph() //<
  //< A shape can be added to an ordinary paragraph too (Word and Excel both put one over the body)
  //<
  //< **The flow must not move.** A shape has a position, so slipped in between the lines it would
  //< move the text (a shape jumping with its anchor paragraph is a common complaint elsewhere).
  verdict.start("[kspage/insert] a shape being added to a paragraph too test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  n: = d.add_block("body").add_text("body")
  sheet: = sized_slide_sheet(arena)
  page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
  was: = page.height

  ed: = edit.new_editor(d)
  ed.caret = caret.at(n, 0)
  put: = ed.insert_shape(page, sheet, "figure", Shape.rise_line)
  assert(put, "it can be added to a paragraph")
  assert(d.blocks.get(0).children.len == 1, "it goes in as that paragraph's child")

  again: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
  assert(base.near(again.height, was), "adding a shape does not change the body's height")
  assert(again.frames.len == 1, "it is laid as a frame")
  // **A frame's position is from the paragraph's top left** (not screen coordinates).
  spot: = again.frames.get(0).rect
  assert(base.near(spot.w, 120.0) && base.near(spot.h, 80.0), "it goes in at the size set")
  assert(base.near(spot.x, 8.0), "it goes a little inside the paragraph's top left")
  assert(ed.undo(), "it can be put back in one")
  assert(d.blocks.get(0).children.len == 0, "the shape comes off")
  verdict
    .pass("a shape is carried by the holder at the place pressed, and the body's flow does not \
      move.")

fn test_a_drawn_shape_needs_a_holder() //< nothing can be drawn where there is no container
  //<
  //< A shape has a position, so it needs a container to hold it.
  verdict.start("[kspage/insert] not drawing outside a holder test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  d.add_block("body").add_text("body")
  sheet: = sized_slide_sheet(arena)
  page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)

  ed: = edit.new_editor(d)
  put: = ed.draw_shape(page, sheet, "figure", Shape.box, 5000.0, 5000.0, 40.0, 20.0)
  assert(!put, "outside the document nothing is drawn")
  assert(d.blocks.get(0).children.len == 0, "the document does not change")
  assert(sheet.find("figure").is_none(), "no style is made either")
  verdict.pass("nothing is drawn where there is no holder to carry it.")
fn test_a_picked_frame_takes_numbers() //<
  //< A shape cannot be pointed at with the cursor (it holds no text)
  verdict.start("[kspage/absolute] laying a frame picked by numbers test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  slide: = d.add_block("slide")
  // A frame with a text and a shape: the last frame is never removed, so two are placed.
  doc.add_framed_child(slide, "", Rect::{ .x = 0.0, .y = 0.0, .w = 40.0, .h = 20.0 })
    .add_text("title")
  figure: = doc.add_framed_child(slide, "",
    Rect::{ .x = 40.0, .y = 60.0, .w = 100.0, .h = 50.0 })
  sheet: = sized_slide_sheet(arena)
  ed: = edit.new_editor(d)
  page: = flow.layout(d, sheet, fixed.make(), 320.0, arena)

  ed.pick_at(page, 90.0, 85.0)
  switch ed.frame_at() case .some(got)
    assert(got == figure, "the frame at the place pressed is picked")
  case .none
    assert(false, "there is a frame picked")
  assert(ed.place_frame(10.0, 20.0, 30.0, 40.0), "the place and the size can be set by numbers")
  switch figure.frame case .some(r)
    assert(base.near(r.x, 10.0) && base.near(r.y, 20.0), "it becomes the place handed over")
    assert(base.near(r.w, 30.0) && base.near(r.h, 40.0), "it becomes the size handed over")
  case .none
    assert(false, "there is a place")
  // A negative size is not created (a frame turned inside out could not be grabbed).
  assert(ed.place_frame(10.0, 20.0, -5.0, -5.0), "a negative size is taken too")
  if r: = figure.frame
    assert(base.near(r.w, 0.0) && base.near(r.h, 0.0), "a negative size becomes 0")
  assert(ed.undo(), "it can be put back in one")
  assert(ed.undo(), "it can be put back once more")

  // A removed frame is not pointed at (nothing is written into a dangling place); the cursor moves
  // to the remaining frame.
  assert(ed.drop_frame(sheet), "the frame picked can be taken off")
  if b: = ed.frame_at()
    assert(b != figure, "a frame taken off is not pointed at")
  verdict.pass("a frame picked can be laid by numbers, and once off it is not pointed at.")

fn test_a_table_in_the_flow_is_not_a_frame() //< a table in the flow is not a frame
  verdict.start("[kspage/absolute] a table in the flow being no frame test...")
  arena: = Arena.new(64 * 1024)
  defer arena.free()
  d: = Doc.new(arena)
  sheet: = sized_slide_sheet(arena)
  grid: = sheet.add("grid", paint.inherit_all())
  grid.arrange = Arrange.grid
  d.add_block("").add_text("body")
  t: = d.add_block("grid")
  t.add_child("").add_child("").add_text("cell")
  // A slide is laid out too (the frame list must not be empty).
  slide: = d.add_block("slide")
  doc.add_framed_child(slide, "", Rect::{ .x = 0.0, .y = 0.0, .w = 40.0, .h = 20.0 })
    .add_text("title")
  ed: = edit.new_editor(d)
  page: = flow.layout(d, sheet, fixed.make(), 320.0, arena)
  cell: = page.boxes.get(1).rect
  ed.pick_at(page, cell.x + 1.0F32, cell.y + 1.0F32)
  if _b: = ed.frame_at()
    assert(false, "a table in the flow is no frame")
  verdict.pass("a frame is a slide's child and nothing else.")

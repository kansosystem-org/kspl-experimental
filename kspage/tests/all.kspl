import "kspage/tests/undo_test"
import "std/mem" { Arena }
import "std/suite"

// ==========================================
// The entry point that runs all of kspage's tests.
// **This is the only `pub` in this package**: the tests live inside the unit, so what they
// inspect needs no mark (which lets [I0402] stay on).
// Caution: **Do not add an entry point for inspection here** — each is one more contract exposed
// beyond the unit.
// ==========================================
priv struct Tests //< what kspage's tests take: an arena of their own each
    arena: Arena$@ //< the running test's; null between tests

impl Tests: suite.Suite
    fn before_each(r: Self$@, _name: U8[]) //< gives the next test an arena of its own
        //< **A fresh arena per test**, so nothing one test leaves there reaches the next. Its
        //< chunks start small and grow up to the cap only as a test asks for room.
        r.arena = Arena.new(1024 * 1024)

    fn after_each(r: Self$@, _name: U8[]) //< frees the arena the test was given
        r.arena.free()

pub fn run_kspage() //< runs every kspage test
    $t: = Tests::{ .arena = null }
    t.run()

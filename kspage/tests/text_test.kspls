//< kspage: the text form kept exactly as it is, and annotations on an inline
import "kspage/lay/caret"
import "kspage/lay/flow"
import "kspage/model/doc" { Doc }
import "kspage/model/fixed_font" as fixed
import "kspage/model/font" { Font }
import "kspage/model/paint"
import "kspage/model/run" { Inline }
import "kspage/model/style" { Sheet }
import "kspage/share/markdown"
import "kspage/share/text"
import "kspage/tests/base"
import "kspage/write/edit"
import "kspage/write/shape"
import "std/chars"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/verdict"

// ==========================================
// kspage: checks that the text form is kept exactly as it is.
//
// **The round trip on real files is checked by `tests/suite/textrip_test.kspls`**; here, the
// edge cases (an empty file, only newlines, no final newline, a NUL) and a style's part.
// ==========================================

priv fn trip(src: U8[], out: Str_builder$@, arena: Arena$@) //< round-trips a text once
    sheet: = text.sheet_for(base.root_font(), "", arena)
    text.write(text.read(src, sheet, arena), out)

priv fn same(src: U8[], arena: Arena$@): Bool //<
    //< Whether one round trip returns the original
    $out: = Str_builder.new()
    defer out.free()
    trip(src, out@, arena)
    return src.equals(out.slice())

priv fn lines_of(src: U8[], arena: Arena$@): Sz //< the number of lines read
    sheet: = text.sheet_for(base.root_font(), "", arena)
    return text.read(src, sheet, arena).blocks.len

fn test_the_bytes_come_back_exactly(arena: Arena$@)
    verdict.start("[kspage/text] the text form coming back without one byte changed test...")

    // **Whether it ends in a newline is kept**: adding one grows the diff by a line, and dropping
    // it makes it unreadable to some tools.
    assert(same("a\nb\n", arena), "a text ending in a newline")
    assert(same("a\nb", arena), "a text not ending in a newline")
    assert(same("", arena), "an empty file")
    assert(same("\n", arena), "newlines alone")
    assert(same("\n\n\n", arena), "a row of empty lines")
    // **Trailing whitespace and tabs stay** (tidied, it would become another file).
    assert(same("fn main() {\n\treturn 0;   \n}\n", arena), "a tab and whitespace at the end")
    // **A line that looks like Markdown markup is text too** (the text form has no markup).
    assert(same("# not a heading\n- nor a bullet\n| a | b |\n", arena), "rows that look like marks")
    // **A CR is kept as a character of the line** (stored as "CRLF", a mixed text would break).
    assert(same("a\r\nb\r\n", arena), "CRLF")
    assert(same("a\r\nb\n", arena), "a text with mixed newlines")
    verdict.pass("not one of the edges changes by one byte on the way back.")

fn test_a_line_is_a_block(arena: Arena$@)
    verdict.start("[kspage/text] one row becoming one block test...")

    // **There is a line after the final newline too**, and that alone tells whether the text ends
    // in one; a separate flag would say the same thing twice.
    assert(lines_of("", arena) == 1, "an empty file is one row too")
    assert(lines_of("a", arena) == 1, "with no newline it is one row")
    assert(lines_of("a\n", arena) == 2, "ending in a newline, there is a row behind it too")
    assert(lines_of("a\nb\nc", arena) == 3, "two newlines make three rows")
    verdict.pass("a row is the piece cut at a newline, as it stands.")

fn test_what_is_not_text_is_refused()
    verdict.start("[kspage/text] refusing what is no text test...")

    assert(text.texty("an ordinary text\n"), "an ordinary text comes through")
    assert(text.texty(""), "an empty one comes through too")
    // **Reject what holds a NUL**: opened, it shows garbled and **saving it breaks the original**.
    // It is built as bytes (a NUL cannot be written inside a text literal).
    bytes: U8[5] = ::{ 'P', 'N', 'G', 0U8, 0x1aU8 }
    assert(!text.texty(U8[]::bytes), "a text holding a NUL is refused")
    verdict.pass("a file holding a NUL is not opened as the text form.")

fn test_the_sheet_has_one_role(arena: Arena$@)
    verdict.start("[kspage/text] the style's part being one only test...")

    sheet: = text.sheet_for(base.root_font(), "", arena)
    assert(sheet.styles.len == 1, "there is one style")
    one: = sheet.styles.get(0)
    // Caution: **Do not wrap.** Wrapping drops the whitespace at the break, and the indent depth
    // silently changes.
    assert(!one.wrap, "it does not wrap")
    assert(one.outline == 0, "it is no heading")
    // **Set neither a background color nor a frame** (it is the document itself, not a band).
    if _v: = one.fill
        assert(false, "it lays no fill")
    assert(one.rule_width == 0.0, "it draws no line")
    assert(one.pad == 0.0, "it lays no space inside")
    // The line number. **It is not written into the text**, so the round trip does not change.
    switch one.marker
    case .number {}
    default
        assert(false, "the row-number mark goes on")
    // **The gutter must be wider than the number.** Too narrow, the number overlaps the body
    // (`place_mark` in `lay/line.kspls`).
    assert(one.indent > 0.0, "there is a gutter the numbers are laid in")

    // Given an empty table (not `sheet_for`'s), it still adds its own style.
    bare: = Sheet.new(base.root_font(), arena)
    d: = text.read("a\nb\n", bare, arena)
    assert(bare.styles.len == 1, "only one is added to an empty table")
    assert(!bare.styles.get(0).wrap, "what is added is a style that does not wrap either")
    assert(d.blocks.get(0).style.equals(bare.styles.get(0).name), "that style is laid on")
    verdict.pass("the part is the one `it does not wrap` and nothing else.")
priv fn gutter_of(lines: Sz, arena: Arena$@): F32 //<
    //< The width of the line-number gutter after reading a text of `lines` lines
    $src: = Str_builder.new()
    defer src.free()
    for $i: Sz = 0; i < lines; i += 1
        src.s("x\n")
    sheet: = text.sheet_for(base.root_font(), "", arena)
    _d: = text.read(src.slice(), sheet, arena)
    return sheet.styles.get(0).indent

fn test_the_number_gutter_follows_the_line_count(arena: Arena$@) //<
    //< The line-number gutter is sized from the digit count of the line count
    //<
    //< Caution: **Do not fix the width**, or a file with three-digit line numbers gets a margin
    //< three characters too wide. **Do not make it narrower than the number and the space after
    //< it** — too narrow, the number overlaps the body (`place_mark` in `../lay/line.kspls`).
    verdict.start("[kspage/text] the width of the row numbers' gutter test...")
    small: = gutter_of(9, arena)
    mid: = gutter_of(99, arena)
    big: = gutter_of(1000, arena)
    assert(small < mid && mid < big, "more places and the gutter widens")
    // **The number and a space are counted**: four digits make the five characters "1000 ".
    src: = fixed.make()
    font: = Font::{ .family = "monospace", .size_px = 16.0 * 0.9F32, .weight = 400U16,
        .italic = false }
    assert(src.measure_width(font, "1000 ") <= big,
        "a number of four places and a space go into the gutter")
    assert(src.measure_width(font, "9 ") <= small, "a number of one place and a space go in too")
    verdict
        .pass("the gutter widens with the places in the count of rows, and the number and the space \
            beside it always go in.")

fn test_the_line_numbers_reach_the_screen(arena: Arena$@)
    verdict.start("[kspage/text] the row numbers coming out as far as the screen test...")

    sheet: = text.sheet_for(base.root_font(), "", arena)
    d: = text.read("a\nb\nc\n", sheet, arena)
    page: = flow.layout(d, sheet, fixed.make(), 400.0, arena)

    // **The number is a box that is not in the document** (clicked, no position comes back).
    // One number box per line is laid out before the text's box.
    $marks: Sz = 0
    $first: U8[] = ""
    for $i: Sz = 0; i < page.boxes.len; i += 1
        box: = page.boxes.get(i)
        if box.inline != null
            continue
        marks += 1
        if marks == 1
            first = box.text
    // Four lines are read (there is a line after the final newline too).
    assert(d.blocks.len == 4, "it becomes four rows")
    assert(marks == 4, "as many numbers come out as there are rows")
    assert(first.starts_with("1"), "it counts from 1")
    // **The number must sit inside the gutter.** Sticking out, it overlaps the body.
    $body: F32 = 0.0
    for $i: Sz = 0; i < page.boxes.len; i += 1
        box: = page.boxes.get(i)
        if box.inline != null
            body = box.rect.x
            break
    for $i: Sz = 0; i < page.boxes.len; i += 1
        box: = page.boxes.get(i)
        if box.inline == null
            assert(box.rect.x + box.rect.w <= body,
                "the number ends nearer than the body's left edge")
    verdict
        .pass("the row numbers line up right-aligned inside the gutter and do not bite into the \
            body.")
fn test_the_lines_are_as_tight_as_a_code_editor(arena: Arena$@)
    verdict.start("[kspage/text] a row's height being about a code editor's test...")

    sheet: = text.sheet_for(base.root_font(), "", arena)
    d: = text.read("a\nb\nc\nd\n", sheet, arena)
    page: = flow.layout(d, sheet, fixed.make(), 400.0, arena)

    // The tops of two text boxes differ by one line's advance.
    // Caution: **Skip the number boxes** (they sit on the same line).
    $first: F32 = -1.0
    $second: F32 = -1.0
    for $i: Sz = 0; i < page.boxes.len; i += 1
        box: = page.boxes.get(i)
        if box.inline == null
            continue
        if first < 0.0
            first = box.rect.y
        else if second < 0.0
            second = box.rect.y
    assert(first >= 0.0 && second > first, "two rows or more are laid")
    pitch: = second - first
    size: = base.root_font().size_px * 0.9F32
    // **Do not exceed 1.4 times**, or a screen holds a quarter fewer lines (VS Code uses 1.35).
    assert(pitch <= size * 1.4F32, "a row's advance does not go past 1.4 times the font size")
    // **Do not pack it too tight** (the characters would touch above and below).
    assert(pitch >= size * 1.15F32, "a row's advance does not fall below 1.15 times the font size")
    verdict.pass("one row's advance sits within 1.15 to 1.4 times the font size")

// ==========================================
// kspage: checks the annotation on an inline (someone's comment).
//
// **An annotation does not appear in the flow**, neither on the page nor in an export; unchecked,
// nobody would notice the day it starts to. A note, whose mark does appear, is `Inline.note`.
// ==========================================

priv fn runs_of(d: Doc$@): Sz
    return d.blocks.get(0).inlines.len

priv fn run_at(d: Doc$@, i: Sz): Inline$@
    return d.blocks.get(0).inlines.get(i)

priv fn one_para(arena: Arena$@): edit.Editor$@ //<
    //< One paragraph of "abcde", with the cursor in it
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("abcde")
    e: = edit.new_editor(d)
    e.caret = caret.at(n, 0)
    return e

fn test_a_remark_covers_the_span_and_undoes_as_one_step(arena: Arena$@) //<
    //< An annotation covers the selected range, and the words and who wrote them are set together
    verdict.start("[kspage/shape] an annotation lying on a range test...")
    ed: = one_para(arena)
    // "ab" is selected.
    ed.caret.offset = 2
    assert(ed.set_remark("better not to put this so flatly", "Alice"), "it can be put on")

    assert(runs_of(ed.doc) == 2, "the run splits where it was selected")
    marked: = run_at(ed.doc, 0)
    assert(marked.remark.equals("better not to put this so flatly"), "the words go on")
    assert(marked.remark_by.equals("Alice"), "who wrote them goes on too")
    assert(run_at(ed.doc, 1).remark.len == 0, "it does not go on where nothing was selected")
    assert(ed.undo(), "it can be put back in one")
    assert(run_at(ed.doc, 0).remark.len == 0, "the words come off")
    assert(run_at(ed.doc, 0).remark_by.len == 0, "who wrote them comes off too")
    verdict
        .pass("an annotation lies on the range selected, and one undo takes both the words and who \
            wrote them off.")

fn test_an_empty_remark_drops_the_writer_too(arena: Arena$@) //<
    //< an empty text removes who wrote it too
    //<
    //< Left in place, a name with no words would stay on the inline.
    verdict.start("[kspage/shape] an empty annotation coming off with who wrote it test...")
    ed: = one_para(arena)
    assert(ed.set_remark("better changed", "Alice"), "it can be put on")
    assert(run_at(ed.doc, 0).remark_by.equals("Alice"), "who wrote it is on")
    assert(ed.set_remark("", "Alice"), "it can be taken off")
    assert(run_at(ed.doc, 0).remark.len == 0, "the words go empty")
    assert(run_at(ed.doc, 0).remark_by.len == 0, "who wrote it goes empty too")
    verdict.pass("where the text is empty, who wrote it is cleared too.")

fn test_a_remark_stays_out_of_the_flow(arena: Arena$@) //<
    //< an annotation does not appear in the flow
    //<
    //< Laid out again the boxes do not grow, and it does not appear in the exported Markdown.
    verdict.start("[kspage/flow] an annotation not coming out in the flow test...")
    ed: = one_para(arena)
    sheet: = Sheet.new(base.root_font(), arena)
    before: = flow.layout(ed.doc, sheet, fixed.make(), 200.0, arena).boxes.len
    assert(ed.set_remark("this is not to come out in the flow", "Alice"), "it can be put on")
    after: = flow.layout(ed.doc, sheet, fixed.make(), 200.0, arena)
    assert(after.boxes.len == before, "putting an annotation on does not grow the boxes")

    $sb: = Str_builder.new()
    defer sb.free()
    markdown.write(ed.doc, sheet, sb@)
    out: = sb.slice()
    assert(!base.has(out, "this is not to come out in the flow"),
        "the words do not come out in the Markdown written out")
    assert(!base.has(out, "Alice"), "who wrote them does not come out either")
    verdict.pass("an annotation comes out in neither a laying-out again nor a writing out.")

fn test_a_split_run_keeps_the_remark_on_both_halves(arena: Arena$@) //<
    //< An annotation covers a range, so it stays on both sides of a split inline (as a link does)
    verdict.start("[kspage/edit] an annotation being left on both sides of a split run test...")
    ed: = one_para(arena)
    assert(ed.set_remark("words on the whole of it", "Alice"), "it can be put on the whole")
    // Split in the middle, the second half keeps the same words.
    switch edit.split_run(ed, ed.step(), run_at(ed.doc, 0), 2)
    case .some {}
    case .none
        panic("it does not split")
    assert(runs_of(ed.doc) == 2, "the runs become two")
    assert(run_at(ed.doc, 0).remark.equals("words on the whole of it"), "it is left in front")
    assert(run_at(ed.doc, 1).remark.equals("words on the whole of it"), "it is left behind too")
    assert(run_at(ed.doc, 1).remark_by.equals("Alice"), "who wrote it carries over too")
    verdict.pass("split, the annotation stays lying on both sides.")

fn test_neighbouring_runs_with_different_remarks_stay_apart(arena: Arena$@) //<
    //< Neighbouring inlines with different annotations are not joined
    //<
    //< Joined, what was said about one would cover both.
    verdict.start("[kspage/edit] runs of differing annotations not being brought together test...")
    ed: = one_para(arena)
    ed.caret.offset = 2
    assert(ed.set_remark("words on the front half", "Alice"), "they were put on the front half")
    ed.caret = caret.at(run_at(ed.doc, 1), 0)
    ed.caret.offset = 2
    assert(ed.set_remark("words on the back half", "Alice"), "they were put on the back half")

    assert(runs_of(ed.doc) == 3, "neighbours or not, they do not become one")
    head: = run_at(ed.doc, 0)
    assert(head.remark.equals("words on the front half"), "the front half's words stay as they were")
    assert(run_at(ed.doc, 1).remark.equals("words on the back half"),
        "the back half holds other words")
    verdict.pass("where the annotations differ, neighbouring runs are not brought together.")

// Layout needs metrics. Why these are fixed: the header of `kspage/model/fixed_font.kspls`.

// ==========================================
// kspage: checks a code block (a paragraph that does not wrap).
// **Wrapping changes the text**: the whitespace at the break is dropped (`skip_spaces` in
// `kspage/lay/line.kspls`), so the indent depth silently changes. A paragraph that does not wrap
// stays one box past the column's width.
// The metrics are fixed (`kspage/model/fixed_font`): ASCII 8px, a line 19.2px.
// ==========================================

priv fn code_sheet(arena: Arena$@): Sheet$@ //<
    //< A table with a wrapping "body" and a non-wrapping "code"
    //<
    //< **Fixed width comes from the style's font**; the fixed metrics ignore the typeface, so only
    //< the wrapping is checked.
    sheet: = Sheet.new(base.root_font(), arena)
    sheet.add("body", paint.inherit_all())
    $mono: paint.Font_spec = paint.inherit_all()
    mono.family = .some("monospace")
    code: = sheet.add("code", mono)
    code.wrap = false
    return sheet

priv const source_line: U8[] = "    let x = 1;" //< the column's width is 40px = 5 ASCII characters
    //<
    //< "    let x = 1;" is 14 characters = 112px, so a wrapping style would split it into lines

priv const spaced_line: U8[] = "aa    bb" //< a text with a run of whitespace
    //<
    //< **Wrapped, the whitespace after the break is dropped**, breaking code aligned with spaces

fn test_no_wrap_keeps_one_box(arena: Arena$@)
    verdict.start("[kspage/code] a paragraph that does not wrap becoming one box test...")
    doc: = Doc.new(arena)
    doc.add_block("code").add_text(source_line)

    page: = flow.layout(doc, code_sheet(arena), fixed.make(), 40.0, arena)
    assert(page.boxes.len == 1, "it does not wrap, so the box is one")
    b: = page.boxes.get(0)
    assert(b.text.equals(source_line), "the text is as it was typed (no whitespace is dropped)")
    assert(base.near(b.rect.w, 112.0),
        "14 ASCII characters = 112px. Past the column's width it stays as it is")
    assert(base.near(page.height, 19.2), "the row is one row high")
    verdict.pass("past the column's width it does not split, and the whitespace stays as it was.")

fn test_wrapping_style_still_splits_and_drops_spaces(arena: Arena$@) //<
    //< **The same text splits under a wrapping style**, losing the whitespace at the split
    verdict.start("[kspage/code] a wrapping style splitting as it always did test...")
    doc: = Doc.new(arena)
    doc.add_block("body").add_text(spaced_line)

    page: = flow.layout(doc, code_sheet(arena), fixed.make(), 40.0, arena)
    assert(page.boxes.len > 1, "on a wrapping style the boxes grow")
    $joined: = Str_builder.new()
    defer joined.free()
    for $i: Sz = 0; i < page.boxes.len; i += 1
        joined.s(page.boxes.get(i).text)
    same: = joined.slice().equals(spaced_line)
    assert(!same, "the whitespace at the split is dropped, so the text changes")
    verdict.pass("that wrapping changes the text is made sure of too.")

fn test_next_block_wraps_again(arena: Arena$@) //<
    //< The paragraph after one that does not wrap wraps again
    //<
    //< Caution: **Do not carry it over to the next paragraph.** The pen is set anew per paragraph
    //< (`Pen.wrap`).
    verdict.start("[kspage/code] what follows a paragraph that does not wrap wrapping test...")
    doc: = Doc.new(arena)
    doc.add_block("code").add_text(source_line)
    doc.add_block("body").add_text(source_line)

    page: = flow.layout(doc, code_sheet(arena), fixed.make(), 40.0, arena)
    assert(page.boxes.len > 2, "the paragraph behind splits, so the boxes are more than two")
    assert(page.boxes.get(0).text.equals(source_line), "the paragraph in front stays one whole")
    verdict.pass("the setting not to wrap does not cross a paragraph.")

priv fn panel_sheet(arena: Arena$@): Sheet$@ //<
    //< A table with a non-wrapping style that has a fill and space before and after
    //<
    //< **With the spacing at 0 there are no stripes**, so the fault checked here would not show.
    sheet: = code_sheet(arena)
    switch sheet.find("code")
    case .some(s)
        s.fill = .some(0xf5f5f5U32)
        s.space_before = 8.0
        s.space_after = 8.0
    case .none
        panic("kspage_code: there is no style 'code'")
    switch sheet.find("body")
    case .some(s)
        s.fill = .some(0xeeeeeeU32)
        s.space_before = 8.0
        s.space_after = 8.0
    case .none
        panic("kspage_code: there is no style 'body'")
    return sheet

fn test_a_run_of_code_lines_is_one_panel(arena: Arena$@) //<
    //< One fenced block is filled by one band
    //<
    //< **Fill the code lines one by one and the background color shows through the gaps between
    //< them** (black and white stripes).
    verdict.start("[kspage/code] rows of code carrying on becoming one band test...")
    doc: = Doc.new(arena)
    doc.add_block("code").add_text("fn main() {")
    doc.add_block("code").add_text("  let x = 1;")
    doc.add_block("code").add_text("}")

    page: = flow.layout(doc, panel_sheet(arena), fixed.make(), 400.0, arena)
    assert(page.panels.len == 1, "three rows and still one band")
    band: = page.panels.get(0)
    assert(base.near(band.rect.h, 57.6),
        "the band's height is three rows (the gaps between do not go in)")
    assert(base.near(page.height, 73.6),
        "the space before and behind is one each, outside the fenced block")
    verdict.pass("rows of code carrying on are one band, with no ground colour peeping between.")

fn test_another_style_breaks_the_run(arena: Arena$@) //<
    //< **Whatever separates fenced blocks keeps them separate**
    //<
    //< Another style or a wrapping paragraph in between ends the band there (otherwise paragraphs
    //< with another look would share the band).
    verdict.start("[kspage/code] another style coming in between cutting the fenced block test...")
    doc: = Doc.new(arena)
    doc.add_block("code").add_text("fn main() {")
    doc.add_block("body").add_text("This is the body.")
    doc.add_block("code").add_text("}")

    page: = flow.layout(doc, panel_sheet(arena), fixed.make(), 400.0, arena)
    assert(page.panels.len == 3, "the band is another per style")
    for $i: Sz = 0; i < page.panels.len; i += 1
        assert(base.near(page.panels.get(i).rect.h, 19.2), "every band is one row high")
    verdict
        .pass("the paragraph that came in between cuts the fenced block, and the bands become \
            three.")

fn test_indent_is_room_inside_the_panel(arena: Arena$@) //<
    //< **An indent does not narrow the region**
    //<
    //< Narrowed, the fill would start right of the indent and leave a strip of background color
    //< left of the code (on a list, before the marker).
    verdict.start("[kspage/code] the indent becoming the space inside the fill test...")
    doc: = Doc.new(arena)
    doc.add_block("code").add_text("fn main() {")

    sheet: = panel_sheet(arena)
    switch sheet.find("code")
    case .some(s)
        s.indent = 8.0
    case .none
        panic("kspage_code: there is no style 'code'")
    page: = flow.layout(doc, sheet, fixed.make(), 400.0, arena)
    assert(page.panels.len == 1, "the band is one")
    band: = page.panels.get(0)
    assert(base.near(band.rect.x, 0.0),
        "the band's left edge is the region's left edge (in front of the indent)")
    assert(base.near(band.rect.w, 400.0), "the band's width is the whole region")
    assert(page.boxes.len == 1, "the box is one")
    assert(base.near(page.boxes.get(0).rect.x, 8.0), "the text alone comes right by the indent")
    verdict
        .pass("the indent only lowers the contents, and the fill comes out across the whole region.")
fn test_pad_is_room_between_the_band_and_the_text(arena: Arena$@) //<
    //< **The line-height multiple cannot stand in for the padding**
    //<
    //< It widens the gaps between lines too, and the line spacing looks too large.
    verdict.start("[kspage/code] the space inside going between the band and the contents test...")
    doc: = Doc.new(arena)
    doc.add_block("code").add_text("fn main() {")
    doc.add_block("code").add_text("}")

    sheet: = panel_sheet(arena)
    switch sheet.find("code")
    case .some(s)
        s.pad = 10.0
    case .none
        panic("kspage_code: there is no style 'code'")
    page: = flow.layout(doc, sheet, fixed.make(), 400.0, arena)
    assert(page.panels.len == 1, "the band is one")
    band: = page.panels.get(0)
    // Two lines = 38.4px. With 10px padding above and below, 58.4px.
    assert(base.near(band.rect.h, 58.4), "the band is 10px taller than the contents above and below")
    assert(base.near(band.rect.x, 0.0),
        "the band's left edge is the region's left edge (in front of the space)")
    assert(base.near(band.rect.w, 400.0), "the band's width is the whole region too")
    assert(page.boxes.len == 2, "the boxes are two")
    assert(base.near(page.boxes.get(0).rect.x, 10.0), "the text comes right by the space")
    assert(base.near(page.boxes.get(0).rect.y, 18.0),
        "the first row is below the space before and the space inside")
    // The gap between lines stays one line (the multiple is unchanged).
    assert(base.near(page.boxes.get(1).rect.y - page.boxes.get(0).rect.y, 19.2),
        "the gap between the rows does not open")
    assert(base.near(page.height, 74.4), "the space before and behind is outside the band")
    verdict
        .pass("the space inside goes between the band and the contents alone, and the gap between \
            the rows does not open.")

fn test_pad_does_not_narrow_the_next_block(arena: Arena$@) //<
    //< A block's padding does not narrow the next block
    //<
    //< Caution: **Restore the region's right edge**, or the next sibling of a block with padding is
    //< laid out narrower by that much (the number of wraps changes).
    verdict.start("[kspage/code] the space inside not being left for the next block test...")
    doc: = Doc.new(arena)
    doc.add_block("code").add_text("x")
    doc.add_block("body").add_text("y")

    sheet: = panel_sheet(arena)
    switch sheet.find("code")
    case .some(s)
        s.pad = 40.0
    case .none
        panic("kspage_code: there is no style 'code'")
    page: = flow.layout(doc, sheet, fixed.make(), 400.0, arena)
    assert(page.panels.len == 2, "the bands are two")
    next_band: = page.panels.get(1)
    assert(base.near(next_band.rect.w, 400.0), "the next block's band is the whole region")
    assert(base.near(page.boxes.get(1).rect.x, 0.0),
        "the next block's text starts from the left edge")
    verdict.pass("the space inside acts within that block alone.")

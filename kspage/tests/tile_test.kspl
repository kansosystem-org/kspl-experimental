//< kspage: table cells (merging, the current cell's frame, inserting) and charts
import "kspage/expr/calc"
import "kspage/lay/ask"
import "kspage/lay/caret"
import "kspage/lay/flow"
import "kspage/lay/page" { Page, Panel }
import "kspage/model/collect" { Collect }
import "kspage/model/doc" { Block, Doc }
import "kspage/model/fixed_font" as fixed
import "kspage/model/paint"
import "kspage/model/style" + { Sheet }
import "kspage/tests/base"
import "kspage/write/block"
import "kspage/write/cells"
import "kspage/write/edit"
import "kspage/write/insert"
import "kspage/write/shape" as _shape
import "std/ds" { List }
import "std/math"
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

// ==========================================
// kspage: checks the cells themselves (merging, the frame of the current cell, inserting a table)
// (a golden test).
// **The metrics are fixed (`kspage/model/fixed_font`)** (measure a real font and the answer
// changes with the machine and the version).
// Note: [`grid_test.kspl`](grid_test.kspl) covers how column and row sizes are decided; this
// one, what a cell covers and which cell the cursor is in.
// ==========================================

// ---- merging cells ----

fn test_a_merged_cell_spans_its_columns(arena: Arena$@) //<
    //< A cell merged across is as wide as the columns it covers put together
    verdict.start("[kspage/tile] the breadth of a cell merged across test...")
    d: = Doc.new(arena)
    table: = base.two_by_two(d)
    // The first cell of the first row is merged to the right and the covered cell removed (one
    // set).
    head: = table.children.get(0)
    head.children.get(0).span_cols = 2
    head.children.remove_at(1)

    page: = flow.layout(d, base.grid_sheet(arena), fixed.make(), 200.0, arena)
    assert(page.cells.len == 3, "the cell covered is not laid")
    wide: = page.cells.get(0).rect
    assert(base.near(wide.x, 0.0) && base.near(wide.w, 16.0), "it comes to the width of two columns")
    // The second row is not merged, so the column widths do not change.
    assert(base.near(page.cells.get(2).rect.x, 8.0),
        "the second column of the row below is where it was")
    verdict.pass("a merge across comes to the breadth of the columns it covers put together.")

fn test_a_merged_cell_spans_its_rows(arena: Arena$@) //<
    //< A cell merged downward is as tall as the rows it covers put together
    verdict.start("[kspage/tile] the height of a cell merged downwards test...")
    d: = Doc.new(arena)
    table: = base.two_by_two(d)
    // The first cell of the first row is merged downward over the second row's first column.
    table.children.get(0).children.get(0).span_rows = 2
    table.children.get(1).children.remove_at(0)

    page: = flow.layout(d, base.grid_sheet(arena), fixed.make(), 200.0, arena)
    assert(page.cells.len == 3, "the cell covered is not laid")
    tall: = page.cells.get(0).rect
    assert(base.near(tall.y, 0.0) && base.near(tall.h, 38.4), "it comes to the height of two rows")
    // The cell left in the second row is laid out right of the covered column.
    low: = page.cells.get(2).rect
    assert(base.near(low.x, 8.0) && base.near(low.y, 19.2),
        "the cell of the row below goes into the right column")
    verdict.pass("a merge downwards comes to the height of the rows it covers put together.")

fn test_a_merged_cell_does_not_widen_its_columns(arena: Arena$@) //<
    //< A merged cell does not decide a column's width
    //< **Otherwise the narrow columns would all widen at once.**
    verdict.start("[kspage/tile] a merged cell not widening a column test...")
    d: = Doc.new(arena)
    table: = base.two_by_two(d)
    head: = table.children.get(0)
    wide: = head.children.get(0)
    wide.span_cols = 2
    head.children.remove_at(1)
    // With a long text in it, the column stays at the width of the row below's one ASCII character.
    wide.inlines.get(0).insert(1, "bcdefgh")

    page: = flow.layout(d, base.grid_sheet(arena), fixed.make(), 200.0, arena)
    assert(base.near(page.cells.get(1).rect.w, 8.0),
        "the first column of the row below does not widen")
    assert(base.near(page.cells.get(0).rect.w, 16.0), "the merged cell stays two columns wide")
    verdict.pass("a merged cell does not decide a column's width.")

fn test_merging_absorbs_the_next_cell_and_undoes_in_one_step(arena: Arena$@) //<
    //< It absorbs the neighbour, merges, and undoes in one step
    verdict.start("[kspage/tile] merging cells and going back in one test...")
    d: = Doc.new(arena)
    table: = base.two_by_two(d)
    sheet: = base.grid_sheet(arena)
    ed: = edit.new_editor(d)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed.caret = caret.at(table.children.get(0).children.get(0).inlines.get(0), 0)
    assert(ed.merge_range(page) == cells.Merge_end.alone, "one cell alone is not merged")

    // The selection reaches into the right neighbour, as a drag across the two does.
    ed.caret.anchor = table.children.get(0).children.get(1).inlines.get(0)
    assert(ed.merge_range(page) == cells.Merge_end.done, "it can be merged with the right neighbour")
    head: = table.children.get(0)
    assert(head.children.len == 1, "the cell taken in comes off")
    assert(head.children.get(0).span_cols == 2, "it covers two columns")
    after: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    assert(after.cells.len == 3, "the cells laid drop by one too")

    assert(ed.undo(), "it can be put back in one")
    assert(head.children.len == 2, "the cell taken off comes back")
    assert(head.children.get(0).span_cols == 1, "the merge can be parted too")
    assert(head.children.get(1).inlines.get(0).text().equals("b"), "it goes back with its text")
    verdict.pass("a merge takes the neighbour in, and one step puts it back.")

fn test_splitting_puts_the_covered_cells_back(arena: Arena$@) //<
    //< Split the merge and an empty cell comes back where it was covering
    verdict.start("[kspage/tile] the cells coming back when a merge is parted test...")
    d: = Doc.new(arena)
    table: = base.two_by_two(d)
    sheet: = base.grid_sheet(arena)
    ed: = edit.new_editor(d)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed.caret = caret.at(table.children.get(0).children.get(0).inlines.get(0), 0)
    ed.caret.anchor = table.children.get(1).children.get(0).inlines.get(0)
    ed.merge_range(page)
    assert(table.children.get(1).children.len == 1, "the cell of the row below comes off")

    laid: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    assert(ed.split_cell(laid), "it can be parted")
    assert(table.children.get(0).children.get(0).span_rows == 1, "the covering goes back to one row")
    assert(table.children.get(1).children.len == 2, "a cell comes back where it was covering")
    // The cell comes back empty (the record restores its text).
    back: = table.children.get(1).children.get(0)
    assert(back.inlines.len == 1 && back.inlines.get(0).text().len == 0,
        "the cell that comes back is empty")
    verdict.pass("parted, an empty cell comes back where it was covering.")

fn test_the_frame_marks_the_cell_the_caret_is_in(arena: Arena$@) //<
    //< The cell the cursor is in, and only that cell, gets the frame
    verdict.start("[kspage/tile] the frame pointing at the cell the cursor is in test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("outside")
    base.two_by_two(d)

    // The boxes come as "outside", a, b, c, d; the table starts one line lower.
    page: = flow.layout(d, base.grid_sheet(arena), fixed.make(), 200.0, arena)
    in_c: = caret.cell_frame(page, caret.at(page.boxes.get(3).inline, 0))
    switch in_c
    case .some(r)
        assert(base.near(r.x, 0.0) && base.near(r.y, 38.4),
            "it is the place of the second row's first column")
        assert(base.near(r.w, 8.0) && base.near(r.h, 19.2),
            "it is that column's width and that row's height")
    case .none
        assert(false, "inside a cell the frame comes out")

    // Outside a table there is none.
    outside: = caret.cell_frame(page, caret.at(page.boxes.get(0).inline, 0))
    if _r: = outside
        assert(false, "on the body no frame comes out")
    verdict.pass("the frame fences the cell the cursor is in and nothing else.")

fn test_the_frame_is_the_innermost_cell(arena: Arena$@) //<
    //< In a table within a table, the inner cell gets the frame
    verdict.start("[kspage/tile] the frame becoming the inner cell test...")
    d: = Doc.new(arena)
    outer: = d.add_block("table")
    row: = outer.add_child("row")
    left: = row.add_child("cell")
    inner: = left.add_child("table")
    ir: = inner.add_child("row")
    ir.add_child("cell").add_text("a")
    ir.add_child("cell").add_text("b")
    row.add_child("cell").add_text("z")

    page: = flow.layout(d, base.grid_sheet(arena), fixed.make(), 200.0, arena)
    // The outer cell comes first and the inner one after.
    assert(page.cells.len == 4, "two outside and two inside")
    outer_w: = page.cells.get(0).rect.w
    assert(base.near(outer_w, 16.0), "what comes in first is the outer cell holding the inner table")

    // "a" is inside both cells; the outer one's 16px would be the wrong answer.
    frame: = caret.cell_frame(page, caret.at(page.boxes.get(0).inline, 0))
    switch frame
    case .some(r)
        assert(base.near(r.w, 8.0), "it is the inner first column's width")
    case .none
        assert(false, "the frame comes out inside a nesting too")
    verdict.pass("in a nesting the innermost cell becomes the frame.")
fn test_a_cell_does_not_split_into_paragraphs(arena: Arena$@) //<
    //< inside a cell no paragraph is split
    //< Split, that row alone would gain a cell and the table's shape would break.
    verdict.start("[kspage/tile] not splitting a paragraph inside a cell test...")
    d: = Doc.new(arena)
    table: = base.two_by_two(d)
    ed: = edit.new_editor(d)

    sheet: = base.grid_sheet(arena)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed.caret = caret.at(page.boxes.get(0).inline, 0)
    assert(!ed.split_block(page, sheet), "it does not split")
    assert(!ed.join_prev(page), "it does not join onto the cell before either")
    assert(table.line_count(.row) == 2, "the rows stay two")
    assert(table.children.get(0).children.len == 2, "the first row's cells stay two too")
    verdict
        .pass("pressed inside a cell no paragraph splits, and the table's shape does not change.")
fn test_a_table_is_inserted_after_the_caret(arena: Arena$@) //<
    //< An empty table can be inserted after the paragraph the cursor is in
    //< **Where there is no grid style it makes one**, or the table would be laid out as paragraphs.
    verdict.start("[kspage/tile] a table being insertable test...")
    d: = Doc.new(arena)
    head: = d.add_block("body").add_text("body")
    d.add_block("body").add_text("after")
    // It starts from a table with no grid style yet.
    sheet: = Sheet.new(base.root_font(), arena)
    ed: = edit.new_editor(d)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed.caret = caret.at(head, 0)

    assert(ed.insert_table(page, sheet, "table", 2, 2), "it inserts")
    assert(d.blocks.len == 3, "one grows behind the paragraph the cursor is in")
    table: = d.blocks.get(1)
    assert(table.line_count(.row) == 2, "there are two rows")
    assert(table.children.get(0).children.len == 2, "there are two cells to a row")
    first: = table.children.get(0).children.get(0).inlines.get(0)
    assert(ed.caret.inline == first && ed.caret.offset == 0, "the cursor goes into the first cell")

    // They are laid out as cells.
    after: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    assert(after.cells.len == 4, "four cells are laid")
    // Inside a cell of the inserted table, it does not insert again.
    assert(!ed.insert_table(after, sheet, "table", 2, 2), "inside a cell it does not insert")

    // **The cells get a cell style**; without it, they have no padding and no line, text touching
    // text. It is made through the record, so the same undo removes it together with the table.
    first_cell: = table.children.get(0).children.get(0)
    assert(first_cell.style.len > 0, "a fresh cell carries a style name")
    switch sheet.find(first_cell.style)
    case .some(cs)
        assert(style.cell_like(cs), "the cell's style has a cell's part (an inner space, no mark)")
        assert(cs.rule_width > 0.0, "the cell's style draws the grid's line")
    case .none
        assert(false, "the cell's style is on the table")

    assert(ed.undo(), "it can be put back in one")
    assert(d.blocks.len == 2, "the table and the styles made come off together")
    assert(sheet.styles.len == 0, "the style table goes back too")
    verdict.pass("a table goes in behind the cursor's paragraph, and goes back in one.")

fn test_a_table_takes_the_size_pressed(arena: Arena$@) //<
    //< The size is the click's: three rows and four columns give three rows of four cells
    //< Below one row or one column nothing is inserted (there is no table without cells).
    verdict.start("[kspage/tile] the size pressed test...")
    d: = Doc.new(arena)
    head: = d.add_block("body").add_text("body")
    sheet: = Sheet.new(base.root_font(), arena)
    ed: = edit.new_editor(d)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed.caret = caret.at(head, 0)
    assert(!ed.insert_table(page, sheet, "table", 0, 4), "no rows inserts nothing")
    assert(!ed.insert_table(page, sheet, "table", 3, 0), "no columns inserts nothing")
    assert(d.blocks.len == 1, "a refused size leaves the document as it was")
    assert(ed.insert_table(page, sheet, "table", 3, 4), "three by four inserts")
    table: = d.blocks.get(1)
    assert(table.line_count(.row) == 3, "there are three rows")
    for y in Range.asc(3)
        assert(table.children.get(y).children.len == 4, "every row holds four cells")
    after: = flow.layout(d, sheet, fixed.make(), 400.0, arena)
    assert(after.cells.len == 12, "twelve cells are laid")
    verdict.pass("a table takes the size pressed, and refuses a size with nothing in it.")

fn test_a_fresh_table_spans_the_text(arena: Arena$@) //<
    //< A new table's columns get equal shares of the width it is laid out to
    //< So it spans the text and keeps that width when the page is laid out wider. The table's
    //< indent and padding narrow what the columns share, as the flow narrows any block.
    verdict.start("[kspage/tile] a fresh table's width test...")
    d: = Doc.new(arena)
    head: = d.add_block("body").add_text("body")
    sheet: = Sheet.new(base.root_font(), arena)
    t: = base.table_style(sheet)
    t.indent = 10.0
    t.pad = 4.0
    ed: = edit.new_editor(d)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed.caret = caret.at(head, 0)
    assert(ed.insert_table(page, sheet, "table", 2, 4), "two by four inserts")
    table: = d.blocks.get(1)
    // The text is 200 wide; the indent takes 10 and the padding 4 on each side.
    $sum: F32 = 0.0
    for c in Range.asc(4)
        switch table.size_of(.column, c)
        case .some(v)
            assert(base.near(v, 45.5), "every column is named the same quarter")
            sum += v
        case .none
            assert(false, "a column was left unnamed")
    assert(base.near(sum, 182.0), "together they fill the width the table is laid to")
    wide: = flow.layout(d, sheet, fixed.make(), 400.0, arena)
    first: = wide.cells.get(0)
    last: = wide.cells.get(3)
    assert(base.near(first.rect.x, 14.0), "the grid starts behind the indent and the inner space")
    assert(base.near(last.rect.x + last.rect.w, 196.0),
        "and ends where the text it was put into ended, not where the wider page does")
    assert(ed.undo() && d.blocks.len == 1, "one undo takes the table and its widths back")
    verdict.pass("a fresh table spans the text it was put into, and holds that width.")

fn test_the_heading_band_is_the_first_row(arena: Arena$@) //<
    //< Every top-level table gives a band: its rectangle and its first row's
    //< A table inside a cell gives none.
    //<
    //< It is what the window keeps in view while the table scrolls under the tools.
    verdict.start("[kspage/tile] the heading band test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("above")
    outer: = d.add_block("table")
    r0: = outer.add_child("row")
    r0.add_child("cell").add_text("a")
    r0.add_child("cell").add_text("b")
    r1: = outer.add_child("row")
    r1.add_child("cell").add_text("c")
    holder: = r1.add_child("cell")
    holder.add_text("d")
    inner: = holder.add_child("table")
    inner.add_child("row").add_child("cell").add_text("x")
    sheet: = base.grid_sheet(arena)
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(ask.head_band_count(page) == 1, "the outer table alone names a band")
    band: = ask.head_band_at(page, 0)
    assert(band.found, "the band is found")
    first: = page.cells.get(0)
    assert(base.near(band.row.y, first.rect.y) && base.near(band.row.h, first.rect.h),
        "the band's row is the first row")
    assert(base.near(band.table.y, first.rect.y), "the table's rectangle starts at the first row")
    assert(band.table.h > band.row.h, "and reaches below it")
    $foot: F32 = 0.0
    for c in page.cells
        if c.table == outer && c.rect.y + c.rect.h > foot
            foot = c.rect.y + c.rect.h
    assert(base.near(band.table.y + band.table.h, foot), "down to the last row's foot")
    assert(!ask.head_band_at(page, 1).found, "past the last table there is none")
    verdict.pass("each outermost table names its heading band, and a nested one names none.")

// ---- inserting and removing a column where a merge is in the way ----

priv fn merged_head(d: Doc$@): Block$@ //<
    //< A table whose first row is one cell covering two columns, and whose second row is two cells
    //< **It separates "which column" from "which child"**: the first row has one child and two
    //< columns.
    table: = d.add_block("table")
    r0: = table.add_child("row")
    wide: = r0.add_child("cell")
    wide.add_text("wide")
    wide.span_cols = 2
    r1: = table.add_child("row")
    r1.add_child("cell").add_text("a")
    r1.add_child("cell").add_text("b")
    return table

fn test_a_column_past_the_end_reaches_the_merged_row_too(arena: Arena$@) //<
    //< A column added past the grid's end goes into the merged row as well
    verdict.start("[kspage/grid] a column put in past the end reaching the merged row test...")
    d: = Doc.new(arena)
    table: = merged_head(d)
    sheet: = base.grid_sheet(arena)
    ed: = edit.new_editor(d)

    page: = flow.layout(d, sheet, fixed.make(), 400.0, arena)
    // The cursor into the last column's "b", so the column is added past the grid's end.
    ed.caret = caret.at(table.children.get(1).children.get(1).inlines.get(0), 1)
    assert(ed.add_line(page, .column) == cells.Line_end.done, "it was added")
    // **Counted by child index, the first row has 1 and the wanted column is 2.** So it would be
    // skipped, and the rows would get out of step.
    assert(table.children.get(0).children.len == 2, "the merged row gains a cell as well")
    assert(table.children.get(1).children.len == 3, "the plain row gains one too")
    assert(table.grid_columns(arena) == 3, "the grid is three columns across")

    assert(ed.undo(), "it can be put back in one")
    assert(table.children.get(0).children.len == 1, "the merged row goes back to what it was")
    assert(table.children.get(1).children.len == 2, "and so does the plain row")
    verdict.pass("a column put in past the end reaches the row holding a merge too.")

fn test_a_column_over_a_merge_widens_it(arena: Arena$@) //<
    //< A column landing on a cell that spans more than one column widens that cell
    verdict.start("[kspage/grid] a column put in over a merge widening it test...")
    d: = Doc.new(arena)
    table: = merged_head(d)
    sheet: = base.grid_sheet(arena)
    ed: = edit.new_editor(d)

    page: = flow.layout(d, sheet, fixed.make(), 400.0, arena)
    // The cursor into the merged cell, so the column lands on the merge.
    ed.caret = caret.at(table.children.get(0).children.get(0).inlines.get(0), 0)
    assert(ed.add_line(page, .column) == cells.Line_end.done, "it was added")
    // **The merge is those columns held as one**, so the column widens it rather than cutting it
    // (Excel's answer too).
    assert(table.children.get(0).children.get(0).span_cols == 3, "the merge grows by one column")
    assert(table.children.get(0).children.len == 1, "and no cell goes into that row")
    assert(table.children.get(1).children.len == 3, "the plain row gains a cell")
    assert(table.grid_columns(arena) == 3, "so both rows are three columns across")

    assert(ed.undo(), "it can be put back in one")
    assert(table.children.get(0).children.get(0).span_cols == 2, "the merge narrows back")
    assert(table.children.get(1).children.len == 2, "and the plain row gives its cell up")
    verdict.pass("a column put in over a merge widens the merge, and one undo narrows it back.")

fn test_dropping_a_column_narrows_a_merge_and_comes_home(arena: Arena$@) //<
    //< Removing a column narrows the cell that spans it, and one undo restores the span
    verdict.start("[kspage/grid] taking a column off narrowing a merge test...")
    d: = Doc.new(arena)
    table: = merged_head(d)
    sheet: = base.grid_sheet(arena)
    ed: = edit.new_editor(d)

    page: = flow.layout(d, sheet, fixed.make(), 400.0, arena)
    ed.caret = caret.at(table.children.get(0).children.get(0).inlines.get(0), 0)
    assert(ed.drop_line(page, .column), "it was deleted")
    assert(table.children.get(0).children.get(0).span_cols == 1, "the merge loses one column")
    assert(table.children.get(1).children.len == 1, "the plain row loses its first cell")

    // **A cell narrowed to one column cannot be told from one that always spanned one.** So the
    // record keeps each row's span. Read from the table, undo would put a cell into the merged row.
    assert(ed.undo(), "it can be put back in one")
    assert(table.children.get(0).children.len == 1, "the merged row holds one cell still")
    assert(table.children.get(0).children.get(0).span_cols == 2, "and its span comes home")
    assert(table.children.get(1).children.len == 2, "the plain row gets its cell back")
    verdict.pass("taking a column off narrows the merge, and one undo puts the span back.")

// ==========================================
// kspage: checks charts (a golden test).
// ==========================================

priv fn near_px(a: F32, b: F32): Bool //< whether two chart lengths agree within half a pixel
    d: = a - b
    return math.abs(d) < 0.5F32

priv fn chart_sheet(arena: Arena$@, kind: Collect, height: F32): Sheet$@ //<
    //< A table's style, and a chart's style
    sheet: = Sheet.new(base.root_font(), arena)
    base.table_style(sheet)
    c: = sheet.add("chart", paint.inherit_all())
    c.collect = kind
    c.height = height
    c.fill = .some(0x0000ffU32)
    c.rule_width = 1.0
    return sheet

priv fn bare_chart_sheet(arena: Arena$@, kind: Collect): Sheet$@ //<
    //< A chart style that sets only the height, and neither a line nor a fill
    //< **This shape hits "nothing is drawn"**; a document not made by inserting (loaded, from
    //< Markdown, built by hand) can have it.
    sheet: = Sheet.new(base.root_font(), arena)
    base.table_style(sheet)
    c: = sheet.add("chart", paint.inherit_all())
    c.collect = kind
    c.height = 120.0
    return sheet

priv fn doc_with_chart(arena: Arena$@, range: U8[], a: U8[], b: U8[], c: U8[]): Doc$@ //<
    //< A table with one column named "detail", and a chart pointing at it
    d: = Doc.new(arena)
    t: = d.add_block("table")
    t.name = "detail"
    t.add_child("").add_child("").add_text(a)
    t.add_child("").add_child("").add_text(b)
    t.add_child("").add_child("").add_text(c)
    g: = d.add_block("chart")
    g.chart = range
    return d

priv fn bands_of(page: Page$@, chart: Block$@, arena: Arena$@): List<|Panel$@|>$@ //<
    //< Collects only the bands of the chart's block
    out: = List<|Panel$@|>.create(arena)
    for $i: Sz = 0; i < page.panels.len; i += 1
        if page.panels.get(i).block == chart
            out.push(page.panels.get(i))
    return out

priv fn laid(d: Doc$@, sheet: Sheet$@, arena: Arena$@): Page$@
    calc.recalc(d, sheet)
    return flow.layout(d, sheet, fixed.make(), 300.0, arena)

fn test_a_bar_stands_for_each_value_in_the_range(arena: Arena$@) //<
    //< As many bars as values in the range, each as tall in proportion to its value
    //< **Start them from 0**; showing only the differences makes a short bar look long.
    verdict.start("[kspage/chart] a bar standing per value test...")
    d: = doc_with_chart(arena, "detail!A1:A3", "10", "20", "30")
    sheet: = chart_sheet(arena, .bars, 120.0)
    page: = laid(d, sheet, arena)

    bands: = bands_of(page, d.blocks.get(1), arena)
    // Three bars, and one axis drawn at 0.
    assert(bands.len == 4, "as many bands come out as there are bars")
    low: = bands.get(0)
    high: = bands.get(2)
    assert(high.rect.h > low.rect.h, "the bar of the larger value is taller")
    assert(near_px(high.rect.h, low.rect.h * 3.0F32), "the height is in proportion to the value")
    assert(low.rect.x < high.rect.x, "the bars line up in the range's order")
    // Every value is positive, so the axis at 0 is at the bars' bottom edge.
    axis: = bands.get(3)
    assert(near_px(axis.rect.h, 0.0), "the axis is a line holding no height")
    assert(near_px(axis.rect.y, low.rect.y + low.rect.h), "the axis comes at the bars' bottom edge")
    verdict.pass("a bar stands per value in the range, from 0 to the value's height.")

fn test_each_value_gets_a_label_that_is_not_in_the_document(arena: Arena$@) //<
    //< A value's text appears as a box
    //< **It points at no text in the document** (a click cannot get inside it).
    verdict.start("[kspage/chart] the values' texts coming out test...")
    d: = doc_with_chart(arena, "detail!A1:A3", "10", "20", "30")
    sheet: = chart_sheet(arena, .bars, 120.0)
    page: = laid(d, sheet, arena)

    $labels: Sz = 0
    for box in page.boxes
        if box.inline != null
            continue
        labels += 1
        assert(box.text.len > 0, "a box with no text is not put out")
    assert(labels == 3, "as many texts come out as there are values")
    verdict.pass("a value's text comes out as a box, but becomes no place in the document.")

fn test_a_line_chart_joins_the_points(arena: Arena$@) //< a line joins point to point
    //< **With one point no line is drawn.**
    verdict.start("[kspage/chart] a line joining the points test...")
    d: = doc_with_chart(arena, "detail!A1:A3", "10", "30", "20")
    sheet: = chart_sheet(arena, .lines, 120.0)
    page: = laid(d, sheet, arena)

    bands: = bands_of(page, d.blocks.get(1), arena)
    // Two lines (three points have two gaps) and one axis.
    assert(bands.len == 3, "as many lines come out as there are gaps between the points")
    assert(bands.get(0).shape.same_shape(.rise_line), "the rising line rises to the right")
    assert(bands.get(1).shape.same_shape(.fall_line), "the falling line falls to the right")
    assert(bands.get(0).rect.h > 0.0, "a line holds a height")
    verdict.pass("a line joins point to point as the band's diagonal.")

fn test_a_chart_without_a_height_is_not_placed(arena: Arena$@) //<
    //< With no height set it is not laid out (as with a picture: the core infers no height)
    verdict.start("[kspage/chart] a graph with no height test...")
    d: = doc_with_chart(arena, "detail!A1:A3", "10", "20", "30")
    sheet: = chart_sheet(arena, .bars, 0.0)
    page: = laid(d, sheet, arena)

    assert(bands_of(page, d.blocks.get(1), arena).len == 0, "not one band comes out")
    verdict.pass("a graph whose height is unsettled is not laid.")

fn test_an_unreadable_range_places_nothing(arena: Arena$@) //<
    //< Even with a range that does not read, relayout does not stop
    //< A cell that is not a number is skipped too.
    //< With no value only the axis appears (so fixing the range visibly brings the bars back).
    verdict.start("[kspage/chart] a range that does not read test...")
    sheet: = chart_sheet(arena, .bars, 120.0)
    // A range with no table name. A chart sits in the flow, so it has no table of its own.
    bare: = doc_with_chart(arena, "A1:A3", "10", "20", "30")
    bare_page: = laid(bare, sheet, arena)
    bare_bands: = bands_of(bare_page, bare.blocks.get(1), arena)
    assert(bare_bands.len == 1, "on a range with no name no bar comes out")
    other: = doc_with_chart(arena, "nosuch!A1:A3", "10", "20", "30")
    other_page: = laid(other, sheet, arena)
    other_bands: = bands_of(other_page, other.blocks.get(1), arena)
    assert(other_bands.len == 1, "on a name it does not know no bar comes out")
    junk: = doc_with_chart(arena, "detail!A1:A3x", "10", "20", "30")
    junk_page: = laid(junk, sheet, arena)
    junk_bands: = bands_of(junk_page, junk.blocks.get(1), arena)
    assert(junk_bands.len == 1, "on a text with something left unread no bar comes out")
    mixed: = doc_with_chart(arena, "detail!A1:A3", "10", "x", "30")
    mixed_page: = laid(mixed, sheet, arena)
    bands: = bands_of(mixed_page, mixed.blocks.get(1), arena)
    assert(bands.len == 3, "a cell that is no number becomes no bar")
    verdict.pass("even on a range that does not read, laying out again does not stop.")

fn test_a_formula_cell_becomes_a_bar(arena: Arena$@) //< a formula's result becomes a bar too
    //< **The computed number is read** (a formatted text cannot be turned back into a number).
    verdict.start("[kspage/chart] a formula's answer becoming a bar test...")
    d: = doc_with_chart(arena, "detail!A1:A3", "10", "=A1*2", "30")
    sheet: = chart_sheet(arena, .bars, 120.0)
    // Apply thousands grouping and a currency sign, and the bar's height is still the value.
    money: = sheet.add("money", paint.inherit_all())
    money.number.grouped = true
    money.number.prefix = "$"
    d.blocks.get(0).children.get(1).children.get(0).inlines.get(0).style = "money"
    page: = laid(d, sheet, arena)

    bands: = bands_of(page, d.blocks.get(1), arena)
    assert(bands.len == 4, "a cell holding a formula becomes a bar too")
    assert(near_px(bands.get(1).rect.h, bands.get(0).rect.h * 2.0F32),
        "the height is the answer's value")
    verdict.pass("a formula's answer, and a cell with dressing on it, become a bar at the value.")

fn test_inserting_a_chart_puts_no_content_in_the_document(arena: Arena$@) //<
    //< Insert a chart and the contents still do not go into the document
    //< **One undo takes it back.**
    verdict.start("[kspage/chart] inserting a graph test...")
    d: = Doc.new(arena)
    t: = d.add_block("table")
    t.name = "detail"
    t.add_child("").add_child("").add_text("7")
    head: = d.add_block("body").add_text("body")
    sheet: = chart_sheet(arena, .bars, 120.0)
    ed: = edit.new_editor(d)
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    ed.caret = caret.at(head, 0)

    assert(ed.insert_chart(page, sheet, "chart", "detail!A1", .bars), "it inserts")
    made: = d.blocks.get(2)
    assert(made.children.len == 0 && made.inlines.len == 0,
        "the contents do not go into the document")
    assert(made.chart.equals("detail!A1"), "what it holds is the range and nothing else")
    after: = laid(d, sheet, arena)
    assert(bands_of(after, made, arena).len == 2, "one bar and one axis come out")

    assert(ed.undo(), "it can be put back in one")
    assert(d.blocks.len == 2, "the graph comes off")
    verdict.pass("a graph holds the range alone, and the contents are built when it is laid.")

fn test_a_chart_draws_even_when_the_style_says_no_ink(arena: Arena$@) //<
    //< It draws even with a style that sets neither a line nor a fill
    //< **Do not lay it out invisible**: with nothing shown the user can only think "I got the range
    //< wrong" (Principle 5). A shape differs: its bare frame holds children, a chart none.
    verdict.start("[kspage/chart] a style saying neither a line nor a fill test...")
    d: = doc_with_chart(arena, "detail!A1:A3", "10", "20", "30")
    sheet: = bare_chart_sheet(arena, .bars)
    page: = laid(d, sheet, arena)

    bands: = bands_of(page, d.blocks.get(1), arena)
    assert(bands.len == 4, "three bars and one axis come out")
    // **The bars must have a color**; transparent bands leave the screen looking the same.
    $painted: Sz = 0
    for item in bands
        switch item.fill
        case .some(c)
            assert(c == style.DRAWN_COLOR, "it is the same colour as the inserting side's")
            painted += 1
        case .none {}
    assert(painted == 3, "the bars alone are filled (the axis is a line)")
    assert(bands.get(3).width > 0.0, "a thickness goes into the axis")
    verdict.pass("even on a style saying neither a line nor a fill it draws in the default colour.")

fn test_inserting_a_chart_fills_in_what_the_style_lacks(arena: Arena$@) //<
    //< Inserting one adds the missing settings to the style
    //< Caution: **Test the case where the height and the thickness are already set too.**
    //< Otherwise the change that adds a fill looks "unchanged" and is silently lost.
    verdict.start("[kspage/chart] the inserting putting the settings that are wanting in test...")
    d: = Doc.new(arena)
    t: = d.add_block("table")
    t.name = "detail"
    t.add_child("").add_child("").add_text("7")
    head: = d.add_block("body").add_text("body")
    sheet: = Sheet.new(base.root_font(), arena)
    base.table_style(sheet)
    // A style that already has the height, the thickness and the aggregation, but no fill.
    c: = sheet.add("chart", paint.inherit_all())
    c.collect = .bars
    c.height = 120.0
    c.rule_width = 1.0
    ed: = edit.new_editor(d)
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    ed.caret = caret.at(head, 0)

    assert(ed.insert_chart(page, sheet, "chart", "detail!A1", .bars), "it inserts")
    $inked: = false
    if got: = sheet.find("chart")
        switch got.fill
        case .some(v)
            inked = v == style.DRAWN_COLOR
        case .none {}
    assert(inked, "the fill goes into the style")
    verdict
        .pass("even where the height and the thickness are there already, the fill that is wanting \
            goes in.")

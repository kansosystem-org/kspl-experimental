// ==========================================
// The entry point that runs all of kspage's tests.
// **This is the only `pub` in this package**: the tests live inside the unit, so what they
// inspect needs no mark (which lets [I0402] stay on).
// Caution: **Do not add an entry point for inspection here** — each is one more contract exposed
// beyond the unit.
// **What grows here is the registration**: at 300 lines per function (Principle 3), move the tail
// into the next runner called at the end (`run_kspage` → `run_kspage_more` → the next).
// ==========================================
pub fn run_kspage() //< runs every kspage test
    columns_test.test_width_counts_ascii_as_half_an_em()
    columns_test.test_width_counts_multibyte_as_one_em()
    columns_test.test_width_scales_with_size()
    columns_test.test_empty_text_has_no_width()
    columns_test.test_line_height_adds_the_gap()
    columns_test.test_line_height_scales_with_size()
    columns_test.test_source_is_swappable()
    run(columns_test.test_layout_is_the_same_twice)
    run(flow_test.test_one_short_line_makes_one_box)
    run(flow_test.test_wrapping_breaks_at_spaces)
    run(flow_test.test_wrapping_breaks_between_wide_characters)
    run(flow_test.test_too_narrow_still_places_one_character)
    run(flow_test.test_style_name_changes_the_font)
    run(flow_test.test_unspecified_fields_are_inherited)
    run(flow_test.test_space_and_indent_move_the_block)
    run(flow_test.test_space_after_comes_after_the_children)
    run(flow_test.test_children_stack_under_the_parent_indent)

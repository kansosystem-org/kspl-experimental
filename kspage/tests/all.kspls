priv fn run_kspage_more() //<
    //< **Split off from `run_kspage`** (one function would reach 300 lines, Principle 3)
    run(markdown_test.test_headings_become_hashes_and_keep_their_number)
    run(markdown_test.test_markers_become_list_syntax)

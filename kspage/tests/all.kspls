// ==========================================
// The entry point that runs all of kspage's tests.
// **This is the only `pub` in this package**: the tests live inside the unit, so what they
// inspect needs no mark (which lets [I0402] stay on).
// Caution: **Do not add an entry point for inspection here** — each is one more contract exposed
// beyond the unit.
// **What grows here is the registration**: at 300 lines per function (Principle 3), move the tail
// into the next runner called at the end (`run_kspage` → `run_kspage_more` → the next).
// ==========================================
pub fn run_kspage(builds: fn(src: U8[], arena: Arena$@): Bool) //< runs every kspage test
  font_test.test_width_counts_ascii_as_half_an_em()

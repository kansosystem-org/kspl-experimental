priv fn run(test: fn(arena: Arena$@)) //< runs one test in an arena of its own, freed after it
    //<
    //< **A fresh arena per test**, so nothing one test leaves there reaches the next. Its chunks
    //< start small and grow up to the cap only as a test asks for room.
    arena: = Arena.new(1024 * 1024)
    defer arena.free()
    test(arena)

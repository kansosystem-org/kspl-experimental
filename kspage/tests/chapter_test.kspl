//< kspage: chapter numbers, and references to a heading or a figure from the body
import "kspage/lay/caret"
import "kspage/lay/flow"
import "kspage/lay/page" { Page }
import "kspage/model/doc" + { Doc }
import "kspage/model/fixed_font" as fixed
import "kspage/model/number"
import "kspage/model/paint"
import "kspage/model/style" { Sheet }
import "kspage/tests/base"
import "kspage/write/edit"
import "kspage/write/insert"
import "kspage/write/typing"
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/verdict"

// Layout needs metrics. Why these are fixed: the header of `kspage/model/fixed_font.kspl`.

// ==========================================
// kspage: checks chapter numbers, and references to a heading from the body (cross-references).
// **The number is not stored in the document.** The "1.2" shown is counted from the depth at
// each layout. Written in, one added heading would leave every number and reference after it stale.
// **The style gives the depth (`Style.outline`), the marker the text's format
// (`Marker.outline`).** Storing the depth on the marker too would put the contents' indent out
// of step with the number's digits.
// ==========================================

priv fn outlined_sheet(arena: Arena$@): Sheet$@ //<
    //< The styles of headings down to depth 3. Every one of them assigns a chapter number
    sheet: = Sheet.new(base.root_font(), arena)
    for $lv: Sz = 1; lv <= 3; lv += 1
        name: = arena.text().s("heading\{lv\}").take()
        st: = sheet.add(name, paint.inherit_all())
        st.outline = lv
        st.marker = .outline(".", ". ")
    return sheet

priv fn add_head(d: Doc$@, level: Sz, text: U8[], name: U8[], arena: Arena$@) //< adds one heading
    //<
    //< Give it a name and it can be referred to from the body.
    b: = d.add_block(arena.text().s("heading\{level\}").take())
    b.name = name
    b.add_text(text)

priv fn number_of(page: Page$@, d: Doc$@, at: Sz): U8[] //<
    //< Reads that heading's chapter number from the layout result
    return number.heading_number(page.headings, d.blocks.get(at))

// ---- assigning chapter numbers ----

fn test_chapter_numbers_follow_the_outline_depth(arena: Arena$@) //<
    //< Go deeper and a level is added; come back up and the deeper levels restart
    verdict.start("[kspage/flow] a chapter number following a heading's depth test...")
    d: = Doc.new(arena)
    sheet: = outlined_sheet(arena)
    add_head(d, 1, "Start", "", arena)
    add_head(d, 2, "One", "", arena)
    add_head(d, 3, "Detail", "", arena)
    add_head(d, 2, "Two", "", arena)
    add_head(d, 1, "Next", "", arena)

    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(number_of(page, d, 0).equals("1"), "depth 1 is 1")
    assert(number_of(page, d, 1).equals("1.1"), "depth 2 is 1.1")
    assert(number_of(page, d, 2).equals("1.1.1"), "depth 3 is 1.1.1")
    assert(number_of(page, d, 3).equals("1.2"), "the next at the same depth is 1.2")
    // **Restart the deeper levels.** Otherwise a number like 2.3 would appear.
    assert(number_of(page, d, 4).equals("2"),
        "back at depth 1 it is 2, and the deeper places are dropped")
    verdict
        .pass("the depth decides the places, and back at a shallower one the deeper places are \
            counted afresh.")

fn test_a_skipped_depth_shows_as_zero(arena: Arena$@) //<
    //< **A skipped depth shows as 0.** Collapsed, the skip could not be seen in the number
    verdict.start("[kspage/flow] a depth skipped coming out as 0 test...")
    d: = Doc.new(arena)
    sheet: = outlined_sheet(arena)
    add_head(d, 1, "Start", "", arena)
    add_head(d, 3, "Deep at once", "", arena)

    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(number_of(page, d, 1).equals("1.0.1"), "skipping depth 2 gives 1.0.1")
    verdict.pass("a depth skipped is seen as 0.")

fn test_an_unnumbered_heading_still_counts_its_depth(arena: Arena$@) //<
    //< A heading whose marker is not a chapter number has no text
    //<
    //< **The depth is counted all the same.**
    verdict.start("[kspage/flow] a heading with no number still counting the depth test...")
    d: = Doc.new(arena)
    sheet: = outlined_sheet(arena)
    // Depth 1 alone assigns no number.
    switch sheet.find("heading1")
    case .some(top)
        top.marker = .none
    case .none
        assert(false, "the heading1 is there")
    add_head(d, 1, "Start", "", arena)
    add_head(d, 2, "One", "", arena)

    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(number_of(page, d, 0).len == 0, "a heading with no number holds no text")
    // With that level suppressed, it counts from 1.
    assert(number_of(page, d, 1).equals("1.1"), "depth 2 stays 1.1")
    verdict.pass("it puts no text out, but the depth is counted.")

fn test_the_number_shows_at_the_head_of_the_paragraph(arena: Arena$@) //<
    //< A chapter number appears at the start of a paragraph
    //<
    //< **The text set beside it appears with it.**
    verdict.start("[kspage/flow] a chapter number coming out at a paragraph's head test...")
    d: = Doc.new(arena)
    sheet: = outlined_sheet(arena)
    add_head(d, 1, "Start", "", arena)
    add_head(d, 2, "One", "", arena)

    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    // A marker's box points at no document (its `inline` is null); that is what makes it a marker.
    $marks: = Str_builder.new()
    for $i: Sz = 0; i < page.boxes.len; i += 1
        bx: = page.boxes.get(i)
        if bx.inline == null
            marks.s(bx.text).c('|')
    assert(marks.slice().equals("1. |1.1. |"), "the row-head marks are `1. ` and `1.1. `")
    verdict.pass("a chapter number comes out at the head when it is laid.")

// ---- referring to a heading from the body ----

fn test_a_reference_to_a_heading_shows_its_chapter_number(arena: Arena$@) //<
    //< Name a heading, refer to it from the body, and its chapter number is shown
    verdict.start("[kspage/flow] a heading being callable from the body test...")
    d: = Doc.new(arena)
    sheet: = outlined_sheet(arena)
    sheet.add("body", paint.inherit_all())
    add_head(d, 1, "Start", "", arena)
    add_head(d, 2, "One", "target", arena)
    body: = d.add_block("body")
    body.add_text("here")
    run: = body.inlines.get(0)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(run, run.text().len)

    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(ed.insert_refer(page, sheet, "target"), "it was called")
    called: = body.inlines.get(1)
    assert(called.refers.equals("target"),
        "what the document holds is the name of what it points at")
    assert(called.text().len == 0, "the number does not go in as a text")
    flow.layout(d, sheet, fixed.make(), 300.0, arena)
    // **A chapter number is only the number** (no text like the "Figure " of "Figure 2"); the words
    // around it belong to the referring body.
    assert(called.showing().equals("1.1"), "called, it is seen as 1.1")

    // **Add a chapter before it and the number changes too**; else it would stay stale as typed.
    head: = doc.new_block("heading1", arena)
    head.add_text("cut in")
    d.blocks.insert(0, head)
    flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(called.showing().equals("2.1"), "a chapter going in in front makes it 2.1")
    verdict
        .pass("it holds the name it calls and nothing else, and the number is counted afresh every \
            laying.")

fn test_a_reference_to_a_missing_heading_shows_a_question_mark(arena: Arena$@) //<
    //< Where the target is gone, a `!` is shown
    //<
    //< Showing a removed chapter's old number as it is, the reader could not notice.
    verdict.start("[kspage/flow] a ? coming out where a heading that has gone is called test...")
    d: = Doc.new(arena)
    sheet: = outlined_sheet(arena)
    sheet.add("body", paint.inherit_all())
    add_head(d, 1, "Start", "target", arena)
    body: = d.add_block("body")
    body.add_text("here")
    run: = body.inlines.get(0)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(run, run.text().len)
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(ed.insert_refer(page, sheet, "target"), "it was called")
    called: = body.inlines.get(1)

    d.blocks.get(0).name = ""
    flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(called.showing().equals("?"), "where what it points at is not there a ? comes out")
    verdict.pass("calling a heading that has gone puts a ? out.")

// ==========================================
// kspage: checks references to a figure from the body (cross-references).
// **The document holds only the target's name.** "Figure 2" is counted at every layout; written
// in, one added figure would leave every reference after it stale.
// **Only a block with a running number can be referred to.** A number counted among siblings
// changes with whatever comes in between, so referred to from far away it points at another thing.
// ==========================================

// ---- referring to a figure from the body (a cross-reference) ----

priv fn named_figures(d: Doc$@, arena: Arena$@): Sheet$@ //<
    //< A document with two figure headings and one body paragraph
    sheet: = Sheet.new(base.root_font(), arena)
    fig: = sheet.add("figure", paint.inherit_all())
    fig.indent = 40.0
    fig.marker = .serial("Figure ", ". ")
    first: = d.add_block("figure")
    first.name = "the first figure"
    first.add_text("a")
    d.add_block("body").add_text("cc")
    second: = d.add_block("figure")
    second.name = "the next figure"
    second.add_text("d")
    return sheet

fn test_a_reference_shows_the_number_of_the_figure_it_names(arena: Arena$@) //<
    //< A reference from the body shows that figure's number
    //<
    //< The number is not stored in the document (it is counted at every layout).
    verdict.start("[kspage/insert] a figure being callable from the body test...")
    d: = Doc.new(arena)
    sheet: = named_figures(d, arena)
    body: = d.blocks.get(1).inlines.get(0)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(body, body.text().len)

    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(ed.insert_refer(page, sheet, "the next figure"), "it was called")
    runs: = d.blocks.get(1).inlines
    assert(runs.len == 2, "the calling run grows by one")
    called: = runs.get(1)
    assert(called.refers.equals("the next figure"),
        "what the document holds is the name of what it points at")
    assert(called.text().len == 0, "the number does not go in as a text")
    after: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(called.showing().equals("Figure 2"),
        "the second figure is called, so it is seen as Figure 2")
    assert(after.boxes.len > 0, "it lays out")

    // **Add a figure before it and the number changes too.**
    fresh: = d.blocks.get(0)
    head: = doc.new_block("figure", arena)
    head.add_text("e")
    d.blocks.insert(0, head)
    assert(fresh != null, "the original figure is left")
    flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(called.showing().equals("Figure 3"), "a figure going in in front makes it Figure 3")
    verdict
        .pass("it holds the name it calls and nothing else, and the number is counted afresh every \
            laying.")

fn test_a_reference_lands_in_the_middle_of_a_run(arena: Arena$@) //<
    //< Inserted in the middle of a text, it goes there and the second half stays
    //<
    //< Caution: **Split the inline before inserting.**
    verdict.start("[kspage/insert] a calling text going into the middle of a text test...")
    d: = Doc.new(arena)
    sheet: = named_figures(d, arena)
    body: = d.blocks.get(1).inlines.get(0)
    ed: = edit.new_editor(d)
    // After the first character of "cc".
    ed.caret = caret.at(body, 1)

    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(ed.insert_refer(page, sheet, "the first figure"), "it can be called mid-text too")
    runs: = d.blocks.get(1).inlines
    assert(runs.len == 3, "it becomes the three of the front, the calling text and the back half")
    assert(runs.get(0).text().equals("c"), "the front half is left")
    assert(runs.get(1).refers.equals("the first figure"), "the middle is the calling run")
    // **The document holds no text for it.**
    assert(runs.get(1).text().len == 0, "the calling run holds no text")
    assert(runs.get(2).text().equals("c"), "the back half is left too")
    flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(runs.get(1).showing().equals("Figure 1"),
        "the first figure is called, so it is seen as Figure 1")
    verdict.pass("called mid-text, the text in front and behind is left.")

fn test_a_reference_to_a_missing_figure_shows_a_question_mark(arena: Arena$@) //<
    //< Where the target is gone, a `!` is shown
    //<
    //< A stale number would go unnoticed by the reader.
    verdict.start("[kspage/flow] a ? coming out where a figure that has gone is called test...")
    d: = Doc.new(arena)
    sheet: = named_figures(d, arena)
    body: = d.blocks.get(1).inlines.get(0)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(body, body.text().len)
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(ed.insert_refer(page, sheet, "the next figure"), "it was called")
    called: = d.blocks.get(1).inlines.get(1)

    // The name of the figure it referred to is removed.
    d.blocks.get(2).name = ""
    flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(called.showing().equals("?"), "where what it points at is not there it is a ?")
    verdict.pass("calling a figure that has gone puts a ? out.")

fn test_a_block_without_a_serial_number_cannot_be_called(arena: Arena$@) //<
    //< What has no number cannot be referred to
    //<
    //< The reason is in this file's header.
    verdict.start("[kspage/insert] what holds no number not being callable test...")
    d: = Doc.new(arena)
    sheet: = named_figures(d, arena)
    plain: = d.blocks.get(1)
    plain.name = "just a paragraph"
    body: = plain.inlines.get(0)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(body, body.text().len)

    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(!ed.insert_refer(page, sheet, "just a paragraph"),
        "a paragraph with no number cannot be called")
    assert(!ed.insert_refer(page, sheet, "nowhere at all"),
        "a name that is not there cannot be called either")
    assert(plain.inlines.len == 1, "refused, the runs do not grow either")
    verdict.pass("what can be called is what carries a running number and nothing else.")

fn test_a_reference_run_is_never_split_or_merged(arena: Arena$@) //<
    //< A reference inline is not joined with its neighbour
    verdict.start("[kspage/edit] a calling run not being brought together and coming off test...")
    d: = Doc.new(arena)
    sheet: = named_figures(d, arena)
    body: = d.blocks.get(1).inlines.get(0)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(body, body.text().len)
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(ed.insert_refer(page, sheet, "the next figure"), "it was called")
    runs: = d.blocks.get(1).inlines
    called: = runs.get(1)

    // Joined, the neighbouring text would be rewritten as a number too.
    edit.merge_runs(ed, ed.step(), d.blocks.get(1))
    assert(d.blocks.get(1).inlines.len == 2, "it is not brought together with its neighbour")
    assert(runs.get(1) == called, "the calling run is left as it is")
    // Backspace removes it whole. **It holds no text, so if skipped over it could not be removed.**
    ed.caret = caret.at(called, 0)
    ed.backspace()
    assert(d.blocks.get(1).inlines.len == 1, "Backspace takes the calling run off")
    assert(ed.undo(), "it can be put back")
    assert(d.blocks.get(1).inlines.len == 2, "it goes back in one")
    verdict
        .pass("a calling run is not brought together with its neighbour, and Backspace takes it off \
            whole.")

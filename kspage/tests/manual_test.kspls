//< Checks the manual that ships with kspage (`content/manual.kspage`)
//<
//< **It is an ordinary saved document**, so the checks are the ones any document passes: it reads,
//< it lays out, and it is in the form kspage writes.
import "kspage/lay/flow"
import "kspage/model/fixed_font" as fixed
import "kspage/share/store"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/verdict"

embed "kspage/content/manual.kspage" as manual_text //< the same file the page opens

fn test_the_manual_opens_and_lays_out() //< the manual reads, and lays out with its chapters
    verdict.start("[kspage/manual] the manual opening and being laid out test...")
    arena: = Arena.new(1024 * 1024)
    defer arena.free()
    got: = store.load(manual_text, arena) catch _e
        panic("the manual does not read")
    page: = flow.layout(got.doc, got.sheet, fixed.make(), 600.0, arena)
    assert(page.boxes.len > 0, "the manual lays out")
    // **The chapters are counted by layout**, so a heading lost on the way shows here.
    assert(page.headings.len >= 10, "the manual's headings come out")
    verdict.pass("the manual opens and lays out with its headings.")

fn test_the_manual_is_in_the_saved_form() //< saving the manual again changes not one byte
    //<
    //< **Edited in kspage, it stays the same file**: a hand edit in another shape would turn every
    //< later save into a diff over the whole file.
    verdict.start("[kspage/manual] the manual being in the form kspage writes test...")
    arena: = Arena.new(1024 * 1024)
    defer arena.free()
    got: = store.load(manual_text, arena) catch _e
        panic("the manual does not read")
    $again: = Str_builder.new()
    defer again.free()
    store.save(got.doc, got.sheet, again@)
    assert(again.slice().equals(manual_text), "written again, the manual is the same bytes")
    verdict.pass("the manual is in the form kspage writes.")

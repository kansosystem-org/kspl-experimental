//< kspage: copy, cut and paste, and converting between a table and CSV text
import "kspage/expr/calc"
import "kspage/lay/ask"
import "kspage/lay/caret"
import "kspage/lay/flow"
import "kspage/lay/page" { Page }
import "kspage/model/doc" + { Block, Doc }
import "kspage/model/filter"
import "kspage/model/fixed_font" as fixed
import "kspage/model/run"
import "kspage/model/style" as _style + { Sheet }
import "kspage/tests/base"
import "kspage/write/block"
import "kspage/write/cells"
import "kspage/write/csv"
import "kspage/write/edit"
import "kspage/write/shape"
import "kspage/write/typing"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/verdict"

// ==========================================
// kspage: copying the selection out, and taking text in (copy, cut, paste).
// **An `Inline` cannot hold a newline** (splitting lines is the layout's job): going out, a
// paragraph break becomes one newline, and coming in the reverse. The deletion part of cutting is
// checked by [`edit_test.kspls`](edit_test.kspls).
// ==========================================

priv fn three_paragraphs(d: Doc$@) //< a document with three paragraphs
    d.add_block("body").add_text("abc")
    d.add_block("body").add_text("XYZ")
    d.add_block("body").add_text("def")

priv fn plain_page(d: Doc$@, arena: Arena$@): Page$@ //< a page of plain flowing text
    //<
    //< A paste checks whether it is inside a cell, so it needs a page.
    return flow.layout(d, Sheet.new(base.root_font(), arena), fixed.make(), 200.0, arena)

priv fn picked(d: Doc$@, c: caret.Caret, sb: Str_builder$@): U8[] //<
    //< The text of the selection
    //<
    //< The returned text lives in `sb` (usable only until the next write into `sb`).
    sb.clear()
    caret.selection_into(d, c, sb)
    return sb.slice()

priv fn para_run(d: Doc$@, i: Sz): run.Inline$@ //< the inline holding a paragraph's text
    return d.blocks.get(i).inlines.get(0)

priv fn para(d: Doc$@, i: Sz): U8[] //< reads one paragraph's text
    return para_run(d, i).text()

// ---- copying out ----

fn test_the_selected_text_comes_out_as_typed(arena: Arena$@)
    verdict.start("[kspage/clip] the text selected coming out as it stands test...")
    $sb: = Str_builder.new()
    defer sb.free()
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("abcd")
    ed: = edit.new_editor(d)

    // With nothing selected it is empty, and neither copy nor cut runs (the JS side decides by it).
    ed.caret = caret.at(n, 1)
    assert(picked(d, ed.caret, sb@).len == 0, "with nothing selected nothing comes out")

    ed.move_right(true)
    ed.move_right(true)
    assert(picked(d, ed.caret, sb@).equals("bc"), "only what was selected comes out")
    verdict.pass("only the range selected comes out, as the text was typed.")

fn test_paragraph_breaks_come_out_as_one_newline(arena: Arena$@) //<
    //< **A paragraph break is one newline.** Without it, the paragraphs would join when pasted back
    verdict.start("[kspage/clip] a paragraph's break becoming one newline test...")
    $sb: = Str_builder.new()
    defer sb.free()
    d: = Doc.new(arena)
    three_paragraphs(d)

    // It selects from the first paragraph's "c" to the third's "de".
    ed: = edit.new_editor(d)
    ed.caret = caret.at(para_run(d, 0), 2)
    ed.caret.inline = para_run(d, 2)
    ed.caret.offset = 2
    assert(picked(d, ed.caret, sb@).equals("c\nXYZ\nde"),
        "the paragraph between is carried by a newline too")
    verdict.pass("across paragraphs, one newline goes in per break.")

fn test_styled_runs_in_one_paragraph_stay_on_one_line(arena: Arena$@) //<
    //< **No newline is added where inlines split within a paragraph**
    //<
    //< Applying a style splits the inlines, and a mere bold would multiply the paragraphs.
    verdict.start("[kspage/clip] a style within a paragraph not growing the newlines test...")
    $sb: = Str_builder.new()
    defer sb.free()
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("abcd")
    ed: = edit.new_editor(d)

    // The middle "bc" is made bold, splitting the inlines into three.
    ed.caret = caret.at(n, 1)
    ed.move_right(true)
    ed.move_right(true)
    assert(ed.set_style("strong"), "the style lies on")
    assert(d.blocks.get(0).inlines.len == 3, "the runs split into three")

    ed.caret = caret.at(d.blocks.get(0).inlines.get(0), 0)
    ed.caret.inline = d.blocks.get(0).inlines.get(2)
    ed.caret.offset = 1
    assert(picked(d, ed.caret, sb@).equals("abcd"), "it stays one row")
    verdict.pass("within the same paragraph it comes out as one row even where the runs split.")

// ---- pasting in ----

fn test_pasting_puts_the_text_at_the_caret(arena: Arena$@)
    verdict.start("[kspage/clip] the text pasted going in at the cursor test...")
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("ad")
    page: = plain_page(d, arena)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, 1)

    assert(ed.paste(page, "bc"), "it pastes")
    assert(para(d, 0).equals("abcd"), "it goes in at the cursor")
    assert(d.blocks.len == 1, "with no newline the paragraphs do not grow")
    assert(ed.caret.offset == 3, "the cursor stands behind the text pasted")
    assert(!ed.paste(page, ""), "an empty text is not pasted")
    verdict.pass("a text with no newline goes in at the cursor as it stands.")

fn test_pasting_lines_makes_paragraphs(arena: Arena$@) //<
    //< **The paragraph count grows by the number of newlines**
    //<
    //< Folded into one paragraph, the newlines would be lost (an `Inline` cannot hold them as
    //< text).
    verdict.start("[kspage/clip] a newline becoming a paragraph's break test...")
    d: = Doc.new(arena)
    d.add_block("body").add_text("")
    page: = plain_page(d, arena)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(para_run(d, 0), 0)

    // A `\r\n` is two bytes and one break. Counted as two, an empty paragraph would appear between.
    assert(ed.paste(page, "one\ntwo\r\nthree"), "it pastes")
    assert(d.blocks.len == 3, "the paragraphs become three")
    assert(para(d, 0).equals("one"), "the first row is the first paragraph")
    assert(para(d, 1).equals("two"), "the second row is the second paragraph")
    assert(para(d, 2).equals("three"), "the third row is the third paragraph")
    verdict.pass("a paragraph splits per newline, and a `\\r\\n` is one break too.")

fn test_pasting_lines_inside_a_paragraph_keeps_the_tail(arena: Arena$@) //<
    //< Paste several lines mid-paragraph and the second half stays after the last line
    verdict.start("[kspage/clip] the back half being left when pasting mid-paragraph test...")
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("az")
    page: = plain_page(d, arena)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, 1)

    assert(ed.paste(page, "b\nc"), "it pastes")
    assert(d.blocks.len == 2, "the paragraphs become two")
    assert(para(d, 0).equals("ab"), "the first row goes on in front")
    // Dropped, the "z" would be lost. The last line goes at the start of the split-off second half.
    assert(para(d, 1).equals("cz"), "the original back half is left behind the last row")
    verdict.pass("pasted mid-paragraph, the paragraph's back half is not deleted.")

fn test_pasting_replaces_the_selection_in_one_undo_step(arena: Arena$@) //<
    //< **Where something is selected, pasting replaces it**
    //<
    //< Inserted without deleting, typing over would become adding.
    //< **One paste is one undo**, not one per line.
    verdict.start("[kspage/clip] a paste replacing in one step test...")
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("aXYd")
    page: = plain_page(d, arena)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, 1)
    ed.move_right(true)
    ed.move_right(true)

    assert(ed.paste(page, "b\nc"), "it pastes")
    assert(d.blocks.len == 2, "the paragraphs grow by the count of rows")
    assert(para(d, 0).equals("ab"), "what was selected goes and the first row goes in")
    assert(para(d, 1).equals("cd"), "the rest carries on into the second paragraph")

    assert(ed.undo(), "it can be put back")
    assert(d.blocks.len == 1, "the paragraphs come back in one step")
    assert(para(d, 0).equals("aXYd"), "the text that had been selected comes back too")
    assert(!ed.undo(), "there is one hand to go back by and no more")
    verdict.pass("a paste replaces what was selected, and goes back in one.")

fn test_pasting_inside_a_cell_folds_the_newlines(arena: Arena$@) //<
    //< **Inside a cell no paragraph is split** (the cell would grow and the table would break)
    //<
    //< A newline becomes one space.
    verdict.start("[kspage/clip] a newline becoming a space inside a cell test...")
    d: = Doc.new(arena)
    table: = d.add_block("table")
    row: = table.add_child("row")
    row.add_child("cell").add_text("a")
    row.add_child("cell").add_text("b")
    sheet: = Sheet.new(base.root_font(), arena)
    base.table_style(sheet)

    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    ed: = edit.new_editor(d)
    ed.caret = caret.at(page.boxes.get(0).inline, 1)
    assert(ed.paste(page, "x\ny"), "it pastes")
    assert(table.line_count(.row) == 1, "the rows stay one")
    assert(table.children.get(0).children.len == 2, "the cells stay two too")
    cell: = row.children.get(0).inlines.get(0).text()
    assert(cell.equals("ax y"), "the newline is folded into one space")
    verdict
        .pass("pasted into a cell the table's shape does not change, and a newline becomes a space.")

fn test_a_copied_range_pastes_back_the_same(arena: Arena$@) //<
    //< Copied out and pasted back, it gives the same shape (both directions share one rule)
    verdict.start("[kspage/clip] copying and pasting back giving the same shape test...")
    $sb: = Str_builder.new()
    defer sb.free()
    d: = Doc.new(arena)
    three_paragraphs(d)
    sheet: = Sheet.new(base.root_font(), arena)
    ed: = edit.new_editor(d)

    ed.caret = caret.at(para_run(d, 0), 0)
    ed.caret.inline = para_run(d, 2)
    ed.caret.offset = 3
    held: = picked(d, ed.caret, sb@)

    ed.caret = caret.at(para_run(d, 2), 3)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)
    assert(ed.paste(page, held), "it pastes")
    assert(d.blocks.len == 5, "three paragraphs grow, and one break is carried onto the end")
    assert(para(d, 2).equals("defabc"), "the first row carries on into the paragraph pasted into")
    assert(para(d, 3).equals("XYZ"), "the paragraph between lines up as it was")
    assert(para(d, 4).equals("def"), "the last row becomes a paragraph too")
    verdict.pass("paste the text carried out back and it lines up at the same breaks.")
// ---- find and replace ----

fn test_finding_walks_the_document_and_wraps(arena: Arena$@) //<
    //< It searches in document order, and at the end it wraps to the start
    verdict.start("[kspage/find] the order of looking and the coming round test...")
    d: = Doc.new(arena)
    head: = d.add_block("body").add_text("ax ay")
    tail: = d.add_block("body").add_text("az")
    ed: = edit.new_editor(d)
    ed.caret = caret.at(head, 0)

    assert(ed.find_next("a"), "it is found")
    assert(ed.caret.anchor == head && ed.caret.anchor_offset == 0, "the first is at the head")
    // It selects the match; only placing the cursor there would leave the match unseen on the
    // screen.
    assert(caret.has_selection(ed.caret), "where it was found is selected")
    assert(ed.find_next("a") && ed.caret.anchor_offset == 3, "it goes on to the second")
    assert(ed.find_next("a") && ed.caret.anchor == tail, "it goes on to the next paragraph too")
    // Without wrapping, nothing would be found after searching to the bottom.
    assert(ed.find_next("a") && ed.caret.anchor == head,
        "reaching the end it comes back to the head")
    wrapped_back: = ed.find_next("a", true) && ed.caret.anchor == tail
    assert(wrapped_back, "backward it comes round to the end")
    assert(ed.find_next("a", true) && ed.caret.anchor_offset == 3, "it goes on further back")
    assert(!ed.find_next("no such text"), "where there is none it is not found")
    assert(!ed.find_next(""), "an empty text is not looked for")
    verdict.pass("the order of looking is the document's order, and at the edge it comes round.")

fn test_finding_crosses_runs_but_not_blocks(arena: Arena$@) //<
    //< it crosses inlines but not paragraphs
    verdict.start("[kspage/find] crossing runs but not paragraphs test...")
    d: = Doc.new(arena)
    b: = d.add_block("body")
    first: = b.add_text("ab")
    b.add_text("cd", "strong")
    d.add_block("body").add_text("ef")
    ed: = edit.new_editor(d)
    ed.caret = caret.at(first, 0)

    // Without crossing, a text that spans a bold part would not be found.
    assert(ed.find_next("bc"), "it is found across the runs")
    assert(ed.caret.anchor == first && ed.caret.anchor_offset == 1, "the start is in the first run")
    ends_in_second: = ed.caret.inline == b.inlines.get(1) && ed.caret.offset == 1
    assert(ends_in_second, "the end is in the second run")
    // No character stands between paragraphs; crossing, one's end and the next's start look joined.
    assert(!ed.find_next("de"), "it does not cross a paragraph")
    verdict.pass("looking crosses runs and does not cross paragraphs.")

fn test_replacing_undoes_in_one_step(arena: Arena$@) //<
    //< One replacement is one undo, and replacing all is also undone in one
    verdict.start("[kspage/find] a replacing going back in one test...")
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("axayaz")
    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, 0)

    assert(ed.replace_next("a", "X"), "one is replaced")
    assert(para(d, 0).equals("Xxayaz"), "the first one alone changes")
    assert(ed.undo() && para(d, 0).equals("axayaz"), "it goes back in one")

    // Wrapping at the end, the replaced text would be found again and it would loop forever.
    assert(ed.replace_all("a", "aa") == 3, "all three are replaced")
    assert(para(d, 0).equals("aaxaayaaz"),
        "even with a text that grows it does not go round for ever")
    assert(ed.undo() && para(d, 0).equals("axayaz"), "the whole goes back in one")
    assert(ed.replace_all("no such text", "X") == 0, "where there is none it is 0")
    verdict.pass("one replacing is one undo, and even a text that grows stops.")

fn test_a_formula_cell_is_not_replaced(arena: Arena$@) //<
    //< A formula's text is not replaced (changed, what it points at and means would change too)
    //<
    //< **The typed text is searched** (a position in the value is no position in the document).
    verdict.start("[kspage/find] not typing over a cell holding a formula test...")
    d: = Doc.new(arena)
    b: = d.add_block("body")
    plain: = b.add_text("12")
    shown: = b.add_text("=1+11")
    ed: = edit.new_editor(d)
    ed.caret = caret.at(plain, 0)

    assert(ed.replace_all("12", "X") == 1, "the text form alone is replaced")
    assert(plain.text().equals("X"), "the text form changes")
    assert(shown.text().equals("=1+11"), "the formula's text does not change")
    ed.caret = caret.at(plain, 0)
    assert(ed.find_next("1+11"), "the formula's text can be looked for")
    ed.caret = caret.at(plain, 0)
    assert(!ed.find_next("12"), "the value worked out is not looked for")
    verdict.pass("both the looking and the typing over are on the text as it was typed.")

// ==========================================
// kspage: checks converting between a table and CSV text (a golden test): one quoting rule for
// reading and writing, rows of equal length, and an insertion undone in one step.
// ==========================================

priv fn cell_text(t: Block$@, r: Sz, c: Sz): U8[]
    return t.children.get(r).children.get(c).inlines.get(0).text()

fn test_a_field_with_commas_and_quotes_survives_the_round_trip(arena: Arena$@) //<
    //< The quoting rule is shared by the reader and the writer
    //<
    //< With two rules, it could not read what it wrote itself.
    verdict.start("[kspage/csv] a fenced field going round test...")
    src: = "a,\"b,c\",\"d\"\"e\"\n1,2,3\n"
    $made: Block$@ = null
    if got: = csv.read_table(src, "table", arena)
        made = got
    assert(made != null, "the table builds")
    assert(made.children.len == 2, "there are two rows")
    assert(cell_text(made, 0, 1).equals("b,c"), "the parting mark inside a fence is text")
    assert(cell_text(made, 0, 2).equals("d\"e"), "doubled quotes become one")

    $out: = Str_builder.new()
    defer out.free()
    csv.write_table(made, out@, arena)
    assert(out.slice().equals(src), "written out it goes back to the original text")
    verdict.pass("a fenced field goes round under the same quoting.")

fn test_short_rows_are_padded_to_the_widest(arena: Arena$@) //<
    //< the rows come out as long as the longest row
    //<
    //< Not padded, the cell count differs row by row and the column count is undefined.
    verdict.start("[kspage/csv] short rows coming out even test...")
    $made: Block$@ = null
    if got: = csv.read_table("a\nb,c,d\ne,f\n", "table", arena)
        made = got
    assert(made != null, "the table builds")
    assert(made.children.get(0).children.len == 3,
        "a short row too comes out the length of the longest")
    assert(cell_text(made, 0, 2).len == 0, "the cells wanting are empty")
    assert(cell_text(made, 2, 1).equals("f"), "the text of the row behind stays as it was")
    verdict.pass("the rows come out the length of the longest row.")

fn test_a_fenced_field_keeps_to_its_row(arena: Arena$@) //<
    //< A line break inside quotes becomes one space, and text after a closing quote stays in it
    //<
    //< A cell's text holds no line break; and read as a row of its own, the text behind a quote
    //< would shift every row after it.
    verdict.start("[kspage/csv] a fenced field keeping to its row test...")
    $made: Block$@ = null
    src: = "\"one\ntwo\",\"three\r\nfour\"\n\"q\"junk,c\nlast,x\n"
    if got: = csv.read_table(src, "table", arena)
        made = got
    assert(made != null, "the table builds")
    assert(made.children.len == 3, "a line break inside quotes starts no row, nor a closing quote")
    assert(cell_text(made, 0, 0).equals("one two"), "a line break inside quotes is one space")
    assert(cell_text(made, 0, 1).equals("three four"), "so is a CR LF")
    assert(cell_text(made, 1, 0).equals("qjunk"), "the text after a closing quote stays in it")
    assert(cell_text(made, 1, 1).equals("c"), "the field after it is the next column")
    assert(cell_text(made, 2, 0).equals("last"), "the rows behind stay as they were")
    verdict.pass("a fenced field keeps to its row and its cell holds no line break.")

fn test_an_empty_source_makes_no_table(arena: Arena$@) //< an empty text makes no table
    //<
    //< A table with no rows has no column count.
    verdict.start("[kspage/csv] an empty text making no table test...")
    if _got: = csv.read_table("", "table", arena)
        assert(false, "no table is built from an empty text")
    verdict.pass("no table is built from an empty text.")

fn test_a_text_a_spreadsheet_would_run_is_guarded(arena: Arena$@) //<
    //< A text starting as a formula does goes out behind a `'`, and comes back in without it
    //<
    //< Unguarded, a spreadsheet opening the file runs `+HYPERLINK(…)` or `@SUM(…)` typed as words.
    //< **A number is never guarded** (`-5` stays `-5`), and the reader takes off just the `'` the
    //< writer put on, so a text already starting with one goes round too.
    verdict.start("[kspage/csv] a formula-looking text guarded test...")
    d: = Doc.new(arena)
    t: = d.add_block("table")
    row: = t.add_child("")
    texts: = U8[][]::{ "-5", "=1+2", "-abc", "+x", "@sum", "\tx", "'=x", "'plain", "a=b" }
    for one in texts
        row.add_child("").add_text(one)
    calc.recalc(d, base.grid_sheet(arena))
    $out: = Str_builder.new()
    defer out.free()
    csv.write_table(t, out@, arena)
    assert(out.slice().equals("-5,3,'-abc,'+x,'@sum,'\tx,''=x,'plain,a=b\n"),
        "only a text a spreadsheet would run is guarded, and no number")
    $back: Block$@ = null
    if got: = csv.read_table(out.slice(), "table", arena)
        back = got
    assert(back != null, "what was written reads back")
    for $i: Sz = 2; i < texts.len; i += 1
        assert(cell_text(back, 0, i).equals(texts[i]), "a guarded text reads back as it was typed")
    verdict.pass("a text a spreadsheet would run goes out guarded and comes back as it was.")

fn test_inserting_a_csv_table_undoes_as_one_step(arena: Arena$@) //<
    //< It inserts after the paragraph the cursor is in
    verdict.start("[kspage/csv] inserting a table from CSV test...")
    d: = Doc.new(arena)
    n: = d.add_block("body").add_text("here")
    sheet: = base.grid_sheet(arena)
    page: = flow.layout(d, sheet, fixed.make(), 200.0, arena)

    ed: = edit.new_editor(d)
    ed.caret = caret.at(n, 0)
    assert(ed.insert_csv(page, sheet, "table", "x,y\n1,2\n"), "it inserts")
    assert(d.blocks.len == 2, "the table goes in behind the paragraph")
    made: = d.blocks.get(1)
    assert(made.style.equals("table"), "the grid style is laid on")
    assert(cell_text(made, 1, 1).equals("2"), "the cells' text goes in")
    // The cursor is in the first cell (typing can continue right away).
    head: = made.children.get(0).children.get(0).inlines.get(0)
    assert(ed.caret.inline == head, "the cursor stands in the first cell")
    assert(ed.undo(), "it goes back in one")
    assert(d.blocks.len == 1, "the table comes off whole")
    verdict.pass("a table inserted from CSV comes off in one undo.")

// ==========================================
// kspage: checks what one column offers to filter by — the values it shows, their order, and a
// filter to a chosen set of them.
// **A person reads down the list in the column's sort order**, so it is checked here, not in the
// page. The effect on layout is [`grid_test.kspls`](grid_test.kspls); the panel is
// `kspage/tests/browser/find.js`.
// ==========================================

priv fn one_column(d: Doc$@): doc.Block$@ //<
    //< A table whose one column holds a number, a text, the same text in another case, and a blank
    //<
    //< **The heading is not a value**; its word would sort first if counted.
    table: = d.add_block("table")
    h: = table.add_child("row")
    h.add_child("cell").add_text("Aname")
    texts: = U8[][]::{ "twenty", "10", "TWENTY", "", "10" }
    for $i: Sz = 0; i < texts.len; i += 1
        table.add_child("row").add_child("cell").add_text(texts[i])
    return table

fn test_a_columns_values_come_in_the_order_it_sorts_in(arena: Arena$@) //<
    //< The values offered are the distinct ones, in the column's sort order, without the heading
    //<
    //< **A number compares as a number** (10 before "twenty"). **Spellings that differ only by case
    //< are one value**: the filter ignores case, so two entries would answer to one checkbox.
    verdict.start("[kspage/narrow] the values one column offers test...")
    d: = Doc.new(arena)
    table: = one_column(d)
    seen: = List<|U8[]|>.create(arena)
    got: = cells.column_values(table, 0, arena, seen)
    assert(seen.len == 2, "the two distinct values come out, the heading and the blank left out")
    assert(seen.get(0).equals("10"), "a number stands first")
    assert(seen.get(1).equals("twenty"), "and the spelling met first is the one kept")
    assert(got.blank, "the blank cell is said apart")
    assert(!got.cut, "nothing was cut, so it does not say it was")
    verdict.pass("a column offers its distinct values in the order it sorts in, blanks said apart.")

fn test_a_chosen_set_keeps_the_rows_showing_one_of_them(arena: Arena$@) //<
    //< A set filter keeps exactly the rows whose cell shows one of the checked values
    verdict.start("[kspage/narrow] narrowing to a chosen set test...")
    d: = Doc.new(arena)
    table: = one_column(d)
    sheet: = base.grid_sheet(arena)
    sheet.over.filters = List<|filter.Filter|>.create(arena)
    // **Each value is followed by a line break**, so an empty value is the break alone.
    sheet.over.filters.push(filter.make_filter(table, 0, .one_of, "10\n"))
    assert(shown_rows(d, sheet, arena) == 2, "the two rows showing 10 stay")
    // Case is ignored, so one checkbox takes both spellings.
    sheet.over.filters.len = 0
    sheet.over.filters.push(filter.make_filter(table, 0, .one_of, "twenty\n"))
    assert(shown_rows(d, sheet, arena) == 2, "one tick takes both spellings of the same value")
    // The blank cells are the empty value.
    sheet.over.filters.len = 0
    sheet.over.filters.push(filter.make_filter(table, 0, .one_of, "\n"))
    assert(shown_rows(d, sheet, arena) == 1, "the empty value keeps the blank cell alone")
    // **Nothing checked keeps nothing** (unlike checking the blanks).
    sheet.over.filters.len = 0
    sheet.over.filters.push(filter.make_filter(table, 0, .one_of, ""))
    assert(shown_rows(d, sheet, arena) == 0, "nothing ticked leaves no row under the heading")
    verdict.pass("a chosen set keeps the rows showing one of its values, blanks and case included.")

priv fn shown_rows(d: Doc$@, sheet: Sheet$@, arena: Arena$@): Sz //<
    //< How many rows under the heading the layout shows
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    $n: Sz = 0
    for $i: Sz = 0; i < page.cells.len; i += 1
        c: = page.cells.get(i)
        if c.column == 0 && c.row > 0
            n += 1
    return n

fn test_the_heading_cells_come_out_with_their_column_numbers(arena: Arena$@) //<
    //< The heading row's cells come out in layout order, each with its column index
    //<
    //< **The filter arrow attaches to these**, so the page needs no notion of where columns are.
    verdict.start("[kspage/narrow] the heading cells a narrowing hangs off test...")
    d: = Doc.new(arena)
    table: = d.add_block("table")
    h: = table.add_child("row")
    h.add_child("cell").add_text("one")
    h.add_child("cell").add_text("two")
    body: = table.add_child("row")
    body.add_child("cell").add_text("1")
    body.add_child("cell").add_text("2")
    sheet: = base.grid_sheet(arena)
    page: = flow.layout(d, sheet, fixed.make(), 300.0, arena)
    assert(ask.head_band_count(page) == 1, "the one table is counted")
    assert(ask.head_cell_count(page, 0) == 2, "its heading row shows two cells")
    first: = ask.head_cell_at(page, 0, 0)
    second: = ask.head_cell_at(page, 0, 1)
    assert(first.found && second.found, "both come out")
    assert(first.column == 0 && second.column == 1, "each carries its own column's number")
    assert(first.table == table && second.table == table, "and the table they belong to")
    assert(second.rect.x > first.rect.x, "they come left to right")
    assert(!ask.head_cell_at(page, 0, 2).found, "past the row's end nothing comes out")
    assert(ask.head_cell_count(page, 1) == 0, "and there is no second table")
    verdict.pass("a heading row's cells come out in order, each naming its column and its table.")

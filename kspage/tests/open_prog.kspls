//< Opens one document and lays it out
//<
//< The target of `make test-fuzz`.
//< Caution: **Do not stop at reading it.** kspage breaks where the numbers read are **used** (a
//< merge's column count, a heading's depth); read and thrown away, fuzzing finds nothing.
//< **The result is only the exit code**: 0 means "opened and laid out", 1 means "refused";
//< anything else is a finding. Usage: `open_prog <kind> <file>` (the kind is doc / md / csv / txt).
import "kspage/lay/flow"
import "kspage/model/doc" { Doc }
import "kspage/model/fixed_font" as fixed
import "kspage/model/style" { Sheet }
import "kspage/share/html"
import "kspage/share/markdown"
import "kspage/share/markdown_read"
import "kspage/share/store"
import "kspage/share/text"
import "kspage/tests/base"
import "kspage/write/csv"
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/sys"

priv const width: F32 = 640.0 //< the width it is laid out at
  //<
  //< Any width at which columns and wrapping take effect will do.

priv fn used(d: Doc$@, sheet: Sheet$@, arena: Arena$@) //< uses the document that was read
  //<
  //< Caution: **Do both the layout and the export**; they use the numbers differently.
  flow.layout(d, sheet, fixed.make(), width, arena)
  $out: = Str_builder.new()
  defer out.free()
  store.save(d, sheet, out@)
  out.clear()
  markdown.write(d, sheet, out@)
  out.clear()
  html.write(d, sheet, fixed.make(), out@)

fn main(): I32
  args: = sys.args()
  if args.len < 3
    io.err().s("Usage: kspage_open <doc|md|csv|txt> <file>\n")
    return 2
  kind: = args[1]
  src: = io.read_file(args[2]) catch
    io.err().s("cannot read: \{args[2]\}\n")
    return 2
  arena: = Arena.new(8 * 1024 * 1024)
  defer arena.free()
  if kind.equals("doc")
    got: = store.load(src, arena) catch _e
      return 1
    used(got.doc, got.sheet, arena)
    return 0
  if kind.equals("csv")
    // **One table is not a document** (layout needs a container). Build one and then use it.
    if made: = csv.read_table(src, "table", arena)
      sheet: = Sheet.new(base.root_font(), arena)
      d: = Doc.new(arena)
      d.blocks.push(made)
      used(d, sheet, arena)
      return 0
    return 1
  sheet: = Sheet.new(base.root_font(), arena)
  d: =
    (text.read(src, sheet, arena) if kind.equals("txt")
    else markdown_read.read(src, sheet, arena))
  used(d, sheet, arena)
  return 0

//< The reader's own overrides (settings that do not go into the document)
//<
//< Note: It is split from [`style.kspl`](style.kspl) to keep each file under 1000 lines
//< (Principle 3); it is not a style, so the split is clean.
import "kspage/model/doc" { Block }
import "kspage/model/filter" { Filter }
import "std/ds" { List }

struct Over //< the reader's overrides
    //<
    //< **It is not saved** (neither into the text nor an export). **Only fields that change how it
    //< is laid out belong here**; the color is the page's.
    reveal: Sz? //<
        //< The step to show now
        //<
        //< **`none` limits to no step** (all of them show, so printing shows everything). It
        //< applies only while they are shown one at a time.
    filters: List<|Filter|>$@ //<
        //< The conditions that filter the tables' rows ([`filter.kspl`](filter.kspl))
        //<
        //< **`null` means no filter.** It points at the document's tables, so it does not carry
        //< over to another document (`carried`).
    kept_row: Block$@ //<
        //< The row the cursor is in, laid out even where a filter would hide it
        //<
        //< **The page sets it before every layout** (`kspage_web_layout`); `null` keeps no row. It
        //< points at the document's row, so it does not carry over either.

fn no_over(): Over //< overrides nothing
    return Over::{ .reveal = .none, .filters = null, .kept_row = null }

fn carried(o: Over): Over //< the overrides that carry over to another document
    //<
    //< They belong to the viewer, so opening another document keeps them. Two are not kept:
    //< `filters` and `kept_row` point into the old document, and they dangle once its arena is
    //< freed.
    $kept: = o
    kept.filters = null
    kept.kept_row = null
    return kept

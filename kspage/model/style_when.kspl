//< A setting that changes the look by the value (a style under a condition)
//<
//< **Another style is laid over only when a cell's value matches the condition** (`When`).
//< Note: The code that draws the table (`when_style`) is in [`style.kspl`](style.kspl); this file
//< holds only the condition and the match test, nothing about tables (so the reference is one-way).
import "std/strnum"

enum Compare //< how the value is compared
    //<
    //< **`none` means no condition.**
    //< Caution: **Do not rename a variant**: its name is the spelling a saved text holds (`make
    //< test` pins every one).
    none
    above
    below
    equal

const comparisons: Compare[3] = ::{ .above, .below, .equal } //<
    //< Every way of comparing a saved text can hold, in the order a text is read
    //<
    //< Each is saved as `when_` and its name (`variant_name`), and read back through this one row
    //< (`read_when` in `share/store.kspl`).
    //< Caution: **List a new variant here too**, or it is saved and never read back (`make test`
    //< pins every name).

struct When //< the condition that changes the look by the value (a style under a condition)
    //<
    //< **A match lays another style over, by name**, not a color (a color held here would be
    //< another look with no name). **Only the look changes** (the font, the color, the fill, the
    //< line); a line height that moved with a value would confuse the reader.
    how: Compare
    than: F32 //< the value it is compared against
    then: U8[] //< the name of the style laid over on a match. **Empty lays nothing over.**

fn no_when(): When
    return When::{ .how = .none, .than = 0.0, .then = "" }

fn suits(w: When, text: U8[]): Bool //< whether the text matches the condition
    //<
    //< **A text that cannot be read as a number does not match** (an empty cell, a heading word).
    switch w.how
    case .none
        return false
    case .above, .below, .equal {}
    if text.len <= 0
        return false
    v: = text.to_f64() catch
        return false
    than: = F64::w.than
    switch w.how
    case .above
        return v > than
    case .below
        return v < than
    case .equal
        return v == than
    case .none {}
    return false

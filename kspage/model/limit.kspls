//< The allowed range of a number read from a document
//<
//< **In some fields, one number decides the amount of work.**
//< **Values outside the range are rejected**: rejecting tells the writer what happened.
//< **The range is kept in this one place.**

const most_span: I64 = 1000 //< how many rows and columns a merge can cover
  //<
  //< It is HTML's `colspan` cap. **Rows and columns are not separated** (HTML's split has no
  //< reason behind it beyond old differences between browsers).

const most_columns: I64 = 64 //< the number of columns in a column layout
  //<
  //< **This check rejects before it reads the paper width** (Word's 45 depends on the width), so a
  //< round number enough for the widest paper is used.

const most_outline: I64 = 9 //< a heading's depth
  //<
  //< As in Word and ODF; Markdown and HTML go to 6
  //< ([`../share/markdown.kspls`](../share/markdown.kspls)).

const most_places: I64 = 9 //< the decimal places in how a number is shown
  //<
  //< **As far as 10 to that power fits in an I64** (more places would change no text: a field
  //< with no effect though written).

fn span_fits(got: I64): Bool //< whether it is allowed as a merge's count
  //<
  //< **1 is the smallest** (the layout cannot count a merge of 0).
  return got >= 1I64 && got <= most_span

fn columns_fits(got: I64): Bool //< whether it is allowed as a column count
  //<
  //< **0 and 1 mean "no column layout"** (they are inside the range).
  return got >= 0I64 && got <= most_columns

fn outline_fits(got: I64): Bool //< whether it is allowed as a heading's depth
  //<
  //< **0 means "not a heading"** (it is inside the range).
  return got >= 0I64 && got <= most_outline

fn places_fits(got: I64): Bool //< whether it is allowed as a number of decimal places
  //<
  //< **0 means "show no decimals"** (it is inside the range).
  return got >= 0I64 && got <= most_places

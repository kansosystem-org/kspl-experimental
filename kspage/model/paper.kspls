//< The size of one sheet of paper, and its margins
//<
//< **This is not a style** but a setting for the whole document. The style table holds it
//< (`Sheet.paper` in [`style.kspls`](style.kspls)); it is not looked up by name or inherited,
//< and a file of its own keeps the two apart.

struct Paper //< the size of one page and its margins (pixels)
  //<
  //< **Height 0 means "no pages"** (the screen stays one continuous scroll). On the screen only
  //< the width applies; **the margins apply on paper.**
  width: F32
  height: F32
  left: F32
  top: F32
  right: F32
  bottom: F32
  reading: F32 //<
    //< The width beyond which the body does not widen
    //<
    //< **0 means no cap.** **It does not apply once the paper width is set** (there would be two
    //< ways to set a line's length). The leftover width is split equally left and right
    //< (`column_left`).

fn a4_portrait(): Paper //< the default paper (A4 portrait, 15mm margins)
  //<
  //< In px at 96dpi: 794×1123px and 57px.
  //< Caution: **Do not write the numbers in two places**: the shipped document and the page
  //< borrowed for printing both need them ("A document with no paper size borrows one only for
  //< printing" in [`../docs/DESIGN.md`](../docs/DESIGN.md)). **Do not make it 0**: the bands
  //< sit inside the margin (`chrome_rect` in [`../lay/chrome.kspls`](../lay/chrome.kspls)).
  return Paper::{ .width = 794.0, .height = 1123.0, .left = 57.0, .top = 57.0, .right = 57.0,
    .bottom = 57.0, .reading = 0.0 }

fn no_paper(): Paper //< no pages (neither the size nor the margins are set)
  return Paper::{ .width = 0.0, .height = 0.0, .left = 0.0, .top = 0.0, .right = 0.0, .bottom = 0.0,
    .reading = 0.0 }

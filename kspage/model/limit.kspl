//< The allowed range of a number read from a document
//<
//< **In some fields, one number decides the amount of work.**
//< **Values outside the range are rejected**: rejecting tells the writer what happened. A length
//< the editor makes itself is brought inside instead (`length_in`), so what it saves loads back.
//< A merge or a nesting it would make outside is refused, since bringing it in changes the shape.
//< **The range is kept in this one place.**

const MOST_SPAN: I64 = 1000 //< how many rows and columns a merge can cover
    //<
    //< It is the cap browsers put on a table cell's span. **Rows and columns are not separated**
    //< (the browsers' split has no reason behind it beyond old differences between them).

const MOST_COLUMNS: I64 = 64 //< the number of columns in a column layout
    //<
    //< **This check rejects before it reads the paper width** (Word's 45 depends on the width), so
    //< a round number enough for the widest paper is used.

const MOST_OUTLINE: I64 = 9 //< a heading's depth
    //<
    //< As in Word and ODF; Markdown goes to 6
    //< ([`../share/markdown.kspl`](../share/markdown.kspl)).

const MOST_PLACES: I64 = 9 //< the decimal places in how a number is shown
    //<
    //< **As far as 10 to that power fits in an I64** (more places would change no text: a field
    //< with no effect though written).

const MOST_NESTING: Sz = 32 //< how deep blocks may sit inside one another
    //<
    //< **Laying out and drawing descend one call per level**, and so do the tables a cell holds.
    //< A document a few kilobytes long can nest thousands deep. It runs the stack out where it is
    //< laid out, after it has replaced the open one. 32 is past any list or table people nest.

fn nesting_fits(depth: Sz): Bool //< whether a block may stand this deep (the top level is 1)
    return depth <= MOST_NESTING

fn span_fits(got: I64): Bool //< whether it is allowed as a merge's count
    //<
    //< **1 is the smallest** (the layout cannot count a merge of 0).
    return got >= 1I64 && got <= MOST_SPAN

fn columns_fits(got: I64): Bool //< whether it is allowed as a column count
    //<
    //< **0 and 1 mean "no column layout"** (they are inside the range).
    return got >= 0I64 && got <= MOST_COLUMNS

fn outline_fits(got: I64): Bool //< whether it is allowed as a heading's depth
    //<
    //< **0 means "not a heading"** (it is inside the range).
    return got >= 0I64 && got <= MOST_OUTLINE

fn places_fits(got: I64): Bool //< whether it is allowed as a number of decimal places
    //<
    //< **0 means "show no decimals"** (it is inside the range).
    return got >= 0I64 && got <= MOST_PLACES

// ==========================================
// Lengths and sizes (pixels, F32 in the model). **A length decides work too.** The layout counts
// pages by the paper's height and draws a band per page. A size or a gap past any paper turns
// those counts into billions, or past what a cast to an integer can hold.
// ==========================================

const MOST_LENGTH: F64 = 100000.0 //< the longest length, gap or position either way, in pixels
    //<
    //< About 26 metres at 96 to the inch: past any paper, well short of a count that hangs.

const LEAST_PAGE: F64 = 96.0 //< the shortest page a document is split into: one inch
    //<
    //< **0 means "no pages"** and stays allowed. Between, a page of a pixel splits a document into
    //< a page per pixel.

const MOST_FONT: F64 = 1638.0 //< the largest font size, in pixels
    //<
    //< Word's own cap on a size (1638 points) taken as pixels: larger than any it can set.

const MOST_SPACING: F64 = 100.0 //< the largest line height ratio

fn length_fits(got: F64): Bool //< whether it is allowed as a length, a gap or a position
    //<
    //< **Negative values are allowed** (a hanging indent, a frame dragged past the edge); the
    //< magnitude decides the work. A value that is not a number fits nowhere.
    return got >= -MOST_LENGTH && got <= MOST_LENGTH

fn length_in(got: F32): F32 //< the nearest length that `length_fits`; one that is no number is 0
    //<
    //< **For a length the editor makes itself** (a size measured, dragged or taken from a
    //< picture). Refused, the person could not tell why. Kept, the saved file would not load.
    if !(got == got)
        return 0.0
    if got > F32::MOST_LENGTH
        return F32::MOST_LENGTH
    if got < -F32::MOST_LENGTH
        return -F32::MOST_LENGTH
    return got

fn page_fits(got: F64): Bool //< whether it is allowed as the paper's width or height
    return got == 0.0 || (got >= LEAST_PAGE && got <= MOST_LENGTH)

fn font_fits(got: F64): Bool //< whether it is allowed as a font size; 0 and below are not
    return got > 0.0 && got <= MOST_FONT

fn spacing_fits(got: F64): Bool //<
    //< whether it is allowed as a line height ratio; 0 means "not set"
    return got >= 0.0 && got <= MOST_SPACING

//< Narrows a table's rows by a condition (a filter)
//<
//< **It is a view, not a change to the document.** The conditions belong to the reader
//< ([`over.kspls`](over.kspls)'s `Over.filters`): nothing is saved, and a formula still counts
//< every row (as in Excel, where `SUBTOTAL` is the opt-in). The layout asks one question,
//< `row_shown`.
import "kspage/model/doc" { Block, Tile }
import "std/chars"
import "std/ds" { List }
import "std/str"
import "std/strnum"

enum Keep //< how a cell's text is matched
  //<
  //< Caution: **Do not move or rename an existing name**: the page passes the kind by its index in
  //< `keep_order` (`../port/web/state.kspls`), read back by name (`make test` pins every one).
  is //< the same text, ignoring case
  is_not //< any other text
  holds //< contains the text, ignoring case
  above //< a number greater than the typed one (a text that is not a number fails)
  below //< a number less than the typed one
  blank //< nothing in the cell
  filled //< anything in the cell
  one_of //< the text is one of a chosen set (the set is `Filter.text`, one value per line)

impl Keep
  fn wants_number(k: Self): Bool //< whether the kind compares numbers
    switch k case .above, .below
      return true
    case .is, .is_not, .holds, .blank, .filled, .one_of
      return false

fn keep_from(name: U8[]): Keep //< the kind with that name
  //<
  //< **An unknown name means "is"** (the plainest reading of a typed value).
  if name.equals("is_not")
    return Keep.is_not
  if name.equals("holds")
    return Keep.holds
  if name.equals("above")
    return Keep.above
  if name.equals("below")
    return Keep.below
  if name.equals("blank")
    return Keep.blank
  if name.equals("filled")
    return Keep.filled
  if name.equals("one_of")
    return Keep.one_of
  return Keep.is

struct Filter //< one condition on one column of one table
  table: Block$@ //<
    //< The table being filtered
    //<
    //< **An identity, not a name**, cleared with the document (a name would outlive it).
  column: Sz //< the column, counting merged cells (a tile's column)
  keep: Keep
  text: U8[] //< the typed text (a copy of the page's, kept with the filter)
  num: F64 //< the text as a number, where it reads as one
  numeric: Bool

fn make_filter(table: Block$@, column: Sz, keep: Keep, text: U8[]): Filter //< one condition
  $num: F64 = 0.0
  $numeric: = false
  v: = text.to_f64() catch
    return Filter::{ .table = table, .column = column, .keep = keep, .text = text, .num = 0.0,
      .numeric = false }
  num = v
  numeric = true
  return Filter::{ .table = table, .column = column, .keep = keep, .text = text, .num = num,
    .numeric = numeric }

priv fn holds_text(hay: U8[], needle: U8[]): Bool //<
  //< whether needle appears inside hay, ignoring case
  //<
  //< **An empty needle matches everything** (as Excel's "contains" left blank does).
  if needle.len == 0
    return true
  if needle.len > hay.len
    return false
  for $at: Sz = 0; at + needle.len <= hay.len; at += 1
    $same: = true
    for $i: Sz = 0; i < needle.len && same; i += 1
      same = hay[at + i].to_lower() == needle[i].to_lower()
    if same
      return true
  return false

fn passes(f: Filter, shown: U8[]): Bool //< whether a cell showing that text is kept
  //<
  //< **It matches the visible text**, not the formula (as sorting does).
  switch f.keep case .is
    return shown.equals_ignore_case(f.text)
  case .is_not
    return !shown.equals_ignore_case(f.text)
  case .holds
    return holds_text(shown, f.text)
  case .above, .below
    if !f.numeric
      return false
    v: = shown.to_f64() catch
      return false
    return v > f.num if f.keep == Keep.above else v < f.num
  case .blank
    return shown.len == 0
  case .filled
    return shown.len > 0
  case .one_of
    return one_of(shown, f.text)

const value_sep: U8 = '\n' //< what separates one chosen value from the next inside `Filter.text`
  //<
  //< **A run holds no line break**, so no value contains this byte (`text_at` below).
  //< **Each value is written followed by this byte**, so the byte alone means "the blank cells",
  //< distinct from "nothing chosen" (an empty text).

priv fn one_of(shown: U8[], set: U8[]): Bool //< whether the text is one of the chosen values
  //<
  //< **Nothing chosen keeps nothing** (unticking everything); the way back is removing the filter,
  //< not an empty set meaning "all".
  $at: Sz = 0
  for at < set.len
    cut: = set.sub_from(at).find_char(value_sep)
    stop: = set.len if cut < 0 else at + cut
    if shown.equals_ignore_case(set.sub(at, stop - at))
      return true
    at = stop + 1
  return false

priv fn text_at(tiles: List<|Tile|>$@, r: Sz, column: Sz): U8[] //< the text a cell shows
  //<
  //< **A position covered by a merge, or past the row's end, shows nothing.**
  for $i: Sz = 0; i < tiles.len; i += 1
    t: = tiles.get(i)
    if t.row == r && t.column == column
      if n: = t.block.first_run()
        return n.showing()
      return ""
  return ""

fn row_shown(filters: List<|Filter|>$@, kept: Block$@, table: Block$@, row: Block$@,
  tiles: List<|Tile|>$@, r: Sz): Bool //<
    //< Whether row r of the table is laid out
    //<
    //< **The heading row is always laid out**, and so is the kept row (the cursor's): it must not
    //< vanish while the user works in it (in Numbers' live filtering it can). Every other row must
    //< pass every filter, or it is left out.
  if r == 0 || filters == null || row == kept
    return true
  for $i: Sz = 0; i < filters.len; i += 1
    f: = filters.get(i)
    if f.table == table && !passes(f, text_at(tiles, r, f.column))
      return false
  return true

fn column_narrowed(filters: List<|Filter|>$@, table: Block$@, column: Sz): Bool //<
  //< Whether a condition is set on that one column
  //<
  //< **The heading's own arrow is drawn from this**, so which column is filtered shows at a glance.
  if filters == null
    return false
  for $i: Sz = 0; i < filters.len; i += 1
    f: = filters.get(i)
    if f.table == table && f.column == column
      return true
  return false

fn narrowed(filters: List<|Filter|>$@, table: Block$@): Bool //<
  //< Whether any condition is set on that table
  if filters == null
    return false
  for $i: Sz = 0; i < filters.len; i += 1
    if filters.get(i).table == table
      return true
  return false

//< A table's arithmetic
//< **A text starting with `=` is a formula.**
//< The value itself is computed on every run (other cells point at it).
//< Caution: **Call it before layout.** The shown text changes, so after layout the boxes point at
//< old values.

// ==========================================
// Usage:
//   calc.recalc(doc, sheet, ed.caret.inline);
//   ed.clamp();
//   page: = flow.layout(doc, sheet, src, width, arena);
// ==========================================
import "kspage/expr/addr" + { Addr, Reader, BROKEN_REF }
import "kspage/expr/shown"
import "kspage/expr/value" { Cell_error, Fold, Value, fn_kind, folded, number, rounded, take }
import "kspage/model/day"
import "kspage/model/doc" { Doc, Block }
import "kspage/model/run" { Inline }
import "kspage/model/style" + { Number_spec, Sheet }
import "std/chars"
import "std/ds" { List }
import "std/math"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strfmt" as _strfmt
import "std/strnum"

priv const UNVISITED: U8 = 0U8 //< a cycle is detected by whether a cell is being computed
priv const WORKING: U8 = 1U8
priv const SETTLED: U8 = 2U8

priv const MAX_NEST: Sz = 64 //< how deep one formula may nest (parentheses, `-`, `if … else`)
    //< As Excel's cap of 64. **Each level is a call.** Without a cap, a formula of a few kilobytes
    //< (`((((…1…))))`) runs the stack out, and on wasm it writes over the page's memory.

priv const MAX_DEPTH: Sz = 256 //< how deep one computation goes before a chain is set aside
    //< It counts the cells a chain passes through (`=A2`, `=A3`, …) and the nesting inside them.
    //< **A deeper chain is not refused**: its deepest cell is set aside and settled first, and then
    //< the chain is retried (`settle`). So an ordinary running total of thousands of rows computes.

priv struct Cell_at //< one cell, by its table and position
    g: Grid$@
    r: Sz
    c: Sz

priv struct Grid //< one table, laid out so that it can be looked up by row × column
    table: Block$@
    rows: Sz
    cols: Sz
    state: List<|U8|>$@ //< how far each cell is computed, and its value, in row × column order
    value: List<|Value|>$@
    anchor: List<|Block$@|>$@ //<
        //< From a cell's position (row × column) to its block. **Null where it is covered.**
    book: Book$@ //<
        //< The same document's tables, for references across tables.
    arena: Arena$@

priv struct Book //< the document's tables together
    //< Caution: **Keep it alive through one whole recalculation.** A cycle across tables is
    //< detected only while both tables' computing states are visible at once.
    grids: List<|Grid$@|>$@
    sheet: Sheet$@ //<
        //< The style table, for looking up how a number is shown.
    arena: Arena$@ //<
        //< The arena for one recalculation only, thrown away when computing is done.
    kept: Arena$@ //<
        //< The arena the computed values go in (the document's arena)
        //< **Not the arena above**: a value put there would point at freed memory. It is reused per
        //< run, so it does not keep growing.
    editing: Inline$@ //<
        //< The run being typed in now
        //< **The screen lays it out as typed**, since the user cannot edit it without seeing the
        //< typed text. Its value is still computed and kept, for export and for the other cells.
    depth: Sz //< how deep the computation under way is (`MAX_DEPTH`)
    // A chain went past `MAX_DEPTH` at `deferred`: what was computed on the way is not kept, and
    // `settle` computes `deferred` first.
    deferring: Bool
    deferred: Cell_at

priv fn new_book(sheet: Sheet$@, arena: Arena$@, kept: Arena$@, editing: Inline$@): Book$@
    grids: = List<|Grid$@|>.create(arena)
    return arena
        .create(Book::{ .grids = grids, .sheet = sheet, .arena = arena, .kept = kept,
        .editing = editing, .depth = 0, .deferring = false,
        .deferred = Cell_at::{ .g = null, .r = 0, .c = 0 } })

priv fn find_grid(book: Book$@, name: U8[]): Grid$@? //< the table a name points at
    //< **Where two have the same name it is the earlier one in document order.**
    for $i: Sz = 0; i < book.grids.len; i += 1
        g: = book.grids.get(i)
        if g.table.name.len > 0 && g.table.name.equals(name)
            return .some(g)
    return .none

priv fn new_grid(table: Block$@, book: Book$@): Grid$@
    arena: = book.arena
    rows: = table.children.len
    cols: = table.grid_columns(arena)
    g: = Grid::{
        .table = table,
        .rows = rows,
        .cols = cols,
        .state = List<|U8|>.create(arena),
        .value = List<|Value|>.create(arena),
        .anchor = List<|Block$@|>.create(arena),
        .book = book,
        .arena = arena,
    }
    for $i: Sz = 0; i < rows * cols; i += 1
        g.state.push(UNVISITED)
        g.value.push(Cell_error.no_cell.failed())
        g.anchor.push(null)
    // **A cell's position counts merges** (`Block.tiles_of`). Counted separately, the address in a
    // merged table would disagree with where it is laid out. A covered address holds no cell.
    tiles: = table.tiles_of(arena)
    for $i: Sz = 0; i < tiles.len; i += 1
        t: = tiles.get(i)
        if t.row < rows && t.column < cols
            g.anchor.set(t.row * cols + t.column, t.block)
    return arena.create(g)

priv fn cell_inline(g: Grid$@, r: Sz, c: Sz): Inline$@? //<
    //< The inline holding cell (r, c)'s text
    //< **Only a merge's upper-left cell holds a value.**
    if r < 0 || r >= g.rows || c < 0 || c >= g.cols
        return .none
    cell: = g.anchor.get(r * g.cols + c)
    if cell == null || cell.inlines.len <= 0
        return .none
    return .some(cell.inlines.get(0))

// ---- Computing a formula ----

priv struct P //< the state partway through reading a formula
    //< **A position is read with `addr.Reader`** (a second parser here would disagree with the
    //< rewriting code).
    c: Reader
    book: Book$@
    g: Grid$@ //<
        //< The table it is in; null for a formula in the body.
    nest: Sz //< how deep this formula is nested where it is read now (`MAX_NEST`)

impl P
    fn enter(p: Self$@): Bool //< goes one level deeper; false past `MAX_NEST`
        if p.nest >= MAX_NEST
            return false
        p.nest += 1
        p.book.depth += 1
        return true

    fn leave(p: Self$@) //< comes back up one level
        p.nest -= 1
        p.book.depth -= 1

priv fn parse_number(p: P$@): Value //< reads a number
    //< Only digits and one decimal point (the sign belongs to unary minus). **One decimal point**:
    //< accept a second and the `.` of `5.0.round(2)` is swallowed. **A `.` is the decimal point
    //< only with a digit after it**; otherwise it starts a method (`2026.year()`).
    start: = p.c.pos
    $dot: = false
    for p.c.pos < p.c.src.len
        ch: = addr.at(p.c@)
        if ch == '.' && !dot && p.c.pos + 1 < p.c.src.len &&
            p.c.src[p.c.pos + 1].is_digit()
            dot = true
        else if !ch.is_digit()
            break
        p.c.pos += 1
    text: = p.c.src.sub(start, p.c.pos - start)
    v: = text.to_f64() catch
        return Cell_error.syntax.failed()
    return number(v)

priv const MET_ROUND: Sz = 0 //<
    //< The methods that can follow a value
    //< **They cannot be used on a range** (only folding takes one: `fn_kind` in
    //< `expr/value.kspl`).
priv const MET_YEAR: Sz = 1
priv const MET_MONTH: Sz = 2
priv const MET_DAY: Sz = 3

priv fn method_of(name: U8[]): Sz //< the names of the methods that can follow a value
    //< **An unknown name is rejected** (skipped over, a typo would pass silently).
    if name.equals("round")
        return MET_ROUND
    if name.equals("year")
        return MET_YEAR
    if name.equals("month")
        return MET_MONTH
    if name.equals("day")
        return MET_DAY
    return -1

priv fn take_span(g: Grid$@, f: Fold$@, a: Addr, b: Addr) //< folds the cells from a to b
    //< The order of the ends does not matter (A3:A1 is the same as A1:A3).
    r0: = math.min(a.row, b.row)
    r1: = math.max(b.row, a.row)
    c0: = math.min(a.col, b.col)
    c1: = math.max(b.col, a.col)
    if r0 < 0 || c0 < 0 || r1 >= g.rows || c1 >= g.cols
        f.broken = true
        f.err = .no_cell
        return
    for $r: Sz = r0; r <= r1; r += 1
        for $c: Sz = c0; c <= c1; c += 1
            v: = value_at(g, r, c)
            if !v.ok && typed(g, r, c)
                continue
            take(f, v)

priv fn typed(g: Grid$@, r: Sz, c: Sz): Bool //< whether cell (r, c) holds typed text, no formula
    //< **A range skips such a cell where it is no number** (a heading word, an empty cell: a range
    //< means "the numbers around here"). A formula that fails shows a mark, so `take` carries it,
    //< whatever the reason (`=1/0` as much as `#CYCLE!`); skipped, the total would look right.
    if n: = cell_inline(g, r, c)
        return !n.is_formula()
    return false

priv fn eat(p: P$@, c: U8): Bool //< advances where the next character is c
    //< **Skip spaces first** (`IF(A1 , 1, 2)` is the same formula).
    addr.skip_ws(p.c@)
    if addr.at(p.c@) != c
        return false
    p.c.pos += 1
    return true

priv fn parse_word(p: P$@): U8[] //< reads a run of letters
    //< Caution: **Put the position back where nothing could be read** (`A1`'s `A` is a letter too).
    start: = p.c.pos
    // Letters only: `_` is no letter here (`c.is_alpha()` would take it in).
    for addr.at(p.c@).is_lower() || addr.at(p.c@).is_upper()
        p.c.pos += 1
    return p.c.src.sub(start, p.c.pos - start)

priv fn word(p: P$@, w: U8[]): Bool //< advances where the next word is w
    //< **Where more letters follow, it is another word** (`ifx` is not `if`).
    addr.skip_ws(p.c@)
    mark: = p.c.pos
    if parse_word(p).equals(w)
        return true
    p.c.pos = mark
    return false

priv fn parse_day_of(p: P$@): Value //< `Day.of(year, month, day)`
    //< **A date that does not exist on the calendar is not a value** (2026-02-30). This is how a
    //< date is written inside a formula (`2026-08-18` is a subtraction).
    y: = parse_pick(p)
    if !eat(p, ',')
        return Cell_error.syntax.failed()
    m: = parse_pick(p)
    if !eat(p, ',')
        return Cell_error.syntax.failed()
    d: = parse_pick(p)
    if !eat(p, ')')
        return Cell_error.syntax.failed()
    if !y.ok
        return y
    if !m.ok
        return m
    if !d.ok
        return d
    if yy: = shown.whole_of(y.num)
        if mm: = shown.whole_of(m.num)
            if dd: = shown.whole_of(d.num)
                if n: = day.days_of(yy, mm, dd)
                    return number(F64::n)
    return Cell_error.not_number.failed()

priv fn parse_fold(p: P$@, g: Grid$@, a: Addr, b: Addr): Value //<
    //< Folds `[<table's name>!]<position>:<position>`
    //< **A range with no folding function is not a value** (`A1:A3` alone). **The folding
    //< functions take no argument** (a sum over gaps is written with `+`).
    if !eat(p, '.')
        return Cell_error.syntax.failed()
    kind: = fn_kind(parse_word(p))
    // A value's method on a range is rejected too (mixed, what cannot fold would look foldable).
    if kind < 0
        return Cell_error.no_name.failed()
    if !eat(p, '(') || !eat(p, ')')
        return Cell_error.syntax.failed()
    $f: = Fold::{ .kind = kind, .acc = 0.0, .seen = 0, .broken = false, .err = .syntax }
    take_span(g, f@, a, b)
    return folded(f@)

priv fn parse_place(p: P$@): Value //< a position or a range
    //< **It is a range where a `:` follows the position.** **A name applies to the whole range**
    //< (`Table2!A1:A3`), not per end. **A formula in the body cannot point at a position with no
    //< name** (it has no table of its own).
    $g: Grid$@ = p.g
    name: = addr.parse_table_name(p.c@)
    if name.len > 0
        switch find_grid(p.book, name)
        case .some(other)
            g = other
        case .none
            // An unknown name is rejected: taken as its own table, it would silently give another
            // cell.
            return Cell_error.no_name.failed()
    // A named position removed by deleting its row or column (`detail!#REF!`).
    if addr.at(p.c@) == '#'
        return parse_broken(p)
    a: = addr.parse_addr(p.c@)
    switch a.kind
    case .unreadable
        return Cell_error.syntax.failed()
    case .out_of_range
        // **The text did parse.** A number too large is the same "there is no cell" as `=A999` (one
        // mistake, one mark, whatever the number's size).
        return Cell_error.no_cell.failed()
    case .spot {}
    if addr.at(p.c@) != ':'
        if g == null
            return Cell_error.no_cell.failed()
        return value_at(g, a.row, a.col)
    p.c.pos += 1
    b: = addr.parse_addr(p.c@)
    switch b.kind
    case .unreadable
        return Cell_error.syntax.failed()
    case .out_of_range
        return Cell_error.no_cell.failed()
    case .spot {}
    if g == null
        return Cell_error.no_cell.failed()
    return parse_fold(p, g, a, b)

priv fn parse_broken(p: P$@): Value //< the mark of a removed position, `#REF!`
    //< **A broken reference's mark can be written inside a formula**, with its table's name or
    //< without. Deleting a row or column rewrites a removed position to it (closed up, it would
    //< silently point at the next cell).
    if p.c.src.starts_with(BROKEN_REF, p.c.pos)
        p.c.pos += BROKEN_REF.len
        return Cell_error.no_cell.failed()
    return Cell_error.syntax.failed()

priv fn parse_primary(p: P$@): Value //< one value
    //< **Methods are not read here** (the loop outside reads them).
    addr.skip_ws(p.c@)
    c: = addr.at(p.c@)
    if c == '('
        p.c.pos += 1
        v: = parse_pick(p)
        if !eat(p, ')')
            return Cell_error.syntax.failed()
        return v
    // **A number starts with a digit**, as in KSPL (`.5` is not one: write `0.5`).
    if c.is_digit()
        return parse_number(p)
    if c == '#'
        return parse_broken(p)
    // A value made from a type. **`Day` is a type's name, so it cannot be a table's name.**
    if c.is_lower() || c.is_upper()
        mark: = p.c.pos
        if parse_word(p).equals("Day")
            if !eat(p, '.') || !word(p, "of") || !eat(p, '(')
                return Cell_error.syntax.failed()
            return parse_day_of(p)
        p.c.pos = mark
    // The rest is text pointing at a cell. **A table name starting with a non-letter comes here
    // too**, so do not branch on letters alone.
    return parse_place(p)

enum Name_fault //< why a formula could not reach a table by a name, or `none`
    //< **It is the reader's rule** (`parse_primary`, `parse_place`), written out so that a name
    //< is refused where it is set, not found broken where a formula uses it.
    none
    separator //< it holds a separator (`addr.is_break`), a `!` or a control character
    leading //< it starts as a number (a digit) or a mark (`#`) does
    type_name //< its leading letters are `Day`, the date type's name

impl Name_fault
    fn reachable(f: Self): Bool //< whether a formula can reach the name (no fault)
        switch f
        case .none
            return true
        default {}
        return false

fn name_fault(name: U8[]): Name_fault //< whether a table may carry this name
    //< **An empty name is fine** (it removes the name).
    for c in name
        if addr.is_break(c) || c == '!' || c < ' ' || c == 127
            return .separator
    if name.len <= 0
        return .none
    if name[0].is_digit() || name[0] == '#'
        return .leading
    $letters: Sz = 0
    for letters < name.len && (name[letters].is_lower() || name[letters].is_upper())
        letters += 1
    if name.sub(0, letters).equals("Day")
        return .type_name
    return .none

priv fn parse_method(p: P$@, v: Value): Value //< one method following a value
    //< It is called after the `.`. **The `(` and the `)` cannot be omitted** (the same form as
    //< KSPL). **An unknown name is rejected**; no name at all (`=1.`) does not read as a formula.
    name: = parse_word(p)
    if name.len <= 0
        return Cell_error.syntax.failed()
    kind: = method_of(name)
    if kind < 0
        return Cell_error.no_name.failed()
    if !eat(p, '(')
        return Cell_error.syntax.failed()
    if kind == MET_ROUND
        places: = parse_pick(p)
        if !eat(p, ')')
            return Cell_error.syntax.failed()
        if !v.ok
            return v
        return places if !places.ok else rounded(v.num, places.num)
    if !eat(p, ')')
        return Cell_error.syntax.failed()
    if !v.ok
        return v
    // **It takes a count of days**, whatever the date format (the format belongs to the text). One
    // too large to convert names no day.
    if days: = shown.whole_of(v.num)
        c: = day.civil_of(days)
        if kind == MET_YEAR
            return number(F64::c.year)
        if kind == MET_MONTH
            return number(F64::c.month)
        return number(F64::c.day)
    return Cell_error.not_number.failed()

priv fn parse_factor(p: P$@): Value
    addr.skip_ws(p.c@)
    if addr.at(p.c@) == '-'
        p.c.pos += 1
        if !p.enter()
            return Cell_error.syntax.failed()
        v: = parse_factor(p)
        p.leave()
        return v if !v.ok else number(-v.num)
    $v: Value = parse_primary(p)
    // **Any number of methods can follow** (`A1.round(0).day()`).
    for v.ok && addr.at(p.c@) == '.'
        p.c.pos += 1
        v = parse_method(p, v)
    return v

priv fn parse_term(p: P$@): Value
    $left: Value = parse_factor(p)
    addr.skip_ws(p.c@)
    for addr.at(p.c@) == '*' || addr.at(p.c@) == '/'
        c: = addr.at(p.c@)
        p.c.pos += 1
        right: = parse_factor(p)
        if !left.ok
            return left
        if !right.ok
            return right
        // A division by 0 gives an infinity or a NaN, which `number` refuses.
        left = number(left.num * right.num if c == '*' else left.num / right.num)
        addr.skip_ws(p.c@)
    return left

priv fn parse_expr(p: P$@): Value
    $left: Value = parse_term(p)
    addr.skip_ws(p.c@)
    for addr.at(p.c@) == '+' || addr.at(p.c@) == '-'
        c: = addr.at(p.c@)
        p.c.pos += 1
        right: = parse_term(p)
        if !left.ok
            return left
        if !right.ok
            return right
        left = number(left.num + right.num if c == '+' else left.num - right.num)
        addr.skip_ws(p.c@)
    return left

// ---- Comparing ----
priv const CMP_NONE: Sz = 0 //<
    //< The ways of comparing; this first one means no comparison follows
    //< **Only numbers can be compared** (a text cell gives "not a number").
    //< The result is 1 (true) or 0 (false). Multiply for "and"; add and test > 0 for "or".
priv const CMP_EQ: Sz = 1
priv const CMP_NE: Sz = 2
priv const CMP_LT: Sz = 3
priv const CMP_LE: Sz = 4
priv const CMP_GT: Sz = 5
priv const CMP_GE: Sz = 6

priv fn compare_op(p: P$@): Sz //< reads the comparison operator that comes next
    //< **Check the two-character ones first** (or `<=` is split into `<` and `=`).
    addr.skip_ws(p.c@)
    c: = addr.at(p.c@)
    next: = addr.at_next(p.c@)
    if c == '<' && next == '='
        p.c.pos += 2
        return CMP_LE
    if c == '<' && next == '>'
        p.c.pos += 2
        return CMP_NE
    if c == '>' && next == '='
        p.c.pos += 2
        return CMP_GE
    if c == '<' || c == '>' || c == '='
        p.c.pos += 1
        return CMP_LT if c == '<' else (CMP_GT if c == '>' else CMP_EQ)
    return CMP_NONE

priv fn compared(op: Sz, a: F64, b: F64): Bool
    if op == CMP_EQ
        return a == b
    if op == CMP_NE
        return a != b
    if op == CMP_LT
        return a < b
    if op == CMP_LE
        return a <= b
    if op == CMP_GT
        return a > b
    return a >= b

priv fn parse_compare(p: P$@): Value //<
    //< Reads an expression and at most one comparison after it
    //< **It compares only once.** `A1<B1<C1` cannot be written (the first 1 or 0 would be compared
    //< with the next operand, which is not what it looks like).
    left: = parse_expr(p)
    op: = compare_op(p)
    if op == CMP_NONE
        return left
    right: = parse_expr(p)
    if !left.ok
        return left
    if !right.ok
        return right
    return number(1.0 if compared(op, left.num, right.num) else 0.0)

priv fn parse_pick(p: P$@): Value //< `<value where true> if <condition> else <value where false>`
    //< **Both sides are computed**, so the same formula touches the same cells every time. The
    //< error on the side not chosen is discarded (`0 if A1 = 0 else 1/A1` is 0 where A1 is 0). It
    //< chains to the right (`a if c else b if d else e`).
    if !p.enter()
        return Cell_error.syntax.failed()
    v: = parse_pick_body(p)
    p.leave()
    return v

priv fn parse_pick_body(p: P$@): Value //< `parse_pick` within one level of nesting
    yes: = parse_compare(p)
    if !word(p, "if")
        return yes
    cond: = parse_compare(p)
    if !word(p, "else")
        return Cell_error.syntax.failed()
    no: = parse_pick(p)
    if !cond.ok
        return cond
    return yes if cond.num != 0.0 else no

priv fn literal_of(text: U8[], spec: Number_spec): Value //< reads a text as a number
    //< **A text that does not parse is not a number** (it is not the same as 0).
    //< **It is read as a date only where the text's style sets a date format.** Read every text as
    //< a date, and a text meant as a number would become one too. Otherwise it is read as a number.
    if text.len <= 0
        return Cell_error.not_number.failed()
    if !spec.dated.same_dating(.none)
        if n: = day.day_of(text)
            return number(F64::n)
    v: = text.to_f64() catch
        return Cell_error.not_number.failed()
    return number(v)

priv fn eval(src: U8[], book: Book$@, g: Grid$@): Value //< computes one text as a formula
    //< **The leading `=` marks a formula; it is not part of it.** g is as in `P.g`.
    $p: = P::{ .c = Reader::{ .src = src, .pos = 1 }, .book = book, .g = g, .nest = 0 }
    v: = parse_pick(p@)
    addr.skip_ws(p.c@)
    // Anything left unread fails it; otherwise a typo would pass silently.
    // **Do not overwrite an error already set** (the first reason is closer to the fix).
    if v.ok && p.c.pos < p.c.src.len
        return Cell_error.syntax.failed()
    return v

priv fn compute(g: Grid$@, r: Sz, c: Sz): Value
    n: Inline$@ = cell_inline(g, r, c) catch
        return Cell_error.no_cell.failed()
    if !n.is_formula()
        return literal_of(n.text(), shown_as(g.book.sheet, n.style))
    return eval(n.text(), g.book, g)

priv fn value_at(g: Grid$@, r: Sz, c: Sz): Value //< cell (r, c)'s value
    //< **Coming back into a cell being computed means a cycle.**
    if r < 0 || r >= g.rows || c < 0 || c >= g.cols
        return Cell_error.no_cell.failed()
    i: = r * g.cols + c
    st: = g.state.get(i)
    if st == SETTLED
        return g.value.get(i)
    if st == WORKING
        return Cell_error.circular.failed()
    book: = g.book
    // Caution: **Once a chain is set aside, compute nothing more in this pass**: nothing it
    // computes is kept, and a range walking on would compute each later cell anew, without end.
    if book.deferring
        return Cell_error.no_cell.failed()
    // Caution: **Set the chain aside rather than go deeper**: each cell is several calls, and a
    // chain of thousands runs the stack out. What it stands for is not kept (`deferring`).
    if book.depth >= MAX_DEPTH
        if !book.deferring
            book.deferring = true
            book.deferred = Cell_at::{ .g = g, .r = r, .c = c }
        return Cell_error.no_cell.failed()
    g.state.set(i, WORKING)
    book.depth += 1
    v: = compute(g, r, c)
    book.depth -= 1
    if book.deferring
        g.state.set(i, UNVISITED)
        return v
    g.value.set(i, v)
    g.state.set(i, SETTLED)
    return v

priv fn settle(g: Grid$@, r: Sz, c: Sz): Value //< cell (r, c)'s value, however long its chain
    //< A chain set aside (`MAX_DEPTH`) has its deepest cell computed first, then is retried. **A
    //< cell set aside while it is already waiting depends on itself.** That is a cycle longer than
    //< one pass sees. It is marked as one, so the rest of it reads `#CYCLE!` as a short cycle does.
    book: = g.book
    $todo: = List<|Cell_at|>.new(book.arena)
    todo.push(Cell_at::{ .g = g, .r = r, .c = c })
    for todo.len > 0
        top: = todo.get(todo.len - 1)
        book.deferring = false
        book.depth = 0
        _v: = value_at(top.g, top.r, top.c)
        if !book.deferring
            todo.len -= 1
            continue
        d: = book.deferred
        if waits(todo@, d)
            i: = d.r * d.g.cols + d.c
            d.g.value.set(i, Cell_error.circular.failed())
            d.g.state.set(i, SETTLED)
            continue
        todo.push(d)
    book.deferring = false
    book.depth = 0
    return value_at(g, r, c)

priv fn waits(todo: List<|Cell_at|>$@, d: Cell_at): Bool //< whether d is already set aside
    for t in todo@
        if t.g == d.g && t.r == d.r && t.c == d.c
            return true
    return false

// ---- Writing a value into a text ----

priv fn shown_as(sheet: Sheet$@, name: U8[]): Number_spec //<
    //< The number format that the text's style sets
    //< **It is not inherited** (only the text's own style; an unknown name stays plain).
    if sheet != null
        if s: = sheet.find(name)
            return s.number
    return style.plain_number()

priv fn show(n: Inline$@, v: Value, book: Book$@, out: Str_builder$@) //<
    //< Sets the resulting value as the text to show
    //< **The typed text is not rewritten** (it would disagree with the undo record's positions).
    //< Caution: **Clear the value of a text that is not a formula.** Otherwise the old value still
    //< shows after the formula is typed over. **The run being typed in keeps its value too**
    //< (export reads it); only the screen lays it out as typed (`Inline.face`).
    // A number is set on every cell, formula or not: **a chart reads it**.
    num: F64? = .some(v.num) if v.ok else .none
    if !n.is_formula()
        // Caution: **Clear only the text and set the number** (a chart reads this cell too).
        n.show_value("", num, false, book.kept)
        return
    out.clear()
    if v.ok
        shown.write_shown(out, v.num, shown_as(book.sheet, n.style))
    else
        out.s(v.err.error_text())
    n.show_value(out.slice(), num, n == book.editing, book.kept)

// ---- Recomputing a table ----

priv fn recalc_grid(g: Grid$@, out: Str_builder$@)
    for $r: Sz = 0; r < g.rows; r += 1
        for $c: Sz = 0; c < g.cols; c += 1
            v: = settle(g, r, c)
            // Caution: **Let every cell through** (`show` clears an old value from a non-formula
            // cell).
            if n: = cell_inline(g, r, c)
                show(n, v, g.book, out)

priv fn show_free(n: Inline$@, book: Book$@, out: Str_builder$@) //< one text in the body
    //< Where it is a formula, it is computed and its value set as the text to show.
    if !n.is_formula()
        // **No number is set either** (a chart never reads a text outside a cell).
        n.show_value("", .none, false, book.kept)
        return
    show(n, eval(n.text(), book, null), book, out)

priv fn show_prose(b: Block$@, sheet: Sheet$@, book: Book$@, out: Str_builder$@) //<
    //< Computes the body's formulas
    //< **A cell's first inline is not computed here** (its table does that, knowing its own table).
    //< The runs from the second on, and a table's or row's own texts, count as the body.
    for $i: Sz = 0; i < b.inlines.len; i += 1
        show_free(b.inlines.get(i), book, out)
    if !sheet.arrange_of(b.style).same_arrange(.grid)
        for $i: Sz = 0; i < b.children.len; i += 1
            show_prose(b.children.get(i), sheet, book, out)
        return
    for $r: Sz = 0; r < b.children.len; r += 1
        row: = b.children.get(r)
        for $i: Sz = 0; i < row.inlines.len; i += 1
            show_free(row.inlines.get(i), book, out)
        for $c: Sz = 0; c < row.children.len; c += 1
            cell: = row.children.get(c)
            // Index 0 is the cell the table computes.
            for $i: Sz = 1; i < cell.inlines.len; i += 1
                show_free(cell.inlines.get(i), book, out)
            for $k: Sz = 0; k < cell.children.len; k += 1
                show_prose(cell.children.get(k), sheet, book, out)

priv fn collect(b: Block$@, sheet: Sheet$@, book: Book$@) //<
    //< Finds the tables and collects them into book
    //< A table inside a cell counts as another table.
    //< Caution: **Collect them all before computing.** Otherwise a formula pointing at a table not
    //< yet collected reads "unknown name", and the result depends on the order written.
    if sheet.arrange_of(b.style).same_arrange(.grid)
        book.grids.push(new_grid(b, book))
    for $i: Sz = 0; i < b.children.len; i += 1
        collect(b.children.get(i), sheet, book)

fn takes_formula(d: Doc$@, sheet: Sheet$@, n: Inline$@): Bool //<
    //< Whether n's text may be replaced whole as a formula
    //< Any inline takes a formula when `=` is typed; this entry point is for **editing** one whose
    //< visible text has become its value. **In the body it opens only where a formula already
    //< exists** (otherwise one key press could replace a whole paragraph).
    if n == null
        return false
    if n.is_formula()
        return true
    for $i: Sz = 0; i < d.blocks.len; i += 1
        if seek_cell(d.blocks.get(i), sheet, n)
            return true
    return false

priv fn seek_cell(b: Block$@, sheet: Sheet$@, n: Inline$@): Bool
    if sheet.arrange_of(b.style).same_arrange(.grid)
        for $r: Sz = 0; r < b.children.len; r += 1
            row: = b.children.get(r)
            for $c: Sz = 0; c < row.children.len; c += 1
                cell: = row.children.get(c)
                if cell.inlines.len > 0 && cell.inlines.get(0) == n
                    return true
    for $i: Sz = 0; i < b.children.len; i += 1
        if seek_cell(b.children.get(i), sheet, n)
            return true
    return false

fn recalc(d: Doc$@, sheet: Sheet$@, editing: Inline$@ = null) //<
    //< Recomputes the document's tables
    //< Caution: **Call it before layout**: the texts change, so the boxes would point at old ones.
    //< **Also move the cursor back in bounds** (`Editor.clamp` in `write/typing.kspl`): a shrunk
    //< text leaves it outside. **Build the tables' structure here and throw it away here**; in the
    //< document's arena it would pile up at every keystroke.
    $out: = Str_builder.new()
    scratch: = Arena.new(16 * 1024)
    defer scratch.free()
    book: = new_book(sheet, scratch, d.arena, editing)
    for $i: Sz = 0; i < d.blocks.len; i += 1
        collect(d.blocks.get(i), sheet, book)
    // Caution: **Compute under the same book**, or a cycle across tables is not detected.
    for $i: Sz = 0; i < book.grids.len; i += 1
        recalc_grid(book.grids.get(i), out@)
    // **The body is computed after the tables** (it points at their cells by name).
    for $i: Sz = 0; i < d.blocks.len; i += 1
        show_prose(d.blocks.get(i), sheet, book, out@)

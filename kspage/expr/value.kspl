//< One cell's value, and the reason when there is no value
//< The functions that fold a range are here too.
//< **It knows neither the document, the cell, nor the formula's text.** Which cell a value came
//< from is [`calc.kspl`](calc.kspl)'s concern. So the folding alone can be tested.
//< **Turning the reason into text happens in this one place** (`error_text`), or the mark differs
//< between the screen and the exported text.
import "kspage/expr/addr" { BROKEN_REF }
import "kspage/expr/shown"
import "std/str"

enum Cell_error //< the reason there is no value
    //< **It is shown as visible text**, so the kinds are chosen to show how to fix it.
    syntax //< it does not read as a formula
    no_cell //< there is no cell where it points
    not_number //< what it points at is not a number
    circular //< it loops back to itself
    no_name //< an unknown name (a function's name, or a table's)

impl Cell_error
    fn error_text(e: Self): U8[]
        switch e
        case .syntax
            return "#SYNTAX!"
        case .no_cell
            return BROKEN_REF
        case .not_number
            return "#VALUE!"
        case .circular
            return "#CYCLE!"
        case .no_name
            return "#NAME!"
        return "#SYNTAX!"

    fn failed(e: Self): Value
        return Value::{ .num = 0.0, .ok = false, .err = e }

struct Value //< one cell's value
    num: F64
    ok: Bool //< whether it is a number. Where false, err is the reason
    err: Cell_error

fn number(v: F64): Value //< v as a value; an infinity or a NaN is not a number
    //< **This is the one place that refuses them**, whatever made them (a division by 0, a product
    //< or a total past an F64's range). Written as text, they could not be read back.
    // `v - v` is 0 for a finite v, and a NaN for an infinity or a NaN.
    if !(v - v == 0.0)
        return Cell_error.not_number.failed()
    return Value::{ .num = v, .ok = true, .err = .syntax }

fn rounded(v: F64, places: F64): Value //< the value rounded to places decimals
    //< **It is separate from the decimal places of the display**: it changes the value itself. How
    //< it rounds, and what is too large to round, is at `shown.round_to`.
    if places < 0.0 || places > 9.0
        return Cell_error.not_number.failed()
    return number(shown.round_to(v, Sz::I64::places))

priv const FN_SUM: Sz = 0 //<
    //< The functions that fold a range
    //< **Only what the existing operations cannot express is added.** An average is
    //< `r.sum() / r.count()` and an absolute value is `-A1 if A1 < 0 else A1`, so neither exists.
priv const FN_MIN: Sz = 1
priv const FN_MAX: Sz = 2
priv const FN_COUNT: Sz = 3

fn fn_kind(name: U8[]): Sz
    if name.equals("sum")
        return FN_SUM
    if name.equals("min")
        return FN_MIN
    if name.equals("max")
        return FN_MAX
    if name.equals("count")
        return FN_COUNT
    return -1

struct Fold //< the state partway through folding, taking the arguments' values one at a time
    kind: Sz
    acc: F64
    seen: Sz //< how many were counted as numbers
    broken: Bool
    err: Cell_error

fn take(f: Fold$@, v: Value) //< takes one value
    //< **Every error is carried through**, or a broken formula's total would look right. Which
    //< cells a range skips (typed text that is no number) is the caller's to say: it knows the cell
    //< (`take_span` in `calc.kspl`).
    if f.broken
        return
    if !v.ok
        f.broken = true
        f.err = v.err
        return
    f.seen += 1
    if f.kind == FN_COUNT
        return
    if f.kind == FN_SUM
        f.acc += v.num
        return
    first: = f.seen == 1
    if first || (f.kind == FN_MIN && v.num < f.acc) || (f.kind == FN_MAX && v.num > f.acc)
        f.acc = v.num

fn folded(f: Fold$@): Value //< the value after folding
    //< **With no numbers at all**, a total and a count are 0, but the smallest and the largest do
    //< not exist.
    if f.broken
        return f.err.failed()
    if f.kind == FN_COUNT
        return number(F64::f.seen)
    if f.kind == FN_SUM
        return number(f.acc)
    return Cell_error.not_number.failed() if f.seen <= 0 else number(f.acc)

//< The editing core (`Editor`)
//<
//< Only `Editor` changes the document's text.
//< Only [`shape.kspls`](shape.kspls) may call the `do_*` functions.
//< `Editor`'s methods are split across two files, so a user imports both (with only one, the
//< other's methods are not visible).

// ==========================================
// Usage:
//   ed: = edit.new_editor(doc);
//   ed.point_to(page, 120.0, 30.0, false);
//   ed.insert("a");
// ==========================================
import "kspage/expr/shift" + { Shift }
import "kspage/lay/caret" + { Caret }
import "kspage/model/doc" { Axis, Block, Doc }
import "kspage/model/run" + { Inline }
import "kspage/share/trail" { Trail }
import "kspage/write/field"
import "kspage/write/record" { Again, Block_op, Line_op, Op, Run_op, Size_op, Step, last_moved,
  new_step, push_op, summary_of }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"

struct Editor //< the editing state
  //<
  //< The document, the cursor and the undo record together.
  //< Caution: **Changes must go through here**, or nothing is left in the record to undo.
  doc: Doc$@
  caret: Caret
  pick: Block$@ //<
    //< The selected frame (a container's child), or null.
    //<
    //< The cursor cannot point at a shape (it holds no text), so the handles, the numbers and
    //< deletion act on this (`frame_at` in `block.kspls`). One at a time (`../docs/DESIGN.md`,
    //< "One frame is selected at a time").
  trail: Trail$@ //<
    //< The change history.
    //<
    //< null keeps no history (the caller's choice).
    //< Caution: **Open it anew once the document is reloaded** (`open` in
    //< [`trail.kspls`](trail.kspls)), or its "when, who and what" is added to another document.
  again: Again //<
    //< The last command that can be repeated ("do it again", F4).
    //<
    //< The command itself sets it when it succeeds; it is not worked out from the record afterwards
    //< (`Again` in [`record.kspls`](record.kspls) says why).
    //< It is not stored in the document (like the cursor).
  read_only: Bool //<
    //< Whether it was opened read-only.
    //<
    //< It is not stored in the document (it is "how it was opened"; stored, a copy would still call
    //< itself "read-only"). `shut()` checks it (in the `impl` below).
  // The steps that can be undone, and the steps that can be redone.
  priv undone: List<|Step$@|>$@
  priv redone: List<|Step$@|>$@
  priv open: Step$@ //< the step being written to now. null means none is open
  arena: Arena$@

fn new_editor(d: Doc$@): Editor$@ //<
  //< Makes an editor for the document `d`.
  //<
  //< The editor lives in the document's arena (it lives exactly as long; the same reason as
  //< `add_text` in `model/doc.kspls`).
  arena: = d.arena
  e: = Editor::{
    .doc = d,
    .caret = caret.nowhere(),
    .pick = null,
    .again = Again.none,
    .read_only = false,
    .trail = null,
    .undone = List<|Step$@|>.create(arena),
    .redone = List<|Step$@|>.create(arena),
    .open = null,
    .arena = arena,
  }
  return arena.create(e)

impl Editor
  fn picked(r: Self$@): Block$@ //< the selected frame
    //<
    //< null where there is none. Read it through `frame_at` in `block.kspls`, which checks the
    //< frame is still in the tree.
    return r.pick

  fn holds_pick(r: Self$@, b: Block$@): Bool //< whether that frame is the selected one
    return b != null && r.pick == b

  fn pick_only(r: Self$@, b: Block$@) //< selects that frame
    //<
    //< Caution: **Remove the handles from the previous one** (only what was clicked is selected).
    //< null selects nothing.
    r.pick = b

fn keep(e: Editor$@, into: Step$@, op: Op) //< adds one operation to the undo record
  //<
  //< This is the only place that adds them (a second place would miss a newly added operation).
  _unused: = e
  into.ops.push(op)

fn do_insert(e: Editor$@, into: Step$@, n: Inline$@, at: Sz, s: U8[]) //<
  //< Inserts and deletes while recording
  //<
  //< These two are the only functions that change a text.
  //< Caution: **Do not call them from typing.** `Editor.insert` in `typing.kspls` finishes off the
  //< selected range and the composition mark.
  //< Where `into` is null it goes into neither the record nor the peer: for an incoming operation
  //< (undoable, the peer's typing would be silently deleted), and for the text being composed
  //< (`set_preedit` in [`typing.kspls`](typing.kspls)).
  n.insert(at, s)
  keep_insert(e, into, n, at, s)

fn keep_insert(e: Editor$@, into: Step$@, n: Inline$@, at: Sz, s: U8[]) //<
  //< Records a text that is already inserted, afterwards
  //<
  //< It does not insert the text.
  //< Note: Committing a composition goes through here (`commit_preedit` in
  //< [`typing.kspls`](typing.kspls)). The text being composed entered the document without going
  //< through the record, so it is recorded as "typed" only when it is committed.
  if into == null
    return
  push_op(into, e.arena, n, at, false, s.len, "")

fn do_remove(e: Editor$@, into: Step$@, n: Inline$@, at: Sz, len: Sz)
  if len <= 0
    return
  if into != null
    // Caution: Copy it before deleting. After deleting it cannot be read.
    push_op(into, e.arena, n, at, true, 0, n.text().sub(at, len))
  n.remove(at, len)

fn do_set_size(e: Editor$@, into: Step$@, table: Block$@, axis: Axis, index: Sz,
  v: Option<|F32|>) //<
    //< Sets a column's width (or a row's height) while recording.
    //<
    //< Caution: **Do not change the table directly, just as with text.**
  if into != null
    // Moving the same position again and again adds nothing (the first saved setting undoes it).
    if !last_moved(into, table, axis, index)
      // Save the old value before changing it.
      op: = Size_op::{ .table = table, .axis = axis, .index = index,
        .was = table.size_of(axis, index) }
      keep(e, into, Op.size(e.arena.create(op)))

  table.set_size(axis, index, v)

fn do_line(e: Editor$@, into: Step$@, table: Block$@, axis: Axis, at: Sz, put_back: Bool,
  blocks: List<|Block$@|>$@, spans: List<|Sz|>$@, size: Option<|F32|>) //<
    //< Removes a row (or column), or restores it, while recording.
    //<
    //< Caution: **Do not touch the table directly.**
    //< `spans` is empty for a new column, and filled when a removal is being restored (`Line_op`
    //< says why the table cannot be read for it).
  if put_back
    table.attach_line(axis, at, blocks, spans, e.arena)
    table.open_line(axis, at)
    table.set_size(axis, at, size)
    if into != null
      op: = Line_op::{ .table = table, .axis = axis, .at = at, .put_back = false,
        .blocks = List<|Block$@|>.create(e.arena), .spans = List<|Sz|>.create(e.arena),
        .size = Option<|F32|>.none }
      keep(e, into, Op.line(e.arena.create(op)))
    return
  // Caution: **Save it before removing it.** Once removed, which block it was cannot be read.
  took: = List<|Sz|>.create(e.arena)
  gone: = table.detach_line(axis, at, took, e.arena)
  was: = table.close_line(axis, at)
  if into != null
    op: = Line_op::{ .table = table, .axis = axis, .at = at, .put_back = true, .blocks = gone,
      .spans = took, .size = was }
    keep(e, into, Op.line(e.arena.create(op)))

fn do_run(e: Editor$@, into: Step$@, b: Block$@, at: Sz, put_back: Bool, n: Inline$@) //<
  //< Removes one inline or restores it, while recording
  //<
  //< Caution: **Do not touch the list directly.** A restored inline comes with its text (so it is
  //< not always empty). An inline holding a formula does not go through here.
  if put_back
    if at < 0 || at > b.inlines.len
      return
    b.inlines.insert(at, n)
    if into != null
      op: = Run_op::{ .block = b, .at = at, .put_back = false, .run = null }
      keep(e, into, Op.run(e.arena.create(op)))
    return
  if at < 0 || at >= b.inlines.len
    return
  if into != null
    // Caution: **Copy it before removing it.** Once removed, which inline it was cannot be read.
    op: = Run_op::{ .block = b, .at = at, .put_back = true, .run = b.inlines.get(at) }
    keep(e, into, Op.run(e.arena.create(op)))
  b.inlines.remove_at(at)

fn do_block(e: Editor$@, into: Step$@, parent: Block$@, at: Sz, put_back: Bool, b: Block$@) //<
  //< Removes one block or restores it, while recording
  //<
  //< Caution: **Do not touch the list directly.**
  //< Where `parent` is null it is at the top level of the document. Otherwise as `do_run`.
  kin: = e.doc.kin_of(parent)
  if put_back
    if at < 0 || at > kin.len
      return
    kin.insert(at, b)
    if into != null
      op: = Block_op::{ .parent = parent, .at = at, .put_back = false, .block = null }
      keep(e, into, Op.block(e.arena.create(op)))
    return
  if at < 0 || at >= kin.len
    return
  if into != null
    // Caution: **Copy it before removing it.** Once removed, which block it was cannot be read.
    op: = Block_op::{ .parent = parent, .at = at, .put_back = true, .block = kin.get(at) }
    keep(e, into, Op.block(e.arena.create(op)))
  kin.remove_at(at)

fn replace_source(e: Editor$@, into: Step$@, n: Inline$@, s: U8[]) //< replaces the text with `s`
  //<
  //< Formulas are replaced here too: a text starting with `=` becomes a formula at the next
  //< recalculation, and undo restores the old one (`apply_inverse`).
  do_remove(e, into, n, 0, n.text().len)
  do_insert(e, into, n, 0, s)

fn shift_formulas(e: Editor$@, into: Step$@, table: Block$@, axis: Axis, at: Sz, delta: Sz) //<
  //< Rewrites all formulas in the document to follow rows (or columns) being added or removed
  //<
  //< Caution: **Record it in the same step as the row or column that moved**, or the first undo
  //< restores only the row and leaves the formulas stranded. Call it after the removal, so a
  //< removed row keeps its formulas as they are for restoring.
  // ---- applying a style ----
  plans: = List<|Shift|>.create(e.arena)
  shift.plan_shift(e.doc, table, axis, at, delta, plans, e.arena)
  for $i: Sz = 0; i < plans.len; i += 1
    s: = plans.get(i)
    replace_source(e, into, s.inline, s.source)

// ---- laying a style on ----

fn split_run(e: Editor$@, into: Step$@, n: Inline$@, offset: Sz): Option<|Inline$@|> //<
  //< Splits `n` in two at `offset` and returns the second half
  //<
  //< Where the split is at an end it does nothing and returns null.
  //< An inline holding a formula is not split — its text is the result, rewritten whole at the next
  //< recalculation, and a second half would keep the old value.
  text: = n.text()
  // An inline that refers to something is not split either (its text is one whole name).
  if offset <= 0 || offset >= text.len || n.is_formula() || n.refers.len > 0
    return Option<|Inline$@|>.none
  own: = e.doc.owner_of(n)
  if !own.found
    return Option<|Inline$@|>.none
  tail: = run.new_inline(n.style, e.arena)
  // Caution: **Copy the link too** (the second half points at the same place).
  tail.href = n.href
  // Copy the annotation too (it applies to a range).
  tail.remark = n.remark
  tail.remark_by = n.remark_by
  // The note is not copied (its mark would show twice); it stays on the first half.
  do_run(e, into, own.block, own.index + 1, true, tail)
  // Caution: **Copy the text, then delete.** After deleting it cannot be read.
  do_insert(e, into, tail, 0, text.sub(offset, text.len - offset))
  do_remove(e, into, n, offset, text.len - offset)
  caret.carry_tail(e.caret@, n, offset, tail)
  return Option<|Inline$@|>.some(tail)

fn merge_runs(e: Editor$@, into: Step$@, b: Block$@) //<
  //< Joins neighbouring inlines with the same style and the same link into one
  //<
  //< Caution: **Call it every time a style is applied**, or applying and removing keeps adding
  //< inlines. Not joined: an inline holding a formula (out of step at the next recalculation),
  //< inlines with different links, an inline with a note (its mark would move).
  $i: Sz = 0
  for i + 1 < b.inlines.len
    a: = b.inlines.get(i)
    next: = b.inlines.get(i + 1)
    if a.is_formula() || next.is_formula() || !a.style.equals(next.style) ||
      !a.href.equals(next.href) || a.note.len > 0 || next.note.len > 0 ||
      !a.remark.equals(next.remark) || !a.remark_by.equals(next.remark_by) || a.refers.len > 0 ||
      next.refers.len > 0
      i += 1
      continue
    at: = a.text().len
    // The removed inline's text is not deleted (it is restored as it is).
    do_insert(e, into, a, at, next.text())
    do_run(e, into, b, i + 1, false, null)
    caret.carry_all(e.caret@, next, a, at)

priv fn apply_inverse(e: Editor$@, st: Step$@, into: Step$@) //<
  //< Applies a step's inverse, and records the inverse of that into `into`
  //<
  //< The inverse of the inverse is the original change.
  //< Caution: **Apply them from the back**, or the position a later change looked at shifts. Undo
  //< and redo both go through here (two places would diverge when a kind is added).
  for $i: Sz = st.ops.len; i > 0; i -= 1
    switch st.ops.get(i - 1) case .text(op)
      if op.put_back
        do_insert(e, into, op.inline, op.at,
          U8[]::{ .ptr = op.text.ptr, .len = op.text.len })
      else
        do_remove(e, into, op.inline, op.at, op.len)
    case .size(op)
      do_set_size(e, into, op.table, op.axis, op.index, op.was)
    case .line(op)
      do_line(e, into, op.table, op.axis, op.at, op.put_back, op.blocks, op.spans, op.size)
    case .run(op)
      do_run(e, into, op.block, op.at, op.put_back, op.run)
    case .block(op)
      do_block(e, into, op.parent, op.at, op.put_back, op.block)
    case .style(op)
      field.do_set_style(e, into, op.run, op.was)
    case .frame(op)
      field.do_set_frame(e, into, op.block, op.was)
    case .look(op)
      field.do_set_look(e, into, op.style, op.was)
    case .paper(op)
      field.do_set_paper(e, into, op.sheet, op.was)
    case .sheet(op)
      field.do_sheet(e, into, op.sheet, op.at, op.put_back, op.style)
    case .span(op)
      field.do_set_span(e, into, op.cell, op.was_rows, op.was_cols)
    case .href(op)
      field.do_set_href(e, into, op.run, op.was)
    case .note(op)
      field.do_set_note(e, into, op.run, op.was)
    case .remark(op)
      field.do_set_remark(e, into, op.run, op.was, op.was_by)
    case .name(op)
      field.do_set_name(e, into, op.block, op.was)
    case .refer(op)
      field.do_set_refers(e, into, op.run, op.was)
    case .block_face(op)
      field.do_set_block_style(e, into, op.block, op.was)
    case .aside(op)
      field.do_set_aside(e, into, op.block, op.was)
    case .aim(op)
      field.do_set_aim(e, into, op.block, op.was)
    case .step(op)
      field.do_set_step(e, into, op.block, op.was)

impl Editor
  fn shut(r: Self$@): Bool //< whether a change is refused
    //<
    //< Every function that changes the document must check this before doing anything, so
    //< read-only can be enforced in one place. `make test-conventions` holds each function in this
    //< folder that opens a step to it.
    //< Caution: **Do not enforce it in the `do_*` functions.** If they quietly did nothing, a
    //< caller that "repeats until it acts" (`join_here` in `block.kspls`) would never end.
    return r != null && r.read_only

  fn step(r: Self$@): Step$@ //< the step to write to
    //<
    //< Opens one where there is none.
    if r.open == null
      r.open = new_step(r.caret, r.arena)
      // Anything new drops the redo steps (otherwise redo jumps to a text that does not match).
      r.redone.len = 0
    return r.open

  fn break_group(r: Self$@) //< closes the open step
    //<
    //< This is where one undo ends. Moving and committing a composition close it by themselves; a
    //< pause in typing is for the caller to close (the core has no clock).
    if r.open == null
      return
    r.open.after = r.caret
    // A step that changed nothing is not stored (its undo would restore nothing).
    if r.open.ops.len > 0
      r.undone.push(r.open)
      r.mark(summary_of(r.open))
    r.open = null

  priv fn mark(r: Self$@, what: U8[]) //< holds back what was done for the history
    //<
    //< With no history kept, it does nothing. The caller adds the time and who.
    if r.trail == null
      return
    r.trail.wait(what)

  fn forget_history(r: Self$@) //< throws the whole undo record away
    //<
    //< It is called only when the document has been reloaded (what is remembered points at the old
    //< document).
    r.open = null
    r.undone.len = 0
    r.redone.len = 0

  fn undo(r: Self$@): Bool //<
    //< Goes back one step, and returns true if it did.
    //<
    //< Caution: **Do not undo while read-only.** The `do_*` below stop, but the record alone would
    //< move a step and report "undone" when nothing has changed.
    r.break_group()
    if r.undone.len <= 0 || r.shut()
      return false
    st: = r.undone.get(r.undone.len - 1)
    r.undone.len -= 1
    back: = new_step(st.after, r.arena)
    apply_inverse(r, st, back)
    back.after = st.before
    r.redone.push(back)
    r.caret = st.before
    r.mark("Undid")
    return true

  fn redo(r: Self$@): Bool //< redoes one undone step
    //<
    //< True if redone.
    r.break_group()
    if r.redone.len <= 0 || r.shut()
      return false
    st: = r.redone.get(r.redone.len - 1)
    r.redone.len -= 1
    forward: = new_step(st.after, r.arena)
    apply_inverse(r, st, forward)
    forward.after = st.before
    r.undone.push(forward)
    r.caret = st.before
    r.mark("Redid")
    return true

//< Converts between a table and CSV text
//<
//< Fields are separated by `,` and lines by a newline. A text holding a `,`, a `"` or a newline is
//< quoted in `"`, and a `"` inside is doubled as `""` (the rule of RFC 4180).
//< Caution: **The reader and the writer must share this rule**, or it cannot read what it wrote.
//< The shown text is written out (not the formula; saving as a document keeps that). A text a
//< spreadsheet would run as a formula gets a leading `'`, which reading takes off (`field_into`).
//< A loaded text goes into the cell as it is. A line break inside quotes becomes one space (an
//< `Inline` holds no line break; a paste into a cell does the same).
import "kspage/lay/caret"
import "kspage/lay/page" { Page }
import "kspage/model/doc" + { Block, Tile }
import "kspage/model/run" { Inline }
import "kspage/model/style" { Sheet, Style }
import "kspage/write/block"
import "kspage/write/edit" + { Editor }
import "kspage/write/shape"
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }

priv const QUOTE: U8 = '"'

priv fn tricky(text: U8[]): Bool //< whether the text has to be quoted
    for $i: Sz = 0; i < text.len; i += 1
        c: = text[i]
        if c == ',' || c == QUOTE || c == '\n' || c == '\r'
            return true
    return false

priv const GUARD: U8 = '\'' //< the mark that keeps a spreadsheet from reading a text as a formula

priv fn formula_like(text: U8[]): Bool //<
    //< Whether a spreadsheet opening the CSV would run the text, guarded or not
    //<
    //< **A run of `'` is looked through**, so the guard reads back (`unguarded`) whatever the text:
    //< `'=x` is written `''=x`. The characters are the ones OWASP's CSV-injection guidance names.
    $i: Sz = 0
    for i < text.len && text[i] == GUARD
        i += 1
    if i >= text.len
        return false
    c: = text[i]
    return c == '=' || c == '+' || c == '-' || c == '@' || c == '\t' || c == '\r'

priv fn field_into(out: Str_builder$@, text: U8[], number: Bool) //< writes one cell to `out`
    //<
    //< **A text a spreadsheet would run as a formula gets a leading `'`** (Excel's mark for "this
    //< is text"). A cell reading `+HYPERLINK(…)` or `-2+3` must stay words for whoever opens the
    //< file. **A cell whose value is a number never does** (`number`), so `-5` stays `-5`.
    $sb: = Str_builder.new()
    if !number && formula_like(text)
        sb.c(GUARD)
    sb.s(text)
    got: = sb.slice()
    if !tricky(got)
        out.s(got)
        return
    out.c(QUOTE)
    for $i: Sz = 0; i < got.len; i += 1
        if got[i] == QUOTE
            out.c(QUOTE)
        out.c(got[i])
    out.c(QUOTE)

priv fn unguarded(text: U8[]): U8[] //< a field read with the writer's `'` taken back off
    //<
    //< The counterpart of `field_into`: the `'` comes off exactly where the writer puts one on.
    if text.len > 0 && text[0] == GUARD && formula_like(text)
        return text.sub(1, text.len - 1)
    return text

fn write_table(t: Block$@, out: Str_builder$@, arena: Arena$@) //< writes one table as CSV text
    //<
    //< A cell's position is counted with the merges included (`Block.tiles_of`, the one count); a
    //< covered cell is an empty field. A newline follows the last line too.
    if t == null
        return
    tiles: = t.tiles_of(arena)
    cols: = t.grid_columns(arena)
    for $r: Sz = 0; r < t.children.len; r += 1
        for $c: Sz = 0; c < cols; c += 1
            if c > 0
                out.c(',')
            if n: = cell_inline(tiles, r, c)
                field_into(out, n.showing(), n.figure().is_some())
            else
                field_into(out, "", false)
        out.c('\n')

priv fn cell_inline(tiles: List<|Tile|>$@, row: Sz, column: Sz): Inline$@? //<
    //< The text of the cell at row `row`, column `column`; none for a covered or empty cell
    //<
    //< Its shown text is written, and whether its value is a number decides the guard
    //< (`field_into`).
    for $i: Sz = 0; i < tiles.len; i += 1
        one: = tiles.get(i)
        if one.row == row && one.column == column && one.block != null &&
            one.block.inlines.len > 0
            return .some(one.block.inlines.get(0))
    return .none

priv struct Reader //< the position reached while reading
    //<
    //< It is not the text cursor (that one is in `lay/caret.kspl`).
    //< Note: The formula reader has the same shape (`Reader` in `expr/addr.kspl`).
    src: U8[]
    pos: Sz

priv fn plain_field(c: Reader$@, out: Str_builder$@) //< reads an unquoted field
    //<
    //< Caution: **Stop before the separator and the newline** (those belong to the next field).
    for c.pos < c.src.len
        ch: = c.src[c.pos]
        if ch == ',' || ch == '\n' || ch == '\r'
            return
        out.c(ch)
        c.pos += 1

priv fn quoted_field(c: Reader$@, out: Str_builder$@) //<
    //< Reads a field quoted in `"`
    //<
    //< A `""` inside is one `"`, and a line break (`\r\n` too) one space. Unclosed, what there is
    //< so far is the field (a broken text that still loads is easier to fix).
    c.pos += 1
    for c.pos < c.src.len
        ch: = c.src[c.pos]
        if ch == '\r' || ch == '\n'
            out.c(' ')
            crlf: = ch == '\r' && c.pos + 1 < c.src.len && c.src[c.pos + 1] == '\n'
            c.pos += 2 if crlf else 1
            continue
        if ch != QUOTE
            out.c(ch)
            c.pos += 1
            continue
        if c.pos + 1 < c.src.len && c.src[c.pos + 1] == QUOTE
            out.c(QUOTE)
            c.pos += 2
            continue
        c.pos += 1
        return

priv fn read_row(c: Reader$@, out: List<|U8[]|>$@, arena: Arena$@): Bool //<
    //< Reads one line and appends the fields' texts to `out`
    //<
    //< Returns true once read. An empty line is one empty field. A `\r\n` is one line break.
    if c.pos >= c.src.len
        return false
    out.len = 0
    $more: = true
    for more
        $sb: = Str_builder.new()
        // Caution: **Read on to the separator after a closing quote** (`"q"junk` is `qjunk`).
        // Stopped there, the rest would start a row of its own.
        if c.pos < c.src.len && c.src[c.pos] == QUOTE
            quoted_field(c, sb@)
        plain_field(c, sb@)
        out.push(arena.dup_str(sb.slice()))
        more = c.pos < c.src.len && c.src[c.pos] == ','
        if more
            c.pos += 1
    if c.pos < c.src.len && c.src[c.pos] == '\r'
        c.pos += 1
    if c.pos < c.src.len && c.src[c.pos] == '\n'
        c.pos += 1
    return true

fn read_table(src: U8[], name: U8[], arena: Arena$@): Block$@? //<
    //< Builds a table block from CSV text
    //<
    //< If no line reads, no table is made. **The rows are padded to the longest** (otherwise the
    //< column count is undefined). The rows and cells get no style name (the screen offers no way
    //< to choose one).
    rows: = List<|List<|U8[]|>$@|>.create(arena)
    $wide: Sz = 0
    $c: = Reader::{ .src = src, .pos = 0 }
    one: = List<|U8[]|>.create(arena)
    for read_row(c@, one, arena)
        kept: = List<|U8[]|>.create(arena)
        for $i: Sz = 0; i < one.len; i += 1
            kept.push(one.get(i))
        if kept.len > wide
            wide = kept.len
        rows.push(kept)
    if rows.len <= 0 || wide <= 0
        return .none
    made: = doc.new_block(name, arena)
    for $r: Sz = 0; r < rows.len; r += 1
        row: = made.add_child("")
        got: = rows.get(r)
        for $i: Sz = 0; i < wide; i += 1
            text: = unguarded(got.get(i)) if i < got.len else ""
            row.add_child("").add_text(text)
    return .some(made)

impl Editor
    fn insert_csv(r: Self$@, page: Page$@, sheet: Sheet$@, name: U8[], src: U8[]): Bool //<
        //< Inserts one table from CSV text after the paragraph the cursor is in
        //<
        //< Returns true once inserted. The style decides the layout (as `insert_table`). **Nothing
        //< is inserted inside a table cell** (that row alone would gain a cell).
        if r.shut()
            return false
        room: = r.room_after_caret(page)
        if !room.found || src.len <= 0 || !r.fits_below(room.block, 3) // a table, rows, cells
            return false
        r.break_group()
        st: = r.step()
        $s: Style$@ = null
        switch r.styled(st, sheet, name, .grid)
        case .some(got)
            s = got
        case .none
            return false
        $made: Block$@ = null
        switch read_table(src, s.name, r.arena)
        case .some(got)
            made = got
        case .none
            return false
        edit.do_block(r, st, room.block, room.index + 1, true, made)
        head: = made.children.get(0).children.get(0)
        r.caret = caret.at(head.inlines.get(0), 0)
        r.break_group()
        return true

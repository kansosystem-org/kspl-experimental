//< The manual's first half (the title page, the contents, typing, formatting, headings)
//<
//< **Do not write a chapter number as text.** The style's `outline` gives the depth and
//< `Marker.outline` makes the "1.", so the document uses the very features it explains.
//< The style table is in [`manual.kspls`](manual.kspls). This file holds only the contents.
import "kspage/model/doc" { Doc, Rect, add_framed_child }

fn add_front(doc: Doc$@) //< the title page and the contents
  //<
  //< **What is inside the contents does not go into the document** (it is built from the headings
  //< at every layout).
  // **The title is one run and its text is only `kspage`**: the boundary's checks find it by its
  // text (add characters to the subtitle instead).
  doc.add_block("title").add_text("kspage")
  doc.add_block("subtitle")
    .add_text("The manual — an editing system for writing prose, tables and slides all in one \
      document")

  intro: = doc.add_block("body")
  intro.add_text("This manual is ")
  intro.add_text("written in kspage itself. ")
  intro
    .add_text("You may type over it where you stand as you read, to see for yourself. Shut the \
      window and open it afresh and it comes back.")

  doc.add_block("hint")
    .add_text("In a hurry, “2. The basics of typing” and “17. Keyboard shortcuts” are \
      enough on their own. Come back to the tables and the slides once you need them.")

  doc.add_block("subheading").add_text("Contents")
  doc.add_block("contents")

priv fn add_intro(doc: Doc$@) //< the opening chapter
  //<
  //< What this is, and how to open it.
  doc.add_block("chapter").add_text("Where this begins")

  p: = doc.add_block("body")
  p.add_text("kspage is an editing system for writing prose, tables and slides ")
  p.add_text("as one document", "strong")
  p.add_text(". The three are not separate tools; the same tree is only laid out differently.")

  t: = doc.add_block("table")
  h: = t.add_child("")
  h.add_child("heading-cell").add_text("The look")
  h.add_child("heading-cell").add_text("The laying")
  h.add_child("heading-cell").add_text("What it is for")
  r1: = t.add_child("")
  r1.add_child("cell").add_text("Prose")
  r1.add_child("cell").add_text("Flowed in")
  r1.add_child("cell").add_text("Reports, design papers, letters")
  r2: = t.add_child("")
  r2.add_child("cell").add_text("Table")
  r2.add_child("cell").add_text("Grid")
  r2.add_child("cell").add_text("Quotations, totals, listings")
  r3: = t.add_child("")
  r3.add_child("cell").add_text("Slide")
  r3.add_child("cell").add_text("Absolute coordinates")
  r3.add_child("cell").add_text("Slides that explain, diagrams")

  doc.add_block("section").add_text("Opening it")

  o1: = doc.add_block("body")
  o1.add_text("What comes out is one HTML file. ")
  o1.add_text("Double-clicking it to open is all there is to it.", "strong")

  doc.add_block("bullet")
    .add_text("No web server is wanted (the wasm and the JS are both inside that one file).")
  doc.add_block("bullet")
    .add_text("Nothing has to be installed either. The browser you already use will do.")
  doc.add_block("bullet")
    .add_text("Copy that one file to another machine and it opens there the same way.")

  doc.add_block("section").add_text("How the screen reads")

  view: = doc.add_block("body")
  view.add_text("The screen parts into five.")

  v: = doc.add_block("table")
  vh: = v.add_child("")
  vh.add_child("heading-cell").add_text("Name")
  vh.add_child("heading-cell").add_text("Where")
  vh.add_child("heading-cell").add_text("What is there")
  v1: = v.add_child("")
  v1.add_child("cell").add_text("The menu bar")
  v1.add_child("cell").add_text("At the very top")
  v1.add_child("cell").add_text("File, Style, Table, Insert, Share, Review. A press opens one")
  v2: = v.add_child("")
  v2.add_child("cell").add_text("The ribbon")
  v2.add_child("cell").add_text("Below it")
  v2.add_child("cell").add_text("The commands used most are listed. They can be reordered")
  v3: = v.add_child("")
  v3.add_child("cell").add_text("The editing area")
  v3.add_child("cell").add_text("In the middle")
  v3.add_child("cell").add_text("The document itself. Press here and type")
  v4: = v.add_child("")
  v4.add_child("cell").add_text("Navigation")
  v4.add_child("cell").add_text("On the right")
  v4.add_child("cell")
    .add_text("Splits into the 4 tabs Headings, Slides, Placed and Files. Press one to move there")
  v5: = v.add_child("")
  v5.add_child("cell").add_text("The status bar")
  v5.add_child("cell").add_text("At the very bottom")
  v5.add_child("cell").add_text("Where you are, what a press did, how many pages there are")

  nav: = doc.add_block("body")
  nav.add_text("The navigation on the right is put out and folded with the ")
  nav.add_text("Navigation", "key")
  nav.add_text(" to the menu bar's right. The ")
  nav.add_text("✕", "key")
  nav.add_text(" inside the panel folds it too.")

  doc.add_block("bullet")
    .add_text("Headings — the whole document's headings and contents. A press moves there.")
  doc.add_block("bullet")
    .add_text("Slides — the slides inside the document. A press moves to that slide.")
  doc.add_block("bullet")
    .add_text("Placed — the shapes and images laid on the slide or the cell you are in. A press \
      selects one. What is nearest the front is listed on top.")

  doc.add_block("hint")
    .add_text("To the right of a tab's name is how many are inside it. Without opening it you can \
      read “there are three things placed”.")

  doc.add_block("warning")
    .add_text("Only the one tab you chose comes out. The tab chosen is remembered, so the same one \
      comes out the next time you open it.")

  wide: = doc.add_block("body")
  wide
    .add_text("The panel's width can be changed. Bring the mouse to the seam between the panel and \
      the body and the arrow changes; drag it left or right from there. Widen it when a long \
      heading is cut off and cannot be read. The width you changed is remembered, so it is the same \
      width the next time you open it.")

  doc.add_block("bullet")
    .add_text("Pressing the seam and typing ← → changes the width too (16 dots a press). This \
      is the way when holding the thin seam down with the mouse is hard.")
  doc.add_block("bullet").add_text("Press the seam twice and it returns to the width it was.")

  doc.add_block("warning")
    .add_text("It widens as far as half the window and no further, because once the body is \
      narrower than the panel the navigation eats the part you are reading.")

  doc.add_block("hint")
    .add_text("While you are editing, a region of prose, a table and a slide are each fenced in a \
      grey dotted line. That dotted line comes out neither in printing nor in the HTML written out.")

  rc: = doc.add_block("body")
  rc.add_text("Over the body, a ")
  rc.add_text("right-click", "strong")
  rc
    .add_text(" opens a menu that acts where you are. Comment, Link, Footnote and Style are listed, \
      and inside a table's cell putting rows and columns in and out is listed too.")

  doc.add_block("warning")
    .add_text("Over a menu or a tool the browser's own menu comes out as it is. Cut, copy and paste \
      are done by key (Ctrl+X / Ctrl+C / Ctrl+V).")

  zm: = doc.add_block("body")
  zm.add_text("To look at it larger, use ")
  zm.add_text("the browser's zoom", "strong")
  zm.add_text(" (")
  zm.add_text("Ctrl", "key")
  zm.add_text(" and ")
  zm.add_text("+", "key")
  zm.add_text(" / ")
  zm.add_text("−", "key")
  zm.add_text("). The menus grow with it.")

  doc.add_block("warning")
    .add_text("Zooming changes nothing in the document. What is copied to paper does not move, so \
      what is printed is the same.")

  // The screen figure. **Place the frames first and the numbers after**: a frame without a number
  // in between restarts the count at 1.
  shot: = doc.add_block("slide")
  add_framed_child(shot, "screen-bar", Rect::{ .x = 40.0, .y = 16.0, .w = 480.0, .h = 24.0 })
    .add_text("File   Style   Table   Insert   Share   Review   ?")
  add_framed_child(shot, "screen-bar", Rect::{ .x = 40.0, .y = 44.0, .w = 480.0, .h = 24.0 })
    .add_text("Undo  Redo │ Bold  Italic │ Table  Slide  Image  Link │ Save  Print")
  add_framed_child(shot, "screen-area",
    Rect::{ .x = 40.0, .y = 72.0, .w = 340.0, .h = 130.0 }).add_text("The document itself")
  add_framed_child(shot, "screen-area",
    Rect::{ .x = 386.0, .y = 72.0, .w = 134.0, .h = 130.0 }).add_text("Headings / Slides / Placed")
  add_framed_child(shot, "screen-bar",
    Rect::{ .x = 40.0, .y = 206.0, .w = 480.0, .h = 22.0 })
    .add_text("body        ✓ Noted                       Slide 1")
  add_framed_child(shot, "number-dot", Rect::{ .x = 8.0, .y = 16.0, .w = 24.0, .h = 24.0 })
    .add_text("1")
  add_framed_child(shot, "number-dot", Rect::{ .x = 8.0, .y = 44.0, .w = 24.0, .h = 24.0 })
    .add_text("2")
  add_framed_child(shot, "number-dot", Rect::{ .x = 8.0, .y = 122.0, .w = 24.0, .h = 24.0 })
    .add_text("3")
  add_framed_child(shot, "number-dot",
    Rect::{ .x = 528.0, .y = 122.0, .w = 24.0, .h = 24.0 }).add_text("4")
  add_framed_child(shot, "number-dot", Rect::{ .x = 8.0, .y = 205.0, .w = 24.0, .h = 24.0 })
    .add_text("5")

  doc.add_block("caption").add_text("The screen's five places")

  doc.add_block("step").add_text("The menu bar. A press opens one.")
  doc.add_block("step")
    .add_text("The ribbon. The commands used most are listed. What is put out can be chosen, and \
      they can be reordered. The font colour, the highlight colour, the paragraph style and the \
      alignment each open a choice on a press (press again or Esc to shut it). A group that does \
      not fit goes into the … at the right end.")
  doc.add_block("step").add_text("The editing area. Press here and type.")
  doc.add_block("step")
    .add_text("Navigation. It splits into the 4 tabs Headings, Slides, Placed and Files.")
  doc.add_block("step")
    .add_text("The status bar. Where you are, what a press did, how many pages there are.")

priv fn add_typing(doc: Doc$@) //< the chapter on typing something first
  doc.add_block("chapter").add_text("The basics of typing")

  p: = doc.add_block("body")
  p
    .add_text("Press over a character and the cursor (an upright bar) stands there. You can type \
      from there.")

  doc.add_block("section").add_text("Typing, and parting a line")

  doc.add_block("step").add_text("Press where you want to type.")
  doc.add_block("step")
    .add_text("Type. A character no key carries goes in as it stands (an underline comes out while \
      it is being composed).")
  doc.add_block("step").add_text("Press Enter and the paragraph parts in two there.")

  back: = doc.add_block("body")
  back.add_text("At the head of the paragraph that parted, ")
  back.add_text("Backspace", "key")
  back.add_text(" joins it onto the one in front and it is back as it was.")

  // The figure of what to do. **The three frames go on one slide** (so no page break splits them).
  step_fig: = doc.add_block("slide")
  add_framed_child(step_fig, "screen-area",
    Rect::{ .x = 10.0, .y = 30.0, .w = 180.0, .h = 60.0 }).add_text("abc|de")
  add_framed_child(step_fig, "screen-area",
    Rect::{ .x = 230.0, .y = 30.0, .w = 180.0, .h = 60.0 }).add_text("Press Enter")
  add_framed_child(step_fig, "screen-area",
    Rect::{ .x = 450.0, .y = 20.0, .w = 180.0, .h = 40.0 }).add_text("abc")
  add_framed_child(step_fig, "screen-area",
    Rect::{ .x = 450.0, .y = 62.0, .w = 180.0, .h = 40.0 }).add_text("|de")
  add_framed_child(step_fig, "arrow", Rect::{ .x = 194.0, .y = 46.0, .w = 32.0, .h = 28.0 })
  add_framed_child(step_fig, "arrow", Rect::{ .x = 414.0, .y = 46.0, .w = 32.0, .h = 28.0 })
  add_framed_child(step_fig, "number-dot",
    Rect::{ .x = 10.0, .y = 100.0, .w = 24.0, .h = 24.0 }).add_text("1")
  add_framed_child(step_fig, "number-dot",
    Rect::{ .x = 230.0, .y = 100.0, .w = 24.0, .h = 24.0 }).add_text("2")
  add_framed_child(step_fig, "number-dot",
    Rect::{ .x = 450.0, .y = 108.0, .w = 24.0, .h = 24.0 }).add_text("3")

  doc.add_block("caption").add_text("Enter parts a paragraph in two (| is the cursor)")

  doc.add_block("warning")
    .add_text("Inside a table's cell Enter does not part it. What grows the cells is “Insert a \
      row” and “Insert a column”.")

  doc.add_block("section").add_text("Deleting")

  d: = doc.add_block("body")
  d.add_text("Backspace", "key")
  d
    .add_text(" deletes the one character in front, and at a paragraph's head joins it onto the \
      paragraph in front. ")
  d.add_text("Delete", "key")
  d
    .add_text(" deletes the one character after, and at a paragraph's end joins the next paragraph \
      on.")

  doc.add_block("section").add_text("Selecting")

  s: = doc.add_block("body")
  s.add_text("There are two ways to select.")
  doc.add_block("bullet").add_text("Drag. Hold it down and move.")
  doc.add_block("bullet").add_text("Hold Shift down and move an arrow key.")

  s2: = doc.add_block("body")
  s2.add_text("Type while something is selected and what is selected is ")
  s2.add_text("replaced", "strong")
  s2
    .add_text(" by what you typed. Select across paragraphs and delete, and the paragraphs crossed \
      join into one.")

  s3: = doc.add_block("body")
  s3.add_text("Ctrl+A", "key")
  s3.add_text(" selects everything. Copying is ")
  s3.add_text("Ctrl+C", "key")
  s3.add_text(", cutting is ")
  s3.add_text("Ctrl+X", "key")
  s3.add_text(", pasting is ")
  s3.add_text("Ctrl+V", "key")
  s3.add_text(". Text brought in from outside can be pasted too.")

  doc.add_block("section").add_text("Undoing, redoing, and doing a command again")

  u: = doc.add_block("body")
  u.add_text("Ctrl+Z", "key")
  u.add_text(" undoes one step. To redo it, ")
  u.add_text("Ctrl+Shift+Z", "key")
  u.add_text(" or ")
  u.add_text("Ctrl+Y", "key")
  u.add_text(".")

  a: = doc.add_block("body")
  a.add_text("F4", "key")
  a.add_text(" is another thing: it does the last command again, ")
  a.add_text("where the cursor is now")
  a.add_text(". Put a column in, move to another table and press ")
  a.add_text("F4", "key")
  a
    .add_text(", and a column goes into that one. Where nothing can be done again, the status bar \
      says which command it was holding.")

  doc.add_block("hint")
    .add_text("Doing a command again is not the same as a redo. A redo puts back a step you undid; \
      doing it again runs the command afresh, wherever you now stand.")

  doc.add_block("hint")
    .add_text("Text typed in one run is undone together in one step, not character by character.")

  doc.add_block("warning").add_text("On a Mac, Command will do in place of Ctrl.")

  doc.add_block("section").add_text("Finding and replacing")

  f: = doc.add_block("body")
  f.add_text("Ctrl+F", "key")
  f.add_text(" moves to the find field at the menu bar's right. Type and ")
  f.add_text("the count found comes out on the spot", "strong")
  f.add_text(".")

  doc.add_block("step")
    .add_text("Type the text to find. “3 found” and the like comes out to the right.")
  doc.add_block("step")
    .add_text("Enter moves to the next, Shift+Enter to the one before. Reach the end and it comes \
      back to the head.")
  doc.add_block("step")
    .add_text("Open “Replace”, type the text to replace with, and press “Replace” or \
      “Replace all”.")

  doc.add_block("hint").add_text("Replace all is undone in one step, not one place at a time.")

  doc.add_block("warning")
    .add_text("The count is “how many were found”. A cell holding a formula can be found but \
      not replaced, so the count replaced can be fewer than this. The “Replaced N places” that \
      comes out after the press is that count.")

  doc.add_block("warning")
    .add_text("Where they overlap is not counted. Find “aa” in “aaa” and it is one (the \
      replacing side goes on from the end of what it found too, so the count and the outcome \
      agree).")

priv fn add_styling(doc: Doc$@) //< the chapter on formatting text and paragraphs
  doc.add_block("chapter").add_text("The styles of text and paragraphs")

  p: = doc.add_block("body")
  p.add_text("What kspage's decorating lays on is ")
  p.add_text("a style's name", "strong")
  p.add_text(". Rather than giving a colour or a weight directly, you lay a name on.")

  doc.add_block("hint")
    .add_text("Lay a name on and changing that name's contents in one place afterwards changes \
      every place it was laid on.")

  doc.add_block("section").add_text("Laying bold and italic on at once")

  q: = doc.add_block("body")
  q.add_text("Bold is ")
  q.add_text("Ctrl+B", "key")
  q.add_text(", italic is ")
  q.add_text("Ctrl+I", "key")
  q.add_text(". These two go on by key alone.")

  q2: = doc.add_block("body")
  q2
    .add_text("From the menu's “Style” → “Font” you can choose the colour, the highlight, \
      ")
  q2.add_text("underline", "underline")
  q2.add_text(", ")
  q2.add_text("strikethrough", "strikethrough")
  q2
    .add_text(", bold and italic. Point at a row and the choice opens to the right, with a mark on \
      what is laid on.")

  doc.add_block("hint")
    .add_text("Every one of them carries an “Unset” row. Choose it and that one thing alone is \
      inherited from the parent's style. To take everything laid on off, it is “Character \
      style”'s “Unset”.")

  doc.add_block("warning")
    .add_text("A decoration that is a line does not change the measures. Laying it on does not move \
      where the lines break.")

  doc.add_block("section").add_text("Choosing a paragraph's style")

  b: = doc.add_block("body")
  b
    .add_text("The style of the paragraph the cursor is in is swapped under “Paragraph style” \
      in the menu's “Style”. In this manual that lists ")
  b.add_text("body", "key")
  b.add_text(" · ")
  b.add_text("bullet", "key")
  b.add_text(" · ")
  b.add_text("code", "key")
  b.add_text(" · ")
  b.add_text("warning", "key")
  b.add_text(" and the like.")

  doc.add_block("section").add_text("The styles in detail, and making one")

  e: = doc.add_block("body")
  e
    .add_text("Under “The styles in detail” in the menu's “Style” you can choose one name \
      and reach into its contents. What can be reached is this.")

  st: = doc.add_block("table")
  sh: = st.add_child("")
  sh.add_child("heading-cell").add_text("Set")
  sh.add_child("heading-cell").add_text("What it sets")
  s1: = st.add_child("")
  s1.add_child("cell").add_text("Font")
  s1.add_child("cell")
    .add_text("Font name, size, weight, italic, text colour, highlight colour, underline, \
      strikethrough")
  s2: = st.add_child("")
  s2.add_child("cell").add_text("Paragraph")
  s2.add_child("cell")
    .add_text("The space before and after, the indent, the inner space, the alignment, the leading, \
      whether it wraps")
  s3: = st.add_child("")
  s3.add_child("cell").add_text("Line and fill")
  s3.add_child("cell")
    .add_text("The line's thickness and colour, the fill, the shape (rounded, ellipse, triangle and \
      11 in all)")
  s4: = st.add_child("")
  s4.add_child("cell").add_text("Bullets and numbering")
  s4.add_child("cell").add_text("A mark, a number, a running number, a chapter number")
  s5: = st.add_child("")
  s5.add_child("cell").add_text("How a number is shown")
  s5.add_child("cell")
    .add_text("The digit grouping, the decimal places, per cent, the text put on before and after, \
      a date's shape")

  doc.add_block("warning")
    .add_text("The leading is counted in “lines”. 1 is one line, 1.5 is one and a half. A line \
      here is the line height the font decides, which is taller than the type's size (about 1.26 \
      times). It is counted the same way as Word's and Writer's “multiple”, and differs from \
      CSS's line-height.")
  s6: = st.add_child("")
  s6.add_child("cell").add_text("The arranging")
  s6.add_child("cell")
    .add_text("Flowed in, grid, absolute coordinates, the count of columns and the gap between them")
  s7: = st.add_child("")
  s7.add_child("cell").add_text("The way of gathering")
  s7.add_child("cell")
    .add_text("The table of contents, the footnote list, a bar chart, a line chart, a source window")
  s8: = st.add_child("")
  s8.add_child("cell").add_text("When the value")
  s8.add_child("cell")
    .add_text("Where a number is above / below / equal to some value, it switches to another style")

  doc.add_block("warning")
    .add_text("Set a fill and please set the text colour too. Text with no setting takes “the \
      screen's default colour”, so on a dark screen light text sits on a light fill and cannot be \
      read.")

  n: = doc.add_block("body")
  n.add_text("“Make” grows a new name. A name grown is listed under “Paragraph style” too.")

  doc.add_block("section").add_text("Applying a theme")

  th: = doc.add_block("body")
  th.add_text("The themes under “The whole document's theme” in the menu's “Style” swap ")
  th.add_text("the colours and the fonts alone", "strong")
  th.add_text(" as one set. Neither the spacing nor the sizes move.")

  doc.add_block("hint")
    .add_text("The colours of the bars and the shapes switch apart from a table's rules and a \
      heading's fill, because they are the colour of the contents themselves. Put the theme back to \
      “Standard” and the colours are as they were at inserting.")

priv fn add_headings(doc: Doc$@) //< the chapter on headings, the contents and a chapter number
  doc.add_block("chapter").add_text("Headings, the contents, and a chapter number")

  p: = doc.add_block("body")
  p
    .add_text("A heading is not “a large, heavy paragraph”. What makes it a heading is giving \
      the style ")
  p.add_text("a depth", "strong")
  p.add_text(".")

  doc.add_block("section").add_text("Giving it a depth")

  d: = doc.add_block("body")
  d
    .add_text("Open “The styles in detail” in the menu's “Style” and make the depth 1 for a \
      chapter, 2 for a section. In this manual ")
  d.add_text("chapter", "key")
  d.add_text(" is depth 1 and ")
  d.add_text("section", "key")
  d.add_text(" is depth 2.")

  doc.add_block("section").add_text("A chapter number is not written by hand")

  o: = doc.add_block("body")
  o.add_text("Set “Bullets and numbering” to “A chapter number” and the number is ")
  o.add_text("counted on every placing", "strong")
  o.add_text(". A heading of depth 3 comes out as “1.2.3”.")

  doc.add_block("warning")
    .add_text("The numbers do not go into the document. So adding one chapter needs no retyping of \
      the numbers behind it. This manual's chapter numbers are what was counted just now, too.")

  doc.add_block("section").add_text("Putting the contents in")

  t: = doc.add_block("body")
  t
    .add_text("They go in from “Insert the contents” in the menu's “Insert”. What is inside \
      does not go into the document; it is ")
  t.add_text("assembled from the headings on every placing", "strong")
  t.add_text(". Add a chapter and it grows by itself.")

  t2: = doc.add_block("body")
  t2
    .add_text("The drop is set by the indent of the contents' style. This manual's contents are at \
      the very top.")

  t3: = doc.add_block("body")
  t3.add_text("The contents carry the chapter numbers, and a press on a row ")
  t3.add_text("moves to that chapter", "strong")
  t3
    .add_text(" (where it moved to comes out at the window's top). Point at it and the arrow \
      changes. The same headings are listed in the navigation on the right, and a press there moves \
      too.")

  t4: = doc.add_block("body")
  t4.add_text("At the very top of the navigation on the right is ")
  t4.add_text("contents", "key")
  t4.add_text(". It is the way back from a chapter to the contents. After moving, the ribbon's ")
  t4.add_text("← Back", "key")
  t4.add_text(" returns you where you were, and ")
  t4.add_text("→ Forward", "key")
  t4.add_text(" goes on to before you went back.")

  doc.add_block("warning")
    .add_text("“Undo” takes a rewriting back; “Back” returns you to where you were looking. \
      They are separate tools.")

  doc.add_block("hint")
    .add_text("What the contents pick up is a style carrying a depth, and nothing else. They do not \
      remember by name, so change a style's name and the contents follow along.")

priv fn add_lists(doc: Doc$@) //< the chapter on bullet lists and numbers
  doc.add_block("chapter").add_text("Bullet lists and numbers")

  p: = doc.add_block("body")
  p.add_text("To make a bullet list, open ")
  p.add_text("Style", "key")
  p.add_text(" → ")
  p.add_text("Paragraph style", "key")
  p.add_text(" and choose a style that carries a mark (in this manual ")
  p.add_text("bullet", "key")
  p.add_text(" and ")
  p.add_text("step", "key")
  p.add_text(").")

  doc.add_block("warning")
    .add_text("The mark itself is not typed. The mark is carried by the style, so lay the style on \
      and it comes out; change to a style with no mark and it goes.")

  doc.add_block("body")
    .add_text("There are four kinds of mark under “Bullets and numbering”. Every one is carried \
      by the style, and none goes into the document.")

  t: = doc.add_block("table")
  h: = t.add_child("")
  h.add_child("heading-cell").add_text("The mark")
  h.add_child("heading-cell").add_text("What comes out")
  h.add_child("heading-cell").add_text("How it counts")
  r1: = t.add_child("")
  r1.add_child("cell").add_text("A mark")
  r1.add_child("cell").add_text("The mark set (“• ” and the like)")
  r1.add_child("cell").add_text("It does not count")
  r2: = t.add_child("")
  r2.add_child("cell").add_text("A number")
  r2.add_child("cell").add_text("1. 2. 3.")
  r2.add_child("cell").add_text("It counts among the siblings that carry on")
  r3: = t.add_child("")
  r3.add_child("cell").add_text("A running number")
  r3.add_child("cell").add_text("Figure 1. Figure 2.")
  r3.add_child("cell").add_text("It counts on through the whole document")
  r4: = t.add_child("")
  r4.add_child("cell").add_text("A chapter number")
  r4.add_child("cell").add_text("1.2.3")
  r4.add_child("cell").add_text("It is decided by the heading's depth")

  doc.add_block("section").add_text("The numbers start the count at 1 again")

  n: = doc.add_block("body")
  n
    .add_text("A number's mark counts “while the siblings that hand a number out carry on”. Let \
      a paragraph that hands out no number in between and the next starts from 1 again.")

  doc.add_block("step").add_text("This comes out as number 1.")
  doc.add_block("step").add_text("This comes out as number 2.")
  doc.add_block("body").add_text("Here an ordinary paragraph comes in between.")
  doc.add_block("step").add_text("So this starts from number 1 again.")

  doc.add_block("section").add_text("A running number counts through the whole document")

  s: = doc.add_block("body")
  s
    .add_text("A figure's or a table's caption is this. However much comes in between it counts \
      straight on, so it runs on across the chapters as “Figure 1”, “Figure 2”. This \
      manual's figure captions are those.")

  doc.add_block("warning")
    .add_text("Taking a mark off is changing that paragraph's style to one with no mark. The mark \
      cannot be taken off from the typing.")

fn add_chapters(doc: Doc$@) //< the first half's chapters
  //<
  //< **The list decides the chapter numbers.**
  add_intro(doc)
  add_typing(doc)
  add_styling(doc)
  add_headings(doc)
  add_lists(doc)

//< The chapter on saving, exporting and importing
//<
//< **One chapter in a file of its own** (to keep each file under the line cap); its position in
//< the list is `add_chapters` in `manual_share.kspls`.
import "kspage/model/doc" { Doc }

fn add_chapter(doc: Doc$@) //< the chapter on saving and exporting
  doc.add_block("chapter").add_text("Saving, writing out, and taking in")

  p: = doc.add_block("body")
  p.add_text("There is one shape that can be read back, and several to write out. ")
  p.add_text("What can be read back is “Save” alone.", "strong")

  doc.add_block("section").add_text("Dropping it onto the screen to open it")
  d: = doc.add_block("body")
  d.add_text("Drop a file onto the screen and it opens. ")
  d.add_text("Drop an image and it is inserted at that place", "strong")
  d
    .add_text(". What opens as a document is a file that is not an image. In Chrome and Edge, \
      Ctrl+S writes straight back to the file dropped (Firefox and Safari open it, but saving drops \
      a copy).")

  doc.add_block("section").add_text("Beginning from a blank")
  doc.add_block("body")
    .add_text("“New” in the menu's “File” opens one blank document. No screen for choosing \
      a template comes out. The document you have is not shut, so it stays listed under “Files” \
      in the navigation on the right.")
  doc.add_block("body")
    .add_text("Neither the place to save nor the document's name is carried over, so that a blank \
      is not written back to the file you had open.")

  doc.add_block("section").add_text("The draft of what you were writing")
  k: = doc.add_block("body")
  k.add_text("Shut it without pressing save and what you typed is still there", "strong")
  k
    .add_text(". Where your hand stops typing, the text as it then stands is held back inside the \
      browser. If a draft is there the next time you open it, the status bar tells you “There are \
      N unsaved drafts”. It opens from “Bring the draft back” under “Draft kept” in the \
      menu's “File”.")

  doc.add_block("warning")
    .add_text("A draft is not a save. Holding one back changes the file by not one byte. So it does \
      not say “Saved” but only “Held back”. To leave it in the file, please press save as \
      you always would.")

  doc.add_block("hint")
    .add_text("A document brought back is tied to no file. A draft can be older than the file, so \
      this is to keep one press from putting the file back to older content. Where it came from, \
      the status bar tells you. The place to save is asked at the first save.")

  doc.add_block("hint")
    .add_text("Once it saves to that file, the draft goes. The file carries it, so there is no need \
      to hold it back any longer. Drafts you do not want can be thrown away together with “Throw \
      the drafts away”.")

  doc.add_block("warning")
    .add_text("A draft is inside this browser and nowhere else. It cannot be seen from another \
      machine or another browser. Delete the browser's browsing data and the drafts go with it. A \
      draft past 30 days, and the older ones beyond 32, are thrown away by themselves.")

  t: = doc.add_block("table")
  h: = t.add_child("")
  h.add_child("heading-cell").add_text("The command")
  h.add_child("heading-cell").add_text("What comes out")
  h.add_child("heading-cell").add_text("Can it be read back")
  r1: = t.add_child("")
  r1.add_child("cell").add_text("Save (Ctrl+S)")
  r1.add_child("cell").add_text("The document and every style")
  r1.add_child("cell").add_text("It can be read back")
  r2: = t.add_child("")
  r2.add_child("cell").add_text("Write out as HTML")
  r2.add_child("cell").add_text("A block becomes an element, a style's name a class")
  r2.add_child("cell").add_text("It cannot be read back")
  r3: = t.add_child("")
  r3.add_child("cell").add_text("Write out as Markdown")
  r3.add_child("cell")
    .add_text("The contents that hold text. Those that hold none become a comment")
  r3.add_child("cell").add_text("It cannot be read back")
  r4: = t.add_child("")
  r4.add_child("cell").add_text("Open a Markdown")
  r4.add_child("cell").add_text("It makes a document from text")
  r4.add_child("cell").add_text("It can be edited as it stands")
  r4b: = t.add_child("")
  r4b.add_child("cell").add_text("Open a text")
  r4b.add_child("cell").add_text(".txt and a program's source")
  r4b.add_child("cell").add_text("Not one byte changes")
  r5: = t.add_child("")
  r5.add_child("cell").add_text("Write the table out as CSV")
  r5.add_child("cell").add_text("The table you are in alone")
  r5.add_child("cell").add_text("It cannot be read back")
  r6: = t.add_child("")
  r6.add_child("cell").add_text("Write the table out as constant source")
  r6.add_child("cell").add_text("KSPL constants from a table")
  r6.add_child("cell").add_text("It cannot be read back")

  doc.add_block("hint")
    .add_text("Taking Markdown in has no “way of writing it cannot read”. A line it does not \
      know goes in as a paragraph.")

  doc.add_block("hint")
    .add_text("Open a .md file and saving writes back to that .md. It does not become JSON, so a \
      document laid beside the code can be edited as it stands. Its diffs and its searches are the \
      repository's own tools, unchanged.")

  doc.add_block("warning")
    .add_text("What Markdown cannot carry (a page break, the columns, a comment, an attached note, \
      a merged cell) is lost from the file written out. Where something is dropped, saving tells \
      you how many.")

  doc.add_block("warning")
    .add_text("It writes no change-history file (.ksdb) for a .md document, so as not to grow a \
      file the repository's ways do not know in a folder laid beside the code. For the history, \
      please use what that repository carries.")

  doc.add_block("hint")
    .add_text("A table's column alignment goes there and back. Left alignment written out plainly \
      (:--) becomes the default (---), though; both look the same, so nothing has fallen away.")

  doc.add_block("hint")
    .add_text("Open a file whose name is neither .kspage nor .md and it opens as a text (a .json \
      saved earlier opens as a kspage document too). A .txt and a program's source are the same. \
      Saving writes back to that file without changing one byte, so a compiler's or a tool's input \
      can be edited as it stands.")

  doc.add_block("hint")
    .add_text("A text stays as it was typed. The space at a line's end, the tab characters and a \
      run of empty lines all stay, and a file that does not end in a newline comes back not ending \
      in one. It neither adds nor evens up a newline at a line's end of its own accord.")

  doc.add_block("warning")
    .add_text("Contents that are not text (an image, a program that runs) do not open. Opened, the \
      screen would show garbled characters and the original file would break the moment it was \
      saved. Where it refuses, it tells you in words apart from “too large”.")

  doc.add_block("hint")
    .add_text("A text carries line numbers. The number is the style's mark under “Bullets and \
      numbering”, so take it off if you do not want it. The numbers are not written into the \
      file.")

  doc.add_block("hint")
    .add_text("A KSPL source (.kspls) carries colours. So does a ```kspls fence inside Markdown. \
      What carries a colour is the language's words, the strings, the numbers and the comments — \
      four things; it tells nothing apart such as a type from a function.")

  doc.add_block("hint")
    .add_text("What carries colours is KSPL, C and JavaScript (.c .h .js, and the language a \
      Markdown fence named). A comment that crosses lines, such as /* */, carries on as a comment \
      until it closes.")

  doc.add_block("warning")
    .add_text("It puts no colour on any other language. Parted by guesswork, part of a source alone \
      comes out in another colour.")

  doc.add_block("hint")
    .add_text("A source's colours change with the background's colour. Choose the dark look (Ink) \
      under “The look” in the settings and the words, the strings and the numbers all take the \
      colours that read on a dark background.")

  doc.add_block("hint")
    .add_text("“Back” in the ribbon's “Move” group brings you back from where you moved to \
      (a heading in the navigation, a row of the table of contents, a row of the differences). Even \
      having gone to another file, it opens that file afresh and returns to the line you were on \
      before.")

  doc.add_block("hint")
    .add_text("The documents you have open are listed under “Files” in the navigation on the \
      right. The ● before a name is the mark of changes not saved, and ✕ shuts it. It does not \
      shut while a draft stands, so please save first.")

  doc.add_block("warning")
    .add_text("The colours do not go into the document. They come out in neither the file saved, \
      the paper, nor the HTML written out, so they go once it is changed.")

  doc.add_block("warning")
    .add_text("A text makes one paragraph of one line. It uses about 3 to 20 times the file in \
      memory, so a very large file is refused before opening. Refused, the document you have is \
      unhurt.")

  doc.add_block("hint")
    .add_text("A document opened from a .md carries a way of showing from the start. A heading \
      changes size by its step, a fence is fixed-width with a fill and a frame, a table is ruled, \
      and a link carries a colour and an underline. The table of styles is the same as any \
      document's, so change it after opening, or apply a theme, as you please.")

  doc.add_block("warning")
    .add_text("The way of showing is not written into the .md. Change a style and the file's \
      contents do not change, so save it and open it afresh and it comes out with the default way \
      of showing again. To keep the look as well, please save as JSON.")

  doc.add_block("warning")
    .add_text("“Write the table out as constant source” is the bearing where the table is the \
      source and the code is what is made. A row that cannot be a name is not taken in, and it \
      tells you how many.")
  add_files(doc)

priv fn add_files(doc: Doc$@) //<
  //< The part of that chapter on the file a document is saved back to
  //<
  //< **It is one chapter, written as two functions** (for the function-length guideline [H0803]);
  //< a heading of its own would tell the reader about a division that is not there.
  doc.add_block("section").add_text("Writing back to the same file")

  w: = doc.add_block("body")
  w
    .add_text("It is “Save (Ctrl+S)” in the menu's “File”. To a file opened once by \
      “Open”, or chosen at the first save, from then on it ")
  w.add_text("writes straight back", "strong")
  w.add_text(". A press never grows a copy.")

  doc.add_block("bullet")
    .add_text("It confirms the place to save only while it carries no file yet. From then on it \
      does not ask.")
  doc.add_block("bullet")
    .add_text("The change history is a file apart, so on a document that carries a history it \
      confirms two places to save.")
  doc.add_block("bullet")
    .add_text("Read the page afresh and the document you had open comes back, read again from its \
      file, and it still writes back there. A tab opened anew starts from the sample, carrying no \
      file.")
  doc.add_block("bullet")
    .add_text("At the first save after reading afresh you may be asked to allow the writing. It is \
      the browser itself that asks, so it cannot be avoided. Once the browser itself has been shut, \
      even the reading wants the file chosen again with “Open”.")
  doc.add_block("bullet")
    .add_text("Where the file it had open has gone, it says so and starts from the sample, carrying \
      no file yet, so the next save confirms the place to save.")

  doc.add_block("warning")
    .add_text("Only a browser that carries this can write back to a file. In one that does not, a \
      copy is downloaded, and then it tells you so. It does not switch in silence.")

  doc.add_block("section")
    .add_text("Opening by a place in a local folder, and saving to that place")

  lp: = doc.add_block("body")
  lp.add_text("On a page opened from a server (kssrv) running locally, the field ")
  lp.add_text("“Path for saving and opening”", "strong")
  lp
    .add_text(" comes out on the second tier of the menu's “File”. Put the place as seen from \
      the folder the server is serving in (a path such as docs/notes.kspage), press Enter, and it \
      opens from there; “Save (Ctrl+S)” writes back there.")

  doc.add_block("bullet")
    .add_text("Read the page afresh and the document at that place opens again, so it does not \
      confirm the place to save again.")
  doc.add_block("bullet")
    .add_text("Save with the field empty and it writes directly under the folder by the name on the \
      menu bar, and puts that place into the field. The place to save is the folder chosen at \
      start-up, so it does not ask.")
  doc.add_block("bullet")
    .add_text("Where the same name is there already, it tells you rather than overwriting in \
      silence. To overwrite, put it into this field.")
  doc.add_block("bullet")
    .add_text("“Open” in the menu is the browser's own file window, with the server there or \
      not. A document opened that way writes back to that file when you save, and this field \
      clears, so what is shown is the one place it goes. A file chosen in the window may lie \
      outside the folder being served, so it is reopened the way it was opened — by the window, \
      or by a double-click.")

  doc.add_block("warning")
    .add_text("Where that file has changed outside after it was opened, saving refuses. Open the \
      same file in two windows and save from both and one side's writing would go, so it does not \
      overwrite in silence. Refused, please set them against each other with “Compare with an \
      earlier version” in “Review”, or save under another name.")
  doc.add_block("bullet")
    .add_text("The change history is written to the name with the place's extension swapped for \
      .ksdb. It never confirms two places to save.")
  doc.add_block("bullet")
    .add_text("It cannot point outside the folder being served. Enter one and it tells you there \
      and then.")

  doc.add_block("warning")
    .add_text("The field does not come out on a page with no server standing. It puts out nothing \
      that can be pressed and has no effect.")

  doc.add_block("hint")
    .add_text("kssrv puts one line out with the URL to open when it starts up. Please open it by \
      that URL. The token is inside it, so type the address alone and the field does not come out.")

  doc.add_block("section").add_text("Pointing at a document by URL, and opening it read-only")

  u: = doc.add_block("body")
  u.add_text("Add ")
  u.add_text("?doc=docs/design.kspage", "code")
  u
    .add_text(" behind the page's URL and it starts up with that document open. This is the shape \
      that lets a README or a task sheet carry a link to a document.")

  u2: = doc.add_block("body")
  u2.add_text("Add ")
  u2.add_text("&read=1", "code")
  u2.add_text(" as well and it opens ")
  u2.add_text("read-only", "strong")
  u2
    .add_text(". The tools that rewrite do not come out, and typing or deleting changes the \
      document not at all. A link only meant to be read takes this shape.")

  doc.add_block("bullet")
    .add_text("What can be pointed at is a relative path as seen from the same place as this page, \
      and nothing else. Another server's address (one opening with https://) and a path that climbs \
      to a folder above are both refused.")
  doc.add_block("bullet")
    .add_text("The reading is an ordinary read, so it opens even from a server that only serves \
      files. It need not be the local server (kssrv).")
  doc.add_block("bullet")
    .add_text("Read-only is not the document's property but a setting that depends on how it was \
      opened. It comes out neither in the file saved nor in the HTML written out, so a document \
      copied can be edited as usual.")
  doc.add_block("bullet")
    .add_text("Read-only can still find, move to a chapter from the contents, print and write out.")

  doc.add_block("warning")
    .add_text("On a page opened as a file (one opening with file://), ?doc= has no effect, because \
      what it reads is not in the same place as that page.")

  m1: = doc.add_block("body")
  m1
    .add_text("Reading alone and editing can be crossed between at any time. Press the mode at the \
      status bar's left edge and a choice opens with a mark on whichever it now is: ")
  m1.add_text("Edit", "key")
  m1
    .add_text(" or “Read only”. A document opened with read=1 can be brought back to editing \
      from there.")

  doc.add_block("warning")
    .add_text("This is a screen against rewriting it by a mistaken press, and not a key. Please \
      simply not hand over a document you do not want read.")

  doc.add_block("hint")
    .add_text("Which it now is always reads at the status bar's left edge. Why a press has no \
      effect is told there.")

  doc.add_block("section").add_text("Naming the document")

  n: = doc.add_block("body")
  n
    .add_text("Press the name on the menu bar and it can be rewritten. It becomes the name of the \
      file saved.")

  doc.add_block("hint")
    .add_text("Rewrite the name and it forgets where to write back. The next save confirms the \
      place to save, and this is what “Save as” is.")

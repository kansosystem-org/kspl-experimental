//< The manual's second half (notes, pages, links, comparing, keys, the limits)
//<
//< **Importing and exporting is one chapter of it, in `manual_inout.kspls`**; the list that
//< decides the chapter numbers is `add_chapters` here.
//<
//< **Put the chapter on what it cannot do last.** A manual listing only what it can do leaves the
//< reader mistaking a missing feature for their own mistake.
import "kspage/content/manual_inout"
import "kspage/model/doc" { Block, Doc }

priv fn add_notes(doc: Doc$@) //< the chapter on notes, comments, links and attached notes
  doc.add_block("chapter").add_text("Notes, comments, links and attached notes")

  p: = doc.add_block("body")
  p.add_text("There are four things that can be attached to the text you select. ")
  p.add_text("None of them differs in how it looks; they differ in where they come out.", "strong")

  t: = doc.add_block("table")
  h: = t.add_child("")
  h.add_child("heading-cell").add_text("What is attached")
  h.add_child("heading-cell").add_text("Does it come out in the body")
  h.add_child("heading-cell").add_text("Does it come out on paper and in the HTML")
  r1: = t.add_child("")
  r1.add_child("cell").add_text("A footnote")
  r1.add_child("cell").add_text("A mark comes out, and it appears in the list too")
  r1.add_child("cell").add_text("It comes out")
  r2: = t.add_child("")
  r2.add_child("cell").add_text("A comment")
  r2.add_child("cell").add_text("It does not (it is remembered along with whose words they are)")
  r2.add_child("cell").add_text("It does not")
  r3: = t.add_child("")
  r3.add_child("cell").add_text("A link")
  r3.add_child("cell").add_text("The text itself carries where it goes")
  r3.add_child("cell").add_text("It comes out")
  r4: = t.add_child("")
  r4.add_child("cell").add_text("An attached note")
  r4.add_child("cell").add_text("A short note attached to a table, a slide or an image")
  r4.add_child("cell").add_text("It does not")

  doc.add_block("section").add_text("Attaching a footnote")

  n: = doc.add_block("body")
  n
    .add_text("Lay the cursor, put the text in under “Footnote” in the menu's “Insert” and \
      press “Attach”. The number does not go into the document; it is ")
  fn_run: = n.add_text("counted on every placing")
  fn_run.note =
    "So adding one footnote needs no retyping of the numbers behind it. This footnote is what was \
      counted just now, too."
  n.add_text(". The list goes in from “Insert the footnote list” in “Insert”.")

  doc.add_block("subheading").add_text("Footnotes")
  doc.add_block("footnotes")

  doc.add_block("hint")
    .add_text("Press a row of the list and it returns to where that footnote was attached. Point at \
      it and the arrow changes. It is the same way as the contents.")

  doc.add_block("section").add_text("Attaching a comment")

  r: = doc.add_block("body")
  r
    .add_text("Select, then type it under “Comment” in the menu's “Review” and press \
      “Attach”. It is remembered along with who wrote it. ")
  r.add_text("It does not come out in the flow", "strong")
  r
    .add_text(" — it comes out neither in printing nor in the HTML written out. They are words \
      somebody said about this text, and not the document's contents.")

  doc.add_block("section").add_text("Attaching a link")

  l: = doc.add_block("body")
  l
    .add_text("Select, then type where it goes under “Link” in the menu's “Insert” and \
      press “Attach”. The blue and the underline are ")
  l.add_text("carried by the style", "strong")
  l.add_text(", and where it goes is carried by the text. ")
  link: = l.add_text("Kanso's home page", "link")
  link.href = "https://kansosystem.org/"
  l.add_text(" is one.")

  doc.add_block("hint")
    .add_text("A link is not lost when its text is typed on. Unlike a formula, change the text and \
      it still points at the same place.")

  doc.add_block("section").add_text("Attaching a note to a table, a slide or an image")

  m: = doc.add_block("body")
  m.add_text("Press inside a table, a slide or an image, then type into the ")
  m.add_text("Share", "key")
  m.add_text(" menu's ")
  m.add_text("Attach a note", "key")
  m.add_text(" and press “Attach”.")

  doc.add_block("warning")
    .add_text("Each of them takes one note. It cannot be attached to a paragraph. It comes out \
      neither in the flow, nor in printing, nor in the HTML written out.")

  doc.add_block("hint")
    .add_text("A note attached to a slide is the presenter's note. Press N while it is being shown \
      full screen and it comes out at the screen's foot.")

priv fn add_paper(doc: Doc$@) //< the chapter on pages and printing
  doc.add_block("chapter").add_text("Paper and printing")

  p: = doc.add_block("body")
  p
    .add_text("It is set under “Paper and margins, the body's width, the header and footer” in \
      the menu's “File”.")

  t: = doc.add_block("table")
  h: = t.add_child("")
  h.add_child("heading-cell").add_text("The setting")
  h.add_child("heading-cell").add_text("What it does")
  r1: = t.add_child("")
  r1.add_child("cell").add_text("The paper's size")
  r1.add_child("cell")
    .add_text("A3, A4, A5, B5, Letter, Legal. Not splitting into pages can be chosen too")
  r0: = t.add_child("")
  r0.add_child("cell").add_text("The printing's bearing")
  r0.add_child("cell").add_text("Upright or across. Chosen apart from the size")
  r2: = t.add_child("")
  r2.add_child("cell").add_text("The margins")
  r2.add_child("cell").add_text("The room above, below, left and right")
  r3: = t.add_child("")
  r3.add_child("cell").add_text("The body's width")
  r3.add_child("cell").add_text("It widens no further than this. At 0 nothing stops it")
  r4: = t.add_child("")
  r4.add_child("cell").add_text("The column's width and its left edge")
  r4.add_child("cell").add_text("The width and place of the region the body is laid in")
  r5: = t.add_child("")
  r5.add_child("cell").add_text("The header and the footer")
  r5.add_child("cell")
    .add_text("The paper's header and footer. {page} becomes the page's number and {pages} the \
      count of all the sheets")

  doc.add_block("warning")
    .add_text("Where the paper's width is set, “the body's width” has no effect. The paper \
      decides the width to print, so if both had an effect, two settings would decide a line's \
      length.")

  doc.add_block("hint")
    .add_text("This manual begins as A4 upright with 15mm margins, and carries “{page} / \
      {pages}” in the paper's footer. Set the page up front and the page breaks you see on the \
      screen are the breaks that print.")

  doc.add_block("warning")
    .add_text("It prints even left at “Do not split into pages”. Then it borrows A4 upright and \
      splits it — unsplit, it becomes one long picture and the browser decides the page's breaks \
      itself, partway down a line.")

  doc.add_block("section").add_text("Making the body's width readable")

  e: = doc.add_block("body")
  e
    .add_text("“Make it a readable width” in the menu's “File” sets the width alone in one \
      press.")

  doc.add_block("section").add_text("Making it readable on your own screen only")

  o: = doc.add_block("body")
  o
    .add_text("“The body's width (this screen only)” and “The body's type size (this screen \
      only)” under “The look” in the settings (⚙ at the menu bar's right) go onto ")
  o.add_text("your own screen", "strong")
  o
    .add_text(" rather than onto the document you have open. They do not go into the document, so \
      how it looks to whoever you handed it to does not change. This screen remembers them, so they \
      go in once and apply to every document you open thereafter.")

  o2: = doc.add_block("body")
  o2
    .add_text("The type's size is in pixels, not a multiple. A style with a size set on it, such as \
      a heading, stretches by the same ratio, so the relation of large to small does not break. \
      What differs from the browser's zoom (Ctrl and +) is that ")
  o2.add_text("the ribbon and the menus do not grow", "strong")
  o2
    .add_text(", and that the images, the frames and the table's grid all stay at the size they \
      were.")

  o3: = doc.add_block("body")
  o3
    .add_text("It has no effect on printing or on the paper's look. A page is what comes out by the \
      document's settings, so a different page per reader would leave what was printed out of step.")

  doc.add_block("section").add_text("Putting a header and a footer in")

  hf: = doc.add_block("body")
  hf
    .add_text("Under “Paper and margins, the body's width, the header and footer” in the menu's \
      “File”, text can go in that comes out at the paper's top and foot on every page.")
  hf.add_text("{page}", "key")
  hf.add_text(" becomes the page's number and ")
  hf.add_text("{pages}", "key")
  hf.add_text(" the count of all the sheets.")

  doc.add_block("hint")
    .add_text("The alignment is set by the style. The names are “header” and “footer”, and \
      the core sets those two, so another name affects neither. This manual aligns them both to the \
      centre.")

  doc.add_block("warning")
    .add_text("With no room above and below there is nowhere to lay them, so the header and the \
      footer do not come out on the paper.")

  doc.add_block("section").add_text("Breaking the page")

  bp: = doc.add_block("body")
  bp.add_text("Open “The styles in detail” in the menu's “Style” and stand ")
  bp.add_text("Break the page before this paragraph", "strong")
  bp.add_text(" up, and the page breaks before a paragraph of that style.")

  doc.add_block("hint")
    .add_text("Turn it on in the chapter's style, and there is one place to change however many \
      chapters there are. Turn it on in this manual's `chapter`, and every chapter starts on a new \
      page.")

  bp2: = doc.add_block("body")
  bp2.add_text("To break the page once only, ")
  bp2.add_text("make a style named “page-break”", "strong")
  bp2
    .add_text(" and lay it on that paragraph. It carries no separate machinery for breaking a page.")

  doc.add_block("warning")
    .add_text("It has no effect in a document that is not split into pages, because there is no \
      page to send it on to.")

  doc.add_block("section").add_text("Printing")

  i: = doc.add_block("body")
  i
    .add_text("It is “Print” in the menu's “File”. The grey dotted lines you see while \
      editing, and the comments and the attached notes, do not come out.")

  doc.add_block("hint")
    .add_text("The paper's size and bearing you chose come out in the printing as they are. Only \
      the document's settings apply to the margins too (it does not lay the browser's margins over \
      them).")

priv fn add_together(doc: Doc$@) //< the chapter on viewing two places of one document at once
  doc.add_block("chapter").add_text("Seeing two places of the same document at once")

  pk: = doc.add_block("body")
  pk.add_text("Press ")
  pk.add_text("“Pin it below”", "key")
  pk
    .add_text(" in the set that opens on pointing at “Split view” in the menu's “Share” and \
      the place you now see stays at the screen's foot. Send the body on and the place pinned does \
      not move. Use it to write further down while looking at a table further up.")

  doc.add_block("step")
    .add_text("To mirror another place, send it as far as there and press “Re-pin”. Turning the \
      mouse over the split view moves it up and down too (the body's side does not move).")
  doc.add_block("step")
    .add_text("While it is pinned, the same place reads “Close”. A press makes the split view \
      go.")

  doc.add_block("warning")
    .add_text("The split view is for reading alone. There is one place to type, so pressing inside \
      the split view writes nothing. What you type into the body comes out in the split view at \
      once.")

  doc.add_block("warning")
    .add_text("Two people cannot write into one document at once. Open the same file in two windows \
      and both may type, but whichever saves second is told the file changed underneath and refused \
      — please bring the two together with “Compare with an earlier version” in “Review”.")

priv fn add_plugins(doc: Doc$@) //< the chapter on the programs that work on the selected text
  doc.add_block("chapter").add_text("Working on the selected text with a program of your own")

  doc.add_block("body")
    .add_text("A plugin is a program on your machine. Select some text, press its name under \
      “Plugins”, and what the program returns takes the selected text's place. The one that \
      comes with kspage puts the selected lines in order.")

  doc.add_block("warning")
    .add_text("“Plugins” comes out only where kspage was opened through the local server. A \
      page opened by double-clicking the built file alone cannot start a program, so the menu is \
      not there.")

  doc.add_block("hint")
    .add_text("Nothing is replaced unless the program finished cleanly. Where it could not do its \
      work, the text you selected stays exactly as it was and the reason it gave comes out on the \
      status bar, with the plugin's name in front of it.")
  doc.add_block("hint")
    .add_text("One undo puts it back. What the program gave takes the selected text's place in a \
      single step.")
  doc.add_block("hint")
    .add_text("A program that does not finish is given up on and named, so a press never leaves you \
      waiting with nothing said.")

  doc.add_block("section").add_text("Writing one")

  doc.add_block("step")
    .add_text("Write a program that reads what comes in and writes what should replace it. It is \
      handed nothing else — not the document, not where the cursor is — so you can try it from \
      a terminal with a pipe.")
  doc.add_block("step")
    .add_text("Where it cannot do its work, say why on the error side and finish with a number that \
      is not 0. kspage then replaces nothing and shows what you said.")
  doc.add_block("step")
    .add_text("Build it into the plugins folder beside the server. It is read once when the server \
      starts, so start the server again to see a new one.")

  doc.add_block("warning")
    .add_text("A document can never name a plugin, and nothing runs when a document is opened. Only \
      your own press starts one.")

  doc.add_block("warning")
    .add_text("A plugin is handed the selected text alone. It cannot read the rest of the document, \
      lay a style on, or add a button of its own.")

priv fn add_review(doc: Doc$@) //<
  //< The chapter on comparing with an earlier version, and the change history
  doc.add_block("chapter").add_text("Comparing with an earlier version, and the change history")

  doc.add_block("section").add_text("Comparing with an earlier version")

  p: = doc.add_block("body")
  p
    .add_text("Save the version you have with “Save the current version” in the menu's \
      “Review”, rewrite it, then press “Compare with an earlier version”. What changed \
      comes out ")
  p.add_text("in one row", "strong")
  p.add_text(". It can be narrowed by three things: the prose, the shapes and the look.")

  doc.add_block("bullet").add_text("Press a row of the list and it moves to that place.")
  doc.add_block("bullet")
    .add_text("For the look, both are drawn by the same drawer and the pixels set against each \
      other.")
  doc.add_block("bullet")
    .add_text("“Delete a saved version” lists the versions saved, and the one you press is \
      deleted.")

  doc.add_block("hint")
    .add_text("It saves only when you press, and when you save. It does not save on every \
      keystroke.")

  doc.add_block("section").add_text("Seeing the change history")

  h: = doc.add_block("body")
  h
    .add_text("Open “The change history” in the menu's “Review” and press “See the \
      history”, and the record of when, who and what changed comes out. It is a record only added \
      to, so it is never rewritten.")

  doc.add_block("bullet")
    .add_text("What goes into the record is when, who and what was done, and nothing else. The text \
      typed does not go in. The name that goes in is the one in the “your name” field inside \
      the same “The change history”.")

  doc.add_block("warning")
    .add_text("The history does not go into the document. Carrying it out and reading it back are \
      separate commands.")

priv fn add_source(doc: Doc$@) //< the chapter on pointing at a source from a design document
  doc.add_block("chapter").add_text("Tying a design document to a source")

  p: = doc.add_block("body")
  p
    .add_text("Writing a design document, you come to want to show part of a source as it stands. \
      kspage ")
  p.add_text("does not point by a line's number", "strong")
  p
    .add_text(" — because one line added shifts it. What it points by is the file's and the \
      symbol's names.")

  doc.add_block("step")
    .add_text("Hand the code over under “Tie to the source” in the menu's “Insert”.")
  doc.add_block("step").add_text("“Tie to the source” chooses which symbol in which file.")
  doc.add_block("step")
    .add_text("“Insert a source window” puts in a source window with only the place that symbol \
      is in cut out.")
  doc.add_block("step").add_text("“The draw diagram” puts in the diagram of what it imports.")
  doc.add_block("step")
    .add_text("“Inspect the targets” makes sure the places pointed at are still there.")
  doc.add_block("step")
    .add_text("While a source is being edited, Ctrl+Space puts the rest of a half-typed name out as \
      candidates. ↑↓ chooses, and Tab lands one. Enter does not land it (because at a line's \
      end, meaning a newline, it would land one instead).")

  doc.add_block("body")
    .add_text("What comes out in a source window is the place the symbol referred to is in, and \
      nothing else.")
  doc.add_block("code").add_text("fn main() {")
  doc.add_block("code").add_text("    io.out().s(\"Hello, Kanso!\\n\");")
  doc.add_block("code").add_text("}")

  doc.add_block("warning")
    .add_text("kspage itself opens no file. The code is what it was handed. That is why it runs in \
      a browser alone.")

priv fn add_keys(doc: Doc$@) //< the chapter on the keyboard shortcuts
  doc.add_block("chapter").add_text("Keyboard shortcuts")

  doc.add_block("body").add_text("On a Mac, Command will do in place of Ctrl.")

  t: = doc.add_block("table")
  h: = t.add_child("")
  h.add_child("heading-cell").add_text("key")
  h.add_child("heading-cell").add_text("What it does")
  add_key(t, "Enter", "Parts a paragraph in two")
  add_key(t, "Backspace",
    "Deletes the one character in front. At a paragraph's head, joins it onto the paragraph in \
      front")
  add_key(t, "Delete",
    "Deletes the one character after. At a paragraph's end, joins the next paragraph on")
  add_key(t, "The arrow keys", "Move the cursor")
  add_key(t, "Shift+an arrow", "Select")
  add_key(t, "Alt+an arrow", "Move the selected frame or shape")
  add_key(t, "Home / End", "Move to a line's head or end")
  add_key(t, "Tab / Shift+Tab", "Move to the next cell or the one before")
  add_key(t, "Ctrl+A", "Select everything")
  add_key(t, "Ctrl+C / X / V", "Copy, cut, paste")
  add_key(t, "Ctrl+Z", "Undo")
  add_key(t, "Ctrl+Shift+Z / Ctrl+Y", "Redo")
  add_key(t, "F4", "Do the last command again, where the cursor is")
  add_key(t, "Ctrl+B / Ctrl+I", "Bold, italic")
  add_key(t, "Ctrl+S", "Save")
  add_key(t, "Ctrl+F", "Find")
  add_key(t, "Esc", "Clear the selection. Stop the slideshow")
  add_key(t, "→ / ↓ / Space", "To the next slide during a slideshow")
  add_key(t, "← / ↑", "To the slide before during a slideshow")

priv fn add_key(t: Block$@, key: U8[], what: U8[]) //< adds one row of keys
  //<
  //< Caution: **Build the text in one place** (rows made by hand each need rewriting when a cell
  //< style changes).
  r: = t.add_child("")
  r.add_child("cell").add_text(key, "key")
  r.add_child("cell").add_text(what)

priv fn add_limits(doc: Doc$@) //< the chapter that lists what it cannot do
  doc.add_block("chapter").add_text("What it cannot do")

  p: = doc.add_block("body")
  p.add_text("kspage is not yet enough as an editing system. ")
  p.add_text("What is missing is listed here.", "strong")
  p.add_text(" ")
  p.add_text("It is so that you need not look for it thinking you have used it wrongly.")

  // **Put this first of all**: for somebody who cannot read the screen it decides "can I use it
  // at all"; further back, they **give up before reading on**, or **find out only after starting**.
  // **Do not write "in progress"** (only the outer frame is provided), **nor "not yet"**: it is
  // decided not to be included, and hopeful wording leaves the reader waiting for something that
  // is not planned (`../docs/DESIGN.md`).
  doc.add_block("section").add_text("Reading aloud")

  doc.add_block("bullet")
    .add_text("A screen reader cannot read the body. The body is drawn straight onto the screen, so \
      to a screen reader it looks like one picture. The ribbon, the menus and the navigation on the \
      right can be read, but the prose you wrote cannot be read from there.")
  doc.add_block("bullet")
    .add_text("A braille display cannot take the body either, for the same reason. It is not handed \
      over as text, so changing the screen reader changes nothing.")
  doc.add_block("bullet")
    .add_text("If you use a screen reader to read, please do not choose kspage. It is decided that \
      the body is not handed over, and that will not change.")
  doc.add_block("bullet")
    .add_text("It carries no field for writing an image's alternative description either. The body \
      does not reach the reading aloud, so what was written would have nowhere to reach.")

  // **This comes second, right after reading aloud**: a person coming from Word, Excel and
  // PowerPoint (`kspage/docs/DESIGN.md`) arrives with a file.
  doc.add_block("section").add_text("Taking a document in from the three")

  doc.add_block("bullet")
    .add_text("A Word file (.docx), an Excel file (.xlsx) and a PowerPoint file (.pptx) cannot be \
      opened. There is no way of taking one in, so a document somebody sent you cannot be worked on \
      here at all.")
  doc.add_block("bullet")
    .add_text("None of the three can be written out either. What you wrote here cannot be handed to \
      somebody who opens it in Word. What can be handed over is a printed page (PDF), HTML, \
      Markdown, and a table as CSV.")
  doc.add_block("bullet")
    .add_text("A LibreOffice file (.odt, .ods, .odp) cannot be opened or written either.")
  doc.add_block("bullet")
    .add_text("Where a table is what you want, CSV goes both ways (“Insert from CSV” under \
      “Table”, and the writing out under “File”). The text goes across; the styles, the \
      formulas and the merges do not.")
  doc.add_block("bullet")
    .add_text("Where prose is what you want, Markdown goes both ways. What cannot be carried is \
      written into the text as a note, so opening the result in any editor shows you what was \
      dropped.")

  doc.add_block("section").add_text("How a document is made")

  doc.add_block("bullet")
    .add_text("The depth carried into the contents cannot be narrowed. Every heading that carries a \
      depth goes in, so the contents cannot be made of the chapters alone (that is why this \
      manual's contents are long).")
  doc.add_block("bullet")
    .add_text("What a line's height was widened by all goes below. It is not parted above and \
      below.")
  doc.add_block("bullet")
    .add_text("A number cannot be put inside a shape. A bullet or a number comes out at a \
      paragraph's head, so it cannot be laid inside an ellipse or a rectangle.")
  doc.add_block("bullet")
    .add_text("The highlight fills the whole of the line's height, so widen the line and it does \
      not fence the text.")
  doc.add_block("bullet")
    .add_text("A footnote comes out where the footnote list was laid, and not at the page's foot.")
  doc.add_block("bullet")
    .add_text("At the first save after reading afresh, you are asked to allow the writing. Where to \
      write back is remembered, but the browser itself asks every time, so it cannot be avoided.")
  doc.add_block("bullet")
    .add_text("There is a ceiling on the size of a document that can be opened. It is because the \
      memory a page may use is fixed, and a document past it is refused rather than opened (and \
      then the document you have stays as it is). The ceiling comes out in the debug log.")
  doc.add_block("bullet")
    .add_text("The ceiling is not decided by a count of bytes alone. It is decided by the \
      “count” of a table's cells and of paragraphs too, so a document smaller than the ceiling \
      can still be refused. A document parted finely into tables uses far more memory than prose of \
      the same count of bytes (a table's cell is about five times a paragraph).")
  doc.add_block("bullet")
    .add_text("Where it refuses, the document you have stays as it is. What you were writing can \
      never go. Please part the document and then open it.")

  doc.add_block("section").add_text("What is wanting in the tables")

  doc.add_block("bullet")
    .add_text("A formula can call eight workings by name (sum, min, max, count, round, year, month, \
      day). There is nothing that looks a value up in another table by a key, and nothing that cuts \
      or joins text. Where the work wants those, this is not the place for it.")
  doc.add_block("bullet")
    .add_text("Rows cannot be hidden by hand, nor gathered into groups that fold and unfold \
      (Excel's Hide and Group). A filter narrows them by one condition per column, and it is a way \
      of looking: it is not saved with the document, and a total still counts the rows it leaves \
      out.")
  doc.add_block("bullet")
    .add_text("Only a table's first row stays in view as you scroll. A heading of two rows keeps \
      its first alone, and no column stays put at the left (the page does not scroll sideways). On \
      paper the heading is not repeated at the top of the next page, as Word and Excel can.")
  doc.add_block("bullet")
    .add_text("There is nothing that gathers a table into a summary by a key (a pivot table).")
  doc.add_block("bullet")
    .add_text("A range cannot be given a name. A formula points by the letters and numbers (A1, \
      detail!C2), so what a range means has to be read from where it sits.")
  doc.add_block("bullet")
    .add_text("A table has no sheets. Where a workbook of several sheets is wanted, they become \
      several tables in one document, each pointed at by the name it carries.")
  doc.add_block("bullet")
    .add_text("A chart is bars or a line. There is no circle, no scattering of points and no \
      stacking.")
  doc.add_block("bullet")
    .add_text("A line break cannot be put inside a cell. A cell is one paragraph that wraps of its \
      own accord; Enter moves to the cell below, as it does in Excel, and there is no key that \
      breaks the line where you are (Excel's Alt+Enter, Word's Enter).")
  doc.add_block("bullet")
    .add_text("Sorting takes one column. Rows that tie on it keep the order they had; there is no \
      second column to break the tie by, as Excel's “Then by” gives.")

  doc.add_block("section").add_text("What is wanting in the slides")

  doc.add_block("bullet")
    .add_text("It carries neither an effect for the screen changing nor an animation that moves an \
      element. This is not something missing but something decided not to be carried (it copies to \
      neither the paper nor the HTML written out). To put them out in order alone, the “Step” \
      writes it.")
  doc.add_block("bullet")
    .add_text("A note for the speaker comes up while you are showing, with the N key, and it comes \
      up on the screen the audience is watching. There is no second screen holding your notes and \
      the timing while they see the slide alone.")
  doc.add_block("bullet")
    .add_text("There is no master slide. To make every slide carry the same title place and the \
      same colours, lay the same style on each (change the style itself and every slide using it \
      moves at once, so that is the way to do it).")
  doc.add_block("bullet")
    .add_text("Only one shape can be selected at a time. There is no selecting several to move or \
      delete them together, and nothing that lines them up or spaces them evenly.")

  doc.add_block("bullet")
    .add_text("No sound and no video can be put in. What goes in is a still image, the shapes and a \
      chart.")
  doc.add_block("bullet")
    .add_text("There are eleven shapes (a rectangle, a rounded rectangle, an ellipse, a triangle, a \
      diamond, and lines and arrows). There is no line that joins two shapes and follows them, and \
      nothing that builds a diagram out of a list for you.")

  doc.add_block("section").add_text("What it does not answer about a program")

  doc.add_block("bullet")
    .add_text("A source carries the colours of its words alone (the language's words, the strings, \
      the numbers, the comments). Which name is a type and which a function is not told apart, and \
      no colour comes out for a language it does not know.")
  doc.add_block("bullet")
    .add_text("Nothing says a place that does not go through. There is no wavy line, no explanation \
      floating over a name, no going to a declaration and no completion — please use an editor \
      for those.")
  doc.add_block("bullet")
    .add_text("Renaming a name throughout cannot be done. “Replace” changes the text, so it \
      changes the same letters inside a comment or a string too; please look at each one as you go.")

  doc.add_block("section").add_text("What a plugin can do")

  doc.add_block("bullet")
    .add_text("A plugin is handed the selected text and returns text, and that is the whole of it. \
      It cannot read the rest of the document, lay a style on, add a button, or be set to run by \
      itself.")
  doc.add_block("bullet")
    .add_text("Where kspage was not opened through the local server there are no plugins at all.")

  doc.add_block("section").add_text("Writing it with somebody else")

  doc.add_block("bullet")
    .add_text("Two people cannot write into one document at once, on one machine or across a \
      network. Whoever saves second is told the file changed underneath and refused, so nothing is \
      lost in silence, but the two have to be brought together by hand.")
  doc.add_block("bullet")
    .add_text("What there is for bringing them together is “Compare with an earlier version” \
      and the change history, both under “Review”.")
  doc.add_block("bullet")
    .add_text("Two documents cannot be shown side by side. They can be carried (crossing between \
      them under “Files” in the navigation on the right), but to see them at once please open \
      two windows.")
  doc.add_block("bullet")
    .add_text("Inside the split view nothing can be typed. There is one place to type, so it serves \
      for seeing another place of the same document but not for changing it there.")

  doc.add_block("section").add_text("The draft of what you were writing")

  doc.add_block("bullet")
    .add_text("A draft is not a save. Holding one back does not change the file, so to leave it in \
      the file please press save.")
  doc.add_block("bullet")
    .add_text("What is held back is where your hand stopped typing. What was shut right after you \
      began typing may not be held back yet.")
  doc.add_block("bullet")
    .add_text("A draft is inside this browser and nowhere else. It cannot be seen from another \
      machine or another browser, and deleting the browsing data deletes the drafts too.")
  doc.add_block("bullet")
    .add_text("It brings them back one at a time. They cannot be opened together.")

  doc.add_block("section").add_text("What it does not carry")

  doc.add_block("bullet")
    .add_text("It carries no working for looking into a mistake in the text (a spell check).")
  doc.add_block("bullet")
    .add_text("It carries no way of setting the letter spacing and the line spacing finely.")
  doc.add_block("bullet").add_text("It carries no vertical writing.")
  doc.add_block("bullet").add_text("It carries no reading glosses.")
  doc.add_block("bullet").add_text("It carries no mail merge.")
  doc.add_block("bullet")
    .add_text("It carries no way of writing a change as a suggestion for somebody else to take or \
      refuse. The change history records who changed what and when, and comparing shows what moved, \
      but a change goes into the document the moment it is made.")
  doc.add_block("bullet")
    .add_text("It carries no documents to begin from (a template). A new document starts blank.")

  doc.add_block("hint")
    .add_text("This list came out of writing this manual in kspage itself. It is what can only be \
      known by using it, so please go on adding whatever you notice.")

fn add_chapters(doc: Doc$@) //< the second half's chapters
  //<
  //< **The list decides the chapter numbers.**
  add_notes(doc)
  add_paper(doc)
  manual_inout.add_chapter(doc)
  add_together(doc)
  add_plugins(doc)
  add_review(doc)
  add_source(doc)
  add_keys(doc)
  add_limits(doc)

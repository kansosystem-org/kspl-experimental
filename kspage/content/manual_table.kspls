//< The manual's middle (tables, formulas, shapes and charts, slides)
//<
//< **Put the real thing on the page and show what it explains working** (text alone cannot show
//< how it looks). A table's total and a chart are recomputed at every layout.
import "kspage/model/doc" { Axis, Doc, Rect, add_framed_child }

priv fn add_tables(doc: Doc$@) //< the chapter on tables
  doc.add_block("chapter").add_text("Tables")

  p: = doc.add_block("body")
  p.add_text("A table is a block with “the style that lines things up in a grid” laid on it. ")
  p.add_text("The document's side does not say “this is a table”.", "strong")

  doc.add_block("section").add_text("Putting a table in, and moving from cell to cell")

  i: = doc.add_block("body")
  i
    .add_text("It goes in behind the paragraph the cursor is in, from “Table” in the menu's \
      “Insert”. Point at the grid there and the size lights up, columns first (“4 × 3” is \
      four across); press the cell and a table of that size goes in, or press “Insert a table” \
      for the size shown (2 × 2 to begin with). The grid reaches 10 × 8; a larger table is grown \
      from the menu's “Table”, which is also what moves the cells themselves.")

  t: = doc.add_block("table")
  h: = t.add_child("")
  h.add_child("heading-cell").add_text("The command")
  h.add_child("heading-cell").add_text("What it does")
  r1: = t.add_child("")
  r1.add_child("cell").add_text("Insert a row / Delete the row")
  r1.add_child("cell")
    .add_text("Inserts one row below the cell you are in. What it deletes is the row you are in")
  r2: = t.add_child("")
  r2.add_child("cell").add_text("Insert a column / Delete the column")
  r2.add_child("cell")
    .add_text("Inserts one column to the right of the cell you are in. What it deletes is the \
      column you are in")
  r3: = t.add_child("")
  r3.add_child("cell").add_text("Merge the selected cells")
  r3.add_child("cell")
    .add_text("Drag across the cells first, then press. Every one of them goes into the top left \
      cell")
  r4: = t.add_child("")
  r4.add_child("cell").add_text("Unmerge cells")
  r4.add_child("cell").add_text("Puts a merged cell back to the count it was")
  r5: = t.add_child("")
  r5.add_child("cell").add_text("Copy downward / Copy rightward")
  r5.add_child("cell")
    .add_text("Copies what is in the cell you are in to the one beside it. A formula's places shift \
      with it")
  r6: = t.add_child("")
  r6.add_child("cell").add_text("Ascending / Descending")
  r6.add_child("cell")
    .add_text("In the panel that “Order and narrow this column” opens, reorders the rows under \
      the heading by the value in the column you are in, smallest or largest first. The first row \
      is the heading and stays where it is")

  doc.add_block("hint")
    .add_text("Tab moves from cell to cell, and from the last cell it adds a row. Shift+Tab goes \
      back one. Enter moves to the cell below and Shift+Enter to the one above, and from the last \
      row Enter adds a row too. One undo takes a row added by mistake back. The arrow keys move \
      too.")

  doc.add_block("hint")
    .add_text("Scroll a long table and its first row stays at the top of the window until the \
      table's last row comes up to it. Press it to go to the heading.")

  doc.add_block("section").add_text("Showing only some of the rows")

  f: = doc.add_block("body")
  f
    .add_text("Every heading cell carries a small arrow on its right. Press it and a panel opens \
      under that column holding everything that orders and narrows it. The values the column shows \
      are listed there with a tick beside each: untick the ones to leave out and press ")
  f.add_text("“Narrow to the ticked”", "key")
  f
    .add_text(". Only the rows whose cell in that column is one of the ticked stay in sight; the \
      heading always stays, and so does the row you are in. A narrowing on another column narrows \
      further. “Show every row” in the panel lets this column go, and “Show all rows of this \
      table” under “Table” lets every column go at once.")

  doc.add_block("hint")
    .add_text("The box above the list looks for a value; it narrows what the list shows and never \
      changes what is ticked, so a search can be typed, cleared and typed again with the ticks \
      untouched. The values come in the order that column sorts in, and the blank cells stand last \
      as “(the blank cells)”.")

  g: = doc.add_block("body")
  g
    .add_text("The same panel narrows by a condition instead: choose how the cell is to match (is, \
      is not, contains, is above, is below, is empty, is not empty), type the value beside it, and \
      press ")
  g.add_text("“Narrow by this”", "key")
  g
    .add_text(". One narrowing stands on a column at a time, so setting either takes the other off. \
      A column that is narrowed keeps a line under its arrow.")

  doc.add_block("hint")
    .add_text("The same panel opens from “Order and narrow” in the ribbon's Table group, at the \
      column the cursor stands in. There is one panel and two ways to reach it.")

  doc.add_block("hint")
    .add_text("Narrowing is a way of looking, not a change to the document. It is not saved with \
      the file, and a total still counts the rows you cannot see, as it does in Excel. The status \
      bar says how many rows are shown while a condition holds.")

  doc.add_block("hint")
    .add_text("Ascending and Descending at the top of that panel put the rows in order by that \
      column. Sorting puts numbers first, then text by letter without regard to case, and empty \
      cells last. A date in either spelling the formulas read sorts by the day it names. Where the \
      sort cannot be done, the status bar says why: a cell merged down the page in the rows, fewer \
      than two rows under the heading, or rows already in that order.")

  doc.add_block("warning")
    .add_text("A merged cell decides no column's width. What does not fit inside it juts out.")

  doc.add_block("section").add_text("Setting the width and the height")

  w: = doc.add_block("body")
  w.add_text("A column's width and a row's height are ")
  w.add_text("carried by the table", "strong")
  w
    .add_text(" (not by the style). Drag a column's seam left or right, or a row's seam up or down, \
      and they change. Point at one and the arrow's shape changes, so that is how a place you can \
      take hold of is told.")

  n: = doc.add_block("body")
  n.add_text("They can be set by number too. Lay the cursor inside the table and the fields ")
  n.add_text("“A column's width” and “A row's height”", "strong")
  n
    .add_text(" come out in the tools above. Type the same number and the columns' widths line up, \
      so there is no matching them by eye. The unit is the same as the paper's and the margins': a \
      point on the screen (px).")

  doc.add_block("hint")
    .add_text("Empty the field and the setting comes off, and that column (or row) goes back to \
      following its contents. The number showing faintly while it is empty is the width or height \
      as it now stands, so you can tell what to start from.")

  doc.add_block("hint")
    .add_text("Press a seam twice and it fits itself to what is in it, the same gesture as Excel's. \
      A column goes to the widest text in it; a row goes back to following its contents. A cell \
      covering two columns is passed over when a column is measured, since its width is the pair's.")

  doc.add_block("warning")
    .add_text("A width set does not widen for its contents. Text that does not fit juts out.")

  doc.add_block("section").add_text("Merging cells")

  m: = doc.add_block("body")
  m.add_text("Drag across the cells you want as one, then press ")
  m.add_text("“Merge the selected cells”", "strong")
  m
    .add_text(" under “Table”. Every cell the drag covered goes into the one at its top left, \
      and the cursor stands there afterwards.")

  doc.add_block("warning")
    .add_text("The text in the other cells comes off. Nothing is asked before it happens, because \
      one undo (Ctrl+Z) puts every cell and its text back.")

  doc.add_block("hint")
    .add_text("Where it cannot be done the status bar says why: nothing selected inside a table, \
      one cell alone selected, or a cell already merged that reaches outside what you selected. \
      That last one is parted first with “Unmerge cells”.")

  doc.add_block("section").add_text("Taking CSV in and out")

  c: = doc.add_block("body")
  c
    .add_text("“Write the table out as CSV” in the menu's “File” puts the table you are in \
      out. It goes in from “Insert from CSV” under “Table” in “Insert”.")

priv fn add_formulas(doc: Doc$@) //< the chapter on table formulas
  doc.add_block("chapter").add_text("A table's formulas")

  p: = doc.add_block("body")
  p.add_text("Where a cell's text opens with ")
  p.add_text("=", "key")
  p
    .add_text(" it is a formula. A place is written as the column's letter and the row's number, as \
      ")
  p.add_text("A1", "key")
  p.add_text(".")

  doc.add_block("section").add_text("Trying a formula out")

  d: = doc.add_block("body")
  d.add_text("Press inside a cell and the field ")
  d.add_text("Formula", "key")
  d.add_text(" comes out below the menu bar. Type ")
  d.add_text("=A2*B2", "key")
  d
    .add_text(" into it and press Enter. Type the quantity in the table below over and the amount \
      and the total both follow along.")

  doc.add_block("warning")
    .add_text("The formula's field is shut while you are over the body. A formula can be written \
      inside a cell and nowhere else.")

  calc: = doc.add_block("table")
  // **The table holds the name, not the style** (as in `sample.kspls`).
  calc.name = "detail"
  calc.set_size(Axis.column, 0, Option<|F32|>.some(64.0))
  calc.set_size(Axis.column, 1, Option<|F32|>.some(64.0))
  ch: = calc.add_child("")
  ch.add_child("heading-cell").add_text("Qty")
  ch.add_child("heading-cell").add_text("Price")
  ch.add_child("heading-cell").add_text("Amount")
  q1: = calc.add_child("")
  q1.add_child("cell").add_text("3")
  q1.add_child("cell").add_text("120")
  q1.add_child("cell").add_text("=A2*B2", "amount")
  q2: = calc.add_child("")
  q2.add_child("cell").add_text("5")
  q2.add_child("cell").add_text("80")
  q2.add_child("cell").add_text("=A3*B3", "amount")
  tot: = calc.add_child("")
  tot.add_child("heading-cell").add_text("Total")
  tot.add_child("cell").add_text("")
  tot.add_child("cell").add_text("=C2:C3.sum()", "amount")

  doc.add_block("section").add_text("Folding a range")

  r: = doc.add_block("body")
  r.add_text("A range is written as ")
  r.add_text("C2:C3", "key")
  r.add_text(", with the way of folding it put on behind.")

  doc.add_block("bullet").add_text("sum() — adds them")
  doc.add_block("bullet").add_text("count() — counts them")
  doc.add_block("bullet").add_text("min() / max() — the smaller, the larger")
  doc.add_block("bullet").add_text("avg() — the mean")

  doc.add_block("section").add_text("Pointing at another table by name")

  n: = doc.add_block("body")
  n.add_text("Give a table a name and another table can point at it as ")
  n.add_text("detail!C4", "key")
  n.add_text(". The table below points at the one above.")

  // **Say how to set it.** Otherwise whoever reads that it can be referred to by name **looks for
  // where to set one and cannot find it**.
  h: = doc.add_block("body")
  h.add_text("The name goes on from ")
  h.add_text("Set the name", "key")
  h
    .add_text(" under “Shape” in the menu's “Insert”, after clicking one of that table's \
      cells. The name typed into the field goes onto that table.")

  doc.add_block("warning")
    .add_text("What it goes onto changes with where the cursor is: inside a cell the table \
      enclosing it, inside a slide's frame the frame, and otherwise the paragraph you are in. To \
      put it on a table, please press inside one of that table's cells.")

  sum: = doc.add_block("table")
  sum.name = "summary"
  sum.set_size(Axis.column, 0, Option<|F32|>.some(110.0))
  sum.set_size(Axis.column, 1, Option<|F32|>.some(110.0))
  sh: = sum.add_child("")
  sh.add_child("heading-cell").add_text("Items")
  sh.add_child("heading-cell").add_text("Sum")
  sv: = sum.add_child("")
  sv.add_child("cell").add_text("=detail!C2:C3.count()")
  sv.add_child("cell").add_text("=detail!C4", "amount")

  b: = doc.add_block("body")
  b.add_text("A formula can be laid in the body too. The sum is ")
  b.add_text("=detail!C4")
  b.add_text(".")

  doc.add_block("section").add_text("Setting how a number is shown")

  s: = doc.add_block("body")
  s.add_text("The digit grouping and the money sign in the “$1,000” on the amounts above are ")
  s.add_text("set by the style", "strong")
  s
    .add_text(". The digit grouping, the decimal places, per cent, the text put on before and \
      after, and a date's shape can all be chosen.")

  doc.add_block("warning")
    .add_text("The way of showing applies to a formula's answer alone. A number typed bare stays as \
      it was typed.")

  doc.add_block("hint")
    .add_text("Use “When the value” in “The styles in detail” and it switches to another \
      style by whether a number is above or below some value (making it red, say).")

priv fn add_figures(doc: Doc$@) //< the chapter on shapes, images and charts
  doc.add_block("chapter").add_text("Shapes, images and charts")

  doc.add_block("section").add_text("Putting a chart in")

  p: = doc.add_block("body")
  p.add_text("“Chart” in the menu's “Insert” makes bars or a line of a table's range. ")
  p.add_text("What the document carries is the range alone; what is inside is assembled on every \
    placing.", "strong")

  bars: = doc.add_block("bar-chart")
  bars.chart = "detail!C2:C3"

  doc.add_block("caption").add_text("The detail's amounts made into bars")

  doc.add_block("hint")
    .add_text("Type the quantity in the table above over and these bars change with it. A chart \
      remembers no values.")

  doc.add_block("section").add_text("Drawing a shape")

  s: = doc.add_block("body")
  s
    .add_text("It goes in from “Insert a shape” under “Shape” in the menu's “Insert”. \
      The shape is carried by the style, and there are 11 (a rectangle, a rounded rectangle, an \
      ellipse, a triangle, a diamond, and a line and an arrow each way up).")

  doc.add_block("bullet").add_text("“Set the name” puts a name on a shape.")
  doc.add_block("bullet")
    .add_text("“Call it from the body” calls one from the body by number, as “Figure 1”.")

  doc.add_block("hint")
    .add_text("On the ribbon, a button either does the thing at once or opens what has to be filled \
      in first. “Table” and “Slide” go in on the press. “Image” opens the file chooser. \
      “Link” and “Comment” open their field with the cursor in it, and Ctrl+K opens the \
      link's field from anywhere.")

  doc.add_block("section").add_text("Inserting an image")

  e: = doc.add_block("body")
  e.add_text("There are two ways in. Both are inside the menu ")
  e.add_text("Insert", "key")
  e.add_text(".")

  doc.add_block("step")
    .add_text("For an image on your machine, press “Insert from a file” and choose the file. It \
      goes in at the size of the image as it was read.")
  doc.add_block("step")
    .add_text("For an image on the web, type where it is into the field inside the same “Image” \
      and press “Insert”.")

  doc.add_block("body")
    .add_text("The size after it is in is changed by dragging the frame's corner. Write a number \
      into the width and height fields before putting it in and it goes in at that size.")

  doc.add_block("body")
    .add_text("A file chosen goes in one of two ways, and which is not for you to choose. On a \
      document opened by place, with a local server running, the image is laid in the same folder \
      as the document and the document points at that place. Otherwise the image itself is embedded \
      into the document. Which it was comes out on the status bar after the press.")

  doc.add_block("warning")
    .add_text("An image embedded makes the document heavy. The size embedded comes out on the \
      status bar, so it can be noticed there. Embed many large images and it meets the ceiling for \
      opening, and the document no longer opens.")

  doc.add_block("warning")
    .add_text("An image pointed at by place stops coming out unless the document and the image \
      travel together. The HTML written out points at the same place, so move the page alone \
      somewhere else and the image is gone. To hand over one file only, stop the server before \
      putting it in and it is embedded.")

  doc.add_block("warning")
    .add_text("Where an image of the same name is laid already it refuses. It does not overwrite in \
      silence, so please change the name before inserting.")

priv fn add_slides(doc: Doc$@) //< the chapter on slides
  doc.add_block("chapter").add_text("Slides")

  p: = doc.add_block("body")
  p
    .add_text("A slide is a block with “the style that lays things at fixed places” laid on it. \
      A frame inside it takes its place from ")
  p.add_text("its own place", "strong")
  p.add_text(", not from the flow before and after.")

  doc.add_block("section").add_text("Putting a slide in")

  i: = doc.add_block("body")
  i
    .add_text("It goes in from “Slide” in the menu's “Insert”. The row of frames can be \
      chosen from a layout (one frame, a title and a body, a title and two columns).")

  deck: = doc.add_block("slide")
  // **The text is split in two**, so the boundary's checks can find the run holding `As one
  // sheet` alone, by name rather than by position.
  deck_title: =
    add_framed_child(deck, "slide-title",
    Rect::{ .x = 24.0, .y = 20.0, .w = 560.0, .h = 40.0 })
  deck_title.add_text("As one sheet")
  deck_title.add_text(" — showing the same tree, laid out differently")
  add_framed_child(deck, "slide-body", Rect::{ .x = 24.0, .y = 72.0, .w = 270.0, .h = 90.0 })
    .add_text("A frame's place is the coordinate from the slide's top left. It can be moved by \
      dragging.")
  add_framed_child(deck, "slide-frame",
    Rect::{ .x = 330.0, .y = 90.0, .w = 120.0, .h = 46.0 }).add_text("Prose")
  add_framed_child(deck, "slide-frame",
    Rect::{ .x = 480.0, .y = 90.0, .w = 120.0, .h = 46.0 }).add_text("Slide")

  doc.add_block("caption").add_text("One sheet laid in the flow")

  doc.add_block("section").add_text("Moving a frame, and taking one off")

  m: = doc.add_block("body")
  m
    .add_text("Press a frame and it is selected. Drag a handle and its size changes. What takes one \
      off is “Delete the selected frame” under “Slide” in the menu's “Insert”.")

  doc.add_block("hint")
    .add_text("The frames of the slide you are in are listed in the navigation on the right. One \
      can be selected and set there, and the order of overlapping sent forward or back.")

  doc.add_block("section").add_text("Changing the slides' order")

  o: = doc.add_block("body")
  o
    .add_text("In the “Slides” tab of the navigation on the right, take hold of a thumbnail and \
      carry it over another and it goes in there. Where it is going comes out as a dotted frame.")

  doc.add_block("warning")
    .add_text("What carries the order is the document's row. So carrying one is the same as moving \
      a paragraph inside the document, and one undo puts it back.")

  doc.add_block("section").add_text("Putting them out in order (showing it in stages)")

  st: = doc.add_block("body")
  st.add_text("The frames can be put out one at a time in order. Into the ")
  st.add_text("Step", "key")
  st
    .add_text(" field of the selected frame (in the ribbon's “The selected shape” group), write \
      at which step it comes out.")

  doc.add_block("bullet").add_text("0 — it comes out at any time (this is the default).")
  doc.add_block("bullet")
    .add_text("1 and above — it comes out when you have sent it on as far as that step.")

  doc.add_block("body")
    .add_text("While it is being shown full screen, the key that sends on sends one step. Where no \
      step is left it goes on to the next slide. There is one hand that sends.")

  doc.add_block("warning")
    .add_text("What it carries is the order alone. It carries neither “it comes out after N \
      seconds” nor an effect for the screen changing. Put time's axis into the document and \
      something that copies to neither the paper nor the HTML written out is left inside it.")

  doc.add_block("hint")
    .add_text("So a page and the HTML written out are both always “the likeness with everything \
      out”. Write a step and printing does not change.")

  doc.add_block("section").add_text("Showing it full screen")

  v: = doc.add_block("body")
  v
    .add_text("“Slideshow” in the menu's “Share” puts them out one at a time, filling the \
      screen. What sends on is ")
  v.add_text("→", "key")
  v.add_text(" · ")
  v.add_text("↓", "key")
  v.add_text(" · ")
  v.add_text("Space", "key")
  v.add_text(", what goes back is ")
  v.add_text("←", "key")
  v.add_text(" · ")
  v.add_text("↑", "key")
  v.add_text(". What stops is ")
  v.add_text("Esc", "key")
  v.add_text(".")

  doc.add_block("warning")
    .add_text("The style sets a sheet's size both ways. Write no width and it becomes the \
      container's width, and how the frames sit changes with the window's width.")

  doc.add_block("subheading").add_text("The presenter's notes")

  nt: = doc.add_block("body")
  nt.add_text("Press ")
  nt.add_text("N", "key")
  nt
    .add_text(" while it is being shown and the note put beside that slide comes out at the \
      screen's foot. Press again and it goes.")

  doc.add_block("warning")
    .add_text("There is one screen, so the seats see the same thing. It carries no way of parting \
      two screens and putting it out at your hand alone. So it comes out only while you hold the \
      key down.")

fn add_chapters(doc: Doc$@) //< the middle's chapters
  //<
  //< **The list decides the chapter numbers.**
  add_tables(doc)
  add_formulas(doc)
  add_figures(doc)
  add_slides(doc)

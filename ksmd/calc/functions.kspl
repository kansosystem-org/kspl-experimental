//< The functions a formula calls by name, written as any KSPL function is
//< **Each one is an ordinary function.** Its parameters' types say what it takes, and the table
//< generated from this file (`ksmd/calc/functions_table.kspl`) converts a formula's arguments
//< to them by the rules in `ksmd/calc/args.kspl`. **What a person reads of each comes from here
//< too**: its summary, each parameter's `//<`, a sentence "For example, `f(…)` is `…`.", and the
//< divider above it, which names its group. `if`, `sum_if`, `today` and the other forms stay in
//< `ksmd/calc/calc.kspl` and `ksmd/calc/forms.kspl`, and their entries in `ksmd/calc/help.kspl`.
//< Caution: **Change a signature or its comments here, then run `make ksmd-functions`**, which
//< writes the table again; `make debug-ksmd` fails while the two differ.
import "ksmd/base/dates" { day_of, write_date, write_date_with, ymd_of }
import "ksmd/base/marker" { compare_text }
import "ksmd/calc/bases" { Base, Base_error, read, whole, width_ok, write }
import "ksmd/calc/value" { MAX_TEXT, Calc_error, Value, date_value, number }
import "ksmd/model/format" { SHOWN_DIGITS, format_of, round_digits, round_places, show, show_plain }
import "std/chars" // `next_codepoint`, `count_codepoints`
import "std/math"
import "std/mem" { Arena }
import "std/str" { Str_builder } // and `text`, `find_str`
import "std/strfmt" as _strfmt // `\{}` of a whole number
import "std/strnum" // `to_f64`

// **What a person's own functions use is public, so [I0402] is off here.** Their file stands in
// their own workspace, outside this package, and calls these; the lint sees only ksmd's own uses.
##lint(I0402 = off)

const MAX_ROUND: I64 = 15 //< the most places `round` takes, either way
    //< An F64 holds at most 17 significant digits, so a carry past them cannot overflow.

// ==========================================
// Numbers
// ==========================================
// `sum`, `min`, `max`, `count` and `average` fold their numbers. Each takes its numbers in order
// and stops at the first that it cannot take: an error, or a date where dates have no sum. A range
// alone gives its numbers, dates and errors, and leaves out empty cells, text and `true`/`false`
// (`Value[]` in `ksmd/calc/args.kspl`).

pub fn sum( //<
    //< the numbers added; of nothing, 0
    //< For example, `sum(1, 2, 3.5)` is `6.5`.
    xs: Value[], //< the numbers, cells or ranges to add
): F64!Calc_error
    $total: = 0.0
    for v in xs
        if v.kind == .error
            throw v.error
        // Dates have a least and a greatest, and a count; they have no sum.
        if v.kind == .date
            throw .wrong_kind
        total += v.number
    return total

pub fn count( //<
    //< how many numbers and dates there are
    //< For example, `count(4, 8, 15)` is `3`.
    xs: Value[], //< the values, cells or ranges to count
): F64!Calc_error
    $n: Sz = 0
    for v in xs
        if v.kind == .error
            throw v.error
        n += 1
    return F64::n

pub fn average( //<
    //< the numbers' mean
    //< Of no numbers it is `#EMPTY!`.
    //< For example, `average(2, 4, 9)` is `5`.
    xs: Value[], //< the numbers, cells or ranges to average
): F64!Calc_error
    s: = sum(xs)!
    if xs.len == 0
        throw .no_numbers
    return s / F64::xs.len

pub fn min( //<
    //< the least; of dates alone, the earliest date
    //< For example, `min(3, -1, 7)` is `-1`.
    xs: Value[], //< the numbers or dates, cells or ranges to compare
): Value!Calc_error
    return extreme(xs, true)!

pub fn max( //<
    //< the greatest; of dates alone, the latest date
    //< For example, `max(3, -1, 7)` is `7`.
    xs: Value[], //< the numbers or dates, cells or ranges to compare
): Value!Calc_error
    return extreme(xs, false)!

priv fn extreme(xs: Value[], least: Bool): Value!Calc_error //<
    //< The least or the greatest. **Of dates and numbers together there is no answer**
    //< (`#VALUE!`), and of nothing none either (`#EMPTY!`).
    $best: = 0.0
    $dates: Sz = 0
    for i in Range.asc(xs.len)
        v: = xs[i]
        if v.kind == .error
            throw v.error
        if v.kind == .date
            dates += 1
        if i == 0 || (v.number < best if least else v.number > best)
            best = v.number
    if xs.len == 0
        throw .no_numbers
    if dates > 0
        if dates != xs.len
            throw .wrong_kind
        return date_value(I64::best)
    return number(best)

pub fn mod( //<
    //< what is left of `x` after dividing by `y`, with the sign of `y`
    //< So a count of minutes wraps round a clock. A division by zero is `#DIV/0!`, and a quotient
    //< past 2^53, whose remainder an F64 no longer holds, is `#NUM!`.
    //< For example, `mod(-1, 72)` is `71`.
    x: F64, //< the number to divide
    y: F64, //< the number to divide by
): F64!Calc_error
    if y == 0.0
        throw .division
    q: = x / y
    if q >= 9007199254740992.0 || q <= -9007199254740992.0
        throw .not_finite
    $times: = F64::(I64::q)
    if times > q
        times -= 1.0
    return x - y * times

pub fn power( //<
    //< `x` to the power `y`
    //< Where no real number is the answer, it is `#NUM!`.
    //< For example, `power(2, 10)` is `1024`.
    x: F64, //< the base
    y: F64, //< the power to raise it to
): F64!Calc_error
    return math.pow(x, y)

// ==========================================
// Text
// ==========================================
// Why they work as they do is "Text" in `ksmd/docs/DESIGN-ksmd.md`. A position counts characters
// from 1, not bytes, so Japanese text cuts where it reads. A count or a position below its least is
// `#NUM!`; one past the end takes what there is.

pub fn len( //<
    //< how many characters the text holds
    //< For example, `len("pencil")` is `6`.
    t: U8[], //< the text
): I64
    return t.count_codepoints()

pub fn left( //<
    //< the first `count` characters
    //< For example, `left("pencil", 3)` is `pen`.
    t: U8[], //< the text
    count: I64, //< how many characters to take
): U8[]!Calc_error
    return t.sub(0, offset_of(t, count, 0)!)

pub fn right( //<
    //< the last `count` characters
    //< For example, `right("pencil", 4)` is `ncil`.
    t: U8[], //< the text
    count: I64, //< how many characters to take
): U8[]!Calc_error
    if count < 0
        throw .not_finite
    skip: = I64::t.count_codepoints() - count
    return t.sub_from(offset_of(t, skip if skip > 0 else 0, 0)!)

pub fn mid( //<
    //< `count` characters from the `start`th, the first being 1
    //< For example, `mid("pencil", 2, 3)` is `enc`.
    t: U8[], //< the text
    start: I64, //< the first character to take, counted from 1
    count: I64, //< how many characters to take
): U8[]!Calc_error
    if start < 1
        throw .not_finite
    from: = offset_of(t, start - 1, 0)!
    return t.sub(from, offset_of(t, count, from)! - from)

pub fn find( //<
    //< where `part` first stands in `t`, in characters from 1; 0 where it does not
    //< Case counts: `find("a", "A")` is 0.
    //< For example, `find("c", "pencil")` is `4`.
    part: U8[], //< the text to look for
    t: U8[], //< the text to look in
): I64
    if at: = t.find_str(part)
        return I64::t.sub(0, at).count_codepoints() + 1
    return 0

pub fn like( //<
    //< whether the whole text matches the pattern, `*` and `?` standing for any characters
    //< `*` stands for any run of characters, none too, and `?` for exactly one. `~*`, `~?` and `~~`
    //< stand for `*`, `?` and `~` themselves; any other `~` is `#VALUE!`. Case does not count, as
    //< the filter compares text. So `like(A1, "INV-*")` asks whether `A1` starts with `INV-`.
    //< For example, `like("Pens", "p?n*")` is `true`.
    t: Value, //< the text; a number or a date is `false`, and `true`/`false` is `#VALUE!`
    pattern: U8[], //< the pattern, such as `"INV-*"`; any other character stands for itself
): Bool!Calc_error
    // Each `~` escapes a wildcard or itself; checked first, so the answer never hangs on the text.
    for $i: Sz = 0; i < pattern.len; i += 1
        if pattern[i] == '~'
            if i + 1 == pattern.len || !is_wild(pattern[i + 1])
                throw .wrong_kind
            i += 1
    // **A number matches no pattern**, so `sum_if(B, like(A, "INV-*"))` passes over the rows
    // whose code is a number instead of being `#VALUE!` for the whole column.
    switch t.kind
    case .number, .date
        return false
    case .text
        return matches(t.text, pattern)
    case .empty
        return matches("", pattern)
    default
        throw .wrong_kind

priv fn matches(t: U8[], pattern: U8[]): Bool //< whether `t` matches a pattern checked by `like`
    // **One `*` is kept to go back to, the last one passed.** A later `*` matches whatever an
    // earlier one would, so going back further finds nothing new. The work is then at most the
    // text's characters times the pattern's bytes, never exponential.
    $at: Sz = 0 // in `t`
    $p: Sz = 0 // in `pattern`
    $star: Sz = -1 // the pattern's byte after the last `*`; -1 before any
    $star_at: Sz = 0 // where in `t` that `*` began to match
    for at < t.len
        step: = t.next_codepoint(at)
        if p < pattern.len && pattern[p] == '*'
            p += 1
            star = p
            star_at = at
        else if p < pattern.len && one_matches(t.sub(at, step), pattern, p)
            at += step
            p += 2 if pattern[p] == '~' else pattern.next_codepoint(p)
        else if star >= 0
            star_at += t.next_codepoint(star_at)
            at = star_at
            p = star
        else
            return false
    for p < pattern.len && pattern[p] == '*'
        p += 1
    return p == pattern.len

priv fn is_wild(c: U8): Bool //< whether a `~` before `c` makes it stand for itself in `like`
    return c == '*' || c == '?' || c == '~'

priv fn one_matches(c: U8[], pattern: U8[], p: Sz): Bool //<
    //< Whether the character `c` matches the one the pattern holds at byte `p`, which is no `*`
    //< Case does not count: `compare_text`, which the filter and the sort use, decides.
    if pattern[p] == '?'
        return true
    if pattern[p] == '~'
        return c.len == 1 && c[0] == pattern[p + 1]
    return compare_text(c, pattern.sub(p, pattern.next_codepoint(p))) == 0

pub fn value( //<
    //< the number a text writes in decimal, such as `"12.5"` or `" -3 "`; a number stays as it is
    //< **The one way from text to a number**, since arithmetic never reads text. Any other text,
    //< `true`/`false` or a date is `#VALUE!`; an empty cell is 0.
    //< For example, `value(" -3 ")` is `-3`.
    v: Value, //< the text, or a cell that holds it
): F64!Calc_error
    switch v.kind
    case .number
        return v.number
    case .empty
        return 0.0
    case .text
        return v.text.to_f64() catch
            throw .wrong_kind
    default
        throw .wrong_kind

pub fn substitute( //<
    //< `t` with every `old` in it replaced by `new`, from the left and without overlaps
    //< Case counts, as in `find`; an empty `old` leaves `t` as it is. A result past `MAX_TEXT`
    //< bytes is `#NUM!`, measured before the text is made.
    //< For example, `substitute("a-b-c", "-", "/")` is `a/b/c`.
    t: U8[], //< the text
    old: U8[], //< the text to replace
    new: U8[], //< the text to put in its place
    arena: Arena$@,
): U8[]!Calc_error
    if old.len == 0
        return t
    $length: = t.len
    $at: Sz = 0
    for at < t.len
        if t.starts_with(old, at)
            // A growing text is checked at each step, so the count cannot overflow a 32-bit `Sz`.
            length += new.len - old.len
            if new.len > old.len && length > MAX_TEXT
                throw .not_finite
            at += old.len
        else
            at += 1
    if length > MAX_TEXT
        throw .not_finite
    out: = arena.text()
    at = 0
    for at < t.len
        if t.starts_with(old, at)
            out.s(new)
            at += old.len
        else
            out.c(t[at])
            at += 1
    return out.take()

pub fn text( //<
    //< a number or a date written as text, as a column's number format would show it
    //< `text(E2, "date:yyyy/mm/dd")` is `"2026/06/18"` where `E2` holds that date.
    //< **The one way from a number to text**, so `&` can join it. An empty `format` writes the
    //< number as the page shows it without a format: `text(0.1 + 0.2, "")` is `"0.3"`. Text stays
    //< as it is; a format that does not read, or `true`/`false`, is `#VALUE!`.
    //< For example, `text(0.25, "percent:0")` is `25%`.
    v: Value, //< the number or the date
    format: U8[], //< a number format, such as `"percent:0"` or `"date:yyyy/mm/dd"`
    arena: Arena$@,
): U8[]!Calc_error
    f: = format_of(format) catch
        throw .wrong_kind
    defer $out: = Str_builder()
    switch v.kind
    case .text
        return v.text
    case .empty
        return ""
    case .date
        if f.kind == .slash_date
            write_date_with(I64::v.number, '/', out@)
        else
            write_date(I64::v.number, out@)
    case .number
        if f.kind == .none || f.kind == .general || f.kind == .slash_date
            show_plain(v.number, out@)
        else
            show(v.number, f, out@)
    default
        throw .wrong_kind
    return arena.dup_str(out.slice())

priv fn offset_of(t: U8[], count: I64, from: Sz): Sz!Calc_error //<
    //< The byte `count` characters after the byte `from`, or the end; a negative count is `#NUM!`
    if count < 0
        throw .not_finite
    $at: = from
    for $n: I64 = 0; n < count && at < t.len; n += 1
        at += t.next_codepoint(at)
    return at

// ==========================================
// Rounding
// ==========================================

pub fn round( //<
    //< `x` rounded to `places` decimal places, half away from zero
    //< It rounds the digits a person reads, as a number format does.
    //< For example, `round(1234.5, -2)` is `1200`.
    x: F64, //< the number to round
    places: I64, //< the decimal places to keep, from -15 to 15; -2 rounds to hundreds
): F64!Calc_error
    if places < -MAX_ROUND || places > MAX_ROUND
        throw .not_finite
    return round_places(x, Sz::places) catch
        throw .not_finite

pub fn round_down( //<
    //< `x` cut to `places` decimal places, toward zero
    //< For example, `round_down(2.79, 1)` is `2.7`.
    x: F64, //< the number to round
    places: I64, //< the decimal places to keep, as `round` takes them
): F64!Calc_error
    return cut(x, places, false)!

pub fn round_up( //<
    //< `x` taken to `places` decimal places, away from zero
    //< For example, `round_up(2.21, 1)` is `2.3`.
    x: F64, //< the number to round
    places: I64, //< the decimal places to keep, as `round` takes them
): F64!Calc_error
    return cut(x, places, true)!

priv fn cut(x: F64, places: I64, away: Bool): F64!Calc_error //<
    //< `round_down` or `round_up`: the digits a person reads are cut, so 0.3 stays 0.3
    // The scaled value is first rounded to the digits a number shows, so `round_down(0.1 + 0.2,
    // 1)` is 0.3: the F64 just above 0.3 would cut to 0.3 anyway, and the one just below to 0.2.
    // Only those digits are rounded, so `round_down(0.99999999, 0)` stays 0.
    if places < -MAX_ROUND || places > MAX_ROUND
        throw .not_finite
    $scale: = 1.0
    for _ in Range.asc(Sz::(places if places > 0 else -places))
        scale *= 10.0
    scaled: = x * scale if places >= 0 else x / scale
    if scaled >= 9007199254740992.0 || scaled <= -9007199254740992.0
        return x
    near: = round_digits(scaled, SHOWN_DIGITS) catch
        throw .not_finite
    $kept: = F64::(I64::near)
    if away && kept != near
        kept += 1.0 if near > 0.0 else -1.0
    return kept / scale if places >= 0 else kept * scale

// ==========================================
// Dates
// ==========================================

pub fn date( //<
    //< the day the three parts name, in the years 1 to 9999
    //< Any other day, such as the 30th of February, is `#NUM!`.
    //< For example, `date(2026, 3, 1)` is `2026-03-01`.
    year: I64, //< the year, from 1 to 9999
    month: I64, //< the month, from 1 to 12
    day: I64, //< the day of the month
): Value!Calc_error
    d: = day_of(year, month, day) catch
        throw .not_finite
    return date_value(d)

pub fn year( //<
    //< a date's year
    //< For example, `year(date(2026, 3, 1))` is `2026`.
    d: Value, //< the date
): F64!Calc_error
    return F64::ymd_of(day_in(d)!).year

pub fn month( //<
    //< a date's month, 1 to 12
    //< For example, `month(date(2026, 3, 1))` is `3`.
    d: Value, //< the date
): F64!Calc_error
    return F64::ymd_of(day_in(d)!).month

pub fn day( //<
    //< a date's day of the month
    //< For example, `day(date(2026, 3, 1))` is `1`.
    d: Value, //< the date
): F64!Calc_error
    return F64::ymd_of(day_in(d)!).day

priv fn day_in(d: Value): I64!Calc_error //< the day a date names; anything else is `#VALUE!`
    if d.kind != .date
        throw .wrong_kind
    return I64::d.number

// ==========================================
// Hexadecimal and binary
// ==========================================
// Why they work as they do is "Hexadecimal and binary" in `ksmd/docs/DESIGN-ksmd.md`. The width is
// in bits, from 1 to 53. Left out, a negative number takes a minus sign; given, it is written and
// read as its two's complement in that width (`ksmd/calc/bases.kspl`).

pub fn dec_to_hex( //<
    //< `n` in hexadecimal
    //< For example, `dec_to_hex(255)` is `FF`.
    n: I64, //< the whole number
    width: I64?, //< the width in bits, from 1 to 53; left out, a negative number takes a minus sign
    arena: Arena$@,
): U8[]!Calc_error
    return written(n, .hex, width, arena)!

pub fn dec_to_bin( //<
    //< `n` in binary
    //< For example, `dec_to_bin(5)` is `101`.
    n: I64, //< the whole number
    width: I64?, //< the width in bits, from 1 to 53; left out, a negative number takes a minus sign
    arena: Arena$@,
): U8[]!Calc_error
    return written(n, .binary, width, arena)!

pub fn hex_to_dec( //<
    //< the number hexadecimal digits name
    //< For example, `hex_to_dec("100000")` is `1048576`. The literal `=0x100000` is already the
    //< number 1048576. It does not read as the digits.
    digits: Value, //< the hexadecimal digits as text, such as `"100000"`, not `0x100000`
    width: I64?, //< the width in bits, from 1 to 53; given, the digits are two's complement
    arena: Arena$@,
): I64!Calc_error
    return read_in(digits, .hex, width, arena)!

pub fn bin_to_dec( //<
    //< the number binary digits name
    //< For example, `bin_to_dec("101")` is `5`. The literal `=0b101` is already the number 5.
    //< It does not read as the digits.
    digits: Value, //< the binary digits as text, such as `"101"`, not `0b101`
    width: I64?, //< the width in bits, from 1 to 53; given, the digits are two's complement
    arena: Arena$@,
): I64!Calc_error
    return read_in(digits, .binary, width, arena)!

pub fn hex_to_bin( //<
    //< hexadecimal digits written in binary
    //< For example, `hex_to_bin("1F")` is `11111`. A literal such as `0x1F` does not read as the
    //< digits; write `dec_to_bin(0x1F)`.
    digits: Value, //< the hexadecimal digits as text, such as `"1F"`, not `0x1F`
    width: I64?, //< the width in bits, from 1 to 53; given, the digits are two's complement
    arena: Arena$@,
): U8[]!Calc_error
    return written(read_in(digits, .hex, width, arena)!, .binary, width, arena)!

pub fn bin_to_hex( //<
    //< binary digits written in hexadecimal
    //< For example, `bin_to_hex("11111")` is `1F`. A literal such as `0b11111` does not read as the
    //< digits; write `dec_to_hex(0b11111)`.
    digits: Value, //< the binary digits as text, such as `"11111"`, not `0b11111`
    width: I64?, //< the width in bits, from 1 to 53; given, the digits are two's complement
    arena: Arena$@,
): U8[]!Calc_error
    return written(read_in(digits, .binary, width, arena)!, .hex, width, arena)!

priv fn written(n: I64, base: Base, width: I64?, arena: Arena$@): U8[]!Calc_error //<
    //< `n` in the base, in the width given
    return write(n, base, bits_of(width)!, arena) catch e
        throw failure(e)

priv fn read_in(digits: Value, base: Base, width: I64?, arena: Arena$@): I64!Calc_error //<
    //< The digits of text, or of a whole number's decimal digits (`bin_to_dec(101)`); an empty
    //< cell is 0. A negative or a fractional number is no digit text: `#VALUE!`.
    w: = bits_of(width)!
    $s: U8[] = "0"
    switch digits.kind
    case .text
        s = digits.text
    case .number
        at: = whole(digits.number).unwrap_or(-1)
        if at < 0
            throw .wrong_kind
        s = arena.text().s("\{at\}").take()
    case .empty {}
    default
        throw .wrong_kind
    return read(s, base, w) catch e
        throw failure(e)

priv fn bits_of(width: I64?): I64!Calc_error //< 0 for no width; a width out of 1 to 53 is `#NUM!`
    if w: = width
        if !width_ok(w)
            throw .not_finite
        return w
    return 0

priv fn failure(e: Base_error): Calc_error //< the mark a base conversion's failure shows
    return .wrong_kind if e == .not_digits else .not_finite

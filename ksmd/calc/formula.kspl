//< A formula's tokens, how its references attach to rows and columns, and how it is written back
//< A formula is a run of pieces (`Piece` in `ksmd/model/model`). Binding turns each reference that
//< names a cell into a piece holding the identities of that cell's row and column. Writing turns
//< the identities back into the coordinates the rows and columns have now.
//< Caution: **Read a formula only through `token_at` and `next`.** Binding, writing and
//< calculating then agree on where each reference starts and ends.
import "ksmd/base/marker" { formula_text_end, is_decimal, run_of_digits, write_column }
import "ksmd/calc/bases" { is_literal, literal }
import "ksmd/model/model" { Cell, Corner, Document, Piece, Table }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }

const BROKEN: U8[] = "#REF!" //< what a reference becomes when its row or column is removed
priv const CAP: Sz = 1000000000 //< past every table; a longer address stops growing here

struct Address //< a cell by its place, counted from 0: `A1` is row 0, column 0
    row: Sz
    column: Sz
    fixed_row: Bool
    fixed_column: Bool

enum Token_kind
    number //< decimal, as a cell's number without its sign, or in a base: `0xFF`, `0b_0111`
        //< A decimal may leave out the digits on one side of its point: `1.`, `.5`.
    name //< a lowercase name not followed by `.` and a cell address: a function's name or a word
    reference //< a cell, a range or whole columns: `D1`, `budget.D1`, `"Q1 sales".D1`, `D1:D3`, `D`
    text //< quoted text not followed by `.` and a cell address: `"C:\src"`, `"say ""hi"""`
    broken //< `#REF!`
    plus
    minus
    times
    divide
    power //< `^`
    percent //< `%` after a value, which divides it by 100
    join //< `&`, joining text
    equal //< `=`
    unequal //< `<>`
    less //< `<`
    less_equal //< `<=`
    greater //< `>`
    greater_equal //< `>=`
    open
    close
    comma
    bad //< bytes that start no token: a number that does not read, a character, or open text
    end

struct Token
    kind: Token_kind
    start: Sz //< where it starts in its text piece
    end: Sz //< where it ends in its text piece
    text: U8[] //< a number's or a name's bytes, or quoted text with its quotes
    piece: Sz //< a bound reference's piece in `Table.pieces`; -1 for a reference in a text piece
    table: U8[] //< the table's name as written before a reference, quotes included; or empty
    range: Bool //< whether a reference names a rectangle
    whole: Bool //< whether it names whole columns, as `D`, `map.D` or `D:F`, and not a cell
    from: Address
    to: Address //< a range's other corner

impl Token
    fn new(kind: Token_kind, start: Sz, end: Sz): Token //< a token that is not a reference yet
        no: = Address::{ .row = 0, .column = 0, .fixed_row = false, .fixed_column = false }
        return Token::{ .kind = kind, .start = start, .end = end, .text = "", .piece = -1,
            .table = "", .range = false, .whole = false, .from = no, .to = no }

struct Cursor //< how far `next` has read a formula's pieces
    piece: Sz //< which piece of the run
    at: Sz //< where in that piece, for a text piece

priv struct Spot //< a cell address and where it ends
    address: Address
    end: Sz

fn token_at(text: U8[], from: Sz): Token //< the token after any spaces and tabs from `from`
    $i: = from
    for i < text.len && (text[i] == ' ' || text[i] == '\t')
        i += 1
    $t: = Token(.end, i, i)
    if i == text.len
        return t
    c: = text[i]
    if c.is_digit() && is_literal(text.sub_from(i))
        // A literal in a base runs on over every letter, digit and `_`, so `0b12` is one token
        // that does not read, not `0b1` and then `2`.
        $j: = i
        for j < text.len &&
            (text[j].is_lower() || text[j].is_upper() || text[j].is_digit() || text[j] == '_')
            j += 1
        t.end = j
        t.text = text.sub(i, j - i)
        t.kind = .number if literal(t.text).is_some() else .bad
        return t
    if c.is_digit() || (c == '.' && i + 1 < text.len && text[i + 1].is_digit())
        t.end = number_end(text, i)
        t.text = text.sub(i, t.end - i)
        defer $plain: = Str_builder()
        t.kind = .number if is_decimal(literal_decimal(t.text, plain@)) else .bad
        return t
    if c.is_lower()
        $j: = i
        for j < text.len &&
            (text[j].is_lower() || text[j].is_digit() || text[j] == '_')
            j += 1
        if j < text.len && text[j] == '.'
            if spot: = address_at(text, j + 1)
                t = reference_from(text, i, spot)
                t.table = text.sub(i, j - i)
                return t
            if spot: = column_at(text, j + 1)
                t = columns_from(text, i, spot)
                t.table = text.sub(i, j - i)
                return t
        t.kind = .name
        t.end = j
        t.text = text.sub(i, j - i)
        return t
    if c == '"'
        // A table's name before `.` and a cell, as any name that is not plain is written; or else
        // text. Text never stands before `.`, so the two cannot be confused.
        close: = formula_text_end(text, i)
        if close == text.len
            return Token(.bad, i, text.len)
        if close + 1 < text.len && text[close + 1] == '.'
            if spot: = address_at(text, close + 2)
                t = reference_from(text, i, spot)
                t.table = text.sub(i, close + 1 - i)
                return t
            if spot: = column_at(text, close + 2)
                t = columns_from(text, i, spot)
                t.table = text.sub(i, close + 1 - i)
                return t
        t.kind = .text
        t.end = close + 1
        t.text = text.sub(i, close + 1 - i)
        return t
    if spot: = address_at(text, i)
        return reference_from(text, i, spot)
    // Letters with no row number are a whole column of the formula's own table, as `D1` is its
    // cell. Letters before `(` stay a byte that starts nothing: a function's name is lowercase.
    if spot: = column_at(text, i)
        if spot.end == text.len || text[spot.end] != '('
            return columns_from(text, i, spot)
    if text.starts_with(BROKEN, i)
        return Token(.broken, i, i + BROKEN.len)
    if (c == '<' || c == '>') && i + 1 < text.len &&
        (text[i + 1] == '=' || text[i + 1] == '>')
        two: = text.sub(i, 2)
        if two.equals("<=")
            return Token(.less_equal, i, i + 2)
        if two.equals(">=")
            return Token(.greater_equal, i, i + 2)
        if two.equals("<>")
            return Token(.unequal, i, i + 2)
    kind: = operator(c)
    if kind != .bad
        return Token(kind, i, i + 1)
    // A byte that starts nothing keeps its whole character, so a reason can name it: `~`, `é`.
    t.kind = .bad
    t.end = i + text.next_codepoint(i)
    t.text = text.sub(i, t.end - i)
    return t

fn next(table: Table@, cell: Cell, cur: Cursor$@): Token //<
    //< The next token of a formula cell, read across its pieces; `.end` after the last
    for cur.piece < cell.count
        index: = cell.first + cur.piece
        p: = table.pieces[index]@
        switch p.kind
        case .text
            tok: = token_at(p.text, cur.at)
            if tok.kind != .end
                cur.at = tok.end
                return tok
            cur.piece += 1
            cur.at = 0
        case .cell, .range, .columns
            cur.piece += 1
            cur.at = 0
            $tok: = Token(.reference, 0, 0)
            tok.piece = index
            tok.range = p.kind != .cell
            return tok
    return Token(.end, 0, 0)

fn bind(doc: Document@, home: Sz, text: U8[], pieces: List<|Piece|>$@): Sz //<
    //< Appends the pieces of a formula held by table `home`, and returns how many
    //< A reference attaches when it names a cell (`attachable`); any other stays text.
    $count: Sz = 0
    $kept: Sz = 0
    for
        found: = attachable(doc, home, text, kept) catch
            break
        if found.token.start > kept
            pieces.push(text_piece(text.sub(kept, found.token.start - kept)))
            count += 1
        pieces.push(found.piece)
        count += 1
        kept = found.token.end
    if kept < text.len
        pieces.push(text_piece(text.sub_from(kept)))
        count += 1
    return count

fn has_attachable(doc: Document@, home: Sz, table: Table@, cell: Cell): Bool //<
    //< Whether a reference kept as text in a formula would attach if it were bound again
    for k in Range(cell.first, cell.first + cell.count, 1)
        p: = table.pieces[k]@
        if p.kind == .text
            if _found: = attachable(doc, home, p.text, 0)
                return true
    return false

struct Found //< a reference that attaches, and its piece
    token: Token
    piece: Piece

fn attachable(doc: Document@, home: Sz, text: U8[], from: Sz): Found? //<
    //< The next reference from `from` that names a cell in this source, as `bind` attaches it
    //< A reference right after a number stays text: the formula is wrong, and a moved column
    //< would join the two into one number (`1A1` into `1E1`).
    $after_number: = false
    $at: = from
    for
        tok: = token_at(text, at)
        if tok.kind == .end
            return .none
        if tok.kind == .reference && !(after_number && tok.start == at)
            if p: = attach(doc, home, tok)
                return .some(Found::{ .token = tok, .piece = p })
        after_number = tok.kind == .number
        at = tok.end

fn bind_all(doc: Document$@, arena: Arena$@) //<
    //< Binds each formula the reader read as one text piece, once every table's name is known
    for table in Range.asc(doc.tables.len)
        $fresh: = List<|Piece|>(arena)
        for i in Range.asc(doc.tables[table].cells.len)
            cell: = doc.tables[table].cells[i]
            if cell.kind == .formula
                text: = doc.tables[table].pieces[cell.first].text
                first: = fresh.len
                count: = bind(doc, table, text, fresh@)
                doc.tables[table].cells[i].first = first
                doc.tables[table].cells[i].count = count
        doc.tables[table].pieces = fresh

fn text_piece(text: U8[]): Piece //< a piece of bytes kept as written
    return Piece::{ .kind = .text, .text = text, .table = 0, .named = false, .from = no_corner(),
        .to = no_corner() }

fn write_formula(doc: Document@, table: Table@, cell: Cell, at: Positions@, rows: Sz, columns: Sz,
    out: Str_builder$@) //<
        //< Writes a formula with each reference's coordinates as they are now
        //< `rows` and `columns` shift every axis without `$`, as a copy that far away does. A
        //< reference shifted outside its table becomes `#REF!`.
    for i in Range.asc(cell.count)
        p: = table.pieces[cell.first + i]@
        switch p.kind
        case .text
            out.s(p.text)
        case .cell, .range
            write_reference(doc, p, at, rows, columns, out)
        case .columns
            write_columns(doc, p, at, columns, out)

fn shift_formula(doc: Document@, home: Sz, text: U8[], rows: Sz, columns: Sz, out: Str_builder$@) //<
    //< Writes a formula's text, without its `=`, as a copy `rows` down and `columns` right writes
    //< it into table `home`, each reference shifted as `moved` shifts it
    //< A paste of cells copied in ksmd calls it: the text may come from another document. A
    //< reference without a table's name names a cell of `home`. A reference shifted outside its
    //< table becomes `#REF!`. One that names no table of this source stays as written, as `bind`
    //< keeps it.
    $kept: Sz = 0
    $at: Sz = 0
    $after_number: = false
    for
        tok: = token_at(text, at)
        if tok.kind == .end
            break
        if tok.kind == .reference && !(after_number && tok.start == at)
            if table: = table_of(doc, home, tok)
                out.s(text.sub(kept, tok.start - kept))
                write_shifted(text, tok, doc.tables[table]@, rows, columns, out)
                kept = tok.end
        after_number = tok.kind == .number
        at = tok.end
    out.s(text.sub_from(kept))

priv fn table_of(doc: Document@, home: Sz, tok: Token): Sz? //< the table a reference names
    if tok.table.len == 0
        return .some(home)
    return find_written(doc, tok.table)

priv fn write_shifted(text: U8[], tok: Token, table: Table@, rows: Sz, columns: Sz,
    out: Str_builder$@) //<
        //< One reference token, shifted, its table's name as written; `#REF!` where it leaves `table`
    $a: = tok.from
    $b: = tok.to
    // Whole columns hold every row, so only their columns shift.
    height: = 1 if tok.whole else table.rows.len
    a.fixed_row = a.fixed_row || tok.whole
    b.fixed_row = b.fixed_row || tok.whole
    a = moved(a, rows, columns, height, table.columns.len)
    b = moved(b, rows, columns, height, table.columns.len)
    if a.row < 0 || b.row < 0
        out.s(BROKEN)
        return
    write_token(text, tok, a, b, out)

priv fn write_token(text: U8[], tok: Token, left: Address, right: Address, out: Str_builder$@) //<
    //< A reference token with new corners: its table's name as written, then its addresses in the
    //< order written, a second only where the text has one
    if tok.table.len > 0
        out.s(tok.table).c('.')
    if tok.whole
        write_letters(left, out)
    else
        write_address(left, out)
    // `map.D` and `map.D:D` both name one column, so the text tells whether a second stands.
    addresses: = tok.start + (tok.table.len + 1 if tok.table.len > 0 else 0)
    if text.sub(addresses, tok.end - addresses).find_char(':').is_none()
        return
    out.c(':')
    if tok.whole
        write_letters(right, out)
    else
        write_address(right, out)

fn cycle_fixed(text: U8[], from: Sz, to: Sz, out: Str_builder$@): Sz //<
    //< Writes a formula's text, without its `=`, with `$` turned to its next form in each reference
    //< from byte `from` to byte `to`, as F4 turns it in a spreadsheet's cell. It gives where the
    //< last reference turned ends in `out`, or -1 where none turned.
    //< `A1` becomes `$A$1`, then `A$1`, then `$A1`, then `A1` again. Whole columns turn between
    //< `D` and `$D`. A range's corners both take the form that follows its first corner's. With
    //< `from` equal to `to`, the reference the caret stands in or just after turns.
    $kept: Sz = 0
    $at: Sz = 0
    $last: Sz = -1
    for
        tok: = token_at(text, at)
        if tok.kind == .end
            break
        at = tok.end
        touches: =
            (tok.start < to && tok.end > from) ||
            (from == to && tok.start <= from && tok.end >= from)
        if tok.kind != .reference || !touches
            continue
        $a: = tok.from
        a.fixed_row = !tok.whole && a.fixed_column == a.fixed_row
        a.fixed_column = !tok.from.fixed_column
        $b: = tok.to
        b.fixed_row = a.fixed_row
        b.fixed_column = a.fixed_column
        out.s(text.sub(kept, tok.start - kept))
        write_token(text, tok, a, b, out)
        kept = tok.end
        last = out.slice().len
    out.s(text.sub_from(kept))
    return last

priv struct Brackets //< how a formula's brackets and quotes stand at its end
    open: Sz //< each `(` that no `)` closes
    stray: Bool //< a `)` closes nothing
    quoted: Bool //< quoted text runs on to the end

priv fn brackets_of(text: U8[]): Brackets //< the brackets of a formula's tokens
    //< A bracket inside quoted text is text, as `token_at` reads it.
    $b: = Brackets::{ .open = 0, .stray = false, .quoted = false }
    $at: Sz = 0
    for
        tok: = token_at(text, at)
        if tok.kind == .end
            return b
        if tok.kind == .open
            b.open += 1
        else if tok.kind == .close && b.open == 0
            b.stray = true
        else if tok.kind == .close
            b.open -= 1
        else if tok.kind == .bad && text[tok.start] == '"' && tok.end == text.len
            b.quoted = true
        at = tok.end

fn closing(text: U8[], out: Str_builder$@) //<
    //< Writes what closes a formula left open at its end: a `"` for quoted text still open, then
    //< a `)` for each `(` no `)` closes. It writes nothing where the formula closes already.
    //< **It writes nothing where an ending alone cannot close it**, as where a `)` closes nothing.
    //< It never guesses a place inside. A `\` before the end is text, so `"C:\` closes as `"C:\"`.
    b: = brackets_of(text)
    if b.stray || (b.open == 0 && !b.quoted)
        return
    defer $whole: = Str_builder()
    whole.s(text)
    if b.quoted
        whole.c('"')
    for _ in Range.asc(b.open)
        whole.c(')')
    after: = brackets_of(whole.slice())
    if after.stray || after.open > 0 || after.quoted
        return
    out.s(whole.slice().sub_from(text.len))

fn partner(text: U8[], at: Sz, arena: Arena$@): Sz //<
    //< Where the bracket that pairs with the bracket at byte `at` starts, or -1
    //< -1 also where byte `at` starts no bracket, as inside quoted text, or where nothing pairs.
    $opens: = List<|Sz|>(arena)
    $from: Sz = 0
    $wanted: Sz = -1 //< how many `(` stay open once the `(` at `at` is closed
    for
        tok: = token_at(text, from)
        if tok.kind == .end || (wanted < 0 && tok.start > at)
            return -1
        if tok.kind == .open
            if tok.start == at
                wanted = opens.len
            opens.push(tok.start)
        else if tok.kind == .close && opens.len == 0
            if tok.start == at
                return -1
        else if tok.kind == .close
            o: = opens.pop().unwrap_or(-1)
            if tok.start == at
                return o
            if opens.len == wanted
                return tok.start
        from = tok.end

priv fn write_reference(doc: Document@, piece: Piece@, at: Positions@, rows: Sz, columns: Sz,
    out: Str_builder$@) //<
        //< `[name.]A1`, or a range from its upper left corner to its lower right one
    $a: = at.place(piece.table, piece.from, rows, columns)
    $b: = at.place(piece.table, piece.to, rows, columns)
    if a.row < 0 || b.row < 0
        out.s(BROKEN)
        return
    if piece.named
        write_table_name(doc.tables[piece.table].name, out)
        out.c('.')
    if piece.kind == .cell
        write_address(a, out)
        return
    // Each axis's place and `$` travel together, so a swap keeps which line a copy holds.
    if a.row > b.row
        row: = a.row
        fixed: = a.fixed_row
        a.row = b.row
        a.fixed_row = b.fixed_row
        b.row = row
        b.fixed_row = fixed
    if a.column > b.column
        column: = a.column
        fixed: = a.fixed_column
        a.column = b.column
        a.fixed_column = b.fixed_column
        b.column = column
        b.fixed_column = fixed
    write_address(a, out)
    out.c(':')
    write_address(b, out)

priv fn write_columns(doc: Document@, piece: Piece@, at: Positions@, columns: Sz,
    out: Str_builder$@) //<
        //< `[name.]D`, or `[name.]D:F` from the left column to the right one
    $a: = at.column_place(piece.table, piece.from, columns)
    $b: = at.column_place(piece.table, piece.to, columns)
    if a.column < 0 || b.column < 0
        out.s(BROKEN)
        return
    if piece.named
        write_table_name(doc.tables[piece.table].name, out)
        out.c('.')
    if a.column > b.column
        other: = a
        a = b
        b = other
    write_letters(a, out)
    if a.column != b.column
        out.c(':')
        write_letters(b, out)

fn write_address(address: Address, out: Str_builder$@) //<
    //< `$A$1`: letters for the column, then the row
    write_letters(address, out)
    if address.fixed_row
        out.c('$')
    out.s("\{address.row + 1\}")

priv fn write_letters(address: Address, out: Str_builder$@) //< `$A`: the column's letters
    if address.fixed_column
        out.c('$')
    write_column(address.column, out)

struct Positions //< where each row and column stands, by its identity, in every table
    //< It is built from the document, and a table's lists can be put in its place to measure an
    //< edit before making it (`place_lists`).
    slots: List<|Sz|> //< for each table, from `starts`: each identity's place, or -1
    starts: List<|Sz|>
    rows: List<|Sz|> //< each table's count of data rows
    columns: List<|Sz|> //< each table's count of columns

impl Positions
    fn new(doc: Document@, arena: Arena$@): Positions
        $at: = Positions::{ .slots = List<|Sz|>(arena), .starts = List<|Sz|>(arena),
            .rows = List<|Sz|>(arena), .columns = List<|Sz|>(arena) }
        for table in Range.asc(doc.tables.len)
            t: = doc.tables[table]@
            at.starts.push(at.slots.len)
            // One slot more than the identities given, for the one an insertion gives.
            for _ in Range.asc(t.next_id + 1)
                at.slots.push(-1)
            at.rows.push(0)
            at.columns.push(0)
            at.place_lists(table, t.rows@, t.columns@)
        return at

    fn place_lists(at: Self$@, table: Sz, rows: List<|Sz|>@, columns: List<|Sz|>@) //<
        //< Makes the rows and columns of the table at `table` stand as these lists order them
        start: = at.starts[table]
        end: = at.slots.len if table + 1 == at.starts.len else at.starts[table + 1]
        for i in Range(start, end, 1)
            at.slots[i] = -1
        for i in Range.asc(rows.len)
            at.slots[start + rows[i]] = i
        for i in Range.asc(columns.len)
            at.slots[start + columns[i]] = i
        at.rows[table] = rows.len
        at.columns[table] = columns.len

    fn of(at: Self@, table: Sz, id: Sz): Sz //<
        //< the place of a row or column of the table at `table`, or -1
        slot: = at.starts[table] + id
        return at.slots[slot]

    fn column_place(at: Self@, table: Sz, corner: Corner, columns: Sz): Address //<
        //< Where a corner's column stands, shifted unless it has `$`; column -1 outside the table
        $a: =
            moved(Address::{ .row = 0, .column = at.of(table, corner.column), .fixed_row = true,
            .fixed_column = corner.fixed_column }, 0, columns, 1, at.columns[table])
        if a.row < 0
            a.column = -1
        a.fixed_row = false
        return a

    fn place(at: Self@, table: Sz, corner: Corner, rows: Sz, columns: Sz): Address //<
        //< Where a corner stands, shifted on each axis without `$`; row -1 outside the table
        return moved(Address::{ .row = at.of(table, corner.row),
            .column = at.of(table, corner.column), .fixed_row = corner.fixed_row,
            .fixed_column = corner.fixed_column }, rows, columns, at.rows[table],
            at.columns[table])

fn moved($address: Address, rows: Sz, columns: Sz, height: Sz, width: Sz): Address //<
    //< An address as a copy `rows` down and `columns` right writes it: each axis without `$`
    //< shifts, and one with `$` stays. Row -1 where it falls outside a table of `height` rows and
    //< `width` columns.
    //< Caution: **Shift a reference only here.** A fill, a copy and a paste of a formula then
    //< agree on which part moves.
    if !address.fixed_row
        address.row += rows
    if !address.fixed_column
        address.column += columns
    if address.row < 0 || address.row >= height || address.column < 0 || address.column >= width
        address.row = -1
    return address

priv fn attach(doc: Document@, home: Sz, tok: Token): Piece? //<
    //< The piece of a reference that names a cell in this source, or none
    $table: = home
    if tok.table.len > 0
        table = find_written(doc, tok.table) catch
            return .none
    t: = doc.tables[table]@
    if tok.whole
        if tok.from.column >= t.columns.len || tok.to.column >= t.columns.len
            return .none
        return .some(Piece::{ .kind = .columns, .text = "", .table = table,
            .named = tok.table.len > 0, .from = column_corner(t, tok.from),
            .to = column_corner(t, tok.to) })
    if !inside(t, tok.from) || tok.range && !inside(t, tok.to)
        return .none
    return .some(Piece::{ .kind = .range if tok.range else .cell, .text = "", .table = table,
        .named = tok.table.len > 0, .from = corner(t, tok.from), .to = corner(t, tok.to) })

fn write_table_name(name: U8[], out: Str_builder$@) //<
    //< A table's name as a reference writes it: plain, or in quotes as formula text is written
    if is_plain_name(name)
        out.s(name)
    else
        write_quoted(name, out)

fn write_quoted(text: U8[], out: Str_builder$@) //<
    //< Text in a formula's quotes: each byte as it is, and each '"' twice, as `unquoted` reads it
    out.c('"')
    for c in text
        if c == '"'
            out.c('"')
        out.c(c)
    out.c('"')

fn is_plain_name(name: U8[]): Bool //< `[a-z][a-z0-9_]*`, which a formula writes without quotes
    if name.len == 0 || !name[0].is_lower()
        return false
    for c in name
        if !c.is_lower() && !c.is_digit() && c != '_'
            return false
    return true

priv fn find_written(doc: Document@, written: U8[]): Sz? //< the table a reference's name names
    if !written.starts_with("\"")
        return find_table(doc, written)
    defer scratch: = Arena(4096)
    return find_table(doc, unquoted(written, scratch))

fn unquoted(quoted: U8[], arena: Arena$@): U8[] //<
    //< The text a formula's quoted text means, its quotes included in `quoted`: each `""` is one
    //< '"', and every other byte stands for itself. Without a `""`, a view of `quoted` itself.
    inner: = quoted.sub(1, quoted.len - 2)
    if inner.find_char('"').is_none()
        return inner
    out: = arena.text()
    $i: Sz = 0
    for i < inner.len
        out.c(inner[i])
        i += 2 if inner[i] == '"' else 1
    return out.take()

fn find_table(doc: Document@, name: U8[]): Sz? //< the table of this name in this source
    for table in Range.asc(doc.tables.len)
        if doc.tables[table].name.equals(name)
            return .some(table)
    return .none

priv fn inside(table: Table@, address: Address): Bool
    return address.row < table.rows.len && address.column < table.columns.len

priv fn corner(table: Table@, address: Address): Corner
    return Corner::{ .row = table.rows[address.row], .column = table.columns[address.column],
        .fixed_row = address.fixed_row, .fixed_column = address.fixed_column }

priv fn column_corner(table: Table@, address: Address): Corner //<
    //< a whole column's corner: its row unused
    return Corner::{ .row = 0, .column = table.columns[address.column], .fixed_row = false,
        .fixed_column = address.fixed_column }

priv fn no_corner(): Corner
    return Corner::{ .row = 0, .column = 0, .fixed_row = false, .fixed_column = false }

priv fn reference_from(text: U8[], start: Sz, spot: Spot): Token //<
    //< A reference from `start`; a range when `:` and a second address follow at once
    $t: = Token(.reference, start, spot.end)
    t.from = spot.address
    t.to = spot.address
    if spot.end < text.len && text[spot.end] == ':'
        if other: = address_at(text, spot.end + 1)
            t.range = true
            t.to = other.address
            t.end = other.end
    return t

priv fn columns_from(text: U8[], start: Sz, spot: Spot): Token //<
    //< Whole columns from `start`: one, or a run when `:` and other letters follow at once
    $t: = Token(.reference, start, spot.end)
    t.range = true
    t.whole = true
    t.from = spot.address
    t.to = spot.address
    if spot.end < text.len && text[spot.end] == ':'
        if other: = column_at(text, spot.end + 1)
            t.to = other.address
            t.end = other.end
    return t

priv fn column_at(text: U8[], from: Sz): Spot? //<
    //< A whole column at `from`: `$`, then capital letters that no row number or other name
    //< character follows
    $i: = from
    $a: = Address::{ .row = 0, .column = 0, .fixed_row = false, .fixed_column = false }
    if i < text.len && text[i] == '$'
        a.fixed_column = true
        i += 1
    letters: = i
    $column: Sz = 0
    for i < text.len && text[i].is_upper()
        column = capped(column * 26 + Sz::(text[i] - 'A') + 1)
        i += 1
    if i == letters
        return .none
    if i < text.len &&
        (text[i].is_digit() || text[i].is_lower() || text[i] == '_' || text[i] == '$')
        return .none
    a.column = column - 1
    return .some(Spot::{ .address = a, .end = i })

priv fn address_at(text: U8[], from: Sz): Spot? //<
    //< A cell address at `from`: `$`, capital letters, `$`, then a row number without a leading 0
    $i: = from
    $a: = Address::{ .row = 0, .column = 0, .fixed_row = false, .fixed_column = false }
    if i < text.len && text[i] == '$'
        a.fixed_column = true
        i += 1
    letters: = i
    $column: Sz = 0
    for i < text.len && text[i].is_upper()
        column = capped(column * 26 + Sz::(text[i] - 'A') + 1)
        i += 1
    if i == letters
        return .none
    if i < text.len && text[i] == '$'
        a.fixed_row = true
        i += 1
    if i == text.len || text[i] < '1' || text[i] > '9'
        return .none
    $row: Sz = 0
    for i < text.len && text[i].is_digit()
        row = capped(row * 10 + Sz::(text[i] - '0'))
        i += 1
    a.row = row - 1
    a.column = column - 1
    return .some(Spot::{ .address = a, .end = i })

priv fn capped(count: Sz): Sz
    return count if count < CAP else CAP

priv fn number_end(text: U8[], from: Sz): Sz //<
    //< The end of the digits, a point and a fraction, and an exponent that start at `from`
    $i: = from
    for i < text.len && text[i].is_digit()
        i += 1
    if i < text.len && text[i] == '.'
        i += 1
        for i < text.len && text[i].is_digit()
            i += 1
    if i < text.len && (text[i] == 'e' || text[i] == 'E')
        $j: = i + 1
        if j < text.len && (text[j] == '+' || text[j] == '-')
            j += 1
        if j < text.len && text[j].is_digit()
            for j < text.len && text[j].is_digit()
                j += 1
            i = j
    return i

fn as_decimal(written: U8[], out: Str_builder$@): U8[] //<
    //< A number in decimal, as a cell's number writes it: `1.` as `1`, `.5` as `0.5`, `-.5` as `-0.5`
    //< Excel takes a point with digits on one side only, so a formula copied from it reads, and a
    //< typed `.5` is a number. A number with digits on both sides, or none, is given as written,
    //< in `written` itself. A `-` in front stays; a formula's number has none, as its sign is
    //< unary minus.
    point: = written.find_char('.') catch
        return written
    sign: Sz = 1 if written.starts_with("-") else 0
    fraction: = run_of_digits(written.sub_from(point + 1))
    // Only digits stand before the point: in `1e5.` it follows an exponent, and is no number's.
    if (point > sign) == (fraction > 0) ||
        run_of_digits(written.sub_from(sign)) != point - sign
        return written
    out.s(written.sub(0, sign))
    out.s("0" if point == sign else written.sub(sign, point - sign))
    out.s(written.sub_from(point if fraction > 0 else point + 1))
    return out.slice()

fn literal_decimal(written: U8[], out: Str_builder$@): U8[] //<
    //< A formula's number in decimal: as `as_decimal`, after its leading zeros, as Excel reads it
    //< `007` is 7, and `00.5` is 0.5. A number cell keeps JSON's form, which has no leading zero:
    //< as a cell, `007` is a code that would lose its zeros.
    $zeros: Sz = 0
    for zeros + 1 < written.len && written[zeros] == '0' && written[zeros + 1].is_digit()
        zeros += 1
    return as_decimal(written.sub_from(zeros), out)

priv fn operator(byte: U8): Token_kind
    switch byte
    case '+'
        return .plus
    case '-'
        return .minus
    case '*'
        return .times
    case '/'
        return .divide
    case '^'
        return .power
    case '%'
        return .percent
    case '&'
        return .join
    case '='
        return .equal
    case '<'
        return .less
    case '>'
        return .greater
    case '('
        return .open
    case ')'
        return .close
    case ','
        return .comma
    default {}
    return .bad

fn spelled(tok: Token): U8[] //< how a token is written, for a reason a person reads (`Why`)
    //< A number, a name or text as written; an operator or a bracket as its sign. A reference
    //< bound to a cell holds no text, and the formula's end none.
    if tok.text.len > 0
        return tok.text
    switch tok.kind
    case .plus
        return "+"
    case .minus
        return "-"
    case .times
        return "*"
    case .divide
        return "/"
    case .power
        return "^"
    case .percent
        return "%"
    case .join
        return "&"
    case .equal
        return "="
    case .unequal
        return "<>"
    case .less
        return "<"
    case .less_equal
        return "<="
    case .greater
        return ">"
    case .greater_equal
        return ">="
    case .open
        return "("
    case .close
        return ")"
    case .comma
        return ","
    case .broken
        return BROKEN
    case .reference
        return "a reference"
    case .number, .name, .text, .bad, .end
        return ""

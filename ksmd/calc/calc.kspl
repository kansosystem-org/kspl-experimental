//< Calculates every table of a document: the value of each data cell, kept apart from the document
//< A formula is read from its pieces and calculated in the same pass; nothing is saved. Cells are
//< calculated in the order they depend on each other, so a formula can name a later row.
//< Calculation reads the model and one input, the date the document was opened, which `today()`
//< gives. It reads no clock, so the same model and date always give the same values.
//< Caution: **Calculate again after every edit.** `Results` holds the values of one moment, and
//< places that an edit has moved point at other cells.
import "ksmd/base/dates" { date_of }
import "ksmd/calc/args" { Raw_arg, Raw_args }
import "ksmd/calc/bases" { READ_DIGITS, literal }
import "ksmd/calc/forms" // `lookup`, `sum_product`, `column_name`, `conditional`, `area_of`
import "ksmd/calc/forms" { parser_row }
import "ksmd/calc/formula" { Cursor, Positions, Token, Token_kind, next, spelled, unquoted }
import "ksmd/calc/functions_table" as table
import "ksmd/calc/help" { FORMS }
import "ksmd/calc/value" { MAX_TEXT, Calc_error, Value, Why, arithmetic, boolean, compare,
    date_value, empty, is_comparison, joined, number, number_of, text, truth }
import "ksmd/model/model" { Cell, Document, Table }
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"

const MAX_LEVELS: Sz = 64 //< how deeply one formula nests: brackets, functions, unary minus and
    //< `not`

const MAX_READS: Sz = 500000000 //< the cell values one calculation reads; past it, `#LIMIT!`
    //< A range read on every row multiplies the reads, so a crafted file of 8 MiB could take many
    //< minutes, and the page calculates after every edit. Two tables of 10,000 rows, each row
    //< taking a `sum_if` over a whole column, read 410 million: more than any document measured
    //< needs.

priv const MAX_DEPTH: Sz = 256 //< the cells and levels one calculation passes through at a time
    //< A deeper chain is set aside and its deepest cell calculated first (`settle`), so a running
    //< total down 10,000 rows calculates without running out of stack.
priv const UNVISITED: U8 = 0U8
priv const WORKING: U8 = 1U8 //< being calculated; reaching it again is a cycle
priv const SETTLED: U8 = 2U8

fn known(name: U8[]): Bool //< whether ksmd has a function of this name, so a person's cannot
    for form in FORMS
        if form.name.equals(name)
            return true
    for one in table.NAMES
        if one.equals(name)
            return true
    return false

struct Results //< the value of every data cell of every table, at one moment
    values: List<|Value|> //< each table's data cells from `starts`, row by row
    starts: List<|Sz|>
    columns: List<|Sz|> //< each table's count of columns
    reads: Sz //< how many cell values the formulas read: the work, which a test holds to the cells
        //< It stops at the calculation's limit (`MAX_READS`).

impl Results
    fn at(r: Self@, u: Sz, row: Sz, column: Sz): Value //< the value of a data cell of table `u`
        index: = r.starts[u] + row * r.columns[u] + column
        return r.values[index]

fn calculate( //< calculates every data cell; the results live in `arena`
    //< The lists are made at their full size at once, so no cell's value is copied as they grow.
    //< **A function's arguments live in a scratch arena only while it runs** (`Calc.scratch`), so
    //< the memory kept grows with the cells, not with the cells each formula reads.
    doc: Document@,
    today: U8[], //< the date the document was opened, written `2026-10-23`
    arena: Arena$@,
    own: Own_functions@ = null, //< a person's own functions; none where the page has none
    most_reads: Sz = 0, //< the cell values the formulas may read; 0 for `MAX_READS`
        //< **Past it, each formula not yet calculated is `#LIMIT!`**, and so is each one under
        //< way, which carries it.
): Results
    $cells: Sz = 0
    for u in Range.asc(doc.tables.len)
        cells += doc.tables[u].rows.len * doc.tables[u].columns.len
    defer scratch: = Arena(64 * 1024)
    $c: = Calc::{ .doc = doc, .today = today, .own = own,
        .most_reads = MAX_READS if most_reads <= 0 else most_reads, .past_limit = false,
        .arena = arena, .scratch = scratch, .at = Positions(doc, arena),
        .results = Results::{ .values = List<|Value|>.new_with_cap(cells, arena),
        .starts = List<|Sz|>(arena), .columns = List<|Sz|>(arena), .reads = 0 },
        .states = List<|U8|>.new_with_cap(cells, scratch), .depth = 0, .deferring = false,
        .deferred = Spot::{ .table = 0, .row = 0, .column = 0 },
        .todo = List<|Spot|>(arena) }
    for u in Range.asc(doc.tables.len)
        t: = doc.tables[u]@
        c.results.starts.push(c.results.values.len)
        c.results.columns.push(t.columns.len)
        for _ in Range.asc(t.rows.len * t.columns.len)
            c.results.values.push(Value.failed(.syntax))
            c.states.push(UNVISITED)
    for u in Range.asc(doc.tables.len)
        for row in Range.asc(doc.tables[u].rows.len)
            for column in Range.asc(doc.tables[u].columns.len)
                settle(c@, Spot::{ .table = u, .row = row, .column = column })
    return c.results

typedef Ask_fn = fn(ctx: Void$@, name: U8[], args: Raw_args$@): Value //<
    //< The value of a person's function on its arguments, as the page answers it
    //< It sets `args.misread` where the arguments did not fit the function's parameters.
    //< **The page answers from what its worker has already worked out.** Where the answer has not
    //< come yet, the value is `…` (`Calc_error.pending`), and the page calculates again once it
    //< has.

struct Own_functions //< a person's own functions, which a calculation asks the page for
    names: U8[][] //< their names, as a formula calls them
    ask: Ask_fn
    ctx: Void$@ //< what `ask` is handed back
    unknown: Calc_error //< what a call to a name no file gives is, while a file's names are unknown
        //< `.blocked` while the person has not allowed a file, `.pending` while one builds, and
        //< `.syntax` once every file's names are known. **A name is unknown until its file
        //< builds**, so the first two hold for every name ksmd does not have.

impl Own_functions
    fn has(r: Self@, name: U8[]): Bool //< whether a formula's `name` is one of them
        for one in r.names
            if one.equals(name)
                return true
        return false

    fn called(r: Self@, t: Table@, cell: Cell, arena: Arena$@): U8[][] //<
        //< The names of these functions that a cell's formula calls, each once, in its order
        //< **Read as the calculator reads it**: a name followed by `(`, and never text in quotes.
        $cur: = Cursor::{ .piece = 0, .at = 0 }
        $got: = List<|U8[]|>(arena)
        $last: = Token(.end, 0, 0)
        for
            tok: = next(t, cell, cur@)
            if tok.kind == .end
                break
            if tok.kind == .open && last.kind == .name && r.has(last.text)
                $known: = false
                for one in got
                    known = known || one.equals(last.text)
                if !known
                    got.push(last.text)
            last = tok
        return got.slice()

struct Spot //< a data cell, by its table and place
    table: Sz
    row: Sz
    column: Sz

struct Calc //< the state of one calculation
    doc: Document@
    today: U8[] //< what `today()` gives
    own: Own_functions@ //< a person's own functions, or null
    most_reads: Sz //< the cell values the formulas may read (`MAX_READS`)
    past_limit: Bool //< a read was refused; every formula calculated from then on is `#LIMIT!`
    arena: Arena$@ //< holds the results, and the text that formulas make
    scratch: Arena$@ //< holds `states`, then the arguments of each function while it runs
        //< A call rewinds it as it returns (`Parser.function`), once `Parser.kept` has copied its
        //< text result out. `states` is made first, so no rewind frees it.
    at: Positions
    results: Results
    states: List<|U8|> //< each cell's progress, in the order of `results.values`
    depth: Sz //< how far the calculation under way has gone (`MAX_DEPTH`)
    deferring: Bool //< a chain went past `MAX_DEPTH` at `deferred`; what it found is dropped
    deferred: Spot
    todo: List<|Spot|> //< the cells `settle` has set aside, the last one calculated next

priv fn settle(c: Calc$@, spot: Spot) //<
    //< Calculates a cell, setting aside each chain too deep to follow at once
    //< The cell a chain was set aside at is calculated first, and the chain is tried again. A cell
    //< set aside while it already waits depends on itself: it is a cycle.
    c.todo.clear()
    c.todo.push(spot)
    for c.todo.len > 0
        top: = c.todo[c.todo.len - 1]
        c.deferring = false
        c.depth = 0
        _value: = value_at(c, top)
        if !c.deferring
            _done: = c.todo.pop()
            continue
        d: = c.deferred
        if waits(c.todo@, d)
            index: = slot(c, d)
            c.results.values[index] = Value.failed(.cycle)
            c.states[index] = SETTLED
            continue
        c.todo.push(d)

priv fn waits(todo: List<|Spot|>@, d: Spot): Bool //< whether a cell is already set aside
    for s in todo
        if s.table == d.table && s.row == d.row && s.column == d.column
            return true
    return false

priv fn slot(c: Calc@, s: Spot): Sz //< where a cell's value and state stand
    return c.results.starts[s.table] + s.row * c.results.columns[s.table] + s.column

priv fn value_at(c: Calc$@, s: Spot): Value //< a cell's value, calculated once
    index: = slot(c, s)
    state: = c.states[index]
    if state == SETTLED
        return c.results.values[index]
    if state == WORKING
        return Value.failed(.cycle)
    // Caution: **Once a chain is set aside, calculate nothing more in this pass.** Nothing it
    // finds is kept, and a range would calculate each later cell again.
    if c.deferring
        return Value.failed(.cycle)
    if c.depth >= MAX_DEPTH
        c.deferring = true
        c.deferred = s
        return Value.failed(.cycle)
    c.states[index] = WORKING
    c.depth += 1
    v: = cell_value(c, s)
    c.depth -= 1
    if c.deferring
        c.states[index] = UNVISITED
        return v
    c.results.values[index] = v
    c.states[index] = SETTLED
    return v

priv fn cell_value(c: Calc$@, s: Spot): Value //< what a cell holds, a formula calculated
    t: = c.doc.tables[s.table]@
    index: = t.at(s.row, s.column)
    cell: = t.cells[index]
    switch cell.kind
    case .empty
        return empty()
    case .text
        return text(cell.text)
    case .number
        return number_of(cell.text)
    case .date
        return date_value(date_of(cell.text).unwrap_or(0I64))
    case .formula
        if c.past_limit
            return Value.failed(.read_limit)
        $p: = Parser::{ .c = c, .t = t, .cell = cell, .cur = Cursor::{ .piece = 0, .at = 0 },
            .tok = Token(.end, 0, 0), .levels = 1, .wrong = false,
            .why = Value.failed(.syntax), .digits = false, .reads = -1, .origin = -1, .skipping = 0,
            .rows = Row_reading::{ .inside = false, .count = 0, .row = 0, .ranged = false,
            .shaped = true } }
        p.advance()
        v: = p.expression()
        if p.tok.kind != .end
            p.fail(.trailing, spelled(p.tok), -1)
        if p.wrong
            return p.why
        return number(0.0) if v.kind == .empty else v

struct Parser //< reads one formula's tokens and calculates as it reads
    c: Calc$@
    t: Table@ //< the table that holds the formula
    cell: Cell
    cur: Cursor
    tok: Token //< the next token, not yet taken
    levels: Sz //< how deeply the formula nests where it is read now (`MAX_LEVELS`)
    wrong: Bool //< the formula does not read; its value is `#SYNTAX!`
    why: Value //< the first reason it does not read (`fail`)
    digits: Bool //< the digit text of a function in `READ_DIGITS` is read now, outside other calls
    reads: Sz //< that function's place in `READ_DIGITS`
    origin: Sz //< the place of the cell the last operand was read from alone, or -1
        //< An operator's error of a wrong kind names that cell (`blame`).
    skipping: Sz //< above 0 while a part is read but not calculated; no cell is read then
        //< `and` and `or` skip their right side when the left one decides, and `if` the branch
        //< it does not take.
    rows: Row_reading //< how a range in a condition of `sum_if` is read

struct Row_reading //< a condition of `sum_if`, read once for each row of its values
    inside: Bool //< a condition is read now; elsewhere a range is no value
        //< Caution: **Do not take `count` 0 to mean outside.** A table with no data rows gives a
        //< condition over its whole columns no rows.
    count: Sz //< the rows of the values; every range in the condition must be that tall
    row: Sz //< the row read now, counted from each range's top
    ranged: Bool //< a range was read in the condition
    shaped: Bool //< every range read was one column wide and `count` rows tall

priv fn parser_cells(ctx: Void$@, piece: Sz): Value[] //<
    //< `Cells_fn` for the parser: the cells a reference alone names, taken when a function reads
    //< them; nothing while not calculating
    p: = Parser$@::ctx
    $xs: = List<|Value|>(p.c.scratch)
    if p.skipping > 0
        return xs.slice()
    area: = p.area_of(piece) catch
        xs.push(Value.because(.reference, .no_cell, "", -1))
        return xs.slice()
    for row in Range(area.rows.low, area.rows.high + 1, 1)
        for column in Range(area.columns.low, area.columns.high + 1, 1)
            v: = p.read(Spot::{ .table = area.table, .row = row, .column = column })
            xs.push(v)
            // Past the limit, the rest of a range of 100,000 cells is not walked either.
            if v.kind == .error && v.error == .read_limit
                return xs.slice()
    return xs.slice()

impl Parser
    fn advance(p: Self$@)
        p.tok = next(p.t, p.cell, p.cur@)

    fn fail(p: Self$@, why: Why, detail: U8[], at: Sz) //<
        //< Marks the formula as one that does not read, keeping the first reason
        if !p.wrong
            p.why = Value.because(.syntax, why, detail, at)
        p.wrong = true

    priv fn blame(p: Self$@, v: Value, left: Value, lo: Sz, ro: Sz): Value //<
        //< An operator's result; a wrong kind or a divisor of 0 names the cell it was read from
        //< `lo` and `ro` are the places of the cells the left and the right operands were read
        //< from alone, or -1.
        p.origin = -1
        if v.kind != .error || v.at() >= 0
            return v
        $at: = ro
        switch v.why
        case .text_in_arithmetic, .truth_in_arithmetic
            at = lo if left.kind == .text || left.kind == .boolean else ro
        case .joined_kind
            at =
                ro if left.kind == .text || left.kind == .empty || left.kind == .error else lo
        case .divide_by_zero, .not_a_condition {}
        default
            return v
        return v if at < 0 else Value.because(v.error, v.why, v.text, at)

    fn condition(p: Self$@, v: Value): Value //< a value as a condition (`truth`), named
        return p.blame(truth(v), empty(), -1, p.origin)

    priv fn enter(p: Self$@): Bool //< goes one level deeper; false past `MAX_LEVELS`
        if p.levels == MAX_LEVELS
            p.fail(.too_deep, "", -1)
            return false
        p.levels += 1
        p.c.depth += 1
        return true

    priv fn leave(p: Self$@)
        p.levels -= 1
        p.c.depth -= 1

    fn expression(p: Self$@): Value //< conditions joined by `and` and `or`; `and` binds first
        //< The right side of `or` is calculated only when the left one is false. Most formulas
        //< hold no word, so a comparison is read first, without the steps for `not` and `and`.
        $left: = p.negation() if p.is_word("not") else p.comparison()
        if p.tok.kind != .name
            return left
        left = p.conjunction(left)
        for p.is_word("or")
            p.advance()
            l: = p.condition(left)
            if l.kind == .error || l.boolean
                p.skipping += 1
                _right: = p.conjunction(p.negation())
                p.skipping -= 1
                left = l
            else
                left = p.condition(p.conjunction(p.negation()))
        return left

    priv fn conjunction(p: Self$@, first: Value): Value //< `first` and conditions joined by `and`
        //< The right side is calculated only when the left one is true.
        $left: = first
        for p.is_word("and")
            p.advance()
            l: = p.condition(left)
            if l.kind == .error || !l.boolean
                p.skipping += 1
                _right: = p.negation()
                p.skipping -= 1
                left = l
            else
                left = p.condition(p.negation())
        return left

    priv fn negation(p: Self$@): Value //< `not` before a condition, or a comparison
        if !p.is_word("not")
            return p.comparison()
        p.advance()
        if !p.enter()
            return Value.failed(.syntax)
        v: = p.condition(p.negation())
        p.leave()
        return v if v.kind == .error else boolean(!v.boolean)

    priv fn comparison(p: Self$@): Value //< two joins compared, or one join
        //< A second comparison does not read: `a < b < c` would compare `true` with `c`.
        left: = p.join()
        op: = p.tok.kind
        if !is_comparison(op)
            return left
        p.advance()
        right: = p.join()
        if is_comparison(p.tok.kind)
            p.fail(.two_comparisons, "", -1)
        return p.blame(compare(left, right, op), left, -1, -1)

    priv fn is_word(p: Self@, word: U8[]): Bool //< whether the next token is this word
        return p.tok.kind == .name && p.tok.text.equals(word)

    priv fn join(p: Self$@): Value //< sums joined as text by `&`, from the left
        $left: = p.sum()
        for p.tok.kind == .join
            p.advance()
            lo: = p.origin
            right: = p.sum()
            left = p.blame(joined(left, right, p.c.arena), left, lo, p.origin)
        return left

    priv fn sum(p: Self$@): Value //< terms joined by `+` and `-`, from the left
        $left: = p.product()
        for p.tok.kind == .plus || p.tok.kind == .minus
            plus: = p.tok.kind == .plus
            p.advance()
            lo: = p.origin
            right: = p.product()
            left = p.blame(arithmetic(left, right, .plus if plus else .minus), left, lo, p.origin)
        return left

    priv fn product(p: Self$@): Value //< factors joined by `*` and `/`, from the left
        $left: = p.unary()
        for p.tok.kind == .times || p.tok.kind == .divide
            kind: = p.tok.kind
            p.advance()
            lo: = p.origin
            right: = p.unary()
            left = p.blame(arithmetic(left, right, kind), left, lo, p.origin)
        return left

    priv fn unary(p: Self$@): Value //< `-` before a factor, or a factor
        if p.tok.kind != .minus
            return p.primary()
        p.advance()
        if !p.enter()
            return Value.failed(.syntax)
        v: = p.unary()
        p.leave()
        return p.blame(arithmetic(number(0.0), v, .minus), empty(), -1, p.origin)

    priv fn primary(p: Self$@): Value //< a number, text, a word, a cell, a bracket or a function
        //< Only the fields needed are taken from the token: a whole token is large to copy.
        p.origin = -1
        switch p.tok.kind
        case .number
            written: = p.tok.text
            p.advance()
            if v: = literal(written)
                // A literal in a base is the number, not digit text (`READ_DIGITS`).
                if p.digits
                    p.fail(.digit_literal, written, p.reads)
                return number(F64::v)
            return number_of(written)
        case .text
            quoted: = p.tok.text
            p.advance()
            if p.skipping > 0
                return empty()
            return text(unquoted(quoted, p.c.arena).unwrap_or(""))
        case .reference
            range: = p.tok.range
            piece: = p.tok.piece
            p.advance()
            if range
                if !p.rows.inside
                    p.fail(.range_alone, "", -1)
                    return Value.failed(.syntax)
                return p.row_of(piece)
            if p.skipping > 0
                return empty()
            return p.cell_of(piece)
        case .broken
            p.advance()
            return Value.because(.reference, .lost_reference, "", -1)
        case .open
            p.advance()
            if !p.enter()
                return Value.failed(.syntax)
            v: = p.expression()
            p.leave()
            p.expect(.close)
            return v
        case .name
            if p.is_word("true") || p.is_word("false")
                yes: = p.is_word("true")
                p.advance()
                return boolean(yes)
            v: = p.function()
            p.origin = -1
            return v
        case .bad
            p.fail(.bad_token, p.tok.text, -1)
            return Value.failed(.syntax)
        case .plus, .minus, .times, .divide, .join, .equal, .unequal, .less, .less_equal, .greater,
            .greater_equal, .close, .comma, .end
            p.fail(.unexpected, spelled(p.tok), -1)
            return Value.failed(.syntax)

    priv fn function(p: Self$@): Value //< a function's name, then its arguments in brackets
        name: = p.tok.text
        p.advance()
        if p.tok.kind != .open && !known(name) &&
            !(p.c.own != null && p.c.own.has(name))
            p.fail(.bare_word, name, -1)
        before: = p.wrong
        p.expect(.open)
        if !p.enter()
            return Value.failed(.syntax)
        // Another call's brackets end the digit text: `hex_to_dec(dec_to_hex(0xFF))` reads.
        outer: = p.digits
        p.digits = false
        $v: = Value.failed(.syntax)
        // **Eight forms stay here** (`FORMS` in `ksmd/calc/help.kspl`, in this order): `today`
        // reads the date the document opened, five choose which arguments are calculated,
        // `sum_product` pairs two ranges' cells, and `name` reads a column's name. Every other
        // function is an ordinary one, called through its table (`ksmd/calc/functions.kspl`).
        if name.equals(FORMS[0].name)
            v = date_value(date_of(p.c.today).unwrap_or(0I64))
        else if name.equals(FORMS[1].name)
            v = p.choice()
        else if name.equals(FORMS[2].name)
            v = p.conditional(.sum)
        else if name.equals(FORMS[3].name)
            v = p.conditional(.count)
        else if name.equals(FORMS[4].name)
            v = p.conditional(.average)
        else if name.equals(FORMS[5].name)
            v = p.lookup()
        else if name.equals(FORMS[6].name)
            v = p.sum_product()
        else if name.equals(FORMS[7].name)
            v = p.column_name()
        else
            mark: = p.c.scratch.save()
            v = p.kept(p.call(name))
            p.c.scratch.restore(mark)
        p.digits = outer
        p.leave()
        p.expect(.close)
        // A `,` or a `)` where another stood is an argument too many or too few.
        if !before && p.why.why == .missing && p.why.at() == 1
            p.why = Value.because(.syntax, .arguments, name, -1)
        return v

    priv fn call(p: Self$@, name: U8[]): Value //<
        //< An ordinary function, or a person's own, on its arguments, which go in `scratch`
        for i in Range.asc(READ_DIGITS.len)
            if name.equals(READ_DIGITS[i])
                p.digits = true
                p.reads = i
        $args: = p.raw_arguments()
        if got: = table.call(name, args@)
            // **An argument too many or too few is the formula's error**, not the value's.
            if args.misread || args.used < args.args.len
                p.fail(.arguments, name, -1)
            return args.named(got, name, .in_function)
        if p.c.own != null && p.c.own.has(name)
            if p.skipping > 0
                return empty()
            v: = p.c.own.ask(p.c.own.ctx, name, args@)
            if args.misread
                p.fail(.arguments, name, -1)
            return args.named(v, name, .own_function)
        if p.c.own != null && p.c.own.unknown != .syntax
            if p.skipping > 0
                return empty()
            return Value.because(p.c.own.unknown, .own_function, name, -1)
        p.fail(.unknown_function, name, -1)
        return Value.failed(.syntax)

    priv fn kept(p: Self$@, v: Value): Value //<
        //< A function's result, its text copied into `arena` before `scratch` rewinds
        //< Text past `MAX_TEXT` bytes is `#NUM!`, whichever function gave it, a person's included.
        if v.kind != .text
            return v
        if v.text.len > MAX_TEXT
            return Value.because(.not_finite, .text_too_long, "", -1)
        return text(p.c.arena.dup_str(v.text))

    priv fn choice(p: Self$@): Value //< `if(condition, then, else)`, after its `(`
        //< Only the branch taken is calculated, so an error or a cycle in the other never shows.
        //< An error in the condition is the result, and neither branch is calculated.
        c: = p.condition(p.expression())
        p.expect(.comma)
        then: = p.branch(c.kind == .boolean && c.boolean)
        p.expect(.comma)
        otherwise: = p.branch(c.kind == .boolean && !c.boolean)
        if c.kind == .error
            return c
        return then if c.boolean else otherwise

    fn branch(p: Self$@, taken: Bool): Value //< an argument, calculated only when taken
        if taken
            return p.expression()
        p.skipping += 1
        _skipped: = p.expression()
        p.skipping -= 1
        return empty()

    priv fn raw_arguments(p: Self$@): Raw_args //<
        //< A function's arguments up to its `)`, each calculated, for its table to convert
        //< **A reference alone is kept as its cells**, so `Value[]` can leave out the text in a
        //< range while a lone argument of text is an error. They are taken when read
        //< (`parser_cells`).
        $args: = List<|Raw_arg|>(p.c.scratch)
        if p.tok.kind != .close
            for
                args.push(p.raw_argument())
                p.digits = false // only the first argument is digit text
                if p.tok.kind != .comma
                    break
                p.advance()
        return Raw_args::{ .args = args.slice(), .used = 0, .misread = false,
            .row = parser_row if p.rows.inside else null, .take = parser_cells,
            .ctx = Void$@::p, .live = p.skipping == 0, .memory = p.c.scratch }

    priv fn raw_argument(p: Self$@): Raw_arg //< one argument: a reference alone, or a value
        if p.tok.kind == .reference || p.tok.kind == .broken
            cur: = p.cur
            tok: = p.tok
            p.advance()
            if p.tok.kind == .comma || p.tok.kind == .close
                return Raw_arg::{ .value = empty(), .cells = Value[]::{}, .is_cells = true,
                    .range = tok.kind == .reference && tok.range, .piece = tok.piece }
            p.cur = cur
            p.tok = tok
        return Raw_arg::{ .value = p.expression(), .cells = Value[]::{}, .is_cells = false,
            .range = false, .piece = -1 }

    priv fn cell_of(p: Self$@, index: Sz): Value //<
        //< The value of the one cell a piece names; `origin` becomes that cell
        if index < 0
            return Value.because(.reference, .no_cell, "", -1)
        piece: = p.t.pieces[index]
        u: = piece.table
        s: = Spot::{ .table = u, .row = p.c.at.of(u, piece.from.row),
            .column = p.c.at.of(u, piece.from.column) }
        v: = p.read(s)
        p.origin = slot(p.c, s)
        return v

    fn read(p: Self$@, s: Spot): Value //<
        //< A cell's value; an error in it becomes that cell's, so a reason can be followed back
        //< A cycle keeps its own reason: every cell on it shows `#CYCLE!` for the same cause. So
        //< does `#LIMIT!`, which every formula past the limit shows (`MAX_READS`).
        if p.c.results.reads >= p.c.most_reads
            p.c.past_limit = true
            return Value.failed(.read_limit)
        p.c.results.reads += 1
        v: = value_at(p.c, s)
        if v.kind != .error || v.error == .cycle || v.error == .read_limit
            return v
        return Value.because(v.error, .from_cell, "", slot(p.c, s))

    fn expect(p: Self$@, kind: Token_kind) //< takes a token of this kind, or marks it wrong
        if p.tok.kind != kind
            stood: = p.tok.kind == .comma || p.tok.kind == .close
            p.fail(.missing, spelled(Token(kind, 0, 0)), 1 if stood else 0)
            return
        p.advance()

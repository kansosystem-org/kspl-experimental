//< Calculates every table of a document: the value of each data cell, kept apart from the document
//< A formula is read from its pieces and calculated in the same pass; nothing is saved. Cells are
//< calculated in the order they depend on each other, so a formula can name a later row.
//< Calculation reads the model and one input, the date the document was opened, which `today()`
//< gives. It reads no clock, so the same model and date always give the same values.
//< Caution: **Calculate again after every edit.** `Results` holds the values of one moment, and
//< places that an edit has moved point at other cells.
import "ksmd/base/dates" { date_of }
import "ksmd/base/keyed" { Keyed }
import "ksmd/calc/args" { Raw_arg, Raw_args }
import "ksmd/calc/bases" { READ_DIGITS, literal }
import "ksmd/calc/forms" // `lookup`, `sum_product`, `column_name`, `conditional`, `area_of`
import "ksmd/calc/forms" { parser_row }
import "ksmd/calc/formula" { Cursor, Positions, Token, Token_kind, literal_decimal, next, spelled,
    unquoted }
import "ksmd/calc/functions" { power }
import "ksmd/calc/functions_table" as functions
import "ksmd/calc/help" { FORMS }
import "ksmd/calc/value" { MAX_TEXT, Calc_error, Value, Why, arithmetic, boolean, compare,
    date_value, empty, is_comparison, joined, number, number_of, operand, text, truth }
import "ksmd/model/model" { Cell, Document, Table }
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str } // and `text`, for the key of a call kept

const MAX_LEVELS: Sz = 64 //< how deeply one formula nests: brackets, functions, unary minus and
    //< `not`

const MAX_READS: Sz = 500000000 //< the cell values one calculation reads; past it, `#LIMIT!`
    //< A range read on every row multiplies the reads, so a crafted file of 8 MiB could take many
    //< minutes, and the page calculates after every edit. Two tables of 10,000 rows, each row
    //< taking a `sum_if` over a whole column, read 410 million: more than any document measured
    //< needs. **A call worked out once is one read when used again** (`Parser.shared`): reading it
    //< costs no more than reading one cell.

priv const MAX_DEPTH: Sz = 256 //< the cells and levels one calculation passes through at a time
    //< A deeper chain is set aside and its deepest cell calculated first (`settle`), so a running
    //< total down 10,000 rows calculates without running out of stack.
priv const UNVISITED: U8 = 0U8
priv const WORKING: U8 = 1U8 //< being calculated; reaching it again is a cycle
priv const SETTLED: U8 = 2U8

fn known(name: U8[]): Bool //< whether ksmd has a function of this name, so a person's cannot
    for form in FORMS
        if form.name.equals(name)
            return true
    for one in functions.NAMES
        if one.equals(name)
            return true
    return false

struct Results //< the value of every data cell of every table, at one moment
    values: List<|Value|> //< each table's data cells from `starts`, row by row
    starts: List<|Sz|>
    columns: List<|Sz|> //< each table's count of columns
    reads: Sz //< how many cell values the formulas read: the work, which a test holds to the cells
        //< It stops at the calculation's limit (`MAX_READS`).
    looks: Sz //< how many taken values `sum_if` and its kin check for an error: work beside the
        //< reads, which a test holds to grow with them

impl Results
    fn at(r: Self@, table: Sz, row: Sz, column: Sz): Value //<
        //< the value of a data cell of the table at `table`
        index: = r.starts[table] + row * r.columns[table] + column
        return r.values[index]

fn calculate( //< calculates every data cell; the results live in `arena`
    //< The lists are made at their full size at once, so no cell's value is copied as they grow.
    //< **A function's arguments live in a scratch arena only while it runs** (`Calc.scratch`), so
    //< the memory kept grows with the cells, not with the cells each formula reads.
    doc: Document@,
    today: U8[], //< the date the document was opened, written `2026-10-23`
    arena: Arena$@,
    own: Own_functions@ = null, //< a person's own functions; none where the page has none
    most_reads: Sz = 0, //< the cell values the formulas may read; 0 for `MAX_READS`
        //< **Past it, each formula not yet calculated is `#LIMIT!`**, and so is each one under
        //< way, which carries it.
): Results
    $cells: Sz = 0
    for table in Range.asc(doc.tables.len)
        cells += doc.tables[table].rows.len * doc.tables[table].columns.len
    defer scratch: = Arena(64 * 1024)
    defer kept: = Arena(64 * 1024)
    $c: = Calc::{ .doc = doc, .today = today, .own = own, .kept = kept,
        .shared = Keyed<|Shared|>(kept), .most_reads = MAX_READS if most_reads <= 0 else most_reads,
        .past_limit = false, .arena = arena, .scratch = scratch, .at = Positions(doc, arena),
        .results = Results::{ .values = List<|Value|>.new_with_cap(cells, arena),
        .starts = List<|Sz|>(arena), .columns = List<|Sz|>(arena), .reads = 0, .looks = 0 },
        .states = List<|U8|>.new_with_cap(cells, scratch), .depth = 0, .deferring = false,
        .deferred = Spot::{ .table = 0, .row = 0, .column = 0 },
        .todo = List<|Spot|>(arena) }
    for table in Range.asc(doc.tables.len)
        t: = doc.tables[table]@
        c.results.starts.push(c.results.values.len)
        c.results.columns.push(t.columns.len)
        for _ in Range.asc(t.rows.len * t.columns.len)
            c.results.values.push(Value.failed(.syntax))
            c.states.push(UNVISITED)
    for table in Range.asc(doc.tables.len)
        for row in Range.asc(doc.tables[table].rows.len)
            for column in Range.asc(doc.tables[table].columns.len)
                settle(c@, Spot::{ .table = table, .row = row, .column = column })
    return c.results

typedef Ask_fn = fn(ctx: Void$@, name: U8[], args: Raw_args$@): Value //<
    //< The value of a person's function on its arguments, as the page answers it
    //< It sets `args.misread` where the arguments did not fit the function's parameters.
    //< **The page answers from what its worker has already worked out.** Where the answer has not
    //< come yet, the value is `…` (`Calc_error.pending`), and the page calculates again once it
    //< has.

struct Own_functions //< a person's own functions, which a calculation asks the page for
    names: U8[][] //< their names, as a formula calls them
    ask: Ask_fn
    ctx: Void$@ //< what `ask` is handed back
    unknown: Calc_error //< what a call to a name no file gives is, while a file's names are unknown
        //< `.blocked` while the person has not allowed a file, `.pending` while one builds, and
        //< `.syntax` once every file's names are known. **A name is unknown until its file
        //< builds**, so the first two hold for every name ksmd does not have.

impl Own_functions
    fn has(r: Self@, name: U8[]): Bool //< whether a formula's `name` is one of them
        for one in r.names
            if one.equals(name)
                return true
        return false

    fn called(r: Self@, table: Table@, cell: Cell, arena: Arena$@): U8[][] //<
        //< The names of these functions that a cell's formula calls, each once, in its order
        //< **Read as the calculator reads it**: a name followed by `(`, and never text in quotes.
        $cur: = Cursor::{ .piece = 0, .at = 0 }
        $got: = List<|U8[]|>(arena)
        $last: = Token(.end, 0, 0)
        for
            tok: = next(table, cell, cur@)
            if tok.kind == .end
                break
            if tok.kind == .open && last.kind == .name && r.has(last.text)
                $known: = false
                for one in got
                    known = known || one.equals(last.text)
                if !known
                    got.push(last.text)
            last = tok
        return got.slice()

struct Spot //< a data cell, by its table and place
    table: Sz
    row: Sz
    column: Sz

struct Calc //< the state of one calculation
    doc: Document@
    today: U8[] //< what `today()` gives
    own: Own_functions@ //< a person's own functions, or null
    most_reads: Sz //< the cell values the formulas may read (`MAX_READS`)
    past_limit: Bool //< a read was refused; every formula calculated from then on is `#LIMIT!`
    arena: Arena$@ //< holds the results, and the text that formulas make
    scratch: Arena$@ //< holds `states`, then the arguments of each function while it runs
        //< A call rewinds it as it returns (`Parser.function`), once `Parser.kept` has copied its
        //< text result out. `states` is made first, so no rewind frees it.
    at: Positions
    results: Results
    states: List<|U8|> //< each cell's progress, in the order of `results.values`
    depth: Sz //< how far the calculation under way has gone (`MAX_DEPTH`)
    deferring: Bool //< a chain went past `MAX_DEPTH` at `deferred`; what it found is dropped
    deferred: Spot
    todo: List<|Spot|> //< the cells `settle` has set aside, the last one calculated next
    kept: Arena$@ //< holds `shared` and its keys, for this calculation alone
    shared: Keyed<|Shared|> //< the calls whose answer is known, by their function and cells
        //< (`Parser.shared`)

struct Shared //< a call's answer, kept for the same call on the same cells
    value: Value //< its text, if any, stands in `Calc.arena`
    misread: Bool //< its arguments did not fit the function: each formula that makes it fails

priv fn settle(calc: Calc$@, spot: Spot) //<
    //< Calculates a cell, setting aside each chain too deep to follow at once
    //< The cell a chain was set aside at is calculated first, and the chain is tried again. A cell
    //< set aside while it already waits depends on itself: it is a cycle.
    calc.todo.clear()
    calc.todo.push(spot)
    for calc.todo.len > 0
        top: = calc.todo[calc.todo.len - 1]
        calc.deferring = false
        calc.depth = 0
        _value: = value_at(calc, top)
        if !calc.deferring
            _done: = calc.todo.pop()
            continue
        d: = calc.deferred
        if waits(calc.todo@, d)
            index: = slot(calc, d)
            calc.results.values[index] = Value.failed(.cycle)
            calc.states[index] = SETTLED
            continue
        calc.todo.push(d)

priv fn waits(todo: List<|Spot|>@, spot: Spot): Bool //< whether a cell is already set aside
    for s in todo
        if s.table == spot.table && s.row == spot.row && s.column == spot.column
            return true
    return false

priv fn slot(calc: Calc@, spot: Spot): Sz //< where a cell's value and state stand
    return calc.results.starts[spot.table] + spot.row * calc.results.columns[spot.table] + spot
        .column

priv fn value_at(calc: Calc$@, spot: Spot): Value //< a cell's value, calculated once
    index: = slot(calc, spot)
    state: = calc.states[index]
    if state == SETTLED
        return calc.results.values[index]
    if state == WORKING
        return Value.failed(.cycle)
    // Caution: **Once a chain is set aside, calculate nothing more in this pass.** Nothing it
    // finds is kept, and a range would calculate each later cell again.
    if calc.deferring
        return Value.failed(.cycle)
    if calc.depth >= MAX_DEPTH
        calc.deferring = true
        calc.deferred = spot
        return Value.failed(.cycle)
    calc.states[index] = WORKING
    calc.depth += 1
    v: = cell_value(calc, spot)
    calc.depth -= 1
    if calc.deferring
        calc.states[index] = UNVISITED
        return v
    calc.results.values[index] = v
    calc.states[index] = SETTLED
    return v

priv fn cell_value(calc: Calc$@, spot: Spot): Value //< what a cell holds, a formula calculated
    t: = calc.doc.tables[spot.table]@
    index: = t.at(spot.row, spot.column)
    cell: = t.cells[index]
    switch cell.kind
    case .empty
        return empty()
    case .text
        return text(cell.text)
    case .number
        return number_of(cell.text)
    case .date
        return date_value(date_of(cell.text).unwrap_or(0I64))
    case .formula
        if calc.past_limit
            return Value.failed(.read_limit)
        $p: = Parser::{ .c = calc, .t = t, .cell = cell, .cur = Cursor::{ .piece = 0, .at = 0 },
            .tok = Token(.end, 0, 0), .levels = 1, .wrong = false,
            .why = Value.failed(.syntax), .digits = false, .reads = -1, .origin = -1, .skipping = 0,
            .rows = Row_reading::{ .inside = false, .count = 0, .row = 0, .ranged = false,
            .shaped = true } }
        p.advance()
        v: = p.expression()
        if p.tok.kind != .end && !p.stray()
            p.fail(.trailing, spelled(p.tok), -1)
        if p.wrong
            return p.why
        return number(0.0) if v.kind == .empty else v

struct Parser //< reads one formula's tokens and calculates as it reads
    c: Calc$@
    t: Table@ //< the table that holds the formula
    cell: Cell
    cur: Cursor
    tok: Token //< the next token, not yet taken
    levels: Sz //< how deeply the formula nests where it is read now (`MAX_LEVELS`)
    wrong: Bool //< the formula does not read; its value is `#SYNTAX!`
    why: Value //< the first reason it does not read (`fail`)
    digits: Bool //< the digit text of a function in `READ_DIGITS` is read now, outside other calls
    reads: Sz //< that function's place in `READ_DIGITS`
    origin: Sz //< the place of the cell the last operand was read from alone, or -1
        //< An operator's error of a wrong kind names that cell (`blame`).
    skipping: Sz //< above 0 while a part is read but not calculated; no cell is read then
        //< `and` and `or` skip their right side when the left one decides, and `if` the branch
        //< it does not take.
    rows: Row_reading //< how a range in a condition of `sum_if` is read

struct Row_reading //< a condition of `sum_if`, read once for each row of its values
    inside: Bool //< a condition is read now; elsewhere a range is no value
        //< Caution: **Do not take `count` 0 to mean outside.** A table with no data rows gives a
        //< condition over its whole columns no rows.
    count: Sz //< the rows of the values; every range in the condition must be that tall
    row: Sz //< the row read now, counted from each range's top
    ranged: Bool //< a range was read in the condition
    shaped: Bool //< every range read was one column wide and `count` rows tall

priv fn raised_to(base: Value, exponent: Value): Value //< `base ^ exponent`, by `power`'s rules
    //< `0^-1` is `#DIV/0!`, and `(-1)^0.5` is `#NUM!`, as `power(0, -1)` and `power(-1, 0.5)` are.
    //< The left error comes first, and a value of another kind is `#VALUE!`, as in `*`. **Text on
    //< the left is that error too**, before an error on the right: `operand` passes an error on.
    a: = operand(base)
    if a.kind == .error
        return a
    b: = operand(exponent)
    if b.kind == .error
        return b
    r: = power(a.number, b.number) catch e
        return Value.because(e, .in_function, "^", -1)
    return number(r)

priv fn parser_cells(ctx: Void$@, piece: Sz): Value[] //<
    //< `Cells_fn` for the parser: the cells a reference alone names, taken when a function reads
    //< them; nothing while not calculating
    p: = Parser$@::ctx
    $xs: = List<|Value|>(p.c.scratch)
    if p.skipping > 0
        return xs.slice()
    area: = p.area_of(piece) catch
        xs.push(Value.because(.reference, .no_cell, "", -1))
        return xs.slice()
    for row in Range(area.rows.low, area.rows.high + 1, 1)
        for column in Range(area.columns.low, area.columns.high + 1, 1)
            v: = p.read(Spot::{ .table = area.table, .row = row, .column = column })
            xs.push(v)
            // Past the limit, or in a pass set aside, the rest of a range of 100,000 cells is not
            // walked either.
            if p.c.deferring || (v.kind == .error && v.error == .read_limit)
                return xs.slice()
    return xs.slice()

impl Parser
    fn advance(r: Self$@)
        r.tok = next(r.t, r.cell, r.cur@)

    fn fail(r: Self$@, why: Why, detail: U8[], at: Sz) //<
        //< Marks the formula as one that does not read, keeping the first reason
        if !r.wrong
            r.why = Value.because(.syntax, why, detail, at)
        r.wrong = true

    priv fn blame(r: Self$@, value: Value, left: Value, right: Value, lo: Sz, ro: Sz): Value //<
        //< An operator's result; a wrong kind or a divisor of 0 names the cell it was read from
        //< `lo` and `ro` are the places of the cells the left and the right operands were read
        //< from alone, or -1. **An error an operand already held is carried as it is**: the
        //< operator did not make it, so `A1/0+B1` must not name B1 as the divisor.
        r.origin = -1
        if value.kind != .error || value.at() >= 0 || left.kind == .error
            return value
        $on_left: = false
        switch value.why
        case .text_in_arithmetic, .truth_in_arithmetic
            on_left = left.kind == .text || left.kind == .boolean
        case .joined_kind
            on_left = left.kind != .text && left.kind != .empty
        case .divide_by_zero, .not_a_condition {}
        default
            return value
        // The left operand is checked first, so an error about it stands even where the right
        // one holds an error.
        if !on_left && right.kind == .error
            return value
        at: = lo if on_left else ro
        return (value if at < 0
            else Value.because(value.error, value.why, value.text, at))

    fn condition(r: Self$@, value: Value): Value //< a value as a condition (`truth`), named
        return r.blame(truth(value), empty(), value, -1, r.origin)

    priv fn enter(r: Self$@): Bool //< goes one level deeper; false past `MAX_LEVELS`
        if r.levels == MAX_LEVELS
            r.fail(.too_deep, "", -1)
            return false
        r.levels += 1
        r.c.depth += 1
        return true

    priv fn leave(r: Self$@)
        r.levels -= 1
        r.c.depth -= 1

    fn expression(r: Self$@): Value //< conditions joined by `and` and `or`; `and` binds first
        //< The right side of `or` is calculated only when the left one is false. Most formulas
        //< hold no word, so a comparison is read first, without the steps for `not` and `and`.
        $left: = r.negation() if r.is_word("not") else r.comparison()
        if r.tok.kind != .name
            return left
        left = r.conjunction(left)
        for r.is_word("or")
            r.advance()
            l: = r.condition(left)
            if l.kind == .error || l.boolean
                r.skipping += 1
                _right: = r.conjunction(r.negation())
                r.skipping -= 1
                left = l
            else
                left = r.condition(r.conjunction(r.negation()))
        return left

    priv fn conjunction(r: Self$@, first: Value): Value //< `first` and conditions joined by `and`
        //< The right side is calculated only when the left one is true.
        $left: = first
        for r.is_word("and")
            r.advance()
            l: = r.condition(left)
            if l.kind == .error || !l.boolean
                r.skipping += 1
                _right: = r.negation()
                r.skipping -= 1
                left = l
            else
                left = r.condition(r.negation())
        return left

    priv fn negation(r: Self$@): Value //< `not` before a condition, or a comparison
        if !r.is_word("not")
            return r.comparison()
        r.advance()
        if !r.enter()
            return Value.failed(.syntax)
        v: = r.condition(r.negation())
        r.leave()
        return v if v.kind == .error else boolean(!v.boolean)

    priv fn comparison(r: Self$@): Value //< two joins compared, or one join
        //< A second comparison does not read: `a < b < c` would compare `true` with `c`.
        left: = r.join()
        op: = r.tok.kind
        if !is_comparison(op)
            return left
        r.advance()
        right: = r.join()
        if is_comparison(r.tok.kind)
            r.fail(.two_comparisons, "", -1)
        return r.blame(compare(left, right, op), left, right, -1, -1)

    priv fn is_word(r: Self@, word: U8[]): Bool //< whether the next token is this word
        return r.tok.kind == .name && r.tok.text.equals(word)

    priv fn join(r: Self$@): Value //< sums joined as text by `&`, from the left
        $left: = r.sum()
        for r.tok.kind == .join
            r.advance()
            lo: = r.origin
            right: = r.sum()
            left = r.blame(joined(left, right, r.c.arena), left, right, lo, r.origin)
        return left

    priv fn sum(r: Self$@): Value //< terms joined by `+` and `-`, from the left
        $left: = r.product()
        for r.tok.kind == .plus || r.tok.kind == .minus
            plus: = r.tok.kind == .plus
            r.advance()
            lo: = r.origin
            right: = r.product()
            left = r.blame(arithmetic(left, right, .plus if plus else .minus), left, right, lo,
                r.origin)
        return left

    priv fn product(r: Self$@): Value //< powers joined by `*` and `/`, from the left
        $left: = r.raised()
        for r.tok.kind == .times || r.tok.kind == .divide
            kind: = r.tok.kind
            r.advance()
            lo: = r.origin
            right: = r.raised()
            left = r.blame(arithmetic(left, right, kind), left, right, lo, r.origin)
        return left

    priv fn raised(r: Self$@): Value //< a percentage, or two joined by `^`
        //< **`-2^2` and `2^3^2` do not read**: Excel's answers, 4 and 64, are not those of
        //< mathematics, -4 and 512. Either answer would surprise someone, so brackets must say.
        //< A minus on the power reads: `2^-1`.
        minus: = r.tok.kind == .minus
        $left: = r.percentage()
        $first: = true
        for r.tok.kind == .power
            if !first
                r.fail(.two_powers, "", -1)
            else if minus
                r.fail(.minus_power, "", -1)
            first = false
            r.advance()
            lo: = r.origin
            right: = r.percentage()
            left = r.blame(raised_to(left, right), left, right, lo, r.origin)
        return left

    priv fn percentage(r: Self$@): Value //< a factor and each `%` after it, which divides by 100
        //< Unary minus binds tighter than `%`, as in Excel: `-5%` is `(-5)%`.
        $v: = r.unary()
        for r.tok.kind == .percent
            r.advance()
            lo: = r.origin
            v = r.blame(arithmetic(v, number(100.0), .divide), v, empty(), lo, -1)
        return v

    priv fn unary(r: Self$@): Value //< `-` before a factor, or a factor
        if r.tok.kind != .minus
            return r.primary()
        r.advance()
        if !r.enter()
            return Value.failed(.syntax)
        v: = r.unary()
        r.leave()
        return r.blame(arithmetic(number(0.0), v, .minus), empty(), v, -1, r.origin)

    priv fn primary(r: Self$@): Value //< a number, text, a word, a cell, a bracket or a function
        //< Only the fields needed are taken from the token: a whole token is large to copy.
        r.origin = -1
        switch r.tok.kind
        case .number
            written: = r.tok.text
            r.advance()
            if v: = literal(written)
                // A literal in a base is the number, not digit text (`READ_DIGITS`).
                if r.digits
                    r.fail(.digit_literal, written, r.reads)
                return number(F64::v)
            defer $plain: = Str()
            return number_of(literal_decimal(written, plain@))
        case .text
            quoted: = r.tok.text
            r.advance()
            if r.skipping > 0
                return empty()
            return text(unquoted(quoted, r.c.arena))
        case .reference
            range: = r.tok.range
            piece: = r.tok.piece
            r.advance()
            if range
                if !r.rows.inside
                    r.fail(.range_alone, "", -1)
                    return Value.failed(.syntax)
                return r.row_of(piece)
            if r.skipping > 0
                return empty()
            return r.cell_of(piece)
        case .broken
            r.advance()
            return Value.because(.reference, .lost_reference, "", -1)
        case .open
            r.advance()
            if !r.enter()
                return Value.failed(.syntax)
            v: = r.expression()
            r.leave()
            r.expect(.close)
            return v
        case .name
            if r.is_word("true") || r.is_word("false")
                yes: = r.is_word("true")
                r.advance()
                return boolean(yes)
            v: = r.function()
            r.origin = -1
            return v
        case .bad
            r.fail(.bad_token, r.tok.text, -1)
            return Value.failed(.syntax)
        case .plus, .minus, .times, .divide, .power, .percent, .join, .equal, .unequal, .less,
            .less_equal, .greater, .greater_equal, .close, .comma, .end
            r.fail(.unexpected, spelled(r.tok), -1)
            return Value.failed(.syntax)

    priv fn function(r: Self$@): Value //< a function's name, then its arguments in brackets
        name: = r.tok.text
        r.advance()
        if r.tok.kind != .open && !known(name) &&
            !(r.c.own != null && r.c.own.has(name))
            r.fail(.bare_word, name, -1)
        before: = r.wrong
        r.expect(.open)
        if !r.enter()
            return Value.failed(.syntax)
        // Another call's brackets end the digit text: `hex_to_dec(dec_to_hex(0xFF))` reads.
        outer: = r.digits
        r.digits = false
        $v: = Value.failed(.syntax)
        // **Eight forms stay here** (`FORMS` in `ksmd/calc/help.kspl`, in this order): `today`
        // reads the date the document opened, five choose which arguments are calculated,
        // `sum_product` pairs two ranges' cells, and `name` reads a column's name. Every other
        // function is an ordinary one, called through its table (`ksmd/calc/functions.kspl`).
        if name.equals(FORMS[0].name)
            v = date_value(date_of(r.c.today).unwrap_or(0I64))
        else if name.equals(FORMS[1].name)
            v = r.choice()
        else if name.equals(FORMS[2].name)
            v = r.conditional(.sum)
        else if name.equals(FORMS[3].name)
            v = r.conditional(.count)
        else if name.equals(FORMS[4].name)
            v = r.conditional(.average)
        else if name.equals(FORMS[5].name)
            v = r.lookup()
        else if name.equals(FORMS[6].name)
            v = r.sum_product()
        else if name.equals(FORMS[7].name)
            v = r.column_name()
        else
            mark: = r.c.scratch.save()
            v = r.kept(r.call(name))
            r.c.scratch.restore(mark)
        r.digits = outer
        r.leave()
        r.expect(.close)
        // A `,` or a `)` where another stood is an argument too many or too few.
        if !before && r.why.why == .missing && r.why.at() == 1
            r.why = Value.because(.syntax, .arguments, name, -1)
        return v

    priv fn call(r: Self$@, name: U8[]): Value //<
        //< An ordinary function, or a person's own, on its arguments, which go in `scratch`
        for i in Range.asc(READ_DIGITS.len)
            if name.equals(READ_DIGITS[i])
                r.digits = true
                r.reads = i
        $args: = r.raw_arguments()
        key: = r.shared_key(name, args@)
        if key.len > 0
            if hit: = r.c.shared.get(key)
                return r.shared(hit, name)
        if got: = functions.call(name, args@)
            // **An argument too many or too few is the formula's error**, not the value's.
            misread: = args.misread || args.used < args.args.len
            if misread
                r.fail(.arguments, name, -1)
            v: = args.named(got, name, .in_function)
            if key.len > 0 && r.settled(args@)
                r.c.shared
                    .set(r.c.kept.dup_str(key),
                    Shared::{ .value = r.kept(v), .misread = misread })
            return v
        if r.c.own != null && r.c.own.has(name)
            if r.skipping > 0
                return empty()
            v: = r.c.own.ask(r.c.own.ctx, name, args@)
            if args.misread
                r.fail(.arguments, name, -1)
            return args.named(v, name, .own_function)
        if r.c.own != null && r.c.own.unknown != .syntax
            if r.skipping > 0
                return empty()
            return Value.because(r.c.own.unknown, .own_function, name, -1)
        r.fail(.unknown_function, name, -1)
        return Value.failed(.syntax)

    priv fn shared_key(r: Self$@, name: U8[], args: Raw_args@): U8[] //<
        //< What names a call to one of ksmd's functions whose every argument is a reference alone:
        //< the function and the cells; empty for any other call
        //< **Such a call gives the same answer wherever it stands**, as no function reads anything
        //< but its arguments. So a share of a total, `=A1/sum(A$1:A$10000)` on every row, adds the
        //< column once, not once per row. A call read but not calculated, and a range read row by
        //< row in a condition, are never kept.
        if args.args.len == 0 || r.skipping > 0 || r.rows.inside
            return ""
        key: = r.c.scratch.text()
        key.s(name)
        for arg in args.args
            if !arg.is_cells
                return ""
            area: = r.area_of(arg.piece) catch
                return ""
            key.s(" \{arg.range\} \{area.table\} \{area.rows.low\} \{area.rows.high\} ")
                .s("\{area.columns.low\} \{area.columns.high\}")
        return key.take()

    priv fn settled(r: Self@, args: Raw_args@): Bool //<
        //< Whether every cell of the call's references holds its final value, so the answer holds
        //< for the rest of the calculation
        //< **A cell's value never changes once settled.** One read as a cycle, as `#LIMIT!`, or in
        //< a pass set aside is not settled yet, and a call that read it is not kept.
        if r.c.deferring || r.c.past_limit
            return false
        for arg in args.args
            area: = r.area_of(arg.piece) catch
                return false
            for row in Range(area.rows.low, area.rows.high + 1, 1)
                for column in Range(area.columns.low, area.columns.high + 1, 1)
                    index: =
                        slot(r.c,
                        Spot::{ .table = area.table, .row = row, .column = column })
                    if r.c.states[index] != SETTLED
                        return false
        return true

    priv fn shared(r: Self$@, hit: Shared, name: U8[]): Value //<
        //< A call's kept answer, which counts as one read (`MAX_READS`)
        if r.c.deferring
            return Value.failed(.cycle)
        if r.c.results.reads >= r.c.most_reads
            r.c.past_limit = true
            return Value.failed(.read_limit)
        r.c.results.reads += 1
        if hit.misread
            r.fail(.arguments, name, -1)
        return hit.value

    priv fn kept(r: Self$@, value: Value): Value //<
        //< A function's result, its text copied into `arena` before `scratch` rewinds
        //< Text past `MAX_TEXT` bytes is `#NUM!`, whichever function gave it, a person's included.
        if value.kind != .text
            return value
        if value.text.len > MAX_TEXT
            return Value.because(.not_finite, .text_too_long, "", -1)
        return text(r.c.arena.dup_str(value.text))

    priv fn choice(r: Self$@): Value //< `if(condition, then, else)`, after its `(`
        //< Only the branch taken is calculated, so an error or a cycle in the other never shows.
        //< An error in the condition is the result, and neither branch is calculated.
        c: = r.condition(r.expression())
        r.expect(.comma)
        then: = r.branch(c.kind == .boolean && c.boolean)
        r.expect(.comma)
        otherwise: = r.branch(c.kind == .boolean && !c.boolean)
        if c.kind == .error
            return c
        return then if c.boolean else otherwise

    fn branch(r: Self$@, taken: Bool): Value //< an argument, calculated only when taken
        if taken
            return r.expression()
        r.skipping += 1
        _skipped: = r.expression()
        r.skipping -= 1
        return empty()

    priv fn raw_arguments(r: Self$@): Raw_args //<
        //< A function's arguments up to its `)`, each calculated, for its table to convert
        //< **A reference alone is kept as its cells**, so `Value[]` can leave out the text in a
        //< range while a lone argument of text is an error. They are taken when read
        //< (`parser_cells`).
        $args: = List<|Raw_arg|>(r.c.scratch)
        if r.tok.kind != .close
            for
                args.push(r.raw_argument())
                r.digits = false // only the first argument is digit text
                if r.tok.kind != .comma
                    break
                r.advance()
        return Raw_args::{ .args = args.slice(), .used = 0, .misread = false,
            .row = parser_row if r.rows.inside else null, .take = parser_cells,
            .ctx = Void$@::r, .live = r.skipping == 0, .memory = r.c.scratch }

    priv fn raw_argument(r: Self$@): Raw_arg //< one argument: a reference alone, or a value
        if r.tok.kind == .reference || r.tok.kind == .broken
            cur: = r.cur
            tok: = r.tok
            r.advance()
            if r.tok.kind == .comma || r.tok.kind == .close
                return Raw_arg::{ .value = empty(), .cells = Value[]::{}, .is_cells = true,
                    .range = tok.kind == .reference && tok.range, .piece = tok.piece }
            r.cur = cur
            r.tok = tok
        return Raw_arg::{ .value = r.expression(), .cells = Value[]::{}, .is_cells = false,
            .range = false, .piece = -1 }

    priv fn cell_of(r: Self$@, index: Sz): Value //<
        //< The value of the one cell a piece names; `origin` becomes that cell
        if index < 0
            return Value.because(.reference, .no_cell, "", -1)
        piece: = r.t.pieces[index]
        table: = piece.table
        s: = Spot::{ .table = table, .row = r.c.at.of(table, piece.from.row),
            .column = r.c.at.of(table, piece.from.column) }
        v: = r.read(s)
        r.origin = slot(r.c, s)
        return v

    fn read(r: Self$@, spot: Spot): Value //<
        //< A cell's value; an error in it becomes that cell's, so a reason can be followed back
        //< A cycle keeps its own reason: every cell on it shows `#CYCLE!` for the same cause. So
        //< does `#LIMIT!`, which every formula past the limit shows (`MAX_READS`).
        // **A pass set aside reads nothing, and counts nothing**: its results are dropped, and a
        // range read on each row of a deep chain counted the whole range again in every pass.
        if r.c.deferring
            return Value.failed(.cycle)
        if r.c.results.reads >= r.c.most_reads
            r.c.past_limit = true
            return Value.failed(.read_limit)
        r.c.results.reads += 1
        v: = value_at(r.c, spot)
        if v.kind != .error || v.error == .cycle || v.error == .read_limit
            return v
        return Value.because(v.error, .from_cell, "", slot(r.c, spot))

    fn stray(r: Self$@): Bool //<
        //< Whether the next token starts nothing, marking the formula wrong for it
        //< **The token is the fault, not what was wanted in its place**: `=2~3` stops at `~`, and
        //< no operator is missing before it.
        if r.tok.kind != .bad
            return false
        r.fail(.bad_token, r.tok.text, -1)
        return true

    fn expect(r: Self$@, kind: Token_kind) //< takes a token of this kind, or marks it wrong
        if r.tok.kind == kind
            r.advance()
            return
        if r.stray()
            return
        stood: = r.tok.kind == .comma || r.tok.kind == .close
        r.fail(.missing, spelled(Token(kind, 0, 0)), 1 if stood else 0)

//< The forms the calculator reads itself, beside the reader in `calc.kspl`: `lookup`,
//< `sum_product`, `name`, and the three conditional totals `sum_if`, `count_if` and `average_if`
//< Each chooses which of its arguments are calculated, or reads a range cell by cell, so none is
//< an ordinary function of `functions.kspl`. `FORMS` in `help.kspl` lists them.
import "ksmd/calc/calc" { Parser, Row_reading, Spot }
import "ksmd/calc/functions" as fns
import "ksmd/calc/help" { FORMS }
import "ksmd/calc/value" { Calc_error, Value, Why, empty, equal_keys, number, text }
import "std/ds" { List }

fn parser_row(ctx: Void$@, piece: Sz): Value //< `Row_fn` for the parser reading a condition
    p: = Parser$@::ctx
    return p.row_of(piece)

enum Fold_kind //< what `sum_if`, `count_if` or `average_if` makes of its values
    sum
    count
    average

impl Parser
    fn lookup(r: Self$@): Value //<
        //< `lookup(key, keys, values, otherwise)` after its `(`: the value beside the first key
        //< that equals `key`
        //< `keys` and `values` are ranges of one column, or of one row, as long as each other. Text
        //< equals text without regard to case, as the filter and the sort compare it. Where no key
        //< equals it, the result is `otherwise`, which is calculated only then, as `if` does. A key
        //< cell holding an error is passed over, but `#CYCLE!` before the match is the result.
        key: = r.expression()
        r.expect(.comma)
        keys: = r.range_piece()
        r.expect(.comma)
        values: = r.range_piece()
        r.expect(.comma)
        if r.skipping > 0 || r.wrong
            _skipped: = r.branch(false)
            return empty()
        $found: Value? = .none
        $broken: = Value.failed(.syntax)
        $failed: = false
        if key.kind == .error
            broken = key
            failed = true
        a: = r.area_of(keys)
        b: = r.area_of(values)
        if !failed && (a.is_none() || b.is_none())
            broken = Value.because(.reference, .no_cell, "", -1)
            failed = true
        if !failed
            ka: = a.unwrap_or(empty_area())
            va: = b.unwrap_or(empty_area())
            if !same_line(ka, va)
                broken = Value.because(.shape, .not_aligned, "", -1)
                failed = true
            else
                for i in Range.asc(length_of(ka))
                    v: = r.read(spot_in(ka, i))
                    // A key on a cycle carries it, so every cell on the cycle shows `#CYCLE!`.
                    // A key past the read limit ends the walk too: every later key is one.
                    if v.kind == .error && (v.error == .cycle || v.error == .read_limit)
                        broken = v
                        failed = true
                        break
                    if equal_keys(key, v)
                        found = .some(r.read(spot_in(va, i)))
                        break
        otherwise: = r.branch(!failed && found.is_none())
        if failed
            return broken
        if v: = found
            return v
        return otherwise

    fn sum_product(r: Self$@): Value //<
        //< `sum_product(a, b)` after its `(`: each cell of `a` times the cell of `b` beside it, added
        //< The two ranges are one column, or one row, as long as each other, as `lookup`'s are. A
        //< pair whose cells are not both numbers is left out, as `sum` leaves out text; an empty
        //< cell is left out too. An error in either range is the result, the first in order.
        first: = r.range_piece()
        r.expect(.comma)
        second: = r.range_piece()
        if r.skipping > 0 || r.wrong
            return empty()
        a: = r.area_of(first) catch
            return Value.because(.reference, .no_cell, "", -1)
        b: = r.area_of(second) catch
            return Value.because(.reference, .no_cell, "", -1)
        if !same_line(a, b)
            return Value.because(.shape, .not_aligned, "", -1)
        $total: = 0.0
        for i in Range.asc(length_of(a))
            x: = r.read(spot_in(a, i))
            y: = r.read(spot_in(b, i))
            if x.kind == .error
                return x
            if y.kind == .error
                return y
            if x.kind == .number && y.kind == .number
                total += x.number * y.number
        return number(total)

    fn column_name(r: Self$@): Value //<
        //< `name(column)` after its `(`: one whole column's name, as text, as the names row holds it
        //< **Any other argument does not read**, as a value where `lookup` needs a range does not.
        //< The column is read through its piece, so the name follows the column as it moves.
        if r.tok.kind == .broken
            r.advance()
            return Value.because(.reference, .lost_reference, "", -1)
        if r.tok.kind != .reference || !r.one_column()
            r.fail(.not_a_column, "", -1)
            return Value.failed(.syntax)
        index: = r.tok.piece
        r.advance()
        if r.skipping > 0
            return empty()
        area: = r.area_of(index) catch
            return Value.because(.reference, .no_cell, "", -1)
        return text(r.c.doc.tables[area.table].cells[area.columns.low].text)

    priv fn one_column(r: Self@): Bool //< whether the next token, a reference, is one whole column
        if r.tok.piece < 0
            return r.tok.whole && r.tok.from.column == r.tok.to.column
        piece: = r.t.pieces[r.tok.piece]@
        return piece.kind == .columns && piece.from.column == piece.to.column

    priv fn range_piece(r: Self$@): Sz //< the piece of a reference argument; -1 where it is not one
        if r.tok.kind != .reference && r.tok.kind != .broken
            r.fail(.missing, "a range", 1)
            return -1
        piece: = r.tok.piece
        r.advance()
        return piece

    fn conditional(r: Self$@, kind: Fold_kind): Value //<
        //< `sum_if(values, condition)` after its `(`, or `count_if` or `average_if`
        //< The values are a cell or a range. The condition is calculated once for each of their
        //< rows, with each range in it read as its cell on that row. The values on a row are read
        //< only where the condition is `true`, as `if` reads only the branch it takes. The values
        //< taken go to `sum`, `count` or `average`, which a formula calls by name too.
        if r.tok.kind != .reference && r.tok.kind != .broken
            r.fail(.missing, "a range", 1)
            return Value.failed(.syntax)
        values: = r.tok.piece
        r.advance()
        r.expect(.comma)
        mark: = r.c.scratch.save()
        $xs: = List<|Value|>(r.c.scratch)
        // **Whether an error was taken is kept as it is taken**, so no row reads `xs` again: a
        // look over `xs` on each row would make one formula's work grow with its rows squared.
        $errored: = false
        $area: = empty_area()
        if found: = r.area_of(values)
            area = found
        else
            xs.push(Value.because(.reference, .no_cell, "", -1))
            errored = true
        outer: = r.rows
        r.rows = Row_reading::{ .inside = true, .count = area.rows.high - area.rows.low + 1,
            .row = 0, .ranged = false, .shaped = true }
        cur: = r.cur
        tok: = r.tok
        // Read once without calculating, to check every range's shape first.
        r.skipping += 1
        _shape: = r.expression()
        r.skipping -= 1
        if !errored && !(r.rows.ranged && r.rows.shaped)
            why: = Why.condition_shape if r.rows.ranged else Why.condition_no_range
            xs.push(Value.because(.shape, why, "", -1))
            errored = true
        if r.skipping == 0
            for row in Range.asc(r.rows.count)
                // **The first error ends it**: the rows below are not read, as their values
                // could not change the result.
                if errored || r.wrong || r.c.deferring
                    break
                r.cur = cur
                r.tok = tok
                r.rows.row = row
                holds: = r.condition(r.expression())
                if holds.kind == .error
                    xs.push(holds)
                    errored = true
                else if holds.boolean
                    errored = r.take_row(xs@, area, area.rows.low + row)
        r.rows = outer
        v: = kind.fold(xs.slice())
        r.c.scratch.restore(mark)
        return v

    fn area_of(r: Self@, index: Sz): Area? //<
        //< The cells a reference's piece names; none for -1, a reference to no cell or `#REF!`
        if index < 0
            return .none
        piece: = r.t.pieces[index]
        table: = piece.table
        at: = r.c.at@
        columns: =
            ordered(at.of(table, piece.from.column), at.of(table, piece.to.column))
        // Whole columns take every data row the table has now, rows added later among them.
        if piece.kind == .columns
            return .some(Area::{ .table = table,
                .rows = Span::{ .low = 0, .high = at.rows[table] - 1 }, .columns = columns })
        return .some(Area::{ .table = table,
            .rows =
            ordered(at.of(table, piece.from.row), at.of(table, piece.to.row)), .columns = columns })

    priv fn take_row(r: Self$@, xs: List<|Value|>$@, area: Area, row: Sz): Bool //<
        //< The numbers, dates and errors of the area's cells on one row, from the left
        //< The result is whether one of them is an error.
        $errored: = false
        for column in Range(area.columns.low, area.columns.high + 1, 1)
            v: = r.read(Spot::{ .table = area.table, .row = row, .column = column })
            if v.kind == .number || v.kind == .date || v.kind == .error
                xs.push(v)
                r.c.results.looks += 1
                errored = errored || v.kind == .error
        return errored

    fn row_of(r: Self$@, piece: Sz): Value //<
        //< A range in a condition, by its piece: its cell on the row read now
        //< It must be one column wide and as tall as the values; else the result is `#SHAPE!`.
        r.rows.ranged = true
        area: = r.area_of(piece) catch
            return Value.because(.reference, .no_cell, "", -1)
        if area.columns.low != area.columns.high ||
            area.rows.high - area.rows.low + 1 != r.rows.count
            r.rows.shaped = false
            return Value.because(.shape, .condition_shape, "", -1)
        if r.skipping > 0
            return empty()
        return r
            .read(Spot::{ .table = area.table, .row = area.rows.low + r.rows.row,
            .column = area.columns.low })

impl Fold_kind
    priv fn fold(r: Self, xs: Value[]): Value //<
        //< The function this kind names, on `xs`; an error is the first value that holds it
        result: = r.folded(xs) catch e
            for x in xs
                if x.kind == .error && x.error == e
                    return x
            return Value.because(e, .in_function, FORMS[r.form()].name, -1)
        return number(result)

    priv fn form(r: Self): Sz //< the place of the function this kind names in `FORMS`
        switch r
        case .sum
            return 2
        case .count
            return 3
        case .average
            return 4

    priv fn folded(r: Self, xs: Value[]): F64!Calc_error
        switch r
        case .sum
            return fns.sum(xs)!
        case .count
            return fns.count(xs)!
        case .average
            return fns.average(xs)!

struct Span //< two places in order
    low: Sz
    high: Sz

struct Area //< the rectangle of cells a reference names, by their places
    table: Sz
    rows: Span
    columns: Span

priv fn empty_area(): Area
    return Area::{ .table = 0, .rows = Span::{ .low = 0, .high = 0 },
        .columns = Span::{ .low = 0, .high = 0 } }

priv fn length_of(area: Area): Sz //< how many cells a line of one row or one column holds
    return area.rows.high - area.rows.low + area.columns.high - area.columns.low + 1

priv fn same_line(left: Area, right: Area): Bool //<
    //< Whether both are one column, or both one row, and hold as many cells
    a_column: = left.columns.low == left.columns.high
    b_column: = right.columns.low == right.columns.high
    a_row: = left.rows.low == left.rows.high
    b_row: = right.rows.low == right.rows.high
    return (a_column && b_column || a_row && b_row) && length_of(left) == length_of(right)

priv fn spot_in(area: Area, i: Sz): Spot //< the `i`th cell of a line, from its top or its left
    if area.columns.low == area.columns.high
        return Spot::{ .table = area.table, .row = area.rows.low + i,
            .column = area.columns.low }
    return Spot::{ .table = area.table, .row = area.rows.low, .column = area.columns.low + i }

priv fn ordered(left: Sz, right: Sz): Span
    return (Span::{ .low = left, .high = right } if left <= right
        else Span::{ .low = right, .high = left })

fn call(name: U8[], a: Raw_args$@): Value? //<
    //< The value of the function `name` on the arguments `a` reads; none for no such name
    if name.equals("average")
        return .some(call_average(a))
    if name.equals("bin_to_dec")
        return .some(call_bin_to_dec(a))
    if name.equals("bin_to_hex")
        return .some(call_bin_to_hex(a))
    if name.equals("char")
        return .some(call_char(a))
    if name.equals("count")
        return .some(call_count(a))
    if name.equals("date")
        return .some(call_date(a))
    if name.equals("day")
        return .some(call_day(a))
    if name.equals("dec_to_bin")
        return .some(call_dec_to_bin(a))
    if name.equals("dec_to_hex")
        return .some(call_dec_to_hex(a))
    if name.equals("find")
        return .some(call_find(a))
    if name.equals("hex_to_bin")
        return .some(call_hex_to_bin(a))
    if name.equals("hex_to_dec")
        return .some(call_hex_to_dec(a))
    if name.equals("left")
        return .some(call_left(a))
    if name.equals("len")
        return .some(call_len(a))
    if name.equals("like")
        return .some(call_like(a))
    if name.equals("max")
        return .some(call_max(a))
    if name.equals("mid")
        return .some(call_mid(a))
    if name.equals("min")
        return .some(call_min(a))
    if name.equals("mod")
        return .some(call_mod(a))
    if name.equals("month")
        return .some(call_month(a))
    if name.equals("power")
        return .some(call_power(a))
    if name.equals("right")
        return .some(call_right(a))
    if name.equals("round")
        return .some(call_round(a))
    if name.equals("round_down")
        return .some(call_round_down(a))
    if name.equals("round_up")
        return .some(call_round_up(a))
    if name.equals("substitute")
        return .some(call_substitute(a))
    if name.equals("sum")
        return .some(call_sum(a))
    if name.equals("text")
        return .some(call_text(a))
    if name.equals("value")
        return .some(call_value(a))
    if name.equals("year")
        return .some(call_year(a))
    return .none

const NAMES: U8[][_] = ::{ "average", "bin_to_dec", "bin_to_hex", "char", "count", "date", "day",
        "dec_to_bin", "dec_to_hex", "find", "hex_to_bin", "hex_to_dec", "left", "len", "like",
        "max", "mid", "min", "mod", "month", "power", "right", "round", "round_down", "round_up",
        "substitute", "sum", "text", "value", "year",
} //< every function this table calls, by its name


priv fn call_find(a: Raw_args$@): Value //< `find(…)`
    $first: = First_error::{ .broken = false, .error = .syntax }
    p_part: = a.text() catch e
        first.take(e)
        fallback ""
    p_t: = a.text() catch e
        first.take(e)
        fallback ""
    if !a.calculating()
        return empty()
    if first.broken
        return Value.failed(first.error)
    r: = fns.find(p_part, p_t)
    return number(F64::r)


priv fn call_find(args: Raw_args$@): Value //< `find(…)`
    $first: = First_error::{ .broken = false, .error = .syntax }
    p_find_text: = args.text() catch e
        first.take(e)
        fallback ""
    p_within_text: = args.text() catch e
        first.take(e)
        fallback ""
    if !args.calculating()

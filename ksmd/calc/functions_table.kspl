priv fn call_average(a: Raw_args$@): Value //< `average(…)`
    p_xs: = a.rest()
    if !a.calculating()
        return empty()
    r: = fns.average(p_xs) catch e
        return Value.failed(e)
    return number(r)

priv fn call_bin_to_dec(a: Raw_args$@): Value //< `bin_to_dec(…)`
    $first: = First_error::{ .broken = false, .error = .syntax }
    p_digits: = a.value() catch e
        first.take(e)
        fallback empty()
    $p_width: I64? = .none
    if a.more()
        got: = a.whole() catch e
            first.take(e)
            fallback 0I64
        p_width = .some(got)
    if !a.calculating()
        return empty()
    if first.broken
        return Value.failed(first.error)
    r: = fns.bin_to_dec(p_digits, p_width, a.arena()) catch e
        return Value.failed(e)
    return number(F64::r)


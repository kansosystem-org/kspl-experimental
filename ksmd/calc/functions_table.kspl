priv fn call_average(args: Raw_args$@): Value //< `average(…)`
    p_numbers: = args.rest()
    if !args.calculating()
        return empty()
    r: = fns.average(p_numbers) catch e
        return Value.failed(e)
    return number(r)

priv fn call_bin_to_dec(args: Raw_args$@): Value //< `bin_to_dec(…)`
    $first: = First_error::{ .broken = false, .error = .syntax }
    p_number: = args.value() catch e
        first.take(e)
        fallback empty()
    $p_width: I64? = .none
    if args.more()
        got: = args.whole() catch e
            first.take(e)
            fallback 0I64
        p_width = .some(got)
    if !args.calculating()
        return empty()
    if first.broken
        return Value.failed(first.error)
    r: = fns.bin_to_dec(p_number, p_width, args.arena()) catch e
        return Value.failed(e)
    return number(F64::r)


fn call(name: U8[], args: Raw_args$@): Value? //<
    //< The value of the function `name` on the arguments `args` reads; none for no such name
    if name.equals("average")
        return .some(call_average(args))
    if name.equals("bin_to_dec")
        return .some(call_bin_to_dec(args))
    if name.equals("bin_to_hex")
        return .some(call_bin_to_hex(args))
    if name.equals("char")
        return .some(call_char(args))
    if name.equals("count")
        return .some(call_count(args))
    if name.equals("date")
        return .some(call_date(args))
    if name.equals("day")
        return .some(call_day(args))
    if name.equals("dec_to_bin")
        return .some(call_dec_to_bin(args))
    if name.equals("dec_to_hex")
        return .some(call_dec_to_hex(args))
    if name.equals("find")
        return .some(call_find(args))
    if name.equals("hex_to_bin")
        return .some(call_hex_to_bin(args))
    if name.equals("hex_to_dec")
        return .some(call_hex_to_dec(args))
    if name.equals("left")
        return .some(call_left(args))
    if name.equals("len")
        return .some(call_len(args))
    if name.equals("like")
        return .some(call_like(args))
    if name.equals("max")
        return .some(call_max(args))
    if name.equals("mid")
        return .some(call_mid(args))
    if name.equals("min")
        return .some(call_min(args))
    if name.equals("mod")
        return .some(call_mod(args))
    if name.equals("month")
        return .some(call_month(args))
    if name.equals("power")
        return .some(call_power(args))
    if name.equals("right")
        return .some(call_right(args))
    if name.equals("round")
        return .some(call_round(args))
    if name.equals("round_down")
        return .some(call_round_down(args))
    if name.equals("round_up")
        return .some(call_round_up(args))
    if name.equals("substitute")
        return .some(call_substitute(args))
    if name.equals("sum")
        return .some(call_sum(args))
    if name.equals("text")
        return .some(call_text(args))
    if name.equals("value")
        return .some(call_value(args))
    if name.equals("year")
        return .some(call_year(args))
    return .none


//< A value a formula calculates, and the arithmetic, comparisons and conversions between values
//< `ksmd/calc/calc.kspl` reads a formula and calls these; they hold no state, so the same values
//< always give the same result.
import "ksmd/base/dates" { BEFORE_DATES, in_range }
import "ksmd/base/marker" { compare_text }
import "ksmd/calc/formula" { Token_kind }
import "ksmd/model/format" { shows_same }
import "std/mem" { Arena }
import "std/str" // `text`
import "std/strnum"

// **What a person's own functions use is public, so [I0402] is off here.** Their file stands in
// their own workspace, outside this package, and calls these; the lint sees only ksmd's own uses.
##lint(I0402 = off)

const MAX_TEXT: Sz = 32767 //< the most bytes of text that `&` or a function gives
    //< A longer result is `#NUM!`, found before its text is made. Spreadsheets cap a cell's text
    //< at 32,767 characters; here, as every other limit, the count is in UTF-8 bytes.

pub enum Calc_error //< why a cell has no value; each is fixed differently
    wrong_kind //< text or true and false in arithmetic, or two kinds ordered: `#VALUE!`
    division //< a division by zero: `#DIV/0!`
    not_finite //< a result too large for a number or text, or out of range: `#NUM!`
    reference //< a reference to no cell: `#REF!`
    cycle //< the cell depends on itself: `#CYCLE!`
    no_numbers //< `min`, `max` or `average` of no numbers: `#EMPTY!`
    shape //< a condition's range not as tall as its values, or a condition with no range: `#SHAPE!`
    syntax //< the formula does not read: `#SYNTAX!`
    pending //< a person's own function whose answer has not come yet: `…`
    time_limit //< a person's own function ran past its time: `#TIME!`
    stopped //< a person's own function stopped, by a panic or a fault: `#STOPPED!`
    blocked //< a call that may be the document's own, whose file the person has not allowed yet:
        //< `#BLOCKED!`
    read_limit //< the formulas read `MAX_READS` cell values, and this cell was not calculated:
        //< `#LIMIT!`

impl Calc_error
    pub fn mark(e: Self): U8[] //< what the cell shows
        switch e
        case .wrong_kind
            return "#VALUE!"
        case .division
            return "#DIV/0!"
        case .not_finite
            return "#NUM!"
        case .reference
            return "#REF!"
        case .cycle
            return "#CYCLE!"
        case .no_numbers
            return "#EMPTY!"
        case .shape
            return "#SHAPE!"
        case .syntax
            return "#SYNTAX!"
        case .pending
            return "…"
        case .time_limit
            return "#TIME!"
        case .stopped
            return "#STOPPED!"
        case .blocked
            return "#BLOCKED!"
        case .read_limit
            return "#LIMIT!"

pub enum Why //< what made an error, beyond its kind; `ksmd/calc/reason.kspl` writes it for a person
    //< **A value keeps this tag and its detail, not a sentence**, so a large table of errors makes
    //< no text. For an error, `Value.number` and `Value.text` hold the detail named here.
    plain //< nothing beyond what the error's kind says
    from_cell //< the error of another cell, carried: `number` is that cell's place in `Results`
    text_in_arithmetic //< `number` is the place of the cell that holds the text, or -1
    truth_in_arithmetic //< `true` or `false` in arithmetic; `number` is its cell's place, or -1
    date_arithmetic //< a date in arithmetic other than adding or taking away whole days
    not_a_condition //< a number, text or a date where true or false is needed; `number` its cell
    kinds_ordered //< two values of different kinds put in order
    joined_kind //< `&` with a number, a date or a truth value; `number` its cell's place, or -1
    divide_by_zero //< `number` is the place of the cell that holds the divisor, or -1
    too_large //< a number past an F64
    text_too_long //< text past `MAX_TEXT` bytes
    day_out_of_range //< a date past the years 1 to 9999
    lost_reference //< `#REF!` written in the formula: its row or column was removed
    no_cell //< a reference to no cell: outside its table, or a table this source does not hold
    not_aligned //< two ranges that are not one column, or one row, of the same length
    condition_shape //< a range in a condition not one column as tall as the values
    condition_no_range //< a condition with no range in it
    in_function //< an error the function `text` found in its own work
    own_function //< an error of the document's own function `text`
    unbuilt //< the file that gives the document's own function `text` does not build
    wants_number //< argument `number` of the function `text` takes a number
    wants_whole //< argument `number` of the function `text` takes a whole number
    wants_truth //< argument `number` of the function `text` takes `true` or `false`
    wants_text //< argument `number` of the function `text` takes text
    unknown_function //< no function is called `text`
    bare_word //< the word `text` stands alone: it is no function, cell or value
    arguments //< the arguments do not fit the function `text`
    not_a_column //< `name` given anything but one whole column
    digit_literal //< a literal in a base, `text`, given as the digit text of a function in
        //< `READ_DIGITS`: `number` is that function's place in the list
    bad_token //< `text` reads as nothing a formula holds; empty for a byte that starts nothing
    range_alone //< a range outside a function or a condition
    missing //< `text` is missing, such as `)`; `number` is 1 where a `,` or a `)` stood instead
    unexpected //< `text` stands where a value is needed; empty at the formula's end
    two_comparisons //< `a < b < c`
    too_deep //< more than `MAX_LEVELS` levels
    trailing //< `text` follows a whole formula, with no operator before it

pub enum Value_kind //< a formula's value is never empty: an empty cell's value as a formula's is 0
    empty
    number
    text //< a text cell's text, or text a formula gives
    date //< a day, as its count of days from 1970-01-01 in `number`
    boolean //< `true` or `false`
    error

pub struct Value //< the small fields first, so they share one word
    pub kind: Value_kind
    pub boolean: Bool //< true for `true`; false for the other kinds
    pub error: Calc_error //< an error's kind; `.syntax` for the other kinds
    pub why: Why //< what made an error; `.plain` for the other kinds
    pub number: F64 //< a number's value, or a date's day; 0 for the other kinds
    pub text: U8[] //< a text's bytes; empty for the other kinds

impl Value
    pub fn failed(e: Calc_error): Value //< the value of a cell that has none, of this kind
        return Value.because(e, .plain, "", -1)

    pub fn because(e: Calc_error, why: Why, detail: U8[], at: Sz): Value //<
        //< An error and what made it: `detail` and `at` are the text and the number `why` names
        return Value::{ .kind = .error, .number = F64::at, .text = detail, .boolean = false,
            .error = e, .why = why }

    pub fn at(v: Self): Sz //< an error's number as `Why` names it: a place, or -1
        return Sz::v.number

fn equal_keys(key: Value, cell: Value): Bool //< whether a cell's value is the key looked for
    if key.kind != cell.kind
        return false
    switch key.kind
    case .number
        return shows_same(key.number, cell.number)
    case .date
        return key.number == cell.number
    case .text
        return compare_text(key.text, cell.text) == 0
    case .boolean
        return key.boolean == cell.boolean
    default
        return false

fn arithmetic(x: Value, y: Value, op: Token_kind): Value //<
    //< Two numbers joined by an operator; the left error comes first
    if x.kind == .date || y.kind == .date
        return date_arithmetic(x, y, op)
    a: = operand(x)
    if a.kind == .error
        return a
    b: = operand(y)
    if b.kind == .error
        return b
    switch op
    case .plus
        return sum_of(a.number, b.number)
    case .minus
        return sum_of(a.number, -b.number)
    case .times
        return number(a.number * b.number)
    default {}
    if b.number == 0.0
        return Value.because(.division, .divide_by_zero, "", -1)
    return number(a.number / b.number)

fn sum_of(a: F64, b: F64): Value //< `a + b`, and 0 where the two cancel at the 15 digits they show
    //< **A sum whose sides show the same 15 digits with opposite signs is exactly 0**, so
    //< `0.1 + 0.2 - 0.3` is 0, not 5.55e-17, and `a - b` is 0 exactly where `a = b` is `true`.
    //< A number the sides do not cancel stays, however small: `1e-20 - 0` is 1e-20.
    if a != 0.0 && b != 0.0 && shows_same(a, -b)
        return number(0.0)
    return number(a + b)

pub fn operand(v: Value): Value //< a value in arithmetic: empty is 0, text or true and false
    //< an error
    switch v.kind
    case .empty
        return number(0.0)
    case .text
        return Value.because(.wrong_kind, .text_in_arithmetic, "", -1)
    case .boolean
        return Value.because(.wrong_kind, .truth_in_arithmetic, "", -1)
    case .date
        return Value.because(.wrong_kind, .date_arithmetic, "", -1)
    case .number, .error
        return v

pub fn truth(v: Value): Value //< a value as a condition: empty is false, a number or text an error
    switch v.kind
    case .empty
        return boolean(false)
    case .number, .text, .date
        return Value.because(.wrong_kind, .not_a_condition, "", -1)
    case .boolean, .error
        return v

fn is_comparison(k: Token_kind): Bool
    return k == .equal || k == .unequal || k == .less || k == .less_equal || k == .greater ||
        k == .greater_equal

fn joined(x: Value, y: Value, arena: Arena$@): Value //<
    //< Two texts joined by `&`; the left error comes first. An empty cell is empty text. **A
    //< number, a date or `true`/`false` is `#VALUE!`**: written as text, its digits would depend on
    //< a format the formula does not name. Text past `MAX_TEXT` is `#NUM!`.
    a: = as_text(x)
    if a.kind == .error
        return a
    b: = as_text(y)
    if b.kind == .error
        return b
    if a.text.len + b.text.len > MAX_TEXT
        return Value.because(.not_finite, .text_too_long, "", -1)
    if a.text.len == 0
        return b
    if b.text.len == 0
        return a
    return text(arena.text().s(a.text).s(b.text).take())

priv fn as_text(v: Value): Value //< a value as one side of `&`: text, or an error
    switch v.kind
    case .text, .error
        return v
    case .empty
        return text("")
    default
        return Value.because(.wrong_kind, .joined_kind, "", -1)

fn compare(x: Value, y: Value, op: Token_kind): Value //<
    //< Two values compared; the left error comes first
    //< An empty value takes the other side's kind: 0, empty text, false or a day before every
    //< date. Values of two kinds are unequal, and ordering them is an error. Two numbers are
    //< equal when the 15 digits they show agree, so `0.1 + 0.2 = 0.3`. Text compares without
    //< regard to case.
    if x.kind == .error
        return x
    if y.kind == .error
        return y
    a: = like(x, y)
    b: = like(y, x)
    if a.kind != b.kind
        if op == .equal || op == .unequal
            return boolean(op == .unequal)
        return Value.because(.wrong_kind, .kinds_ordered, "", -1)
    $order: I32 = 0
    switch a.kind
    case .number
        order =
            0 if shows_same(a.number, b.number) else -1 if a.number < b.number else 1
    case .date
        order = -1 if a.number < b.number else 1 if a.number > b.number else 0
    case .text
        order = compare_text(a.text, b.text)
    case .boolean
        order = 0 if a.boolean == b.boolean else 1 if a.boolean else -1
    case .empty, .error {}
    switch op
    case .equal
        return boolean(order == 0)
    case .unequal
        return boolean(order != 0)
    case .less
        return boolean(order < 0)
    case .less_equal
        return boolean(order <= 0)
    case .greater
        return boolean(order > 0)
    default {}
    return boolean(order >= 0)

fn like(v: Value, other: Value): Value //< an empty value as the zero of the other's kind
    //< Among dates that is a day before the first, so an empty due date is earlier than every
    //< date, as an empty cell is 0 among numbers.
    if v.kind != .empty
        return v
    switch other.kind
    case .number
        return number(0.0)
    case .text
        return text("")
    case .boolean
        return boolean(false)
    case .date
        return date_value(BEFORE_DATES)
    case .empty, .error {}
    return v

priv fn date_arithmetic(x: Value, y: Value, op: Token_kind): Value //<
    //< A date and a whole number of days added or taken away, or two dates taken apart
    //< A date plus or minus days is a date, and a date minus a date the days between them. Any
    //< other use of a date in arithmetic is `#VALUE!`, and a day past the year 9999 `#NUM!`.
    if x.kind == .error
        return x
    if y.kind == .error
        return y
    a: = number(0.0) if x.kind == .empty else x
    b: = number(0.0) if y.kind == .empty else y
    if op == .minus && a.kind == .date && b.kind == .date
        return number(a.number - b.number)
    $days: = 0.0
    $at: = 0.0
    if a.kind == .date && b.kind == .number && (op == .plus || op == .minus)
        at = a.number
        days = b.number if op == .plus else -b.number
    else if a.kind == .number && b.kind == .date && op == .plus
        at = b.number
        days = a.number
    else
        return Value.because(.wrong_kind, .date_arithmetic, "", -1)
    if days != F64::(I64::days) || days > 4000000.0 || days < -4000000.0
        return Value.because(.wrong_kind, .date_arithmetic, "", -1)
    day: = I64::at + I64::days
    if !in_range(day)
        return Value.because(.not_finite, .day_out_of_range, "", -1)
    return date_value(day)

pub fn date_value(day: I64): Value //< a date; the caller keeps the day in the years 1 to 9999
    return Value::{ .kind = .date, .number = F64::day, .text = "", .boolean = false,
        .error = .syntax }

fn number_of(text: U8[]): Value //< a number written in decimal; one too large is an error
    n: = text.to_f64() catch
        return Value.because(.not_finite, .too_large, "", -1)
    return number(n)

pub fn number(n: F64): Value //< a number; an infinity or a NaN is an error
    if n - n != 0.0
        return Value.because(.not_finite, .too_large, "", -1)

    return Value::{ .kind = .number, .number = n, .text = "", .boolean = false, .error = .syntax }

pub fn text(s: U8[]): Value
    return Value::{ .kind = .text, .number = 0.0, .text = s, .boolean = false, .error = .syntax }

pub fn boolean(b: Bool): Value
    return Value::{ .kind = .boolean, .number = 0.0, .text = "", .boolean = b, .error = .syntax }

pub fn empty(): Value
    return Value::{ .kind = .empty, .number = 0.0, .text = "", .boolean = false,
        .error = .syntax }

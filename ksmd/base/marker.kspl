//< Which line starts a block other than prose, as the reader reads it and the writer escapes it
//< Also the small scans the readers share, and the order text sorts and compares in.
import "std/chars"
import "std/str"

fn starts_block(text: U8[]): Bool //< whether a line begins a block other than prose
    return text.starts_with("#") || text.starts_with("```") || text.starts_with(":::") ||
        text.starts_with("|") || text.starts_with("{") || is_quote_marker(text) ||
        text.trim_end().equals("---") || is_list_marker(text)

fn is_quote_marker(text: U8[]): Bool //< `>`, then a space or the line's end
    return text.starts_with(">") && (text.len == 1 || text[1] == ' ')

fn is_list_marker(text: U8[]): Bool //< `-`, or digits and `.`, then a space or the line's end
    $mark: Sz = 1
    if !text.starts_with("-")
        mark = run_of_digits(text)
        if mark == 0 || !text.starts_with(".", mark)
            return false
        mark += 1
    return mark == text.len || text[mark] == ' '

fn run_of(text: U8[], c: U8): Sz //< how many times `c` repeats at the start
    $n: Sz = 0
    for n < text.len && text[n] == c
        n += 1
    return n

fn run_of_digits(text: U8[]): Sz //< how many ASCII digits stand at the start
    $n: Sz = 0
    for n < text.len && text[n].is_digit()
        n += 1
    return n

fn is_punctuation(c: U8): Bool //< ASCII punctuation, the only bytes a backslash escapes
    return c >= '!' && c <= '/' || c >= ':' && c <= '@' || c >= '[' && c <= '`' ||
        c >= '{' && c <= '~'

fn leading(text: U8[]): Sz //< how many bytes of whitespace stand at the start
    return text.len - text.trim_start().len

fn is_decimal(text: U8[]): Bool //< a JSON number: `-12`, `2.5`, `1e3`; no `+` and no leading zero
    $i: Sz = 1 if text.starts_with("-") else 0
    whole: = run_of_digits(text.sub_from(i))
    if whole == 0 || whole > 1 && text[i] == '0'
        return false
    i += whole
    if i < text.len && text[i] == '.'
        fraction: = run_of_digits(text.sub_from(i + 1))
        if fraction == 0
            return false
        i += 1 + fraction
    if i < text.len && (text[i] == 'e' || text[i] == 'E')
        i += 1
        if i < text.len && (text[i] == '+' || text[i] == '-')
            i += 1
        power: = run_of_digits(text.sub_from(i))
        if power == 0
            return false
        i += power
    return i == text.len

fn quoted_end(text: U8[], from: Sz): Sz //<
    //< The index of the '"' that closes the JSON string opening at `from`, or the text's length
    $i: = from + 1
    for i < text.len && text[i] != '"'
        i += 2 if text[i] == '\\' else 1
    return i if i < text.len else text.len

fn compare_text(a: U8[], b: U8[]): I32 //<
    //< Below zero when `a` comes first: letters A to Z without regard to case, then other bytes
    for i in Range.asc(a.len if a.len < b.len else b.len)
        x: = a[i].to_lower()
        y: = b[i].to_lower()
        if x != y
            return -1 if x < y else 1
    return -1 if a.len < b.len else 1 if a.len > b.len else 0

//< Undo and redo as model transactions: what each action changed, kept to swap back
//< A record holds the version of a part that the document does not show now. Undoing swaps it in,
//< which leaves the undone version in the record, ready for redo. Inline nodes and list items are
//< only ever added, so a block swapped back still names valid nodes.
//< A table edit is recorded by comparing each table with a copy made before the edit: cell by
//< cell and piece by piece where the table keeps its shape, or the whole table otherwise. Column
//< widths changed alone are recorded alone, so resizing a large table copies none of its cells.
//< Caution: **Undo and redo strictly in order.** A swap restores the exact state its action started
//< from only when every later action has been undone first.
import "ksmd/model" { Block, Cell, Corner, Document, Piece, Table }
import "ksmd/region" { Spot, Style }
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"

struct Selection //< where the selection's two ends stood, and the kind a gap's new block takes
    anchor: Spot
    focus: Spot
    gap: Style

enum Step_kind //< which actions may join the step before them
    other
    typing
    deleting

struct Blocks_swap //< blocks that stood from `at` where `count` blocks stand now
    at: Sz
    count: Sz
    blocks: List<|Block|>

struct Table_swap //< another version of the table at `table`
    table: Sz
    version: Table

struct Cell_swap //< another version of cell `index` of the table at `table`
    table: Sz
    index: Sz
    cell: Cell

struct Piece_swap //< another version of piece `index` of the table at `table`
    table: Sz
    index: Sz
    piece: Piece

struct Widths_swap //< another version of the column weights of the table at `table`
    table: Sz
    weights: List<|Sz|>

struct Transaction //< what one action changed, and the selection before and after it
    blocks: List<|Blocks_swap|> //< in the order they were made
    tables: List<|Table_swap|>
    cells: List<|Cell_swap|>
    pieces: List<|Piece_swap|>
    widths: List<|Widths_swap|>
    before: Selection
    after: Selection
    kind: Step_kind
    word_ended: Bool //< typed text ended in a space, which ends the step

struct Change //< what an action changed, for a page to show again
    from: Sz //< the first block changed
    tail: Sz //< how many blocks at the end are unchanged
    tables: Bool //< a table changed, so values may differ in every table
    any: Bool //< the document changed at all, blocks being removed included

impl Change
    fn none(doc: Document@): Change //< nothing changed yet
        return Change::{ .from = doc.blocks.len, .tail = doc.blocks.len, .tables = false,
            .any = false }

    fn note(c: Self$@, doc: Document@, at: Sz, count: Sz) //< blocks from `at`, `count` now, changed
        c.any = true
        if at < c.from
            c.from = at
        after: = doc.blocks.len - at - count
        if after < c.tail
            c.tail = after

struct History
    done: List<|Transaction|> //< the last one is undone first
    undone: List<|Transaction|> //< the last one is redone first

fn new_history(arena: Arena$@): History
    return History::{ .done = List<|Transaction|>(arena),
        .undone = List<|Transaction|>(arena) }

fn begin(before: Selection, arena: Arena$@): Transaction //< a transaction that has changed nothing
    return Transaction::{ .blocks = List<|Blocks_swap|>(arena),
        .tables = List<|Table_swap|>(arena), .cells = List<|Cell_swap|>(arena),
        .pieces = List<|Piece_swap|>(arena), .widths = List<|Widths_swap|>(arena), .before = before,
        .after = before, .kind = .other, .word_ended = false }

fn is_empty(tx: Transaction@): Bool //< whether it changed nothing
    return tx.blocks.len == 0 && tx.tables.len == 0 && tx.cells.len == 0 && tx.pieces.len == 0 &&
        tx.widths.len == 0

fn replace_blocks(doc: Document$@, tx: Transaction$@, at: Sz, removed: Sz,
    blocks: List<|Block|>@, change: Change$@, arena: Arena$@) //<
        //< Puts `blocks` in place of `removed` blocks from `at`, and records the swap
    $old: = List<|Block|>(arena)
    for i in Range.asc(removed)
        old.push(doc.blocks.get(at + i))
    splice(doc, at, removed, blocks)
    tx.blocks.push(Blocks_swap::{ .at = at, .count = blocks.len, .blocks = old })
    change.note(doc, at, blocks.len)

fn swap(doc: Document$@, tx: Transaction$@, undo: Bool, change: Change$@, scratch: Arena$@) //<
    //< Undoes the transaction, or redoes it, by swapping each recorded version with the document's
    //< Block swaps run backwards to undo, since a later one stands on the places an earlier left.
    for i in Range.asc(tx.blocks.len)
        k: = tx.blocks.len - 1 - i if undo else i
        s: = tx.blocks[k]@
        $now: = List<|Block|>(scratch)
        for j in Range.asc(s.count)
            now.push(doc.blocks.get(s.at + j))
        splice(doc, s.at, s.count, s.blocks@)
        change.note(doc, s.at, s.blocks.len)
        s.count = s.blocks.len
        s.blocks.clear()
        for b in now
            s.blocks.push(b)
    for i in Range.asc(tx.tables.len)
        s: = tx.tables[i]@
        here: = doc.tables[s.table]
        doc.tables[s.table] = s.version
        s.version = here
    for i in Range.asc(tx.cells.len)
        s: = tx.cells[i]@
        here: = doc.tables[s.table].cells[s.index]
        doc.tables[s.table].cells[s.index] = s.cell
        s.cell = here
    for i in Range.asc(tx.pieces.len)
        s: = tx.pieces[i]@
        here: = doc.tables[s.table].pieces[s.index]
        doc.tables[s.table].pieces[s.index] = s.piece
        s.piece = here
    for i in Range.asc(tx.widths.len)
        s: = tx.widths[i]@
        here: = doc.tables[s.table].weights
        doc.tables[s.table].weights = s.weights
        s.weights = here
    if tx.tables.len + tx.cells.len + tx.pieces.len + tx.widths.len > 0
        change.tables = true
        change.any = true

priv fn splice(doc: Document$@, at: Sz, removed: Sz, blocks: List<|Block|>@) //<
    //< Replaces `removed` blocks from `at` with `blocks`, writing over the places both share
    shared: = removed if removed < blocks.len else blocks.len
    for i in Range.asc(shared)
        doc.blocks.set(at + i, blocks.get(i))
    for _ in Range(shared, removed, 1)
        doc.blocks.remove_at(at + shared)
    for i in Range(shared, blocks.len, 1)
        doc.blocks.insert(at + i, blocks.get(i))

fn capture(doc: Document@, scratch: Arena$@): List<|Table|> //<
    //< A copy of every table, made before a table edit for `record_tables`
    $copies: = List<|Table|>(scratch)
    for t in doc.tables
        copies.push(copied(t@, scratch))
    return copies

fn record_tables(doc: Document@, before: List<|Table|>@, tx: Transaction$@, arena: Arena$@) //<
    //< Records how each table differs from its copy in `before`
    //< A table added since is recorded against an empty table with no name, which is what the
    //< document holds at its place once the edit is undone.
    for u in Range.asc(doc.tables.len)
        if u >= before.len
            tx.tables.push(Table_swap::{ .table = u, .version = Table("", arena) })
            continue
        t: = doc.tables[u]@
        b: = before[u]@
        if !keeps_shape(t, b)
            tx.tables.push(Table_swap::{ .table = u, .version = copied(b, arena) })
            continue
        for i in Range.asc(b.cells.len)
            if !same_cell(t.cells[i], b.cells[i])
                tx.cells.push(Cell_swap::{ .table = u, .index = i, .cell = b.cells[i] })
        for i in Range.asc(b.pieces.len)
            if !same_piece(t.pieces[i]@, b.pieces[i]@)
                tx.pieces
                    .push(Piece_swap::{ .table = u, .index = i, .piece = b.pieces[i] })
        if !same_ids(t.weights@, b.weights@)
            tx.widths
                .push(Widths_swap::{ .table = u, .weights = copied_ids(b.weights@, arena) })

priv fn copied(t: Table@, arena: Arena$@): Table //< the table with its lists copied into `arena`
    $c: = Table(t.name, arena)
    c.next_id = t.next_id
    for cell in t.cells
        c.cells.push(cell)
    for id in t.rows
        c.rows.push(id)
    for id in t.columns
        c.columns.push(id)
    for p in t.pieces
        c.pieces.push(p)
    c.weights = copied_ids(t.weights@, arena)
    return c

priv fn copied_ids(ids: List<|Sz|>@, arena: Arena$@): List<|Sz|> //< the list copied into `arena`
    $c: = List<|Sz|>(arena)
    for id in ids
        c.push(id)
    return c

priv fn keeps_shape(t: Table@, b: Table@): Bool //<
    //< Whether a table has the rows, columns, name and cell count of its copy, and kept every piece
    //< Its column weights can differ: `Widths_swap` records them.
    return t.name.equals(b.name) && t.next_id == b.next_id && t.cells.len == b.cells.len &&
        t.pieces.len >= b.pieces.len && same_ids(t.rows@, b.rows@) &&
        same_ids(t.columns@, b.columns@)

priv fn same_ids(a: List<|Sz|>@, b: List<|Sz|>@): Bool
    if a.len != b.len
        return false
    for i in Range.asc(a.len)
        if a[i] != b[i]
            return false
    return true

priv fn same_cell(a: Cell, b: Cell): Bool
    return a.kind == b.kind && a.text.equals(b.text) && a.first == b.first && a.count == b.count

priv fn same_piece(a: Piece@, b: Piece@): Bool
    return a.kind == b.kind && a.text.equals(b.text) && a.table == b.table && a.named == b.named &&
        same_corner(a.from, b.from) && same_corner(a.to, b.to)

priv fn same_corner(a: Corner, b: Corner): Bool
    return a.row == b.row && a.column == b.column && a.fixed_row == b.fixed_row &&
        a.fixed_column == b.fixed_column

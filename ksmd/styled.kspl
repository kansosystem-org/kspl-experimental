//< Styled text: the form an editor changes a paragraph's, a heading's or a list item's text in
//< A run of segments, each a piece of text with the marks over it, or one hard break. Marks are
//< kept per segment, so an edit never has to close and reopen a mark itself: `build` turns the
//< segments back into the nested inline nodes the reader would read.
//< An offset counts UTF-8 bytes of the visible text, where a hard break counts as one byte ("\n").
import "ksmd/model" { Document, Inline, Inline_kind }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }

struct Marks //< the marks over a piece of text
    emphasis: Bool
    strong: Bool
    code: Bool //< inline code: literal text, which can stand inside the other marks
    link: U8[] //< the destination of the link over it, or empty

struct Seg //< a piece of text with one set of marks, or a hard break
    text: U8[] //< the text; "\n" for a hard break
    marks: Marks //< none for a hard break
    hard: Bool

fn plain(): Marks //< no mark
    return Marks::{ .emphasis = false, .strong = false, .code = false, .link = "" }

fn same(a: Marks, b: Marks): Bool
    return a.emphasis == b.emphasis && a.strong == b.strong && a.code == b.code &&
        a.link.equals(b.link)

fn is_plain(m: Marks): Bool //< no mark at all, so the text is written without delimiters
    return same(m, plain())

fn text_seg(text: U8[], marks: Marks): Seg
    return Seg::{ .text = text, .marks = marks, .hard = false }

fn hard_break(): Seg
    return Seg::{ .text = "\n", .marks = plain(), .hard = true }

fn length(segs: List<|Seg|>@): Sz //< the bytes of visible text
    $n: Sz = 0
    for s in segs
        n += s.text.len
    return n

fn visible(segs: List<|Seg|>@, arena: Arena$@): U8[] //< the visible text, a hard break as "\n"
    defer $b: = Str_builder()
    for s in segs
        b.s(s.text)
    return arena.dup_str(b.slice())

fn flatten(doc: Document@, first: Sz, count: Sz, out: List<|Seg|>$@) //<
    //< Appends the segments the inline nodes from `first` hold
    $m: = plain()
    for i in Range.asc(count)
        node: = doc.inlines.get(first + i)
        switch node.kind
        case .text
            out.push(text_seg(node.text, m))
        case .code
            $c: = m
            c.code = true
            out.push(text_seg(node.text, c))
        case .hard_break
            out.push(hard_break())
        case .emphasis_start, .emphasis_end
            m.emphasis = node.kind == .emphasis_start
        case .strong_start, .strong_end
            m.strong = node.kind == .strong_start
        case .link_start
            m.link = node.text
        case .link_end
            m.link = ""

fn cut(segs: List<|Seg|>@, from: Sz, to: Sz, out: List<|Seg|>$@) //<
    //< Appends the segments between two offsets, splitting the segments at either end
    $at: Sz = 0
    for s in segs
        end: = at + s.text.len
        if end > from && at < to
            lo: = from - at if from > at else 0
            hi: = to - at if to < end else s.text.len
            out
                .push(Seg::{ .text = s.text.sub(lo, hi - lo), .marks = s.marks, .hard = s.hard })
        at = end

fn marks_before(segs: List<|Seg|>@, offset: Sz): Marks //<
    //< The marks typed text takes at an offset: the emphasis of the text before it
    //< A link and inline code do not grow at their ends; at the start, the first text decides.
    $at: Sz = 0
    $m: = plain()
    for s in segs
        end: = at + s.text.len
        if offset > at && offset <= end || offset == 0 && s.text.len > 0
            m = s.marks
            break
        at = end
    m.code = false
    m.link = ""
    return m

fn set_mark(segs: List<|Seg|>$@, from: Sz, to: Sz, which: Mark, on: Bool, link: U8[],
    arena: Arena$@) //<
        //< Turns a mark on or off over the text between two offsets; hard breaks take no mark
    $out: = List<|Seg|>(arena)
    total: = length(segs)
    cut(segs, 0, from, out@)
    $middle: = List<|Seg|>(arena)
    cut(segs, from, to, middle@)
    for i in Range.asc(middle.len)
        $s: = middle[i]
        if !s.hard
            s.marks = with_mark(s.marks, which, on, link)
        out.push(s)
    cut(segs, to, total, out@)
    segs$ = out

fn has_mark(segs: List<|Seg|>@, from: Sz, to: Sz, which: Mark): Bool //<
    //< Whether every piece of text between two offsets has the mark; false when there is none
    $at: Sz = 0
    $any: = false
    for s in segs
        end: = at + s.text.len
        if end > from && at < to && !s.hard
            any = true
            if !mark_of(s.marks, which)
                return false
        at = end
    return any

enum Mark //< a mark a command turns on or off
    emphasis
    strong
    code
    link

priv fn mark_of(m: Marks, which: Mark): Bool
    switch which
    case .emphasis
        return m.emphasis
    case .strong
        return m.strong
    case .code
        return m.code
    case .link
        return m.link.len > 0

priv fn with_mark($m: Marks, which: Mark, on: Bool, link: U8[]): Marks
    switch which
    case .emphasis
        m.emphasis = on
    case .strong
        m.strong = on
    case .code
        m.code = on
    case .link
        m.link = link if on else ""
    return m

fn normalized(segs: List<|Seg|>@, arena: Arena$@): List<|Seg|> //<
    //< The segments as the writer saves them and the reader reads them back
    //< Neighbours with the same marks join, and empty text goes. Spaces at a line's edge go where
    //< no mark stands before or after them, and so do hard breaks at the end.
    $out: = List<|Seg|>(arena)
    for s in segs
        if s.text.len == 0
            continue
        if out.len > 0 && !s.hard && !out[out.len - 1].hard &&
            same(out[out.len - 1].marks, s.marks)
            last: = out[out.len - 1]
            out[out.len - 1] =
                text_seg(arena.text().s(last.text).s(s.text).take(), s.marks)
            continue
        out.push(s)
    for out.len > 0 &&
        (out[out.len - 1].hard ||
        is_plain(out[out.len - 1].marks) &&
        out[out.len - 1].text.trim_spaces().len == 0)
        _dropped: = out.pop()
    $trimmed: = List<|Seg|>(arena)
    for i in Range.asc(out.len)
        $s: = out[i]
        if !s.hard && is_plain(s.marks)
            if i == 0 || out[i - 1].hard
                s.text = s.text.trim_start()
            if i + 1 == out.len || out[i + 1].hard
                s.text = s.text.trim_end()
            if s.text.len == 0
                continue
        trimmed.push(s)
    return trimmed

fn equal(a: List<|Seg|>@, b: List<|Seg|>@): Bool //<
    //< the same text with the same marks, piece by piece
    if a.len != b.len
        return false
    for i in Range.asc(a.len)
        if a[i].hard != b[i].hard || !a[i].text.equals(b[i].text) ||
            !same(a[i].marks, b[i].marks)
            return false
    return true

fn build(segs: List<|Seg|>@, doc: Document$@, arena: Arena$@): Sz //<
    //< Appends the inline nodes of the segments to `doc.inlines`, and returns where they start
    //< Marks open in a fixed order, link outermost, then strong emphasis, then emphasis, as the
    //< reader reads `***` that opens both. A mark closes where its text ends, and a mark inside it
    //< closes and opens again. Every mark closes before a hard break. Text lands in `arena`.
    first: = doc.inlines.len
    $open: = Open::{ .kinds = ::{}, .links = ::{}, .depth = 0 }
    $pending: = Seg::{ .text = "", .marks = plain(), .hard = false }
    defer $text: = Str_builder()
    for s in segs
        if s.text.len == 0
            continue
        if !s.hard && text.slice().len > 0 && same(pending.marks, s.marks)
            text.s(s.text)
            continue
        flush(text@, pending.marks, doc, arena)
        if s.hard
            open.close_to(0, doc)
            doc.inlines.push(Inline::{ .kind = .hard_break, .text = "", .offset = 0 })
            continue
        open.reach(s.marks, doc, arena)
        pending = s
        text.s(s.text)
    flush(text@, pending.marks, doc, arena)
    open.close_to(0, doc)
    return first

priv fn flush(text: Str_builder$@, marks: Marks, doc: Document$@, arena: Arena$@) //<
    //< Pushes the pending text as a text node, or as code under `marks.code`
    if text.slice().len == 0
        return
    kind: = Inline_kind.code if marks.code else Inline_kind.text
    doc.inlines
        .push(Inline::{ .kind = kind, .text = arena.dup_str(text.slice()), .offset = 0 })
    text.clear()

priv struct Open //< the marks open while nodes are built, outermost first
    kinds: Inline_kind[3]
    links: U8[][3] //< a link's destination, beside its kind
    depth: Sz

impl Open
    priv fn reach(o: Self$@, m: Marks, doc: Document$@, arena: Arena$@) //<
        //< Closes the marks `m` lacks, with every mark opened inside them, then opens the rest
        $keep: Sz = 0
        for keep < o.depth && o.holds(keep, m)
            keep += 1
        o.close_to(keep, doc)
        if m.link.len > 0 && !o.has(.link_start)
            o.push(.link_start, arena.dup_str(m.link), doc)
        if m.strong && !o.has(.strong_start)
            o.push(.strong_start, "", doc)
        if m.emphasis && !o.has(.emphasis_start)
            o.push(.emphasis_start, "", doc)

    priv fn holds(o: Self@, i: Sz, m: Marks): Bool //< whether open mark `i` is one of `m`
        switch o.kinds[i]
        case .link_start
            return m.link.equals(o.links[i])
        case .strong_start
            return m.strong
        default
            return m.emphasis

    priv fn has(o: Self@, kind: Inline_kind): Bool
        for i in Range.asc(o.depth)
            if o.kinds[i] == kind
                return true
        return false

    priv fn push(o: Self$@, kind: Inline_kind, link: U8[], doc: Document$@)
        o.kinds[o.depth] = kind
        o.links[o.depth] = link
        o.depth += 1
        doc.inlines.push(Inline::{ .kind = kind, .text = link, .offset = 0 })

    priv fn close_to(o: Self$@, depth: Sz, doc: Document$@) //< closes marks down to `depth` open
        for o.depth > depth
            o.depth -= 1
            doc.inlines
                .push(Inline::{ .kind = end_of(o.kinds[o.depth]), .text = "", .offset = 0 })

priv fn end_of(kind: Inline_kind): Inline_kind
    switch kind
    case .link_start
        return .link_end
    case .strong_start
        return .strong_end
    default
        return .emphasis_end

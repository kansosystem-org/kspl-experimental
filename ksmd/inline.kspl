//< Reads the inline markup of a paragraph, a heading or a list item into inline nodes
//< Every mark opens and closes on one source line. `*` marks emphasis and `**` strong emphasis;
//< a run of `*` closes and opens them as `star_plans` decides.
import "ksmd/attribute" { read_attributes }
import "ksmd/look" { is_plain, look_of, plain_look }
import "ksmd/marker" { is_punctuation, quoted_end, run_of }
import "ksmd/model" { Document, Inline, Inline_kind }
import "ksmd/source" { Diagnostic, Source }
import "std/chars"
import "std/mem" { Arena }
import "std/str" { Str_builder }

struct Inline_reader //< collects the inline nodes of one block or item, a source line at a time
    pending: Str_builder //< text read but not yet pushed as a node
    pending_at: Sz //< where the pending text starts in the original bytes
    first: Sz //< the first node in `Document.inlines`

impl Inline_reader
    fn new(doc: Document@): Inline_reader
        return Inline_reader::{ .pending = Str_builder(), .pending_at = 0,
            .first = doc.inlines.len }

    fn line(r: Self$@, src: Source@, text: U8[], offset: Sz, doc: Document$@, arena: Arena$@):
        Void!Diagnostic //<
            //< Reads the text of one line, which starts at `offset`. Every mark closes on it.
        $marks: = Marks::{ .kinds = ::{}, .at = ::{}, .node = ::{}, .depth = 0 }
        $i: Sz = 0
        for i < text.len
            c: = text[i]
            if c == '\\'
                if i + 1 == text.len || !is_punctuation(text[i + 1])
                    throw src.diagnostic(offset + i,
                        "a backslash escapes only ASCII punctuation. Write '\\\\' for a literal \
                            backslash")
                r.add(text[i + 1], offset + i)
                i += 2
            else if c == '`'
                i = r.code(src, text, i, offset, doc, arena)!
            else if c == '*'
                n: = run_of(text.sub_from(i), '*')
                r.stars(src, text, i, n, offset, marks@, doc, arena)!
                i += n
            else if c == '['
                if marks.has(.link_start)
                    throw src.diagnostic(offset + i,
                        "a link holds no other link. Write '\\[' for a literal '['")
                r.flush(doc, arena)
                marks.push(.link_start, offset + i, doc.inlines.len)
                doc.inlines
                    .push(Inline::{ .kind = .link_start, .text = "", .offset = offset + i,
                    .look = plain_look() })
                i += 1
            else if c == ']'
                i = r.link_end(src, text, i, offset, marks@, doc, arena)!
            else
                r.add(c, offset + i)
                i += 1
        if marks.depth > 0
            throw src.diagnostic(marks.at[0], unclosed(marks.kinds[0]))

    fn soft_break(r: Self$@, at: Sz) //< a source newline inside a paragraph, read as one space
        r.add(' ', at)

    fn hard_break(r: Self$@, at: Sz, doc: Document$@, arena: Arena$@) //< an escaped newline
        r.flush(doc, arena)
        doc.inlines
            .push(Inline::{ .kind = .hard_break, .text = "", .offset = at, .look = plain_look() })

    fn finish(r: Self$@, doc: Document$@, arena: Arena$@): Sz //< how many nodes were collected
        r.flush(doc, arena)
        return doc.inlines.len - r.first

    priv fn add(r: Self$@, c: U8, at: Sz) //< one byte of literal text
        if r.pending.slice().len == 0
            r.pending_at = at
        r.pending.c(c)

    priv fn flush(r: Self$@, doc: Document$@, arena: Arena$@) //< pushes the pending text as a node
        if r.pending.slice().len == 0
            return
        doc.inlines
            .push(Inline::{ .kind = .text, .text = arena.dup_str(r.pending.slice()),
            .offset = r.pending_at, .look = plain_look() })
        r.pending.clear()

    priv fn code(r: Self$@, src: Source@, text: U8[], i: Sz, offset: Sz, doc: Document$@,
        arena: Arena$@): Sz!Diagnostic //<
            //< A code span from the run of backticks at `i` to the next run of the same length
        ticks: = run_of(text.sub_from(i), '`')
        j: = closing_run(text, i + ticks, ticks)
        if j < text.len
            r.flush(doc, arena)
            doc.inlines
                .push(Inline::{ .kind = .code,
                .text = unpadded(text.sub(i + ticks, j - i - ticks)), .offset = offset + i,
                .look = plain_look() })
            return j + ticks
        throw src.diagnostic(offset + i,
            "this code span is not closed on its line. Close it with a run of as many backticks")

    priv fn stars(r: Self$@, src: Source@, text: U8[], i: Sz, n: Sz, offset: Sz, marks: Marks$@,
        doc: Document$@, arena: Arena$@): Void!Diagnostic //<
            //< The run of `n` '*' at `i`: it closes marks innermost first, then opens marks
        found: = star_plans(marks, n)
        if found.count == 0
            throw src.diagnostic(offset + i,
                "this run of '*' can neither close the innermost mark nor open one. Write '\\*' for \
                    a literal '*'")
        later: = found.count > 1 && fits_next_run(marks, found.second, text, i + n)
        plan: = found.second if later else found.first
        r.flush(doc, arena)
        $at: = offset + i
        for _ in Range.asc(plan.closes)
            kind: = marks.pop()
            doc.inlines
                .push(Inline::{ .kind = end_of(kind), .text = "", .offset = at,
                .look = plain_look() })
            at += mark_width(kind)
        if plan.opens >= 1
            marks.push(plan.outer, at, doc.inlines.len)
            doc.inlines
                .push(Inline::{ .kind = plan.outer, .text = "", .offset = at,
                .look = plain_look() })
            at += mark_width(plan.outer)
        if plan.opens == 2
            marks.push(plan.inner, at, doc.inlines.len)
            doc.inlines
                .push(Inline::{ .kind = plan.inner, .text = "", .offset = at,
                .look = plain_look() })

    priv fn link_end(r: Self$@, src: Source@, text: U8[], i: Sz, offset: Sz, marks: Marks$@,
        doc: Document$@, arena: Arena$@): Sz!Diagnostic //<
            //< The `]` at `i`, then a destination in parentheses, a look in braces, or both
        if !marks.has(.link_start)
            throw src.diagnostic(offset + i, "this ']' ends no link. Write '\\]' for a literal ']'")
        top: = marks.depth - 1
        if marks.kinds[top] != .link_start
            throw src.diagnostic(marks.at[top], "close this mark before the ']' that ends its link")
        r.flush(doc, arena)
        start: = marks.node[top]
        $j: = i + 1
        $destination: U8[] = ""
        if j < text.len && text[j] == '('
            j += 1
            for j < text.len && text[j] != ')'
                if text[j] == ' ' || text[j] == '\t' || text[j] == '('
                    throw src.diagnostic(offset + j,
                        "a link's destination holds no spaces or parentheses. Write them as %20, \
                            %28 and %29")
                j += 1
            if j == text.len
                throw src.diagnostic(offset + i + 1, "this link's destination has no ')'")
            destination = text.sub(i + 2, j - i - 2)
            if !is_allowed_destination(destination)
                throw src.diagnostic(offset + i + 2,
                    "a link goes to an https:, http: or mailto: address, or to a '#' fragment")
            j += 1
        $look: = plain_look()
        if j < text.len && text[j] == '{'
            close: = brace_end(text, j)
            if close == text.len
                throw src.diagnostic(offset + j, "this look has no closing '}' on its line")
            attributes: = read_attributes(src, text, j + 1, close, offset, arena)!
            look = look_of(src, attributes@, offset + j, false)!
            j = close + 1
        if destination.len == 0 && is_plain(look)
            throw src.diagnostic(offset + i,
                "a label in brackets is followed by a destination in '(' and ')', or a look in '{' \
                    and '}'")
        if doc.inlines.len == start + 1
            throw src.diagnostic(marks.at[top],
                "this link has no label" if destination.len > 0 else "these brackets hold no text")
        doc.inlines
            .set(start,
            Inline::{ .kind = .link_start, .text = destination, .offset = marks.at[top],
            .look = look })
        _link: = marks.pop()
        doc.inlines
            .push(Inline::{ .kind = .link_end, .text = "", .offset = offset + i,
            .look = plain_look() })
        return j

impl Inline_reader: Manual_free //< `free()` lets go the pending text's buffer
    fn free(r: Self$@)
        r.pending.free()

priv struct Marks //< the marks open on the line being read, outermost first
    kinds: Inline_kind[3] //< emphasis, strong emphasis and a link: each is open once at most
    at: Sz[3] //< where each one opened, in the original bytes
    node: Sz[3] //< each one's start node in `Document.inlines`
    depth: Sz

impl Marks
    fn push(r: Self$@, kind: Inline_kind, at: Sz, node: Sz)
        r.kinds[r.depth] = kind
        r.at[r.depth] = at
        r.node[r.depth] = node
        r.depth += 1

    fn pop(r: Self$@): Inline_kind //< the innermost mark, which is no longer open
        r.depth -= 1
        return r.kinds[r.depth]

    fn has(r: Self@, kind: Inline_kind): Bool //< whether that kind is open
        return r.has_below(r.depth, kind)

    fn has_below(r: Self@, depth: Sz, kind: Inline_kind): Bool //< open among the outer `depth`
        for i in Range.asc(depth)
            if r.kinds[i] == kind
                return true
        return false

    fn apply(r: Self$@, plan: Star_plan) //< closes and opens what `plan` says, without nodes
        for _ in Range.asc(plan.closes)
            _closed: = r.pop()
        if plan.opens >= 1
            r.push(plan.outer, 0, 0)
        if plan.opens == 2
            r.push(plan.inner, 0, 0)

priv struct Star_plan //< one way a run of '*' closes and opens marks
    closes: Sz //< how many open marks it closes, innermost first
    opens: Sz //< how many it then opens: 0, 1 or 2
    outer: Inline_kind //< the first mark it opens
    inner: Inline_kind //< the second

priv struct Star_plans //< the ways a run can be read; two at most, which differ in opening order
    count: Sz
    first: Star_plan
    second: Star_plan

priv fn star_plans(marks: Marks@, n: Sz): Star_plans //<
    //< Every way a run of `n` '*' can close and open marks
    //< A run closes emphasis marks from the innermost, then opens kinds that are not open. It
    //< never opens the kind it closed last, since that pair would only continue the closed mark.
    //< Only a run of three with neither kind open has two readings: strong emphasis outside, or
    //< emphasis outside.
    none: = Star_plan::{ .closes = 0, .opens = 0, .outer = .text, .inner = .text }
    $found: = Star_plans::{ .count = 0, .first = none, .second = none }
    $closable: Sz = 0
    for closable < marks.depth && closable < 2 &&
        marks.kinds[marks.depth - 1 - closable] != .link_start
        closable += 1
    for closes in Range.asc(closable + 1)
        $width: Sz = 0
        for j in Range.asc(closes)
            width += mark_width(marks.kinds[marks.depth - 1 - j])
        last: = marks.kinds[marks.depth - closes] if closes > 0 else Inline_kind.text
        left: = marks.depth - closes
        for option in Range.asc(5)
            // 0 opens nothing; 1 emphasis; 2 strong; 3 emphasis, then strong; 4 the reverse
            emphasis_first: = option == 1 || option == 3
            outer: = Inline_kind.emphasis_start if emphasis_first else Inline_kind.strong_start
            inner: = Inline_kind.strong_start if option == 3 else Inline_kind.emphasis_start
            opens: Sz = 0 if option == 0 else 1 if option < 3 else 2
            $total: = width
            $fits: = true
            if opens >= 1
                total += mark_width(outer)
                fits = outer != last && !marks.has_below(left, outer)
            if opens == 2
                total += mark_width(inner)
                fits = fits && !marks.has_below(left, inner)
            if fits && total == n
                plan: = Star_plan::{ .closes = closes, .opens = opens, .outer = outer,
                    .inner = inner }
                if found.count == 0
                    found.first = plan
                else
                    found.second = plan
                found.count += 1
    return found

priv fn fits_next_run(marks: Marks@, plan: Star_plan, text: U8[], from: Sz): Bool //<
    //< Whether the next run of '*' on the line can be read after `plan`, or there is none
    next: = next_star_run(text, from)
    if next == 0
        return true
    $after: = marks$
    after.apply(plan)
    return star_plans(after@, next).count > 0

priv fn next_star_run(text: U8[], from: Sz): Sz //< the length of the next run of '*', or 0
    //< Escaped bytes and code spans are skipped, as the reader skips them.
    $i: = from
    for i < text.len
        if text[i] == '*'
            return run_of(text.sub_from(i), '*')
        if text[i] == '\\'
            i += 2
        else if text[i] == '`'
            ticks: = run_of(text.sub_from(i), '`')
            i = closing_run(text, i + ticks, ticks) + ticks
        else
            i += 1
    return 0

priv fn closing_run(text: U8[], from: Sz, ticks: Sz): Sz //<
    //< Where the next run of exactly `ticks` backticks starts, or the text's length
    $j: = from
    for j < text.len
        if text[j] != '`'
            j += 1
            continue
        run: = run_of(text.sub_from(j), '`')
        if run == ticks
            return j
        j += run
    return text.len

priv fn mark_width(kind: Inline_kind): Sz //< how many '*' write the mark
    return 1 if kind == .emphasis_start else 2

priv fn end_of(kind: Inline_kind): Inline_kind
    switch kind
    case .emphasis_start
        return .emphasis_end
    case .strong_start
        return .strong_end
    default
        return .link_end

priv fn unclosed(kind: Inline_kind): U8[] //< the refusal for a mark still open at the line's end
    switch kind
    case .emphasis_start
        return "this '*' is not closed on its line. Close it there, or write '\\*' for a literal \
            '*'"
    case .strong_start
        return "this '**' is not closed on its line. Close it there, or write '\\*\\*' for literal \
            asterisks"
    default
        return "this '[' is not closed on its line. Close it there, or write '\\[' for a literal \
            '['"

priv fn unpadded(code: U8[]): U8[] //< drops one space at each end when both ends have one
    //< That space lets a code span start or end with a backtick.
    if code.len >= 2 && code[0] == ' ' && code[code.len - 1] == ' ' &&
        code.trim_spaces().len > 0
        return code.sub(1, code.len - 2)
    return code

fn is_destination(text: U8[]): Bool //< whether a link to `text` reads back, as an editor needs
    for c in text
        if c == ' ' || c == '\t' || c == '(' || c == ')' || c == '\n' || c == '\r'
            return false
    return is_allowed_destination(text)

priv fn is_allowed_destination(destination: U8[]): Bool //< https, http, mailto, or a fragment
    return destination.len > "https:".len && destination.starts_with("https:") ||
        destination.len > "http:".len && destination.starts_with("http:") ||
        destination.len > "mailto:".len && destination.starts_with("mailto:") ||
        destination.len > 1 && destination.starts_with("#")

priv fn brace_end(text: U8[], from: Sz): Sz //< the `}` closing the brace at `from`, or the length
    $i: = from + 1
    for i < text.len && text[i] != '}'
        i = quoted_end(text, i) + 1 if text[i] == '"' else i + 1
    return i if i < text.len else text.len

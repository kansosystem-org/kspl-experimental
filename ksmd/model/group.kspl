//< A table's groups of rows and of columns, which show and hide together, as `groups` saves them
//< A group names its first and last data row, or column, by place, not by identity. Like a
//< column's width, it is part of the table's layout, so a sort or a moved row leaves it where it
//< stands. A line inserted inside a group joins it; a group whose lines are all removed goes. The
//< rows' groups and the columns' groups are two lists, and each follows the rules below alone.
//< Groups nest: one holds another whole, or the two share no row. Two groups that stand side by
//< side stay two groups.
import "ksmd/base/marker" { write_column }
import "ksmd/model/model" { Group, MAX_DEPTH, Table }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strnum"

enum Group_fault //< why a list of groups cannot be saved
    not_rows //< an entry is not `rows N`, `rows N-M`, `columns B`, `columns B-D` or one with
        //< ` closed`, or it names no data row or column
    out_of_order //< the entries are not from the top, then from the left, an outer group before
        //< the groups it holds
    crosses //< two groups share some rows but not all of the smaller one's
    twice //< two groups hold the same rows
    too_deep //< a row stands in more than `MAX_DEPTH` groups

fn fault_of(groups: List<|Group|>@): Group_fault? //<
    //< What is wrong with groups in the writer's order, or none
    defer scratch: = Arena(1024)
    $open: = List<|Group|>(scratch)
    for g in groups
        for open.len > 0 && open[open.len - 1].last < g.first
            open.remove_at(open.len - 1)
        if open.len > 0
            top: = open[open.len - 1]
            if top.first == g.first && top.last == g.last
                return .some(.twice)
            if g.last > top.last
                return .some(.crosses)
        open.push(g)
        if open.len > MAX_DEPTH
            return .some(.too_deep)
    return .none

fn comes_first(a: Group, b: Group): Bool //<
    //< Whether `a` stands before `b` in the writer's order: from the top, an outer group first
    return a.first < b.first || a.first == b.first && a.last > b.last

fn order(groups: List<|Group|>$@) //< puts the groups in the writer's order
    for i in Range(1, groups.len, 1)
        g: = groups[i]
        $j: = i
        for j > 0 && comes_first(g, groups[j - 1])
            groups[j] = groups[j - 1]
            j -= 1
        groups[j] = g

fn depths(groups: List<|Group|>@, out: List<|Sz|>$@) //<
    //< How many groups hold each group, in the writer's order: 0 for one that no group holds
    defer scratch: = Arena(1024)
    $open: = List<|Group|>(scratch)
    for g in groups
        for open.len > 0 && open[open.len - 1].last < g.first
            open.remove_at(open.len - 1)
        out.push(open.len)
        open.push(g)

fn innermost(groups: List<|Group|>@, first: Sz, last: Sz): Sz? //<
    //< The smallest group that holds the rows from `first` to `last`, by its place in the list
    $found: Sz? = .none
    for i in Range.asc(groups.len)
        g: = groups[i]
        if g.first > first || g.last < last
            continue
        if f: = found
            if g.last - g.first >= groups[f].last - groups[f].first
                continue
        found = .some(i)
    return found

fn after_insert(groups: List<|Group|>$@, at: Sz, count: Sz) //<
    //< Follows `count` lines inserted before the line at `at`
    for i in Range.asc(groups.len)
        if groups[i].first >= at
            groups[i].first += count
        if groups[i].last >= at
            groups[i].last += count

fn after_remove(groups: List<|Group|>$@, at: Sz) //<
    //< Follows the line at `at` removed: a group left with no line goes, and of two groups left
    //< holding the same lines the outer one stays
    $i: Sz = 0
    for i < groups.len
        $g: = groups[i]
        if g.first > at
            g.first -= 1
        gone: = g.first == at && g.last == at
        if g.last >= at && !gone
            g.last -= 1
        if gone ||
            i > 0 && groups[i - 1].first == g.first && groups[i - 1].last == g.last
            groups.remove_at(i)
            continue
        groups[i] = g
        i += 1

fn read_groups(text: U8[], t: Table$@): Void!Group_fault //<
    //< Adds the groups `rows 2-4, rows 6-9 closed, columns B-D` names, in the writer's order
    //< A row is numbered from 1 and a column lettered, as a formula names them. The rows' entries
    //< come first, so one set of groups has one spelling.
    $start: Sz = 0
    for start <= text.len
        $end: = start
        for end < text.len && text[end] != ','
            end += 1
        piece: = text.sub(start, end - start)
        columns: = piece.starts_with("columns ")
        if !columns && t.column_groups.len > 0
            throw .out_of_order
        groups: = t.column_groups@ if columns else t.groups@
        g: = entry(piece, t.columns.len if columns else t.rows.len, columns) catch
            throw .not_rows
        if groups.len > 0 && !comes_first(groups[groups.len - 1], g)
            if groups[groups.len - 1].first == g.first &&
                groups[groups.len - 1].last == g.last
                throw .twice
            throw .out_of_order
        groups.push(g)
        if end == text.len
            break
        if !text.starts_with(", ", end)
            throw .not_rows
        start = end + 2
    if f: = fault_of(t.groups@)
        throw f
    if f: = fault_of(t.column_groups@)
        throw f

priv fn entry(text: U8[], lines: Sz, columns: Bool): Group!Group_fault //<
    //< One entry: `rows 2-4` or `columns B-D`, maybe with ` closed`
    word: = "columns " if columns else "rows "
    if !text.starts_with(word)
        throw .not_rows
    $body: = text.sub_from(word.len)
    closed: = body.ends_with(" closed")
    if closed
        body = body.sub(0, body.len - 7)
    $dash: = body.len
    for i in Range.asc(body.len)
        if body[i] == '-'
            dash = i
            break
    first: = place_of(body.sub(0, dash), lines, columns)!
    $last: = first
    if dash < body.len
        last = place_of(body.sub_from(dash + 1), lines, columns)!
        if last <= first
            throw .not_rows
    return Group::{ .first = first, .last = last, .closed = closed }

priv fn place_of(text: U8[], lines: Sz, columns: Bool): Sz!Group_fault //<
    //< The place a row number or column letters name, from 0; one past `lines` is refused
    // One form only: a number written with a leading zero is refused, as the writer never writes
    // it.
    if !columns
        if text.starts_with("0")
            throw .not_rows
        n: = text.to_count(lines) catch
            throw .not_rows
        return n - 1
    $n: Sz = 0
    for c in text
        if !c.is_upper() || n > lines
            throw .not_rows
        n = n * 26 + Sz::(c - 'A') + 1
    if n == 0 || n > lines
        throw .not_rows
    return n - 1

fn write_groups(t: Table@, out: Str_builder$@) //< the value `read_groups` reads
    for i in Range.asc(t.groups.len)
        if i > 0
            out.s(", ")
        write_entry(t.groups[i], false, out)
    for i in Range.asc(t.column_groups.len)
        if i > 0 || t.groups.len > 0
            out.s(", ")
        write_entry(t.column_groups[i], true, out)

priv fn write_entry(g: Group, columns: Bool, out: Str_builder$@) //< `rows 2-4` or `columns B-D`
    out.s("columns " if columns else "rows ")
    write_place(g.first, columns, out)
    if g.last > g.first
        out.c('-')
        write_place(g.last, columns, out)
    if g.closed
        out.s(" closed")

priv fn write_place(at: Sz, columns: Bool, out: Str_builder$@) //<
    //< a row's number or a column's letters
    if columns
        write_column(at, out)
    else
        out.s("\{at + 1\}")

//< A table column's number format: how its numbers show, while each cell keeps its number
//< A table's `formats` attribute holds one entry per column: `number:2`, `grouped:2`, `percent:1`
//< or `currency:USD:2`, `date:yyyy/mm/dd` for dates, or nothing for a column without one. A format
//< rounds only what the page shows. Text, empty cells and errors show as they are.
//< The number's shortest decimal digits are rounded, half away from zero, so `2.675` shows as
//< `2.68`, as a person rounds the digits they read. A formula's `round` rounds by the same rule
//< (`round_places`).
import "std/chars"
import "std/str" { Str_builder }
import "std/strnum"

const MAX_PLACES: Sz = 9 //< the most digits a format shows after the decimal point

priv const DIGITS: Sz = 24 //< room for a number's shortest digits, which are at most 17

const GENERAL: U8[] = "general" //< a cell's own format that shows its value as calculated
    //< **A column has no such entry**: its empty entry says the same.

const SLASH_DATE: U8[] = "date:yyyy/mm/dd" //< the entry of a column that shows dates with `/`
    //< **Only the form other than the file's own is an entry.** A date shows as `2026-10-23` with
    //< no entry, so one format keeps one spelling.

enum Format_kind //< how a column shows its numbers
    none //< as calculated
    number //< fixed places, without thousands separators: `1234.50`
    grouped //< fixed places, with a `,` between each three digits: `1,234.50`
    percent //< the number times 100, grouped, then `%`: `12.5%`
    currency //< a currency's symbol, then the number grouped: `$1,234.50`
    slash_date //<
        //< a date as `2026/10/23`; numbers show as calculated, and no date shows `2026-10-23`
    general //< as calculated, whatever the column's format: a cell's own choice, never a column's

struct Number_format
    kind: Format_kind
    places: Sz //< the digits shown after the decimal point, 0 to 9
    code: U8[] //< a currency's three capital letters, as `USD`; empty for the other kinds

fn no_format(): Number_format //< a column that shows its numbers as calculated
    return Number_format::{ .kind = .none, .places = 0, .code = "" }

fn same_format(a: Number_format, b: Number_format): Bool
    return a.kind == b.kind && a.places == b.places && a.code.equals(b.code)

fn shows_numbers(f: Number_format): Bool //< whether a format changes how numbers show
    return f.kind != .none && f.kind != .slash_date && f.kind != .general

fn format_of(text: U8[]): Number_format? //<
    //< The format an entry of `formats` names, or no format for an empty entry; none if invalid
    if text.len == 0
        return .some(no_format())
    if text.equals(SLASH_DATE)
        return .some(Number_format::{ .kind = .slash_date, .places = 0, .code = "" })
    if text.equals(GENERAL)
        return .some(Number_format::{ .kind = .general, .places = 0, .code = "" })
    if text.len < 3 || text[text.len - 2] != ':' || !text[text.len - 1].is_digit()
        return .none
    $f: = no_format()
    f.places = text[text.len - 1] - '0'
    head: = text.sub(0, text.len - 2)
    if head.equals("number")
        f.kind = .number
    else if head.equals("grouped")
        f.kind = .grouped
    else if head.equals("percent")
        f.kind = .percent
    else if head.len == 12 && head.starts_with("currency:") && is_code(head.sub_from(9))
        f.kind = .currency
        f.code = head.sub_from(9)
    else
        return .none
    return .some(f)

fn currency_of(code: U8[]): Number_format? //<
    //< A currency's format, with the places its money is counted in; none for a code that is not
    //< three capital letters
    if !is_code(code)
        return .none
    places: Sz = 0 if code.equals("JPY") || code.equals("KRW") else 2
    return .some(Number_format::{ .kind = .currency, .places = places, .code = code })

fn write_format(f: Number_format, out: Str_builder$@) //< the entry `formats` holds; none is empty
    switch f.kind
    case .none
        return
    case .slash_date
        out.s(SLASH_DATE)
        return
    case .general
        out.s(GENERAL)
        return
    case .number
        out.s("number")
    case .grouped
        out.s("grouped")
    case .percent
        out.s("percent")
    case .currency
        out.s("currency:").s(f.code)
    out.c(':').c('0' + U8::f.places)

fn show(n: F64, f: Number_format, out: Str_builder$@) //< writes a finite number as `f` shows it
    //< A number that rounds to zero shows no minus sign: `-0.00` would read as a value below zero.
    $d: = digits_of(-n if n < 0.0 else n)
    if f.kind == .percent
        d.point += 2
    cut(d@, d.point + f.places)
    if n < 0.0 && d.count > 0
        out.c('-')
    if f.kind == .currency
        write_symbol(f.code, out)
    grouped: = f.kind != .number
    if d.point <= 0
        out.c('0')
    for i in Range.asc(d.point)
        if grouped && i > 0 && (d.point - i) % 3 == 0
            out.c(',')
        out.c(d.at(i))
    if f.places > 0
        out.c('.')
    for j in Range.asc(f.places)
        out.c(d.at(d.point + j))
    if f.kind == .percent
        out.c('%')

fn round_places(n: F64, places: Sz): F64? //<
    //< A finite number rounded to `places` decimal places as `show` rounds; none if too large
    //< A negative `places` rounds to tens, hundreds and on: `round_places(1250.0, -2)` is 1300.
    $d: = digits_of(-n if n < 0.0 else n)
    kept: = d.point + places
    if kept >= d.count
        return .some(n)
    cut(d@, kept)
    if d.count == 0
        return .some(0.0)
    defer $text: = Str_builder()
    if n < 0.0
        text.c('-')
    text.s("0.")
    for i in Range.asc(d.count)
        text.c(d.digits[i])
    text.s("e\{d.point\}")
    rounded: = text.slice().to_f64() catch
        return .none
    return .some(rounded)

priv struct Digits //< a number's decimal digits: its value is 0.d1d2… times 10 to `point`
    digits: U8[DIGITS] //< as ASCII, without leading or trailing zeros
    count: Sz
    point: Sz

impl Digits
    priv fn at(d: Self@, i: Sz): U8 //< the digit at place `i` from the first, or `0` past them
        return d.digits[i] if i >= 0 && i < d.count else '0'

priv fn digits_of(m: F64): Digits //< the shortest digits that read back as `m`, which is 0 or more
    $d: Digits = ::{}
    defer $text: = Str_builder()
    text.s("\{m\}")
    t: = text.slice()
    $seen_point: = false
    $i: Sz = 0
    for i < t.len && t[i] != 'e'
        c: = t[i]
        i += 1
        if c == '.'
            seen_point = true
            continue
        if c == '-' // a negative zero is written `-0.0`
            continue
        if !seen_point
            d.point += 1
        if c == '0' && d.count == 0
            d.point -= 1
        else if d.count < DIGITS
            d.digits[d.count] = c
            d.count += 1
    if i < t.len
        $exponent: Sz = 0
        for j in Range(i + 2, t.len, 1)
            exponent = exponent * 10 + Sz::(t[j] - '0')
        d.point += -exponent if t[i + 1] == '-' else exponent
    for d.count > 0 && d.digits[d.count - 1] == '0'
        d.count -= 1
    return d

priv fn cut(d: Digits$@, kept: Sz) //< keeps the first `kept` digits; a half rounds away from zero
    if kept < 0
        d.count = 0
    else if kept < d.count
        up: = d.digits[kept] >= '5'
        d.count = kept
        if up
            carry(d)

priv fn carry(d: Digits$@) //< adds one to the last digit; nines carry, and may add a digit
    for d.count > 0 && d.digits[d.count - 1] == '9'
        d.count -= 1
    if d.count == 0
        d.digits[0] = '1'
        d.count = 1
        d.point += 1
        return
    d.digits[d.count - 1] += 1U8

priv fn is_code(text: U8[]): Bool //< three capital letters, as ISO 4217 writes a currency
    return text.len == 3 && text[0].is_upper() && text[1].is_upper() && text[2].is_upper()

priv fn write_symbol(code: U8[], out: Str_builder$@) //<
    //< The symbol English text writes for a currency, or else its code and a no-break space
    //< A symbol that two currencies share is told apart, as `CA$` and `CN¥` are.
    if code.equals("USD")
        out.s("$")
    else if code.equals("EUR")
        out.s("€")
    else if code.equals("JPY")
        out.s("¥")
    else if code.equals("GBP")
        out.s("£")
    else if code.equals("CNY")
        out.s("CN¥")
    else if code.equals("KRW")
        out.s("₩")
    else if code.equals("INR")
        out.s("₹")
    else if code.equals("CAD")
        out.s("CA$")
    else if code.equals("AUD")
        out.s("A$")
    else
        out.s(code).s("\u00A0")

//< A column's colour rule, as the `rules` attribute saves it: a colour that follows each value
//< `rules=",<0;color:#9c0006 fill:#ffc7ce"` holds one entry per column, empty for none. An entry is
//< a condition, `;`, then the colours its cells take while the condition holds:
//< `<5` below 5, `>5` above 5, `=5` or `=Done` equal to it, and `empty` an empty cell. `color:` is
//< the text's colour and `fill:` the background's; the rule's colours stand over the cell's own.
//< Text compares without regard to case, as the filter compares it. A text in a rule has no `,`,
//< `;`, `"` or `\`, and no space at either end.
//< `scale;from:#ffffff to:#ffef9c` is a colour scale: each number's cell takes a fill between the
//< two, from the least number to the greatest. The table's columns with the same scale share
//< one least and one greatest, so a block of columns compares as one.
import "ksmd/base/marker" { is_decimal }
import "ksmd/model/look" { is_colour }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }

priv const MAX_TEXT: Sz = 100 //< the bytes of a rule's text

enum Rule_kind
    none //< the column has no rule
    below
    above
    equal
    empty
    scale //< a fill from `color` at the least number to `fill` at the greatest

struct Rule //< one column's rule
    kind: Rule_kind
    value: U8[] //< what `below`, `above` and `equal` compare with, as written
    color: U8[] //< the text's colour while it holds, `#` and six hex digits in lower case; or empty
        //< For a scale, the fill at the least number.
    fill: U8[] //< the background's, the same way; for a scale, the fill at the greatest number

fn no_rule(): Rule
    return Rule::{ .kind = .none, .value = "", .color = "", .fill = "" }

fn rule_of(entry: U8[], arena: Arena$@): Rule? //<
    //< The rule an entry names; an empty entry is no rule, and none where it is not one
    if entry.len == 0
        return .some(no_rule())
    semi: = entry.find_str(";") catch
        return .none
    condition: = entry.sub(0, semi)
    $r: = no_rule()
    if condition.equals("scale")
        return scale_of(entry.sub_from(semi + 1), arena)
    if condition.equals("empty")
        r.kind = .empty
    else if condition.starts_with("<") || condition.starts_with(">")
        r.kind = .below if condition[0] == '<' else .above
        r.value = condition.sub_from(1)
        if !is_decimal(r.value)
            return .none
    else if condition.starts_with("=")
        r.kind = .equal
        r.value = condition.sub_from(1)
        if !is_text(r.value)
            return .none
    else
        return .none
    c: = colours_of(entry.sub_from(semi + 1), arena) catch
        return .none
    r.color = c.color
    r.fill = c.fill
    return .some(r)

struct Colours //< a text's colour and a background's, either of which may be empty
    color: U8[]
    fill: U8[]

fn colours_of(text: U8[], arena: Arena$@): Colours? //<
    //< `color:#rrggbb`, then `fill:#rrggbb`, either or both, a space between; in lower case
    //< A rule's colours and a choice's are written so.
    $c: = Colours::{ .color = "", .fill = "" }
    $rest: = text
    if rest.starts_with("color:")
        c.color = (rest.sub(6, 7) if rest.len >= 13 else "").to_lower_ascii(arena)
        if !is_colour(c.color)
            return .none
        rest = rest.sub_from(13)
        if rest.len > 0
            if !rest.starts_with(" ")
                return .none
            rest = rest.sub_from(1)
    if rest.starts_with("fill:")
        c.fill = (rest.sub(5, 7) if rest.len >= 12 else "").to_lower_ascii(arena)
        if !is_colour(c.fill)
            return .none
        rest = rest.sub_from(12)
    if rest.len > 0 || c.color.len == 0 && c.fill.len == 0
        return .none
    return .some(c)

fn write_colours(c: Colours, out: Str_builder$@) //< what `colours_of` reads
    if c.color.len > 0
        out.s("color:").s(c.color)
    if c.fill.len > 0
        if c.color.len > 0
            out.c(' ')
        out.s("fill:").s(c.fill)

priv fn scale_of(rest: U8[], arena: Arena$@): Rule? //< `from:#ffffff to:#ffef9c`, after `scale;`
    if rest.len != 23 || !rest.starts_with("from:") || !rest.starts_with(" to:", 12)
        return .none
    $r: = no_rule()
    r.kind = .scale
    r.color = rest.sub(5, 7).to_lower_ascii(arena)
    r.fill = rest.sub(16, 7).to_lower_ascii(arena)
    if !is_colour(r.color) || !is_colour(r.fill)
        return .none
    return .some(r)

fn write_rule(r: Rule, out: Str_builder$@) //< the entry `rule_of` reads; nothing for no rule
    switch r.kind
    case .none
        return
    case .scale
        out.s("scale;from:").s(r.color).s(" to:").s(r.fill)
        return
    case .below
        out.c('<').s(r.value)
    case .above
        out.c('>').s(r.value)
    case .equal
        out.c('=').s(r.value)
    case .empty
        out.s("empty")
    out.c(';')
    write_colours(Colours::{ .color = r.color, .fill = r.fill }, out)

fn has_rule(rules: List<|Rule|>@): Bool //< whether any column has a rule
    for r in rules
        if r.kind != .none
            return true
    return false

fn same_rule(a: Rule, b: Rule): Bool
    return a.kind == b.kind && a.value.equals(b.value) && a.color.equals(b.color) &&
        a.fill.equals(b.fill)

priv fn is_text(text: U8[]): Bool //< a text a rule can hold: 1 to 100 bytes, as the head says
    if text.len == 0 || text.len > MAX_TEXT || text.trim_spaces().len != text.len
        return false
    for c in text
        if c < 0x20U8 || c == 0x7FU8 || c == ',' || c == ';' || c == '"' || c == '\\'
            return false
    return true

//< Builds the page's wasm for `ksmd/Makefile` (`ksmd/port/wasm.kspl` holds the steps):
//<     ksplc run port/wasm_build.kspl <ksplc> <entry> <out.wasm> <imports> <work> <deps>
import "ksmd/port/wasm" { Wasm_build, build }
import "std/io"
import "std/mem" { Arena }
import "std/sys"

fn main(): I32
    defer arena: = Arena(1 << 20)
    a: = sys.args()
    if a.len != 7
        io.err().s("usage: wasm_build <ksplc> <entry> <out.wasm> <imports> <work> <deps>\n")
        return 2
    b: = Wasm_build::{ .ksplc = a.get(1), .entry = a.get(2), .out = a.get(3),
        .imports = a.get(4), .work = a.get(5), .cwd = "", .deps = a.get(6),
        .options = U8[][]::{} }
    build(b@, arena) catch why
        io.err().s(why).c('\n')
        return 1
    return 0

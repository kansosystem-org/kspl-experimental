//< Builds a person's own functions into the wasm the page's worker runs
//<     own_build <file> <shown> <digest> [<ksplc> <sources>]
//< `<file>` is the person's `.kspl` file; `<shown>` is how messages name it, its path from the
//< workspace. `<digest>` is the SHA-256 of the bytes the person allowed: other bytes are not
//< built. The wasm goes to standard output and exit 0; a failure is a message on standard error
//< and exit 1, for the clause. The local server runs it with three arguments, and it finds
//< `ksplc` and ksmd's sources from its own place (`tools_near`). It reads nothing else.
//<
//< The steps, in a scratch folder removed at the end:
//<
//< 1. The person's file is copied in as `own/functions.kspl`, in a package that names itself
//<    (`own/ksplc.cfg`) and uses only ksmd. **This closes the build**: a path that climbs out of
//<    the folder, or names any other package, is a compile error, for an `embed` too.
//< 2. `ksplc doc` lists its `pub fn`s; `ksmd/calc/glue.kspl` writes their table as
//<    `entry/table.kspl`, and refuses a name ksmd already has.
//< 3. `entry/main.kspl`, the entry (`ENTRY`), hands the table to `ksmd/port/own/serve.kspl`. Both
//<    stand in the package `entry`, with its own `ksplc.cfg`, as `own` may write no `extern fn`.
//< 4. `ksmd/port/wasm.kspl` builds the entry, with ksmd's sources as the place packages are found.
//<    **`--closed=own` closes `own` to C too**, so no assembler `.include` reads a file elsewhere.
import "ksmd/calc/calc" { known }
import "ksmd/calc/glue"
import "ksmd/port/wasm" { Wasm_build, build, step }
import "std/chars" // `starts_with`
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/sha256"
import "std/str"
import "std/sys"

priv const PERSON: U8[] = "own/functions.kspl" //< the person's file in the scratch folder
priv const SERVER_MS: I64 = 60000I64 //< how long the local server waits for one build
    //< It is the 60 s of "Building a page's own functions" in `docs/SPEC-local-server.md`. Past it,
    //< the server kills this program, and the scratch folder stays.
priv const LIMIT_MS: I64 = SERVER_MS - 10000I64 //< how long every step may take together
    //< **It ends before the server's limit**, so this program removes its own scratch folder. The
    //< 10 s left cover its start and the removal.

priv const ENTRY: U8[][_] = ::{ "//< A person's own functions, as the page's worker calls them",
        "import \"ksmd/port/own/serve\"", "import \"entry/table\"",
        "import \"ksmd/calc/help\" { Help }", "",
        "extern fn ksmd_own_call(len: Sz): Sz //< answers the call in the input; the answer's \
            length", "    return serve.answer(len, table.call)", "",
        "extern fn ksmd_own_names(): Sz //< the functions' names, one per line, in the output",
        "    return serve.names(U8[][]::table.NAMES)", "",
        "extern fn ksmd_own_help(): Sz //< what a person reads of each, as JSON, in the output",
        "    return serve.help(Help[]::table.HELP)",
} //< the entry's lines, the same for every person

priv const PACKAGE: U8[] = "[package]\nname = own\nuses = ksmd\n" //< `own/ksplc.cfg`
priv const ENTRY_PACKAGE: U8[] = "[package]\nname = entry\nuses = own ksmd\n" //<
    //< `entry/ksplc.cfg`

priv const SCRATCH: U8[][_] = ::{ "own/ksplc.cfg", "own/functions.kspl", "entry/ksplc.cfg",
    "entry/table.kspl", "entry/main.kspl", "functions.tsv", "c/module.c", "c/module.o", "own.wasm",
    "own", "entry", "c" } //< Every file and folder a build makes, removed in this order

struct Tools //< what a build runs
    ksplc: U8[]
    sources: U8[] //< the folder that holds `ksmd/`, where the entry's imports are found
    std: U8[] //< the standard library's folder, or empty where ksplc finds its own

fn main(): I32
    defer arena: = Arena(4 * 1024 * 1024)
    a: = sys.args()
    if a.len != 4 && a.len != 6
        io.err().s("usage: own_build <file> <shown> <digest> [<ksplc> <sources>]\n")
        return 2
    $t: = Tools::{ .ksplc = "", .sources = "", .std = "" }
    if a.len == 6
        t = Tools::{ .ksplc = a.get(4), .sources = a.get(5), .std = "" }
    else if found: = tools_near(arena)
        t = found
    else
        io.err()
            .s("ksmd cannot build functions here: ksplc or ksmd's sources are not installed beside \
                \{sys.program_name()\}. Run `make install` again\n")
        return 1
    wasm: = own_wasm(a.get(1), a.get(2), a.get(3), t, arena) catch why
        io.err().s(why)
        if why.len == 0 || why[why.len - 1] != '\n'
            io.err().c('\n')
        return 1
    io.out().s(wasm).flush()
    return 0

fn tools_near(arena: Arena$@): Tools? //<
    //< `ksplc` and ksmd's sources, from where this program stands
    //< **Two places, each as `make` lays it out**: installed, it is in `<prefix>/lib/kspl/ksmd/`
    //< with the sources in `src/` and `ksplc` in `<prefix>/bin/`; built in the repository, it is in
    //< `out/` beside the compiler, under the sources' root. `make install` names the compiler
    //< `ksplc.exe` on Windows and `ksplc` elsewhere.
    $buf: U8[4096] = ::{}
    exe: = sys.exe_path(U8$[]::buf) catch
        return .none
    // **Copied out of `buf`**, which ends with this function while the paths are used after it.
    here: = arena.dup_str(sys.get_dir_name(exe))
    up: = sys.get_dir_name(sys.get_dir_name(sys.get_dir_name(here)))
    installed: = Tools::{ .ksplc = fs.join(fs.join(up, "bin", arena),
        "ksplc.exe" if sys.is_windows() else "ksplc", arena),
        .sources = fs.join(here, "src", arena), .std = "" }
    // **The repository's compiler has no `std/` beside it**: make names it each time.
    root: = sys.get_dir_name(here)
    built: = Tools::{ .ksplc = fs.join(here, "ksplc_stage1.exe", arena), .sources = root,
        .std = fs.join(root, "std", arena) }
    for t in Tools[]::{ installed, built }
        if fs.can_run(t.ksplc) &&
            fs.exists(fs.join(t.sources, "ksmd/port/own/serve.kspl", arena))
            return .some(t)
    return .none

fn own_wasm(file: U8[], shown: U8[], digest: U8[], t: Tools, arena: Arena$@): U8[]!U8[] //<
    //< The wasm of the functions in `file`, or why there is none, naming the file as `shown`
    //< **Only bytes whose SHA-256 is `digest` are built**, read once, so a file that changed after
    //< the person allowed it is refused.
    source: = io.read_file(file, arena) catch
        throw arena.text().s("cannot read \{shown\}\n").take()
    $hex: U8[sha256.HEX_LEN] = ::{}
    sha256.write_hex(sha256.hash(source), U8$[]::hex)
    if !(U8[]::hex).equals(digest)
        throw arena.text()
            .s("\{shown\} changed after its functions were allowed. Allow them again\n").take()
    $buf: U8[4096] = ::{}
    exe: = sys.exe_path(U8$[]::buf).unwrap_or("")
    ends: = sys.deadline_after_ms(LIMIT_MS)
    base: = fs.join(sys.get_dir_name(exe), "tmp", arena)
    clean_stale(base, arena)
    work: = fs.mkdir_unique(base, PREFIX, arena) catch
        throw arena.text().s("cannot make a scratch folder in \{base\}\n").take()
    defer clean(work, arena)
    got: = steps(source, shown, t, work, ends, arena) catch why
        throw why.replace(PERSON, shown, arena)
    return got

priv fn steps(source: U8[], shown: U8[], t: Tools, work: U8[], ends: I64, arena: Arena$@):
    U8[]!U8[] //<
        //< The build's steps in `work` on the person's `source`; a message names their file as it
        //< stands there
    fs.mkdir_all(fs.join(work, "own", arena)) catch
        throw arena.text().s("cannot write in \{work\}\n").take()
    put(work, "own/ksplc.cfg", PACKAGE, arena)!
    put(work, PERSON, source, arena)!
    $options: = List<|U8[]|>(arena)
    options.push(arena.text().s("--pkg-src-dir=").s(t.sources).take())
    if t.std.len > 0
        options.push(arena.text().s("--std-dir=").s(t.std).take())
    tsv: = fs.join(work, "functions.tsv", arena)
    $doc: = List<|U8[]|>(arena)
    doc.push_all(U8[][]::{ t.ksplc, "doc" })
    doc.push_all(options.slice())
    doc
        .push_all(U8[][]::{ arena.text().s("--emit-surface=").s(tsv).take(), "own/functions" })
    step(doc.slice(), work, ends, arena)!
    rows: = io.read_file(tsv, arena) catch
        throw "ksplc doc listed no functions\n"
    fns: = glue.functions_of(rows, arena) catch why
        throw arena.text().s(PERSON).s(": ").s(why).c('\n').take()
    if fns.len == 0
        throw arena.text().s(PERSON).s(": no `pub fn` a formula can call\n").take()
    for i in Range.asc(fns.len)
        name: = fns.get(i).name
        if known(name)
            throw arena.text().s(PERSON)
                .s(": ksmd has a function `\{name\}` of its own. Name yours otherwise\n").take()
    entry: = arena.text()
    for line in ENTRY
        entry.s(line).c('\n')
    fs.mkdir_all(fs.join(work, "entry", arena)) catch
        throw arena.text().s("cannot write in \{work\}\n").take()
    put(work, "entry/ksplc.cfg", ENTRY_PACKAGE, arena)!
    put(work, "entry/table.kspl", glue.table_source(fns@, "own/functions", shown, arena), arena)!
    put(work, "entry/main.kspl", entry.take(), arena)!
    options.push("--closed=own")
    out: = fs.join(work, "own.wasm", arena)
    b: = Wasm_build::{ .ksplc = t.ksplc, .entry = "entry/main.kspl", .out = out,
        .imports = fs.join(t.sources, "ksmd/port/own/imports.txt", arena),
        .work = fs.join(work, "c", arena), .cwd = work, .deps = "", .options = options.slice(),
        .ends = ends }
    build(b@, arena)!
    return io.read_file(out, arena) catch
        throw "the build wrote no wasm\n"

priv fn put(work: U8[], name: U8[], text: U8[], arena: Arena$@): Void!U8[] //< writes one file
    io.write_file(fs.join(work, name, arena), text) catch
        throw arena.text().s("cannot write \{name\} in \{work\}\n").take()

priv const PREFIX: U8[] = "own-build-" //< the start of every scratch folder's name

priv fn clean_stale(base: U8[], arena: Arena$@) //< removes scratch folders a killed build left
    //< **Only one older than the server's limit**: the build that made it has ended, since the
    //< server kills it there. A folder still in use is younger.
    names: = fs.read_dir(base, arena) catch
        return
    now: = sys.wall_seconds()
    for name in names
        if !name.starts_with(PREFIX)
            continue
        work: = fs.join(base, name, arena)
        info: = fs.stat(work) catch
            continue
        if fs.is_dir(work) && !fs.is_link(work) && (now - info.mtime) * 1000I64 > SERVER_MS
            clean(work, arena)

priv fn clean(work: U8[], arena: Arena$@) //< removes the scratch folder and what a build made
    for name in SCRATCH
        fs.remove_path(fs.join(work, name, arena)) catch {}
    fs.remove_path(work) catch {}

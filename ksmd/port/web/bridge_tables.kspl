//< The page's actions on tables and charts, through the bridge in `bridge.kspl`
//< Each starts and answers as the bridge's other actions do (`begin`, `result`); here stand those
//< that add a table, change its rows, columns and cells, paste or copy a grid, or set a chart,
//< and what the page shows of each function a formula calls.
//< `extern` names a symbol, not an import, so each action is in the page's wasm wherever it
//< stands.
import "ksmd/calc/formula" { Positions, attachable, cycle_fixed }
import "ksmd/calc/functions_table" as table
import "ksmd/calc/help" { FORMS, Help, write_json }
import "ksmd/calc/value"
import "ksmd/edit/editor" { Refused }
import "ksmd/edit/editor_charts" { Chart_settings }
import "ksmd/edit/editor_tables" { Copied_at, Group_edit, Table_edit }
import "ksmd/model/format" { currency_of, format_of, show_plain, write_format }
import "ksmd/model/look" { Look_part }
import "ksmd/model/model" { MAX_ROWS }
import "ksmd/port/web/bridge_session" { begin, done, ed, ensure, full, number, out, refused, result,
    text_in }
import "ksmd/syntax/chart" { kind_of }
import "ksmd/syntax/clause" { parse_widths }
import "ksmd/syntax/writer"
import "std/chars"
import "std/ds" { List }
import "std/json"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strnum"

extern fn ksmd_web_insert_table(columns: Sz, rows: Sz): Sz //<
    //< a new table in place of the selection
    if !begin()
        return full()
    return done(ed.insert_table(columns, rows))

extern fn ksmd_web_remove_table(block: Sz): Sz
    if !begin()
        return full()
    return done(ed.remove_table(block))

extern fn ksmd_web_table_edit(block: Sz, what: I32, at: Sz, count: Sz, len: Sz): Sz //<
    //< 0 inserts `count` rows before row `at`, 1 removes `count` from it, 2 and 3 do so with
    //< columns
    //< A removal of rows leaves those written in, as `ksmd_web_set_heights` takes rows: the rows
    //< hidden (`Editor.edit_table`).
    if !begin()
        return full()
    edit: Table_edit =
        (.insert_row if what == 0 else .remove_row if what == 1 else .insert_column if what == 2
        else .remove_column)
    defer scratch: = Arena(64 * 1024)
    $left_out: = rows_in(len, scratch) catch e
        return refused(e)
    return done(ed.edit_table(block, edit, at, count, left_out.slice()))

extern fn ksmd_web_move_lines(block: Sz, rows: I32, first: Sz, count: Sz, at: Sz): Sz //<
    //< Moves `count` data rows (`rows` 1) or columns (0) from `first` to stand before the one at
    //< `at`; at the count, after the last
    if !begin()
        return full()
    return done(ed.move_lines(block, rows != 0, first, count, at))

extern fn ksmd_web_move_cells(block: Sz, top: Sz, left: Sz, height: Sz, width: Sz, to_row: Sz,
    to_column: Sz): Sz //<
        //< Moves the `height` by `width` cells at `top`, `left` to stand from `to_row`,
        //< `to_column`, as a paste after a cut does; row -1 is the names
    if !begin()
        return full()
    return done(ed.move_cells(block, top, left, height, width, to_row, to_column))

extern fn ksmd_web_set_cell(block: Sz, row: Sz, column: Sz, len: Sz): Sz //<
    //< Puts typed text in a cell; row -1 names a column
    if !begin()
        return full()
    return done(ed.set_cell(block, row, column, text_in(len)))

extern fn ksmd_web_cell_look(block: Sz, from_row: Sz, from_column: Sz, to_row: Sz, to_column: Sz,
    part: I32, len: Sz): Sz //<
        //< Sets one part of the look of a rectangle of cells: 0 the text's colour, 1 the
        //< background's, 2 the font size in points, 3 the alignment, 4 every part, 5 the cell's own
        //< number format, as `formats` writes an entry or `general`, 6 the wrapping of its text,
        //< `on`; empty text clears it
    if !begin()
        return full()
    which: Look_part =
        (.color if part == 0 else .fill if part == 1 else .size if part == 2
        else .align if part == 3 else .format if part == 5 else .wrap if part == 6 else .all)
    return done(ed.set_look(block, from_row, from_column, to_row, to_column, which, text_in(len)))

extern fn ksmd_web_cell_places(block: Sz, from_row: Sz, from_column: Sz, to_row: Sz, to_column: Sz,
    more: I32): Sz //<
        //< One more (1), or one fewer (0), decimal place in each cell of a rectangle
    if !begin()
        return full()
    return done(ed.step_cell_places(block, from_row, from_column, to_row, to_column, more != 0))

extern fn ksmd_web_cell_currency(block: Sz, from_row: Sz, from_column: Sz, to_row: Sz,
    to_column: Sz, len: Sz): Sz //<
        //< Shows the cells' numbers as money in the currency written in, as `USD`
    if !begin()
        return full()
    f: = currency_of(text_in(len)) catch
        return refused(.table(.not_a_format))
    defer $entry: = Str_builder()
    write_format(f, entry@)
    looked: = ed.set_look(block, from_row, from_column, to_row, to_column, .format,
        entry.slice())
    return done(looked)

extern fn ksmd_web_paste_cells(block: Sz, row: Sz, column: Sz, len: Sz): Sz //<
    //< Pastes a grid, written in as a JSON array of rows of strings, into a table from a cell
    if !begin()
        return full()
    defer scratch: = Arena(64 * 1024)
    grid: = grid_in(len, scratch)
    return done(ed.paste_cells(block, row, column, grid@))

extern fn ksmd_web_paste_copied(block: Sz, row: Sz, column: Sz, bottom: Sz, right: Sz, from_row: Sz,
    from_column: Sz, len: Sz): Sz //<
        //< Pastes cells copied in ksmd into the range from `row`, `column` to `bottom`, `right`
        //< They are written in as `{"cells":…,"rows":[…]}`: `cells` a grid as
        //< `ksmd_web_paste_cells` takes one, and `rows` the row each line was copied from, or
        //< empty (`Copied_at.rows`). `from_row` and `from_column` name the cell they were copied
        //< from, and the formulas shift by the distance; `from_column` -1 pastes the texts
        //< unshifted, as Paste values does.
    if !begin()
        return full()
    defer scratch: = Arena(64 * 1024)
    $grid: = List<|List<|U8[]|>|>(scratch)
    $rows: = List<|Sz|>(scratch)
    doc: = json.parse(text_in(len), scratch) catch
        return refused(.table(.outside))
    for line in doc.val.get("cells").arr_list(scratch)
        $cells: = List<|U8[]|>(scratch)
        for cell in line.arr_list(scratch)
            cells.push(cell.as_str().unwrap_or(""))
        grid.push(cells)
    for at in doc.val.get("rows").arr_list(scratch)
        n: = number(at)
        if n < -1
            return refused(.table(.outside))
        rows.push(n)
    $from: Copied_at? = .none
    if from_column >= 0
        from =
            .some(Copied_at::{ .row = from_row, .column = from_column, .rows = rows.slice() })
    return done(ed.paste_copied(block, row, column, bottom, right, grid@, from))

extern fn ksmd_web_copied_cells(block: Sz, top: Sz, left: Sz, bottom: Sz, right: Sz, len: Sz): Sz //<
    //< What a copy of a rectangle of cells carries for a paste in ksmd, written to the output
    //< (`Editor.copied_cells`); empty outside a table
    //< The rows the copy leaves out are written in as `ksmd_web_set_heights` takes rows.
    ensure()
    out.clear()
    defer scratch: = Arena(16 * 1024)
    $left_out: = rows_in(len, scratch) catch
        return 0
    ed.copied_cells(block, top, left, bottom, right, left_out.slice(), out) catch
        out.clear()
    return out.slice().len

extern fn ksmd_web_cycle_fixed(from: Sz, to: Sz, len: Sz): Sz //<
    //< The open cell's text written in, with `$` turned in the references from byte `from` to
    //< byte `to` (`cycle_fixed`): `{"text":…,"at":…}`, `at` the byte where the last one turned
    //< ends; empty where the text is no formula or holds no reference there
    ensure()
    text: = text_in(len)
    out.clear()
    if text.len == 0 || text[0] != '='
        return 0
    defer $turned: = Str_builder()
    turned.c('=')
    at: = cycle_fixed(text.sub_from(1), from - 1, to - 1, turned@)
    if at < 0
        return 0
    out.s("{\"text\":\"").escape_and_append(turned.slice()).s("\",\"at\":\{at\}}")
    return out.slice().len

extern fn ksmd_web_references(block: Sz, len: Sz): Sz //<
    //< The references of a typed formula that name cells, as taking it attaches them
    //< The text is typed into a cell of the table block `block` shows (`attachable`). Each
    //< reference is `[from, to, table, row, column, row, column, whole]`: its bytes in the text,
    //< its table's place, and its corners as written, counted from 0. Empty for no formula.
    ensure()
    out.clear()
    text: = text_in(len)
    if text.len == 0 || text[0] != '=' || block < 0 || block >= ed.doc.blocks.len ||
        ed.doc.blocks.get(block).kind != .table
        return 0
    home: = ed.doc.blocks.get(block).first
    formula: = text.sub_from(1)
    out.c('[')
    $at: Sz = 0
    for
        found: = attachable(ed.doc@, home, formula, at) catch
            break
        tok: = found.token
        if at > 0
            out.c(',')
        out.s("[\{tok.start + 1\},\{tok.end + 1\},\{found.piece.table\},\{tok.from.row\},")
        out.s("\{tok.from.column\},\{tok.to.row\},\{tok.to.column\},\{tok.whole\}]")
        at = tok.end
    out.c(']')
    return out.slice().len

extern fn ksmd_web_paste_table(len: Sz): Sz //<
    //< Puts a new table made from a grid, written in as `ksmd_web_paste_cells` takes it
    if !begin()
        return full()
    defer scratch: = Arena(64 * 1024)
    grid: = grid_in(len, scratch)
    return done(ed.insert_grid(grid@))

extern fn ksmd_web_paste_ksmd(len: Sz): Sz //<
    //< Puts the table of the ksmd source written in after the caret's paragraph, as a copy left it
    if !begin()
        return full()
    return done(ed.paste_table(text_in(len)))

extern fn ksmd_web_block_source(block: Sz): Sz //<
    //< a source that holds that block alone, for a copy
    ensure()
    out.clear()
    if block >= 0 && block < ed.doc.blocks.len
        writer.write_one(ed.doc@, block, out)
    return out.slice().len

priv fn grid_in(len: Sz, scratch: Arena$@): List<|List<|U8[]|>|> //<
    //< The grid the script wrote in; text that is not one reads as an empty grid
    $grid: = List<|List<|U8[]|>|>(scratch)
    doc: = json.parse(text_in(len), scratch) catch
        return grid
    for line in doc.val.arr_list(scratch)
        $cells: = List<|U8[]|>(scratch)
        for cell in line.arr_list(scratch)
            cells.push(cell.as_str().unwrap_or(""))
        grid.push(cells)
    return grid

extern fn ksmd_web_sort(block: Sz, column: Sz, descending: I32): Sz //<
    //< Orders a table's data rows by one column's values; 1 sorts descending
    if !begin()
        return full()
    return done(ed.sort_table(block, column, descending == 1))

extern fn ksmd_web_group(block: Sz, how: I32, columns: I32, first: Sz, last: Sz): Sz //<
    //< Groups the data rows, or with `columns` 1 the columns, from `first` to `last` (how 0), takes
    //< away the smallest group that holds them (1), hides that group's lines (2) or shows them (3)
    if how < 0 || how > 3 || columns < 0 || columns > 1
        return result(false, "")
    if !begin()
        return full()
    what: Group_edit =
        (.group if how == 0 else .ungroup if how == 1 else .hide if how == 2 else .show)
    return done(ed.group_lines(block, columns == 1, first, last, what))

extern fn ksmd_web_choices(block: Sz, column: Sz, len: Sz): Sz //<
    //< Gives a column the choices typed as `Open, Done` in the `len` bytes written in; none for empty
    if !begin()
        return full()
    return done(ed.set_choices(block, column, text_in(len)))

extern fn ksmd_web_rule(block: Sz, column: Sz, len: Sz): Sz //<
    //< Gives a column the colour rule an entry names, `<0;color:#9c0006`, in the `len` bytes
    //< written in; none for empty
    if !begin()
        return full()
    return done(ed.set_rule(block, column, text_in(len)))

extern fn ksmd_web_table_caption(block: Sz, len: Sz): Sz //<
    //< Gives a table the caption in the `len` bytes written in; takes it away with none
    if !begin()
        return full()
    return done(ed.set_caption(block, text_in(len)))

extern fn ksmd_web_merge(block: Sz, column: Sz, on: I32): Sz //<
    //< Shows a column's repeated values once (on 1), or each again (0)
    if !begin()
        return full()
    return done(ed.set_merged(block, column, on == 1))

extern fn ksmd_web_row_colors(block: Sz, column: Sz): Sz //<
    //< Colours a table's rows by the choice a column holds, or no row with -1
    if !begin()
        return full()
    return done(ed.set_row_colors(block, column))

extern fn ksmd_web_insert_chart(block: Sz): Sz //< a bar chart of a table, after the table
    if !begin()
        return full()
    return done(ed.insert_chart(block))

extern fn ksmd_web_set_chart(block: Sz, len: Sz): Sz //<
    //< New settings for a chart, written in as JSON: `{"t":table,"k":"bar","l":labels column,
    //< "v":[columns],"title":text}`, the columns by their places; by rows, also `"r":1`, `"v"` the
    //< rows' places, and `"f"` and `"e"` the first and last columns drawn
    if !begin()
        return full()
    defer scratch: = Arena(16 * 1024)
    doc: = json.parse(text_in(len), scratch) catch
        return result(false, "The chart's settings did not arrive whole, so nothing changed.")
    $values: = List<|Sz|>(scratch)
    for v in doc.val.get("v").arr_list(scratch)
        values.push(number(v))
    kind: = kind_of(doc.val.get("k").as_str().unwrap_or("")) catch
        return result(false, "A chart is a bar chart or a line chart.")
    settings: = Chart_settings::{ .table = number(doc.val.get("t")), .kind = kind,
        .labels = number(doc.val.get("l")), .values = values,
        .title = doc.val.get("title").as_str().unwrap_or(""),
        .by_rows = number(doc.val.get("r")) == 1, .from = number(doc.val.get("f")),
        .to = number(doc.val.get("e")) }
    return done(ed.set_chart(block, settings@))

extern fn ksmd_web_cell_note(block: Sz, row: Sz, column: Sz, len: Sz): Sz //<
    //< Gives a cell the note in the `len` bytes written in; resolves it with none
    if !begin()
        return full()
    return done(ed.set_cell_note(block, row, column, text_in(len)))

extern fn ksmd_web_cell_link(block: Sz, row: Sz, column: Sz, len: Sz): Sz //<
    //< Gives a text cell the link in the `len` bytes written in; takes it away with none
    if !begin()
        return full()
    return done(ed.set_cell_link(block, row, column, text_in(len)))

extern fn ksmd_web_fill(block: Sz, top: Sz, left: Sz, height: Sz, width: Sz, bottom: Sz, right: Sz,
    series: I32, len: Sz): Sz //<
        //< Copies the `height` by `width` cells at `top`, `left` over the range up to `bottom`,
        //< `right`, repeating them, as fill down and fill right do; 1 in `series` goes on with a
        //< series where the cells make one, as the fill handle does
        //< The rows the fill leaves out are written in as `ksmd_web_set_heights` takes rows.
    if !begin()
        return full()
    defer scratch: = Arena(16 * 1024)
    $left_out: = rows_in(len, scratch) catch e
        return refused(e)
    filled: = ed.fill_cells(block, top, left, height, width, bottom, right, series == 1,
        left_out.slice())
    return done(filled)

extern fn ksmd_web_table_texts(block: Sz): Sz //<
    //< Each cell's text as a person edits it, names first: `[[name,…],[cell,…],…]`, written to the
    //< output; empty outside a table. A search reads it.
    ensure()
    out.clear()
    if block < 0 || block >= ed.doc.blocks.len ||
        ed.doc.blocks.get(block).kind != .table
        return 0
    u: = ed.doc.blocks.get(block).first
    t: = ed.doc.tables[u]@
    defer scratch: = Arena(64 * 1024)
    at: = Positions(ed.doc@, scratch)
    out.c('[')
    for r in Range(-1, t.rows.len, 1)
        out.s("[" if r < 0 else ",[")
        for c in Range.asc(t.columns.len)
            if c > 0
                out.c(',')
            defer cell: = Arena(1024)
            out.c('"').escape_and_append(ed.cell_text_at(u, r, c, at@, cell)).c('"')
        out.c(']')
    out.c(']')
    return out.slice().len

extern fn ksmd_web_set_widths(block: Sz, len: Sz): Sz //<
    //< Gives the table's columns the widths written in, as `char_widths` holds them: `12,,8.5`
    if !begin()
        return full()
    defer scratch: = Arena(4096)
    $widths: = List<|Sz|>(scratch)
    if !parse_widths(text_in(len), widths@)
        return refused(.table(.not_widths))
    return done(ed.set_widths(block, widths@))

extern fn ksmd_web_set_filter(block: Sz, column: Sz, len: Sz): Sz //<
    //< Gives a column the filter entry written in, empty for none; column -1 clears every column's
    if !begin()
        return full()
    return done(ed.set_filter(block, column, text_in(len)))

extern fn ksmd_web_set_heights(block: Sz, len: Sz, points: Sz): Sz //<
    //< Gives the data rows written in, from 0, as `0,2,3`, a height in points; 0 takes it away
    if !begin()
        return full()
    defer scratch: = Arena(64 * 1024)
    $rows: = rows_in(len, scratch) catch e
        return refused(e)
    return done(ed.set_heights(block, rows.slice(), points))

extern fn ksmd_web_clear_cells(block: Sz, top: Sz, left: Sz, bottom: Sz, right: Sz, len: Sz): Sz //<
    //< Empties the cells from `top`, `left` to `bottom`, `right`, but those on the rows written in
    //< as `ksmd_web_set_heights` takes rows (`Editor.clear_cells`)
    if !begin()
        return full()
    defer scratch: = Arena(64 * 1024)
    $left_out: = rows_in(len, scratch) catch e
        return refused(e)
    return done(ed.clear_cells(block, top, left, bottom, right, left_out.slice()))

priv fn rows_in(len: Sz, scratch: Arena$@): List<|Sz|>!Refused //<
    //< The data rows the script wrote in, from 0, as `0,2,3`; none for no text
    text: = text_in(len)
    $rows: = List<|Sz|>(scratch)
    if text.len == 0
        return rows
    $start: Sz = 0
    for i in Range.asc(text.len + 1)
        if i < text.len && text[i] != ','
            continue
        row: = text.sub(start, i - start).to_count(MAX_ROWS) catch
            throw .table(.outside)
        rows.push(row)
        start = i + 1
    return rows

extern fn ksmd_web_column_format(block: Sz, first: Sz, last: Sz, len: Sz): Sz //<
    //< Gives columns `first` to `last` the number format written in, as `formats` writes one
    //< entry, as `grouped:2`; empty clears it
    if !begin()
        return full()
    f: = format_of(text_in(len)) catch
        return refused(.table(.not_a_format))
    return done(ed.set_format(block, first, last, f))

extern fn ksmd_web_column_currency(block: Sz, first: Sz, last: Sz, len: Sz): Sz //<
    //< Shows the columns' numbers as money in the currency written in, as `USD`
    if !begin()
        return full()
    f: = currency_of(text_in(len)) catch
        return refused(.table(.not_a_format))
    return done(ed.set_format(block, first, last, f))

extern fn ksmd_web_column_places(block: Sz, first: Sz, last: Sz, more: I32): Sz //<
    //< Shows one more decimal place in the formatted columns, or one fewer for `more` 0
    if !begin()
        return full()
    return done(ed.step_places(block, first, last, more == 1))

extern fn ksmd_web_rename_table(block: Sz, len: Sz): Sz
    if !begin()
        return full()
    return done(ed.rename_table(block, text_in(len)))

extern fn ksmd_web_show_number(n: F64): Sz //<
    //< A number the page worked out, such as a sum, as a cell shows it without a format
    //< **The page writes no number itself**: a second rule would round some numbers differently.
    //< A sum too large for a number shows `#NUM!`, as a formula's would.
    ensure()
    out.clear()
    v: = value.number(n)
    if v.kind == .error
        out.s(v.error.mark())
    else
        show_plain(n, out)
    return out.slice().len

extern fn ksmd_web_cell_text(block: Sz, row: Sz, column: Sz): Sz //<
    //< The text a cell shows to edit, written to the output; empty outside a table
    ensure()
    out.clear()
    if block < 0 || block >= ed.doc.blocks.len ||
        ed.doc.blocks.get(block).kind != .table
        return 0
    u: = ed.doc.blocks.get(block).first
    t: = ed.doc.tables[u]@
    if column < 0 || column >= t.columns.len || row < -1 || row >= t.rows.len
        return 0
    defer scratch: = Arena(16 * 1024)
    out.s(ed.cell_text(u, row, column, scratch))
    return out.slice().len

extern fn ksmd_web_functions(): Sz //<
    //< Every function of ksmd's own a formula calls, as a JSON array in the output; its length
    //< The forms come first, then the table's (`ksmd/calc/help.kspl`). A person's own come from
    //< the worker that runs them (`ksmd_own_help` in `ksmd/port/own_build.kspl`).
    ensure()
    out.clear()
    write_json(Help[][]::{ Help[]::FORMS, Help[]::table.HELP }, out)
    return out.slice().len

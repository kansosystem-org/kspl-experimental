//< What the page shows of a document, written as JSON for the page's script to build HTML from
//< A block is an object with a kind letter `k`: `p`, `h`, `c`, `l`, `q` quote, `d` divider, `t`,
//< `g` chart, `i` and `n` include. A list item has its depth `d`, `o` 1 when numbered, and `x` 1
//< or 2 for an open or a ticked box. Text is a list of segments `{"t":…,"m":…,"l":…}`: `m` adds 1
//< for emphasis, 2 strong, 4 code; `l` is a link's destination; a hard break is `{"br":1}`. A cell
//< is `[kind]` or `[kind, value]`: 0 empty, 1 number, 2 text, 3 an error's mark, 4 a truth value,
//< 5 a date. A spot is `[place, block, item, offset]`: place 0 text, 1 a block's gap, 2 an item's.
//< An include and an image add where their path leads (`to`) and any problem (`why`), and an
//< include its file's blocks (`inside`).
//< Caution: **Change this and `ksmd/port/web/view.js` together**; the script reads these shapes.
import "ksmd/base/dates" { write_date, write_date_with }
import "ksmd/base/keyed" { Keyed }
import "ksmd/calc/calc" { Results }
import "ksmd/calc/calc"
import "ksmd/calc/value" { Value }
import "ksmd/edit/editor" { Editor }
import "ksmd/edit/region" { Spot, Style, Unit, gather }
import "ksmd/edit/styled" { Seg }
import "ksmd/files/assemble" { Assembly, NONE }
import "ksmd/model/format" { Number_format, no_format, show, shows_numbers }
import "ksmd/model/group" { depths }
import "ksmd/model/look" { is_plain }
import "ksmd/model/model" { Block_kind, Chart, Document, UNBOUND }
import "ksmd/model/rule" { no_rule }
import "ksmd/syntax/chart" { column_at }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }

struct Inside //< what includes and images show: the view assembled from the files fetched
    a: Assembly
    top: List<|Sz|> //< the entry of each block of the open document
    values: List<|Results?|> //< each source's values by its index, calculated when first shown
    waiting: Keyed<|Bool|> //< the paths not fetched yet; their clauses show no problem
    today: U8[] //< the date the open document was opened, which its included sources take too
    arena: Arena$@

impl Inside
    fn new(a: Assembly, waiting: Keyed<|Bool|>, today: U8[], arena: Arena$@): Inside //<
        //< The open document is the view's first source
        $top: = List<|Sz|>(arena)
        for e in Range.asc(a.entries.len)
            if a.entries.get(e).instance == 0
                top.push(e)
        $values: = List<|Results?|>(arena)
        for _ in Range.asc(a.sources.len)
            values.push(.none)
        return Inside::{ .a = a, .top = top, .values = values, .waiting = waiting, .today = today,
            .arena = arena }

    priv fn values_of(r: Self$@, source: Sz): Results
        if found: = r.values.get(source)
            return found
        src: = r.a.sources.get(source)
        got: = calc.calculate(src.doc@, r.today, r.arena)
        r.values.set(source, .some(got))
        return got

fn blocks(ed: Editor@, from: Sz, to: Sz, values: Results@, inside: Inside$@, out: Str_builder$@) //<
    //< The blocks from `from` to `to`, as a JSON list; `inside` is null where no file is fetched
    defer scratch: = Arena(16 * 1024)
    out.c('[')
    for b in Range(from, to, 1)
        if b > from
            out.c(',')
        entry: = inside.top.get(b) if inside != null && b < inside.top.len else NONE
        block(ed.doc@, b, values, out, scratch, inside, entry)
    out.c(']')

fn tables(ed: Editor@, from: Sz, to: Sz, values: Results@, out: Str_builder$@) //<
    //< Each table and chart block outside `from` to `to`, as a JSON list of `[block, block's JSON]`
    //< A chart draws a table's values, so it is shown again whenever the tables are.
    defer scratch: = Arena(16 * 1024)
    out.c('[')
    $first: = true
    for b in Range.asc(ed.doc.blocks.len)
        kind: = ed.doc.blocks.get(b).kind
        if b >= from && b < to || kind != .table && kind != .chart
            continue
        if !first
            out.c(',')
        first = false
        out.s("[\{b\},")
        block(ed.doc@, b, values, out, scratch, null, NONE)
        out.c(']')
    out.c(']')

fn selection(ed: Editor@, out: Str_builder$@) //< `{"a":spot,"f":spot,"g":style}`
    out.s("{\"a\":")
    spot(ed.anchor, out)
    out.s(",\"f\":")
    spot(ed.focus, out)
    out.s(",\"g\":")
    style(ed.gap, out)
    out.c('}')

priv fn spot(p: Spot, out: Str_builder$@)
    place: = 0 if p.place == .text else 1 if p.place == .block_gap else 2
    out.s("[\{place\},\{p.block\},\{p.item\},\{p.offset\}]")

priv fn style(s: Style, out: Str_builder$@) //< `{"k":kind,"n":level,"d":depth,"o":0 or 1}`
    out.s("{\"k\":\"").s(kind_letter(s.kind)).s("\",\"n\":\{s.level\},\"d\":\{s.depth\},\"o\":")
    out.s("1}" if s.ordered else "0}")

priv fn kind_letter(kind: Block_kind): U8[]
    switch kind
    case .paragraph
        return "p"
    case .heading
        return "h"
    case .code
        return "c"
    case .list
        return "l"
    case .table
        return "t"
    case .image
        return "i"
    case .include
        return "n"
    case .chart
        return "g"
    case .quote
        return "q"
    case .divider
        return "d"

priv fn block(doc: Document@, b: Sz, values: Results@, out: Str_builder$@, scratch: Arena$@,
    inside: Inside$@, entry: Sz) //<
        //< One block; `entry` is its entry in `inside`'s view, or `NONE`
    x: = doc.blocks.get(b)
    out.s("{\"k\":\"").s(kind_letter(x.kind)).c('"')
    if x.invisible
        out.s(",\"iv\":1")
    switch x.kind
    case .paragraph, .heading, .code, .list, .quote
        $units: = List<|Unit|>(scratch)
        gather(doc, b, b + 1, units@, scratch)
        if x.kind == .heading
            out.s(",\"n\":\{x.level\}")
        if x.align != .none
            out.s(",\"a\":")
            text(x.align.name(), out)
        if x.note.len > 0
            out.s(",\"no\":")
            text(x.note, out)
        if x.kind == .code
            out.s(",\"label\":")
            text(x.label, out)
            out.s(",\"t\":")
            text(units[0].segs[0].text, out)
        else if x.kind == .list
            out.s(",\"items\":[")
            for i in Range.asc(units.len)
                if i > 0
                    out.c(',')
                u: = units[i]@
                out.s("{\"d\":\{u.style.depth\},\"o\":").s("1" if u.style.ordered else "0")
                // A checklist item's box: 1 open, 2 ticked.
                if u.style.check != .none
                    out.s(",\"x\":").s("1" if u.style.check == .open else "2")
                out.s(",\"s\":")
                segs(u.segs@, out)
                out.c('}')
            out.c(']')
        else
            out.s(",\"s\":")
            segs(units[0].segs@, out)
    case .table
        table(doc, x.first, values, out)
    case .chart
        chart(doc, doc.charts[x.first]@, values, out)
    case .divider {}
    case .image
        image: = doc.images.get(x.first)
        out.s(",\"src\":")
        text(image.src, out)
        out.s(",\"alt\":")
        text(image.alt, out)
        out.s(",\"cap\":")
        text(image.caption, out)
        if entry != NONE
            aim(inside, entry, out)
    case .include
        out.s(",\"path\":")
        text(x.text, out)
        if entry != NONE
            aim(inside, entry, out)
            included(inside, entry, out, scratch)
    out.c('}')

priv fn aim(inside: Inside$@, entry: Sz, out: Str_builder$@) //<
    //< `"to"`, where a clause's path leads, and `"why"` with its place where it is refused. The
    //< place is named only inside another file than the clause's. A file not fetched yet waits.
    target: = inside.a.entries.get(entry).target
    out.s(",\"to\":")
    text(target, out)
    if inside.waiting.get(target).is_some()
        out.s(",\"wait\":1")
        return
    if p: = inside.a.problem_at(entry)
        at: = inside.a.problems.get(p).at
        out.s(",\"why\":")
        text(at.message, out)
        if !at.path.equals(inside.a.source_of(entry).path)
            out.s(",\"in\":")
            text(at.path, out)
            out.s(",\"line\":\{at.line\},\"column\":\{at.column\}")

priv fn included(inside: Inside$@, entry: Sz, out: Str_builder$@, scratch: Arena$@) //<
    //< `"inside"`: the blocks of the instance an include opens, each nested include in turn
    opens: = inside.a.entries.get(entry).opens
    if opens == NONE
        return
    child: = inside.a.instances.get(opens)
    source: = inside.a.sources.get(child.source)
    values: = inside.values_of(child.source)
    out.s(",\"inside\":[")
    $first: = true
    for k in Range(child.first, child.first + child.count, 1)
        e: = inside.a.entries.get(k)
        if e.instance != opens
            continue
        if !first
            out.c(',')
        first = false
        block(source.doc@, e.block, values@, out, scratch, inside, k)
    out.c(']')

priv fn segs(list: List<|Seg|>@, out: Str_builder$@)
    out.c('[')
    for i in Range.asc(list.len)
        if i > 0
            out.c(',')
        s: = list[i]
        if s.hard
            out.s("{\"br\":1}")
            continue
        m: Sz =
            (1 if s.marks.emphasis else 0) + (2 if s.marks.strong else 0) + (4 if s.marks.code
            else 0)
        out.s("{\"t\":")
        text(s.text, out)
        out.s(",\"m\":\{m\}")
        if s.marks.link.len > 0
            out.s(",\"l\":")
            text(s.marks.link, out)
        if s.marks.color.len > 0
            out.s(",\"co\":")
            text(s.marks.color, out)
        out.c('}')
    out.c(']')

priv fn table(doc: Document@, u: Sz, values: Results@, out: Str_builder$@) //<
    //< `"name"`, the column weights `"w"`, the rows' heights `"h"`, the columns' filters `"fl"`, the column names, the identities of the rows (`"ri"`)
    //< and columns (`"ci"`), the groups of rows (`"g"`), and each data row's values
    t: = doc.tables[u]@
    out.s(",\"u\":\{u\},\"name\":")
    text(t.name, out)
    out.s(",\"w\":[")
    for i in Range.asc(t.weights.len)
        if i > 0
            out.c(',')
        out.s("\{t.weights[i]\}")
    // Each data row's least height in points, 0 for none.
    out.s("],\"h\":[")
    defer tall: = Arena(16 * 1024)
    $by_id: = List<|Sz|>(tall)
    for _ in Range.asc(t.next_id)
        by_id.push(0)
    for h in t.heights
        by_id[h.row] = h.points
    for r in Range.asc(t.rows.len)
        if r > 0
            out.c(',')
        out.s("\{by_id[t.rows[r]]\}")
    // Each column's filter entry (`ksmd/model/filter.kspl`), empty for none.
    out.s("],\"fl\":[")
    for c in Range.asc(t.columns.len)
        if c > 0
            out.c(',')
        $entry: U8[] = ""
        for f in t.filters
            entry = f.entry if f.column == t.columns[c] else entry
        text(entry, out)
    out.s("],\"names\":[")
    for c in Range.asc(t.columns.len)
        if c > 0
            out.c(',')
        text(t.cells[c].text, out)
    out.s("],\"looks\":[")
    $any: = false
    for i in Range.asc(t.cells.len)
        l: = t.cells[i].look
        if is_plain(l)
            continue
        if any
            out.c(',')
        any = true
        // [row, column, colour, fill, size in half points, alignment]; row -1 is the names.
        out.s("[\{i / t.columns.len - 1\},\{i % t.columns.len\},")
        text(l.color, out)
        out.c(',')
        text(l.fill, out)
        out.s(",\{l.size\},")
        text(l.align.name(), out)
        out.c(']')
    // Each note as [row, column, text].
    out.s("],\"notes\":[")
    $noted: = false
    for i in Range.asc(t.cells.len)
        if t.cells[i].note.len == 0
            continue
        if noted
            out.c(',')
        noted = true
        out.s("[\{i / t.columns.len - 1\},\{i % t.columns.len\},")
        text(t.cells[i].note, out)
        out.c(']')
    // The identities of the rows and columns, which a range of chosen cells keeps to.
    out.s("],\"ri\":[")
    ids(t.rows@, out)
    out.s("],\"ci\":[")
    ids(t.columns@, out)
    // Each column's choices, a list of texts, empty for a column that takes any value.
    out.s("],\"ch\":[")
    for c in Range.asc(t.columns.len)
        if c > 0
            out.c(',')
        out.c('[')
        if t.choices.len > 0
            entry: = t.choices[c]
            $start: Sz = 0
            for i in Range.asc(entry.len + 1)
                if entry.len > 0 && (i == entry.len || entry[i] == '|')
                    if start > 0
                        out.c(',')
                    text(entry.sub(start, i - start), out)
                    start = i + 1
        out.c(']')
    // Each column's colour rule as [condition, value, colour, fill], or null for none.
    out.s("],\"ru\":[")
    for c in Range.asc(t.columns.len)
        if c > 0
            out.c(',')
        r: = t.rules[c] if t.rules.len > 0 else no_rule()
        if r.kind == .none
            out.s("null")
            continue
        out.c('[')
        text(r.kind.variant_name(), out)
        out.c(',')
        text(r.value, out)
        out.c(',')
        text(r.color, out)
        out.c(',')
        text(r.fill, out)
        out.c(']')
    // Each group as [first row, last row, 1 if hidden, how many groups hold it].
    out.s("],\"g\":[")
    defer scratch: = Arena(1024)
    $deep: = List<|Sz|>(scratch)
    depths(t.groups@, deep@)
    for i in Range.asc(t.groups.len)
        g: = t.groups[i]
        if i > 0
            out.c(',')
        out.s("[\{g.first\},\{g.last\},\{1 if g.closed else 0\},\{deep[i]\}]")
    out.s("],\"rows\":[")
    for r in Range.asc(t.rows.len)
        if r > 0
            out.c(',')
        out.c('[')
        for c in Range.asc(t.columns.len)
            if c > 0
                out.c(',')
            // A cell's own format stands over its column's.
            own: = t.cells[t.at(r, c)].look.format
            column: = t.formats[c] if t.formats.len > 0 else no_format()
            cell(values.at(u, r, c), own if own.kind != .none else column, out)
        out.c(']')
    out.s("]")

priv fn chart(doc: Document@, c: Chart@, values: Results@, out: Str_builder$@) //<
    //< `"kind"`, `"title"`, the table's place `"u"` and columns' names `"cols"`, the labels
    //< column's place `"l"` and the drawn columns' `"v"`, then each row's label (`"lab"`) and each
    //< drawn column's numbers (`"ser"`, null for a cell that holds none). `"why"` says what is
    //< missing where the chart cannot be drawn.
    out.s(",\"kind\":\"").s("bar" if c.kind == .bar else "line").s("\",\"title\":")
    text(c.title, out)
    bound: =
        c.table != UNBOUND && c.table < doc.tables.len &&
        doc.tables[c.table].name.len > 0
    defer $why: = Str_builder()
    if !bound
        why.s("No table named \"").s(c.name).s("\" stands in this file.")
        out.s(",\"why\":")
        text(why.slice(), out)
        return
    t: = doc.tables[c.table]@
    out.s(",\"u\":\{c.table\},\"cols\":[")
    for k in Range.asc(t.columns.len)
        if k > 0
            out.c(',')
        text(t.cells[k].text, out)
    labels: = column_at(t, c.labels)
    $missing: U8[] = c.label_name if labels == UNBOUND else ""
    out.s("],\"l\":\{labels\},\"v\":[")
    for j in Range.asc(c.series.len)
        at: = column_at(t, c.series[j])
        if at == UNBOUND && missing.len == 0
            missing = c.series_names[j]
        if j > 0
            out.c(',')
        out.s("\{at\}")
    out.c(']')
    if missing.len > 0
        why.s("No column named \"").s(missing).s("\" stands in table \"").s(t.name).s("\".")
        out.s(",\"why\":")
        text(why.slice(), out)
        return
    out.s(",\"lab\":[")
    for r in Range.asc(t.rows.len)
        if r > 0
            out.c(',')
        label(values.at(c.table, r, labels), out)
    out.s("],\"ser\":[")
    for j in Range.asc(c.series.len)
        at: = column_at(t, c.series[j])
        if j > 0
            out.c(',')
        out.s("{\"n\":")
        text(t.cells[at].text, out)
        out.s(",\"v\":[")
        for r in Range.asc(t.rows.len)
            if r > 0
                out.c(',')
            v: = values.at(c.table, r, at)
            if v.kind == .number
                out.s("\{v.number\}")
            else
                out.s("null")
        out.s("]}")
    out.c(']')

priv fn label(v: Value, out: Str_builder$@) //< a value as a chart's label shows it
    switch v.kind
    case .number
        out.s("\"\{v.number\}\"")
    case .text
        text(v.text, out)
    case .date
        out.c('"')
        write_date(I64::v.number, out)
        out.c('"')
    case .boolean
        out.s("\"true\"" if v.boolean else "\"false\"")
    case .error
        text(v.error.mark(), out)
    case .empty
        out.s("\"\"")

priv fn ids(list: List<|Sz|>@, out: Str_builder$@) //< numbers separated by commas
    for i in Range.asc(list.len)
        if i > 0
            out.c(',')
        out.s("\{list[i]\}")

priv fn cell(v: Value, f: Number_format, out: Str_builder$@) //<
    //< `[kind, value]`; a number in a column with a format adds the text the format shows, and a
    //< date is `[5, "2026-10-23"]`
    switch v.kind
    case .empty
        out.s("[0]")
    case .number
        out.s("[1,\{v.number\}")
        if shows_numbers(f)
            out.s(",\"")
            show(v.number, f, out)
            out.c('"')
        out.c(']')
    case .text
        out.s("[2,")
        text(v.text, out)
        out.c(']')
    case .date
        out.s("[5,\"")
        write_date(I64::v.number, out)
        if f.kind == .slash_date
            out.s("\",\"")
            write_date_with(I64::v.number, '/', out)
        out.s("\"]")
    case .boolean
        out.s("[4,\"true\"]" if v.boolean else "[4,\"false\"]")

    case .error
        out.s("[3,")
        text(v.error.mark(), out)
        out.c(']')

priv fn text(s: U8[], out: Str_builder$@) //< a JSON string
    out.c('"').escape_and_append(s).c('"')

//< The bridge between the ksmd page's script and the editor, built for the browser as wasm32
//< The script writes text into the input buffer (`ksmd_web_in`) and calls an action by its
//< `extern` name. Each action writes a JSON result to the output (`ksmd_web_out_ptr` and
//< `ksmd_web_out_len`): whether it was taken, the blocks it changed, the selection, and whether
//< undo and redo can run. Numbers cross as arguments; no struct crosses.
//< Where the local server serves the page, the script also hands in the document's path and each
//< file the view asks for (`ksmd_web_wanted`, `ksmd_web_hold`).
//< This file holds the actions on the text and on files. What every action shares, the memory,
//< the open document and the result, is `bridge_session.kspl`.
import "ksmd/base/source" { Diagnostic, MAX_SOURCE_BYTES, Source }
import "ksmd/edit/editor" { Input }
import "ksmd/edit/editor"
import "ksmd/edit/editor_diagrams" // `insert_diagram`, `set_diagram`
import "ksmd/edit/editor_drawings" // `set_drawings`
import "ksmd/edit/editor_looks"
import "ksmd/edit/editor_replace" { Cell_text, Span }
import "ksmd/edit/editor_settings" // `set_settings`
import "ksmd/edit/history" { Change }
import "ksmd/edit/region" { Place, Spot, paragraph_style }
import "ksmd/edit/styled" { Mark }
import "ksmd/files/fetched" { Fetched, Held }
import "ksmd/files/files" { Refusal, resolve_text }
import "ksmd/files/image" { measure }
import "ksmd/model/model" { Settings }
import "ksmd/port/web/bridge_own" { own_functions } // a person's own functions, and their actions
import "ksmd/port/web/bridge_session" { HEAP_BYTES, RESERVE, assembled, begin, doc_path, ed, ensure,
    fetched, files, full, here, loading, number, out, refused, release_input, result, result_with,
    session, text_in }
import "ksmd/port/web/bridge_tables" as _tables // the table actions; this brings them into the wasm
import "ksmd/port/web/moving"
import "ksmd/syntax/reader"
import "ksmd/syntax/settings" { fault_of, is_empty }
import "ksmd/syntax/writer"
import "std/chars"
import "std/ds" { List }
import "std/json"
import "std/mem" + { Arena }
import "std/str" { Str_builder }

extern fn ksmd_web_recover() //< frees a document whose reading stopped when memory ran out
    if loading != null
        loading.free()
        loading = null

extern fn ksmd_web_load(len: Sz, year: I32, month: I32, day: I32): I32 //<
    //< Opens the `len` bytes of source written in, on this date; 1 if it opened
    //< A refused source leaves the open document as it was, and the result names the place. The
    //< date is what `today()` gives until the next document opens.
    ensure()
    out.clear()
    loading = Arena(64 * 1024)
    bytes: = loading.dup_str(text_in(len))
    src: = Source("document.ksmd", bytes) catch d
        return refuse_source(d)
    doc: = reader.read(src@, loading) catch d
        return refuse_source(d)
    if mem.heap_used_bytes() + RESERVE > HEAP_BYTES
        loading.free()
        loading = null
        out.s("{\"ok\":false,\"why\":\"This document is too large for the editor's memory.\"}")
        return 0
    session.free()
    session = loading
    loading = null
    ed = session
        .create(editor.open(doc, date_text(year, month, day, session), session))
    // **The page's own functions stay**: the script changes them once it sees the new clauses.
    ed.own = own_functions()
    release_input()
    out.s("{\"ok\":true}")
    return 1

priv fn date_text(year: I32, month: I32, day: I32, arena: Arena$@): U8[] //< `2026-10-23`
    b: = arena.text()
    for place in I32[]::{ 1000, 100, 10, 1 }
        b.c('0' + U8::(year / place % 10))
    b.c('-').c('0' + U8::(month / 10 % 10)).c('0' + U8::(month % 10))
    b.c('-').c('0' + U8::(day / 10 % 10)).c('0' + U8::(day % 10))
    return b.take()

extern fn ksmd_web_source_limit(): Sz //<
    //< the most bytes a source may hold; the script reads one more
    return MAX_SOURCE_BYTES

extern fn ksmd_web_resolve(len: Sz): Sz //< a path typed or linked, from the workspace root
    //< `{"ok":true,"path":…}`, or `{"ok":false,"why":…}` for a refused path. The local server
    //< refuses a link along it when the file is fetched.
    ensure()
    out.clear()
    defer scratch: = Arena(4096)
    path: = resolve_text("", text_in(len), scratch) catch why
        out.s("{\"ok\":false,\"why\":\"").escape_and_append(why.message()).s("\"}")
        return out.slice().len
    out.s("{\"ok\":true,\"path\":\"").escape_and_append(path).s("\"}")
    return out.slice().len

extern fn ksmd_web_place(len: Sz) //<
    //< names the open document's path; what was fetched is forgotten
    ensure()
    if files != null
        files.free()
    files = Arena(64 * 1024)
    doc_path = files.dup_str(text_in(len))
    fetched = files.create(Fetched(files))

extern fn ksmd_web_forget() //<
    //< forgets what was fetched, so the next view fetches every file again
    ensure()
    if fetched == null
        return
    // Caution: **Copy the path before the old arena goes**: it lives there.
    was: = files
    files = Arena(64 * 1024)
    doc_path = files.dup_str(doc_path)
    fetched = files.create(Fetched(files))
    was.free()

extern fn ksmd_web_hold(path_len: Sz, len: Sz, status: I32) //<
    //< Keeps the local server's answer for one path: the path, then `len` bytes, are written in.
    //< `status` 0 is found, 1 nothing there, 2 refused by the server (a link), 3 unreadable and 4
    //< a folder or a device. An image's bytes stay with the script.
    ensure()
    if fetched == null
        return
    both: = text_in(path_len + len)
    why: Refusal =
        (.missing if status == 1 else .link if status == 2 else .unreadable if status == 3
        else .not_file)
    fetched.hold(both.sub(0, path_len),
        Held::{ .found = status == 0, .why = why, .bytes = both.sub_from(path_len) })
    release_input()

extern fn ksmd_web_wanted(): Sz //< the files the view still lacks: `[{"p":path,"i":0 or 1}]`
    //< `i` is 1 for an image, where only whether a file stands there is asked.
    ensure()
    out.clear()
    out.c('[')
    if fetched != null
        defer scratch: = Arena(64 * 1024)
        _view: = assembled(scratch)
        for i in Range.asc(fetched.wanted.len)
            w: = fetched.wanted.get(i)
            if i > 0
                out.c(',')
            out.s("{\"p\":\"").escape_and_append(w.path).s("\",\"i\":")
                .s("1}" if w.image else "0}")
    out.c(']')
    return out.slice().len

extern fn ksmd_web_image(at: Sz, total: Sz, len: Sz): Sz //<
    //< What a window of an image's bytes tells: `{"t":type,"w":…,"h":…}`, `{"why":…}`, or
    //< `{"more":at}` to pass the bytes from `at`. The window is written in.
    ensure()
    out.clear()
    switch measure(text_in(len), at, total)
    case .size(s)
        out.s("{\"t\":\"").s(s.format.mime()).s("\",\"w\":\{s.width\},\"h\":\{s.height\}}")
    case .refused(why)
        out.s("{\"why\":\"").escape_and_append(why.message()).s("\"}")
    case .more(next)
        out.s("{\"more\":\{next\}}")
    release_input()
    return out.slice().len

priv fn refuse_source(d: Diagnostic): I32 //< `{"ok":false,"why":…,"line":…,"column":…}`
    out.s("{\"ok\":false,\"why\":\"").escape_and_append(d.message)
        .s("\",\"line\":\{d.line\},\"column\":\{d.column\}}")
    loading.free()
    loading = null
    return 0

extern fn ksmd_web_render(): Sz //<
    //< the whole document as the result of an action that changed it all
    ensure()
    ed.change = Change.none(ed.doc@)
    ed.change.from = 0
    ed.change.tail = 0
    ed.change.tables = true
    return result(true, "")

extern fn ksmd_web_render_files(): Sz //<
    //< the blocks that show a fetched file, and every table and chart, once files have come
    //< **The rest of the document stays as it was shown**: showing it all again doubled the time
    //< a large document took to open.
    ensure()
    ed.change = Change.none(ed.doc@)
    ed.change.from = ed.doc.blocks.len
    ed.change.tail = 0
    ed.change.tables = true
    return result_with(true, "", true)

extern fn ksmd_web_source(): Sz //< the canonical source, as the writer saves it
    ensure()
    out.clear()
    writer.write(ed.doc@, out)
    return out.slice().len

extern fn ksmd_web_select(ap: I32, ab: Sz, ai: Sz, ao: Sz, fp: I32, fb: Sz, fi: Sz, fo: Sz) //<
    //< Moves the selection to two spots: a place (0 text, 1 block gap, 2 item gap), a block, an
    //< item and an offset each
    ensure()
    ed.select(spot(ap, ab, ai, ao), spot(fp, fb, fi, fo))

extern fn ksmd_web_here(): Sz //<
    //< what stands at the selection, as `result` gives it in `here`; changes nothing
    ensure()
    out.clear()
    here(out)
    return out.slice().len

extern fn ksmd_web_selection(): Sz //<
    //< a result that changes nothing, to show the selection after `select`
    if !begin()
        return full()
    return result(true, "")

extern fn ksmd_web_type(len: Sz, how: I32): Sz //<
    //< types text: `how` 0 typing, 1 paste, 2 composition
    if !begin()
        return full()
    kind: Input = .typing if how == 0 else .paste if how == 1 else .composition
    ed.type_text(text_in(len), kind) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_erase(backward: I32): Sz //< Backspace (1) or Delete (0)
    if !begin()
        return full()
    ed.erase(backward != 0) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_enter(hard: I32): Sz //<
    //< Enter, or with `hard` a line break inside a paragraph
    if !begin()
        return full()
    ed.enter(hard != 0) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_kind(kind: I32, level: Sz, ordered: I32): Sz //<
    //< Sets the selection's kind: 0 paragraph, 1 heading of `level`, 2 code, 3 list item, 4 quote
    //< A list item is bulleted for `ordered` 0, numbered for 1, and a checklist item for 2.
    if !begin()
        return full()
    $style: = paragraph_style()
    style.kind =
        (.paragraph if kind == 0 else .heading if kind == 1 else .code if kind == 2
        else .list if kind == 3 else .quote)
    style.level = level if kind == 1 else 0
    style.ordered = ordered == 1
    style.check = .open if kind == 3 && ordered == 2 else .none
    ed.set_kind(style) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_check(block: Sz, item: Sz): Sz //<
    //< ticks a checklist item's box, or takes the tick away
    if !begin()
        return full()
    ed.toggle_check(block, item) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_divider(): Sz //< a divider in place of the selection
    if !begin()
        return full()
    ed.insert_divider() catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_move_paths(from_len: Sz, to_len: Sz): Sz //<
    //< Writes the includes' and images' paths again for the document's new folder, as one step:
    //< the old folder, then the new one, from the workspace's root, are written in
    if !begin()
        return full()
    both: = text_in(from_len + to_len)
    ed.move_paths(both.sub(0, from_len), both.sub_from(from_len))
    return result(true, "")

extern fn ksmd_web_moved_source(from_len: Sz, to_len: Sz): Sz //<
    //< The canonical source with its paths written for a new folder, as `ksmd_web_move_paths`
    //< writes them; the open document stays as it is. The old folder, then the new one, from the
    //< workspace's root, are written in. -1 where the editor's memory cannot hold a copy.
    //< Save As writes this, and moves the document's own paths only once the write has
    //< succeeded, so a failed write leaves nothing to take back.
    ensure()
    if mem.heap_used_bytes() + RESERVE > HEAP_BYTES
        return -1
    both: = text_in(from_len + to_len)
    defer copy: = Arena(64 * 1024)
    defer $text: = Str_builder()
    writer.write(ed.doc@, text@)
    src: = Source("document.ksmd", copy.dup_str(text.slice())) catch
        panic("the editor's document reads back")
    doc: = reader.read(src@, copy) catch
        panic("the editor's document reads back")
    $moved: = editor.open(doc, ed.today, copy)
    moved.move_paths(both.sub(0, from_len), both.sub_from(from_len))
    out.clear()
    writer.write(moved.doc@, out)
    release_input()
    return out.slice().len

extern fn ksmd_web_insert_image(src_len: Sz, alt_len: Sz): Sz //<
    //< An image in place of the selection: its path from the document's folder, then its
    //< alternate text, are written in
    if !begin()
        return full()
    both: = text_in(src_len + alt_len)
    ed.insert_image(both.sub(0, src_len), both.sub_from(src_len)) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_drawings(block: Sz, len: Sz): Sz //<
    //< Gives an image or a chart the shapes drawn over it: their `draw` lines, as its clause's
    //< body holds them, are written in
    if !begin()
        return full()
    ed.set_drawings(block, text_in(len)) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_settings(len: Sz): Sz //<
    //< Gives the document its settings, written in as JSON: `{"paper":"A3","land":1,"header":text,
    //< "footer":text,"numbers":2,"tl":text,"fl":text}`, each empty or 0 for none
    if !begin()
        return full()
    defer scratch: = Arena(4 * 1024)
    got: = json.parse(text_in(len), scratch) catch
        return result(false, "The settings did not arrive whole, so nothing changed.")
    v: = got.val
    numbers: = number(v.get("numbers"))
    s: = Settings::{ .paper = word_of(v, "paper"), .landscape = number(v.get("land")) == 1,
        .header = word_of(v, "header"), .footer = word_of(v, "footer"),
        .numbers = 0 if numbers < 0 else numbers, .table_label = word_of(v, "tl"),
        .figure_label = word_of(v, "fl") }
    if says: = fault_of(s)
        if !is_empty(s)
            return result(false, says)
    ed.set_settings(s) catch e
        return refused(e)
    return result(true, "")

priv fn word_of(v: json.Value, name: U8[]): U8[] //< a text field of JSON written in, kept
    return ed.arena.dup_str(v.get(name).as_str().unwrap_or(""))

extern fn ksmd_web_insert_include(len: Sz): Sz //<
    //< An `:::include` clause in place of the selection: the included file's path from the
    //< document's folder is written in
    if !begin()
        return full()
    ed.insert_include(text_in(len)) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_insert_functions(len: Sz): Sz //<
    //< A `:::functions` clause in place of the selection: its file's path from the document's
    //< folder is written in
    if !begin()
        return full()
    ed.insert_functions(text_in(len)) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_invisible(block: Sz, on: I32): Sz //<
    //< leaves a clause's block out of print, or not
    if !begin()
        return full()
    ed.set_invisible(block, on != 0) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_indent(deeper: I32): Sz //< nests the selected list items one level in or out
    if !begin()
        return full()
    ed.indent(deeper != 0) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_text_color(len: Sz): Sz //<
    //< colours the selected text: `#rrggbb` written in, or empty
    if !begin()
        return full()
    ed.set_text_color(text_in(len)) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_mark(which: I32, len: Sz): Sz //<
    //< Turns a mark on or off: 0 emphasis, 1 strong, 2 code, 3 a link to the text written in
    if !begin()
        return full()
    mark: Mark =
        (.emphasis if which == 0 else .strong if which == 1 else .code if which == 2 else .link)
    ed.toggle_mark(mark, text_in(len)) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_insert_diagram(): Sz //< an empty diagram at the selection
    if !begin()
        return full()
    ed.insert_diagram() catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_diagram(block: Sz, len: Sz): Sz //<
    //< Gives a diagram the whole `:::diagram` clause written in, as one step
    if !begin()
        return full()
    ed.set_diagram(block, text_in(len)) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_undo(): Sz
    if !begin()
        return full()
    ed.undo()
    return result(true, "")

extern fn ksmd_web_redo(): Sz
    if !begin()
        return full()
    ed.redo()
    return result(true, "")

extern fn ksmd_web_remove_block(block: Sz): Sz //< removes a table, an include or an image block
    if !begin()
        return full()
    ed.remove_block(block) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_clear_look(): Sz //<
    //< takes the selected text's colour and alignment away, in one step
    if !begin()
        return full()
    ed.clear_look() catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_align(len: Sz): Sz //<
    //< aligns the selected paragraphs and headings; empty for none
    if !begin()
        return full()
    ed.set_align(text_in(len)) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_block_note(block: Sz, len: Sz): Sz //<
    //< Gives a paragraph or a heading the note in the `len` bytes written in; resolves it with none
    if !begin()
        return full()
    ed.set_block_note(block, text_in(len)) catch e
        return refused(e)
    return result(true, "")

extern fn ksmd_web_replace(len: Sz): Sz //<
    //< Replaces what a search found, as one step. Written in as JSON: `{"t":text,
    //< "s":[[block,item,from,to],…],"c":[[block,row,column,new text],…]}`
    if !begin()
        return full()
    defer scratch: = Arena(64 * 1024)
    $spans: = List<|Span|>(scratch)
    $cells: = List<|Cell_text|>(scratch)
    doc: = json.parse(text_in(len), scratch) catch
        return result(false, "The replacement did not arrive whole, so nothing was replaced.")
    text: = doc.val.get("t").as_str().unwrap_or("")
    for s in doc.val.get("s").arr_list(scratch)
        spans
            .push(Span::{ .block = number(s.get_at(0)), .item = number(s.get_at(1)),
            .from = number(s.get_at(2)), .to = number(s.get_at(3)) })
    for c in doc.val.get("c").arr_list(scratch)
        cells
            .push(Cell_text::{ .block = number(c.get_at(0)), .row = number(c.get_at(1)),
            .column = number(c.get_at(2)),
            .text = c.get_at(3).as_str().unwrap_or("") })
    ed.replace_found(spans@, text, cells@) catch e
        return refused(e)
    return result(true, "")

priv fn spot(place: I32, block: Sz, item: Sz, offset: Sz): Spot
    p: Place = .text if place == 0 else .block_gap if place == 1 else .item_gap
    return Spot::{ .place = p, .block = block, .item = item, .offset = offset }

//< Reads a clause, from `:::kind name=value ...` to a line of `:::`: a table, an include, an
//< image, a chart or a person's functions
//< A table's names, cells and widths are read and checked here. What a formula means, and where a
//< path leads, are not: calculation and file resolution come after reading.
import "ksmd/base/attribute" { Attribute, attribute_at, decode, find, read_attributes }
import "ksmd/base/dates" { is_date }
import "ksmd/base/keyed" { Keyed }
import "ksmd/base/marker" { is_decimal, leading, quoted_end }
import "ksmd/base/source" { Diagnostic, Line, Source }
import "ksmd/calc/formula" { text_piece }
import "ksmd/model/choice" { has_choices, is_entry, lowered }
import "ksmd/model/filter" { is_filter_entry }
import "ksmd/model/format" { format_of }
import "ksmd/model/group" { Group_fault, read_groups }
import "ksmd/model/look" { look_of, note_of, plain_look }
import "ksmd/model/model" { Block, Cell, Chart, Document, Image, Drawing, UNBOUND, MAX_CELLS,
    MAX_COLUMNS, MAX_FORMULA, MAX_HEIGHT, MAX_NAME, MAX_ROWS, MAX_SCALE, MAX_WIDTH, MIN_HEIGHT,
    MIN_WIDTH, Column_filter, Row_height, Table }
import "ksmd/model/rule" { has_rule, rule_of }
import "ksmd/syntax/chart" { kind_of, split_names }
import "ksmd/syntax/diagram" { read_diagram }
import "ksmd/syntax/drawing" { read_drawings }
import "ksmd/syntax/inline" { is_destination }
import "ksmd/syntax/settings" { fault_of, is_label, settings_of }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/strnum"

fn read_clause(src: Source@, first: Line, doc: Document$@, names: Keyed<|Bool|>$@, arena: Arena$@):
    Sz!Diagnostic //<
        //< Reads the clause that opens at `first`, and returns where the next block may start
    text: = first.text
    $end: Sz = 3
    for end < text.len && text[end] != ' '
        end += 1
    kind: = text.sub(3, end - 3)
    attributes: = read_attributes(src, text, end, text.len, first.offset, arena)!
    invisible: = invisible_of(src, attributes)!
    at: = doc.blocks.len
    next: = read_kind(src, first, kind, attributes, doc, names, arena)!
    if invisible
        doc.blocks[at].invisible = true
    return next

fn percent_of(text: U8[], most: Sz): Sz //<
    //< `40%` as 40: a whole number from 1 to `most`, at most 3 digits, and `%`; 0 for none
    if text.len < 2 || text.len > 4 || !text.ends_with("%")
        return 0
    n: = text.sub(0, text.len - 1).to_count(most) catch
        return 0
    return n

priv fn invisible_of(src: Source@, attributes: List<|Attribute|>): Bool!Diagnostic //<
    //< Whether the clause holds `invisible="printing"`, which leaves its block out of print and PDF
    a: = find(attributes, "invisible") catch
        return false
    if !string_of(src, a)!.equals("printing")
        throw src.diagnostic(a.offset, "invisible is \"printing\", or leave it out")
    return true

priv fn read_kind(src: Source@, first: Line, kind: U8[], attributes: List<|Attribute|>,
    doc: Document$@, names: Keyed<|Bool|>$@, arena: Arena$@): Sz!Diagnostic //<
        //< Reads the clause of each kind, once its attributes are read
    if kind.equals("table")
        return read_table(src, first, attributes, doc, names, arena)
    if kind.equals("include")
        allow(src, attributes, U8[][]::{ "path", "invisible" },
            "':::include' takes only path and invisible")!
        path: =
            required(src, first, attributes, "path",
            "':::include' needs a path, as in path=\"notes.ksmd\"")!
        doc.blocks
            .push(Block::{ .kind = .include, .level = 0, .label = "", .text = path, .first = 0,
            .count = 0, .offset = first.offset, .align = .none, .note = "", .invisible = false })
        return empty_body(src, first, "':::include' has no body. Close it on the next line")
    if kind.equals("image")
        allow(src, attributes,
            U8[][]::{ "src", "alt", "caption", "width", "scale", "invisible" },
            "':::image' takes only src, alt, caption, width, scale and invisible")!
        image_src: =
            required(src, first, attributes, "src", "':::image' needs src and alt")!
        alt: =
            required_or_empty(src, first, attributes, "alt", "':::image' needs src and alt")!
        $caption: U8[] = ""
        if a: = find(attributes, "caption")
            caption = string_of(src, a)!
            if caption.len == 0
                throw src.diagnostic(a.offset, "leave out an empty caption")
        $width: Sz = 0
        if a: = find(attributes, "width")
            width = percent_of(string_of(src, a)!, 100)
            if width == 0
                throw src.diagnostic(a.offset,
                    "width is a share of the text width, \"1%\" to \"100%\", or leave it out")
        $scale: Sz = 0
        if a: = find(attributes, "scale")
            scale = percent_of(string_of(src, a)!, MAX_SCALE)
            if scale == 0
                throw src.diagnostic(a.offset,
                    "scale is a share of the image's own size, \"1%\" to \"400%\", or leave it out")
            if width > 0
                throw src.diagnostic(a.offset,
                    "an image takes a width or a scale, not both. Keep one of them")
        doc.blocks
            .push(Block::{ .kind = .image, .level = 0, .label = "", .text = "",
            .first = doc.images.len, .count = 1, .offset = first.offset, .align = .none, .note = "",
            .invisible = false })
        $drawings: = List<|Drawing|>(arena)
        next: = read_drawings(src, first, drawings@, arena)!
        doc.images
            .push(Image::{ .src = image_src, .alt = alt, .caption = caption, .width = width,
            .scale = scale, .drawings = drawings })
        return next
    if kind.equals("chart")
        return read_chart(src, first, attributes, doc, arena)
    if kind.equals("diagram")
        return read_diagram(src, first, attributes, doc, arena)
    if kind.equals("functions")
        allow(src, attributes, U8[][]::{ "path" }, "':::functions' takes only path")!
        path: =
            required(src, first, attributes, "path",
            "':::functions' needs a path, as in path=\"mine.kspl\"")!
        if !names_kspl(path)
            throw src.diagnostic(first.offset, "':::functions' names a KSPL file, ending in .kspl")
        doc.blocks
            .push(Block::{ .kind = .functions, .level = 0, .label = "", .text = path, .first = 0,
            .count = 0, .offset = first.offset, .align = .none, .note = "", .invisible = false })
        return empty_body(src, first, "':::functions' has no body. Close it on the next line")
    if kind.equals("document")
        // It stands first, so a reader meets the paper and the numbers before what they number.
        if doc.blocks.len > 0
            throw src.diagnostic(first.offset,
                "':::document' stands first in its source, before every other block, and once")
        settings: = settings_of(attributes@) catch a
            throw src.diagnostic(a.offset, document_says(a))
        if says: = fault_of(settings)
            throw src.diagnostic(first.offset, says)
        doc.settings.push(settings)
        doc.blocks
            .push(Block::{ .kind = .document, .level = 0, .label = "", .text = "",
            .first = doc.settings.len - 1, .count = 1, .offset = first.offset, .align = .none,
            .note = "", .invisible = false })
        return empty_body(src, first, "':::document' has no body. Close it on the next line")
    throw src.diagnostic(first.offset + 3,
        "a clause is ':::table', ':::include', ':::image', ':::chart', ':::diagram', ':::functions' \
            or ':::document'")

priv fn document_says(a: Attribute): U8[] //< what the reader says of an attribute it cannot take
    if a.name.equals("numbers")
        return "numbers is the heading level numbering starts at, 1 to 6, unquoted"
    if a.name.equals("orientation")
        return "orientation is \"landscape\", or leave it out for portrait"
    if a.name.equals("paper") || a.name.equals("header") || a.name.equals("footer") ||
        a.name.equals("table_label") || a.name.equals("figure_label")
        return "this attribute takes a quoted string"
    return "':::document' takes only paper, orientation, header, footer, numbers, table_label and \
        figure_label"

fn names_kspl(path: U8[]): Bool //< whether a `:::functions` clause's path names a KSPL file
    return path.len > ".kspl".len && path.ends_with(".kspl")

priv fn read_chart(src: Source@, first: Line, attributes: List<|Attribute|>, doc: Document$@,
    arena: Arena$@): Sz!Diagnostic //<
        //< `:::chart table="t" kind="bar" labels="item" values="cost,tax" title="..."`, or by rows
        //< with `by="rows" from="Jan" to="Dec"`, `values` then naming rows
        //< The names are found once every table is read (`chart.bind_charts`).
    allow(src, attributes,
        U8[][]::{ "table", "kind", "labels", "values", "by", "from", "to", "title", "invisible" },
        "':::chart' takes only table, kind, labels, values, by, from, to, title and invisible")!
    message: = "':::chart' needs table, kind, labels and values"
    table: = required(src, first, attributes, "table", message)!
    kind_text: = required(src, first, attributes, "kind", message)!
    kind: = kind_of(kind_text) catch
        throw src.diagnostic(attribute_at(attributes, "kind"), "kind is \"bar\" or \"line\"")
    labels: = required(src, first, attributes, "labels", message)!
    values: = required(src, first, attributes, "values", message)!
    $names: = List<|U8[]|>(arena)
    if !split_names(values, names@)
        throw src.diagnostic(attribute_at(attributes, "values"),
            "values names 1 to 8 columns, or rows, separated by ','")
    // `by="rows"` draws each named row, its points the columns from `from` to `to`.
    $by_rows: = false
    $from: U8[] = ""
    $to: U8[] = ""
    if a: = find(attributes, "by")
        if !string_of(src, a)!.equals("rows")
            throw src.diagnostic(a.offset, "by is \"rows\", or leave it out for columns")
        by_rows = true
        rows_message: = "a chart by rows needs from and to, the first and last columns it draws"
        from = required(src, first, attributes, "from", rows_message)!
        to = required(src, first, attributes, "to", rows_message)!
    else if a: = find(attributes, "from")
        throw src.diagnostic(a.offset, "from and to belong to a chart by rows")
    else if a: = find(attributes, "to")
        throw src.diagnostic(a.offset, "from and to belong to a chart by rows")
    $title: U8[] = ""
    if a: = find(attributes, "title")
        title = string_of(src, a)!
        if title.len == 0
            throw src.diagnostic(a.offset, "leave out an empty title")
    $ids: = List<|Sz|>(arena)
    for _ in names
        ids.push(UNBOUND)
    doc.blocks
        .push(Block::{ .kind = .chart, .level = 0, .label = "", .text = "",
        .first = doc.charts.len, .count = 1, .offset = first.offset, .align = .none, .note = "",
        .invisible = false })
    $drawings: = List<|Drawing|>(arena)
    next: = read_drawings(src, first, drawings@, arena)!
    doc.charts
        .push(Chart::{ .kind = kind, .title = title, .table = UNBOUND, .name = table,
        .labels = UNBOUND, .label_name = labels, .series = ids, .series_names = names,
        .by_rows = by_rows, .from = UNBOUND, .from_name = from, .to = UNBOUND, .to_name = to,
        .drawings = drawings })
    return next

priv fn read_table(src: Source@, first: Line, attributes: List<|Attribute|>, doc: Document$@,
    names: Keyed<|Bool|>$@, arena: Arena$@): Sz!Diagnostic //<
        //< A header row of quoted names, then data rows, each with as many cells
    if a: = find(attributes, "widths")
        throw src.diagnostic(a.offset,
            "':::table' no longer takes widths. Give each column's width in characters with \
                char_widths")
    allow(src, attributes,
        U8[][]::{ "name", "caption", "char_widths", "heights", "formats", "choices", "color_rows",
        "rules", "groups", "merge", "filter", "invisible" },
        "':::table' takes only name, caption, char_widths, heights, formats, choices, color_rows, \
            rules, groups, merge, filter and invisible")!
    name: =
        required(src, first, attributes, "name", "':::table' needs a name, as in name=\"budget\"")!
    name_at: = attribute_at(attributes, "name")
    if !is_table_name(name)
        throw src.diagnostic(name_at,
            "a table name is 1 to 255 bytes of text, with no line breaks or other control \
                characters")
    if names.get(name).unwrap_or(false)
        throw src.diagnostic(name_at, "another table in this source has this name")
    names.set(name, true)
    $t: = Table(name, arena)
    $at: = first.next
    for
        if at >= src.bytes.len
            throw src.diagnostic(first.offset, "this clause has no closing ':::' line")
        line: = src.line_at(at)
        if line.text.equals(":::")
            break
        count: = read_row(src, line, t@, arena)!
        header: = at == first.next
        if !header && count != t.columns.len
            throw src.diagnostic(line.offset, "every row has as many cells as the header")
        if header
            for i in Range.asc(count)
                if t.cells[i].kind != .text
                    throw src.diagnostic(t.cells[i].offset, "a header cell is a quoted name")
                t.columns.push(t.next_id)
                t.next_id += 1
        else
            if t.rows.len == MAX_ROWS
                throw src.diagnostic(line.offset, "a table holds at most 10,000 data rows")
            t.rows.push(t.next_id)
            t.next_id += 1
        if t.cells.len > MAX_CELLS
            throw src.diagnostic(line.offset,
                "a table holds at most 100,000 cells, the header's included")
        at = line.next
    if at == first.next
        throw src.diagnostic(first.offset, "a table has a header row of quoted names")
    read_widths(src, attributes, t@)!
    if a: = find(attributes, "heights")
        read_heights(src, a, t@)!
    if a: = find(attributes, "formats")
        read_formats(src, a, t@)!
    if a: = find(attributes, "choices")
        read_choice_list(src, a, t@, arena)!
    if a: = find(attributes, "color_rows")
        read_color_rows(src, a, t@)!
    if a: = find(attributes, "caption")
        t.caption = string_of(src, a)!
        if !is_label(t.caption)
            throw src.diagnostic(a.offset, "a caption is 1 to 200 bytes of text, with no braces")
    if a: = find(attributes, "merge")
        read_merge(src, a, t@)!
    if a: = find(attributes, "rules")
        read_rule_list(src, a, t@, arena)!
    if a: = find(attributes, "groups")
        read_group_list(src, a, t@)!
    if a: = find(attributes, "filter")
        read_filter_list(src, a, t@)!
    doc.blocks
        .push(Block::{ .kind = .table, .level = 0, .label = "", .text = "",
        .first = doc.tables.len, .count = 1, .offset = first.offset, .align = .none, .note = "",
        .invisible = false })
    doc.tables.push(t)
    return src.line_at(at).next

priv fn read_row(src: Source@, line: Line, t: Table$@, arena: Arena$@): Sz!Diagnostic //<
    //< One row's cells, split at each '|' outside quoted text; returns how many it holds
    text: = line.text.trim_end()
    if text.len < 2 || text[0] != '|' || text[text.len - 1] != '|'
        throw src.diagnostic(line.offset, "a table row starts and ends with '|'")
    $count: Sz = 0
    $start: Sz = 1
    $i: Sz = 1
    for i < text.len
        if text[i] == '"'
            close: = quoted_end(text, i)
            if close == text.len
                throw src.diagnostic(line.offset + i, "this quoted text has no closing '\"'")
            i = close + 1
            continue
        if text[i] == '|'
            if count == MAX_COLUMNS
                throw src.diagnostic(line.offset + i, "a table holds at most 256 columns")
            t.cells
                .push(read_cell(src, text.sub(start, i - start), line.offset + start, t, arena)!)
            count += 1
            start = i + 1
        i += 1
    if start != text.len
        throw src.diagnostic(line.offset, "a table row starts and ends with '|'")
    return count

fn reads_as_formula(formula: U8[]): Bool //<
    //< Whether `formula`, saved after `=` alone in a cell, reads back as this formula and nothing
    //< more
    //< The editor asks this before it takes a formula, so the reader's rule for a cell is the only
    //< one. A `|` or a `{` outside quotes, or a line break, fails it.
    defer scratch: = Arena(8 * 1024)
    bytes: = scratch.text().s("%ksmd 1\n| =").s(formula).s(" |").take()
    src: = Source("", bytes) catch
        return false
    $t: = Table("", scratch)
    count: = read_row(src@, src.line_at(src.body), t@, scratch) catch
        return false
    return count == 1 && t.cells[0].kind == .formula && t.pieces[0].text.equals(formula)

priv fn read_cell(src: Source@, raw: U8[], offset: Sz, t: Table$@, arena: Arena$@):
    Cell!Diagnostic //<
        //< Nothing, quoted text, a number, a date, or a formula after '=', then a look in braces or
        //< none
        //< A formula is kept as one text piece, which `formula.bind_all` splits once every table
        //< is read.
    whole: = raw.trim_spaces()
    at: = offset + leading(raw)
    brace: = brace_at(whole)
    $look: = plain_look()
    $note: U8[] = ""
    $link: U8[] = ""
    $link_at: Sz = 0
    $body: = whole
    if brace < whole.len
        if whole[whole.len - 1] != '}'
            throw src.diagnostic(at + brace, "a look in braces ends its cell, with '}' last")
        attributes: = read_attributes(src, whole, brace + 1, whole.len - 1, at, arena)!
        look = look_of(src, attributes@, at + brace)!
        note = note_of(src, attributes@)!
        if a: = find(attributes, "link")
            if !a.quoted || !is_destination(a.value)
                throw src.diagnostic(a.offset,
                    "a link goes to an https:, http: or mailto: address, or to a '#' place, with no \
                        space or bracket")
            link = a.value
            link_at = a.offset
        body = whole.sub(0, brace).trim_end()
    $cell: = Cell::{ .kind = .empty, .text = "", .first = 0, .count = 0, .offset = at, .look = look,
        .note = note, .link = link }
    // A link names what its text says, so only a text cell holds one.
    if link.len > 0 && (body.len == 0 || body[0] != '"')
        throw src.diagnostic(link_at, "only a text cell holds a link")
    if body.len == 0
        cell.offset = offset
        return cell
    if body[0] == '"'
        if quoted_end(body, 0) != body.len - 1
            throw src.diagnostic(at,
                "a cell holds one value: quoted text, a number, a date, a formula after '=', or \
                    nothing")
        cell.kind = .text
        cell.text = decode(src, body, at, arena)!
        return cell
    if body[0] == '='
        formula: = body.sub_from(1).trim_spaces()
        if formula.len == 0
            throw src.diagnostic(at, "this formula is empty")
        if formula.len > MAX_FORMULA
            throw src.diagnostic(at, "a formula holds at most 4,096 bytes")
        t.pieces.push(text_piece(formula))
        cell.kind = .formula
        cell.first = t.pieces.len - 1
        cell.count = 1
        return cell
    if is_date(body)
        cell.kind = .date
        cell.text = body
        return cell
    if !is_decimal(body)
        throw src.diagnostic(at,
            "a cell holds one value: quoted text, a number, a date, a formula after '=', or nothing")
    value: = body.to_f64() catch
        throw src.diagnostic(at, "this number is too large for a cell")
    if value - value != 0.0
        throw src.diagnostic(at, "this number is too large for a cell")
    cell.kind = .number
    cell.text = body
    return cell

priv fn brace_at(text: U8[]): Sz //< where the first `{` outside quotes stands, or the length
    $i: Sz = 0
    for i < text.len
        if text[i] == '"'
            i = quoted_end(text, i) + 1
            continue
        if text[i] == '{'
            return i
        i += 1
    return text.len

priv fn read_widths(src: Source@, attributes: List<|Attribute|>, t: Table$@): Void!Diagnostic //<
    //< `char_widths="12,,8.5"`: one entry per column, its width in characters, empty where it fits
    //< its text
    if a: = find(attributes, "char_widths")
        if !a.quoted
            throw src.diagnostic(a.offset, "this attribute takes a quoted string")
        if !parse_widths(a.value, t.widths@)
            throw src.diagnostic(a.offset,
                "a column's width is 0.5 to 255 characters, with at most one decimal place, or \
                    nothing")
        if t.widths.len != t.columns.len
            throw src.diagnostic(a.offset, "char_widths has one entry per column, empty for none")
        $any: = false
        for w in t.widths
            any = any || w > 0
        if !any
            throw src.diagnostic(a.offset, "leave out char_widths when no column has a width")

priv fn read_heights(src: Source@, a: Attribute, t: Table$@): Void!Diagnostic //<
    //< `heights=",20,,"`: one entry per data row, its height in whole points, empty for none
    if !a.quoted
        throw src.diagnostic(a.offset, "this attribute takes a quoted string")
    $count: Sz = 0
    $start: Sz = 0
    for i in Range.asc(a.value.len + 1)
        if i < a.value.len && a.value[i] != ','
            continue
        entry: = a.value.sub(start, i - start)
        start = i + 1
        if count == t.rows.len
            throw src.diagnostic(a.offset, "heights has one entry per data row, empty for none")
        row: = t.rows[count]
        count += 1
        if entry.len == 0
            continue
        points: = entry.to_count(MAX_HEIGHT) catch
            throw src.diagnostic(a.offset,
                "a row's height is a whole number of points from 6 to 409, or nothing")
        if points < MIN_HEIGHT
            throw src.diagnostic(a.offset,
                "a row's height is a whole number of points from 6 to 409, or nothing")
        t.heights.push(Row_height::{ .row = row, .points = points })
    if count != t.rows.len
        throw src.diagnostic(a.offset, "heights has one entry per data row, empty for none")
    if t.heights.len == 0
        throw src.diagnostic(a.offset, "leave out heights when no row has one")

priv fn read_formats(src: Source@, a: Attribute, t: Table$@): Void!Diagnostic //<
    //< `formats="grouped:2,,percent:1"`: one number format per column, empty for none
    //< A diagnostic points at the entry itself where the value holds no escape.
    if !a.quoted
        throw src.diagnostic(a.offset, "this attribute takes a quoted string")
    value_at: = a.offset + 9
    plain: =
        value_at + a.value.len <= src.bytes.len &&
        src.bytes.sub(value_at, a.value.len).equals(a.value)
    $any: = false
    $start: Sz = 0
    for i in Range.asc(a.value.len + 1)
        if i < a.value.len && a.value[i] != ','
            continue
        f: = format_of(a.value.sub(start, i - start)) catch
            throw src.diagnostic(value_at + start if plain else a.offset,
                "a format is number:N, grouped:N, percent:N or currency:XXX:N, with N from 0 to 9, \
                    date:yyyy/mm/dd, or nothing")
        if f.kind == .general
            throw src.diagnostic(value_at + start if plain else a.offset,
                "a column shows its values as calculated with an empty entry; general is a cell's")
        any = any || f.kind != .none
        t.formats.push(f)
        start = i + 1
    if t.formats.len != t.columns.len
        throw src.diagnostic(a.offset, "formats has one entry per column, empty for none")
    if !any
        throw src.diagnostic(a.offset, "leave out formats when no column has one")

priv fn read_choice_list(src: Source@, a: Attribute, t: Table$@, arena: Arena$@): Void!Diagnostic //<
    //< `choices=",Open|Done,"`: one entry per column, empty for a column that takes any value
    if !a.quoted
        throw src.diagnostic(a.offset, "this attribute takes a quoted string")
    $start: Sz = 0
    for i in Range.asc(a.value.len + 1)
        if i < a.value.len && a.value[i] != ','
            continue
        entry: = lowered(a.value.sub(start, i - start), arena)
        if !is_entry(entry)
            throw src.diagnostic(a.offset,
                "a column's choices are 1 to 50 texts separated by '|', each with no ',', '|', ';', \
                    '\"' or '\\', none twice, and each maybe with colours after ';'")
        t.choices.push(entry)
        start = i + 1
    if t.choices.len != t.columns.len
        throw src.diagnostic(a.offset, "choices has one entry per column, empty for none")
    if !has_choices(t.choices@)
        throw src.diagnostic(a.offset, "leave out choices when no column has any")
    // A cell that holds a value off its column's list still reads: the page marks it.

priv fn read_merge(src: Source@, a: Attribute, t: Table$@): Void!Diagnostic //<
    //< `merge="A,B"`: the columns, from the left, whose repeated values show once
    message: = "merge names columns by their letters from the left, as \"A,B\", each once"
    if !a.quoted || a.value.len == 0
        throw src.diagnostic(a.offset, message)
    $start: Sz = 0
    $last: Sz = -1
    for i in Range.asc(a.value.len + 1)
        if i < a.value.len && a.value[i] != ','
            continue
        letters: = a.value.sub(start, i - start)
        start = i + 1
        $n: Sz = 0
        for c in letters
            if !c.is_upper() || n > t.columns.len
                throw src.diagnostic(a.offset, message)
            n = n * 26 + Sz::(c - 'A') + 1
        if n == 0 || n > t.columns.len || n - 1 <= last
            throw src.diagnostic(a.offset, message)
        last = n - 1
        t.merged.push(t.columns[n - 1])

priv fn read_color_rows(src: Source@, a: Attribute, t: Table$@): Void!Diagnostic //<
    //< `color_rows="C"`: each row takes the colours of the choice its column C holds
    message: = "color_rows names a column with choices by its letters, as \"C\""
    if !a.quoted || a.value.len == 0 || a.value.len > 3
        throw src.diagnostic(a.offset, message)
    $n: Sz = 0
    for c in a.value
        if !c.is_upper()
            throw src.diagnostic(a.offset, message)
        n = n * 26 + Sz::(c - 'A') + 1
    if n > t.columns.len || t.choices.len == 0 || t.choices[n - 1].len == 0
        throw src.diagnostic(a.offset, message)
    t.row_colors = t.columns[n - 1]

priv fn read_rule_list(src: Source@, a: Attribute, t: Table$@, arena: Arena$@): Void!Diagnostic //<
    //< `rules=",<0;color:#9c0006"`: one colour rule per column, empty for none
    if !a.quoted
        throw src.diagnostic(a.offset, "this attribute takes a quoted string")
    $start: Sz = 0
    for i in Range.asc(a.value.len + 1)
        if i < a.value.len && a.value[i] != ','
            continue
        r: = rule_of(a.value.sub(start, i - start), arena) catch
            throw src.diagnostic(a.offset,
                "a rule is <N, >N, =value or empty, then ';' and color:#rrggbb, fill:#rrggbb or \
                    both")
        t.rules.push(r)
        start = i + 1
    if t.rules.len != t.columns.len
        throw src.diagnostic(a.offset, "rules has one entry per column, empty for none")
    if !has_rule(t.rules@)
        throw src.diagnostic(a.offset, "leave out rules when no column has one")

priv fn read_group_list(src: Source@, a: Attribute, t: Table$@): Void!Diagnostic //<
    //< `groups="rows 2-4, rows 6-9 closed, columns B-D"`: the groups of data rows, then of columns
    if !a.quoted
        throw src.diagnostic(a.offset, "this attribute takes a quoted string")
    if a.value.len == 0
        throw src.diagnostic(a.offset, "leave out groups when the table has none")
    read_groups(a.value, t) catch f
        throw src.diagnostic(a.offset, message_of(f))

priv fn read_filter_list(src: Source@, a: Attribute, t: Table$@): Void!Diagnostic //<
    //< `filter=",in:apple|fig,"`: one entry per column, empty for a column that narrows nothing
    if !a.quoted
        throw src.diagnostic(a.offset, "this attribute takes a quoted string")
    $count: Sz = 0
    $start: Sz = 0
    for i in Range.asc(a.value.len + 1)
        if i < a.value.len && a.value[i] != ','
            continue
        entry: = a.value.sub(start, i - start)
        start = i + 1
        if count == t.columns.len
            throw src.diagnostic(a.offset, "filter has one entry per column, empty for none")
        if !is_filter_entry(entry)
            throw src.diagnostic(a.offset,
                "a column's filter is in: or out: and values separated by '|', is:, not:, \
                    contains:, above: or below: and a value, empty, filled, or nothing")
        if entry.len > 0
            t.filters.push(Column_filter::{ .column = t.columns[count], .entry = entry })
        count += 1
    if count != t.columns.len
        throw src.diagnostic(a.offset, "filter has one entry per column, empty for none")
    if t.filters.len == 0
        throw src.diagnostic(a.offset, "leave out filter when no column has one")

priv fn message_of(f: Group_fault): U8[] //< what the reader says of groups it cannot read
    switch f
    case .not_rows
        return "groups lists entries such as rows 2-4, rows 6 closed or columns B-D, naming data \
            rows from 1 and columns by letter, separated by ', '"
    case .out_of_order
        return "groups lists the rows' entries from the top, then the columns' from the left, an \
            outer group before the groups it holds"
    case .crosses
        return "a group holds another whole, or shares no row with it"
    case .twice
        return "two groups hold the same rows"
    case .too_deep
        return "a row or a column stands in at most 8 groups"

fn parse_widths(text: U8[], widths: List<|Sz|>$@): Bool //<
    //< Adds the widths `12,,8.5` names to `widths`, in tenths of a character, 0 for an empty
    //< entry; false if the text is not that form
    //< Each entry is empty, or 0.5 to 255 with at most one decimal place.
    $start: Sz = 0
    for i in Range.asc(text.len + 1)
        if i < text.len && text[i] != ','
            continue
        entry: = text.sub(start, i - start)
        start = i + 1
        if entry.len == 0
            widths.push(0)
            continue
        $whole: = entry
        $tenth: Sz = 0
        if dot: = entry.find_char('.')
            if dot + 2 != entry.len || !entry[dot + 1].is_digit()
                return false
            whole = entry.sub(0, dot)
            tenth = entry[dot + 1] - '0'
        count: = whole.to_count(MAX_WIDTH / 10) catch
            return false
        width: = count * 10 + tenth
        if width < MIN_WIDTH || width > MAX_WIDTH
            return false
        widths.push(width)
    return true

priv fn allow(src: Source@, attributes: List<|Attribute|>, names: U8[][], message: U8[]):
    Void!Diagnostic //<
        //< Refuses any attribute but these
    for i in Range.asc(attributes.len)
        $known: = false
        for name in names
            known = known || attributes.get(i).name.equals(name)
        if !known
            throw src.diagnostic(attributes.get(i).offset, message)

priv fn required(src: Source@, first: Line, attributes: List<|Attribute|>, name: U8[],
    message: U8[]): U8[]!Diagnostic //<
        //< A quoted attribute that must be given and not be empty
    value: = required_or_empty(src, first, attributes, name, message)!
    if value.len == 0
        throw src.diagnostic(attribute_at(attributes, name), "this attribute is not empty")
    return value

priv fn required_or_empty(src: Source@, first: Line, attributes: List<|Attribute|>, name: U8[],
    message: U8[]): U8[]!Diagnostic //<
        //< A quoted attribute that must be given
    a: = find(attributes, name) catch
        throw src.diagnostic(first.offset, message)
    return string_of(src, a)

priv fn string_of(src: Source@, a: Attribute): U8[]!Diagnostic //< a quoted attribute's value
    if !a.quoted
        throw src.diagnostic(a.offset, "this attribute takes a quoted string")
    return a.value

priv fn empty_body(src: Source@, first: Line, message: U8[]): Sz!Diagnostic //<
    //< The `:::` line right after the opening line
    if first.next >= src.bytes.len
        throw src.diagnostic(first.offset, "this clause has no closing ':::' line")
    close: = src.line_at(first.next)
    if !close.text.equals(":::")
        throw src.diagnostic(close.offset, message)
    return close.next

fn is_table_name(name: U8[]): Bool //<
    //< 1 to 255 bytes of text, with no line break or other control character
    //< A formula writes a name that is not plain in JSON quotes (`write_table_name` in
    //< `formula.kspl`), so any other character can stand in a name.
    if name.len == 0 || name.len > MAX_NAME
        return false
    for c in name
        if c < 0x20U8 || c == 0x7FU8
            return false
    return true

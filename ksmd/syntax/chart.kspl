//< A chart: a table's columns, or its rows, drawn as bars or lines, as the `:::chart` clause saves
//< it
//< `:::chart table="budget" kind="bar" labels="item" values="cost,tax" title="Spending"` names
//< the table, the column whose values label the bars or points, and the columns to draw, by
//< their names. The chart holds the table and the columns by identity, as a formula's references
//< do, so a renamed or a moved column stays in the chart, and the writer writes the names they
//< have now. A name that names nothing is kept as written, and the page says what is missing.
//< `by="rows" from="Oct" to="Mar"` draws rows instead: `values` names rows by their text in the
//< `labels` column, and the columns from `from` to `to` are the points, as a burn-up chart of a
//< plan whose months stand across.
import "ksmd/base/attribute" { write_invisible }
import "ksmd/calc/formula" { find_table }
import "ksmd/model/model" { Chart, Chart_kind, Document, MAX_SERIES, Table, UNBOUND }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str }

fn kind_of(text: U8[]): Chart_kind? //< `bar` or `line`
    if text.equals("bar")
        return .some(.bar)
    if text.equals("line")
        return .some(.line)
    return .none

fn split_names(text: U8[], out: List<|U8[]|>$@): Bool //<
    //< Adds the names `cost,tax` holds; false where one is empty, or past `MAX_SERIES`
    $start: Sz = 0
    for i in Range.asc(text.len + 1)
        if i < text.len && text[i] != ','
            continue
        if i == start || out.len == MAX_SERIES
            return false
        out.push(text.sub(start, i - start))
        start = i + 1
    return true

fn bind_charts(doc: Document$@) //< finds each chart's table and columns by their names
    for i in Range.asc(doc.charts.len)
        $c: = doc.charts[i]
        c.table = find_table(doc, c.name).unwrap_or(UNBOUND)
        c.labels = UNBOUND
        if c.table != UNBOUND
            t: = doc.tables[c.table]@
            c.labels = column_named(t, c.label_name)
            if c.by_rows
                c.from = column_named(t, c.from_name)
                c.to = column_named(t, c.to_name)
            else
                for j in Range.asc(c.series_names.len)
                    c.series[j] = column_named(t, c.series_names[j])
        doc.charts[i] = c

fn column_at(table: Table@, id: Sz): Sz //< where the column of this identity stands, or `UNBOUND`
    for c in Range.asc(table.columns.len)
        if table.columns[c] == id
            return c
    return UNBOUND

fn write_chart(doc: Document@, chart: Chart@, invisible: Bool, out: Str$@) //<
    //< The opening line, with its names
    //< A chart whose table is not found, as when it is read alone, writes the names it holds.
    bound: = is_bound(doc, chart)
    out.s(":::chart table=")
    quoted(doc.tables[chart.table].name if bound else chart.name, out)
    out.s(" kind=\"").s("bar" if chart.kind == .bar else "line").s("\" labels=")
    quoted(name_of(doc, chart, bound, chart.labels, chart.label_name), out)
    out.s(" values=\"")
    for j in Range.asc(chart.series.len)
        if j > 0
            out.c(',')
        series_name: =
            name_of(doc, chart, bound, chart.series[j], chart.series_names[j])
        out.escape_and_append(series_name)
    out.c('"')
    if chart.by_rows
        out.s(" by=\"rows\" from=")
        quoted(name_of(doc, chart, bound, chart.from, chart.from_name), out)
        out.s(" to=")
        quoted(name_of(doc, chart, bound, chart.to, chart.to_name), out)
    if chart.title.len > 0
        out.s(" title=")
        quoted(chart.title, out)
    write_invisible(invisible, out)
    out.c('\n')

fn reads_back(doc: Document@, chart: Chart@): Bool //<
    //< Whether the chart, saved and read again, finds the columns it holds now
    //< The reader takes the first column of a name, and splits `values` at each ','. So a column
    //< the chart shows needs a name of its own, and a drawn one no ','. A missing column is kept.
    if !is_bound(doc, chart)
        return true
    t: = doc.tables[chart.table]@
    if !found_again(t, chart.labels,
        name_of(doc, chart, true, chart.labels, chart.label_name))
        return false
    defer scratch: = Arena(1024)
    joined: = scratch.text()
    for j in Range.asc(chart.series.len)
        if j > 0
            joined.c(',')
        joined.s(name_of(doc, chart, true, chart.series[j], chart.series_names[j]))
    $names: = List<|U8[]|>(scratch)
    if !split_names(joined.take(), names@) || names.len != chart.series.len
        return false
    if chart.by_rows
        // A row is found by its name when drawn, so its name is all that must read back.
        return found_again(t, chart.from,
            name_of(doc, chart, true, chart.from, chart.from_name)) &&
            found_again(t, chart.to, name_of(doc, chart, true, chart.to, chart.to_name))
    for j in Range.asc(names.len)
        if !found_again(t, chart.series[j], names[j])
            return false
    return true

fn row_named(table: Table@, column: Sz, name: U8[]): Sz //<
    //< The first data row whose text in the column at place `column` is `name`, or `UNBOUND`
    for r in Range.asc(table.rows.len)
        cell: = table.cells[table.at(r, column)]
        if cell.kind == .text && cell.text.equals(name)
            return r
    return UNBOUND

priv fn found_again(table: Table@, id: Sz, name: U8[]): Bool //<
    //< Whether a column, written by this name, is found again; a missing one stays missing
    if name.len == 0
        return false
    return id == UNBOUND || column_at(table, id) == UNBOUND || column_named(table, name) == id

priv fn is_bound(doc: Document@, chart: Chart@): Bool //< whether the chart's table is found
    return chart.table != UNBOUND && chart.table < doc.tables.len &&
        doc.tables[chart.table].name.len > 0

priv fn name_of(doc: Document@, chart: Chart@, bound: Bool, id: Sz, kept: U8[]): U8[] //<
    //< A column's name now, or the name kept where the column is not found
    if !bound || id == UNBOUND
        return kept
    t: = doc.tables[chart.table]@
    at: = column_at(t, id)
    return kept if at == UNBOUND else t.cells[at].text

priv fn column_named(table: Table@, name: U8[]): Sz //< the identity of the column of that name
    for c in Range.asc(table.columns.len)
        if table.cells[c].text.equals(name)
            return table.columns[c]
    return UNBOUND

priv fn quoted(text: U8[], out: Str$@) //< a JSON string, as an attribute holds it
    out.c('"').escape_and_append(text).c('"')

//< The document's own settings, a table's caption and its merged columns: how they read and save,
//< what the reader refuses, and setting each with its undo
import "ksmd/edit/editor_settings" // `set_settings`
import "ksmd/edit/editor_tables"
import "ksmd/syntax/settings" { no_settings }
import "ksmd/tests/support" { opened, refused, refuses, saves }
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

priv const FULL: U8[] =
    ":::document paper=\"A3\" orientation=\"landscape\" header=\"[Confidential]\" footer=\"No.12 \
        ({page}/{pages})\" numbers=2 table_label=\"表\" figure_label=\"図\"\n:::\n"
priv const BODY: U8[] = "\n# Title\n\n## One\n"
priv const TABLE: U8[] =
    "%ksmd 2\n\n:::table name=\"t\"\n| \"kind\" | \"mode\" |\n| \"lock\" | \"A\" |\n| \"lock\" | \
        \"B\" |\n:::\n"

fn run()
    reading()
    setting()
    tables()

priv fn reading()
    defer arena: = Arena(64 * 1024)
    for clause in U8[][]::{ FULL, ":::document numbers=1\n:::\n",
        ":::document paper=\"letter\"\n:::\n", ":::document orientation=\"landscape\"\n:::\n" }
        text: = arena.text().s("%ksmd 2\n\n").s(clause).s(BODY).take()
        ed: = opened(text, arena)
        saves(arena.text().s("settings read and save unchanged: \{clause\}").take(), ed@, arena,
            text)
    for bad in U8[][]::{ ":::document\n:::\n", ":::document paper=\"A0\"\n:::\n",
        ":::document orientation=\"portrait\"\n:::\n", ":::document numbers=7\n:::\n",
        ":::document numbers=0\n:::\n", ":::document numbers=\"2\"\n:::\n",
        ":::document header=\"{date}\"\n:::\n", ":::document header=\"a}\"\n:::\n",
        ":::document table_label=\"{page}\"\n:::\n", ":::document colour=\"red\"\n:::\n",
        ":::document numbers=2\nbody\n:::\n" }
        refused(arena.text().s("%ksmd 2\n\n").s(bad).s(BODY).take(), bad)
    refused(arena.text().s("%ksmd 2\n\n# Title\n\n").s(FULL).take(), "settings after another block")
    refused(arena.text().s("%ksmd 2\n\n").s(FULL).s("\n").s(FULL).take(), "settings twice")

priv fn setting()
    defer arena: = Arena(64 * 1024)
    plain: = arena.text().s("%ksmd 2\n").s(BODY).take()
    $ed: = opened(plain, arena)
    $s: = no_settings()
    s.numbers = 2
    s.header = "[Confidential]"
    ed.set_settings(s) catch e
        verdict.check("setting the settings", false, e.message())
    first: = arena.text().s("%ksmd 2\n\n:::document header=\"[Confidential]\" numbers=2\n:::\n")
        .s(BODY).take()
    saves("settings set on a document go first", ed@, arena, first)
    s.paper = "A3"
    ed.set_settings(s) catch e
        verdict.check("changing the settings", false, e.message())
    changed: = arena.text()
        .s("%ksmd 2\n\n:::document paper=\"A3\" header=\"[Confidential]\" numbers=2\n:::\n").s(BODY)
        .take()
    saves("new settings replace the clause", ed@, arena, changed)
    $bad: = s
    bad.paper = "A0"
    refuses("settings the reader would refuse are refused", ed.set_settings(bad))
    ed.set_settings(no_settings()) catch e
        verdict.check("taking the settings away", false, e.message())
    saves("settings that set nothing take the clause away", ed@, arena, plain)
    ed.undo()
    saves("undo brings it back", ed@, arena, changed)
    ed.undo()
    ed.undo()
    saves("and undo takes each step back", ed@, arena, plain)

priv fn tables()
    defer arena: = Arena(64 * 1024)
    text: =
        "%ksmd 2\n\n:::table name=\"t\" caption=\"Modes\" merge=\"A,B\"\n| \"kind\" | \"mode\" |\n| \
            \"lock\" | \"A\" |\n:::\n"
    ed: = opened(text, arena)
    saves("a caption and merged columns read and save unchanged", ed@, arena, text)
    for bad in U8[][]::{ " caption=\"\"", " caption=\"a{b}\"", " merge=\"C\"", " merge=\"B,A\"",
        " merge=\"A,A\"", " merge=\"a\"", " merge=\"\"" }
        refused(arena.text().s("%ksmd 2\n\n:::table name=\"t\"").s(bad)
            .s("\n| \"kind\" | \"mode\" |\n:::\n").take(), bad)
    $t: = opened(TABLE, arena)
    t.set_caption(0, "Modes") catch e
        verdict.check("setting a caption", false, e.message())
    t.set_merged(0, 0, true) catch e
        verdict.check("merging a column", false, e.message())
    merged: = TABLE.replace(":::table name=\"t\"",
        ":::table name=\"t\" caption=\"Modes\" merge=\"A\"", arena)
    saves("a caption and a merged column set by the editor", t@, arena, merged)
    t.edit_table(0, .remove_column, 0, 1, Sz[]::{}) catch e
        verdict.check("removing a column", false, e.message())
    saves("removing a merged column takes it out of merge", t@, arena,
        "%ksmd 2\n\n:::table name=\"t\" caption=\"Modes\"\n| \"mode\" |\n| \"A\" |\n| \"B\" \
            |\n:::\n")
    t.undo()
    t.set_merged(0, 0, false) catch e
        verdict.check("unmerging a column", false, e.message())
    t.set_caption(0, "") catch e
        verdict.check("taking the caption away", false, e.message())
    saves("unmerged, and without its caption, it saves as before", t@, arena, TABLE)

//< Editor actions on tables: adding and removing one, row and column edits, sorting, cell values,
//< names, column widths, pasting and filling
//< Each check compares the saved source, and undo and redo give back the source before and after.
//< Values are checked through calculation, so a reference left on the wrong cell shows.
import "ksmd/calc/calc"
import "ksmd/calc/formula" { closing, partner }
import "ksmd/edit/editor" { Editor, Refused }
import "ksmd/edit/editor_tables" { Table_edit }
import "ksmd/edit/history" { capture }
import "ksmd/edit/region" { gap_spot, text_spot }
import "ksmd/tests/support" { changed, opened, saves, written }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strnum"
import "std/verdict"

priv const T1: U8[] = ":::table name=\"table1\"\n| \"\" | \"\" |\n| | |\n:::\n"

fn run()
    inserting()
    cells()
    rows_and_columns()
    many_lines()
    removing()
    naming()
    widths()
    sorting()
    sorting_ranges()
    sorting_row_totals()
    sorting_as_copies()
    looks()
    across()
    auto_entry()
    closing_formulas()
    closings()
    partners()
    pasting()
    pasting_whole()
    kept_small()
    filling()
    series()
    leaving_rows()
    dated()

priv fn inserting()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\nAbcd\n", arena)
    p: = text_spot(0, 0, 2)
    ed.select(p, p)
    inserted(ed@, 2, 1)
    saves("a table put in the middle of a paragraph splits it", ed@, arena,
        join3("%ksmd 2\n\nAb\n\n", T1, "\ncd\n", arena))
    end: = gap_spot(3)
    ed.select(end, end)
    inserted(ed@, 1, 0)
    saves("a table at the end takes the next free name, with a header alone", ed@, arena,
        join3("%ksmd 2\n\nAb\n\n", T1, "\ncd\n\n:::table name=\"table2\"\n| \"\" |\n:::\n", arena))
    ed.undo()
    saves("undo takes the new table back out", ed@, arena,
        join3("%ksmd 2\n\nAb\n\n", T1, "\ncd\n", arena))
    ed.redo()
    redone: = written(ed.doc@, arena)
    verdict.check("redo puts it back with its name",
        redone.ends_with("\n:::table name=\"table2\"\n| \"\" |\n:::\n"), redone)
    $loose: =
        opened("%ksmd 2\n\n:::table name=\"t\"\n| \"x\" |\n| =table1.A1*2 |\n:::\n", arena)
    at_end: = gap_spot(1)
    loose.select(at_end, at_end)
    inserted(loose@, 1, 1)
    set(loose@, 1, 0, 0, "21")
    verdict.check("a reference to a table not there yet attaches when the table is added",
        value(loose@, 0, 0, 0, arena) == 42.0, "")

priv fn cells()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | 2 |\n:::\n", arena)
    set(ed@, 0, -1, 0, "Count")
    set(ed@, 0, 0, 0, "12")
    set(ed@, 0, 0, 1, "=A1*3")
    saves("a name, a number and a formula as typed", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| 12 | =A1*3 |\n:::\n")
    verdict.check("the formula calculates", value(ed@, 0, 0, 1, arena) == 36.0, "")
    set(ed@, 0, 0, 0, "\"12\"")
    saves("a quoted number is text", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| \"12\" | =A1*3 |\n:::\n")
    shown(ed@, 0, 0, "\"12\"", "text that would read as a number shows quoted", arena)
    shown(ed@, 0, 1, "=A1*3", "a formula shows with its '='", arena)
    set(ed@, 0, 0, 0, "Pens")
    shown(ed@, 0, 0, "Pens", "other text shows as it is", arena)
    set(ed@, 0, 0, 0, "")
    saves("nothing makes the cell empty", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| | =A1*3 |\n:::\n")
    ed.undo()
    ed.undo()
    ed.undo()
    saves("undo gives each cell's value back, one step at a time", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| 12 | =A1*3 |\n:::\n")
    ed.redo()
    saves("redo sets the value again", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| \"12\" | =A1*3 |\n:::\n")
    refused(ed@, "a formula with a '|' outside quotes is refused", .pipe, "one cell")
    refused(ed@, "an '=' alone is refused as an empty formula", .empty, "This formula is empty")
    set(ed@, 0, 0, 0, "1e400")
    saves("a number too large for a cell stays the text typed, as in Excel", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| \"1e400\" | =A1*3 |\n:::\n")
    shown(ed@, 0, 0, "1e400", "and shows as typed", arena)
    // Text typed in quotes follows a formula's rule: `\` is itself and `""` is a quote. The file
    // keeps JSON's escapes for a text cell.
    set(ed@, 0, 0, 0, "\"C:\\new\"")
    saves("a backslash typed in quotes is itself", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| \"C:\\\\new\" | =A1*3 |\n:::\n")
    shown(ed@, 0, 0, "C:\\new", "and shows without quotes", arena)
    set(ed@, 0, 0, 0, "\"C:\\src\"")
    shown(ed@, 0, 0, "C:\\src", "text in quotes that is no JSON string loses its quotes too", arena)
    set(ed@, 0, 0, 0, "\"say \"\"hi\"\"\"")
    saves("a doubled quote typed in quotes is one quote", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| \"say \\\"hi\\\"\" | =A1*3 \
            |\n:::\n")
    set(ed@, 0, 0, 0, "\"\"\"x\\\"\"\"")
    shown(ed@, 0, 0, "\"\"\"x\\\"\"\"", "text that starts with a quote shows by the same rule",
        arena)

priv fn rows_and_columns()
    defer arena: = Arena(64 * 1024)
    before: =
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | =A1+A2 |\n| 2 | =sum(A1:A2) \
            |\n:::\n"
    $ed: = opened(before, arena)
    changed(ed@, 0, .insert_row, 1)
    set(ed@, 0, 1, 0, "4")
    saves("a row inserted inside a range joins it", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | =A1+A3 |\n| 4 | |\n| 2 | \
            =sum(A1:A3) |\n:::\n")
    verdict.check("and the sum takes the new row", value(ed@, 0, 2, 1, arena) == 7.0, "")
    changed(ed@, 0, .remove_column, 0)
    saves("removing a column turns references to it into #REF!", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"b\" |\n| =#REF!+#REF! |\n| |\n| =sum(#REF!) |\n:::\n")
    ed.undo()
    verdict.check("undo brings the column and its references back",
        value(ed@, 0, 2, 1, arena) == 7.0, "")
    ed.undo()
    ed.undo()
    saves("undo takes the row back out", ed@, arena, before)
    changed(ed@, 0, .insert_column, 2)
    saves("a column added after the last", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"\" |\n| 1 | =A1+A2 | |\n| 2 | \
            =sum(A1:A2) | |\n:::\n")
    refused(ed@, "a row outside the table is refused", .row, "No table")

priv fn many_lines() //< a row or column edit acts on every line chosen, as one step
    defer arena: = Arena(64 * 1024)
    before: =
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 | =sum(A1:A4) |\n| 2 | \
            | |\n| 3 | | |\n| 4 | | |\n:::\n"
    $ed: = opened(before, arena)
    edited(ed@, .insert_row, 1, 2)
    saves("two rows inserted at once stand above the row given", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 | =sum(A1:A6) |\n| | | \
            |\n| | | |\n| 2 | | |\n| 3 | | |\n| 4 | | |\n:::\n")
    ed.undo()
    saves("and one undo takes both away", ed@, arena, before)
    edited(ed@, .remove_row, 1, 2)
    saves("two rows removed at once take their range's cells with them", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 | =sum(A1:A2) |\n| 4 | \
            | |\n:::\n")
    ed.undo()
    saves("and one undo brings both back", ed@, arena, before)
    edited(ed@, .insert_column, 1, 2)
    saves("two columns inserted at once", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"\" | \"\" | \"b\" | \"c\" |\n| 1 | | | 2 | \
            =sum(A1:A4) |\n| 2 | | | | |\n| 3 | | | | |\n| 4 | | | | |\n:::\n")
    ed.undo()
    edited(ed@, .remove_column, 0, 2)
    saves("two columns removed at once", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"c\" |\n| =sum(#REF!) |\n| |\n| |\n| |\n:::\n")
    ed.undo()
    $why: U8[] = ""
    ed.edit_table(0, .remove_column, 0, 3, Sz[]::{}) catch e
        why = e.message()
    verdict.check("removing every column is refused",
        why.find_str("at least one column").is_some(), why)
    saves("and changes nothing", ed@, arena, before)

priv fn edited(ed: Editor$@, what: Table_edit, at: Sz, count: Sz)
    ed.edit_table(0, what, at, count, Sz[]::{}) catch e
        verdict.check("an edit of several lines", false, e.message())

priv fn removing()
    defer arena: = Arena(64 * 1024)
    before: =
        "%ksmd 2\n\nText\n\n:::table name=\"a\"\n| \"x\" |\n| 5 |\n:::\n\n:::table name=\"b\"\n| \
            \"y\" |\n| =a.A1*2 |\n:::\n"
    $ed: = opened(before, arena)
    ed.remove_table(1) catch e
        verdict.check("removing a table", false, e.message())
    saves("a removed table's references from another table stay as written", ed@, arena,
        "%ksmd 2\n\nText\n\n:::table name=\"b\"\n| \"y\" |\n| =a.A1*2 |\n:::\n")
    verdict.check("and calculate as #REF!", is_error(ed@, 1, 0, 0, arena), "")
    verdict.check("the caret goes to the end of the text before, as a table stands after",
        ed.focus.place == .text && ed.focus.block == 0 && ed.focus.offset == 4, "")
    inserted(ed@, 1, 1)
    verdict.check("a new table takes the free name, and no removed table answers to it",
        written(ed.doc@, arena).find_str("name=\"table1\"").is_some(), "")
    ed.undo()
    ed.undo()
    saves("undo brings the table back", ed@, arena, before)
    verdict.check("with the reference attached again", value(ed@, 1, 0, 0, arena) == 10.0, "")
    span: = text_spot(0, 0, 2)
    ed.select(span, gap_spot(2))
    ed.erase(true) catch e
        verdict.check("deleting across a table", false, e.message())
    saves("deleting a selection that holds a table removes it", ed@, arena,
        "%ksmd 2\n\nTe\n\n:::table name=\"b\"\n| \"y\" |\n| =a.A1*2 |\n:::\n")
    verdict.check("and its references calculate as #REF!", is_error(ed@, 1, 0, 0, arena), "")
    ed.undo()
    verdict.check("undo brings it back attached", value(ed@, 1, 0, 0, arena) == 10.0, "")

priv fn naming()
    defer arena: = Arena(64 * 1024)
    $ed: =
        opened("%ksmd 2\n\n:::table name=\"a\"\n| \"x\" |\n| 3 |\n:::\n\n:::table name=\"b\"\n| \
            \"y\" | \"z\" |\n| =a.A1 | =c.A1 |\n:::\n", arena)
    ed.rename_table(0, "c") catch e
        verdict.check("renaming a table", false, e.message())
    saves("a renamed table's references follow it, and text naming it attaches", ed@, arena,
        "%ksmd 2\n\n:::table name=\"c\"\n| \"x\" |\n| 3 |\n:::\n\n:::table name=\"b\"\n| \"y\" | \
            \"z\" |\n| =c.A1 | =c.A1 |\n:::\n")
    verdict.check("both now calculate", value(ed@, 1, 0, 1, arena) == 3.0, "")
    refused(ed@, "a name another table has is refused", .taken, "Another table")
    refused(ed@, "a name the reader refuses is refused", .bad_name, "control characters")
    ed.undo()
    verdict.check("undo gives the old name back",
        written(ed.doc@, arena).find_str("name=\"a\"").is_some(), "")
    ed.rename_table(0, "Q1 sales | \"net\"") catch e
        verdict.check("a name with spaces, a pipe and quotes", false, e.message())
    quoted: =
        "%ksmd 2\n\n:::table name=\"Q1 sales | \\\"net\\\"\"\n| \"x\" |\n| 3 |\n:::\n\n:::table \
            name=\"b\"\n| \"y\" | \"z\" |\n| =\"Q1 sales | \"\"net\"\"\".A1 | =c.A1 |\n:::\n"
    saves("a name that is not plain is quoted in a formula, each quote twice", ed@, arena, quoted)
    verdict.check("and its references still calculate", value(ed@, 1, 0, 0, arena) == 3.0, "")
    defer $long: = Str_builder()
    long.s("%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | =t.A1")
    for _ in Range.asc(800)
        long.s("+t.A1")
    long.s(" |\n:::\n")
    $grown: = opened(long.slice(), arena)
    $renamed: = true
    grown.rename_table(0, "quarterly_sales") catch e
        renamed = false
        verdict.check("a name that would write a formula past 4,096 bytes is refused",
            e.message().equals(Refused.table(.too_long).message()), e.message())
    verdict.check("so the table keeps its name", !renamed, "")
    saves("and the document stays as it was", grown@, arena, long.slice())

priv fn widths()
    defer arena: = Arena(64 * 1024)
    before: = "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 | =A1+B1 |\n:::\n"
    $ed: = opened(before, arena)
    resized(ed@, "120,85,0", arena)
    saves("widths are saved in characters, empty for a column that fits its text", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\" char_widths=\"12,8.5,\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 \
            | =A1+B1 |\n:::\n")
    verdict.check("the cells and their values stay", value(ed@, 0, 0, 2, arena) == 3.0, "")
    last: = ed.history.done[ed.history.done.len - 1]@
    verdict.check("the step records the widths alone, and no copy of the table",
        last.columns.len == 1 && last.tables.len == 0 && last.cells.len == 0, "")
    resized(ed@, "10,10,20", arena)
    ed.undo()
    saves("undo gives the widths before back", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\" char_widths=\"12,8.5,\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 \
            | =A1+B1 |\n:::\n")
    ed.undo()
    saves("and the table that had none", ed@, arena, before)
    ed.redo()
    ed.redo()
    saves("redo sets them again", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\" char_widths=\"1,1,2\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 | \
            =A1+B1 |\n:::\n")
    changed(ed@, 0, .remove_column, 0)
    changed(ed@, 0, .insert_column, 2)
    saves("a column's width goes with it, and a new last column takes the width before it", ed@,
        arena,
        "%ksmd 2\n\n:::table name=\"t\" char_widths=\"1,2,2\"\n| \"b\" | \"c\" | \"\" |\n| 2 | \
            =#REF!+A1 | |\n:::\n")
    resized(ed@, "0,0,0", arena)
    saves("widths that all fit their text take the attribute away", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"b\" | \"c\" | \"\" |\n| 2 | =#REF!+A1 | |\n:::\n")
    wrong_widths(ed@, "two widths for three columns are refused", "10,20", arena)
    wrong_widths(ed@, "a width over 255 characters is refused", "10,2551,10", arena)
    wrong_widths(ed@, "a width under half a character is refused", "10,4,10", arena)

priv fn wrong_widths(ed: Editor$@, what: U8[], tenths: U8[], arena: Arena$@) //<
    //< Giving block 0's table these widths is refused, and changes nothing
    before: = written(ed.doc@, arena)
    list: = tenths_of(tenths, arena)
    ed.set_widths(0, list@) catch e
        verdict.check(what,
            e.message().find_str("0.5 to 255 characters").is_some() &&
            written(ed.doc@, arena).equals(before), e.message())
        return
    verdict.check(what, false, "the action was taken")

priv fn resized(ed: Editor$@, tenths: U8[], arena: Arena$@) //<
    //< gives block 0's table these widths, in tenths of a character
    list: = tenths_of(tenths, arena)
    ed.set_widths(0, list@) catch e
        verdict.check(tenths, false, e.message())

priv fn tenths_of(text: U8[], arena: Arena$@): List<|Sz|> //< the widths `120,85,0` names
    $list: = List<|Sz|>(arena)
    for part in text.split(',', arena)
        list.push(part.to_count(100000) catch 0)
    return list

priv enum Wrong //< an action a check expects to be refused
    pipe //< a formula with a '|' outside quotes, in cell B1 of block 0
    empty //< an `=` alone, in cell B1 of block 0
    row //< removing row 6 of block 0
    taken //< naming block 0's table `b`
    bad_name //< naming it with a line break in the name

priv fn refused(ed: Editor$@, what: U8[], action: Wrong, says: U8[]) //<
    //< The action is refused with a message that holds `says`
    _took: = attempt(ed, action) catch e
        verdict.check(what, e.message().find_str(says).is_some(), e.message())
        return
    verdict.check(what, false, "the action was taken")

priv fn attempt(ed: Editor$@, action: Wrong): Bool!Refused
    switch action
    case .pipe
        ed.set_cell(0, 0, 1, "=A1 | B1")!
    case .empty
        ed.set_cell(0, 0, 1, "=")!
    case .row
        ed.edit_table(0, .remove_row, 5, 1, Sz[]::{})!
    case .taken
        ed.rename_table(0, "b")!
    case .bad_name
        ed.rename_table(0, "two\nlines")!
    return true

priv fn dated() //< a date cell reads, saves and sorts as a date
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 2\n\n:::table name=\"t\"\n| \"d\" |\n"
    text: =
        join3(head, "| 2026-10-23 |\n| \"2026-01-01\" |\n| 2025-02-28 |\n| 3 |\n", ":::\n", arena)
    $ed: = opened(text, arena)
    saves("a date stands bare, and a quoted one stays text", ed@, arena, text)
    sorted(ed@, 0, false)
    saves("numbers sort first, then dates by day, then text", ed@, arena,
        join3(head, "| 3 |\n| 2025-02-28 |\n| 2026-10-23 |\n| \"2026-01-01\" |\n", ":::\n", arena))
    rest: = "| 2025-02-28 |\n| 2026-10-23 |\n| \"2026-01-01\" |\n:::\n"
    set(ed@, 0, 0, 0, "2024-02-29")
    saves("a typed date is a date", ed@, arena, join3(head, "| 2024-02-29 |\n", rest, arena))
    set(ed@, 0, 0, 0, "2026-02-30")
    saves("a day that is no date stays text", ed@, arena,
        join3(head, "| \"2026-02-30\" |\n", rest, arena))
    set(ed@, 0, 0, 0, "2026/10/26")
    saves("a date typed with / is a date, kept with -", ed@, arena,
        join3(head, "| 2026-10-26 |\n", rest, arena))
    set(ed@, 0, 0, 0, "2026/1/5")
    saves("its month and day take one digit too", ed@, arena,
        join3(head, "| 2026-01-05 |\n", rest, arena))
    for typed in U8[][]::{ "2026/02/30", "2026/1/", "26/10/26", "2026/10-26", "2026/100/1" }
        set(ed@, 0, 0, 0, typed)
        verdict.check(arena.text().s("a typed \{typed\} that is no date stays text").take(),
            ed.cell_text(0, 0, 0, arena)
            .equals(arena.text().c('"').s(typed).c('"').take()) ||
            ed.cell_text(0, 0, 0, arena).equals(typed), ed.cell_text(0, 0, 0, arena))

priv fn sorting()
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 2\n\n:::table name=\"t\"\n| \"item\" | \"n\" | \"double\" |\n"
    before: =
        join3(head,
        "| \"pear\" | 3 | =B1*2 |\n| \"Apple\" | | =B2*2 |\n| \"fig\" | 1 | =B3*2 |\n| \"apple\" | \
            =1/0 | =B4*2 |\n", ":::\n", arena)
    $ed: = opened(before, arena)
    sorted(ed@, 1, false)
    by_number: =
        join3(head,
        "| \"fig\" | 1 | =B1*2 |\n| \"pear\" | 3 | =B2*2 |\n| \"apple\" | =1/0 | =B3*2 |\n| \
            \"Apple\" | | =B4*2 |\n", ":::\n", arena)
    saves("numbers sort first, smallest first, then errors, and empty cells last", ed@, arena,
        by_number)
    verdict.check("each formula stays on its row's cells",
        value(ed@, 0, 0, 2, arena) == 2.0 && value(ed@, 0, 1, 2, arena) == 6.0, "")
    sorted(ed@, 1, true)
    by_number_down: =
        join3(head,
        "| \"apple\" | =1/0 | =B1*2 |\n| \"pear\" | 3 | =B2*2 |\n| \"fig\" | 1 | =B3*2 |\n| \
            \"Apple\" | | =B4*2 |\n", ":::\n", arena)
    saves("descending reverses that, and empty cells stay last", ed@, arena, by_number_down)
    ed.undo()
    ed.undo()
    saves("undo puts each sort back", ed@, arena, before)
    sorted(ed@, 0, false)
    by_text: =
        join3(head,
        "| \"Apple\" | | =B1*2 |\n| \"apple\" | =1/0 | =B2*2 |\n| \"fig\" | 1 | =B3*2 |\n| \"pear\" \
            | 3 | =B4*2 |\n", ":::\n", arena)
    saves("text sorts A to Z without regard to case, and equal text keeps its order", ed@, arena,
        by_text)
    sorted(ed@, 0, true)
    by_text_down: =
        join3(head,
        "| \"pear\" | 3 | =B1*2 |\n| \"fig\" | 1 | =B2*2 |\n| \"Apple\" | | =B3*2 |\n| \"apple\" | \
            =1/0 | =B4*2 |\n", ":::\n", arena)
    saves("and Z to A, equal text still in its order", ed@, arena, by_text_down)
    $outside: = false
    ed.sort_table(0, 3, false) catch
        outside = true
    verdict.check("a column outside the table is refused", outside, "")

priv fn sorting_ranges() //<
    //< A sort moves a formula on a sorted row as a copy, unless the shift would leave the table,
    //< while another table's range keeps its places and its reference to one cell follows its
    //< row; moving rows by hand still moves a range's corners with them
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 2\n\n:::table name=\"t\"\n| \"n\" | \"all\" | \"fixed\" |\n"
    other: = ":::table name=\"s\"\n| \"total\" | \"first\" |\n"
    totals: = join3(other, "| =sum(t.A1:A3) | =t.A1 |\n", ":::\n", arena)
    before: =
        join3(head, "| 1 | =sum(A1:A3) | =sum(A$1:A$3) |\n| 3 | | |\n| 2 | | |\n:::\n\n", totals,
        arena)
    $ed: = opened(before, arena)
    sorted(ed@, 0, true)
    totals_sorted: = join3(other, "| =sum(t.A1:A3) | =t.A3 |\n", ":::\n", arena)
    sorted_text: =
        join3(head, "| 3 | | |\n| 2 | | |\n| 1 | =sum(A1:A3) | =sum(A$1:A$3) |\n:::\n\n",
        totals_sorted, arena)
    saves("on a sorted row, a range a shift would take out of the table keeps its places, and one \
        with $ stays", ed@, arena, sorted_text)
    verdict.check("so both totals add every row, and another table keeps its references",
        value(ed@, 0, 2, 1, arena) == 6.0 && value(ed@, 0, 2, 2, arena) == 6.0 &&
        value(ed@, 1, 0, 0, arena) == 6.0 && value(ed@, 1, 0, 1, arena) == 1.0, "")
    ed.undo()
    saves("undo puts the sort and the ranges back", ed@, arena, before)
    ed.move_lines(0, true, 0, 1, 3) catch e
        verdict.check("moving a row", false, e.message())
    totals_moved: = join3(other, "| =sum(t.A2:A3) | =t.A3 |\n", ":::\n", arena)
    moved_text: =
        join3(head, "| 3 | | |\n| 2 | | |\n| 1 | =sum(A2:A3) | =sum(A$2:A$3) |\n:::\n\n",
        totals_moved, arena)
    saves("a row moved by hand takes a range's corner with it", ed@, arena, moved_text)

priv fn sorting_row_totals() //<
    //< A range within one row moves with its row on a sort, as a reference to one cell does
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 2\n\n:::table name=\"t\"\n| \"item\" | \"q1\" | \"q2\" | \"total\" |\n"
    other: = ":::table name=\"s\"\n| \"ink\" |\n| =sum(t.B2:C2) |\n:::\n"
    rows: =
        "| \"Pens\" | 1 | 10 | =sum(B1:C1) |\n| \"Ink\" | 3 | 30 | =sum(B2:C2) |\n| \"Paper\" | 2 | \
            20 | =sum(B3:C3) |\n:::\n\n"
    $ed: = opened(join3(head, rows, other, arena), arena)
    sorted(ed@, 1, true)
    other_sorted: = ":::table name=\"s\"\n| \"ink\" |\n| =sum(t.B1:C1) |\n:::\n"
    rows_sorted: =
        "| \"Ink\" | 3 | 30 | =sum(B1:C1) |\n| \"Paper\" | 2 | 20 | =sum(B2:C2) |\n| \"Pens\" | 1 | \
            10 | =sum(B3:C3) |\n:::\n\n"
    saves("a range within one row moves with its row", ed@, arena,
        join3(head, rows_sorted, other_sorted, arena))
    verdict.check("and each row's total adds its own figures",
        value(ed@, 0, 0, 3, arena) == 33.0 && value(ed@, 0, 1, 3, arena) == 22.0 &&
        value(ed@, 0, 2, 3, arena) == 11.0 && value(ed@, 1, 0, 0, arena) == 33.0, "")

priv fn sorting_as_copies() //<
    //< A formula on a sorted row moves as a copy: a running total keeps running, and a part with
    //< `$` keeps its place; a total in another table keeps its places
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 2\n\n:::table name=\"t\"\n| \"item\" | \"n\" | \"running\" | \"gap\" |\n"
    other: = ":::table name=\"s\"\n| \"total\" |\n| =sum(t.B1:B3) |\n:::\n"
    rows: =
        "| \"Ink\" | 3 | =sum(B$1:B1) | =B1-B$1 |\n| \"Pens\" | 1 | =sum(B$1:B2) | =B2-B$1 |\n| \
            \"Paper\" | 2 | =sum(B$1:B3) | =B3-B$1 |\n:::\n\n"
    $ed: = opened(join3(head, rows, other, arena), arena)
    sorted(ed@, 1, false)
    rows_sorted: =
        "| \"Pens\" | 1 | =sum(B$1:B1) | =B1-B$1 |\n| \"Paper\" | 2 | =sum(B$1:B2) | =B2-B$1 |\n| \
            \"Ink\" | 3 | =sum(B$1:B3) | =B3-B$1 |\n:::\n\n"
    saves("each formula on a sorted row is written as a copy to the row's new place", ed@, arena,
        join3(head, rows_sorted, other, arena))
    verdict.check("so the running total runs in the new order",
        value(ed@, 0, 0, 2, arena) == 1.0 && value(ed@, 0, 1, 2, arena) == 3.0 &&
        value(ed@, 0, 2, 2, arena) == 6.0, "")
    verdict.check("a part with $ names the first row in the new order",
        value(ed@, 0, 0, 3, arena) == 0.0 && value(ed@, 0, 2, 3, arena) == 2.0, "")
    verdict.check("and the column total in another table still adds every row",
        value(ed@, 1, 0, 0, arena) == 6.0, "")

priv fn looks()
    defer arena: = Arena(64 * 1024)
    before: = "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | 2 |\n| 3 | 4 |\n:::\n"
    $ed: = opened(before, arena)
    ed.set_look(0, -1, 0, 0, 1, .fill, "#FFF2CC") catch e
        verdict.check("setting a fill", false, e.message())
    ed.set_look(0, 0, 1, 1, 1, .align, "center") catch e
        verdict.check("setting an alignment", false, e.message())
    painted: =
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" {fill=\"#fff2cc\"} | \"b\" {fill=\"#fff2cc\"} |\n| \
            1 {fill=\"#fff2cc\"} | 2 {fill=\"#fff2cc\" align=\"center\"} |\n| 3 | 4 \
            {align=\"center\"} |\n:::\n"
    saves("a look is set on every cell of a rectangle, the names included", ed@, arena, painted)
    set(ed@, 0, 0, 1, "20")
    verdict.check("a new value keeps the cell's look",
        written(ed.doc@, arena).find_str("| 20 {fill=\"#fff2cc\" align=\"center\"} |").is_some(), "")
    ed.undo()
    ed.undo()
    ed.undo()
    saves("undo takes each look back off", ed@, arena, before)
    $refused_look: = false
    ed.set_look(0, 0, 0, 0, 0, .size, "100") catch
        refused_look = true
    verdict.check("a size outside 6 to 72 points is refused", refused_look, "")
    ed.set_look(0, 0, 0, 1, 0, .wrap, "on") catch e
        verdict.check("setting wrap", false, e.message())
    wrapped: =
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 {wrap=\"on\"} | 2 |\n| 3 \
            {wrap=\"on\"} | 4 |\n:::\n"
    saves("wrap is set on each chosen cell, as Excel's Wrap Text", ed@, arena, wrapped)
    ed.set_look(0, 0, 0, 0, 0, .wrap, "") catch e
        verdict.check("clearing wrap", false, e.message())
    verdict.check("an empty value stops a cell wrapping",
        written(ed.doc@, arena).find_str("| 1 | 2 |").is_some(), "")
    $refused_wrap: = false
    ed.set_look(0, 0, 0, 0, 0, .wrap, "yes") catch
        refused_wrap = true
    verdict.check("wrap other than on is refused", refused_wrap, "")

priv fn across() //< Centre across columns: one step over the chosen range, a look alone
    defer arena: = Arena(64 * 1024)
    before: =
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n| 2129920 | | =A1 |\n:::\n"
    $ed: = opened(before, arena)
    ed.set_look(0, 0, 0, 0, 1, .align, "across") catch e
        verdict.check("centring across columns", false, e.message())
    saves("Centre across columns sets across on every chosen cell, the value staying in its own",
        ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n| 2129920 {align=\"across\"} | \
            {align=\"across\"} | =A1 |\n:::\n")
    ed.undo()
    saves("one undo takes across off every cell it was set on", ed@, arena, before)

priv fn one(cell: U8[], a: Arena$@): U8[] //< a source holding a table with one data cell
    return a.text().s("%ksmd 2\n\n:::table name=\"t\"\n| \"a\" |\n").s(cell).s("\n:::\n").take()

priv fn auto_entry() //< a typed 11/6 is a date and an address a link, each undone alone, or off
    defer arena: = Arena(64 * 1024)
    $ed: = opened(one("| |", arena), arena)
    set(ed@, 0, 0, 0, "11/6")
    saves("a typed 11/6 is a date in the year the document opened", ed@, arena,
        one("| 2026-11-06 |", arena))
    ed.undo()
    saves("Ctrl+Z right after gives back the text as typed", ed@, arena,
        one("| \"11/6\" |", arena))
    ed.undo()
    saves("and a second one what the cell held before", ed@, arena, one("| |", arena))
    set(ed@, 0, 0, 0, "2/30")
    saves("a day that does not exist stays text", ed@, arena, one("| \"2/30\" |", arena))
    set(ed@, 0, 0, 0, "https://example.com/a")
    saves("a typed web address is text that links to it", ed@, arena,
        one("| \"https://example.com/a\" {link=\"https://example.com/a\"} |", arena))
    ed.undo()
    saves("and Ctrl+Z right after takes the link alone away", ed@, arena,
        one("| \"https://example.com/a\" |", arena))
    ed.auto = ::{ .dates = false, .links = false, .brackets = false }
    set(ed@, 0, 0, 0, "11/6")
    saves("turned off, 11/6 stays text", ed@, arena, one("| \"11/6\" |", arena))
    set(ed@, 0, 0, 0, "2026/1/5")
    saves("so does a date written with '/'", ed@, arena, one("| \"2026/1/5\" |", arena))
    set(ed@, 0, 0, 0, "2026-01-05")
    saves("the file's own form is a date still", ed@, arena, one("| 2026-01-05 |", arena))
    set(ed@, 0, 0, 0, "https://example.com/b")
    saves("and a web address stays plain text", ed@, arena,
        one("| \"https://example.com/b\" |", arena))

priv fn closing_formulas() //< Enter adds a formula's missing `)` as a step of its own, or off
    defer arena: = Arena(64 * 1024)
    $ed: = opened(one("| |", arena), arena)
    set(ed@, 0, 0, 0, "=sum(1, max(2, 3")
    saves("a formula missing its last brackets takes them", ed@, arena,
        one("| =sum(1, max(2, 3)) |", arena))
    ed.undo()
    saves("Ctrl+Z right after gives back the formula as typed", ed@, arena,
        one("| =sum(1, max(2, 3 |", arena))
    set(ed@, 0, 0, 0, "=round(2.5")
    saves("a function given too few arguments keeps the text as typed", ed@, arena,
        one("| =round(2.5 |", arena))
    set(ed@, 0, 0, 0, "=len(\"a(b")
    saves("text still in quotes takes its quote, then the bracket", ed@, arena,
        one("| =len(\"a(b\") |", arena))
    ed.undo()
    saves("as one step, since the file cannot hold text open in quotes", ed@, arena,
        one("| =round(2.5 |", arena))
    set(ed@, 0, 0, 0, "=1+(")
    saves("a formula that does not read with them keeps the text as typed", ed@, arena,
        one("| =1+( |", arena))
    set(ed@, 0, 0, 0, "=round(1, 2))")
    saves("so does one with a ) too many", ed@, arena, one("| =round(1, 2)) |", arena))
    ed.auto = ::{ .dates = true, .links = true, .brackets = false }
    set(ed@, 0, 0, 0, "=sum(1, 2")
    saves("turned off, the formula stays as typed", ed@, arena, one("| =sum(1, 2 |", arena))

priv fn closings() //< what closes a formula at its end, or nothing where an ending cannot
    closes("=sum(A1", ")")
    closes("=round(sum(A1:A3), 2", ")")
    closes("=if(A1, len(\"x\"", "))")
    closes("=len(\"a(b", "\")")
    closes("=len(\"a)b\"", ")")
    closes("=len(\"say \"\"hi", "\")")
    closes("=like(A1, \".\\src\\", "\")")
    closes("=\"open", "\"")
    closes("=sum(A1)", "")
    closes("=1+2", "")
    closes("=sum(A1))", "")
    closes("=1)+(2", "")

priv fn closes(text: U8[], want: U8[]) //< `closing` of a formula gives `want`
    defer $out: = Str_builder()
    closing(text, out@)
    defer arena: = Arena(4096)
    what: = arena.text().s("the ending that closes \{text\} is \{want\}").take()
    verdict.check(what, out.slice().equals(want), out.slice())

priv fn partners() //< the bracket that pairs with the one at a byte, never one in quotes
    pairs("=sum(A1)", 4, 7)
    pairs("=sum(A1)", 7, 4)
    pairs("=round(sum(A1), 2)", 6, 17)
    pairs("=round(sum(A1), 2)", 13, 10)
    pairs("=len(\"(\")", 4, 8)
    pairs("=len(\"(\")", 6, -1)
    pairs("=1)+(2)", 4, 6)
    pairs("=1)+(2)", 2, -1)
    pairs("=sum(A1", 4, -1)
    pairs("=sum(A1)", 1, -1)

priv fn pairs(text: U8[], at: Sz, want: Sz) //< `partner` of the byte `at` in a formula is `want`
    defer arena: = Arena(4096)
    got: = partner(text, at, arena)
    what: = arena.text().s("the bracket at \{at\} in \{text\} pairs with \{want\}").take()
    verdict.check(what, got == want, arena.text().s("\{got\}").take())

priv fn pasting_whole()
    defer arena: = Arena(64 * 1024)
    copy: =
        ":::table name=\"t\" char_widths=\"1,2\" filter=\",above:1\"\n| \"a\" | \"b\" |\n| 1 | \
            =t.A1+u.A1 |\n:::\n"
    pasted: =
        ":::table name=\"t_2\" char_widths=\"1,2\" filter=\",above:1\"\n| \"a\" | \"b\" |\n| 1 | \
            =t_2.A1+u.A1 |\n:::\n"
    before: = arena.text().s("%ksmd 2\n\nText\n\n").s(copy).take()
    $ed: = opened(before, arena)
    at: = text_spot(0, 0, 2)
    ed.select(at, at)
    ed.paste_table(arena.text().s("%ksmd 2\n\n").s(copy).take()) catch e
        verdict.check("pasting a whole table", false, e.message())
    saves("a whole table pastes after the caret's paragraph, its name made free and followed", ed@,
        arena,
        arena.text().s("%ksmd 2\n\nText\n\n").s(pasted).s("\n").s(copy).take())
    ed.undo()
    saves("and one undo takes it out", ed@, arena, before)
    for wrong in U8[][]::{ "%ksmd 2\n\nText\n", "Text", "%ksmd 2\n\n:::table name=\"x\"\n" }
        $refused_paste: = false
        ed.paste_table(wrong) catch e
            refused_paste = e.message().starts_with("The clipboard holds no table")
        verdict.check("text that is no ksmd source of one table is refused", refused_paste, wrong)

priv fn pasting()
    defer arena: = Arena(64 * 1024)
    before: = "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | 2 |\n:::\n"
    $ed: = opened(before, arena)
    $grid: = List<|List<|U8[]|>|>(arena)
    grid.push(row3("Pens", "1,234.5", "=A1", arena))
    grid.push(row3("Paper", "", "12%", arena))
    ed.paste_cells(0, 0, 0, grid@) catch e
        verdict.check("pasting a grid", false, e.message())
    saves("a pasted grid fills cells and grows the table; 1,234.5 is a number", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"\" |\n| \"Pens\" | 1234.5 | =A1 |\n| \
            \"Paper\" | | \"12%\" |\n:::\n")
    ed.undo()
    saves("one undo takes the whole paste away", ed@, arena, before)
    $spaced: = List<|List<|U8[]|>|>(arena)
    spaced.push(row3("  Revenue", " 1,234.5 ", " 7 ", arena))
    ed.paste_cells(0, 0, 0, spaced@) catch e
        verdict.check("pasting spaced values", false, e.message())
    saves("a pasted text keeps its spaces, and a number reads without them", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"\" |\n| \"  Revenue\" | 1234.5 | 7 \
            |\n:::\n")
    ed.undo()
    $dated: = List<|List<|U8[]|>|>(arena)
    dated.push(row3(" 2026-10-23 ", "  2026/11/06 ", " Due ", arena))
    ed.paste_cells(0, 0, 0, dated@) catch e
        verdict.check("pasting spaced dates", false, e.message())
    saves("a pasted date reads without its spaces too, and text keeps them", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"\" |\n| 2026-10-23 | 2026-11-06 | \" \
            Due \" |\n:::\n")
    ed.undo()
    $bad: = List<|List<|U8[]|>|>(arena)
    bad.push(row3("x", "=A1 | B1", "y", arena))
    $refused_paste: = false
    ed.paste_cells(0, 0, 0, bad@) catch
        refused_paste = true
    verdict.check("a grid with a value the file cannot hold is refused", refused_paste, "")
    saves("and changes nothing", ed@, arena, before)
    $prose: = opened("%ksmd 2\n\nText\n", arena)
    prose.select(text_spot(0, 0, 4), text_spot(0, 0, 4))
    $table: = List<|List<|U8[]|>|>(arena)
    table.push(row3("Item", "Count", "Cost", arena))
    table.push(row3("Pens", "2", "3.5", arena))
    prose.insert_grid(table@) catch e
        verdict.check("a grid pasted into text", false, e.message())
    saves("a grid pasted into text becomes a table, its first row the names", prose@, arena,
        "%ksmd 2\n\nText\n\n:::table name=\"table1\"\n| \"Item\" | \"Count\" | \"Cost\" |\n| \
            \"Pens\" | 2 | 3.5 |\n:::\n")
    prose.undo()
    saves("and one undo takes it away", prose@, arena, "%ksmd 2\n\nText\n")

// The editor's arena lasts as long as the editor, so a paste keeps no copy of the tables there.
// A refused paste puts them back from the copy made to record the step.
priv fn kept_small()
    defer $tall: = Str_builder()
    tall.s("%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n")
    for i in Range.asc(1000)
        tall.s("| \{i\} | =A\{i + 1\}*2 |\n")
    tall.s(":::\n")
    defer arena: = Arena(64 * 1024)
    $ed: = opened(tall.slice(), arena)
    defer probe: = Arena(64 * 1024)
    _copy: = capture(ed.doc@, probe)
    copy: = probe.get_total_used()
    $one: = List<|List<|U8[]|>|>(probe)
    $cell: = List<|U8[]|>(probe)
    cell.push("7")
    one.push(cell)
    before: = arena.get_total_used()
    ed.paste_cells(0, 5, 1, one@) catch e
        verdict.check("pasting one cell", false, e.message())
    ed.select(gap_spot(1), gap_spot(1))
    ed.insert_grid(one@) catch e
        verdict.check("pasting a grid after the table", false, e.message())
    grew: = arena.get_total_used() - before
    verdict.check("a pasted cell and a pasted grid keep no copy of the tables", grew < copy / 4,
        arena.text().s("\{grew\} bytes kept, against \{copy\} for a copy").take())

priv fn filling()
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n"
    before: =
        join3(head, "| 1 | 10 | =A1+$B$1 |\n| 2 | 20 | |\n| 3 | 30 | |\n| 4 | 40 | |\n", ":::\n",
        arena)
    $ed: = opened(before, arena)
    filled(ed@, 0, 2, 1, 1, 3, 2)
    down: =
        join3(head,
        "| 1 | 10 | =A1+$B$1 |\n| 2 | 20 | =A2+$B$1 |\n| 3 | 30 | =A3+$B$1 |\n| 4 | 40 | =A4+$B$1 \
            |\n", ":::\n", arena)
    saves("fill down copies the top cell: a reference shifts, and a $ axis stays", ed@, arena, down)
    verdict.check("and the copies calculate on their own rows",
        value(ed@, 0, 3, 2, arena) == 14.0, "")
    ed.undo()
    saves("one undo takes the whole fill back", ed@, arena, before)
    filled(ed@, 0, 0, 2, 1, 3, 0)
    repeated: =
        join3(head, "| 1 | 10 | =A1+$B$1 |\n| 2 | 20 | |\n| 1 | 30 | |\n| 2 | 40 | |\n", ":::\n",
        arena)
    saves("a range of two cells repeats down the rest", ed@, arena, repeated)
    ed.undo()
    filled(ed@, 0, 0, 1, 1, 0, 2)
    saves("fill right copies the left cell across", ed@, arena,
        join3(head, "| 1 | 1 | 1 |\n| 2 | 20 | |\n| 3 | 30 | |\n| 4 | 40 | |\n", ":::\n", arena))
    ed.undo()
    $outside: = false
    ed.fill_cells(0, 0, 0, 1, 1, 4, 0, false, Sz[]::{}) catch
        outside = true
    verdict.check("a fill past the last row is refused", outside, "")
    saves("and changes nothing", ed@, arena, before)
    too_long(arena)

priv fn series() //< the fill handle goes on with a series where the cells make one
    goes_on("two numbers go on by their step", "| 1 |\n| 2 |", 2, "| 1 |\n| 2 |\n| 3 |\n| 4 |")
    goes_on("one number alone repeats", "| 5 |", 1, "| 5 |\n| 5 |\n| 5 |\n| 5 |")
    goes_on("decimal steps add without rounding error", "| 0.1 |\n| 0.2 |", 2,
        "| 0.1 |\n| 0.2 |\n| 0.3 |\n| 0.4 |")
    goes_on("a step down passes zero", "| 10 |\n| 7.5 |", 2, "| 10 |\n| 7.5 |\n| 5 |\n| 2.5 |")
    goes_on("steps that differ repeat", "| 1 |\n| 2 |\n| 4 |", 3, "| 1 |\n| 2 |\n| 4 |\n| 1 |")
    goes_on("text ending in a number goes on by one", "| \"Item 1\" |", 1,
        "| \"Item 1\" |\n| \"Item 2\" |\n| \"Item 3\" |\n| \"Item 4\" |")
    goes_on("or by its step", "| \"Q1\" |\n| \"Q3\" |", 2,
        "| \"Q1\" |\n| \"Q3\" |\n| \"Q5\" |\n| \"Q7\" |")
    goes_on("a number with leading zeros keeps its width", "| \"Week 08\" |", 1,
        "| \"Week 08\" |\n| \"Week 09\" |\n| \"Week 10\" |\n| \"Week 11\" |")
    goes_on("a date goes on by a day", "| 2026-10-30 |", 1,
        "| 2026-10-30 |\n| 2026-10-31 |\n| 2026-11-01 |\n| 2026-11-02 |")
    goes_on("or by its step, across a year", "| 2026-12-25 |\n| 2027-01-01 |", 2,
        "| 2026-12-25 |\n| 2027-01-01 |\n| 2027-01-08 |\n| 2027-01-15 |")
    goes_on("a date written as text repeats", "| \"2026-10-23\" |", 1,
        "| \"2026-10-23\" |\n| \"2026-10-23\" |\n| \"2026-10-23\" |\n| \"2026-10-23\" |")
    goes_on("and so does a time", "| \"14:05\" |", 1,
        "| \"14:05\" |\n| \"14:05\" |\n| \"14:05\" |\n| \"14:05\" |")
    goes_on("a code with a '-' before its number goes on", "| \"INV-001\" |", 1,
        "| \"INV-001\" |\n| \"INV-002\" |\n| \"INV-003\" |\n| \"INV-004\" |")
    goes_on("so does a version with a '.'", "| \"v1.9\" |", 1,
        "| \"v1.9\" |\n| \"v1.10\" |\n| \"v1.11\" |\n| \"v1.12\" |")
    goes_on("and a room with a letter before its '-'", "| \"Room A-12\" |", 1,
        "| \"Room A-12\" |\n| \"Room A-13\" |\n| \"Room A-14\" |\n| \"Room A-15\" |")
    defer arena: = Arena(64 * 1024)
    $ed: =
        opened("%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" | \"d\" |\n| 1 | 2 | | \
            |\n:::\n", arena)
    ed.fill_cells(0, 0, 0, 1, 2, 0, 3, true, Sz[]::{}) catch e
        verdict.check("a fill right", false, e.message())
    saves("a row goes on to the right", ed@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" | \"d\" |\n| 1 | 2 | 3 | 4 \
            |\n:::\n")

priv fn leaving_rows() //< a clear and a fill leave alone the rows they are told to, as hidden
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n"
    before: =
        join3(head, "| 1 | \"x\" |\n| 2 | \"y\" |\n| 3 | \"z\" |\n| 4 | \"w\" |\n", ":::\n", arena)
    $ed: = opened(before, arena)
    ed.clear_cells(0, 0, 0, 3, 1, Sz[]::{ 1, 3 }) catch e
        verdict.check("a clear", false, e.message())
    saves("a clear empties the cells of the rows it is not told to leave", ed@, arena,
        join3(head, "| | |\n| 2 | \"y\" |\n| | |\n| 4 | \"w\" |\n", ":::\n", arena))
    ed.undo()
    saves("and one undo gives them back", ed@, arena, before)
    $outside: = false
    ed.clear_cells(0, 0, 0, 3, 1, Sz[]::{ 4 }) catch
        outside = true
    verdict.check("a row left out past the last row is refused", outside, "")
    ed.fill_cells(0, 0, 1, 1, 1, 3, 1, false, Sz[]::{ 1 }) catch e
        verdict.check("a fill down", false, e.message())
    saves("a fill down copies the top cell over the rows not left out", ed@, arena,
        join3(head, "| 1 | \"x\" |\n| 2 | \"y\" |\n| 3 | \"x\" |\n| 4 | \"x\" |\n", ":::\n", arena))
    ed.undo()
    ed.fill_cells(0, 0, 0, 2, 1, 3, 0, true, Sz[]::{ 2 }) catch e
        verdict.check("a fill by the handle", false, e.message())
    saves("a series counts only the rows not left out, which neither give nor take", ed@, arena,
        join3(head, "| 1 | \"x\" |\n| 2 | \"y\" |\n| 3 | \"z\" |\n| 3 | \"w\" |\n", ":::\n", arena))
    ed.undo()
    ed.fill_cells(0, 0, 0, 4, 1, 3, 1, false, Sz[]::{ 2 }) catch e
        verdict.check("a fill right", false, e.message())
    saves("a fill right leaves the rows left out as they were", ed@, arena,
        join3(head, "| 1 | 1 |\n| 2 | 2 |\n| 3 | \"z\" |\n| 4 | 4 |\n", ":::\n", arena))
    ed.undo()
    $nothing: = false
    ed.fill_cells(0, 0, 0, 1, 1, 3, 0, false, Sz[]::{ 0 }) catch
        nothing = true
    verdict.check("a fill whose cells to copy are all left out is refused", nothing, "")
    saves("and changes nothing", ed@, arena, before)
    four: =
        join3(head, "| 1 | \"x\" |\n| 2 | \"y\" |\n| 3 | \"z\" |\n| 4 | =A2 |\n", ":::\n", arena)
    $formula: = opened(four, arena)
    formula.edit_table(0, .remove_row, 0, 3, Sz[]::{ 1 }) catch e
        verdict.check("a removal of rows", false, e.message())
    saves("a removal of rows leaves the rows left out, and their references", formula@, arena,
        join3(head, "| 2 | \"y\" |\n| 4 | =A1 |\n", ":::\n", arena))
    formula.undo()
    saves("and one undo brings every row back", formula@, arena, four)
    $none: = false
    formula.edit_table(0, .remove_row, 1, 1, Sz[]::{ 1 }) catch
        none = true
    verdict.check("a removal whose rows are all left out is refused", none, "")
    $columns: = false
    formula.edit_table(0, .remove_column, 0, 1, Sz[]::{ 1 }) catch
        columns = true
    verdict.check("rows left out are refused for a column edit", columns, "")

priv fn goes_on(what: U8[], first: U8[], given: Sz, expected: U8[]) //<
    //< A column of four rows whose `given` first cells are `first`, filled down by the handle
    defer arena: = Arena(64 * 1024)
    defer $rows: = Str_builder()
    rows.s(first)
    for _ in Range(given, 4, 1)
        rows.s("\n| |")
    head: = "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" |\n"
    $ed: = opened(join3(head, rows.slice(), "\n:::\n", arena), arena)
    ed.fill_cells(0, 0, 0, given, 1, 3, 0, true, Sz[]::{}) catch e
        verdict.check(what, false, e.message())
        return
    saves(what, ed@, arena, join3(head, expected, "\n:::\n", arena))

priv fn too_long(arena: Arena$@) //<
    //< A fill refused midway puts back the cells it copied before the refusal
    //< A long formula on A9 grows by one byte a reference when it is copied onto row 10.
    defer $long: = Str_builder()
    long.s("A9")
    for long.slice().len + 3 <= 4096
        long.s("+A9")
    defer $rows: = Str_builder()
    for r in Range.asc(10)
        rows.s("| \{r\} | ")
        if r == 8
            rows.s("=A9 | =").s(long.slice()).s(" |\n")
        else
            rows.s("| |\n")
    tall: =
        join3("%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n", rows.slice(), ":::\n",
        arena)
    $ed: = opened(tall, arena)
    $refused: = false
    ed.fill_cells(0, 8, 1, 1, 2, 9, 2, false, Sz[]::{}) catch e
        refused = e.message().equals(Refused.table(.too_long).message())
    verdict.check("a fill that would write a formula too long is refused", refused, "")
    saves("and the cell copied before the refusal is put back", ed@, arena, tall)
    verdict.check("nothing is left to undo", !ed.can_undo(), "")

priv fn filled(ed: Editor$@, top: Sz, left: Sz, height: Sz, width: Sz, bottom: Sz, right: Sz)
    ed.fill_cells(0, top, left, height, width, bottom, right, false, Sz[]::{}) catch e
        verdict.check("a fill", false, e.message())

priv fn row3(a: U8[], b: U8[], c: U8[], arena: Arena$@): List<|U8[]|> //< one row of a grid
    $line: = List<|U8[]|>(arena)
    line.push(a)
    line.push(b)
    line.push(c)
    return line

// ---- Helpers ----

priv fn sorted(ed: Editor$@, column: Sz, descending: Bool) //< sorts block 0's table by a column
    ed.sort_table(0, column, descending) catch e
        verdict.check("a sort", false, e.message())

priv fn inserted(ed: Editor$@, columns: Sz, rows: Sz)
    ed.insert_table(columns, rows) catch e
        verdict.check("inserting a table", false, e.message())

priv fn set(ed: Editor$@, block: Sz, row: Sz, column: Sz, text: U8[])
    ed.set_cell(block, row, column, text) catch e
        verdict.check(text, false, e.message())

priv fn shown(ed: Editor@, row: Sz, column: Sz, want: U8[], what: U8[], arena: Arena$@) //<
    //< What a cell of table 0 shows to edit, which sets the same value again
    got: = ed.cell_text(0, row, column, arena)
    verdict.check(what, got.equals(want), got)

priv fn value(ed: Editor@, u: Sz, row: Sz, column: Sz, arena: Arena$@): F64 //< a number, or -1
    r: = calc.calculate(ed.doc@, ed.today, arena)
    v: = r.at(u, row, column)
    return v.number if v.kind == .number else -1.0

priv fn is_error(ed: Editor@, u: Sz, row: Sz, column: Sz, arena: Arena$@): Bool
    r: = calc.calculate(ed.doc@, ed.today, arena)
    return r.at(u, row, column).kind == .error

priv fn join3(a: U8[], b: U8[], c: U8[], arena: Arena$@): U8[]
    return arena.text().s(a).s(b).s(c).take()

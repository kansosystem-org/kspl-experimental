//< Editor actions on tables: adding and removing one, row and column edits, sorting, cell values,
//< names, column widths, pasting and filling
//< Each check compares the saved source, and undo and redo give back the source before and after.
//< Values are checked through calculation, so a reference left on the wrong cell shows.
import "ksmd/base/source" { Source }
import "ksmd/calc/calc"
import "ksmd/edit/editor" { Editor, Refused }
import "ksmd/edit/editor"
import "ksmd/edit/editor_tables" { Table_edit }
import "ksmd/edit/region" { gap_spot, text_spot }
import "ksmd/syntax/reader"
import "ksmd/syntax/writer"
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strnum"
import "std/verdict"

priv const T1: U8[] = ":::table name=\"table1\"\n| \"\" | \"\" |\n| | |\n:::\n"

fn run()
    inserting()
    cells()
    rows_and_columns()
    removing()
    naming()
    widths()
    sorting()
    looks()
    pasting()
    filling()
    series()
    dated()

priv fn inserting()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 1\n\nAbcd\n", arena)
    p: = text_spot(0, 0, 2)
    ed.select(p, p)
    inserted(ed@, 2, 1)
    saves("a table put in the middle of a paragraph splits it", ed@, arena,
        join3("%ksmd 1\n\nAb\n\n", T1, "\ncd\n", arena))
    end: = gap_spot(3)
    ed.select(end, end)
    inserted(ed@, 1, 0)
    saves("a table at the end takes the next free name, with a header alone", ed@, arena,
        join3("%ksmd 1\n\nAb\n\n", T1, "\ncd\n\n:::table name=\"table2\"\n| \"\" |\n:::\n", arena))
    ed.undo()
    saves("undo takes the new table back out", ed@, arena,
        join3("%ksmd 1\n\nAb\n\n", T1, "\ncd\n", arena))
    ed.redo()
    redone: = source_of(ed@, arena)
    verdict.check("redo puts it back with its name",
        redone.ends_with("\n:::table name=\"table2\"\n| \"\" |\n:::\n"), redone)
    $loose: =
        opened("%ksmd 1\n\n:::table name=\"t\"\n| \"x\" |\n| =table1.A1*2 |\n:::\n", arena)
    at_end: = gap_spot(1)
    loose.select(at_end, at_end)
    inserted(loose@, 1, 1)
    set(loose@, 1, 0, 0, "21")
    verdict.check("a reference to a table not there yet attaches when the table is added",
        value(loose@, 0, 0, 0, arena) == 42.0, "")

priv fn cells()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | 2 |\n:::\n", arena)
    set(ed@, 0, -1, 0, "Count")
    set(ed@, 0, 0, 0, "12")
    set(ed@, 0, 0, 1, "=A1*3")
    saves("a name, a number and a formula as typed", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| 12 | =A1*3 |\n:::\n")
    verdict.check("the formula calculates", value(ed@, 0, 0, 1, arena) == 36.0, "")
    set(ed@, 0, 0, 0, "\"12\"")
    saves("a quoted number is text", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| \"12\" | =A1*3 |\n:::\n")
    shown(ed@, 0, 0, "\"12\"", "text that would read as a number shows quoted", arena)
    shown(ed@, 0, 1, "=A1*3", "a formula shows with its '='", arena)
    set(ed@, 0, 0, 0, "Pens")
    shown(ed@, 0, 0, "Pens", "other text shows as it is", arena)
    set(ed@, 0, 0, 0, "")
    saves("nothing makes the cell empty", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| | =A1*3 |\n:::\n")
    ed.undo()
    ed.undo()
    ed.undo()
    saves("undo gives each cell's value back, one step at a time", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| 12 | =A1*3 |\n:::\n")
    ed.redo()
    saves("redo sets the value again", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"Count\" | \"b\" |\n| \"12\" | =A1*3 |\n:::\n")
    refused(ed@, "a formula with a '|' outside quotes is refused", .pipe, "one cell")

priv fn rows_and_columns()
    defer arena: = Arena(64 * 1024)
    before: =
        "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | =A1+A2 |\n| 2 | =sum(A1:A2) \
            |\n:::\n"
    $ed: = opened(before, arena)
    changed(ed@, 0, .insert_row, 1)
    set(ed@, 0, 1, 0, "4")
    saves("a row inserted inside a range joins it", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | =A1+A3 |\n| 4 | |\n| 2 | \
            =sum(A1:A3) |\n:::\n")
    verdict.check("and the sum takes the new row", value(ed@, 0, 2, 1, arena) == 7.0, "")
    changed(ed@, 0, .remove_column, 0)
    saves("removing a column turns references to it into #REF!", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"b\" |\n| =#REF!+#REF! |\n| |\n| =sum(#REF!) |\n:::\n")
    ed.undo()
    verdict.check("undo brings the column and its references back",
        value(ed@, 0, 2, 1, arena) == 7.0, "")
    ed.undo()
    ed.undo()
    saves("undo takes the row back out", ed@, arena, before)
    changed(ed@, 0, .insert_column, 2)
    saves("a column added after the last", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"\" |\n| 1 | =A1+A2 | |\n| 2 | \
            =sum(A1:A2) | |\n:::\n")
    refused(ed@, "a row outside the table is refused", .row, "No table")

priv fn removing()
    defer arena: = Arena(64 * 1024)
    before: =
        "%ksmd 1\n\nText\n\n:::table name=\"a\"\n| \"x\" |\n| 5 |\n:::\n\n:::table name=\"b\"\n| \
            \"y\" |\n| =a.A1*2 |\n:::\n"
    $ed: = opened(before, arena)
    ed.remove_table(1) catch e
        verdict.check("removing a table", false, e.message())
    saves("a removed table's references from another table stay as written", ed@, arena,
        "%ksmd 1\n\nText\n\n:::table name=\"b\"\n| \"y\" |\n| =a.A1*2 |\n:::\n")
    verdict.check("and calculate as #REF!", is_error(ed@, 1, 0, 0, arena), "")
    verdict.check("the caret takes the gap the table left",
        ed.focus.place == .block_gap && ed.focus.block == 1, "")
    inserted(ed@, 1, 1)
    verdict.check("a new table takes the free name, and no removed table answers to it",
        source_of(ed@, arena).find_str("name=\"table1\"").is_some(), "")
    ed.undo()
    ed.undo()
    saves("undo brings the table back", ed@, arena, before)
    verdict.check("with the reference attached again", value(ed@, 1, 0, 0, arena) == 10.0, "")
    span: = text_spot(0, 0, 2)
    ed.select(span, gap_spot(2))
    ed.erase(true) catch e
        verdict.check("deleting across a table", false, e.message())
    saves("deleting a selection that holds a table removes it", ed@, arena,
        "%ksmd 1\n\nTe\n\n:::table name=\"b\"\n| \"y\" |\n| =a.A1*2 |\n:::\n")
    verdict.check("and its references calculate as #REF!", is_error(ed@, 1, 0, 0, arena), "")
    ed.undo()
    verdict.check("undo brings it back attached", value(ed@, 1, 0, 0, arena) == 10.0, "")

priv fn naming()
    defer arena: = Arena(64 * 1024)
    $ed: =
        opened("%ksmd 1\n\n:::table name=\"a\"\n| \"x\" |\n| 3 |\n:::\n\n:::table name=\"b\"\n| \
            \"y\" | \"z\" |\n| =a.A1 | =c.A1 |\n:::\n", arena)
    ed.rename_table(0, "c") catch e
        verdict.check("renaming a table", false, e.message())
    saves("a renamed table's references follow it, and text naming it attaches", ed@, arena,
        "%ksmd 1\n\n:::table name=\"c\"\n| \"x\" |\n| 3 |\n:::\n\n:::table name=\"b\"\n| \"y\" | \
            \"z\" |\n| =c.A1 | =c.A1 |\n:::\n")
    verdict.check("both now calculate", value(ed@, 1, 0, 1, arena) == 3.0, "")
    refused(ed@, "a name another table has is refused", .taken, "Another table")
    refused(ed@, "a name the reader refuses is refused", .bad_name, "control characters")
    ed.undo()
    verdict.check("undo gives the old name back",
        source_of(ed@, arena).find_str("name=\"a\"").is_some(), "")
    ed.rename_table(0, "Q1 sales | \"net\"") catch e
        verdict.check("a name with spaces, a pipe and quotes", false, e.message())
    quoted: =
        "%ksmd 1\n\n:::table name=\"Q1 sales | \\\"net\\\"\"\n| \"x\" |\n| 3 |\n:::\n\n:::table \
            name=\"b\"\n| \"y\" | \"z\" |\n| =\"Q1 sales | \\\"net\\\"\".A1 | =c.A1 |\n:::\n"
    saves("a name that is not plain is written in JSON quotes in a formula", ed@, arena, quoted)
    verdict.check("and its references still calculate", value(ed@, 1, 0, 0, arena) == 3.0, "")

priv fn widths()
    defer arena: = Arena(64 * 1024)
    before: = "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 | =A1+B1 |\n:::\n"
    $ed: = opened(before, arena)
    resized(ed@, "300,450,750", arena)
    saves("widths are saved divided by their greatest common divisor", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\" widths=\"2,3,5\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 | \
            =A1+B1 |\n:::\n")
    verdict.check("the cells and their values stay", value(ed@, 0, 0, 2, arena) == 3.0, "")
    last: = ed.history.done[ed.history.done.len - 1]@
    verdict.check("the step records the widths alone, and no copy of the table",
        last.columns.len == 1 && last.tables.len == 0 && last.cells.len == 0, "")
    resized(ed@, "1,1,2", arena)
    ed.undo()
    saves("undo gives the widths before back", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\" widths=\"2,3,5\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 | \
            =A1+B1 |\n:::\n")
    ed.undo()
    saves("and the table that had none", ed@, arena, before)
    ed.redo()
    ed.redo()
    saves("redo sets them again", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\" widths=\"1,1,2\"\n| \"a\" | \"b\" | \"c\" |\n| 1 | 2 | \
            =A1+B1 |\n:::\n")
    changed(ed@, 0, .remove_column, 0)
    changed(ed@, 0, .insert_column, 2)
    saves("a column's width goes with it, and a new last column takes the width before it", ed@,
        arena,
        "%ksmd 1\n\n:::table name=\"t\" widths=\"1,2,2\"\n| \"b\" | \"c\" | \"\" |\n| 2 | =#REF!+A1 \
            | |\n:::\n")
    wrong_widths(ed@, "two widths for three columns are refused", "1,2", arena)
    wrong_widths(ed@, "a width over 10,000 is refused", "1,10001,1", arena)
    wrong_widths(ed@, "a width of 0 is refused", "1,0,1", arena)

priv fn wrong_widths(ed: Editor$@, what: U8[], weights: U8[], arena: Arena$@) //<
    //< Giving block 0's table these widths is refused, and changes nothing
    before: = source_of(ed, arena)
    list: = weights_of(weights, arena)
    ed.set_widths(0, list@) catch e
        verdict.check(what,
            e.message().find_str("whole number").is_some() &&
            source_of(ed, arena).equals(before), e.message())
        return
    verdict.check(what, false, "the action was taken")

priv fn resized(ed: Editor$@, weights: U8[], arena: Arena$@) //< gives block 0's table these widths
    list: = weights_of(weights, arena)
    ed.set_widths(0, list@) catch e
        verdict.check(weights, false, e.message())

priv fn weights_of(text: U8[], arena: Arena$@): List<|Sz|> //< the weights `1,2,1` names
    $list: = List<|Sz|>(arena)
    for part in text.split(',', arena)
        list.push(part.to_count(100000) catch 0)
    return list

priv enum Wrong //< an action a check expects to be refused
    pipe //< a formula with a '|' outside quotes, in cell B1 of block 0
    row //< removing row 6 of block 0
    taken //< naming block 0's table `b`
    bad_name //< naming it with a line break in the name

priv fn refused(ed: Editor$@, what: U8[], action: Wrong, says: U8[]) //<
    //< The action is refused with a message that holds `says`
    _took: = attempt(ed, action) catch e
        verdict.check(what, e.message().find_str(says).is_some(), e.message())
        return
    verdict.check(what, false, "the action was taken")

priv fn attempt(ed: Editor$@, action: Wrong): Bool!Refused
    switch action
    case .pipe
        ed.set_cell(0, 0, 1, "=A1 | B1")!
    case .row
        ed.edit_table(0, .remove_row, 5)!
    case .taken
        ed.rename_table(0, "b")!
    case .bad_name
        ed.rename_table(0, "two\nlines")!
    return true

priv fn dated() //< a date cell reads, saves and sorts as a date
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 1\n\n:::table name=\"t\"\n| \"d\" |\n"
    text: =
        join3(head, "| 2026-10-23 |\n| \"2026-01-01\" |\n| 2025-02-28 |\n| 3 |\n", ":::\n", arena)
    $ed: = opened(text, arena)
    saves("a date stands bare, and a quoted one stays text", ed@, arena, text)
    sorted(ed@, 0, false)
    saves("numbers sort first, then dates by day, then text", ed@, arena,
        join3(head, "| 3 |\n| 2025-02-28 |\n| 2026-10-23 |\n| \"2026-01-01\" |\n", ":::\n", arena))
    rest: = "| 2025-02-28 |\n| 2026-10-23 |\n| \"2026-01-01\" |\n:::\n"
    set(ed@, 0, 0, 0, "2024-02-29")
    saves("a typed date is a date", ed@, arena, join3(head, "| 2024-02-29 |\n", rest, arena))
    set(ed@, 0, 0, 0, "2026-02-30")
    saves("a day that is no date stays text", ed@, arena,
        join3(head, "| \"2026-02-30\" |\n", rest, arena))

priv fn sorting()
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 1\n\n:::table name=\"t\"\n| \"item\" | \"n\" | \"double\" |\n"
    before: =
        join3(head,
        "| \"pear\" | 3 | =B1*2 |\n| \"Apple\" | | =B2*2 |\n| \"fig\" | 1 | =B3*2 |\n| \"apple\" | \
            =1/0 | =B4*2 |\n", ":::\n", arena)
    $ed: = opened(before, arena)
    sorted(ed@, 1, false)
    by_number: =
        join3(head,
        "| \"fig\" | 1 | =B1*2 |\n| \"pear\" | 3 | =B2*2 |\n| \"apple\" | =1/0 | =B3*2 |\n| \
            \"Apple\" | | =B4*2 |\n", ":::\n", arena)
    saves("numbers sort first, smallest first, then errors, and empty cells last", ed@, arena,
        by_number)
    verdict.check("each formula stays on its row's cells",
        value(ed@, 0, 0, 2, arena) == 2.0 && value(ed@, 0, 1, 2, arena) == 6.0, "")
    sorted(ed@, 1, true)
    by_number_down: =
        join3(head,
        "| \"apple\" | =1/0 | =B1*2 |\n| \"pear\" | 3 | =B2*2 |\n| \"fig\" | 1 | =B3*2 |\n| \
            \"Apple\" | | =B4*2 |\n", ":::\n", arena)
    saves("descending reverses that, and empty cells stay last", ed@, arena, by_number_down)
    ed.undo()
    ed.undo()
    saves("undo puts each sort back", ed@, arena, before)
    sorted(ed@, 0, false)
    by_text: =
        join3(head,
        "| \"Apple\" | | =B1*2 |\n| \"apple\" | =1/0 | =B2*2 |\n| \"fig\" | 1 | =B3*2 |\n| \"pear\" \
            | 3 | =B4*2 |\n", ":::\n", arena)
    saves("text sorts A to Z without regard to case, and equal text keeps its order", ed@, arena,
        by_text)
    sorted(ed@, 0, true)
    by_text_down: =
        join3(head,
        "| \"pear\" | 3 | =B1*2 |\n| \"fig\" | 1 | =B2*2 |\n| \"Apple\" | | =B3*2 |\n| \"apple\" | \
            =1/0 | =B4*2 |\n", ":::\n", arena)
    saves("and Z to A, equal text still in its order", ed@, arena, by_text_down)
    $outside: = false
    ed.sort_table(0, 3, false) catch
        outside = true
    verdict.check("a column outside the table is refused", outside, "")

priv fn looks()
    defer arena: = Arena(64 * 1024)
    before: = "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | 2 |\n| 3 | 4 |\n:::\n"
    $ed: = opened(before, arena)
    ed.set_look(0, -1, 0, 0, 1, .fill, "#FFF2CC") catch e
        verdict.check("setting a fill", false, e.message())
    ed.set_look(0, 0, 1, 1, 1, .align, "center") catch e
        verdict.check("setting an alignment", false, e.message())
    painted: =
        "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" {fill=\"#fff2cc\"} | \"b\" {fill=\"#fff2cc\"} |\n| \
            1 {fill=\"#fff2cc\"} | 2 {fill=\"#fff2cc\" align=\"center\"} |\n| 3 | 4 \
            {align=\"center\"} |\n:::\n"
    saves("a look is set on every cell of a rectangle, the names included", ed@, arena, painted)
    set(ed@, 0, 0, 1, "20")
    verdict.check("a new value keeps the cell's look",
        source_of(ed@, arena).find_str("| 20 {fill=\"#fff2cc\" align=\"center\"} |").is_some(), "")
    ed.undo()
    ed.undo()
    ed.undo()
    saves("undo takes each look back off", ed@, arena, before)
    $refused_look: = false
    ed.set_look(0, 0, 0, 0, 0, .size, "100") catch
        refused_look = true
    verdict.check("a size outside 6 to 72 points is refused", refused_look, "")

priv fn pasting()
    defer arena: = Arena(64 * 1024)
    before: = "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n| 1 | 2 |\n:::\n"
    $ed: = opened(before, arena)
    $grid: = List<|List<|U8[]|>|>(arena)
    grid.push(row3("Pens", "1,234.5", "=A1", arena))
    grid.push(row3("Paper", "", "12%", arena))
    ed.paste_cells(0, 0, 0, grid@) catch e
        verdict.check("pasting a grid", false, e.message())
    saves("a pasted grid fills cells and grows the table; 1,234.5 is a number", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"\" |\n| \"Pens\" | 1234.5 | =A1 |\n| \
            \"Paper\" | | \"12%\" |\n:::\n")
    ed.undo()
    saves("one undo takes the whole paste away", ed@, arena, before)
    $bad: = List<|List<|U8[]|>|>(arena)
    bad.push(row3("x", "=A1 | B1", "y", arena))
    $refused_paste: = false
    ed.paste_cells(0, 0, 0, bad@) catch
        refused_paste = true
    verdict.check("a grid with a value the file cannot hold is refused", refused_paste, "")
    saves("and changes nothing", ed@, arena, before)
    $prose: = opened("%ksmd 1\n\nText\n", arena)
    prose.select(text_spot(0, 0, 4), text_spot(0, 0, 4))
    $table: = List<|List<|U8[]|>|>(arena)
    table.push(row3("Item", "Count", "Cost", arena))
    table.push(row3("Pens", "2", "3.5", arena))
    prose.insert_grid(table@) catch e
        verdict.check("a grid pasted into text", false, e.message())
    saves("a grid pasted into text becomes a table, its first row the names", prose@, arena,
        "%ksmd 1\n\nText\n\n:::table name=\"table1\"\n| \"Item\" | \"Count\" | \"Cost\" |\n| \
            \"Pens\" | 2 | 3.5 |\n:::\n")
    prose.undo()
    saves("and one undo takes it away", prose@, arena, "%ksmd 1\n\nText\n")

priv fn filling()
    defer arena: = Arena(64 * 1024)
    head: = "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n"
    before: =
        join3(head, "| 1 | 10 | =A1+$B$1 |\n| 2 | 20 | |\n| 3 | 30 | |\n| 4 | 40 | |\n", ":::\n",
        arena)
    $ed: = opened(before, arena)
    filled(ed@, 0, 2, 1, 1, 3, 2)
    down: =
        join3(head,
        "| 1 | 10 | =A1+$B$1 |\n| 2 | 20 | =A2+$B$1 |\n| 3 | 30 | =A3+$B$1 |\n| 4 | 40 | =A4+$B$1 \
            |\n", ":::\n", arena)
    saves("fill down copies the top cell: a reference shifts, and a $ axis stays", ed@, arena, down)
    verdict.check("and the copies calculate on their own rows",
        value(ed@, 0, 3, 2, arena) == 14.0, "")
    ed.undo()
    saves("one undo takes the whole fill back", ed@, arena, before)
    filled(ed@, 0, 0, 2, 1, 3, 0)
    repeated: =
        join3(head, "| 1 | 10 | =A1+$B$1 |\n| 2 | 20 | |\n| 1 | 30 | |\n| 2 | 40 | |\n", ":::\n",
        arena)
    saves("a range of two cells repeats down the rest", ed@, arena, repeated)
    ed.undo()
    filled(ed@, 0, 0, 1, 1, 0, 2)
    saves("fill right copies the left cell across", ed@, arena,
        join3(head, "| 1 | 1 | 1 |\n| 2 | 20 | |\n| 3 | 30 | |\n| 4 | 40 | |\n", ":::\n", arena))
    ed.undo()
    $outside: = false
    ed.fill_cells(0, 0, 0, 1, 1, 4, 0, false) catch
        outside = true
    verdict.check("a fill past the last row is refused", outside, "")
    saves("and changes nothing", ed@, arena, before)
    too_long(arena)

priv fn series() //< the fill handle goes on with a series where the cells make one
    goes_on("two numbers go on by their step", "| 1 |\n| 2 |", 2, "| 1 |\n| 2 |\n| 3 |\n| 4 |")
    goes_on("one number alone repeats", "| 5 |", 1, "| 5 |\n| 5 |\n| 5 |\n| 5 |")
    goes_on("decimal steps add without rounding error", "| 0.1 |\n| 0.2 |", 2,
        "| 0.1 |\n| 0.2 |\n| 0.3 |\n| 0.4 |")
    goes_on("a step down passes zero", "| 10 |\n| 7.5 |", 2, "| 10 |\n| 7.5 |\n| 5 |\n| 2.5 |")
    goes_on("steps that differ repeat", "| 1 |\n| 2 |\n| 4 |", 3, "| 1 |\n| 2 |\n| 4 |\n| 1 |")
    goes_on("text ending in a number goes on by one", "| \"Item 1\" |", 1,
        "| \"Item 1\" |\n| \"Item 2\" |\n| \"Item 3\" |\n| \"Item 4\" |")
    goes_on("or by its step", "| \"Q1\" |\n| \"Q3\" |", 2,
        "| \"Q1\" |\n| \"Q3\" |\n| \"Q5\" |\n| \"Q7\" |")
    goes_on("a number with leading zeros keeps its width", "| \"Week 08\" |", 1,
        "| \"Week 08\" |\n| \"Week 09\" |\n| \"Week 10\" |\n| \"Week 11\" |")
    goes_on("a date goes on by a day", "| 2026-10-30 |", 1,
        "| 2026-10-30 |\n| 2026-10-31 |\n| 2026-11-01 |\n| 2026-11-02 |")
    goes_on("or by its step, across a year", "| 2026-12-25 |\n| 2027-01-01 |", 2,
        "| 2026-12-25 |\n| 2027-01-01 |\n| 2027-01-08 |\n| 2027-01-15 |")
    goes_on("a date written as text repeats", "| \"2026-10-23\" |", 1,
        "| \"2026-10-23\" |\n| \"2026-10-23\" |\n| \"2026-10-23\" |\n| \"2026-10-23\" |")
    defer arena: = Arena(64 * 1024)
    $ed: =
        opened("%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" | \"d\" |\n| 1 | 2 | | \
            |\n:::\n", arena)
    ed.fill_cells(0, 0, 0, 1, 2, 0, 3, true) catch e
        verdict.check("a fill right", false, e.message())
    saves("a row goes on to the right", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" | \"d\" |\n| 1 | 2 | 3 | 4 \
            |\n:::\n")

priv fn goes_on(what: U8[], first: U8[], given: Sz, expected: U8[]) //<
    //< A column of four rows whose `given` first cells are `first`, filled down by the handle
    defer arena: = Arena(64 * 1024)
    defer $rows: = Str_builder()
    rows.s(first)
    for _ in Range(given, 4, 1)
        rows.s("\n| |")
    head: = "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" |\n"
    $ed: = opened(join3(head, rows.slice(), "\n:::\n", arena), arena)
    ed.fill_cells(0, 0, 0, given, 1, 3, 0, true) catch e
        verdict.check(what, false, e.message())
        return
    saves(what, ed@, arena, join3(head, expected, "\n:::\n", arena))

priv fn too_long(arena: Arena$@) //<
    //< A fill refused midway puts back the cells it copied before the refusal
    //< A long formula on A9 grows by one byte a reference when it is copied onto row 10.
    defer $long: = Str_builder()
    long.s("A9")
    for long.slice().len + 3 <= 4096
        long.s("+A9")
    defer $rows: = Str_builder()
    for r in Range.asc(10)
        rows.s("| \{r\} | ")
        if r == 8
            rows.s("=A9 | =").s(long.slice()).s(" |\n")
        else
            rows.s("| |\n")
    tall: =
        join3("%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" |\n", rows.slice(), ":::\n",
        arena)
    $ed: = opened(tall, arena)
    $refused: = false
    ed.fill_cells(0, 8, 1, 1, 2, 9, 2, false) catch e
        refused = e.message().equals(Refused.table(.too_long).message())
    verdict.check("a fill that would write a formula too long is refused", refused, "")
    saves("and the cell copied before the refusal is put back", ed@, arena, tall)
    verdict.check("nothing is left to undo", !ed.can_undo(), "")

priv fn filled(ed: Editor$@, top: Sz, left: Sz, height: Sz, width: Sz, bottom: Sz, right: Sz)
    ed.fill_cells(0, top, left, height, width, bottom, right, false) catch e
        verdict.check("a fill", false, e.message())

priv fn row3(a: U8[], b: U8[], c: U8[], arena: Arena$@): List<|U8[]|> //< one row of a grid
    $line: = List<|U8[]|>(arena)
    line.push(a)
    line.push(b)
    line.push(c)
    return line

// ---- Helpers ----

priv fn sorted(ed: Editor$@, column: Sz, descending: Bool) //< sorts block 0's table by a column
    ed.sort_table(0, column, descending) catch e
        verdict.check("a sort", false, e.message())

fn opened(bytes: U8[], arena: Arena$@): Editor
    src: = Source("t.ksmd", arena.dup_str(bytes)) catch e
        verdict.check("a test source is valid", false, e.message)
        panic("a test source was refused")
    doc: = reader.read(src@, arena) catch e
        verdict.check("a test document reads", false, e.message)
        panic("a test document was refused")
    return editor.open(doc, "2026-10-23", arena)

priv fn inserted(ed: Editor$@, columns: Sz, rows: Sz)
    ed.insert_table(columns, rows) catch e
        verdict.check("inserting a table", false, e.message())

priv fn set(ed: Editor$@, block: Sz, row: Sz, column: Sz, text: U8[])
    ed.set_cell(block, row, column, text) catch e
        verdict.check(text, false, e.message())

priv fn changed(ed: Editor$@, block: Sz, what: Table_edit, at: Sz)
    ed.edit_table(block, what, at) catch e
        verdict.check("a row or column edit", false, e.message())

priv fn shown(ed: Editor@, row: Sz, column: Sz, want: U8[], what: U8[], arena: Arena$@) //<
    //< What a cell of table 0 shows to edit, which sets the same value again
    got: = ed.cell_text(0, row, column, arena)
    verdict.check(what, got.equals(want), got)

priv fn value(ed: Editor@, u: Sz, row: Sz, column: Sz, arena: Arena$@): F64 //< a number, or -1
    r: = calc.calculate(ed.doc@, ed.today, arena)
    v: = r.at(u, row, column)
    return v.number if v.kind == .number else -1.0

priv fn is_error(ed: Editor@, u: Sz, row: Sz, column: Sz, arena: Arena$@): Bool
    r: = calc.calculate(ed.doc@, ed.today, arena)
    return r.at(u, row, column).kind == .error

priv fn source_of(ed: Editor@, arena: Arena$@): U8[]
    defer $out: = Str_builder()
    writer.write(ed.doc@, out@)
    return arena.dup_str(out.slice())

priv fn join3(a: U8[], b: U8[], c: U8[], arena: Arena$@): U8[]
    return arena.text().s(a).s(b).s(c).take()

fn saves(what: U8[], ed: Editor@, arena: Arena$@, expected: U8[]) //<
    //< The document saves as `expected`, and that source reads and saves again unchanged
    got: = source_of(ed, arena)
    verdict.check(what, got.equals(expected), got)
    src: = Source("again.ksmd", got) catch e
        verdict.check(what, false, e.message)
        return
    again: = reader.read(src@, arena) catch e
        verdict.check(what, false, e.message)
        return
    defer $second: = Str_builder()
    writer.write(again@, second@)
    verdict.check(what, second.slice().equals(got), "a second save changed")

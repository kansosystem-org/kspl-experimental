//< Number formats: what each format shows, how `formats` reads and saves, and the editor's actions
//< Each shown text is worked out by hand from the number's decimal digits.
import "ksmd/editor" { Editor }
import "ksmd/editor_tables" { Table_edit }
import "ksmd/format" { Number_format, currency_of, format_of, round_places, show }
import "ksmd/reader"
import "ksmd/source" { Source }
import "ksmd/tests/tables" { opened, saves }
import "std/chars"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/verdict"

priv const OPEN: U8[] = "%ksmd 1\n\n:::table name=\"t\""
priv const BODY: U8[] = "\n| \"a\" | \"b\" |\n| 1234.5 | =A1*2 |\n:::\n"

fn run()
    kinds()
    rounding()
    shared()
    edges()
    reading()
    refusals()
    editing()

priv fn kinds()
    shows("a number keeps its places and has no separators", 1234.5, "number:2", "1234.50")
    shows("grouped puts a comma between each three digits", 1234567.891, "grouped:2",
        "1,234,567.89")
    shows("percent shows the number times 100", 0.125, "percent:1", "12.5%")
    shows("percent moves the point, so 0.07 is exactly 7%", 0.07, "percent:0", "7%")
    shows("a dollar comes before the number", 1234.5, "currency:USD:2", "$1,234.50")
    shows("a minus comes before the symbol", -1234.5, "currency:USD:2", "-$1,234.50")
    shows("a yen has no decimal places here", 1234.5, "currency:JPY:0", "¥1,235")
    shows("a symbol two currencies share is told apart", 5.0, "currency:CAD:2", "CA$5.00")
    shows("a code without a symbol is written, then a no-break space", 1234.5, "currency:CHF:2",
        "CHF 1,234.50")
    shows("a negative number keeps its minus", -1234.5, "grouped:1", "-1,234.5")
    verdict.check("JPY is counted in whole yen, USD in cents",
        currency_of("JPY").unwrap_or(fmt("number:5")).places == 0 &&
        currency_of("USD").unwrap_or(fmt("number:5")).places == 2, "")
    verdict.check("a currency is three capital letters",
        currency_of("usd").is_none() && currency_of("US").is_none(), "")

priv fn rounding()
    shows("a half rounds away from zero", 2.5, "number:0", "3")
    shows("below zero too", -2.5, "number:0", "-3")
    shows("the digits a person reads are rounded: 2.675 is 2.68", 2.675, "number:2", "2.68")
    shows("and 1.005 is 1.01", 1.005, "number:2", "1.01")
    shows("12.5% with no places is 13%", 0.125, "percent:0", "13%")
    shows("a carry can add a digit", 9.995, "number:2", "10.00")
    shows("and a group", 999999.5, "grouped:0", "1,000,000")
    shows("a half below the first place rounds up", 0.005, "number:2", "0.01")
    shows("anything smaller is zero", 0.0049, "number:2", "0.00")
    shows("a sum's last binary digit does not show", 0.1 + 0.2, "number:2", "0.30")

priv const SHARED: F64[] = F64[]::{ 2.675, -2.675, 1.005, 2.5, -2.5, 0.125, 9.995, 0.005, 0.0049,
    1234.5, 999999.5, 0.30000000000000004, 1.0e-7, 123456789.987654321 } //< the numbers `shared` rounds

priv fn shared() //<
    //< A formula's `round` and a number format round alike: what a format shows of the rounded
    //< number is what it shows of the number itself
    $same: = true
    defer $detail: = Str_builder()
    for n in SHARED
        for places in Range.asc(ENTRIES.len)
            f: = fmt(ENTRIES[places])
            rounded: = round_places(n, places).unwrap_or(-1.0)
            defer $a: = Str_builder()
            defer $b: = Str_builder()
            show(rounded, f, a@)
            show(n, f, b@)
            if !a.slice().equals(b.slice())
                same = false
                detail.s("\{n\} at \{places\}: ").s(a.slice()).c(' ').s(b.slice()).c(' ')
    verdict.check("round to N places, then a format of N places, shows what the format shows", same,
        detail.slice())

priv const ENTRIES: U8[][] = U8[][]::{ "number:0", "number:1", "number:2", "number:3" } //<
    //< `number` with 0 to 3 places, each at its place count

priv fn edges()
    shows("zero", 0.0, "number:2", "0.00")
    shows("zero as a percent", 0.0, "percent:0", "0%")
    shows("a negative zero shows no minus", -0.0, "number:1", "0.0")
    shows("a small negative number that rounds to zero shows no minus", -0.001, "number:2", "0.00")
    shows("a small number keeps its digits", 1.5e-7, "number:9", "0.000000150")
    shows("a large number is written whole", 1.0e21, "grouped:0", "1,000,000,000,000,000,000,000")
    shows("its digits past the seventeenth are zeros", 123456789012345678901.0, "grouped:0",
        "123,456,789,012,345,680,000")
    defer $out: = Str_builder()
    show(1.0e300, fmt("number:0"), out@)
    verdict.check("the largest numbers are written whole too",
        out.slice().len == 301 && out.slice()[0] == '1', out.slice())

priv fn reading()
    saves_as("formats saves as written, one entry per column",
        "%ksmd 1\n\n:::table name=\"t\" formats=\"grouped:2,\"\n| \"a\" | \"b\" |\n:::\n",
        "%ksmd 1\n\n:::table name=\"t\" formats=\"grouped:2,\"\n| \"a\" | \"b\" |\n:::\n")
    saves_as("formats is written after widths",
        "%ksmd 1\n\n:::table formats=\",currency:EUR:2\" widths=\"2,4\" name=\"t\"\n| \"a\" | \"b\" \
            |\n:::\n",
        "%ksmd 1\n\n:::table name=\"t\" widths=\"1,2\" formats=\",currency:EUR:2\"\n| \"a\" | \"b\" \
            |\n:::\n")
    defer arena: = Arena(64 * 1024)
    src: =
        Source("f.ksmd",
        "%ksmd 1\n\n:::table name=\"t\" formats=\"percent:1,\"\n| \"a\" | \"b\" |\n| 0.125 | \"x\" \
            |\n:::\n") catch
        panic("the source is valid")
    doc: = reader.read(src@, arena) catch e
        verdict.check("a table with formats reads", false, e.message)
        return
    t: = doc.tables[0]@
    verdict.check("each column holds its format, and the cell its number",
        t.formats.len == 2 && t.formats[0].kind == .percent && t.formats[0].places == 1 &&
        t.formats[1].kind == .none && t.cells[2].text.equals("0.125"), "")

priv fn refusals()
    refused(":::table name=\"t\" formats=\"money:2,\"",
        "a format is number:N, grouped:N, percent:N or currency:XXX:N, with N from 0 to 9, or \
            nothing", 28)
    refused(":::table name=\"t\" formats=\"number:2,number:10\"",
        "a format is number:N, grouped:N, percent:N or currency:XXX:N, with N from 0 to 9, or \
            nothing", 37)
    refused(":::table name=\"t\" formats=\",currency:usd:2\"",
        "a format is number:N, grouped:N, percent:N or currency:XXX:N, with N from 0 to 9, or \
            nothing", 29)
    refused(":::table name=\"t\" formats=\"number:2\"",
        "formats has one entry per column, empty for none", 19)
    refused(":::table name=\"t\" formats=\",\"", "leave out formats when no column has one", 19)
    refused(":::table name=\"t\" formats=2", "this attribute takes a quoted string", 19)
    refused(":::table name=\"t\" format=\"number:2,\"",
        "':::table' takes only name, widths and formats", 19)

priv fn editing()
    defer arena: = Arena(64 * 1024)
    plain: = table_with("", arena)
    $ed: = opened(plain, arena)
    formatted(ed@, 0, 1, "grouped:2")
    saves("a format set on two columns", ed@, arena,
        table_with(" formats=\"grouped:2,grouped:2\"", arena))
    last: = ed.history.done[ed.history.done.len - 1]@
    verdict.check("the step records the formats alone, and no copy of the table",
        last.columns.len == 1 && last.tables.len == 0 && last.cells.len == 0, "")
    verdict.check("the cell still edits its number",
        ed.cell_text(0, 0, 0, arena).equals("1234.5"), "")
    ed.step_places(0, 1, 1, true) catch e
        verdict.check("one more place", false, e.message())
    saves("one more place in the second column", ed@, arena,
        table_with(" formats=\"grouped:2,grouped:3\"", arena))
    ed.undo()
    ed.undo()
    saves("undo takes each step back", ed@, arena, plain)
    ed.redo()
    changed(ed@, .insert_column, 1)
    saves("a new column has no format", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\" formats=\"grouped:2,,grouped:2\"\n| \"a\" | \"\" | \"b\" \
            |\n| 1234.5 | | =A1*2 |\n:::\n")
    changed(ed@, .remove_column, 0)
    saves("a removed column's format goes with it", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\" formats=\",grouped:2\"\n| \"\" | \"b\" |\n| | =#REF!*2 \
            |\n:::\n")
    formatted(ed@, 1, 1, "")
    saves("clearing the last format leaves formats out", ed@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"\" | \"b\" |\n| | =#REF!*2 |\n:::\n")
    wrong(ed@, "more places on a column with no format", "no number format")
    formatted(ed@, 0, 0, "number:0")
    ed.step_places(0, 0, 0, false) catch e
        verdict.check("fewer than no places is refused",
            e.message().find_str("0 to 9").is_some(), e.message())

priv fn shows(what: U8[], n: F64, format: U8[], expected: U8[]) //< `n` shows as `expected`
    defer $out: = Str_builder()
    show(n, fmt(format), out@)
    verdict.check(what, out.slice().equals(expected), out.slice())

priv fn table_with(attributes: U8[], arena: Arena$@): U8[] //< a table `t` with these attributes
    return arena.text().s(OPEN).s(attributes).s(BODY).take()

priv fn fmt(text: U8[]): Number_format //< the format an entry names; the entry must be valid
    return format_of(text) catch
        panic("a test's format is valid")

priv fn saves_as(what: U8[], bytes: U8[], expected: U8[])
    defer arena: = Arena(64 * 1024)
    ed: = opened(bytes, arena)
    saves(what, ed@, arena, expected)

priv fn refused(line: U8[], message: U8[], column: Sz) //<
    //< The reader refuses a table opened by `line` with this message, on line 3 at `column`
    defer arena: = Arena(64 * 1024)
    defer $text: = Str_builder()
    text.s("%ksmd 1\n\n").s(line).s("\n| \"a\" | \"b\" |\n:::\n")
    src: = Source("bad.ksmd", text.slice()) catch e
        verdict.check(message, false, e.message)
        return
    _doc: = reader.read(src@, arena) catch e
        defer $got: = Str_builder()
        got.s("\{e.message\} at \{e.line\}:\{e.column\}")
        verdict.check(message,
            e.message.equals(message) && e.line == 3 && e.column == column, got.slice())
        return
    verdict.check(message, false, "the source was read")

priv fn formatted(ed: Editor$@, first: Sz, last: Sz, format: U8[]) //< sets columns' format
    ed.set_format(0, first, last, fmt(format)) catch e
        verdict.check("setting a format", false, e.message())

priv fn changed(ed: Editor$@, what: Table_edit, at: Sz)
    ed.edit_table(0, what, at) catch e
        verdict.check("a column edit", false, e.message())

priv fn wrong(ed: Editor$@, what: U8[], says: U8[]) //< more places is refused, with this message
    ed.step_places(0, 0, 1, true) catch e
        verdict.check(what, e.message().find_str(says).is_some(), e.message())
        return
    verdict.check(what, false, "the action was taken")

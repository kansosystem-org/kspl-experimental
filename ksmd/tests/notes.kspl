//< Notes: on a cell or a paragraph, how they read and save, and adding and resolving one
import "ksmd/base/source" { Source }
import "ksmd/edit/editor_tables"
import "ksmd/edit/region" { text_spot }
import "ksmd/syntax/reader"
import "ksmd/tests/support" { opened, saves }
import "ksmd/tests/support"
import "std/chars"
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

priv const TABLE: U8[] = "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" |\n"

fn run()
    reading()
    cells()
    paragraphs()
    links()

priv fn reading()
    defer arena: = Arena(64 * 1024)
    for text in U8[][]::{ "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" |\n| 120 {fill=\"#fff2cc\" \
        note=\"Check with Sam\"} |\n:::\n",
        "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" |\n| {note=\"Say \\\"hi\\\"\\nthen go\"} |\n:::\n",
        "%ksmd 1\n\n{align=\"center\" note=\"Is this the final title?\"}\n# Plan\n\nText.\n",
        "%ksmd 1\n\n{note=\"A remark\"}\nText.\n" }
        ed: = opened(text, arena)
        saves("a note reads and saves unchanged", ed@, arena, text)
    for bad in U8[][]::{ "%ksmd 1\n\n{note=\"\"}\nText.\n", "%ksmd 1\n\n{note=\"a\\tb\"}\nText.\n",
        "%ksmd 1\n\n{note=2}\nText.\n" }
        src: = Source("bad.ksmd", bad) catch
            continue
        $read: = true
        _doc: = reader.read(src@, arena) catch
            read = false
        verdict.check(arena.text().s("a note that cannot be saved is refused: ").s(bad).take(),
            !read, "")

priv fn cells()
    defer arena: = Arena(64 * 1024)
    plain: = arena.text().s(TABLE).s("| 1 |\n:::\n").take()
    $ed: = opened(plain, arena)
    ed.set_cell_note(0, 0, 0, "Why one?") catch e
        verdict.check("a note on a cell", false, e.message())
    noted: = arena.text().s(TABLE).s("| 1 {note=\"Why one?\"} |\n:::\n").take()
    saves("a cell takes a note after its value", ed@, arena, noted)
    ed.set_cell(0, 0, 0, "2") catch e
        verdict.check("a new value", false, e.message())
    saves("a new value keeps the cell's note", ed@, arena,
        arena.text().s(TABLE).s("| 2 {note=\"Why one?\"} |\n:::\n").take())
    ed.set_cell_note(0, 0, 0, "") catch e
        verdict.check("resolving a note", false, e.message())
    saves("resolving takes the note away", ed@, arena,
        arena.text().s(TABLE).s("| 2 |\n:::\n").take())
    ed.undo()
    ed.undo()
    saves("undo brings it back", ed@, arena, noted)
    $named: =
        opened("%ksmd 1\n\n:::table name=\"t\"\n| \"a\" {fill=\"#fff2cc\" note=\"In USD\"} |\n| 1 \
            |\n:::\n", arena)
    named.set_cell(0, -1, 0, "Cost") catch e
        verdict.check("a new name", false, e.message())
    saves("a new name keeps the name's look and note", named@, arena,
        "%ksmd 1\n\n:::table name=\"t\"\n| \"Cost\" {fill=\"#fff2cc\" note=\"In USD\"} |\n| 1 \
            |\n:::\n")

priv fn paragraphs()
    defer arena: = Arena(64 * 1024)
    plain: = "%ksmd 1\n\nOne two.\n"
    $ed: = opened(plain, arena)
    ed.set_block_note(0, "Too short?") catch e
        verdict.check("a note on a paragraph", false, e.message())
    noted: = "%ksmd 1\n\n{note=\"Too short?\"}\nOne two.\n"
    saves("a paragraph takes a note on a line of braces before it", ed@, arena, noted)
    p: = text_spot(0, 0, 3)
    ed.select(p, p)
    ed.enter(false) catch e
        verdict.check("a split", false, e.message())
    saves("a paragraph split in two keeps its note on the first part", ed@, arena,
        "%ksmd 1\n\n{note=\"Too short?\"}\nOne\n\ntwo.\n")
    ed.undo()
    ed.set_block_note(0, "") catch e
        verdict.check("resolving a paragraph's note", false, e.message())
    saves("resolving takes it away", ed@, arena, plain)
    $refused: = false
    $table: = opened(arena.text().s(TABLE).s("| 1 |\n:::\n").take(), arena)
    table.set_block_note(0, "x") catch
        refused = true
    verdict.check("a table takes no block note; its cells take notes", refused, "")

// A text cell's link: read and saved after its note, refused on any other cell, and set, kept and
// dropped by the editor.
priv fn links()
    defer arena: = Arena(64 * 1024)
    for text in U8[][]::{ arena.text().s(TABLE)
        .s("| \"Results\" {link=\"https://example.com/r\"} |\n:::\n").take(),
        arena.text().s(TABLE).s("| \"Mail\" {fill=\"#fff2cc\" link=\"mailto:a@b.c\"} |\n:::\n")
        .take() }
        ed: = opened(text, arena)
        saves("a cell's link reads and saves unchanged", ed@, arena, text)
    for cell in U8[][]::{ "12 {link=\"https://example.com\"}", "{link=\"https://example.com\"}",
        "\"x\" {link=\"ftp://example.com\"}", "\"x\" {link=\"https://a b\"}", "\"x\" {link=1}",
        "\"x\" {link=\"\"}" }
        support.refused(arena.text().s(TABLE).s("| ").s(cell).s(" |\n:::\n").take(), cell)
    $ed: =
        opened(arena.text().s(TABLE).s("| \"Results\" |\n:::\n").take(), arena)
    ed.set_cell_link(0, 0, 0, "https://example.com/r") catch e
        verdict.check("setting a cell's link", false, e.message())
    with_link: = arena.text().s(TABLE).s("| \"Results\" {link=\"https://example.com/r\"} |\n:::\n")
        .take()
    saves("a link set on a text cell is saved", ed@, arena, with_link)
    ed.undo()
    saves("undo takes the link away", ed@, arena,
        arena.text().s(TABLE).s("| \"Results\" |\n:::\n").take())
    ed.redo()
    saves("redo sets it again", ed@, arena, with_link)
    ed.set_cell(0, 0, 0, "Report") catch e
        verdict.check("new text", false, e.message())
    saves("new text keeps the link", ed@, arena,
        arena.text().s(TABLE).s("| \"Report\" {link=\"https://example.com/r\"} |\n:::\n").take())
    ed.set_cell(0, 0, 0, "12") catch e
        verdict.check("a number", false, e.message())
    saves("a number takes the link away", ed@, arena,
        arena.text().s(TABLE).s("| 12 |\n:::\n").take())
    ed.set_cell_link(0, 0, 0, "https://example.com/r") catch e
        verdict.check("a number takes no link",
            e.message().find_str("Only a cell that holds text").is_some(), e.message())

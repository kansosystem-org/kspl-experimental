//< Reads one outside document through ksmd's reader, and **uses what it read**
//< `make test-fuzz` runs its mutated documents through this program.
//< Caution: **Do not stop at reading.** A fault shows where the model is used: the tables
//< calculated, each error's reason written, and the document written back.
//< **The exit code is the only answer**: 0 "read and used", 1 "refused". **A round trip that
//< breaks stops with `assert`**, counted as an announced stop. What the writer wrote must read
//< back, and be written again the same.
//< Usage: `read_prog ksmd <file>` (the one kind `tests/fuzz_main.kspl` names).
import "ksmd/base/source" { Diagnostic, Source }
import "ksmd/calc/calc"
import "ksmd/calc/reason" { write_reason }
import "ksmd/calc/value" { Value }
import "ksmd/model/model" { Document }
import "ksmd/syntax/reader"
import "ksmd/syntax/writer"
import "std/ds"
import "std/io"
import "std/mem" { Arena, dealloc }
import "std/str" { Str }
import "std/strfmt" as _strfmt
import "std/sys"

priv const TODAY: U8[] = "2026-11-16" //< the date the tables are calculated on
    //< Fixed, so one input always gives the same values.

// The value that what was read is mixed into.
// Caution: **Do not just count the bytes**, or a mix-up in the characters does not show.
priv $used: U64 = 0

priv const MIX: U64 = 0x100000001B3U64 //< the multiplier
    //< **It can wrap on overflow**; it is used only for mixing.

priv fn use_bytes(bytes: U8[])
    for b in bytes
        used = (used ^ U64::b) * MIX

priv fn use_len(len: Sz)
    used = (used ^ U64::len) * MIX

priv fn refused(src: Source@, why: Diagnostic): I32 //<
    //< Uses a refusal's place and words, and checks that the place stands in the source
    use_bytes(why.message)
    use_len(why.offset)
    assert(why.offset <= src.bytes.len && why.line >= 1 && why.column >= 1,
        "ksmd: a refusal names a place outside the source")
    return 1

priv fn read_ksmd(bytes: U8[], arena: Arena$@): I32 //<
    //< Reads the document, calculates it, and checks that what the writer writes reads back the same
    src: = Source("fuzz.ksmd", bytes) catch e
        use_bytes(e.message)
        return 1
    doc: = reader.read(src@, arena) catch e
        return refused(src@, e)
    use_results(doc@, arena)
    defer $once: = Str()
    writer.write(doc@, once@)
    use_bytes(once.slice())
    assert(writer.size(doc@) == once.len, "ksmd: the writer's size is not what it writes")
    again_src: = Source("again.ksmd", once.slice()) catch
        panic("ksmd: what the writer wrote is not a valid source")
    again: = reader.read(again_src@, arena) catch
        panic("ksmd: what the writer wrote is refused by the reader")
    defer $twice: = Str()
    writer.write(again@, twice@)
    assert(twice.slice().equals(once.slice()), "ksmd: what the writer wrote is written otherwise")
    return 0

priv fn use_results(doc: Document@, arena: Arena$@) //<
    //< Calculates every table, then uses each value, and each error's reason as the page shows it
    results: = calc.calculate(doc, TODAY, arena)
    use_len(results.reads)
    defer $reason: = Str()
    for table in Range.asc(doc.tables.len)
        from: = results.starts[table]
        cells: = doc.tables[table].rows.len * doc.tables[table].columns.len
        for i in Range.asc(cells)
            v: Value = results.values[from + i]
            // The number as text: a cast of a huge or not-a-number F64 to an integer is undefined.
            reason.clear()
            reason.s("\{v.number\}").s(v.text)
            if v.kind == .error
                write_reason(v, table, doc, results@, reason@)
            use_bytes(reason.slice())

fn main(): I32
    args: = sys.args()
    if args.len < 3 || !args[1].equals("ksmd")
        io.err().s("usage: read_prog ksmd <file>\n")
        return 2
    src: = io.read_file(args[2], null) catch
        io.err().s("cannot read: \{args[2]\}\n")
        return 2
    // The address sanitizer's leak check counts a buffer still held at the exit as a finding.
    defer dealloc(Void$@::src.ptr)
    defer arena: = Arena(64 * 1024 * 1024)
    code: = read_ksmd(src, arena)
    // Caution: **Print the mixed value**, or the reading above could be optimized away entirely.
    io.out().s("used=\{used\}\n")
    return code

//< Calculating tables: each result is checked against a value worked out by hand
//< Values are compared exactly; every expected number is one an F64 holds without rounding.
import "ksmd/calc" { Calc_error, Results, Value_kind }
import "ksmd/calc"
import "ksmd/edit"
import "ksmd/keyed" { Keyed }
import "ksmd/model" { Document }
import "ksmd/reader"
import "ksmd/source" { Source }
import "ksmd/writer"
import "std/chars"
import "std/ds" { List }
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/str"
import "std/strnum"
import "std/verdict"

priv const HEAD: U8[] = "%ksmd 1\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n"
priv const TODAY: U8[] = "2026-10-23" //< the date the test documents count as opened on

fn run()
    arithmetic()
    references()
    functions()
    errors()
    propagation()
    limits()
    budget()
    chains()
    many_names()
    comparisons()
    logic()
    text_in_formulas()
    choices()
    lazy_choices()
    rounding()
    today()
    conditional_totals()
    condition_shapes()
    conditional_cycles()

priv fn arithmetic()
    defer arena: = Arena(64 * 1024)
    r: =
        results("| =1+2*3 | =(1+2)*3 |\n| =10-4-3 | =24/4/2 |\n| =-2*3 | =2*-3 |\n| =--2 | =-(1+2) \
            |\n| =1.5e2/3 | =10 - 2 * 3 + 1 |\n| =0.5+0.25 | = 7 |\n:::\n", arena)
    number("multiplication binds before addition", r@, 0, 0, 0, 7.0)
    number("brackets group first", r@, 0, 0, 1, 9.0)
    number("subtraction groups from the left", r@, 0, 1, 0, 3.0)
    number("division groups from the left", r@, 0, 1, 1, 3.0)
    number("unary minus before a product", r@, 0, 2, 0, -6.0)
    number("unary minus after an operator", r@, 0, 2, 1, -6.0)
    number("two unary minuses", r@, 0, 3, 0, 2.0)
    number("unary minus before brackets", r@, 0, 3, 1, -3.0)
    number("an exponent", r@, 0, 4, 0, 50.0)
    number("spaces between tokens", r@, 0, 4, 1, 5.0)
    number("fractions", r@, 0, 5, 0, 0.75)
    number("a number alone", r@, 0, 5, 1, 7.0)

priv fn references()
    defer arena: = Arena(64 * 1024)
    r: =
        results("| | =A1+1 |\n| \"x\" | =A2+1 |\n| \"2026-01-02\" | =A3+1 |\n| 4 | =A5*2 |\n| =A4+5 \
            | =u.A1*t.A4 |\n:::\n\n:::table name=\"u\"\n| \"x\" |\n| 3 |\n:::\n", arena)
    number("an empty cell is 0 in arithmetic", r@, 0, 0, 1, 1.0)
    failure("text in arithmetic is a type error", r@, 0, 1, 1, .wrong_kind)
    failure("a date stays text", r@, 0, 2, 1, .wrong_kind)
    number("a formula can name a later row", r@, 0, 3, 1, 18.0)
    number("the later row's formula", r@, 0, 4, 0, 9.0)
    number("a reference into another table, and into its own by name", r@, 0, 4, 1, 12.0)
    two: =
        results("| =u.A1 | |\n:::\n\n:::table name=\"u\"\n| \"x\" |\n| =t.A1 |\n:::\n", arena)
    failure("a cycle through two tables", two@, 0, 0, 0, .cycle)
    failure("the same cycle, seen from the other table", two@, 1, 0, 0, .cycle)
    kind("an empty cell's value is empty", r@, 0, 0, 0, .empty)
    kind("a text cell's value is text", r@, 0, 1, 0, .text)

priv fn functions()
    defer arena: = Arena(64 * 1024)
    r: =
        results("| 1 | =sum(A1:A4) |\n| | =count(A1:A4) |\n| \"x\" | =min(A1:A4) |\n| 4 | \
            =max(A1:A4) |\n| =average(A1:A4) | =sum(A1:A2, 10, A4) |\n| =max(0, A1-5) | =sum(A4:A1) \
            |\n| =sum(A1:B2) | =sum(A3) |\n| =count(5, A3, A2) | =average(A1, A4, 1) |\n:::\n",
        arena)
    number("sum leaves out empty cells and text", r@, 0, 0, 1, 5.0)
    number("count counts numbers", r@, 0, 1, 1, 2.0)
    number("min", r@, 0, 2, 1, 1.0)
    number("max", r@, 0, 3, 1, 4.0)
    number("average divides by the count of numbers", r@, 0, 4, 0, 2.5)
    number("several arguments: ranges, cells and numbers", r@, 0, 4, 1, 15.0)
    number("an argument that is arithmetic", r@, 0, 5, 0, 0.0)
    number("a range's corners in either order", r@, 0, 5, 1, 5.0)
    number("a range over two columns", r@, 0, 6, 0, 8.0)
    number("one cell of text as an argument is left out", r@, 0, 6, 1, 0.0)
    number("count of a number and of cells", r@, 0, 7, 0, 1.0)
    number("average of cells and a number", r@, 0, 7, 1, 2.0)
    e: =
        results("| \"x\" | =sum(A1:A2) |\n| | =count(A1:A2) |\n| =min(A1:A2) | =max(A1:A2) |\n| \
            =average(A1:A2) | |\n:::\n", arena)
    number("the sum of no numbers is 0", e@, 0, 0, 1, 0.0)
    number("the count of no numbers is 0", e@, 0, 1, 1, 0.0)
    failure("min of no numbers is an error", e@, 0, 2, 0, .no_numbers)
    failure("max of no numbers is an error", e@, 0, 2, 1, .no_numbers)
    failure("average of no numbers is an error", e@, 0, 3, 0, .no_numbers)

priv fn errors()
    defer arena: = Arena(64 * 1024)
    r: =
        results("| =1/0 | =0/0 |\n| =1e308*10 | =1e999 |\n| =Z99 | =#REF! |\n| =nope.A1 | =B4 |\n| \
            =B5 | =A5 |\n| =sum(A6:A6) | =1+ |\n| =foo(1) | =A1:A2 |\n| =sum() | =1 2 |\n| =(1 | \
            =A01 |\n:::\n", arena)
    failure("division by zero", r@, 0, 0, 0, .division)
    failure("zero divided by zero", r@, 0, 0, 1, .division)
    failure("a result too large", r@, 0, 1, 0, .not_finite)
    failure("a number too large", r@, 0, 1, 1, .not_finite)
    failure("a reference outside the table", r@, 0, 2, 0, .reference)
    failure("#REF! in a formula", r@, 0, 2, 1, .reference)
    failure("a table that does not exist", r@, 0, 3, 0, .reference)
    failure("a cell that names itself", r@, 0, 3, 1, .cycle)
    failure("two cells that name each other", r@, 0, 4, 0, .cycle)
    failure("the other of the two", r@, 0, 4, 1, .cycle)
    failure("a range that holds its own cell", r@, 0, 5, 0, .cycle)
    failure("an operator without its operand", r@, 0, 5, 1, .syntax)
    failure("an unknown function", r@, 0, 6, 0, .syntax)
    failure("a range outside a function", r@, 0, 6, 1, .syntax)
    failure("a function without an argument", r@, 0, 7, 0, .syntax)
    failure("two numbers without an operator", r@, 0, 7, 1, .syntax)
    failure("an open bracket", r@, 0, 8, 0, .syntax)
    failure("a row number with a leading 0", r@, 0, 8, 1, .syntax)
    marks: =
        Calc_error.wrong_kind.mark().equals("#VALUE!") &&
        Calc_error.division.mark().equals("#DIV/0!") &&
        Calc_error.not_finite.mark().equals("#NUM!") &&
        Calc_error.reference.mark().equals("#REF!") &&
        Calc_error.cycle.mark().equals("#CYCLE!") &&
        Calc_error.no_numbers.mark().equals("#EMPTY!") &&
        Calc_error.syntax.mark().equals("#SYNTAX!")
    verdict.check("each error shows its own mark", marks, "")

priv fn propagation()
    defer arena: = Arena(64 * 1024)
    r: =
        results("| =1/0 | =A1+1 |\n| =sum(A1:B1) | =count(A1) |\n| =A1+Z99 | =Z99+A1 |\n| =-A1 | \
            =max(Z99, A1) |\n:::\n", arena)
    failure("an error in a referenced cell carries into arithmetic", r@, 0, 0, 1, .division)
    failure("an error in a range carries into a sum", r@, 0, 1, 0, .division)
    failure("an error carries into a count too", r@, 0, 1, 1, .division)
    failure("the left error comes first", r@, 0, 2, 0, .division)
    failure("the left error comes first, the other way", r@, 0, 2, 1, .reference)
    failure("an error carries through unary minus", r@, 0, 3, 0, .division)
    failure("the first error among the arguments comes first", r@, 0, 3, 1, .reference)

priv fn limits()
    defer arena: = Arena(64 * 1024)
    defer $deep: = Str_builder()
    deep.s(HEAD).s("| =")
    for _ in Range.asc(63)
        deep.c('(')
    deep.c('1')
    for _ in Range.asc(63)
        deep.c(')')
    deep.s(" | =")
    for _ in Range.asc(64)
        deep.c('(')
    deep.c('1')
    for _ in Range.asc(64)
        deep.c(')')
    deep.s(" |\n| =")
    for _ in Range.asc(63)
        deep.c('-')
    deep.s("1 | =sum(sum(1)) |\n:::\n")
    doc: = read(deep.slice(), arena)
    r: = calc.calculate(doc@, TODAY, arena)
    number("a formula nests 64 levels", r@, 0, 0, 0, 1.0)
    failure("a formula nested 65 levels does not read", r@, 0, 0, 1, .syntax)
    number("each unary minus is a level", r@, 0, 1, 0, -1.0)
    number("a function inside a function", r@, 0, 1, 1, 1.0)
    defer $long: = Str_builder()
    long.s(HEAD).s("| 1 | =A1")
    for _ in Range.asc(2047)
        long.s("+1")
    long.s(" |\n:::\n")
    full: = read(long.slice(), arena)
    f: = calc.calculate(full@, TODAY, arena)
    number("a formula of 4,096 bytes calculates", f@, 0, 0, 1, 2048.0)

priv fn budget()
    defer arena: = Arena(64 * 1024)
    bytes: = io.read_file("examples/overview.ksmd", arena) catch
        verdict.check("the overview example reads", false, "")
        return
    $doc: = read(bytes, arena)
    r: = calc.calculate(doc@, TODAY, arena)
    number("budget D1 is 30", r@, 0, 0, 3, 30.0)
    number("budget D2 is 10", r@, 0, 1, 3, 10.0)
    number("budget D3 is 40", r@, 0, 2, 3, 40.0)
    edit.set_cell(doc@, 0, 0, 1, .number, "24", arena) catch
        panic("setting a quantity")
    changed: = calc.calculate(doc@, TODAY, arena)
    number("a changed quantity changes its total", changed@, 0, 0, 3, 60.0)
    number("and the sum that depends on it", changed@, 0, 2, 3, 70.0)
    edit.insert_row(doc@, 0, 1, arena) catch
        panic("inserting a row")
    edit.set_cell(doc@, 0, 1, 0, .text, "Ink", arena) catch
        panic("naming the new row")
    edit.set_cell(doc@, 0, 1, 1, .number, "1", arena) catch
        panic("setting its quantity")
    edit.set_cell(doc@, 0, 1, 2, .number, "8", arena) catch
        panic("setting its price")
    edit.copy_cell(doc@, 0, 0, 3, 0, 1, 3, arena) catch
        panic("copying the total's formula")
    edit.remove_row(doc@, 0, 2) catch
        panic("removing the paper row")
    saved: = written(doc@, arena)
    expected: =
        ":::table name=\"budget\"\n| \"Item\" | \"Quantity\" | \"Price\" | \"Total\" |\n| \"Pens\" \
            | 24 | 2.5 | =B1*C1 |\n| \"Ink\" | 1 | 8 | =B2*C2 |\n| \"Total\" | | | =sum(D1:D2) \
            |\n:::\n"
    found: = saved.find_str(expected)
    verdict.check("the edited budget saves its formulas, not their results", found.is_some(), saved)
    again: = read(saved, arena)
    a: = calc.calculate(again@, TODAY, arena)
    number("read again, the new row's total is 8", a@, 0, 1, 3, 8.0)
    number("read again, the sum takes the new row", a@, 0, 2, 3, 68.0)
    verdict.check("the edited budget saves a second time unchanged",
        written(again@, arena).equals(saved), "")

priv fn chains()
    defer arena: = Arena(1024 * 1024)
    defer $long: = Str_builder()
    long.s("%ksmd 1\n\n:::table name=\"t\"\n| \"a\" |\n| 1 |\n")
    for row in Range(2, 10001, 1)
        long.s("| =A").s("\{row - 1\}").s("+1 |\n")
    long.s(":::\n")
    doc: = read(long.slice(), arena)
    r: = calc.calculate(doc@, TODAY, arena)
    number("a running total down 10,000 rows", r@, 0, 9999, 0, 10000.0)
    defer $ring: = Str_builder()
    ring.s("%ksmd 1\n\n:::table name=\"t\"\n| \"a\" |\n| =A1000 |\n")
    for row in Range(2, 1001, 1)
        ring.s("| =A").s("\{row - 1\}").s(" |\n")
    ring.s(":::\n")
    cycle: = read(ring.slice(), arena)
    c: = calc.calculate(cycle@, TODAY, arena)
    failure("a cycle through 1,000 cells", c@, 0, 999, 0, .cycle)
    failure("every cell of it", c@, 0, 0, 0, .cycle)

priv const NAMES: Sz = 2000 //< the tables named in `many_names`
priv const SHARED_BITS: U32 = 12 //< the lowest bits of their hash (`hash` in `std/str`), all zero

priv fn many_names() //<
    //< 2,000 table names that all start at one slot of a `Map` read, calculate and are looked up
    //< **The work is counted, not timed**: a clock flakes on a loaded machine. A lookup compares
    //< at most `depth` names, which an AVL tree holds under 1.45 log2(n + 2).
    defer arena: = Arena(4 * 1024 * 1024)
    names: = colliding_names(arena)
    defer $text: = Str_builder()
    text.s("%ksmd 1\n\n")
    for i in Range.asc(NAMES) // falling byte order, so each name is the least so far
        text.s(":::table name=\"").s(names[NAMES - 1 - i]).s("\"\n| \"n\" | \"twice\" |\n")
        text.s("| 3 | =A1*2 |\n:::\n\n")
    text.s(":::table name=\"total\"\n| \"first\" | \"last\" |\n| =").s(names[0])
    text.s(".B1 | =").s(names[NAMES - 1]).s(".B1+1 |\n:::\n")
    doc: = read(text.slice(), arena)
    verdict.check("2,000 table names that share a Map's slot read", doc.tables.len == NAMES + 1, "")
    r: = calc.calculate(doc@, TODAY, arena)
    number("a formula finds the first of those tables by name", r@, NAMES, 0, 0, 6.0)
    number("and the last", r@, NAMES, 0, 1, 7.0)
    text.s("\n:::table name=\"").s(names[NAMES / 2]).s("\"\n| \"n\" |\n:::\n")
    refusal: = refusal_at(text.slice(), arena)
    want: = arena.text().s("another table in this source has this name \{5 * NAMES + 8\}:10").take()
    verdict.check("one of them repeated is refused, at the repeated name", refusal.equals(want),
        refusal)
    $tree: = Keyed<|Bool|>(arena)
    for i in Range.asc(NAMES)
        tree.set(names[NAMES - 1 - i], true)
    $found: Sz = 0
    for i in Range.asc(NAMES)
        if tree.get(names[i]).is_some()
            found += 1
    $bits: Sz = 0 // the least with 2^bits > NAMES + 2, so above log2(NAMES + 2)
    for (1 << bits) <= NAMES + 2
        bits += 1
    verdict.check("each name is found, and a lookup compares at most 1.45 log2(n + 2) names",
        found == NAMES && tree.get("t").is_none() && tree.depth() * 100 <= bits * 145,
        arena.text().s("\{found\} found, \{tree.depth()\} deep").take())

priv fn colliding_names(arena: Arena$@): List<|U8[]|> //<
    //< `NAMES` names in rising byte order, each one's hash ending in `SHARED_BITS` zeros
    //< A `Map` takes a key's first slot from its hash's lowest bits. A `Map` of 2,000 pairs has
    //< at most 4,096 slots, so all these names start at one slot.
    $out: = List<|U8[]|>(arena)
    mask: U32 = (U32::1 << SHARED_BITS) - 1
    defer $name: = Str_builder()
    $i: Sz = 0
    for out.len < NAMES
        name.clear()
        name.c('t')
        $place: Sz = 10000000 // eight digits, so byte order is number order
        for place > 0
            name.c('0' + U8::((i / place) % 10))
            place /= 10
        if (name.slice().hash() & mask) == 0
            out.push(arena.dup_str(name.slice()))
        i += 1
    return out

priv fn refusal_at(bytes: U8[], arena: Arena$@): U8[] //< the reader's message, line and column
    src: = Source("t.ksmd", arena.dup_str(bytes)) catch e
        return e.message
    _doc: = reader.read(src@, arena) catch e
        return arena.text().s(e.message).s(" \{e.line\}:\{e.column\}").take()
    return "read"

// The cells formulas in `cases` read: A1 is 2, B1 the text Pens, A2 empty and B2 `#DIV/0!`.
priv const INPUTS: U8[] = "| 2 | \"Pens\" |\n| | =1/0 |\n"

priv fn comparisons()
    cases(U8[][]::{ "A1=2 -> true", "A1<>2 -> false", "A1<3 -> true", "A1<=2 -> true",
        "A1>2 -> false", "A1>=2 -> true", "A1 = 2.0 -> true", "-1 < 0 -> true",
        "B1=\"pens\" -> true", "B1<>\"PENS\" -> false", "B1<\"Q\" -> true", "B1>\"pens\" -> false",
        "\"a\"<\"B\" -> true", "\"ab\">\"a\" -> true", "\"\"<\"a\" -> true", "A2=0 -> true",
        "A2=\"\" -> true", "A2=false -> true", "A2<1 -> true", "A2=A2 -> true", "A2>\"\" -> false",
        "A2+1=1 -> true", "A1=\"2\" -> false", "A1<>\"2\" -> true", "A1<\"2\" -> #VALUE!",
        "\"2\">=A1 -> #VALUE!", "true=1 -> false", "true<>1 -> true", "true>0 -> #VALUE!",
        "B1=true -> false", "true>false -> true", "false=false -> true", "false<false -> false",
        "B2=1 -> #DIV/0!", "1=B2 -> #DIV/0!", "Z99=B2 -> #REF!", "B2=Z99 -> #DIV/0!",
        "1+1=2 -> true", "2*3>5 -> true", "-A1<0 -> true", "1<2=true -> #SYNTAX!",
        "(1<2)=true -> true", "1= -> #SYNTAX!", "=1 -> #SYNTAX!", "1<> -> #SYNTAX!", "1=1 -> true",
        "1==1 -> #SYNTAX!", "1=>1 -> #SYNTAX!", "1< =1 -> #SYNTAX!" })

// In `logic`, the right side of `and` and `or` is calculated only when the left side does not
// decide: `B2` is an error.
priv fn logic()
    cases(U8[][]::{ "true -> true", "false -> false", "true and false -> false",
        "true and true -> true", "false or true -> true", "false or false -> false",
        "not true -> false", "not false -> true", "not not true -> true", "not A1=3 -> true",
        "not(A1=2) -> false", "true or false and false -> true",
        "(true or false) and false -> false", "false and true or true -> true",
        "A1>1 and B1=\"Pens\" -> true", "A1>1 and B1<>\"Pens\" -> false", "false and B2=1 -> false",
        "true or B2=1 -> true", "true and B2=1 -> #DIV/0!", "false or B2=1 -> #DIV/0!",
        "B2=1 or true -> #DIV/0!", "B2=1 and false -> #DIV/0!", "1 and true -> #VALUE!",
        "true and 1 -> #VALUE!", "\"x\" or true -> #VALUE!", "not 0 -> #VALUE!",
        "not \"\" -> #VALUE!", "A2 or true -> true", "not A2 -> true", "true and A2 -> false",
        "true + 1 -> #VALUE!", "-true -> #VALUE!", "sum(true) -> #VALUE!", "sum(1, A1=2) -> #VALUE!",
        "and -> #SYNTAX!", "true and -> #SYNTAX!", "not -> #SYNTAX!", "true(1) -> #SYNTAX!",
        "true false -> #SYNTAX!" })

priv fn text_in_formulas()
    cases(U8[][]::{ "\"late\" -> \"late\"", "\"\" -> \"\"", "B1 -> \"Pens\"", "A2 -> 0", "A1 -> 2",
        "\"A1\" -> \"A1\"", "\"a\\\"b\" -> \"a\"b\"", "\"x|y\" -> \"x|y\"", "\"x\" + 1 -> #VALUE!",
        "\"1\" * 2 -> #VALUE!", "-\"1\" -> #VALUE!", "sum(\"1\") -> #VALUE!", "count(B1) -> 0",
        "\"a\" \"b\" -> #SYNTAX!", "\"a\". -> #SYNTAX!" })
    // Quotes before `.` and a cell name a table; anywhere else they hold text.
    defer arena: = Arena(64 * 1024)
    r: =
        results("| =\"Q1 sales\".A1*2 | =\"Q1 sales\" |\n| =\"Q1 sales\".A1=\"Q1 sales\" | =\"Q1 \
            sales\"=\"q1 SALES\" |\n:::\n\n:::table name=\"Q1 sales\"\n| \"n\" |\n| 5 |\n:::\n",
        arena)
    number("a quoted table name before a cell is a reference", r@, 0, 0, 0, 10.0)
    shows("the same quotes alone are text", r@, 0, 1, "\"Q1 sales\"")
    shows("a number and text are unequal", r@, 1, 0, "false")
    shows("text equals text that differs only in case", r@, 1, 1, "true")
    kind("a text cell's value keeps its text", r@, 0, 0, 1, .text)

priv fn choices()
    cases(U8[][]::{ "if(A1=2, 1, 2) -> 1", "if(A1<>2, 1, 2) -> 2",
        "if(A1>1, \"big\", \"small\") -> \"big\"", "if(A2=\"\", \"none\", A2) -> \"none\"",
        "if(A2=0, 0, A1/A2) -> 0", "if(A1=0, 0, 6/A1) -> 3", "if(true, A2, 1) -> 0",
        "if(true, A2, 1)=\"\" -> true", "if(true, B1, 1) -> \"Pens\"", "if(true, true, 1) -> true",
        "if(A1=2, if(B1=\"pens\", 10, 20), 30) -> 10", "if(A1=2, 10, if(true, 20, 30)) -> 10",
        "1 + if(true, 2, 3) * 2 -> 5", "sum(if(true, A1, 0), 1) -> 3",
        "if(true and B1=\"Pens\", 1, 0) -> 1", "if(not true, 1, 0) -> 0", "if(1, 1, 2) -> #VALUE!",
        "if(\"x\", 1, 2) -> #VALUE!", "if(A2, 1, 2) -> 2", "if(B2=1, 1, 2) -> #DIV/0!",
        "if(B2, 1, 2) -> #DIV/0!", "if(true, B2, 1) -> #DIV/0!", "if(true, 1) -> #SYNTAX!",
        "if(true, 1, 2, 3) -> #SYNTAX!", "if() -> #SYNTAX!", "if(true) -> #SYNTAX!",
        "If(true, 1, 2) -> #SYNTAX!", "if true, 1, 2 -> #SYNTAX!" })

// The branch `if` does not take is read, so it must read, but no cell in it is calculated: an
// error there never shows.
priv fn lazy_choices()
    cases(U8[][]::{ "if(true, 1, 1/0) -> 1", "if(false, 1/0, 2) -> 2", "if(false, B2, 2) -> 2",
        "if(true, 1, Z99) -> 1", "if(true, 1, #REF!) -> 1", "if(false, sum(B1:B2), 3) -> 3",
        "if(true, sum(A1:A2), 3) -> 2", "if(true, 1, 2 +) -> #SYNTAX!",
        "if(true, 1, foo(1)) -> #SYNTAX!", "if(true, 1, A1:A2) -> #SYNTAX!",
        "if(false, \"a\" \"b\", 1) -> #SYNTAX!" })
    // A cycle is a cell reached again while it calculates. Only the branch taken is followed, so
    // a cell named in the other branch is never reached: that is no cycle.
    defer arena: = Arena(64 * 1024)
    r: =
        results("| 0 | =if(A1>0, B1, 5) |\n| 1 | =if(A2>0, B2, 5) |\n| =if(true, 1, A3) | |\n| \
            =if(false, B4, 1) | =if(false, A4, 2) |\n| =if(true, B5, 1) | =if(true, A5, 2) |\n:::\n",
        arena)
    number("a cell named in the branch not taken is no cycle", r@, 0, 0, 1, 5.0)
    failure("the same formula taking the branch is a cycle", r@, 0, 1, 1, .cycle)
    number("a cell's own name in the branch not taken", r@, 0, 2, 0, 1.0)
    number("two cells that name each other in branches not taken", r@, 0, 3, 0, 1.0)
    number("and the other of the two", r@, 0, 3, 1, 2.0)
    failure("two cells that name each other in branches taken", r@, 0, 4, 0, .cycle)
    failure("and the other of those two", r@, 0, 4, 1, .cycle)
    defer $long: = Str_builder()
    long.s("%ksmd 1\n\n:::table name=\"t\"\n| \"a\" |\n| 1 |\n")
    for row in Range(2, 10001, 1)
        long.s("| =if(A").s("\{row - 1\}").s(" > 0, A").s("\{row - 1\}").s(" + 1, Z1) |\n")
    long.s(":::\n")
    defer big: = Arena(1024 * 1024)
    doc: = read(long.slice(), big)
    chain: = calc.calculate(doc@, TODAY, big)
    number("a chain of choices down 10,000 rows", chain@, 0, 9999, 0, 10000.0)

// `round` rounds the digits a person reads, half away from zero, as the number formats do.
priv fn rounding()
    cases(U8[][]::{ "round(2.675, 2) -> 2.68", "round(-2.675, 2) -> -2.68",
        "round(1.005, 2) -> 1.01", "round(2.5, 0) -> 3", "round(-2.5, 0) -> -3",
        "round(0.5, 0) -> 1", "round(0.49, 0) -> 0", "round(1.25, 1) -> 1.3",
        "round(0.125, 2) -> 0.13", "round(9.995, 2) -> 10", "round(123.456, 0) -> 123",
        "round(123.456, 1) -> 123.5", "round(0.1 + 0.2, 2) -> 0.3", "round(1.5, 15) -> 1.5",
        "round(1234, -2) -> 1200", "round(1250, -2) -> 1300", "round(-1250, -2) -> -1300",
        "round(49, -2) -> 0", "round(50, -2) -> 100", "round(1, -15) -> 0",
        "round(5e14, -15) -> 1e15", "round(1e300, -15) -> 1e300", "round(0, 2) -> 0",
        "round(-0.001, 2) -> 0", "round(A2, 2) -> 0", "round(A1, 0) -> 2", "round(7, A2) -> 7",
        "round(2.25, 1) * 2 -> 4.6", "round(B1, 2) -> #VALUE!", "round(true, 2) -> #VALUE!",
        "round(1, B1) -> #VALUE!", "round(1, 1.5) -> #NUM!", "round(1, 16) -> #NUM!",
        "round(1, -16) -> #NUM!", "round(B2, 1) -> #DIV/0!", "round(1, B2) -> #DIV/0!",
        "round(B2, B1) -> #DIV/0!", "round(1) -> #SYNTAX!", "round(1, 2, 3) -> #SYNTAX!",
        "round(A1:A2, 1) -> #SYNTAX!" })

// `today()` is the date the document was opened, as text in the form Ctrl+; types.
priv fn today()
    cases(U8[][]::{ "today() -> \"2026-10-23\"", "today() = \"2026-10-23\" -> true",
        "\"2026-10-22\" < today() -> true", "\"2026-10-24\" < today() -> false",
        "if(\"2026-09-30\" < today(), \"late\", \"\") -> \"late\"", "today() + 1 -> #VALUE!",
        "today(1) -> #SYNTAX!", "today -> #SYNTAX!", "today( ) -> \"2026-10-23\"" })
    defer arena: = Arena(64 * 1024)
    doc: = read(join(HEAD, "| =today() | |\n:::\n", arena), arena)
    a: = calc.calculate(doc@, "2026-10-23", arena)
    b: = calc.calculate(doc@, "2027-01-02", arena)
    verdict.check("the same document gives the date it is calculated with, and reads no clock",
        a.at(0, 0, 0).text.equals("2026-10-23") &&
        b.at(0, 0, 0).text.equals("2027-01-02"), "")

// Table `d` for the conditional totals: an item, a count and a price on each row. Row 4's count
// is empty, row 5's is text, and row 6's is `#DIV/0!`.
priv const DATA: U8[] =
    "\n:::table name=\"d\"\n| \"item\" | \"n\" | \"price\" |\n| \"Pens\" | 3 | 2.5 |\n| \"Ink\" | 1 \
        | 8 |\n| \"pens\" | 2 | 2 |\n| \"Paper\" | | 4 |\n| \"Ink\" | \"many\" | 1 |\n| \"Ink\" | \
        =1/0 | 3 |\n:::\n"

priv fn conditional_totals()
    cases_with(U8[][]::{ "sum_if(d.C1:C6, d.A1:A6 = \"Pens\") -> 4.5",
            "count_if(d.B1:B6, d.A1:A6 = \"Pens\") -> 2",
            "average_if(d.C1:C6, d.A1:A6 = \"pens\") -> 2.25",
            "sum_if(d.C1:C6, d.A1:A6 = \"Ink\") -> 12", "count_if(d.C1:C6, d.A1:A6 = \"Ink\") -> 3",
            "sum_if(d.B1:B5, d.A1:A5 = \"Ink\") -> 1", "count_if(d.B1:B5, d.A1:A5 = \"Ink\") -> 1",
            "sum_if(d.C1:C4, d.B1:B4 > 1) -> 4.5", "sum_if(d.C1:C4, d.B1:B4 = \"\") -> 4",
            "sum_if(d.C1:C4, d.B1:B4 >= 1 and d.A1:A4 <> \"Ink\") -> 4.5",
            "sum_if(d.C1:C6, d.A1:A6 = \"Pens\" or d.A1:A6 = \"Paper\") -> 8.5",
            "sum_if(d.C1:C6, not (d.A1:A6 = \"Ink\")) -> 8.5",
            "sum_if(d.B1:C3, d.A1:A3 = \"Pens\") -> 9.5", "sum_if(d.C1, d.A1:A1 = \"Pens\") -> 2.5",
            "sum_if(d.C1:C6, d.A1:A6 = B1) -> 4.5", "sum_if(d.C1:C6, d.A6:A1 = \"Pens\") -> 4.5",
            "sum_if(d.C1:C6, round(d.C1:C6, 0) = 3) -> 5.5",
            "sum_if(d.C1:C6, d.C1:C6 > average(d.C1:C6)) -> 12",
            "sum_if(d.C1:C6, if(d.A1:A6 = \"Ink\", d.C1:C6 > 2, false)) -> 11",
            "sum_if(d.C1:C6, d.A1:A6 = \"Nothing\") -> 0",
            "count_if(d.C1:C6, d.A1:A6 = \"Nothing\") -> 0",
            "average_if(d.C1:C6, d.A1:A6 = \"Nothing\") -> #EMPTY!",
            "sum_if(d.C1:C6, d.A1:A6 = \"Pens\") * 2 -> 9",
        // An error in a value on a row that matches carries out; on a row that does not, it is
        // not read. An error in the condition carries out on the first row that has one.
        "sum_if(d.B1:B6, d.A1:A6 = \"Ink\") -> #DIV/0!",
            "count_if(d.B1:B6, d.A1:A6 = \"Ink\") -> #DIV/0!",
            "sum_if(d.B1:B6, d.A1:A6 = \"Pens\") -> 5", "sum_if(d.C1:C6, d.B1:B6 > 1) -> #VALUE!",
            "sum_if(d.C1:C6, d.B1:B6 = 1) -> #DIV/0!", "sum_if(d.C1:C6, d.A1:A6) -> #VALUE!",
            "sum_if(Z1:Z6, d.A1:A6 = \"x\") -> #REF!", "sum_if(#REF!, d.A1:A6 = \"x\") -> #REF!",
            "sum_if(d.C1:C6, d.Z1:Z6 = 1) -> #REF!",
            "if(false, sum_if(d.C1:C6, d.A1:A6 = 1/0), 1) -> 1",
            "sum_if(5, d.A1:A6 = \"x\") -> #SYNTAX!", "sum_if(d.C1+1, d.A1:A6 = \"x\") -> #SYNTAX!",
            "sum_if(d.C1:C6) -> #SYNTAX!", "sum_if(d.C1:C6, d.A1:A6 = \"x\", 1) -> #SYNTAX!",
            "d.A1:A6 = \"Pens\" -> #SYNTAX!", "if(d.A1:A6 = \"Pens\", 1, 2) -> #SYNTAX!"
    }, DATA)

// Every range in a condition is one column as tall as the values, and a condition holds one.
priv fn condition_shapes()
    cases_with(U8[][]::{ "sum_if(d.C1:C6, d.A1:A5 = \"Pens\") -> #SHAPE!",
        "sum_if(d.C1:C5, d.A1:A6 = \"Pens\") -> #SHAPE!",
        "sum_if(d.C1:C6, d.A1:B6 = \"Pens\") -> #SHAPE!",
        "sum_if(d.C1:C6, d.A1:A6 = \"Pens\" and d.B1:B5 > 1) -> #SHAPE!",
        "count_if(d.C1:C6, A1 = 2) -> #SHAPE!", "sum_if(d.C1:C6, true) -> #SHAPE!",
        "average_if(d.C1, d.A1:A2 = \"Pens\") -> #SHAPE!",
        "sum_if(d.C1:C6, d.B1:B6 = 1 and d.A1:A5 = \"x\") -> #SHAPE!",
        "if(false, sum_if(d.C1:C6, d.A1:A5 = \"x\"), 1) -> 1",
        "if(true, sum_if(d.C1:C6, d.A1:A5 = \"x\"), 1) -> #SHAPE!" }, DATA)
    verdict.check("the mark of a shape error", Calc_error.shape.mark().equals("#SHAPE!"), "")

// The values on a row are read only where the condition holds, so a total row inside its own
// range is no cycle when the condition leaves its row out.
priv fn conditional_cycles()
    defer arena: = Arena(64 * 1024)
    r: =
        results("| \"Pens\" | 2 |\n| \"Ink\" | 3 |\n| \"Total\" | =sum_if(B1:B4, A1:A4 <> \
            \"Total\") |\n| \"Total\" | =sum_if(B1:B4, A1:A4 <> \"Ink\") |\n| =1=1 | =sum(A5, \
            B1:B2) |\n:::\n", arena)
    number("a total in its own range, left out by the condition", r@, 0, 2, 1, 5.0)
    failure("a total in its own range that the condition takes", r@, 0, 3, 1, .cycle)
    number("a set of cells leaves out true and false", r@, 0, 4, 1, 5.0)

priv fn cases(list: U8[][]) //< `cases_with`, with no other table
    cases_with(list, "")

priv fn cases_with(list: U8[][], after: U8[]) //<
    //< Each a formula, without its `=`, then ` -> ` and what it calculates to as `shows` takes it
    //< `after` holds any tables after table `t`.
    defer arena: = Arena(256 * 1024)
    defer $rows: = Str_builder()
    rows.s(INPUTS)
    for c in list
        rows.s("| =").s(c.sub(0, arrow(c))).s(" | |\n")
    rows.s(":::\n").s(after)
    r: = results(arena.dup_str(rows.slice()), arena)
    for i in Range.asc(list.len)
        c: = list[i]
        what: = arena.text().c('=').s(c.sub(0, arrow(c))).s(" is ")
            .s(c.sub_from(arrow(c) + 4)).take()
        shows(what, r@, i + 2, 0, c.sub_from(arrow(c) + 4))

priv fn arrow(c: U8[]): Sz //< where ` -> ` stands in a case
    return c.find_str(" -> ").unwrap_or(c.len)

priv fn shows(what: U8[], r: Results@, row: Sz, column: Sz, want: U8[]) //<
    //< The value of a cell of table `t` is `want`: `true`, `false`, an error's mark, text in
    //< quotes written without escapes, or a number
    v: = r.at(0, row, column)
    defer $got: = Str_builder()
    got.s(v.kind.variant_name()).c(' ').s("\{v.number\} ").s(v.text).c(' ').s(v.error.mark())
    $ok: = false
    if want.equals("true") || want.equals("false")
        ok = v.kind == .boolean && v.boolean == want.equals("true")
    else if want.starts_with("#")
        ok = v.kind == .error && v.error.mark().equals(want)
    else if want.starts_with("\"")
        ok = v.kind == .text && v.text.equals(want.sub(1, want.len - 2))
    else
        n: = want.to_f64() catch
            panic("a test's number does not read")
        ok = v.kind == .number && v.number == n
    verdict.check(what, ok, got.slice())

priv fn number(what: U8[], r: Results@, u: Sz, row: Sz, column: Sz, want: F64) //<
    //< The cell's value is the number `want`
    v: = r.at(u, row, column)
    defer $got: = Str_builder()
    got.s("\{v.number\} ").s(v.kind.variant_name()).c(' ').s(v.error.variant_name())
    verdict.check(what, v.kind == .number && v.number == want, got.slice())

priv fn failure(what: U8[], r: Results@, u: Sz, row: Sz, column: Sz, want: Calc_error) //<
    //< The cell's value is the error `want`
    v: = r.at(u, row, column)
    defer $got: = Str_builder()
    got.s("\{v.number\} ").s(v.kind.variant_name()).c(' ').s(v.error.variant_name())
    verdict.check(what, v.kind == .error && v.error == want, got.slice())

priv fn kind(what: U8[], r: Results@, u: Sz, row: Sz, column: Sz, want: Value_kind) //<
    //< The cell's value is of the kind `want`
    verdict.check(what, r.at(u, row, column).kind == want, "")

priv fn results(rows: U8[], arena: Arena$@): Results //< the values of table `t` with these rows
    doc: = read(join(HEAD, rows, arena), arena)
    return calc.calculate(doc@, TODAY, arena)

priv fn read(bytes: U8[], arena: Arena$@): Document //< the model; a refusal stops the run
    src: = Source("t.ksmd", arena.dup_str(bytes)) catch e
        verdict.check("a test source is valid", false, e.message)
        panic("a test source was refused")
    return reader.read(src@, arena) catch e
        verdict.check("a test document reads", false, e.message)
        panic("a test document was refused")

priv fn written(doc: Document@, arena: Arena$@): U8[] //< the source the writer saves
    defer $out: = Str_builder()
    writer.write(doc, out@)
    return arena.dup_str(out.slice())

priv fn join(a: U8[], b: U8[], arena: Arena$@): U8[]
    return arena.text().s(a).s(b).take()

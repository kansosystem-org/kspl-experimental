//< Measures what a document costs outside the browser: its view, its values, an edit and a save
//< It writes three documents into a folder, with the note they include: a typical one, a medium
//< one with a 10,000-row table, and a large one near the 8 MiB limit with that table. Each step
//< runs five times, and the middle time is printed. `tests/browser/measure.mjs` measures the
//< page's own costs on the same files.
//< Usage: ksplc run tests/measure.kspl <folder> (`make measure` here)
import "ksmd/calc/calc"
import "ksmd/edit/editor" { Editor }
import "ksmd/edit/editor"
import "ksmd/edit/editor_tables"
import "ksmd/edit/region" { text_spot }
import "ksmd/files/assemble" { assemble }
import "ksmd/files/workspace" { Workspace }
import "ksmd/model/model" { Block_kind }
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/sys"

priv const RUNS: Sz = 5 //< how often each step runs; the middle time counts
priv const OPENED: U8[] = "2026-10-23" //< the date the documents count as opened on

fn main(): I32
    args: = sys.args()
    if args.len != 2
        io.err().s("usage: measure <folder>\n")
        return 2
    folder: = args[1]
    fs.mkdir_all(folder) catch
        io.err().s("the folder cannot be made\n")
        return 1
    defer arena: = Arena(64 * 1024)
    defer $notes: = Str_builder()
    notes.s("%ksmd 1\n\n## A note\n\nThis note is included by both documents.\n")
    defer $typical: = Str_builder()
    document(typical@, 40, 4, 49)
    defer $medium: = Str_builder()
    document(medium@, 2000, 1, 9999)
    defer $large: = Str_builder()
    document(large@, 6000, 1, 9999)
    if !write(folder, "notes.ksmd", notes.slice(), arena) ||
        !write(folder, "typical.ksmd", typical.slice(), arena) ||
        !write(folder, "medium.ksmd", medium.slice(), arena) ||
        !write(folder, "large.ksmd", large.slice(), arena)
        io.err().s("a document cannot be written\n")
        return 1
    ws: = Workspace.open(folder).unwrap_or(Workspace::{ .root = folder })
    measure(ws@, "typical.ksmd")
    measure(ws@, "medium.ksmd")
    measure(ws@, "large.ksmd")
    return 0

priv fn write(folder: U8[], name: U8[], bytes: U8[], arena: Arena$@): Bool //<
    //< whether it was written
    fs.replace_file(fs.join(folder, name, arena), bytes, .kept) catch
        return false
    return true

priv fn document(out: Str_builder$@, sections: Sz, tables: Sz, rows: Sz) //<
    //< A heading, four paragraphs and a list of five items per section, then the tables, an include
    //< and a last paragraph. Each table holds `rows` rows of an item, a count, a price, their
    //< product and a running total, then a row of sums.
    out.s("%ksmd 1\n\n# A measured document\n\n")
    for s in Range.asc(sections)
        out.s("## Section \{s + 1\}\n\n")
        for p in Range.asc(4)
            out.s("Paragraph \{p + 1\} of section \{s + 1\} holds **some strong words**, *some ")
            out.s("emphasis*, `a little code` and [a link](https://example.org/\{s\}). It runs ")
            out.s("on for a few more words, so that a line wraps as prose does.\n\n")
        for i in Range.asc(5)
            out.s("- Item \{i + 1\} of a short list\n")
        out.c('\n')
    for t in Range.asc(tables)
        out.s(":::table name=\"table\{t + 1\}\"\n")
        out.s("| \"Item\" | \"Count\" | \"Price\" | \"Total\" | \"Running\" |\n")
        for r in Range(1, rows + 1, 1)
            out.s("| \"Item \{r\}\" | \{r % 17 + 1\} | 2.5 | =B\{r\}*C\{r\} | ")
            if r == 1
                out.s("=D1 |\n")
            else
                out.s("=E\{r - 1\}+D\{r\} |\n")
        out.s("| \"Sum\" | =sum(B1:B\{rows\}) | | =sum(D1:D\{rows\}) | |\n:::\n\n")
    out.s(":::include path=\"notes.ksmd\"\n:::\n\nThe last paragraph.\n")

priv fn measure(ws: Workspace@, name: U8[]) //< prints the middle time of each step on one document
    defer arena: = Arena(64 * 1024)
    $view: = List<|I64|>(arena)
    $values: = List<|I64|>(arena)
    $key: = List<|I64|>(arena)
    $cell: = List<|I64|>(arena)
    $save: = List<|I64|>(arena)
    $blocks: Sz = 0
    $bytes: Sz = 0
    for _ in Range.asc(RUNS)
        defer run: = Arena(1024 * 1024)
        $t: = sys.mono_us()
        a: = assemble(ws, name, run) catch e
            switch e
            case .invalid(at)
                io.err().s(name).s(":\{at.line\}: ").s(at.message).c('\n')
            case .refused(why)
                io.err().s(name).s(": ").s(why.message()).c('\n')
            return
        view.push(sys.mono_us() - t)
        top: = a.sources.get(0)
        blocks = top.doc.blocks.len
        bytes = top.source.bytes.len
        t = sys.mono_us()
        _r: = calc.calculate(top.doc@, OPENED, run)
        values.push(sys.mono_us() - t)
        $ed: = editor.open(top.doc, OPENED, run)
        key.push(keystroke(ed@, run))
        cell.push(cell_edit(ed@, run))
        t = sys.mono_us()
        ws.save(name, ed.doc@, run) catch
            io.err().s("the document cannot be saved\n")
            return
        save.push(sys.mono_us() - t)
    io.out().s(name).s(": \{bytes\} bytes, \{blocks\} blocks\n")
    shown("read the files and build the view", view@)
    shown("calculate every table", values@)
    shown("type one character at the end, as one transaction", key@)
    shown("set one cell, then calculate every table", cell@)
    shown("write the canonical source and replace the file", save@)

priv fn keystroke(ed: Editor$@, run: Arena$@): I64 //< types one character into the last paragraph
    last: = ed.doc.blocks.len - 1
    at: = text_spot(last, 0, ed.text_at(text_spot(last, 0, 0), run).len)
    ed.select(at, at)
    t: = sys.mono_us()
    ed.type_text("x", .typing) catch
        return -1
    return sys.mono_us() - t

priv fn cell_edit(ed: Editor$@, run: Arena$@): I64 //< sets a count in the middle of the first table
    $block: Sz = 0
    for ed.doc.blocks.get(block).kind != Block_kind.table
        block += 1
    rows: = ed.doc.tables[ed.doc.blocks.get(block).first].rows.len
    t: = sys.mono_us()
    ed.set_cell(block, rows / 2, 1, "7") catch
        return -1
    _r: = calc.calculate(ed.doc@, ed.today, run)
    return sys.mono_us() - t

priv fn shown(what: U8[], times: List<|I64|>$@) //< the middle of the times, in milliseconds
    for i in Range.asc(times.len)
        for j in Range(i + 1, times.len, 1)
            if times[j] < times[i]
                earlier: = times[j]
                times[j] = times[i]
                times[i] = earlier
    us: = times[times.len / 2]
    hundredths: = us % 1000 / 10
    io.out().s("  ").s(what).s(": \{us / 1000\}.").s("0" if hundredths < 10 else "")
        .s("\{hundredths\} ms\n")

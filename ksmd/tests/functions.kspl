//< The function table's writer: which signatures a formula can call, and why the others cannot
//< And what a person reads of each function: every one has it, and each example gives what it says.
import "ksmd/base/dates" { write_date }
import "ksmd/calc/args" { Raw_arg, Raw_args }
import "ksmd/calc/calc" + { Own_functions, Results }
import "ksmd/calc/functions_table" as table
import "ksmd/calc/glue"
import "ksmd/calc/help" { FORMS, Help }
import "ksmd/calc/value" { Calc_error, Value, empty, number, text }
import "ksmd/calc/wire" + { Wire_error }
import "ksmd/model/format" { show_plain }
import "ksmd/tests/support" { read }
import "std/chars" // `find_str`
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/str"
import "std/verdict"

fn run()
    taken()
    refused()
    asked()
    held()
    marked()
    wired()
    described()
    documented()
    exampled()

priv fn row(sig: U8[], arena: Arena$@): U8[] //< one line of the record `--emit-surface` writes
    open: = sig.find_char('(').unwrap_or(0)
    return arena.text().s("mine\t").s(sig.sub(7, open - 7)).c('\t').s(sig).s("\tdoes it\n").take()

priv fn taken() //< every parameter and result type, an optional one and the arena
    defer arena: = Arena(64 * 1024)
    t: = arena.text()
    t.s(row("pub fn tax(price: F64, rate: F64?): F64", arena))
    label: = "pub fn label(n: I64, short: Bool, prefix: U8[], arena: Arena$@): U8[]!Calc_error"
    t.s(row(label, arena))
    t.s(row("pub fn spread(first: Value, rest: Value[]): Value", arena))
    t.s("mine\tLIMIT\tpub const LIMIT: F64 = 1.0\tnot a function\n")
    t.s("mine\tBox.size\tpub fn size(r: Self@): F64\ta method\n")
    tsv: = t.take()
    fns: = glue.functions_of(tsv, arena) catch why
        verdict.check("a record of callable signatures reads", false, why)
        return
    verdict.check("each pub fn is a function a formula calls; a constant and a method are not",
        fns.len == 3, "")
    src: = glue.table_source(fns@, "mine", "mine.kspl", arena)
    verdict.check("an optional parameter is read only where another argument follows",
        src.find_str("$p_rate: F64? = .none\n    if a.more()").is_some(), src)
    verdict.check("the arena is handed in, never read from the formula",
        src.find_str("fns.label(p_n, p_short, p_prefix, a.arena())").is_some(), src)
    thrown: = "fns.label(p_n, p_short, p_prefix, a.arena()) catch e\n        return Value.failed(e)"
    verdict.check("an error a function throws is the cell's mark",
        src.find_str(thrown).is_some(), src)
    verdict.check("a function no argument of which can fail keeps no first error",
        src.find_str("call_spread(a: Raw_args$@): Value //< `spread(…)`\n    $first").is_some(),
        src)

priv struct Case //< a signature a formula cannot call, and a piece of the reason given
    sig: U8[]
    says: U8[]

priv const REFUSED: Case[_] = ::{
    Case::{ .sig = "pub fn f(x: I32): F64", .says = "x is I32, which a formula's argument" },
    Case::{ .sig = "pub fn f(x: F64 = 1.0): F64",
        .says = "x has a default; write its type with ?" },
    Case::{ .sig = "pub fn f(xs: Value[], y: F64): F64", .says = "Value[] takes every argument" },
    Case::{ .sig = "pub fn f(x: F64?, y: F64): F64", .says = "y comes after one that can be left" },
    Case::{ .sig = "pub fn f(x: F64): I32", .says = "it returns I32, which no cell holds" },
    Case::{ .sig = "pub fn f(x: F64): F64!Io_error", .says = "throws Calc_error alone" },
    Case::{ .sig = "pub fn f<|T|>(x: T): T", .says = "takes no type parameters" },
    Case::{ .sig = "pub fn f(xs: Value[]?): F64", .says = "xs cannot be left out" },
} //< one of each refusal `functions_of` gives

priv fn refused() //< each signature a formula cannot call, with the reason it gives
    defer arena: = Arena(64 * 1024)
    for c in REFUSED
        what: = arena.text().s("refused, saying why: ").s(c.sig).take()
        _fns: = glue.functions_of(row(c.sig, arena), arena) catch why
            verdict.check(what, why.find_str(c.says).is_some(), why)
            continue
        verdict.check(what, false, "it was taken")

// ==========================================
// A person's own functions, as the page answers them
// ==========================================

priv struct Stand_in //< what the stand-in page counted
    asked: Sz //< how many times a function was asked for

priv fn answer(ctx: Void$@, name: U8[], args: Raw_args$@): Value //<
    //< The stand-in page: `twice(x)` doubles, `later(x)` has no answer yet, and `picky(x)` says
    //< its arguments did not fit
    seen: = Stand_in$@::ctx
    seen.asked += 1
    if name.equals("later")
        return Value.failed(.pending)
    if name.equals("picky")
        args.misread = true
        return number(1.0)
    x: = args.number() catch e
        return Value.failed(e)
    return number(x * 2.0)

priv const OWN_HEAD: U8[] = "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" |\n" //< table `t`

priv fn own_results(rows: U8[], seen: Stand_in$@, arena: Arena$@, unknown: Calc_error): Results //<
    //< The values of table `t` with these rows, the stand-in page answering `twice` and
    //< `later`; a name it lacks gives `unknown`'s value
    doc: =
        read(arena.text().s(OWN_HEAD).s(rows).s(":::\n").take(), arena)
    own: = Own_functions::{ .names = U8[][]::{ "twice", "later", "picky", "sum" }, .ask = answer,
        .ctx = Void$@::seen, .unknown = unknown }
    return calc.calculate(doc@, "2026-10-23", arena, own@)

priv fn held() //< while a file's names are unknown, a name ksmd lacks says why, not `#SYNTAX!`
    defer arena: = Arena(64 * 1024)
    $seen: = Stand_in::{ .asked = 0 }
    rows: = "| 4 | =tax(A1) |\n| 1 | =twice(A1) |\n| 2 | =if(true, 1, tax(A1)) |\n| 3 | =sum( |\n"
    blocked: = own_results(rows, seen@, arena, .blocked)
    verdict.check("before the person allows a file, a call it may give is #BLOCKED!",
        blocked.at(0, 0, 1).error == .blocked &&
        Calc_error.blocked.mark().equals("#BLOCKED!"), blocked.at(0, 0, 1).error.mark())
    verdict.check("a function already known is still asked",
        blocked.at(0, 1, 1).number == 8.0, "")
    verdict.check("a branch not taken does not block", blocked.at(0, 2, 1).number == 1.0, "")
    verdict.check("a formula that does not read is still #SYNTAX!",
        blocked.at(0, 3, 1).error == .syntax, blocked.at(0, 3, 1).error.mark())
    building: = own_results(rows, seen@, arena, .pending)
    verdict.check("while a file builds, a call it may give waits",
        building.at(0, 0, 1).error == .pending, building.at(0, 0, 1).error.mark())

priv fn marked() //< the names of the person's functions a formula calls, as the page marks them
    defer arena: = Arena(64 * 1024)
    doc: =
        read(arena.text().s(OWN_HEAD)
        .s("| 1 | =twice(A1) + twice(A1) * later(2) |\n| 2 | =sum(A1) & \"twice(\" |\n").s(":::\n")
        .take(), arena)
    own: = Own_functions::{ .names = U8[][]::{ "twice", "later" }, .ask = answer, .ctx = null,
        .unknown = .syntax }
    t: = doc.tables[0]@
    first: = own.called(t, t.cells[t.columns.len + 1], arena)
    verdict.check("each name a formula calls is listed once, in its order",
        first.len == 2 && first[0].equals("twice") && first[1].equals("later"), "")
    second: = own.called(t, t.cells[2 * t.columns.len + 1], arena)
    verdict.check("a name inside quoted text is no call", second.len == 0, "")

priv fn asked() //< a formula calls a person's function by its name, and the page answers it
    defer arena: = Arena(64 * 1024)
    $seen: = Stand_in::{ .asked = 0 }
    r: =
        own_results("| 4 | =twice(A1) |\n| \"x\" | =twice(A2) |\n| 1 | =later(A1) + 1 |\n| 2 | \
            =if(false, twice(A1), 7) |\n| 3 | =sum(A1:A4) |\n| 5 | =unknown(1) |\n| 6 | =picky(A1) \
            |\n", seen@, arena, .syntax)
    verdict.check("a person's function gives the cell its answer",
        r.at(0, 0, 1).kind == .number && r.at(0, 0, 1).number == 8.0, "")
    verdict.check("its arguments are converted by the rules every function follows",
        r.at(0, 1, 1).error == .wrong_kind, r.at(0, 1, 1).error.mark())
    verdict.check("an answer not come yet shows as pending, and carries into what uses it",
        r.at(0, 2, 1).kind == .error && r.at(0, 2, 1).error == .pending, "")
    verdict.check("ksmd's own sum comes first: a person's name cannot hide it",
        r.at(0, 4, 1).kind == .number && r.at(0, 4, 1).number == 7.0, "")
    verdict.check("a name nobody defined is a formula that does not read",
        r.at(0, 5, 1).error == .syntax, r.at(0, 5, 1).error.mark())
    verdict.check("an answer whose arguments did not fit is a formula that does not read",
        r.at(0, 6, 1).error == .syntax, r.at(0, 6, 1).error.mark())
    verdict.check("a branch not taken does not ask the page", seen.asked == 4,
        arena.text().s("asked \{seen.asked\} times").take())

priv fn wired() //< a call and an answer come back from their bytes as they were written
    defer arena: = Arena(64 * 1024)
    one: = Raw_arg::{ .value = text("x"), .cells = Value[]::{}, .is_cells = false, .range = false,
        .piece = -1 }
    cells: = Raw_arg::{ .value = empty(),
        .cells = Value[]::{ number(1.5), Value.failed(.division) }, .is_cells = true, .range = true,
        .piece = 0 }
    // `f(A1:A1)` is a range of one cell, and `f(A1)` one cell: only the flag tells them apart.
    small: = Raw_arg::{ .value = empty(), .cells = Value[]::{ number(2.0) }, .is_cells = true,
        .range = true, .piece = 1 }
    lone: = Raw_arg::{ .value = empty(), .cells = Value[]::{ number(3.0) }, .is_cells = true,
        .range = false, .piece = 2 }
    out: = arena.text()
    wire.put_call(out, "twice", Raw_arg[]::{ one, cells, small, lone })
    data: = out.take()
    call: = wire.read_call(data, arena) catch
        verdict.check("a call reads back from its bytes", false, "")
        return
    verdict.check("a call reads back with its name and each argument",
        call.name.equals("twice") && call.args.len == 4 &&
        call.args[0].value.text.equals("x") && call.args[1].is_cells &&
        call.args[1].cells.len == 2 && call.args[1].cells[0].number == 1.5 &&
        call.args[1].cells[1].error == .division && call.args[1].range, "")
    verdict.check("a range of one cell reads back as a range, and one cell as no range",
        call.args[2].range && call.args[2].cells.len == 1 && !call.args[3].range &&
        call.args[3].cells[0].number == 3.0, "")
    $why: = Wire_error.unknown
    $whole: = true
    _cut: = wire.read_call(data.sub(0, data.len - 1), arena) catch e
        why = e
        whole = false
    verdict.check("bytes cut short are no call", !whole && why == .cut, "")
    answer: = arena.text()
    wire.put_answer(answer, number(-2.25), true)
    got: = wire.read_answer(answer.take()) catch
        verdict.check("an answer reads back from its bytes", false, "")
        return
    verdict.check("an answer reads back with its value and whether the arguments fit",
        got.value.number == -2.25 && got.misread, "")

// ==========================================
// What a person reads of each function
// ==========================================

priv fn described() //< a doc comment splits into a summary, the detail and the example
    defer arena: = Arena(64 * 1024)
    t: = arena.text()
    t.s("mine\tf\tpub fn f(x: F64, y: F64?): F64\tdoubles it. For example, `f(2)` is `4`. ")
        .s("Only once.\n")
    t.s("mine\tf~00.x\tx\tthe number\n")
    fns: = glue.functions_of(t.take(), arena) catch why
        verdict.check("a documented function reads", false, why)
        return
    f: = fns.get(0)
    verdict.check("the summary, the detail and the example are read apart",
        f.summary.equals("doubles it") && f.detail.equals("Only once.") &&
        f.example.equals("f(2)") && f.gives.equals("4"), f.detail)
    verdict.check("a parameter's own comment is its meaning",
        f.params.get(0).meaning.equals("the number"), f.params.get(0).meaning)
    why: = glue.undocumented(fns@, arena).unwrap_or("")
    verdict.check("a parameter with no comment of its own is named",
        why.find_str("y has no").is_some(), why)
    bare: = glue.functions_of(row("pub fn g(x: F64): F64", arena), arena) catch
        return
    said: = glue.undocumented(bare@, arena).unwrap_or("")
    verdict.check("a function with no example is named",
        said.find_str("x has no").is_some() || said.find_str("For example").is_some(), said)

priv fn documented() //< every function a formula calls has all a person reads of it
    defer arena: = Arena(64 * 1024)
    verdict.check("the table has an entry for every function it calls, in its order",
        table.HELP.len == table.NAMES.len, "")
    for i in Range.asc(table.NAMES.len)
        verdict.check(arena.text().s("the entry of ").s(table.NAMES[i]).s(" is its own").take(),
            i < table.HELP.len && table.HELP[i].name.equals(table.NAMES[i]), "")
    for list in Help[][]::{ Help[]::FORMS, Help[]::table.HELP }
        for h in list
            $missing: =
                h.group.len == 0 || h.summary.len == 0 ||
                !h.example.starts_with(arena.text().s(h.name).c('(').take())
            for a in h.args
                missing = missing || a.meaning.len == 0
            verdict.check(arena.text().s(h.name).s(" has a group, a summary, an example and a ")
                .s("meaning for each argument").take(), !missing && calc.known(h.name), "")

priv fn exampled() //< each example calculates, and gives what its entry says
    //< The examples stand in column E of one table, so those that name cells read its columns B to
    //< D: "Pens" and "Ink" in turn, and numbers.
    defer arena: = Arena(256 * 1024)
    $all: = List<|Help|>(arena)
    all.push_all(Help[]::FORMS)
    all.push_all(Help[]::table.HELP)
    t: = arena.text()
    t.s("%ksmd 2\n\n:::table name=\"t\"\n| \"a\" | \"b\" | \"c\" | \"d\" | \"e\" |\n")
    for i in Range.asc(all.len)
        t.s("| | \"Pens\" | " if i % 2 == 0 else "| | \"Ink\" | ").s("\{i + 1\} | \{2 * i\} | =")
            .s(all.get(i).example).s(" |\n")
    t.s(":::\n")
    doc: = read(t.take(), arena)
    r: = calc.calculate(doc@, "2026-10-23", arena, null)
    for i in Range.asc(all.len)
        h: = all.get(i)
        v: = r.at(0, i, 4)
        what: = arena.text().s("the example of ").s(h.name).s(" calculates")
        if h.gives.len == 0
            verdict.check(what.take(), v.kind != .error, h.example)
            continue
        defer $b: = Str_builder()
        switch v.kind
        case .number
            show_plain(v.number, b@)
        case .date
            write_date(I64::v.number, b@)
        case .text
            b.s(v.text)
        case .boolean
            b.s("true" if v.boolean else "false")
        default
            b.s(v.error.mark() if v.kind == .error else "")
        verdict.check(what.s(" to ").s(h.gives).take(), b.slice().equals(h.gives), b.slice())

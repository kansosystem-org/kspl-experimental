//< Editor actions on prose: what each saves, and what undo and redo give back
//< Each check opens a source, sets the selection as model spots, runs actions, and compares the
//< canonical source with the expected one. That source must read and save again unchanged.
import "ksmd/edit/editor" { Editor, Refused }
import "ksmd/edit/editor_looks"
import "ksmd/edit/region" { Style, gap_spot, paragraph_style, text_spot }
import "ksmd/edit/styled" { Mark }
import "ksmd/tests/support" { opened, saves }
import "std/ds"
import "std/mem" { Arena }
import "std/verdict"

fn run()
    typing()
    composing_and_pasting()
    deleting()
    entering()
    blank_lines()
    kinds()
    marks()
    looks()
    removing_blocks()
    undoing()
    refusals()

priv fn typing()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\nOne two.\n", arena)
    at(ed@, 0, 0, 3)
    typed(ed@, " and a half")
    saves("typing inserts at the caret", ed@, arena, "%ksmd 2\n\nOne and a half two.\n")
    at(ed@, 0, 0, 0)
    typed(ed@, "*#")
    saves("typed '*' and '#' stay text", ed@, arena, "%ksmd 2\n\n\\*#One and a half two.\n")
    $tail: = opened("%ksmd 2\n\nEnd\n", arena)
    at(tail@, 0, 0, 3)
    typed(tail@, " ")
    saves("a space at a line's end is kept out of the source", tail@, arena, "%ksmd 2\n\nEnd\n")
    typed(tail@, "s")
    saves("and the next word follows it", tail@, arena, "%ksmd 2\n\nEnd s\n")
    $after: = opened("%ksmd 2\n\n:::table name=\"t\"\n| \"a\" |\n:::\n", arena)
    gap(after@, 1)
    typed(after@, "After")
    saves("typing in the gap after a table at the end adds a paragraph", after@, arena,
        "%ksmd 2\n\n:::table name=\"t\"\n| \"a\" |\n:::\n\nAfter\n")
    gap(after@, 0)
    typed(after@, "Before")
    saves("and in the gap before it at the start", after@, arena,
        "%ksmd 2\n\nBefore\n\n:::table name=\"t\"\n| \"a\" |\n:::\n\nAfter\n")
    $small: = opened("%ksmd 2\n\nFirst.\n\nSecond.\n\nThird.\n", arena)
    at(small@, 1, 0, 6)
    typed(small@, " More")
    saves("an edit to one paragraph changes only its line", small@, arena,
        "%ksmd 2\n\nFirst.\n\nSecond More.\n\nThird.\n")

priv fn composing_and_pasting()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\n- one\n", arena)
    at(ed@, 0, 0, 3)
    ed.type_text("かんそ", .composition) catch
        verdict.check("committed text is taken", false, "refused")
    saves("committed composition text is inserted once", ed@, arena, "%ksmd 2\n\n- oneかんそ\n")
    $p: = opened("%ksmd 2\n\nStart end\n", arena)
    at(p@, 0, 0, 6)
    p.type_text("a\r\n\r\nb\nc ", .paste) catch
        verdict.check("pasted text is taken", false, "refused")
    saves("pasted lines become paragraphs of the caret's kind, and blank lines go", p@, arena,
        "%ksmd 2\n\nStart a\n\nb\n\nc end\n")
    $code: = opened("%ksmd 2\n\n```\nx\n```\n", arena)
    at(code@, 0, 0, 1)
    code.type_text("\ny\nz", .paste) catch
        verdict.check("pasted code is taken", false, "refused")
    saves("text pasted into code keeps its lines", code@, arena, "%ksmd 2\n\n```\nx\ny\nz\n```\n")

priv fn deleting()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\nAbc\n\n## Def\n", arena)
    at(ed@, 0, 0, 2)
    removed(ed@, true)
    saves("Backspace removes the character before the caret", ed@, arena,
        "%ksmd 2\n\nAc\n\n## Def\n")
    at(ed@, 1, 0, 0)
    removed(ed@, true)
    saves("Backspace at a block's start joins it to the block before", ed@, arena,
        "%ksmd 2\n\nAcDef\n")
    $fwd: = opened("%ksmd 2\n\nAb\n\nCd\n", arena)
    at(fwd@, 0, 0, 2)
    removed(fwd@, false)
    saves("Delete at a block's end joins the next block to it", fwd@, arena, "%ksmd 2\n\nAbCd\n")
    $wide: =
        opened("%ksmd 2\n\nKeep this\n\n:::table name=\"t\"\n| \"a\" |\n:::\n\nand that\n", arena)
    wide.select(text_spot(0, 0, 4), text_spot(2, 0, 3))
    removed(wide@, true)
    saves("a selection across a table removes the table and joins the text", wide@, arena,
        "%ksmd 2\n\nKeep that\n")
    $item: = opened("%ksmd 2\n\n- a\n  - b\n", arena)
    at(item@, 0, 1, 0)
    removed(item@, true)
    saves("Backspace at a nested item's start moves it one level out", item@, arena,
        "%ksmd 2\n\n- a\n- b\n")
    removed(item@, true)
    saves("and at the top it leaves the list as a paragraph", item@, arena, "%ksmd 2\n\n- a\n\nb\n")
    $all: = opened("%ksmd 2\n\n# Title\n\nText\n", arena)
    all.select(text_spot(0, 0, 0), text_spot(0, 0, 5))
    removed(all@, true)
    saves("a block left with no text goes", all@, arena, "%ksmd 2\n\nText\n")
    typed(all@, "New")
    saves("and typing where it stood makes a block of its kind again", all@, arena,
        "%ksmd 2\n\n# New\n\nText\n")

priv fn entering()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\nOne two\n", arena)
    at(ed@, 0, 0, 3)
    entered(ed@, false)
    saves("Enter in a paragraph splits it", ed@, arena, "%ksmd 2\n\nOne\n\ntwo\n")
    at(ed@, 1, 0, 4)
    entered(ed@, false)
    verdict.check("Enter at a block's end leaves the caret in a gap after it",
        ed.focus.place == .block_gap && ed.focus.block == 2, "")
    typed(ed@, "three")
    saves("and typing there adds a paragraph", ed@, arena, "%ksmd 2\n\nOne\n\ntwo\n\nthree\n")
    $head: = opened("%ksmd 2\n\n# Title\n", arena)
    at(head@, 0, 0, 5)
    entered(head@, false)
    typed(head@, "Body")
    saves("after a heading's end, the new block is a paragraph", head@, arena,
        "%ksmd 2\n\n# Title\n\nBody\n")
    $list: = opened("%ksmd 2\n\n- a\n- b\n", arena)
    at(list@, 0, 0, 1)
    entered(list@, false)
    typed(list@, "c")
    saves("Enter at an item's end makes the next item", list@, arena, "%ksmd 2\n\n- a\n- c\n- b\n")
    at(list@, 0, 2, 1)
    entered(list@, false)
    entered(list@, false)
    typed(list@, "After")
    saves("Enter in an empty item leaves the list", list@, arena,
        "%ksmd 2\n\n- a\n- c\n- b\n\nAfter\n")
    $hard: = opened("%ksmd 2\n\nOne\n", arena)
    at(hard@, 0, 0, 3)
    entered(hard@, true)
    saves("a hard break at a paragraph's end is kept out of the source", hard@, arena,
        "%ksmd 2\n\nOne\n")
    typed(hard@, "Two")
    saves("until text follows it", hard@, arena, "%ksmd 2\n\nOne\\\nTwo\n")
    $code: = opened("%ksmd 2\n\n```\nx\n```\n", arena)
    at(code@, 0, 0, 1)
    entered(code@, false)
    saves("Enter in code adds a line", code@, arena, "%ksmd 2\n\n```\nx\n\n```\n")
    entered(code@, false)
    typed(code@, "Text")
    saves("Enter on code's empty last line leaves the code", code@, arena,
        "%ksmd 2\n\n```\nx\n```\n\nText\n")
    $start: = opened("%ksmd 2\n\nOne\n", arena)
    at(start@, 0, 0, 0)
    entered(start@, false)
    typed(start@, "Zero")
    saves("Enter at a block's start opens a gap before it", start@, arena,
        "%ksmd 2\n\nZero\n\nOne\n")

priv fn blank_lines() //< Enter in a gap keeps a blank line; Backspace and Delete take it away
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\nOne.\n\nTwo.\n", arena)
    gap(ed@, 1)
    entered(ed@, false)
    saves("Enter in a gap puts a blank line there", ed@, arena, "%ksmd 2\n\nOne.\n\n\\\n\nTwo.\n")
    entered(ed@, false)
    saves("and the caret stays in a gap after it, so each press adds one", ed@, arena,
        "%ksmd 2\n\nOne.\n\n\\\n\n\\\n\nTwo.\n")
    at(ed@, 3, 0, 0)
    removed(ed@, true)
    saves("Backspace at the start of the text after one takes it away", ed@, arena,
        "%ksmd 2\n\nOne.\n\n\\\n\nTwo.\n")
    at(ed@, 0, 0, 4)
    removed(ed@, false)
    saves("Delete at the end of the text before one takes it away", ed@, arena,
        "%ksmd 2\n\nOne.\n\nTwo.\n")
    ed.undo()
    saves("each is one step of undo", ed@, arena, "%ksmd 2\n\nOne.\n\n\\\n\nTwo.\n")

priv fn kinds()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\nA\n\nB\nwith\\\nbreak\n\nC\n", arena)
    at(ed@, 0, 0, 0)
    kind(ed@, heading(2))
    saves("a paragraph becomes a heading", ed@, arena, "%ksmd 2\n\n## A\n\nB with\\\nbreak\n\nC\n")
    ed.select(text_spot(1, 0, 0), text_spot(2, 0, 1))
    kind(ed@, item(false))
    saves("paragraphs become one list; a hard break becomes a space", ed@, arena,
        "%ksmd 2\n\n## A\n\n- B with break\n- C\n")
    at(ed@, 1, 1, 0)
    ed.indent(true) catch
        verdict.check("indenting is taken", false, "refused")
    saves("an item nests one level deeper", ed@, arena, "%ksmd 2\n\n## A\n\n- B with break\n  - C\n")
    at(ed@, 1, 0, 0)
    kind(ed@, paragraph_style())
    saves("an item made a paragraph splits the list, and the next item moves to the top", ed@, arena,
        "%ksmd 2\n\n## A\n\nB with break\n\n- C\n")
    at(ed@, 1, 0, 0)
    kind(ed@, item(false))
    saves("an item made next to a list with its marker joins it", ed@, arena,
        "%ksmd 2\n\n## A\n\n- B with break\n- C\n")
    at(ed@, 1, 1, 0)
    kind(ed@, item(true))
    saves("another marker starts a list of its own", ed@, arena,
        "%ksmd 2\n\n## A\n\n- B with break\n\n1. C\n")
    at(ed@, 0, 0, 0)
    $code: = paragraph_style()
    code.kind = .code
    kind(ed@, code)
    saves("a heading becomes code", ed@, arena, "%ksmd 2\n\n```\nA\n```\n\n- B with break\n\n1. C\n")

priv fn marks()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\nabcdef\n", arena)
    ed.select(text_spot(0, 0, 1), text_spot(0, 0, 4))
    marked(ed@, .emphasis, "")
    saves("emphasis over a range", ed@, arena, "%ksmd 2\n\na*bcd*ef\n")
    ed.select(text_spot(0, 0, 3), text_spot(0, 0, 5))
    marked(ed@, .strong, "")
    saves("strong emphasis over a range that overlaps it", ed@, arena,
        "%ksmd 2\n\na*bc**d*****e**f\n")
    ed.select(text_spot(0, 0, 0), text_spot(0, 0, 6))
    marked(ed@, .emphasis, "")
    saves("emphasis over all of it, where part had it", ed@, arena, "%ksmd 2\n\n*abc**de**f*\n")
    marked(ed@, .emphasis, "")
    saves("and off again where all had it", ed@, arena, "%ksmd 2\n\nabc**de**f\n")
    ed.select(text_spot(0, 0, 0), text_spot(0, 0, 2))
    marked(ed@, .code, "")
    saves("inline code over a range", ed@, arena, "%ksmd 2\n\n`ab`c**de**f\n")
    ed.select(text_spot(0, 0, 2), text_spot(0, 0, 6))
    marked(ed@, .link, "https://kanso.example/a")
    saves("a link over a range holds its marks", ed@, arena,
        "%ksmd 2\n\n`ab`[c**de**f](https://kanso.example/a)\n")
    marked(ed@, .link, "")
    saves("an empty destination removes the link", ed@, arena, "%ksmd 2\n\n`ab`c**de**f\n")
    refused_link(ed@)

priv fn looks() //< alignment and colour, the looks text takes
    defer arena: = Arena(64 * 1024)
    $aligned: = opened("%ksmd 2\n\nOne\n\n# Two\n\n- three\n", arena)
    aligned.select(text_spot(0, 0, 0), text_spot(2, 0, 2))
    aligned.set_align("center") catch e
        verdict.check("aligning", false, e.message())
    saves("paragraphs and headings take the alignment, list items do not", aligned@, arena,
        "%ksmd 2\n\n{align=\"center\"}\nOne\n\n{align=\"center\"}\n# Two\n\n- three\n")
    at(aligned@, 0, 0, 3)
    entered(aligned@, false)
    typed(aligned@, "Next")
    saves("a paragraph split by Enter keeps its alignment", aligned@, arena,
        "%ksmd 2\n\n{align=\"center\"}\nOne\n\n{align=\"center\"}\nNext\n\n{align=\"center\"}\n# \
            Two\n\n- three\n")
    at(aligned@, 2, 0, 0)
    kind(aligned@, heading(2))
    saves("a heading made another level keeps its alignment", aligned@, arena,
        "%ksmd 2\n\n{align=\"center\"}\nOne\n\n{align=\"center\"}\nNext\n\n{align=\"center\"}\n## \
            Two\n\n- three\n")
    $across_refused: = false
    aligned.set_align("across") catch
        across_refused = true
    verdict.check("a paragraph refuses across, which belongs to table cells", across_refused, "")
    $coloured: = opened("%ksmd 2\n\nStop **now** please\n", arena)
    coloured.select(text_spot(0, 0, 0), text_spot(0, 0, 8))
    coloured.set_text_color("#C00000") catch e
        verdict.check("colouring", false, e.message())
    saves("a colour over a range is text in brackets, with marks kept inside", coloured@, arena,
        "%ksmd 2\n\n[Stop **now**]{color=\"#c00000\"} please\n")
    coloured.select(text_spot(0, 0, 5), text_spot(0, 0, 15))
    coloured.set_text_color("") catch e
        verdict.check("taking the colour away", false, e.message())
    saves("an empty colour takes it away over the range only", coloured@, arena,
        "%ksmd 2\n\n[Stop ]{color=\"#c00000\"}**now** please\n")
    coloured.undo()
    coloured.undo()
    saves("undo puts the text back as it was", coloured@, arena, "%ksmd 2\n\nStop **now** please\n")
    $refused: = false
    coloured.set_text_color("red") catch
        refused = true
    verdict.check("a colour that is not #rrggbb is refused", refused, "")

priv fn removing_blocks()
    defer arena: = Arena(64 * 1024)
    before: =
        "%ksmd 2\n\nOne\n\n:::include path=\"notes.ksmd\"\n:::\n\n:::image src=\"a.png\" \
            alt=\"\"\n:::\n\nTwo\n"
    $ed: = opened(before, arena)
    ed.remove_block(1) catch e
        verdict.check("removing an include", false, e.message())
    saves("an include block is removed, without a text editor", ed@, arena,
        "%ksmd 2\n\nOne\n\n:::image src=\"a.png\" alt=\"\"\n:::\n\nTwo\n")
    verdict.check("the caret ends the text before, as no text follows at once",
        ed.focus.place == .text && ed.focus.block == 0 && ed.focus.offset == 3, "")
    ed.remove_block(1) catch e
        verdict.check("removing an image", false, e.message())
    saves("and an image block", ed@, arena, "%ksmd 2\n\nOne\n\nTwo\n")
    verdict.check("the caret starts the text that takes its place",
        ed.focus.place == .text && ed.focus.block == 1 && ed.focus.offset == 0, "")
    ed.undo()
    ed.undo()
    saves("undo brings both back", ed@, arena, before)
    $refused_text: = false
    ed.remove_block(0) catch
        refused_text = true
    verdict.check("a paragraph is not removed as a whole block", refused_text, "")

priv fn undoing()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\nSay\n", arena)
    at(ed@, 0, 0, 3)
    for word in U8[][]::{ " ", "h", "e", "l", "l", "o", " ", "w", "o", "r", "l", "d" }
        typed(ed@, word)
    saves("typed letters land one by one", ed@, arena, "%ksmd 2\n\nSay hello world\n")
    ed.undo()
    saves("one undo takes back the last word", ed@, arena, "%ksmd 2\n\nSay hello\n")
    ed.undo()
    saves("the next takes back the word before it", ed@, arena, "%ksmd 2\n\nSay\n")
    verdict.check("undo puts the caret back where the step started", ed.focus.offset == 4, "")
    ed.redo()
    ed.redo()
    saves("redo gives both words back", ed@, arena, "%ksmd 2\n\nSay hello world\n")
    at(ed@, 0, 0, 0)
    entered(ed@, false)
    typed(ed@, "Top")
    ed.undo()
    ed.undo()
    saves("undo takes back a split block", ed@, arena, "%ksmd 2\n\nSay hello world\n")
    verdict.check("redo is possible after undo", ed.can_redo(), "")
    typed(ed@, "!")
    verdict.check("a new action drops what was undone", !ed.can_redo(), "")

priv fn refusals()
    defer arena: = Arena(64 * 1024)
    $ed: = opened("%ksmd 2\n\nText\n", arena)
    at(ed@, 0, 0, 4)
    refused_bytes(ed@)
    saves("and changes nothing", ed@, arena, "%ksmd 2\n\nText\n")
    verdict.check("a refused action leaves nothing to undo", !ed.can_undo(), "")

priv fn refused_link(ed: Editor$@)
    what: = "a link to a destination the reader refuses is refused"
    ed.toggle_mark(.link, "ftp://x") catch e
        verdict.check(what, e.message().equals(Refused.link.message()), e.message())
        return
    verdict.check(what, false, "the link was made")

priv fn refused_bytes(ed: Editor$@)
    what: = "text that is not UTF-8 is refused"
    ed.type_text(U8[]::{ 0xFFU8 }, .typing) catch e
        verdict.check(what, e.message().equals(Refused.no_read_back.message()), e.message())
        return
    verdict.check(what, false, "the text was typed")

// ---- Helpers ----

priv fn at(ed: Editor$@, block: Sz, item: Sz, offset: Sz) //< puts the caret in text
    p: = text_spot(block, item, offset)
    ed.select(p, p)

priv fn gap(ed: Editor$@, block: Sz) //< puts the caret in the gap before a block
    p: = gap_spot(block)
    ed.select(p, p)

priv fn typed(ed: Editor$@, text: U8[])
    ed.type_text(text, .typing) catch e
        verdict.check(text, false, e.message())

priv fn removed(ed: Editor$@, backward: Bool)
    ed.erase(backward) catch e
        verdict.check("deleting", false, e.message())

priv fn entered(ed: Editor$@, hard: Bool)
    ed.enter(hard) catch e
        verdict.check("Enter", false, e.message())

priv fn kind(ed: Editor$@, style: Style)
    ed.set_kind(style) catch e
        verdict.check("changing kind", false, e.message())

priv fn marked(ed: Editor$@, which: Mark, link: U8[])
    ed.toggle_mark(which, link) catch e
        verdict.check("a mark", false, e.message())

priv fn heading(level: Sz): Style
    $s: = paragraph_style()
    s.kind = .heading
    s.level = level
    return s

priv fn item(ordered: Bool): Style
    $s: = paragraph_style()
    s.kind = .list
    s.ordered = ordered
    return s

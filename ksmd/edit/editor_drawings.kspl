//< The editor's action on the shapes drawn over an image or a chart
//< Drawings never change in place. New drawings make a new entry in `Document.images` or
//< `Document.charts`, and the block points at it, so undo swaps the block back, as for a chart.
import "ksmd/edit/editor" { Editor, Refused, end_block, replace }
import "ksmd/edit/history" { begin }
import "ksmd/edit/region" { Unit, gap_spot, whole_unit }
import "ksmd/model/model" { Block, Drawing, MAX_DRAWINGS }
import "ksmd/syntax/drawing" { drawings_of }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }

impl Editor
    fn set_image_width(ed: Self$@, block: Sz, width: Sz): Void!Refused //<
        //< Gives an image its share of the text width in percent, 1 to 100, or 0 to fit it, as one
        //< step. The image takes a new entry, as for its drawings, so undo swaps the block back.
        if block < 0 || block >= ed.doc.blocks.len || width < 0 || width > 100
            throw .not_whole
        $b: = ed.doc.blocks.get(block)
        if b.kind != .image
            throw .not_whole
        $image: = ed.doc.images.get(b.first)
        image.width = width
        ed.doc.images.push(image)
        b.first = ed.doc.images.len - 1
        ed.put_whole(block, b)!

    fn set_image_words(ed: Self$@, block: Sz, caption: Bool, text: U8[]): Void!Refused //<
        //< Gives an image its caption, with `caption`, or else its alternate text, as one step
        //< Empty text takes the caption away, or marks the image as one that only decorates. What
        //< the reader would refuse, such as a line break, is refused, as every action's result is.
        if block < 0 || block >= ed.doc.blocks.len
            throw .not_whole
        $b: = ed.doc.blocks.get(block)
        if b.kind != .image
            throw .not_whole
        $image: = ed.doc.images.get(b.first)
        if caption
            image.caption = ed.arena.dup_str(text)
        else
            image.alt = ed.arena.dup_str(text)
        ed.doc.images.push(image)
        b.first = ed.doc.images.len - 1
        ed.put_whole(block, b)!

    fn set_drawings(ed: Self$@, block: Sz, text: U8[]): Void!Refused //<
        //< Gives an image or a chart the drawings `text` writes, as its clause's `draw` lines, as
        //< one step. What the reader would refuse is refused here, so the file reads back.
        if block < 0 || block >= ed.doc.blocks.len
            throw .not_whole
        $b: = ed.doc.blocks.get(block)
        if b.kind != .image && b.kind != .chart
            throw .not_whole
        // Each shape is one line, which the page ends with a line break.
        if text.count_str("\n") > MAX_DRAWINGS
            throw .too_many_drawings
        $drawings: = List<|Drawing|>(ed.arena)
        drawings_of(ed.arena.dup_str(text), drawings@, ed.arena) catch
            throw .no_read_back
        if b.kind == .image
            $image: = ed.doc.images.get(b.first)
            image.drawings = drawings
            ed.doc.images.push(image)
            b.first = ed.doc.images.len - 1
        else
            $chart: = ed.doc.charts[b.first]
            chart.drawings = drawings
            ed.doc.charts.push(chart)
            b.first = ed.doc.charts.len - 1
        ed.put_whole(block, b)!

    priv fn put_whole(ed: Self$@, block: Sz, b: Block): Void!Refused //<
        //< Puts a whole block back in its place, changed, as one step
        defer scratch: = Arena(16 * 1024)
        s: = gap_spot(block)
        e: = gap_spot(block + 1)
        $w: = ed.work(s, e, s.block, end_block(e), scratch)
        $frag: = List<|Unit|>(scratch)
        frag.push(whole_unit(b, scratch))
        r: = replace(w@, frag@, scratch)
        $tx: = begin(ed.selection(), ed.arena)
        ed.commit(w@, tx@, r.caret, r.caret, scratch)!
        ed.finish(tx, .other, false)!

//< Editing a table: inserting, removing and moving rows and columns, setting and copying a cell
//< Sorting the rows is in `sort.kspl`.
//< A reference stays attached to its row and column, so an insertion or a move changes only where
//< the reference is written. Removing a row or a column turns a reference to it into `#REF!`, and
//< moves a range's corner on it one line inward.
//< Caution: **An edit that would write a formula longer than 4,096 bytes is undone and refused.**
//< The reader refuses such a formula, so the saved source could not be opened again.
import "ksmd/base/dates" { is_date }
import "ksmd/base/marker" { is_decimal }
import "ksmd/calc/formula" { BROKEN, Positions, bind, find_table, has_attachable, text_piece,
    write_formula }
import "ksmd/model/choice" { choice_of, is_entry }
import "ksmd/model/format" { MAX_PLACES, Number_format, no_format, same_format, shows_numbers }
import "ksmd/model/group" { after_insert, after_remove, fault_of, innermost, order }
import "ksmd/model/look" { Look_part, is_note, plain_look, with_part }
import "ksmd/model/model" { Cell, Cell_kind, Corner, Document, Group, MAX_CELLS, MAX_COLUMNS,
    MAX_FORMULA, MAX_HEIGHT, MAX_ROWS, MAX_WEIGHT, MIN_HEIGHT, Piece, Row_height, Table }
import "ksmd/model/rule" { Rule, no_rule }
import "ksmd/syntax/chart" { reads_back }
import "ksmd/syntax/clause" { is_table_name, reads_as_formula }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strnum"

enum Edit_error //< why an edit was refused; a refused edit changes nothing
    outside //< no table, row, column or cell stands at that place
    too_many_rows //< a table holds at most 10,000 data rows
    too_many_columns //< a table holds at most 256 columns
    too_many_cells //< a table holds at most 100,000 cells, the header's included
    last_column //< a table keeps at least one column
    too_long //< a formula would be written longer than 4,096 bytes
    not_a_value //< the text is not a value of that kind, or would not read back as one cell
    not_a_name //< a table name is 1 to 255 bytes of text, with no control character
    name_taken //< another table of this source has the name
    not_widths //< a table takes one width per column, each a whole number from 1 to 10,000
    not_a_height //< a row's height is a whole number of points from 6 to 409
    not_a_filter //< a column's filter that the `filter` attribute does not hold
    not_a_look //< a colour is `#rrggbb`, a size 6 to 72 points, an alignment left, center or right
    not_a_format //< a number format the `formats` attribute does not hold
    no_format //< the columns have no number format whose places could change
    places //< a number format shows 0 to 9 decimal places
    groups_cross //< a group holds another whole, or shares no row with it
    grouped_already //< these rows are a group already
    too_deep //< a row stands in at most 8 groups
    no_group //< no group holds these rows
    not_a_choice //< the column takes only its choices
    not_choices //< a list of choices that cannot be saved
    not_a_rule //< a colour rule that cannot be saved
    not_a_note //< a note is 1 to 1,000 bytes of text
    chart_name //< a chart would not find its column again by the column's name

impl Edit_error
    fn message(e: Self): U8[] //< what the editor says: the problem, then what to do
        switch e
        case .outside
            return "No table, row, column or cell stands there."
        case .too_many_rows
            return "A table holds at most 10,000 data rows."
        case .too_many_columns
            return "A table holds at most 256 columns."
        case .too_many_cells
            return "A table holds at most 100,000 cells, the names included."
        case .last_column
            return "A table keeps at least one column. Remove the table instead."
        case .too_long
            return "A formula would be longer than 4,096 bytes. Shorten the formula."
        case .not_a_value
            return "This value cannot be saved in one cell. Put each '|' and '{' inside quotes, and \
                write a line break as \\n inside quotes."
        case .not_a_name
            return "A table name is 1 to 255 bytes of text, with no line breaks or other control \
                characters."
        case .name_taken
            return "Another table in this file has this name. Choose another name."
        case .not_a_look
            return "This look cannot be saved. A colour is '#' and six hex digits, a size 6 to 72 \
                points, and alignment left, center or right."
        case .not_widths
            return "These column widths cannot be saved. Give each column one whole number from 1 \
                to 10,000."
        case .not_a_filter
            return "This filter cannot be saved. Clear it, and choose the values or the condition \
                again."
        case .not_a_height
            return "A row's height is a whole number of points from 6 to 409."
        case .not_a_format
            return "This number format cannot be saved. A currency is three capital letters, as USD \
                or JPY."
        case .no_format
            return "This column has no number format. Choose a number format first."
        case .places
            return "A number format shows 0 to 9 decimal places."
        case .groups_cross
            return "A group holds another group whole, or none of its rows. Choose rows that hold \
                each group whole, or none of it."
        case .grouped_already
            return "These rows are a group already."
        case .too_deep
            return "A row stands in at most 8 groups."
        case .no_group
            return "No group holds these rows. Choose a row inside a group."
        case .not_a_choice
            return "This column takes only its choices. Choose one from the list, or change the \
                column's choices."
        case .not_a_note
            return "This note cannot be saved. A note is 1 to 1,000 bytes of text."
        case .chart_name
            return "A chart finds its columns by their names. Give each column it shows a name no \
                other column has, with no ','."
        case .not_a_rule
            return "This rule cannot be saved. Compare with a number, or with text that has no ',', \
                ';', '\"' or '\\', and choose a colour."
        case .not_choices
            return "These choices cannot be saved. Give 1 to 50 choices separated by commas, with \
                no '|', '\"' or '\\', and none twice."

priv struct Saved //< a piece an edit changed, kept to undo the edit
    table: Sz
    index: Sz
    piece: Piece

fn insert_rows(doc: Document$@, u: Sz, at: Sz, count: Sz, arena: Arena$@): Void!Edit_error //<
    //< `count` empty data rows before the row at `at`; at the count of rows, after the last one
    //< Every formula is measured once for all of them, not once for each row.
    t: = table_at(doc, u)!
    if at < 0 || at > t.rows.len || count < 1
        throw .outside
    if t.rows.len + count > MAX_ROWS
        throw .too_many_rows
    if t.cells.len + count * t.columns.len > MAX_CELLS
        throw .too_many_cells
    add_cells(t, at, count, true)
    widen(t.rows@, at, count, 0)
    for i in Range.asc(count)
        t.rows[at + i] = t.next_id + i
    t.next_id += count
    fits(doc) catch
        remove_cells(t, at, count, true)
        narrow(t.rows@, at, count)
        t.next_id -= count
        throw .too_long
    after_insert(t, at, count)
    attach_loose(doc, arena)

fn insert_columns(doc: Document$@, u: Sz, at: Sz, count: Sz, arena: Arena$@): Void!Edit_error //<
    //< `count` columns before the column at `at`, with empty names and empty cells
    //< In a table with column widths, each takes the width of the column they stand before, or of
    //< the last column when they are added after it.
    t: = table_at(doc, u)!
    if at < 0 || at > t.columns.len || count < 1
        throw .outside
    if t.columns.len + count > MAX_COLUMNS
        throw .too_many_columns
    if t.cells.len + count * (t.rows.len + 1) > MAX_CELLS
        throw .too_many_cells
    if t.weights.len > 0
        widen(t.weights@, at, count, t.weights[at if at < t.weights.len else at - 1])
    if t.formats.len > 0
        widen(t.formats@, at, count, no_format())
    if t.choices.len > 0
        widen(t.choices@, at, count, "")
    if t.rules.len > 0
        widen(t.rules@, at, count, no_rule())
    add_cells(t, at, count, false)
    widen(t.columns@, at, count, 0)
    for i in Range.asc(count)
        t.columns[at + i] = t.next_id + i
    t.next_id += count
    fits(doc) catch
        remove_cells(t, at, count, false)
        narrow(t.columns@, at, count)
        t.next_id -= count
        if t.weights.len > 0
            narrow(t.weights@, at, count)
        if t.formats.len > 0
            narrow(t.formats@, at, count)
        if t.choices.len > 0
            narrow(t.choices@, at, count)
        if t.rules.len > 0
            narrow(t.rules@, at, count)
        throw .too_long
    attach_loose(doc, arena)

fn remove_row(doc: Document$@, u: Sz, at: Sz): Void!Edit_error //<
    //< Removes a data row; a reference to it becomes `#REF!`
    t: = table_at(doc, u)!
    if at < 0 || at >= t.rows.len
        throw .outside
    id: = t.rows[at]
    defer scratch: = Arena(16 * 1024)
    $saved: = List<|Saved|>(scratch)
    detach(doc, u, id, true, saved@)
    $cells: = List<|Cell|>(scratch)
    for c in Range.asc(t.columns.len)
        cells.push(t.cells[t.at(at, c)])
    remove_cells(t, at, 1, true)
    t.rows.remove_at(at)
    fits(doc) catch
        t.rows.insert(at, id)
        for c in Range.asc(t.columns.len)
            t.cells.insert(t.at(at, c), cells[c])
        restore(doc, saved@)
        throw .too_long
    after_remove(t, at)

fn remove_column(doc: Document$@, u: Sz, at: Sz): Void!Edit_error //<
    //< Removes a column, its name, width and format; a reference to it becomes `#REF!`
    t: = table_at(doc, u)!
    if at < 0 || at >= t.columns.len
        throw .outside
    if t.columns.len == 1
        throw .last_column
    id: = t.columns[at]
    defer scratch: = Arena(16 * 1024)
    $saved: = List<|Saved|>(scratch)
    detach(doc, u, id, false, saved@)
    $cells: = List<|Cell|>(scratch)
    for r in Range.asc(t.rows.len + 1)
        cells.push(t.cells[r * t.columns.len + at])
    $weight: Sz = 0
    if t.weights.len > 0
        weight = t.weights[at]
        t.weights.remove_at(at)
    $format: = no_format()
    if t.formats.len > 0
        format = t.formats[at]
        t.formats.remove_at(at)
    $choices: U8[] = ""
    if t.choices.len > 0
        choices = t.choices[at]
        t.choices.remove_at(at)
    $rule: = no_rule()
    if t.rules.len > 0
        rule = t.rules[at]
        t.rules.remove_at(at)
    remove_cells(t, at, 1, false)
    t.columns.remove_at(at)
    fits(doc) catch
        t.columns.insert(at, id)
        columns: = t.columns.len
        for r in Range.asc(t.rows.len + 1)
            t.cells.insert(r * columns + at, cells[r])
        if t.weights.len > 0
            t.weights.insert(at, weight)
        if t.formats.len > 0
            t.formats.insert(at, format)
        if t.choices.len > 0
            t.choices.insert(at, choices)
        if t.rules.len > 0
            t.rules.insert(at, rule)
        restore(doc, saved@)
        throw .too_long

fn move_row(doc: Document$@, u: Sz, from: Sz, to: Sz): Void!Edit_error //<
    //< Moves the data row at `from` so that it stands at `to`; its references move with it
    t: = table_at(doc, u)!
    if from < 0 || from >= t.rows.len || to < 0 || to >= t.rows.len
        throw .outside
    shift_row(t, from, to)
    fits(doc) catch
        shift_row(t, to, from)
        throw .too_long

fn move_column(doc: Document$@, u: Sz, from: Sz, to: Sz): Void!Edit_error //<
    //< Moves the column at `from` so that it stands at `to`, with its name and width
    t: = table_at(doc, u)!
    if from < 0 || from >= t.columns.len || to < 0 || to >= t.columns.len
        throw .outside
    shift_column(t, from, to)
    fits(doc) catch
        shift_column(t, to, from)
        throw .too_long
    // Of two columns with one name, a chart finds the first.
    charts_found(doc, u) catch why
        shift_column(t, to, from)
        throw why

fn set_cell(doc: Document$@, u: Sz, row: Sz, column: Sz, kind: Cell_kind, text: U8[],
    arena: Arena$@): Void!Edit_error //<
        //< Puts a value in a data cell: text, a number or a date as written, a formula without its
        //< `=`
        //< An empty cell takes empty text. A formula's spaces at either end are dropped, as the
        //< reader drops them, and its references attach.
    t: = table_at(doc, u)!
    if row < 0 || row >= t.rows.len || column < 0 || column >= t.columns.len
        throw .outside
    $cell: = empty_cell()
    cell.kind = kind
    // A number or a date typed into a column with choices is one of them, as text.
    if (kind == .number || kind == .date) && t.choices.len > 0 && t.choices[column].len > 0
        cell.kind = .text
        cell.text = arena.dup_str(chosen(t, column, text)!)
        t.cells[t.at(row, column)] = with_look(cell, t.cells[t.at(row, column)])
        return
    switch kind
    case .empty
        if text.len > 0
            throw .not_a_value
    case .text
        if !is_utf8(text)
            throw .not_a_value
        cell.text = arena.dup_str(chosen(t, column, text)!)
    case .number
        value: = text.to_f64() catch
            throw .not_a_value
        if !is_decimal(text) || value - value != 0.0
            throw .not_a_value
        cell.text = arena.dup_str(text)
    case .date
        if !is_date(text)
            throw .not_a_value
        cell.text = arena.dup_str(text)
    case .formula
        formula: = text.trim_spaces()
        if formula.len > MAX_FORMULA
            throw .too_long
        if formula.len == 0 || !reads_as_formula(formula)
            throw .not_a_value
        cell.first = t.pieces.len
        cell.count = bind(doc, u, arena.dup_str(formula), t.pieces@)
    index: = t.at(row, column)
    // A new value keeps the cell's look and note, as a spreadsheet's cell keeps its format.
    cell.look = t.cells[index].look
    cell.note = t.cells[index].note
    t.cells[index] = cell

priv fn chosen(t: Table@, column: Sz, text: U8[]): U8[]!Edit_error //<
    //< The text a cell of the column holds: one of its choices, as the list spells it, where the
    //< column has a list; the text itself where it has none
    if t.choices.len == 0 || t.choices[column].len == 0
        return text
    return choice_of(t.choices[column], text) catch
        throw .not_a_choice

priv fn with_look($cell: Cell, was: Cell): Cell //< the cell, with the look and note it had
    cell.look = was.look
    cell.note = was.note
    return cell

fn copy_cell(doc: Document$@, from: Sz, row: Sz, column: Sz, to: Sz, to_row: Sz, to_column: Sz,
    arena: Arena$@): Void!Edit_error //<
        //< Copies a data cell to another, in the same table or another table of this source
        //< A formula's references without `$` shift as far as the copy moves; those with `$` stay.
        //< A reference shifted outside its table becomes `#REF!`.
    source: = table_at(doc, from)!
    target: = table_at(doc, to)!
    if row < 0 || row >= source.rows.len || column < 0 || column >= source.columns.len
        throw .outside
    if to_row < 0 || to_row >= target.rows.len || to_column < 0 ||
        to_column >= target.columns.len
        throw .outside
    from_index: = source.at(row, column)
    cell: = source.cells[from_index]
    if cell.kind != .formula
        // A value copied into a column with choices must be one of them.
        if cell.kind == .text || cell.kind == .number || cell.kind == .date
            _ok: = chosen(target, to_column, cell.text)!
        index: = target.at(to_row, to_column)
        target.cells[index] = cell
        return
    defer scratch: = Arena(16 * 1024)
    at: = Positions(doc, scratch)
    defer $out: = Str_builder()
    write_formula(doc, source, cell, at@, to_row - row, to_column - column, out@)
    set_cell(doc, to, to_row, to_column, .formula, out.slice(), arena)!
    target.cells[target.at(to_row, to_column)].look = cell.look
    target.cells[target.at(to_row, to_column)].note = cell.note

fn set_look(doc: Document$@, u: Sz, row: Sz, column: Sz, part: Look_part, value: U8[],
    arena: Arena$@): Void!Edit_error //<
        //< Sets or clears one part of a cell's look; row -1 is the names above the data rows
        //< A colour is `#rrggbb`, a size a number of points from 6 to 72, whole or ending in .5,
        //< and an alignment `left`, `center` or `right`. An empty value clears that part.
    t: = table_at(doc, u)!
    if row < -1 || row >= t.rows.len || column < 0 || column >= t.columns.len
        throw .outside
    index: = column if row < 0 else t.at(row, column)
    look: = with_part(t.cells[index].look, part, arena.dup_str(value)) catch
        throw .not_a_look
    if row >= 0 && !same_format(t.cells[index].look.format, look.format)
        drop_filters(t, column, column)
    t.cells[index].look = look

fn group_rows(doc: Document$@, u: Sz, first: Sz, last: Sz): Void!Edit_error //<
    //< Makes the data rows from `first` to `last` a group, shown
    t: = table_at(doc, u)!
    if first > last || last >= t.rows.len
        throw .outside
    t.groups.push(Group::{ .first = first, .last = last, .closed = false })
    order(t.groups@)
    if f: = fault_of(t.groups@)
        for i in Range.asc(t.groups.len)
            if t.groups[i].first == first && t.groups[i].last == last && !t.groups[i].closed
                t.groups.remove_at(i)
                break
        switch f
        case .twice
            throw .grouped_already
        case .too_deep
            throw .too_deep
        default
            throw .groups_cross

fn ungroup_rows(doc: Document$@, u: Sz, first: Sz, last: Sz): Void!Edit_error //<
    //< Takes away the smallest group that holds the data rows from `first` to `last`
    t: = table_at(doc, u)!
    at: = innermost(t.groups@, first, last) catch
        throw .no_group
    t.groups.remove_at(at)

fn show_group(doc: Document$@, u: Sz, first: Sz, last: Sz, shown: Bool): Void!Edit_error //<
    //< Shows or hides the rows of the smallest group that holds the rows from `first` to `last`
    t: = table_at(doc, u)!
    at: = innermost(t.groups@, first, last) catch
        throw .no_group
    t.groups[at].closed = !shown

fn set_choices(doc: Document$@, u: Sz, column: Sz, entry: U8[], arena: Arena$@): Void!Edit_error //<
    //< Gives a column its choices, as `choice.entry_of` makes them, or none with empty text
    //< Cells already off the new list keep their values; the page marks them.
    t: = table_at(doc, u)!
    if column < 0 || column >= t.columns.len
        throw .outside
    if !is_entry(entry)
        throw .not_choices
    if t.choices.len == 0
        for _ in Range.asc(t.columns.len)
            t.choices.push("")
    t.choices[column] = arena.dup_str(entry)

fn set_rule(doc: Document$@, u: Sz, column: Sz, r: Rule): Void!Edit_error //<
    //< Gives a column its colour rule, or none with `no_rule()`
    t: = table_at(doc, u)!
    if column < 0 || column >= t.columns.len
        throw .outside
    if t.rules.len == 0
        for _ in Range.asc(t.columns.len)
            t.rules.push(no_rule())
    t.rules[column] = r

fn set_note(doc: Document$@, u: Sz, row: Sz, column: Sz, note: U8[], arena: Arena$@):
    Void!Edit_error //<
        //< Gives a data cell a note, or takes its note away with empty text
    t: = table_at(doc, u)!
    if row < 0 || row >= t.rows.len || column < 0 || column >= t.columns.len
        throw .outside
    if note.len > 0 && !is_note(note)
        throw .not_a_note
    t.cells[t.at(row, column)].note = arena.dup_str(note)

fn set_widths(doc: Document$@, u: Sz, weights: List<|Sz|>@): Void!Edit_error //<
    //< Gives each column a relative width: its weight divided by the sum of the weights
    t: = table_at(doc, u)!
    if weights.len != t.columns.len
        throw .not_widths
    for weight in weights
        if weight < 1 || weight > MAX_WEIGHT
            throw .not_widths
    t.weights.clear()
    for weight in weights
        t.weights.push(weight)

fn set_heights(doc: Document$@, u: Sz, rows: Sz[], points: Sz): Void!Edit_error //<
    //< Gives each data row listed a least height in points; 0 takes it away
    //< Every row is checked first, so a refusal changes none.
    t: = table_at(doc, u)!
    if rows.len == 0
        throw .outside
    for r in rows
        if r < 0 || r >= t.rows.len
            throw .outside
    if points != 0 && (points < MIN_HEIGHT || points > MAX_HEIGHT)
        throw .not_a_height
    for r in rows
        $i: Sz = 0
        for i < t.heights.len && t.heights[i].row != t.rows[r]
            i += 1
        if i < t.heights.len
            t.heights.remove_at(i)
        if points > 0
            t.heights.push(Row_height::{ .row = t.rows[r], .points = points })

fn set_format(doc: Document$@, u: Sz, first: Sz, last: Sz, f: Number_format, arena: Arena$@):
    Void!Edit_error //<
        //< Gives columns `first` to `last` one number format; no format clears theirs
        //< `general` is a cell's own format alone: for a column it is the empty entry. The cells of
        //< those columns lose their own formats, so the whole column shows the one chosen, as
        //< Excel's format on a whole column does.
    t: = table_at(doc, u)!
    if first < 0 || last < first || last >= t.columns.len
        throw .outside
    if t.formats.len == 0
        for _ in Range.asc(t.columns.len)
            t.formats.push(no_format())
    $kept: = no_format() if f.kind == .general else f
    kept.code = arena.dup_str(f.code)
    for c in Range(first, last + 1, 1)
        t.formats[c] = kept
        for r in Range(-1, t.rows.len, 1)
            t.cells[t.at(r, c)].look.format = no_format()
    drop_filters(t, first, last)
    for g in t.formats
        if g.kind != .none
            return
    t.formats.clear()

fn step_places(doc: Document$@, u: Sz, first: Sz, last: Sz, more: Bool): Void!Edit_error //<
    //< Shows one more, or one fewer, decimal place in each column from `first` to `last` that
    //< has a number format
    t: = table_at(doc, u)!
    if first < 0 || last < first || last >= t.columns.len
        throw .outside
    $formatted: = false
    $changed: = false
    for c in Range(first, last + 1, 1)
        if t.formats.len == 0 || !shows_numbers(t.formats[c])
            continue
        formatted = true
        places: = t.formats[c].places
        if more && places < MAX_PLACES
            t.formats[c].places = places + 1
        else if !more && places > 0
            t.formats[c].places = places - 1
        else
            continue
        changed = true
        drop_filters(t, c, c)
    if !formatted
        throw .no_format
    if !changed
        throw .places

fn set_name(doc: Document$@, u: Sz, column: Sz, text: U8[], arena: Arena$@): Void!Edit_error //<
    //< Gives a column the name its header shows; the header keeps its look and note
    //< Refused where a chart would then not find its columns by their names.
    t: = table_at(doc, u)!
    if column < 0 || column >= t.columns.len
        throw .outside
    if !is_utf8(text)
        throw .not_a_value
    was: = t.cells[column]
    $cell: = empty_cell()
    cell.kind = .text
    cell.text = arena.dup_str(text)
    t.cells[column] = with_look(cell, was)
    charts_found(doc, u) catch why
        t.cells[column] = was
        throw why

fn new_table(doc: Document$@, columns: Sz, rows: Sz, arena: Arena$@): Sz!Edit_error //<
    //< Adds a table with empty names and cells, and returns its place in `doc.tables`
    //< It takes the first free name of `table1`, `table2` and on. A reference kept as text that now
    //< names one of its cells attaches.
    if columns < 1 || rows < 0
        throw .outside
    if columns > MAX_COLUMNS
        throw .too_many_columns
    if rows > MAX_ROWS
        throw .too_many_rows
    if (rows + 1) * columns > MAX_CELLS
        throw .too_many_cells
    $n: Sz = 1
    defer $name: = Str_builder()
    name.s("table1")
    for find_table(doc, name.slice()).is_some()
        n += 1
        name.clear()
        name.s("table\{n\}")
    $t: = Table(arena.dup_str(name.slice()), arena)
    for _ in Range.asc(columns)
        t.columns.push(t.next_id)
        t.next_id += 1
        $header: = empty_cell()
        header.kind = .text
        t.cells.push(header)
    for _ in Range.asc(rows)
        t.rows.push(t.next_id)
        t.next_id += 1
        for _ in Range.asc(columns)
            t.cells.push(empty_cell())
    doc.tables.push(t)
    attach_loose(doc, arena)
    return doc.tables.len - 1

fn remove_table(doc: Document$@, u: Sz, arena: Arena$@): Void!Edit_error //<
    //< Empties a table and its name, so it keeps its place and no reference finds it
    //< A reference to it from another table becomes text as written, and calculates as `#REF!`.
    //< The block that showed the table is the caller's to remove.
    t: = table_at(doc, u)!
    if t.name.len == 0
        throw .outside
    defer scratch: = Arena(16 * 1024)
    at: = Positions(doc, scratch)
    $found: = List<|Written|>(scratch)
    defer $out: = Str_builder()
    for v in Range.asc(doc.tables.len)
        if v == u
            continue
        for i in Range.asc(doc.tables[v].cells.len)
            cell: = doc.tables[v].cells[i]
            if cell.kind != .formula || !points_into(doc.tables[v]@, cell, u)
                continue
            out.clear()
            write_formula(doc, doc.tables[v]@, cell, at@, 0, 0, out@)
            found
                .push(Written::{ .table = v, .index = i,
                .text = arena.dup_str(out.slice()) })
    doc.tables[u] = Table("", arena)
    for w in found
        first: = doc.tables[w.table].pieces.len
        count: = bind(doc, w.table, w.text, doc.tables[w.table].pieces@)
        doc.tables[w.table].cells[w.index].first = first
        doc.tables[w.table].cells[w.index].count = count

fn rename_table(doc: Document$@, u: Sz, name: U8[], arena: Arena$@): Void!Edit_error //<
    //< Gives a table another name; references written with its name follow it
    //< A reference kept as text that now names one of its cells attaches. Refused where a formula
    //< would then be written longer than 4,096 bytes.
    t: = table_at(doc, u)!
    if t.name.len == 0
        throw .outside
    if !is_table_name(name) || !is_utf8(name)
        throw .not_a_name
    if found: = find_table(doc, name)
        if found != u
            throw .name_taken
        return
    was: = t.name
    t.name = arena.dup_str(name)
    // A reference written with the table's name grows with it.
    fits(doc) catch
        t.name = was
        throw .too_long
    attach_loose(doc, arena)

priv struct Written //< a formula written out as text, to be bound again
    table: Sz
    index: Sz //< its cell in `Table.cells`
    text: U8[]

priv fn points_into(t: Table@, cell: Cell, u: Sz): Bool //< whether a formula refers to table `u`
    for k in Range(cell.first, cell.first + cell.count, 1)
        p: = t.pieces[k]@
        if p.kind != .text && p.table == u
            return true
    return false

priv fn detach(doc: Document$@, u: Sz, id: Sz, row: Bool, saved: List<|Saved|>$@) //<
    //< Rewrites each reference to row or column `id` of table `u`, before it is removed
    //< A reference to one cell becomes `#REF!`. A range's corner on it moves one line toward the
    //< other corner, and a range with no line left becomes `#REF!`.
    defer scratch: = Arena(16 * 1024)
    at: = Positions(doc, scratch)
    t: = doc.tables[u]@
    lines: = t.rows@ if row else t.columns@
    for v in Range.asc(doc.tables.len)
        for i in Range.asc(doc.tables[v].cells.len)
            cell: = doc.tables[v].cells[i]
            if cell.kind != .formula
                continue
            for k in Range(cell.first, cell.first + cell.count, 1)
                $p: = doc.tables[v].pieces[k]
                if p.kind == .text || p.table != u
                    continue
                $a: = line_of(p.from, row)
                $b: = line_of(p.to, row)
                if a != id && b != id
                    continue
                saved.push(Saved::{ .table = v, .index = k, .piece = p })
                if a == b
                    doc.tables[v].pieces[k] = text_piece(BROKEN)
                    continue
                pa: = at.of(u, a)
                pb: = at.of(u, b)
                inward: = 1 if pa < pb else -1
                if a == id
                    a = lines[pa + inward]
                else
                    b = lines[pb - inward]
                p.from = with_line(p.from, row, a)
                p.to = with_line(p.to, row, b)
                doc.tables[v].pieces[k] = p

priv fn restore(doc: Document$@, saved: List<|Saved|>$@) //< puts back the pieces `detach` changed
    for s in saved
        doc.tables[s.table].pieces[s.index] = s.piece

fn fits(doc: Document@): Void!Edit_error //<
    //< Refuses when a formula would be written too long
    //< Every formula is measured: one whose reference became `#REF!` refers to no table now.
    defer scratch: = Arena(16 * 1024)
    at: = Positions(doc, scratch)
    defer $out: = Str_builder()
    for v in Range.asc(doc.tables.len)
        t: = doc.tables[v]@
        for cell in t.cells
            if cell.kind != .formula
                continue
            out.clear()
            write_formula(doc, t, cell, at@, 0, 0, out@)
            if out.slice().len > MAX_FORMULA
                throw .too_long

priv fn charts_found(doc: Document@, u: Sz): Void!Edit_error //<
    //< Refuses when a chart that a block shows would not find its columns of table `u` again
    for i in Range.asc(doc.blocks.len)
        b: = doc.blocks.get(i)
        if b.kind == .chart && doc.charts[b.first].table == u &&
            !reads_back(doc, doc.charts[b.first]@)
            throw .chart_name

fn attach_loose(doc: Document$@, arena: Arena$@) //<
    //< Binds again each formula holding a reference kept as text that names a cell now
    //< So a formula's reference is attached whenever it names a cell, as after reading.
    defer scratch: = Arena(16 * 1024)
    at: = Positions(doc, scratch)
    defer $out: = Str_builder()
    for v in Range.asc(doc.tables.len)
        for i in Range.asc(doc.tables[v].cells.len)
            cell: = doc.tables[v].cells[i]
            if cell.kind != .formula || !has_attachable(doc, v, doc.tables[v]@, cell)
                continue
            out.clear()
            write_formula(doc, doc.tables[v]@, cell, at@, 0, 0, out@)
            first: = doc.tables[v].pieces.len
            count: =
                bind(doc, v, arena.dup_str(out.slice()), doc.tables[v].pieces@)
            doc.tables[v].cells[i].first = first
            doc.tables[v].cells[i].count = count

priv fn shift_row(t: Table$@, from: Sz, to: Sz) //< moves a row's identity and its cells
    defer scratch: = Arena(16 * 1024)
    $cells: = List<|Cell|>(scratch)
    for c in Range.asc(t.columns.len)
        cells.push(t.cells[t.at(from, c)])
    remove_cells(t, from, 1, true)
    id: = t.rows[from]
    t.rows.remove_at(from)
    t.rows.insert(to, id)
    for c in Range.asc(t.columns.len)
        t.cells.insert(t.at(to, c), cells[c])

priv fn shift_column(t: Table$@, from: Sz, to: Sz) //<
    //< Moves a column's identity, cells, width and number format
    columns: = t.columns.len
    for r in Range.asc(t.rows.len + 1)
        cell: = t.cells[r * columns + from]
        t.cells.remove_at(r * columns + from)
        t.cells.insert(r * columns + to, cell)
    id: = t.columns[from]
    t.columns.remove_at(from)
    t.columns.insert(to, id)
    if t.weights.len > 0
        weight: = t.weights[from]
        t.weights.remove_at(from)
        t.weights.insert(to, weight)
    if t.formats.len > 0
        format: = t.formats[from]
        t.formats.remove_at(from)
        t.formats.insert(to, format)
    if t.choices.len > 0
        choices: = t.choices[from]
        t.choices.remove_at(from)
        t.choices.insert(to, choices)
    if t.rules.len > 0
        rule: = t.rules[from]
        t.rules.remove_at(from)
        t.rules.insert(to, rule)

priv fn add_cells(t: Table$@, at: Sz, count: Sz, row: Bool) //<
    //< Puts empty cells for `count` data rows from row `at`, or for `count` columns from column
    //< `at`, before `rows` or `columns` counts them
    //< A new column's name is empty text. Each cell moves once, so the cost is the table's size.
    columns: = t.columns.len
    if row
        widen(t.cells@, t.at(at, 0), count * columns, empty_cell())
        return
    lines: = t.rows.len + 1
    wider: = columns + count
    $name: = empty_cell()
    name.kind = .text
    widen(t.cells@, t.cells.len, lines * count, empty_cell())
    // From the end backwards, so no cell is overwritten before it moves.
    for r in Range.desc(lines)
        for c in Range.desc(wider)
            t.cells[r * wider + c] =
                (t.cells[r * columns + c] if c < at
                else t.cells[r * columns + c - count] if c >= at + count else name if r == 0
                else empty_cell())

priv fn remove_cells(t: Table$@, at: Sz, count: Sz, row: Bool) //<
    //< Removes the cells of `count` data rows from row `at`, or of `count` columns from column `at`
    //< with their names, while `rows` or `columns` still counts them
    columns: = t.columns.len
    if row
        narrow(t.cells@, t.at(at, 0), count * columns)
        return
    $kept: Sz = 0
    for i in Range.asc(t.cells.len)
        c: = i % columns
        if c < at || c >= at + count
            t.cells[kept] = t.cells[i]
            kept += 1
    for t.cells.len > kept
        _gone: = t.cells.pop()

priv fn widen<|T|>(list: List<|T|>$@, at: Sz, count: Sz, fill: T) //<
    //< Puts `count` copies of `fill` before place `at`, moving each later element once
    for _ in Range.asc(count)
        list.push(fill)
    for i in Range.desc(list.len - at - count)
        list[at + count + i] = list[at + i]
    for i in Range.asc(count)
        list[at + i] = fill

priv fn narrow<|T|>(list: List<|T|>$@, at: Sz, count: Sz) //<
    //< Removes `count` elements from place `at`, moving each later element once
    for i in Range(at, list.len - count, 1)
        list[i] = list[i + count]
    for _ in Range.asc(count)
        _gone: = list.pop()

priv fn line_of(c: Corner, row: Bool): Sz
    return c.row if row else c.column

priv fn with_line($c: Corner, row: Bool, id: Sz): Corner
    if row
        c.row = id
    else
        c.column = id
    return c

fn drop_filters(t: Table$@, first: Sz, last: Sz) //<
    //< Takes away the filters of columns `first` to `last`
    //< A filter matches the text a cell shows, so a change of format makes its entry stale.
    $i: Sz = 0
    for i < t.filters.len
        $kept: = true
        for c in Range(first, last + 1, 1)
            kept = kept && t.filters[i].column != t.columns[c]
        if kept
            i += 1
        else
            t.filters.remove_at(i)

fn table_at(doc: Document$@, u: Sz): Table$@!Edit_error //< the table at place `u`
    if u < 0 || u >= doc.tables.len
        throw .outside
    return doc.tables[u]@

priv fn is_utf8(text: U8[]): Bool //< whether the text is well-formed UTF-8, as a source must be
    $i: Sz = 0
    for i < text.len
        width: = text.utf8_seq_len(i) catch
            return false
        i += width
    return true

priv fn empty_cell(): Cell
    return Cell::{ .kind = .empty, .text = "", .first = 0, .count = 0, .offset = 0,
        .look = plain_look(), .note = "" }

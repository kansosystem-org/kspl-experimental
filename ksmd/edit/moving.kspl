//< Moving a table's rows, columns and cells: what a drag or a paste after a cut does
//< A moved line keeps its identity, so its references, height and notes go with it. Cells moved
//< as a block take their values, looks and notes, and a reference to a moved cell follows it.
import "ksmd/calc/formula" { BROKEN, Positions, text_piece }
import "ksmd/edit/edit" { Edit_error, Saved, charts_found, chosen, drop_filters, empty_cell, fits,
    restore, table_at }
import "ksmd/model/format" { no_format, same_format }
import "ksmd/model/model" { Cell, Corner, Document, Table, UNBOUND }
import "ksmd/model/rule" { no_rule }
import "std/ds" { List }
import "std/mem" { Arena }

fn move_rows(doc: Document$@, u: Sz, first: Sz, count: Sz, at: Sz): Void!Edit_error //<
    //< Moves `count` data rows from `first` to stand before the row at `at`; at the count of rows,
    //< after the last one
    //< Each row keeps its identity, so its references, height and notes go with it. A place inside
    //< the rows moved, or just after them, changes nothing.
    t: = table_at(doc, u)!
    if count < 1 || first < 0 || first + count > t.rows.len || at < 0 || at > t.rows.len
        throw .outside
    if at >= first && at <= first + count
        return
    lo: = at if at < first else first
    mid: = first if at < first else first + count
    hi: = first + count if at < first else at
    shift_rows(t, lo, mid, hi)
    fits(doc) catch
        shift_rows(t, lo, lo + hi - mid, hi)
        throw .too_long

fn move_columns(doc: Document$@, u: Sz, first: Sz, count: Sz, at: Sz): Void!Edit_error //<
    //< Moves `count` columns from `first` to stand before the column at `at`; at the count of
    //< columns, after the last one
    //< Each column keeps its identity, name, width, format, choices, rule and filter. A place
    //< inside the columns moved, or just after them, changes nothing.
    t: = table_at(doc, u)!
    if count < 1 || first < 0 || first + count > t.columns.len || at < 0 || at > t.columns.len
        throw .outside
    if at >= first && at <= first + count
        return
    lo: = at if at < first else first
    mid: = first if at < first else first + count
    hi: = first + count if at < first else at
    shift_columns(t, lo, mid, hi)
    fits(doc) catch
        shift_columns(t, lo, lo + hi - mid, hi)
        throw .too_long
    // Of two columns with one name, a chart finds the first.
    charts_found(doc, u) catch why
        shift_columns(t, lo, lo + hi - mid, hi)
        throw why

fn move_cells(doc: Document$@, u: Sz, top: Sz, left: Sz, height: Sz, width: Sz, to_row: Sz,
    to_column: Sz): Void!Edit_error //<
        //< Moves the `height` by `width` cells at `top`, `left` to stand from `to_row`,
        //< `to_column` of the same table, as a paste after a cut moves them
        //< Each cell there takes a moved cell whole; one left behind becomes empty. Row -1 is the
        //< names. A reference to a moved cell, or a range moved whole, follows it; one written
        //< over becomes `#REF!`. Whole columns, as `t.A`, follow only when every data row moves.
        //< Whole lines take their settings (`carry_columns`, `carry_heights`).
    t: = table_at(doc, u)!
    if height < 1 || width < 1 || top < -1 || left < 0 || to_row < -1 || to_column < 0 ||
        (top < 0 && to_row >= 0) || (top >= 0 && to_row < 0) || top + height > t.rows.len ||
        to_row + height > t.rows.len || left + width > t.columns.len ||
        to_column + width > t.columns.len
        throw .outside
    if top == to_row && left == to_column
        return
    // A value moved into a column with choices must be one of them, as for a copy. Whole columns
    // take their own choices with them.
    whole_columns: = top < 0 && top + height == t.rows.len
    for r in Range.asc(height)
        for c in Range.asc(width)
            cell: = t.cells[t.at(top + r, left + c)]
            if !whole_columns && top + r >= 0 &&
                (cell.kind == .text || cell.kind == .number || cell.kind == .date)
                _ok: = chosen(t, to_column + c, cell.text)!
    defer scratch: = Arena(64 * 1024)
    at: = Positions(doc, scratch)
    $saved: = List<|Saved|>(scratch)
    from: = Area::{ .top = top, .left = left, .height = height, .width = width }
    to: = Area::{ .top = to_row, .left = to_column, .height = height, .width = width }
    // Whole columns name every row, so only a block of every data row moves them.
    every_row: = top <= 0 && top + height == t.rows.len
    for v in Range.asc(doc.tables.len)
        for i in Range.asc(doc.tables[v].cells.len)
            cell: = doc.tables[v].cells[i]
            if cell.kind != .formula
                continue
            for k in Range(cell.first, cell.first + cell.count, 1)
                $p: = doc.tables[v].pieces[k]
                columns: = p.kind == .columns
                if p.kind == .text || p.table != u || columns && !every_row
                    continue
                a_moves: = from.holds(at@, u, p.from, columns)
                b_moves: = from.holds(at@, u, p.to, columns)
                if a_moves && b_moves
                    p.from =
                        moved(t, at@, u, p.from, to_row - top, to_column - left, columns)
                    p.to =
                        moved(t, at@, u, p.to, to_row - top, to_column - left, columns)
                else if !a_moves && !b_moves && to.holds(at@, u, p.from, columns) &&
                    to.holds(at@, u, p.to, columns)
                    p = text_piece(BROKEN)
                else
                    continue
                saved
                    .push(Saved::{ .table = v, .index = k,
                    .piece = doc.tables[v].pieces[k] })
                doc.tables[v].pieces[k] = p
    // The cells of both places as they were, to put back on a refusal.
    $places: = List<|Sz|>(scratch)
    $was: = List<|Cell|>(scratch)
    for which in Range.asc(2)
        area: = from if which == 0 else to
        for r in Range.asc(height)
            for c in Range.asc(width)
                index: = t.at(area.top + r, area.left + c)
                places.push(index)
                was.push(t.cells[index])
    $name: = empty_cell()
    name.kind = .text
    for r in Range.asc(height)
        for c in Range.asc(width)
            t.cells[t.at(top + r, left + c)] = name if top + r < 0 else empty_cell()
    for r in Range.asc(height)
        for c in Range.asc(width)
            t.cells[t.at(to_row + r, to_column + c)] = was[r * width + c]
    fits(doc) catch
        put_back(doc, u, places@, was@, saved@)
        throw .too_long
    // A name moved can leave a chart without its column.
    charts_found(doc, u) catch why
        put_back(doc, u, places@, was@, saved@)
        throw why
    if whole_columns
        // The filters go with their columns, whose cells keep the formats they matched.
        carry_columns(t, left, width, to_column)
        return
    if left == 0 && width == t.columns.len
        carry_heights(t, top, height, to_row)
    // A filter matches the text a cell shows, so a column whose cells change format loses it.
    for c in Range.asc(width)
        for r in Range.asc(height)
            format: = was[r * width + c].look.format
            if top + r >= 0 && !same_format(format, no_format())
                drop_filters(t, left + c, left + c)
            if top + r >= 0 &&
                !same_format(format, was[height * width + r * width + c].look.format)
                drop_filters(t, to_column + c, to_column + c)

priv fn carry_columns(t: Table$@, left: Sz, width: Sz, to_column: Sz) //<
    //< Gives the `width` columns from `to_column` the settings of those from `left`: width,
    //< number format, choices, colour rule, filter, merging and row colours
    //< A column left behind loses its settings, and a column written over loses its own.
    if t.widths.len > 0
        carry(t.widths@, left, width, to_column, 0)
        $any: = false
        for w in t.widths
            any = any || w > 0
        // Widths that are all 0 are written as none.
        if !any
            t.widths.clear()
    if t.formats.len > 0
        carry(t.formats@, left, width, to_column, no_format())
    if t.choices.len > 0
        carry(t.choices@, left, width, to_column, "")
    if t.rules.len > 0
        carry(t.rules@, left, width, to_column, no_rule())
    // The settings kept by a column's identity go to the identity of its new place.
    $i: Sz = 0
    for i < t.filters.len
        id: = carried(t.columns@, left, to_column, width, t.filters[i].column)
        if id == UNBOUND
            t.filters.remove_at(i)
        else
            t.filters[i].column = id
            i += 1
    i = 0
    for i < t.merged.len
        id: = carried(t.columns@, left, to_column, width, t.merged[i])
        if id == UNBOUND
            t.merged.remove_at(i)
        else
            t.merged[i] = id
            i += 1
    if t.row_colors != UNBOUND
        t.row_colors = carried(t.columns@, left, to_column, width, t.row_colors)

priv fn carry_heights(t: Table$@, top: Sz, height: Sz, to_row: Sz) //<
    //< Gives the `height` data rows from `to_row` the heights of those from `top`, as
    //< `carry_columns` gives columns their settings
    $i: Sz = 0
    for i < t.heights.len
        id: = carried(t.rows@, top, to_row, height, t.heights[i].row)
        if id == UNBOUND
            t.heights.remove_at(i)
        else
            t.heights[i].row = id
            i += 1

priv fn carry<|T|>(list: List<|T|>$@, from: Sz, count: Sz, to: Sz, none: T) //<
    //< Puts the `count` entries from `from` at `to`, and `none` where an entry was left behind
    //< The two runs may overlap: the entries are taken in the order that reads each one first.
    for k in Range.asc(count)
        at: = k if to < from else count - 1 - k
        list[to + at] = list[from + at]
    for place in Range(from, from + count, 1)
        if place < to || place >= to + count
            list[place] = none

priv fn carried(ids: List<|Sz|>@, from: Sz, to: Sz, count: Sz, id: Sz): Sz //<
    //< Where the setting of the line `id` goes when `count` lines' settings move from place `from`
    //< to place `to`: the identity at its new place, `UNBOUND` for a line written over, or `id`
    for k in Range.asc(count)
        if ids[from + k] == id
            return ids[to + k]
    for k in Range.asc(count)
        if ids[to + k] == id
            return UNBOUND
    return id

priv struct Area //< a rectangle of a table's cells, by places
    top: Sz
    left: Sz
    height: Sz
    width: Sz

impl Area
    fn holds(a: Self@, at: Positions@, u: Sz, c: Corner, whole: Bool): Bool //<
        //< Whether a corner stands in it; a whole column's corner, by its column alone
        column: = at.of(u, c.column)
        if column < 0 || column < a.left || column >= a.left + a.width
            return false
        if whole
            return true
        row: = at.of(u, c.row)
        return row >= 0 && row >= a.top && row < a.top + a.height

priv fn moved(t: Table@, at: Positions@, u: Sz, $c: Corner, rows: Sz, columns: Sz, whole: Bool):
    Corner //<
        //< The corner `rows` lower and `columns` further right, keeping its `$` marks; a whole
        //< column's corner only further right, as its row is unused
    if !whole
        c.row = t.rows[at.of(u, c.row) + rows]
    c.column = t.columns[at.of(u, c.column) + columns]
    return c

priv fn put_back(doc: Document$@, u: Sz, places: List<|Sz|>@, was: List<|Cell|>@,
    saved: List<|Saved|>$@) //< puts back the cells and pieces `move_cells` changed
    for j in Range.asc(places.len)
        doc.tables[u].cells[places[j]] = was[j]
    restore(doc, saved)

priv fn shift_rows(t: Table$@, lo: Sz, mid: Sz, hi: Sz) //<
    //< Puts the data rows from `mid` up to `hi` before those from `lo`, with their identities and
    //< cells; `shift_rows(t, lo, lo + hi - mid, hi)` puts them back
    rotate(t.rows@, lo, mid, hi)
    rotate(t.cells@, t.at(lo, 0), t.at(mid, 0), t.at(hi, 0))

priv fn shift_columns(t: Table$@, lo: Sz, mid: Sz, hi: Sz) //<
    //< Puts the columns from `mid` up to `hi` before those from `lo`, with their identities, cells,
    //< widths, formats, choices and rules, as `shift_rows` puts rows
    columns: = t.columns.len
    for r in Range.asc(t.rows.len + 1)
        rotate(t.cells@, r * columns + lo, r * columns + mid, r * columns + hi)
    rotate(t.columns@, lo, mid, hi)
    if t.widths.len > 0
        rotate(t.widths@, lo, mid, hi)
    if t.formats.len > 0
        rotate(t.formats@, lo, mid, hi)
    if t.choices.len > 0
        rotate(t.choices@, lo, mid, hi)
    if t.rules.len > 0
        rotate(t.rules@, lo, mid, hi)

priv fn rotate<|T|>(list: List<|T|>$@, lo: Sz, mid: Sz, hi: Sz) //<
    //< Puts the elements from `mid` up to `hi` before those from `lo`, moving each element once
    reverse(list, lo, mid)
    reverse(list, mid, hi)
    reverse(list, lo, hi)

priv fn reverse<|T|>(list: List<|T|>$@, lo: Sz, hi: Sz) //< the elements from `lo` up to `hi`
    $i: = lo
    $j: = hi - 1
    for i < j
        kept: = list[i]
        list[i] = list[j]
        list[j] = kept
        i += 1
        j -= 1

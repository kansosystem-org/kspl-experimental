//< The editor's actions on tables: adding and removing one, its rows and columns, its cells and
//< their looks, sorting, pasting a grid, widths, number formats, choices, colour rules, groups of
//< rows and names Each is one step of undo, recorded by comparing the tables with copies made
//< before it.
import "ksmd/base/dates" { is_date, typed_date, write_date }
import "ksmd/base/marker" { is_decimal }
import "ksmd/base/source" { Source }
import "ksmd/calc/calc" { calculate }
import "ksmd/calc/formula" { Positions, bind, find_table, shift_formula, write_formula }
import "ksmd/calc/value" as calculated
import "ksmd/edit/edit"
import "ksmd/edit/edit" { Edit_error }
import "ksmd/edit/editor" { Editor, Pos, Refused, end_block, replace }
import "ksmd/edit/history" { Transaction, begin, capture, is_empty, record_tables, swap }
import "ksmd/edit/moving"
import "ksmd/edit/region" { Unit, blank_unit, gap_spot, paragraph_style, settle, whole_unit }
import "ksmd/edit/series" { Series, series_of, value_at }
import "ksmd/edit/sort" { Sort_key, sort_rows }
import "ksmd/model/choice" { entry_of }
import "ksmd/model/filter" { is_filter_entry }
import "ksmd/model/format" { MAX_PLACES, Number_format, no_format, show_plain, shows_numbers }
import "ksmd/model/look" { Look_part, plain_look, with_part }
import "ksmd/model/model" { Block, Cell, Cell_kind, Column_filter, Document, MAX_NAME, Piece,
    Table }
import "ksmd/model/rule" { rule_of }
import "ksmd/syntax/reader"
import "std/chars"
import "std/ds" { List }
import "std/json"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strnum"

enum Table_edit //< a row or column edit a page asks for, at a row or column of the table
    insert_row //< an empty row before row `at`; at the count of rows, after the last
    remove_row
    insert_column //< an empty column before column `at`; at the count, after the last
    remove_column

struct Copied_at //< where copied cells stood: the row and column of their upper left cell
    row: Sz //< -1 for the names
    column: Sz
    rows: Sz[] //< the row each line was copied from; empty where they stood one after another

enum Group_edit //< what a page asks of the rows, or columns, from one to another
    group //< makes them a group
    ungroup //< takes away the smallest group that holds them
    hide //< hides the lines of that group
    show //< shows them again

impl Editor
    fn insert_table(ed: Self$@, columns: Sz, rows: Sz): Void!Refused //<
        //< Puts a new table in place of the selection, splitting the text the caret stands in
        defer scratch: = Arena(1024)
        none: = List<|List<|U8[]|>|>(scratch)
        ed.place_table(columns, rows, none@)!

    fn insert_grid(ed: Self$@, grid: List<|List<|U8[]|>|>@): Void!Refused //<
        //< Puts a new table made from a pasted grid in place of the selection, as one step
        //< The grid's first row gives the column names, and the rest the data rows.
        $columns: Sz = 1
        for line in grid
            columns = line.len if line.len > columns else columns
        rows: = grid.len - 1 if grid.len > 1 else 0
        ed.place_table(columns, rows, grid)!

    priv fn place_table(ed: Self$@, columns: Sz, rows: Sz, grid: List<|List<|U8[]|>|>@):
        Void!Refused //<
            //< A new table in place of the selection, its cells filled from the grid, as one step
        s: = ed.start_spot()
        e: = ed.end_spot()
        defer scratch: = Arena(16 * 1024)
        before: = capture(ed.doc@, scratch)
        $w: = ed.work(s, e, s.block, end_block(e), scratch)
        table: = Block::{ .kind = .table, .level = 0, .label = "", .text = "",
            .first = ed.doc.tables.len, .count = 1, .offset = 0, .align = .none, .note = "",
            .invisible = false }
        $frag: = List<|Unit|>(scratch)
        frag.push(blank_unit(paragraph_style(), scratch))
        frag.push(whole_unit(table, scratch))
        frag.push(blank_unit(paragraph_style(), scratch))
        r: = replace(w@, frag@, scratch)
        got: = settle(ed.doc@, w.units@, w.from, ed.arena, scratch) catch
            throw .no_read_back
        u: = edit.new_table(ed.doc@, columns, rows, ed.arena) catch why
            throw .table(why)
        if grid.len > 0
            ed.fill(u, -1, 0, grid, false, .none) catch why
                ed.put_tables_back(before@)
                throw .table(why)
        $tx: = begin(ed.selection(), ed.arena)
        caret: = Pos::{ .unit = r.last, .offset = 0 }
        ed.apply(w@, tx@, got@, caret, caret)
        ed.close_table_step(before@, tx)!

    fn paste_table(ed: Self$@, text: U8[]): Void!Refused //<
        //< Puts the one table a copied ksmd source holds in a block after the caret's paragraph,
        //< as one step, with its formulas, looks, formats, widths and filter
        //< A name another table has gains `_2`, `_3` and on, and the table's own formulas follow
        //< it.
        kept: = ed.arena.dup_str(text)
        src: = Source("clipboard.ksmd", kept) catch
            throw .not_a_table
        $from: = reader.read(src@, ed.arena) catch
            throw .not_a_table
        if from.blocks.len != 1 || from.blocks.get(0).kind != .table
            throw .not_a_table
        edit.rename_table(from@, 0,
            free_name(ed.doc@, from.tables[0].name, ed.arena), ed.arena) catch why
            throw .table(why)
        // Each formula is written out under the new name, and bound again in this document.
        defer scratch: = Arena(16 * 1024)
        at: = Positions(from@, scratch)
        $t: = from.tables[0]
        $texts: = List<|U8[]|>(scratch)
        defer $out: = Str_builder()
        for cell in t.cells
            if cell.kind == .formula
                out.clear()
                write_formula(from@, t@, cell, at@, 0, 0, out@)
                texts.push(ed.arena.dup_str(out.slice()))
        s: = ed.start_spot()
        g: = gap_spot(s.block + 1 if s.place == .text else s.block)
        before: = capture(ed.doc@, scratch)
        $w: = ed.work(g, g, g.block, end_block(g), scratch)
        $b: = from.blocks.get(0)
        b.first = ed.doc.tables.len
        b.offset = 0
        $frag: = List<|Unit|>(scratch)
        frag.push(whole_unit(b, scratch))
        r: = replace(w@, frag@, scratch)
        got: = settle(ed.doc@, w.units@, w.from, ed.arena, scratch) catch
            throw .no_read_back
        t.pieces = List<|Piece|>(ed.arena)
        ed.doc.tables.push(t)
        u: = ed.doc.tables.len - 1
        $k: Sz = 0
        for i in Range.asc(t.cells.len)
            if t.cells[i].kind == .formula
                first: = ed.doc.tables[u].pieces.len
                count: = bind(ed.doc@, u, texts[k], ed.doc.tables[u].pieces@)
                ed.doc.tables[u].cells[i].first = first
                ed.doc.tables[u].cells[i].count = count
                k += 1
        edit.attach_loose(ed.doc@, ed.arena)
        $tx: = begin(ed.selection(), ed.arena)
        caret: = Pos::{ .unit = r.last, .offset = 0 }
        ed.apply(w@, tx@, got@, caret, caret)
        ed.close_table_step(before@, tx)!

    fn remove_table(ed: Self$@, block: Sz): Void!Refused //<
        //< Removes a table block and empties its table, as `remove_whole` does
        _u: = ed.table_of(block)!
        ed.remove_whole(block)!

    fn edit_table(ed: Self$@, block: Sz, what: Table_edit, at: Sz, count: Sz): Void!Refused //<
        //< Inserts `count` rows or columns of the table a block shows before the one at `at`, or
        //< removes `count` from it, as one step
        //< A filter stays as it is: the page shows a new row until the filter is chosen again. A
        //< refusal changes nothing.
        u: = ed.table_of(block)!
        if count < 1
            throw .table(.outside)
        defer scratch: = Arena(16 * 1024)
        before: = capture(ed.doc@, scratch)
        switch what
        case .insert_row
            edit.insert_rows(ed.doc@, u, at, count, ed.arena) catch why
                throw .table(why)
        case .insert_column
            edit.insert_columns(ed.doc@, u, at, count, ed.arena) catch why
                throw .table(why)
        case .remove_row, .remove_column
            // Each line goes in turn from the same place; one refused puts every table back.
            for _ in Range.asc(count)
                if what == .remove_row
                    edit.remove_row(ed.doc@, u, at) catch why
                        ed.put_tables_back(before@)
                        throw .table(why)
                else
                    edit.remove_column(ed.doc@, u, at) catch why
                        ed.put_tables_back(before@)
                        throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn move_lines(ed: Self$@, block: Sz, rows: Bool, first: Sz, count: Sz, at: Sz): Void!Refused //<
        //< Moves `count` data rows, or columns, from `first` to stand before the one at `at`, as
        //< one step: what Insert cut rows and Insert cut columns do
        //< A place inside the lines moved, or just after them, changes nothing and records no step.
        u: = ed.table_of(block)!
        defer scratch: = Arena(16 * 1024)
        before: = capture(ed.doc@, scratch)
        if rows
            moving.move_rows(ed.doc@, u, first, count, at) catch why
                throw .table(why)
        else
            moving.move_columns(ed.doc@, u, first, count, at) catch why
                throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn move_cells(ed: Self$@, block: Sz, top: Sz, left: Sz, height: Sz, width: Sz, to_row: Sz,
        to_column: Sz): Void!Refused //<
            //< Moves the `height` by `width` cells at `top`, `left` to stand from `to_row`,
            //< `to_column`, as one step: what a paste after a cut does (`moving.move_cells`)
            //< The table grows rows and columns where the cells reach past it, as a paste grows it.
            //< A refusal changes nothing.
        u: = ed.table_of(block)!
        if height < 1 || width < 1 || to_row < -1 || to_column < 0
            throw .table(.outside)
        defer scratch: = Arena(64 * 1024)
        before: = capture(ed.doc@, scratch)
        rows: = ed.doc.tables[u].rows.len
        if to_row + height > rows
            edit.insert_rows(ed.doc@, u, rows, to_row + height - rows, ed.arena) catch why
                ed.put_tables_back(before@)
                throw .table(why)
        columns: = ed.doc.tables[u].columns.len
        if to_column + width > columns
            edit.insert_columns(ed.doc@, u, columns, to_column + width - columns, ed.arena) catch why
                ed.put_tables_back(before@)
                throw .table(why)
        moving.move_cells(ed.doc@, u, top, left, height, width, to_row, to_column) catch why
            ed.put_tables_back(before@)
            throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn set_cell(ed: Self$@, block: Sz, row: Sz, column: Sz, text: U8[]): Void!Refused //<
        //< Puts what a person typed in a cell; row -1 is the names above the data rows
        //< Text after `=` is a formula, a number as JSON writes one is a number, and nothing is an
        //< empty cell. Quoted text is text, so `"12"` is the text 12. Anything else is text as
        //< typed.
        //< **A line break typed into a cell that held none turns Wrap text on**, in the same step,
        //< as Excel does: unwrapped, the lines after it run past the column and are cut.
        u: = ed.table_of(block)!
        defer scratch: = Arena(16 * 1024)
        had_break: = ed.cell_text(u, row, column, scratch).find_char('\n').is_some()
        before: = capture(ed.doc@, scratch)
        ed.put_typed(u, row, column, text, scratch) catch why
            throw .table(why)
        if !had_break && text.find_char('\n').is_some()
            edit.set_look(ed.doc@, u, row, column, .wrap, "on", ed.arena) catch why
                ed.put_tables_back(before@)
                throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn put_typed(ed: Self$@, u: Sz, row: Sz, column: Sz, text: U8[], scratch: Arena$@):
        Void!Edit_error //<
            //< Puts text in a cell of table `u` as `value_of` reads it; row -1 is the names
        if row < 0
            edit.set_name(ed.doc@, u, column, text, ed.arena)!
            return
        value: = value_of(text, scratch)
        edit.set_cell(ed.doc@, u, row, column, value.kind, value.text, ed.arena)!

    fn sort_table(ed: Self$@, block: Sz, column: Sz, descending: Bool): Void!Refused //<
        //< Orders the data rows of the table a block shows by one column's values, as one step
        //< A formula sorts by its calculated value, which the rows hold before the sort.
        u: = ed.table_of(block)!
        t: = ed.doc.tables[u]@
        if column < 0 || column >= t.columns.len
            throw .table(.outside)
        defer scratch: = Arena(64 * 1024)
        values: = calculate(ed.doc@, ed.today, scratch, ed.own)
        $keys: = List<|Sort_key|>(scratch)
        for row in Range.asc(t.rows.len)
            v: = values.at(u, row, column)
            $key: = Sort_key::{ .group = 5, .number = 0.0, .text = "", .row = row }
            switch v.kind
            case .number
                key.group = 0
                key.number = v.number
            case .date
                key.group = 1
                key.number = v.number
            case .text
                key.group = 2
                key.text = v.text
            case .boolean
                key.group = 3
                key.number = 1.0 if v.boolean else 0.0
            case .error
                key.group = 4
                key.text = v.error.mark()
            case .empty
                key.group = 5
            keys.push(key)
        before: = capture(ed.doc@, scratch)
        sort_rows(ed.doc@, u, keys@, descending, scratch) catch why
            throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn set_look(ed: Self$@, block: Sz, from_row: Sz, from_column: Sz, to_row: Sz, to_column: Sz,
        part: Look_part, value: U8[]): Void!Refused //<
            //< Sets or clears one part of the look of every cell in a rectangle, as one step
            //< Row -1 is the names above the data rows. An empty value clears that part.
            //< The range and the value are checked first, so a refusal changes no cell.
        u: = ed.table_of(block)!
        t: = ed.doc.tables[u]@
        if from_row < -1 || to_row >= t.rows.len || from_row > to_row || from_column < 0 ||
            to_column >= t.columns.len || from_column > to_column
            throw .table(.outside)
        if with_part(plain_look(), part, value).is_none()
            throw .table(.not_a_look)
        defer scratch: = Arena(16 * 1024)
        before: = capture(ed.doc@, scratch)
        for row in Range(from_row, to_row + 1, 1)
            for column in Range(from_column, to_column + 1, 1)
                edit.set_look(ed.doc@, u, row, column, part, value, ed.arena) catch why
                    throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn paste_cells(ed: Self$@, block: Sz, row: Sz, column: Sz, grid: List<|List<|U8[]|>|>@):
        Void!Refused //<
            //< Puts a grid of pasted texts into a table from one cell, as one step
            //< Each text reads as typed text does (`value_of`); a number written with thousands
            //< separators, as `1,234.5`, is a number. Row -1 starts with the names. The table
            //< grows rows and columns where the grid reaches past it. A refusal changes nothing.
        u: = ed.table_of(block)!
        if row < -1 || column < 0
            throw .table(.outside)
        defer scratch: = Arena(64 * 1024)
        before: = capture(ed.doc@, scratch)
        ed.fill(u, row, column, grid, false, .none) catch why
            ed.put_tables_back(before@)
            throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn clear_cells(ed: Self$@, block: Sz, top: Sz, left: Sz, bottom: Sz, right: Sz,
        left_out: Sz[]): Void!Refused //<
            //< Empties every cell of a rectangle but those on the rows `left_out`, as one step
            //< Each cell keeps its look. Row -1 is the names. A refusal changes nothing.
        u: = ed.table_of(block)!
        t: = ed.doc.tables[u]@
        if top < -1 || left < 0 || bottom >= t.rows.len || right >= t.columns.len || top > bottom ||
            left > right
            throw .table(.outside)
        defer scratch: = Arena(64 * 1024)
        out: = marks_of(left_out, t.rows.len, scratch)!
        before: = capture(ed.doc@, scratch)
        for row in Range(top, bottom + 1, 1)
            if row >= 0 && out[row]
                continue
            for column in Range(left, right + 1, 1)
                ed.put_typed(u, row, column, "", scratch) catch why
                    ed.put_tables_back(before@)
                    throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn paste_copied(ed: Self$@, block: Sz, row: Sz, column: Sz, bottom: Sz, right: Sz,
        grid: List<|List<|U8[]|>|>@, from: Copied_at?): Void!Refused //<
            //< Puts cells copied in ksmd into a table from one cell, as one step
            //< Each text reads as typed text does (`value_of`), with no thousands separators taken
            //< out. With `from`, each formula's references shift by the distance from the line's
            //< own place there (`shift_formula`), as a fill shifts them. A range from `row`,
            //< `column` to `bottom`, `right` that holds the grid a whole number of times takes it
            //< that many times, each copy shifted from its own place. The table grows where the
            //< grid reaches past it. A refusal changes nothing.
        u: = ed.table_of(block)!
        if row < -1 || column < 0 || grid.len == 0
            throw .table(.outside)
        if f: = from
            if f.rows.len != 0 && f.rows.len != grid.len
                throw .table(.outside)
        $width: Sz = 0
        for line in grid
            width = line.len if line.len > width else width
        height: = grid.len
        $down: Sz = 1
        $across: Sz = 1
        if width > 0 && bottom >= row && right >= column && (bottom - row + 1) % height == 0 &&
            (right - column + 1) % width == 0
            down = (bottom - row + 1) / height
            across = (right - column + 1) / width
        defer scratch: = Arena(64 * 1024)
        before: = capture(ed.doc@, scratch)
        for i in Range.asc(down)
            for j in Range.asc(across)
                ed.fill(u, row + i * height, column + j * width, grid, true, from) catch why
                    ed.put_tables_back(before@)
                    throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    priv fn fill(ed: Self$@, u: Sz, row: Sz, column: Sz, grid: List<|List<|U8[]|>|>@, typed: Bool,
        from: Copied_at?): Void!Edit_error //<
            //< Grows table `u` to hold the grid from a cell, then sets each cell; row -1 is the names
            //< A text `typed` reads as typed; one that is not may hold thousands separators
            //< (`pasted`). With `from`, a formula's references shift by the distance from where
            //< its line was copied (`shift_formula`).
        $width: Sz = 0
        for line in grid
            width = line.len if line.len > width else width
        rows: = ed.doc.tables[u].rows.len
        if rows < row + grid.len
            edit.insert_rows(ed.doc@, u, rows, row + grid.len - rows, ed.arena)!
        columns: = ed.doc.tables[u].columns.len
        if columns < column + width
            edit.insert_columns(ed.doc@, u, columns, column + width - columns, ed.arena)!
        defer scratch: = Arena(16 * 1024)
        for r in Range.asc(grid.len)
            line: = grid[r]
            for c in Range.asc(line.len)
                at_row: = row + r
                $text: = line[c]
                if at_row >= 0 && !typed
                    text = pasted(text, scratch)
                if f: = from
                    if at_row >= 0 && text.starts_with("=")
                        copied_row: = f.rows[r] if f.rows.len > 0 else f.row + r
                        defer $out: = Str_builder()
                        out.c('=')
                        shift_formula(ed.doc@, u, text.sub_from(1), at_row - copied_row,
                            column - f.column, out@)
                        text = scratch.dup_str(out.slice())
                ed.put_typed(u, at_row, column + c, text, scratch)!

    fn fill_cells(ed: Self$@, block: Sz, top: Sz, left: Sz, height: Sz, width: Sz, bottom: Sz,
        right: Sz, series: Bool, left_out: Sz[]): Void!Refused //<
            //< Copies a range's first cells over the rest of it, as one step
            //< The `height` by `width` cells at `top`, `left` repeat down to `bottom` and across to
            //< `right`. Each copy is `edit.copy_cell`'s, so a reference without `$` shifts. With
            //< `series`, a line of those cells that goes on (`ksmd/edit/series.kspl`) goes on
            //< instead: each column when the range reaches down, each row when it reaches right.
            //< The rows `left_out` neither give nor take a cell, and a fill down counts only the
            //< others, so a series goes on from row to row taken. A refusal changes nothing.
        u: = ed.table_of(block)!
        t: = ed.doc.tables[u]@
        if top < 0 || left < 0 || height < 1 || width < 1 || bottom < top + height - 1 ||
            right < left + width - 1 || bottom >= t.rows.len || right >= t.columns.len
            throw .table(.outside)
        defer scratch: = Arena(64 * 1024)
        out: = marks_of(left_out, t.rows.len, scratch)!
        // The rows that take part, and how many of them give the cells copied.
        $taking: = List<|Sz|>(scratch)
        $given: Sz = 0
        for row in Range(top, bottom + 1, 1)
            if !out[row]
                taking.push(row)
                given = given + 1 if row < top + height else given
        if given == 0
            throw .table(.outside)
        before: = capture(ed.doc@, scratch)
        down: = bottom > top + height - 1
        $lines: = List<|Series|>(scratch)
        for i in Range.asc(width if down else height)
            $line: = List<|Cell|>(scratch)
            for j in Range.asc(given if down else width)
                line
                    .push(t
                    .cells[t.at(taking[j], left + i) if down else t.at(top + i, left + j)])
            // Without `series`, an empty line makes a line that repeats.
            if !series
                line.clear()
            lines.push(series_of(line@, scratch))
        for k in Range.asc(taking.len)
            row: = taking[k]
            for column in Range(left, right + 1, 1)
                from_row: = taking[k % given]
                from_column: = left + (column - left) % width
                if from_row == row && from_column == column
                    continue
                line: = lines[column - left if down else row - top]@
                if value: = value_at(line, k if down else column - left, scratch)
                    look: = t.cells[t.at(from_row, from_column)].look
                    kind: Cell_kind =
                        (.number if line.kind == .number else .date if line.kind == .date
                        else .text)
                    edit.set_cell(ed.doc@, u, row, column, kind, value, ed.arena) catch why
                        ed.put_tables_back(before@)
                        throw .table(why)
                    ed.doc.tables[u].cells[ed.doc.tables[u].at(row, column)].look = look
                    continue
                edit.copy_cell(ed.doc@, u, from_row, from_column, u, row, column, ed.arena) catch why
                    ed.put_tables_back(before@)
                    throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn put_tables_back(ed: Self$@, before: List<|Table|>@) //<
        //< Makes every table its copy again, after an edit refused midway; nothing is recorded
        //< A table added since is taken out.
        was: = ed.change
        $tx: = begin(ed.selection(), ed.arena)
        record_tables(ed.doc@, before, tx@, ed.arena)
        defer scratch: = Arena(16 * 1024)
        swap(ed.doc@, tx@, true, ed.change@, scratch)
        for ed.doc.tables.len > before.len
            _gone: = ed.doc.tables.pop()
        ed.change = was

    fn set_widths(ed: Self$@, block: Sz, widths: List<|Sz|>@): Void!Refused //<
        //< Gives the columns of the table a block shows their widths in tenths of a character, 0
        //< where a column fits its text, as one step
        u: = ed.table_of(block)!
        defer scratch: = Arena(16 * 1024)
        before: = capture(ed.doc@, scratch)
        edit.set_widths(ed.doc@, u, widths) catch why
            throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn set_filter(ed: Self$@, block: Sz, column: Sz, entry: U8[]): Void!Refused //<
        //< Gives a column the filter `entry`, empty for none, as one step; column -1 clears every
        //< column's (`ksmd/model/filter.kspl`)
        u: = ed.table_of(block)!
        t: = ed.doc.tables[u]@
        if column < -1 || column >= t.columns.len || (column < 0 && entry.len > 0)
            throw .table(.outside)
        if !is_filter_entry(entry)
            throw .table(.not_a_filter)
        defer scratch: = Arena(16 * 1024)
        before: = capture(ed.doc@, scratch)
        if column < 0
            t.filters.clear()
        else
            edit.drop_filters(t, column, column)
        if entry.len > 0
            t.filters
                .push(Column_filter::{ .column = t.columns[column],
                .entry = ed.arena.dup_str(entry) })
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn set_heights(ed: Self$@, block: Sz, rows: Sz[], points: Sz): Void!Refused //<
        //< Gives each data row listed a height in points, 0 for none, as one step
        u: = ed.table_of(block)!
        defer scratch: = Arena(16 * 1024)
        before: = capture(ed.doc@, scratch)
        edit.set_heights(ed.doc@, u, rows, points) catch why
            throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn group_lines(ed: Self$@, block: Sz, columns: Bool, first: Sz, last: Sz, what: Group_edit):
        Void!Refused //<
            //< Groups or ungroups the data rows, or the columns, from `first` to `last`, or hides or
            //< shows a group, as one step: a group and whether it is hidden are saved in the file
        u: = ed.table_of(block)!
        defer scratch: = Arena(16 * 1024)
        before: = capture(ed.doc@, scratch)
        switch what
        case .group
            edit.group_lines(ed.doc@, u, columns, first, last) catch why
                throw .table(why)
        case .ungroup
            edit.ungroup_lines(ed.doc@, u, columns, first, last) catch why
                throw .table(why)
        case .hide, .show
            edit.show_group(ed.doc@, u, columns, first, last, what == .show) catch why
                throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn set_format(ed: Self$@, block: Sz, first: Sz, last: Sz, f: Number_format): Void!Refused //<
        //< Gives columns `first` to `last` of a block's table one number format, as one step
        u: = ed.table_of(block)!
        defer scratch: = Arena(16 * 1024)
        before: = capture(ed.doc@, scratch)
        edit.set_format(ed.doc@, u, first, last, f, ed.arena) catch why
            throw .table(why)
        ed.close_table_step(before@, begin(ed.selection(), ed.arena))!

    fn set_choices(ed: Self$@, block: Sz, column: Sz, list: U8[]): Void!Refused //<
        //< Gives a column of a block's table the choices a person typed as `Open, Done`, or none
        //< with empty text, as one step
        u: = ed.table_of(block)!

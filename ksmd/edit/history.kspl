//< Undo and redo as model transactions: what each action changed, kept to swap back
//< A record holds the version of a part that the document does not show now. Undoing swaps it in,
//< which leaves the undone version in the record, ready for redo. Inline nodes and list items are
//< only ever added, so a block swapped back still names valid nodes.
//< A table edit is recorded by comparing each table with a copy made before the edit: cell by
//< cell and piece by piece where the table keeps its shape, or the whole table otherwise. Column
//< widths, formats, choices, rules and filters, groups, the column that colours whole rows, and
//< heights of rows, changed alone are recorded alone, so a large table's cells are not copied.
//< Caution: **Undo and redo strictly in order.** A swap restores the exact state its action started
//< from only when every later action has been undone first.
import "ksmd/edit/region" { Spot, Style }
import "ksmd/model/format" { Number_format, same_format }
import "ksmd/model/look" { same_look }
import "ksmd/model/model" { Block, Cell, Column_filter, Corner, Document, Group, Piece, Row_height,
    Table }
import "ksmd/model/rule" { Rule, same_rule }
import "std/ds" { List }
import "std/mem" { Arena }

struct Selection //< where the selection's two ends stood, and the kind a gap's new block takes
    anchor: Spot
    focus: Spot
    gap: Style

enum Step_kind //< which actions may join the step before them
    other
    typing
    deleting

struct Blocks_swap //< blocks that stood from `at` where `count` blocks stand now
    at: Sz
    count: Sz
    blocks: List<|Block|>

struct Table_swap //< another version of the table at `table`
    table: Sz
    version: Table

struct Cell_swap //< another version of cell `index` of the table at `table`
    table: Sz
    index: Sz
    cell: Cell

struct Piece_swap //< another version of piece `index` of the table at `table`
    table: Sz
    index: Sz
    piece: Piece

struct Columns_swap //< another version of the layout of the table at `table`
    //< Its column widths, formats, choices, rules and filters, its groups of rows and of
    //< columns, the column that colours whole rows, and its heights of rows.
    table: Sz
    widths: List<|Sz|>
    formats: List<|Number_format|>
    choices: List<|U8[]|>
    rules: List<|Rule|>
    groups: List<|Group|>
    column_groups: List<|Group|>
    row_colors: Sz
    heights: List<|Row_height|>
    filters: List<|Column_filter|>

struct Transaction //< what one action changed, and the selection before and after it
    blocks: List<|Blocks_swap|> //< in the order they were made
    tables: List<|Table_swap|>
    cells: List<|Cell_swap|>
    pieces: List<|Piece_swap|>
    columns: List<|Columns_swap|>
    before: Selection
    after: Selection
    kind: Step_kind
    word_ended: Bool //< typed text ended in a space, which ends the step
    grown: Sz //< how many bytes the action added to the source; below 0 where it took bytes away

struct Change //< what an action changed, for a page to show again
    from: Sz //< the first block changed
    tail: Sz //< how many blocks at the end are unchanged
    tables: Bool //< a table changed, so values may differ in every table
    any: Bool //< the document changed at all, blocks being removed included

impl Change
    fn none(doc: Document@): Change //< nothing changed yet
        return Change::{ .from = doc.blocks.len, .tail = doc.blocks.len, .tables = false,
            .any = false }

    fn note(r: Self$@, doc: Document@, at: Sz, count: Sz) //< blocks from `at`, `count` now, changed
        r.any = true
        if at < r.from
            r.from = at
        after: = doc.blocks.len - at - count
        if after < r.tail
            r.tail = after

struct History
    done: List<|Transaction|> //< the last one is undone first
    undone: List<|Transaction|> //< the last one is redone first

fn new_history(arena: Arena$@): History
    return History::{ .done = List<|Transaction|>(arena),
        .undone = List<|Transaction|>(arena) }

fn begin(before: Selection, arena: Arena$@): Transaction //< a transaction that has changed nothing
    return Transaction::{ .blocks = List<|Blocks_swap|>(arena),
        .tables = List<|Table_swap|>(arena), .cells = List<|Cell_swap|>(arena),
        .pieces = List<|Piece_swap|>(arena), .columns = List<|Columns_swap|>(arena),
        .before = before, .after = before, .kind = .other, .word_ended = false, .grown = 0 }

fn is_empty(tx: Transaction@): Bool //< whether it changed nothing
    return tx.blocks.len == 0 && tx.tables.len == 0 && tx.cells.len == 0 && tx.pieces.len == 0 &&
        tx.columns.len == 0

fn replace_blocks(doc: Document$@, tx: Transaction$@, at: Sz, removed: Sz,
    blocks: List<|Block|>@, change: Change$@, arena: Arena$@) //<
        //< Puts `blocks` in place of `removed` blocks from `at`, and records the swap
    $old: = List<|Block|>(arena)
    for i in Range.asc(removed)
        old.push(doc.blocks.get(at + i))
    splice(doc, at, removed, blocks)
    tx.blocks.push(Blocks_swap::{ .at = at, .count = blocks.len, .blocks = old })
    change.note(doc, at, blocks.len)

fn swap(doc: Document$@, tx: Transaction$@, undo: Bool, change: Change$@, scratch: Arena$@) //<
    //< Undoes the transaction, or redoes it, by swapping each recorded version with the document's
    //< Block swaps run backwards to undo, since a later one stands on the places an earlier left.
    for i in Range.asc(tx.blocks.len)
        k: = tx.blocks.len - 1 - i if undo else i
        s: = tx.blocks[k]@
        $now: = List<|Block|>(scratch)
        for j in Range.asc(s.count)
            now.push(doc.blocks.get(s.at + j))
        splice(doc, s.at, s.count, s.blocks@)
        change.note(doc, s.at, s.blocks.len)
        s.count = s.blocks.len
        s.blocks.clear()
        s.blocks.push_all(now.slice())
    for i in Range.asc(tx.tables.len)
        s: = tx.tables[i]@
        here: = doc.tables[s.table]
        doc.tables[s.table] = s.version
        s.version = here
    for i in Range.asc(tx.cells.len)
        s: = tx.cells[i]@
        here: = doc.tables[s.table].cells[s.index]
        doc.tables[s.table].cells[s.index] = s.cell
        s.cell = here
    for i in Range.asc(tx.pieces.len)
        s: = tx.pieces[i]@
        here: = doc.tables[s.table].pieces[s.index]
        doc.tables[s.table].pieces[s.index] = s.piece
        s.piece = here
    for i in Range.asc(tx.columns.len)
        s: = tx.columns[i]@
        widths: = doc.tables[s.table].widths
        formats: = doc.tables[s.table].formats
        choices: = doc.tables[s.table].choices
        rules: = doc.tables[s.table].rules
        groups: = doc.tables[s.table].groups
        column_groups: = doc.tables[s.table].column_groups
        row_colors: = doc.tables[s.table].row_colors
        heights: = doc.tables[s.table].heights
        filters: = doc.tables[s.table].filters
        doc.tables[s.table].widths = s.widths
        doc.tables[s.table].formats = s.formats
        doc.tables[s.table].choices = s.choices
        doc.tables[s.table].rules = s.rules
        doc.tables[s.table].groups = s.groups
        doc.tables[s.table].column_groups = s.column_groups
        doc.tables[s.table].row_colors = s.row_colors
        doc.tables[s.table].heights = s.heights
        doc.tables[s.table].filters = s.filters
        s.widths = widths
        s.formats = formats
        s.choices = choices
        s.rules = rules
        s.groups = groups
        s.column_groups = column_groups
        s.row_colors = row_colors
        s.heights = heights
        s.filters = filters
    if tx.tables.len + tx.cells.len + tx.pieces.len + tx.columns.len > 0
        change.tables = true
        change.any = true

priv fn splice(doc: Document$@, at: Sz, removed: Sz, blocks: List<|Block|>@) //<
    //< Replaces `removed` blocks from `at` with `blocks`, writing over the places both share
    shared: = removed if removed < blocks.len else blocks.len
    for i in Range.asc(shared)
        doc.blocks.set(at + i, blocks.get(i))
    for _ in Range(shared, removed, 1)
        doc.blocks.remove_at(at + shared)
    for i in Range(shared, blocks.len, 1)
        doc.blocks.insert(at + i, blocks.get(i))

fn capture(doc: Document@, scratch: Arena$@): List<|Table|> //<
    //< A copy of every table, made before a table edit for `record_tables`
    $copies: = List<|Table|>(scratch)
    for t in doc.tables
        copies.push(copied(t@, scratch))
    return copies

fn record_tables(doc: Document@, before: List<|Table|>@, tx: Transaction$@, arena: Arena$@) //<
    //< Records how each table differs from its copy in `before`
    //< A table added since is recorded against an empty table with no name, which is what the
    //< document holds at its place once the edit is undone.
    for table in Range.asc(doc.tables.len)
        if table >= before.len
            tx.tables.push(Table_swap::{ .table = table, .version = Table("", arena) })
            continue
        t: = doc.tables[table]@
        b: = before[table]@
        if !keeps_shape(t, b)
            tx.tables.push(Table_swap::{ .table = table, .version = copied(b, arena) })
            continue
        for i in Range.asc(b.cells.len)
            if !same_cell(t.cells[i], b.cells[i])
                tx.cells
                    .push(Cell_swap::{ .table = table, .index = i, .cell = b.cells[i] })
        for i in Range.asc(b.pieces.len)
            if !same_piece(t.pieces[i]@, b.pieces[i]@)
                tx.pieces
                    .push(Piece_swap::{ .table = table, .index = i, .piece = b.pieces[i] })
        if !same_ids(t.widths@, b.widths@) || !same_formats(t.formats@, b.formats@) ||
            !same_texts(t.choices@, b.choices@) || !same_rules(t.rules@, b.rules@) ||
            !same_groups(t.groups@, b.groups@) ||
            !same_groups(t.column_groups@, b.column_groups@) || t.row_colors != b.row_colors ||
            !same_heights(t.heights@, b.heights@) ||
            !same_filters(t.filters@, b.filters@)
            tx.columns
                .push(Columns_swap::{ .table = table, .widths = copied_ids(b.widths@, arena),
                .formats = copied_formats(b.formats@, arena),
                .choices = copied_texts(b.choices@, arena),
                .rules = copied_rules(b.rules@, arena),
                .groups = copied_groups(b.groups@, arena),
                .column_groups = copied_groups(b.column_groups@, arena),
                .row_colors = b.row_colors, .heights = copied_heights(b.heights@, arena),
                .filters = copied_filters(b.filters@, arena) })

priv fn copied(table: Table@, arena: Arena$@): Table //<
    //< the table with its lists copied into `arena`
    $c: = Table(table.name, arena)
    c.next_id = table.next_id
    for cell in table.cells
        c.cells.push(cell)
    for id in table.rows
        c.rows.push(id)
    for id in table.columns
        c.columns.push(id)
    for p in table.pieces
        c.pieces.push(p)
    c.widths = copied_ids(table.widths@, arena)
    c.formats = copied_formats(table.formats@, arena)
    c.choices = copied_texts(table.choices@, arena)
    c.rules = copied_rules(table.rules@, arena)
    c.groups = copied_groups(table.groups@, arena)
    c.column_groups = copied_groups(table.column_groups@, arena)
    c.row_colors = table.row_colors
    c.caption = table.caption
    c.merged = copied_ids(table.merged@, arena)
    c.heights = copied_heights(table.heights@, arena)
    c.filters = copied_filters(table.filters@, arena)
    return c

priv fn copied_texts(texts: List<|U8[]|>@, arena: Arena$@): List<|U8[]|> //<
    //< The list copied into `arena`; each text stays where it was, since none changes
    $c: = List<|U8[]|>(arena)
    for t in texts
        c.push(t)
    return c

priv fn copied_rules(rules: List<|Rule|>@, arena: Arena$@): List<|Rule|> //<
    //< The list copied into `arena`
    $c: = List<|Rule|>(arena)
    for r in rules
        c.push(r)
    return c

priv fn same_rules(left: List<|Rule|>@, right: List<|Rule|>@): Bool
    if left.len != right.len
        return false
    for i in Range.asc(left.len)
        if !same_rule(left[i], right[i])
            return false
    return true

priv fn same_texts(left: List<|U8[]|>@, right: List<|U8[]|>@): Bool
    if left.len != right.len
        return false
    for i in Range.asc(left.len)
        if !left[i].equals(right[i])
            return false
    return true

priv fn copied_groups(groups: List<|Group|>@, arena: Arena$@): List<|Group|> //<
    //< The list copied into `arena`
    $c: = List<|Group|>(arena)
    for g in groups
        c.push(g)
    return c

priv fn same_groups(left: List<|Group|>@, right: List<|Group|>@): Bool
    if left.len != right.len
        return false
    for i in Range.asc(left.len)
        if left[i].first != right[i].first || left[i].last != right[i].last ||
            left[i].closed != right[i].closed
            return false
    return true

priv fn copied_filters(filters: List<|Column_filter|>@, arena: Arena$@): List<|Column_filter|> //<
    //< The list copied into `arena`; each entry's text stays where it was, since none changes
    $c: = List<|Column_filter|>(arena)
    for f in filters
        c.push(f)
    return c

priv fn same_filters(left: List<|Column_filter|>@, right: List<|Column_filter|>@): Bool
    if left.len != right.len
        return false
    for i in Range.asc(left.len)
        if left[i].column != right[i].column ||
            !left[i].entry.equals(right[i].entry)
            return false
    return true

priv fn copied_heights(heights: List<|Row_height|>@, arena: Arena$@): List<|Row_height|> //<
    //< The list copied into `arena`
    $c: = List<|Row_height|>(arena)
    for h in heights
        c.push(h)
    return c

priv fn same_heights(left: List<|Row_height|>@, right: List<|Row_height|>@): Bool
    if left.len != right.len
        return false
    for i in Range.asc(left.len)
        if left[i].row != right[i].row || left[i].points != right[i].points
            return false
    return true

priv fn copied_formats(formats: List<|Number_format|>@, arena: Arena$@): List<|Number_format|> //<
    //< The list copied into `arena`; a currency's code stays where it was, since none changes
    $c: = List<|Number_format|>(arena)
    for f in formats
        c.push(f)
    return c

priv fn same_formats(left: List<|Number_format|>@, right: List<|Number_format|>@): Bool
    if left.len != right.len
        return false
    for i in Range.asc(left.len)
        if !same_format(left[i], right[i])
            return false
    return true

priv fn copied_ids(ids: List<|Sz|>@, arena: Arena$@): List<|Sz|> //< the list copied into `arena`
    $c: = List<|Sz|>(arena)
    for id in ids
        c.push(id)
    return c

priv fn keeps_shape(table: Table@, copy: Table@): Bool //<
    //< Whether a table has the rows, columns, name and cell count of its copy, and kept every piece
    //< Its column widths, formats, choices, rules and filters, its groups, the column that
    //< colours its rows, and its heights of rows can differ: `Columns_swap` records them. A new
    //< caption or merged columns, which change seldom, take a copy of the whole table.
    return table.name.equals(copy.name) && table.caption.equals(copy.caption) &&
        same_ids(table.merged@, copy.merged@) && table.next_id == copy.next_id &&
        table.cells.len == copy.cells.len && table.pieces.len >= copy.pieces.len &&
        same_ids(table.rows@, copy.rows@) && same_ids(table.columns@, copy.columns@)

priv fn same_ids(left: List<|Sz|>@, right: List<|Sz|>@): Bool
    if left.len != right.len
        return false
    for i in Range.asc(left.len)
        if left[i] != right[i]
            return false
    return true

priv fn same_cell(left: Cell, right: Cell): Bool
    return left.kind == right.kind && left.text.equals(right.text) && left.first == right.first &&
        left.count == right.count && same_look(left.look, right.look) &&
        left.note.equals(right.note) && left.link.equals(right.link)

priv fn same_piece(left: Piece@, right: Piece@): Bool
    return left.kind == right.kind && left.text.equals(right.text) && left.table == right.table &&
        left.named == right.named && same_corner(left.from, right.from) &&
        same_corner(left.to, right.to)

priv fn same_corner(left: Corner, right: Corner): Bool
    return left.row == right.row && left.column == right.column &&
        left.fixed_row == right.fixed_row && left.fixed_column == right.fixed_column

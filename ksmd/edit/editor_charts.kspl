//< The editor's actions on charts: a new chart of a table, and new settings for a chart
//< A chart's settings never change in place. A changed chart is a new one in `Document.charts`,
//< and its block points at it, so undo swaps the block back, as for any block.
import "ksmd/calc/calc" { calculate }
import "ksmd/calc/value" { Value_kind }
import "ksmd/edit/editor" { Editor, Refused }
import "ksmd/edit/region" { Spot, gap_spot }
import "ksmd/model/model" { Block, Chart, Chart_kind, Drawing, MAX_SERIES, Table, UNBOUND }
import "ksmd/syntax/chart" { reads_back }
import "std/ds" { List }
import "std/mem" { Arena }

struct Chart_settings //< what a page asks a chart to show, by the places of the table's columns
    table: Sz //< the table's place in `Document.tables`
    kind: Chart_kind
    labels: Sz
    values: List<|Sz|> //< the columns drawn; by rows, the rows drawn, by their places
    title: U8[]
    by_rows: Bool
    from: Sz //< by rows, the first and last columns drawn as points
    to: Sz

impl Editor
    fn insert_chart(ed: Self$@, block: Sz): Void!Refused //<
        //< A bar chart of the table a block shows, in a block of its own after the table
        //< Its labels are the first column, and it draws the first other column that holds
        //< numbers, or the second column where none does.
        if block < 0 || block >= ed.doc.blocks.len ||
            ed.doc.blocks.get(block).kind != .table
            throw .not_whole
        table: = ed.doc.blocks.get(block).first
        t: = ed.doc.tables[table]@
        defer scratch: = Arena(16 * 1024)
        $values: = List<|Sz|>(scratch)
        values.push(numeric_column(ed, table, t) if t.columns.len > 1 else 0)
        settings: = Chart_settings::{ .table = table, .kind = .bar, .labels = 0, .values = values,
            .title = "", .by_rows = false, .from = 0, .to = 0 }
        chart: = ed.chart_of(settings@)!
        s: = gap_spot(block + 1)
        ed.put_chart(s, s, chart)!

    fn set_chart(ed: Self$@, block: Sz, settings: Chart_settings@): Void!Refused //<
        //< Gives a chart block new settings, as one step
        if block < 0 || block >= ed.doc.blocks.len ||
            ed.doc.blocks.get(block).kind != .chart
            throw .not_whole
        $chart: = ed.chart_of(settings)!
        // What is drawn over it stays, in the same frame.
        chart.drawings = ed.doc.charts[ed.doc.blocks.get(block).first].drawings
        ed.put_chart(gap_spot(block), gap_spot(block + 1), chart)!

    priv fn chart_of(ed: Self$@, settings: Chart_settings@): Chart!Refused //<
        //< A chart of the settings, its columns held by identity
        //< Refused where the saved chart would not find these columns by their names: one with no
        //< name or another's, or a drawn one whose name holds a ','.
        if settings.table < 0 || settings.table >= ed.doc.tables.len ||
            ed.doc.tables[settings.table].name.len == 0
            throw .table(.outside)
        t: = ed.doc.tables[settings.table]@
        if settings.labels < 0 || settings.labels >= t.columns.len || settings.values.len == 0 ||
            settings.values.len > MAX_SERIES
            throw .table(.outside)
        $ids: = List<|Sz|>(ed.arena)
        $names: = List<|U8[]|>(ed.arena)
        for c in settings.values
            if settings.by_rows
                // A row is named by its text in the labels column, as the file writes it.
                if c < 0 || c >= t.rows.len
                    throw .table(.outside)
                cell: = t.cells[t.at(c, settings.labels)]
                if cell.kind != .text || cell.text.len == 0
                    throw .table(.chart_name)
                ids.push(UNBOUND)
                names.push(cell.text)
                continue
            if c < 0 || c >= t.columns.len
                throw .table(.outside)
            ids.push(t.columns[c])
            names.push(t.cells[c].text)
        if settings.by_rows &&
            (settings.from < 0 || settings.from >= t.columns.len || settings.to < 0 ||
            settings.to >= t.columns.len)
            throw .table(.outside)
        chart: = Chart::{ .kind = settings.kind, .title = ed.arena.dup_str(settings.title),
            .table = settings.table, .name = t.name, .labels = t.columns[settings.labels],
            .label_name = t.cells[settings.labels].text, .series = ids, .series_names = names,
            .by_rows = settings.by_rows,
            .from = t.columns[settings.from] if settings.by_rows else UNBOUND,
            .from_name = t.cells[settings.from].text if settings.by_rows else "",
            .to = t.columns[settings.to] if settings.by_rows else UNBOUND,
            .to_name = t.cells[settings.to].text if settings.by_rows else "",
            .drawings = List<|Drawing|>(ed.arena) }
        if !reads_back(ed.doc@, chart@)
            throw .table(.chart_name)
        return chart

    priv fn put_chart(ed: Self$@, start: Spot, end: Spot, chart: Chart): Void!Refused //<
        //< A block for the chart in place of what stands from `start` to `end`, as one step
        ed.doc.charts.push(chart)
        ed.put_whole(start, end, Block.whole(.chart, ed.doc.charts.len - 1, 0))!

priv fn numeric_column(ed: Editor@, table: Sz, grid: Table@): Sz //<
    //< The first column after the first whose values are mostly numbers, or the second column
    defer scratch: = Arena(64 * 1024)
    values: = calculate(ed.doc@, ed.today, scratch, ed.own)
    for c in Range(1, grid.columns.len, 1)
        $numbers: Sz = 0
        for r in Range.asc(grid.rows.len)
            if values.at(table, r, c).kind == Value_kind.number
                numbers += 1
        if numbers * 2 > grid.rows.len
            return c
    return 1

//< The folder's files, as the model's tools reach them
//< **Every path the model gives passes `resolve` first**, so nothing outside the folder, no link
//< and no hidden name is ever read. The tools only read: nothing here writes a file.
//< A file is text when it holds no NUL byte and is valid UTF-8 (`text_problem`). **A Word or Excel
//< file is read as its text view** (`ksagent/office/`), so the tools and the citation check see
//< lines in both. **A conversation's files are no source**: they hold the model's own words and a
//< person's questions (`is_conversation`).
import "ksagent/office/excel"
import "ksagent/office/word"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/seq"
import "std/str"
import "std/strfmt" as _strfmt
import "std/sys"

const MAX_HITS: Sz = 50 //< the most lines one search returns
const MAX_READ_LINES: Sz = 400 //< the most lines one read returns
const MAX_READ_BYTES: Sz = 32 * 1024 //< the most bytes one read returns
const MAX_LISTED: Sz = 500 //< the most names one listing returns
priv const MAX_TEXT_BYTES: I64 = 8I64 * 1024I64 * 1024I64 //<
    //< a larger file, or text view, is not read
    //< It bounds the memory one tool call takes; a regulation or a source file is far smaller.
priv const MAX_OFFICE_BYTES: I64 = 32I64 * 1024I64 * 1024I64 //<
    //< a larger Word or Excel file is not read
    //< Pictures make most of such a file's size, and only its text is unpacked
    //< (`ksagent/office/zip.kspl` caps that).
priv const HIT_TEXT_BYTES: Sz = 200 //< how much of a matching line a search hit shows
    //< The model reads the lines around a hit with `read`, so a hit only has to place them.

const ASK_SUFFIX: U8[] = ".ask.jsonl" //< how the name of the file a page asks in ends
    //< `ksagent watch` answers the questions in it. Only the page writes it.
const MAX_ASK_BYTES: Sz = 1024 * 1024 //< the largest ask file whose questions are answered
    //< It is read again for each question, and every 2 seconds while an answer is written. A MiB
    //< holds thousands of questions; past it, the person starts a new conversation.
const CHAT_SUFFIX: U8[] = ".chat.jsonl" //< how the name of a conversation's record ends
    //< `team.ask.jsonl` has `team.chat.jsonl`. Only ksagent writes it.
const LIVE_SUFFIX: U8[] = ".live.json" //< how the name of the answer being written ends
    //< `team.ask.jsonl` has `team.live.json`. Only ksagent writes it.
priv const OLD_SUFFIXES: U8[][_] = ::{ ".chat.ksmd", ".live.ksmd" } //<
    //< how the names of chat files of the old form end, which ksmd's editor showed
    //< Their answers are the model's own words, so `old_chat_file` finds them before any command.

enum Resolved //< a path the model gave, checked against the root
    ok(full: U8[], rel: U8[]) //< the path to open, and the path under the root (empty: the root)
    refused(why: U8[]) //< why it was refused, as one line the model can act on

fn resolve(root: U8[], given: U8[], arena: Arena$@): Resolved //<
    //< Checks a path the model gave and joins it to the root
    //< It refuses an absolute path, a `..` step, a link anywhere on the path (`fs.stays_under`) and
    //< a name that starts with a dot. **Windows answers to a short name** (`GIT~1` for `.git`), so
    //< each segment's long name is checked too (`fs.long_name`).
    $rel: = given.trim_spaces()
    for rel.starts_with("./")
        rel = rel.sub_from(2)
    for rel.len > 0 && rel[rel.len - 1] == '/'
        rel = rel.sub(0, rel.len - 1)
    if rel.len == 0 || rel.equals(".")
        return .ok(root, "")
    if !fs.stays_under(root, rel)
        return .refused("the path must stay inside the folder: give it relative to the folder, such \
            as rules/leave.md, with no `..` step and no link on the way")
    if hides_name(rel) || hides_long_name(root, rel, arena)
        return .refused("names that start with a dot are hidden, and cannot be read")
    if is_conversation(sys.get_file_name(rel)) ||
        is_conversation(last_long_name(root, rel, arena))
        return .refused("a conversation's file holds the model's own words or a person's questions, \
            which are no source")
    return .ok(fs.join(root, rel, arena), rel)

fn is_ask(name: U8[]): Bool //< whether a name is an ask file's, whose questions `watch` answers
    return name.ends_with(ASK_SUFFIX)

fn ask_too_large(ask_path: U8[]): Bool //< whether an ask file is past `MAX_ASK_BYTES`
    info: = fs.stat(ask_path) catch
        return false
    return info.size > I64::MAX_ASK_BYTES

fn is_conversation(name: U8[]): Bool //< whether a name is one of a conversation's three files
    //< Caution: **Never let one back an answer.** Its answers are the model's own words, so citing
    //< one would check a claim against itself, and a question is no evidence either. **ASCII case
    //< is ignored**, since Windows and macOS open `team.CHAT.jsonl` as `team.chat.jsonl`.
    return ends_ignoring_case(name, ASK_SUFFIX) || ends_ignoring_case(name, CHAT_SUFFIX) ||
        ends_ignoring_case(name, LIVE_SUFFIX)

fn chat_path(ask_path: U8[], arena: Arena$@): U8[] //< the conversation's record beside an ask file
    return arena.text().s(ask_path.strip_suffix(ASK_SUFFIX)).s(CHAT_SUFFIX).take()

fn live_path(ask_path: U8[], arena: Arena$@): U8[] //< the answer being written, beside an ask file
    return arena.text().s(ask_path.strip_suffix(ASK_SUFFIX)).s(LIVE_SUFFIX).take()

fn old_chat_file(root: U8[], arena: Arena$@): U8[] //<
    //< The first chat file of the old form under the root, or empty where none stands
    //< **No command starts beside one**: the tools do not hide it, so its answers would count as
    //< sources. The person deletes it, or asks its questions again on the chat page.
    found: = fs.walk_files(root, skip_dir, arena) catch
        return ""
    for path in found
        name: = sys.get_file_name(path)
        for suffix in OLD_SUFFIXES
            if ends_ignoring_case(name, suffix) && !is_hidden(name)
                return path
    return ""

fn is_hidden(name: U8[]): Bool //< whether a name is one the tools never show: it starts with a dot
    return name.len > 0 && name[0] == '.'

priv fn hides_name(rel: U8[]): Bool //< whether a segment of `rel` starts with a dot
    //< Caution: **Split at `\` too** (`sys.is_path_sep`): Windows opens `sub\.env` as `sub/.env`.
    $start: Sz = 0
    for start <= rel.len
        end: = sys.segment_end(rel, start)
        if is_hidden(rel.sub(start, end - start))
            return true
        start = end + 1
    return false

priv fn hides_long_name(root: U8[], rel: U8[], arena: Arena$@): Bool //<
    //< Whether a segment of `rel`, by the name the file system keeps, starts with a dot
    //< Caution: **Skip an empty segment** (`a//b`): Windows reads no long name for `a/`.
    //< Caution: **A long name that cannot be read hides what stands there.** Only where nothing
    //< stands is the path not hidden (a file `eval --out` makes), and nothing deeper can stand.
    $start: Sz = 0
    for start <= rel.len
        end: = sys.segment_end(rel, start)
        empty: = end == start
        start = end + 1
        if empty
            continue
        prefix: = fs.join(root, rel.sub(0, end), arena)
        long: = fs.long_name(prefix, arena) catch
            return fs.exists(prefix)
        if is_hidden(long)
            return true
    return false

priv fn last_long_name(root: U8[], rel: U8[], arena: Arena$@): U8[] //<
    //< The name the file system keeps for the last segment of `rel`; empty where nothing stands
    //< **Windows answers to a short name**, so `TEAM~1.JSO` can open `team.chat.jsonl`.
    return fs.long_name(fs.join(root, rel, arena), arena) catch
        fallback ""

fn skip_dir(name: U8[]): Bool //< the folders a walk does not enter: hidden ones, and `out`
    //< **`out` is skipped at any depth**: a checkout keeps build output there, often in each
    //< package, and its generated text would bury the real lines. A search given a path inside
    //< one still reads it, since the walk starts there.
    return is_hidden(name) || name.equals("out")

fn text_problem(bytes: U8[]): U8[] //< why the bytes are not text, or empty when they are
    if bytes.contains_nul()
        return "it holds a NUL byte, so it is not a text file"
    $i: Sz = 0
    for i < bytes.len
        if bytes[i] < 0x80U8
            i += 1
            continue
        n: = bytes.utf8_seq_len(i) catch
            return "it is not valid UTF-8 text"
        i += n
    return ""

priv enum Kind //< how a file is read, by the ending of its name
    text //< as it stands, when it is UTF-8 text
    word //< `.docx`, `.docm`: as its text view
    excel //< `.xlsx`, `.xlsm`: as its text view
    old_word //< `.doc`: refused, with what to do
    old_excel //< `.xls`: refused, with what to do

priv fn kind_of(name: U8[]): Kind //< how a file of that name is read
    if ends_ignoring_case(name, ".docx") || ends_ignoring_case(name, ".docm")
        return .word
    if ends_ignoring_case(name, ".xlsx") || ends_ignoring_case(name, ".xlsm")
        return .excel
    if ends_ignoring_case(name, ".doc")
        return .old_word
    if ends_ignoring_case(name, ".xls")
        return .old_excel
    return .text

priv fn ends_ignoring_case(name: U8[], ending: U8[]): Bool //< whether the name ends so, any case
    return name.len >= ending.len &&
        name.sub_from(name.len - ending.len).equals_ignore_case(ending)

fn read_text(full: U8[], arena: Arena$@): U8[]!U8[] //<
    //< The whole file as text, or its text view for a Word or Excel file; otherwise why not, as one
    //< line
    info: = fs.stat(full) catch
        throw "there is no such file"
    switch info.kind
    case .file {}
    case .dir
        throw "it is a folder: use list to see what it holds"
    case .other
        throw "it is not a regular file"
    if fs.is_link(full)
        throw "it is a link, and links are not followed"
    kind: = kind_of(sys.get_file_name(full))
    switch kind
    case .old_word
        throw "it is a Word file in the old format (.doc), which is not read: open it in Word and \
            save it as .docx"
    case .old_excel
        throw "it is an Excel file in the old format (.xls), which is not read: open it in Excel \
            and save it as .xlsx"
    default {}
    if kind == Kind.word || kind == Kind.excel
        if info.size > MAX_OFFICE_BYTES
            throw "it is larger than 32 MiB"
        return office_text(full, kind, arena)
    if info.size > MAX_TEXT_BYTES
        throw "it is larger than 8 MiB"
    body: = io.read_file(full, arena) catch
        throw "it cannot be read"
    problem: = text_problem(body)
    if problem.len > 0
        throw problem
    return body

priv fn office_text(full: U8[], kind: Kind, arena: Arena$@): U8[]!U8[] //<
    //< A Word or Excel file's text view, worked out in an arena of its own
    //< **Only the view is kept**: the file and its unpacked parts are many times its size, and a
    //< search reads every file in one call.
    defer work: = Arena(1024 * 1024)
    body: = io.read_file(full, work) catch
        throw "it cannot be read"
    view: =
        (word.text_of(body, Sz::MAX_TEXT_BYTES, work) if kind == Kind.word
        else excel.text_of(body, Sz::MAX_TEXT_BYTES, work)) catch why
        throw arena.dup_str(why)
    return arena.dup_str(view)

fn split_lines(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< The lines of a text, numbered from 1 by their index plus one
    //< The same split as the citation check's, so a line number means one line everywhere.
    return text.lines(arena)

// ==========================================
// The tools: list, search and read. Each returns the text the model reads, a refusal included.
// ==========================================

fn tool_list(root: U8[], given: U8[], arena: Arena$@): U8[] //< the entries of one folder
    //< A folder ends with `/`. Hidden names and links are left out, as `read` would refuse them.
    $full: U8[] = ""
    switch resolve(root, given, arena)
    case .ok(f, _rel)
        full = f
    case .refused(why)
        return arena.text().s("refused: ").s(why).take()
    if !fs.is_dir(full)
        return "refused: it is not a folder"
    names: = fs.read_dir(full, arena) catch
        return "refused: the folder cannot be read"
    sorted: = names.order_by(fn(a: U8[]@, b: U8[]@; ): I32 {
        return a.compare(b$);
    }, arena)
    out: = arena.text()
    $listed: Sz = 0
    for name in sorted
        path: = fs.join(full, name, arena)
        if is_hidden(name) || is_conversation(name) || fs.is_link(path)
            continue
        if listed == MAX_LISTED
            out.s("(the list stops at \{MAX_LISTED\} names)\n")
            break
        listed += 1
        out.s(name).s("/\n" if fs.is_dir(path) else "\n")
    if listed == 0
        return "(the folder is empty)"
    return out.take()

fn tool_search(root: U8[], text: U8[], given: U8[], arena: Arena$@): U8[] //<
    //< The lines that hold the words of `text`, as `path:line: text`, over every text file under
    //< `given`
    //< **A line matches when it holds every word, in any order**, ASCII case ignored. A word is
    //< found inside a longer one, so `quote` finds `quoted`. Japanese has no spaces, so a Japanese
    //< text is one word, found as it is written. With no line holding every word, the lines that
    //< hold the most of them come first, under a line that says so.
    $words: = words_of(text, arena)
    if words.len == 0
        return "refused: give some words to search for"
    $full: U8[] = ""
    $rel: U8[] = ""
    switch resolve(root, given, arena)
    case .ok(f, r)
        full = f
        rel = r
    case .refused(why)
        return arena.text().s("refused: ").s(why).take()
    $files: = List<|U8[]|>(arena)
    if fs.is_dir(full)
        files = fs.walk_files(full, skip_dir, arena) catch
            return "refused: the folder cannot be read"
    else
        files.push(full)
    // The lines that hold a word, with how many each holds; each list is cut where no more of it
    // could be shown. **Each file is read in memory of its own**, and only its hits are kept.
    $whole: = List<|Hit|>(arena)
    $partial: = List<|Hit|>(arena)
    for path in files
        name: = sys.get_file_name(path)
        if is_hidden(name) || is_conversation(name) || fs.is_link(path)
            continue
        defer one: = Arena(64 * 1024)
        body: = read_text(path, one) catch
            continue
        lines: = split_lines(body, one)
        $shown: U8[] = ""
        for i in Range.asc(lines.len)
            held: = words_held(lines.get(i), words.slice())
            if held == 0 || whole.len > MAX_HITS ||
                (held < words.len && partial.len == MAX_PARTIAL)
                continue
            if shown.len == 0
                shown = shown_path(rel, full, path, arena)
            kept: = arena.dup_str(cut(lines.get(i).trim_spaces(), HIT_TEXT_BYTES))
            hit: = Hit::{ .path = shown, .line = i + 1, .text = kept, .held = held }
            if held == words.len
                whole.push(hit)
            else
                partial.push(hit)
    if whole.len > 0
        return hit_lines(whole.slice(), arena)
    if partial.len == 0
        return "(no line holds any of those words)"
    out: = arena.text()
    out.s("(no line holds every word; these lines hold the most of them)\n")
    $shown_hits: Sz = 0
    $level: = words.len - 1
    for level > 0 && shown_hits < MAX_HITS
        for h in partial
            if h.held == level && shown_hits < MAX_HITS
                hit_line(h, out)
                shown_hits += 1
        level -= 1
    return out.take()

priv struct Hit //< one line a search found
    path: U8[] //< the file, as the model gives it back
    line: Sz //< its number, from 1
    text: U8[] //< the line, cut to `HIT_TEXT_BYTES`
    held: Sz //< how many of the search's words it holds

priv const MAX_PARTIAL: Sz = 10000 //< the most lines kept that hold only some of the words
    //< It bounds the memory a search of common words takes over a large folder.

priv fn hit_lines(hits: Hit[], arena: Arena$@): U8[] //<
    //< The lines that hold every word, at most `MAX_HITS`, and a last line where the list was cut
    out: = arena.text()
    for k in Range.asc(hits.len)
        if k == MAX_HITS
            out.s("(the list stops at \{MAX_HITS\} hits: add a word, or give a path)\n")
            break
        hit_line(hits[k], out)
    return out.take()

priv fn hit_line(h: Hit, out: str.Arena_text$@) //< writes one hit as `path:line: text`
    out.s(h.path).s(":\{h.line\}: ").s(h.text).c('\n')

fn words_of(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< The words of a search, lower case, each once
    //< Words are split at spaces and tabs, and at the ideographic space a Japanese keyboard types.
    $words: = List<|U8[]|>(arena)
    $start: Sz = 0
    $i: Sz = 0
    for i <= text.len
        gap: = space_at(text, i)
        if i == text.len || gap > 0
            if i > start
                w: = lower_ascii(text.sub(start, i - start), arena)
                if !holds(words.slice(), w)
                    words.push(w)
            i += 1 if gap == 0 else gap
            start = i
            continue
        i += 1
    return words

priv fn space_at(text: U8[], i: Sz): Sz //< how many bytes the space at `i` takes; 0 for none
    if i >= text.len
        return 0
    c: = text[i]
    if c == ' ' || c == '\t'
        return 1
    // U+3000, the ideographic space, is E3 80 80 in UTF-8.
    if c == 0xE3U8 && i + 2 < text.len && text[i + 1] == 0x80U8 && text[i + 2] == 0x80U8
        return 3
    return 0

priv fn holds(words: U8[][], w: U8[]): Bool //< whether the list already holds the word
    for x in words
        if x.equals(w)
            return true
    return false

priv fn words_held(line: U8[], words: U8[][]): Sz //< how many of the words the line holds
    $n: Sz = 0
    for w in words
        if holds_ignoring_case(line, w)
            n += 1
    return n

priv fn shown_path(rel: U8[], full: U8[], path: U8[], arena: Arena$@): U8[] //<
    //< A walked file's path as the model gives it back: under the root, with `/` between levels
    if path.equals(full)
        return rel
    tail: = path.sub_from(full.len + 1)
    return (tail if rel.len == 0
        else arena.text().s(rel).c('/').s(tail).take())

fn tool_read(root: U8[], given: U8[], from_line: I64, to_line: I64, arena: Arena$@): U8[] //<
    //< Lines `from_line`..`to_line` of one text file, each opening with its number
    //< At most `MAX_READ_LINES` lines or `MAX_READ_BYTES` bytes; the last line says where it
    //< stopped, so the model can read on.
    $full: U8[] = ""
    $rel: U8[] = ""
    switch resolve(root, given, arena)
    case .ok(f, r)
        full = f
        rel = r
    case .refused(why)
        return arena.text().s("refused: ").s(why).take()
    body: = read_text(full, arena) catch why
        return arena.text().s("refused: ").s(why).take()
    lines: = split_lines(body, arena)
    n: = I64::lines.len
    first: = 1I64 if from_line < 1I64 else from_line
    if first > n
        return arena.text().s("refused: \{rel\} has \{n\} lines").take()
    last: = n if to_line < first || to_line > n else to_line
    out: = arena.text()
    out.s(rel).s(" (lines \{first\}-\{last\} of \{n\})\n")
    $bytes: Sz = 0
    $k: = first
    for k <= last
        line: = lines.get(Sz::(k - 1I64))
        if k - first == I64::MAX_READ_LINES || bytes + line.len > MAX_READ_BYTES
            out
                .s("(stopped before line \{k\}: one read returns at most \{MAX_READ_LINES\} lines \
                    or 32 KiB; read again from line \{k\})\n")
            break
        bytes += line.len
        out.s("\{k\}: ").s(line).c('\n')
        k += 1I64
    return out.take()

// ==========================================
// Text helpers
// ==========================================

fn lower_ascii(text: U8[], arena: Arena$@): U8[] //< a copy with ASCII letters made lower case
    out: = arena.text()
    for c in text
        out.c(c.to_lower())
    return out.take()

priv fn holds_ignoring_case(line: U8[], lower_needle: U8[]): Bool //<
    //< Whether the line holds the needle, ASCII case ignored; the needle is already lower case
    if lower_needle.len > line.len
        return false
    for start in Range.asc(line.len - lower_needle.len + 1)
        $same: = true
        for j in Range.asc(lower_needle.len)
            if line[start + j].to_lower() != lower_needle[j]
                same = false
                break
        if same
            return true
    return false

fn cut(text: U8[], max: Sz): U8[] //< at most `max` bytes, cut at a character's start
    if text.len <= max
        return text
    $end: = max
    for end > 0 && (text[end] & 0xC0U8) == 0x80U8
        end -= 1
    return text.sub(0, end)

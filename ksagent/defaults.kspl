//< Where ksagent finds its model server, and how long a conversation that server must hold
//< **They are public**, so a program that starts a model server for ksagent can start it where
//< ksagent asks, with the key ksagent sends and the length ksagent's requests are sized to fit.

// **Programs outside this package read these, so [I0402] is off here.**
##lint(I0402 = off)

pub const DEFAULT_URL: U8[] = "http://127.0.0.1:8081" //< where ksagent asks unless told otherwise
pub const API_KEY_ENV: U8[] = "KSAGENT_API_KEY" //< the environment variable an API key comes from
    //< Caution: **Never an option.** The command line shows in the process list, to anyone on the
    //< machine.
pub const CONTEXT_TOKENS: Sz = 32768 //< the conversation's length in tokens a server must hold
    //< `MAX_REQUEST_BYTES` in `ksagent/agent.kspl` is sized to fit it.

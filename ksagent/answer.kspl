//< An answer, its checked sources, and how it is written out
//< **Every cited source is checked against the file** (`check_source`): its quote must stand in
//< the lines it names. A source that fails is removed and counted, never shown as evidence.
//< The fixed lines ksagent adds itself come in the question's language (`Lang`).
import "ksagent/files"
import "ksagent/office/excel"
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt

const NOT_FOUND: U8[] = "NOT_FOUND" //< the text the model gives `answer` when the files lack one
    //< **A marker, not a sentence**: a small model copies one word reliably. ksagent writes the
    //< sentence itself, in the question's language (`not_found_line`).

const MAX_CITED_LINES: I64 = 50I64 //< the widest range one source may cite
    //< A wider range no longer points at the evidence: any quote stands somewhere in a long range,
    //< and an evaluation would pass an answer that cites a whole file.

const MIN_QUOTE_CHARS: Sz = 8 //< the fewest characters a quote may hold
    //< A shorter quote no longer shows where the answer comes from: one word, or one Japanese
    //< character, stands in almost any range. Characters are counted, not bytes, so a Japanese
    //< quote needs as many as an English one.

enum Lang //< the language of a question, and of the lines ksagent adds to its answer
    en
    ja

impl Lang
    fn of(text: U8[]): Lang //< `ja` when the text holds kana or kanji, else `en`
        $i: Sz = 0
        for i < text.len
            step: = text.utf8_seq_len(i) catch
                i += 1
                continue
            if step == 3 && is_japanese(text, i)
                return .ja
            i += step
        return .en

    fn not_found_line(r: Self): U8[] //< what a not-found answer says
        switch r
        case .ja
            return "このフォルダーのファイルには、この質問の答えが見つかりませんでした。"
        case .en
            return "The files in this folder do not hold the answer to this question."

    fn unverified_line(r: Self): U8[] //< the mark on an answer that no checked source backs
        switch r
        case .ja
            return "未確認: 確認できた出典がありません。ファイルで確かめてください。"
        case .en
            return "Unverified: no cited source passed the check. Confirm it in the files."

    fn removed_line(r: Self, count: Sz, arena: Arena$@): U8[] //< how many sources the check removed
        switch r
        case .ja
            return arena.text()
                .s("示された行に引用が見つからない出典を \{count\} 件取り除きました。").take()
        case .en
            return arena.text()
                .s("Removed \{count\} cited source(s): the quote does not stand at the lines given.")
                .take()

    fn sources_word(r: Self): U8[] //< the word that opens the list of sources
        switch r
        case .ja
            return "出典:"
        case .en
            return "Sources:"

priv fn is_japanese(text: U8[], at: Sz): Bool //<
    //< Whether the three-byte character at `at` is kana, a kanji, or a full-width form
    lead: = I32::text[at]
    cp: =
        ((lead & 0x0F) << 12) | ((I32::text[at + 1] & 0x3F) << 6) | (I32::text[at + 2] & 0x3F)
    return (cp >= 0x3040 && cp <= 0x30FF) || (cp >= 0x4E00 && cp <= 0x9FFF) ||
        (cp >= 0xFF00 && cp <= 0xFFEF)

struct Turn //< one earlier question and its answer, sent as the conversation so far
    question: U8[]
    answer: U8[]

struct Source //< one place the answer cites
    path: U8[] //< the file, under the root
    from_line: I64 //< the first line cited, counting from 1
    to_line: I64 //< the last line cited
    quote: U8[] //< the words cited, as they stand in those lines
    rows: Sheet_rows //< for an Excel file, the sheet and rows those lines name; set by the check

struct Sheet_rows //< the place an Excel source stands, as Excel shows it
    //< **A line number counts the view's lines, which Excel does not show**, and an empty row or
    //< a second sheet puts it apart from the row. So an Excel source is shown by its sheet and
    //< rows.
    sheet: U8[] //< the first cited line's sheet; empty for a file that is not Excel
    from_row: I64
    to_sheet: U8[] //< the last cited line's sheet
    to_row: I64

const NO_ROWS: Sheet_rows = ::{ .sheet = "", .from_row = 0I64, .to_sheet = "", .to_row = 0I64 } //<
    //< the place of a source in a file that is not Excel

enum Outcome //< how the work on one question ended
    answered //< the model gave an answer: through `answer`, or as plain text
    not_found //< the model said the files do not hold the answer
    stopped(why: U8[]) //< a cap was reached first; `why` names the cap
    failed(why: U8[]) //< the model server could not be reached, or failed

struct Answer //< what one question got
    outcome: Outcome
    lang: Lang //< the question's language, for the lines ksagent adds
    text: U8[] //< the model's answer, as it wrote it; empty unless `answered`
    sources: List<|Source|> //< the sources that passed the check
    removed: List<|U8[]|> //< one line for each source that failed the check, saying why

impl Answer
    fn ended(outcome: Outcome, lang: Lang, arena: Arena$@): Answer //< an answer with no text
        return Answer::{ .outcome = outcome, .lang = lang, .text = "",
            .sources = List<|Source|>(arena), .removed = List<|U8[]|>(arena) }

    fn is_answer(r: Self@): Bool //< whether the work ended in an answer: the model's, or not found
        switch r.outcome
        case .answered
            return true
        case .not_found
            return true
        default
            return false

    fn is_unverified(r: Self@): Bool //< whether it is an answer that no checked source backs
        switch r.outcome
        case .answered
            return r.sources.len == 0
        default
            return false

fn finish(folder: files.Folder, text: U8[], given: List<|Source|>@, lang: Lang, arena: Arena$@):
    Answer //<
        //< Turns the model's final answer into an `Answer`, checking each source it cites
        //< The not-found marker ends as `not_found`, whatever sources come with it.
    if text.trim_spaces().equals_ignore_case(NOT_FOUND)
        return Answer.ended(.not_found, lang, arena)
    $a: = Answer.ended(.answered, lang, arena)
    a.text = text.trim_spaces()
    for i in Range.asc(given.len)
        s: = given.get(i)
        $checked: = s
        // **Each check reads its file in memory of its own**, so many sources do not add up.
        defer one: = Arena(64 * 1024)
        why: = check_source(folder, s, checked@, one)
        if why.len == 0
            checked.path = arena.dup_str(checked.path)
            checked.rows.sheet = arena.dup_str(checked.rows.sheet)
            checked.rows.to_sheet = arena.dup_str(checked.rows.to_sheet)
            a.sources.push(checked)
        else
            a.removed
                .push(arena.text().s(s.path).s(" ").s(span_words(s, lang, arena)).s(": ").s(why)
                .take())
    return a

fn check_source(folder: files.Folder, source: Source, out: Source$@, arena: Arena$@): U8[] //<
    //< Why the source fails the check, or empty when its quote stands in the lines it names
    //< **The quote and the lines are compared with every space left out** (`without_spaces`), so
    //< a line break, an indent or a full-width space in either does not matter. A Japanese file
    //< often breaks a sentence across lines with no space, and a model copies it with none.
    //< `out` gets the path as the root holds it, and an Excel file's sheet and rows. Caution:
    //< **This shows that the words stand there, not that they back the answer.**
    if source.from_line < 1I64 || source.to_line < source.from_line
        return "the lines are not a range from a first line to a last one"
    if source.to_line - source.from_line + 1I64 > MAX_CITED_LINES
        return arena.text().s("the range is wider than \{MAX_CITED_LINES\} lines").take()
    at: = files.resolve(folder, source.path, arena) catch why
        return why
    out.path = at.rel
    body: = files.read_text(at.full, arena) catch why
        return why
    lines: = files.split_lines(body, arena)
    if source.to_line > I64::lines.len
        return arena.text().s("the file has only \{lines.len\} lines").take()
    // **An Excel line is compared by its cells**: each line starts with its sheet's name, so a
    // quote of the name alone stood in every line. A head copied into the quote is taken out too.
    sheet: = files.is_excel(at.full)
    cited: = arena.text()
    $heads: = List<|U8[]|>(arena)
    for k in Range.asc(Sz::(source.to_line - source.from_line + 1I64))
        line: = lines.get(Sz::(source.from_line - 1I64) + k)
        head: = excel.head_of(line) if sheet else ""
        cited.s(line.sub_from(head.len))
        if head.len > 0
            heads.push(without_spaces(head, arena))
    quote: = without_heads(without_spaces(source.quote, arena), heads.slice(), arena)
    // **The characters counted are those compared**: a quote of full-width spaces alone counted
    // 8, then compared as empty, and an empty quote stands in every range.
    if char_count(quote) < MIN_QUOTE_CHARS
        return arena.text().s("the quote is shorter than \{MIN_QUOTE_CHARS\} characters").take()
    if without_spaces(cited.take(), arena).find_str(quote).is_none()
        return "the quote does not stand in those lines"
    out.rows = NO_ROWS
    if sheet
        if first: = excel.place_of(lines.get(Sz::(source.from_line - 1I64)))
            if last: = excel.place_of(lines.get(Sz::(source.to_line - 1I64)))
                out.rows = Sheet_rows::{ .sheet = arena.dup_str(first.sheet),
                    .from_row = first.row, .to_sheet = arena.dup_str(last.sheet),
                    .to_row = last.row }
    return ""

priv fn without_heads(quote: U8[], heads: U8[][], arena: Arena$@): U8[] //<
    //< The quote with each of the cited lines' heads taken out, both without spaces
    //< A quote across rows may hold a head in its middle. No head starts another, since a sheet's
    //< name holds no `:`, so the first head that matches is the only one.
    out: = arena.text()
    $i: Sz = 0
    for i < quote.len
        $n: Sz = 0
        for h in heads
            if quote.starts_with(h, i)
                n = h.len
                break
        if n == 0
            out.c(quote[i])
        i += 1 if n == 0 else n
    return out.take()

priv fn char_count(text: U8[]): Sz //< how many UTF-8 characters the text holds
    //< Each byte that does not continue a character starts one.
    $n: Sz = 0
    for c in text
        if (c & 0xC0U8) != 0x80U8
            n += 1
    return n

fn without_spaces(text: U8[], arena: Arena$@): U8[] //< the text with every space left out
    //< Spaces, tabs and line breaks, and the Unicode spaces (`space_len`): a file can hold a
    //< full-width or a no-break space where the model writes an ASCII one, or none.
    out: = arena.text()
    $i: Sz = 0
    for i < text.len
        n: = space_len(text, i)
        if n == 0
            out.c(text[i])
        i += 1 if n == 0 else n
    return out.take()

priv fn space_len(text: U8[], i: Sz): Sz //< how many bytes the space at `i` takes; 0 for none
    //< ASCII's, and every other character Unicode counts as white space: U+0085, U+00A0, U+1680,
    //< U+2000 to U+200A, U+2028, U+2029, U+202F, U+205F and U+3000, the full-width space.
    c: = text[i]
    if c.is_space() || c == 0x0BU8 || c == 0x0CU8
        return 1
    if c == 0xC2U8 && i + 1 < text.len && (text[i + 1] == 0x85U8 || text[i + 1] == 0xA0U8)
        return 2
    if i + 2 >= text.len
        return 0
    b: = text[i + 1]
    d: = text[i + 2]
    if (c == 0xE1U8 && b == 0x9AU8 && d == 0x80U8) || (c == 0xE3U8 && b == 0x80U8 && d == 0x80U8)
        return 3
    if c == 0xE2U8 && b == 0x80U8 &&
        ((d >= 0x80U8 && d <= 0x8AU8) || d == 0xA8U8 || d == 0xA9U8 || d == 0xAFU8)
        return 3
    if c == 0xE2U8 && b == 0x81U8 && d == 0x9FU8
        return 3
    return 0

fn collapse_spaces(text: U8[], arena: Arena$@): U8[] //<
    //< The text with each run of spaces, tabs and line breaks made one space, and none at the ends
    out: = arena.text()
    $pending: = false
    $any: = false
    for c in text
        if c.is_space()
            pending = any
            continue
        if pending
            out.c(' ')
            pending = false
        out.c(c)
        any = true
    return out.take()

// ==========================================
// The lines ksagent adds, in the question's language
// ==========================================

fn span_words(source: Source, lang: Lang, arena: Arena$@): U8[] //<
    //< the lines a source cites, as words
    //< One line is named alone: `line 3`, not `lines 3–3`. An Excel source names its sheet and
    //< rows instead (`rows_words`).
    if source.rows.sheet.len > 0
        return rows_words(source.rows, lang, arena)
    span: = arena.text()
    one: = source.from_line == source.to_line
    switch lang
    case .ja
        span.s("\{source.from_line\}")
        if !one
            span.s("–\{source.to_line\}")
        span.s("行目")
    case .en
        span.s("line " if one else "lines ").s("\{source.from_line\}")
        if !one
            span.s("–\{source.to_line\}")
    return span.take()

priv fn rows_words(rows: Sheet_rows, lang: Lang, arena: Arena$@): U8[] //<
    //< An Excel source's place as words: `sheet 規程一覧, rows 9–12`, `シート「規程一覧」9–12行目`
    //< A range over two sheets names both: `sheet A, row 9 to sheet B, row 2`.
    out: = arena.text()
    one: = rows.sheet.equals(rows.to_sheet)
    switch lang
    case .ja
        out.s("シート「").s(rows.sheet).s("」\{rows.from_row\}")
        if !one
            out.s("行目〜シート「").s(rows.to_sheet).s("」\{rows.to_row\}")
        else if rows.to_row != rows.from_row
            out.s("–\{rows.to_row\}")
        out.s("行目")
    case .en
        out.s("sheet ").s(rows.sheet)
        if !one
            out.s(", row \{rows.from_row\} to sheet ").s(rows.to_sheet).s(", row \{rows.to_row\}")
        else if rows.to_row != rows.from_row
            out.s(", rows \{rows.from_row\}–\{rows.to_row\}")
        else
            out.s(", row \{rows.from_row\}")
    return out.take()

fn ended_line(answer: Answer@, arena: Arena$@): U8[] //<
    //< The one line an answer that did not finish says, or empty when it finished
    switch answer.outcome
    case .stopped(why)
        return arena.text()
            .s(("回答の途中で止まりました: " if answer.lang == Lang.ja
            else "Stopped without an answer: ")).s(why).take()
    case .failed(why)
        return arena.text()
            .s("回答できませんでした: " if answer.lang == Lang.ja else "No answer: ").s(why).take()
    default
        return ""

// ==========================================
// Writing an answer out
// ==========================================

fn write_console(answer: Answer@, out: Writer, arena: Arena$@) //<
    //< Writes the answer for a terminal: the text, then each checked source with its quote
    //< Each removed source is named with the reason, so whoever tries a model sees what it got
    //< wrong. Text from the model or a file goes through `write_shown`.
    switch answer.outcome
    case .answered
        write_shown(out, answer.text)
        out.c('\n')
    case .not_found
        out.s(answer.lang.not_found_line()).c('\n')
    default
        write_shown(out, ended_line(answer, arena))
        out.c('\n')
        return
    if answer.sources.len > 0
        out.c('\n').s(answer.lang.sources_word()).c('\n')
    for i in Range.asc(answer.sources.len)
        s: = answer.sources.get(i)
        out.s("- ")
        write_shown(out, s.path)
        // **The words name the sheet**, which is the file's text and can hold a control.
        out.c(' ')
        write_shown(out, span_words(s, answer.lang, arena))
        out.s("\n  > ")
        write_shown(out, collapse_spaces(s.quote, arena))
        out.c('\n')
    if answer.removed.len > 0
        out.c('\n').s(answer.lang.removed_line(answer.removed.len, arena)).c('\n')
        for i in Range.asc(answer.removed.len)
            out.s("  (")
            write_shown(out, answer.removed.get(i))
            out.s(")\n")
    if answer.is_unverified()
        out.c('\n').s(answer.lang.unverified_line()).c('\n')

fn write_shown(out: Writer, text: U8[]) //<
    //< Writes text for a terminal, each control character but a line break and a tab made `�`
    //< **The model, a file or a server can hold an escape sequence**, which a terminal would obey:
    //< set its title, clear the screen, or move the cursor over what stands. C1 controls (U+0080
    //< to U+009F) count too, since some terminals read U+009B as an escape.
    $from: Sz = 0
    $i: Sz = 0
    for i < text.len
        c: = text[i]
        n: Sz =
            (2
            if c == 0xC2U8 && i + 1 < text.len && text[i + 1] < 0xA0U8 && text[i + 1] >= 0x80U8
            else (1 if (c < 0x20U8 && c != '\n' && c != '\t') || c == 0x7FU8 else 0))
        if n == 0
            i += 1
            continue
        out.s(text.sub(from, i - from)).s("�")
        i += n
        from = i
    out.s(text.sub(from, text.len - from))

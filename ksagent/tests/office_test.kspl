//< Word and Excel files: their text views, and the tools and the citation check on them
//< The files in `office_data/` come from python-docx and openpyxl, with what those cannot write
//< added by hand (`make_office_fixtures.py` beside this file says what). The tests need no Python.
import "ksagent/answer" + { Answer, Source }
import "ksagent/chat"
import "ksagent/files"
import "ksagent/office/cell_format"
import "ksagent/office/excel"
import "ksagent/office/numbering"
import "ksagent/office/word"
import "ksagent/tests/office_files"
import "ksagent/tests/stub"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

embed "ksagent/tests/office_data/rules.docx" as rules_docx
embed "ksagent/tests/office_data/leave.xlsx" as leave_xlsx

const VIEW_CAP: Sz = 8 * 1024 * 1024 //< the cap the tools give a view
priv const ROOM: Sz = 64 * 1024 //< the request's room a tool gets when a test calls it alone

priv const RULES_VIEW: U8[] =
    """
# 就業規則
## 第1章 総則
第1条 この規則は、従業員の労働条件を定める。
Overtime work requires prior approval by the manager.
## 第2章 休暇
第2条 年次有給休暇は、次のとおり付与する。
（１） 入社6か月後に10日を付与する
（２） 以後1年ごとに1日を加算する[^1]
① 出勤率が8割以上であること
第3条 特別休暇は、5日とする。
・ 休暇の申請は、所属長へ行う。
勤続年数 | 付与日数 | 備考
6か月 | 10日 | 最大20日まで
1年6か月 | 11日 | 最大20日まで
※ 出勤率8割以上が条件 | 最大20日まで
相談は次の窓口へ。
相談窓口：人事部（内線1234）
附則　この規則は、2024年4月1日から施行する。
[^1]: 出勤率は、全労働日に対する出勤日の割合をいう。
"""

priv const LEAVE_VIEW: U8[] =
    """
規程一覧!1: 項目 | 内容 | 施行日 | 日数
規程一覧!2: 有給休暇 | 入社6か月後に付与 | 2024-04-01 | 10
規程一覧!3: 特別休暇 | 慶弔時 | 2025-10-01 | 5
規程一覧!4: 休職 | 私傷病 |  | 90
規程一覧!5: 休職 | 家族の介護 |  | 93
規程一覧!6: 合計 |  |  | 198
規程一覧!7: 割増賃金率 | 25%
規程一覧!9: 始業時刻 | 09:00 | TRUE | 1234.5
規程一覧!10: インライン文字列
規程一覧!11: 社内規程
"""

fn test_a_word_file_reads_as_its_paragraphs()
    verdict.start("[ksagent] a Word file is read as one paragraph a line, as its reader sees it")
    defer arena: = Arena(1024 * 1024)
    view: = word.text_of(rules_docx, VIEW_CAP, arena) catch why
        verdict.check("the Word file is read", false, why)
        return
    verdict.check("the view is the paragraphs in order: numbers, a table, a text box, a footnote",
        view.equals(RULES_VIEW), view)
    verdict.check("deleted text, comments, the header and the text box's second copy are left out",
        view.find_str("3日").is_none() && view.find_str("要確認").is_none() &&
        view.find_str("社外秘").is_none() && view.count_str("相談窓口") == 1, view)

fn test_an_excel_file_reads_as_its_rows()
    verdict
        .start("[ksagent] an Excel file is read as one row a line, each naming its sheet and row")
    defer arena: = Arena(1024 * 1024)
    view: = excel.text_of(leave_xlsx, VIEW_CAP, arena) catch why
        verdict.check("the Excel file is read", false, why)
        return
    verdict.check("the view shows dates, a formula's value, a percentage, merged and inline cells",
        view.equals(LEAVE_VIEW), view)
    verdict.check("the hidden sheet and the furigana are left out",
        view.find_str("旧規程").is_none() && view.find_str("15日").is_none() &&
        view.find_str("シャナイ").is_none(), view)

fn test_an_excel_escape_shows_its_character()
    verdict.start("[ksagent] an Excel cell's `_xHHHH_` shows the character it stands for")
    // **Excel writes a carriage return or a tab in a cell as `_x000D_` or `_x0009_`**, and an
    // underscore that would read as such as `_x005F_`. The person sees the character.
    defer arena: = Arena(256 * 1024)
    strings: = arena.text().s("<sst><si><t>Line1_x000D_\nLine2</t></si>")
        .s("<si><t>Tab_x0009_here</t></si>")
        .s("<si><r><t>a_x005F_</t></r><r><t>x0041_b</t></r></si>")
        .s("<si><t>_x00G1_ and _x0041</t></si></sst>").take()
    sheet: =
        "<worksheet><sheetData><row r=\"1\"><c r=\"A1\" t=\"s\"><v>0</v></c><c r=\"B1\" \
            t=\"s\"><v>1</v></c><c r=\"C1\" t=\"s\"><v>2</v></c><c r=\"D1\" \
            t=\"inlineStr\"><is><t>x_x0041_y_x00e9_</t></is></c><c r=\"E1\" \
            t=\"str\"><f>A1</f><v>sum_x0020_text</v></c><c r=\"F1\" \
            t=\"s\"><v>3</v></c></row></sheetData></worksheet>"
    view: =
        excel.text_of(office_files.xlsx_of(sheet, strings, "", arena), VIEW_CAP, arena) catch why
            fallback why
    want: = "S!1: Line1 Line2 | Tab here | a_x0041_b | xAyé | sum text | _x00G1_ and _x0041\n"
    verdict.check("shared, inline and formula strings are decoded; `_x005F_` keeps what follows",
        view.equals(want), view)

fn test_an_excel_formula_shows_its_value_or_its_text()
    verdict.start("[ksagent] an Excel formula shows its computed value, an empty one included")
    // **Excel stores a formula whose answer is the empty text as kind `str` with an empty value.**
    // A library that computes nothing writes no kind, and then the formula's text is all there is.
    defer arena: = Arena(256 * 1024)
    sheet: =
        "<worksheet><sheetData><row r=\"1\"><c r=\"A1\" \
            t=\"str\"><f>IF(D1=\"\",\"\",D1)</f><v></v></c><c \
            r=\"B1\"><f>SUM(D2:D5)</f><v></v></c><c r=\"C1\" \
            t=\"str\"><f>D1&amp;\"x\"</f><v>x</v></c></row><row r=\"2\"><c r=\"A2\" \
            t=\"str\"><f>IF(D2=\"\",\"\",D2)</f><v/></c></row></sheetData></worksheet>"
    view: =
        excel.text_of(office_files.xlsx_of(sheet, "", "", arena), VIEW_CAP, arena) catch why
            fallback why
    verdict.check("an empty computed text shows nothing; an uncomputed formula shows its text",
        view.equals("S!1: =SUM(D2:D5) | x\n"), view)

fn test_word_leaves_out_furigana_and_text_a_style_hides()
    verdict.start("[ksagent] Word's furigana, and text a style hides, are left out of the view")
    defer arena: = Arena(256 * 1024)
    styles: =
        "<styles><style type=\"character\" styleId=\"Secret\"><name \
            val=\"Secret\"/><rPr><vanish/></rPr></style><style type=\"character\" \
            styleId=\"Child\"><basedOn val=\"Secret\"/></style><style type=\"paragraph\" \
            styleId=\"Note\"><name val=\"Note\"/><rPr><vanish/></rPr></style></styles>"
    doc: = arena.text().s("<document><body>")
        .s("<p><r><t xml:space=\"preserve\">Ruby: </t></r><ruby><rubyPr/>")
        .s("<rt><r><t>しゃない</t></r></rt><rubyBase><r><t>社内</t></r></rubyBase></ruby>")
        .s("<r><t>規程</t></r></p>").s("<p><r><t xml:space=\"preserve\">Hidden by style: </t></r>")
        .s("<r><rPr><rStyle val=\"Child\"/></rPr><t>SECRET</t></r><r><t>end</t></r></p>")
        .s("<p><r><rPr><rStyle val=\"Secret\"/><vanish val=\"0\"/></rPr>")
        .s("<t>Shown over the style</t></r></p>")
        .s("<p><pPr><pStyle val=\"Note\"/></pPr><r><t>HIDDEN NOTE</t></r>")
        .s("<r><rPr><vanish val=\"false\"/></rPr><t>Shown in a hidden style</t></r></p>")
        .s("</body></document>").take()
    view: =
        word.text_of(office_files.docx_styled(doc, styles, arena), VIEW_CAP, arena) catch why
            fallback why
    want: =
        "Ruby: 社内規程\nHidden by style: end\nShown over the style\nShown in a hidden style\n"
    verdict.check("the base text without its furigana, and no text a style hides",
        view.equals(want), view)

fn test_a_word_table_row_in_a_content_control_is_read()
    verdict.start("[ksagent] a Word table's row or cell inside a content control keeps its line")
    // **A form's repeating rows stand in a content control** (`w:sdt` around `w:tr`), so the row is
    // two levels below its table.
    defer arena: = Arena(256 * 1024)
    row: = "<tr><tc><p><r><t>A2</t></r></p></tc><tc><p><r><t>B2</t></r></p></tc></tr>"
    inner: =
        "<tbl><sdt><sdtContent><tr><tc><p><r><t>in</t></r></p></tc></tr></sdtContent></sdt></tbl>"
    doc: = arena.text().s("<document><body><tbl>")
        .s("<tr><tc><p><r><t>A1</t></r></p></tc><tc><p><r><t>B1</t></r></p></tc></tr>")
        .s("<sdt><sdtPr/><sdtContent>").s(row).s("</sdtContent></sdt>")
        .s("<tr><tc><p><r><t>A3</t></r></p></tc><sdt><sdtContent><tc><p><r><t>B3</t></r></p>")
        .s(inner).s("</tc></sdtContent></sdt></tr>")
        .s("</tbl><p><r><t>after</t></r></p></body></document>").take()
    view: =
        word.text_of(office_files.docx_of(doc, "", arena), VIEW_CAP, arena) catch why
            fallback why
    verdict.check("each row has its line, the one in a content control too",
        view.equals("A1 | B1\nA2 | B2\nA3 | B3 in\nafter\n"), view)

fn test_a_word_symbol_shows_its_character()
    verdict.start("[ksagent] a symbol Word inserts from a symbol font shows as its character")
    // **Word writes a symbol from Insert > Symbol as `w:sym`**: a font, and the code of the
    // character in it. Forms take their check boxes from Wingdings.
    defer arena: = Arena(256 * 1024)
    doc: =
        "<document><body><p><r><t xml:space=\"preserve\">Sym </t></r><r><sym font=\"Wingdings\" \
            char=\"F0FE\"/></r><r><t xml:space=\"preserve\"> done </t></r><r><sym font=\"Wingdings \
            2\" char=\"54\"/><sym font=\"wingdings\" char=\"f0a8\"/></r><r><t \
            xml:space=\"preserve\"> 5</t></r><r><sym font=\"Symbol\" \
            char=\"F0B1\"/></r><r><t>1</t></r><r><sym font=\"Wingdings\" char=\"F04A\"/><sym \
            font=\"MS Mincho\" char=\"2192\"/><sym font=\"MS Mincho\" \
            char=\"F001\"/></r></p></body></document>"
    view: =
        word.text_of(office_files.docx_of(doc, "", arena), VIEW_CAP, arena) catch why
            fallback why
    verdict.check("a check box, a mark, and a plain font's character; an unknown symbol left out",
        view.equals("Sym ☑ done ☒☐ 5±1→\n"), view)

fn test_list_numbers_take_each_format()
    verdict.start("[ksagent] a list number is written in its format: kanji, kana, letters, roman")
    defer arena: = Arena(64 * 1024)
    cases: = U8[][]::{ "japaneseCounting:1:一", "japaneseCounting:10:十",
        "japaneseCounting:21:二十一", "japaneseCounting:105:百五",
        "japaneseCounting:2024:二千二十四", "japaneseDigitalTenThousand:2024:二〇二四",
        "aiueoFullWidth:2:イ", "iroha:3:ハ", "decimalFullWidth:12:１２",
        "decimalEnclosedCircle:3:③", "decimalEnclosedCircle:21:21", "upperLetter:27:AA",
        "lowerRoman:1994:mcmxciv", "decimalZero:7:07", "ideographTraditional:2:乙",
        "someFutureFormat:5:5" }
    for c in cases
        parts: = c.split(':', arena)
        out: = arena.text()
        numbering.write_number(out, I32::number(parts.get(1)), parts.get(0))
        got: = out.take()
        verdict.check(c, got.equals(parts.get(2)), got)

fn test_a_cell_number_is_shown_as_its_format_shows_it()
    verdict.start("[ksagent] a cell's number is shown as a date, a time, a percentage or digits")
    defer arena: = Arena(64 * 1024)
    date: = cell_format.of_code("yyyy\"年\"m\"月\"d\"日\"")
    era: = cell_format.of_code("[$-411]ggge\"年\"m\"月\"d\"日\"")
    time: = cell_format.of_code("h:mm")
    hours: = cell_format.of_code("[h]:mm:ss")
    percent: = cell_format.of_code("0.0%")
    money: = cell_format.of_code("#,##0\"円\";[Red]-#,##0\"円\"")
    general: = cell_format.of_code("General")
    results: = U8[][]::{ cell_format.show("45383", date, false, arena),
        cell_format.show("45383", era, false, arena),
        cell_format.show("60", date, false, arena),
        cell_format.show("59", date, false, arena),
        cell_format.show("61", date, false, arena), cell_format.show("0", date, true, arena),
        cell_format.show("0.375", time, false, arena),
        cell_format.show("45383.75", cell_format.built_in(22), false, arena),
        cell_format.show("1.5", hours, false, arena),
        cell_format.show("0.255", percent, false, arena),
        cell_format.show("300000", money, false, arena),
        cell_format.show("0.30000000000000004", general, false, arena),
        cell_format.show("1.5E-3", general, false, arena),
        cell_format.show("123456789012345678", general, false, arena),
        cell_format.show("-12.50", general, false, arena),
        cell_format.show("99999999999999999", general, false, arena),
        cell_format.show("abc", date, false, arena) }
    expected: = U8[][]::{ "2024-04-01", "2024-04-01", "1900-02-29", "1900-02-28", "1900-03-01",
        "1904-01-01", "09:00", "2024-04-01 18:00", "36:00:00", "25.5%", "300000", "0.3", "0.0015",
        "1.23456789012346E+17", "-12.5", "1E+17", "abc" }
    for i in Range.asc(expected.len)
        verdict.check(arena.text().s("shows ").s(expected[i]).take(),
            results[i].equals(expected[i]), results[i])
    // **A colour's name is no elapsed time**, though `[Magenta]` opens with `m` as `[mm]` does.
    for code in U8[][]::{ "[Magenta]0.0", "[magenta]#,##0.0", "[Red]0.0" }
        got: = cell_format.show("12.5", cell_format.of_code(code), false, arena)
        verdict.check(arena.text().s(code).s(" shows 12.5 as a number").take(),
            got.equals("12.5"), got)
    minutes: = cell_format.show("1.5", cell_format.of_code("[mm]:ss"), false, arena)
    verdict.check("[mm]:ss still counts elapsed time", minutes.equals("36:00:00"), minutes)
    // **A Japanese Excel names General `G/標準`**, and its `G` is no era letter.
    for code in U8[][]::{ "G/標準", "G/標準\"個\"", "g/標準;-G/標準" }
        got: = cell_format.show("12", cell_format.of_code(code), false, arena)
        verdict.check(arena.text().s(code).s(" shows 12 as a number").take(), got.equals("12"), got)

priv fn number(text: U8[]): I64 //< a test case's number
    $v: I64 = 0
    for c in text
        v = v * 10 + I64::(c - '0')
        if v > 1000000I64
            return v
    return v

// ==========================================
// Through the tools: search, read, and the citation check
// ==========================================

priv fn office_folder(work: U8[], arena: Arena$@): U8[] //<
    //< A fresh folder holding the two files, an old-format one, a damaged one and a locked one
    root: = fs.mkdir_unique(work, "office-", arena) catch panic("the test folder can be made")
    rels: = U8[][]::{ "規程/rules.docx", "規程/leave.xlsx", "規程/old.doc", "規程/broken.xlsx",
        "規程/locked.docx" }
    bodies: = U8[][]::{ rules_docx, leave_xlsx, ole(" an old Word file", arena), "not a zip at all",
        ole(" a file Office encrypted", arena) }
    fs.write_tree(root, rels, bodies, arena) catch panic("the test folder can be written")
    return root

priv fn ole(rest: U8[], arena: Arena$@): U8[] //< bytes that open as a compound file does
    return arena.text().c(0xD0U8).c(0xCFU8).c(0x11U8).c(0xE0U8).s(rest).take()

fn test_the_tools_search_and_read_word_and_excel_files(work: U8[], arena: Arena$@)
    verdict.start("[ksagent] search and read reach a Word and an Excel file by their text views")
    root: = office_folder(work, arena)
    hits: = files.tool_search(files.Folder(root), "有給休暇", "", ROOM, stub.GOING, arena)
    verdict.check("a search finds the Excel row, named by its sheet and row, and the Word paragraph",
        hits.find_str("規程/leave.xlsx:2: 規程一覧!2: 有給休暇 | 入社6か月後に付与").is_some() &&
        hits.find_str("規程/rules.docx:6: 第2条 年次有給休暇は").is_some(), hits)
    numbered: = files.tool_search(files.Folder(root), "第3条", "", ROOM, stub.GOING, arena)
    verdict.check("a search finds an article by the number Word's list numbering writes",
        numbered.find_str("規程/rules.docx:10: 第3条 特別休暇は、5日とする。").is_some(), numbered)
    read: = files.tool_read(files.Folder(root), "規程/leave.xlsx", 7, 7, ROOM, arena)
    verdict.check("a read numbers the view's lines",
        read.find_str("7: 規程一覧!7: 割増賃金率 | 25%").is_some(), read)
    refusals: = U8[][]::{ "規程/old.doc", "save it as .docx", "規程/broken.xlsx",
        "it is not a zip file", "規程/locked.docx", "protected by a password" }
    for k in Range.asc(refusals.len / 2)
        got: = files.tool_read(files.Folder(root), refusals[2 * k], 1, 5, ROOM, arena)
        verdict.check(arena.text().s("reading ").s(refusals[2 * k]).s(" is refused with what to do")
            .take(),
            got.starts_with("refused: ") && got.find_str(refusals[2 * k + 1]).is_some(), got)

fn test_a_citation_of_a_word_or_excel_file_is_checked(work: U8[], arena: Arena$@)
    verdict.start("[ksagent] a quote from a Word or Excel file is checked against its view's lines")
    root: = office_folder(work, arena)
    cases: = U8[][]::{ "規程/rules.docx", "特別休暇は、5日とする", "規程/leave.xlsx",
        "割増賃金率 | 25%" }
    for k in Range.asc(cases.len / 2)
        s: = Source::{ .path = cases[2 * k], .from_line = 10I64 if k == 0 else 7I64,
            .to_line = 10I64 if k == 0 else 7I64, .quote = cases[2 * k + 1],
            .rows = answer.NO_ROWS }
        $out: = s
        why: = answer.check_source(files.Folder(root), s, out@, arena)
        verdict.check(arena.text().s("a true quote from ").s(cases[2 * k]).s(" passes").take(),
            why.len == 0, why)
    deleted: = Source::{ .path = "規程/rules.docx", .from_line = 10I64, .to_line = 10I64,
        .quote = "特別休暇は、3日とする", .rows = answer.NO_ROWS }
    $out: = deleted
    why: = answer.check_source(files.Folder(root), deleted, out@, arena)
    verdict.check("a quote of deleted text fails, since the view holds the text as changed",
        why.len > 0, why)

fn test_a_search_matches_an_excel_row_by_its_cells(work: U8[], arena: Arena$@)
    verdict.start("[ksagent] a search matches an Excel row by its cells, not by its sheet's name")
    // **Every line of a sheet names the sheet**, so a word of the name would match each of them,
    // and fill the list before the lines that hold it.
    root: = office_folder(work, arena)
    named: = files.tool_search(files.Folder(root), "規程一覧", "", ROOM, stub.GOING, arena)
    verdict.check("the sheet's name alone matches no row",
        named.find_str("leave.xlsx").is_none(), named)
    both: = files.tool_search(files.Folder(root), "規程一覧 割増賃金率", "", ROOM, stub.GOING, arena)
    verdict.check("a row whose cells hold the other word ranks with the lines holding the most",
        both.find_str("no line holds every word").is_some() &&
        both.find_str("規程/leave.xlsx:7: 規程一覧!7: 割増賃金率 | 25%").is_some(), both)

fn test_an_excel_source_is_shown_by_its_sheet_and_rows(work: U8[], arena: Arena$@)
    verdict.start("[ksagent] an Excel source is shown by the sheet and rows Excel shows")
    // **Line 8 of the view is row 9**: row 8 is empty, so it has no line.
    root: = office_folder(work, arena)
    cited: = Source::{ .path = "規程/leave.xlsx", .from_line = 7I64, .to_line = 8I64,
        .quote = "25% 規程一覧!9: 始業時刻 | 09:00", .rows = answer.NO_ROWS }
    $out: = cited
    why: = answer.check_source(files.Folder(root), cited, out@, arena)
    verdict.check("the quote passes, and the source gets the sheet and rows of its lines",
        why.len == 0 && out.rows.sheet.equals("規程一覧") && out.rows.from_row == 7I64 &&
        out.rows.to_row == 9I64 && out.rows.to_sheet.equals("規程一覧"), why)
    $a: = Answer.ended(.answered, .en, arena)
    a.text = "It starts at 09:00."
    a.sources.push(out)
    shown: = arena.text()
    answer.write_console(a@, shown, arena)
    console: = shown.take()
    verdict.check("the console names the sheet and rows",
        console.find_str("- 規程/leave.xlsx sheet 規程一覧, rows 7–9\n").is_some(), console)
    $one: = out
    one.from_line = 8I64
    one.rows.from_row = 9I64
    words: = U8[][]::{ answer.span_words(one, .en, arena),
        answer.span_words(one, .ja, arena), answer.span_words(out, .ja, arena) }
    verdict.check("one row, and a range, in each language",
        words[0].equals("sheet 規程一覧, row 9") &&
        words[1].equals("シート「規程一覧」9行目") &&
        words[2].equals("シート「規程一覧」7–9行目"), words[1])
    none: = List<|answer.Turn|>(arena)
    p: = chat.Pending::{ .id = "q1", .question = "When does work start?", .lang = .en,
        .history = none }
    record: = chat.turn_lines(p@, a@, "", arena)
    verdict.check("the chat file's record names the sheet and rows, for the page",
        record
        .find_str("\"sheet\":\"規程一覧\",\"from_row\":7,\"to_sheet\":\"規程一覧\",\"to_row\":9")
        .is_some(), record)
    plain: = Source::{ .path = "規程/rules.docx", .from_line = 10I64, .to_line = 10I64,
        .quote = "特別休暇は、5日とする", .rows = answer.NO_ROWS }
    $word_out: = plain
    _passed: = answer.check_source(files.Folder(root), plain, word_out@, arena)
    verdict.check("a Word source gets no sheet", word_out.rows.sheet.len == 0, "")

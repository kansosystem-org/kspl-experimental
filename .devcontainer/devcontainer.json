{
  "name": "Kanso Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n",
        "files.encoding": "utf8",
        "[c]": {
           "editor.defaultFormatter": "xaver.clang-format"
        }
      },
      "extensions": [
        "ms-python.python",
        "xaver.clang-format",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "remoteUser": "ubuntu",
  // Do not build here. CI (devcontainers/ci) runs postCreateCommand too, so a `make -B`
  // here makes the `make ci` right after it redo the same bootstrap once more (measured at over 30
  // seconds of duplication per round). Run `make` once the container is open.
  "postCreateCommand": "sudo chown -R ubuntu:ubuntu ."
}
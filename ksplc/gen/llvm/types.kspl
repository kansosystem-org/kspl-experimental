//< Maps a KSPL type to an LLVM type string, and the low-level IR helpers
//< The helpers are `alloca` and load/store. Two parts: the type-output methods on Ctx (t / t_gep
//< and so on), and the Ast_node extensions that convert composite types and parameter lists.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/core" as base_core
import "ksplc/base/diag" as base_diag
import "ksplc/gen/llvm/ctx" as gen_llvm_ctx + { Genllvm_ctx }
import "ksplc/sema/decl/layout" as sema_decl_layout
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/math"
import "std/str"

priv const MAX_LLVM_TYPE_DEPTH: Sz = 1000 //<
    //< The depth limit for Ctx.t's recursive walk down a `[N]` array chain
    //< The parser does not count a repeated `[N]` as depth, so a very long one could overflow the
    //< stack. Past it, had_error is set and a fallback type returned (codegen_failed reports it).

priv const MAX_INLINE_ZERO_FILL_BYTES: Sz = 256 //<
    //< The largest aggregate, in bytes, still zeroed with one `store <T> zeroinitializer`
    //< Above it, llvm.memset is used (see emit_zero_fill); a small type keeps a readable store.

priv fn llvm_prim_name(base_str: U8[]): U8[] //<
    //< It returns the LLVM scalar type for a KSPL primitive type name ("" for a non-primitive)
    //< Ctx.t_impl and Ctx.is_llvm_aggregate both read this one table. Two tables would let "an i64
    //< treated as an aggregate" slip in silently.
    prim_map: = U8[][]::{ "I8", "i8", "I16", "i16", "I32", "i32", "I64", "i64", "U8", "i8", "U16",
        "i16", "U32", "i32", "U64", "i64", "Sz", "i64", "Bool", "i8", "F32", "float", "F64",
        "double" }
    for $i: = 0; i < prim_map.len; i += 2
        if base_str.equals(prim_map[i])
            return prim_map[i + 1]
    return ""

impl Genllvm_ctx
    fn reg_str(r: Self$@, reg: I32): U8$[]
        r.clear_scratch().s("%\{reg\}")
        return r.take_scratch()

    fn emit_numeric_to_i32(r: Self$@, val_reg: U8[], src_type_id: I32): U8$[] //<
        //< It converts val_reg (a register holding the type src_type_id) to i32 and returns it
        //< It lets main()'s value (or its Result's success value) give the right process exit code.
        //< This holds even for a numeric type other than I32, a scalar enum included (see
        //< emit_main_wrapper in gen/llvm/module.kspl). A float, which check_main_signature keeps
        //< out today, saturates as a cast does.
        i32_id: = I32::sema_type_env.Builtin_type_id.i32_type
        resolved_src: = r.env.scalar_repr_id(src_type_id)
        if r.env.is_float(resolved_src)
            return r.emit_float_to_int_sat(val_reg, resolved_src, i32_id)
        return r.emit_numeric_coerce(val_reg, src_type_id, i32_id)

    fn emit_float_to_int_sat(r: Self$@, val_reg: U8[], src_id: I32, dst_id: I32): U8$[] //<
        //< It converts a float register to the integer type dst_id, saturating, and returns it
        //< Caution: **Never a bare `fptosi` / `fptoui`.** It is poison for a value the type cannot
        //< hold; `llvm.fpto[su]i.sat` saturates, as genc's `kspl_F64_to_I32` does.
        reg: = r.next_reg()
        sign: = "u" if r.env.is_unsigned(dst_id) else "s"
        bits: = r.env.get_primitive_bit_size(dst_id)
        src_word: = "f32" if r.env.get_primitive_bit_size(src_id) == 32 else "f64"
        r.s("    %\{reg\} = call i\{bits\} @llvm.fpto\{sign\}i.sat.i\{bits\}.\{src_word\}(")
            .t(src_id).s(" ").s(val_reg).s(")\n")
        return r.reg_str(reg)

    fn emit_numeric_coerce(r: Self$@, val_reg: U8[], src_id: I32, dst_id: I32): U8$[] //<
        //< It returns val_reg (of type src_id) converted to dst_id's width and sign
        //< **The one place that chooses zext, sext, trunc, fpext or fptrunc.** A scalar enum counts
        //< as its base type. Where the representation is the same, it emits nothing.
        //< Caution: A store must always be emitted in **the destination's type**. `Sz$[]::{ .len =
        //< 2 }` as `store i32 2` writes 4 bytes and **leaves the other 4 to the zeroinitializer**.
        if src_id <= 0 || dst_id <= 0
            return base_core.arena.dup_str(val_reg)
        src: = r.env.scalar_repr_id(src_id)
        dst: = r.env.scalar_repr_id(dst_id)
        src_bits: = r.env.get_primitive_bit_size(src)
        dst_bits: = r.env.get_primitive_bit_size(dst)
        // Sema rejects integers mixed with floating point; one here passes unconverted and shows up
        // as LLVM's type mismatch rather than as a silently changed value.
        if src == dst || src_bits == dst_bits ||
            r.env.is_float(src) != r.env.is_float(dst)
            return base_core.arena.dup_str(val_reg)
        reg: = r.next_reg()
        r.s("    %\{reg\} = ")
        if r.env.is_float(src)
            r.s("fpext " if dst_bits > src_bits else "fptrunc ")
        else if dst_bits > src_bits
            r.s("zext " if r.env.is_unsigned(src) else "sext ")
        else
            r.s("trunc ")
        r.t(src_id).s(" ").s(val_reg).s(" to ").t(dst_id).s("\n")
        return r.reg_str(reg)

    fn get_or_alloc_tmp_slot(r: Self$@, node: Void$@, type_id: I32): U8$[]
        is_existing: = r.has_local_var_id(node)
        m_id: = r.get_or_add_local_var_id(node)
        r.clear_scratch().s("%v_tmp_ast_\{m_id\}")
        ptr_str: = r.take_scratch()
        if !is_existing
            r.emit_alloca(ptr_str, type_id)
        return ptr_str
    fn emit_ret_value(r: Self$@, val_str: U8[]) //<
        //< It returns val_str following the ABI of the function being emitted
        //< val_str is a register name, or a constant such as `zeroinitializer`. In an sret function
        //< it writes through the hidden pointer and does `ret void`. Use this rather than writing a
        //< `ret` directly.
        if r.current_ret_is_sret
            r.s("    store ").t(r.current_ret_id).s(" ").s(val_str).s(", ptr ")
                .s(gen_llvm_ctx.SRET_PARAM_NAME).s("\n")
            r.s("    ret void\n")
            return
        r.s("    ret ").t(r.current_ret_id).s(" ").s(val_str).s("\n")

    fn alloc_tmp_slot(r: Self$@, type_id: I32): U8$[] //<
        //< It allocates new temporary memory for each call site and returns its name
        //< Unlike get_or_alloc_tmp_slot it is not keyed on an AST node, so it never collides (an
        //< sret's destination, a byval copy). It goes into the alloca group at the function's
        //< start, since an alloca in a loop grows the stack per iteration.
        m_id: = r.var_counter
        r.var_counter += 1
        r.clear_scratch().s("%v_tmp_abi_\{m_id\}")
        ptr_str: = r.take_scratch()
        r.emit_alloca(ptr_str, type_id)
        return ptr_str

    fn emit_agg_param_type(r: Self$@): Self$@ //<
        //< It emits the type of an argument that passes an aggregate explicitly through memory
        //< This is **a plain `ptr`**, not an `sret(%T)` / `byval(%T)`: with the attribute, how the
        //< aggregate is passed would depend again on each target's convention.
        return r.s("ptr")

    fn emit_alloca(r: Self$@, slot: U8[], type_id: I32) //<
        //< It writes `<slot> = alloca <type>` to the alloca group at the function's start
        //< An `#align(N)` struct gets `, align N` as well.
        align_val: = r.get_struct_align(type_id)
        prev: = r.emit.target
        r.emit.target = .alloca
        r.s("    ").s(slot).s(" = alloca ").t(type_id)
        if align_val > 0
            r.s(", align \{align_val\}")
        r.s("\n")
        r.emit.target = prev

    fn emit_zero_fill(r: Self$@, ptr: U8[], type_id: I32) //<
        //< It fills the type_id-sized memory that ptr points at with zeros
        //< A large `store <T> zeroinitializer` is expanded per element at -O0, and a big enough one
        //< **crashes clang itself with SIGSEGV**. Above the threshold llvm.memset is used
        //< ("A huge aggregate is not handled as a first-class value" in
        //< ksplc/docs/DESIGN-backends.md).
        if !base_core.config.is_freestanding
            lay: = r.sema.type_layout(type_id)
            if lay.size > MAX_INLINE_ZERO_FILL_BYTES
                align_val: = lay.align if lay.align > 0 else 1
                r.s("    call void @llvm.memset.p0.i64(ptr align \{align_val\} ").s(ptr)
                    .s(", i8 0, i64 \{lay.size\}, i1 false)\n")
                return
        r.s("    store ").t(type_id).s(" zeroinitializer, ptr ").s(ptr).s("\n")

    fn op_load(r: Self$@, res_reg: I32, type_id: I32, ptr: U8[])
        r.s("    %\{res_reg\} = load ").t(type_id).s(", ptr ").s(ptr).s("\n")
    fn op_store(r: Self$@, type_id: I32, val: U8[], ptr: U8[])
        r.s("    store ").t(type_id).s(" ").s(val).s(", ptr ").s(ptr).s("\n")
    fn op_load_place(r: Self$@, res_reg: I32, type_id: I32, ptr: U8[], place: Ast_node$@) //<
        //< op_load from a place, told the alignment a `#packed` struct leaves it
        //< Caution: **A load or store with no `align` takes its type's own.** So a field of a
        //< `#packed` struct read or written without one faults on a Cortex-M0.
        r.s("    %\{res_reg\} = load ").t(type_id).s(", ptr ").s(ptr).place_align(place).s("\n")
    fn op_store_place(r: Self$@, type_id: I32, val: U8[], ptr: U8[], place: Ast_node$@) //<
        //< op_store to a place, told the alignment a `#packed` struct leaves it (op_load_place)
        r.s("    store ").t(type_id).s(" ").s(val).s(", ptr ").s(ptr).place_align(place).s("\n")
    priv fn place_align(r: Self$@, place: Ast_node$@): Self$@ //<
        //< `, align N` where packing lowers it
        align: = r.sema.packed_place_align(place)
        return r.s(", align \{align\}") if align > 0 else r
    fn op_gep(r: Self$@, res_reg: I32, type_id: I32, ptr: U8[], idx0: I32, idx1: I32)
        r.s("    %\{res_reg\} = getelementptr inbounds ").t(type_id).s(", ptr ").s(ptr)
            .s(", i32 \{idx0\}, i32 \{idx1\}\n")
    fn t_gep(r: Self$@, type_id: I32): Self$@ //<
        //< It emits a type for a GEP's element, with unknown and void as i8
        //< void cannot be a GEP's element type, so those become i8 for byte-wise access; everything
        //< else goes to t().
        if type_id <= 0 || sema_type_env.is_unknown(type_id) || sema_type_env.is_void(type_id)
            return r.s("i8")
        real_id: = r.env.get_real_type(type_id)
        if sema_type_env.is_void(real_id)
            return r.s("i8")
        return r.t(type_id)

    fn t(r: Self$@, type_id: I32): Self$@ //<
        //< It maps a Kanso type ID to its LLVM IR type
        return r.t_impl(type_id, 0)

    fn t_impl(r: Self$@, type_id: I32, depth: Sz): Self$@
        if depth >= MAX_LLVM_TYPE_DEPTH
            if !r.had_error
                base_diag.print_unplaced("", 0,
                    "array type nesting too deep (possible unbounded '[N]' chain).")
                r.had_error = true
            return r.s("i8")
        if type_id <= 0 || sema_type_env.is_unknown(type_id)
            return r.s("ptr") // an opaque type cannot be used as a value, so it becomes ptr

        // The immutability qualifier (`Info.const_of`) is stripped first.
        // **Alias resolution and qualifier stripping alternate** (`get_clean_real_type`, as in
        // sema); doing each once leaves `const_of(alias B)` as an undefined `%..._B` (`loading
        // unsized types is not allowed`).
        real_id: = r.env.get_clean_real_type(type_id)

        if r.env.is_fn_ptr(real_id)
            return r.s("ptr")

        info: = r.env.get_info(real_id)

        switch info
        case .void_type
            return r.s("void")
        case .pointer
            // Modern LLVM (v15+) uses Opaque Pointers.
            return r.s("ptr")
        case .array(base_id, size)
            if size == -1
                return r.s("ptr") // where the length is unknown, it becomes a pointer
            return r.s("[\{size\} x ").t_impl(base_id, depth + 1).s("]")
        case .enum_type(def)
            if def.is_scalar()
                return r.t_impl(def.base_type_id, depth + 1)
        default {}

        // The LLVM IR has no const qualifier; the plain base type is used.
        base_str: = r.env.get_str(r.env.strip_const(real_id))
        prim: = llvm_prim_name(base_str)
        if prim.len > 0
            return r.s(prim)
        // Everything else is a user-defined type such as a struct or an enum.
        return r.s("%").s_mangled(real_id)

    fn is_llvm_aggregate(r: Self$@, type_id: I32): Bool //<
        //< Whether a type_id's LLVM form is a first-class aggregate (a struct or array)
        //< Caution: This must match t_impl's branches one to one (both use llvm_prim_name's table).
        //< Otherwise an ABI mismatch is silently built in: sret in the definition, a value return
        //< at the caller ("Passing an aggregate is an explicit internal ABI" in
        //< ksplc/docs/DESIGN-backends.md).
        return r.is_llvm_aggregate_impl(type_id, 0)

    priv fn is_llvm_aggregate_impl(r: Self$@, type_id: I32, depth: Sz): Bool
        if depth >= MAX_LLVM_TYPE_DEPTH
            return false // t_impl makes it i8 too (it is not an aggregate)
        if type_id <= 0 || sema_type_env.is_unknown(type_id)
            return false // ptr
        real_id: = r.env.get_clean_real_type(type_id)
        if r.env.is_fn_ptr(real_id)
            return false // ptr
        switch r.env.get_info(real_id)
        case .void_type
            return false
        case .pointer
            return false
        case .array(_base_id, size)
            return size != -1 // an unknown length becomes ptr
        case .enum_type(def)
            if def.is_scalar()
                return r.is_llvm_aggregate_impl(def.base_type_id, depth + 1)
            return true
        default {}

        // A primitive gives the scalar type, anything else a named struct or trait type.
        return llvm_prim_name(r.env.get_str(r.env.strip_const(real_id))).len == 0

    fn ret_needs_sret(r: Self$@, type_id: I32): Bool //<
        //< Whether a return type type_id is returned by an explicit `sret` pointer argument
        //< The LLVM IR accepts a multi-field first-class aggregate such as `ret { i64, i64 }`, but
        //< which registers or memory it ends up in is not fixed by any ABI. No aggregate return
        //< value crosses the FFI boundary (`#ext` / `#export`), so this internal ABI can be chosen
        //< independently without drifting from C. Where a form that could drift appears,
        //< gen/llvm/decl.kspl fails with an ICE.
        return r.is_llvm_aggregate(type_id)
    fn get_struct_align(r: Self$@, type_id: I32): I32 //<
        //< The alignment an alloca or global of the type must be told (0 where LLVM's own is right)
        //< A named struct type cannot carry an alignment. So each alloca or global adds `, align N`
        //< taken from here: an `#align(N)` struct's N, and ksplc's own for a laid one (`is_laid`).
        //< LLVM takes a laid struct's packed type for byte-aligned. An array asks of its element.
        real_id: = r.env.get_clean_real_type(type_id)
        switch r.env.get_info(real_id)
        case .array(elem_id, _size)
            return r.get_struct_align(elem_id)
        case .enum_type(def)
            // A tagged union's type aligns to 8 at most (its words are i64 at most).
            if !def.is_scalar()
                lay_align: = I32::r.sema.type_layout(real_id).align
                return lay_align if lay_align > 8 else 0
        default {}
        // With an immutability qualifier on the type name, the struct definition is not found.
        // The `#align(N)` is then silently lost (it is stripped for the same reason as in t_impl).
        if sdef: = r.env.get_struct_def(r.env.get_str(real_id))
            if sdef.align_attr > 0
                return sdef.align_attr
            if r.is_laid(real_id, 0)
                return I32::r.sema.type_layout(real_id).align
        return 0

    fn enum_tag_type(r: Self$@, enum_type: I32): I32 //< a tagged union's tag type: its base type
        if def: = r.env
            .get_enum_def(r.env.get_str(r.env.get_clean_real_type(enum_type)))
            return def.base_type_id
        return I32::sema_type_env.Builtin_type_id.i32_type

    fn enum_tag_init(r: Self$@, key: Void$@, real_type_id: I32, tag_value: I64): U8$[] //<
        //< It zero-fills a tagged union's slot for key, writes the tag and returns the slot
        tmp_ptr: = r.get_or_alloc_tmp_slot(key, real_type_id)
        r.s("    store ")
        r.t(real_type_id).s(" zeroinitializer, ptr ").s(tmp_ptr).s("\n")

        tag_ptr: = r.next_reg()
        r.s("    %\{tag_ptr\} = getelementptr inbounds ")
        r.t_gep(real_type_id).s(", ptr ").s(tmp_ptr).s(", i32 0, i32 0\n")
        r.s("    store ").t(r.enum_tag_type(real_type_id)).s(" \{tag_value\}, ptr %\{tag_ptr\}\n")
        return tmp_ptr

    fn result_variant(r: Self$@, type_id: I32, name: U8[]): sema_type_def.Enum_variant$@ //<
        //< The Result's or Option's variant of that name (`ok` / `err`, `some` / `none`)
        if e_def: = r.env
            .get_enum_def(r.env.get_str(r.env.get_clean_real_type(type_id)))
            if v_def: = e_def.get_variant(name)
                return v_def
        base_diag.ice_panic("result_variant: the type is no Result with this variant")

    fn result_of(r: Self$@, key: Void$@, type_id: I32, variant: U8[], val_type_id: I32, val: U8[]):
        U8$[] //<
            //< A register holding the Result type_id built at `variant`, with val as its payload
            //< A variant whose field is `Void` (`Void!E`'s `ok`) carries nothing, and val is
            //< unread. An empty val leaves the payload zero: the end of a body every path of which
            //< returned.
        real_id: = r.env.get_clean_real_type(type_id)
        v_def: = r.result_variant(real_id, variant)
        tmp_ptr: = r.enum_tag_init(key, real_id, v_def.tag_value)
        if v_def.payload_fields.len > 0 && val.len > 0
            field_ptr: = r.payload_field_ptr(tmp_ptr, real_id, v_def, 0)
            r.s("    store ").t(val_type_id).s(" ").s(val).s(", ptr ").s(field_ptr).s("\n")
        res_reg: = r.next_reg()
        r.op_load(res_reg, real_id, tmp_ptr)
        return r.reg_str(res_reg)

    fn holds_variant(r: Self$@, type_id: I32, ptr: U8[], variant: U8[]): U8$[] //<
        //< A `Bool` (i8) register: whether the Result or Option type_id at ptr holds `variant`
        real_id: = r.env.get_clean_real_type(type_id)
        tag_type: = r.enum_tag_type(real_id)
        tag_ptr: = r.next_reg()
        r.s("    %\{tag_ptr\} = getelementptr inbounds ")
        r.t_gep(real_id).s(", ptr ").s(ptr).s(", i32 0, i32 0\n")
        tag: = r.next_reg()
        r.s("    %\{tag\} = load ").t(tag_type).s(", ptr %\{tag_ptr\}\n")
        want: = r.result_variant(real_id, variant).tag_value
        is_it: = r.next_reg()
        r.s("    %\{is_it\} = icmp eq ").t(tag_type).s(" %\{tag\}, \{want\}\n")
        res: = r.next_reg()
        r.s("    %\{res\} = zext i1 %\{is_it\} to i8\n")
        return r.reg_str(res)

    fn payload_field_ptr(r: Self$@, enum_ptr: U8[], enum_type: I32,
        v_def: sema_type_def.Enum_variant$@, k: Sz): U8$[] //<
            //< The address of a tagged union's payload field k, at ksplc's offset from its start
            //< Caution: **Do not reach it through a struct of the payload's types.** LLVM lays that
            //< out by its own alignments. So a field after an `#align(N)` struct, or a payload
            //< aligned past 8, lands elsewhere than in C and in a global's constant (decl.kspl).
        off: =
            r.sema.enum_payload_offset(enum_type) + r.sema
            .payload_field_offset(v_def, v_def.payload_fields.get(k).name)
        reg: = r.next_reg()
        r.s("    %\{reg\} = getelementptr inbounds i8, ptr ").s(enum_ptr).s(", i64 \{off\}\n")
        return r.reg_str(reg)

    fn is_laid(r: Self$@, type_id: I32, depth: Sz): Bool //<
        //< Whether the struct's LLVM type is written at ksplc's layout, with explicit padding
        //< LLVM lays a struct out by its fields' own alignments, and an `#align(N)` struct has none
        //< to show it. So a struct holding one (or being one) would put its fields elsewhere than C
        //< and `offsetof` do. Such a struct, and every struct holding it, is written packed, each
        //< field at sema's offset and padded to sema's size.
        if depth >= MAX_LLVM_TYPE_DEPTH
            return false
        real_id: = r.env.get_clean_real_type(type_id)
        switch r.env.get_info(real_id)
        case .array(elem_id, _size)
            return r.is_laid(elem_id, depth + 1)
        case .enum_type(def)
            // A tagged union aligned past 8 has no LLVM type showing it (its words are i64 at
            // most).
            return !def.is_scalar() && r.sema.type_layout(real_id).align > 8
        case .struct_type(def)
            if def.is_packed
                return false
            if def.align_attr > 0
                return true
            for f in def.fields_list
                if r.is_laid(f.type_id, depth + 1)
                    return true
            return false
        default
            return false

    fn field_index(r: Self$@, type_id: I32, idx: I32): I32 //<
        //< The LLVM element index of a struct's field number idx
        //< The same number unless the struct is laid, where padding elements come between.
        real_id: = r.env.get_clean_real_type(type_id)
        if !r.is_laid(real_id, 0)
            return idx
        $piece: I32 = 0
        $pos: Sz = 0
        switch r.env.get_info(real_id)
        case .struct_type(def)
            for i in Range.asc(def.fields_list.len)
                f: = def.fields_list.get(i)
                off: = r.sema.field_offset_of(real_id, f.name, null) catch pos
                if off > pos
                    piece += 1
                if I32::i == idx
                    return piece
                piece += 1
                pos = off + r.sema.type_layout(f.type_id).size
        default {}
        return idx

fn emit_slice_base_types(cg: Genllvm_ctx$@) //< it defines the base types of a string slice
    cg.s("%U8_Slice = type { ptr, i64 }\n")
    cg.s("%Const_U8_Slice = type { ptr, i64 }\n\n")

impl Ast_node
    fn emit_llvm_type_decl(r: Ast_node$@, cg: Genllvm_ctx$@)
        if r == null
            return

        switch r.kind_id
        case .k_decl_struct
            r.emit_llvm_struct(cg)
        case .k_decl_enum
            r.emit_llvm_enum(cg)
        case .k_decl_trait
            r.emit_llvm_trait(cg)
        default {}
    fn emit_llvm_param_list(r: Ast_node$@, cg: Genllvm_ctx$@, opts: gen_llvm_ctx.Param_list_opts):
        Bool //<
            //< The shared code that emits LLVM's argument list separated by ", "
            //< Declarations, definitions and variadic calls share it. It returns true where it
            //< emitted anything (so the caller can add a ", ..." at the end).
        if r == null
            return opts.emitted_before
        $is_first: = !opts.emitted_before
        for param in r.children
            if param.kind_id == .k_fn_param
                if !is_first
                    cg.s(", ")
                p_type: = param.get_decl_type_node()
                p_type_id: = p_type.type_id if p_type != null else 0
                if p_type == null
                    cg.s("ptr")
                else if opts.kspl_abi && cg.is_llvm_aggregate(p_type_id)
                    cg.emit_agg_param_type()
                else
                    cg.t(p_type_id)
                if opts.with_names
                    id_node: = param.find_child(.k_identifier)
                    cg.s(" ").s(cg.param_reg(id_node.text if id_node != null else "unknown"))
                is_first = false
            else if opts.emit_variadic && param.is_literal("...")
                if !is_first
                    cg.s(", ")
                cg.s("...")
                is_first = false
        return !is_first
    priv fn mangled_type_name(r: Ast_node$@, cg: Genllvm_ctx$@): U8[] //<
        //< It returns the mangled name of a type ID ("" where the type is unresolved)
        //< The caller skips a type that returns "".
        if r.type_id == 0
            return ""
        return base_core.arena.dup_str(cg.mangled_in_scratch(r.type_id))

    priv fn emit_llvm_struct(r: Ast_node$@, cg: Genllvm_ctx$@)
        m_name: = r.mangled_type_name(cg)
        if m_name.len == 0
            return

        $is_packed: = false
        if struct_def: = cg.env.get_struct_def(cg.env.get_str(r.type_id))
            is_packed = struct_def.is_packed
            if cg.is_laid(r.type_id, 0)
                r.emit_llvm_laid_struct(cg, m_name, struct_def)
                return

        cg.s("%").s(m_name).s(" = type <{ " if is_packed else " = type { ")

        $is_first: = true
        for c in r.children
            if c.kind_id == .k_struct_field
                type_node: = c.get_decl_type_node()
                if type_node != null
                    if !is_first
                        cg.s(", ")
                    cg.t(type_node.type_id)
                    is_first = false
        cg.s(" }>\n" if is_packed else " }\n")

    priv fn emit_llvm_laid_struct(r: Ast_node$@, cg: Genllvm_ctx$@, m_name: U8[],
        def: sema_type_def.Struct_def$@) //<
            //< A laid struct's type: packed, each field at sema's offset, `i8` padding around
            //< Caution: **Keep the pieces in step with `field_index`**, which counts them to find
            //< one.
        cg.s("%").s(m_name).s(" = type <{ ")
        $pos: Sz = 0
        $first: = true
        for f in def.fields_list
            off: = cg.sema.field_offset_of(r.type_id, f.name, r) catch pos
            if off > pos
                cg.s("" if first else ", ").s("[\{off - pos\} x i8]")
                first = false
            cg.s("" if first else ", ").t(f.type_id)
            first = false
            pos = off + cg.sema.type_layout(f.type_id).size
        size: = cg.sema.type_layout(r.type_id).size
        if size > pos
            cg.s("" if first else ", ").s("[\{size - pos\} x i8]")
        cg.s(" }>\n")

    priv fn emit_llvm_enum(r: Ast_node$@, cg: Genllvm_ctx$@)
        m_name: = r.mangled_type_name(cg)
        if m_name.len == 0
            return

        if !cg.env.is_scalar_enum(r.type_id)
            // LLVM has no tagged union, so a non-scalar enum is declared as "the tag (i32) plus raw
            // bytes". Field access (emit_llvm_enum_init_call / match) gives the GEP an anonymous
            // struct of the payload types. With opaque pointers, the GEP type only sets the offset.
            // The tag is the base type, as C's and sema's. The words are as wide as the alignment
            // (8 at most), so the type takes sema's size and, up to 8, its alignment.
            lay: = cg.sema.type_layout(r.type_id)
            tag_id: = cg.enum_tag_type(r.type_id)
            word: Sz = math.min(lay.align, 8)
            tag_size: = cg.sema.type_layout(tag_id).size
            start: = (tag_size + word - 1) / word * word
            n: = (lay.size - start) / word
            cg.s("%").s(m_name).s(" = type { ").t(tag_id)
            if n > 0
                cg.s(", [\{n\} x i\{word * 8\}]")
            cg.s(" }\n")

    priv fn emit_llvm_trait(r: Ast_node$@, cg: Genllvm_ctx$@)
        m_name: = r.mangled_type_name(cg)
        if m_name.len == 0
            return

        fqn_name: = cg.env.get_str(r.type_id)

        cg.s("%").s(m_name).s(" = type { ptr, ptr }\n")

        if trait_def: = cg.env.get_trait_def(fqn_name)
            cg.s("%kspl_vtable_").s(m_name).s(" = type { ")
            // Caution: **Count only the methods that have a slot.** The code that fills the table
            // (`../../lower/vtable.kspl`) skips by the same predicate; counting all here makes the
            // element counts disagree, and LLVM rejects it with
            // `initializer with struct type has wrong # elements`.
            $is_first: = true
            for method in trait_def.methods_list
                if !method.node.has_vtable_slot()
                    continue
                if !is_first
                    cg.s(", ")
                cg.s("ptr")
                is_first = false
            if is_first
                cg.s("ptr")
            cg.s(" }\n")

//< The C backend's postfix chain (`.` / `[]` / `()` / `::`), beside the rest of `expr.kspl`
//< **Some places write the same subexpression twice** (a subscript names the receiver for `.ptr`
//< and for the bounds check's `.len`), so a side effect would run twice. `lower/expr.kspl` copies
//< such values to temporaries first (`ksplc/tests/lang_test.kspl` checks the count).
// ==========================================
// **`receiver_needs_hoist` decides whether the receiver needs a temporary before its address is
// taken** (`base/ast_place.kspl`). Do not decide it again here.
// ==========================================
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/core" as base_core
import "ksplc/gen/c/ctx" { Genc_ctx }
import "ksplc/gen/c/expr" as gen_c_expr
import "ksplc/gen/c/literal" as gen_c_literal
import "ksplc/sema/body/call" as sema_body_call
import "ksplc/sema/body/postfix" as sema_body_postfix
import "ksplc/sema/decl/fold_float" as sema_decl_fold_float
import "ksplc/sema/type/display" // `display`
import "ksplc/sema/type/query" as sema_type_query
import "std/str"

impl Ast_node
    fn emit_method_call(r: Self$@, c: Genc_ctx$@, args_node: Ast_node$@)
        method_node: = r.get_postfix_member()
        r.ice_assert(method_node != null, "emit_method_call: missing method name")

        recv_node: = r.get_postfix_receiver()
        r.ice_assert(recv_node != null, "emit_method_call: missing receiver")

        obj_id: = recv_node.type_id
        depth: = c.env.ptr_depth(obj_id)
        arrow: = "->" if depth >= 1 else "."

        c.s("(")
        c.s("(")
        recv_node.emit_ptr_adjusted_receiver(c, depth)
        c.s(")").s(arrow).s("vtable->")
        c.nm(method_node.text)
        c.s("((")
        recv_node.emit_ptr_adjusted_receiver(c, depth)
        c.s(")").s(arrow).s("obj")
        if args_node != null
            for arg_node in args_node.children
                if arg_node.is_literal(",")
                    continue
                c.s(", ")
                arg_node.emit_expr(c)
        c.s("))")

    fn emit_upcast_expr(r: Self$@, c: Genc_ctx$@, as_init: Bool)
        inner: = r.get_upcast_inner()
        trait_id: = r.type_id
        base_id: = inner.type_id
        // Caution: Strip it the same way as vtable_key in lower/vtable.kspl does. strip_ptr leaves
        // an immutability level and prints `Const_<type>`, a symbol with no definition.
        clean_base_id: = c.env.receiver_base_id(base_id)

        c.open_compound(trait_id, as_init).s("{ .obj = (void*)")
        if c.env.is_pointer(base_id)
            inner.emit_expr(c)
        else
            c.s("&")
            inner.emit_expr_prec(c, 13)
        c.s(", .vtable = &kspl_vtable_impl_").m(clean_base_id).s("_").m(trait_id).s(" }")

    fn emit_postfix_call(r: Ast_node$@, c: Genc_ctx$@, expr_node: Ast_node$@)
        is_method: = expr_node.kind_id == .k_method_access
        $args_node: = r.find_child(.k_expr_args)
        if args_node == null
            args_node = expr_node.find_child(.k_expr_args)

        $intr: = sema_body_call.Intrinsic.not_intrinsic
        if expr_node.kind_id == .k_identifier
            intr = sema_body_call.intrinsic_of(expr_node.text)
        if !is_method && intr != .not_intrinsic && emit_intrinsic_call(c, intr, args_node)
            return

        if is_method
            expr_node.emit_method_call(c, args_node)
        else
            expr_node.emit_expr_as_receiver(c)
            c.s("(")
            if args_node != null
                args_node.emit_comma_separated_args(c, false)
            c.s(")")

    fn emit_ptr_adjusted_receiver(r: Self$@, c: Genc_ctx$@, depth: I32) //<
        //< It writes depth-1 '*'s before the receiver, for a multi-level pointer (Foo@@)
        //< This is automatic dereferencing; at depth<=1 it writes nothing.
        //< The caller picks the following '->' / '.' by depth.
        if depth > 1
            c.s("(")
            for _i in Range.new(1, depth, 1)
                c.s("*")
            r.emit_expr_as_receiver(c)
            c.s(")")
        else
            r.emit_expr_as_receiver(c)

    fn emit_postfix_dot(r: Ast_node$@, c: Genc_ctx$@, expr_node: Ast_node$@)
        member_node: = r.get_postfix_member()
        r.ice_assert(member_node != null, "emit_postfix_dot: expr_postfix '.' missing target member")
        depth: = c.env.ptr_depth(expr_node.type_id)
        base_id: = c.env.receiver_base_id(expr_node.type_id)
        if c.env.is_result(base_id) || c.env.is_option(base_id)
            // Lower's view of a Result or an Option (build_result_access in base/ast.kspl), off
            // the enum's tag and payload.
            // The tag test is a comparison, bracketed by its precedence (get_c_expr_precedence in
            // expr.kspl).
            expr_node.emit_ptr_adjusted_receiver(c, depth)
            c.s("->" if depth >= 1 else ".")
            if member_node.text.equals("is_err")
                c.s("tag == kspl_").m(c.env.get_clean_real_type(base_id)).s("_")
                    .s(c.env.caught_variant(base_id, false))
            else if member_node.text.equals("val")
                c.s("payload.").s(c.env.caught_variant(base_id, true)).s(".value")
            else
                c.s("payload.err.error")
            return
        expr_node.emit_ptr_adjusted_receiver(c, depth)

        // Caution: Escape the name for both `->` and `.`; with only one, the reference misses the
        // declared suffix and only the C compiler's "undeclared" shows it.
        c.s("->" if depth >= 1 else ".")
        c.nm(member_node.text)

    fn emit_payload_access(r: Ast_node$@, c: Genc_ctx$@) //<
        //< Lower's read of a payload field, `<subject>.payload.<variant>.<field>`
        //< build_payload_access in base/ast.kspl says what it holds.
        subject: = r.get_child(0)
        variant: = c.env.variant_at(subject.type_id, r.ival) catch
            r.ice_panic("genc: a payload read names no variant")
        subject.emit_expr_as_receiver(c)
        c.s(".payload.").s(variant.name).s(".")
        c.nm(r.get_child(1).text)

    fn emit_postfix_array(r: Ast_node$@, c: Genc_ctx$@, expr_node: Ast_node$@)
        r.ice_assert(r.children.len >= 3, "emit_postfix_array: access missing index")
        next_op: = r.get_postfix_member()
        r.ice_assert(next_op != null, "emit_postfix_array: missing index")

        // A receiver can be a pointer (`ps[1]` with `ps: U8$[]@`). Just as sema strips it
        // (receiver_base_id in sema/type/env.kspl), this emits `->` / `(*x)` per pointer level, as
        // emit_postfix_dot does.
        recv_id: = c.env.receiver_base_id(expr_node.type_id)
        // **Only fixed-length arrays reach here.** `lower/expr.kspl` rewrites a slice's subscript
        // into an `at(…)$` call (`Index_place` / `Index_ref`); a slice here is a missed rewrite.
        if !c.env.is_array(recv_id)
            r.ice_panic("emit_postfix_array: indexing here is only allowed for fixed-size arrays")
        file_name: = r.loc.file()
        line_num: = c.last_line
        depth: = c.env.ptr_depth(expr_node.type_id)
        arrow: = "->" if depth >= 1 else "."
        expr_node.emit_ptr_adjusted_receiver(c, depth)

        arr_size: = c.env.array_len(recv_id)
        // A constant subscript inside the range needs no check (as in emit_divisor; the decision is
        // in sema/body/postfix.kspl).
        if sema_body_postfix.index_is_static_in_range(c.sema, next_op, arr_size)
            c.s("\{arrow\}data[")
            next_op.emit_expr(c)
            c.s("]")
            return
        c.s("\{arrow\}data[kspl_bounds_check(")
        next_op.emit_expr(c)
        c.s(", \{arr_size\}, \"\{file_name\}\", \{line_num\})]")

    fn emit_as_cast(r: Ast_node$@, c: Genc_ctx$@, expr_node: Ast_node$@, as_init: Bool)
        $target_id: = r.type_id
        if target_id == 0 && r.children.len >= 3
            target_id = r.get_child(2).type_id

        target_type_str: = c.env.get_str(target_id)
        if target_type_str.len == 0 || target_type_str.equals(base_core.UNKNOWN_TYPE_NAME)
            r.ice_panic("emit_as_cast: invalid target type (Sema inference missed)")

        // The built-in constructor and a `Slice<|T|>` instance are handled the same. The
        // descriptor's fields (`ptr` and `len`) are the same, so the compound literal built is the
        // same too (`../../parse/desugar_slice.kspl`).
        is_target_slice: = c.env.is_slice(target_id)
        target_base_id: = c.env.slice_elem(target_id)
        is_base_slice: = c.env.is_slice(expr_node.type_id)
        is_base_array: = c.env.is_array(expr_node.type_id)

        if is_target_slice && is_base_slice
            clean_base_id: = c.env.strip_const(target_base_id)
            src_base_id: = c.env.slice_elem(expr_node.type_id)
            clean_src_base_id: = c.env.strip_const(src_base_id)
            // Where the element types are identical in C (U8[] and const U8[] are both
            // kspl_U8_Slice), the expression is emitted as is. Rebuilding it would run the
            // receiver's side effect twice.

            if clean_base_id == clean_src_base_id
                c.brace_init = as_init
                expr_node.emit_expr(c)
            else
                c.open_compound_t(target_id, as_init).s("{ .ptr = (")
                c.t(clean_base_id).s("*)")
                expr_node.emit_expr_as_receiver(c)
                c.s(".ptr, .len = ")
                expr_node.emit_expr_as_receiver(c)
                c.s(".len }")
        else if is_target_slice && is_base_array
            gen_c_expr.emit_slice_cast_prefix(c, target_id, target_base_id, as_init)
            // **The slice takes the array's address.** So a constant array stays a name, as under
            // `@` (Genc_ctx.addr_root). Written as its value, the slice would point into a copy.
            outer_root: = c.addr_root
            c.addr_root = expr_node.addr_place_root().unwrap_or(null)
            expr_node.emit_expr_as_receiver(c)
            c.addr_root = outer_root
            c.s(".data, .len = \{c.env.array_len(expr_node.type_id)\} }")
        else if def: = sema_body_postfix.enum_cast_needs_check(c.sema, r)
            // The tags go as a compound literal array, so the operand is evaluated once.
            c.s("(").t(target_id).s(")kspl_tag_check((int64_t)(")
            expr_node.emit_expr(c)
            c.s("), (const int64_t[]){ ")
            for i in Range.asc(def.variants_list.len)
                if i > 0
                    c.s(", ")
                gen_c_literal.emit_folded_i64(c, def.variants_list.get(i).tag_value)
            c.s(" }, \{def.variants_list.len\}, \"").s(c.env.display(target_id))
                .s("\", \"\{r.loc.file()\}\", \{c.last_line\})")
        else if c.env.is_float(expr_node.type_id) &&
            c.env.is_integer(c.env.scalar_repr_id(target_id))
            r.emit_float_to_int(c, expr_node, target_id)
        else if crosses_fn_obj(c, expr_node, target_id) && is_obj_ptr(c, expr_node.type_id)
            // A function and an object pointer convert through the runtime's union, as ISO C has
            // no cast between them (`kspl_fn_to_ptr` in runtime/core.h).
            c.s("((").t(target_id).s(")kspl_ptr_to_fn((void*)(")
            expr_node.emit_expr(c)
            c.s(")))")
        else if crosses_fn_obj(c, expr_node, target_id)
            c.s("((").t(target_id).s(")kspl_fn_to_ptr((kspl_any_fn)(")
            expr_node.emit_expr(c)
            c.s(")))")
        else if !is_c_scalar(c, target_id)
            // **C casts to a scalar type alone** (C99 6.5.4). The aggregate a cast can reach here
            // is the operand's own type, an immutability mark or an alias aside. So it goes as is.
            c.brace_init = as_init
            expr_node.emit_expr(c)
        else
            c.s("(").t(target_id).s(")")

            expr_node.emit_expr_prec(c, 13)

    priv fn emit_float_to_int(r: Ast_node$@, c: Genc_ctx$@, expr_node: Ast_node$@, target_id: I32) //<
        //< A cast from floating point to an integer: a constant's value, else the saturating call
        //< Caution: **Never a bare C cast.** C leaves a value the type cannot hold undefined (NaN
        //< included); KSPL saturates it, as `kspl_F64_to_I32` and its kin in `runtime/core.h` do.
        switch r.float_cast_of(c.sema, false)
        case .fits(v)
            c.s("((").t(target_id).s(")")
            gen_c_literal.emit_folded_i64(c, v)
            c.s(")")
            return
        case .out_of_range
            r.ice_panic("emit_float_to_int: sema let through a constant cast that does not fit")
        case .not_constant {}
        dst: = c.env.scalar_repr_id(target_id)
        src_word: =
            "F32" if c.env.get_primitive_bit_size(expr_node.type_id) == 32 else "F64"
        sign: = "U" if c.env.is_unsigned(dst) else "I"
        bits: = c.env.get_primitive_bit_size(dst)
        c.s("((").t(target_id).s(")kspl_\{src_word\}_to_\{sign\}\{bits\}(")
        expr_node.emit_expr(c)
        c.s("))")

    fn emit_postfix_expr(r: Ast_node$@, c: Genc_ctx$@, as_init: Bool)
        r.ice_assert(r.children.len >= 2, "emit_postfix_expr: requires an operator")
        expr_node: = r.get_postfix_receiver()
        op_text: = r.postfix_op_text()
        if op_text.equals("!") || op_text.equals("catch")
            r.ice_panic("Lowering missed: '!' or 'catch' reached Genc")

        if op_text.equals(".")
            r.emit_postfix_dot(c, expr_node)
        else if op_text.equals("(")
            r.emit_postfix_call(c, expr_node)
        else if op_text.equals("@")
            outer_root: = c.addr_root
            c.addr_root = expr_node.addr_place_root().unwrap_or(null)
            if c.env.is_array(expr_node.type_id)
                c.s("(")
                expr_node.emit_expr_as_receiver(c)
                c.s(".data)")
            else
                c.s("&")
                expr_node.emit_expr_prec(c, 13)
            c.addr_root = outer_root
        else if op_text.equals("[") || op_text.equals("[]")
            r.emit_postfix_array(c, expr_node)
        else if op_text.equals("$")
            c.s("(*(")
            expr_node.emit_expr(c)
            c.s("))")
        else if op_text.equals("::")
            r.emit_as_cast(c, expr_node, as_init)
        else
            expr_node.emit_expr_as_receiver(c)
            c.s(op_text)

    priv fn addr_place_root(r: Ast_node$@): Ast_node$@? //<
        //< The name at the root of a place reached through `.` and `[`, if there is one
        //< An index is a value and is not the root, so a constant there is still written out.
        $at: = r
        for at != null && at.kind_id == .k_expr_postfix
            op: = at.postfix_op_text()
            if !op.equals(".") && !op.equals("[")
                return .none
            at = at.get_postfix_receiver()
        if at != null && at.is_path_or_ident()
            return .some(at)
        return .none

priv fn emit_intrinsic_call(c: Genc_ctx$@, intr: sema_body_call.Intrinsic, args_node: Ast_node$@):
    Bool //<
        //< It writes an intrinsic's call as the C it stands for; false where it wrote none
        //< A volatile access missing its arguments falls back to an ordinary call, which C rejects.
    switch intr
    case .read_volatile
        arg1: = args_node.get_arg_at(0).unwrap_or(null)
        if arg1 == null
            return false
        c.s("(*(volatile ").t(c.env.strip_ptr(arg1.type_id)).s("*)(")
        arg1.emit_expr(c)
        c.s("))")
    case .write_volatile
        arg1: = args_node.get_arg_at(0).unwrap_or(null)
        arg2: = args_node.get_arg_at(1).unwrap_or(null)
        if arg1 == null || arg2 == null
            return false
        c.s("((*(volatile ").t(c.env.strip_ptr(arg1.type_id)).s("*)(")
        arg1.emit_expr(c)
        c.s(")) = (")
        arg2.emit_expr(c)
        c.s("))")
    case .asm_volatile
        emit_asm_volatile(c, args_node)
    default
        return false
    return true

priv fn emit_asm_volatile(c: Genc_ctx$@, args_node: Ast_node$@) //<
    //< `asm_volatile(…)`: GCC's `__asm__ volatile(…)`, its strings written as they are
    c.s("__asm__ volatile(")
    if args_node != null
        $is_first: = true
        for ch in args_node.children
            if ch.is_literal(",")
                continue
            if !is_first
                c.s(", ")
            if ch.kind_id == .k_string
                c.s(ch.text)
            else
                ch.emit_expr(c)
            is_first = false
    c.s(")")

priv fn is_c_scalar(c: Genc_ctx$@, type_id: I32): Bool //<
    //< Whether C carries the type as a scalar: a number, a `Bool`, a pointer or a scalar enum
    repr: = c.env.scalar_repr_id(type_id)
    return c.env.is_numeric(repr) || c.env.is_bool(repr) || c.env.is_pointer(repr) ||
        c.env.is_fn_ptr(repr)

priv fn is_obj_ptr(c: Genc_ctx$@, type_id: I32): Bool //< whether C carries it as an object pointer
    return c.env.is_pointer(type_id) && !c.env.is_fn_ptr(type_id)

priv fn crosses_fn_obj(c: Genc_ctx$@, operand: Ast_node$@, target_id: I32): Bool //<
    //< Whether a cast goes between a function and an object pointer, and is written as a call
    //< **`null` is no such crossing**: a null pointer constant converts to a function pointer in
    //< ISO C. Nor is a file-scope initializer, which takes no call: there the plain cast is the
    //< one spelling left, which gcc's `-pedantic` reports.
    if c.top_level_var || operand.kind_id == .k_null
        return false
    src: = operand.type_id
    return (is_obj_ptr(c, src) && c.env.is_fn_ptr(target_id)) ||
        (c.env.is_fn_ptr(src) && is_obj_ptr(c, target_id))

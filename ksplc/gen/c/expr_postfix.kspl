//< The C backend's postfix chain (`.` / `[]` / `()` / `::`), beside the rest of `expr.kspl`
//< **Some places write the same subexpression twice** (a subscript names the receiver for `.ptr`
//< and for the bounds check's `.len`), so a side effect would run twice. `lower/expr.kspl` copies
//< such values to temporaries first (`ksplc/tests/lang_test.kspl` checks the count).
// ==========================================
// **`receiver_needs_hoist` decides whether the receiver needs a temporary before its address is
// taken** (`sema/type/query.kspl`). Do not decide it again here.
// ==========================================
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/core" as base_core
import "ksplc/base/literal" // `append_literal_bytes`
import "ksplc/gen/c/ctx" { Genc_ctx }
import "ksplc/gen/c/expr" as gen_c_expr
import "ksplc/gen/c/literal" as gen_c_literal
import "ksplc/sema/body/call" as sema_body_call
import "ksplc/sema/body/postfix" as sema_body_postfix
import "ksplc/sema/decl/fold_float" as sema_decl_fold_float
import "ksplc/sema/type/def" { Enum_def }
import "ksplc/sema/type/display" // `display`
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/ds"

impl Ast_node
    priv fn emit_method_call(r: Self$@, cg: Genc_ctx$@, args_node: Ast_node@)
        method_node: = r.get_postfix_member()
        r.ice_assert(method_node != null, "emit_method_call: missing method name")

        recv_node: = r.get_postfix_receiver()
        r.ice_assert(recv_node != null, "emit_method_call: missing receiver")

        obj_id: = recv_node.type_id
        depth: = cg.env.ptr_depth(obj_id)
        arrow: = "->" if depth >= 1 else "."

        cg.s("(")
        cg.s("(")
        recv_node.emit_ptr_adjusted_receiver(cg, depth)
        cg.s(")").s(arrow).s("vtable->")
        cg.nm(method_node.text)
        cg.s("((")
        recv_node.emit_ptr_adjusted_receiver(cg, depth)
        cg.s(")").s(arrow).s("obj")
        if args_node != null
            for arg_node in args_node.children
                if arg_node.is_literal(",")
                    continue
                cg.s(", ")
                arg_node.emit_expr(cg)
        cg.s("))")

    fn emit_upcast_expr(r: Self$@, cg: Genc_ctx$@, as_init: Bool)
        inner: = r.get_upcast_inner()
        trait_id: = r.type_id
        base_id: = inner.type_id
        // Caution: Strip it the same way as vtable_key in lower/vtable.kspl does. strip_ptr leaves
        // an immutability level and prints `Const_<type>`, a symbol with no definition.
        clean_base_id: = cg.env.receiver_base_id(base_id)

        cg.open_compound(trait_id, as_init).s("{ .obj = (void*)")
        if cg.env.is_pointer(base_id)
            inner.emit_expr(cg)
        else
            inner.emit_address_of(cg)
        cg.s(", .vtable = &kspl_vtable_impl_").m(clean_base_id).s("_").m(trait_id).s(" }")

    priv fn emit_postfix_call(r: Ast_node$@, cg: Genc_ctx$@, expr_node: Ast_node$@)
        is_method: = expr_node.kind_id == .k_method_access
        $args_node: = r.find_child(.k_expr_args)
        if args_node == null
            args_node = expr_node.find_child(.k_expr_args)

        $intr: = sema_body_call.Intrinsic.not_intrinsic
        if expr_node.kind_id == .k_identifier
            intr = sema_body_call.intrinsic_of(expr_node.text)
        if intr != .not_intrinsic && emit_intrinsic_call(cg, intr, args_node)
            return

        if is_method
            expr_node.emit_method_call(cg, args_node)
        else
            expr_node.emit_expr_as_receiver(cg)
            cg.s("(")
            if args_node != null
                args_node.emit_comma_separated_args(cg, false)
            cg.s(")")

    priv fn emit_ptr_adjusted_receiver(r: Self$@, cg: Genc_ctx$@, depth: I32) //<
        //< It writes depth-1 '*'s before the receiver, for a multi-level pointer (Foo@@)
        //< This is automatic dereferencing; at depth<=1 it writes nothing.
        //< The caller picks the following '->' / '.' by depth.
        if depth > 1
            cg.s("(")
            for _i in Range(1, depth, 1)
                cg.s("*")
            r.emit_expr_as_receiver(cg)
            cg.s(")")
        else
            r.emit_expr_as_receiver(cg)

    fn emit_postfix_dot(r: Ast_node$@, cg: Genc_ctx$@, expr_node: Ast_node$@)
        member_node: = r.get_postfix_member()
        r.ice_assert(member_node != null, "emit_postfix_dot: expr_postfix '.' missing target member")
        depth: = cg.env.ptr_depth(expr_node.type_id)
        base_id: = cg.env.receiver_base_id(expr_node.type_id)
        expr_node.emit_ptr_adjusted_receiver(cg, depth)
        cg.s("->" if depth >= 1 else ".")
        if cg.env.is_result(base_id) || cg.env.is_option(base_id)
            // Lower's view of a Result or an Option (build_result_access in base/ast.kspl), off
            // the enum's tag and payload.
            // The tag test is a comparison, bracketed by its precedence (get_c_expr_precedence in
            // expr.kspl).
            if member_node.text.equals("is_err")
                cg.s("tag == kspl_").m(cg.env.get_clean_real_type(base_id)).s("_")
                    .s(cg.env.caught_variant(base_id, false))
            else if member_node.text.equals("val")
                cg.s("payload.").s(cg.env.caught_variant(base_id, true)).s(".value")
            else
                cg.s("payload.err.error")
            return

        // Caution: Escape the name for both `->` and `.`; with only one, the reference misses the
        // declared suffix and only the C compiler's "undeclared" shows it.
        cg.nm(member_node.text)

    fn emit_payload_access(r: Ast_node$@, cg: Genc_ctx$@) //<
        //< Lower's read of a payload field, `<subject>.payload.<variant>.<field>`
        //< build_payload_access in base/ast.kspl says what it holds.
        subject: = r.get_child(0)
        variant: = cg.env.variant_at(subject.type_id, r.ival) catch
            r.ice_panic("genc: a payload read names no variant")
        subject.emit_expr_as_receiver(cg)
        cg.s(".payload.").nm(variant.name).s(".")
        cg.nm(r.get_child(1).text)

    fn emit_postfix_array(r: Ast_node$@, cg: Genc_ctx$@, expr_node: Ast_node$@)
        r.ice_assert(r.children.len >= 3, "emit_postfix_array: access missing index")
        next_op: = r.get_postfix_member()
        r.ice_assert(next_op != null, "emit_postfix_array: missing index")

        // A receiver can be a pointer (`ps[1]` with `ps: U8$[]@`). Just as sema strips it
        // (receiver_base_id in sema/type/env.kspl), this emits `->` / `(*x)` per pointer level, as
        // emit_postfix_dot does.
        recv_id: = cg.env.receiver_base_id(expr_node.type_id)
        // **Only fixed-length arrays reach here.** `lower/expr.kspl` rewrites a slice's subscript
        // into an `at(…)$` call (`Index_place` / `Index_ref`); a slice here is a missed rewrite.
        if !cg.env.is_array(recv_id)
            r.ice_panic("emit_postfix_array: indexing here is only allowed for fixed-size arrays")
        file_name: = r.loc.file()
        line_num: = cg.last_line
        depth: = cg.env.ptr_depth(expr_node.type_id)
        arrow: = "->" if depth >= 1 else "."
        expr_node.emit_ptr_adjusted_receiver(cg, depth)

        arr_size: = cg.env.array_len(recv_id)
        // A constant subscript inside the range needs no check (as in emit_divisor; the decision is
        // in sema/body/postfix.kspl).
        if sema_body_postfix.index_is_static_in_range(cg.sema, next_op, arr_size)
            cg.s("\{arrow\}data[")
            next_op.emit_expr(cg)
            cg.s("]")
            return
        cg.s("\{arrow\}data[kspl_bounds_check(")
        next_op.emit_expr(cg)
        cg.s(", \{arr_size\}, \"\{file_name\}\", \{line_num\})]")

    fn emit_as_cast(r: Ast_node$@, cg: Genc_ctx$@, expr_node: Ast_node$@, as_init: Bool)
        $target_id: = r.type_id
        if target_id == 0 && r.children.len >= 3
            target_id = r.get_child(2).type_id

        target_type_str: = cg.env.get_str(target_id)
        if target_type_str.len == 0 || target_type_str.equals(base_core.UNKNOWN_TYPE_NAME)
            r.ice_panic("emit_as_cast: invalid target type (Sema inference missed)")

        // The built-in constructor and a `Slice<|T|>` instance are handled the same. The
        // descriptor's fields (`ptr` and `len`) are the same, so the compound literal built is the
        // same too (`../../parse/desugar_slice.kspl`).
        is_target_slice: = cg.env.is_slice(target_id)
        target_base_id: = cg.env.slice_elem(target_id)
        is_base_slice: = cg.env.is_slice(expr_node.type_id)
        is_base_array: = cg.env.is_array(expr_node.type_id)

        if is_target_slice && is_base_slice
            clean_base_id: = cg.env.strip_const(target_base_id)
            src_base_id: = cg.env.slice_elem(expr_node.type_id)
            clean_src_base_id: = cg.env.strip_const(src_base_id)
            // Where the element types are identical in C (U8[] and const U8[] are both
            // kspl_U8_Slice), the expression is emitted as is. Rebuilding it would run the
            // receiver's side effect twice.

            if clean_base_id == clean_src_base_id
                cg.brace_init = as_init
                expr_node.emit_expr(cg)
            else
                gen_c_expr.emit_slice_cast_prefix(cg, target_id, target_base_id, as_init)
                expr_node.emit_expr_as_receiver(cg)
                cg.s(".ptr, .len = ")
                expr_node.emit_expr_as_receiver(cg)
                cg.s(".len }")
        else if is_target_slice && is_base_array
            gen_c_expr.emit_slice_cast_prefix(cg, target_id, target_base_id, as_init)
            // **The slice takes the array's address.** So a constant array stays a name, as under
            // `@` (Genc_ctx.addr_root). Written as its value, the slice would point into a copy.
            outer_root: = cg.addr_root
            cg.addr_root = expr_node.addr_place_root().unwrap_or(null)
            expr_node.emit_expr_as_receiver(cg)
            cg.addr_root = outer_root
            cg.s(".data, .len = \{cg.env.array_len(expr_node.type_id)\} }")
        else if def: = sema_body_postfix.enum_cast_needs_check(cg.sema, r)
            emit_tag_check(cg, r, expr_node, target_id, def)
        else if cg.env.is_float(expr_node.type_id) &&
            cg.env.is_integer(cg.env.scalar_repr_id(target_id))
            r.emit_float_to_int(cg, expr_node, target_id)
        else if crosses_fn_obj(cg, expr_node, target_id) && is_obj_ptr(cg, expr_node.type_id)
            // A function and an object pointer convert through the runtime's union, as ISO C has
            // no cast between them (`kspl_fn_to_ptr` in runtime/core.h).
            cg.s("((").t(target_id).s(")kspl_ptr_to_fn((void*)(")
            expr_node.emit_expr(cg)
            cg.s(")))")
        else if crosses_fn_obj(cg, expr_node, target_id)
            cg.s("((").t(target_id).s(")kspl_fn_to_ptr((kspl_any_fn)(")
            expr_node.emit_expr(cg)
            cg.s(")))")
        else if !is_c_scalar(cg, target_id)
            // **C casts to a scalar type alone** (C99 6.5.4). The aggregate a cast can reach here
            // is the operand's own type, an immutability mark or an alias aside. So it goes as is.
            cg.brace_init = as_init
            expr_node.emit_expr(cg)
        else if cg.env.is_bool(cg.env.strip_const_deep(expr_node.type_id)) &&
            cg.env.is_integer(cg.env.scalar_repr_id(target_id))
            // **A `Bool` becomes a number through `?:`.** gcc reads `(I32)(x == 3)` as still a
            // truth value, and warns about a `~` on it (-Wbool-operation), although KSPL's
            // `~I32::b` is plain integer arithmetic.
            cg.s("((").t(target_id).s(")((")
            expr_node.emit_expr(cg)
            cg.s(") ? 1 : 0))")
        else if cg.env.is_pointer(target_id) && cg.env.is_integer(expr_node.type_id)
            // **An integer becomes an address through `Sz`**, the pointer's width, widened by its
            // own sign as genllvm widens it. A narrower one cast directly draws C's
            // -Wint-to-pointer-cast.
            cg.s("((").t(target_id).s(")(").t(I32::sema_type_env.Builtin_type_id.size_type).s(")")
            expr_node.emit_expr_prec(cg, gen_c_expr.C_PREC_UNARY)
            cg.s(")")
        else
            cg.s("(").t(target_id).s(")")

            expr_node.emit_expr_prec(cg, gen_c_expr.C_PREC_UNARY)

    priv fn emit_float_to_int(r: Ast_node$@, cg: Genc_ctx$@, expr_node: Ast_node$@, target_id: I32) //<
        //< A cast from floating point to an integer: a constant's value, else the saturating call
        //< Caution: **Never a bare C cast.** C leaves a value the type cannot hold undefined (NaN
        //< included); KSPL saturates it, as `kspl_F64_to_I32` and its kin in `runtime/core.h` do.
        switch r.float_cast_of(cg.sema)
        case .fits(v)
            cg.s("((").t(target_id).s(")")
            gen_c_literal.emit_folded_i64(cg, v)
            cg.s(")")
            return
        case .out_of_range
            r.ice_panic("emit_float_to_int: sema let through a constant cast that does not fit")
        case .not_constant {}
        dst: = cg.env.scalar_repr_id(target_id)
        src_word: =
            "F32" if cg.env.get_primitive_bit_size(expr_node.type_id) == 32 else "F64"
        sign: = "U" if cg.env.is_unsigned(dst) else "I"
        bits: = cg.env.get_primitive_bit_size(dst)
        cg.s("((").t(target_id).s(")kspl_\{src_word\}_to_\{sign\}\{bits\}(")
        expr_node.emit_expr(cg)
        cg.s("))")

    fn emit_postfix_expr(r: Ast_node$@, cg: Genc_ctx$@, as_init: Bool)
        r.ice_assert(r.children.len >= 2, "emit_postfix_expr: requires an operator")
        expr_node: = r.get_postfix_receiver()
        op_text: = r.postfix_op_text()
        if op_text.equals("!") || op_text.equals("catch")
            r.ice_panic("Lowering missed: '!' or 'catch' reached Genc")

        if op_text.equals(".")
            r.emit_postfix_dot(cg, expr_node)
        else if op_text.equals("(")
            r.emit_postfix_call(cg, expr_node)
        else if op_text.equals("@")
            outer_root: = cg.addr_root
            cg.addr_root = expr_node.addr_place_root().unwrap_or(null)
            if cg.env.is_array(expr_node.type_id)
                cg.s("(")
                expr_node.emit_expr_as_receiver(cg)
                cg.s(".data)")
            else
                expr_node.emit_address_of(cg)
            cg.addr_root = outer_root
        else if op_text.equals("[") || op_text.equals("[]")
            r.emit_postfix_array(cg, expr_node)
        else if op_text.equals("$")
            cg.s("(*(")
            expr_node.emit_expr(cg)
            cg.s("))")
        else if op_text.equals("::")
            r.emit_as_cast(cg, expr_node, as_init)
        else
            expr_node.emit_expr_as_receiver(cg)
            cg.s(op_text)

    priv fn addr_place_root(r: Ast_node$@): Ast_node$@? //<
        //< The name at the root of a place reached through `.` and `[`, if there is one
        //< An index is a value and is not the root, so a constant there is still written out.
        $at: = r
        for at != null && at.kind_id == .k_expr_postfix
            op: = at.postfix_op_text()
            if !op.equals(".") && !op.equals("[")
                return .none
            at = at.get_postfix_receiver()
        if at != null && at.is_path_or_ident()
            return .some(at)
        return .none

priv fn emit_intrinsic_call(cg: Genc_ctx$@, intr: sema_body_call.Intrinsic, args_node: Ast_node$@):
    Bool //<
        //< It writes an intrinsic's call as the C it stands for; false where it wrote none
        //< A volatile access missing its arguments falls back to an ordinary call, which C rejects.
    switch intr
    case .read_volatile
        arg1: = args_node.get_arg_at(0).unwrap_or(null)
        if arg1 == null
            return false
        cg.s("(*(volatile ").t(cg.env.strip_ptr(arg1.type_id)).s("*)(")
        arg1.emit_expr(cg)
        cg.s("))")
    case .write_volatile
        arg1: = args_node.get_arg_at(0).unwrap_or(null)
        arg2: = args_node.get_arg_at(1).unwrap_or(null)
        if arg1 == null || arg2 == null
            return false
        cg.s("((*(volatile ").t(cg.env.strip_ptr(arg1.type_id)).s("*)(")
        arg1.emit_expr(cg)
        cg.s(")) = (")
        arg2.emit_expr(cg)
        cg.s("))")
    case .asm_volatile
        emit_asm_volatile(cg, args_node)
    default
        return false
    return true

priv fn emit_asm_volatile(cg: Genc_ctx$@, args_node: Ast_node@) //<
    //< `asm_volatile(…)`: GCC's `__asm__ volatile(…)`, each string written as the bytes it holds
    //< Caution: **Do not copy the spelling.** A line continuation (`\` at a line's end, which
    //< `ksplc fmt` puts in a long string) stands for no byte, but C keeps the next line's indent
    //< inside the assembly text. The LLVM backend writes the bytes too.
    cg.s("__asm__ volatile(")
    if args_node != null
        $is_first: = true
        for ch in args_node.children
            if ch.is_literal(",")
                continue
            if !is_first
                cg.s(", ")
            if ch.kind_id == .k_string
                cg.c('"')
                ch.text.append_literal_bytes(cg, gen_c_literal.append_c_string_byte)
                cg.c('"')
            else
                ch.emit_expr(cg)
            is_first = false
    cg.s(")")

priv fn emit_tag_check(cg: Genc_ctx$@, cast: Ast_node@, operand: Ast_node$@, target_id: I32,
    def: Enum_def@) //<
        //< A cast to an enum from a number, its operand passed through the runtime's tag check
        //< Tags that run unbroken are checked as a range, others as a compound literal array.
        //< Either way the operand is evaluated once. A `U64` above INT64_MAX arrives negative as
        //< an `int64_t`; the flag makes it no tag and prints it unsigned.
    is_unsigned: = cg.env.is_unsigned(cg.env.scalar_repr_id(operand.type_id))
    unsigned_flag: = "1" if is_unsigned else "0"
    n: = def.variants_list.len
    low: = def.run_low()
    cg.s("(").t(target_id).s(")")
        .s("kspl_tag_range_check" if low.is_some() else "kspl_tag_check").s("((int64_t)(")
    operand.emit_expr(cg)
    cg.s("), ").s(unsigned_flag).s(", ")
    if v: = low
        gen_c_literal.emit_folded_i64(cg, v)
        cg.s(", ")
        gen_c_literal.emit_folded_i64(cg, v + I64::(n - 1))
    else
        cg.s("(const int64_t[]){ ")
        for i in Range.asc(n)
            if i > 0
                cg.s(", ")
            gen_c_literal.emit_folded_i64(cg, def.variants_list.get(i).tag_value)
        cg.s(" }, \{n\}")
    cg.s(", \"").s(cg.env.display(target_id)).s("\", \"\{cast.loc.file()\}\", \{cg.last_line\})")

priv fn is_c_scalar(cg: Genc_ctx$@, type_id: I32): Bool //<
    //< Whether C carries the type as a scalar: a number, a `Bool`, a pointer or a scalar enum
    repr: = cg.env.scalar_repr_id(type_id)
    return cg.env.is_numeric(repr) || cg.env.is_bool(repr) || cg.env.is_pointer(repr) ||
        cg.env.is_fn_ptr(repr)

priv fn is_obj_ptr(cg: Genc_ctx$@, type_id: I32): Bool //< whether C carries it as an object pointer
    return cg.env.is_pointer(type_id) && !cg.env.is_fn_ptr(type_id)

priv fn crosses_fn_obj(cg: Genc_ctx$@, operand: Ast_node$@, target_id: I32): Bool //<
    //< Whether a cast goes between a function and an object pointer, and is written as a call
    //< **`null` is no such crossing**: a null pointer constant converts to a function pointer in
    //< ISO C. Nor is a file-scope initializer, which takes no call: there the plain cast is the
    //< one spelling left, which gcc's `-pedantic` reports.
    if cg.top_level_var || operand.kind_id == .k_null
        return false
    src: = operand.type_id
    return (is_obj_ptr(cg, src) && cg.env.is_fn_ptr(target_id)) ||
        (cg.env.is_fn_ptr(src) && is_obj_ptr(cg, target_id))

//< Generates C99 for struct / enum / trait declarations
//<
//< Field layouts, tagged unions (enums), vtable types and a trait's wrapper struct (the thunks are
//< synthesized in ksplc/lower/root.kspl as ordinary decl_fn / decl_const). Forward declarations
//< are in decl.kspl; expressions and statements in expr.kspl / stmt.kspl.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/base/mangle" as base_mangle
import "ksplc/gen/c/ctx" { Genc_ctx }
import "ksplc/gen/c/decl" as gen_c_decl
import "ksplc/gen/c/literal" as gen_c_literal
import "ksplc/gen/c/root" as gen_c_root
import "ksplc/lower/prune" as lower_prune
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/str"

priv fn emit_enum_tag_macros(cg: Genc_ctx$@, name: U8[], e_def: sema_type_def.Enum_def$@) //<
    //< A scalar enum's tags as macros of its own type, for tags past a C `int`
    for v in e_def.variants_list
        cg.clear_scratch()
        v.name.mangle_c_identifier_to(cg.scratch)
        cg.s("#define kspl_\{name\}_\{cg.scratch.slice()\} ((\{name\})")
        if cg.env.is_unsigned(e_def.base_type_id)
            cg.s("\{U64::v.tag_value\}ULL)\n")
        else
            gen_c_literal.emit_folded_i64(cg, v.tag_value)
            cg.s(")\n")
    cg.s("\n")

impl Ast_node
    fn emit_enum_decl(r: Ast_node$@, cg: Genc_ctx$@)
        cg.emit_line_directive(r)
        name: = r.find_text(.k_identifier)
        r.ice_assert(name.len > 0, "emit_node: enum_decl missing identifier")

        is_scalar: = cg.env.is_scalar_enum(r.type_id)
        found: = cg.env
            .get_enum_def(cg.env.get_str(cg.env.get_clean_real_type(r.type_id)))
        $e_def: sema_type_def.Enum_def$@ = null
        switch found
        case .some(d)
            e_def = d
        case .none
            r.ice_panic("emit_enum_decl: the enum has no definition")
        // Caution: **Write each tag as the value sema folded**, never the expression: a name or a
        // cast written there is not C, and a tag C counts itself drifts from sema's count.
        // A C99 enumerator is an `int`, so a scalar enum with a tag past it (a `U32`'s top bit, an
        // `I64`) names its tags as macros of its own type instead; both are constant expressions.
        if is_scalar && !e_def.tags_fit_i32()
            emit_enum_tag_macros(cg, name, e_def)
            return
        cg.s("enum {\n" if is_scalar else "typedef enum {\n")
        for v in e_def.variants_list
            cg.clear_scratch()
            v.name.mangle_c_identifier_to(cg.scratch)
            cg.s("    kspl_\{name\}_\{cg.scratch.slice()\} = \{v.tag_value\},\n")

        if is_scalar
            cg.s("};\n\n")
            return

        // The tag field is the base type, as sema lays it out (`enum E: U8` holds a one-byte tag);
        // a C enum type would be an `int`.
        cg.s("} kspl_\{name\}_Tag;\n\nstruct \{name\} {\n    ").t(e_def.base_type_id).s(" tag;\n")

        if _found: = r.find_deep_child(.k_enum_payload)
            cg.s("    union {\n")
            for child2 in r.children
                if child2.kind_id == .k_enum_variant
                    child2.emit_variant_payload(cg)
            cg.s("    } payload;\n")
        cg.s("};\n\n")

    fn emit_variant_payload(r: Ast_node$@, cg: Genc_ctx$@) //<
        //< A variant's payload as a struct member of the enum's union, named after the variant
        //<
        //< A variant with no payload writes nothing.
        f_list: = r.find_child(.k_enum_payload)
        if f_list == null
            return
        cg.clear_scratch()
        r.get_child(0).text.mangle_c_identifier_to(cg.scratch)
        v_name: = cg.scratch.slice()
        cg.s("        struct {\n")
        for f_node in f_list.children
            if f_node.kind_id != .k_enum_field
                continue
            f_name_node: = f_node.get_enum_field_name_node()
            f_name: = f_name_node.text if f_name_node != null else ""
            cg.s("            ")
            f_node.get_enum_field_type_node().emit_resolved_type(cg, false)
            cg.s(" ").nm(f_name).s(";\n")
        cg.s("        } \{v_name\};\n")

    fn emit_vtable_param(r: Ast_node$@, cg: Genc_ctx$@, pi: Sz) //<
        //< It writes one argument of a vtable's function pointer
        //<
        //< pi is the argument's position. **The first (pi==0) is always a `void*`**: the receiver's
        //< type differs per implementation.
        p_name: = r.get_decl_id_text()
        t_node: = r.get_decl_type_node()
        if pi > 0 && t_node != null && t_node.kind_id != .k_empty &&
            !t_node.text.equals(base_core.unknown_type_name)
            t_node.emit_resolved_type(cg, false)
            cg.s(" ").nm(p_name)
            return
        // No type annotation: the inferred type, where there is one.
        if pi > 0 && !sema_type_env.is_unknown(r.type_id) &&
            !sema_type_env.is_void(r.type_id)
            cg.t(r.type_id).s(" ").nm(p_name)
            return
        cg.s("void* ").nm(p_name)

    fn emit_trait_decl(r: Ast_node$@, cg: Genc_ctx$@) //<
        //< It emits a trait's C struct and the struct of its vtable
        //<
        //< Note: The walk of a vtable's function pointers is like emit_param_list in
        //< gen/c/decl.kspl, but the two cannot be merged: this one always makes the first argument
        //< (the receiver) a void* (the pi==0 branch).
        cg.emit_line_directive(r)
        name: = r.find_text(.k_identifier)
        cg
            .s("struct \{name\} {\n    void *obj;\n    const struct kspl_vtable_\{name\} \
                *vtable;\n};\n\nstruct kspl_vtable_\{name\} {\n")

        for c in r.children
            if c.has_vtable_slot()
                c.emit_vtable_slot(cg)
        cg.s("};\n\n")

    fn emit_vtable_slot(r: Ast_node$@, cg: Genc_ctx$@) //<
        //< One method's function pointer in a trait's vtable struct
        type_node: = r.get_decl_type_node()
        cg.s("    ")
        if type_node != null
            type_node.emit_resolved_type(cg, true)
            cg.s(" (*")
        else
            cg.s("void (*")
        // A method name is emitted plain as the vtable struct's member, so it gets the suffix here
        // just as at the call (`vtable->` in gen/c/expr.kspl).
        cg.nm(r.find_text(.k_identifier)).s(")(")
        param_list: = r.get_fn_params()
        if param_list != null
            $is_first: = true
            for pi in Range.asc(param_list.children.len)
                item: = param_list.get_child(pi)
                is_rest: = item.kind_id == .k_literal && item.text.equals("...")
                if item.kind_id != .k_fn_param && !is_rest
                    continue
                if !is_first
                    cg.s(", ")
                is_first = false
                if is_rest
                    cg.s("...")
                else
                    item.emit_vtable_param(cg, pi)
        cg.s(");\n")

    fn emit_impl_decl(r: Ast_node$@, cg: Genc_ctx$@)
        cg.emit_line_directive(r)
        target_node: = r.get_decl_type_node()
        r.ice_assert(target_node != null, "emit_node: impl_decl missing target type_expr")

        t_id: = target_node.type_id

        old_impl: = cg.current_impl_name
        if t_id != 0
            cg.current_impl_name = cg.mangled_in_scratch(t_id)

        for child in r.children
            if child.kind_id == .k_decl_fn && child.is_emittable()
                child.emit(cg)

        cg.current_impl_name = old_impl

    fn emit_struct_decl(r: Ast_node$@, cg: Genc_ctx$@)
        cg.emit_line_directive(r)
        name: = r.find_text(.k_identifier)
        r.ice_assert(name.len > 0, "emit_node: struct_decl missing Identifier")

        $is_packed: = false
        $align_val: I32 = 0
        if struct_def: = cg.env.get_struct_def(cg.env.get_str(r.type_id))
            is_packed = struct_def.is_packed
            align_val = struct_def.align_attr

        cg.s("struct ")
        if align_val > 0
            cg.s("__attribute__((aligned(\{align_val\}))) ")
        if is_packed
            cg.s("__attribute__((packed)) ")
        cg.s("\{name\} {\n")
        for c in r.children
            if c.kind_id == .k_struct_field
                current_field: = c.find_text(.k_identifier)
                type_node: = c.get_decl_type_node()
                if current_field.len > 0 && type_node != null && type_node.kind_id != .k_empty
                    cg.s("    ")
                    type_node.emit_c_decl(cg, current_field, false)
                    cg.s(";\n")
        cg.s("};\n\n")

//< What the generated `main` does around `kspl_main`, for either backend
//<
//< **Both backends emit the entry point from here**, so a program behaves the same whichever
//< backend built it: the same startup calls in the same order, the same exit code, the same
//< message on failure (`tests/runtime/main_result_without_sys.kspls` runs it on both).
import "ksplc/base/core" as base_core
import "ksplc/lower/abi" as lower_abi
import "ksplc/sema/type/def" { Enum_variant }
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/ds" { List }
import "std/str" { Str_builder }

const startup_calls: U8[][3] = ::{ //<
    //< The runtime calls made after `argc` / `argv` are stored and before `kspl_main`, in order
    //<
    //< Each is `void (void)` and does nothing outside Windows (`runtime/hosted.c`). The console
    //< ones set the code page, without which `--help` and the first diagnostics come out
    //< unreadable; the binary one stops the C runtime from silently turning a `\n` written to
    //< standard output into `\r\n` ("Standard output carries the bytes a program writes" in
    //< `../../docs/DESIGN.md`).
    "kspl_io_attach_console", "kspl_io_init_console", "kspl_io_set_stdio_binary",
}

const failed_with_code: U8[] = "[Kanso] Error: main() failed with code %lld" //<
    //< The failure line where `main`'s error is a signed integer, printed with that number
const failed_with_unsigned_code: U8[] = "[Kanso] Error: main() failed with code %llu" //<
    //< The failure line where `main`'s error is an unsigned integer, printed with that number
const failed_with_variant: U8[] = "[Kanso] Error: main() failed with %s" //<
    //< The failure line where `main`'s error is an enum, printed with the variant's declared name
const failed: U8[] = "[Kanso] Error: main() failed." //< the failure line for any other error

const exit_code_max: I64 = 255 //<
    //< The largest number a failure's exit status passes on as it is; any other gives 1
    //<
    //< A POSIX shell sees only the low 8 bits, so 256 would read as 0, success. **A failure always
    //< exits non-zero**, and with one rule on every OS a program's status is the same everywhere.

enum Main_err //< what `main`'s error is, which fixes the failure line and the exit status
    none //< `main` returns no Result
    number //< an integer: `failed_with_code`; the status is the number where it is 1..255
    variant //< an enum: `failed_with_variant`, naming the variant; the status is 1
    other //< anything else (a struct, a float): `failed`; the status is 1

struct Main_plan //< how the entry point turns what `kspl_main` returns into an exit code
    exit_is_value: Bool //< an integer (a Result's success value) is the exit code; otherwise 0
    err: Main_err //< what a failure is (`none` where `main` returns no Result)
    err_is_unsigned: Bool //< a `number` error is unsigned (`failed_with_unsigned_code`)
    err_variants: List<|Enum_variant$@|>$@ //< a `variant` error's variants; null otherwise
    err_has_payload: Bool //< a `variant` error is a tagged union, whose tag is its first field
    trace_fn: U8[] //<
        //< The C name of what prints the propagation trace on a failure; empty where none is called
        //<
        //< It is `print_trace` in `std/lang`, which every hosted program holds.

impl Main_plan
    fn returns_result(r: Self@): Bool //< whether `main` returns a Result
        switch r.err
        case .none
            return false
        default
            return true

    fn failure_line(r: Self@): U8[] //< the format of the line a failure prints, without its `\n`
        switch r.err
        case .number
            return failed_with_unsigned_code if r.err_is_unsigned else failed_with_code
        case .variant
            return failed_with_variant
        default
            return failed

fn plan_of(env: sema_type_env.Env$@, main_type_id: I32): Main_plan //<
    //< The plan for a `main` of this type
    //<
    //< Caution: **`trace_fn` is set only where the program holds the trace printer.** It has no
    //< definition otherwise (a freestanding build), and calling it anyway gives a raw C compiler
    //< error or an unresolved symbol (Principle 2).
    $trace_fn: U8[] = ""
    if sym: = env.find_backtrace_symbol()
        $w: = Str_builder.new()
        defer w.free()
        lower_abi.get_c_identifier_for_sym_to(sym, sym.name, w@)
        trace_fn = base_core.arena.dup_str(w.slice())
    $plan: = Main_plan::{ .exit_is_value = env.is_integer(env.strip_result(main_type_id)),
        .err = .none, .err_is_unsigned = false, .err_variants = null, .err_has_payload = false,
        .trace_fn = trace_fn }
    if !env.is_result(main_type_id)
        return plan
    err_id: = env.get_result_err_id(main_type_id)
    if env.is_integer(err_id)
        plan.err = .number
        plan.err_is_unsigned = env.is_unsigned(env.get_clean_real_type(err_id))
        return plan
    plan.err = .other
    if def: = env.get_enum_def(env.get_str(env.get_clean_real_type(err_id)))
        plan.err = .variant
        plan.err_variants = def.variants_list
        plan.err_has_payload = !def.is_scalar()
    return plan

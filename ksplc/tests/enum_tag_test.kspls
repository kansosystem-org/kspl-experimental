//< Verifies that an enum's tags are the values written, whatever expression writes them
//<
//< Caution: Check the value itself — the two backends agreeing (tests/prog/equiv.kspls) passes
//< when both take the counter's value instead of the written one.
import "std/verdict"

priv const tag_five: I32 = 5

priv enum Tagged
    by_name = tag_five
    by_cast = I32::7
    by_char = 'A'
    by_size = sizeof(I64)
    by_sum = tag_five * 2 + 1
    counted //< one past the last written tag

priv enum Wide_tag: U32 //< a tag past I32, held in its base type
    top = 0x80000000
    next

priv enum Long_tag: I64
    big = 5000000000I64
    after

priv enum Byte_tag: U8 //< carried as one byte, as sema lays it out
    lo = 1
    hi = 255

priv struct Byte_tags
    priv a: Byte_tag
    priv b: Byte_tag

fn test_enum_tags_are_the_written_values()
    verdict.start("[enum] each tag is the value its expression folds to test...")
    assert(I32::Tagged.by_name == 5, "a constant's name as a tag")
    assert(I32::Tagged.by_cast == 7, "a cast as a tag")
    assert(I32::Tagged.by_char == 65, "a character as a tag")
    assert(I32::Tagged.by_size == 8, "a sizeof as a tag")
    assert(I32::Tagged.by_sum == 11, "arithmetic as a tag")
    assert(I32::Tagged.counted == 12, "the counter goes on from the last written tag")
    w: = Wide_tag.next
    assert(U32::Wide_tag.top == 2147483648U32, "a U32 tag past I32's range")
    assert(U32::w == 2147483649U32, "the counter after a U32 tag past I32's range")
    assert(I64::Long_tag.big == 5000000000I64, "an I64 tag past 32 bits")
    assert(I64::Long_tag.after == 5000000001I64, "the counter after an I64 tag")
    assert(sizeof(Byte_tags) == 2, "a U8 enum is one byte in a struct")
    switch w case .top
        assert(false, "a switch on a wide tag picks its own case")
    case .next {}
    verdict.pass("")

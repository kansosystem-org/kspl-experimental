//< The programs that must stop at run time, each case built and run alone on both backends
//<
//< Each case is compiled as the file its head names, outside any package. So a stop's position
//< reads `at <case>:<line>`.
// ==== case array_index_constant_out_of_bounds
//< Even with an index known at translation time, **out of range must stop at run time**
//<
//< The generated message has a container's shape, `in <what>` ("Conditions that stop execution
//< at run time" in `../../../docs/SPEC-programming-language.md`).
//< Caution: **Check the position too.** Wrapped wrongly, the LLVM pool's file name loses both ends.
// EXPECT: panic: index out of bounds in array (idx: 7, len: 4)
// EXPECT: at array_index_constant_out_of_bounds:
// EXPECT: output before the failed check
// EXPECT-NOT: reached the read
import "std/io"

fn main(): I32
    a: I32[4] = ::{ 10, 20, 30, 40 }
    io.out().s("output before the failed check") // the failure reporter must flush this
    bad: = a[7]
    io.out().s("reached the read: \{I64::bad\}\n").flush()
    return 0
// ==== case crash_null_dereference
//< A write through a null pointer is a crash the OS stops, and the program says so in one line
//<
//< Not a run-time check: the OS refuses the access, and the runtime's handler names it ("A crash
//< says what happened" in `../../gen/runtime/hosted.c`). The code is still the fault's own, 139.
// EXPECT: crash: null pointer dereference (
// EXPECT: exit code 139
// EXPECT-NOT: must not get here
import "std/io"

fn main(): I32
    p: I32$@ = null
    p$ = 1
    io.out().s("must not get here\n").flush()
    return 0
// ==== case crash_stack_overflow
//< A recursion that runs the main thread's stack out says so, though no stack is left to say it on
//<
//< Caution: **The handler runs on a stack of its own.** On the one that ran out it could not run,
//< and the program would end with 139 and no word.
// EXPECT: crash: stack overflow (
// EXPECT: exit code 139
// EXPECT-NOT: must not get here
import "std/io"

fn deep(n: I64): I64
    $frame: U8[256] = ::{}
    frame[0] = U8::(n & 255I64)
    return deep(n + 1I64) + I64::frame[0]

fn main(): I32
    io.out().s("must not get here: \{deep(0I64)\}\n").flush()
    return 0
// ==== case crash_stack_overflow_on_thread
//< A `std/thread` thread that runs its stack out says so too
//<
//< Each such thread is given a stack for the handler as it starts (`kspl_thread_spawn`).
// EXPECT: crash: stack overflow (
// EXPECT: exit code 139
// EXPECT-NOT: must not get here
import "std/io"
import "std/thread"

fn deep(n: I64): I64
    $frame: U8[256] = ::{}
    frame[0] = U8::(n & 255I64)
    return deep(n + 1I64) + I64::frame[0]

#export
fn walk(n: I64$@): Void$@
    n$ = deep(n$)
    return null

fn main(): I32
    $n: I64 = 0
    t: = thread.Thread.spawn<|I64|>(walk, n@) catch panic("the thread must start")
    t.join_and_free()
    io.out().s("must not get here: \{n\}\n").flush()
    return 0
// ==== case dealloc_arena_pointer
//< Passing a pointer an arena allocated to `mem.dealloc` must stop before touching the heap
//<
//< **Neither the type nor translation tells them apart** (both `alloc_as<|T|>()` return `T$@`). So
//< only the start of `dealloc` can stop it. Libc cannot be relied on: glibc can let it pass. On
//< freestanding a fake header joins the free list: **the heap breaks with nobody reporting it**.
// EXPECT: mem.dealloc: this pointer did not come from mem.alloc
// EXPECT-NOT: must not get here
import "std/io"
import "std/mem" + { Arena }

fn main(): I32
    arena: = Arena.new(4096)
    defer arena.free()
    p: = arena.alloc_as<|I32|>()
    p$ = 7
    io.out().s("arena=\{p$\}\n").flush()
    mem.dealloc(Void$@::p)
    io.out().s("must not get here\n").flush()
    return 0
// ==== case dealloc_interior_pointer
//< Passing a pointer to the **inside** of an allocation to `mem.dealloc` must stop
//<
//< `dealloc` may receive only the exact pointer `mem.alloc` returned. `Rc.get()` points inside the
//< control block, so 16 bytes back is not malloc's address; a field's or element's is alike.
//< ARC itself is out of reach (`Rc` has no `free()`; `ctrl`, `retain` and `release` are `priv`).
// EXPECT: mem.dealloc: this pointer did not come from mem.alloc
// EXPECT-NOT: must not get here
import "std/io"
import "std/mem"
import "std/refcount" { Rc }

fn main(): I32
    $r: = Rc<|I32|>.new(5)
    inner: = r.get()
    io.out().s("inner=\{inner$\}\n").flush()
    mem.dealloc(Void$@::inner)
    io.out().s("must not get here\n").flush()
    return 0
// ==== case divide_by_zero
//< When a divisor known only at run time is 0, the program must stop instead of dividing
//<
//< Sema rejects a divisor known to be 0 (the case divide_by_zero in tests/negative/numbers.kspl),
//< which cannot notice a run-time zero getting through.
//< Caution: The divisor must be **decided at run time**, or the test never reaches its check.
// EXPECT: panic: division by zero
// EXPECT: at divide_by_zero:
// EXPECT-NOT: must not get here
import "std/io"
import "std/sys"

fn main(): I32
    // The only argument is the executable's name, so this is 0.
    d: = I32::sys.args().len - 1
    io.out().s("about to divide by \{I64::d\}\n")
    q: I32 = 7 / d
    io.out().s("must not get here: \{q\}\n")
    return 0
// ==== case enum_cast_from_no_tag
//< A cast to an enum from a value known only at run time stops where the value is none of its tags
//<
//< **Let it through and an exhaustive `switch` takes a value it never lists**, as its last arm. A
//< constant is refused at translation time (the case cast_to_enum in `../negative/numbers.kspl`).
//< The base `U8` shows the value is checked before it is narrowed: 300 must not pass as 44.
// EXPECT: panic: enum
// EXPECT: has no tag 300
// EXPECT: at enum_cast_from_no_tag:
// EXPECT: listed: 1
// EXPECT-NOT: must not get here
import "std/io"
import "std/sys"

priv enum E: U8
    a
    b
    c = 44

fn main(): I32
    n: = I32::sys.args().len // 1
    listed: = E::n
    io.out().s("listed: \{I32::listed\}\n").flush()
    far: = 299 + n
    e: = E::far
    io.out().s("must not get here: \{I32::e\}\n").flush()
    return 0
// ==== case index_place_write_out_of_bounds
//< Even an index that returns a place and **writes** must stop when out of range
//<
//< A type of its own (`Index_place.at`) handles the index, and the stop names the user's line.
//< Caution: **Do not write `$` on the receiver.** The `at` below declares `Self@`, so a value
//< received by value can be written to as well ("Indexing" in
//< `../../../docs/SPEC-programming-language.md`).
// EXPECT: panic: index out of bounds in Cells.at (idx: 9, len: 2)
// EXPECT: at index_place_write_out_of_bounds:
// EXPECT-NOT: must not get here
import "std/io"
import "std/mem" { Arena }

struct Cells //< a few I32s, indexed the way a container outside std indexes its elements
    data: I32$@
    size: Sz

impl Cells: Index_place<|Sz, I32|> //< so `c[i]` reads and writes one cell
    fn at(r: Self@, index: Sz, file: U8[], line: Sz): I32$@ //< one cell's place
        if index < 0 || index >= r.size
            bounds_panic("Cells.at", index, r.size, file, line)
        return r.data + index

fn main(): I32
    ar: = Arena.new(1024)
    defer ar.free()
    c: = Cells::{ .data = I32$@::ar.alloc(2 * sizeof(I32)), .size = 2 }
    io.out().s("about to write at 9\n")
    c[9] = 1
    io.out().s("must not get here: \{c[0]\}\n")
    return 0
// ==== case list_get_out_of_bounds
//< When List.get's index is out of range, it must stop instead of reading
//<
//< Tested apart from a slice's index. Both call `std/lang`'s bounds_panic, but the callers differ
//< (`List.get` returns a value, `Slice.at_ref` a place). So either check can vanish alone.
//< The case index_place_write_out_of_bounds covers **writing** through a method that returns a
//< place.
// EXPECT: index out of bounds in List.get
// EXPECT-NOT: must not get here
import "std/ds" { List }
import "std/io"
import "std/sys"

fn main(): I32
    $l: = List<|I32|>.new(null)
    defer l.free()
    l.push(7)
    i: = l.len + sys.args().len - 1 // = 1 = the first index out of range
    io.out().s("about to get at \{i\}\n")
    v: = l.get(i)
    io.out().s("must not get here: \{v\}\n")
    return 0
// ==== case main_fails_with_code_past_255
//< A `main` failing with a number past 255 exits with 1, not with the number's low 8 bits
//<
//< A shell sees only those bits, so 256 would read as 0, success; the suite's non-zero check is
//< the test. The line names the number as thrown.
// EXPECT: [Kanso] Error: main() failed with code 256
// EXPECT: stack backtrace:
priv fn may(): Void!I32
    throw 256

fn main(): Void!I32
    may()!
// ==== case main_fails_with_enum_variant
//< A `main` failing with an enum's first variant exits non-zero, naming the variant and its route
//<
//< The first variant's tag is 0, so an exit status taken from the tag would read as success. The
//< error type is `priv`: only the start-up code receives `main`'s return, so nothing leaks.
// EXPECT: [Kanso] Error: main() failed with bad
// EXPECT: main_fails_with_enum_variant.may at
// EXPECT-NOT: failed with code
priv enum Er
    bad
    worse

priv fn may(): Void!Er
    throw .bad

priv fn mid(): Void!Er
    may()!

fn main(): Void!Er
    mid()!
// ==== case prng_below_zero
//< `Prng.below(0)` must stop: [0, 0) holds no number, and any answer would be out of it
// EXPECT: Prng.below: n must be at least 1
// EXPECT-NOT: must not get here
import "std/io"
import "std/prng"
import "std/sys"

fn main(): I32
    $r: = prng.Prng.new(7U64)
    n: = sys.args().len - 1 // = 0, read at run time so no check can fold it away
    v: = r.below(n)
    io.out().s("must not get here: \{v\}\n")
    return 0
// ==== case shift_amount_out_of_range
//< A run-time shift amount outside the width must stop the program instead of shifting
//<
//< Sema rejects a constant shift amount (the case shift_count_out_of_range in
//< tests/negative/numbers.kspl). This is the run-time path, whose message the code generator
//< writes.
//< Caution: The shift amount must be **decided at run time** (why: the case divide_by_zero).
// EXPECT: panic: shift amount out of range (amount: 32, width: 32)
// EXPECT: at shift_amount_out_of_range:
// EXPECT-NOT: must not get here
import "std/io"
import "std/sys"

fn main(): I32
    // The only argument is the executable's name, so this is exactly U32's width = the first
    // amount out of range.
    n: = U32::(31 + sys.args().len)
    io.out().s("about to shift by \{n\}\n")
    shifted: U32 = 1U32 << n
    io.out().s("must not get here: \{shifted\}\n")
    return 0
// ==== case shift_amount_wider_than_width
//< A shift amount of a wider type is checked whole, before it meets the shifted value's width
//<
//< **Narrowed first, the amount wraps into range**: a `U64` amount of 2^32 becomes 0 at an `I32`'s
//< width, and `1 << m` gives 1 with no stop, on both backends.
//< Caution: The shift amount must be **decided at run time** (why: the case divide_by_zero).
// EXPECT: panic: shift amount out of range (amount: 4294967296, width: 32)
// EXPECT: at shift_amount_wider_than_width:
// EXPECT-NOT: must not get here
import "std/io"
import "std/sys"

fn main(): I32
    // The only argument is the executable's name, so this is exactly 2^32.
    m: = U64::sys.args().len + 4294967295
    x: I32 = 1
    shifted: = x << m
    io.out().s("must not get here: \{shifted\}\n")
    return 0
// ==== case shift_amount_unsigned_past_sign
//< An unsigned shift amount with its top bit set is reported as the number it is
//<
//< The check takes the amount in 64 signed bits, so a `U64` of 2^64-1 reads there as -1 unless the
//< stop is told the amount's type is unsigned.
//< Caution: The shift amount must be **decided at run time** (why: the case divide_by_zero).
// EXPECT: panic: shift amount out of range (amount: 18446744073709551615, width: 64)
// EXPECT: at shift_amount_unsigned_past_sign:
// EXPECT-NOT: must not get here
import "std/io"
import "std/sys"

fn main(): I32
    // The only argument is the executable's name, so this is exactly 2^64-1.
    m: = U64::sys.args().len + 18446744073709551614U64
    x: U64 = 1
    shifted: = x << m
    io.out().s("must not get here: \{shifted\}\n")
    return 0
// ==== case slice_index_out_of_bounds
//< When a slice's index is out of range, it must stop instead of reading
//<
//< Caution: The index must be **decided at run time**, or a reader takes it for a constant's test.
//< A slice is `Slice<|$T|>` ("`T[]` is sugar for `Slice<|$T|>`" in
//< `../../../docs/DESIGN-programming-language.md`), so `bounds_panic` in `std/lang` stops it and
//< reports the user's line, not one inside std.
// EXPECT: panic: index out of bounds in Slice.at_ref (idx: 4, len: 4)
// EXPECT: at slice_index_out_of_bounds:
// EXPECT-NOT: must not get here
import "std/io"
import "std/sys"

fn main(): I32
    data: U8[4] = ::{ 1, 2, 3, 4 }
    s: = U8[]::data
    // The only argument is the executable's name, so this equals s.len = the first index out of
    // range.
    i: = s.len + sys.args().len - 1
    io.out().s("about to read at \{i\}\n")
    b: = s[i]
    io.out().s("must not get here: \{I32::b\}\n")
    return 0
// ==== case slice_struct_out_of_bounds
//< Out of range on a slice held in a struct
//<
//< **Report the place of use.** The code generator embeds the position for the built-in slice. The
//< struct version's `Index_ref.at_ref` takes the caller's position as a default argument ("Default
//< arguments" in `docs/SPEC-programming-language.md`). `std/lang`'s bounds_panic writes the
//< message.
// EXPECT: panic: index out of bounds in Slice.at_ref (idx: 9, len: 2)
import "std/io"

$buf: I32[2] = ::{ 1, 2 }

fn main(): I32
    s: I32[] = ::{ .ptr = buf[0]@, .len = 2 }
    io.out().s("\{s[9]\}\n")
    return 0

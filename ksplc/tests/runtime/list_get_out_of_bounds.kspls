//< When List.get's index is out of range, it must stop instead of reading
//<
//< Tested apart from a slice's index: both call `std/lang`'s bounds_panic, but the callers differ
//< (`List.get` returns a value, `Slice.at_ref` a place), so either check can vanish alone.
//< index_place_write_out_of_bounds.kspls covers **writing** through a method that returns a place.
// EXPECT: index out of bounds in List.get
// EXPECT-NOT: must not get here
import "std/ds" { List }
import "std/io"
import "std/sys"

fn main(): I32
  $l: = List<|I32|>.new()
  defer l.free()
  l.push(7)
  i: = l.len + sys.args().len - 1 // = 1 = the first index out of range
  io.out().s("about to get at \{i\}\n")
  v: = l.get(i)
  io.out().s("must not get here: \{v\}\n")
  return 0

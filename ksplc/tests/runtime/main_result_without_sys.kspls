//< A program whose `main` returns a Result and that uses no `std/sys` compiles, links and runs
//<
//< The error-trace printer is defined only with `std/sys`, so an entry point calling it anyway is
//< a raw C compiler error (`find_backtrace_symbol` in `ksplc/sema/type/env.kspls` decides).
//< Caution: **Do not add an import.** Even `std/io` does not bring it, and it hides what is tested.
// EXPECT: [Kanso] Error: main() failed with code 3
// EXPECT-NOT: stack backtrace

fn inner(): I32?Sz
  throw Sz::3

fn main(): I32?Sz
  return inner()?

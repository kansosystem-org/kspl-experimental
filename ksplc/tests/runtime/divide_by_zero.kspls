//< When a divisor known only at run time is 0, the program must stop instead of dividing
//<
//< Sema rejects a divisor known to be 0 (tests/negative/divide_by_zero.kspls), which cannot notice
//< a run-time zero getting through.
//< Caution: The divisor must be **decided at run time**, or the test never reaches its check.
// EXPECT: panic: division by zero
// EXPECT: at ksplc/tests/runtime/divide_by_zero:
// EXPECT-NOT: must not get here
import "std/io"
import "std/sys"

fn main(): I32
  // The only argument is the executable's name, so this is 0.
  d: = I32::sys.args().len - 1
  io.out().s("about to divide by \{I64::d\}\n")
  q: I32 = 7 / d
  io.out().s("must not get here: \{q\}\n")
  return 0

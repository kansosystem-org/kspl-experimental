//< A run-time shift amount outside the width must stop the program instead of shifting
//<
//< Sema rejects a constant shift amount (tests/negative/shift_count_out_of_range.kspls); this is
//< the run-time path, whose message the code generator writes.
//< Caution: The shift amount must be **decided at run time** (why: divide_by_zero.kspls).
// EXPECT: panic: shift amount out of range (amount: 32, width: 32)
// EXPECT: at ksplc/tests/runtime/shift_amount_out_of_range:
// EXPECT-NOT: must not get here
import "std/io"
import "std/sys"

fn main(): I32
  // The only argument is the executable's name, so this is exactly U32's width = the first
  // amount out of range.
  n: = U32::(31 + sys.args().len)
  io.out().s("about to shift by \{n\}\n")
  shifted: U32 = 1U32 << n
  io.out().s("must not get here: \{shifted\}\n")
  return 0

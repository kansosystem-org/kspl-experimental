//< A binding typed with a written function type, set from an anonymous function on the same line
//<
//< **A name, a `:` and `fn` read as a label before a block**, so the anonymous function's block
//< got no `;` after it and the next line was a syntax error. Only `for`, `switch` and `if` follow
//< a label (`labelled_heads` in `../../parse/layout.kspls`).
import "std/io"

fn main(): I32
    p: fn(x: I32): Bool = fn(x: I32): Bool
        return x > 2
    outer: for $i: = 0; i < 3; i += 1
        if p(i)
            break outer
    io.out().s("\{p(3)\}\n")
    return 0

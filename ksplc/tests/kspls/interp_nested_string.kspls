//< A string written inside an interpolation, raw or plain, is a string of its own
//<
//< **Read as the end of the string around it**, the quote left a raw string seemingly open, so
//< the line got no `;` and the next line was a syntax error (`skip_interp` in
//< `../../parse/layout.kspls`).
import "std/io"

fn main(): I32
    io.out().s("\{"""ab""".len\} \{"c\"d".len\}\n")
    io.out().s("done\n")
    return 0

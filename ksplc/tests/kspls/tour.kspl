//< The one program the tour walks through, written with braces and `;`
//<
//< Each declaration below is one step of the walk, and its `//<` run is that step's prose. The
//< order is the reader's, not the file's convenience, so the smallest things come first and `main`
//< puts them together at the end.
//< Caution: **It must be the same program as the `tour.kspls` beside it.** Only the spelling
//< differs; the C put out must agree as well. What matches them is `make test-kspls`.
//< **Write both by hand.** Convert one and place it and the converter's error becomes "the right
//< answer" as it stands, so the check looks at nothing (Principle 8 in `docs/DESIGN.md`).
import "std/ds" { List };
import "std/io";
import "std/mem" { Arena };
import "std/str" { Str_builder };
import "std/strfmt" as _strfmt; // the route reaching `\{x\}`'s `fmt`; `_` asks for no `strfmt.`

priv const limit: Sz = 4; //< A name for a value, and why the type is written
  //<
  //< **A `const` cannot be assigned to.** The type (`Sz`, a size) is written out rather than
  //< inferred, because a top-level name is the file's interface and a reader of another file has
  //< only this line to go on. Inside a function the type may be left off.

priv fn greet(who: U8[]) { //< Saying something, and what a function looks like
  //<
  //< **`io.out()` returns the writer for the terminal**, and `.s(…)` sends a string to
  //< it. A parameter's type comes after its name. This one returns nothing, so no return type is
  //< written.
  io.out().s("hello, ").s(who).s(".\n");
}

priv fn count_up(n: Sz): Sz { //< A binding that changes, and the three shapes of a loop
  //<
  //< **A binding is immutable unless it opens with `$`.** `for a; b; c` counts, `for x in …` walks
  //< what it is given, and a bare `for` goes round until something stops it. `continue` takes the
  //< next turn; `else if` and `else` chain as they read.
  $total: Sz = 0;
  for $i: Sz = 0; i < n; i += 1 {
    if i % 2 == 0 {
      total += i;
    } else if i == 3 {
      total += 10;
    } else {
      continue;
    }
  }
  return total;
}

priv struct Point { //< Values laid side by side
  //<
  //< **A struct is its fields and nothing else** — no hidden header, no method table. It is built
  //< with `Point::{ .x = …, .y = … }`, and where the type is already known the name can be left
  //< off (`p: Point = ::{ … }`).
  x: I32;
  y: I32;
}

impl Point { //< Methods of one's own
  //<
  //< **The receiver is written out**, so whether a method may rewrite the value is read off its
  //< signature: `Self@` is a pointer that only reads, `Self$@` one that may write. `p.moved(2)`
  //< passes `p` as `r`. A type's own function is reached with the same `.`, as a module's is
  //< (`Arena.new(…)`, `io.out()`): **`::` is never a path** — it builds a value (`Point::{ … }`) or
  //< casts one (`I32::n`).
  fn moved(r: Self@, by: I32): Point {
    return Point::{ .x = r.x + by, .y = r.y + by };
  }
}

trait Sized_thing { //< What a type promises
  //<
  //< **A trait is a row of signatures.** Whoever asks for a `Sized_thing` may call `area` and
  //< knows nothing else about the value. `Self` stands for whichever type keeps the promise.
  fn area(r: Self): I32;
}

impl Point: Sized_thing { //< Keeping the promise
  //<
  //< **The promise is kept in a block of its own**, named for the trait. Leave a signature out and
  //< the compiler refuses here, at the place that claimed to keep it, rather than at the call.
  fn area(r: Self@): I32 {
    return r.x * r.y;
  }
}

priv struct Span { //< Saying what a thing is, behind it
  //<
  //< **A description stands behind what it describes, on that thing's own line, marked `//<`**:
  //< a field's on the field, a parameter's on the parameter, the whole's on the opening line. The
  //< first line is the summary an editor's hover and `ksplc doc` open with; a `//<` with
  //< nothing after it parts it from the detail. **`///` and `//!` are not read**: elsewhere they
  //< point at the next thing and at the enclosing one, so the compiler warns rather than guess.
  from: Sz; //< where it begins
  to: Sz; //< just past where it ends
}

priv enum Shade { //< One of a few, and a variant that carries something
  //<
  //< **A variant may carry values**, so `mid(level: I32)` is "mid, and how mid". An enum is not a
  //< number: there is no arithmetic on it, and a value not listed cannot be made.
  dark;
  mid(level: I32);
  light;
}

priv fn shade_name(s: Shade): U8[] { //< Reading an enum with `switch`
  //<
  //< **A `case` binds what its variant carries** — `.mid(level)` names the payload for that arm
  //< alone. `default` takes the rest. The `if … else` here is the expression form: it stands where
  //< a value is wanted, not where a statement is.
  switch s case .dark {
    return "dark";
  } case .mid(level) {
    return "mid" if level > 0 else "mid0";
  } default {
    return "light";
  }
}

priv fn twice_of<|T|>(v: T, add: fn(a: T, b: T): T): T { //< A generic, and a function handed over
  //<
  //< **`<|T|>` is a type the caller chooses**, and it is chosen at the call (`twice_of<|I32|>`).
  //< The second parameter is a function value: its type is its signature, so anything of that
  //< shape may be passed.
  return add(v, v);
}

priv fn add_i32(a: I32, b: I32): I32 {
  return a + b;
}

priv enum Step_error { //< An error is a value, and it is listed
  //<
  //< **What a function may fail with is an enum like any other.** A caller can `switch` on it, so
  //< there is nothing to match on a message or a number.
  too_far;
}

priv fn step(n: I32): I32?Step_error { //< Failing, and a return type that says so
  //<
  //< **`I32?Step_error` reads "an `I32`, or a `Step_error`".** The failure is in the signature, so
  //< a caller cannot ignore it by accident — there is no road that quietly returns 0.
  if n > 100 {
    throw Step_error.too_far;
  }
  return n + 1;
}

priv fn step_twice(n: I32): I32?Step_error { //< Passing a failure on with `?`
  //<
  //< **A `?` says "or give up here and hand the failure to my caller".** It needs this function to
  //< be able to fail too, which its return type says. On the indentation side a `?` at a line's
  //< end does not carry the line on.
  once: = step(n)?;
  return step(once)?;
}

priv fn pick_builder(ok: Bool): Str_builder?Step_error { //< `defer`, right below what it cleans up
  //<
  //< **`defer` runs when the block ends, however it ends.** It takes one statement that names what
  //< it cleans up (`defer b.free();` in `main` below), so it sits on the line after the binding; a
  //< cleanup of more than one statement goes in a block. A bare `.free()` has nothing in front of
  //< it and is refused.
  if !ok {
    throw Step_error.too_far;
  }
  return Str_builder.new();
}

priv fn note(on: Bool) { //< Leaving early
  //<
  //< **A line holding `return` alone ends the function.** A value always starts on the `return`'s
  //< own line, so a line below is never read as one; a long value is split inside parentheses.
  if !on {
    return;
  }
  seen += 1;
}

priv fn tally(s: Shade) { //< Where the braces have to stay
  //<
  //< **A block holding a comment and nothing else cannot be written by indentation**, since a
  //< comment makes no step, so that arm keeps its braces on both sides. Here the `case` that
  //< follows comes behind the `}`.
  switch s case .dark {
    seen += 1;
  } case .mid(_level) {
    // A variant that is not counted. As a sample it holds no content.
  } default {
    seen += 2;
  }
}

priv $seen: Sz = 0; //< A global, and why there is one here
  //<
  //< **A top-level `$` is mutable for the whole program.** It is here so the steps above have
  //< somewhere to leave a mark; a program of your own is better off handing the count along than
  //< reaching for one of these.

priv fn gather(arena: Arena$@): List<|U8[]|> { //< Where memory comes from, and leaving two loops
  //<
  //< **An arena hands out memory and takes it all back at once**, so a `List` built on one is let
  //< go with it and nothing is freed one by one. A label on a `for` lets `break` name which loop
  //< it leaves.
  $out: = List<|U8[]|>.new(arena);
  for w in U8[][]::{ "a", "b", "c" } {
    out.push(w);
    seen += 1;
  }
  outer: for {
    for k in Range.asc(limit) {
      if k == 2 {
        break outer;
      }
    }
  }
  return out;
}

fn main(): I32 { //< Putting it together
  //<
  //< **`main` is where a program starts, and what it returns is the exit code.** `catch` takes the
  //< failure a `?`-returning call may return: with a value after it, that value is used; with
  //< a block, the block runs and `fallback` gives the value. `\{…\}` puts a value into a
  //< string.
  arena: = Arena.new(1024 * 1024);
  defer arena.free();
  greet("Kanso");
  p: Point = ::{ .x = 3, .y = 4 };
  span: Span = ::{ .from = 2, .to = 5 };
  moved: = p.moved(2);
  ok: = step(9) catch 0;
  bad: = step(999) catch {
    io.out().s("step refused.\n");
    fallback -1;
  };
  // **A handler names the error.** The line is written past the width on purpose and still is not
  // closed on `catch <name>`: broken there, the handler lands at the block's own column and is
  // read as its first statement ("The formatting settings (`--style`)" in `ksplc/docs/SPEC-
  // tools.md`).
  far: =
    step(1000 + moved.x + moved.y + p.x + p.y + p.area() + moved.area() + p.moved(1).x) catch refusal_reason {
    switch refusal_reason case .too_far {
      io.out().s("too far.\n");
    }
    fallback -2;
  };
  $b: = pick_builder(true) catch {
    io.out().s("the place to assemble into could not be taken.\n");
    fallback Str_builder.new();
  };
  defer b.free();
  b.s("held");
  note(true);
  note(false);
  tally(Shade.dark);
  tally(Shade.mid(1));
  words: = gather(arena);
  // **It carries a label.** A block with no heading cannot be told from a continuation of the
  // statement before it, so a bare `{ … }` is writable in neither notation.
  while_locked: {
    io.out().s("a labelled block passes too.\n");
  }
  defer io.out().s("defer comes out last.\n");
  io.out().s("area=\{p.area()\} moved=(\{moved.x\},\{moved.y\})\n");
  io.out().s("span=\{span.to - span.from\}\n");
  io.out().s("shade=\{shade_name(Shade.mid(1))\}/\{shade_name(Shade.dark)\}\n");
  io.out().s("step=\{ok\}/\{bad\}/\{far\} twice=\{twice_of<|I32|>(5, add_i32)\}\n");
  io.out().s("count=\{count_up(6)\} words=\{words.len\} seen=\{seen\} b=\{b.slice()\}\n");
  io.out().s("twice=\{step_twice(1) catch -1\}/\{step_twice(999) catch -1\}\n");
  return 0;
}

//< Immutable arrays: what reading, copying and emitting one must keep
//<
//< An element of a `const` array is the immutable form of its type (`const_of(T)`). Each route
//< below once stopped at that mark where it had to look past it. There was no diagnostic on the
//< KSPL side: only the C or the LLVM build failed.
import "std/str" { Str_builder }
import "std/verdict"

// ==========================================
// A variable holding a value **copied** from an immutable one is writable. In `$x: = c[i]` the new
// binding is writable, or genc writes `const T x` and C rejects the assignment (copy_value_type in
// `sema/type/query.kspl`).
// Caution: **Do not test only the annotated shape.** It uses the declared type as it is, and it
// passes even with the inference path broken.
// ==========================================
priv const WORDS: U8[][3] = ::{ "alpha", "beta", "gamma" }
priv const LEFT: I64[3] = ::{ 1, 2, 3 }
priv const RIGHT: I64[3] = ::{ 10, 20, 30 }

fn test_const_copy_binding()
    verdict.start("[sema] a binding copied from an immutable value is writable test...")
    // Make a mutable binding by inference alone, and assign to it later.
    $w: = WORDS[1]
    assert(w.equals("beta"), "the copy must start as the element it was made from")
    w = WORDS[0]
    assert(w.equals("alpha"), "a mutable binding copied from a const element must be assignable")
    // A ternary assigns to a temporary from its branches, both immutable arrays.
    pick: = WORDS[0].len == 5
    chosen: = LEFT if pick else RIGHT
    assert(chosen[0] == 1I64, "a conditional over const arrays must copy the chosen one")
    // The copied array is writable (the owner decides its elements' immutability).
    $mine: = LEFT
    mine[0] = 99I64
    assert(mine[0] == 99I64 && LEFT[0] == 1I64, "writing the copy must not touch the original")
    verdict.pass("")

// ==========================================
// A row or an element of an immutable array, copied out, has the type a written one gives.
// `r: I32[_] = m[1]` takes its length from the row (a field of array type too). `P::ps[1]` is
// a copy of a `P`. Each is the immutable form of its type. Compared with that mark, both were
// refused (`apply_type_coercion` in sema/body/coerce.kspl, `infer_cast_postfix` in
// sema/body/postfix.kspl).
// ==========================================
priv struct Row_of_three //< a field of array type, read through an immutable value
    a: I32[3]

fn test_inferred_length_from_a_row()
    verdict.start("[sema] a '[_]' length taken from an immutable row or a field test...")
    m: I32[3][2] = ::{::{ 1, 2, 3 }, ::{ 4, 5, 6 } }
    r: I32[_] = m[1]
    $w: I32[_] = m[0]
    w[0] = 10
    h: = Row_of_three::{ .a = ::{ 7, 8, 9 } }
    q: I32[_] = h.a
    assert(r[2] == 6 && q[0] == 7, "'[_]' must copy the row and the field it is set to")
    assert(w[0] == 10 && m[0][0] == 1, "writing the copy must not touch the original row")
    assert(sizeof(r) == sizeof(I32[3]) && sizeof(q) == sizeof(I32[3]),
        "'[_]' must take the length 3 from the row and the field")
    verdict.pass("")

fn test_cast_of_an_element_to_its_own_type()
    verdict.start("[sema] a cast of an immutable element to its own type test...")
    p: = Pair::PAIRS[1]
    m: I32[3][2] = ::{::{ 1, 2, 3 }, ::{ 4, 5, 6 } }
    $row: = I32[3]::m[1]
    row[0] = 40
    assert(p.a == 0.5, "the cast must copy the struct element")
    assert(row[0] == 40 && row[2] == 6 && m[1][0] == 4,
        "the cast copy of a row is writable and leaves the original alone")
    verdict.pass("")

// ==========================================
// An immutable `F32` array holds the values as written. An LLVM `float` constant must round-trip
// exactly through its decimal form. `0.85` does not (format_f32_hex_literal in
// gen/llvm/ctx.kspl writes it in hexadecimal). An element is `const_of(F32)`, so **a plain `F32`
// constant never reaches this case** (emit_llvm_const_float in gen/llvm/decl.kspl).
// Caution: **Do not list only values that round-trip** (`1.0` and `0.5` pass in decimal too).
// ==========================================
priv const SCALES: F32[6] = ::{ 2.0, 1.5, 1.25, 1.0, 0.875, 0.85 } //<
    //< Values that round-trip and values that do not, mixed
priv struct Pair //< an F32 inside a struct is the same route
    a: F32
    b: F32
priv const PAIRS: Pair[2] = ::{ Pair::{ .a = 0.1, .b = 0.85 }, Pair::{ .a = 0.5, .b = 3.14 } }
priv const SEPARATED: F32[2] = ::{ 1_000.5, 2_500.25F32 } //<
    //< A `_` separator and a type suffix are removed before the value is read

fn test_a_const_float_array_keeps_its_values()
    verdict.start("[genllvm] an immutable F32 array keeps its values test...")
    // Caution: **Compare against the value rounded to F32** (compared as F64, 0.85 does not match).
    assert(SCALES[0] == 2.0F32 && SCALES[3] == 1.0F32, "a round-tripping value stays as it is")
    assert(SCALES[4] == 0.875F32, "a fraction that is a power of two stays as it is")
    assert(SCALES[5] == F32::0.85, "a value that does not round-trip is held as written too")
    assert(SCALES[1] > SCALES[2] && SCALES[2] > SCALES[3], "the order is not broken")
    assert(PAIRS[0].b == F32::0.85 && PAIRS[1].b == F32::3.14, "the same holds inside a struct")
    assert(PAIRS[0].a == F32::0.1, "0.1 is held as written too")
    assert(SEPARATED[0] == 1000.5F32 && SEPARATED[1] == 2500.25F32,
        "a separator or a suffix does not cut the value short")
    verdict.pass("an F32 that does not round-trip in decimal is held as the value written too.")

// ==========================================
// A float constant computed from others folds on LLVM as C's compiler folds it for genc
// (`fold_float` in `ksplc/gen/llvm/decl.kspl`); LLVM refused `pi * 2.0` and `I32::2.9`.
// ==========================================
priv const FOLD_PI: F64 = 3.25
priv const FOLD_TWICE: F64 = FOLD_PI * 2.0
priv const FOLD_THIRD: F64 = 1.0 / 3.0
priv const FOLD_NEG: F64 = -(FOLD_PI - 0.25)
priv const FOLD_DOWN: I32 = I32::2.9
priv const FOLD_DOWN_NEG: I32 = I32::(-2.9)
priv const FOLD_UP: F64 = F64::3
priv const FOLD_SMALL: F32 = 1.5F32 / 3.0F32
priv const FOLD_TABLE: F64[2] = ::{ FOLD_PI * 2.0, FOLD_THIRD }

fn test_a_computed_float_constant_folds()
    verdict.start("[genllvm] a float constant computed from others folds test...")
    assert(FOLD_TWICE == 6.5 && FOLD_NEG == -3.0 && FOLD_UP == 3.0, "arithmetic and a cast fold")
    assert(FOLD_THIRD == 1.0 / 3.0, "a division rounds as at run time")
    assert(FOLD_DOWN == 2 && FOLD_DOWN_NEG == -2, "a float cast to an integer truncates toward zero")
    assert(FOLD_SMALL == 0.5F32, "an F32 folds at F32")
    assert(FOLD_TABLE[0] == 6.5 && FOLD_TABLE[1] == FOLD_THIRD, "inside an array as well")
    verdict.pass("each computed float constant holds the value C's fold gives.")

// ==========================================
// A top-level `const` array follows its element's struct type. Genc strips the qualifier to see the
// dependency, or C fails with `array has incomplete element type` ("Genc orders its type
// definitions after stripping immutability marks" in ksplc/docs/DESIGN-backends.md).
// ==========================================
struct Const_row
    name: U8[]
    n: I32

priv const CONST_ROWS: Const_row[_] = ::{
    ::{ .name = "a", .n = 1 },
    ::{ .name = "b", .n = 2 },
}

fn test_const_struct_array()
    verdict.start("[genc] a top-level immutable const struct array test...")
    $total: I32 = 0
    for row in CONST_ROWS
        total += row.n
    assert(total == 3, "a top-level const array of structs must be readable")
    assert(CONST_ROWS[0].name.equals("a"), "element fields must survive the emission order")
    verdict.pass("")
fn test_multi_dim_array() //< that multi-dimensional fixed-length arrays share one struct tag in C
    //<
    //< Caution: **Choose the tag only after stripping every level of the element's immutable
    //< qualifier** (gen/c/decl.kspl). Test both an immutable binding and a mutable one. The
    //< mutable one has a different type id, without the qualifier, so with only one the two names
    //< never meet.
    verdict.start("[genc] a multi-dimensional fixed-length array test...")
    grid: I32[2][3] = ::{::{ 1, 2 }, ::{ 3, 4 }, ::{ 5, 6 } }
    $sum: I32 = 0
    for row in grid
        sum += row[0] + row[1]
    assert(sum == 21, "a 2-D array must be iterable and indexable")

    $mut_grid: I32[2][3] = grid
    mut_grid[0][0] = 10
    assert(mut_grid[0][0] == 10, "a writable binding must accept element writes")
    assert(grid[0][0] == 1, "copying into another binding must not alias the source")

    // A slice element takes the same path (`Const_U8_Slice`).
    names: U8[][2][2] = ::{::{ "a", "b" }, ::{ "c", "d" } }
    $joined: = Str_builder.new()
    defer joined.free()
    for pair in names
        joined.s(pair[0]).s(pair[1])
    assert(joined.slice().equals("abcd"), "a 2-D array of slices must keep its elements")
    verdict.pass("one C struct tag is shared even in multiple dimensions.")

// ==========================================
// A struct holds an enum by value and that enum's payload holds **a slice of the first struct**.
// A descriptor needs only a forward declaration of the element; **treating it as needing the full
// definition makes a false cycle** (`Cyc_row` → `Cyc_kind` → `Cyc_row`).
// ==========================================

struct Cyc_row //<
    //< The struct half of a struct and an enum pointing at each other through a slice
    //<
    //< **Building the array** is the point (only it needs the wrapper), so the payload is built at
    //< run time. A payload written into a `const` is `tests/prog/equiv_shapes.kspl`'s, on both
    //< backends.
    name: U8[]
    kind: Cyc_kind

enum Cyc_kind
    leaf
    branch(rows: Cyc_row[])

fn test_struct_enum_slice_cycle()
    verdict.start("[genc] a struct and an enum pointing at each other test...")
    leaves: Cyc_row[2] = ::{::{ .name = "x", .kind = .leaf }, ::{ .name = "y", .kind = .leaf } }
    root: Cyc_row = ::{ .name = "r", .kind = .branch(Cyc_row[]::leaves) }
    $names: = Str_builder.new()
    defer names.free()
    names.s(root.name)
    switch root.kind
    case .branch(sub)
        for leaf in sub
            names.c('/').s(leaf.name)
    default {}
    assert(names.slice().equals("r/x/y"), "a struct/enum cycle through a slice must emit in order")
    verdict.pass("")

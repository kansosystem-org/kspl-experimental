//< The accepted shapes sitting right next to the shapes `tests/negative/` rejects
//<
//< **The negative tests alone are not enough**: they cannot show rejecting too much, so these must
//< **run correctly**.
//< Caution: For a new boundary, pair the rejected shape (`tests/negative/`) with the accepted one
//< (here).
import "std/verdict"

// A function value taken as an argument may be wrapped in a struct and returned.
// **This is the shape of a lazy chain**: the middle holds a predicate and allocates nothing.
priv struct Bind_where
    src: I32[]
    pred: Callable1<|I32, Bool|>
priv struct Bind_map
    inner: Bind_where
    f: Callable1<|I32, I32|>

impl Bind_where
    priv fn map_with(r: Self, f: Callable1<|I32, I32|>): Bind_map
        return Bind_map::{ .inner = r, .f = f }

impl Bind_map
    priv fn total(r: Self@): I32 //< the terminal
        $s: I32 = 0
        for i in Range.asc(r.inner.src.len)
            v: = r.inner.src[i]
            if r.inner.pred.call(v)
                s += r.f.call(v)
        return s

priv fn keep_where(src: I32[], p: Callable1<|I32, Bool|>): Bind_where
    return Bind_where::{ .src = src, .pred = p }

fn test_closure_wrapped_in_struct()
    verdict
        .start("[Lang] a function value taken as an argument can be wrapped and returned test...")
    xs: I32[8] = ::{ 1, 5, 2, 9, 3, 7, 4, 8 }
    sl: = I32[]::xs
    bound: = 4
    factor: = 10
    chained: = keep_where(sl, fn(x: I32; bound: I32): Bool {
        return x > bound;
    }).map_with(fn(x: I32; factor: I32): I32 {
        return x * factor;
    })
    // Caution: **Call another function after building the chain.** If the environment were on the
    // callee's frame, this call would overwrite it and the answer would change.
    spacer: = keep_where(sl, fn(x: I32; bound: I32): Bool {
        return x < bound;
    }).map_with(fn(x: I32; factor: I32): I32 {
        return x + factor;
    })
    assert(spacer.total() == 36,
        "the disturber's side: under 4 is 1,2,3, and 10 added to each makes 36")
    assert(chained.total() == 290, "(5+9+7+8)*10 = 290. The environment lives on the caller's frame")
    verdict
        .pass("a function value taken as an argument keeps its environment alive even wrapped in a \
            struct and returned (the lazy-chain shape).")

// A closure or a frame's slice can be stored where the frame keeps it. A function pointer goes
// into a global. A closure the caller built is stored through the caller's pointer. The check
// refuses only a value this frame made, stored where it outlives the frame
// (`tests/negative/closure.kspl`, `tests/negative/pointer.kspl`).
priv struct Frame_kept
    c: Callable1<|I32, I32|>?
    s: I32[]

priv $stored_fn: fn(x: I32): I32

priv fn install(k: Frame_kept$@, c: Callable1<|I32, I32|>)
    k.c = .some(c)

fn test_frame_store_kept_inside()
    verdict.start("[Lang] a closure or a frame's slice stored inside the frame test...")
    n: = 5
    xs: I32[3] = ::{ 1, 2, 3 }
    $k: Frame_kept = ::{ .c = .none }
    k.c = .some(fn(x: I32; n: I32): I32 {
        return x + n;
    })
    k.s = I32[]::xs
    $other: Frame_kept = ::{ .c = .none }
    install(other@, fn(x: I32; n: I32): I32 {
        return x - n;
    })
    stored_fn = fn(x: I32): I32
        return x * 2
    $got: I32 = 0
    if c: = k.c
        got += c.call(1)
    if c: = other.c
        got += c.call(10)
    got += stored_fn(4) + k.s[2]
    assert(got == 22, "6 from the local struct's closure, 5 from the installed one, 8 and 3")
    verdict
        .pass("a closure and a slice stored into a local, a closure installed through the caller's \
            pointer, and a function pointer stored into a global all run.")

// ==========================================
// The operators that apply to `Bool`, over every combination. The refused ones are
// `tests/negative/bool_arithmetic.kspl`, which alone stays green if `&` is refused too.
// Why these stay: `== != < > <= >=` match Rust's `bool: Ord`, and `& | ^` match Java's logical
// operators that do not short-circuit.
// ==========================================
priv const LEFTS: Bool[4] = ::{ false, false, true, true } //< every combination of true and false
    //<
    //< With only one side varied, swapping `&` and `|` would pass.
priv const RIGHTS: Bool[4] = ::{ false, true, false, true }

fn test_bool_operators()
    verdict.start("[Genc] the operators kept on `Bool` test...")
    for i in Range.asc(4)
        a: = LEFTS[i]
        b: = RIGHTS[i]
        // The short-circuiting and the non-short-circuiting forms agree.
        assert((a && b) == (a & b), "Bool ops: '&' must agree with '&&'")
        assert((a || b) == (a | b), "Bool ops: '|' must agree with '||'")
        assert((a ^ b) == (a != b), "Bool ops: '^' must agree with '!='")
        // Equality and ordering. The ordering is false < true (as numbers, 0 < 1).
        assert((a == b) == !(a != b), "Bool ops: '==' and '!=' must be opposites")
        assert((a < b) == (!a && b), "Bool ops: '<' must order false before true")
        assert((a > b) == (a && !b), "Bool ops: '>' must order true after false")
        assert((a <= b) == ((a < b) || (a == b)), "Bool ops: '<=' must be '<' or '=='")
        assert((a >= b) == ((a > b) || (a == b)), "Bool ops: '>=' must be '>' or '=='")
        // The compound forms of `& | ^` stay, as the binary ones do (`/=` and the like are
        // refused: the case compound_assign_operands in tests/negative/numbers.kspl).
        $c: = a
        c &= b
        assert(c == (a & b), "Bool ops: '&=' must agree with '&'")
        c = a
        c |= b
        assert(c == (a | b), "Bool ops: '|=' must agree with '|'")
        c = a
        c ^= b
        assert(c == (a ^ b), "Bool ops: '^=' must agree with '^'")
        // Negation is `!` (`-` and `~` are rejected).
        assert(!(!a) == a, "Bool ops: '!' must be its own inverse")
        // **What to write instead of `b1 + b2`**: a conversion to a number.
        assert(I32::a + I32::b == (1 if a else 0) + (1 if b else 0),
            "Bool ops: 'I32::flag' must convert for counting")
    verdict
        .pass("the logical, the bit, the equality, the ordering, the negation and the conversion \
            for counting are all there.")

priv fn shift_by(start: U8, by: I32): U8 //< `<<=` with an amount of another type than the place
    $v: = start
    v <<= by
    return v

fn test_compound_takes_binary_operands()
    verdict.start("[Genc] a compound assignment's operands test...")
    // The rejected side is the case compound_assign_promotes in tests/negative/numbers.kspl.
    assert(shift_by(1, 3) == 8, "compound: '<<=' must take an 'I32' amount on a 'U8', as '<<' does")
    $wide: I64 = 1
    small: I32 = 41
    wide += small
    assert(wide == 42, "compound: '+=' must widen the right-hand side to the place's type")
    $lo: I8 = 5
    lo -= -1
    assert(lo == 6, "compound: an untyped literal must take the place's type")
    // An unsigned negation is written as the wrapping subtraction (the case
    // unsigned_unary_minus in tests/negative/numbers.kspl).
    u: U32 = 5
    assert(0 - u == 4294967291U32, "compound: '0 - u' must wrap on an unsigned type")
    verdict.pass("'a op= b' takes the operands 'a = a op b' takes, a shift amount its own type.")

//< The shapes the backend-equivalence program checks that C leaves open or lays out its own way
//<
//< The evaluation order, tagged unions in arrays and globals, nested `#align(N)` and `#packed`
//< layout, and 16-bit products, each a function `equiv.kspl`'s `main` calls with the builder,
//< with the declarations it alone reads.
import "std/mem"
import "std/str" { Str_builder }

priv enum Ev //< a tagged union whose variants differ in size, kept in arrays and globals
    none
    one(a: U8)
    two(a: I64, b: U8)

priv enum Ev_arr //< a payload holding a fixed-size array, assigned as a whole value
    //<
    //< Caution: **Keep the reassignment**: C refuses to assign a value whose member is `const`, so
    //< a payload array emitted with read-only elements breaks only there.
    none
    pair(v: I32[2])

impl Ev
    priv fn tag_of(r: Self@): I32 //< a switch on `r$` of a read-only receiver, which is marked
        switch r$
        case .none
            return 0
        case .one
            return 1
        case .two
            return 2

priv fn bool_word(b: Bool): U8[] //< a switch on a Bool, both values named and no default
    switch b
    case true
        return "yes"
    case false
        return "no"

impl Ev_arr
    priv fn flip(r: Self$@)
        switch r$
        case .pair(v)
            r$ = .pair(::{ v[1], v[0] })
        case .none {}

priv struct Ev_row
    priv k: U8
    priv e: Ev

priv const g_evs: Ev[3] = ::{ .none, .one(200), .two(-7, 9) } //<
    //< A global holding tagged unions, which LLVM cannot fill through their named type
    //<
    //< Caution: **Keep variants of different sizes, an `I64` among them, and one inside a struct.**
    //< genllvm lays such a value out as packed bytes; one shape alone hides a misplaced payload.
priv const g_ev_rows: Ev_row[2] = ::{::{ .k = 1, .e = .two(5, 6) },
    ::{ .e = .one(7), .k = 2 } }
priv $g_ev_mut: Ev = .two(3, 4)

// A side effect that shows the evaluation order. The call order is recorded as digits (12 where 1
// came first, 21 where 2 did).
priv $eval_log: I32 = 0
priv $eval_arr: I32[4] = ::{}

priv fn eval_idx(): Sz
    eval_log = eval_log * 10 + 1
    return 0

priv fn eval_val(): I32
    eval_log = eval_log * 10 + 2
    return 9

priv fn eval_a(): I32
    eval_log = eval_log * 10 + 1
    return 1

priv fn eval_b(): I32
    eval_log = eval_log * 10 + 2
    return 2

priv fn eval_take(x: I32, y: I32): I32
    return x * 10 + y

priv fn eval_set(v: I32): I32 //< it overwrites the log, so a read of the log before it shows
    eval_log = v
    return v

priv struct Eval_pair
    priv a: I32
    priv b: I32

impl Eval_pair
    priv fn add(r: Self$@, v: I32): Eval_pair$@ //< a chain whose receiver is the call before
        r.a = r.a * 10 + v
        return r

impl Ev
    priv fn val(e: Self): I64
        switch e
        case .none
            return -1
        case .one(a)
            return a
        case .two(a, b)
            return a * 1000 + b

fn tagged_union_lines(b: Str_builder$@) //< tagged unions in array literals and in globals
    //<
    //< An element of a `const` array carries the immutability mark, which both backends once took
    //< for another type: C named `Const_Ev`, LLVM read every element as the first variant.
    locals: Ev[3] = ::{ .none, .one(200), .two(-7, 9) }
    $muts: Ev[2] = ::{ .two(1, 2), .none }
    muts[1] = .one(3)
    b.s("evs=")
    for e in locals
        b.s("\{e.val()\},")
    for e in muts
        b.s("\{e.val()\},")
    for e in g_evs
        b.s("\{e.val()\},")
    for row in g_ev_rows
        b.s("\{row.k\}:\{row.e.val()\},")
    b.s("\{g_ev_mut.val()\}")
    g_ev_mut = .one(8)
    b.s("/\{g_ev_mut.val()\}")
    $pair: = Ev_arr.pair(::{ 1, 2 })
    pair.flip()
    switch pair
    case .pair(v)
        b.s("/\{v[0]\}\{v[1]\}")
    case .none {}
    pair = .none
    b.s("/\{pair\}")
    copy: = locals[2]
    b.s("/\{locals[1].tag_of()\}\{copy.tag_of()\}/").s(bool_word(muts.len > 1))
        .s(bool_word(false)).s("\n")

fn eval_order_lines(b: Str_builder$@) //< the evaluation order, a line per group of shapes
    //<
    //< The order is "Evaluation order" in docs/SPEC-language.md.
    // Caution: **Put an expression with a side effect on both sides of an assignment.** C does not
    // define the order of an assignment's left and right sides, so without them a shape that gives
    // different answers under clang and gcc passes.
    eval_log = 0
    eval_arr[eval_idx()] = eval_val()
    b.s("evalorder=\{eval_log\}")
    eval_log = 0
    eval_arr[eval_idx()] += eval_val()
    b.s("/\{eval_log\}")
    eval_log = 0
    b.s("/\{eval_take(eval_a(), eval_b())\}/\{eval_log\}\n")
    // Caution: **Read a variable before a call that writes it, and give each shape its own line.**
    // gcc takes a call's arguments from the right and clang from the left, and an operator's sides
    // and a compound literal's fields are just as open in C, so each shape needs both compilers.
    eval_log = 3
    read_first: = eval_take(eval_log, eval_set(4))
    eval_log = 3
    sum_first: = eval_log * 10 + eval_set(4)
    eval_log = 0
    pair: = Eval_pair::{ .a = eval_a(), .b = eval_b() }
    b.s("evalread=\{read_first\}/\{sum_first\}/\{pair.a\}\{pair.b\}/\{eval_log\}\n")
    $chain: = Eval_pair::{ .a = 0, .b = 0 }
    eval_log = 0
    _chained: = chain.add(eval_a()).add(eval_b())
    b.s("evalchain=\{chain.a\}/\{eval_log\}")
    eval_log = 0
    b.s("/\{eval_a()\}\{eval_b()\}/\{eval_log\}\n")

#align(16)
priv struct Aligned16 //< a struct whose `#align(N)` its single field does not show
    priv a: U8

priv struct Aligned_holder //< it, nested: LLVM lays a struct out by its fields' own alignments
    //<
    //< Caution: **Measure the offsets at run time, and write through the nested one.** The fold
    //< answers from ksplc's layout either way, and a `zero(…, sizeof(Aligned16))` overran the next
    //< field on LLVM, whose type held the struct as one byte.
    priv x: U8
    priv al: Aligned16
    priv y: U32
    priv rows: Aligned16[2]

priv enum Narrow_tag: U8 //< a tagged union with a one-byte tag, which C held as an `int`
    one(a: U8)
    two(b: U8, c: U8)
    wide(p: U8, al: Aligned16) //< a payload aligned past 8, behind a field of its own

priv const g_aligned: Aligned_holder = ::{ .x = 1, .al = ::{ .a = 2 }, .y = 3 }
priv const g_narrow: Narrow_tag[2] = ::{ .two(4, 5), .wide(6, ::{ .a = 7 }) }

priv enum Layout_err: U8 //< a one-byte error, so a Result's `val` follows it closely
    bad

priv fn aligned_ok(a: U8): Aligned16!Layout_err
    if a == 0
        throw .bad
    return ::{ .a = a }

impl Narrow_tag
    priv fn sum(r: Self): I32
        switch r
        case .one(a)
            return a
        case .two(b, c)
            return b * 10 + c
        case .wide(p, al)
            return p * 10 + al.a

fn layout_lines(b: Str_builder$@) //<
    //< `#align(N)` nested, a narrow tag and `#packed`, laid out alike
    $h: Aligned_holder = ::{}
    h.y = 12345
    h.rows[1].a = 9
    mem.zero(Void$@::h.al@, sizeof(Aligned16))
    base: = Sz::h@
    b.s("aligned=\{Sz::h.al@ - base\}/\{Sz::h.y@ - base\}/\{Sz::h.rows@ - base\}/")
        .s("\{Sz::h.rows[1]@ - base\}/\{sizeof(Aligned_holder)\}/\{h.y\}/\{h.rows[1].a\}/")
        .s("\{g_aligned.al.a\}\{g_aligned.y\}")
    n: = Narrow_tag.wide(1, Aligned16::{ .a = 2 })
    b.s(" narrow=\{sizeof(Narrow_tag)\}/\{n.sum()\}/\{g_narrow[0].sum()\}/\{g_narrow[1].sum()\}")
    // A Result holding an over-aligned value: LLVM put `val` right after the error, so the stride
    // and the value's alignment differed from C's. And one of bytes alone, whose size C gives as 3.
    rs: (Aligned16!Layout_err)[2] = ::{ aligned_ok(4), aligned_ok(5) }
    got: = rs[1] catch Aligned16::{}
    b.s(" result=\{Sz::rs[1]@ - Sz::rs[0]@\}/\{sizeof(Aligned16!Layout_err)\}/")
        .s("\{(Sz::rs[0]@) % 16\}/\{got.a\}/\{sizeof(U8!Layout_err)\}\n")
    packed_lines(b)

#packed
priv struct Wire //< a wire record: `#packed` leaves every field but the first under-aligned
    //<
    //< Caution: **Reach the fields through a subscript.** The C backend fixes such a target's
    //< address first, and an aligned pointer to the field makes the store a word store, which
    //< faults on a Cortex-M0 (`make test-equiv` builds this C with C's alignment trap).
    priv tag: U8
    priv n: I32
    priv big: I64
    priv pair: Wire_pair
    priv nums: I32[2]

priv struct Wire_pair //< a struct at its own alignment, inside the packed one
    priv a: I16
    priv b: I64

#noinline
priv fn wire_fill(ws: Wire$[], i: Sz, v: I32) //< each field written and updated through `ws[i]`
    ws[i].tag = U8::i
    ws[i].n = v
    ws[i].n *= 3
    ws[i].big = I64::v << 40
    ws[i].big -= 1
    ws[i].pair = ::{ .a = I16::v, .b = I64::v * 7 }
    ws[i].pair.b += 1
    ws[i].nums[1] = v + 1

priv fn packed_lines(b: Str_builder$@) //< `#packed` fields written, updated and read by subscript
    $ws: Wire[3] = ::{}
    wire_fill(Wire$[]::ws, 1, 5)
    // The order holds through a field the subscript's receiver cannot point at.
    eval_log = 0
    ws[eval_idx() + 2].nums[eval_idx()] += eval_val()
    b.s("packed=\{sizeof(Wire)\}/\{ws[1].tag\}/\{ws[1].n\}/\{ws[1].big\}/\{ws[1].pair.a\}/")
        .s("\{ws[1].pair.b\}/\{ws[1].nums[1]\}/\{ws[2].nums[0]\}/\{eval_log\}\n")

#noinline
priv fn wrap16(u: U16, s: I16, b: Str_builder$@) //<
    //< 16-bit products, which C would compute in `int`
    $cu: = u
    cu *= u
    $cs: = s
    cs *= s
    b.s("/\{u * u\}/\{s * s\}/\{cu\}/\{cs\}")

fn wrap16_lines(b: Str_builder$@) //< 16-bit products past `int`'s range, which wrap at 16 bits
    b.s("wrap16")
    wrap16(65535, -1, b)
    wrap16(40000, 300, b)
    b.s("\n")

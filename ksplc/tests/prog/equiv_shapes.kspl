//< The shapes the backend-equivalence program checks that C leaves open or lays out its own way
//<
//< The evaluation order, tagged unions in arrays and globals, nested `#align(N)` and `#packed`
//< layout, 16-bit products, globals naming globals, locals named as a C symbol, and casts from
//< floating point to an integer. Each is a function that `equiv.kspl`'s `main` calls with the
//< builder, with the declarations it alone reads.
import "std/libc"
import "std/mem"
import "std/str" { Str_builder }

priv enum Ev //< a tagged union whose variants differ in size, kept in arrays and globals
    none
    one(a: U8)
    two(a: I64, b: U8)

priv enum Ev_arr //< a payload holding a fixed-size array, assigned as a whole value
    //<
    //< Caution: **Keep the reassignment**: C refuses to assign a value whose member is `const`, so
    //< a payload array emitted with read-only elements breaks only there.
    none
    pair(v: I32[2])

impl Ev
    priv fn tag_of(r: Self@): I32 //< a switch on `r$` of a read-only receiver, which is marked
        switch r$
        case .none
            return 0
        case .one
            return 1
        case .two
            return 2

priv fn bool_word(b: Bool): U8[] //< a switch on a Bool, both values named and no default
    switch b
    case true
        return "yes"
    case false
        return "no"

impl Ev_arr
    priv fn flip(r: Self$@)
        switch r$
        case .pair(v)
            r$ = .pair(::{ v[1], v[0] })
        case .none {}

priv struct Ev_row
    priv k: U8
    priv e: Ev

priv const G_EVS: Ev[3] = ::{ .none, .one(200), .two(-7, 9) } //<
    //< A global holding tagged unions, which LLVM cannot fill through their named type
    //<
    //< Caution: **Keep variants of different sizes, an `I64` among them, and one inside a struct.**
    //< genllvm lays such a value out as packed bytes; one shape alone hides a misplaced payload.
priv const G_EV_ROWS: Ev_row[2] = ::{::{ .k = 1, .e = .two(5, 6) },
    ::{ .e = .one(7), .k = 2 } }
priv $g_ev_mut: Ev = .two(3, 4)

// A side effect that shows the evaluation order. The call order is recorded as digits (12 where 1
// came first, 21 where 2 did).
priv $eval_log: I32 = 0
priv $eval_arr: I32[4] = ::{}

priv fn eval_idx(): Sz
    eval_log = eval_log * 10 + 1
    return 0

priv fn eval_val(): I32
    eval_log = eval_log * 10 + 2
    return 9

priv fn eval_a(): I32
    eval_log = eval_log * 10 + 1
    return 1

priv fn eval_b(): I32
    eval_log = eval_log * 10 + 2
    return 2

priv fn eval_take(x: I32, y: I32): I32
    return x * 10 + y

priv fn eval_set(v: I32): I32 //< it overwrites the log, so a read of the log before it shows
    eval_log = v
    return v

priv struct Eval_pair
    priv a: I32
    priv b: I32

impl Eval_pair
    priv fn add(r: Self$@, v: I32): Eval_pair$@ //< a chain whose receiver is the call before
        r.a = r.a * 10 + v
        return r

impl Ev
    priv fn val(e: Self): I64
        switch e
        case .none
            return -1
        case .one(a)
            return a
        case .two(a, b)
            return a * 1000 + b

fn tagged_union_lines(b: Str_builder$@) //< tagged unions in array literals and in globals
    //<
    //< An element of a `const` array carries the immutability mark. Both backends once took it
    //< for another type: C named `Const_Ev`, LLVM read every element as the first variant.
    locals: Ev[3] = ::{ .none, .one(200), .two(-7, 9) }
    $muts: Ev[2] = ::{ .two(1, 2), .none }
    muts[1] = .one(3)
    b.s("evs=")
    for e in locals
        b.s("\{e.val()\},")
    for e in muts
        b.s("\{e.val()\},")
    for e in G_EVS
        b.s("\{e.val()\},")
    for row in G_EV_ROWS
        b.s("\{row.k\}:\{row.e.val()\},")
    b.s("\{g_ev_mut.val()\}")
    g_ev_mut = .one(8)
    b.s("/\{g_ev_mut.val()\}")
    $pair: = Ev_arr.pair(::{ 1, 2 })
    pair.flip()
    switch pair
    case .pair(v)
        b.s("/\{v[0]\}\{v[1]\}")
    case .none {}
    pair = .none
    b.s("/\{pair\}")
    copy: = locals[2]
    b.s("/\{locals[1].tag_of()\}\{copy.tag_of()\}/").s(bool_word(muts.len > 1))
        .s(bool_word(false)).s("\n")

fn eval_order_lines(b: Str_builder$@) //< the evaluation order, a line per group of shapes
    //<
    //< The order is "Evaluation order" in docs/SPEC-programming-language.md.
    // Caution: **Put an expression with a side effect on both sides of an assignment.** C does not
    // define the order of an assignment's left and right sides. Without them, a shape that gives
    // different answers under clang and gcc passes.
    eval_log = 0
    eval_arr[eval_idx()] = eval_val()
    b.s("evalorder=\{eval_log\}")
    eval_log = 0
    eval_arr[eval_idx()] += eval_val()
    b.s("/\{eval_log\}")
    eval_log = 0
    b.s("/\{eval_take(eval_a(), eval_b())\}/\{eval_log\}\n")
    // Caution: **Read a variable before a call that writes it, and give each shape its own line.**
    // gcc takes a call's arguments from the right and clang from the left. An operator's sides
    // and a compound literal's fields are just as open in C, so each shape needs both compilers.
    eval_log = 3
    read_first: = eval_take(eval_log, eval_set(4))
    eval_log = 3
    sum_first: = eval_log * 10 + eval_set(4)
    eval_log = 0
    pair: = Eval_pair::{ .a = eval_a(), .b = eval_b() }
    b.s("evalread=\{read_first\}/\{sum_first\}/\{pair.a\}\{pair.b\}/\{eval_log\}\n")
    $chain: = Eval_pair::{ .a = 0, .b = 0 }
    eval_log = 0
    _chained: = chain.add(eval_a()).add(eval_b())
    b.s("evalchain=\{chain.a\}/\{eval_log\}")
    eval_log = 0
    b.s("/\{eval_a()\}\{eval_b()\}/\{eval_log\}\n")

#align(16)
priv struct Aligned16 //< a struct whose `#align(N)` its single field does not show
    priv a: U8

priv struct Aligned_holder //< it, nested: LLVM lays a struct out by its fields' own alignments
    //<
    //< Caution: **Measure the offsets at run time, and write through the nested one.** The fold
    //< answers from ksplc's layout either way, and a `zero(…, sizeof(Aligned16))` overran the next
    //< field on LLVM, whose type held the struct as one byte.
    priv x: U8
    priv al: Aligned16
    priv y: U32
    priv rows: Aligned16[2]

priv enum Narrow_tag: U8 //< a tagged union with a one-byte tag, which C held as an `int`
    one(a: U8)
    two(b: U8, c: U8)
    wide(p: U8, al: Aligned16) //< a payload aligned past 8, behind a field of its own

priv const G_ALIGNED: Aligned_holder = ::{ .x = 1, .al = ::{ .a = 2 }, .y = 3 }
priv const G_NARROW: Narrow_tag[2] = ::{ .two(4, 5), .wide(6, ::{ .a = 7 }) }

priv enum Layout_err: U8 //< a one-byte error, so a Result's `val` follows it closely
    bad

priv fn aligned_ok(a: U8): Aligned16!Layout_err
    if a == 0
        throw .bad
    return ::{ .a = a }

impl Narrow_tag
    priv fn sum(r: Self): I32
        switch r
        case .one(a)
            return a
        case .two(b, c)
            return b * 10 + c
        case .wide(p, al)
            return p * 10 + al.a

fn layout_lines(b: Str_builder$@) //<
    //< `#align(N)` nested, a narrow tag and `#packed`, laid out alike
    $h: Aligned_holder = ::{}
    h.y = 12345
    h.rows[1].a = 9
    mem.zero(Void$@::h.al@, sizeof(Aligned16))
    base: = Sz::h@
    b.s("aligned=\{Sz::h.al@ - base\}/\{Sz::h.y@ - base\}/\{Sz::h.rows@ - base\}/")
        .s("\{Sz::h.rows[1]@ - base\}/\{sizeof(Aligned_holder)\}/\{h.y\}/\{h.rows[1].a\}/")
        .s("\{G_ALIGNED.al.a\}\{G_ALIGNED.y\}")
    n: = Narrow_tag.wide(1, Aligned16::{ .a = 2 })
    b.s(" narrow=\{sizeof(Narrow_tag)\}/\{n.sum()\}/\{G_NARROW[0].sum()\}/\{G_NARROW[1].sum()\}")
    // A Result holding an over-aligned value: LLVM put `val` right after the error, so the stride
    // and the value's alignment differed from C's. And one of bytes alone, whose size C gives as 3.
    rs: (Aligned16!Layout_err)[2] = ::{ aligned_ok(4), aligned_ok(5) }
    got: = rs[1] catch Aligned16::{}
    b.s(" result=\{Sz::rs[1]@ - Sz::rs[0]@\}/\{sizeof(Aligned16!Layout_err)\}/")
        .s("\{(Sz::rs[0]@) % 16\}/\{got.a\}/\{sizeof(U8!Layout_err)\}\n")
    packed_lines(b)

#packed
priv struct Wire //< a wire record: `#packed` leaves every field but the first under-aligned
    //<
    //< Caution: **Reach the fields through a subscript.** The C backend fixes such a target's
    //< address first. An aligned pointer to the field makes the store a word store, which
    //< faults on a Cortex-M0 (`make test-equiv` builds this C with C's alignment trap).
    priv tag: U8
    priv n: I32
    priv big: I64
    priv pair: Wire_pair
    priv nums: I32[2]

priv struct Wire_pair //< a struct at its own alignment, inside the packed one
    priv a: I16
    priv b: I64

#noinline
priv fn wire_fill(ws: Wire$[], i: Sz, v: I32) //< each field written and updated through `ws[i]`
    ws[i].tag = U8::i
    ws[i].n = v
    ws[i].n *= 3
    ws[i].big = I64::v << 40
    ws[i].big -= 1
    ws[i].pair = ::{ .a = I16::v, .b = I64::v * 7 }
    ws[i].pair.b += 1
    ws[i].nums[1] = v + 1

priv fn packed_lines(b: Str_builder$@) //< `#packed` fields written, updated and read by subscript
    $ws: Wire[3] = ::{}
    wire_fill(Wire$[]::ws, 1, 5)
    // The order holds through a field the subscript's receiver cannot point at.
    eval_log = 0
    ws[eval_idx() + 2].nums[eval_idx()] += eval_val()
    b.s("packed=\{sizeof(Wire)\}/\{ws[1].tag\}/\{ws[1].n\}/\{ws[1].big\}/\{ws[1].pair.a\}/")
        .s("\{ws[1].pair.b\}/\{ws[1].nums[1]\}/\{ws[2].nums[0]\}/\{eval_log\}\n")

#noinline
priv fn wrap16(u: U16, s: I16, b: Str_builder$@) //<
    //< 16-bit products, which C would compute in `int`
    $cu: = u
    cu *= u
    $cs: = s
    cs *= s
    b.s("/\{u * u\}/\{s * s\}/\{cu\}/\{cs\}")

fn wrap16_lines(b: Str_builder$@) //< 16-bit products past `int`'s range, which wrap at 16 bits
    b.s("wrap16")
    wrap16(65535, -1, b)
    wrap16(40000, 300, b)
    b.s("\n")

// ==========================================
// Globals naming other globals: an address taken of a `const` and of a variable, of a field and of
// an element, and a `const` copying a tagged union. **The address names the global itself.**
// Written out as its value instead, C takes the address of a cast and LLVM of nothing. A part's
// address is C's `&g.v` and LLVM's constant `getelementptr`.
// ==========================================
priv struct Link
    v: I32
    next: Link@

priv enum Pick
    a
    b(x: I32)

priv const G_FOUR: I32 = 4
priv const G_FOUR_AT: I32@ = G_FOUR@
priv $g_var: I32 = 4
priv const G_VAR_AT: I32@ = g_var@
priv const G_LINK1: Link = ::{ .v = 1, .next = null }
priv const G_LINK2: Link = ::{ .v = 2, .next = G_LINK1@ }
priv const G_PICK_A: Pick = .a
priv const G_PICK_A2: Pick = G_PICK_A //< a payload-less variant of a tagged union, by name
priv const G_PICK_B: Pick = .b(3)
priv const G_PICKS: Pick[2] = ::{ G_PICK_B, G_PICK_A2 }
priv const G_V_AT: I32@ = G_LINK2.v@ //< a field's address
priv const G_NUMS: I32[4] = ::{ 10, 20, 30, 40 }
priv const G_NUM_AT: I32@ = G_NUMS[2]@ //< an element's address
priv const G_LINKS: Link[2] = ::{::{ .v = 7, .next = null }, ::{ .v = 8, .next = G_LINK1@ } }
priv const G_DEEP_AT: I32@ = G_LINKS[1].v@ //< a field of an element

impl Pick
    priv fn val(r: Self): I32
        switch r
        case .a
            return -1
        case .b(x)
            return x

fn global_ref_lines(b: Str_builder$@) //< globals that name other globals, one line
    g_var = 5
    b.s("gref=\{G_FOUR_AT$\}/\{G_FOUR_AT == G_FOUR@\}/\{G_VAR_AT$\}/\{G_LINK2.next.v\}/")
        .s("\{G_LINK2.next == G_LINK1@\}/\{G_PICK_A2.val()\}/\{G_PICKS[0].val()\}/")
        .s("\{G_PICKS[1].val()\}\n")
    b.s("gpart=\{G_V_AT$\}/\{G_V_AT == G_LINK2.v@\}/\{G_NUM_AT$\}/\{G_NUM_AT == G_NUMS[2]@\}/")
        .s("\{G_DEEP_AT$\}/\{G_DEEP_AT == G_LINKS[1].v@\}\n")

// ==========================================
// A local named as a global whose C name is written as it is (`#export`, an `extern` block's). C
// sees the local from its own declarator on, so it would read itself in its initializer.
// ==========================================
#export
$equiv_hidden: I32 = 5

#export
fn equiv_hidden_fn(): I32
    return 9

fn verbatim_hiding_lines(b: Str_builder$@) //< each initializer reads the global, not the local
    equiv_hidden: = equiv_hidden + 1
    equiv_hidden_fn: = equiv_hidden_fn() + 1
    sqrt: = libc.sqrt(16.0) + 1.0
    b.s("verbatim=\{equiv_hidden\}/\{equiv_hidden_fn\}/\{I32::sqrt\}\n")

// ==========================================
// Casts from floating point to an integer. Each width saturates at its own bounds, and NaN gives 0
// at run time. A constant is folded to the value both backends write. **Keep each bound's
// two sides**: just in (`127.9` for `I8`) and just out (`128.0`).
// ==========================================
priv $g_cast_src: F64[_] = ::{ 0.0, -0.0, -0.9, -1.0, 2.9, -2.9, 127.9, 128.0, -128.9, -129.0,
    255.9, 256.0, 32767.9, 32768.0, -32768.9, -32769.0, 65535.9, 65536.0, 2147483647.9,
    2147483648.0, -2147483648.9, -2147483649.0, 4294967295.9, 4294967296.0, 9223372036854774784.0,
    9223372036854775808.0, -9223372036854775808.0, -9223372036854777856.0, 18446744073709549568.0,
    18446744073709551616.0, 1.0e300, -1.0e300 } //<
        //< read at run time; the first is the zero the infinities and NaN are made from
priv $g_cast_src32: F32[_] = ::{ F32::2147483520.0, F32::2147483648.0, F32::3.0e9, F32::-1.0e30,
    F32::16777217.0 }
priv const G_CAST_FOLDED: I32 = I32::(1.5 * -3.0) //< folded by ksplc for both backends

priv fn cast_row(b: Str_builder$@, v: F64)
    b.s("\{I8::v\},\{I16::v\},\{I32::v\},\{I64::v\},\{U8::v\},\{U16::v\},\{U32::v\},\{U64::v\},")
        .s("\{Sz::v\};")

fn float_cast_lines(b: Str_builder$@) //< one line of every source value at every width
    zero: = g_cast_src[0]
    b.s("fcast=")
    cast_row(b, 1.0 / zero)
    cast_row(b, -1.0 / zero)
    cast_row(b, zero / zero)
    for v in g_cast_src
        cast_row(b, v)
    for f in g_cast_src32
        b.s("\{I32::f\},\{U32::f\},\{I8::f\},\{U64::f\};")
    b.s("\{I32::2.9\},\{I32::-2.9\},\{U8::255.9\},\{I64::-9223372036854775808.0\},")
        .s("\{U64::18446744073709549568.0\},\{I32::(F32::16777217.0)\},\{G_CAST_FOLDED\}\n")

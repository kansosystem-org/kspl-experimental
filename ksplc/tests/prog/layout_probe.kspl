//< Every shape whose layout differs between machines, and every way a folded size reaches the C
//< `layout_targets_test.kspl` compiles it for each machine ksplc knows, and clang compiles the C
//< for the same machine. The C checks each folded number, so a size laid out wrongly fails there.
//< Its entry points answer what the folds decided, for a machine that runs it (wasm32 under node).
trait Shape //< a trait value: an object and its table of methods
    fn area(r: Self): I64

struct Wide //< every width a machine decides, one field each
    tag: U8
    p: I32@
    s: U8[]
    f: fn(x: I32): I32
    n: Sz
    d: I64
    x: F64
    sh: Shape

impl Wide: Shape
    fn area(r: Self@): I64
        return r.d

enum Pick //< a tagged enumeration whose payload holds a pointer and a 64-bit field
    none
    one(at: U8@, n: Sz)
    two(d: I64)

struct Spec //< a field after an option over `Sz`: its place stands on the option's tag and padding
    count: Sz?
    after: I32

struct Holder
    words: Sz[2]
    tail: I32

const PTR_BYTES: Sz = sizeof(U8@)
const TWO_PTR_BYTES: Sz = PTR_BYTES * 2 // a chain: the C writes the folded number, not `sizeof`
const WORD_IS_64: Bool = sizeof(Sz) == 8

##error(sizeof(Sz) == sizeof(U8@), "Sz is as wide as a pointer on every machine ksplc knows")
##error(sizeof(Wide) > offsetof(Wide, sh), "a struct ends after its last field")

$wide_bytes: U8[sizeof(Wide)] = ::{}
$pick_bytes: U8[sizeof(Pick)] = ::{}
const FN_BYTES: Sz = sizeof(fn(): I32)
const SLICE_BYTES: Sz = sizeof(U8[])
const TRAIT_BYTES: Sz = sizeof(Shape)
const RESULT_BYTES: Sz = sizeof(I64!U8)
const WIDE_D_AT: Sz = offsetof(Wide, d)
const OPTION_BYTES: Sz = sizeof(Sz?)
const SPEC_AFTER_AT: Sz = offsetof(Spec, after)
const WIDE_OPTION_BYTES: Sz = sizeof(I64?) //<
    //< an option over a field aligned to 8, even on a 32-bit machine
const HOLDER_TAIL_AT: Sz = offsetof(Holder, tail)
// Named through constants, so the C holds each folded number; a `sizeof` here would stay C's.
$sizes: Sz[9] = ::{ FN_BYTES, SLICE_BYTES, TRAIT_BYTES, RESULT_BYTES, WIDE_D_AT, OPTION_BYTES,
    SPEC_AFTER_AT, WIDE_OPTION_BYTES, HOLDER_TAIL_AT }
$top_bits: Sz = 64 if sizeof(Sz) == 8 else 32

extern fn two_ptrs(): Sz //< two pointers' bytes, through a chain of constants
    return TWO_PTR_BYTES

extern fn word_bits_if(): Sz //< `Sz`'s bits, by a static `if`: the branch kept is the machine's
    $bits: Sz = 0
    if sizeof(Sz) == 8
        bits = 64
    else
        bits = 32
    return bits

extern fn word_bits_const(): Sz //< `Sz`'s bits, by a folded constant
    return 64 if WORD_IS_64 else 32

extern fn word_bits_top(): Sz //< `Sz`'s bits, by a top-level initializer
    return top_bits

extern fn word_bits_case(): Sz //< a pointer's bits, by a `case` label
    switch sizeof(U8@)
    case 4
        return 32
    case 8
        return 64
    default
        return 0

extern fn wide_len(): Sz //< an array whose length is a folded size
    return wide_bytes.len + pick_bytes.len - sizeof(Pick)

extern fn sizes_sum(): Sz //< the folded sizes in a table, which the C checks one by one
    $sum: Sz = 0
    for v in sizes
        sum += v
    return sum

extern fn cast_len(): Sz //< a slice cast that stands on two element sizes being equal
    h: Holder = ::{ .words = ::{ 1, 2 }, .tail = 9 }
    view: = U8@[]::h.words
    return view.len

fn main(): I32
    return 0

//< The fixture for the debug-line-mapping gate (tests/suite/debug_line_test.kspls uses it)
//<
//< Caution: **Do not copy the line numbers into the test.** The test reads which line a
//< `// MARK:<name>` is actually on and expects that. A copy disagrees every time a line is added
//< to this file.
//< Place only one MARK per line.
//< Importing std is deliberate: it confirms that a mapping is attached **to lines outside this
//< file (the imported one) too**, which is the first thing to break under split compilation.
import "std/io"

priv fn alpha(): Sz
  return 11 // MARK:alpha

priv fn beta(n: Sz): Sz
  return n * 2 // MARK:beta

fn main(): I32
  a: = alpha()
  b: = beta(a) // MARK:call_beta
  io.out().s("dl=\{a + b\}").c('\n') // MARK:print
  return 0

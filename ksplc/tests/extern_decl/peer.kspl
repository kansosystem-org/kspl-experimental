//< A fixture: brings in by their C names the symbols `../extern_decl_test.kspl` publishes
//< **The two cannot be one file**: one file cannot declare a name twice, and only the C name joins
//< the two declarations.
extern fn extern_decl_doubled(n: I32): I32 //< defined by the test file, reached through C

extern extern_decl_seen: I32 //< defined by the test file, reached through C

fn doubled_through_c(n: I32): I32 //< calls the test file's function by its C name
    return extern_decl_doubled(n)

fn seen_through_c(): I32 //< reads the test file's variable by its C name
    return extern_decl_seen

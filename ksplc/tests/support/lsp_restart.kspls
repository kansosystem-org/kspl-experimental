//< What the language server answers after its worker is remade, with many documents open
//<
//< Not a suite; part of `../suite/lsp_test.kspls`. **Each check starts a client of its own**, so
//< the supervisor holds the documents it opens and no other.
//< **The first answer after a recovery waits for its own document's analysis, not for every open
//< one** ("The language server is split into two processes: the watcher and the analyser" in
//< `../../docs/DESIGN.md`). The yardstick is what analysing every open document took when they
//< were opened, measured in the same run, so a slow or loaded machine moves both alike.
import "ksplc/tests/support/lsp_client"
import "ksplc/tests/support/lsp_read" { col_in_line, decl_line }
import "std/chars"
import "std/ds" as _ds // what makes `arr_list`'s List available
import "std/json" + { Json_builder }
import "std/jsonrpc"
import "std/mem" { Arena }
import "std/str" // `find_str` and `equals`
import "std/strfmt" as _strfmt
import "std/sys"
import "std/verdict"

priv const normal_ms: I32 = 15000 //< the read timeout (the same as the suite's)
priv const watchdog_ms: I64 = 10000 //<
    //< The supervisor's hang timeout (`worker_timeout_ms` in `../../lsp/server.kspls`)
    //<
    //< Written again here: importing the server would build the language server into this suite.
priv const copies: Sz = 20 //< how many documents are open when the worker is remade
priv const share_of_all: I64 = 2 //<
    //< The recovery may take at most 1/`share_of_all` of analysing every open copy
    //<
    //< **What the check tells apart**: waiting for every open document costs about all of it, and
    //< waiting for its own document (plus an idle-time analysis the request may find under way)
    //< about 2/`copies` of it. Half sits far from both, so neither a loaded machine nor the
    //< watchdog's own jitter moves a run across it; a multiple of one document's recovery does.
priv const copy_fns: Sz = 250 //<
    //< How many functions each copy holds, so analysing one takes measurable work
    //<
    //< **Made here, not read from a file of the package**: the work stays the same whatever the
    //< package's files become, and none is imported, so each analysis is the copy alone.
priv const hover_decl: U8[] = "fn first(" //< the declaration the hover asks about
priv const crash_hook: U8[] = "$/ksplTestCrash"
priv const hang_hook: U8[] = "$/ksplTestHang"

priv fn copy_uri(k: Sz, arena: Arena$@): U8[] //< the `k`th copy's name
    return arena.text().s("file:///restart_copy_\{k\}.kspl").take()

priv fn copy_text(arena: Arena$@): U8[] //< the text every copy holds
    b: = arena.text()
    b.s("fn first(a: I32): I32 { //< the function the hover asks about\n  return a;\n}\n")
    for k in Range.asc(copy_fns)
        b.s("fn step_\{k\}(a: I32): I32 {\n  b: I32 = first(a) * 2;\n  return b + \{k\};\n}\n")
    return b.take()

priv fn empty_obj(arena: Arena$@): json.Val
    $b: = Json_builder.new(arena)
    return b.obj().build()

priv struct Recovery //< what one recovery took, from sending the hook on
    ms: I64 //< until the hover answered; -1 where no answer came
    answered: Bool //< whether the answer showed the declaration (not the null of a lost request)
    published: Sz //< how many of the open copies had their diagnostics published again

priv fn copy_of(uri: U8[], open: Sz, arena: Arena$@): I32 //< which open copy `uri` names; -1 none
    for k in Range.asc(open)
        if uri.equals(copy_uri(k, arena))
            return I32::k
    return -1

priv fn recover(c: jsonrpc.Client$@, hook: U8[], open: Sz, id: I32, text: U8[], arena: Arena$@):
    Recovery //<
        //< It sends `hook` and at once a hover on the first copy, and reads all that comes back
        //<
        //< It reads until the answer and every open copy's diagnostics have come.
        //< **Read the messages here, not through `request`**, which skips the diagnostics that
        //< come before its answer.
    line: = decl_line(text, hover_decl, arena)
    col: = col_in_line(text, hover_decl, "first", arena) + 1
    pos: = lsp_client.at_pos(copy_uri(0, arena), line, col, arena)
    $seen: Bool[copies] = ::{}
    $out: = Recovery::{ .ms = -1, .answered = false, .published = 0 }
    t0: = sys.mono_us()
    c.notify(hook, empty_obj(arena), lsp_client.send_ms, arena) catch {}
    c.send_raw(jsonrpc.encode("textDocument/hover", pos, id, arena), lsp_client.send_ms) catch {}
    for out.ms < 0 || out.published < open
        // The first answer after a hang comes once the watchdog has given up.
        wait: = I32::(watchdog_ms + I64::normal_ms)
        msg: = c.read_msg(wait, arena) catch
            break
        if msg.get("id").as_int(-1) == id
            out.ms = (sys.mono_us() - t0) / 1000I64
            out.answered = lsp_client.hover_text(msg).find_str("first").is_some()
            continue
        if !msg.get("method").as_str().equals("textDocument/publishDiagnostics")
            continue
        k: = copy_of(msg.get("params").get("uri").as_str(), open, arena)
        if k >= 0 && !seen[k]
            seen[k] = true
            out.published += 1
    return out

priv fn open_copies(c: jsonrpc.Client$@, from: Sz, to: Sz, text: U8[], arena: Arena$@): Bool //<
    //< It opens copies `from` to `to` (excluded) and waits for each one's diagnostics
    //<
    //< **Settle before the hook**: diagnostics still on the way would be counted as the recovery's.
    for k in Range.asc(to - from)
        c.notify("textDocument/didOpen",
            lsp_client.did_open(copy_uri(from + k, arena), text, arena), lsp_client.send_ms, arena)
            catch {}
    $left: = to - from
    for left > 0
        msg: = c.read_msg(normal_ms, arena) catch
            return false
        if msg.get("method").as_str().equals("textDocument/publishDiagnostics")
            left -= 1
    return true

priv fn told(c: jsonrpc.Client$@, line: U8[], arena: Arena$@): Bool //<
    //< Whether the supervisor's log carries `line`, copied at once (`err_tail` borrows its buffer)
    return arena.text().s(c.err_tail()).take().find_str(line).is_some()

fn check_first_answer(exe: U8[], arena: Arena$@) //<
    //< That a recovery with many documents open answers in about one document's analysis
    //<
    //< After a crash and after a hang alike; every other document's diagnostics still come.
    name: = "a recovery with many documents open answers in about one document's analysis"
    text: = copy_text(arena)
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, "", arena) catch
        verdict.check(name, false, "the client cannot be started")
        return
    defer c.free()
    _init: = c.request("initialize", empty_obj(arena), normal_ms, arena) catch
        fallback .null_val
    if !verdict.check("the copy a recovery is measured on opens",
        open_copies(c@, 0, 1, text, arena), lsp_client.why(c@, "", arena))
        return

    // One document's recovery, reported beside the timing so a failure shows both scales.
    got_one: = recover(c@, crash_hook, 1, 9000, text, arena)
    verdict.check("a hover answers after a crash with one document open", got_one.answered,
        lsp_client.why(c@, "", arena))
    one: = got_one.ms

    // The yardstick: analysing every other copy as it is opened (each waits for its diagnostics).
    t_open: = sys.mono_us()
    if !verdict.check("every copy opens", open_copies(c@, 1, copies, text, arena),
        lsp_client.why(c@, "", arena))
        return
    all_ms: = (sys.mono_us() - t_open) / 1000I64
    budget: = all_ms / share_of_all
    for hook in U8[][]::{ crash_hook, hang_hook }
        is_hang: = hook.equals(hang_hook)
        got: = recover(c@, hook, copies, 9100 + I32::is_hang, text, arena)
        allowed: = budget + (watchdog_ms if is_hang else 0I64)
        after: = "a hang" if is_hang else "a crash"
        timing: = arena.text()
            .s("\{got.ms\} ms with \{copies\} documents open; analysing them took \{all_ms\} ms and \
                one document's recovery \{one\} ms, so the budget is \{allowed\} ms").take()
        took: = lsp_client.why(c@, timing, arena)
        verdict.check(arena.text().s("after ").s(after)
            .s(", a hover answers in about one document's analysis, not one per open document")
            .take(), got.answered && got.ms <= allowed, took)
        verdict.check(arena.text().s("after ").s(after)
            .s(", every open document's diagnostics are published again").take(),
            got.published == copies,
            lsp_client.why(c@, arena.text().s("\{got.published\} of \{copies\}").take(), arena))
    verdict.check("the supervisor's log counts the documents it restores",
        told(c@, arena.text().s("open documents to restore: \{copies\})").take(), arena),
        lsp_client.why(c@, "", arena))

// ==========================================
// A document whose analysis crashes the worker is quarantined, and the others go on answering
// ==========================================

priv const kept_src: U8[] = "fn main(): I32 {\n  probe: I64 = 1;\n  return 0;\n}\n"
priv const kept_uris: U8[][2] = ::{ "file:///kept_a.kspl", "file:///kept_b.kspl" }
priv const poison_uri: U8[] = "kspl-test-poison:///poison.kspl" //<
    //< A name whose analysis crashes the worker (`test_poison_scheme` in `../../lsp/worker.kspls`)

priv fn probe_hover(c: jsonrpc.Client$@, uri: U8[], arena: Arena$@): json.Val
    got: =
        c.request("textDocument/hover", lsp_client.at_pos(uri, 1, 3, arena), normal_ms, arena) catch
        fallback .null_val
    return got

fn check_quarantine(exe: U8[], arena: Arena$@) //<
    //< That a document crashing its analysis is quarantined while the others go on answering
    //<
    //< **The document is found when it is analysed**, which after a restart comes later than the
    //< restart itself; the worker is not remade without end.
    name: = "a document that crashes its analysis is quarantined"
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, "", arena) catch
        verdict.check(name, false, "the client cannot be started")
        return
    defer c.free()
    _init: = c.request("initialize", empty_obj(arena), normal_ms, arena) catch
        fallback .null_val
    for uri in kept_uris
        c.notify("textDocument/didOpen", lsp_client.did_open(uri, kept_src, arena),
            lsp_client.send_ms, arena) catch {}
    c.notify("textDocument/didOpen", lsp_client.did_open(poison_uri, kept_src, arena),
        lsp_client.send_ms, arena) catch {}
    for uri in kept_uris
        text: = lsp_client.hover_text(probe_hover(c@, uri, arena))
        verdict.check(arena.text().s("a document beside the quarantined one answers: ").s(uri)
            .take(), text.find_str("I64").is_some(),
            lsp_client.why(c@, arena.text().s("'").s(text).s("'").take(), arena))
    poisoned: = probe_hover(c@, poison_uri, arena)
    verdict.check("the crashing document answers nothing, without bringing the worker down",
        lsp_client.hover_text(poisoned).len == 0 && c.alive(),
        lsp_client.dump(poisoned, arena))
    verdict.check(name,
        told(c@, arena.text().s("quarantining '\{poison_uri\}'").take(), arena),
        lsp_client.why(c@, "", arena))
    again: = lsp_client.hover_text(probe_hover(c@, kept_uris[0], arena))
    verdict.check("after the quarantine the worker goes on answering",
        again.find_str("I64").is_some(),
        lsp_client.why(c@, arena.text().s("'").s(again).s("'").take(), arena))

fn run(exe: U8[], arena: Arena$@)
    check_first_answer(exe, arena)
    check_quarantine(exe, arena)

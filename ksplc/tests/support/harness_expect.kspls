//< The shared way to run the fixtures that carry expectation marks (not a suite)
//<
//< The fixtures in [`../negative`](../negative) and [`../lint`](../lint) are one mechanism: a
//< source whose opening comment holds `// EXPECT:` / `// EXPECT-NOT:` / `// ARGS:`, compiled once
//< and its output matched. A file may hold several such sources, each opened by a line
//< `// ==== case <name>` (`case_head`).
//< Caution: **Do not use one entry point split by argument.** Only the input and ksplc decide
//< `ksplc run`'s directory, so the same script run **at the same time** with other arguments
//< contends for it (as `make -j test-suites` does).
import "ksplc/tests/support/harness"
import "ksplc/tests/support/harness_grow"
import "ksplc/tests/support/harness_markers"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/seq"
import "std/str"
import "std/strfmt" as _strfmt
import "std/subproc"
import "std/sys"
import "std/verdict"

priv const fixture_exts: U8[][_] = ::{ ".kspls", ".kspl" } //< the fixtures' extensions
    //<
    //< Caution: **Include the indentation notation too** — a diagnostic that appears only on a
    //< `.kspls` (the misaligned column, in `../../pipeline.kspls`) would go silent unnoticed. The
    //< longer one comes first (the reason is at `strip_fixture_ext`).

priv fn fixture_ext(name: U8[]): U8[] //< a fixture's extension, empty for any other name
    //<
    //< Caution: **Try the longer one first** — read `.kspl` off a `.kspls` and the trailing `s`
    //< is left.
    for ext in fixture_exts
        if name.ends_with(ext)
            return ext
    return ""

priv fn strip_fixture_ext(name: U8[]): U8[] //< drops a fixture's extension from a name
    return name.strip_suffix(fixture_ext(name))

priv const case_head: U8[] = "// ==== case " //< opens one case, at the start of its line
    //<
    //< **A case is the text from the line after its head to the next head**, so it reads as the
    //< file it would be alone: a line number in a mark counts from its head. Its name names the
    //< file it is compiled as, in the suite's working directory.

struct Fixture //< one source as it is compiled
    label: U8[] //< its name in the verdict: the file, then the case if the file holds several
    path: U8[] //< the source handed to the compiler
    stem: U8[] //< the source's name without the extension, which names its generated C too
    body: U8[]

priv fn case_starts(body: U8[], arena: Arena$@): List<|Sz|> //< where each case's head begins
    $at: = List<|Sz|>.new(arena)
    $p: Sz = 0
    for p < body.len
        if body.sub_from(p).starts_with(case_head)
            at.push(p)
        switch body.sub_from(p).find_char('\n')
        case .some(nl)
            p += nl + 1
        case .none
            break
    return at

priv fn is_case_name(name: U8[]): Bool //< lower case letters, digits and `_`, at least one
    for c in name
        if !(c.is_lower() || c.is_digit() || c == '_')
            return false
    return name.len > 0

priv fn take_name(stem: U8[], taken: List<|U8[]|>$@): Bool //< claims a name; false if taken
    //<
    //< **A name is one file in `work`**, the source and its generated C: a second case under it
    //< would overwrite the first, and one case's result would be read as the other's.
    if taken.any(fn(t: U8[]; stem: U8[]): Bool {
        return t.equals(stem);
    })
        return false
    taken.push(stem)
    return true

priv fn gather(name: U8[], path: U8[], body: U8[], work: U8[], into: List<|Fixture|>$@,
    taken: List<|U8[]|>$@, arena: Arena$@): U8[] //<
        //< Adds a file's cases, and returns why it cannot where it cannot
        //<
        //< **A file with no case head is one case, compiled where it stands.** Each case of the
        //< others is written into `work` under its own name and compiled there.
        //< Caution: **Refuse a mark before the first head**: it belongs to no case, so it would
        //< check nothing.
    file: = sys.get_file_name(path)
    starts: = case_starts(body, arena)
    if starts.len == 0
        if !take_name(strip_fixture_ext(file), taken)
            return "another fixture of this suite has the same name"
        into
            .push(Fixture::{ .label = arena.text().s("\{name\}/\{file\}").take(), .path = path,
            .stem = strip_fixture_ext(file), .body = body })
        return ""
    lead: = harness_markers.markers(body.sub(0, starts.get(0)))
    if lead.expect.len + lead.deny.len + lead.args.len > 0
        return "a mark stands before the first case, where it belongs to none"
    for i in Range.asc(starts.len)
        head: = body.sub_from(starts.get(i))
        nl: = head.find_char('\n').unwrap_or(head.len)
        stem: = head.sub(case_head.len, nl - case_head.len).trim_spaces()
        if !is_case_name(stem)
            return arena.text()
                .s("the case head '\{head.sub(0, nl)\}' names no case (lower case letters, digits \
                    and `_`)").take()
        if !take_name(stem, taken)
            return arena.text().s("another fixture of this suite is named \{stem\} too").take()
        end: = starts.get(i + 1) if i + 1 < starts.len else body.len
        from: = starts.get(i) + nl + 1 if nl < head.len else body.len
        text: = body.sub(from, end - from) if from < end else ""
        written: = fs.join(work,
            arena.text().s(stem).s(fixture_ext(file)).take(), arena)
        io.write_file(written, text) catch
            return arena.text().s("the case \{stem\} cannot be written to \{written\}").take()
        into
            .push(Fixture::{ .label = arena.text().s("\{name\}/\{file\}: \{stem\}").take(),
            .path = written, .stem = stem, .body = text })
    return ""

priv fn fixtures(subdir: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Gathers the sources under a folder of this package, in lexicographic order
    dir: = fs.absolute(subdir, arena) catch
        return List<|U8[]|>.new(arena)
    files: = fs.walk_files(dir, fs.skip_none, arena) catch
        return List<|U8[]|>.new(arena)
    return files.where(fn(f: U8[]; ): Bool {
        return strip_fixture_ext(f).len < f.len;
    }).to_list(arena)

priv fn self_contradictory(out: U8[], arena: Arena$@): U8[] //<
    //< Searches for a diagnostic whose "expected" and "got" strings are the same
    //<
    //< **Such a diagnostic tells the reader nothing.** It appears where the types differ at a level
    //< with no written notation (a type's outermost immutability and the like). A case's
    //< EXPECT cannot catch it, so every case is checked.
    head: = "expected '"
    mid: = "', but got '"
    $rest: = out
    for
        $at: Sz = 0
        switch rest.find_str(head)
        case .some(found)
            at = found
        case .none
            break
        tail: = rest.sub_from(at + head.len)
        rest = tail
        $end: Sz = 0
        switch tail.find_char('\'')
        case .some(found)
            end = found
        case .none
            break
        want: = tail.sub(0, end)
        after: = tail.sub_from(end)
        if !after.starts_with(mid)
            continue
        got_all: = after.sub_from(mid.len)
        if close: = got_all.find_char('\'')
            if want.equals(got_all.sub(0, close))
                return arena.text()
                    .s("a diagnostic with the same string on both sides came out: expected \
                        '\{want\}', but got '\{want\}'").take()
    return ""

priv fn unforeseen_errors(out: U8[], expect: U8[][], arena: Arena$@): U8[] //<
    //< The error lines that no EXPECT names, or empty where every one is named
    //<
    //< **An error the case does not foresee can stop the check an EXPECT-NOT is about**: sema
    //< skips the rest of a body's analysis after an error in it, and the EXPECT-NOT then holds
    //< whatever the compiler does. So a case with an EXPECT-NOT names every error it reports.
    b: = arena.text()
        .s("an EXPECT-NOT case reports an error no EXPECT names, which may have stopped the check \
            the EXPECT-NOT is about:\n")
    $found: = 0
    for ln in out.lines(arena)
        if ln.find_str(": error: ").is_none()
            continue
        $named: = false
        for want in expect
            named = named || ln.find_str(want).is_some()
        if !named
            b.s(ln).s("\n")
            found += 1
    text: = b.take()
    return text if found > 0 else ""

priv fn fixture_argv(path: U8[], out_c: U8[], args: U8[][], lint_mode: Bool, arena: Arena$@):
    U8[][] //<
        //< One fixture's argv. The lint suite prefixes `lint` and does not write the generated C.
    $list: = List<|U8[]|>.new(arena)
    if lint_mode
        list.push("lint")
    for a in args
        list.push(a)
    list.push(path)
    if !lint_mode
        list.push(out_c)
    return harness.ksplc_argv(list.slice())

fn gather_files(name: U8[], files: U8[][], work: U8[], arena: Arena$@): List<|Fixture|> //<
    //< Every case of the files, each where it is compiled
    //<
    //< A file that cannot be read or split is reported as a failure under its own name and left
    //< out, so its cases are never counted as passing.
    $all: = List<|Fixture|>.new(arena)
    $taken: = List<|U8[]|>.new(arena)
    for path in files
        label: = arena.text().s("\{name\}/\{sys.get_file_name(path)\}").take()
        body: = io.read_file(path) catch
            verdict.check(label, false, "the fixture cannot be read")
            continue
        why: = gather(name, path, body, work, all@, taken@, arena)
        if why.len > 0
            verdict.check(label, false, why)
    return all

fn run_suite(name: U8[], subdir: U8[], want_failure: Bool, lint_mode: Bool, grow: Bool,
    arena: Arena$@) //<
        //< Runs one suite, the generated C kept apart per fixture
        //<
        //< The fixtures run side by side. `grow` adds the fixtures built just before the run.
        //< Caution: **Fail where a fixture could not be built.** Skipped quietly, it goes green
        //< without testing one of the limits' safety valves.
    $files: = fixtures(subdir, arena)
    if files.len == 0
        verdict.check(arena.text().s("there are fixtures in \{subdir\}").take(), false,
            "there is not one")
        return
    work: = harness.sandbox(arena.text().s("expect_\{name\}").take())
    if grow
        $made: = harness_grow.write_all(work, arena)
        if !verdict.check(arena.text().s("\{name\}: the depth material can be assembled").take(),
            made.len == harness_grow.count(),
            arena.text().s("\{made.len\} / \{harness_grow.count()\} items").take())
            return
        for path in made.slice()
            files.push(path)
    $all: = gather_files(name, files.slice(), work, arena)
    io.out().s("# \{name\}: \{all.len\} items (parallelism \{verdict.jobs()\})\n")
    $cases: = List<|U8[]|>.new(arena)
    $marks: = List<|harness_markers.Markers|>.new(arena)
    $jobs: = List<|subproc.Job|>.new(arena)
    for f in all.slice()
        $m: = harness_markers.markers(f.body)
        out_c: = fs.join(work, arena.text().s("\{f.stem\}.c").take(), arena)
        jobs
            .push(subproc.Job::{ .argv =
            fixture_argv(f.path, out_c, m.args.slice(), lint_mode, arena), .cwd = work })
        cases.push(f.label)
        marks.push(m)
    outs: = harness.run_all(jobs.slice(), name)
    for i in Range.asc(cases.len)
        case_name: = cases.get(i)
        r: = outs.get(i)
        $m: = marks.get(i)
        // Caution: Do not accept a fixture with no mark. A case matching nothing becomes a green
        // line.
        if m.expect.len == 0 && m.deny.len == 0
            verdict.check(case_name, false, "there is no EXPECT / EXPECT-NOT mark")
            continue
        if want_failure && r.code == 0
            verdict.check(case_name, false, "the compiler ended with 0 (a failure was expected)")
            continue
        // Caution: **In a suite that does not expect a failure, check the exit code too**, or
        // EXPECT's string passes a fixture that stopped compiling (many diagnostics come before the
        // body's analysis).
        if !want_failure && r.code != 0
            verdict.check(case_name, false,
                arena.text()
                .s("the compiler failed (this suite's premise is that it passes)\n\{r.out\}").take())
            continue
        same: = self_contradictory(r.out, arena)
        if same.len > 0
            verdict.check(case_name, false, same)
            continue
        stray: =
            unforeseen_errors(r.out, m.expect.slice(), arena) if m.deny.len > 0 else ""
        if stray.len > 0
            verdict.check(case_name, false, stray)
            continue
        harness_markers.check(case_name, m.expect.slice(), m.deny.slice(), r.out)

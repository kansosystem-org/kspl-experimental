//< What ksplc's suites rely on: the compiler they inspect, the std it reads, and their scratch
//<
//< **One ksplc runs a suite, which inspects another.** `make test-suites` gives every suite the
//< compiler under inspection and its scratch directory first, and runs it with another ksplc.
//< Built with the one inspected, a broken compiler and a failed check look the same. The checks
//< and a child's run come from `std/verdict`, and the directories from `std/fs`.
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena, dealloc }
import "std/str" // `arena.text()`
import "std/subproc"
import "std/sys"
import "std/verdict"

priv $suite_arena: Arena$@ = null
priv $under: U8[] = "" //< `ksplc_exe`'s answer, set as the suite begins
priv $scratch: U8[] = "" //< where this suite's scratch goes, from the root
priv $more: U8[][] = U8[][]::{} //< the suite's arguments after the two paths
priv $start_dir: U8[] = "" //< where `run` starts a child; empty is where the suite began

priv fn open_suite(chunk_size: Sz) //<
    //< the verdict's label and the suite's arena, as a suite begins
    verdict.begin(sys.get_env("KANSO_SUITE").unwrap_or(""))
    suite_arena = Arena.new(chunk_size)

fn begin(chunk_size: Sz): Arena$@ //< starts a suite, and returns the arena it allocates from
    //<
    //< Caution: **Call it once, at the start of `main`, and do not free what it returns** —
    //< `finish` and `fatal` do. Every line carries the suite's name (`KANSO_SUITE`). **The paths
    //< are decided here**, before a case changes the environment they are read from.
    open_suite(chunk_size)
    argv: = sys.args()
    if argv.len < 3
        panic("usage: ksplc run tests/suite/<name>_test.kspl <compiler under inspection> <scratch \
            place> [what the suite reads itself]")
    under = fs.absolute(argv.get(1), suite_arena) catch
        fallback ""
    scratch = fs.absolute(argv.get(2), suite_arena) catch
        fallback ""
    if under.len == 0 || scratch.len == 0
        panic("the working directory cannot be read, so the two arguments cannot be made absolute")
    $rest: = List<|U8[]|>.new(suite_arena)
    for i in Range.asc(argv.len)
        if i >= 3
            rest.push(suite_arena.dup_str(argv.get(i)))
    more = rest.slice()
    fs.mkdir_all(scratch) catch panic("the scratch place cannot be made")
    refuse_inside_package(scratch)
    // **This run works in a folder of its own.** An earlier run can leave files it could not delete
    // (the Makefile empties the place where it can). They are never read as this run's.
    scratch = fs.mkdir_unique(scratch, "run_", suite_arena) catch
        fallback ""
    if scratch.len == 0
        panic("this run's folder in the scratch place cannot be made")
    std_path = settle_std_dir()
    return suite_arena

pub fn begin_at(chunk_size: Sz, compiler: U8[], std: U8[], place: U8[], cwd: U8[]): Arena$@ //<
    //< Starts a suite on paths its caller has settled, for a harness built on this one
    //<
    //< Each path is absolute: the compiler under inspection, its std, the scratch place and where
    //< `run` starts a child. **The scratch place is used as it is**, so its caller keeps it clean.
    //< Caution: **Call it once, at the start of `main`, and do not free what it returns**, as at
    //< `begin`.
    open_suite(chunk_size)
    under = suite_arena.dup_str(compiler)
    std_path = suite_arena.dup_str(std)
    scratch = suite_arena.dup_str(place)
    start_dir = suite_arena.dup_str(cwd)
    return suite_arena

fn more_args(): U8[][] //< the suite's arguments after the two paths, for it to read itself
    return more

priv fn refuse_inside_package(dir: U8[]) //< stops if the scratch directory is inside a package
    //<
    //< **A file under a folder whose `ksplc.cfg` names a package belongs to that package.** So a
    //< case's files there would compile under its `uses` and fail for another reason.
    //< Caution: **Ask the compiler under inspection** (`info package`, in that folder). Do not
    //< walk up here: the walk is the compiler's rule, and a copy would drift from it.
    r: = run_in(U8[][]::{ under, "info", "package" }, dir)
    if !r.exited_with(0)
        panic(U8$[]::suite_arena.text()
            .s("which package the scratch place \{dir\} stands in cannot be asked\n\{r.out\}")
            .take())
    lines: = r.out.lines(suite_arena)
    name: = lines.get(0).trim_spaces() if lines.len > 0 else ""
    if name.len > 0
        panic(U8$[]::suite_arena.text().s("the scratch place \{dir\} stands inside the package '")
            .s(name).s("'; hand one outside it (SCRATCH in ksplc/Makefile)").take())

pub fn arena(): Arena$@ //< the suite's arena, for a helper that takes none
    return suite_arena

priv fn end_suite()
    if suite_arena != null
        suite_arena.free()
        suite_arena = null

pub fn finish(): I32 //< prints the `RESULT:` line and returns the verdict as the exit code
    //<
    //< **`return finish()` from `main`.** The suite's arena is freed here (`begin`'s).
    code: = verdict.finish()
    end_suite()
    return code

pub fn fatal(msg: U8[]): I32 //< ends a suite that cannot go on (its input files are missing, say)
    code: = verdict.fatal(msg)
    end_suite()
    return code

pub fn require_or_skip( //<
    //< a check this machine lacks a tool for: a failure where required, else a SKIP
    //<
    //< **Required where the switch reads `1`**, as the repository sets it where CI's image holds
    //< every tool (`REQUIRE_SWITCHES` in `mk/test.mk`). **The failure says how to run without it**,
    //< so a machine lacking the tool is not left with a red it cannot act on.
    name: U8[], //< the check
    switch_name: U8[], //< the switch that requires the tool (`KANSO_REQUIRE_CHOWN`)
    lacks: U8[], //< what this machine lacks, which the SKIP line says too
)
    if !sys.get_env(switch_name).unwrap_or("").equals("1")
        verdict.skip_check(name, lacks)
        return
    verdict.check(name, false,
        suite_arena.text().s(lacks).s("\n    ").s(switch_name)
        .s("=1 makes that a failure here (the default on Linux, whose CI image holds every tool). ")
        .s("On a machine without it, ").s(switch_name)
        .s("=0 makes this a SKIP; such a round is not CI's verdict").take())

// ==========================================
// The compiler under inspection, and its std
// ==========================================

pub fn ksplc_exe(): U8[] //< the compiler under inspection, from the root
    return under

priv $std_path: U8[] = "" //< `std_dir`'s answer, set as the suite begins

pub fn std_dir(): U8[] //< the std given to the compiler under inspection (`--std-dir=`)
    //<
    //< Caution: **Pass it explicitly on every run** (`ksplc_argv`): a case whose working directory
    //< is a scratch directory would otherwise look for a `std` beside it.
    return std_path

priv fn settle_std_dir(): U8[] //<
    //< `KSPLC_STD_DIR` where named, else the compiler's own (`info std-dir`), made absolute
    named: = sys.get_env("KSPLC_STD_DIR").unwrap_or("")
    if named.len > 0
        return fs.absolute(named, suite_arena) catch
            fallback suite_arena.dup_str(named)
    r: = run(U8[][]::{ under, "info", "std-dir" })
    if !r.exited_with(0)
        return ""
    answered: = r.out.trim_spaces()
    return fs.absolute(answered, suite_arena) catch
        fallback answered

pub fn ksplc_argv(args: U8[][]): U8[][] //<
    //< the compiler under inspection's argv, `--std-dir=` first
    //<
    //< For a `subproc.Job` run side by side; for one run, call `ksplc`.
    $argv: = List<|U8[]|>.new(suite_arena)
    argv.push(under)
    argv.push(suite_arena.text().s("--std-dir=\{std_dir()\}").take())
    for a in args
        argv.push(a)
    return argv.slice()

pub fn ksplc(args: U8[][]): verdict.Run_out //< runs the compiler under inspection once
    return run(ksplc_argv(args))

pub fn ksplc_bare(args: U8[][]): verdict.Run_out //< runs it once without `--std-dir=` in front
    //<
    //< Caution: **Call `fmt`, `clean` and `emit-runtime` with this one.** They read no standard
    //< library and so take no `--std-dir`, which they reject.
    $argv: = List<|U8[]|>.new(suite_arena)
    argv.push(under)
    for a in args
        argv.push(a)
    return run(argv.slice())

pub fn read_generated(path: U8[]): U8[] //< the text the compiler wrote, its newlines made LF
    //<
    //< Text mode on Windows writes each `\n` as `\r\n`.
    body: = io.read_file(path) catch
        return ""
    defer dealloc(Void$@::body.ptr)
    return body.replace("\r\n", "\n", suite_arena)

// ==========================================
// The C compiler
// ==========================================

pub fn cc(): U8[] //< the C compiler: `CC` where it is set, and clang otherwise, as ksplc picks it
    named: = sys.get_env("CC").unwrap_or("")
    if named.len > 0
        return suite_arena.dup_str(named)
    return "clang"

fn cc_target(): U8[] //< the C compiler's target triple (`cc -dumpmachine`), empty where unknown
    //<
    //< It is for a case whose subject differs by target.
    //< Caution: **Choose no link flag by it** — ask the compiler for those (`harness_build`).
    r: = run(U8[][]::{ cc(), "-dumpmachine" })
    return "" if !r.exited_with(0) else r.out.trim_spaces()

// ==========================================
// Scratch
// ==========================================

pub fn tmp_dir(): U8[] //< this run's scratch directory
    //<
    //< `begin`'s is a fresh folder inside the place it was given; `begin_at`'s is the place itself.
    return scratch

pub fn sandbox(name: U8[]): U8[] //< a directory of its own for one case, made fresh
    //<
    //< **A suite that cannot make one stops** (`fatal`): the scratch place is broken, so every case
    //< after it would fail for the same reason. Nothing here removes it: whoever hands over the
    //< scratch place empties it (for `begin`, the Makefile, before the next run).
    prefix: = suite_arena.text().s(name).c('_').take()
    dir: = fs.mkdir_unique(scratch, prefix, suite_arena) catch
        why: = suite_arena.text().s("cannot make a working directory in \{scratch\}").take()
        sys.exit(fatal(why))
    return dir

// ==========================================
// Starting a process: `std/verdict`'s runs, in the suite's arena
// ==========================================

pub fn run(argv: U8[][]): verdict.Run_out //< runs argv where the suite starts children
    //<
    //< That is the working directory the suite began in, or the folder `begin_at` names.
    return run_capped(argv, start_dir, verdict.DEFAULT_TIMEOUT_MS)

pub fn has_tool(name: U8[]): Bool //< whether the tool answers `--version`
    return run(U8[][]::{ name, "--version" }).exited_with(0)

pub fn run_in(argv: U8[][], cwd: U8[]): verdict.Run_out //< runs it in the given working directory
    return run_capped(argv, cwd, verdict.DEFAULT_TIMEOUT_MS)

pub fn run_capped(argv: U8[][], cwd: U8[], timeout_ms: I32): verdict.Run_out //<
    //< Runs it with a given timeout
    //<
    //< **Only a case whose failure mode is not stopping uses this**
    //< (`verdict.DEFAULT_TIMEOUT_MS`'s).
    return verdict.run_child(argv, cwd, timeout_ms, suite_arena)

pub fn run_all(items: subproc.Job[], name: U8[]): List<|verdict.Run_out|> //<
    //< Runs jobs side by side (`verdict.run_children`), collected in `work_<name>` in the scratch
    dir: = fs.join(scratch, suite_arena.text().s("work_\{name\}").take(), suite_arena)
    return verdict.run_children(items, dir, suite_arena)

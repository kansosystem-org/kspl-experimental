//< What the `ksplc run` suite runs a case with: the frame, the cache's reader, the cc arguments
//< The frame makes a working directory, points the child's cache at it, writes the files, runs
//< it, and reports one of three states. **No verdict is here**: the cases in
//< `tests/suite/run_test.kspl` decide what counts as good. Not a suite.
import "ksplc/tests/support/harness"
import "ksplc/tests/support/harness_build"
import "ksplc/tests/support/run_progs"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/strfmt"
import "std/sys"
import "std/verdict"

const STATE_OK: Sz = 0 //< the verdict's three states
    //< Caution: Do not confuse "it cannot be confirmed in this environment" with "it failed".
const STATE_FAILED: Sz = 1
const STATE_SKIP: Sz = 2

struct Outcome
    state: Sz
    why: U8[]

fn ok_result(): Outcome
    return Outcome::{ .state = STATE_OK, .why = "" }

fn failed(why: U8[]): Outcome
    return Outcome::{ .state = STATE_FAILED, .why = why }

fn broke(what: U8[], out: U8[], arena: Arena$@): Outcome //<
    //< It makes one failure out of "what did not happen" and the output at the time
    return failed(arena.text().s(what).s("\n").s(out).take())

fn skipped(why: U8[]): Outcome
    return Outcome::{ .state = STATE_SKIP, .why = why }

priv fn report(name: U8[], r: Outcome)
    if r.state == STATE_SKIP
        verdict.skip_check(name, r.why)
        return
    verdict.check(name, r.state == STATE_OK, r.why)

// ==========================================
// The working directory and the cache location
// ==========================================

priv fn in_sandbox(name: U8[], body: fn(work: U8[], arena: Arena$@): Outcome, arena: Arena$@):
    Outcome //<
        //< It makes one working directory and runs the case with the child's cache pointed at it
        //< **Separate them per case**, or "was it rebuilt" passes on the previous case's artifact.
        //< Caution: **Do not forget to point the child's cache here**, or it pollutes the
        //< developer's real cache and passes on the last run's artifact.
    dir: = harness.sandbox(name)
    work: = dir
    sys.set_env("KSPLC_CACHE_DIR", fs.join(work, "cache", arena)) catch
        return failed("cannot point the location at the child")
    return body(work, arena)

fn run(name: U8[], slot: U8[], body: fn(work: U8[], arena: Arena$@): Outcome, arena: Arena$@) //<
    //< It runs one case and reports
    //< Caution: **Do not split these two into separate functions**, or reporting without a working
    //< directory, or a directory without reporting, becomes possible: "green, confirming nothing".
    report(name, in_sandbox(slot, body, arena))

fn cache_dir(work: U8[], arena: Arena$@): U8[]
    return fs.join(work, "cache", arena)

fn run_root(work: U8[], arena: Arena$@): U8[]
    return fs.join(cache_dir(work, arena), "run", arena)

fn slots(work: U8[], arena: Arena$@): List<|U8[]|>
    $out: = List<|U8[]|>.new(arena)
    entries: = fs.read_dir(run_root(work, arena), arena) catch
        return out
    for name in entries
        out.push(name)
    return out

fn only_slot(work: U8[], arena: Arena$@): U8[] //<
    //< the path of the slot when there is exactly one
    ss: = slots(work, arena)
    if ss.len != 1
        return ""
    return fs.join(run_root(work, arena), ss.get(0), arena)

fn helper_src(n: Sz, arena: Arena$@): U8[]
    return arena.text().s("pub fn value(): Sz\n  return \{n\}\n\n").take()

fn write_script(work: U8[], entry: U8[], body: U8[], n: Sz, arena: Arena$@): Bool //<
    //< It writes the entry script and the imported file
    helper: = helper_src(n, arena)
    fs.write_tree(work, U8[][]::{ entry, "helper.kspl" }, U8[][]::{ body, helper }, arena) catch
        return false
    return true

fn ksplc_run(args: U8[][], arena: Arena$@): verdict.Run_out
    $a: = List<|U8[]|>.new(arena)
    a.push("run")
    for x in args
        a.push(x)
    return harness.run(harness.ksplc_argv(a.slice()))

fn run_script(path: U8[], arena: Arena$@): verdict.Run_out //<
    //< It runs one script (the most common case)
    return ksplc_run(U8[][]::{ path }, arena)

fn expect_out(r: verdict.Run_out, want: U8[], what: U8[], arena: Arena$@): Outcome
    if !r.exited_with(0) || r.out.find_str(want).is_none()
        return failed(arena.text().s(what).s("(code=\{r.code.unwrap_or(-1)\})\n").s(r.out).take())
    return ok_result()

// ==========================================
// Reads what is inside `ksplc run`'s cache location
// The location is in the OS's cache area, so **"was it rebuilt" is measured only by the
// artifacts' count and time**, read here.
// ==========================================
struct Objs //<
    //< The count of objects for this script, the newest time, and the count made since `since`
    //< It assumes there is only one slot.
    count: Sz
    newest: I64
    fresh: Sz

fn obj_state(work: U8[], since: I64, arena: Arena$@): Objs
    $out: = Objs::{ .count = 0, .newest = 0, .fresh = 0 }
    slot: = only_slot(work, arena)
    if slot.len == 0
        return out
    dir: = fs.join(slot, "obj", arena)
    entries: = fs.read_dir(dir, arena) catch
        return out
    for name in entries
        if !name.ends_with(".o")
            continue
        st: = fs.stat(fs.join(dir, name, arena)) catch
            continue
        out.count += 1
        if st.mtime > out.newest
            out.newest = st.mtime
        if st.mtime >= since
            out.fresh += 1
    return out

const WAIT_LIMIT_US: I64 = 5000000 //< the longest wait_for_mtime_tick waits, in microseconds

fn wait_for_mtime_tick(probe: U8[], after: I64): I64 //<
    //< It waits until a file's time passes after and returns the time it reached
    //< It returns 0 where the time does not pass it within wait_limit_us.
    //< **`fs.stat`'s mtime is in seconds**, so two builds in a row show **everything rebuilt as
    //< "left alone"**. The file's own clock decides the wait; a monotonic second is not its tick.
    start: = sys.mono_us()
    for sys.mono_us() - start <= WAIT_LIMIT_US
        io.write_file(probe, "x") catch
            return 0I64
        st: = fs.stat(probe) catch
            return 0I64
        if st.mtime > after
            return st.mtime
    return 0I64

fn fake_slot_name(i: Sz, arena: Arena$@): U8[] //<
    //< A fake slot name of the same shape as a real slot (64 hex characters)
    //< Anything but that shape is outside what the sweep touches.
    b: = arena.text()
    for _k in Range.asc(62)
        b.c('0')
    b.c((U8::((i / 16) % 16)).to_hex_lower())
    b.c((U8::(i % 16)).to_hex_lower())
    return b.take()

fn place_fake_slot(root: U8[], i: Sz, used_at: I64, arena: Arena$@): Bool //<
    //< It creates fake slot i under root, marked as last used at used_at (seconds)
    //< It returns false where it cannot.
    //< The mark copies what touch_dir in `ksplc/base/cache.kspl` writes: a file `used` holding the
    //< seconds. A real slot holds an obj/ too, which a one-level sweep leaves behind.
    fake: = fs.join(root, fake_slot_name(i, arena), arena)
    mark: = arena.text().s("\{used_at\}").take()
    fs.write_tree(fake, U8[][]::{ "prog.exe", "obj/x.o", "used" },
        U8[][]::{ "junk", "junk", mark }, arena) catch
        return false
    return true

fn same_place(reported: U8[], want: U8[], arena: Arena$@): Bool //<
    //< Whether the path ksplc reported and the path passed to it point at the same directory
    //< Caution: **Do not compare the path strings.** MSYS2 rewrites a child's `/tmp/…` into
    //< `D:/a/_temp/msys64/tmp/…`; a mark placed here is searched for from the reported path
    //< instead.
    line: = reported.trim_spaces()
    if line.len == 0 || !fs.is_dir(line)
        return false
    mark: = "kanso_same_place.txt"
    io.write_file(fs.join(want, mark, arena), "x") catch
        return false
    return fs.exists(fs.join(line, mark, arena))

// ==========================================
// Helpers for checking the arguments passed to cc
// `ksplc run` starts the C compiler as a child, so **what was passed** is not visible from
// outside. `CC` is replaced by a stand-in that records argv, and this reads it.
// **The verdict itself is not here** but in `run_test.kspl`, so a diff says which of the two
// was changed.
// ==========================================
fn build_probe(work: U8[], arena: Arena$@): U8[] //<
    //< It builds the C compiler's stand-in and returns it (empty where it cannot build one)
    //< Caution: **Build it before replacing CC**, which it uses. **The name must state the
    //< notation.** `cc_probe_src` is in braces, and as `.kspl` it never builds. That looks like
    //< "it cannot be run with the stand-in cc".
    fs.write_tree(work, U8[][]::{ "cc_probe.kspl" }, U8[][]::{ run_progs.CC_PROBE_SRC }, arena)
        catch
        return ""
    gen: = fs.join(work, "cc_probe.c", arena)
    src: = fs.join(work, "cc_probe.kspl", arena)
    g: = harness.run_in(harness.ksplc_argv(U8[][]::{ src, gen }), work)
    if !g.exited_with(0)
        return ""
    exe: = fs.join(work, "cc_probe.exe", arena)
    b: = harness_build.build_exe(U8[][]::{ gen }, exe, U8[][]::harness_build.DEFAULT_CFLAGS)
    return "" if !b.exited_with(0) else exe

struct Seen //< what the record shows, read one line at a time, counting only the `ARG:` lines
    absolute: U8[] //< The first absolute path found (empty where there is none)
    dumpmachine: Sz
    c_files: Sz
    objects: Sz
    exe: Sz
    // Objects after a `-o` already passed once: **twice, cc writes one file in parallel.** Only
    // right after a -o, as the link lists the objects as inputs.
    dup_objects: Sz

fn read_log(log: U8[], arena: Arena$@): Seen //<
    //< It reads the record in log and counts the arguments its `ARG:` lines hold
    //< Caution: **Leave splitting into lines to `lines`**, which drops a trailing `'\r'`. Split by
    //< hand, a record written in text mode on Windows counts **not one** `-dumpmachine`, `.c` or
    //< `.o`, which looks like "it was not passed".
    $out: = Seen::{ .absolute = "", .dumpmachine = 0, .c_files = 0, .objects = 0, .exe = 0,
        .dup_objects = 0 }
    $wrote: = List<|U8[]|>.new(arena)
    $want_out: = false
    for line in log.lines(arena)
        if !line.starts_with("ARG:")
            continue
        a: = line.sub_from(4)
        if want_out
            want_out = false
            if a.ends_with(".o")
                if wrote.contains(a)
                    out.dup_objects += 1
                wrote.push(a)
        want_out = a.equals("-o")
        if sys.is_absolute(a) && out.absolute.len == 0
            out.absolute = a
        if a.equals("-dumpmachine")
            out.dumpmachine += 1
        if a.ends_with(".c")
            out.c_files += 1
        if a.ends_with(".o")
            out.objects += 1
        if a.equals("prog.new.exe")
            out.exe += 1
    return out

fn link_call(log: U8[], arena: Arena$@): List<|U8[]|> //<
    //< The arguments of the call that linked, in order; empty where the record holds none
    //< The link is the call making `prog.new.exe`. **Split the record at its `CALL` lines**: the
    //< compiles run in parallel, so an argument's position does not say whose it is.
    $found: = List<|U8[]|>.new(arena)
    $call: = List<|U8[]|>.new(arena)
    for line in log.lines(arena)
        if line.equals("CALL")
            found = call if call.contains("prog.new.exe") else found
            call = List<|U8[]|>.new(arena)
        else if line.starts_with("ARG:")
            call.push(line.sub_from(4))
    return call if call.contains("prog.new.exe") else found

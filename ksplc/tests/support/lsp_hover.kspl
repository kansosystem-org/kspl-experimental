//< What a hover answers: which positions answer, what it says on a value, and a declaration's docs
//<
//< Not a suite; `../suite/lsp_test.kspl` runs each part.
import "ksplc/tests/support/lsp_client"
import "ksplc/tests/support/lsp_read" { col_in_line, decl_line, end_text, is_missing }
import "std/chars"
import "std/ds" { List }
import "std/json" + { Json_builder }
import "std/jsonrpc"
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"

// ==========================================
// Which positions a hover answers: a name answers, a mark between names does not
// **A bracket, a comma, an operator and a keyword name nothing**, so the hover there is empty.
// Answered from the node around them, the `)` of a call read `fn )()`, the `,` after `words@`
// read `fn @()`, and `priv` read `type priv`: each a declaration that does not exist.
// **The position just past a name still answers that name** (the `(` after `free`), as an editor
// asks there when the caret stands at the name's end.
// ==========================================
priv const marks_src: U8[] =
    """import "std/ds" { List }

priv struct Pair
    a: U8

fn sum(words: List<|U8[]|>$@, x: U8): I32
    $more: = List<|U8[]|>.new(null)
    ns: = List<|I32|>.new(null)
    defer more.free()
    _n: = sum(more@, x)
    y: = I32::x
    return y * 2 + I32::words.len + I32::ns.len
"""

priv const marks_uri: U8[] = "file:///marks_probe.kspl"

priv struct Spot //< a position in the probe, and what a hover there should say
    line: U8[] //< the start of its line
    needle: U8[] //< the text it stands in, first found in that line
    step: Sz //< how many characters into `needle`
    name: U8[] //< what stands there, for the check's label
    want: U8[] //< a piece of the answer; empty where the answer is `null`

priv const blank_spots: Spot[_] = ::{ //< the positions that name nothing
    Spot::{ .line = "    defer more.free", .needle = "()", .step = 1, .name = "the ')' of a call" },
    Spot::{ .line = "    defer more.free", .needle = "()", .step = 2,
        .name = "the end of a line closed by a call's ')'" },
    Spot::{ .line = "    _n: = sum", .needle = ", x", .name = "the ',' after an '@'" },
    Spot::{ .line = "    $more: = List", .needle = "<|", .step = 1, .name = "the '|' of '<|'" },
    Spot::{ .line = "    $more: = List", .needle = "]|>", .name = "the ']' of a slice type" },
    Spot::{ .line = "    $more: = List", .needle = "|>",
        .name = "the '|' of '|>' after a slice type" },
    Spot::{ .line = "    ns: = List", .needle = "|>", .step = 1, .name = "the '>' of '|>'" },
    Spot::{ .line = "    y: = I32", .needle = "::x", .step = 1,
        .name = "the second ':' of a cast" },
    Spot::{ .line = "fn sum", .needle = "): I32", .step = 1,
        .name = "the ':' before a return type" },
    Spot::{ .line = "priv struct", .needle = "priv", .step = 1, .name = "the keyword 'priv'" },
    Spot::{ .line = "priv struct", .needle = "struct", .step = 1, .name = "the keyword 'struct'" },
    Spot::{ .line = "    return y", .needle = "*", .name = "an operator" },
    Spot::{ .line = "fn sum", .needle = "fn", .step = 1, .name = "the keyword 'fn'" },
}

priv const named_spots: Spot[_] = ::{ //< the positions on a name, and a piece of its answer
    Spot::{ .line = "    $more: = List", .needle = "U8", .step = 1,
        .name = "a primitive type among type arguments", .want = "type U8" },
    Spot::{ .line = "fn sum", .needle = "x: U8", .step = 4,
        .name = "a primitive type in a parameter's type", .want = "type U8" },
    Spot::{ .line = "    a: U8", .needle = "U8", .step = 1,
        .name = "a primitive type in a field's type", .want = "type U8" },
    Spot::{ .line = "    y: = I32", .needle = "I32", .step = 1, .name = "the type of a cast",
        .want = "type I32" },
    Spot::{ .line = "    defer more.free", .needle = "free", .step = 1, .name = "a method's name",
        .want = "free(" },
    Spot::{ .line = "    defer more.free", .needle = "()",
        .name = "the position just past a method's name", .want = "free(" },
}

priv fn hover_at(c: jsonrpc.Client$@, spot: Spot, arena: Arena$@): json.Val!jsonrpc.Rpc_end //<
    //< The hover at that spot
    col: = col_in_line(marks_src, spot.line, spot.needle, arena) + spot.step
    pos: = lsp_client.at_pos(marks_uri, decl_line(marks_src, spot.line, arena), col, arena)
    return c.request("textDocument/hover", pos, lsp_client.read_ms, arena)!.val

fn check_hover_marks(c: jsonrpc.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(marks_uri, marks_src, arena),
        lsp_client.send_ms, arena) catch {}
    defer lsp_client.close(c, marks_uri, arena)
    for spot in blank_spots
        label: = arena.text().s("a hover on ").s(spot.name).s(" answers nothing").take()
        got: = hover_at(c, spot, arena) catch e
            verdict.check(label, false, end_text(e))
            continue
        text: = lsp_client.hover_text(got)
        verdict.check(label, is_missing(got.get("result")),
            lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))
    // Caution: **These come after the empty ones**, which a dead worker would answer too: an answer
    // here shows the analysis is standing.
    for spot in named_spots
        label: = arena.text().s("a hover on ").s(spot.name).s(" answers it").take()
        got: = hover_at(c, spot, arena) catch e
            verdict.check(label, false, end_text(e))
            continue
        text: = lsp_client.hover_text(got)
        verdict.check(label, text.find_str(spot.want).is_some(),
            lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))

// ==========================================
// What a hover says on a value. **A literal shows the type it took in its place, and no name**:
// `4` in `size: Sz = 4` is `Sz` (shown as `type 4`, it read as a declaration). **A name where it
// is bound reads as it does where it is used** (`words: List<|U8[]|>`), for every kind of
// binding: a declaration with or without a written type, a parameter, a `for`'s item, an
// `if v: = opt`, a `catch e` and a pattern's payload.
// ==========================================
priv const values_src: U8[] =
    """import "std/ds" { List }

priv struct Pair
    a: I32
    b: U8[]

priv enum Shape
    dot
    circle(r: F64)

priv fn maybe(): I32?
    return .none

priv fn fail(): I32!U8[]
    return 1

fn run(n: Sz, names: List<|U8[]|>$@): Sz
    $words: = List<|U8[]|>.new(null)
    defer words.free()
    size: Sz = 4
    text: = "str"
    letter: = 'a'
    ratio: = 1.5
    nothing: U8@ = null
    yes: = true
    pair: = Pair::{ .a = 1, .b = "x" }
    $total: Sz = size + n + names.len + text.len + Sz::letter
    for w in words
        total += w.len
    for i in Range.asc(3)
        total += i
    if v: = maybe()
        total += Sz::v
    got: = fail() catch e
        fallback I32::e.len
    switch Shape.circle(ratio)
    case .circle(r)
        total += Sz::r
    default {}
    return total + Sz::got + Sz::pair.a + pair.b.len + (1 if yes && nothing == null else 0)
"""

priv const values_uri: U8[] = "file:///values_probe.kspl"

priv struct Ask //< a position in the probe, and what a hover there should show
    line: U8[] //< the start of its line
    needle: U8[] //< the text it stands in, first found in that line
    step: Sz //< how many characters into `needle`
    name: U8[] //< what stands there, for the check's label
    want: U8[] //< the whole line the answer shows; empty where the answer is `null`
    count: Sz //< for references, how many places the name has in the probe

priv const literal_asks: Ask[_] = ::{ //< the literals, each with the type it took
    Ask::{ .line = "    size: Sz", .needle = "4", .name = "an integer given a type", .want = "Sz" },
    Ask::{ .line = "    for i in", .needle = "3)", .name = "an integer passed as an `Sz`",
        .want = "Sz" },
    Ask::{ .line = "    pair: =", .needle = "1,", .name = "an integer given a field's type",
        .want = "I32" },
    Ask::{ .line = "    text: =", .needle = "\"str", .step = 1, .name = "a string",
        .want = "U8[]" },
    Ask::{ .line = "    pair: =", .needle = "\"x", .step = 1,
        .name = "a string given a field's type", .want = "U8[]" },
    Ask::{ .line = "    letter: =", .needle = "'a", .step = 1, .name = "a character",
        .want = "U8" },
    Ask::{ .line = "    ratio: =", .needle = "1.5", .step = 1, .name = "a float", .want = "F64" },
    Ask::{ .line = "    nothing: U8@", .needle = "null", .step = 1,
        .name = "a null given a pointer's type", .want = "U8@" },
    Ask::{ .line = "    yes: =", .needle = "true", .step = 1, .name = "a Bool", .want = "Bool" },
    Ask::{ .line = "    for w in", .needle = " in", .step = 1,
        .name = "the 'in' of a for, beside its copied collection" },
}

priv const bound_asks: Ask[_] = ::{ //< the names where they are bound, and fields set by name
    Ask::{ .line = "    $words: =", .needle = "words", .step = 1,
        .name = "a declaration of a struct's type, inferred",
        .want = "words: std.ds.List<|U8[]|>" },
    Ask::{ .line = "    nothing: U8@", .needle = "nothing", .step = 1,
        .name = "a declaration of a pointer's type, written", .want = "nothing: U8@" },
    Ask::{ .line = "    text: =", .needle = "text", .step = 1,
        .name = "a declaration of a slice's type, inferred", .want = "text: U8[]" },
    Ask::{ .line = "    size: Sz", .needle = "size", .step = 1,
        .name = "a declaration of a primitive type, written", .want = "size: Sz" },
    Ask::{ .line = "fn run", .needle = "names", .step = 1, .name = "a parameter",
        .want = "names: std.ds.List<|U8[]|>$@" },
    Ask::{ .line = "    for w", .needle = "w ", .name = "a for's item, by index",
        .want = "w: U8[]" },
    Ask::{ .line = "    for i", .needle = "i ", .name = "a for's item, from a Range",
        .want = "i: Sz" },
    Ask::{ .line = "    if v", .needle = "v:", .name = "an if's binding", .want = "v: I32" },
    Ask::{ .line = "    got: = fail() catch e", .needle = " e", .step = 1,
        .name = "a catch's binding", .want = "e: U8[]" },
    Ask::{ .line = "    case .circle(r)", .needle = "r)", .name = "a pattern's payload",
        .want = "r: F64" },
    Ask::{ .line = "    pair: =", .needle = ".a", .step = 1,
        .name = "a field set by name in a struct literal", .want = "field a: I32" },
    Ask::{ .line = "    pair: =", .needle = ".b", .step = 1,
        .name = "a second field set by name in a struct literal", .want = "field b: U8[]" },
}

priv fn request_at(c: jsonrpc.Client$@, method: U8[], ask: Ask, arena: Arena$@):
    json.Val!jsonrpc.Rpc_end //<
        //< That request at that position (references count the declaration)
    col: = col_in_line(values_src, ask.line, ask.needle, arena) + ask.step
    $b: = Json_builder.new(arena)
    doc: = b.obj().set("uri", b.str_val(values_uri)).build()
    pos: = b.obj().set("line", b.int_val(decl_line(values_src, ask.line, arena)))
        .set("character", b.int_val(col)).build()
    ctx: = b.obj().set("includeDeclaration", b.bool_val(true)).build()
    params: = b.obj().set("textDocument", doc).set("position", pos).set("context", ctx).build()
    // References walk the workspace, a hover only its own file.
    wait: =
        lsp_client.walk_ms if method.equals("textDocument/references") else lsp_client.read_ms
    return c.request(method, params, wait, arena)!.val

priv fn shown_line(text: U8[]): U8[] //< the answer's first line inside its code fence
    body: = text.strip_prefix("```kspl\n")
    return body.sub(0, body.find_char('\n').unwrap_or(body.len))

priv fn check_asks(c: jsonrpc.Client$@, asks: Ask[], arena: Arena$@) //<
    //< Each hover shows exactly what that position's `want` says
    for ask in asks
        label: = arena.text().s("a hover on ").s(ask.name).s(" shows ")
            .s(ask.want if ask.want.len > 0 else "nothing").take()
        got: = request_at(c, "textDocument/hover", ask, arena) catch e
            verdict.check(label, false, end_text(e))
            continue
        text: = lsp_client.hover_text(got)
        ok: =
            (is_missing(got.get("result")) if ask.want.len == 0
            else shown_line(text).equals(ask.want))
        verdict.check(label, ok,
            lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))

priv const ref_asks: Ask[_] = ::{ //< the names whose references are listed, each with its count
    Ask::{ .line = "    $words: =", .needle = "words", .step = 1, .name = "words", .count = 3 },
    Ask::{ .line = "    for w", .needle = "w ", .name = "w", .count = 2 },
}

priv fn check_refs(c: jsonrpc.Client$@, arena: Arena$@) //<
    //< References from where a name is bound list that name's places, each on the name itself
    lines: = values_src.lines(arena)
    for ask in ref_asks
        label: = arena.text().s("references from where '").s(ask.name).s("' is bound list its ")
            .s("\{ask.count\} places, each on it").take()
        got: = request_at(c, "textDocument/references", ask, arena) catch e
            verdict.check(label, false, end_text(e))
            continue
        spots: = got.get("result").arr_list(arena)
        $off: = List<|U8[]|>.new(arena)
        for spot in spots
            r: = spot.get("range")
            line: = Sz::r.get("start").get("line").as_int(-1I32)
            from: = Sz::r.get("start").get("character").as_int(-1I32)
            to: = Sz::r.get("end").get("character").as_int(-1I32)
            on: =
                (lines.get(line).sub(from, to - from)
                if line < lines.len && from <= to && to <= lines.get(line).len else "")
            uri: = spot.get("uri").as_str()
            if !uri.equals(values_uri) || !on.equals(ask.name)
                off
                    .push(arena.text().s(uri).s(":\{line + 1\}:\{from\} '").s(on).s("'").take())
        found: = arena.text().s("\{spots.len\} found, off: ").s(lsp_client.join(off@, arena)).take()
        verdict.check(label, off.len == 0 && spots.len == ask.count,
            lsp_client.why(c, found, arena))

fn check_hover_values(c: jsonrpc.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(values_uri, values_src, arena),
        lsp_client.send_ms, arena) catch {}
    defer lsp_client.close(c, values_uri, arena)
    check_asks(c, Ask[]::literal_asks, arena)
    // Caution: **These come after the literals**, which hold an empty answer a dead worker would
    // give too: an answer here shows the analysis is standing.
    check_asks(c, Ask[]::bound_asks, arena)
    check_refs(c, arena)

// ==========================================
// What a declaration says of itself, as the editor shows it: the hover's description and
// parameter list, and the panel that comes up while the call is being typed. **They are one
// subject, so they share one fixture**: one reader (`ksplc/base/ast_doc.kspl`) reads all three.
// ==========================================
// A hover shows the documentation the declaration carries
// ==========================================

// **The marks are read from the source, not from the tree**: a `//<` does not survive parsing
// (`ksplc/base/ast_doc.kspl`).
priv const doc_src: U8[] =
    """import "std/io"

pub struct Row //< one row of the table
  //< A row is one line of the table, not one line on the screen.
  /// What a row stands for, in a sentence.
  pub text: U8[] //< the text as the writer typed it


fn wide(a: I32, b: I32): I32 //< the whole of it written on one line
  return a + b


fn many(a1: Sz, a2: Sz, a3: Sz, a4: Sz, a5: Sz, a6: Sz, a7: Sz, a8: Sz, a9: Sz, a10: Sz, a11: Sz, a12: Sz, a13: Sz, a14: Sz, a15: Sz, a16: Sz, a17: Sz): Sz
  return a1 + a17


impl Row
  fn put( //< writes one row out
    r: Self@,
    at: Sz, //< which column it starts in
    //< Counted from 0, not 1.
    times: Sz,
  ): Sz //< how many characters the row now runs to
    return r.text.len + at + times



fn wrapped(a1: I32, a2: I32, a3: I32, a4: I32, a5: I32, a6: I32, a7: I32, a8: I32,
  a9: I32): I32 //<
  //< The summary of a head that closes on a later line
  //<
  //< The detail behind the parting mark.
  return a1 + a9 - a2 - a3 - a4 - a5 - a6 - a7 - a8


fn pointing(): Sz //< what `Row.put` gives back, never `r.text` alone
  return 0


fn quiet(io: Sz): Sz //< the `io.out` here is the parameter's, not the module's
  return io


fn main(): I32
  w2: = wrapped(1, 0, 0, 0, 0, 0, 0, 0, 0)
  r: Row = ::{ .text = "a" }
  n: = r.put(1, 2)
  w: = wide(3, 4)
  io.out().s(r.text)
  return I32::(r.text.len + n + Sz::w) - 1 + w2 - 1 + I32::quiet(0)

"""

priv const doc_uri: U8[] = "file:///doc_probe.kspl"

priv fn check_hover_doc(c: jsonrpc.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(doc_uri, doc_src, arena),
        lsp_client.send_ms, arena) catch {}
    defer lsp_client.close(c, doc_uri, arena)
    // The declaration's own line carries the summary, and the start of its contents the detail.
    line: = decl_line(doc_src, "pub struct Row", arena)
    col: = col_in_line(doc_src, "pub struct Row", "Row", arena)
    got: =
        c.request("textDocument/hover", lsp_client.at_pos(doc_uri, line, col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a hover carries the documentation the declaration holds", false,
            end_text(e))
        return
    text: = lsp_client.hover_text(got.val)
    verdict.check("a hover carries the documentation the declaration holds",
        text.find_str("one row of the table").is_some() &&
        text.find_str("not one line on the screen").is_some(),
        lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))
    // **A `///` is read as nothing, not as the struct's**, or a field's description written the
    // Rust way lands silently on the struct. It is a warning (`[W0212]`).
    verdict.check("a /// is read as nothing, not as the struct's",
        text.find_str("What a row stands for").is_none(),
        lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))
    // A head ending on a later line starts its run on that line, with **a mark carrying no
    // text**; one with text describes the return type (`return_doc` in `../../base/ast_doc.kspl`).
    w_line: = decl_line(doc_src, "  w2: = wrapped(1,", arena)
    w_col: = col_in_line(doc_src, "  w2: = wrapped(1,", "wrapped", arena)
    w2_got: =
        c.request("textDocument/hover", lsp_client.at_pos(doc_uri, w_line, w_col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a head closing on a later line carries its run", false, end_text(e))
        return
    w2_text: = lsp_client.hover_text(w2_got.val)
    verdict.check("a head closing on a later line carries its run",
        w2_text.find_str("The summary of a head that closes on a later line").is_some() &&
        w2_text.find_str("The detail behind the parting mark.").is_some(),
        lsp_client.why(c, arena.text().s("'").s(w2_text).s("'").take(), arena))
    // A mark with no text inside a run separates the summary from the detail (PEP 257's blank
    // line).
    verdict.check("a mark carrying no text parts the summary from the detail",
        w2_text.find_str("later line.\n\nThe detail behind").is_some(),
        lsp_client.why(c, arena.text().s("'").s(w2_text).s("'").take(), arena))

    // Caution: **Test a field too.** It has no contents, and searching for a `{` would find the
    // struct's and show the wrong sentence.
    f_line: = decl_line(doc_src, "  pub text: U8[]", arena)
    f_col: = col_in_line(doc_src, "  pub text: U8[]", "text", arena)
    f_got: =
        c.request("textDocument/hover", lsp_client.at_pos(doc_uri, f_line, f_col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a hover over a field carries that field's own sentence", false,
            end_text(e))
        return
    f_text: = lsp_client.hover_text(f_got.val)
    verdict.check("a hover over a field carries that field's own sentence",
        f_text.find_str("the text as the writer typed it").is_some() &&
        f_text.find_str("What a row stands for").is_none(),
        lsp_client.why(c, arena.text().s("'").s(f_text).s("'").take(), arena))

priv fn check_hover_params(c: jsonrpc.Client$@, arena: Arena$@) //<
    //< It checks a hover shows the parameters one per line, each with its own `//<`
    //<
    //< The lines are as the source has them.
    //< A parameter with no comment stays bare, and a run continued below joins its parameter's
    //< line.
    //< Caution: **Test a signature written on one line too.** Its `//<` describes the declaration;
    //< taken per parameter, each would repeat the declaration\'s summary.
    c.notify("textDocument/didOpen", lsp_client.did_open(doc_uri, doc_src, arena),
        lsp_client.send_ms, arena) catch {}
    defer lsp_client.close(c, doc_uri, arena)
    line: = decl_line(doc_src, "  n: = r.put(1, 2)", arena)
    col: = col_in_line(doc_src, "  n: = r.put(1, 2)", "put", arena)
    got: =
        c.request("textDocument/hover", lsp_client.at_pos(doc_uri, line, col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a hover lists the parameters that carry a description", false, end_text(e))
        return
    text: = lsp_client.hover_text(got.val)
    verdict.check("a hover lays a described parameter out on its own line",
        text.find_str("\n    at: Sz, //< which column it starts in Counted from 0, not 1.\n")
        .is_some(),
        lsp_client.why(c, arena.text().s("\'").s(text).s("\'").take(), arena))
    verdict.check("a parameter that describes nothing stands with nothing behind it",
        text.find_str("\n    times: Sz,\n").is_some() &&
        text.find_str("times: Sz, //<").is_none(),
        lsp_client.why(c, arena.text().s("\'").s(text).s("\'").take(), arena))
    // Caution: **The return's line is described too, and by nothing else.** It is neither the
    // declaration's line (`decl_summary`) nor the last parameter's run, so if not read here it
    // shows nowhere (`return_doc` in `../../base/ast_doc.kspl`).
    verdict.check("a hover shows what the return type's own line says",
        text.find_str("): Sz //< how many characters the row now runs to").is_some(),
        lsp_client.why(c, arena.text().s("\'").s(text).s("\'").take(), arena))

    w_line: = decl_line(doc_src, "  w: = wide(3, 4)", arena)
    w_col: = col_in_line(doc_src, "  w: = wide(3, 4)", "wide", arena)
    w_got: =
        c.request("textDocument/hover", lsp_client.at_pos(doc_uri, w_line, w_col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a one-line signature gives its summary to no parameter", false,
            end_text(e))
        return
    w_text: = lsp_client.hover_text(w_got.val)
    verdict.check("a one-line signature gives its summary to no parameter",
        w_text.find_str("the whole of it written on one line").is_some() &&
        w_text.find_str("//<").is_none(),
        lsp_client.why(c, arena.text().s("\'").s(w_text).s("\'").take(), arena))
    verdict.check("a signature that describes nothing and fits stays on one line",
        w_text.find_str("wide(a: I32, b: I32): I32").is_some(),
        lsp_client.why(c, arena.text().s("\'").s(w_text).s("\'").take(), arena))

    // Caution: **Test the elision on a real declaration, not only on the count**: the return type's
    // line, which a reader needs, must still be shown.
    m_line: = decl_line(doc_src, "fn many(a1: Sz,", arena)
    m_col: = col_in_line(doc_src, "fn many(a1: Sz,", "many", arena)
    m_got: =
        c.request("textDocument/hover", lsp_client.at_pos(doc_uri, m_line, m_col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a signature past the cap says how many were left out", false, end_text(e))
        return
    m_text: = lsp_client.hover_text(m_got.val)
    verdict.check("a signature past the cap says how many were left out",
        m_text.find_str("    a16: Sz,\n    // ... 1 more\n").is_some(),
        lsp_client.why(c, arena.text().s("\'").s(m_text).s("\'").take(), arena))
    verdict.check("an elided signature still carries the return type",
        m_text.find_str("\n): Sz").is_some() && m_text.find_str("a17").is_none(),
        lsp_client.why(c, arena.text().s("\'").s(m_text).s("\'").take(), arena))

priv fn check_hover_links(c: jsonrpc.Client$@, arena: Arena$@) //<
    //< A name the description mentions is shown as a link to where it is declared
    //<
    //< **It is resolved as `[W0211]` resolves it**, through the description's scope: `Row.put`
    //< links, `r.text` (unknown head) stays text, and so does `io.out` where a parameter `io` hides
    //< the module.
    //< Caution: **Check the line, not just the link**, or one opening the file at its start passes.
    c.notify("textDocument/didOpen", lsp_client.did_open(doc_uri, doc_src, arena),
        lsp_client.send_ms, arena) catch {}
    defer lsp_client.close(c, doc_uri, arena)
    line: = decl_line(doc_src, "fn pointing(): Sz", arena)
    col: = col_in_line(doc_src, "fn pointing(): Sz", "pointing", arena)
    got: =
        c.request("textDocument/hover", lsp_client.at_pos(doc_uri, line, col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a name the description points at becomes a link", false, end_text(e))
        return
    text: = lsp_client.hover_text(got.val)
    put_line: = decl_line(doc_src, "  fn put( //< writes one row out", arena)
    want: = arena.text().s("doc_probe.kspl#L").s("\{put_line + 1\}").s(")").take()
    verdict.check("a name the description points at becomes a link to its line",
        text.find_str("[`Row.put`](file://").is_some() && text.find_str(want).is_some(),
        lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))
    verdict.check("a name the file does not know stays text",
        text.find_str("`r.text` alone").is_some() && text.find_str("[`r.text`]").is_none(),
        lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))
    q_line: = decl_line(doc_src, "fn quiet(io: Sz): Sz", arena)
    q_col: = col_in_line(doc_src, "fn quiet(io: Sz): Sz", "quiet", arena)
    q_at: = lsp_client.at_pos(doc_uri, q_line, q_col, arena)
    got_q: = c.request("textDocument/hover", q_at, lsp_client.read_ms, arena) catch e
        verdict.check("a parameter hides the module's name in its function", false, end_text(e))
        return
    quiet: = lsp_client.hover_text(got_q.val)
    verdict.check("a parameter hides the module's name in its function",
        quiet.find_str("`io.out` here").is_some() && quiet.find_str("[`io.out`]").is_none(),
        lsp_client.why(c, arena.text().s("'").s(quiet).s("'").take(), arena))

fn run_docs(c: jsonrpc.Client$@, arena: Arena$@)
    check_hover_doc(c, arena)
    check_hover_params(c, arena)
    check_hover_links(c, arena)

//< The language server keeps answering where something about the input is off
//<
//< Past a broken line, after its worker is remade, on a package opened alone, and on a template
//< that is never instantiated.
//<
//< Not a suite; `../suite/lsp_test.kspl` runs each part.
import "ksplc/tests/support/harness"
import "ksplc/tests/support/lsp_client"
import "ksplc/tests/support/lsp_read" { col_in_line, decl_line, end_text, is_missing }
import "std/chars"
import "std/ds" as _ds // what makes `arr_list`'s List available
import "std/fs"
import "std/json" + { Json_builder }
import "std/jsonrpc"
import "std/mem" { Arena }
import "std/str" // `find_str` and `equals`
import "std/strfmt" as _strfmt
import "std/sys"
import "std/verdict"

priv fn expect_symbols(c: jsonrpc.Client$@, uri: U8[], want: U8[], name: U8[], arena: Arena$@)
    got: = lsp_client.answer(c, "textDocument/documentSymbol", lsp_client.at_doc(uri, arena),
        lsp_client.read_ms, arena)
    result: = got.get("result")
    symbols: = result.arr_list(arena)
    matches: =
        (symbols.len == 0 if want.len == 0
        else symbols.len == 1 && symbols.get(0).get("name").as_str().equals(want))
    verdict.check(name, !is_missing(result) && matches, lsp_client.dump(got, arena))

fn run_empty(exe: U8[], arena: Arena$@) //< an empty buffer hides both previous and saved text
    dir: = harness.sandbox("lsp_empty")
    fs.write_tree(dir, U8[][]::{ "brace.kspl", "laid.kspl" },
        U8[][]::{ "pub fn saved(): I32 { return 1; }\n", "pub fn saved(): I32\n    return 1\n" },
        arena) catch
        verdict.check("the empty-buffer workspace is written", false, "write failed")
        return
    $c: = lsp_client.start(exe, U8[][]::{}, dir, arena) catch
        verdict.check("the empty-buffer client starts", false, "start failed")
        return
    defer c.free()
    _ready: =
        c.request("initialize", lsp_client.empty_obj(arena), lsp_client.read_ms, arena) catch {}
    for rel in U8[][]::{ "brace.kspl", "laid.kspl" }
        uri: = lsp_client.uri_of(dir, rel, arena)
        text: =
            ("fn first(): I32\n    return 1\n" if rel.ends_with(".kspl")
            else "fn first(): I32 { return 1; }\n")
        c.notify("textDocument/didOpen", lsp_client.did_open(uri, text, arena), lsp_client.send_ms,
            arena) catch {}
        expect_symbols(c@, uri, "first", "a nonempty buffer overrides its saved declarations", arena)
        for replacement in U8[][]::{ "", text, "" }
            $b: = Json_builder.new(arena)
            params: = b.obj()
                .set("textDocument", b.obj().set("uri", b.str_val(uri)).build())
                .set("contentChanges",
                b.arr().push(b.obj().set("text", b.str_val(replacement)).build()).build()).build()
            c.notify("textDocument/didChange", params, lsp_client.send_ms, arena) catch {}
            want: = "" if replacement.len == 0 else "first"
            expect_symbols(c@, uri, want,
                "clearing and restoring a buffer replaces its declarations", arena)
        lsp_client.close(c@, uri, arena)
        c.notify("textDocument/didOpen", lsp_client.did_open(uri, "", arena), lsp_client.send_ms,
            arena) catch {}
        expect_symbols(c@, uri, "", "an empty reopened buffer hides its saved declarations", arena)
        c.notify("$/ksplTestCrash", lsp_client.empty_obj(arena), lsp_client.send_ms, arena) catch {}
        expect_symbols(c@, uri, "", "an empty buffer stays empty after worker recovery", arena)
        use: = arena.text().s("import \"").s(rel).s("\" as blank\n")
            .s("fn ask(): I32 { return blank.saved(); }\n").take()
        use_uri: = lsp_client.uri_of(dir, "use.kspl", arena)
        c.notify("textDocument/didOpen", lsp_client.did_open(use_uri, use, arena),
            lsp_client.send_ms, arena) catch {}
        pos: = lsp_client.at_pos(use_uri, 1, col_in_line(use, "fn ask", "saved", arena), arena)
        jump: = lsp_client.answer(c@, "textDocument/definition", pos, lsp_client.read_ms, arena)
        result: = lsp_client.dump(jump.get("result"), arena)
        verdict.check("an imported empty buffer hides its saved declarations",
            jump.get("id").as_int(0) > 0 && is_missing(jump.get("error")) &&
            (result.equals("null") || result.equals("[]")), lsp_client.dump(jump, arena))
        expect_symbols(c@, uri, "", "an imported empty buffer remains queryable", arena)
        lsp_client.close(c@, use_uri, arena)
        lsp_client.close(c@, uri, arena)

// ==========================================
// A file holding one broken line still answers in the editor
// Not a suite; part of `../suite/lsp_test.kspl`, whose client it uses (one of its own would start
// the language server a second time). **The editor reads the file a second time with the
// recovering branches enabled** ("Only the editor's parse recovers from a syntax error" in
// `../../docs/DESIGN-tools.md`), so after a half-typed `pt.` the hover and the jump still answer.
// ==========================================
// The `q: = pt.` line is broken. Everything above and below it is valid.
priv const broken_src: U8[] =
    """struct Point //< a place on the page
  x: I32
  y: I32


fn area(p: Point): I32 //< how much it covers
  return p.x * p.y


fn main(): I32
  pt: Point = ::{ .x = 3, .y = 4 }
  n: = area(pt)
  q: = pt.
  return n

"""

priv const broken_uri: U8[] = "file:///recover_probe.kspl"

priv fn check_answers_beside_the_break(c: jsonrpc.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(broken_uri, broken_src, arena),
        lsp_client.send_ms, arena) catch {}
    defer lsp_client.close(c, broken_uri, arena)
    line: = decl_line(broken_src, "  n: = area(pt)", arena)
    col: = col_in_line(broken_src, "  n: = area(pt)", "area", arena)
    got: =
        c.request("textDocument/hover", lsp_client.at_pos(broken_uri, line, col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a hover beside a broken line still answers", false, end_text(e))
        return
    text: = lsp_client.hover_text(got.val)
    verdict.check("a hover beside a broken line still answers",
        text.find_str("how much it covers").is_some(),
        lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))

    // Caution: **Test a jump too**: a hover needs only the node under the caret, the jump the tree
    // above it.
    def_got: =
        c.request("textDocument/definition", lsp_client.at_pos(broken_uri, line, col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a jump beside a broken line still lands", false, end_text(e))
        return
    def_line: = def_got.val.get("result").get("range").get("start").get("line").as_int(-1)
    want: = decl_line(broken_src, "fn area(p: Point): I32", arena)
    landed: = arena.text().s("landed on line ").s("\{def_line\}").take()
    verdict.check("a jump beside a broken line still lands", def_line == want,
        lsp_client.why(c, landed, arena))

priv fn check_one_account_only(c: jsonrpc.Client$@, arena: Arena$@) //<
    //< It checks a missing bracket is reported once, by the parse
    //<
    //< **Only the parse reports it**. In a recovered tree the later stages find only the chain of
    //< unrelated errors one missing bracket sets off.
    c.notify("textDocument/didOpen", lsp_client.did_open(broken_uri, broken_src, arena),
        lsp_client.send_ms, arena) catch {}
    defer lsp_client.close(c, broken_uri, arena)
    $count: Sz = 0
    $came: = false
    for _k in Range.asc(12)
        msg: = c.read_msg(lsp_client.read_ms, arena) catch
            break
        if !msg.val.get("method").as_str().equals("textDocument/publishDiagnostics")
            continue
        got: = msg.val.get("params")
        if !got.get("uri").as_str().ends_with("recover_probe.kspl")
            continue
        list: = got.get("diagnostics").arr_list(arena)
        count = list.len
        came = true
        break
    verdict.check("a broken line is accounted for once and no more", came && count == 1,
        lsp_client.why(c, arena.text().s("\{count\} diagnostics, came=\{came\}").take(), arena))

// A declaration whose block is never closed, **holding everything below it**: the file above must
// still answer, and the parse must not run on to the end of the input.
priv const unclosed_src: U8[] =
    """fn area(p: I32): I32 //< how much it covers
  return p * p

struct Half
fn tail(): I32
  return 1

"""

priv const unclosed_uri: U8[] = "file:///unclosed_probe.kspl"

priv fn check_an_unclosed_block(c: jsonrpc.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(unclosed_uri, unclosed_src, arena),
        lsp_client.send_ms, arena) catch {}
    defer lsp_client.close(c, unclosed_uri, arena)
    line: = decl_line(unclosed_src, "fn area(p: I32): I32", arena)
    col: = col_in_line(unclosed_src, "fn area(p: I32): I32", "area", arena)
    got: =
        c.request("textDocument/hover", lsp_client.at_pos(unclosed_uri, line, col, arena),
        lsp_client.read_ms, arena) catch e
        verdict.check("a block left unclosed does not take the file with it", false, end_text(e))
        return
    text: = lsp_client.hover_text(got.val)
    verdict.check("a block left unclosed does not take the file with it",
        text.find_str("how much it covers").is_some(),
        lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))

fn run_recover(c: jsonrpc.Client$@, arena: Arena$@)
    check_answers_beside_the_break(c, arena)
    check_one_account_only(c, arena)
    check_an_unclosed_block(c, arena)

// ==========================================
// What the language server answers after its worker is remade, with many documents open. **Each
// check starts a client of its own.** **The first answer after a recovery waits for its own
// document's analysis** ("The language server is split into two processes: the watcher and the
// analyser" in `../../docs/DESIGN-tools.md`), measured against analysing every open document in
// the same run, so a slow machine moves both alike.
// ==========================================
priv const watchdog_ms: I64 = 10000 //<
    //< The supervisor's hang timeout (`worker_timeout_ms` in `../../lsp/server.kspl`)
    //<
    //< Written again here: importing the server would build the language server into this suite.
priv const copies: Sz = 20 //< how many documents are open when the worker is remade
priv const share_of_all: I64 = 2 //<
    //< The recovery may take at most 1/`share_of_all` of analysing every open copy
    //<
    //< **What the check tells apart**: waiting for every open document costs about all of it, and
    //< waiting for its own document (plus an idle-time analysis the request may find under way)
    //< about 2/`copies` of it. Half sits far from both, so neither a loaded machine nor the
    //< watchdog's own jitter moves a run across it; a multiple of one document's recovery
    //< does.
priv const copy_fns: Sz = 250 //<
    //< How many functions each copy holds, so analysing one takes measurable work
    //<
    //< **Made here, not read from a file of the package**: the work stays the same whatever the
    //< package's files become, and none is imported, so each analysis is the copy alone.
priv const hover_decl: U8[] = "fn first(" //< the declaration the hover asks about
priv const crash_hook: U8[] = "$/ksplTestCrash"
priv const hang_hook: U8[] = "$/ksplTestHang"

priv fn copy_uri(k: Sz, arena: Arena$@): U8[] //< the `k`th copy's name
    return arena.text().s("file:///restart_copy_\{k\}.kspl").take()

priv fn copy_text(arena: Arena$@): U8[] //< the text every copy holds
    b: = arena.text()
    b.s("fn first(a: I32): I32 //< the function the hover asks about\n  return a\n\n")
    for k in Range.asc(copy_fns)
        b.s("fn step_\{k\}(a: I32): I32\n  b: I32 = first(a) * 2\n  return b + \{k\}\n\n")
    return b.take()

priv struct Recovery //< what one recovery took, from sending the hook on
    ms: I64 //< until the hover answered; -1 where no answer came
    answered: Bool //< whether the answer showed the declaration (not the null of a lost request)
    published: Sz //< how many of the open copies had their diagnostics published again

priv fn copy_of(uri: U8[], open: Sz, arena: Arena$@): I32 //< which open copy `uri` names; -1 none
    for k in Range.asc(open)
        if uri.equals(copy_uri(k, arena))
            return I32::k
    return -1

priv fn recover(c: jsonrpc.Client$@, hook: U8[], open: Sz, id: I32, text: U8[], arena: Arena$@):
    Recovery //<
        //< It sends `hook` and at once a hover on the first copy, and reads all that comes back
        //<
        //< It reads until the answer and every open copy's diagnostics have come.
        //< **Read the messages here, not through `request`**, which skips the diagnostics that
        //< come before its answer.
    line: = decl_line(text, hover_decl, arena)
    col: = col_in_line(text, hover_decl, "first", arena) + 1
    pos: = lsp_client.at_pos(copy_uri(0, arena), line, col, arena)
    $seen: Bool[copies] = ::{}
    $out: = Recovery::{ .ms = -1, .answered = false, .published = 0 }
    t0: = sys.mono_us()
    c.notify(hook, lsp_client.empty_obj(arena), lsp_client.send_ms, arena) catch {}
    c.send_raw(jsonrpc.encode("textDocument/hover", pos, id, arena), lsp_client.send_ms) catch {}
    for out.ms < 0 || out.published < open
        // The first answer after a hang comes once the watchdog has given up.
        wait: = I32::(watchdog_ms + I64::lsp_client.read_ms)
        msg: = c.read_msg(wait, arena) catch
            break
        if msg.val.get("id").as_int(-1) == id
            out.ms = (sys.mono_us() - t0) / 1000I64
            out.answered = lsp_client.hover_text(msg.val).find_str("first").is_some()
            continue
        if !msg.val.get("method").as_str().equals("textDocument/publishDiagnostics")
            continue
        k: = copy_of(msg.val.get("params").get("uri").as_str(), open, arena)
        if k >= 0 && !seen[k]
            seen[k] = true
            out.published += 1
    return out

priv fn open_copies(c: jsonrpc.Client$@, from: Sz, to: Sz, text: U8[], arena: Arena$@): Bool //<
    //< It opens copies `from` to `to` (excluded) and waits for each one's diagnostics
    //<
    //< **Settle before the hook**: diagnostics still on the way would be counted as the recovery's.
    for k in Range.asc(to - from)
        c.notify("textDocument/didOpen",
            lsp_client.did_open(copy_uri(from + k, arena), text, arena), lsp_client.send_ms, arena)
            catch {}
    $left: = to - from
    for left > 0
        msg: = c.read_msg(lsp_client.read_ms, arena) catch
            return false
        if msg.val.get("method").as_str().equals("textDocument/publishDiagnostics")
            left -= 1
    return true

priv fn told(c: jsonrpc.Client$@, line: U8[], arena: Arena$@): Bool //<
    //< Whether the supervisor's log carries `line`, copied at once (`err_tail` borrows its buffer)
    return arena.text().s(c.err_tail()).take().find_str(line).is_some()

fn check_first_answer(exe: U8[], arena: Arena$@) //<
    //< That a recovery with many documents open answers in about one document's analysis
    //<
    //< After a crash and after a hang alike; every other document's diagnostics still come.
    name: = "a recovery with many documents open answers in about one document's analysis"
    text: = copy_text(arena)
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, "", arena) catch
        verdict.check(name, false, "the client cannot be started")
        return
    defer c.free()
    _init: =
        c.request("initialize", lsp_client.empty_obj(arena), lsp_client.read_ms, arena) catch {}
    if !verdict.check("the copy a recovery is measured on opens",
        open_copies(c@, 0, 1, text, arena), lsp_client.why(c@, "", arena))
        return

    // One document's recovery, reported beside the timing so a failure shows both scales.
    got_one: = recover(c@, crash_hook, 1, 9000, text, arena)
    verdict.check("a hover answers after a crash with one document open", got_one.answered,
        lsp_client.why(c@, "", arena))
    one: = got_one.ms

    // The yardstick: analysing every other copy as it is opened (each waits for its diagnostics).
    t_open: = sys.mono_us()
    if !verdict.check("every copy opens", open_copies(c@, 1, copies, text, arena),
        lsp_client.why(c@, "", arena))
        return
    all_ms: = (sys.mono_us() - t_open) / 1000I64
    budget: = all_ms / share_of_all
    for hook in U8[][]::{ crash_hook, hang_hook }
        is_hang: = hook.equals(hang_hook)
        got: = recover(c@, hook, copies, 9100 + I32::is_hang, text, arena)
        allowed: = budget + (watchdog_ms if is_hang else 0I64)
        after: = "a hang" if is_hang else "a crash"
        timing: = arena.text()
            .s("\{got.ms\} ms with \{copies\} documents open; analysing them took \{all_ms\} ms and \
                one document's recovery \{one\} ms, so the budget is \{allowed\} ms").take()
        took: = lsp_client.why(c@, timing, arena)
        verdict.check(arena.text().s("after ").s(after)
            .s(", a hover answers in about one document's analysis, not one per open document")
            .take(), got.answered && got.ms <= allowed, took)
        verdict.check(arena.text().s("after ").s(after)
            .s(", every open document's diagnostics are published again").take(),
            got.published == copies,
            lsp_client.why(c@, arena.text().s("\{got.published\} of \{copies\}").take(), arena))
    verdict.check("the supervisor's log counts the documents it restores",
        told(c@, arena.text().s("open documents to restore: \{copies\})").take(), arena),
        lsp_client.why(c@, "", arena))

// ==========================================
// A document whose analysis crashes the worker is quarantined, and the others go on answering
// ==========================================

priv const kept_src: U8[] = "fn main(): I32\n  probe: I64 = 1\n  return 0\n\n"
priv const kept_uris: U8[][_] = ::{ "file:///kept_a.kspl", "file:///kept_b.kspl" }
priv const poison_uri: U8[] = "kspl-test-poison:///poison.kspl" //<
    //< A name whose analysis crashes the worker (`test_poison_scheme` in `../../lsp/worker.kspl`)

priv fn probe_hover(c: jsonrpc.Client$@, uri: U8[], arena: Arena$@): json.Val
    got: = lsp_client.answer(c, "textDocument/hover", lsp_client.at_pos(uri, 1, 3, arena),
        lsp_client.read_ms, arena)
    return got

fn check_quarantine(exe: U8[], arena: Arena$@) //<
    //< That a document crashing its analysis is quarantined while the others go on answering
    //<
    //< **The document is found when it is analysed**, which after a restart comes later than the
    //< restart itself; the worker is not remade without end.
    name: = "a document that crashes its analysis is quarantined"
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, "", arena) catch
        verdict.check(name, false, "the client cannot be started")
        return
    defer c.free()
    _init: =
        c.request("initialize", lsp_client.empty_obj(arena), lsp_client.read_ms, arena) catch {}
    for uri in kept_uris
        c.notify("textDocument/didOpen", lsp_client.did_open(uri, kept_src, arena),
            lsp_client.send_ms, arena) catch {}
    c.notify("textDocument/didOpen", lsp_client.did_open(poison_uri, kept_src, arena),
        lsp_client.send_ms, arena) catch {}
    for uri in kept_uris
        text: = lsp_client.hover_text(probe_hover(c@, uri, arena))
        verdict.check(arena.text().s("a document beside the quarantined one answers: ").s(uri)
            .take(), text.find_str("I64").is_some(),
            lsp_client.why(c@, arena.text().s("'").s(text).s("'").take(), arena))
    poisoned: = probe_hover(c@, poison_uri, arena)
    verdict.check("the crashing document answers nothing, without bringing the worker down",
        lsp_client.hover_text(poisoned).len == 0 && c.alive(),
        lsp_client.dump(poisoned, arena))
    verdict.check(name,
        told(c@, arena.text().s("quarantining '\{poison_uri\}'").take(), arena),
        lsp_client.why(c@, "", arena))
    again: = lsp_client.hover_text(probe_hover(c@, kept_uris[0], arena))
    verdict.check("after the quarantine the worker goes on answering",
        again.find_str("I64").is_some(),
        lsp_client.why(c@, arena.text().s("'").s(again).s("'").take(), arena))

fn run_restart(exe: U8[], arena: Arena$@)
    check_first_answer(exe, arena)
    check_quarantine(exe, arena)

// ==========================================
// A package that names itself, edited in an editor opened on its own folder
// **The folder's name differs from the package's** (`alone/` holding `mypkg`). A server naming a
// document by its path (`use/user`) disagrees with the pipeline's `mypkg/use/user`: the jump, the
// rename and the hover find nothing, and a logical-name answer points into a missing `mypkg/`.
// ==========================================
priv const heavy_ms: I32 = 60000 //< the first answer analyses the prelude's import tree too

priv const own_top: U8[] = "alone" //< the folder the server is started in, and the package's top
priv const own_rels: U8[][_] = ::{ "alone/ksplc.cfg", "alone/lib.kspl", "alone/use/user.kspl",
    "alone/gated.kspl" }
priv const own_user: U8[] = "import \"mypkg/lib\"\n\npub fn use(): I32\n  return lib.hit()\n"
priv const own_gated: U8[] = "#cfg(probe_flag)\npub fn gated(): I32\n  return 1\n" //<
    //< A declaration an unset flag leaves out, which a hover explains with the reason
priv const own_bodies: U8[][_] = ::{ "[package]\nname = mypkg\n", "pub fn hit(): I32\n  return 1\n",
    own_user, own_gated }
priv const own_call: U8[] = "  return lib.hit()"

priv fn def_uri(c: jsonrpc.Client$@, uri: U8[], arena: Arena$@): U8[] //<
    //< Where `hit` is defined, asked from the user's document under that spelling
    pos: = lsp_client.at_pos(uri, decl_line(own_user, own_call, arena),
        col_in_line(own_user, own_call, "hit", arena) + 1, arena)
    got: = lsp_client.answer(c, "textDocument/definition", pos, heavy_ms, arena)
    return got.get("result").get("uri").as_str()

priv fn marks_on(c: jsonrpc.Client$@, uri: U8[], arena: Arena$@): I32 //<
    //< How many diagnostics a `didOpen` of the user's document reports; -1 where none came
    c.notify("textDocument/didOpen", lsp_client.did_open(uri, own_user, arena), lsp_client.send_ms,
        arena) catch {}
    for _k in Range.asc(12)
        msg: = c.read_msg(lsp_client.read_ms, arena) catch
            break
        if !msg.val.get("method").as_str().equals("textDocument/publishDiagnostics")
            continue
        got: = msg.val.get("params")
        if !got.get("uri").as_str().equals(uri)
            continue
        return I32::got.get("diagnostics").arr_list(arena).len
    return -1

fn run_package(exe: U8[], arena: Arena$@)
    name: = "a package's own folder is worked on as the package"
    dir: = harness.sandbox("lsp_own")
    fs.write_tree(dir, U8[][]::own_rels, U8[][]::own_bodies, arena) catch
        verdict.check(name, false, "it cannot be placed in the working directory")
        return
    top: = arena.text().s(dir).c('/').s(own_top).take()
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, top, arena) catch
        verdict.check(name, false, "the language server cannot be started")
        return
    defer c.free()
    $b: = Json_builder.new(arena)
    _ready: =
        c.request("initialize", b.obj().build(), lsp_client.read_ms, arena) catch e
        verdict.check(name, false, end_text(e))
        return
    // **Both spellings are tested** (the two a client names a document by, `lsp_client.kspl`).
    full: = lsp_client.uri_of(top, "use/user.kspl", arena)
    marks: = marks_on(c@, full, arena)
    counted: = arena.text().s("\{marks\} diagnostics (-1: none came)").take()
    verdict.check("a sound document of its own is marked with nothing", marks == 0,
        lsp_client.why(c@, counted, arena))
    back: = def_uri(c@, full, arena)
    want: = lsp_client.uri_of(top, "lib.kspl", arena)
    verdict.check("asked by the file:// URI, the jump lands on the file in its folder",
        back.equals(want),
        lsp_client.why(c@, arena.text().s("'").s(back).s("'").take(), arena))
    c.notify("textDocument/didOpen", lsp_client.did_open("use/user.kspl", own_user, arena),
        lsp_client.send_ms, arena) catch {}
    flat: = def_uri(c@, "use/user.kspl", arena)
    verdict.check("asked by the folder-relative name, it answers by that name",
        flat.equals("lib.kspl"),
        lsp_client.why(c@, arena.text().s("'").s(flat).s("'").take(), arena))
    // **The workspace walk names what it reads the same way**, or a rename splits callers from the
    // declaration.
    at_hit: = b.obj().set("line", b.int_val(0I64)).set("character", b.int_val(8I64)).build()
    params: = b.obj()
        .set("textDocument", b.obj().set("uri", b.str_val("lib.kspl")).build())
        .set("position", at_hit).set("newName", b.str_val("tap")).build()
    renamed: = lsp_client.answer(c@, "textDocument/rename", params, heavy_ms, arena)
    changes: = renamed.get("result").get("changes")
    verdict.check("a rename reaches the callers in its other folders",
        changes.has_key("lib.kspl") && changes.has_key("use/user.kspl"),
        lsp_client.dump(changes, arena))
    // **The range left out is recorded under the logical name**, which a copy's URI need not end
    // with.
    gated: = lsp_client.uri_of(top, "gated.kspl", arena)
    c.notify("textDocument/didOpen", lsp_client.did_open(gated, own_gated, arena),
        lsp_client.send_ms, arena) catch {}
    why: = lsp_client.answer(c@, "textDocument/hover", lsp_client.at_pos(gated, 1, 8, arena),
        lsp_client.read_ms, arena)
    said: = lsp_client.hover_text(why)
    verdict.check("what an unraised #cfg leaves out of it answers with the reason",
        said.find_str("not analyzed").is_some(),
        lsp_client.why(c@, arena.text().s("'").s(said).s("'").take(), arena))

// ==========================================
// Checks the type-argument constraints of a template that is never instantiated
// Checked at the template, it always fails as **not satisfying a constraint it declared itself** —
// a template's `K` is bound to nothing, so the conformance table is empty. **It is a file of its
// own for its subject**, "a diagnostic that appears only while editing".
// ==========================================
priv const bound_src: U8[] =
    """pub trait Hashable<|Key|>
  fn hash(r: Self): U32
  fn equals(r: Self, other: Key): Bool


pub struct Box<|K: Hashable<|K|>|>
  priv k: K


pub struct Seq<|K: Hashable<|K|>|>
  priv b: Box<|K|>$@


impl<|K: Hashable<|K|>|> Box<|K|>
  pub fn items(r: Self$@): Seq<|K|>
    return Seq<|K|>::{ .b = r }


"""

priv const bound_uri: U8[] = "file:///bound_probe.kspl"

fn check_template_bound(c: jsonrpc.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(bound_uri, bound_src, arena),
        lsp_client.send_ms, arena) catch {}
    defer lsp_client.close(c, bound_uri, arena)
    $found: = false
    $count: Sz = 0
    $first: U8[] = ""
    for _k in Range.asc(8)
        msg: = c.read_msg(lsp_client.read_ms, arena) catch
            break
        if !msg.val.get("method").as_str().equals("textDocument/publishDiagnostics")
            continue
        p: = msg.val.get("params")
        if !p.get("uri").as_str().ends_with("bound_probe.kspl")
            continue
        found = true
        got: = p.get("diagnostics").arr_list(arena)
        count = got.len
        if count > 0
            first = got.get(0).get("message").as_str()
        break
    seen_text: =
        arena.text().s("\{count\}: \{first\}").take() if found else "(no publishDiagnostics came)"
    verdict.check("a template raises no diagnostic on a type constraint it declared itself",
        found && count == 0, lsp_client.why(c, seen_text, arena))

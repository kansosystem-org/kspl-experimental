//< The few lines that build the LSP params sent to `ksplc lsp`
//< Not a suite. The suites that drive the language server use it: ksplc's own, on the files they
//< are given, and the root's, over the repository's whole tree.
//< **The framing is not here.** `std/jsonrpc` handles the Content-Length frame, the id, standard
//< error and the timeout. Here is only "which LSP method gets what".
//< **It knows no harness.** The caller passes the workspace, so the root's suites can use it.
//< What they call is `pub`.
//< Caution: **Start it with `KSPLC_STD_DIR` set.** The language server rejects `--std-dir=` (the
//< analysis worker is a separate process), so only the environment tells it where std is.
import "ksplc/tests/support/jsonrpc_client"
import "std/chars"
import "std/ds" { List }
import "std/json" + { Json_builder }
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/strfmt"
import "std/subproc"

pub const READ_MS: I32 = 15000 //< how long the answer to a request that walks no files may take

pub const WALK_MS: I32 = 120000 //< how long a request that walks the workspace may take
    //< References and a rename read every file of the workspace, so a loaded machine (a Windows
    //< `make ci` at `-j12`) takes many times `READ_MS` over them.

pub const SEND_MS: I32 = 15000 //< how long the server may go without reading what is sent to it
    //< A send that fails is not checked where it is made: the request after it then fails, and its
    //< check names the server's standard error.

pub fn start(exe: U8[], extra: U8[][], cwd: U8[], arena: Arena$@):
    jsonrpc_client.Client!subproc.Spawn_error //<
        //< It starts `ksplc lsp`, with `extra` after the subcommand (empty for none)
        //< **`cwd` is the workspace**: imports, the walk and the paths returned are relative to it.
        //< Empty inherits the caller's working directory.
    $argv: = List<|U8[]|>.new(arena)
    argv.push(exe)
    argv.push("lsp")
    for a in extra
        argv.push(a)
    return jsonrpc_client.spawn(argv.slice(), cwd)

// ==========================================
// The two spellings a client names a document by
// Caution: **Both are in use, so test both.** An editor sends the absolute `file://` URI, other
// clients the workspace-relative path; tested in only one, half the clients see nothing.
// ==========================================
pub fn uri_of(top: U8[], rel: U8[], arena: Arena$@): U8[] //<
    //< The absolute `file://` URI of `rel`, under the workspace `top`
    //< Caution: **Spell the separators `/`**, as the server does (`to_absolute` in
    //< `../../base/locate.kspl`); a Windows working directory's `\` would never equal the answer.
    return arena.text().s("file://").s(slashed(top, arena)).c('/').s(rel).take()

pub fn encoded_uri_of(top: U8[], rel: U8[], arena: Arena$@): U8[] //<
    //< The `file://` URI of `rel` under `top` as an editor writes it: `/` before a drive, a space
    //< and a Japanese letter as `%XX`
    //< **The server answers in the form it was asked** (`spell_uri_path` in
    //< `../../base/locate.kspl`), so this escapes what it escapes, and no more.
    path: = arena.text().s(slashed(top, arena)).c('/').s(rel).take()
    out: = arena.text().s("file://")
    if !path.starts_with("/")
        out.c('/')
    for c in path
        if c <= ' ' || c >= 0x7F || c == '%' || c == '#' || c == '?'
            out.c('%').c((c >> 4).to_hex_upper()).c((c & 15U8).to_hex_upper())
        else
            out.c(c)
    return out.take()

pub fn rel_of(top: U8[], uri: U8[], arena: Arena$@): U8[] //<
    //< The workspace-relative path a returned URI names, whichever spelling it came back in
    local: = uri.strip_prefix("file://")
    root: = slashed(top, arena)
    if !local.starts_with(root) || local.len <= root.len + 1
        return arena.dup_str(local)
    return arena.dup_str(local.sub_from(root.len + 1))

priv fn slashed(path: U8[], arena: Arena$@): U8[] //< `path` with each `\` spelt `/`
    return path.replace("\\", "/", arena)

pub fn did_open(uri: U8[], text: U8[], arena: Arena$@): json.Value //<
    //< The params of `textDocument/didOpen`
    //< The `languageId` is the one an editor sends for a `.kspl` (`kspl`, the extension's
    //< language).
    $b: = Json_builder.new(arena)
    lang: = "kspl"
    doc: = b.obj().set("uri", b.str_val(uri)).set("languageId", b.str_val(lang))
        .set("version", b.int_val(1I64)).set("text", b.str_val(text)).build()
    return b.obj().set("textDocument", doc).build()

pub fn close(c: jsonrpc_client.Client$@, uri: U8[], arena: Arena$@) //<
    //< It sends didClose for `uri`
    //< **A check closes what it opened where the server is later made to recover** (the `lsp`
    //< suite's crash and hang hooks), by `defer` right after its didOpen. The worker the
    //< supervisor remakes analyses every open document again while the editor is idle. So a
    //< document left behind is work the recovery's request can find under way.
    c.notify("textDocument/didClose", at_doc(uri, arena), SEND_MS, arena) catch {}

fn at_doc(uri: U8[], arena: Arena$@): json.Value //<
    //< The params pointing at only the document (`textDocument`)
    //< For a query that needs no position (`semanticTokens/full` and the like).
    $b: = Json_builder.new(arena)
    return b.obj()
        .set("textDocument", b.obj().set("uri", b.str_val(uri)).build()).build()

pub fn at_pos(uri: U8[], line: Sz, character: Sz, arena: Arena$@): json.Value //<
    //< The params pointing at a position (`textDocument` + `position`)
    $b: = Json_builder.new(arena)
    doc: = b.obj().set("uri", b.str_val(uri)).build()
    pos: = b.obj().set("line", b.int_val(line)).set("character", b.int_val(character)).build()
    return b.obj().set("textDocument", doc).set("position", pos).build()

pub fn empty_obj(arena: Arena$@): json.Value //< `{}`, the params of a request that takes none
    $b: = Json_builder.new(arena)
    return b.obj().build()

pub fn answer( //< the reply to a request; `null` when none comes, so the check reading it fails
    c: jsonrpc_client.Client$@,
    method: U8[], //< the LSP method asked
    params: json.Value, //< what it is asked with
    timeout_ms: I32, //< how long the round trip may take
    arena: Arena$@, //< where the reply goes
): json.Value
    got: = c.request(method, params, timeout_ms, arena) catch
        return .null_val
    return got.val

pub fn hover_text(msg: json.Value): U8[] //< `result.contents.value` (the hover's body)
    //< Empty where there is none.
    return msg.get("result").get("contents").get("value").as_str().unwrap_or("")

// ==========================================
// Explaining why a request failed
// Caution: **Include the supervisor's log.** `result: null` is both "nothing at that position" and
// "the worker crashed and the supervisor answered null"; the response cannot tell.
// ==========================================
pub fn why(c: jsonrpc_client.Client$@, msg: U8[], arena: Arena$@): U8[] //<
    //< `msg` with the supervisor's log
    return arena.text().s(msg).s(" | supervisor: ").s(c.err_tail()).take()

pub fn dump(v: json.Value, arena: Arena$@): U8[] //< `v` as JSON text, cut to 300 bytes
    $b: = Str_builder.new()
    v.dump(b@)
    text: = b.slice()
    keep: = 300
    return arena.dup_str(text if text.len <= keep else text.sub(0, keep))

pub fn join(items: List<|U8[]|>@, arena: Arena$@): U8[] //< the items as `[a, b, c]`
    b: = arena.text().s("[")
    for i in Range.asc(items.len)
        if i > 0
            b.s(", ")
        b.s(items.get(i))
    return b.s("]").take()

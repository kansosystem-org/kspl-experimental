//< The `lsp` suite's check that a workspace request reads each file as it stands now
//< Not a suite; `../suite/lsp_test.kspl` calls `run_fresh`. A rename and the references read every
//< file of the workspace ("The workspace walk reads through the AST cache" in
//< `../../docs/DESIGN-tools.md`). **A file open in the editor is read from its buffer, and every
//< other file from the disk, on each request.** An answer built from an older copy puts its
//< positions on the wrong lines.
//< Each answer is checked against the bytes the editor applies it to. So a server that answers
//< from an older copy cannot pass, and one that answers nothing cannot either.
import "ksplc/tests/support/harness"
import "ksplc/tests/support/jsonrpc_client"
import "ksplc/tests/support/lsp_client"
import "ksplc/tests/support/lsp_read" { col_in_line, decl_line }
import "ksplc/tests/support/lsp_rename" { edits_in, places }
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/json" + { Json_builder }
import "std/jsonrpc"
import "std/mem" { Arena }
import "std/str"
import "std/sys"
import "std/verdict"

priv const WORD: U8[] = "helper" //< the function renamed; no other text in the files holds it
priv const NEW_NAME: U8[] = "aid"
priv const LIB_REL: U8[] = "lib.kspl"
priv const USER_REL: U8[] = "user.kspl" //< uses `lib.helper`; `lib` does not import it

priv const LIB_OLD: U8[] = "fn helper(): I32\n    return 2\n"
priv const LIB_NEW: U8[] = //< `LIB_OLD` with a function above the declaration
    "fn first(): I32\n    return 1\n\nfn helper(): I32\n    return 2\n"

priv const USER_OLD: U8[] =
    """import "lib"

fn twice(): I32
    return lib.helper() + lib.helper()
"""

priv const USER_NEW: U8[] = //< saved over `USER_OLD`: lines above the uses, and other columns
    """import "lib"

fn one(): I32
    return 1

fn two(): I32
    return 2

fn twice(): I32
    total: = lib.helper()
    return total + lib.helper()
"""

priv const USER_TYPED: U8[] = //< the unsaved buffer; it differs from both saved texts
    """import "lib"

fn three(): I32
    return 3

fn twice(): I32
    return 1 + lib.helper() + lib.helper()
"""

priv struct Ask //< one client on the workspace `dir`
    c: jsonrpc_client.Client$@
    dir: U8[]
    arena: Arena$@

impl Ask
    priv fn at(r: Self, rel: U8[], src: U8[], line_head: U8[]): json.Value //<
        //< the position of `WORD` on the line of `rel` that starts with `line_head`, in `src`
        line: = decl_line(src, line_head, r.arena)
        return lsp_client.at_pos(rel, line, col_in_line(src, line_head, WORD, r.arena) + 1,
            r.arena)

    priv fn rename(r: Self, rel: U8[], src: U8[], line_head: U8[]): json.Value //<
        //< the whole answer to renaming `WORD` to `NEW_NAME` from that position
        $b: = Json_builder(r.arena)
        pos: = r.at(rel, src, line_head)
        params: = b.obj().set("textDocument", pos.get("textDocument"))
            .set("position", pos.get("position")).set("newName", b.str_val(NEW_NAME)).build()
        return lsp_client.answer(r.c, "textDocument/rename", params, lsp_client.WALK_MS, r.arena)

    priv fn save(r: Self, rel: U8[], text: U8[]) //< it writes a file and tells the server nothing
        fs.write_tree(r.dir, U8[][]::{ rel }, U8[][]::{ text }, r.arena) catch
            verdict.check("the fresh-bytes workspace can be written again", false, rel)

    priv fn open(r: Self, rel: U8[], text: U8[])
        lsp_client.open(r.c, rel, text, r.arena)

    priv fn renames_on(r: Self, label: U8[], got: json.Value, lib: U8[], user: U8[]) //<
        //< Checks that a rename's edits land on `WORD` in both texts given, and on nothing else
        lib_edits: = edits_in(got, LIB_REL, r.arena)
        user_edits: = edits_in(got, USER_REL, r.arena)
        why: = r.arena.text().s(LIB_REL).s(": ").s(places(lib_edits@, r.arena)).s(USER_REL).s(": ")
            .s(places(user_edits@, r.arena)).take()
        verdict.check(label,
            all_on(lib_edits@, lib, r.arena) && all_on(user_edits@, user, r.arena),
            lsp_client.why(r.c, why, r.arena))

fn run_fresh(exe: U8[], arena: Arena$@) //<
    //< Starts a server on a workspace of its own and changes the files under it between requests
    dir: = harness.sandbox("lsp_fresh")
    fs.write_tree(dir, U8[][]::{ LIB_REL, USER_REL }, U8[][]::{ LIB_OLD, USER_OLD }, arena) catch
        verdict.check("the fresh-bytes workspace can be laid out", false, dir)
        return
    defer $c: =
        lsp_client.start_ready(exe, U8[][]::{ .ptr = null, .len = 0 }, dir, arena) catch
            verdict.check("the fresh-bytes workspace's server starts", false, dir)
            return
    ask: = Ask::{ .c = c@, .dir = dir, .arena = arena }
    check_saved(ask)
    check_typed(ask)
    check_dependent(exe, arena)
    check_burst(exe, arena)

priv fn check_saved(ask: Ask) //<
    //< A file the editor does not have open is read from the disk on each request
    //< The first request reads `USER_OLD`. Then the file is saved with no notification, as another
    //< program or the editor itself can do.
    ask.open(LIB_REL, LIB_OLD)
    ask.renames_on("a rename reaches the uses in a file nobody opened",
        ask.rename(LIB_REL, LIB_OLD, "fn helper"), LIB_OLD, USER_OLD)
    ask.save(USER_REL, USER_NEW)
    ask.renames_on("a rename after a save with no notification lands on the saved bytes",
        ask.rename(LIB_REL, LIB_OLD, "fn helper"), LIB_OLD, USER_NEW)
    // The references come from the same list of uses as the rename. Both are checked, so a change
    // that reaches only one shows.
    refs: = lsp_client.answer(ask.c, "textDocument/references",
        ask.at(LIB_REL, LIB_OLD, "fn helper"), lsp_client.WALK_MS, ask.arena)
    found: = refs.get("result").arr_list(ask.arena)
    $in_user: = List<|json.Value|>(ask.arena)
    for i in Range.asc(found.len)
        if found.get(i).get("uri").as_str().unwrap_or("").equals(USER_REL)
            in_user.push(found.get(i))
    verdict.check("the references after a save with no notification are on the saved bytes",
        all_on(in_user@, USER_NEW, ask.arena),
        lsp_client.why(ask.c, places(found@, ask.arena), ask.arena))

priv fn check_typed(ask: Ask) //<
    //< A file the editor has open is read from its buffer, whatever the disk holds
    //< The editor applies the edits to the buffer, so positions read from the disk land on the
    //< wrong lines there. The request is made from each file in turn: one that only the walk
    //< reaches, and the one the cursor is in.
    ask.open(USER_REL, USER_TYPED)
    ask.renames_on("a rename reaches an open file's unsaved typing, not its saved bytes",
        ask.rename(LIB_REL, LIB_OLD, "fn helper"), LIB_OLD, USER_TYPED)
    // **The other way round**: `lib` is closed and saved with no notification.
    lsp_client.close(ask.c, LIB_REL, ask.arena)
    ask.save(LIB_REL, LIB_NEW)
    ask.renames_on("a rename made in unsaved typing lands on it, and on the saved bytes elsewhere",
        ask.rename(USER_REL, USER_TYPED, "    return 1 + lib"), LIB_NEW, USER_TYPED)

priv fn all_on(edits: List<|json.Value|>@, text: U8[], arena: Arena$@): Bool //<
    //< Whether each range covers exactly `WORD` in `text`, and there is one per `WORD`
    //< **None at all fails**: a server that answers nothing must not pass.
    if edits.len == 0 || edits.len != text.count_str(WORD)
        return false
    lines: = text.lines(arena)
    for i in Range.asc(edits.len)
        range: = edits.get(i).get("range")
        line: = range.get("start").get("line").as_int().unwrap_or(-1)
        from: = range.get("start").get("character").as_int().unwrap_or(-1)
        to: = range.get("end").get("character").as_int().unwrap_or(-1)
        if line < 0 || from < 0 || to < from || Sz::line >= lines.len ||
            range.get("end").get("line").as_int().unwrap_or(-1) != line
            return false
        if !lines.get(line).sub(from, to - from).equals(WORD)
            return false
    return true

priv const LIB_GONE: U8[] = "fn other(): I32\n    return 2\n" //< `LIB_OLD` without `helper`
priv fn marks_of(c: jsonrpc_client.Client$@, rel: U8[], arena: Arena$@): I32 //<
    //< How many diagnostics the next publish for `rel` holds; -1 where none came
    for _k in Range.asc(12)
        msg: = c.read_msg(lsp_client.READ_MS, arena) catch
            break
        if !msg.val.get("method").as_str().unwrap_or("").equals("textDocument/publishDiagnostics")
            continue
        got: = msg.val.get("params")
        if got.get("uri").as_str().unwrap_or("").ends_with(rel)
            return I32::got.get("diagnostics").arr_list(arena).len
    return -1

priv fn check_dependent(exe: U8[], arena: Arena$@) //<
    //< An edit to one open file refreshes the marks on another open file that imports it
    //< **The edited file is not the only one whose marks change**: `user` calls `lib.helper`, and
    //< the edit takes `helper` away. Marks left from before tell the reader `user` is sound.
    name: = "an edit to one open file refreshes the marks on an open file that imports it"
    dir: = harness.sandbox("lsp_dependent")
    fs.write_tree(dir, U8[][]::{ LIB_REL, USER_REL }, U8[][]::{ LIB_OLD, USER_OLD }, arena) catch
        verdict.check(name, false, dir)
        return
    defer $c: =
        lsp_client.start_ready(exe, U8[][]::{ .ptr = null, .len = 0 }, dir, arena) catch
            verdict.check(name, false, "the language server cannot be started")
            return
    lsp_client.open(c@, LIB_REL, LIB_OLD, arena)
    _lib: = marks_of(c@, LIB_REL, arena)
    lsp_client.open(c@, USER_REL, USER_OLD, arena)
    before: = marks_of(c@, USER_REL, arena)
    $b: = Json_builder(arena)
    params: = b.obj()
        .set("textDocument", b.obj().set("uri", b.str_val(LIB_REL)).build())
        .set("contentChanges",
        b.arr().push(b.obj().set("text", b.str_val(LIB_GONE)).build()).build()).build()
    c.notify("textDocument/didChange", params, lsp_client.SEND_MS, arena) catch {}
    after: = marks_of(c@, USER_REL, arena)
    counts: = arena.text().s("\{before\} marks before, \{after\} after").take()
    verdict.check(name, before == 0 && after > 0, lsp_client.why(c@, counts, arena))
    // Caution: **End the session and read what the server says last.** Each re-check of another
    // open file once left that file's framed copy unfreed, and the exit's heap check then said
    // "memory leak" and ended with 1.
    _down: = lsp_client.answer(c@, "shutdown", lsp_client.empty_obj(arena), lsp_client.READ_MS,
        arena)
    c.notify("exit", lsp_client.empty_obj(arena), lsp_client.SEND_MS, arena) catch {}
    $waits: I32 = 0
    for c.alive() && waits < 200
        sys.sleep_ms(50)
        waits += 1
    tail: = arena.text().s(c.err_tail()).take()
    verdict.check("a session that re-checked another open file ends with nothing left allocated",
        !c.alive() && tail.find_str("memory leak").is_none(), tail)

// ==========================================
// A burst of changes is analysed once, as its last text
// **The server analyses only the newest of the changes already waiting**, so fewer analyses
// publish than changes were sent. Each one analysed in turn kept the next answer waiting.
// Caution: **Count the published diagnostics, not the time taken.** A count holds on a loaded
// machine; a time bound fails there by mistake.
// ==========================================

priv const BURST_REL: U8[] = "burst.kspl"
priv const BURST_CHANGES: Sz = 8 //< the changes sent in one write, before the hover
priv const BURST_LAST: U8[] = "fn last_one(): I32\n    return 1\n" //< the last text; no error
priv const BURST_ID: I32 = 9100 //< the hover's id, above any the client gives itself here

priv fn burst_text(k: Sz, arena: Arena$@): U8[] //<
    //< The text the burst's change `k` sends; each but the last holds one error
    if k + 1 == BURST_CHANGES
        return BURST_LAST
    return arena.text().s("fn step(): I32\n    return missing_\{k\}\n").take()

priv fn change_body(k: Sz, arena: Arena$@): U8[] //< the didChange that sends `burst_text(k)`
    $b: = Json_builder(arena)
    params: = b.obj()
        .set("textDocument",
        b.obj().set("uri", b.str_val(BURST_REL)).set("version", b.int_val(I64::k + 2I64)).build())
        .set("contentChanges",
        b.arr()
        .push(b.obj().set("text", b.str_val(burst_text(k, arena))).build()).build()).build()
    return jsonrpc.encode("textDocument/didChange", params, -1, arena)

priv fn check_burst(exe: U8[], arena: Arena$@) //<
    //< Quick changes, then a hover: fewer analyses than changes, and the marks match the last text
    name: = "a burst of changes is analysed fewer times than it holds changes"
    dir: = harness.sandbox("lsp_burst")
    defer $c: =
        lsp_client.start_ready(exe, U8[][]::{ .ptr = null, .len = 0 }, dir, arena) catch
            verdict.check(name, false, "the language server cannot be started")
            return
    lsp_client.open(c@, BURST_REL, burst_text(0, arena), arena)
    opened: = marks_of(c@, BURST_REL, arena)
    $bodies: = List<|U8[]|>(arena)
    for k in Range.asc(BURST_CHANGES)
        bodies.push(change_body(k, arena))
    on_name: = lsp_client.at_pos(BURST_REL, 0, 4, arena)
    bodies.push(jsonrpc.encode("textDocument/hover", on_name, BURST_ID, arena))
    // One write, so every change is waiting before the first one's analysis ends.
    c.send_messages(bodies.slice(), lsp_client.SEND_MS) catch {}
    $published: Sz = 0
    $last_marks: I32 = -1
    $shown: U8[] = ""
    for
        msg: = c.read_msg(lsp_client.READ_MS, arena) catch
            break
        if msg.val.get("id").as_int().unwrap_or(-1) == BURST_ID
            shown = lsp_client.hover_text(msg.val)
            break
        got: = msg.val.get("params")
        if msg.val.get("method").as_str().unwrap_or("").equals("textDocument/publishDiagnostics") &&
            got.get("uri").as_str().unwrap_or("").ends_with(BURST_REL)
            published += 1
            last_marks = I32::got.get("diagnostics").arr_list(arena).len
    counts: = arena.text()
        .s("\{opened\} marks on open; \{published\} analyses for \{BURST_CHANGES\} changes; \
            \{last_marks\} marks last; hover '\{shown\}'").take()
    verdict.check(name, opened == 1 && published >= 1 && published < BURST_CHANGES,
        lsp_client.why(c@, counts, arena))
    verdict.check("after a burst of changes, the marks and the hover match the last text",
        last_marks == 0 && shown.find_str("last_one").is_some(),
        lsp_client.why(c@, counts, arena))

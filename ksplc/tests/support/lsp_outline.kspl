//< The outline (`textDocument/documentSymbol`): what a file declares, nested as written
//< Not a suite. It is part of `../suite/lsp_test.kspl`. It asks for the outline of a source that
//< parses and of one that does not.
//< **It is not a suite of its own**, since one would start the language server a second time
//< ("Files near the limit and how they split" in `../../README.md`).
import "ksplc/tests/support/jsonrpc_client"
import "ksplc/tests/support/lsp_client"
import "ksplc/tests/support/lsp_read" { decl_line, end_text, is_missing }
import "std/ds" { List }
import "std/json" + { Json_builder }
import "std/mem" { Arena }
import "std/str" // `equals`
import "std/verdict"

// **A local inside a body and a constant's own value are no part of the outline**; `inner` and
// `helper` are there to be left out.
priv const OUTLINE_SRC: U8[] =
    """priv const LIMIT: Sz = 4

struct Pair
  left: I32
  right: I32


enum Side
  near
  far


trait Shape
  fn area(r: Self): I32


impl Pair
  fn sum(r: Self@): I32
    inner: = 1
    return r.left + r.right + inner



fn main(): I32
  helper: = 2
  return helper

"""
priv const OUTLINE_URI: U8[] = "file:///o.kspl"

// The source cut off inside `main`: the declarations before the error still come back.
priv const BROKEN_SRC: U8[] = "struct Kept\n  a: I32\n\n\nfn main(): I32\n  var x = 1\n\n"
priv const BROKEN_URI: U8[] = "file:///ob.kspl"

priv struct Seen //< one symbol as the check reads it
    name: U8[]
    kind: I32
    depth: Sz
    inside: Bool //< whether the selection lies inside the range

priv fn line_char(v: json.Value): I64 //< a position as one number, the line before the character
    return v.get("line").as_int64().unwrap_or(-1I64) * 100000I64 + v.get("character").as_int64()
        .unwrap_or(-1I64)

priv fn collect(list: json.Value, depth: Sz, out: List<|Seen|>$@, arena: Arena$@)
    for one in list.arr_list(arena)
        range: = one.get("range")
        sel: = one.get("selectionRange")
        inside: =
            line_char(range.get("start")) <= line_char(sel.get("start")) &&
            line_char(sel.get("end")) <= line_char(range.get("end"))
        out
            .push(Seen::{ .name = one.get("name").as_str().unwrap_or(""),
            .kind = one.get("kind").as_int().unwrap_or(-1I32), .depth = depth, .inside = inside })
        collect(one.get("children"), depth + 1, out, arena)

priv fn found(seen: List<|Seen|>$@, name: U8[], kind: I32, depth: Sz): Bool //<
    //< Whether `seen` holds that name with that kind at that depth
    for s in seen.slice()
        if s.name.equals(name) && s.kind == kind && s.depth == depth
            return true
    return false

priv fn ask(c: jsonrpc_client.Client$@, uri: U8[], src: U8[], arena: Arena$@): json.Value //<
    //< Opens `src` and returns the answer to `documentSymbol` (null where none came)
    c.notify("textDocument/didOpen", lsp_client.did_open(uri, src, arena), lsp_client.SEND_MS, arena)
        catch {}
    got: = lsp_client.answer(c, "textDocument/documentSymbol", lsp_client.at_doc(uri, arena),
        lsp_client.READ_MS, arena)
    lsp_client.close(c, uri, arena)
    return got

fn run_outline(c: jsonrpc_client.Client$@, caps: json.Value, arena: Arena$@) //<
    //< Checks the outline of a source that parses and of one that does not
    verdict.check("it names documentSymbol among its capabilities",
        caps.get("documentSymbolProvider").as_bool().unwrap_or(false),
        lsp_client.dump(caps, arena))

    got: = ask(c, OUTLINE_URI, OUTLINE_SRC, arena)
    d: = lsp_client.dump(got, arena)
    $seen: = List<|Seen|>(arena)
    collect(got.get("result"), 0, seen@, arena)
    // The protocol's numbers: Constant 14, Struct 23, Field 8, Enum 10, EnumMember 22,
    // Interface 11, Method 6, Function 12.
    verdict.check("the top-level declarations come out at the top",
        found(seen@, "LIMIT", 14I32, 0) && found(seen@, "Pair", 23I32, 0) &&
        found(seen@, "Side", 10I32, 0) && found(seen@, "Shape", 11I32, 0) &&
        found(seen@, "main", 12I32, 0), d)
    verdict.check("a type's fields and variants nest under it",
        found(seen@, "left", 8I32, 1) && found(seen@, "right", 8I32, 1) &&
        found(seen@, "near", 22I32, 1) && found(seen@, "far", 22I32, 1), d)
    verdict.check("an impl's and a trait's functions nest under them as methods",
        found(seen@, "sum", 6I32, 1) && found(seen@, "area", 6I32, 1), d)
    $stray: = false
    $outside: = false
    for s in seen.slice()
        if s.name.equals("inner") || s.name.equals("helper")
            stray = true
        if !s.inside
            outside = true
    verdict.check("nothing inside a body comes out", !stray, d)
    verdict.check("each name's place lies inside its declaration's range", !outside, d)

    // **A document that fails to parse gets what parsed around the error.**
    bad: = ask(c, BROKEN_URI, BROKEN_SRC, arena)
    $bad_seen: = List<|Seen|>(arena)
    collect(bad.get("result"), 0, bad_seen@, arena)
    verdict.check("a source that does not parse still lists what parsed",
        !is_missing(bad.get("result")) && found(bad_seen@, "Kept", 23I32, 0),
        lsp_client.dump(bad, arena))

// ==========================================
// The call hierarchy from the language server: a starting point, then its callers
// Not a suite. ksplc's `lsp` suite uses it on a file in its own folder, and the root's `lsp-tree`
// on the repository's whole tree. So what `lsp-tree` calls is `pub`.
// ==========================================
const HEAVY_MS: I32 = 60000 //< the default (15 seconds) is not enough
    //< A didOpen analyses the document's whole import tree, as many files as a workspace query. At
    //< the default a slow disk misses, and "no answer" cannot be told from "the timeout expired".

pub struct Prepared //<
    //< What prepareCallHierarchy gave: the first item and the raw response
    pub found: Bool
    pub item: json.Value
    pub raw: U8[]

pub fn prepare_fn(c: jsonrpc_client.Client$@, rel: U8[], text: U8[], decl: U8[], arena: Arena$@):
    Prepared //<
        //< It opens `text` as the document `rel` and sends prepareCallHierarchy at `decl`'s name
        //< Caution: **Return the raw response too**: with no item, only it tells "the worker has no
        //< answer" from "the timeout expired".
    c.notify("textDocument/didOpen", lsp_client.did_open(rel, text, arena), lsp_client.SEND_MS,
        arena) catch {}
    line: = decl_line(text, decl, arena)
    pos: = lsp_client.at_pos(rel, line, decl.len - 1, arena)
    msg: = c.request("textDocument/prepareCallHierarchy", pos, HEAVY_MS, arena) catch e
        return Prepared::{ .found = false, .item = .null_val, .raw = end_text(e) }
    items: = msg.val.get("result")
    list: = items.arr_list(arena)
    if list.len == 0
        return Prepared::{ .found = false, .item = .null_val,
            .raw = lsp_client.dump(msg.val, arena) }
    return Prepared::{ .found = true, .item = list.get(0),
        .raw = lsp_client.dump(msg.val, arena) }

pub struct Incoming //< the result of incomingCalls: the array of callers
    //< Caution: **Do not discard why it came back empty.** "It does not have it", "the timeout
    //< expired" and "the supervisor killed the worker" are each fixed in a different place.
    pub calls: List<|json.Value|> //< the incoming calls, empty where none came
    pub timed_out: Bool //< whether the timeout expired before an answer

pub fn incoming(c: jsonrpc_client.Client$@, item: json.Value, arena: Arena$@): Incoming //<
    //< who calls `item`
    //< **It walks the workspace**, as references does, so it waits as long (`walk_ms`).
    $b: = Json_builder(arena)
    params: = b.obj().set("item", item).build()
    msg: =
        c.request("callHierarchy/incomingCalls", params, lsp_client.WALK_MS, arena) catch
        return Incoming::{ .calls = List<|json.Value|>(arena), .timed_out = true }
    return Incoming::{ .calls = msg.val.get("result").arr_list(arena), .timed_out = false }

//< The `lsp` suite's checks on renaming: what it refuses, and the import lines it reaches
//< Not a suite; `../suite/lsp_test.kspl` calls `run_rename`. **The workspace is a folder of its
//< own**, with std read from outside it, as a project sees an installed standard library.
//< Each refusal is shown beside a rename that goes through, so a server answering every request
//< with an error cannot pass.
import "ksplc/tests/support/harness"
import "ksplc/tests/support/jsonrpc_client"
import "ksplc/tests/support/lsp_client"
import "ksplc/tests/support/lsp_read" { col_in_line, decl_line, is_missing }
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/json" + { Json_builder }
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

priv const LIB_SRC: U8[] = "fn hit(): I32\n    return 0\n\nfn helper(): I32\n    return 2\n"
priv const USER_URI: U8[] = "user.kspl"
priv const PICK_URI: U8[] = "pick.kspl" //< brings `helper` in by name
priv const PICK_SRC: U8[] =
    """import "lib" { helper }

fn twice(): I32
    return helper() + helper()
"""
priv const USER_SRC: U8[] =
    """import "std/io"
import "std/str" { Str }
import "lib"

fn other(): I32
    return 1

fn built(): Sz
    defer $sb: = Str()
    sb.s("x")
    return sb.len

fn use(seed: I32): I32
    total: = seed + lib.hit()
    io.out().s("x")
    return total + other()

struct Pair
    a: I32

impl Pair
    fn first(p: Self@): I32
        return p.a

impl Pair
    fn second(p: Self@): I32
        return p.a
"""

priv const TYPE_URI: U8[] = "type_call.kspl"
priv const TYPE_SRC: U8[] =
    """struct Cup
    n: I32

impl Cup
    fn new(n: I32 = 7): Self
        return Self::{ .n = n }

    fn again(): Self
        return Self(2)

fn use(): I32
    c: = Cup(3)
    return c.n
"""

priv const CLOSURE_URI: U8[] = "closure.kspl"
priv const CLOSURE_SRC: U8[] =
    """fn apply(f: Callable1<|I32, I32|>, v: I32): I32
    return f.call(v)

fn closes(): I32
    limit: = 3
    add: = fn(x: I32; limit: I32): I32 { return x + limit; }
    return apply(add, limit)
"""

// An enum used through a selective import and through an alias, a type with a type call and an
// operator, and a trait. Each name is used in a file that never spells the declaration's word at
// the cursor where the rename starts (`Self`), or never spells the method (`new`, `add`).
priv const SHADE_URI: U8[] = "shade.kspl"
priv const SHADE_SRC: U8[] =
    """pub enum Shade
    dark
    pale

pub fn pick_shade(s: Shade): I32
    if s == .pale
        return 1
    return 0

fn first_shade(): Shade
    return Shade.dark
"""
priv const PAINT_URI: U8[] = "paint.kspl"
priv const PAINT_SRC: U8[] =
    """import "shade" { Shade, pick_shade }

fn paint(): I32
    a: = Shade.dark
    return pick_shade(a)
"""
priv const TINT_SRC: U8[] =
    """import "shade" as sh

fn tint(): I32
    return sh.pick_shade(sh.Shade.dark)
"""
priv const VEC_URI: U8[] = "vec.kspl"
priv const VEC_SRC: U8[] =
    """pub struct Vec2
    x: I32

impl Vec2: Add<|Vec2, Vec2|>
    pub fn add(r: Self, rhs: Vec2): Vec2
        return Vec2::{ .x = r.x + rhs.x }

impl Vec2
    pub fn new(x: I32): Self
        return Self::{ .x = x }

    pub fn len_of(r: Self@): I32
        return r.x

pub trait Sized2
    fn size2(r: Self): I32
"""
priv const SHAPE_URI: U8[] = "shape.kspl" //< a trait's block holding two of its methods
priv const SHAPE_SRC: U8[] =
    """pub trait Measured
    fn area(r: Self): I32
    fn side(r: Self): I32

pub struct Tile
    w: I32

impl Tile: Measured
    pub fn area(r: Self): I32
        return r.w * r.w

    pub fn side(r: Self): I32
        return r.w

fn tile_total(): I32
    t: = Tile::{ .w = 2 }
    return t.area() + t.side()
"""
priv const STRAY_URI: U8[] = "stray.kspl" //<
    //< Opened and never written: its trait's block holds a method the trait does not declare
priv const STRAY_SRC: U8[] =
    """pub struct Cup2
    n: I32

impl Cup2: Add<|Cup2, Cup2|>
    pub fn add(r: Self, rhs: Cup2): Cup2
        return Cup2::{ .n = r.n + rhs.n }

    pub fn make(n: I32): Self
        return Self::{ .n = n }
"""
priv const SUM_SRC: U8[] =
    """import "vec" as vc

fn sum_up(): I32
    a: = vc.Vec2(1)
    b: = a + a
    return b.len_of()
"""

priv const SLOT_URI: U8[] = "slot.kspl" //< a generic type, used in its own file and in another
priv const SLOT_SRC: U8[] =
    """pub struct Slot<|T|>
    held: T

impl<|T|> Slot<|T|>
    pub fn get(r: Self@): T
        return r.held

fn held_one(): I32
    s: = Slot<|I32|>::{ .held = 1 }
    return s.get()

fn first_of<|Elem|>(items: Elem[]): Elem
    head: = items[0]
    return head
"""
priv const SLOT_USE_URI: U8[] = "slot_use.kspl"
priv const SLOT_USE_SRC: U8[] =
    """import "slot" { Slot }

fn held_two(): I32
    s: = Slot<|I32|>::{ .held = 2 }
    return s.get()
"""
priv const CALL_URI: U8[] = "call.kspl" //<
    //< a closure called through the `call` the compiler declares
priv const CALL_SRC: U8[] =
    """fn calls(): I32
    limit: = 3
    add: = fn(x: I32; limit: I32): I32 { return x + limit; }
    return add.call(4)
"""

priv const LIFT_URI: U8[] = "lift.kspl" //< a function that writes a closure and an anonymous one
priv const LIFT_SRC: U8[] =
    """fn run_on(f: Callable1<|I32, I32|>, v: I32): I32
    return f.call(v)

fn bump_with(f: fn(n: I32): I32, v: I32): I32
    return f(v)

fn makes_closures(): I32
    step: = 3
    add: = fn(x: I32; step: I32): I32 { return x + step; }
    return run_on(add, step) + bump_with(fn(n: I32): I32 { return n + 1; }, 2)
"""

priv struct Ask //< one client, and where the probe's names stand in its document
    c: jsonrpc_client.Client$@
    arena: Arena$@

impl Ask
    priv fn at(r: Self, line_head: U8[], word: U8[]): json.Value //<
        //< the position of `word` on a line of the user's document
        return r.at_in(USER_URI, USER_SRC, line_head, word)

    priv fn at_in(r: Self, uri: U8[], src: U8[], line_head: U8[], word: U8[]): json.Value //<
        //< the position of `word` on a line of the document `uri`, whose text is `src`
        line: = decl_line(src, line_head, r.arena)
        return lsp_client.at_pos(uri, line, col_in_line(src, line_head, word, r.arena) + 1,
            r.arena)

    priv fn rename(r: Self, line_head: U8[], word: U8[], new_name: U8[]): json.Value //<
        //< The whole response to renaming `word` to `new_name` in the user's document
        return r.rename_in(USER_URI, USER_SRC, line_head, word, new_name)

    priv fn rename_in(r: Self, uri: U8[], src: U8[], line_head: U8[], word: U8[], new_name: U8[]):
        json.Value //<
            //< The whole response to renaming `word` to `new_name` in the document `uri`
        $b: = Json_builder(r.arena)
        pos: = r.at_in(uri, src, line_head, word)
        params: = b.obj().set("textDocument", pos.get("textDocument"))
            .set("position", pos.get("position")).set("newName", b.str_val(new_name)).build()
        return lsp_client.answer(r.c, "textDocument/rename", params, lsp_client.WALK_MS, r.arena)

    priv fn call_item(r: Self, uri: U8[], src: U8[], line_head: U8[], word: U8[]): json.Value //<
        //< The call hierarchy's item for `word`, or null where none is prepared
        got: = lsp_client.answer(r.c, "textDocument/prepareCallHierarchy",
            r.at_in(uri, src, line_head, word), lsp_client.READ_MS, r.arena)
        items: = got.get("result").arr_list(r.arena)
        return items.get(0) if items.len == 1 else .null_val

    priv fn call_names(r: Self, item: json.Value, method: U8[], side: U8[]): U8[] //<
        //< The names at the other end of item's calls, each followed by a comma
        //< The error's message instead, where the server answers one.
        $b: = Json_builder(r.arena)
        got: = lsp_client.answer(r.c,
            r.arena.text().s("callHierarchy/").s(method).take(),
            b.obj().set("item", item).build(), lsp_client.WALK_MS, r.arena)
        if !is_missing(got.get("error"))
            return lsp_client.dump(got, r.arena)
        names: = r.arena.text()
        for call in got.get("result").arr_list(r.arena)
            names.s(call.get(side).get("name").as_str().unwrap_or("?")).c(',')
        return names.take()

    priv fn call_range(r: Self, item: json.Value, method: U8[], name: U8[]): json.Value //<
        //< The first range in `fromRanges` of the call whose other end is `name`, or null
        side: = "from" if method.equals("incomingCalls") else "to"
        $b: = Json_builder(r.arena)
        got: = lsp_client.answer(r.c,
            r.arena.text().s("callHierarchy/").s(method).take(),
            b.obj().set("item", item).build(), lsp_client.WALK_MS, r.arena)
        for call in got.get("result").arr_list(r.arena)
            if call.get(side).get("name").as_str().unwrap_or("").equals(name)
                ranges: = call.get("fromRanges").arr_list(r.arena)
                return ranges.get(0) if ranges.len > 0 else .null_val
        return .null_val

    priv fn refuses(r: Self, label: U8[], got: json.Value, says: U8[]) //<
        //< Checks that a response is an error whose message says `says`, and carries no edit
        message: = got.get("error").get("message").as_str().unwrap_or("")
        verdict.check(label,
            is_missing(got.get("result")) && message.find_str(says).is_some(),
            lsp_client.why(r.c, lsp_client.dump(got, r.arena), r.arena))

fn run_rename(exe: U8[], plain_caps: json.Value, arena: Arena$@) //<
    //< Starts a server on a workspace of its own and checks what a rename refuses
    //< `plain_caps` is the capabilities the suite's own server gave a client that said nothing.
    verdict.check("a client that does not ask prepareRename is told only that renaming is answered",
        plain_caps.get("renameProvider").as_bool().unwrap_or(false),
        lsp_client.dump(plain_caps, arena))
    dir: = harness.sandbox("lsp_rename")
    fs.write_tree(dir,
        U8[][]::{ "lib.kspl", USER_URI, PICK_URI, SHADE_URI, PAINT_URI, "tint.kspl", VEC_URI,
        "sum.kspl", SHAPE_URI, SLOT_URI, SLOT_USE_URI, LIFT_URI },
        U8[][]::{ LIB_SRC, USER_SRC, PICK_SRC, SHADE_SRC, PAINT_SRC, TINT_SRC, VEC_SRC, SUM_SRC,
        SHAPE_SRC, SLOT_SRC, SLOT_USE_SRC, LIFT_SRC }, arena) catch
            verdict.check("the rename workspace can be laid out", false, dir)
            return
    defer $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, dir, arena) catch
            verdict.check("the rename workspace's server starts", false, dir)
            return
    $b: = Json_builder(arena)
    asks: = b.obj()
        .set("textDocument",
        b.obj()
        .set("rename", b.obj().set("prepareSupport", b.bool_val(true)).build()).build()).build()
    init: =
        c.request("initialize", b.obj().set("capabilities", asks).build(), lsp_client.READ_MS, arena)
        catch
            verdict.check("the rename workspace's server answers initialize", false, "")
            return
    caps: = init.val.get("result").get("capabilities")
    verdict.check("a client that asks prepareRename is told it is answered",
        caps.get("renameProvider").get("prepareProvider").as_bool().unwrap_or(false),
        lsp_client.dump(caps, arena))
    lsp_client.open(c@, USER_URI, USER_SRC, arena)
    ask: = Ask::{ .c = c@, .arena = arena }
    check_prepare(ask)
    check_names(ask)
    check_clashes(ask)
    lsp_client.open(c@, PICK_URI, PICK_SRC, arena)
    check_selected(ask)
    check_type_calls(ask)
    check_captures(ask)
    check_closure_params(ask)
    check_import_jump(ask)
    check_variants(ask)
    check_other_files(ask)
    check_traits(ask)
    check_call_items(ask)
    check_generics(ask)
    check_generic_body(ask)
    check_generic_calls(ask)
    check_call_ranges(ask)
    check_closure_calls(ask)
    check_unwritten(ask)

priv fn check_prepare(ask: Ask) //< prepareRename: the name's range here, a refusal on std's
    local: = lsp_client.answer(ask.c, "textDocument/prepareRename",
        ask.at("    total: =", "total"), lsp_client.READ_MS, ask.arena)
    r: = local.get("result")
    verdict.check("prepareRename on a local answers its range and its name",
        r.get("placeholder").as_str().unwrap_or("").equals("total") &&
        r.get("range").get("start").get("character").as_int().unwrap_or(-1) == 4 &&
        r.get("range").get("end").get("character").as_int().unwrap_or(-1) == 9,
        lsp_client.why(ask.c, lsp_client.dump(local, ask.arena), ask.arena))
    std_name: = lsp_client.answer(ask.c, "textDocument/prepareRename",
        ask.at("    io.out()", "out"), lsp_client.READ_MS, ask.arena)
    ask.refuses("prepareRename refuses a name the standard library declares, saying where",
        std_name, "outside this workspace")
    // **The rename itself refuses too**: a client that never sends prepareRename would otherwise
    // be handed an edit to the installed std.
    ask.refuses("a rename of a std function refuses, with no edit to std",
        ask.rename("    io.out()", "out", "stdout_x"), "outside this workspace")

priv fn check_names(ask: Ask) //< the new name must be one the grammar reads as an identifier
    ask.refuses("a new name that is not an identifier is refused",
        ask.rename("    total: =", "total", "1bad name"), "is not a name")
    ask.refuses("a keyword as the new name is refused",
        ask.rename("    total: =", "total", "return"), "is a keyword")
    ask.refuses("a primitive type's name as the new name is refused",
        ask.rename("    total: =", "total", "I32"), "is a keyword")
    fine: = ask.rename("    total: =", "total", "sum")
    edits: = fine.get("result").get("changes").get(USER_URI).arr_list(ask.arena)
    verdict.check("a free new name renames the declaration and its use", edits.len == 2,
        lsp_client.why(ask.c, lsp_client.dump(fine, ask.arena), ask.arena))
    // **The `sb.free()` made for `defer $sb: = …` is no use**: it stands at the `defer`, where an
    // edit would overwrite the keyword.
    deferred: = ask.rename("    defer $sb", "sb", "text")
    d_edits: = deferred.get("result").get("changes").get(USER_URI).arr_list(ask.arena)
    verdict.check("a local declared with 'defer' renames its declaration and its two uses alone",
        d_edits.len == 3,
        lsp_client.why(ask.c, lsp_client.dump(deferred, ask.arena), ask.arena))

priv fn check_clashes(ask: Ask) //< the new name must not be declared where it would land
    ask.refuses("a local renamed to its function's parameter is refused",
        ask.rename("    total: =", "total", "seed"), "already declared")
    ask.refuses("a local renamed to a function its scope calls is refused",
        ask.rename("    total: =", "total", "other"), "already declared")
    ask.refuses("a name an import binds in the file is refused",
        ask.rename("    total: =", "total", "io"), "already bound by an import")
    ask.refuses("a function renamed to another of the same file is refused",
        ask.rename("fn other", "other", "use"), "already declared")
    ask.refuses("a method renamed to a method of its type in another impl is refused",
        ask.rename("    fn first", "first", "second"), "already declared")
    // **A member is reached after a `.`**, so a top-level function of the same name is no clash.
    member: = ask.rename("    a: I32", "a", "use")
    verdict.check("a field renamed to a top-level function's name goes through",
        member.get("result").get("changes").get(USER_URI).arr_list(ask.arena).len == 3,
        lsp_client.why(ask.c, lsp_client.dump(member, ask.arena), ask.arena))

fn edits_in(got: json.Value, uri: U8[], arena: Arena$@): List<|json.Value|> //<
    //< the edits a rename's answer makes in `uri`; none where it names no such file
    return got.get("result").get("changes").get(uri).arr_list(arena)

priv fn starts_at(edits: List<|json.Value|>@, line: Sz, character: Sz): Bool //<
    //< whether one of the edits starts at that line and column
    for i in Range.asc(edits.len)
        start: = edits.get(i).get("range").get("start")
        if start.get("line").as_int().unwrap_or(-1) == line &&
            start.get("character").as_int().unwrap_or(-1) == character
            return true
    return false

fn places(found: List<|json.Value|>@, arena: Arena$@): U8[] //<
    //< where each of a list of locations or edits starts, as `[<file>:]<line>:<column>`
    out: = arena.text()
    for i in Range.asc(found.len)
        start: = found.get(i).get("range").get("start")
        uri: = found.get(i).get("uri").as_str().unwrap_or("")
        if uri.len > 0
            out.s(uri).c(':')
        out
            .s("\{start.get("line").as_int().unwrap_or(-1)\}:\{start.get("character").as_int().unwrap_or(-1)\} \
                ")
    return out.take()

priv fn check_selected(ask: Ask) //<
    //< A name a selective import brings in is renamed in the import line too
    //< **The import line names it, so a rename that skips the line stops the program compiling.**
    by_name: = ask.rename_in(PICK_URI, PICK_SRC, "    return helper()", "helper", "aid")
    pick: = edits_in(by_name, PICK_URI, ask.arena)
    verdict.check("a name a selective import brings in is renamed in the import line too",
        edits_in(by_name, "lib.kspl", ask.arena).len == 1 && pick.len == 3 &&
        starts_at(pick@, 0, col_in_line(PICK_SRC, "import", "helper", ask.arena)),
        lsp_client.why(ask.c, lsp_client.dump(by_name, ask.arena), ask.arena))
    refs: = lsp_client.answer(ask.c, "textDocument/references",
        ask.at_in(PICK_URI, PICK_SRC, "    return helper()", "helper"), lsp_client.WALK_MS,
        ask.arena)
    found: = refs.get("result").arr_list(ask.arena)
    // The declaration, the import line and the two uses.
    verdict.check("the references of a name a selective import brings in count the import line",
        found.len == 4,
        lsp_client.why(ask.c, places(found@, ask.arena), ask.arena))

priv fn check_type_calls(ask: Ask) //< type calls name the type, not a written `new` member
    lsp_client.open(ask.c, TYPE_URI, TYPE_SRC, ask.arena)
    defer lsp_client.close(ask.c, TYPE_URI, ask.arena)
    pos: = ask.at_in(TYPE_URI, TYPE_SRC, "    c: =", "Cup")
    hover: = lsp_client.answer(ask.c, "textDocument/hover", pos, lsp_client.READ_MS, ask.arena)
    verdict.check("a type call's written name hovers as its type",
        lsp_client.hover_text(hover).find_str("struct type_call.Cup").is_some(),
        lsp_client.dump(hover, ask.arena))
    jump: = lsp_client.answer(ask.c, "textDocument/definition", pos, lsp_client.READ_MS, ask.arena)
    verdict.check("a type call's written name goes to the type declaration",
        jump.get("result").get("range").get("start").get("line").as_int().unwrap_or(-1) == 0,
        lsp_client.dump(jump, ask.arena))
    self_pos: = ask.at_in(TYPE_URI, TYPE_SRC, "        return Self(2)", "Self")
    self_jump: = lsp_client.answer(ask.c, "textDocument/definition", self_pos, lsp_client.READ_MS,
        ask.arena)
    verdict.check("a Self type call goes to the enclosing type declaration",
        self_jump.get("result").get("range").get("start").get("line").as_int().unwrap_or(-1) == 0,
        lsp_client.dump(self_jump, ask.arena))
    renamed: = ask.rename_in(TYPE_URI, TYPE_SRC, "    c: =", "Cup", "Mug")
    edits: = edits_in(renamed, TYPE_URI, ask.arena)
    verdict.check("renaming a type changes its call and declaration",
        starts_at(edits@, 0, 7) &&
        starts_at(edits@, decl_line(TYPE_SRC, "    c: =", ask.arena), 9),
        lsp_client.dump(renamed, ask.arena))
    verdict.check("renaming a type keeps Self in its body and type calls",
        !starts_at(edits@, decl_line(TYPE_SRC, "        return Self(2)", ask.arena), 15) &&
        !starts_at(edits@, decl_line(TYPE_SRC, "        return Self::{", ask.arena), 15),
        lsp_client.dump(renamed, ask.arena))
    ask.refuses("renaming new refuses before it can break an implicit type call",
        ask.rename_in(TYPE_URI, TYPE_SRC, "    fn new", "new", "make"), "type call")
    refs: = lsp_client.answer(ask.c, "textDocument/references",
        ask.at_in(TYPE_URI, TYPE_SRC, "    fn new", "new"), lsp_client.WALK_MS, ask.arena)
    verdict.check("new's written references do not claim the type call's name",
        refs.get("result").arr_list(ask.arena).len == 1, lsp_client.dump(refs, ask.arena))

priv fn check_captures(ask: Ask) //<
    //< A local a closure captures is renamed in its capture list and the closure's body too
    //< **The capture is the same name**: renamed apart, the closure reads a name that is gone. The
    //< edits land on the names, never on the `fn(` the closure's made declarations stand at.
    lsp_client.open(ask.c, CLOSURE_URI, CLOSURE_SRC, ask.arena)
    defer lsp_client.close(ask.c, CLOSURE_URI, ask.arena)
    closure_line: = decl_line(CLOSURE_SRC, "    add: =", ask.arena)
    cap_col: = col_in_line(CLOSURE_SRC, "    add: =", "limit", ask.arena)
    use_col: = col_in_line(CLOSURE_SRC, "    add: =", "limit;", ask.arena)
    from_outer: = ask.rename_in(CLOSURE_URI, CLOSURE_SRC, "    limit: =", "limit", "most")
    edits: = edits_in(from_outer, CLOSURE_URI, ask.arena)
    verdict.check("a captured local is renamed at its declaration, capture, body use and use",
        edits.len == 4 && starts_at(edits@, closure_line, cap_col) &&
        starts_at(edits@, closure_line, use_col) &&
        starts_at(edits@, decl_line(CLOSURE_SRC, "    limit: =", ask.arena), 4),
        lsp_client.why(ask.c, places(edits@, ask.arena), ask.arena))
    from_body: = ask.rename_in(CLOSURE_URI, CLOSURE_SRC, "    add: =", "limit;", "most")
    body_edits: = edits_in(from_body, CLOSURE_URI, ask.arena)
    verdict.check("a capture renamed from the closure's body renames the outer local too",
        body_edits.len == 4 &&
        starts_at(body_edits@, decl_line(CLOSURE_SRC, "    limit: =", ask.arena), 4),
        lsp_client.why(ask.c, places(body_edits@, ask.arena), ask.arena))
    refs: = lsp_client.answer(ask.c, "textDocument/references",
        ask.at_in(CLOSURE_URI, CLOSURE_SRC, "    add: =", "limit"), lsp_client.WALK_MS, ask.arena)
    found: = refs.get("result").arr_list(ask.arena)
    verdict.check("the references of a capture count the outer local and the body's use",
        found.len == 4,
        lsp_client.why(ask.c, places(found@, ask.arena), ask.arena))

priv fn check_closure_params(ask: Ask) //<
    //< A capturing closure's parameter renamed from its body changes the parameter and the use
    //< **The edits land on the name**, never on the `fn(` the closure's made declarations stand
    //< at. Go-to from the body lands on the written parameter too.
    lsp_client.open(ask.c, CLOSURE_URI, CLOSURE_SRC, ask.arena)
    defer lsp_client.close(ask.c, CLOSURE_URI, ask.arena)
    closure_line: = decl_line(CLOSURE_SRC, "    add: =", ask.arena)
    param_col: = col_in_line(CLOSURE_SRC, "    add: =", "x:", ask.arena)
    use_col: = col_in_line(CLOSURE_SRC, "    add: =", "x +", ask.arena)
    renamed: = ask.rename_in(CLOSURE_URI, CLOSURE_SRC, "    add: =", "x +", "item")
    edits: = edits_in(renamed, CLOSURE_URI, ask.arena)
    verdict.check("a closure's parameter renamed from its body changes only the name and its use",
        edits.len == 2 && starts_at(edits@, closure_line, param_col) &&
        starts_at(edits@, closure_line, use_col),
        lsp_client.why(ask.c, places(edits@, ask.arena), ask.arena))
    jump: = lsp_client.answer(ask.c, "textDocument/definition",
        ask.at_in(CLOSURE_URI, CLOSURE_SRC, "    add: =", "x +"), lsp_client.READ_MS, ask.arena)
    start: = jump.get("result").get("range").get("start")
    verdict.check("go-to from a closure's body lands on the written parameter",
        start.get("line").as_int().unwrap_or(-1) == closure_line &&
        start.get("character").as_int().unwrap_or(-1) == param_col,
        lsp_client.dump(jump, ask.arena))

priv fn check_variants(ask: Ask) //<
    //< An enum's variant is renamed where it is written `Shade.dark`, in every file
    //< **Sema links the `dark` of `Shade.dark` to the variant**, as it links a `.dark`. Missed, the
    //< rename leaves a program that does not compile.
    lsp_client.open(ask.c, SHADE_URI, SHADE_SRC, ask.arena)
    defer lsp_client.close(ask.c, SHADE_URI, ask.arena)
    renamed: = ask.rename_in(SHADE_URI, SHADE_SRC, "    dark", "dark", "deep")
    own: = edits_in(renamed, SHADE_URI, ask.arena)
    verdict.check("a variant is renamed where its own file writes it after the enum's name",
        own.len == 2 &&
        starts_at(own@, decl_line(SHADE_SRC, "    return Shade.dark", ask.arena), 17),
        lsp_client.why(ask.c, lsp_client.dump(renamed, ask.arena), ask.arena))
    verdict.check("a variant is renamed through a selective import and through an alias",
        edits_in(renamed, PAINT_URI, ask.arena).len == 1 &&
        edits_in(renamed, "tint.kspl", ask.arena).len == 1,
        lsp_client.why(ask.c, lsp_client.dump(renamed, ask.arena), ask.arena))
    lsp_client.open(ask.c, PAINT_URI, PAINT_SRC, ask.arena)
    defer lsp_client.close(ask.c, PAINT_URI, ask.arena)
    refs: = lsp_client.answer(ask.c, "textDocument/references",
        ask.at_in(PAINT_URI, PAINT_SRC, "    a: =", "dark"), lsp_client.WALK_MS, ask.arena)
    found: = refs.get("result").arr_list(ask.arena)
    // The declaration and the three uses.
    verdict.check("the references of a variant count the uses after the enum's name",
        found.len == 4,
        lsp_client.why(ask.c, places(found@, ask.arena), ask.arena))
    // **A generic's instance copies std's nodes with the enum put in** (`Index_place`'s `Output`
    // for the array `variants()` returns), at std's places. They are no uses.
    whole: = ask.rename_in(SHADE_URI, SHADE_SRC, "pub enum Shade", "Shade", "Hue")
    verdict.check("an enum is renamed, with nothing in std taken for a use of it",
        is_missing(whole.get("error")) && edits_in(whole, SHADE_URI, ask.arena).len == 4,
        lsp_client.why(ask.c, lsp_client.dump(whole, ask.arena), ask.arena))

priv fn check_other_files(ask: Ask) //<
    //< The files searched are those spelling the declaration, not the word at the cursor
    //< **Started on `Self`, the word names no other file**; and a file calling `new` through a
    //< type call never spells `new`. Either way, the rename used to miss what such a file holds.
    lsp_client.open(ask.c, VEC_URI, VEC_SRC, ask.arena)
    defer lsp_client.close(ask.c, VEC_URI, ask.arena)
    from_self: = ask.rename_in(VEC_URI, VEC_SRC, "    pub fn new", "Self", "Pair2")
    verdict.check("a type renamed from `Self` is renamed in the other files too",
        edits_in(from_self, "sum.kspl", ask.arena).len == 1,
        lsp_client.why(ask.c, lsp_client.dump(from_self, ask.arena), ask.arena))
    ask.refuses("renaming new refuses where only another file calls it through the type",
        ask.rename_in(VEC_URI, VEC_SRC, "    pub fn new", "new", "make"), "type call")
    ok: = ask.rename_in(VEC_URI, VEC_SRC, "    pub fn len_of", "len_of", "width")
    verdict.check("a plain method beside them is renamed in the other files",
        edits_in(ok, "sum.kspl", ask.arena).len == 1,
        lsp_client.why(ask.c, lsp_client.dump(ok, ask.arena), ask.arena))
    // **An operator is a call of the method it is rewritten to**, in another file too.
    $b: = Json_builder(ask.arena)
    prep: = lsp_client.answer(ask.c, "textDocument/prepareCallHierarchy",
        ask.at_in(VEC_URI, VEC_SRC, "    pub fn add", "add"), lsp_client.READ_MS, ask.arena)
    item: = prep.get("result").arr_list(ask.arena)
    $callers: U8[] = ""
    if item.len > 0
        got: = lsp_client.answer(ask.c, "callHierarchy/incomingCalls",
            b.obj().set("item", item.get(0)).build(), lsp_client.WALK_MS, ask.arena)
        callers = lsp_client.dump(got, ask.arena)
    verdict.check("the callers of an operator's method include another file's `a + a`",
        callers.find_str("sum_up").is_some(), lsp_client.why(ask.c, callers, ask.arena))

priv fn check_traits(ask: Ask) //<
    //< A trait's method, and a method implementing a trait, are refused with the reason
    //< **The trait and its implementations share the name**; renamed on one side, the program
    //< stops compiling.
    lsp_client.open(ask.c, VEC_URI, VEC_SRC, ask.arena)
    defer lsp_client.close(ask.c, VEC_URI, ask.arena)
    ask.refuses("a method that implements a std trait is refused",
        ask.rename_in(VEC_URI, VEC_SRC, "    pub fn add", "add", "plus"), "implements the trait")
    ask.refuses("a method a trait declares is refused",
        ask.rename_in(VEC_URI, VEC_SRC, "    fn size2", "size2", "area2"),
        "is declared by the trait")

priv fn check_call_items(ask: Ask) //<
    //< Each method of a trait's block is a starting point of the call hierarchy
    //< **A program the analysis stops on answers an error**, not an item that finds no callers.
    lsp_client.open(ask.c, SHAPE_URI, SHAPE_SRC, ask.arena)
    defer lsp_client.close(ask.c, SHAPE_URI, ask.arena)
    $b: = Json_builder(ask.arena)
    for head in U8[][]::{ "    pub fn area", "    pub fn side" }
        word: = head.sub_from(head.len - 4)
        prep: = lsp_client.answer(ask.c, "textDocument/prepareCallHierarchy",
            ask.at_in(SHAPE_URI, SHAPE_SRC, head, word), lsp_client.READ_MS, ask.arena)
        item: = prep.get("result").arr_list(ask.arena)
        $callers: = lsp_client.dump(prep, ask.arena)
        if item.len > 0
            got: = lsp_client.answer(ask.c, "callHierarchy/incomingCalls",
                b.obj().set("item", item.get(0)).build(), lsp_client.WALK_MS, ask.arena)
            callers = lsp_client.dump(got, ask.arena)
        verdict.check(ask.arena.text().s("the callers of a trait block's `").s(word)
            .s("` are found").take(), callers.find_str("tile_total").is_some(),
            lsp_client.why(ask.c, callers, ask.arena))
    lsp_client.open(ask.c, STRAY_URI, STRAY_SRC, ask.arena)
    defer lsp_client.close(ask.c, STRAY_URI, ask.arena)
    stray: = lsp_client.answer(ask.c, "textDocument/prepareCallHierarchy",
        ask.at_in(STRAY_URI, STRAY_SRC, "    pub fn add", "add"), lsp_client.READ_MS, ask.arena)
    ask.refuses("a function the analysis stopped before answers an error, not an empty item", stray,
        "was not analysed")

priv fn check_generics(ask: Ask) //<
    //< A generic type renamed from `Self`, and a type parameter, are renamed at every use
    //< **`Self` in a generic type's `impl` names an instance**, whose own name (`slot_Slot_I32`) no
    //< file spells. **Sema links no use of a type parameter**, so the walk matches it by the
    //< declaration that binds it.
    lsp_client.open(ask.c, SLOT_URI, SLOT_SRC, ask.arena)
    defer lsp_client.close(ask.c, SLOT_URI, ask.arena)
    from_self: = ask.rename_in(SLOT_URI, SLOT_SRC, "    pub fn get", "Self", "Hold")
    own: = edits_in(from_self, SLOT_URI, ask.arena)
    head_line: = decl_line(SLOT_SRC, "impl<|T|>", ask.arena)
    head_col: = col_in_line(SLOT_SRC, "impl<|T|>", "Slot", ask.arena)
    self_said: = lsp_client.why(ask.c, lsp_client.dump(from_self, ask.arena), ask.arena)
    verdict.check("a generic type renamed from `Self` is renamed in its `impl`'s heading too",
        starts_at(own@, head_line, head_col), self_said)
    verdict.check("a generic type renamed from `Self` is renamed in the other files too",
        edits_in(from_self, SLOT_USE_URI, ask.arena).len == 2,
        lsp_client.why(ask.c, lsp_client.dump(from_self, ask.arena), ask.arena))
    param: = ask.rename_in(SLOT_URI, SLOT_SRC, "fn first_of", "Elem", "Part")
    p_edits: = edits_in(param, SLOT_URI, ask.arena)
    line: = decl_line(SLOT_SRC, "fn first_of", ask.arena)
    at_param: = col_in_line(SLOT_SRC, "fn first_of", "Elem[]", ask.arena)
    at_result: = col_in_line(SLOT_SRC, "fn first_of", "): Elem", ask.arena) + 3
    param_said: = lsp_client.why(ask.c, places(p_edits@, ask.arena), ask.arena)
    verdict.check("a function's type parameter is renamed where it is declared and at its two uses",
        p_edits.len == 3 && starts_at(p_edits@, line, at_param) &&
        starts_at(p_edits@, line, at_result), param_said)
    // **The nearest declaration that binds the name is the one a use means**: the struct's `T`
    // and the `impl`'s `T` are two parameters.
    of_type: = ask.rename_in(SLOT_URI, SLOT_SRC, "pub struct Slot", "T", "Kept")
    t_edits: = edits_in(of_type, SLOT_URI, ask.arena)
    verdict.check("a type's type parameter is renamed in its fields, not in its `impl`'s own",
        t_edits.len == 2 &&
        starts_at(t_edits@, decl_line(SLOT_SRC, "    held:", ask.arena), 10),
        lsp_client.why(ask.c, places(t_edits@, ask.arena), ask.arena))

priv fn check_generic_body(ask: Ask) //<
    //< A parameter and a local of a generic nothing instantiates are renamed at every use
    //< **Sema links no local name in a template's body**, so the walk resolves each by its scope.
    //< Missed, the rename changed the declaration alone and broke the program.
    lsp_client.open(ask.c, SLOT_URI, SLOT_SRC, ask.arena)
    defer lsp_client.close(ask.c, SLOT_URI, ask.arena)
    param: =
        edits_in(ask.rename_in(SLOT_URI, SLOT_SRC, "fn first_of", "items", "parts"), SLOT_URI,
        ask.arena)
    use_line: = decl_line(SLOT_SRC, "    head: =", ask.arena)
    use_col: = col_in_line(SLOT_SRC, "    head: =", "items", ask.arena)
    verdict.check("a generic's parameter is renamed where it is declared and where its body uses it",
        param.len == 2 && starts_at(param@, use_line, use_col),
        lsp_client.why(ask.c, places(param@, ask.arena), ask.arena))
    local: =
        edits_in(ask.rename_in(SLOT_URI, SLOT_SRC, "    head: =", "head", "top"), SLOT_URI,
        ask.arena)
    verdict.check("a generic's local is renamed where it is declared and where it is used",
        local.len == 2 &&
        starts_at(local@, decl_line(SLOT_SRC, "    return head", ask.arena), 11),
        lsp_client.why(ask.c, places(local@, ask.arena), ask.arena))

priv fn check_generic_calls(ask: Ask) //<
    //< A generic type's method is one item of the call hierarchy, named as written
    //< **Every instance stands for its template.** Named by an instance, the method had no callers,
    //< and showed the name the C code uses (`slot_Slot_I32_get`).
    lsp_client.open(ask.c, SLOT_URI, SLOT_SRC, ask.arena)
    defer lsp_client.close(ask.c, SLOT_URI, ask.arena)
    item: = ask.call_item(SLOT_URI, SLOT_SRC, "    pub fn get", "get")
    callers: = ask.call_names(item, "incomingCalls", "from")
    verdict.check("the callers of a generic type's method are found, in each file",
        callers.find_str("held_one").is_some() && callers.find_str("held_two").is_some(),
        lsp_client.why(ask.c, callers, ask.arena))
    at_call: = ask.call_item(SLOT_URI, SLOT_SRC, "    return s.get", "get")
    data: = item.get("data").as_str().unwrap_or("")
    verdict.check("a call of an instance prepares the item the method's declaration does",
        data.len > 0 && at_call.get("data").as_str().unwrap_or("").equals(data) &&
        at_call.get("name").as_str().unwrap_or("").equals("get"),
        lsp_client.why(ask.c, lsp_client.dump(at_call, ask.arena), ask.arena))
    callees: = ask.call_names(ask.call_item(SLOT_URI, SLOT_SRC, "fn held_one", "held_one"),
        "outgoingCalls", "to")
    verdict.check("a call of a generic type's method shows the method's own name",
        callees.equals("get,"), lsp_client.why(ask.c, callees, ask.arena))

priv fn check_call_ranges(ask: Ask) //<
    //< A call's range is read in the caller's file, in both directions
    //< **The call stands in the caller's file**, though the item it leads to can be in another.
    //< Read with the callee's lines, the range pointed at unrelated text.
    lsp_client.open(ask.c, SLOT_USE_URI, SLOT_USE_SRC, ask.arena)
    defer lsp_client.close(ask.c, SLOT_USE_URI, ask.arena)
    line: = decl_line(SLOT_USE_SRC, "    return s.get", ask.arena)
    col: = col_in_line(SLOT_USE_SRC, "    return s.get", "get", ask.arena)
    out: = ask.call_range(ask.call_item(SLOT_USE_URI, SLOT_USE_SRC, "fn held_two", "held_two"),
        "outgoingCalls", "get")
    verdict.check("an outgoing call's range to another file is where the caller's file writes it",
        range_is(out, line, col, 3),
        lsp_client.why(ask.c, lsp_client.dump(out, ask.arena), ask.arena))
    lsp_client.open(ask.c, SLOT_URI, SLOT_SRC, ask.arena)
    defer lsp_client.close(ask.c, SLOT_URI, ask.arena)
    inc: = ask.call_range(ask.call_item(SLOT_URI, SLOT_SRC, "    pub fn get", "get"),
        "incomingCalls", "held_two")
    verdict.check("an incoming call's range from another file is where the caller's file writes it",
        range_is(inc, line, col, 3),
        lsp_client.why(ask.c, lsp_client.dump(inc, ask.arena), ask.arena))

priv fn range_is(range: json.Value, line: Sz, character: Sz, len: Sz): Bool //<
    //< whether a one-line range starts at that line and column and is len long
    start: = range.get("start")
    end: = range.get("end")
    return start.get("line").as_int().unwrap_or(-1) == line &&
        start.get("character").as_int().unwrap_or(-1) == character &&
        end.get("line").as_int().unwrap_or(-1) == line &&
        end.get("character").as_int().unwrap_or(-1) == character + len

priv fn check_closure_calls(ask: Ask) //<
    //< A closure written in a function is not one of its calls; the calls written beside it are
    //< **The compiler lifts a closure into functions of its own**, and the place it is written
    //< calls or names them. Listed, they showed names no file spells (`_anon_env_new_1`).
    lsp_client.open(ask.c, LIFT_URI, LIFT_SRC, ask.arena)
    defer lsp_client.close(ask.c, LIFT_URI, ask.arena)
    item: = ask.call_item(LIFT_URI, LIFT_SRC, "fn makes_closures", "makes_closures")
    callees: = ask.call_names(item, "outgoingCalls", "to")
    verdict.check("a function's closures are not among its calls",
        callees.equals("run_on,bump_with,"), lsp_client.why(ask.c, callees, ask.arena))

priv fn check_unwritten(ask: Ask) //<
    //< A name the source does not spell where it is declared is refused, with the reason
    //< **Only its uses would change.** An import with no `as` is named by its path's last part;
    //< a closure's `call` is declared by the compiler.
    ask.refuses("an import's name is refused where no `as` is written, naming what to write",
        ask.rename("    total: =", "lib", "base"), "Write 'as base'")
    refs: = lsp_client.answer(ask.c, "textDocument/references", ask.at("    total: =", "lib"),
        lsp_client.WALK_MS, ask.arena)
    found: = refs.get("result").arr_list(ask.arena)
    // **The alias, not the `hit` written after it**: one use, and nothing in `lib.kspl`.
    verdict.check("the references of an import's name are its own uses, not the member's after it",
        found.len == 1 &&
        found.get(0).get("uri").as_str().unwrap_or("").equals(USER_URI) &&
        found.get(0).get("range").get("start").get("character").as_int().unwrap_or(-1) ==
        col_in_line(USER_SRC, "    total: =", "lib", ask.arena),
        lsp_client.why(ask.c, places(found@, ask.arena), ask.arena))
    lsp_client.open(ask.c, CALL_URI, CALL_SRC, ask.arena)
    defer lsp_client.close(ask.c, CALL_URI, ask.arena)
    ask.refuses("a closure's `call` is refused: the compiler declares it",
        ask.rename_in(CALL_URI, CALL_SRC, "    return add.call", "call", "run"),
        "not written where it is declared")

priv fn check_import_jump(ask: Ask) //<
    //< A jump from an import's path lands on the file the compiler read for it
    //< **The server resolves it as the loader does**; a search by file name would pick any file
    //< of that name, one in `out/` included.
    lsp_client.open(ask.c, PICK_URI, PICK_SRC, ask.arena)
    jump: = lsp_client.answer(ask.c, "textDocument/definition",
        ask.at_in(PICK_URI, PICK_SRC, "import", "lib"), lsp_client.READ_MS, ask.arena)
    verdict.check("a jump from an import's path lands on the file it names",
        jump.get("result").get("uri").as_str().unwrap_or("").equals("lib.kspl"),
        lsp_client.why(ask.c, lsp_client.dump(jump, ask.arena), ask.arena))

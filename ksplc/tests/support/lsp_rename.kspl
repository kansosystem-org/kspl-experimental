//< The `lsp` suite's checks on renaming: what it refuses, and the import lines it reaches
//< Not a suite; `../suite/lsp_test.kspl` calls `run_rename`. **The workspace is a folder of its
//< own**, with std read from outside it, as a project sees an installed standard library.
//< Each refusal is shown beside a rename that goes through, so a server answering every request
//< with an error cannot pass.
import "ksplc/tests/support/harness"
import "ksplc/tests/support/jsonrpc_client"
import "ksplc/tests/support/lsp_client"
import "ksplc/tests/support/lsp_read" { col_in_line, decl_line, is_missing }
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/json" + { Json_builder }
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

priv const LIB_SRC: U8[] = "fn hit(): I32\n    return 0\n\nfn helper(): I32\n    return 2\n"
priv const USER_URI: U8[] = "user.kspl"
priv const PICK_URI: U8[] = "pick.kspl" //< brings `helper` in by name
priv const PICK_SRC: U8[] =
    """import "lib" { helper }

fn twice(): I32
    return helper() + helper()
"""
priv const USER_SRC: U8[] =
    """import "std/io"
import "std/str" { Str_builder }
import "lib"

fn other(): I32
    return 1

fn built(): Sz
    defer $sb: = Str_builder.new()
    sb.s("x")
    return sb.len

fn use(seed: I32): I32
    total: = seed + lib.hit()
    io.out().s("x")
    return total + other()

struct Pair
    a: I32

impl Pair
    fn first(p: Self@): I32
        return p.a

impl Pair
    fn second(p: Self@): I32
        return p.a
"""

priv const TYPE_URI: U8[] = "type_call.kspl"
priv const TYPE_SRC: U8[] =
    """struct Cup
    n: I32

impl Cup
    fn new(n: I32 = 7): Self
        return Self::{ .n = n }

    fn again(): Self
        return Self(2)

fn use(): I32
    c: = Cup(3)
    return c.n
"""

priv struct Ask //< one client, and where the probe's names stand in its document
    c: jsonrpc_client.Client$@
    arena: Arena$@

impl Ask
    priv fn at(r: Self, line_head: U8[], word: U8[]): json.Value //<
        //< the position of `word` on a line of the user's document
        return r.at_in(USER_URI, USER_SRC, line_head, word)

    priv fn at_in(r: Self, uri: U8[], src: U8[], line_head: U8[], word: U8[]): json.Value //<
        //< the position of `word` on a line of the document `uri`, whose text is `src`
        line: = decl_line(src, line_head, r.arena)
        return lsp_client.at_pos(uri, line, col_in_line(src, line_head, word, r.arena) + 1,
            r.arena)

    priv fn rename(r: Self, line_head: U8[], word: U8[], new_name: U8[]): json.Value //<
        //< The whole response to renaming `word` to `new_name` in the user's document
        return r.rename_in(USER_URI, USER_SRC, line_head, word, new_name)

    priv fn rename_in(r: Self, uri: U8[], src: U8[], line_head: U8[], word: U8[], new_name: U8[]):
        json.Value //<
            //< The whole response to renaming `word` to `new_name` in the document `uri`
        $b: = Json_builder.new(r.arena)
        pos: = r.at_in(uri, src, line_head, word)
        params: = b.obj().set("textDocument", pos.get("textDocument"))
            .set("position", pos.get("position")).set("newName", b.str_val(new_name)).build()
        return lsp_client.answer(r.c, "textDocument/rename", params, lsp_client.WALK_MS, r.arena)

    priv fn refuses(r: Self, label: U8[], got: json.Value, says: U8[]) //<
        //< Checks that a response is an error whose message says `says`, and carries no edit
        message: = got.get("error").get("message").as_str().unwrap_or("")
        verdict.check(label,
            is_missing(got.get("result")) && message.find_str(says).is_some(),
            lsp_client.why(r.c, lsp_client.dump(got, r.arena), r.arena))

fn run_rename(exe: U8[], plain_caps: json.Value, arena: Arena$@) //<
    //< Starts a server on a workspace of its own and checks what a rename refuses
    //< `plain_caps` is the capabilities the suite's own server gave a client that said nothing.
    verdict.check("a client that does not ask prepareRename is told only that renaming is answered",
        plain_caps.get("renameProvider").as_bool().unwrap_or(false),
        lsp_client.dump(plain_caps, arena))
    dir: = harness.sandbox("lsp_rename")
    fs.write_tree(dir, U8[][]::{ "lib.kspl", USER_URI, PICK_URI },
        U8[][]::{ LIB_SRC, USER_SRC, PICK_SRC }, arena) catch
        verdict.check("the rename workspace can be laid out", false, dir)
        return
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, dir, arena) catch
        verdict.check("the rename workspace's server starts", false, dir)
        return
    defer c.free()
    $b: = Json_builder.new(arena)
    asks: = b.obj()
        .set("textDocument",
        b.obj()
        .set("rename", b.obj().set("prepareSupport", b.bool_val(true)).build()).build()).build()
    init: =
        c.request("initialize", b.obj().set("capabilities", asks).build(), lsp_client.READ_MS, arena)
        catch
        verdict.check("the rename workspace's server answers initialize", false, "")
        return
    caps: = init.val.get("result").get("capabilities")
    verdict.check("a client that asks prepareRename is told it is answered",
        caps.get("renameProvider").get("prepareProvider").as_bool().unwrap_or(false),
        lsp_client.dump(caps, arena))
    c.notify("textDocument/didOpen", lsp_client.did_open(USER_URI, USER_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    ask: = Ask::{ .c = c@, .arena = arena }
    check_prepare(ask)
    check_names(ask)
    check_clashes(ask)
    c.notify("textDocument/didOpen", lsp_client.did_open(PICK_URI, PICK_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    check_selected(ask)
    check_type_calls(ask)

priv fn check_prepare(ask: Ask) //< prepareRename: the name's range here, a refusal on std's
    local: = lsp_client.answer(ask.c, "textDocument/prepareRename",
        ask.at("    total: =", "total"), lsp_client.READ_MS, ask.arena)
    r: = local.get("result")
    verdict.check("prepareRename on a local answers its range and its name",
        r.get("placeholder").as_str().unwrap_or("").equals("total") &&
        r.get("range").get("start").get("character").as_int().unwrap_or(-1) == 4 &&
        r.get("range").get("end").get("character").as_int().unwrap_or(-1) == 9,
        lsp_client.why(ask.c, lsp_client.dump(local, ask.arena), ask.arena))
    std_name: = lsp_client.answer(ask.c, "textDocument/prepareRename",
        ask.at("    io.out()", "out"), lsp_client.READ_MS, ask.arena)
    ask.refuses("prepareRename refuses a name the standard library declares, saying where",
        std_name, "outside this workspace")
    // **The rename itself refuses too**: a client that never sends prepareRename would otherwise
    // be handed an edit to the installed std.
    ask.refuses("a rename of a std function refuses, with no edit to std",
        ask.rename("    io.out()", "out", "stdout_x"), "outside this workspace")

priv fn check_names(ask: Ask) //< the new name must be one the grammar reads as an identifier
    ask.refuses("a new name that is not an identifier is refused",
        ask.rename("    total: =", "total", "1bad name"), "is not a name")
    ask.refuses("a keyword as the new name is refused",
        ask.rename("    total: =", "total", "return"), "is a keyword")
    ask.refuses("a primitive type's name as the new name is refused",
        ask.rename("    total: =", "total", "I32"), "is a keyword")
    fine: = ask.rename("    total: =", "total", "sum")
    edits: = fine.get("result").get("changes").get(USER_URI).arr_list(ask.arena)
    verdict.check("a free new name renames the declaration and its use", edits.len == 2,
        lsp_client.why(ask.c, lsp_client.dump(fine, ask.arena), ask.arena))
    // **The `sb.free()` made for `defer $sb: = …` is no use**: it stands at the `defer`, where an
    // edit would overwrite the keyword.
    deferred: = ask.rename("    defer $sb", "sb", "text")
    d_edits: = deferred.get("result").get("changes").get(USER_URI).arr_list(ask.arena)
    verdict.check("a local declared with 'defer' renames its declaration and its two uses alone",
        d_edits.len == 3,
        lsp_client.why(ask.c, lsp_client.dump(deferred, ask.arena), ask.arena))

priv fn check_clashes(ask: Ask) //< the new name must not be declared where it would land
    ask.refuses("a local renamed to its function's parameter is refused",
        ask.rename("    total: =", "total", "seed"), "already declared")
    ask.refuses("a local renamed to a function its scope calls is refused",
        ask.rename("    total: =", "total", "other"), "already declared")
    ask.refuses("a name an import binds in the file is refused",
        ask.rename("    total: =", "total", "io"), "already bound by an import")
    ask.refuses("a function renamed to another of the same file is refused",
        ask.rename("fn other", "other", "use"), "already declared")
    ask.refuses("a method renamed to a method of its type in another impl is refused",
        ask.rename("    fn first", "first", "second"), "already declared")
    // **A member is reached after a `.`**, so a top-level function of the same name is no clash.
    member: = ask.rename("    a: I32", "a", "use")
    verdict.check("a field renamed to a top-level function's name goes through",
        member.get("result").get("changes").get(USER_URI).arr_list(ask.arena).len == 3,
        lsp_client.why(ask.c, lsp_client.dump(member, ask.arena), ask.arena))

priv fn edits_in(got: json.Value, uri: U8[], arena: Arena$@): List<|json.Value|> //<
    //< the edits a rename's answer makes in `uri`; none where it names no such file
    return got.get("result").get("changes").get(uri).arr_list(arena)

priv fn starts_at(edits: List<|json.Value|>@, line: Sz, character: Sz): Bool //<
    //< whether one of the edits starts at that line and column
    for i in Range.asc(edits.len)
        start: = edits.get(i).get("range").get("start")
        if start.get("line").as_int().unwrap_or(-1) == line &&
            start.get("character").as_int().unwrap_or(-1) == character
            return true
    return false

priv fn places(found: List<|json.Value|>@, arena: Arena$@): U8[] //<
    //< where each of a list of locations or edits starts, as `[<file>:]<line>:<column>`
    out: = arena.text()
    for i in Range.asc(found.len)
        start: = found.get(i).get("range").get("start")
        uri: = found.get(i).get("uri").as_str().unwrap_or("")
        if uri.len > 0
            out.s(uri).c(':')
        out
            .s("\{start.get("line").as_int().unwrap_or(-1)\}:\{start.get("character").as_int().unwrap_or(-1)\} ")
    return out.take()

priv fn check_selected(ask: Ask) //<
    //< A name a selective import brings in is renamed in the import line too
    //< **The import line names it, so a rename that skips the line stops the program compiling.**
    by_name: = ask.rename_in(PICK_URI, PICK_SRC, "    return helper()", "helper", "aid")
    pick: = edits_in(by_name, PICK_URI, ask.arena)
    verdict.check("a name a selective import brings in is renamed in the import line too",
        edits_in(by_name, "lib.kspl", ask.arena).len == 1 && pick.len == 3 &&
        starts_at(pick@, 0, col_in_line(PICK_SRC, "import", "helper", ask.arena)),
        lsp_client.why(ask.c, lsp_client.dump(by_name, ask.arena), ask.arena))
    refs: = lsp_client.answer(ask.c, "textDocument/references",
        ask.at_in(PICK_URI, PICK_SRC, "    return helper()", "helper"), lsp_client.WALK_MS,
        ask.arena)
    found: = refs.get("result").arr_list(ask.arena)
    // The declaration, the import line and the two uses.
    verdict.check("the references of a name a selective import brings in count the import line",
        found.len == 4,
        lsp_client.why(ask.c, places(found@, ask.arena), ask.arena))

priv fn check_type_calls(ask: Ask) //< type calls name the type, not a written `new` member
    ask.c
        .notify("textDocument/didOpen", lsp_client.did_open(TYPE_URI, TYPE_SRC, ask.arena),
        lsp_client.SEND_MS, ask.arena) catch {}
    defer lsp_client.close(ask.c, TYPE_URI, ask.arena)
    pos: = ask.at_in(TYPE_URI, TYPE_SRC, "    c: =", "Cup")
    hover: = lsp_client.answer(ask.c, "textDocument/hover", pos, lsp_client.READ_MS, ask.arena)
    verdict.check("a type call's written name hovers as its type",
        lsp_client.hover_text(hover).find_str("struct type_call.Cup").is_some(),
        lsp_client.dump(hover, ask.arena))
    jump: = lsp_client.answer(ask.c, "textDocument/definition", pos, lsp_client.READ_MS, ask.arena)
    verdict.check("a type call's written name goes to the type declaration",
        jump.get("result").get("range").get("start").get("line").as_int().unwrap_or(-1) == 0,
        lsp_client.dump(jump, ask.arena))
    self_pos: = ask.at_in(TYPE_URI, TYPE_SRC, "        return Self(2)", "Self")
    self_jump: = lsp_client.answer(ask.c, "textDocument/definition", self_pos, lsp_client.READ_MS,
        ask.arena)
    verdict.check("a Self type call goes to the enclosing type declaration",
        self_jump.get("result").get("range").get("start").get("line").as_int().unwrap_or(-1) == 0,
        lsp_client.dump(self_jump, ask.arena))
    renamed: = ask.rename_in(TYPE_URI, TYPE_SRC, "    c: =", "Cup", "Mug")
    edits: = edits_in(renamed, TYPE_URI, ask.arena)
    verdict.check("renaming a type changes its call and declaration",
        starts_at(edits@, 0, 7) &&
        starts_at(edits@, decl_line(TYPE_SRC, "    c: =", ask.arena), 9),
        lsp_client.dump(renamed, ask.arena))
    verdict.check("renaming a type keeps Self in its body and type calls",
        !starts_at(edits@, decl_line(TYPE_SRC, "        return Self(2)", ask.arena), 15) &&
        !starts_at(edits@, decl_line(TYPE_SRC, "        return Self::{", ask.arena), 15),
        lsp_client.dump(renamed, ask.arena))
    ask.refuses("renaming new refuses before it can break an implicit type call",
        ask.rename_in(TYPE_URI, TYPE_SRC, "    fn new", "new", "make"), "type call")
    refs: = lsp_client.answer(ask.c, "textDocument/references",
        ask.at_in(TYPE_URI, TYPE_SRC, "    fn new", "new"), lsp_client.WALK_MS, ask.arena)
    verdict.check("new's written references do not claim the type call's name",
        refs.get("result").arr_list(ask.arena).len == 1, lsp_client.dump(refs, ask.arena))

//< The CLI's emitted-file checks and the command assertions they share with the suite
//< The interfaces, API record and link-library list are read back from a sample directory.
//< The suite keeps command selection, help and diagnostics; both use the same status/text check.
import "ksplc/tests/support/harness"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/sys"
import "std/verdict"

fn cli(args: U8[][]): verdict.Run_out //< it runs ksplc once
    //< Not `harness.ksplc`: a subcommand that does not accept `--std-dir=` rejects its call.
    return harness.ksplc_bare(args)

priv fn check_case(name: U8[], args: U8[][], expect: U8[], accepted: Bool) //<
    //< It checks the requested exit status and the text the command must produce
    r: = cli(args)
    if (r.exited_with(0)) != accepted
        why: = "the exit code is not 0" if accepted else "it passed without being turned away"
        verdict.check(name, false,
            harness.arena().text().s(why).c('\n').s(r.out).take())
        return
    if expect.len > 0 && r.out.find_str(expect).is_none()
        verdict.check(name, false,
            harness.arena().text().s("\{expect\} does not come out\n\{r.out\}").take())
        return
    verdict.check(name, true, "")

fn ok_case(name: U8[], args: U8[][], expect: U8[]) //<
    //< It checks that the run passes (exit code 0) and what the output must contain
    check_case(name, args, expect, true)

fn ng_case(name: U8[], args: U8[][], expect: U8[]) //<
    //< It checks that the run is rejected (a non-zero exit code) and what the error must contain
    check_case(name, args, expect, false)

fn std_flag(): U8[] //< the option passing the standard library's directory
    //< **The working directory changes before the run, so a relative path would not resolve.**
    return harness.arena().text().s("--std-dir=\{harness.std_dir()\}").take()

priv fn lib_opt(path: U8[], arena: Arena$@): U8[] //< `--library=<path>`
    return arena.text().s("--library=").s(path).take()

fn case_library(arena: Arena$@) //<
    //< `--library=` builds a library and writes each interface it names, from one compile
    //< A value that names no form, or one path twice, is refused rather than written.
    dir: = harness.sandbox("cli_library")
    src: = fs.join(dir, "lib.kspl", arena)
    io.write_file(src, "pub extern fn lib_twice(n: I32): I32\n  return n * 2\n") catch
        verdict.check("--library: the library can be written", false, "")
        return
    out_c: = fs.join(dir, "lib.c", arena)
    h: = fs.join(dir, "lib.h", arena)
    api: = fs.join(dir, "lib_api.kspl", arena)
    ok_case("--library= twice writes both interfaces from one compile",
        U8[][]::{ std_flag(), lib_opt(h, arena), lib_opt(api, arena), src, out_c }, "")
    verdict.check("both interfaces are written",
        fs.exists(h) && fs.exists(api) && fs.exists(out_c), dir)
    ng_case("--library needs the interface it writes",
        U8[][]::{ std_flag(), "--library", src, out_c }, "'--library=<value>'")
    ng_case("--library= refuses a name of neither form",
        U8[][]::{ std_flag(), lib_opt("x.txt", arena), src, out_c }, "names neither form")
    ng_case("--library= refuses one path named twice",
        U8[][]::{ std_flag(), lib_opt(h, arena), lib_opt(h, arena), src, out_c }, "is named twice")
    ng_case("--library refuses --program, since a library has no main()",
        U8[][]::{ std_flag(), "--program", lib_opt(h, arena), src, out_c },
        "--program cannot be combined")

fn case_surface_doc(arena: Arena$@) //<
    //< The record of the published API carries the documentation as a fourth column
    //< Caution: **Check both sides**, the summary line and the detail below it. One alone lets the
    //< other be lost unnoticed. **Check the full stop between them too.** Without it two fragments
    //< run into one broken sentence. None is wanted where the summary ends in its own (`described`
    //< in `../../base/ast_doc.kspl`). `closed` keeps an empty `//<` below its summary, the shape
    //< before the formatter dropped it, and reads the same. **A `pub` C function is a row too**,
    //< keyed with its block's attributes. Without it, what reaches every package goes unrecorded.
    dir: = fs.join(harness.tmp_dir(), "cli_surface", arena)
    fs.mkdir_all(dir) catch {}
    src: = fs.join(dir, "api.kspl", arena)
    tsv: = fs.join(dir, "api.tsv", arena)
    body: U8[] =
        """pub struct Row //< one row of the table
  //< What a row stands for, in a sentence.
  pub text: U8[] //< the text as the writer typed it


pub fn count(rows: Row[1]): Sz //< how many rows carry text
  //< Walks the table once and counts.
  return rows[0].text.len


pub fn named(rows: Row[1]): Sz //< it names the column as `text`
  //< A summary closing on a code span takes its stop behind the span.
  return rows[0].text.len


pub fn closed(rows: Row[1]): Sz //< it closes its own sentence.
  //<
  //< No second stop is put in behind it.
  return rows[0].text.len


##link("m")
pub extern fn c_reached(x: I32): I32 //< reached from every package
extern fn c_kept(): I32


fn main(): I32
  return 0

"""
    io.write_file(src, body) catch
        verdict.check("the record's documentation: the sample can be written", false, src)
        return
    r: = harness.run_in(U8[][]::{ harness.ksplc_exe(), std_flag(), "doc",
        arena.text().s("--emit-surface=").s(tsv).take(), "api" }, dir)
    if !r.exited_with(0)
        verdict.check("the record's documentation: it is put out", false, r.out)
        return
    got: = io.read_file(tsv, null) catch ""
    wants: U8[][6] = ::{ "Row\tpub struct Row\tone row of the table. What a row stands for, in a \
        sentence.", "Row.text\tpub text: U8[]\tthe text as the writer typed it",
        "count\tpub fn count(rows: Row[1]): Sz\thow many rows carry text. Walks the table once and \
            counts.",
        "named\tpub fn named(rows: Row[1]): Sz\tit names the column as `text`. A summary closing on \
            a code span takes its stop behind the span.",
        "closed\tpub fn closed(rows: Row[1]): Sz\tit closes its own sentence. No second stop is put \
            in behind it.",
        "c_reached\tpub extern fn c_reached(x: I32): I32\treached from every package" }
    for want in wants
        verdict.check(arena.text().s("the record's documentation carries \"").s(want).s("\"").take(),
            got.find_str(want).is_some(), got)
    verdict.check("the record leaves out a C function that is not pub",
        got.find_str("c_kept").is_none(), got)

priv fn emitted_libs(dir: U8[], entry: U8[], flags: U8[][], arena: Arena$@): U8[] //<
    //< What `--emit-libs` wrote for the entry file, or `FAILED` and the output where it failed
    libs: = fs.join(dir, "out.libs", arena)
    fs.remove_path(libs) catch {}
    $argv: = List<|U8[]|>(arena)
    argv.push(harness.ksplc_exe())
    argv.push(std_flag())
    argv.push_all(flags)
    argv.push(arena.text().s("--emit-libs=").s(libs).take())
    argv.push(fs.join(dir, entry, arena))
    argv.push(fs.join(dir, "out.c", arena))
    r: = harness.run_in(argv.slice(), dir)
    if !r.exited_with(0)
        return arena.text().s("FAILED ").s(r.out).take()
    return harness.read_generated(libs)

fn case_emit_libs(arena: Arena$@) //<
    //< `--emit-libs` writes the libraries the kept `##link`s name
    //< **A file's names come before those of the files it imports** (a one-pass linker wants a
    //< library before the ones it uses). Each comes once, at its first place. A group that `#cfg`
    //< dropped names nothing.
    //< Caution: **A failed compile leaves no file.** A build that reads a stale one links the
    //< libraries of a program that does not build.
    dir: = fs.join(harness.tmp_dir(), "cli_emit_libs", arena)
    fs.mkdir_all(dir) catch {}
    main_src: U8[] =
        """import "wrap"

##link("app", "shared")
extern fn app_value(): I32


#cfg(extra)
  ##link("extra")
  extern fn extra_value(): I32


fn main(): I32
  return wrap.value()

"""
    wrap_src: U8[] =
        """##link("wrapped", "shared")
extern fn wrapped_value(): I32


pub fn value(): I32
  return 0

"""
    none_src: U8[] = """fn main(): I32
  return 0

"""
    bad_src: U8[] =
        """##link("app")
extern fn app_value(): I32


fn main(): I32
  return app_value(1)

"""
    fs.write_tree(dir, U8[][]::{ "main.kspl", "wrap.kspl", "none.kspl", "bad.kspl" },
        U8[][]::{ main_src, wrap_src, none_src, bad_src }, harness.arena()) catch
            verdict.check("--emit-libs: the sample can be written", false, dir)
            return
    got: = emitted_libs(dir, "main.kspl", U8[][]::{}, arena)
    verdict.check("--emit-libs: a file's names before those of what it imports, each once",
        got.equals("-lapp -lshared -lwrapped\n"), got)
    flagged: = emitted_libs(dir, "main.kspl", U8[][]::{ "--define=extra" }, arena)
    verdict.check("--emit-libs: a block #cfg keeps names its library in its place",
        flagged.equals("-lapp -lshared -lextra -lwrapped\n"), flagged)
    none: = emitted_libs(dir, "none.kspl", U8[][]::{}, arena)
    verdict.check("--emit-libs: naming no library writes an empty line", none.equals("\n"), none)
    bad: = emitted_libs(dir, "bad.kspl", U8[][]::{}, arena)
    verdict.check("--emit-libs: a compile that fails writes no file",
        bad.starts_with("FAILED ") && !fs.exists(fs.join(dir, "out.libs", arena)), bad)

fn case_output_is_input(arena: Arena$@) //<
    //< A compile or a build refuses to write over its own input, in whatever spelling it is named
    //< **The source must read the same after each refusal**: an exit code alone would also pass
    //< after a write that replaced it.
    dir: = harness.sandbox("cli_output_is_input")
    src: = fs.join(dir, "a.kspl", arena)
    text: U8[] = "fn main(): I32\n  return 0\n"
    other: = fs.join(dir, "sub/../a.kspl", arena)
    deps: = arena.text().s("--emit-deps=").s(src).take()
    libs: = arena.text().s("--emit-libs=").s(other).take()
    out_c: = fs.join(dir, "a.c", arena)
    cases: = U8[][][]::{ U8[][]::{ std_flag(), src, src },
        U8[][]::{ std_flag(), src, other }, U8[][]::{ "build", std_flag(), src, src },
        U8[][]::{ std_flag(), deps, src, out_c },
        U8[][]::{ std_flag(), libs, src, out_c } }
    for i in Range.asc(cases.len)
        // Written again, so a case that replaced it does not spoil the next.
        io.write_file(src, text) catch {}
        name: = arena.text().s("an output that is the input is refused (case \{i\})").take()
        ng_case(name, cases[i], "is the input file")
        kept: = io.read_file(src, null) catch ""
        verdict.check(arena.text().s("the input is kept (case \{i\})").take(),
            kept.equals(text), kept)

fn case_later_output_unwritable(arena: Arena$@) //<
    //< An output written after the code that cannot be written fails the compile, and every older
    //< output stays
    //< **All outputs are renamed in place together, once the last is whole** (`Staged_outputs` in
    //< `ksplc/pipeline.kspl`). Otherwise the C would be new beside an older or cut deps, libs or
    //< interface file. A deps file that could not be written once passed in silence, with exit 0.
    dir: = harness.sandbox("cli_later_output")
    lib_src: = fs.join(dir, "lib.kspl", arena)
    io.write_file(lib_src, "extern fn twice(x: I32): I32\n  return x * 2\n") catch
        verdict.check("a later output: the source can be written", false, lib_src)
        return
    old: U8[] = "the older output\n"
    out_c: = fs.join(dir, "lib.c", arena)
    out_h: = fs.join(dir, "lib.h", arena)
    gone: = fs.join(dir, "no_such_folder", arena)
    deps: = arena.text().s("--emit-deps=").s(gone).s("/deps.txt").take()
    libs: = arena.text().s("--emit-libs=").s(gone).s("/libs.txt").take()
    iface_ok: = arena.text().s("--library=").s(out_h).take()
    iface_bad: = arena.text().s("--library=").s(gone).s("/lib.h").take()
    cases: = U8[][][]::{ U8[][]::{ std_flag(), deps, iface_ok, lib_src, out_c },
        U8[][]::{ std_flag(), libs, iface_ok, lib_src, out_c },
        U8[][]::{ std_flag(), iface_ok, iface_bad, lib_src, out_c } }
    whats: = U8[][]::{ "--emit-deps", "--emit-libs", "--library" }
    for i in Range.asc(cases.len)
        io.write_file(out_c, old) catch {}
        io.write_file(out_h, old) catch {}
        r: = cli(cases[i])
        kept: =
            (io.read_file(out_c, arena) catch "").equals(old) &&
            (io.read_file(out_h, arena) catch "").equals(old)
        verdict.check(arena.text()
            .s("\{whats[i]\} that cannot be written fails the compile and keeps the older outputs")
            .take(),
            !r.exited_with(0) && r.out.find_str("write_failed").is_some() && kept,
            arena.text().s("older outputs kept: \{kept\}\n").s(r.out).take())
    $left: = List<|U8[]|>(arena)
    names: = fs.read_dir(dir, arena) catch
        fallback List<|U8[]|>(arena)
    for n in names
        if n.find_str(".tmp").is_some()
            left.push(n)
    verdict.check("a later output that fails leaves no temporary file", left.len == 0,
        arena.text().s("left: \{left.len\}").take())

fn case_output_cut_short(arena: Arena$@) //<
    //< A write cut short fails the compile and leaves the older output, with no file left beside it
    //< **The output is written under a temporary name and renamed once whole** (`Staged_outputs`
    //< in `ksplc/pipeline.kspl`). Otherwise a full disk would leave an empty file newer than its
    //< source, which `make` takes as up to date, and the compile would exit 0.
    name: = "a write cut short fails the compile and keeps the older output"
    if sys.is_windows()
        verdict.skip_check(name, "a short write needs `ulimit -f`, which Windows does not have")
        return
    dir: = harness.sandbox("cli_output_cut_short")
    src: = fs.join(dir, "a.kspl", arena)
    io.write_file(src, "fn main(): I32\n  return 0\n") catch
        verdict.check(name, false, "the source cannot be written")
        return
    old: U8[] = "the older output\n"
    out_c: = fs.join(dir, "a.c", arena)
    out_ll: = fs.join(dir, "a.ll", arena)
    rt: = fs.join(dir, "rt.c", arena)
    split_h: = fs.join(dir, "s.h", arena)
    cases: = U8[][][]::{ U8[][]::{ std_flag(), src, out_c },
        U8[][]::{ std_flag(), "--to=llvm", src, out_ll },
        U8[][]::{ std_flag(), "--split=2", src, fs.join(dir, "s.c", arena) },
        U8[][]::{ "emit-runtime", rt } }
    kept_files: = U8[][]::{ out_c, out_ll, split_h, rt }
    for i in Range.asc(cases.len)
        io.write_file(kept_files[i], old) catch {}
        // One or two KiB (`ulimit -f` counts blocks of 512 or 1024 bytes), below every output.
        // With SIGXFSZ ignored, the write returns short instead of ending ksplc.
        $argv: = List<|U8[]|>(arena)
        argv.push("/bin/sh")
        argv.push("-c")
        argv.push("ulimit -f 2 && trap '' XFSZ && exec \"$0\" \"$@\"")
        argv.push(harness.ksplc_exe())
        argv.push_all(cases[i])
        r: = harness.run_in(argv.slice(), dir)
        kept: = (io.read_file(kept_files[i], arena) catch "").equals(old)
        verdict.check(arena.text().s("\{name\} (case \{i\})").take(),
            !r.exited_with(0) && r.out.find_str("write_failed").is_some() && kept,
            arena.text().s("older output kept: \{kept\}\n").s(r.out).take())
    $left: = List<|U8[]|>(arena)
    names: = fs.read_dir(dir, arena) catch
        fallback List<|U8[]|>(arena)
    for n in names
        if n.find_str(".tmp").is_some() || n.starts_with("s.0") || n.starts_with("s.1")
            left.push(n)
    verdict.check("a failed compile leaves no temporary or partial file", left.len == 0,
        arena.text().s("left: \{left.len\}").take())
    // Killed part way (SIGXFSZ's default), the compile leaves the older output as it was.
    io.write_file(out_c, old) catch {}
    k: = harness.run_in(U8[][]::{ "/bin/sh", "-c", "ulimit -f 2 && exec \"$0\" \"$@\"",
        harness.ksplc_exe(), std_flag(), src, out_c }, dir)
    verdict.check("a compile killed part way leaves the older output",
        !k.exited_with(0) && (io.read_file(out_c, arena) catch "").equals(old), k.out)
    // A device named as the output is written where it is, never replaced by a file.
    d: = cli(U8[][]::{ std_flag(), src, "/dev/null" })
    verdict.check("a device named as the output is written in place",
        d.exited_with(0) && fs.exists("/dev/null") && !fs.is_link("/dev/null"), d.out)

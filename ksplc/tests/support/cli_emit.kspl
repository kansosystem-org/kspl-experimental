//< The CLI's emitted-file checks and the command assertions they share with the suite
//<
//< The interfaces, API record and link-library list are read back from a sample directory.
//< The suite keeps command selection, help and diagnostics; both use the same status/text check.
import "ksplc/tests/support/harness"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

fn cli(args: U8[][]): verdict.Run_out //< it runs ksplc once
    //<
    //< Not `harness.ksplc`: a subcommand that does not accept `--std-dir=` rejects its call.
    return harness.ksplc_bare(args)

priv fn check_case(name: U8[], args: U8[][], expect: U8[], accepted: Bool) //<
    //< It checks the requested exit status and the text the command must produce
    r: = cli(args)
    if (r.code == 0) != accepted
        why: = "the exit code is not 0" if accepted else "it passed without being turned away"
        verdict.check(name, false,
            harness.arena().text().s(why).c('\n').s(r.out).take())
        return
    if expect.len > 0 && r.out.find_str(expect).is_none()
        verdict.check(name, false,
            harness.arena().text().s("\{expect\} does not come out\n\{r.out\}").take())
        return
    verdict.check(name, true, "")

fn ok_case(name: U8[], args: U8[][], expect: U8[]) //<
    //< It checks that the run passes (exit code 0) and what the output must contain
    check_case(name, args, expect, true)

fn ng_case(name: U8[], args: U8[][], expect: U8[]) //<
    //< It checks that the run is rejected (a non-zero exit code) and what the error must contain
    check_case(name, args, expect, false)

fn std_flag(): U8[] //< the option passing the standard library's directory
    //<
    //< **The working directory changes before the run, so a relative path would not resolve.**
    return harness.arena().text().s("--std-dir=\{harness.std_dir()\}").take()

priv fn lib_opt(path: U8[], arena: Arena$@): U8[] //< `--library=<path>`
    return arena.text().s("--library=").s(path).take()

fn case_library(arena: Arena$@) //<
    //< `--library=` builds a library and writes each interface it names, from one compile
    //<
    //< A value that names no form, or one path twice, is refused rather than written.
    dir: = harness.sandbox("cli_library")
    src: = fs.join(dir, "lib.kspl", arena)
    io.write_file(src, "#export\npub fn lib_twice(n: I32): I32\n  return n * 2\n") catch
        verdict.check("--library: the library can be written", false, "")
        return
    out_c: = fs.join(dir, "lib.c", arena)
    h: = fs.join(dir, "lib.h", arena)
    api: = fs.join(dir, "lib_api.kspl", arena)
    ok_case("--library= twice writes both interfaces from one compile",
        U8[][]::{ std_flag(), lib_opt(h, arena), lib_opt(api, arena), src, out_c }, "")
    verdict.check("both interfaces are written",
        fs.exists(h) && fs.exists(api) && fs.exists(out_c), dir)
    ng_case("--library needs the interface it writes",
        U8[][]::{ std_flag(), "--library", src, out_c }, "'--library=<value>'")
    ng_case("--library= refuses a name of neither form",
        U8[][]::{ std_flag(), lib_opt("x.txt", arena), src, out_c }, "names neither form")
    ng_case("--library= refuses one path named twice",
        U8[][]::{ std_flag(), lib_opt(h, arena), lib_opt(h, arena), src, out_c }, "is named twice")
    ng_case("--library refuses --program, since a library has no main()",
        U8[][]::{ std_flag(), "--program", lib_opt(h, arena), src, out_c },
        "--program cannot be combined")

fn case_surface_doc(arena: Arena$@) //<
    //< The record of the published API carries the documentation as a fourth column
    //<
    //< Caution: **Check both sides of the parting**, the opening paragraph and the detail; one
    //< alone lets the other be lost unnoticed. **Check the full stop between them too**: without it
    //< two fragments run into one broken sentence, and none is wanted where the summary ends in its
    //< own (`described` in `../../base/ast_doc.kspl`). **A `pub` C function is a row too**, keyed
    //< with its block's attributes; without it, what reaches every package goes unrecorded.
    dir: = fs.join(harness.tmp_dir(), "cli_surface", arena)
    fs.mkdir_all(dir) catch {}
    src: = fs.join(dir, "api.kspl", arena)
    tsv: = fs.join(dir, "api.tsv", arena)
    obj: = fs.join(dir, "api.c", arena)
    body: U8[] =
        """pub struct Row //< one row of the table
  //<
  //< What a row stands for, in a sentence.
  pub text: U8[] //< the text as the writer typed it


pub fn count(rows: Row[1]): Sz //< how many rows carry text
  //<
  //< Walks the table once and counts.
  return rows[0].text.len


pub fn named(rows: Row[1]): Sz //< it names the column as `text`
  //<
  //< A summary closing on a code span takes its stop behind the span.
  return rows[0].text.len


pub fn closed(rows: Row[1]): Sz //< it closes its own sentence.
  //<
  //< No second stop is put in behind it.
  return rows[0].text.len


#link("m")
extern "C"
  pub fn c_reached(x: I32): I32 //< reached from every package
  fn c_kept(): I32


fn main(): I32
  return 0

"""
    io.write_file(src, body) catch
        verdict.check("the record's documentation: the sample can be written", false, src)
        return
    r: = harness.run_in(U8[][]::{ harness.ksplc_exe(), std_flag(),
        arena.text().s("--emit-surface=").s(tsv).take(), src, obj }, dir)
    if r.code != 0
        verdict.check("the record's documentation: it is put out", false, r.out)
        return
    got: = io.read_file(tsv) catch ""
    wants: U8[][6] = ::{ "Row\tpub struct Row\tone row of the table. What a row stands for, in a \
        sentence.", "Row.text\tpub text: U8[]\tthe text as the writer typed it",
        "count\tpub fn count(rows: Row[1]): Sz\thow many rows carry text. Walks the table once and \
            counts.",
        "named\tpub fn named(rows: Row[1]): Sz\tit names the column as `text`. A summary closing on \
            a code span takes its stop behind the span.",
        "closed\tpub fn closed(rows: Row[1]): Sz\tit closes its own sentence. No second stop is put \
            in behind it.",
        "c_reached #link(\"m\")\tpub fn c_reached(x: I32): I32\treached from every package" }
    for want in wants
        verdict.check(arena.text().s("the record's documentation carries \"").s(want).s("\"").take(),
            got.find_str(want).is_some(), got)
    verdict.check("the record leaves out a C function that is not pub",
        got.find_str("c_kept").is_none(), got)

priv fn emitted_libs(dir: U8[], entry: U8[], flags: U8[][], arena: Arena$@): U8[] //<
    //< What `--emit-libs` wrote for the entry file, or `FAILED` and the output where it failed
    libs: = fs.join(dir, "out.libs", arena)
    fs.remove_path(libs) catch {}
    $argv: = List<|U8[]|>.new(arena)
    argv.push(harness.ksplc_exe())
    argv.push(std_flag())
    for f in flags
        argv.push(f)
    argv.push(arena.text().s("--emit-libs=").s(libs).take())
    argv.push(fs.join(dir, entry, arena))
    argv.push(fs.join(dir, "out.c", arena))
    r: = harness.run_in(argv.slice(), dir)
    if r.code != 0
        return arena.text().s("FAILED ").s(r.out).take()
    return harness.read_generated(libs)

fn case_emit_libs(arena: Arena$@) //<
    //< `--emit-libs` writes the libraries the kept `extern` blocks name (`#link`)
    //<
    //< **A file's names come before those of the files it imports** (a one-pass linker wants a
    //< library before the ones it uses), each once, at its first place; a block that `#cfg` dropped
    //< names nothing.
    //< Caution: **A failed compile leaves no file.** A build that reads a stale one links the
    //< libraries of a program that does not build.
    dir: = fs.join(harness.tmp_dir(), "cli_emit_libs", arena)
    fs.mkdir_all(dir) catch {}
    main_src: U8[] =
        """import "wrap"

#link("app") #link("shared")
extern "C"
  fn app_value(): I32


#cfg(extra) #link("extra")
extern "C"
  fn extra_value(): I32


fn main(): I32
  return wrap.value()

"""
    wrap_src: U8[] =
        """#link("wrapped") #link("shared")
extern "C"
  fn wrapped_value(): I32


pub fn value(): I32
  return 0

"""
    none_src: U8[] = """fn main(): I32
  return 0

"""
    bad_src: U8[] =
        """#link("app")
extern "C"
  fn app_value(): I32


fn main(): I32
  return app_value(1)

"""
    fs.write_tree(dir, U8[][]::{ "main.kspl", "wrap.kspl", "none.kspl", "bad.kspl" },
        U8[][]::{ main_src, wrap_src, none_src, bad_src }, harness.arena()) catch
        verdict.check("--emit-libs: the sample can be written", false, dir)
        return
    got: = emitted_libs(dir, "main.kspl", U8[][]::{}, arena)
    verdict.check("--emit-libs: a file's names before those of what it imports, each once",
        got.equals("-lapp -lshared -lwrapped\n"), got)
    flagged: = emitted_libs(dir, "main.kspl", U8[][]::{ "--define=extra" }, arena)
    verdict.check("--emit-libs: a block #cfg keeps names its library in its place",
        flagged.equals("-lapp -lshared -lextra -lwrapped\n"), flagged)
    none: = emitted_libs(dir, "none.kspl", U8[][]::{}, arena)
    verdict.check("--emit-libs: naming no library writes an empty line", none.equals("\n"), none)
    bad: = emitted_libs(dir, "bad.kspl", U8[][]::{}, arena)
    verdict.check("--emit-libs: a compile that fails writes no file",
        bad.starts_with("FAILED ") && !fs.exists(fs.join(dir, "out.libs", arena)), bad)

//< `--sanitize`: what it marks in LLVM IR, what it hands `build`'s C compiler, where it is refused
//<
//< Whether a marked program is really watched needs the sanitizers' runtimes, which only Linux's
//< image is sure to hold: `tests/suite/sanitize_test.kspl` runs one. Not a suite;
//< `../suite/cli_test.kspl` runs it.
import "ksplc/tests/support/harness"
import "std/chars"
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

priv fn refused(name: U8[], args: U8[][], says: U8[]) //<
    //< It checks that the compile is refused, and that the refusal says `says`
    r: = harness.ksplc(args)
    verdict.check(name, r.code != 0 && r.out.find_str(says).is_some(), r.out)

priv fn marked_count(ir: U8[], arena: Arena$@): Sz //< how many of the IR's `define`s carry a mark
    $n: Sz = 0
    for line in ir.lines(arena)
        if line.starts_with("define ") && line.find_str(" sanitize_").is_some()
            n += 1
    return n

priv fn define_count(ir: U8[], arena: Arena$@): Sz //< how many functions the IR defines
    $n: Sz = 0
    for line in ir.lines(arena)
        if line.starts_with("define ")
            n += 1
    return n

fn case_sanitize(arena: Arena$@) //<
    //< `--sanitize` marks every function `--to=llvm` writes, and is refused where it cannot act
    //<
    //< **Every `define`, the hand-written ones included** (`main`, the run-time checks): clang's
    //< `-fsanitize=` passes over an unmarked one.
    dir: = harness.sandbox("cli_sanitize")
    src: = fs.join(dir, "prog.kspl", arena)
    io.write_file(src,
        "fn twice(n: I32): I32\n  return n * 2\n\nfn main(): I32\n  return twice(3)\n") catch
        verdict.check("--sanitize: the program can be written", false, "")
        return
    ll: = fs.join(dir, "prog.ll", arena)
    made: = harness.ksplc(U8[][]::{ "--to=llvm", "--sanitize=address", src, ll })
    ir: = harness.read_generated(ll)
    all: = define_count(ir, arena)
    verdict.check("--sanitize=address marks every function --to=llvm writes `sanitize_address`",
        made.code == 0 && all > 2 && marked_count(ir, arena) == all &&
        ir.find_str(") sanitize_address {").is_some(), made.out)
    plain: = harness.ksplc(U8[][]::{ "--to=llvm", src, ll })
    verdict.check("without --sanitize, no function is marked",
        plain.code == 0 && marked_count(harness.read_generated(ll), arena) == 0, plain.out)
    c: = fs.join(dir, "prog.c", arena)
    refused("--sanitize is refused on C, which its C compiler marks",
        U8[][]::{ "--sanitize=address", src, c }, "give that compiler -fsanitize=")
    refused("--sanitize=undefined is refused on LLVM IR, whose checks are clang's front end's",
        U8[][]::{ "--to=llvm", "--sanitize=undefined", src, ll }, "LLVM IR does not pass through")
    refused("--sanitize refuses a name it does not know",
        U8[][]::{ "--to=llvm", "--sanitize=address,adress", src, ll }, "'adress' is not a sanitizer")
    refused("--sanitize is refused beside --freestanding",
        U8[][]::{ "--to=llvm", "--freestanding", "--sanitize=address", src, ll },
        "--freestanding cannot be combined")
    exe: = fs.join(dir, "prog.exe", arena)
    refused("build refuses -fsanitize= in --cflags, which --sanitize hands over",
        U8[][]::{ "build", "--cflags=-O1 -fsanitize=address", src, exe }, "--sanitize=<names>")
    // **A pair every C compiler refuses** shows the word reached it, on any platform: one it
    // accepted would need the sanitizer's runtime there.
    refused("build hands --sanitize to the C compiler as -fsanitize=",
        U8[][]::{ "build", "--sanitize=thread,memory", src, exe }, "the C compiler failed")

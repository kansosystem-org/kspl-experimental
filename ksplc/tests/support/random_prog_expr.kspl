//< The expressions of the programs `random_prog.kspl` writes, and the state they are written from
//< Each function returns the text of an expression of exactly the type it is asked for. Every
//< operation is one the language accepts on that type, and a stop the language defines is never
//< written by chance: a divisor is made odd, a shift amount masked, an index taken modulo its
//< length.
import "std/ds" { List }
import "std/mem" { Arena }
import "std/prng" { Prng }
import "std/str" { Str }

// ==========================================
// Types: the eight integers, `Bool` and `Sz`, by their index into `NAMES`
// ==========================================

const NAMES: U8[][_] = ::{ "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "Bool", "Sz" }
const BITS: Sz[_] = ::{ 8, 16, 32, 64, 8, 16, 32, 64, 1, 64 }
const INTS: Sz = 8 //< how many integer types come first in `NAMES`
const BOOL: Sz = 8
const SZ: Sz = 9
const ENUM_TY: Sz = 100 //< a value of the k-th enum has the type `ENUM_TY + k`
const NONE: Sz = 1000 //< no struct parameter

const COST_CAP: Sz = 3000 //< about how many statements one function may run

const ARITH: U8[][_] = ::{ "+", "-", "*" }
const BITWISE: U8[][_] = ::{ "&", "|", "^" }
const COMPARE: U8[][_] = ::{ "==", "!=", "<", "<=", ">", ">=" }
const BOOL_OPS: U8[][_] = ::{ "==", "!=", "&", "|", "^" }

// ==========================================
// What a program holds so far
// ==========================================

struct Var //< a value a statement can read, and maybe write
    text: U8[] //< how it is written: a name, a field (`s2.f1`) or a parameter
    ty: Sz //< an index into `NAMES`, or `ENUM_TY` + an enum's index
    place: Bool //< it can be written
    bare: Bool //< a local's own name, which a closure can capture

struct Arr //< an array or a slice a statement can index
    text: U8[]
    ty: Sz
    len: Sz
    place: Bool //< its elements can be written

struct Svar //< a struct value a call can be handed
    text: U8[]
    shape: Sz
    place: Bool //< it can be handed as a `$@` pointer
    ptr: Bool //< it is a `$@` parameter already

struct Func //< a function written so far, which a later one can call
    name: U8[]
    params: List<|Sz|>
    st: Sz //< the struct its last parameter is, or `NONE`
    by_ptr: Bool //< that parameter is a `$@` pointer
    ret: Sz
    cost: Sz //< about how many statements one call runs

struct Shape //< a struct type: its integer fields `f0`…, then one array field `fa`
    fields: List<|Sz|>
    arr_ty: Sz
    arr_len: Sz

struct En //< an enum over an integer base, its tags written out
    base: Sz
    tags: List<|I64|>

struct Gen //< the generator's whole state
    rng: Prng
    arena: Arena$@
    out: Str //< the function being written
    indent: Sz
    next: Sz //< the last number a fresh name took
    vars: List<|Var|>
    arrs: List<|Arr|>
    svars: List<|Svar|>
    fns: List<|Func|>
    shapes: List<|Shape|>
    ens: List<|En|>
    mult: Sz //< how many passes the loops around the current statement make
    cost: Sz //< the current function's cost so far
    loops: Sz //< how many loops stand around the current statement
    in_closure: Bool
    open: Bool //< it also writes the shapes of `OPEN_FINDINGS`

// ==========================================
// Small helpers
// ==========================================

fn signed(type_index: Sz): Bool
    return type_index < 4 || type_index == SZ

fn widens(from: Sz, to: Sz): Bool //< whether a `from` converts to a `to` with no cast
    if from >= INTS || to >= INTS || BITS[to] <= BITS[from]
        return false
    return signed(to) || !signed(from)

fn mask(type_index: Sz): U64 //< every bit the type holds
    if BITS[type_index] >= 64
        return 0xFFFFFFFFFFFFFFFFU64
    return (1U64 << U64::BITS[type_index]) - 1U64

fn line(gen: Gen$@, text: U8[]) //< one line of the function, at the current indent
    for _i in Range.asc(gen.indent)
        gen.out.s("    ")
    gen.out.s(text).c('\n')

fn fresh(gen: Gen$@, prefix: U8[]): U8[] //< a name no other declaration takes
    gen.next += 1
    return gen.arena.text().s(prefix).s("\{gen.next\}").take()

fn paren(gen: Gen$@, left: U8[], op: U8[], right: U8[]): U8[] //< `(left op right)`
    return gen.arena.text().s("(").s(left).s(" ").s(op).s(" ").s(right).s(")").take()

fn int_ty(gen: Gen$@): Sz
    return gen.rng.below(INTS)

fn narrow_or_same(gen: Gen$@, type_index: Sz): Sz //<
    //< `type_index`, or now and then a type that widens to it
    if type_index >= INTS || gen.rng.chance(60)
        return type_index
    $c: = List<|Sz|>(gen.arena)
    for s in Range.asc(INTS)
        if widens(s, type_index)
            c.push(s)
    if c.len == 0
        return type_index
    return c.get(gen.rng.below(c.len))

fn lowest(type_index: Sz): I64 //< the type's smallest value
    if !signed(type_index)
        return 0I64
    return 0I64 - I64::(mask(type_index) >> 1U64) - 1I64

fn highest(type_index: Sz): I64 //< the type's largest value, `I64`'s for `U64`
    if signed(type_index) || BITS[type_index] >= 64
        return I64::(mask(type_index) >> 1U64)
    return I64::mask(type_index)

// ==========================================
// Literals
// ==========================================

fn raw_value(gen: Gen$@, type_index: Sz): U64 //< a value's bits, an edge value now and then
    m: = mask(type_index)
    top: = (m >> 1U64) + 1U64
    switch gen.rng.below(9)
    case 0
        return 0U64
    case 1
        return 1U64
    case 2
        return m
    case 3
        return m >> 1U64
    case 4
        return top
    case 5
        return U64::gen.rng.below(20)
    case 6
        return (top + 1U64) & m
    default
        return gen.rng.next_u64() & m

fn lit_text(gen: Gen$@, type_index: Sz, value: U64): U8[] //<
    //< the bits `value` as a literal of `type_index`
    if type_index == BOOL
        return "true" if (value & 1U64) != 0U64 else "false"
    m: = mask(type_index)
    if signed(type_index) && (value & ((m >> 1U64) + 1U64)) != 0U64
        mag: = (0U64 - value) & m
        return gen.arena.text().s("(-\{mag\}").s(NAMES[type_index]).s(")").take()
    return gen.arena.text().s("\{value & m\}").s(NAMES[type_index]).take()

fn lit(gen: Gen$@, type_index: Sz): U8[] //< a literal of `type_index`
    if type_index == SZ
        return gen.arena.text().s("\{gen.rng.below(50)\}Sz").take()
    return lit_text(gen, type_index, raw_value(gen, type_index))

fn i64_lit(gen: Gen$@, type_index: Sz, value: I64): U8[] //<
    //< the number `value` as a literal of `type_index`
    return lit_text(gen, type_index, U64::value)

// ==========================================
// Expressions: each returns text of exactly the type asked for
// ==========================================

fn leaf(gen: Gen$@, type_index: Sz): U8[] //< a variable of type `type_index`, or a literal
    if !gen.rng.chance(25)
        $n: Sz = 0
        for v in gen.vars
            if v.ty == type_index
                n += 1
        if n > 0
            $k: = gen.rng.below(n)
            for v in gen.vars
                if v.ty == type_index
                    if k == 0
                        return v.text
                    k -= 1
    return lit(gen, type_index)

fn hidden(gen: Gen$@, type_index: Sz, operand: U8[]): U8[] //<
    //< `operand` passed through `gid`, whose value C cannot see
    return gen.arena.text().s("gid<|").s(NAMES[type_index]).s("|>(").s(operand).s(")").take()

fn test(gen: Gen$@, depth: Sz): U8[] //<
    //< A statement's condition, passed through `gid` so ksplc cannot work out its value
    //< A constant one (`if true` before `continue`) leaves code after it that never runs, and
    //< ksplc rightly reports that ([W0201]). A comparison inside it stays open to the C compiler.
    return hidden(gen, BOOL, expr(gen, BOOL, depth))

fn expr(gen: Gen$@, type_index: Sz, depth: Sz): U8[] //< an expression of type `type_index`
    if type_index == BOOL
        return cond(gen, depth)
    if type_index == SZ || depth == 0 || gen.rng.chance(20)
        return leaf(gen, type_index)
    d: = depth - 1
    a: = gen.arena
    switch gen.rng.below(17)
    case 0, 1, 2
        return binary(gen, type_index, ARITH[gen.rng.below(3)], d)
    case 3, 4
        return binary(gen, type_index, BITWISE[gen.rng.below(3)], d)
    case 5
        return divide(gen, type_index, d)
    case 6
        return shift(gen, type_index, d)
    case 7
        s: = gen.rng.below(SZ + 1)
        return a.text().s(NAMES[type_index]).s("::(").s(expr(gen, s, d)).s(")").take()
    case 8
        e: = expr(gen, type_index, d)
        if signed(type_index) && gen.rng.chance(50)
            return a.text().s("-(").s(e).s(")").take()
        return a.text().s("~(").s(e).s(")").take()
    case 9
        x: = expr(gen, type_index, d)
        c: = cond(gen, d)
        y: = expr(gen, type_index, d)
        return a.text().s("(").s(x).s(" if ").s(c).s(" else ").s(y).s(")").take()
    case 10, 11
        return call(gen, type_index, d)
    case 12, 13
        return generic(gen, type_index, d)
    case 14
        return element(gen, type_index, d)
    case 15
        return from_enum(gen, type_index)
    default
        return leaf(gen, type_index)

fn binary(gen: Gen$@, type_index: Sz, op: U8[], depth: Sz): U8[] //<
    //< `a op b`, b maybe of a narrower type
    a: = expr(gen, type_index, depth)
    b: = other_side(gen, narrow_or_same(gen, type_index), depth, a, op)
    if gen.rng.chance(50)
        return paren(gen, b, op, a)
    return paren(gen, a, op, b)

fn constant(operand: U8[]): Bool //< whether an operand is a literal or a constant's name
    if operand.len == 0
        return false
    return operand[0] == 'K' || (operand[0] >= '0' && operand[0] <= '9') ||
        (operand.len > 2 && operand[0] == '(' && operand[1] == '-' && operand[2] >= '0' &&
        operand[2] <= '9')

fn other_side(gen: Gen$@, type_index: Sz, depth: Sz, left: U8[], op: U8[]): U8[] //<
    //< The second operand of `left op …`, written differently from the first
    //< `x - x` or `x & x` is the program's own slip: a person writes 0 or x. Two constants are
    //< kept apart but under `^`: their value can wrap, the open finding `WRAPPED_CONSTANT`.
    $b: = expr(gen, type_index, depth)
    if gen.open
        return b
    for _try in Range.asc(3)
        if !b.equals(left) && (op.equals("^") || !(constant(left) && constant(b)))
            return b
        b = expr(gen, type_index, depth)
    return hidden(gen, type_index, b)

fn divide(gen: Gen$@, type_index: Sz, depth: Sz): U8[] //< `/` or `%`, the divisor made odd
    a: = expr(gen, type_index, depth)
    s: = narrow_or_same(gen, type_index)
    b: = paren(gen, expr(gen, s, depth), "|", lit_text(gen, s, 1U64))
    return paren(gen, a, "/" if gen.rng.chance(50) else "%", b)

fn shift(gen: Gen$@, type_index: Sz, depth: Sz): U8[] //< `<<` or `>>`, the amount masked into range
    $a: = expr(gen, type_index, depth)
    if !gen.open && a[0] == 'K'
        a = hidden(gen, type_index, a)
    s: = int_ty(gen)
    amt: =
        paren(gen, expr(gen, s, depth), "&",
        lit_text(gen, s, U64::(BITS[type_index] - 1)))
    return paren(gen, a, "<<" if gen.rng.chance(50) else ">>", amt)

fn cond(gen: Gen$@, depth: Sz): U8[] //< an expression of type `Bool`
    if depth == 0 || gen.rng.chance(20)
        return leaf(gen, BOOL)
    d: = depth - 1
    a: = gen.arena
    switch gen.rng.below(8)
    case 0, 1, 2
        t: = int_ty(gen)
        x: = expr(gen, t, d)
        return paren(gen, x, COMPARE[gen.rng.below(6)], expr(gen, t, d))
    case 3, 4
        x: = cond(gen, d)
        return paren(gen, x, "&&" if gen.rng.chance(50) else "||", cond(gen, d))
    case 5
        return a.text().s("!(").s(cond(gen, d)).s(")").take()
    case 6
        x: = expr(gen, BOOL, d)
        return paren(gen, x, BOOL_OPS[gen.rng.below(5)], expr(gen, BOOL, d))
    default
        return leaf(gen, BOOL)

fn call(gen: Gen$@, type_index: Sz, depth: Sz): U8[] //<
    //< a call of an earlier function that returns `type_index`
    $cands: = List<|Sz|>(gen.arena)
    for i in Range.asc(gen.fns.len)
        f: = gen.fns.get(i)
        if f.ret == type_index && gen.cost + gen.mult * f.cost <= COST_CAP &&
            struct_arg(gen, f@, false).len > 0
            cands.push(i)
    if cands.len == 0
        return leaf(gen, type_index)
    f: = gen.fns.get(cands.get(gen.rng.below(cands.len)))
    gen.cost += gen.mult * f.cost
    b: = gen.arena.text().s(f.name).s("(")
    for i in Range.asc(f.params.len)
        p: = f.params.get(i)
        b.s(", " if i > 0 else "").s(expr(gen, narrow_or_same(gen, p), depth))
    if f.st != NONE
        b.s(", " if f.params.len > 0 else "").s(struct_arg(gen, f@, true))
    return b.s(")").take()

fn struct_arg(gen: Gen$@, func: Func@, draw: Bool): U8[] //<
    //< What a call hands f's struct parameter, empty where nothing fits
    //< Without draw it answers only whether something fits ("-" for a function with no such
    //< parameter), and draws nothing.
    if func.st == NONE
        return "-"
    $cands: = List<|Svar|>(gen.arena)
    for s in gen.svars
        if s.shape == func.st && (s.place || s.ptr || !func.by_ptr)
            cands.push(s)
    if cands.len == 0
        return ""
    if !draw
        return "-"
    s: = cands.get(gen.rng.below(cands.len))
    if func.by_ptr
        return s.text if s.ptr else gen.arena.text().s(s.text).s("@").take()
    return gen.arena.text().s(s.text).s("$").take() if s.ptr else s.text

fn generic(gen: Gen$@, type_index: Sz, depth: Sz): U8[] //<
    //< a call of one of the prelude's generics at `type_index`
    a: = gen.arena
    ty: = NAMES[type_index]
    switch gen.rng.below(7)
    case 0
        x: = expr(gen, type_index, depth)
        return a.text().s("gmix<|").s(ty).s("|>(").s(x).s(", ").s(expr(gen, type_index, depth))
            .s(")").take()
    case 1
        x: = expr(gen, type_index, depth)
        return a.text().s("gap<|").s(ty).s("|>(gmix<|").s(ty).s("|>, ").s(x).s(", ")
            .s(expr(gen, type_index, depth)).s(")").take()
    case 2
        c: = cond(gen, depth)
        x: = expr(gen, type_index, depth)
        return a.text().s("gsel<|").s(ty).s("|>(").s(c).s(", ").s(x).s(", ")
            .s(expr(gen, type_index, depth)).s(")").take()
    case 3
        x: = expr(gen, type_index, depth)
        c: = cond(gen, depth)
        return a.text().s("(gmay<|").s(ty).s("|>(").s(x).s(", ").s(c).s(") catch ")
            .s(lit(gen, type_index)).s(")").take()
    case 4
        return closure(gen, type_index, depth)
    case 5
        x: = expr(gen, type_index, depth)
        return a.text().s("gsh<|").s(ty).s("|>(").s(x).s(", ").s(expr(gen, 4, depth)).s(")").take()
    default
        for r in gen.arrs
            if r.ty == type_index && gen.rng.chance(50)
                return a.text().s("gsum<|").s(ty).s("|>(").s(ty).s("[]::").s(r.text).s(")").take()
        return leaf(gen, type_index)

fn closure(gen: Gen$@, type_index: Sz, depth: Sz): U8[] //<
    //< a closure over up to two locals, called once
    if gen.in_closure
        return leaf(gen, type_index)
    a: = gen.arena
    ty: = NAMES[type_index]
    x: = fresh(gen, "cx")
    $caps: = List<|Var|>(a)
    for v in gen.vars
        if v.bare && caps.len < 2 && v.ty <= SZ && gen.rng.chance(40)
            caps.push(v)
    $inner: = List<|Var|>(a)
    inner.push(Var::{ .text = x, .ty = type_index, .place = false, .bare = false })
    for c in caps
        inner.push(Var::{ .text = c.text, .ty = c.ty, .place = false, .bare = false })
    outer_vars: = gen.vars
    outer_arrs: = gen.arrs
    outer_svars: = gen.svars
    gen.vars = inner
    gen.arrs = List<|Arr|>(a)
    gen.svars = List<|Svar|>(a)
    gen.in_closure = true
    $body: = expr(gen, type_index, 2 if depth > 2 else depth)
    // Every parameter and capture is read, so none goes unread.
    for v in inner
        body =
            paren(gen, body, "^",
            a.text().s(ty).s("::(").s(v.text).s(")").take())
    gen.in_closure = false
    gen.vars = outer_vars
    gen.arrs = outer_arrs
    gen.svars = outer_svars
    b: = a.text().s("gvia<|").s(ty).s("|>(fn(").s(x).s(": ").s(ty).s("; ")
    for i in Range.asc(caps.len)
        c: = caps.get(i)
        b.s(", " if i > 0 else "").s(c.text).s(": ").s(NAMES[c.ty])
    b.s("): ").s(ty).s(" { return ").s(body).s("; }, ").s(expr(gen, type_index, depth)).s(")")
    return b.take()

fn index(gen: Gen$@, len: Sz, depth: Sz): U8[] //< an index below len
    if gen.rng.chance(30)
        return gen.arena.text().s("\{gen.rng.below(len)\}").take()
    s: = int_ty(gen)
    return gen.arena.text().s("Sz::(U32::(").s(expr(gen, s, depth)).s(") % \{len\}U32)").take()

fn element(gen: Gen$@, type_index: Sz, depth: Sz): U8[] //<
    //< an element of an array or a slice of `type_index`
    $cands: = List<|Arr|>(gen.arena)
    for r in gen.arrs
        if r.ty == type_index
            cands.push(r)
    if cands.len == 0
        return leaf(gen, type_index)
    r: = cands.get(gen.rng.below(cands.len))
    return gen.arena.text().s(r.text).s("[").s(index(gen, r.len, depth)).s("]").take()

fn from_enum(gen: Gen$@, type_index: Sz): U8[] //< an enum value cast to `type_index`
    $cands: = List<|U8[]|>(gen.arena)
    for v in gen.vars
        if v.ty >= ENUM_TY
            cands.push(v.text)
    if cands.len == 0
        return leaf(gen, type_index)
    return gen.arena.text().s(NAMES[type_index]).s("::(")
        .s(cands.get(gen.rng.below(cands.len))).s(")").take()

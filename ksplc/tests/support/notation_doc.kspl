//< Whether a declaration's documentation is read from the indentation notation
//<
//< It is not the suite but a part of `../suite/notation_test.kspl`.
//<
//< The round trip in `../suite/notation_test.kspl` checks where the marks sit. **This file checks
//< whether ksplc then reads them as documentation**, by asking the editor, the reader of
//< `../../base/ast_doc.kspl` that a person sees.
import "ksplc/tests/support/jsonrpc_client"
import "ksplc/tests/support/lsp_client"
import "std/chars"
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

priv const PROBE_URI: U8[] = "file:///doc_probe.kspl"
priv const WAIT_MS: I32 = 15000

// One declaration carrying every mark: its summary, one on a parameter's line, that parameter's
// continuation, and the detail after the parting. **The head wraps, so its run starts on the line
// where the head ends** ("The documentation a declaration carries" in
// `../../../docs/DESIGN-notation.md`).
priv const PROBE_SRC: U8[] =
    """priv fn twice(
  n: I32, //< the number doubled
  //< A negative is doubled just the same, and nothing is clamped.
): I32 //<
  //< twice what it is given
  //<
  //< Doubling is a multiply by two, and nothing more.
  return n * 2

fn main(): I32
  return twice(21)
"""

priv const CALL_LINE: Sz = 10 //< the line and column of `twice`'s call (0-based)
    //<
    //< It is the `return twice(21)` line of `PROBE_SRC`.
priv const CALL_COL: Sz = 9

fn run(c: jsonrpc_client.Client$@, arena: Arena$@) //<
    //< It checks a hover on the call of twice carries every part of its documentation
    //<
    //< Caution: **Check all four.** Separate steps read them (`decl_summary`, `param_docs`,
    //< `summary_run` and `run_at` in `../../base/ast_doc.kspl`), and one going silent shows
    //< nowhere else.
    c.notify("textDocument/didOpen", lsp_client.did_open(PROBE_URI, PROBE_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    got: = lsp_client.answer(c, "textDocument/hover",
        lsp_client.at_pos(PROBE_URI, CALL_LINE, CALL_COL, arena), WAIT_MS, arena)
    t: = got.get("result").get("contents").get("value").as_str().unwrap_or("")
    verdict.check("a hover carries the doc comment written in the indentation notation",
        t.find_str("twice what it is given").is_some() &&
        t.find_str("the number doubled").is_some() &&
        t.find_str("nothing is clamped").is_some() &&
        t.find_str("Doubling is a multiply by two").is_some(),
        arena.text().s("returned=").s(lsp_client.dump(got, arena)).take())

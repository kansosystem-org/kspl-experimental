//< Conditions whose answer a constant decides
//<
//< All of them are often "not what the writer meant". `n / 0` cannot be placed here. A division by
//< zero is not a lint but a no-code error (docs/SPEC-language.md 4.2).
//< tests/negative/divide_by_zero.kspls looks at it.
// EXPECT: [W0201] Unreachable code detected
// EXPECT: [W0205] Loop with 'true' condition
// EXPECT: [W0101] Array index out of bounds
import "std/io"

pub fn after_return(n: I32): I32
  return n
  return 0

pub fn always_true() //<
  //< A `for true` loop in a function that returns no value
  //<
  //< No analysis reads `for true` as a loop that never leaves. With a return value it becomes a
  //< different error ("there is a road that does not return"), which never reaches this
  //< diagnostic.
  for true
    return

pub fn indexes(): I32
  a: I32[3] = ::{ 1, 2, 3 }
  return a[5]

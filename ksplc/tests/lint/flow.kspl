//< Flow and values: endless loops, unused results, comparisons
//< Each case below is compiled alone, as the file its head names.
// ==== case endless_for
//< What follows a `for` that never ends is unreachable
//< A `for` with no condition that no `break` leaves never hands control on ("Loops" in
//< `../../../docs/SPEC-programming-language.md`). So the statement after it gets [W0201], and the function
//< needs no `return` there. An inner loop's `break` leaves only the inner loop.
// EXPECT: [W0201] Unreachable code detected
// EXPECT-NOT: control may reach the end
import "std/io"

pub fn spin(): I32
  $i: I32 = 0
  for
    for
      break
    i += 1
  io.out().s("after\n")
  return i
// ==== case after_noreturn_call
//< What follows a call to a `#noreturn` function is unreachable
//< `sys.exit` never hands control back, so the statement after it gets [W0201]. The function needs
//< no `return` after it, and a `catch` block ending in one needs no `fallback`.
// EXPECT: [W0201] Unreachable code detected
// EXPECT: after_noreturn_call.kspl:16:
import "std/io"
import "std/sys"

priv fn read_or_stop(path: U8[]): Sz
  text: = io.read_file(path, null) catch
    sys.exit(1)
  return text.len

priv fn stops(): I32
  sys.exit(2)
  return 0

fn main(): I32
  return I32::read_or_stop("x") + stops()
// ==== case noreturn_call_ends_a_function
//< A function returning a value may end in a `#noreturn` call, with nothing after it
// EXPECT-NOT: [W0201]
// EXPECT-NOT: error:
import "std/sys"

priv fn pick(n: I32): I32
  if n > 0
    return n
  sys.exit(3)

fn main(): I32
  return pick(1)
// ==== case labelled_branch_left_by_break
//< What follows a labelled `switch` or `if` that a `break` leaves is reachable
//< **A `break` to the label carries control past the statement**, so the code after it runs
//< though every branch ends in a `return`. The missing-return check already reads it so. Read as
//< unreachable, the `return` after each would be reported, and the variable it reads as unused.
// EXPECT-NOT: [W0201]
// EXPECT-NOT: [W0207]
pub fn arm_of(e: I32): I32
  ui: switch e
  case 1
    return 10
  case 2, 3
    if e == 3
      break ui
    return 20
  default
    return 30
  return 40

pub fn branch_of(e: I32): I32
  $n: = 0
  ui: if e > 0
    if e > 5
      break ui
    return 1
  else
    return 2
  n += 3
  return n
// ==== case len_of_an_array_field
//< A struct read only through its array field's `.len` gets the same note as an array does
//< **The note named only a variable that is itself an array.** So `b.v.len` on a struct whose `v`
//< is a fixed (or const-generic) array said "nothing reads" with no reason (`holds_fixed_array` in
//< `ksplc/sema/flow/report.kspl`).
// EXPECT: [W0207] Nothing reads local variable or parameter 'b'. Prefix with '_' to ignore. Note: a fixed array's '.len' folds at compile time
import "std/io"

struct Ring<|const N: Sz|>
  v: I32[N]

fn main()
  b: Ring<|3|> = ::{}
  io.out().s("\{b.v.len\}\n")
// ==== case meaningless_compare_float
//< [W0204] does not cover floating point
//< Under IEEE 754 a NaN is equal to no value at all. So `f != f` is the one spelling that asks "is
//< f a NaN", and it is not always false. On the integer side it must come out as before (these two
//< items are pinned down in one file).
// EXPECT: meaningless_compare_float.kspl:12:
// EXPECT: [W0204] Meaningless comparison: both sides are the same expression, so it is always true.
// EXPECT-NOT: meaningless_compare_float.kspl:11:
fn main(): I32
  f: F64 = 0.0 / 1.0
  n: I32 = 3
  is_nan: = f != f
  same: = n == n
  return 1 if is_nan && same else 0
// ==== case fixed_by_place
//< One place on both sides: a field, a pointer, a `Bool`, and an assignment back to it
//< `b |= b` and `b &= b` give `b` back, as `b = b` does.
// EXPECT: fixed_by_place.kspl:14:
// EXPECT: fixed_by_place.kspl:15:
// EXPECT: fixed_by_place.kspl:16:
// EXPECT: [W0204] Meaningless comparison: both sides are the same expression, so it is always false.
// EXPECT: fixed_by_place.kspl:17:3: warning: [W0203] Meaningless self-assignment
// EXPECT: fixed_by_place.kspl:18:3: warning: [W0203] Meaningless self-assignment
struct Pt
  n: U8
  on: Bool

pub fn same(p: Pt$@, q: I32@): Bool
  a: = p.n < p.n
  b: = q != q
  c: = p.on == p.on
  p.n = p.n
  p.on |= p.on
  return a || b || c
// ==== case fixed_by_negation
//< A `Bool` joined with its own negation, in either order
// EXPECT: [W0204] Meaningless comparison: one side is the other's negation, so it is always true.
// EXPECT: [W0204] Meaningless comparison: one side is the other's negation, so it is always false.
pub fn both(b: Bool): Bool
  always: = b || !b
  never: = !b && b
  return always && !never
// ==== case fixed_by_range
//< A number outside, or at the edge of, what the other side can hold
//< The range is the type's, the value's under a widening cast, or a mask's (`&` keeps 0 to 1).
// EXPECT: fixed_by_range.kspl:11:8: warning: [W0204] Meaningless comparison: one side is a 'U32', which holds only 0 to 4294967295, so it is always true.
// EXPECT: fixed_by_range.kspl:12:
// EXPECT: fixed_by_range.kspl:13:8: warning: [W0204] Meaningless comparison: one side is a 'I8', which holds only -128 to 127, so it is always false.
// EXPECT: fixed_by_range.kspl:14:
// EXPECT: fixed_by_range.kspl:15:8: warning: [W0204] Meaningless comparison: one side is a 'U8', which holds only 0 to 255, so it is always false.
// EXPECT: fixed_by_range.kspl:16:
// EXPECT: [W0204] Meaningless comparison: the '&' or '|' on one side rules out the constant on the other, so it is always false.
pub fn ranges(u: U32, x: I8, b: U8): I32
  a: = u >= 0U32
  c: = u < 0U32
  d: = x < -128I8
  e: = b <= 255U8
  f: = I32::(b) < 0
  g: = (u & 1U32) == 2U32
  return I32::a + I32::c + I32::d + I32::e + I32::f + I32::g
// ==== case fixed_elsewhere
//< An answer fixed by what is set elsewhere is no slip, and is not reported
//< A type argument (`T` as `U32`), a named constant a build sets, two constants, and `Sz`, whose
//< width differs per target. A float compared with itself asks whether it is a NaN.
// EXPECT-NOT: [W0204]
const LIMIT: U32 = 0

fn nonneg<|T|>(x: T): Bool
  return x >= 0

pub fn elsewhere(u: U32, n: Sz): Bool
  a: = u >= LIMIT
  b: = 0U32 > LIMIT
  c: = n <= 2147483647
  return a || b || c || nonneg<|U32|>(u) || nonneg<|I32|>(-1)
// ==== case fixed_by_overlap
//< Two tests of one value against numbers, joined by `&&` or `||`, whose answer together is fixed
//< No value passes both `3 <= x` and `1 > x`, and every value passes `x < 3` or `x > 1`. `Sz` is
//< read at its widest. A test whose answer is fixed alone is reported alone (`b >= 0U8`).
// EXPECT: fixed_by_overlap.kspl:13:8: warning: [W0204] Meaningless comparison: no value the tested side can hold passes both tests, so it is always false.
// EXPECT: fixed_by_overlap.kspl:14:8: warning: [W0204] Meaningless comparison: every value the tested side can hold passes one of the two tests, so it is always true.
// EXPECT: fixed_by_overlap.kspl:15:8: warning: [W0204] Meaningless comparison: no value
// EXPECT: fixed_by_overlap.kspl:16:8: warning: [W0204] Meaningless comparison: every value
// EXPECT: fixed_by_overlap.kspl:17:8: warning: [W0204] Meaningless comparison: every value
// EXPECT: fixed_by_overlap.kspl:18:8: warning: [W0204] Meaningless comparison: every value
// EXPECT: fixed_by_overlap.kspl:19:8: warning: [W0204] Meaningless comparison: one side is a 'U8'
// EXPECT-NOT: fixed_by_overlap.kspl:19:8: warning: [W0204] Meaningless comparison: every value
pub fn overlap(x: I32, b: U8, n: Sz): Bool
  a: = 3 <= x && 1 > x
  c: = x < 3 || x > 1
  d: = x == 1 && x == 2
  e: = x != 1 || x != 2
  f: = b <= 200U8 || b > 100U8
  g: = n < 3 || n > 1
  h: = b >= 0U8 || b < 3U8
  return a || c || d || e || f || g || h
// ==== case overlap_elsewhere
//< Two tests of one value whose answer depends on the value, or is fixed by what is set elsewhere
//< `x > 1 && x < 3` holds for 2 alone. A named constant and a type argument are set elsewhere,
//< and two values are two tests.
// EXPECT-NOT: [W0204]
const LOW: I32 = 3

fn either<|T|>(x: T): Bool
  return x < 3 || x > 1

pub fn depends(x: I32, y: I32): Bool
  a: = x > 1 && x < 3
  b: = x < 3 || x > 5
  c: = x < LOW || x > 1
  d: = x < 3 || y > 1
  return a || b || c || d || either<|I32|>(x)
// ==== case xor_of_numbers
//< `^` between two numbers written in decimal, the left one 2 or 10: a power was likely meant
//< `10 ^ 2` is 8, not 100. A number in hexadecimal, a name, a variable, or another number on the
//< left says that exclusive or was meant, and is not reported.
// EXPECT: xor_of_numbers.kspl:14:8: warning: [W0215] '^' is exclusive or, not a power: here it gives 8.
// EXPECT: xor_of_numbers.kspl:15:8: warning: [W0215] '^' is exclusive or, not a power: here it gives 10.
// EXPECT: xor_of_numbers.kspl:16:8: warning: [W0215] '^' is exclusive or, not a power: here it gives -12.
// EXPECT-NOT: xor_of_numbers.kspl:17:
// EXPECT-NOT: xor_of_numbers.kspl:18:
// EXPECT-NOT: xor_of_numbers.kspl:19:
// EXPECT-NOT: xor_of_numbers.kspl:20:
const K: U8 = 10

pub fn xors(x: U8): I32
  a: = 10U8 ^ 2U8
  b: = 2 ^ 8
  c: = 10 ^ -2
  d: = 0x0AU8 ^ 2U8
  e: = K ^ 2U8
  f: = 10U8 ^ x
  g: = 5U8 ^ 3U8
  return I32::(a ^ d ^ e ^ f ^ g) + b + c
// ==== case redundant_parens_and_self_assign
//< Unnecessary brackets around a condition, and an assignment to itself
//< Both are spellings that carry no meaning.
// EXPECT: [H0301] Unnecessary parentheses around 'if' condition
// EXPECT: [H0301] Unnecessary parentheses around 'switch' condition
// EXPECT: [W0203] Meaningless self-assignment
enum Color
  red
  green

pub fn parens(n: I32): I32
  if (n > 0)
    return 1
  return 0

pub fn match_parens(c: Color): I32
  switch (c) case .red
    return 1
  case .green
    return 2

pub fn self_assign($n: I32): I32
  n = n
  return n
// ==== case unused_and_ignored
//< Checks that the diagnostics for "written but never read" can fire
//< Caution: Keep one fixed-length array around. [W0207] looks at the reading, not at the name
//< appearing, so it comes out on an array used only through `.len`.
//< Keep one import around: the private-declaration check draws the file by name.
// EXPECT: [W0202] Expression result of type
// EXPECT: [W0206] Unused private
// EXPECT: [W0207] Nothing reads local variable or parameter
// EXPECT: a fixed array's '.len' folds at compile time
// EXPECT: [W0208] Variable
import "std/io"

priv fn never_called(): I32 //< a private declaration that is not called
  return 0

pub fn probe(used: I32, unread_param: I32): I32
  used + 1
  never_read: I32 = 5
  $assigned_only: I32 = 0
  assigned_only = used
  len_only: Sz[3] = ::{ 1, 2, 3 }
  io.out().s("probe \{len_only.len\}\n")
  return used
// ==== case unused_priv_lib
//< A file another file imports, holding one dead helper and two that only look unused
//< Only a generic nobody instantiates calls `helper`, and a conformance needs `head`.
// EXPECT: unused_priv_lib.kspl:9:1: warning: [W0206] Unused private function 'dead'
// EXPECT-NOT: 'helper'
// EXPECT-NOT: .head'
priv fn helper(): I32
  return 1

priv fn dead(): I32
  return 2

pub fn twice<|T|>(_x: T): I32
  return helper()

pub trait Headed
  fn head(r: Self): I32

pub struct Box
  n: I32

impl Box: Headed
  priv fn head(r: Self): I32
    return r.n

pub fn plain(): I32
  return 3
// ==== case unused_priv_imported
//< A dead `priv` helper is reported in a file the linted file imports, not only in that file
//< The imported file is the case above, which the suite writes beside this one.
// EXPECT: unused_priv_lib.kspl:9:1: warning: [W0206] Unused private function 'dead'
// EXPECT-NOT: 'helper'
// EXPECT-NOT: .head'
import "unused_priv_lib"

fn main(): I32
  return unused_priv_lib.plain()

//< A `///` or a `//!` is not read as documentation, and the compiler warns at that spot
//<
//< At a file's head, in front of a function, in front of a field and behind code alike, the
//< sentence would reach neither the hover nor `ksplc doc`. Four slashes and more are a
//< banner and are left alone, and so is a mark inside a string.
// EXPECT: other_doc_marks_are_not_read.kspls:14:1: warning: [W0212] This //! is not read
// EXPECT: other_doc_marks_are_not_read.kspls:16:1: warning: [W0212] This /// is not read
// EXPECT: other_doc_marks_are_not_read.kspls:21:3: warning: [W0212] This /// is not read
// EXPECT: other_doc_marks_are_not_read.kspls:23:13: warning: [W0212] This //! is not read
// EXPECT: other_doc_marks_are_not_read.kspls:25:29: warning: [W0212] This /// is not read
// EXPECT-NOT: other_doc_marks_are_not_read.kspls:28:
// EXPECT-NOT: other_doc_marks_are_not_read.kspls:30:
import "std/io"
//! what this file is for, written the Rust way

/// adds two numbers
fn add(a: I32, b: I32): I32
  return a + b

struct Row //< one row
  /// the text as the writer typed it
  text: U8[]
  width: Sz //!< how wide it stands, written the Doxygen way

fn sub(a: I32, b: I32): I32 /// subtracts b from a
  return a - b

//// a banner above what follows
pub fn main(): I32
  r: Row = ::{ .text = "a /// b //! c", .width = 1 }
  io.out().s(r.text)
  return add(1, 2) + sub(3, 4) + I32::r.width

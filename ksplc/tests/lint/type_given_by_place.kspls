//< An enum's type written at its variant where the place already gives it
//<
//< The places that fix the expected type: a declaration's written type, the place `=` assigns to,
//< a parameter, a payload, a field or element, what a `catch` replaces, the return and error types.
//< Deleting each name dimmed below leaves `.variant`, the same value. A generic's line counts once.
// EXPECT: type_given_by_place.kspls:44:21: hint: [H0302] Unnecessary type name. The declared type already gives it.
// EXPECT: type_given_by_place.kspls:45:20: hint: [H0302] Unnecessary type name. The declared type already gives it.
// EXPECT: type_given_by_place.kspls:49:12: hint: [H0302] Unnecessary type name. The return type already gives it.
// EXPECT: type_given_by_place.kspls:50:10: hint: [H0302] Unnecessary type name. The return type already gives it.
// EXPECT: type_given_by_place.kspls:54:11: hint: [H0302] Unnecessary type name. The function's error type already gives it.
// EXPECT: type_given_by_place.kspls:55:10: hint: [H0302] Unnecessary type name. The return type already gives it.
// EXPECT: type_given_by_place.kspls:59:12: hint: [H0302] Unnecessary type name. The return type already gives it.
// EXPECT: type_given_by_place.kspls:60:10: hint: [H0302] Unnecessary type name. The return type already gives it.
// EXPECT: type_given_by_place.kspls:75:16: hint: [H0302] Unnecessary type name. The declared type already gives it.
// EXPECT: type_given_by_place.kspls:76:14: hint: [H0302] Unnecessary type name. The parameter's type already gives it.
// EXPECT: type_given_by_place.kspls:78:14: hint: [H0302] Unnecessary type name. The parameter's type already gives it.
// EXPECT: type_given_by_place.kspls:79:26: hint: [H0302] Unnecessary type name. The parameter's type already gives it.
// EXPECT: type_given_by_place.kspls:81:16: hint: [H0302] Unnecessary type name. The parameter's type already gives it.
// EXPECT: type_given_by_place.kspls:88:11: hint: [H0302] Unnecessary type name. The assigned place's type already gives it.
// EXPECT: type_given_by_place.kspls:89:23: hint: [H0302] Unnecessary type name. The payload's type already gives it.
// EXPECT: type_given_by_place.kspls:90:27: hint: [H0302] Unnecessary type name. The field's type already gives it.
// EXPECT: type_given_by_place.kspls:90:46: hint: [H0302] Unnecessary type name. The field's type already gives it.
// EXPECT: type_given_by_place.kspls:91:27: hint: [H0302] Unnecessary type name. The type of the value it stands in for already gives it.
// EXPECT: type_given_by_place.kspls:92:22: hint: [H0302] Unnecessary type name. The element's type already gives it.
// EXPECT: type_given_by_place.kspls:92:34: hint: [H0302] Unnecessary type name. The element's type already gives it.
// EXPECT: type_given_by_place.kspls:95:14: hint: [H0302] Unnecessary type name. The type of the value it stands in for already gives it.
import "std/ds" { List }
import "std/io"
import "std/mem" { Arena }

enum Kind
  small
  big(n: I32)

typedef Sort = Kind

enum Fault
  lost

struct Slot
  kind: Kind
  at: I32?

const usual: Kind = Kind.small
$last_seen: I32? = Option<|I32|>.none

priv fn positive(n: I32): I32? //< n where it is above 0
  if n > 0
    return Option<|I32|>.some(n)
  return Option<|I32|>.none

priv fn sized(n: I32): Kind!Fault //< big where n is not negative; a `!E` gives its success side
  if n < 0
    throw Fault.lost
  return Kind.big(n)

priv fn first<|T|>(xs: List<|T|>@): T? //< the first element, if any
  if xs.len > 0
    return Option<|T|>.some(xs.get(0))
  return Option<|T|>.none

priv fn same<|T|>(v: T): T //< v itself
  return v

priv fn count(o: I32?): I32 //< the value held, or 0
  switch o
  case .some(v)
    return v
  case .none
    return 0

fn main(): I32
  arena: = Arena.new(4096)
  defer arena.free()
  sort: Sort = Kind.small
  n: = count(Option<|I32|>.some(4)) + count(positive(2)) + count(last_seen)
  $kinds: = List<|Kind|>.new(arena)
  kinds.push(Kind.small)
  picked: = same<|Kind|>(Kind.small)
  keep: fn(k: Kind): Kind = same<|Kind|>
  kept: = keep(Kind.big(1))
  kinds.push(sized(n) catch usual)
  $ints: = List<|I32|>.new(arena)
  ints.push(n)
  _a: = first<|I32|>(ints@)
  _b: = first<|Kind|>(kinds@)
  $again: = positive(1)
  again = Option<|I32|>.some(5)
  held: Kind? = .some(Kind.small)
  slot: = Slot::{ .kind = Kind.big(2), .at = Option<|I32|>.none }
  lost: = sized(-1) catch Kind.small
  row: Kind[2] = ::{ Kind.small, Kind.big(9) }
  kept_too: = sized(-1) catch e
    io.out().s("\{e.variant_name()\}").c('\n')
    fallback Kind.small
  if kinds.len > 0
    io.out().s("\{kinds.len\} \{sort.variant_name()\} \{picked.variant_name()\}").c('\n')
  io.out().s("\{kept.variant_name()\} \{count(again)\} \{held.is_some()\}").c('\n')
  io.out().s("\{slot.kind.variant_name()\} \{lost.variant_name()\} \{kept_too.variant_name()\}")
    .c('\n')
  io.out().s("\{row[1].variant_name()\}").c('\n')
  return 0

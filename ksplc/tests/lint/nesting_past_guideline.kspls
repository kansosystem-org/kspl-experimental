//< One function nesting blocks nine levels deep, past the guideline of 8
//<
//< Its neighbour nests eight and is not reported: the guideline is a ceiling, not a target.
// EXPECT: [H0805] This function nests blocks 9 levels deep
fn deep(n: I32): I32
    if n > 0
        if n > 1
            if n > 2
                if n > 3
                    if n > 4
                        if n > 5
                            if n > 6
                                if n > 7
                                    if n > 8
                                        return n
    return 0

fn shallow(n: I32): I32
    if n > 0
        if n > 1
            if n > 2
                if n > 3
                    if n > 4
                        if n > 5
                            if n > 6
                                if n > 7
                                    return n
    return 0

fn main(): I32
    return deep(1) + shallow(1)

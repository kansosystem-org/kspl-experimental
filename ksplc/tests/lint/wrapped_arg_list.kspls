//< A call whose own argument list wraps, passed directly as another call's argument
//<
//< Put there, or into an `if`'s subject, and where one expression begins and ends cannot be read.
//< Caution: The arguments must be long enough that the wrap survives formatting: `make fmt` folds a
//< call that fits the column width onto one line, and then the finding stops coming out.
// EXPECT: [H0802] This call passes another call as an argument
// EXPECT: [H0804] This 'if' directly wraps a call
priv fn combine_three_values(first_operand: I32, second_operand: I32, third_operand: I32): I32
  return first_operand + second_operand + third_operand

priv fn is_sum_positive(first_operand: I32, second_operand: I32, third_operand: I32,
  fourth_operand: I32): Bool
  return first_operand + second_operand + third_operand + fourth_operand > 0

priv fn twice(n: I32): I32
  return n * 2

pub fn nested(some_incoming_value: I32): I32
  return twice(combine_three_values(some_incoming_value * 11, some_incoming_value + 22,
    some_incoming_value + 33))

pub fn subject(some_incoming_value: I32): I32
  if is_sum_positive(some_incoming_value * 11, some_incoming_value + 22, some_incoming_value + 33,
    some_incoming_value + 44)
    return 1
  return 0

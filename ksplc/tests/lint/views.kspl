//< Views into a container: a view read after a change that may move or free what it points into
//< Each case below is compiled alone, as the file its head names. Split from `resources.kspl` for length.
// ==== case view_after_change
//< [W0111] A view used after a call that may move or release the memory it points into
//< The example of "What invalidates a view" in the language specification: a list's element
//< after a push, and an arena's text after a reset, are findings; a view taken after the push
//< is not.
// EXPECT: view_after_change.kspl:24:3: warning: [W0111] 'p' points into 'xs', which 'push' on line 23
// EXPECT: view_after_change.kspl:30:14: warning: [W0111] 's' points into 'arena', which 'reset' on line 29
// EXPECT-NOT: view_after_change.kspl:27:
// EXPECT: 0 error(s), 2 warning(s)
import "std/ds" { List }
import "std/io"
import "std/mem" { Arena }
import "std/str"

priv struct Point
  x: I32
  y: I32

fn main()
  defer arena: = Arena(4096)
  $xs: = List<|Point|>(arena)
  xs.push(Point::{ .x = 1, .y = 2 })
  p: = xs[0]@
  xs.push(Point::{ .x = 3, .y = 4 }) // may move every element
  p.x = 9 // MARK-p
  e: = xs[0]@
  e.x = 1
  e.y = 2 // MARK-e
  s: = arena.text().s("hi").take()
  arena.reset()
  io.out().s(s) // MARK-s
// ==== case view_walked_stale
//< [W0111] A `for … in` over a stale view is reported once, at the view
//< The loop walks a copy of the view, and that copy is the same fault. Once it was told a second
//< time, naming no owner.
// EXPECT: view_walked_stale.kspl:15:12: warning: [W0111] 's' points into 'xs', which 'push' on line 13
// EXPECT-NOT: walks ''
// EXPECT: 0 error(s), 1 warning(s)
import "std/ds" { List }

fn main(): I32
  defer $xs: = List<|I32|>(null)
  xs.push(1)
  s: = xs.slice()
  xs.push(2)
  $t: = 0
  for e in s
    t += e
  return t
// ==== case view_stale_again
//< [W0111] A view given a new value, which is then ended too, is a second fault, and reported
//< Once a copy of a stale view counted as reported for good, so the second fault went unseen.
// EXPECT: view_stale_again.kspl:15:9: warning: [W0111] 's' points into 'xs', which 'push' on line 14
// EXPECT: view_stale_again.kspl:19:12: warning: [W0111] 't' points into 'ys', which 'push' on line 17
// EXPECT: 0 error(s), 2 warning(s)
import "std/ds" { List }

fn main(): I32
  defer $xs: = List<|I32|>(null)
  defer $ys: = List<|I32|>(null)
  xs.push(1)
  ys.push(1)
  s: = xs.slice()
  xs.push(2)
  $t: = s
  t = ys.slice()
  ys.push(5)
  $n: = 0
  for e in t
    n += e
  return n
// ==== case view_across_flow
//< [W0111] follows a loop's back edge and a branch, and each kind of owner std marks
//< **The silent shapes must stay silent**: the view taken again, a view of another list, a copy
//< of an element, an `Rc` with another owner, and a pointer only compared.
// EXPECT: view_across_flow.kspl:28:5: warning: [W0111] 'p' points into 'xs', which 'push' on line 29
// EXPECT: view_across_flow.kspl:35:17: warning: [W0111] 'v' points into 'xs', which 'push' on line 34
// EXPECT: view_across_flow.kspl:42:14: warning: [W0111] 'v' points into 'b', which 's' on line 41
// EXPECT: view_across_flow.kspl:45:3: warning: [W0111] This 'for … in' walks 'm', which the write into 'm[…]' on line 46
// EXPECT: view_across_flow.kspl:52:3: warning: [W0111] 'p' points into 'r', whose old value the new one given on line 51
// EXPECT-NOT: view_across_flow.kspl:58:
// EXPECT-NOT: view_across_flow.kspl:63:
// EXPECT-NOT: view_across_flow.kspl:70:
// EXPECT-NOT: view_across_flow.kspl:75:
// EXPECT-NOT: view_across_flow.kspl:82:
// EXPECT-NOT: view_across_flow.kspl:88:
// EXPECT: 0 error(s), 5 warning(s)
import "std/ds" { List, Map }
import "std/io"
import "std/mem" { Arena }
import "std/refcount" { Rc }
import "std/str"

priv struct Node
  v: I32

priv fn in_loop(xs: List<|I32|>$@, n: I32) //< a view kept over a loop whose body grows the list
  p: = xs[0]@
  for i in Range.asc(n)
    p$ += 1 // MARK-loop
    xs.push(I32::i)

priv fn in_branch(xs: List<|I32|>$@, grow: Bool) //< one branch grows the list
  v: = xs.slice()
  if grow
    xs.push(1)
  io.out().s("\{v[0]\}\n") // MARK-branch

priv fn builder_slice() //< a builder's view, then a write that grows the builder
  defer $b: = str.Str()
  b.s("ab")
  v: = b.slice()
  b.s("cd")
  io.out().s(v) // MARK-builder

priv fn map_walk(m: Map<|I32, I32|>$@) //< a walk over a map that sets a pair
  for e in m.items() // MARK-map
    m[e.key + 1] = e.value

priv fn rc_replaced() //< the last owner given a new value frees the old one
  $r: = Rc<|Node|>(Node::{ .v = 1 })
  p: = r.get()
  r = Rc<|Node|>(Node::{ .v = 2 })
  p.v = 9 // MARK-rc

priv fn taken_again(xs: List<|I32|>$@) //< the view taken again after the push (silent)
  $p: = xs[0]@
  xs.push(2)
  p = xs[0]@
  p$ = 3 // SILENT-1

priv fn other_list(xs: List<|I32|>$@, ys: List<|I32|>$@) //< a view of another list (silent)
  p: = ys[0]@
  xs.push(2)
  p$ = 3 // SILENT-2

priv fn each_branch_retakes(xs: List<|I32|>$@, grow: Bool) //< taken again where it grew (silent)
  $v: = xs.slice()
  if grow
    xs.push(1)
    v = xs.slice()
  io.out().s("\{v[0]\}\n") // SILENT-3

priv fn copied_value(xs: List<|I32|>$@) //< a copy of the element, not its address (silent)
  e: = xs[0]
  xs.push(2)
  io.out().s("\{e\}\n") // SILENT-4

priv fn rc_shared() //< another owner keeps the value alive (silent)
  $r: = Rc<|Node|>(Node::{ .v = 1 })
  keep: = r
  p: = r.get()
  r = Rc<|Node|>(Node::{ .v = 2 })
  p.v = keep.get().v // SILENT-5

priv fn compared(a: Arena$@) //< a pointer compared, not read through (silent)
  mark: = a.save()
  first: = a.alloc(16)
  a.restore(mark)
  assert(a.alloc(16) == first, "the same place") // SILENT-6

fn main()
  defer arena: = Arena(4096)
  $xs: = List<|I32|>(arena)
  xs.push(1)
  $ys: = List<|I32|>(arena)
  ys.push(1)
  $m: = Map<|I32, I32|>(arena)
  m[1] = 2
  in_loop(xs@, 3)
  in_branch(xs@, true)
  builder_slice()
  map_walk(m@)
  rc_replaced()
  taken_again(xs@)
  other_list(xs@, ys@)
  each_branch_retakes(xs@, true)
  copied_value(xs@)
  rc_shared()
  compared(arena)
// ==== case view_left_by_return
//< [W0111] A `return` whose view a `defer` ends as the function leaves
//< The owner is a list, a builder, a map or an arena that the function frees itself: declared
//< with `defer`, or freed by a `defer` statement. The view is returned as written or through a
//< local. **The silent shapes must stay silent**: a view of what the caller owns, a copy made in
//< the caller's arena, and a number read through the view.
// EXPECT: view_left_by_return.kspl:25:3: warning: [W0111] This 'return' hands out a view into 'args', which 'free' on line 23 releases as the function leaves
// EXPECT: view_left_by_return.kspl:31:3: warning: [W0111] This 'return' hands out a view into 'args', which 'free' on line 28 releases
// EXPECT: view_left_by_return.kspl:36:3: warning: [W0111] This 'return' hands out a view into 'b', which 'free' on line 34 releases
// EXPECT: view_left_by_return.kspl:41:3: warning: [W0111] This 'return' hands out a view into 'm', which 'free' on line 39 releases
// EXPECT: view_left_by_return.kspl:45:3: warning: [W0111] This 'return' hands out a view into 'arena', which 'free' on line 44 releases
// EXPECT: view_left_by_return.kspl:51:3: warning: [W0111] This 'return' hands out a view into 'args', which 'free' on line 49 releases
// EXPECT: view_left_by_return.kspl:58:3: warning: [W0111] This 'return' hands out a view into 'b', which 'free' on line 54 releases
// EXPECT-NOT: view_left_by_return.kspl:63:
// EXPECT-NOT: view_left_by_return.kspl:68:
// EXPECT-NOT: view_left_by_return.kspl:73:
// EXPECT-NOT: view_left_by_return.kspl:78:
// EXPECT: 0 error(s), 7 warning(s)
import "std/ds" { List, Map, Map_seq }
import "std/mem" { Arena }
import "std/str" { Str }

priv fn of_list(): I32[] //< the view as written
  defer $args: = List<|I32|>(null)
  args.push(7)
  return args.slice() // MARK-list

priv fn through_local(): I32[] //< the view copied through a local
  defer $args: = List<|I32|>(null)
  args.push(7)
  view: = args.slice()
  return view // MARK-local

priv fn of_builder(): U8[] //< a builder's bytes
  defer $b: = Str()
  b.s("abc")
  return b.slice() // MARK-builder

priv fn of_map(): Map_seq<|I32, I32|> //< a walk over a map's pairs
  defer $m: = Map<|I32, I32|>(null)
  m[1] = 2
  return m.items() // MARK-map

priv fn of_arena(): U8[] //< text made in the function's own arena
  defer arena: = Arena(64)
  return arena.text().s("x").take() // MARK-arena

priv fn freed_by_statement(): I32@ //< the owner freed by a `defer` statement, an element's address
  $args: = List<|I32|>(null)
  defer args.free()
  args.push(7)
  return args[0]@ // MARK-statement

priv fn in_result(fail: Bool): U8[]!Sz //< the value of a `T!E`
  defer $b: = Str()
  b.s("abc")
  if fail
    throw 1
  return b.slice() // MARK-result

priv fn of_caller(xs: List<|I32|>$@): I32[] //< the caller owns the list (silent)
  defer $b: = Str()
  b.s("abc")
  return xs.slice() // SILENT-1

priv fn in_caller_arena(arena: Arena$@): I32[] //< the list lies in the caller's arena (silent)
  $args: = List<|I32|>(arena)
  args.push(7)
  return args.slice() // SILENT-2

priv fn copied_out(arena: Arena$@): U8[] //< a copy that outlives the builder (silent)
  defer $b: = Str()
  b.s("abc")
  return arena.dup_str(b.slice()) // SILENT-3

priv fn a_number(): Sz //< a number read through the view (silent)
  defer $b: = Str()
  b.s("abc")
  return b.slice().len // SILENT-4

fn main(): I32
  defer arena: = Arena(4096)
  $xs: = List<|I32|>(arena)
  _a: = of_list()
  _b: = through_local()
  _c: = of_builder()
  _d: = of_map()
  _e: = of_arena()
  _f: = freed_by_statement()
  _g: = in_result(false) catch ""
  _h: = of_caller(xs@)
  _i: = in_caller_arena(arena)
  _j: = copied_out(arena)
  return I32::a_number()

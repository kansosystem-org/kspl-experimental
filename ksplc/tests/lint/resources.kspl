//< Resources and side effects: arenas, locks, `defer`, release spelling
//< Each case below is compiled alone, as the file its head names.
// ==== case arena_handout_freed
//< Passing a pointer that an arena allocated to `mem.dealloc()`
//< The type is the same `T$@` a heap allocation returns, so without this it breaks at run time.
//< Each of the three methods (`alloc` / `alloc_as` / `create`) is one finding.
//< **Two must stay silent**: a heap allocation, and `free()` of a container placed in an arena.
// EXPECT: [W0104] This pointer was handed out by an arena
// EXPECT-NOT: error:
// EXPECT: 0 error(s), 3 warning(s)
import "std/ds" { List }
import "std/io"
import "std/mem" + { Arena }

pub fn probe(): I32
  arena: = Arena(4096)
  defer arena.free()
  a: = arena.alloc(4)
  mem.dealloc(a)
  b: = arena.alloc_as<|I32|>()
  mem.dealloc(Void$@::b)
  c: = arena.create<|I32|>(3)
  mem.dealloc(Void$@::c)
  // It must stay silent where the source is the heap.
  h: = mem.alloc_as<|I32|>()
  h$ = 9
  mem.dealloc(Void$@::h)
  // It must stay silent on the shape letting go of the content of a container placed in an arena
  // too.
  items: = arena.create(List<|I32|>(null))
  defer items.free()
  items.push(1)
  io.out().s("arena handout \{items.len\}\n")
  return 0
// ==== case bitwise_compare_grouping
//< Comparing `&`'s result without brackets
//< KSPL puts `&` at the same step as multiplication so it reads `(a & b) == c`, while C reads the
//< same expression as `a & (b == c)`. It passes yet the answer changes, so [W0108] gives notice.
// EXPECT: [W0108]
// EXPECT: bind tighter than comparison in KSPL
// EXPECT-NOT: error:
import "std/io"

pub fn probe(a: I32, b: I32, c: I32): I32
  $hits: I32 = 0
  if a & b == c
    hits += 1
  if a == b & c
    hits += 1
  // The shape with the brackets written is out of scope (the grouping can be read from the
  // spelling).
  if (a & b) == c
    hits += 1
  io.out().s("\{hits\}\n")
  return hits
// ==== case constant_condition
//< Conditions whose answer a constant decides
//< All of them are often "not what the writer meant". `n / 0` cannot be placed here. A division by
//< zero is not a lint but a no-code error (docs/SPEC-programming-language.md 4.2).
//< The case divide_by_zero in tests/negative/numbers.kspl looks at it.
// EXPECT: [W0201] Unreachable code detected
// EXPECT: [W0205] Loop with 'true' condition
// EXPECT: [W0101] Array index out of bounds. The array size is 3, but the index is 5.
// EXPECT: [W0101] Array index out of bounds. The array size is 3, but the index is -1.
import "std/io"

pub fn after_return(n: I32): I32
  return n
  return 0

pub fn always_true() //<
  //< A `for true` loop in a function that returns no value
  //< No analysis reads `for true` as a loop that never leaves. With a return value it becomes a
  //< different error ("there is a road that does not return"), which never reaches this
  //< diagnostic.
  for true
    return

pub fn indexes(): I32
  a: I32[3] = ::{ 1, 2, 3 }
  return a[5] + a[-1]
// ==== case defer_after_way_out
//< [W0109] A way out between a `Manual_free` value's binding and the `defer` that frees it
//< The `!` in late() and the `continue` in per_round() leave before the `defer` is registered.
//< `defer` in front of the binding, a value handed back, a hand free and a closure's `!` do not.
//< **The line numbers name the way out and the two lines the message gives.** Mend them on a move.
// EXPECT: defer_after_way_out.kspl:24:8: warning: [W0109] 'arena' leaks if this '!' exits
// EXPECT: registered only on line 25. Put 'defer' in front of its declaration on line 23
// EXPECT: defer_after_way_out.kspl:53:7: warning: [W0109] 'buf' leaks if this 'continue' exits
// EXPECT-NOT: defer_after_way_out.kspl:31:
// EXPECT-NOT: defer_after_way_out.kspl:36:
// EXPECT-NOT: defer_after_way_out.kspl:44:
// EXPECT-NOT: defer_after_way_out.kspl:60:
import "std/mem" { Arena }

priv enum E
  bad

priv fn step(ok: Bool): I32!E //< a road that may throw
  if !ok
    throw .bad
  return 1

priv fn late(ok: Bool): I32!E //< the `!` leaves before the `defer` (a finding)
  arena: = Arena(1024)
  n: = step(ok)!
  defer arena.free()
  return n

priv fn early(ok: Bool): I32!E //< `defer` in front of the binding (not a finding)
  defer arena: = Arena(1024)
  _p: = arena.alloc(8)
  return step(ok)!

priv fn handed(ok: Bool): Arena$@ //< the value handed back is the caller's (not a finding)
  arena: = Arena(1024)
  if ok
    return arena
  defer arena.free()
  return Arena(16)

priv fn by_hand(ok: Bool): I32 //< freed on the road it leaves by (not a finding)
  arena: = Arena(1024)
  if !ok
    arena.free()
    return 0
  defer arena.free()
  return 1

priv fn per_round(n: I32): I32 //< a `continue` before the round's `defer` (a finding)
  $total: = 0
  for $i: = 0; i < n; i += 1
    buf: = Arena(64)
    if i == 2
      continue
    defer buf.free()
    total += i
  return total

priv fn in_closure(ok: Bool): I32!E //< a closure's `!` leaves the closure alone (not a finding)
  arena: = Arena(64)
  f: = fn(x: I32; ): I32!E { return step(x > 0)!; }
  defer arena.free()
  return f.call(I32::ok)

fn main(): I32
  a: = late(true) catch 0
  b: = early(true) catch 0
  h: = handed(false)
  h.free()
  c: = in_closure(true) catch 0
  return a + b + by_hand(true) + per_round(3) + c - 7
// ==== case discarded_side_effect
//< A side effect written to the left of an array's `.len` does not run
//< The array's length is settled at translation time.
// EXPECT: [W0102] Expression has side effects
import "std/io"

priv fn noisy(a: I32[4]): I32[4]
  io.out().s("this call is dropped\n")
  return a

pub fn probe(): Sz
  a: I32[4] = ::{ 0, 0, 0, 0 }
  return noisy(a).len
// ==== case lock_borrow_escape
//< [W0105] Finds uses of a borrow taken from a lock after the lock is released
//< After unlock another thread can rewrite that region at the same time. Both (A) a use after
//< unlock and (B) a return of the borrow must be findings, and a use while holding the lock not.
// ==========================================
// EXPECT: [W0105] Local 'p' borrows into 'mx' via .lock()
// EXPECT: [W0105] Returning a pointer obtained from Mutex.lock()
// **The line number below names the `mx.lock()` line** of the use while holding the lock.
// Move a line above it and mend it here.
// EXPECT-NOT: lock_borrow_escape.kspl:30
// ==========================================
import "std/io"
import "std/thread"

priv fn use_after_unlock() //< (A) using the borrow after unlock (a finding)
  $mx: = thread.Mutex<|I32|>(0) catch
    return
  p: = mx.lock()
  mx.unlock()
  io.out().s("\{p$\}\n")

priv fn returns_borrow(): I32$@ //< (B) returning the borrow as it stands (a finding)
  $mx: = thread.Mutex<|I32|>(0) catch
    return null
  p: = mx.lock()
  return p

priv fn uses_while_locked() //< a use while holding the lock (not a finding)
  $mx: = thread.Mutex<|I32|>(0) catch
    return
  p: = mx.lock()
  p$ += 1
  mx.unlock()

fn main()
  use_after_unlock()
  _q: = returns_borrow()
  uses_while_locked()
// ==== case lock_not_released
//< [W0106] Finds places that take a lock and do not release it
//< Forget to release and every thread trying to take that lock stops forever (a deadlock).
//< forgets() alone is a finding. An explicit unlock and a release by defer are not.
//< **The marks' line numbers name the `mx.lock()` lines**: the finding points at the lock.
// EXPECT: [W0106] 'mx' is locked here but not unlocked
// EXPECT: lock_not_released.kspl:15:3: warning: [W0106]
// EXPECT-NOT: lock_not_released.kspl:21
// EXPECT-NOT: lock_not_released.kspl:29
import "std/io"
import "std/thread"

priv fn forgets() //< forgetting to call it (a finding)
  $mx: = thread.Mutex<|I32|>(0) catch
    return
  p: = mx.lock()
  p$ += 1

priv fn explicit_unlock() //< an explicit unlock (not a finding)
  $mx: = thread.Mutex<|I32|>(0) catch
    return
  p: = mx.lock()
  p$ += 1
  mx.unlock()

priv fn released_by_defer() //< a release by defer (not a finding)
  //< Every road out releases, so forgets()'s problem cannot arise.
  $mx: = thread.Mutex<|I32|>(0) catch
    return
  p: = mx.lock()
  defer { mx.unlock(); }
  p$ += 1

fn main()
  forgets()
  explicit_unlock()
  released_by_defer()
  io.out().s("done\n")
// ==== case lock_across_flow
//< [W0105] and [W0106] follow a loop's back edge, a branch and each way out of the function
//< A pointer from lock() is used after unlock in a loop, returned, or stored through a
//< parameter; a lock is held at a `return` or a `throw`.
//< **The silent shapes must stay silent**: a lock taken again, a branch or a `break` that
//< unlocks, and a `defer` in a nested block.
// EXPECT: lock_across_flow.kspl:29:5: warning: [W0105]
// EXPECT: lock_across_flow.kspl:36:7: warning: [W0105]
// EXPECT: lock_across_flow.kspl:41:5: warning: [W0105]
// EXPECT: lock_across_flow.kspl:48:3: warning: [W0105]
// EXPECT: lock_across_flow.kspl:52:3: warning: [W0105]
// EXPECT: lock_across_flow.kspl:56:3: warning: [W0106]
// EXPECT: lock_across_flow.kspl:61:3: warning: [W0106]
// EXPECT-NOT: lock_across_flow.kspl:71:
// EXPECT-NOT: lock_across_flow.kspl:79:
// EXPECT-NOT: lock_across_flow.kspl:83:
// EXPECT-NOT: lock_across_flow.kspl:92:
// EXPECT: 0 error(s), 7 warning(s)
import "std/thread"

priv enum Err
  bad

priv fn work() {}

priv fn in_loop(m: thread.Mutex<|I64|>$@, n: I32) //< (A) unlocked, then used, in a loop body
  for _i in Range.asc(n)
    p: = m.lock()
    m.unlock()
    p$ += 1

priv fn kept_over_loop(m: thread.Mutex<|I64|>$@, n: I32) //< (A) unlocked before the loop
  p: = m.lock()
  m.unlock()
  for _i in Range.asc(n)
    if n > 1
      p$ += 1

priv fn back_edge(m: thread.Mutex<|I64|>$@, n: I32) //< (A) on the second turn, over the back edge
  p: = m.lock()
  for _i in Range.asc(n)
    p$ += 1
    m.unlock()
    work()

priv fn returned_held(m: thread.Mutex<|I64|>$@): I64$@ //< (B) returned, with the defer to unlock
  p: = m.lock()
  defer m.unlock()
  return p

priv fn stored(m: thread.Mutex<|I64|>$@, out: I64$@$@) //< (C) stored where it outlives the call
  p: = m.lock()
  out$ = p
  m.unlock()

priv fn exit_holding(m: thread.Mutex<|I64|>$@): Void$@ //< [W0106] a thread's entry returns holding
  p: = m.lock()
  p$ = 1
  return null

priv fn throws_holding(m: thread.Mutex<|I64|>$@, c: Bool): Void!Err //< [W0106] by a throw
  m.lock()
  if c
    throw .bad
  m.unlock()

priv fn relock_in_loop(m: thread.Mutex<|I64|>$@, n: I32) //< silent: locked again before each use
  p: = m.lock()
  m.unlock()
  for _i in Range.asc(n)
    m.lock()
    p$ += 1
    m.unlock()

priv fn early_unlock(m: thread.Mutex<|I64|>$@, c: Bool) //< silent: the branch leaves unlocked
  p: = m.lock()
  if c
    m.unlock()
    return
  p$ += 1
  m.unlock()

priv fn break_unlocks(m: thread.Mutex<|I64|>$@, n: I32) //< silent: each way out unlocks
  m.lock()
  for i in Range.asc(n)
    if i == 3
      m.unlock()
      break
  work()

priv fn defer_in_branch(m: thread.Mutex<|I64|>$@, c: Bool) //< silent: the block's defer unlocks
  if c
    p: = m.lock()
    defer m.unlock()
    p$ = 1
  work()

fn main()
  defer $mx: = thread.Mutex<|I64|>(0) catch panic("mutex")
  in_loop(mx@, 2)
  kept_over_loop(mx@, 2)
  back_edge(mx@, 2)
  _r: = returned_held(mx@)
  $q: I64$@ = null
  stored(mx@, q@)
  _e: = exit_holding(mx@)
  throws_holding(mx@, false) catch {}
  relock_in_loop(mx@, 2)
  early_unlock(mx@, true)
  break_unlocks(mx@, 5)
  defer_in_branch(mx@, true)
// ==== case release_method_spelling
//< Warns about a name or contract that releases but is not tracked
// EXPECT: [W0107] 'close' releases the receiver
// EXPECT: [W0107] 'free' releases the receiver
// EXPECT: [W0107] 'destroy' releases the receiver
// EXPECT: [W0107] 'shutdown' releases the receiver
// EXPECT: [W0107] 'dispose' releases its first parameter
// EXPECT-NOT: [W0107] 'take'
// EXPECT-NOT: [W0107] 'clear'
// EXPECT-NOT: [W0107] 'deinit'
import "std/io"
import "std/mem" { dealloc }

pub struct H
  pub id: I32

impl H
  pub fn open(): H
    return H::{ .id = 1 }

  pub fn close(r: Self$@) //< in scope
    //< The name is not `free`.
    r.id = 0

  pub fn free(r: Self$@) //< in scope
    //< The name is `free` but H does not conform to Manual_free.
    r.id = -1

  pub fn take(r: Self$@, key: I32): Bool //< out of scope
    //< It takes an argument because it erases something else.
    return key == r.id

  pub fn clear(r: Self$@) //< out of scope
    //< It only throws the content away; the substance lives on.
    r.id = 0

  priv fn destroy(r: Self$@) //< in scope
    //< The visibility is not asked about (even a priv can conform to `Manual_free`).
    r.id = -2

  pub fn shutdown(r: Self$@, _reason: I32) //< in scope
    //< The second and later arguments are not asked about (a tool is sometimes handed to a
    //< release).
    r.id = -3

  pub fn deinit(r: Self$@) //< out of scope
    //< The body releases the first argument itself, so it is tracked regardless of the name and the
    //< conformance.
    dealloc(Void$@::r)

pub fn dispose(h: H$@) //< in scope
  //< A release written as a free function is looked at too. It returns the content alone, so it
  //< does not ride road 2.
  h.id = 0

pub struct G //< nothing comes out, it having conformed
  pub id: I32

impl G
  pub fn open(): G
    return G::{ .id = 1 }

impl G: Manual_free
  pub fn free(r: Self$@)
    r.id = 0

fn main(): I32
  $h: = H.open()
  h.close()
  _ok: = h.take(1)
  h.clear()
  h.destroy()
  h.shutdown(1)
  dispose(h@)
  $g: = G.open()
  g.free()
  io.out().s("done\n")
  return h.id
// ==== case unbounded_accumulation
//< A loop that accumulates digits with no cap check
//< Untrusted input overflowing the digits goes on in silence.
// EXPECT: [W0103] Accumulating into
pub fn parse_digits(text: U8[]): I32
  $acc: I32 = 0
  for i in Range.asc(text.len)
    d: I32 = I32::(text[i] - '0')
    acc = acc * 10 + d
  return acc
// ==== case arena_param_default
//< A parameter taking an arena carries no default, so each call shows where it allocates
//< The type is read as resolved, so an arena behind a typedef or a pointer is found. A default on
//< another type, an arena with no default, and a field of a function type are not reported.
// EXPECT: arena_param_default.kspl:16:30: information: [I0702]
// EXPECT: arena_param_default.kspl:19:26: information: [I0702]
// EXPECT: arena_param_default.kspl:22:21: information: [I0702]
// EXPECT-NOT: arena_param_default.kspl:25:
import "std/mem" { Arena }

priv typedef Pool = Arena

priv struct Holder
  cb: fn(a: Arena$@): Sz

impl Holder
  fn grow(_r: Self@, _n: Sz, _a: Arena$@ = null): Sz
    return 0

priv fn via_alias(n: Sz, _p: Pool$@ = null): Sz
  return n

priv fn seen(n: Sz, _a: Arena@ = null): Sz
  return n

priv fn plain(_a: Arena$@, n: Sz = 0): Sz
  return n

priv fn none(_a: Arena$@): Sz
  return 0

fn main(): I32
  h: Holder = ::{ .cb = none }
  return I32::(h.grow(1) + via_alias(1) + seen(1) + plain(null) + h.cb(null))
// ==== case value_never_freed
//< [W0109] A value made here that no path frees, and one that only some paths free
//< **Only what this function makes counts**: a parameter, an element read out of a list, a value
//< from an arena and a value another function hands back from its own arena are not its own. A
//< part read out of a value (`b.len`) does not hand the value on.
// EXPECT: value_never_freed.kspl:16:4: warning: [W0109] 'b' is never freed. Put 'defer' in front of its declaration ('defer $b: = …'), or hand it on.
// EXPECT: value_never_freed.kspl:21:4: warning: [W0109] 'xs' is not freed on every path to the end of its block
// EXPECT: value_never_freed.kspl:29:5: warning: [W0109] 'out' leaks if this 'return' exits. Nothing frees it on this way out.
// EXPECT-NOT: 'first'
// EXPECT-NOT: 'given'
// EXPECT: 0 error(s), 3 warning(s)
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }

priv fn length(s: U8[]): Sz //< made and never freed (a finding)
  $b: = Str_builder()
  b.s(s)
  return b.len

priv fn maybe(keep: Bool) //< freed on one path only (a finding)
  $xs: = List<|I32|>(null)
  xs.push(1)
  if keep
    xs.free()

priv fn early(bad: Bool): Str_builder //< handed back, but left behind on an early return (a finding)
  $out: = Str_builder()
  if bad
    return Str_builder()
  out.s("ok")
  return out

priv fn in_arena(a: Arena$@, rows: List<|List<|I32|>|>$@, given: Str_builder): Sz //< none of these
  $xs: = List<|I32|>(a)
  xs.push(1)
  first: = rows.get(0)
  return xs.len + first.len + given.len

fn main()
  _n: = length("x")
  maybe(true)
  $o: = early(false)
  o.free()
  defer a: = Arena(64)
  defer $rows: = List<|List<|I32|>|>(null)
  rows.push(List<|I32|>(a))
  _m: = in_arena(a, rows@, Str_builder())
// ==== case thread_never_joined
//< [W0109] A thread started and never waited for
//< `free()` waits for it, so a thread no path frees can outlive what it was handed. **Two must stay
//< silent**: `defer` in front, which waits at the block's end, and a thread freed by hand.
// EXPECT: thread_never_joined.kspl:16:3: warning: [W0109] '_t' is never freed
// EXPECT-NOT: 'scoped'
// EXPECT-NOT: 'joined'
// EXPECT: 0 error(s), 1 warning(s)
import "std/thread" { Thread }

extern fn idle(arg: I64$@): Void$@
  arg$ += 1
  return null

fn main()
  $x: I64 = 0
  _t: = Thread.spawn<|I64|>(idle, x@) catch panic("spawn")
  $y: I64 = 0
  defer $_scoped: = Thread.spawn<|I64|>(idle, y@) catch panic("spawn")
  $z: I64 = 0
  $joined: = Thread.spawn<|I64|>(idle, z@) catch panic("spawn")
  joined.free()
// ==== case value_never_freed_in_generic
//< [W0109] in a body that is checked only in its instances
//< Those are a generic's method, a generic function and a slice's method. **Each finding is printed
//< once**, at the line written, though each body here is checked once per instance. A value of
//< the type argument's own type is not a finding: in the `Str_builder` instance it owns, in the
//< `I32` one it does not, and `defer` in front of it would not compile there.
// EXPECT: value_never_freed_in_generic.kspl:21:6: warning: [W0109] 'b' is never freed
// EXPECT: value_never_freed_in_generic.kspl:31:6: warning: [W0109] 'xs' is never freed
// EXPECT: value_never_freed_in_generic.kspl:46:4: warning: [W0109] 'b' is never freed
// EXPECT: value_never_freed_in_generic.kspl:54:7: warning: [W0109] 'out' leaks if this 'return' exits
// EXPECT-NOT: 'v'
// EXPECT-NOT: 'kept'
// EXPECT: 0 error(s), 4 warning(s)
import "std/ds" { List }
import "std/str" { Str_builder }

struct Box<|T|>
  v: T

impl<|T|> Box<|T|>
  fn width(_r: Self$@): Sz //< made and never freed (a finding)
    $b: = Str_builder()
    b.s("x")
    return b.len

  fn freed_width(_r: Self$@): Sz //< freed by `defer` in front (silent)
    defer $b: = Str_builder()
    b.s("x")
    return b.len

  fn count(r: Self$@): Sz //< a list of the argument's type, never freed (a finding)
    $xs: = List<|T|>(null)
    xs.push(r.v)
    return xs.len

  fn peek(r: Self$@): T
    return r.v

  fn read(r: Self$@): Sz //< a value of type `T`, an owner in one instance only (silent)
    v: = r.peek()
    return size_of(v@)

priv fn size_of<|T|>(_v: T$@): Sz
  return sizeof(T)

priv fn length<|T|>(_v: T): Sz //< a generic function's value, never freed (a finding)
  $b: = Str_builder()
  b.s("y")
  return b.len

impl U8[]
  priv fn quoted(r: Self, bad: Bool): Str_builder //< left behind on an early return (a finding)
    $out: = Str_builder()
    if bad
      return Str_builder()
    out.s(r)
    return out

  priv fn kept(r: Self): Sz //< handed back (silent)
    defer $q: = r.quoted(false)
    return q.len

fn main()
  $a: = Box<|I32|>::{ .v = 1 }
  $c: = Box<|U8|>::{ .v = 2 }
  _w: = a.width() + c.width() + a.freed_width() + a.count() + c.count()
  $s: = Box<|Str_builder|>::{ .v = Str_builder() }
  _r: = a.read() + s.read()
  s.v.free()
  _n: = length<|I32|>(1) + length<|U8|>(2) + "ab".kept()
// ==== case free_written_twice
//< [H0303] `defer x.free()` right after the declaration of `x`, which `defer` in front says once
//< **One spelling for one cleanup.** Another cleanup (`unlock`, `wait`) keeps its own line, and so
//< does a free with a statement between.
// EXPECT: free_written_twice.kspl:10:3: hint: [H0303] 'defer b.free()' follows the declaration of 'b'. Put 'defer' in front of the declaration instead ('defer $b: = …'), and remove this line.
// EXPECT: 0 error(s), 0 warning(s), 0 information(s), and 1 hint(s)
import "std/str" { Str_builder }

priv fn twice(): Sz
  $b: = Str_builder()
  defer b.free()
  b.s("x")
  return b.len

priv fn once(): Sz
  defer $b: = Str_builder()
  b.s("x")
  return b.len

fn main()
  _a: = twice()
  _b: = once()
// ==== case trait_value_kept_by_container
//< [W0110] A container's `Self$@` method keeps a trait value made from local storage
//< `xs.push(sq)` makes the trait value from `sq` with no `@` written, and the list keeps its
//< address. Behind a pointer, in a global, or in a local of an outer block, the list outlives
//< `sq`. **Four must stay silent**: a list in the same block as `sq`, a pointer upcast, a call that
//< only reads (`show(sq)`), and a `Self$@` method of a type that holds no `Shape`.
// EXPECT: trait_value_kept_by_container.kspl:27:11: warning: [W0110]
// EXPECT: trait_value_kept_by_container.kspl:31:17: warning: [W0110]
// EXPECT: trait_value_kept_by_container.kspl:37:13: warning: [W0110]
// EXPECT: 0 error(s), 3 warning(s)
import "std/ds" { List }
import "std/mem" { Arena }

trait Shape
  fn area(r: Self): I32

struct Sq
  n: I32

impl Sq: Shape
  fn area(r: Self): I32
    return r.n * r.n

priv $g_shapes: List<|Shape|>$@ = null

priv fn into_param(xs: List<|Shape|>$@)
  sq: = Sq::{ .n = 2 }
  xs.push(sq)

priv fn into_global()
  sq: = Sq::{ .n = 3 }
  g_shapes.push(sq)

priv fn into_outer_local(arena: Arena$@): Sz
  $xs: = List<|Shape|>(arena)
  inner:
    sq: = Sq::{ .n = 4 }
    xs.push(sq)
  return xs.len

priv struct Painter
  total: I32

impl Painter
  fn paint(r: Self$@, s: Shape)
    r.total += s.area()

priv fn show(s: Shape): I32
  return s.area()

priv fn silent(arena: Arena$@): I32
  sq: = Sq::{ .n = 5 }
  $xs: = List<|Shape|>(arena)
  xs.push(sq)
  xs.push(arena.create(Sq::{ .n = 6 }))
  $p: = Painter::{ .total = 0 }
  p.paint(sq)
  return xs[0].area() + show(sq) + p.total

fn main()
  defer arena: = Arena(4096)
  g_shapes = arena.create(List<|Shape|>(arena))
  $xs: = List<|Shape|>(arena)
  into_param(xs@)
  into_global()
  _n: = into_outer_local(arena)
  _m: = silent(arena)
// ==== case view_after_change
//< [W0111] A view used after a call that may move or release the memory it points into
//< The example of "What invalidates a view" in the language specification: a list's element
//< after a push, and an arena's text after a reset, are findings; a view taken after the push
//< is not.
// EXPECT: view_after_change.kspl:24:3: warning: [W0111] 'p' points into 'xs', which 'push' on line 23
// EXPECT: view_after_change.kspl:30:14: warning: [W0111] 's' points into 'arena', which 'reset' on line 29
// EXPECT-NOT: view_after_change.kspl:27:
// EXPECT: 0 error(s), 2 warning(s)
import "std/ds" { List }
import "std/io"
import "std/mem" { Arena }
import "std/str"

priv struct Point
  x: I32
  y: I32

fn main()
  defer arena: = Arena(4096)
  $xs: = List<|Point|>(arena)
  xs.push(Point::{ .x = 1, .y = 2 })
  p: = xs[0]@
  xs.push(Point::{ .x = 3, .y = 4 }) // may move every element
  p.x = 9 // MARK-p
  e: = xs[0]@
  e.x = 1
  e.y = 2 // MARK-e
  s: = arena.text().s("hi").take()
  arena.reset()
  io.out().s(s) // MARK-s
// ==== case view_across_flow
//< [W0111] follows a loop's back edge and a branch, and each kind of owner std marks
//< **The silent shapes must stay silent**: the view taken again, a view of another list, a copy
//< of an element, an `Rc` with another owner, and a pointer only compared.
// EXPECT: view_across_flow.kspl:28:5: warning: [W0111] 'p' points into 'xs', which 'push' on line 29
// EXPECT: view_across_flow.kspl:35:17: warning: [W0111] 'v' points into 'xs', which 'push' on line 34
// EXPECT: view_across_flow.kspl:42:14: warning: [W0111] 'v' points into 'b', which 's' on line 41
// EXPECT: view_across_flow.kspl:45:3: warning: [W0111] This 'for … in' walks 'm', which the write into 'm[…]' on line 46
// EXPECT: view_across_flow.kspl:52:3: warning: [W0111] 'p' points into 'r', whose old value the new one given on line 51
// EXPECT-NOT: view_across_flow.kspl:58:
// EXPECT-NOT: view_across_flow.kspl:63:
// EXPECT-NOT: view_across_flow.kspl:70:
// EXPECT-NOT: view_across_flow.kspl:75:
// EXPECT-NOT: view_across_flow.kspl:82:
// EXPECT-NOT: view_across_flow.kspl:88:
// EXPECT: 0 error(s), 5 warning(s)
import "std/ds" { List, Map }
import "std/io"
import "std/mem" { Arena }
import "std/refcount" { Rc }
import "std/str"

priv struct Node
  v: I32

priv fn in_loop(xs: List<|I32|>$@, n: I32) //< a view kept over a loop whose body grows the list
  p: = xs[0]@
  for i in Range.asc(n)
    p$ += 1 // MARK-loop
    xs.push(I32::i)

priv fn in_branch(xs: List<|I32|>$@, grow: Bool) //< one branch grows the list
  v: = xs.slice()
  if grow
    xs.push(1)
  io.out().s("\{v[0]\}\n") // MARK-branch

priv fn builder_slice() //< a builder's view, then a write that grows the builder
  defer $b: = str.Str_builder()
  b.s("ab")
  v: = b.slice()
  b.s("cd")
  io.out().s(v) // MARK-builder

priv fn map_walk(m: Map<|I32, I32|>$@) //< a walk over a map that sets a pair
  for e in m.items() // MARK-map
    m[e.key + 1] = e.value

priv fn rc_replaced() //< the last owner given a new value frees the old one
  $r: = Rc<|Node|>(Node::{ .v = 1 })
  p: = r.get()
  r = Rc<|Node|>(Node::{ .v = 2 })
  p.v = 9 // MARK-rc

priv fn taken_again(xs: List<|I32|>$@) //< the view taken again after the push (silent)
  $p: = xs[0]@
  xs.push(2)
  p = xs[0]@
  p$ = 3 // SILENT-1

priv fn other_list(xs: List<|I32|>$@, ys: List<|I32|>$@) //< a view of another list (silent)
  p: = ys[0]@
  xs.push(2)
  p$ = 3 // SILENT-2

priv fn each_branch_retakes(xs: List<|I32|>$@, grow: Bool) //< taken again where it grew (silent)
  $v: = xs.slice()
  if grow
    xs.push(1)
    v = xs.slice()
  io.out().s("\{v[0]\}\n") // SILENT-3

priv fn copied_value(xs: List<|I32|>$@) //< a copy of the element, not its address (silent)
  e: = xs[0]
  xs.push(2)
  io.out().s("\{e\}\n") // SILENT-4

priv fn rc_shared() //< another owner keeps the value alive (silent)
  $r: = Rc<|Node|>(Node::{ .v = 1 })
  keep: = r.clone()
  p: = r.get()
  r = Rc<|Node|>(Node::{ .v = 2 })
  p.v = keep.get().v // SILENT-5

priv fn compared(a: Arena$@) //< a pointer compared, not read through (silent)
  mark: = a.save()
  first: = a.alloc(16)
  a.restore(mark)
  assert(a.alloc(16) == first, "the same place") // SILENT-6

fn main()
  defer arena: = Arena(4096)
  $xs: = List<|I32|>(arena)
  xs.push(1)
  $ys: = List<|I32|>(arena)
  ys.push(1)
  $m: = Map<|I32, I32|>(arena)
  m[1] = 2
  in_loop(xs@, 3)
  in_branch(xs@, true)
  builder_slice()
  map_walk(m@)
  rc_replaced()
  taken_again(xs@)
  other_list(xs@, ys@)
  each_branch_retakes(xs@, true)
  copied_value(xs@)
  rc_shared()
  compared(arena)

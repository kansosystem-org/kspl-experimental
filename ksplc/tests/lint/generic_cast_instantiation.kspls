//< Two forms that look like findings under a generic instantiation, but are not
//<
//< Following either would stop the build (ksplc/docs/DESIGN.md §11.4 / is_instantiating in
//< ksplc/sema/session/ctx.kspls): `F32$@::a` is an identity cast at T=F32 but a real pointer
//< conversion at T=F64, and the `if sizeof(T) == 4` branch only looks empty once constant-folded.
// EXPECT-NOT: [I0301]
// EXPECT-NOT: [I0307]
import "std/io"

priv fn pick<|T|>(a: T$@): F64
  // It takes the value into a variable once rather than returning in the branch because, in
  // an instantiation where the condition is constant-folded, the dead branch's content is dropped
  // entirely, so putting a `return` in the branch becomes a different error, "there is a road that
  // does not return".
  $v: F64 = 0.0
  if sizeof(T) == 4
    v = F64::(F32$@::a)$
  else
    v = (F64$@::a)$
  return v

fn main(): I32
  v32: F32 = F32::2.5
  v64: F64 = 2.5
  io.out().s("\{I32::(pick(v32@) + pick(v64@))\}").c('\n')
  return 0

//< A typedef and its type, or two typedefs of one type, mix without a warning
//<
//< A typedef is only another name for its type ("3.5 Typedefs (`typedef`)" in
//< `docs/SPEC-language.md`), as in C, Rust and Swift. A type the compiler keeps apart from another
//< is a struct with one field.
// EXPECT-NOT: warning:
pub typedef Meters = I32
pub typedef Seconds = I32

pub enum Shade
  light
  dark

pub typedef Tone = Shade

priv fn travel(distance: Meters): Meters
  return distance * 2

priv fn pick(on: Bool): Tone
  if on
    return Shade.dark
  return Tone.light

pub fn probe(): Meters
  t: Seconds = 3
  raw: I32 = travel(t)
  if pick(true) == Shade.dark
    return raw
  return 0

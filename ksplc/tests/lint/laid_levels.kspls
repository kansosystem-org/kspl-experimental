//< A per-file `##lint(CODE = level)` takes effect in the indentation notation too
//<
//< It takes effect on a diagnostic raised from the pipeline too: the orphan `//<` below draws one.
//< [I0307] still comes out, so a file silent for another reason cannot pass for this suppression.
//< Note: **The ragged column has no code to switch off**: `../negative/laid_ragged_sibling.kspls`.
// EXPECT-NOT: [W0209]
// EXPECT: [I0307]
##lint(W0209 = off)
import "std/io"

priv struct Row
  priv a: I64 //< how many came in

  //< a run with no `//<` above it to continue
  priv b: I64 //< how many were kept

fn main(): I32
  r: Row = ::{ .a = 1, .b = 2 }
  if 1 < 0 {}
  io.out().s("kept \{r.b\} of \{r.a\}\n")
  return 0

//< An inner call that fits on one line is no tangle, even when the outer argument list wraps
//<
//< Pulling it out would leave the readability unchanged and merely add one line.
//< Caution: The outer must be long enough that the wrap survives formatting (`make fmt` folds a
//< call that fits the column width onto one line), or the silence only says "it did not wrap".
// EXPECT-NOT: [H0802]
priv fn detail_of(n: I32): I32
  return n + 1

fn main(): I32
  return report(1)

priv fn record_one_outcome(_label_of_the_case: U8[], passed: Bool, detail_value: I32): I32
  return detail_value if passed else 0 - detail_value

priv fn report(some_incoming_value: I32): I32
  return record_one_outcome("this spelling holds enough length to wrap", some_incoming_value > 0,
    detail_of(some_incoming_value))

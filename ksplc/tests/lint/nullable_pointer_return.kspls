//< A raw pointer return that may be null gives no hint, even when the receiver forgets to check
//<
//< Advice must come out drawing it towards an Option.
// EXPECT: [H0704] Function
import "std/mem" { Arena }

pub struct Cell
  pub v: I32

pub fn find(arena: Arena$@, want: Bool): Cell$@
  if !want
    return null
  return arena.create(Cell::{ .v = 1 })

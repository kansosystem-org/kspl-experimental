//< Control-flow spellings that mean nothing
// EXPECT: [I0304] Redundant 'default' case
// EXPECT: [I0703] Redundant error propagation
// EXPECT: [I0306] Redundant 'continue' at the end of a loop block
import "std/io"

pub enum Color
  red
  green

pub enum Probe_error
  failed

priv fn may_fail(): I32?Probe_error
  return 1

pub fn all_covered(c: Color): I32
  switch c case .red
    return 1
  case .green
    return 2
  default
    return 0

pub fn rethrows(): I32?Probe_error
  v: = may_fail() catch e
    throw e
  return v

pub fn loops(n: Sz): Sz
  $total: Sz = 0
  for i in Range.asc(n)
    total += i
    continue
  return total

//< Names: aliases, imports, shadowing, `pub` and `$`
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case alias_is_only_a_name
//< A typedef and its type, or two typedefs of one type, mix without a warning
//<
//< A typedef is only another name for its type ("3.5 Typedefs (`typedef`)" in
//< `docs/SPEC-language.md`), as in C, Rust and Swift. A type the compiler keeps apart from another
//< is a struct with one field.
// EXPECT-NOT: warning:
pub typedef Meters = I32
pub typedef Seconds = I32

pub enum Shade
  light
  dark

pub typedef Tone = Shade

priv fn travel(distance: Meters): Meters
  return distance * 2

priv fn pick(on: Bool): Tone
  if on
    return Shade.dark
  return Tone.light

pub fn probe(): Meters
  t: Seconds = 3
  raw: I32 = travel(t)
  if pick(true) == Shade.dark
    return raw
  return 0
// ==== case alias_to_option_binds
//< `if name: = expression` unwraps an alias of `Option` just as it unwraps `Option` itself
//<
//< The check reads the resolved name (`ksplc/sema/body/switch.kspls`), as a `switch` on the same
//< value does.
// EXPECT-NOT: binds an 'Option'
pub typedef Opt_i = I32?

priv fn pick(on: Bool): Opt_i
  if !on
    return .none
  return .some(7)

pub fn probe(): I32
  if v: = pick(true)
    return v
  return 0
// ==== case deprecated_symbol
//< Using a declaration marked `#deprecated` must be reported
//<
//< If nothing happens although it is attached, there is no point in writing the mark.
//< **An `enum` is in scope too**: its name appears in an expression as `E.a`, so the warning
//< reaches it (is_allowed_on in ksplc/sema/decl/attrs.kspls); `trait` / `typedef` do not.
// EXPECT: [W0702] Symbol 'old_way'
// EXPECT: [W0702] Symbol 'Old_kind'
import "std/io"

#deprecated
priv fn old_way(): I32
  return 1

#deprecated
pub enum Old_kind
  a
  b

pub fn probe(): I32
  k: = Old_kind.a
  return old_way() + I32::k
// ==== case hand_rolled_ownership
//< A struct holding a raw pointer and managing its lifetime with a `free` of its own
//<
//< Under the managed way of thinking, advice comes out drawing it towards a reference-counted
//< holder.
// ARGS: --lint=I0602=on
// EXPECT: [I0602] Struct
import "std/io"
import "std/mem"

struct Buffer
  data: U8$@
  len: Sz

impl Buffer
  fn free(r: Self$@)
    if r.data != null
      mem.dealloc(Void$@::r.data)
      r.data = null

pub fn probe(): Sz
  $b: = Buffer::{ .data = null, .len = 0 }
  defer b.free()
  return b.len
// ==== case local_hides_module
//< A local or a parameter with an imported module's name hides it for the rest of its scope
//<
//< KSPL reaches a module's member and a value's with the same `.`, so below the local an `io.out()`
//< reads the local and fails as a missing member, far from the cause. Quiet: a name no import binds
//< (`std/mem` as `{ Arena }` binds `Arena` alone), the prelude's `lang`, and a name led by `_`.
// EXPECT: local_hides_module.kspls:15:15: warning: [W0502] 'json' hides the imported module
// EXPECT: local_hides_module.kspls:25:3: warning: [W0502] 'io' hides the imported module
// EXPECT-NOT: 'mem' hides
// EXPECT-NOT: 'lang' hides
// EXPECT-NOT: '_io' hides
import "std/io"
import "std/json"
import "std/mem" { Arena }

priv fn shown(json: I32): I32 //< a parameter named as a module
  return json + 1

pub fn main(): I32
  arena: = Arena.new(1024)
  defer arena.free()
  io.out().s(json.Val.null_val.as_str())
  mem: = 3
  lang: = 4
  _io: = 5
  io: = shown(mem + lang + _io)
  return io
// ==== case naming_and_shadowing
//< The naming conventions, and an inner declaration that hides an outer one
//<
//< With both, a reader mistakes "which declaration am I looking at".
// EXPECT: [I0501] Declaration of
// EXPECT: [I0502] Type name
// EXPECT: [I0601] Parameter
pub struct badName
  pub v: I32

pub fn probe($never_reassigned: I32): I32
  outer: I32 = 1
  if never_reassigned > 0
    // The same name as the outer local.
    outer: I32 = 2
    return outer
  b: = badName::{ .v = outer }
  return b.v
// ==== case shadowed_known_trait
//< Declaring, in one's own file, a trait named like one the compiler knows, and conforming to it
//<
//< A known trait is matched by FQN, so ARC's retain/release are not inserted, and that fact appears
//< nowhere but in this diagnostic.
// EXPECT: [W0501]
// EXPECT: shadows the compiler-known 'std.lang.Ref_counted'
// EXPECT-NOT: error:
import "std/io"

priv trait Ref_counted
  priv fn retain(r: Self)
  priv fn release(r: Self)

struct Node
  n: I32

impl Node: Ref_counted
  priv fn retain($_r: Self$@) {}

  priv fn release($_r: Self$@) {}

pub fn probe(): I32
  a: Node = ::{ .n = 1 }
  b: = a
  io.out().s("shadowed\n")
  return b.n
// ==== case spare_mut_marker
//< A `$` before the name is spare where the name's own value is never rewritten
//<
//< A write through a pointer or into a slice's elements is allowed by the type's `$` (`T$@`,
//< `T$[]`), and a read or a `Self@` call needs no `$` at all. Kept: a fixed-length array's element
//< and a struct's field are part of the value, and `x@`, `U8$[]::buf` and a `Self$@` call hand that
//< value out writable.
// EXPECT: spare_mut_marker.kspls:26:4: information: [I0601] Binding 'target'
// EXPECT: spare_mut_marker.kspls:30:4: information: [I0601] Binding 'view'
// EXPECT: spare_mut_marker.kspls:34:4: information: [I0601] Binding 'peek'
// EXPECT: spare_mut_marker.kspls:38:4: information: [I0601] Binding 'rows'
// EXPECT: spare_mut_marker.kspls:42:4: information: [I0601] Binding 'probe'
// EXPECT-NOT: Binding 'cells'
// EXPECT-NOT: Binding 'backing'
// EXPECT-NOT: Binding 'spot'
// EXPECT-NOT: Binding 'tally'
pub struct Tally
  pub n: I32

impl Tally
  pub fn bump(r: Self$@) //< adds one
    r.n += 1
  pub fn get(r: Self@): I32 //< the count
    return r.n

pub fn through_pointer(n: I32$@)
  $target: = n
  target$ = 5

pub fn into_slice(buf: U8$[])
  $view: = buf
  view[0] = 7

pub fn read_through(n: I32@): I32
  $peek: = n
  return peek$

pub fn element_method(ts: Tally$[])
  $rows: = ts
  rows[0].bump()

pub fn reading_method(): I32
  $probe: = Tally::{ .n = 1 }
  return probe.get()

pub fn array_element(): I32
  $cells: = I32[2]::{ 1, 2 }
  cells[0] = 3
  return cells[1]

pub fn writable_view(): U8
  $backing: = U8[4]::{ 0, 0, 0, 0 }
  bytes: = U8$[]::backing
  bytes[0] = 1
  return backing[0]

pub fn address_out(): I32
  $spot: I32 = 1
  through_pointer(spot@)
  return spot

pub fn value_method(): I32
  $tally: = Tally::{ .n = 1 }
  tally.bump()
  return tally.n
// ==== case unit_internal_pub
//< The case where [I0402] finds a `pub` used only from inside the package
//<
//< It is off by default, so it is enabled with ARGS. `main` and names opening with `_` are out of
//< scope, so that they stay quiet is looked at too.
// ARGS: --lint=I0402=on
// EXPECT: [I0402] Public symbol 'inner_only'
// EXPECT-NOT: [I0402] Public symbol 'main'
import "std/io"

pub const inner_only: I64 = 3

fn main(): I32
  io.out().s("\{inner_only\}\n")
  return 0
// ==== case unused_import_alias
//< Whether an import alias is unused is decided within **that one file**
//<
//< Whether another file uses the same target has nothing to do with it. `std/math` is never written
//< in this file (another file of this compilation unit does use it). `strfmt` is written, so it
//< must not sound (pinning down the suppressing side).
// EXPECT: [I0401] Unused import alias 'mth'
// EXPECT-NOT: [I0401] Unused import alias 'strfmt'
import "std/io"
import "std/math" as mth
import "std/strfmt"

fn main(): I32
  // Choose a function called with the alias in front: it pins the alias being written, where a
  // method call would pin the import that makes the call hold.
  strfmt.write_int(io.out(), 0, 1).c('\n')
  return 0
// ==== case unused_import_alias_named_like
//< An import alias counts as used only where it heads a qualified name
//<
//< A field or a function spelled like the alias is not the alias: counted, a dead import goes
//< unreported for as long as the file keeps a member of that name. `strfmt` is written as a head,
//< beside a field of the same name, so it must not sound (pinning down the suppressing side).
// EXPECT: [I0401] Unused import alias 'strnum'
// EXPECT: [I0401] Unused import alias 'math'
// EXPECT-NOT: [I0401] Unused import alias 'strfmt'
import "std/io"
import "std/math"
import "std/strfmt"
import "std/strnum"

struct Row
  strnum: I32
  strfmt: I32

fn math(): I32
  return 1

fn main(): I32
  r: = Row::{ .strnum = 1, .strfmt = 2 }
  strfmt.write_int(io.out(), r.strnum + r.strfmt + math(), 1).c('\n')
  return 0
// ==== case unused_import_in_template
//< Whether an import is unused is decided only by whether that file **writes** the name
//<
//< An uninstantiated generic body is not analysed, so marking use as a by-product of resolution
//< swings the same import between used and unused by what is compiled alongside. `hex` is used only
//< in Box.get, never instantiated here; `Hex_fmt` is written nowhere, so it must sound.
// EXPECT-NOT: [I0401] Unused import symbol 'hex'
// EXPECT: [I0401] Unused import symbol 'Hex_fmt'
import "std/strfmt" { hex, Hex_fmt }

struct Box<|T|>
  v: T

impl<|T|> Box<|T|>
  fn get(r: Self$@, ok: Bool): T
    if !ok
      _h: = hex(1, 2)
      panic("Box.get: not ok")
    return r.v

fn main(): I32
  return 0

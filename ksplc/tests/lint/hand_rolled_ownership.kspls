//< A struct holding a raw pointer and managing its lifetime with a `free` of its own
//<
//< Under the managed way of thinking, advice comes out drawing it towards a reference-counted
//< holder.
// ARGS: --lint=I0603=on
// EXPECT: [I0603] Struct
import "std/io"
import "std/mem"

struct Buffer
  data: U8$@
  len: Sz

impl Buffer
  fn free(r: Self$@)
    if r.data != null
      mem.dealloc(Void$@::r.data)
      r.data = null

pub fn probe(): Sz
  $b: = Buffer::{ .data = null, .len = 0 }
  defer b.free()
  return b.len

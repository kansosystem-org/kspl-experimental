//< A `$` before the name is spare where the name's own value is never rewritten
//<
//< A write through a pointer or into a slice's elements is allowed by the type's `$` (`T$@`,
//< `T$[]`), and a read or a `Self@` call needs no `$` at all. Kept: a fixed-length array's element
//< and a struct's field are part of the value, and `x@`, `U8$[]::buf` and a `Self$@` call hand that
//< value out writable.
// EXPECT: spare_mut_marker.kspls:26:4: information: [I0601] Binding 'target'
// EXPECT: spare_mut_marker.kspls:30:4: information: [I0601] Binding 'view'
// EXPECT: spare_mut_marker.kspls:34:4: information: [I0601] Binding 'peek'
// EXPECT: spare_mut_marker.kspls:38:4: information: [I0601] Binding 'rows'
// EXPECT: spare_mut_marker.kspls:42:4: information: [I0601] Binding 'probe'
// EXPECT-NOT: Binding 'cells'
// EXPECT-NOT: Binding 'backing'
// EXPECT-NOT: Binding 'spot'
// EXPECT-NOT: Binding 'tally'
pub struct Tally
  pub n: I32

impl Tally
  pub fn bump(r: Self$@) //< adds one
    r.n += 1
  pub fn get(r: Self@): I32 //< the count
    return r.n

pub fn through_pointer(n: I32$@)
  $target: = n
  target$ = 5

pub fn into_slice(buf: U8$[])
  $view: = buf
  view[0] = 7

pub fn read_through(n: I32@): I32
  $peek: = n
  return peek$

pub fn element_method(ts: Tally$[])
  $rows: = ts
  rows[0].bump()

pub fn reading_method(): I32
  $probe: = Tally::{ .n = 1 }
  return probe.get()

pub fn array_element(): I32
  $cells: = I32[2]::{ 1, 2 }
  cells[0] = 3
  return cells[1]

pub fn writable_view(): U8
  $backing: = U8[4]::{ 0, 0, 0, 0 }
  bytes: = U8$[]::backing
  bytes[0] = 1
  return backing[0]

pub fn address_out(): I32
  $spot: I32 = 1
  through_pointer(spot@)
  return spot

pub fn value_method(): I32
  $tally: = Tally::{ .n = 1 }
  tally.bump()
  return tally.n

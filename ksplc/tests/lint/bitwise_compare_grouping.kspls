//< Comparing `&`'s result without brackets
//<
//< KSPL puts `&` at the same step as multiplication so it reads `(a & b) == c`, while C reads the
//< same expression as `a & (b == c)`. It passes yet the answer changes, so [W0109] gives notice.
// EXPECT: [W0109]
// EXPECT: bind tighter than comparison in KSPL
// EXPECT-NOT: error:
import "std/io"

pub fn probe(a: I32, b: I32, c: I32): I32
  $hits: I32 = 0
  if a & b == c
    hits += 1
  if a == b & c
    hits += 1
  // The shape with the brackets written is out of scope (the grouping can be read from the
  // spelling).
  if (a & b) == c
    hits += 1
  io.out().s("\{hits\}\n")
  return hits

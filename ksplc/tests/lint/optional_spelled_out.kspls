//< An optional the source spells out as `Option<|T|>` gets [H0303], which asks for `T?`
//<
//< Every place a type is written is reported: a field, a `typedef`'s right side, a parameter, a
//< return type, a type argument (an expression's included) and a grouped result or function type.
//< An expression whose head is `Option` keeps the long form, as `?` cannot stand there, and the
//< type `T?` folds into is not reported (`kept`, `short` and `held`).
// EXPECT: optional_spelled_out.kspls:25:9: hint: [H0303]
// EXPECT: optional_spelled_out.kspls:27:17: hint: [H0303]
// EXPECT: optional_spelled_out.kspls:29:20: hint: [H0303]
// EXPECT: optional_spelled_out.kspls:29:36: hint: [H0303]
// EXPECT: optional_spelled_out.kspls:34:18: hint: [H0303]
// EXPECT: optional_spelled_out.kspls:37:17: hint: [H0303]
// EXPECT: optional_spelled_out.kspls:47:20: hint: [H0303]
// EXPECT-NOT: optional_spelled_out.kspls:41:
// EXPECT-NOT: optional_spelled_out.kspls:48:
// EXPECT-NOT: optional_spelled_out.kspls:52:

import "std/ds" { List }
import "std/mem" { Arena }

enum Fault
  lost

struct Slot<|T|>
  held: Option<|T|>

typedef Maybe = Option<|I32|>

priv fn doubled(x: Option<|I32|>): Option<|I32|>
  if v: = x
    return .some(v * 2)
  return .none

priv fn tried(): Option<|I32!Fault|>
  return .none

priv fn step(): Option<|fn(n: I32): I32|>
  return .none

impl<|T|> Slot<|T|>
  priv fn kept(r: Self): T?
    return r.held

priv fn empty(): Sz
  arena: = Arena.new(4096)
  defer arena.free()
  spelled: = List<|Option<|F32|>|>.create(arena)
  short: = List<|F32?|>.create(arena)
  return spelled.len + short.len

fn main(): I32
  held: = Option<|I32|>.some(1)
  slot: = Slot<|I32|>::{ .held = held }
  none: Maybe = .none
  if doubled(none).is_some() || tried().is_some() || step().is_some()
    return 1
  return I32::empty() + slot.kept().unwrap_or(0)

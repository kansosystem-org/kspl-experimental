//< Redundancy: casts, booleans, control flow and aliases with no effect
//< Each case below is compiled alone, as the file its head names.
// ==== case const_weakening_cast
//< A cast that only drops the write permission (`$`) is a finding
//< The weakening from `U8$[]` to `U8[]` is done implicitly by the language ("6.4 Type conversion
//< (`::`) and implicit casts" in `docs/SPEC-programming-language.md`), so writing it does nothing.
// EXPECT: [I0301]
import "std/io"
import "std/mem" { Arena }

priv fn len_of(s: U8[]): Sz
  return s.len

fn main(): I32
  arena: = Arena.new(4096)
  defer arena.free()
  buf: U8$[] = arena.dup_str("kanso")
  io.out().s("\{len_of(U8[]::buf)\}").c('\n')
  return 0
// ==== case const_weakening_cast_binding
//< On a binding with no type annotation it is not a finding
//< The cast here settles the binding's own type, and taking it away makes `b` a `U8$[]` — the
//< declaration that said "it is not rewritten" vanishes.
// EXPECT-NOT: [I0301]
import "std/io"
import "std/mem" { Arena }

fn main(): I32
  arena: = Arena.new(4096)
  defer arena.free()
  b: = U8[]::arena.dup_str("kanso")
  io.out().s("\{b.len\}").c('\n')
  return 0
// ==== case directive_warning
//< `##warning(cond, msg)` reports a warning where cond is false, and the analysis goes on
//< The wording is the user's own, so it is given no diagnostic code — if `##lint` could silence it,
//< the assertion would have no point.
// EXPECT: warning: Sz must be 2 bytes
// EXPECT-NOT: this must stay quiet
##warning(sizeof(Sz) == 2, "Sz must be 2 bytes")
##warning(sizeof(Sz) >= 4, "this must stay quiet")

fn main(): I32
  return 0
// ==== case generic_cast_instantiation
//< Two forms that look like findings under a generic instantiation, but are not
//< Following either would stop the build (ksplc/docs/DESIGN-diagnostics.md "No diagnostic that
//< depends on a generic's type argument" / is_instantiating in
//< ksplc/sema/session/ctx.kspl). `F32$@::a` is an identity cast at T=F32 but a real pointer
//< conversion at T=F64. The `if sizeof(T) == 4` branch only looks empty once constant-folded.
// EXPECT-NOT: [I0301]
// EXPECT-NOT: [I0307]
import "std/io"

priv fn pick<|T|>(a: T$@): F64
  // It takes the value into a variable once rather than returning in the branch. In an
  // instantiation where the condition is constant-folded, the dead branch's content is dropped
  // entirely. So a `return` in the branch becomes a different error, "there is a road that
  // does not return".
  $v: F64 = 0.0
  if sizeof(T) == 4
    v = F64::(F32$@::a)$
  else
    v = (F64$@::a)$
  return v

fn main(): I32
  v32: F32 = F32::2.5
  v64: F64 = 2.5
  io.out().s("\{I32::(pick(v32@) + pick(v64@))\}").c('\n')
  return 0
// ==== case lint_levels
//< A per-file `##lint(CODE = level)` takes effect
//< off suppresses a code, and on enables a code that is off by default ([W0601] of the old
//< deterministic profile is one such).
// EXPECT-NOT: [I0305]
// EXPECT: [W0601]
##lint(I0305 = off, W0601 = on)
import "std/refcount" { Rc }

priv fn ends_with_return(): Void
  return

fn main()
  r: = Rc<|I32|>.new(1)
  _x: = r
  ends_with_return()
// ==== case plain_cast_still_reported
//< A "really redundant cast" outside a generic is still a finding
//< It pins down that only being inside a generic instantiation was taken out of scope, and that
//< [I0301] itself was not weakened.
// EXPECT: [I0301]
import "std/io"

fn main(): I32
  n: Sz = 3
  m: Sz = Sz::n
  io.out().s("\{m\}").c('\n')
  return 0
// ==== case redundant_boolean
//< Redundant spellings around booleans
//< The meaning does not change so they pass in silence, but the reader is left hunting for "was
//< something meant by this".
// EXPECT: [I0302] Unnecessary boolean comparison
// EXPECT: [I0303] Redundant logical operation with a boolean literal
// EXPECT: [I0308] Redundant if-return for boolean
pub fn compares(b: Bool): Bool
  return b == true

pub fn ands(b: Bool): Bool
  return b && true

pub fn if_returns(n: I32): Bool
  if n > 0
    return true
  else
    return false
// ==== case redundant_control_flow
//< Control-flow spellings that mean nothing
// EXPECT: [I0304] Redundant 'default' case
// EXPECT: [I0701] Redundant error propagation
// EXPECT: [I0306] Redundant 'continue' at the end of a loop block
import "std/io"

pub enum Color
  red
  green

pub enum Probe_error
  failed

priv fn may_fail(): I32!Probe_error
  return 1

pub fn all_covered(c: Color): I32
  switch c case .red
    return 1
  case .green
    return 2
  default
    return 0

pub fn rethrows(): I32!Probe_error
  v: = may_fail() catch e
    throw e
  return v

pub fn loops(n: Sz): Sz
  $total: Sz = 0
  for i in Range.asc(n)
    total += i
    continue
  return total
// ==== case redundant_deref
//< `.` follows a pointer automatically, so an explicit `$` is unnecessary
// EXPECT: [I0309] Unnecessary explicit '$' dereference
import "std/io"
import "std/mem" { Arena }

struct Cell
  v: I32

pub fn probe(arena: Arena$@): I32
  c: = arena.create(Cell::{ .v = 3 })
  return c$.v
// ==== case redundant_import_alias
//< An `as` naming the path's own tail adds nothing, since an unmarked import derives that alias
//< It lets the same thing be written two ways, so [I0310] reports it.
//< Caution: **Do not make a derived alias a finding.** An unmarked import goes onto the ledger
//< under the same name too, so the name alone says "remove the `as`" where there is no `as`.
// EXPECT: [I0310] Redundant 'as io'
// EXPECT-NOT: [I0310] Redundant 'as base_fmt'
// EXPECT-NOT: [I0310] Redundant 'as _seq'
import "std/io" as io
import "std/seq" as _seq
import "std/strfmt" as base_fmt

pub fn probe(): Sz
  $n: Sz = 0
  for i in Range.asc(3)
    n += i
  // Hex_fmt is a thin wrapper only for placing into an interpolation; it neither
  // allocates nor frees.
  io.out().s("n=\{n\} h=\{base_fmt.hex(255, 2)\}").c('\n')
  return n + "abc".len
// ==== case lang_prefix_changes_nothing
//< `lang.` before a name the file can write alone changes nothing
//< It stays where the bare name is blocked: by the file's own declaration, or by a local.
// EXPECT: lang_prefix_changes_nothing.kspl:10:19: information: [I0312] 'lang.Panic_msg'
// EXPECT: lang_prefix_changes_nothing.kspl:23:5: information: [I0312] 'lang.panic'
// EXPECT-NOT: 'lang.Range'
// EXPECT-NOT: 'lang.assert'
priv struct Range //< this file's own `Range`, which blocks the bare name
  n: I32

priv fn length(m: lang.Panic_msg$@): Sz
  return m.slice().len

priv fn steps(_r: lang.Range, own: Range): I32
  return own.n

priv fn shadowed(assert: I32): I32 //< the parameter blocks the bare `assert`
  lang.assert(assert > 0, "positive")
  return assert

fn main(): I32
  $m: = Panic_msg.new()
  if length(m@) > 0
    lang.panic("not empty")
  return steps(lang.Range.asc(1), Range::{ .n = 2 }) + shadowed(1)
// ==== case payload_nothing_reads
//< A case that reads nothing its payload binds needs no brackets
//< A discarding name (`_a`) is a binding nobody reads. A payload with one name read stays. So
//< does the binding the compiler writes for `if v: = …`.
// EXPECT: payload_nothing_reads.kspl:17:10: information: [I0313]
// EXPECT: payload_nothing_reads.kspl:26:10: information: [I0313]
// EXPECT-NOT: [W0207]
// EXPECT-NOT: payload_nothing_reads.kspl:19:
// EXPECT-NOT: payload_nothing_reads.kspl:32:
priv enum Op
  add(a: I32, b: I32)
  neg(x: I32)
  stop

impl Op
  fn discards(r: Self): I32
    switch r
    case .add(_a, _b)
      return 1
    case .neg(x)
      return -x
    case .stop
      return 0

  fn unread(r: Self): I32
    switch r
    case .add(a, b)
      return 2
    default
      return 0

priv fn bound_by_if(o: I32?): I32
  if _v: = o
    return 1
  return 0

fn main(): I32
  return Op.stop.discards() + Op.neg(1).unread() + bound_by_if(.none)
// ==== case counting_loop_in_three_parts
//< A loop that only counts is written over a `Range`, or over the sequence it walks
//< Each finding names the form to write: `for x in xs` where the body reads only `xs[i]` or
//< `xs.get(i)`, `Range.asc` from 0, `Range.new` from another start.
// EXPECT: [I0314] This loop counts 'i' in three parts. Write 'for x in xs', and read each element
// EXPECT: [I0314] This loop counts 'k' in three parts. Write 'for x in ys', and read each element
// EXPECT: [I0314] This loop counts 'i' in three parts. Write 'for i in Range.asc(n * 2)'
// EXPECT: [I0314] This loop counts 'j' in three parts. Write 'for j in Range.new(1, n, 1)'
// EXPECT: [I0314] This loop counts 'i' in three parts. Write 'for i in Range.asc(out.len)'
import "std/ds" { List }
import "std/mem" { Arena }

priv fn sum(xs: I32[]): I32
  $t: I32 = 0
  for $i: = 0; i < xs.len; i += 1
    t += xs[i]
  return t

priv fn sum_list(ys: List<|I32|>$@): I32
  $t: I32 = 0
  for $k: = 0; k < ys.len; k += 1
    t += ys.get(k)
  return t

priv fn count(n: I32): I32
  $t: I32 = 0
  for $i: = 0; i < n * 2; i += 1
    t += i
  for $j: = 1; j < n; j += 1
    t += j
  return t

priv fn fill(out: I32$[])
  for $i: = 0; i < out.len; i += 1
    out[i] = 1

fn main(): I32
  arena: = Arena.new(4096)
  defer arena.free()
  a: I32[2] = ::{ 1, 2 }
  $b: I32[2] = ::{ 0, 0 }
  fill(I32$[]::b)
  return sum(I32[]::a) + sum_list(List<|I32|>.create(arena)) + count(2)
// ==== case counting_loop_that_must_stay
//< A loop whose body may change its index or its bound keeps the three parts, and is no finding
//< The body skips an element, shortens the bound, grows the list the bound reads, or hands the
//< list on to be written. A bound read from a global or a call is not vouched for either.
// EXPECT-NOT: [I0314]
import "std/ds" { List }
import "std/mem" { Arena }

priv $g_limit: I32 = 3

priv fn grow(xs: List<|I32|>$@)
  xs.push(0)

priv fn shapes(n: I32, xs: List<|I32|>$@): I32
  $t: I32 = 0
  for $i: = 0; i < n; i += 1
    if t > 3
      i += 1
    t += 1
  $m: = n
  for $i: = 0; i < m; i += 1
    m -= 1
  for $i: = 0; i < xs.len; i += 1
    if xs.get(i) > 3
      xs.push(1)
  for $i: = 0; i < xs.len; i += 1
    if i == 0
      grow(xs)
  for $i: = 0; i < g_limit; i += 1
    g_limit -= 1
  for $i: = 0; i < xs.len; i += 2
    t += 1
  for $i: = 0; i <= n; i += 1
    t += 1
  for x in Range.asc(xs.len)
    t += I32::x
  return t

fn main(): I32
  arena: = Arena.new(4096)
  defer arena.free()
  return shapes(2, List<|I32|>.create(arena))

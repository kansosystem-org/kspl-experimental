//< `if name: = expression` unwraps an alias of `Option` just as it unwraps `Option` itself
//<
//< The check reads the resolved name (`ksplc/sema/body/match.kspls`), as a `switch` on the same
//< value does.
// EXPECT-NOT: binds an 'Option'
pub typedef Opt_i = Option<|I32|>

priv fn pick(on: Bool): Opt_i
  if !on
    return Option<|I32|>.none
  return Option<|I32|>.some(7)

pub fn probe(): I32
  if v: = pick(true)
    return v
  return 0

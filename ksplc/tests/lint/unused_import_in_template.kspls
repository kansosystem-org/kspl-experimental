//< Whether an import is unused is decided only by whether that file **writes** the name
//<
//< An uninstantiated generic body is not analysed, so marking use as a by-product of resolution
//< swings the same import between used and unused by what is compiled alongside. `hex` is used only
//< in Box.get, never instantiated here; `Hex_fmt` is written nowhere, so it must sound.
// EXPECT-NOT: [I0401] Unused import symbol 'hex'
// EXPECT: [I0401] Unused import symbol 'Hex_fmt'
import "std/strfmt" { hex, Hex_fmt }

struct Box<|T|>
  v: T

impl<|T|> Box<|T|>
  fn get(r: Self$@, ok: Bool): T
    if !ok
      _h: = hex(1, 2)
      panic("Box.get: not ok")
    return r.v

fn main(): I32
  return 0

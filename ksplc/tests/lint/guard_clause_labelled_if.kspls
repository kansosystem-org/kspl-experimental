//< An `if` that a `break` to its own label leaves gets no guard-clause hint
//<
//< **`break ui` continues after the `if`**, so without the `else` its body would run after the
//< `break` as well, and a `break ui` inside the `else` would be left with no label. The functions
//< whose names begin with `kept_` hold such an `if` and are not reported. The others leave the
//< `if` in a way the code after it does not follow, so their `else` can go: a `return`, a `break`
//< or `continue` of the loop, a `break` of an enclosing label or `switch`, a call that does not
//< return, and an inner `if` that leaves on both sides (reported for both).
// EXPECT: guard_clause_labelled_if.kspls:47:3: hint: [H0801]
// EXPECT: guard_clause_labelled_if.kspls:56:5: hint: [H0801]
// EXPECT: guard_clause_labelled_if.kspls:65:5: hint: [H0801]
// EXPECT: guard_clause_labelled_if.kspls:76:5: hint: [H0801]
// EXPECT: guard_clause_labelled_if.kspls:87:5: hint: [H0801]
// EXPECT: guard_clause_labelled_if.kspls:95:3: hint: [H0801]
// EXPECT: guard_clause_labelled_if.kspls:102:3: hint: [H0801]
// EXPECT: guard_clause_labelled_if.kspls:103:5: hint: [H0801]
// EXPECT-NOT: guard_clause_labelled_if.kspls:21:3:
// EXPECT-NOT: guard_clause_labelled_if.kspls:31:3:
// EXPECT-NOT: guard_clause_labelled_if.kspls:38:3:
pub fn kept_after_return(c: Bool, d: Bool): I32
  ui: if c
    if d
      break ui
    return 1
  else
    return 2
  return 3

pub fn kept_last_is_break(c: Bool): I32
  $n: = 0
  ui: if c
    break ui
  else
    n = 1
  return n

pub fn kept_break_in_else(c: Bool, d: Bool): I32
  ui: if c
    return 1
  else
    if d
      break ui
    return 2
  return 3

pub fn returns(c: Bool): I32
  if c
    return 1
  else
    return 2

pub fn leaves_the_loop(n: I32): I32
  $i: = 0
  for i < n
    i += 1
    if i == 3
      break
    else
      i += 1
  return i

pub fn leaves_the_enclosing_label(c: Bool, d: Bool): I32
  $n: = 0
  outer: if c
    if d
      break outer
    else
      n = 1
    n += 1
  return n

pub fn leaves_the_enclosing_switch(e: I32, d: Bool): I32
  $n: = 0
  ui: switch e
  case 1
    if d
      break ui
    else
      n = 1
    n += 1
  default {}
  return n

pub fn continues_the_loop(n: I32): I32
  $s: = 0
  for $i: = 0; i < n; i += 1
    if i == 2
      continue
    else
      s += i
  return s

pub fn does_not_return(c: Bool): I32
  $n: = 0
  if c
    panic("stop")
  else
    n = 1
  return n

pub fn leaves_on_both_sides(c: Bool, d: Bool): I32
  if c
    if d
      return 1
    else
      return 2
  else
    return 3

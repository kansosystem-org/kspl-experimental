//< A function's name used as a value: bound with no type, passed to a generic parameter, compared
//< A non-generic function, a written specialization, a method named through its type (receiver
//< first) and an anonymous function each name one function. Each use takes that function's
//< type, on both backends.
//< Caution: **Keep each paired with the case in `tests/negative/fn.kspl` its section names.**
//< That case holds what is refused.
import "std/chars" as _std_chars // `U8.is_digit`, named as a value
import "std/ds" { List }
import "std/mem" + { dealloc }
import "std/verdict"

// ==========================================
// A declaration with no type takes the function type of the function a name names. The variadic
// function, the one name with no function type, is the case `fn_value_variadic_binding`.
// ==========================================
priv fn vb_twice(x: I32): I32
    return x * 2

priv fn vb_thrice(x: I32): I32
    return x * 3

priv fn vb_same<|T|>(x: T): T
    return x

priv struct Vb_box<|T|>
    v: T

impl<|T|> Vb_box<|T|>
    fn get(r: Self@): T
        return r.v

priv typedef Vb_op = fn(x: I32): I32

fn test_binding_takes_the_fn_type()
    verdict.start("[fn-ptr] a declaration with no type takes a function's own type test...")
    plain: = vb_twice
    assert(plain(21) == 42, "a non-generic function's name gives its type")
    spec: = vb_same<|I32|>
    assert(spec(7) == 7, "a written specialization gives the instance's type")
    b: = Vb_box<|I32|>::{ .v = 8 }
    get: = Vb_box<|I32|>.get
    assert(get(b@) == 8, "a method named through its type gives its type, the receiver first")
    anon: = fn(x: I32): I32
        return x + 1
    assert(anon(1) == 2, "an anonymous function gives its written type")
    $swap: = vb_twice
    swap = vb_thrice
    assert(swap(2) == 6, "the binding holds another function of the same type")
    typed: Vb_op = plain
    assert(typed == vb_twice && plain != spec, "it is the function type written out")
    verdict.pass("")

// ==========================================
// A function's name passed to a generic parameter binds `F` of `fn pass<|F|>(f: F)` to its type.
// Without it, `pass(gf<|U16|>)` was refused as giving no type. A bare generic name and a variadic
// function are refused: the case `fn_name_to_generic_parameter`.
// ==========================================
priv fn gp_size<|T|>(_x: T): Sz
    return 100 + sizeof(T)

priv fn gp_pass<|F|>(f: F): F
    return f

priv fn gp_twice(x: I32): I32
    return x * 2

priv struct Gp_box<|T|>
    v: T

impl<|T|> Gp_box<|T|>
    fn get(r: Self@): T
        return r.v
    fn pair<|U|>(_x: T, _y: U): Sz
        return 300 + sizeof(T) * 10 + sizeof(U)

fn test_name_to_generic_parameter()
    verdict.start("[fn-ptr] a function's name passed to a generic parameter test...")
    narrow: = gp_pass(gp_size<|U16|>)
    wide: = gp_pass(gp_size<|I64|>)
    assert(narrow(2) == 102, "the written specialization is the one passed")
    assert(wide(2) == 108, "another type argument passes another specialization")
    as_op: fn(x: U16): Sz = narrow
    assert(as_op == gp_size<|U16|>, "the parameter's type is the specialization's function type")
    plain: = gp_pass(gp_twice)
    assert(plain(21) == 42, "a non-generic function passes its own type")
    b: = Gp_box<|I32|>::{ .v = 8 }
    get: = gp_pass(Gp_box<|I32|>.get)
    assert(get(b@) == 8, "a method named through its type passes, its receiver first")
    pair: = gp_pass(Gp_box<|I32|>.pair<|U8|>)
    assert(pair(1, 2) == 341, "a generic method's specialization passes, both type arguments kept")
    anon: = gp_pass(fn(x: I32): I32 {
        return x + 1;
    })
    assert(anon(1) == 2, "an anonymous function passes its written type")
    verdict.pass("")

// ==========================================
// A function's name compared with `==` or `!=` takes the other side's function type, either order.
// Written on the left, the name was typed as its return type, and the LLVM IR compared an `i32`
// with a function's address. Two names and every other operator are refused: the case
// `fn_value_operators`.
// ==========================================
priv typedef Cmp_op = fn(x: I32): I32

priv fn cmp_twice(x: I32): I32
    return x * 2

priv fn cmp_thrice(x: I32): I32
    return x * 3

priv fn cmp_same<|T|>(x: T): T
    return x

priv struct Cmp_box<|T|>
    v: T

impl<|T|> Cmp_box<|T|>
    fn keep(x: T): T
        return x

priv struct Cmp_plain
    v: I32

impl Cmp_plain
    fn cmp_twice(x: I32): I32
        return x * 2

priv fn cmp_pick_wide(): fn(x: I64): I64
    return cmp_same<|I64|>

priv fn cmp_pick_thrice(): Cmp_op
    return cmp_thrice

fn test_name_compared_either_side()
    verdict.start("[fn-ptr] a function's name on either side of '==' test...")
    f: Cmp_op = cmp_twice
    assert(cmp_twice == f && f == cmp_twice, "a name compares in either order")
    assert(cmp_thrice != f && f != cmp_thrice, "'!=' too")
    g: Cmp_op = cmp_same<|I32|>
    assert(cmp_same<|I32|> == g && cmp_same<|I64|> == cmp_pick_wide(),
        "a specialization on the left")
    keep: Cmp_op = Cmp_box<|I32|>.keep
    assert(Cmp_box<|I32|>.keep == keep && Cmp_plain.cmp_twice != keep,
        "a method named through its type")
    k: = keep(1) == 1
    assert((cmp_thrice if k else cmp_twice) == cmp_pick_thrice(), "a choice between two names")
    n: Cmp_op = null
    assert(n == null && null != f, "a null check is unchanged")
    verdict.pass("")

// ==========================================
// Calling a function that **returns** a function pointer.
// A named function's symbol holds its return type in type_id. So judged by type alone `fn cb(): Cb`
// (Cb an alias of a function pointer) looks like a function pointer to call, mistyping `cb()`.
// ==========================================
priv typedef Cb_i32 = fn(): I32
priv typedef Cb_item = fn(): Fn_ptr_item

priv struct Fn_ptr_item
    v: I32

priv fn fn_ptr_source_i32(): I32
    return 9

priv fn fn_ptr_source_item(): Fn_ptr_item
    return Fn_ptr_item::{ .v = 21 }

priv fn returns_cb_i32(): Cb_i32
    return fn_ptr_source_i32

priv fn returns_cb_item(): Cb_item
    return fn_ptr_source_item

priv struct Cb_holder
    f: Cb_item

fn test_fn_returning_fn_ptr()
    verdict.start("[fn-ptr] a function returning a function pointer test...")

    // With a type annotation: the return type resolves to the alias itself.
    annotated: Cb_i32 = returns_cb_i32()
    assert(annotated() == 9, "a function returning a fn-pointer alias must yield the alias")

    // With no type annotation (the path prone to wrong C with zero diagnostics).
    inferred: = returns_cb_item()
    inferred_v: = inferred().v
    assert(inferred_v == 21,
        "an unannotated binding must take the fn-pointer type, not its return type")

    // An indirect call through a field holding a function pointer is still an indirect call.
    h: Cb_holder = ::{ .f = returns_cb_item() }
    assert(h.f().v == 21, "calling through a fn-pointer field must stay an indirect call")

    // The same for an indirect call through a function-pointer variable.
    via_var: Cb_i32 = fn_ptr_source_i32
    assert(via_var() == 9, "calling through a fn-pointer variable must stay an indirect call")

    verdict.pass("")
// ==========================================
// A generic function named as a value is the specialization written after it (`same<|I32|>`):
// that instance is built and its address taken. Without it the template's bare name reached C
// and LLVM, which have no such function.
// ==========================================
priv typedef Spec_op = fn(x: I32): I32

priv fn spec_same<|T|>(x: T): T
    return x

priv fn spec_first<|A, B|>(a: A, _b: B): A
    return a

priv fn spec_apply(f: Spec_op, x: I32): I32
    return f(x)

priv fn spec_pick(): Spec_op
    return spec_same<|I32|>

priv struct Spec_holder
    op: Spec_op

priv const SPEC_AT_TOP: Spec_op = spec_same<|I32|>

fn test_generic_fn_specialization_as_value()
    verdict.start("[fn-ptr] a generic function's specialization as a value test...")
    bound: Spec_op = spec_same<|I32|>
    assert(bound(5) == 5, "a binding holds the specialization")
    assert(spec_apply(spec_same<|I32|>, 6) == 6, "an argument passes the specialization")
    h: Spec_holder = ::{ .op = spec_same<|I32|> }
    assert(h.op(7) == 7, "a field holds the specialization")
    assert(SPEC_AT_TOP(8) == 8, "a top-level constant holds the specialization")
    assert(spec_pick() == spec_same<|I32|>, "one specialization is one function, named twice")
    wide: fn(x: F64): F64 = spec_same<|F64|>
    assert(wide(1.5) == 1.5, "another type argument names another specialization")
    two: fn(a: I64, b: U8): I64 = spec_first<|I64, U8|>
    assert(two(9, 1) == 9, "every type argument is written, in the declaration's order")
    // Another file's generic, named through its import.
    alloc: fn(): I32$@ = mem.alloc_as<|I32|>
    p: = alloc()
    p$ = 3
    assert(p$ == 3, "another file's specialization is built and called")
    dealloc(p)
    assert(spec_same<|I32|>(2) == 2 && spec_same(4) == 4, "a call is unchanged")
    verdict.pass("")
// ==========================================
// A method named through its type is a value too: the function that takes the receiver first.
// Every type argument is written, the type's on the type and the method's own after the method.
// Without this, a generic type's method and a generic method reached C as a bare name
// (`Holder<|I32|>.get` became `get`).
// ==========================================
priv struct Spec_plain
    v: I32

impl Spec_plain
    fn read(r: Self@): I32
        return r.v
    fn twice(x: I32): I32
        return x * 2
    fn same<|T|>(x: T): T
        return x
    fn own_same(): Spec_op
        return Self.same<|I32|>

priv struct Spec_box<|T|>
    v: T

impl<|T|> Spec_box<|T|>
    fn get(r: Self@): T
        return r.v
    fn keep(x: T): T
        return x
    fn pair<|U|>(_x: T, y: U): U
        return y
    fn own_keep(): fn(x: T): T
        return Self.keep

priv typedef Spec_ints = Spec_box<|I32|>

fn test_method_named_as_value()
    verdict.start("[fn-ptr] a method named through its type as a value test...")
    p: = Spec_plain::{ .v = 4 }
    read: fn(r: Spec_plain@): I32 = Spec_plain.read
    assert(read(p@) == 4, "a method takes its receiver as the first argument")
    assert(spec_apply(Spec_plain.twice, 5) == 10, "a method with no receiver is a plain function")
    same: Spec_op = Spec_plain.same<|I32|>
    assert(same(6) == 6, "a generic method is the specialization written after it")
    assert(Spec_plain.own_same()(7) == 7, "'Self' names the type inside its impl")
    b: = Spec_box<|I32|>::{ .v = 8 }
    get: fn(r: Spec_box<|I32|>@): I32 = Spec_box<|I32|>.get
    assert(get(b@) == 8, "a generic type's method is its instance's")
    keep: Spec_op = Spec_box<|I32|>.keep
    assert(keep(9) == 9, "a generic type's static method is its instance's")
    pair: fn(x: I32, y: U8): U8 = Spec_box<|I32|>.pair<|U8|>
    assert(pair(1, 2) == 2, "the type's type arguments and the method's own are both written")
    via_alias: Spec_op = Spec_ints.keep
    assert(via_alias(3) == 3, "a typedef naming an instance names its methods")
    assert(Spec_box<|I32|>.own_keep()(4) == 4, "'Self' names the instance inside its impl")
    assert(keep == Spec_box<|I32|>.keep, "one method is one function, named twice")
    // Another file's: a generic type's method, and one added to a built-in type.
    defer $xs: = List<|I32|>.new(null)
    push: fn(r: List<|I32|>$@, item: I32) = List<|I32|>.push
    push(xs@, 5)
    assert(xs.len == 1 && xs[0] == 5, "another file's generic type's method is built and called")
    digit: fn(c: U8): Bool = U8.is_digit
    assert(digit('7') && !digit('x'), "a method added to a built-in type is a value")
    assert(p.read() == 4 && Spec_box<|I32|>.keep(2) == 2, "a call is unchanged")
    verdict.pass("")

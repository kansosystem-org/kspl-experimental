//< The mutability marker on a type argument (`Box<|$T|>`)
//<
//< The default is immutable, so the marker goes on **the mutable version**: at a declared position
//< (`struct Box<|$T|>`), `Box<|I32|>` points at an immutable value and `Box<|$I32|>` at a mutable
//< one. **A marker written at an undeclared position is rejected**
//< (the case `type_arg_mut_not_named` in `tests/negative/type.kspls`). **One level of weakening is
//< allowed only at a declared position** (`Box<|$I32|>` → `Box<|I32|>`). The strengthening
//< direction is rejected (the case `type_arg_weaken_wrong_way` in `tests/negative/type.kspls`).
import "std/mem" { Arena }
import "std/verdict"

priv struct Box<|$T|>
    p: T$@

priv struct Plain<|T|> //< a generic with no marker declared
    v: T

$slot: I32 = 5

priv fn poke(b: Box<|$I32|>) //<
    //< It writes an element through a read-only receiver, as the pointer's type says it is mutable
    b.p$ = 11

priv fn peek(b: Box<|I32|>): I32 //< what it points at is immutable, so it can only be read
    return b.p$

fn test_type_arg_mut_mark()
    verdict.start("[Variance] the mutability mark put on a type argument test...")
    slot = 5
    m: Box<|$I32|> = ::{ .p = slot@ }
    poke(m)
    assert(slot == 11, "variance: an actual argument given `$` has a mutable target")

    ro: Box<|I32|> = ::{ .p = slot@ }
    assert(peek(ro) == 11, "variance: an unmarked actual argument still reads")

    // **They must be different types**, or the two above passing proves nothing.
    assert(sizeof(Box<|$I32|>) == sizeof(Box<|I32|>),
        "variance: the representation does not change with the mark (the difference is immutability \
            alone)")

    q: Plain<|I32|> = ::{ .v = 3 }
    assert(q.v == 3, "variance: a generic giving nothing is as it always was")
    verdict
        .pass("a type argument's `$` takes effect at a position the declaration gave alone, and \
            unmarked means immutable.")

// A method usable on both instances. **The body is instantiated per instance**, so a write in it
// is rejected for the immutable one (the case `type_arg_mut_method_body` in
// `tests/negative/type.kspls`).
impl<|T|> Box<|T|>
    fn read(r: Self): T
        return r.p$

priv fn read_via_weakened(b: Box<|I32|>): I32 //< takes only the immutable version
    return b.read()

fn test_type_arg_weakening()
    verdict.start("[Variance] one step of weakening at a given position test...")
    slot = 7
    m: Box<|$I32|> = ::{ .p = slot@ }

    // **This is the real check.** The types differ, so the weakening must work for this to pass.
    assert(read_via_weakened(m) == 7,
        "variance: the mutable version passes to an immutable parameter")

    // **The representation must be merged into one too**, or C builds two structs and rejects the
    // line above.
    ro: Box<|I32|> = ::{ .p = slot@ }
    assert(ro.read() == 7, "variance: the method calls on the immutable version itself too")
    assert(sizeof(Box<|$I32|>) == sizeof(Box<|I32|>), "variance: the representation is identical")
    verdict
        .pass("at a given position the mutable version passes to the immutable one, and the \
            representation is folded into one.")

priv struct Only_ro<|$T|> //<
    //< A generic struct whose immutable version is the only one in the program
    //<
    //< It shares the plain instance's representation, which the compiler must build first, or the C
    //< name has no definition.
    //< Do not write `Only_ro<|$I32|>` anywhere in this file, or the setup catches nothing.
    p: T$@

fn test_readonly_instance_alone()
    verdict.start("[Variance] the shape where only the immutable version appears test...")
    slot = 3
    ro: Only_ro<|I32|> = ::{ .p = slot@ }
    assert(ro.p$ == 3, "variance: it builds and reads with the immutable version alone")
    verdict
        .pass("even where only the immutable version appears, the plain instance sharing the \
            representation is generated by the compiler.")

// A method on only the mutable version: **write `$` on the target's type argument**
// (`Box<|$T|>`). On `impl<|T|> Box<|T|>` a writing method fails in the immutable body. From the
// immutable version it is "no such method" (the case `type_arg_mut_only_method` in
// `tests/negative/type.kspls`).
impl<|T|> Box<|$T|>
    fn poke(r: Self, v: T)
        r.p$ = v

fn test_mut_only_impl()
    verdict.start("[Variance] a method put on the mutable version alone test...")
    slot = 0
    m: Box<|$I32|> = ::{ .p = slot@ }
    m.poke(55)
    assert(slot == 55, "variance: the mutable version's method calls and takes effect")

    // **A method attached to both can be called on the mutable version too**, or matching the
    // marker may be dropping whole impls.
    assert(m.read() == 55, "variance: a method attaching to both calls on the mutable version too")
    ro: Box<|I32|> = ::{ .p = slot@ }
    assert(ro.read() == 55,
        "variance: a method attaching to both calls on the immutable version too")
    verdict
        .pass("an impl writing `$` on its target attaches to the mutable version alone, and one not \
            writing it attaches to both.")

// ==========================================
// Making one instantiation the impl's target (`impl Box<|I32|>`).
// An impl's target is a type expression: with its own type argument a template, without one that
// instance. **No new notation.**
// ==========================================
priv struct Held<|$T|>
    p: T$@

// On one instantiation with no mark: the immutable version is the target, and weakening lets the
// mutable one call it.
impl Held<|I32|>
    fn doubled(r: Self@): I32
        return r.p$ * 2

// An instantiation with the marker written. **It attaches only to the mutable version** (called
// on the immutable version, "there is no such method").
impl Held<|$I32|>
    fn bump(r: Self@)
        r.p$ += 1

// Another element type on the same base does not get the two above.
impl Held<|U8|>
    fn as_i32(r: Self@): I32
        return r.p$

fn test_impl_on_one_instantiation()
    verdict.start("[Variance] an impl put on one instantiation test...")
    slot = 6
    ro: Held<|I32|> = ::{ .p = slot@ }
    assert(ro.doubled() == 12, "inst impl: a method put on one instantiation calls")

    m: Held<|$I32|> = ::{ .p = slot@ }
    // **This is the real check**: the receiver must weaken to the unmarked (immutable) target.
    via_weakened: = m.doubled()
    assert(via_weakened == 12,
        "inst impl: an unmarked target's method calls from the mutable version too")
    m.bump()
    assert(slot == 7, "inst impl: a marked target's method takes effect on the mutable version")
    after_bump: = m.doubled()
    assert(after_bump == 14, "inst impl: it sees the same value after writing too")

    $byte: U8 = 5
    other: Held<|$U8|> = ::{ .p = byte@ }
    assert(other.as_i32() == 5, "inst impl: another instantiation takes another impl")
    verdict
        .pass("with an impl's target a concrete type alone, the methods attach to that one instance \
            (and the side one step of weakening reaches).")

priv enum Pick<|$T|> //<
    //< A generic enum matched by `switch` on its immutable version
    //<
    //< That version shares the plain instance's representation, its tags included, so the
    //< `switch` must name the plain instance's tags. The C compiler failed on tags never declared.
    one(v: T)
    none

priv fn pick_value(p: Pick<|I32|>): I32
    switch p
    case .one(v)
        return v
    case .none
        return -1

fn test_switch_on_shared_enum()
    verdict.start("[Variance] a switch on a generic enum's immutable version test...")
    some: Pick<|I32|> = .one(9)
    assert(pick_value(some) == 9, "variance: a switch on the immutable version takes the payload")
    nothing: Pick<|I32|> = .none
    assert(pick_value(nothing) == -1, "variance: a switch on the immutable version tells the tags")
    verdict.pass("a switch on an instance sharing its representation names the shared tags.")

// ==========================================
// A method declaring **its own** type arguments, the only ones a call site may write. With `$` the
// body writes the pointee, without it that is rejected (the reverse of the case
// `type_arg_mut_not_named` in `tests/negative/type.kspls`).
// Caution: **Do not confuse them with the enclosing `impl`'s**, which the receiver's type decides
// (the case `method_type_args_from_impl` in `tests/negative/trait.kspls`).
// ==========================================
priv struct Holder
    n: I32

impl Holder
    fn poke<|$T|>(_r: Self, p: T$@, v: T): T
        p$ = v
        return p$

fn test_method_own_type_args()
    verdict.start("[Generic] a method's own type arguments test...")
    h: Holder = ::{ .n = 0 }
    $slot: I32 = 0
    got: = h.poke<|$I32|>(slot@, 42)
    assert(got == 42,
        "method type args: a type argument declared by the method is writable from the call \
            position")
    assert(slot == 42, "method type args: what an actual argument marked `$` points at is writable")
    verdict
        .pass("a type argument a method declared itself is writable from the call position, and the \
            mutability mark takes effect there.")
// ==========================================
// A generic method called through its type, not a value: the type's type arguments go on the type
// and the method's own after the method, or are inferred from the arguments, as through a value.
// Without this, `Call_box<|U8|>.echo<|U16|>(w)` reached C naming no function (both groups read as
// one), `Call_box<|I64|>.width(b)` silently took the type's `I64` for the method's own (8, not 1),
// and `Call_plain.width(b)` and `Self.width(…)` said "undefined path".
// ==========================================
priv struct Call_box<|T|>
    v: T

impl<|T|> Call_box<|T|>
    fn echo<|U|>(x: U): U
        return x
    fn width<|U|>(_x: U): Sz
        return sizeof(U)
    fn widths<|U|>(_r: Self@, _x: U): Sz //< T's width in tens, U's in ones
        return sizeof(T) * 10 + sizeof(U)
    fn own_width(): Sz
        return Self.width<|U16|>(1) + Self.width(I64::1)

priv struct Call_plain
    v: I32

impl Call_plain
    fn width<|T|>(_x: T): Sz
        return sizeof(T)
    fn own_width(): Sz
        return Self.width<|U16|>(1) + Self.width(I64::1)

priv typedef Call_bytes = Call_box<|U8|>

fn test_generic_method_called_through_type()
    verdict.start("[Generic] a generic method called through its type test...")
    w: U16 = 300
    b: U8 = 200
    assert(Call_box<|U8|>.echo<|U16|>(w) == 300,
        "the type's type arguments and the method's own are both written")
    assert(Call_box<|U8|>.echo(w) == 300,
        "the method's own is inferred from the argument, not taken from the type's")
    assert(Call_box<|I64|>.width(b) == 1 && Call_box<|I64|>.width(w) == 2,
        "each argument's type names its own specialization")
    c: = Call_box<|I64|>::{ .v = 1 }
    assert(Call_box<|I64|>.widths(c@, b) == 81, "a method taking a receiver takes it first")
    assert(Call_bytes.width(w) == 2 && Call_box<|I32|>.own_width() == 10,
        "a typedef naming an instance, and 'Self' inside the impl, name the type")
    assert(Call_plain.width(b) == 1 && Call_plain.width<|I64|>(1) == 8 &&
        Call_plain.own_width() == 10, "a non-generic type's generic method is called the same way")
    a: = Arena.new(4096)
    defer a.free()
    p: = Arena.create(a, w)
    assert(p$ == 300, "another file's generic method is inferred through its type too")
    verdict.pass("")

// ==========================================
// A method reached through an instance is the instance's, as through a value: of an `impl` of one
// instance, through a typedef, `Self` in its signature. Without this, `Inst_box<|I64|>.made()`
// read `<|I64|>` as the method's own, `fn made(): Self` returned a type named `Self`, and
// `Inst_ints.get(i@)` or a `fn(r: Inst_ints@)` value stopped at lower's check or was refused: a
// typedef is only another name, inside a pointer or a function type too.
// ==========================================
priv struct Inst_box<|T|>
    v: T

impl<|T|> Inst_box<|T|>
    fn get(r: Self@): Sz
        return sizeof(T) * 100 + Sz::r.v

impl Inst_box<|I64|>
    fn made(): Self
        return Self::{ .v = 7 }
    fn twice(x: Self): I64
        return x.v * 2

priv typedef Inst_ints = Inst_box<|I64|>

priv struct Inst_plain
    v: I32

impl Inst_plain
    fn get(r: Self@): I32
        return r.v

priv typedef Inst_alias = Inst_plain

fn test_method_reached_through_instance()
    verdict.start("[Generic] a method reached through an instance test...")
    b: = Inst_box<|I64|>.made()
    assert(b.v == 7 && Inst_box<|I64|>.twice(b) == 14,
        "a method of an impl of one instance, called through it, 'Self' in its signature")
    i: Inst_ints = ::{ .v = 3 }
    assert(Inst_ints.get(i@) == 803 && Inst_box<|I64|>.get(i@) == 803,
        "a typedef of the instance names its methods, the receiver through the typedef")
    f: fn(r: Inst_ints@): Sz = Inst_box<|I64|>.get
    assert(f(i@) == 803, "a function type naming the typedef is the instance's")
    p: Inst_alias = ::{ .v = 5 }
    g: fn(r: Inst_alias@): I32 = Inst_plain.get
    assert(g(p@) == 5 && Inst_alias.get(p@) == 5, "so it is for a typedef of a plain type")
    verdict.pass("")

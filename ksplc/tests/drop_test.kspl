//< Automatic cleanup follows ownership through scopes, fields, calls and errors
import "std/ds" { List, Map }
import "std/mem"
import "std/refcount" { Rc }
import "std/str" { Str_builder }
import "std/verdict"

$sum: I32 = 0
$trace: U64 = 0

struct Owner
    id: I32

impl Owner: Drop
    priv fn drop(r: Self$@)
        sum += r.id
        trace = trace * 10 + U64::r.id

fn make(id: I32): Owner
    return Owner::{ .id = id }

fn eat(o: Owner)
    assert(o.id > 0, "a by-value argument owns the resource")

struct Pair
    a: Owner
    b: Owner

fn fields()
    $p: Pair = ::{ .a = make(1), .b = make(2) }
    eat(p.a)
    p.a = make(3)
    eat(p.a)

fn uninitialized()
    $a: Owner
    a = make(4)
    assert(a.id == 4, "an initially uninitialized slot acquires an owner")

fn branches(yes: Bool)
    a: = make(5)
    b: = make(6)
    selected: = a if yes else b
    eat(selected)

enum Failure
    failed

fn result(yes: Bool): Owner!Failure
    if !yes
        throw .failed
    return make(7)

fn unwrap(): Void!Failure
    r: = result(true)
    a: = r!
    eat(a)

fn option()
    o: Owner? = .some(make(8))
    switch o
    case .some(v)
        eat(v)
    case .none {}

fn early(fail: Bool): Void!Failure
    _a: = make(9)
    if fail
        result(false)!

fn discarded()
    result(true) catch {}

fn test_drop_paths()
    verdict.start("[Drop] owners survive moves, branches, fields and early exits...")
    sum = 0
    fields()
    assert(sum == 6, "partial field moves release each owner once")
    uninitialized()
    assert(sum == 10, "initial assignment does not destroy uninitialized storage")
    branches(true)
    branches(false)
    assert(sum == 32, "conditional moves leave the other owner for scope cleanup")
    unwrap() catch panic("unexpected failure")
    assert(sum == 39, "unwrapping transfers the success payload")
    option()
    assert(sum == 47, "a pattern binding takes ownership of its payload")
    early(true) catch {}
    early(false) catch {}
    assert(sum == 65, "both early and ordinary exits destroy the local owner")
    discarded()
    assert(sum == 72, "a discarded successful result destroys its payload")
    verdict.pass("each owned value is destroyed exactly once on its exit path.")

priv fn takes_two(a: Owner, b: Owner)
    assert(a.id > 0 && b.id > 0, "both arguments arrive alive")

priv fn interrupted_call(): Void!Failure
    a: = make(1)
    takes_two(a, result(false)!)

priv fn loop_cleanup()
    for $i: I32 = 0; i < 4; i += 1
        _a: = make(2)
        if i == 0
            continue
        if i == 2
            break

fn test_drop_calls_and_loops()
    verdict.start("[Drop] interrupted calls and loop exits release their owners...")
    sum = 0
    interrupted_call() catch {}
    assert(sum == 1, "a later argument's failure releases an already moved argument")
    loop_cleanup()
    assert(sum == 7, "continue, normal iteration and break each release the local")
    verdict.pass("in-flight arguments and every loop exit keep cleanup balanced.")

priv fn containers()
    $list: = List<|Owner|>.new(null)
    defer list.free()
    list.push(make(1))
    list.push(make(2))
    list.insert(1, make(3))
    if item: = list.pop()
        eat(item)
    else
        panic("the list is not empty")
    list.remove_at(0)
    list.clear()
    $map: = Map<|I32, Owner|>.new(null)
    defer map.free()
    for i in Range.asc(40)
        map.set(I32::i, make(1))
    map.set(0, make(4))
    assert(map.get_ptr(0).unwrap_or(null).id == 4, "lookup borrows the stored owner")
    for i in Range.asc(20)
        map.remove(I32::i)
    for i in Range.asc(40)
        map.set(I32::i, make(1))

priv fn shared()
    owner: = Rc<|Owner|>.new(make(5))
    $copy: = owner
    assert(copy.get().id == 5, "shared ownership borrows the unique payload")

priv fn raw_storage()
    slot: = mem.alloc_as<|Owner|>()
    defer mem.dealloc(Void$@::slot)
    mem.init_at(slot, make(6))
    eat(mem.take_at(slot))
    mem.init_at(slot, make(7))
    mem.drop_at(slot)

priv fn early_free()
    $builder: = Str_builder.new()
    builder.s("early")
    builder.free()
    builder = Str_builder.new()
    builder.s("again")
    assert(builder.slice().equals("again"), "assignment restores a manually released owner")

priv fn maybe_free(builder: Str_builder$@, skip: Bool)
    if skip
        return
    builder.free()

priv fn conditional_free(skip: Bool)
    $builder: = Str_builder.new()
    builder.s("the owner still needs cleanup when the helper returns early")
    maybe_free(builder@, skip)

priv fn free_after_failure(builder: Str_builder$@): Void!Failure
    _item: = result(false)!
    builder.free()

priv fn interrupted_free()
    $builder: = Str_builder.new()
    builder.s("a propagated failure skips the helper's release")
    free_after_failure(builder@) catch {}

fn test_drop_storage()
    verdict.start("[Drop] containers, shared owners and raw slots preserve resource lifetimes...")
    sum = 0
    containers()
    assert(sum == 90, "growth, insertion, removal and replacement release each stored owner once")
    shared()
    assert(sum == 95, "the last shared owner destroys its unique payload")
    raw_storage()
    assert(sum == 108, "initialization, transfer and destruction have distinct storage operations")
    early_free()
    before: = mem.heap_used_bytes()
    conditional_free(true)
    conditional_free(false)
    interrupted_free()
    assert(mem.heap_used_bytes() == before,
        "an interrupted helper cannot cancel the owner's cleanup")
    verdict.pass("storage operations transfer cleanup responsibility exactly once.")

priv fn pair(): Pair
    return ::{ .a = make(1), .b = make(2) }

priv fn relocated(yes: Bool)
    eat(pair().a if yes else make(3))

priv fn ignored_payload()
    o: Owner? = .some(make(4))
    switch o
    case .some {}
    case .none {}

priv struct Outer
    a: Owner
    b: Owner

impl Outer: Drop
    priv fn drop(_r: Self$@)
        trace = trace * 10 + 3

priv fn ordered_fields()
    _outer: Outer = ::{ .a = make(1), .b = make(2) }

priv fn ordered_array()
    _owners: Owner[3] = ::{ make(1), make(2), make(3) }

priv struct Early
    id: I32

impl Early
    fn free(r: Self$@)
        sum += r.id

impl Early: Drop
    priv fn drop(r: Self$@)
        r.free()

priv fn release_helper(e: Early$@): I32
    e.free()
    return 42

priv fn wrapped_release()
    $e: Early = ::{ .id = 8 }
    assert(release_helper(e@) == 42, "a release wrapper keeps its return value")

fn test_drop_order_and_temporaries()
    verdict.start("[Drop] temporary fields, ignored payloads and explicit release stay balanced...")
    sum = 0
    relocated(true)
    relocated(false)
    assert(sum == 6, "a field moved from a branch temporary leaves its sibling alive")
    ignored_payload()
    assert(sum == 10, "an ignored payload still receives cleanup")
    wrapped_release()
    assert(sum == 18, "a wrapper's explicit free cancels the caller's cleanup")
    trace = 0
    ordered_fields()
    assert(trace == 321, "the hook runs before fields in reverse declaration order")
    trace = 0
    ordered_array()
    assert(trace == 321, "array elements are destroyed in reverse index order")
    verdict.pass("partial temporaries, wildcard bindings and cleanup order preserve ownership.")

priv struct Selective<|T|>
    value: T

impl<|T|> Selective<|T|>
    fn get(r: Self@): T
        return r.value
    fn unused(r: Self@): I32
        return r.value.no_such_field

fn test_generic_methods_when_used()
    verdict.start("[Drop] unused generic method bodies impose no copying requirement...")
    value: Selective<|I32|> = ::{ .value = 12 }
    assert(value.get() == 12, "only the referenced generic method body is checked")
    verdict.pass("generic signatures remain available without checking unused bodies.")

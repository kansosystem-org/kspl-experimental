//< The brace notation: shapes refused as they are written
//< Each case below is compiled alone, as the file its head names.
// ==== case attr_on_part
//< An attribute is written on the declaration itself
//< Not on its **parts** (a parameter, a field, an enumerator). `#cfg` on one would change a call's
//< argument count, a literal or a `switch`'s exhaustiveness, and **every user splits by `#cfg`**.
//< What a part's position can hold is demanded. Its head is **the side that stopped the parse**.
// EXPECT: expected ')', '$', an identifier
import "std/io";

pub fn takes(#cfg(never_defined) a: I32, b: I32): I32 {
    return a + b;
}

fn main(): I32 {
    io.out().s("\{takes(1, 2)\}\n");
    return 0;
}
// ==== case attr_position
//< An attribute is written **in front of** a declaration, one at a time with a `#`
//< Neither a trailing one nor a comma list is accepted. **A `#` is written per attribute**, or the
//< later ones read as bare identifiers and the wording (`unknown attribute '#inline'`) mismatches.
//< What a signature holds there is demanded. `{` and `;` stopped the parse, the omissible `:` last.
// EXPECT: expected '{', ';', or ':'
import "std/io";

priv fn legacy() # inline, export { }

fn main(): I32 {
    legacy();
    io.out().s("unreachable\n");
    return 0;
}
// ==== case bare_block_on_one_line
//< The same bare block, written on one line
//< **This is the shape a check reading the text alone walks past.** It looks for a `{` standing
//< alone on its line, and here there is none. The parse stops at the `{` either way
//< (`forbidden_spelling_hint` in `../../parse/syntax_msg.kspl`).
// EXPECT: a bare block carries a label
fn main(): I32 {
  before: I32 = 1;
  { before += 1; }
  return before - 2;
}
// ==== case bare_block_without_label
//< A `{ … }` standing as a statement of its own is refused, not taken without a word
//< **A block with no heading cannot be told from a continuation of the statement before it.** So it
//< is writable in neither notation ("A bare block carries a label" in `../../../docs/DESIGN-notation.md`).
//< `stmt` does not draw `stmt_block` (`../../kspl.kspeg`): the parse stops at the `{`.
// EXPECT: a bare block carries a label
fn main(): I32 {
  before: I32 = 1;
  {
    before += 1;
  }
  return before - 2;
}
// ==== case block_comment_removed
//< The one means of commenting is the line comment `//`
//< There is no block comment `/* */` (TOOWTDI: docs/DESIGN-principles.md "One notation per purpose"). It is
//< taken out of both the grammar and kanso_space_skipper, so a `/*` becomes a syntax error as an
//< ordinary token.
// EXPECT: error

/* this is no longer a comment */
fn main(): I32 {
    return 0;
}
// ==== case bracket_closed_by_another
//< A bracket closed by a closer of another kind
//< The Note names the bracket still open and the closer that fits it.
// EXPECT: this ']' cannot close the '(' at line 9, column 13. Only a ')' can close it
priv fn add(a: I32, b: I32): I32 {
  return a + b;
}

fn main(): I32 {
  return add(1, 2];
}
// ==== case bracket_never_closed
//< A `[` never closed in the brace notation
//< The failure lands on the `;` right behind it. The Note names the bracket all the same, and the
//< brackets inside the string and the character literal are passed over.
// EXPECT: the '[' at line 9, column 10 is never closed
import "std/io";

fn main(): I32 {
  xs: I32[3] = ::{ 1, 2, 3 };
  y: = xs[1;
  io.out().s("(").c('[');
  return y;
}
// ==== case comma_missing_in_literal
//< A `,` missing between two elements of a compound literal
//< A value's `::{` holds a list as a call's `(` does, so the Note names the `,` there too.
// EXPECT: a ',' may be missing before '2'. Separate the items of a list with ','
fn main(): I32 {
  xs: I32[3] = ::{ 1 2, 3 };
  return xs[0];
}
// ==== case defer_behind_a_catch_block
//< A `defer` written behind the `}` of a declaration's `catch` block
//< The name is found past the block. The statement is read back from the `defer` with the block
//< passed over whole, so the `;` inside it does not end the search.
// EXPECT: a 'defer' must start a separate statement
// EXPECT: Put 'defer f.close()' on the next line
import "std/io";

fn main(): I32 {
  $f: = io.open("notes.txt", "rb") catch {
    return 1;
  } defer .close();
  return 0;
}
// ==== case defer_capture_list_removed
//< `defer` holds no capture list (`defer a, b { ... }`)
//< A `defer` takes a block or one statement, and its body reads the values **at the point of
//< leaving** (docs/DESIGN-programming-language.md "Why `defer` has no capture list"). The real uses are almost
//< all `.free()`/`dealloc`/`fclose`, which capture at registration invalidates. Copy into a
//< separate binding to keep such a value.
// ==========================================
// `defer n` reads as the one-statement form, so the refusal comes at the `{` behind it.
// EXPECT: expected ';'
// EXPECT: parse/syntax_error
// Where the user's source is merely invalid, do not show ksplc's own `!` propagation road
// (print_internal_trace in ksplc/main.kspl).
// EXPECT-NOT: stack backtrace
// ==========================================
fn main() {
    $n: Sz = 1;
    defer n { _x: = n; }
    n = 2;
}
// ==== case directive_needs_two_hashes
//< A setting that takes effect on a whole file is written with `##`
//< Drop one `#` and it is read as an attribute. **The count of `#` settles the range, not the
//< position** (`##` the enclosing file, `#` what comes next). So the two sets of names grow apart.
//< Caution: **Do not copy the expectation set to the end.** The tail changes with the grammar.
// EXPECT: expected ')',
import "std/io";

#lint(H0701 = off)
fn main(): I32 {
    io.out().s("unreachable\n");
    return 0;
}
// ==== case enum_comma_separator
//< The shape delimiting an enum's values with `,`
//< **The expectation set alone does not convey it.** Even with `';'` coming first, it cannot be
//< read as "it is `;` rather than `,`". So a Note stating the rule is carried alongside
//< ("Every item in a declaration block ends with `;`" in `../../../docs/DESIGN-principles.md`).
// EXPECT: expected ';', '(', or '='
// EXPECT: an enum value stands on its own, as a struct field does
enum Shade {
  light,
  mid,
}

fn main(): I32 {
  return 0 if Shade.light == Shade.light else 1;
}
// ==== case import_plus_without_selectors
//< The shape writing a `+` and placing no braces
//< **Letting it through makes two spellings.** A `+` is the mark for "use the chosen names bare as
//< well". So with nothing to choose it means the same as an unmarked `import "p";`. The expectation
//< set alone is enough (read that a `'{'` is wanted and it is clear what was forgotten).
// EXPECT: expected '{'
import "std/mem" +;

fn main(): I32 {
  return 0;
}
// ==== case loop_written_as_loop
//< Rust's `loop { … }` suggests the bare `for`, which repeats until a `break` leaves it
//< The brace notation fails at the `{`; `loop` stays a name, as the first statement shows.
// EXPECT: loop_written_as_loop.ksplb:7:10: error: expected ':'
// EXPECT: every loop is written with 'for'. A bare 'for' repeats until a 'break' leaves it.
fn main() {
    $loop: = 0;
    loop { break; }
}
// ==== case parse_label_closer_leads
//< The shape that dropped a closing bracket
//< Not the `;` alone: a `)` closing a run and a `}` closing a step are buried at the tail for the
//< same reason (an outer rule piles them). The `,` and the operators miss on the "it can be
//< absent" side. Only the `)` stops the parse, so the `)` must lead the expectations.
// EXPECT: expected ')',
// EXPECT-NOT: expected ',',
fn takes(x: I32, y: I32): I32 {
  return x + y;
}

fn main(): I32 {
  return takes(1, 2 - 3;
}
// ==== case parse_label_names_the_token
//< A parse error at a type's position lists what may come there in the user's words
//< Caution: **Do not take the `EXPECT-NOT` off.** Listing the names one at a time hits the cap on
//< `I8` `I16` … alone, cutting off with neither a name nor a bracket out (`Primitive_type` in
//< `ksplc/kspl.kspeg`). A lexical token is stated by its name, gathered together.
// EXPECT: expected 'fn', a primitive type, an identifier, or '('
// EXPECT-NOT: 'I16'
struct S {
  f: ;
}

fn main(): I32 {
  return 0;
}
// ==== case parse_label_stmt_end_leads
//< The shape that dropped the `;` closing a statement
//< Caution: **The head of the expectations must be the hand that mends it.** The `';'` that stops
//< the parse leads, split from the operators that missed by `Expected.is_optional` in
//< `kspeg/expected.kspl`. Keep the operators listed after it, since they can be written there too.
// EXPECT: expected ';',
// EXPECT-NOT: expected '.',
fn main(): I32 {
  a: I32 = 1
  return a - 1;
}
// ==== case parse_label_unclosed_string
//< An unclosed string is reported at its opening quote, named as a string never closed
//< The parser runs out of text only at the file's end, far below the quote (`parse_error_at` in
//< `ksplc/parse/syntax_msg.kspl`). Grammar-internal words must not reach the list either
//< (track_token_fail in `kspeg/engine.kspl`).
// EXPECT: parse_label_unclosed_string.ksplb:9:8: error: this string is never closed
// EXPECT-NOT: character class
// EXPECT-NOT: expected
fn main(): I32 {
  s: = "never closed;
  return 0;
}
// ==== case parse_unclosed_string_in_call
//< A string left open inside a call is the string's mistake, not the bracket's
//< The bracket around it is still open where the text runs out, so its note would name the
//< wrong mark at the wrong line.
// EXPECT: parse_unclosed_string_in_call.ksplb:9:14: error: this string is never closed
// EXPECT-NOT: is never closed, so what follows it
import "std/io";

fn main(): I32 {
  io.out().s("abc);
  return 0;
}
// ==== case postfix_if_absent
//< There is no postfix condition (`return x if cond;`)
//< One shape writes the condition first (docs/SPEC-programming-language.md "Appendix A: Features not carried,
//< and what to write instead"); a value position uses the ternary `a if cond else b`. The
//< expectation set alone does not convey that the ternary shape exists separately.
// EXPECT: error
// EXPECT: needs all three parts
fn main(): I32 {
    n: = 1;
    return 0 if n > 0;
}
// ==== case range_syntax_absent
//< There is no range notation (`a..b`), and the error names the alternative
//< A repetition's bounds are written in the for's heading, and a subsequence is taken with
//< `x.sub(start, len)` ("Appendix A: Features not carried, and what to write instead" in
//< docs/SPEC-programming-language.md).
//< Caution: **Name the settlement and show the alternative** (forbidden_spelling_hint in
//< ksplc/parse/syntax_msg.kspl). Put out alone, the expectation set says an `import` or a `pub`
//< was expected. That misleads the writer.
// EXPECT: error
// EXPECT: has no range syntax
import "std/chars" as _chars; // for the single-character checks and cuts
fn main(): I32 {
    $total: = 0;
    for i in 0..10 {
        total += i;
    }
    return total;
}
// ==== case result_error_type_omitted
//< An exception union's error type cannot be omitted
//< `T!I32` is always written: `T!` would be a second spelling of the same type (TOOWTDI:
//< docs/DESIGN-principles.md "One notation per purpose").
// EXPECT: error

priv fn f(): Sz! {
    return 1;
}

fn main(): I32 {
    return I32::(f() catch 0);
}
// ==== case shebang_lookalike_is_refused
#!lint(H0701 = off);
//< A `#!` on line 1 is a shebang only where what comes next (spaces aside) is a `/`
//< Anything else is not reread and sounds as a syntax error.
//< Caution: **Do not turn this into a line comment in silence.** A whole-file setting written
//< with a `#!` would then fail to take effect with not one clue left to its author.
// EXPECT: error: expected an attribute prefix
import "std/io";

fn main(): I32 {
    io.out().s("unreachable\n");
    return 0;
}
// ==== case sigil_must_touch_the_name
//< A mark and a name have to be next to each other
//< **Allow them apart and a name on the line after a line holding only a `#` joins on.** Reading
//< past whitespace skips newlines and line comments too. So characters the reader reads as an
//< expression become an attribute. A mark and a name are one token (`Attribute_prefix`).
// EXPECT: error: expected an attribute prefix
import "std/io";

#
cfg(never)
fn dead(): I32 {
  return 1;
}

fn main(): I32 {
  io.out().s("unreachable\n");
  return 0;
}
// ==== case struct_empty_body
//< A struct with an empty body is not accepted
//< Caution: Take an empty body, and after the normalisation has dropped the `{` it cannot be
//< told apart from `struct S;`. That is the form an `extern` block declares a C type with.
// EXPECT: expected
// EXPECT-NOT: [
pub struct Marker {}

fn main(): I32 {
  return 0;
}
// ==== case switch_arms_in_a_block
//< Braces around all of a `switch`'s arms, as C, Go, Swift and Rust write them
//< **Each arm carries its own braces and the `switch` none**, so the `{` after the subject is
//< refused, and the Note names the shape to write.
// EXPECT: switch_arms_in_a_block.ksplb:8:14: error: expected 'case'
// EXPECT: Note: a 'switch' opens no block of its own. Each 'case' and 'default' opens one.
fn main(): I32 {
    e: = 1;
    switch e {
    case 1 {
        return 1;
    } default {
        return 2;
    }
    }
}
// ==== case trailing_closure_absent
//< A closure written behind a call's `)` in the brace notation
//< The same settlement as the case `laid_trailing_closure_absent` in `../negative/laid.kspl`: the Note is the
//< notation's, not the layout's, so the brace notation gets it too (`forbidden_spelling_hint` in
//< `../../parse/syntax_msg.kspl`).
// EXPECT: error
// EXPECT: KSPL has no trailing closure
priv fn count_over(xs: I32[], pred: Callable1<|I32, Bool|>): Sz {
    return xs.len;
}

fn main(): I32 {
    xs: = I32[]::{ 3, 9, 6 };
    big: = count_over(xs) fn(x: I32; ): Bool { return x > 4; };
    return I32::big;
}
// ==== case typedef_in_c_order
//< C's order for another name for a type writes the line back in KSPL's: the new name first
//< `typedef U8[] Bytes;` fails on the `U8`, where the new name is wanted
//< (`append_typedef_spelling_hint` in `../../parse/syntax_msg.kspl`). The note is the
//< declaration's, not the notation's, so the brace notation gets it too.
// EXPECT: typedef_in_c_order.ksplb:7:9: error: expected an identifier
// EXPECT: 'typedef' puts the new name first. Put the type after '=': 'typedef Bytes = U8[]'.
typedef U8[] Bytes;

fn main(): I32 {
    b: Bytes = "abc";
    return I32::b.len;
}

//< Checks the order of declarations and the order an assignment runs in
//< Nothing depends on the order of declarations. An assignment runs its value, then its place,
//< then the write. The type and place rules are in `lang_types_test.kspl`, and the syntax and
//< basic types in `lang_test.kspl`.
//< Caution: **Put a use before the declaration.** With only uses after it, it passes, helped by
//< Pass 3's order.
import "std/ds" { List }
import "std/verdict"

priv $sz_before_decl: U8[sizeof(Sz_later)] = ::{}
priv typedef Sz_alias_buf = U8[sizeof(Sz_later)]

priv struct Sz_later
    priv a: I64
    priv b: I64
    priv c: I64

priv struct Sz_holder //< uses the size of a struct not yet laid out, from another struct's field
    priv room: U8[sizeof(Sz_nested)]

priv struct Sz_nested
    priv inner: Sz_inner
    priv tag: I32

priv struct Sz_inner
    priv x: I64
    priv y: I64

priv enum Sz_enum
    none
    some(p: Sz_inner)

priv $sz_before_enum_decl: U8[sizeof(Sz_enum)] = ::{}

priv fn sz_in_return_type(): U8[sizeof(Sz_later)]
    return ::{}

fn test_sizeof_does_not_depend_on_declaration_order()
    verdict.start("[sizeof] a size resolves even before the declaration test...")

    assert(sz_before_decl.len == sizeof(Sz_later),
        "a top-level array length resolves before the declaration")
    assert(sz_before_decl.len == 24, "three I64, so 24 bytes")
    // Caution: Bind the return value and use an element too. `.len` of a fixed-length array
    // folds, so `f().len` alone throws the call away ([W0102]) and C sees an unused variable
    // (Principle 2).
    $rb: = sz_in_return_type()
    rb[23] = 5
    assert(rb.len == 24 && rb[23] == 5, "it resolves in a function's return type too")
    $ab: Sz_alias_buf = ::{}
    ab[23] = 7
    assert(ab.len == 24 && ab[23] == 7, "it resolves inside an alias too")
    // Nested: Sz_holder needs Sz_nested, and Sz_nested needs Sz_inner.
    assert(sizeof(Sz_inner) == 16, "the inner struct")
    assert(sizeof(Sz_holder) == sizeof(Sz_nested), "the size taken from a field agrees")
    assert(sizeof(Sz_holder) == 24, "16 + an I32 aligned to 8")
    // An enum with a payload can be used before its declaration too.
    assert(sz_before_enum_decl.len == sizeof(Sz_enum),
        "an enum's size resolves before the declaration")
    assert(sz_before_enum_decl.len > 16, "it holds both the tag and the payload")

    verdict.pass("whatever the declarations' order, it fills when asked and answers the size.")

// ==========================================
// A top-level declaration can refer to a constant declared behind it.
// Caution: **Test a chain too.** With one step alone, merely swapping the output order once
// passes.
// ==========================================
priv $ord_buf: U8[ORD_LEN] = ::{}
priv const ORD_LEN: Sz = ORD_BASE * 2
priv const ORD_BASE: Sz = 3

priv struct Ord_pair
    x: I32
    y: I32

priv const ORD_PAIR: Ord_pair = Ord_pair::{ .x = ORD_X, .y = 2 }
priv const ORD_X: I32 = 9
priv const ORD_ARR: I32[3] = ::{ ORD_X, ORD_X + 1, ORD_X + 2 }
priv $ord_mut: Sz = ORD_BASE * 10

priv fn ord_in_return_type(): U8[ORD_LEN]
    return ::{}

fn test_declarations_may_reference_later_constants()
    verdict.start("[order] a constant declared behind can be referred to test...")

    assert(ORD_LEN == 6 && ORD_BASE == 3, "a chain of constants solves backwards")
    assert(ord_buf.len == 6, "an array length is computed from a constant declared later")
    $rb: = ord_in_return_type()
    rb[5] = 1
    assert(rb.len == 6 && rb[5] == 1, "the same for a function return type's array length")
    assert(ORD_PAIR.x == 9 && ORD_PAIR.y == 2,
        "a struct's initializer can refer to a constant behind")
    assert(ORD_ARR[0] == 9 && ORD_ARR[2] == 11, "the same for an array's initializer")
    assert(ord_mut == 30, "the same for a mutable global")

    verdict.pass("neither sema's fold nor genc's output order is bound to the declarations' order.")

// ==========================================
// Checks that a generic type's `impl` may be written before the type's declaration or its use.
// Caution: **Test the trait conformance too.** Even with the methods in place, an upcast does not
// pass unless `impl<|T|> C<|T|>: Trait` attaches.
// ==========================================
priv const SLOT_SIZE: Sz = sizeof(Slot<|I32|>)

impl<|T|> Slot<|T|>
    fn get(r: Self@): T
        return r.v
    fn put(r: Self$@, x: T)
        r.v = x

impl<|T|> Slot<|T|>: Slot_tag
    fn tag(_r: Self): I32
        return 42

priv trait Slot_tag
    fn tag(r: Self): I32

priv struct Slot<|T|>
    v: T

priv fn slot_tag_of(t: Slot_tag): I32
    return t.tag()

fn test_generic_impl_may_precede_its_type()
    verdict.start("[generic] a generic impl may come before its type test...")

    assert(SLOT_SIZE == sizeof(I32), "the size of a type declared after the impl resolves")
    $c: Slot<|I32|> = ::{ .v = 1 }
    c.put(9)
    assert(c.get() == 9, "a method of an impl written before the declaration has grown")
    tag: = slot_tag_of(c@)
    assert(tag == 42, "the trait conformance of an impl written before the declaration attaches too")

    verdict.pass("the registration of a generic impl is not bound to the order.")

// ==========================================
// Checks that an alias can refer to an alias declared after it.
// ==========================================

priv typedef Ord_a = Ord_b //<
    //< The head of a chain of aliases, each naming one declared after it
    //< Caution: C's `typedef` needs the type name on its right defined before that position. If
    //< genc wrote them in source order, C would say `unknown type name` while ksplc reports nothing
    //< (Principle 2). Dependency decides the output order (emit_fwd_aliases in gen/c/decl.kspl).
    //< **Test a chain, and shapes wrapped in a pointer or an array too.** The dependency is
    //< followed while stripping type ids, so with only a plain reference an implementation that
    //< looks one step deep passes as well.
priv typedef Ord_b = Ord_c
priv typedef Ord_c = I64
priv typedef Ord_arr = Ord_c[3]
priv typedef Ord_of_struct = Ord_s

priv struct Ord_s
    n: I32

fn test_alias_may_reference_later_alias()
    verdict.start("[alias] an alias declared behind can be referred to test...")

    x: Ord_a = 5
    assert(x == 5, "a three-step chain of aliases solves backwards")
    $a: Ord_arr = ::{}
    a[2] = 7
    assert(a.len == 3 && a[2] == 7, "the same for an alias wrapped in an array")
    s: Ord_of_struct = ::{ .n = 4 }
    assert(s.n == 4, "the same for an alias pointing at a struct")

    verdict.pass("typedef's output order is not bound to the declarations' order.")

// ==========================================
// Checks that an assignment evaluates its value, then its place, then writes ("Evaluation order"
// in docs/SPEC-programming-language.md). The calls record the order as digits (21 where 2 came
// first).
// Caution: **Put a call with a side effect on both sides.** C leaves the order of an assignment's
// two sides open, so a shape without them passes under one C compiler and fails under another.
// ==========================================
priv $asg_log: I32 = 0
priv $asg_arr: I32[4] = ::{}
priv $asg_grid: I32[3][3] = ::{}

priv fn asg_idx(): Sz //< a step of the place, recorded as 1
    asg_log = asg_log * 10 + 1
    return 1

priv fn asg_val(): I32 //< the value, recorded as 2
    asg_log = asg_log * 10 + 2
    return 5

priv fn asg_col(): Sz //< a later step of the place, recorded as 3
    asg_log = asg_log * 10 + 3
    return 2

priv fn asg_move(at: Sz$@, v: I32): I32 //< a value that moves the index the place reads
    at$ = 2
    return v

priv fn asg_ptr(): Asg_cell$@ //< a place reached through a pointer, recorded as 1
    asg_log = asg_log * 10 + 1
    return asg_cell@

priv struct Asg_cell
    n: I32

priv $asg_cell: Asg_cell = ::{ .n = 0 }

#packed
priv struct Asg_packed
    tag: U8
    n: I32

priv struct Asg_sink //< `x[i] = v` through `Index_mut.set`, which records the write as 4
    last: I32

impl Asg_sink: Index_mut<|Sz, I32|>
    fn set(r: Self$@, index: Sz, val: I32)
        asg_log = asg_log * 10 + 4
        r.last = I32::index * 100 + val

fn test_assignment_evaluates_value_first()
    verdict.start("[order] an assignment evaluates its value, then its place test...")

    asg_log = 0
    asg_arr[asg_idx()] = asg_val()
    assert(asg_log == 21 && asg_arr[1] == 5, "`a[i()] = v()` runs v() before i()")
    asg_log = 0
    asg_arr[asg_idx()] += asg_val()
    assert(asg_log == 21 && asg_arr[1] == 10, "a compound assignment runs its value first too")
    asg_log = 0
    asg_grid[asg_idx()][asg_col()] = asg_val()
    assert(asg_log == 213 && asg_grid[1][2] == 5,
        "the place's own steps run left to right, after the value")
    asg_log = 0
    asg_ptr().n = asg_val()
    assert(asg_log == 21 && asg_cell.n == 5, "a field through a pointer a call returns")
    $sink: = Asg_sink::{ .last = 0 }
    asg_log = 0
    sink[asg_idx()] = asg_val()
    assert(asg_log == 214 && sink.last == 105,
        "through `Index_mut.set`: the value, the index, the set")
    $pk: Asg_packed[3] = ::{}
    asg_log = 0
    pk[asg_idx()].n = asg_val()
    assert(asg_log == 21 && pk[1].n == 5, "a `#packed` field through a subscript")
    asg_log = 0
    pk[asg_idx()].n *= asg_val()
    assert(asg_log == 21 && pk[1].n == 25, "a compound assignment to a `#packed` field")

    verdict.pass("the value runs before every step of the place, on both backends.")

fn test_assignment_reads_its_place_after_the_value()
    verdict.start("[order] an assignment's place sees what its value changed test...")

    $at: Sz = 0
    asg_arr = ::{}
    asg_arr[at] = asg_move(at@, 7)
    assert(asg_arr[2] == 7 && asg_arr[0] == 0, "the index is read after the value moved it")
    $n: I32 = 1
    n += asg_set_to_ten(n@)
    assert(n == 15, "a compound assignment reads its old value after the value ran")

    verdict.pass("the place, and a compound assignment's old value, are read after the value.")

priv fn asg_set_to_ten(n: I32$@): I32 //< a value that changes the place a `+=` reads
    n$ = 10
    return 5

// ==========================================
// The trap the order prevents: a list's element written with a call that grows the list and moves
// its elements. A place found before the call would be in the old memory, already freed.
// Caution: **Keep the list on the heap (`null` arena).** An arena keeps the old memory, so only
// the value read back would show the stale write; on the heap, `make test-sanitize` reports it.
// ==========================================
priv struct Asg_node
    left: Sz
    tag: I32

priv struct Asg_tree
    nodes: List<|Asg_node|>

impl Asg_tree
    fn grow(r: Self$@): Sz //< pushes enough nodes to move the list, and returns the last one
        for _i in Range.asc(64)
            r.nodes.push(Asg_node::{ .left = 0, .tag = 1 })
        return r.nodes.len - 1

fn test_assignment_into_a_list_its_value_grows()
    verdict.start("[order] a list's element written with a call that grows the list test...")

    $t: = Asg_tree::{ .nodes = List<|Asg_node|>(null) }
    t.nodes.push(Asg_node::{ .left = 0, .tag = 0 })
    t.nodes[0].left = t.grow()
    assert(t.nodes[0].left == 64, "the write reaches the list's memory after it grew")
    t.nodes[0].tag += I32::t.grow()
    assert(t.nodes[0].tag == 128, "a compound assignment reaches it too")
    t.nodes.free()

    verdict.pass("the place is computed after the call that moved the list.")

//< ksplc's tests, run as a program of their own (`make test` in this package's folder)
//<
//< **This is the only way to run ksplc's tests on their own.** `all.kspls` lists them; this file
//< only gives them a `main`, so a copy of the package with nothing around it can run them.
import "ksplc/tests/all"
import "std/io"
import "std/mem" { Arena }

fn main()
  // Line by line, so a run that crashes shows how far it got.
  io.set_line_buffered()
  arena: = Arena.new(1024 * 1024)
  defer arena.free()
  all.run_ksplc(arena)

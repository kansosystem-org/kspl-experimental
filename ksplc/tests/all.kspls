//< The entry point that runs ksplc's tests together
//<
//< **This is the only `pub` declaration in this package.** The tests live inside `ksplc/`, so they
//< see what they test without any visibility marker (a unit sees its own; [I0402] in ksplc.cfg).
//< Caution: **Do not add another entry point here for tests to inspect** — each one is one more
//< contract exposed outside the unit.
//< **None of the tests here imports `ksplc/`.**
//< **Measure `make debug`'s translation time before adding one.**
import "ksplc/tests/arc_branch_test"
import "ksplc/tests/arc_lookalike_test"
import "ksplc/tests/arc_test"
import "ksplc/tests/c_keyword_names"
import "ksplc/tests/const_array_test"
import "ksplc/tests/const_fold_width_test"
import "ksplc/tests/enum_test"
import "ksplc/tests/error_trace_test"
import "ksplc/tests/fn_value_test"
import "ksplc/tests/generic_queue_test"
import "ksplc/tests/lang_format_test"
import "ksplc/tests/lang_limits_test"
import "ksplc/tests/lang_order_test"
import "ksplc/tests/lang_test"
import "ksplc/tests/lang_types_test"
import "ksplc/tests/layout_test"
import "ksplc/tests/name_reach_test"
import "ksplc/tests/packed_test"
import "ksplc/tests/slice_test"
import "ksplc/tests/stmt_attr_cfg_test"
import "ksplc/tests/trait_test"
import "ksplc/tests/variance_test"
import "ksplc/tests/win64_arg_abi_test"
import "std/mem" { Arena }

pub fn run_ksplc(arena: Arena$@) //< runs every ksplc test in this list
    // Caution: **Run it first.** An ABI disagreement ("Both a store and an actual argument are
    // emitted at 'the receiver's type'" in `../docs/DESIGN.md`) quietly breaks other tests' values.
    win64_arg_abi_test.test_win64_arg_abi()
    lang_format_test.test_string_format_spec()
    lang_test.test_default_args()
    lang_test.test_offsetof()
    packed_test.test_packed_fields()
    lang_test.test_sizeof_of_a_value()
    lang_test.test_generic_struct_fills_as_plain()
    lang_test.test_negative_const_type_arg()
    lang_test.test_if_binds_option()
    lang_test.test_if_bind_in_else_if()
    lang_test.test_endless_for_ends_a_function()
    lang_limits_test.test_closure_wrapped_in_struct()
    lang_limits_test.test_frame_store_kept_inside()
    trait_test.test_generic_vtable_only_method()
    trait_test.test_trait_values_in_immutable_array()
    generic_queue_test.test_queue_drained_within_one_body()
    generic_queue_test.test_queue_drained_under_outer_binding()
    generic_queue_test.test_method_returns_deeper_self()
    generic_queue_test.test_trait_type_chain()
    generic_queue_test.test_method_own_type_param()
    generic_queue_test.test_closure_infers_output_type()
    generic_queue_test.test_method_body_building_deeper_self()
    generic_queue_test.test_enum_born_in_a_signature_formats()
    trait_test.test_loop_in_over_iter()
    trait_test.test_loop_in_over_indexed(arena)
    trait_test.test_loop_in_inside_generic(arena)
    trait_test.test_iter_wins_over_index()
    trait_test.test_trait_default_body()
    lang_test.test_noreturn_as_catch_value()
    lang_format_test.test_primitive_interpolation()
    lang_format_test.test_float_spelling()
    lang_test.test_interp_keeps_concrete_writer()
    layout_test.test_ragged_sibling_is_seen()
    layout_test.test_written_terminator_is_seen()
    layout_test.test_mixed_width_stays_silent()
    layout_test.test_tab_indent_is_seen()
    layout_test.test_carried_string_leaves_the_lines_below()
    layout_test.test_one_line_block_gets_its_semicolon()
    layout_test.test_first_arm_below_switch()
    arc_test.test_arc_auto_local()
    arc_test.test_arc_generic_synthesized_only()
    arc_test.test_arc_auto_cross_fn()
    arc_test.test_arc_field_cascade()
    arc_test.test_arc_retain_on_every_copy_site()
    arc_test.test_arc_aggregate_cascade_release()
    arc_test.test_arc_result_payload_release()
    arc_test.test_arc_result_place_copy()
    arc_test.test_arc_zero_value_is_empty()
    arc_test.test_arc_new_of_arc_bearing_value()
    arc_test.test_arc_last_release_takes_value_apart()
    arc_test.test_arc_copy_through_call()
    arc_test.test_arc_place_index_container()
    arc_test.test_arc_container_owns_elements()
    arc_test.test_arc_return_retains_without_cleanups()
    arc_test.test_arc_unbound_value_released()
    arc_branch_test.test_arc_branch_hands_over_a_count()
    arc_branch_test.test_arc_arm_binding_holds_a_count()
    arc_branch_test.test_arc_operand_left_by_exit()
    arc_branch_test.test_arc_part_of_new_value()
    arc_lookalike_test.test_lookalike_trait_is_not_arc()
    arc_lookalike_test.test_qualified_lang_trait_is_arc()
    lang_test.test_option_null_safety()
    lang_test.test_option_combinators()
    lang_test.test_range_loop()
    lang_limits_test.test_bool_operators()
    c_keyword_names.run()
    c_keyword_names.made_names()
    lang_test.test_slice_views(arena)
    lang_test.test_checked_int()
    lang_test.test_selective_import()
    lang_test.test_generic_fn_returning_own_type_param()
    lang_test.test_generic_param_not_first_arg()
    lang_test.test_two_generic_params_inferred()
    lang_test.test_instantiation_before_generic_impl()
    lang_test.test_index_on_a_call_result()
    error_trace_test.test_caller_location_defaults()
    error_trace_test.test_trait_declaration_defaults()
    name_reach_test.test_plus_brings_the_alias_and_the_bare_names()
    name_reach_test.test_extern_struct_through_an_alias()
    slice_test.test_index_ref_returns_a_place()
    slice_test.test_view_receiver_decides_write_permission()
    slice_test.test_slice_made_in_the_statement()
    variance_test.test_type_arg_mut_mark()
    variance_test.test_type_arg_weakening()
    variance_test.test_readonly_instance_alone()
    variance_test.test_mut_only_impl()
    variance_test.test_impl_on_one_instantiation()
    variance_test.test_switch_on_shared_enum()
    slice_test.test_generic_impl_over_slices()
    slice_test.test_subsequence_over_slices()
    variance_test.test_method_own_type_args()
    variance_test.test_generic_method_called_through_type()
    variance_test.test_method_reached_through_instance()
    enum_test.test_option_sugar()
    slice_test.test_slice_struct_places()
    slice_test.test_slice_struct_in_readonly_frame()
    lang_test.test_immutability_axes_are_independent()
    lang_test.test_subexpressions_are_evaluated_once()
    lang_types_test.test_slice_descriptor_literals(arena)
    lang_types_test.test_slice_elem_literal()
    lang_types_test.test_container_of_nested_views(arena)
    lang_types_test.test_const_alias_resolves_through()
    lang_types_test.test_alias_element_acts_as_its_base()
    lang_types_test.test_enum_variant_name()
    lang_types_test.test_index_key_type_follows_the_impl(arena)
    lang_types_test.test_index_place_gives_real_places(arena)
    lang_types_test.test_private_type_arg_reaches_template_body(arena)
    lang_types_test.test_embedded_nul_is_rejected_at_c_boundary()
    lang_types_test.test_defer_reads_values_at_scope_exit()
    fn_value_test.test_fn_returning_fn_ptr()
    fn_value_test.test_generic_fn_specialization_as_value()
    fn_value_test.test_method_named_as_value()
    fn_value_test.test_name_to_generic_parameter()
    fn_value_test.test_binding_takes_the_fn_type()
    fn_value_test.test_name_compared_either_side()
    name_reach_test.test_typedef_reaches_static_method()
    lang_types_test.test_trait_upcast_lifetimes()
    lang_types_test.test_trait_upcast_from_empty_conformance()
    lang_types_test.test_trait_upcast_ignores_constness()
    lang_types_test.test_trait_upcast_through_an_alias_pointer()
    lang_types_test.test_result_wraps_coerced_value()
    lang_types_test.test_numeric_operands_promote_to_the_holder()
    lang_types_test.test_written_type_args_type_the_arguments()
    lang_order_test.test_sizeof_does_not_depend_on_declaration_order()
    lang_types_test.test_void_result_return_forms()
    lang_order_test.test_declarations_may_reference_later_constants()
    lang_order_test.test_generic_impl_may_precede_its_type()
    lang_order_test.test_alias_may_reference_later_alias()
    lang_types_test.test_alias_does_not_block_const_relaxation()
    lang_types_test.test_generic_args_infer_from_composites()
    lang_types_test.test_const_args_infer_from_array_lengths()
    lang_types_test.test_const_args_infer_from_value_args()
    const_array_test.test_const_copy_binding()
    const_array_test.test_inferred_length_from_a_row()
    const_array_test.test_cast_of_an_element_to_its_own_type()
    const_array_test.test_a_const_float_array_keeps_its_values()
    const_array_test.test_a_computed_float_constant_folds()
    const_array_test.test_const_struct_array()
    const_array_test.test_multi_dim_array()
    const_array_test.test_struct_enum_slice_cycle()
    const_fold_width_test.test_const_fold_width()
    enum_test.test_enum_tags_are_the_written_values()
    enum_test.test_variant_in_array()
    stmt_attr_cfg_test.test_stmt_attr_cfg()
    error_trace_test.test_error_trace(arena)
    error_trace_test.test_error_trace_per_thread()
    error_trace_test.test_error_trace_lines()

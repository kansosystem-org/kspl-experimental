import "std/str" // `equals`
import "std/verdict"

// ==========================================
// `T?` is `Option<|T|>` ("`T?` is sugar for `Option<|T|>`" in `../../docs/DESIGN.md`): the two
// spellings are one type, and the marks apply from the left as `[]` and `@` do.
// ==========================================
// The long form is written on purpose, to show it is the same type: [H0303] would ask for `I32?`.
##lint(H0303 = off)

priv enum Lookup_error
    bad

priv fn first(xs: I32[]): I32?
    if xs.len == 0
        return .none
    return .some(xs[0])

priv fn same(x: Option<|I32|>): I32? //< the long form passes where the short one is asked for
    return x

priv fn find(n: I32): I32?!Lookup_error //< a result whose value may be absent
    if n < 0
        throw .bad
    if n == 0
        return .none
    return .some(n)

priv fn optional_result(n: I32): (I32!Lookup_error)? //< an optional result, in brackets
    if n == 0
        return .none
    return .some(n)

fn test_option_sugar()
    verdict.start("[Option] `T?` written for `Option<|T|>` test...")
    xs: = I32[]::{ 4, 5 }
    $got: I32 = -1
    if v: = same(first(xs))
        got = v
    assert(got == 4, "`I32?` and `Option<|I32|>` pass for each other")
    bytes: = U8?[]::{ .some(1), .none }
    assert(bytes.len == 2, "`U8?[]` is a slice of optional bytes")
    $words: U8[]? = .none
    words = .some("hi")
    $word: U8[] = ""
    if w: = words
        word = w
    assert(word.equals("hi"), "`U8[]?` is an optional slice")
    found: = find(3) catch
        fallback .none
    $n: I32 = 0
    if f: = found
        n = f
    assert(n == 3, "`I32?!E` is a result whose value may be absent")
    absent: = find(0) catch
        fallback .some(9)
    assert(!absent.is_some(), "an absent value is not a failure")
    $r: I32 = 0
    if res: = optional_result(2)
        r = res catch -1
    assert(r == 2, "`(I32!E)?` is an optional result")
    verdict.pass("`T?` and `Option<|T|>` are one type, and the marks apply from the left.")

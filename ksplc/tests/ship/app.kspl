//< The KSPL customer: a program using `greet` through the interface it shipped, without its source
//<
//< `greet_api` is the file `ksplc --library=greet_api.kspl` wrote beside the library.
import "greet_api"
import "std/io"

fn main(): I32
    io.out().s("app starts\n")
    wrote: = greet_api.greet_hello(3)
    norm: = greet_api.greet_norm(greet_api.Greet_point::{ .x = 6, .y = 8 })
    io.out().s("app: \{wrote\} bytes, norm \{norm\}\n")
    return 0 if wrote == 24 && norm == 10 else 1

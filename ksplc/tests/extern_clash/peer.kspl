//< A fixture: declares the C function that `../negative/extern_clash.kspl` declares too, with
//< another return type
//< **The two cannot be one file**: one file cannot declare a name twice, and only the C name joins
//< the two declarations.
extern fn kspl_mono_us(): I64 //< the clock as the C runtime defines it

fn now(): I64 //< reads the clock through this file's declaration
    return kspl_mono_us()

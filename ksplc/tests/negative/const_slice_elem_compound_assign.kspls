//< A **compound assignment** to an element of a read-only slice
//<
//< Caution: Check a write on an index only for `=` and `s[0] += v` rewrites the element: the C
//< compiler does not catch it, since the generated C's const qualifier covers only the slice
//< descriptor's value (the `s.ptr` of `const Const_I32_Slice s` is not const).
// EXPECT: cannot write to an element of a read-only slice or array

fn bump_first(s: I32[])
  s[0] += 7

fn main(): I32
  $a: I32[2] = ::{}
  bump_first(I32$[]::a)
  return a[0]

//< A character literal is one byte
//<
//< Caution: **Do not let a spelling through whose body is not spent in one byte**: let it through
//< and char_literal_byte **returns the leading byte alone in silence** (`あ` becomes 227). Text
//< that does not fit one byte is a string (`U8[]`); one-byte spellings must not be caught up in it.
// EXPECT: a character literal holds exactly one byte
// EXPECT-NOT: 'a' is more than one
// EXPECT-NOT: '\n' is more than one
// EXPECT-NOT: '\u0041' is more than one
pub fn take(): I32
  // Caution: **Place both a multi-byte character and the shape with two characters side by side.**
  // With one alone, both an implementation "returning UTF-8's leading byte" and one "returning
  // the first character" pass green.
  wide: U8 = 'あ'
  two: U8 = 'ab'
  ok_plain: U8 = 'a'
  ok_escape: U8 = '\n'
  ok_code: U8 = '\u0041'
  return I32::(wide + two + ok_plain + ok_escape + ok_code)

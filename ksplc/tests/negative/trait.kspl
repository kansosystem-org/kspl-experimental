//< Traits, impls and methods
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case impl_blanket_over_type_param
//< Implementing a trait at once for every type that meets a constraint is not supported
//<
//< Monomorphisation makes a substance per concrete type, and with the target a type argument
//< (`impl<|T: Trait|> T`) there is nowhere settled to make it. Unrefused, the impl block is thrown
//< away in silence: no method grows, while whoever wrote it believes they implemented it.
// EXPECT: cannot implement methods for every type satisfying a constraint at once
// EXPECT: put the constraint on a generic free function
import "std/io"

pub trait Tagged<|T|>
  fn tag(r: Self): U8[]

impl<|T: Tagged<|T|>|> T: Formattable
  pub fn fmt(r: Self, w: Writer): Writer
    return w.s(r.tag())

pub struct A
  pub x: I32

impl A: Tagged<|A|>
  pub fn tag(_r: Self$@): U8[]
    return "A"

fn main(): I32
  io.out().s("the blanket impl attaches to nothing\n")
  return 0
// ==== case impl_gen_param_mut_mark
//< A mutability mark cannot be written on an impl's **own** type argument
//<
//< **It must not be ignored in silence.** Only the target's type expression settles which substance
//< it attaches to, so the mark changes nothing while its writer believes otherwise (Principle 5).
//< Write it on the target (`impl<|T|> Box<|$T|>`), as `ksplc/tests/variance_test.kspl` holds.
// EXPECT: '$' on an impl's own type parameter has no effect
import "std/io"

priv struct Box<|$T|>
  p: T$@

impl<|$T|> Box<|T|>
  fn read(r: Self): I32
    return r.p$

fn main(): I32
  io.out().s("unreachable\n")
  return 0
// ==== case impl_inst_duplicate_method
//< Two impls that define the same method name are rejected
//<
//< The template's table overwrites by name. **Let through, only the later one stays. The earlier
//< implementation is written but has no effect** (Principle 5).
// EXPECT: method 'doubled' is already defined for this type
import "std/io"

pub struct Boxed<|T|>
  pub val: T

impl<|T|> Boxed<|T|>
  pub fn doubled(r: Self): T
    return r.val

impl Boxed<|I8|>
  pub fn doubled(r: Self): I8
    return r.val * 2I8

fn main(): I32
  io.out().s("unreachable\n")
  return 0
// ==== case impl_inst_not_generic
//< An impl that writes type arguments on a non-generic type is rejected
//<
//< Caution: **Do not throw it away in silence.** Piling it into the template's column like the
//< one-instantiation shape (`impl Boxed<|I8|>`) lets a spelling mistake pass, and with no matching
//< substance no method grows anywhere (Principle 5).
// EXPECT: is not a generic type. It takes no type arguments here
import "std/io"

pub struct Plain
  pub val: I8

impl Plain<|I8|>
  pub fn doubled(r: Self): I8
    return r.val * 2I8

fn main(): I32
  io.out().s("unreachable\n")
  return 0
// ==== case impl_on_trait
//< A trait itself cannot be an impl's target
//<
//< A method absent from the declaration has no slot in the vtable, and the call becomes C in which
//< genc draws `vtable->hex`, which does not compile. Without refusing here, the user gets a raw C
//< compiler error rather than KSPL's diagnostic.
// EXPECT: cannot add methods to interface
// EXPECT: a small wrapper type conforming to the interface
import "std/io"

impl Writer
  pub fn hex2(r: Self, v: U64): Self
    return r.s("\{Sz::v\}")

fn main(): I32
  io.out().hex2(255).c('\n')
  return 0
// ==== case method_type_args_from_impl
//< A call to a generic type's method cannot write type arguments
//<
//< **There is nothing to bind them to:** they are the enclosing `impl`'s, settled by the receiver.
//< Dropped in silence, a contradiction (`get<|U8|>()` on a `Plain<|I32|>`) or a wrong count passes
//< (Principle 5). A method's **own** (`fn m<|T|>(…)`) is matched: the case `type_arg_mut_not_named`
//< in `type.kspl`.
// EXPECT: type arguments cannot be written here
import "std/io"

priv struct Plain<|T|>
  v: T

impl<|T|> Plain<|T|>
  fn get(r: Self): T
    return r.v

fn main(): I32
  q: Plain<|I32|> = ::{ .v = 3 }
  io.out().s("unreachable\n")
  return q.get<|U8|>()
// ==== case method_value_needs_type_args
//< A method is a value only through its type, with every type argument written
//<
//< Through its type, it is the function that takes the receiver first. The generic type's arguments
//< go on the type, and the method's own go after the method. Each refusal says what to write. Let
//< through, the method reached C as a bare name no function has. Through a value (`p.read`), there
//< is no room for the receiver. A trait's method is not one function.
//< Caution: Keep the passing side: `Box<|I32|>.keep` and `Plain.same<|I32|>` as values.
// EXPECT: generic method 'same' cannot be used as a value without its type arguments
// EXPECT: name one specialization with 'Plain.same<|…|>'. Write a type for each of 'T'
// EXPECT: generic type 'Box' needs its type arguments before one of its methods can be used as a value
// EXPECT: name the method on one instance with 'Box<|…|>.keep'. Write a type for each of 'T'
// EXPECT: generic method 'pair' cannot be used as a value without its type arguments
// EXPECT: method 'read' cannot be used as a value through a value of type
// EXPECT: or name it through its type with 'Plain.read'. When naming it through its type, pass the receiver as its first argument
// EXPECT: trait method 'Shape.area' cannot be used as a value
// EXPECT: function 'Plain.twice' is not generic. Remove the type arguments '<|I32|>'
// EXPECT: has no method named 'nosuch'
// EXPECT: method 'Box<|I32|>.keep' cannot be used as 'fn(I64):I64'. Its type is 'fn(I32):I32'
// EXPECT-NOT: undeclared identifier
priv typedef Op = fn(x: I32): I32

priv trait Shape
    fn area(r: Self): I32

priv struct Plain
    v: I32

impl Plain
    fn read(r: Self@): I32
        return r.v
    fn twice(x: I32): I32
        return x * 2
    fn same<|T|>(x: T): T
        return x

priv struct Box<|T|>
    v: T

impl<|T|> Box<|T|>
    fn keep(x: T): T
        return x
    fn pair<|U|>(_x: T, y: U): U
        return y

priv fn bare_method(): Op
    return Plain.same

priv fn bare_type(): Op
    return Box.keep

priv fn bare_own(): fn(x: I32, y: U8): U8
    return Box<|I32|>.pair

priv fn through_value(): I32
    p: = Plain::{ .v = 1 }
    f: fn(): I32 = p.read
    return f()

priv fn trait_slot(): fn(s: Shape): I32
    return Shape.area

priv fn stray(): Op
    return Plain.twice<|I32|>

priv fn missing(): Op
    return Box<|I32|>.nosuch

priv fn wrong_type(): fn(x: I64): I64
    return Box<|I32|>.keep

fn main(): I32
    // The passing side.
    ok: Op = Box<|I32|>.keep
    ok2: Op = Plain.same<|I32|>
    return ok(0) + ok2(0) + through_value()
// ==== case operator_lookalike_trait
//< Operator overloading covers only the traits of `std/lang` themselves
//<
//< A same-named trait in one's own file does not desugar `a + b` / `T::v` / `a[i]`. A match on the
//< name suffix (`.Add`) misreads it as the operator trait. KSPL gives no diagnostic. The **invalid
//< C** takes the receiver for a fat pointer and fails as a clang error that no user can map.
// EXPECT: requires
// EXPECT: to implement 'Add' interface
pub trait Add
  fn add(r: Self, o: Self): Self

pub struct V
  pub x: I32

impl V: Add
  pub fn add(r: Self, o: Self): Self
    return ::{ .x = r.x + o.x }

fn main()
  a: V = ::{ .x = 1 }
  b: V = ::{ .x = 2 }
  _c: = a + b
// ==== case receiver_mut
//< One subject, with one function for each of its shapes
//<
//< The marks are every function's marks gathered at the head. The same mark written N times
//< must match N places.
// EXPECT: cannot call a method that takes a writable receiver
// EXPECT: cannot call a method that takes a writable receiver
// EXPECT: cannot call a method that takes a writable receiver
// EXPECT: cannot assign to an immutable variable 'x'
// EXPECT: cannot assign to an immutable variable 'r'

// A method taking `Self$@` (a receiver it can rewrite) could be called on a read-only place. **A
// receiver is a place whose address is taken implicitly.** If only the assignment is shut, a
// mutable receiver's method on the same place can still write. `cs.n = 9` was rejected, but
// `cs.bump()` passed. Against `const` data it becomes a write to ROM.
// A method taking `Self@` can be called on a read-only place too (it declares that it does
// not write).
struct Box
  n: I32

impl Box
  fn bump(r: Self$@)
    r.n = 99
  fn peek(r: Self@): I32
    return r.n

impl U8
  fn bump_byte(r: Self$@)
    r$ = 99

const RO_BOX: Box = ::{ .n = 1 }
const RO_ARR: U8[4] = ::{ 1, 2, 3, 4 }

fn case_mut_method_on_readonly_recv(): I32
  RO_BOX.bump() // a const struct
  RO_ARR[0].bump_byte() // an element of a const array
  $live: Box = ::{ .n = 1 }
  rp: Box@ = live@ // a read-only pointer
  rp.bump()
  return RO_BOX.peek() // Self@ passes

// A binding is immutable unmarked (to make it mutable, write `$x: = ...`). Reassigning to an
// unmarked binding should be refused.
fn case_immut_binding_reassign()
  x: I32 = 5
  x = 10

// A read-only receiver passed by value, `r: Self` (unmarked, so immutable on the binding axis). A
// field write by way of the binding `r` should be refused by sema (enforce_mutability walks the
// `.` and checks the root binding's is_mut). To rewrite it, use the binding axis's `$r: Self`.
struct P
  priv x: I32
impl P
  priv fn bad(r: Self)
    r.x = 5
fn case_immut_value_receiver_field_write()
  p: = P::{ .x = 3 }
  p.bad()

fn main()
  case_mut_method_on_readonly_recv()
  case_immut_binding_reassign()
  case_immut_value_receiver_field_write()
// ==== case trait_index_address_of
//< `@` on an index access through `Index`, the trait that returns a value, is rejected
//<
//< `get` returns a copy, so the `@` is a temporary's address and a `p$ = v` write quietly misses
//< the container. The built-in slice and array and an `Index_place` type give a true
//< element address with `a[i]@`; this case covers a type implementing `Index` alone.
// EXPECT: cannot take the address of an element accessed through the 'Index' interface

struct Pair
  a: I32
  b: I32

impl Pair: Index<|Sz, I32|>
  fn get(r: Self$@, index: Sz): I32
    return r.a if index == 0 else r.b

fn main(): I32
  p: Pair = ::{ .a = 1, .b = 2 }
  q: = p[0]@
  return q$
// ==== case trait_index_compound_assign
//< A compound assignment to an index through `Index_mut`, the trait that passes values in and out
//<
//< `get`/`set` exchange values and return no element place, so a read-and-write-back cannot be
//< assembled; let through, genc emits an invalid three-argument getter call and C fails.
//< Implement "an index returning a place" (`Index_place`) and `a[i] += v` can be used.
// ==========================================
// EXPECT: compound assignment is not supported for types that index through 'Index_mut'
// interface
// ==========================================

struct Pair
  a: I32
  b: I32

impl Pair: Index<|Sz, I32|>
  fn get(r: Self$@, index: Sz): I32
    return r.a if index == 0 else r.b

impl Pair: Index_mut<|Sz, I32|>
  fn set(r: Self$@, index: Sz, val: I32)
    if index == 0
      r.a = val
    else
      r.b = val

fn main(): I32
  $p: Pair = ::{ .a = 1, .b = 2 }
  p[0] += 5
  return p.a
// ==== case trait_proto_missing_param_type
//< A trait method prototype that omits a parameter's type annotation
//<
//< A prototype holds no body and skips infer_fn, which rejects this in an ordinary function, so
//< unchecked here it passes in silence. The omitted annotation still gets type_expr "Unknown" from
//< normalisation, so the check reads the resolved type ID, not the node (see add_trait_method).
// EXPECT: parameter 'r' has no type. Write 'r: <type>'
priv trait Drawable
  fn draw(r)

priv struct V
  x: I32

impl V: Drawable
  fn draw(r: Self@)
    _unused: = r.x

fn main()
  v: V = ::{ .x = 1 }
  d: Drawable = v
  d.draw()
// ==== case trait_self_in_parameter
//< `Self` cannot be written on a trait method's parameters other than the receiver
//<
//< A thunk hands the fat pointer to the implementation's concrete type, so C falls on a mismatch
//< (write `trait Eq<|Other|>` instead). A `Self$@` receiver draws another diagnostic, so it stays
//< out (`case_trait_receiver_must_be_plain_self` in the case trait_shape in tests/negative/trait.kspl).
// EXPECT: 'Self' cannot be used for a parameter other than the receiver
// EXPECT-NOT: fn dup(r: Self): Self;
pub trait Bad
  fn dup(r: Self): Self
  fn equals(r: Self, other: Self): Bool

pub struct Key
  pub a: I32

impl Key: Bad
  pub fn dup(r: Self$@): Self$@
    return r
  pub fn equals(r: Self@, other: Key): Bool
    return r.a == other.a

fn main(): I32
  $k: Key = ::{ .a = 1 }
  return k.dup().a - 1
// ==== case trait_self_inside_return
//< A trait method cannot hold `Self` **at a type argument's position** in its return type
//<
//< The type of the vtable's slot changes per implementation, so nothing settles what fills it.
//< Caution: **Do not mix it with returning `Self` itself**, which passes as a pointer, and whose
//< wording and mend differ (check_trait_method_ret in `ksplc/sema/decl/trait_check.kspl`).
// EXPECT: has 'Self' inside its return type
// EXPECT-NOT: so this implementation must return

priv struct Wrap<|S|>
  priv inner: S

priv trait Chain<|T|>
  fn next(r: Self): T?

  fn wrapped(r: Self): Wrap<|Self|>
    return Wrap<|Self|>::{ .inner = r }

priv struct Src
  priv i: I32

impl Src: Chain<|I32|>
  priv fn next(r: Self$@): I32?
    if r.i >= 2
      return .none
    r.i += 1
    return .some(r.i)

fn main()
  _w: = Src::{ .i = 0 }.wrapped()
// ==== case trait_shape
//< One subject, with one function for each of its shapes
//<
//< The marks are every function's marks gathered at the head. The same mark written N times
//< must match N places.
// EXPECT: return type 'Hidden' is less visible than the interface method exposing it
// EXPECT: interface method receivers must be written as plain 'Self'
// EXPECT: interface method receivers must be written as plain 'Self'
// EXPECT: returns 'Self'. This implementation must return 'I8$@' (a pointer)
// EXPECT: never a raw pointer
// EXPECT: cannot access symbol

// A `pub trait`'s method can return a `priv` type. A side that receives the trait value then gets
// a value of that type with `d.get()`. The return-value check on the conforming impl is not
// enough. Where the `impl` target type is `priv`, the method's effective visibility becomes
// `priv` and it passes. So the check covers the prototype side too
// (docs/DESIGN-programming-language.md "Why a typedef cannot be published wider than its target").
priv struct Hidden
  v: I32

pub trait I
  fn get(r: Self$@): Hidden

fn case_trait_proto_less_visible() {}

// A trait method's receiver can only be written as a plain `Self`.
// A `Self$@` would carry a meaning that cannot be read from the characters. The implementation
// side is not bound: a thunk bridges value↔pointer. So an implementation declared as `Self` can
// still receive `Self$@` and rewrite the receiver. But the caller's lvalue check becomes strict:
// it forbids a temporary in the receiver, as in `io.out().s("x")`.
// The option itself is removed (docs/DESIGN-programming-language.md "Why a trait's receiver is fixed to a bare `Self`").
pub trait Mutating
  fn bump(r: Self$@): I32

pub trait Reading
  fn peek(r: Self@): I32

pub struct S
  pub n: I32

impl S: Mutating
  pub fn bump(r: Self$@): I32
    r.n += 1
    return r.n

impl S: Reading
  pub fn peek(r: Self$@): I32
    return r.n

fn case_trait_receiver_must_be_plain_self(): I32
  s: S = ::{ .n = 0 }
  return s.bump() + s.peek()

// Where a trait declares that it returns `Self`, the implementation side must return a pointer
// (`Self$@`). A thunk repacks the return value into the trait's fat pointer, so it needs the
// target's address. Returned by value, the trait value would point at a temporary. Without the
// refusal, the generated C became `&a temporary` with no diagnostic from KSPL. A raw C
// compiler error reached the user.
import "std/io"

pub trait Zeroed
  fn zero(r: Self): Self

impl I8: Zeroed
  pub fn zero(_r: Self$@): I8
    return 0I8

fn case_trait_self_return_by_value(): I32
  io.out().s("this impl cannot be lowered\n")
  return 0

// A trait's methods inherit the trait's own visibility by default. A `priv` written per method
// takes precedence. `Ref_counted` is a pub trait, but retain/release are priv. So they cannot be
// called even through an upcast to a trait value.
// Without this check, an upcast could call a concrete type's priv method (whose direct call is
// refused). The call would double the automatic one and write into freed memory
// (use-after-free).
import "std/refcount" { Rc }

fn case_trait_method_priv_upcast()
  $a: = Rc<|I32|>.new(1)
  d: Ref_counted = a
  d.release()

fn main()
  case_trait_proto_less_visible()
  case_trait_receiver_must_be_plain_self()
  case_trait_self_return_by_value()
  case_trait_method_priv_upcast()
// ==== case trait_upcast_returns_local
//< Returning or throwing a trait value upcast from local storage is rejected
//<
//< The upcast synthesises `&the value` with no `@` in the source, so it dangles once the frame goes
//< (docs/DESIGN-programming-language.md "Which pointers into a frame are stopped from leaving it"). A
//< value parameter and a throw are the same. Into a `Trait!Err`, the upcast sits inside
//< result_wrap. The check peels that off and checks it too.
// EXPECT: cannot return an interface value built from local storage
// EXPECT: cannot return an interface value built from local storage
// EXPECT: cannot throw an interface value built from local storage

pub trait Shape
  fn area(r: Self$@): I32

pub struct Sq
  pub n: I32

impl Sq: Shape
  pub fn area(r: Self$@): I32
    return r.n * r.n

priv fn from_local(): Shape
  $s: = Sq::{ .n = 7 }
  return s

priv fn from_param(s: Sq): Shape
  return s

priv fn thrown(): I32!Shape
  $s: = Sq::{ .n = 5 }
  throw s

fn main()
  a: = from_local()
  b: = from_param(Sq::{ .n = 2 })
  c: = thrown() catch
    fallback 0
  _x: = a.area() + b.area() + c
// ==== case trait_value_default_body_call
//< A method with a default body has no vtable slot, so it cannot be called from a trait value
//<
//< Let it through and the call names a field absent from the C. It fails at the C compiler with no
//< KSPL diagnostic (has_vtable_slot in `ksplc/base/ast_ext.kspl`). From a concrete type it stays
//< callable: that reaches the body copied per implementation.
// EXPECT: has a default body. It has no vtable slot
// EXPECT-NOT: has no field or method named

pub struct Down
  pub n: I32

impl Down: Iter<|I32|>
  pub fn next(r: Self$@): I32?
    if r.n <= 0
      return .none
    r.n -= 1
    return .some(r.n)

fn main()
  $d: = Down::{ .n = 3 }
  it: Iter<|I32|> = d@
  _n: = it.count()
// ==== case trait_value_wrapped_in_struct_escapes
//< A trait value built from local storage is rejected when carried out on a struct
//<
//< Returning it bare is the case `trait_upcast_returns_local`. Without this, a struct holding a
//< closure escapes and is called with its environment dead. The passing side is held by
//< **running correctly** (test_closure_wrapped_in_struct in `ksplc/tests/lang_limits_test.kspl`).
// EXPECT: cannot return a closure: it keeps pointers to its captured variables
// EXPECT: cannot throw a closure: it keeps pointers to its captured variables

priv struct Holder
  pred: Callable1<|I32, Bool|>

priv fn wrapped_return(n: I32): Holder
  return Holder::{ .pred = fn(x: I32; n: I32): Bool {
    return x > n;
  } }

priv fn wrapped_throw(n: I32): I32!Holder
  throw Holder::{ .pred = fn(x: I32; n: I32): Bool {
    return x > n;
  } }

fn main()
  a: = wrapped_return(1)
  b: = wrapped_throw(1) catch
    fallback 0
  _x: = b if a.pred.call(2) else 0

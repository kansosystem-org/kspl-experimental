//< A `\` at a line's end continues a **string** on the next line
//<
//< A character literal holds one byte on one line, so the mark there is refused like any other
//< (`line_continuation_span`, asked before `is_known_escape`, in ksplc/base/literal.kspls).
//< Caution: **Watch which refusal comes out:** read as a continuation, it draws a wrong complaint.
// EXPECT: unknown escape
// EXPECT-NOT: holds exactly one byte
pub fn take(): I32
  bad: U8 = '\
'
  return I32::bad

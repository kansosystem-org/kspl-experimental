//< A default cannot be written on the implementation either
//<
//< A call through a trait resolves to the trait's declaration, so it does not look at the
//< implementation side's default (the same way C++'s inherited defaults break).
// EXPECT: a trait implementation cannot give a parameter a default value

priv trait Greeter
  fn greet(r: Self, n: I32): I32

priv struct A
  v: I32

impl A: Greeter
  fn greet(r: Self, n: I32 = 9): I32
    return r.v * n

fn main(): I32
  a: A = ::{ .v = 3 }
  return a.greet(1)

//< Use after free (across a function boundary)
//<
//< It is detected where a wrapper function under another name .free()s internally.
// EXPECT: may already be freed here
struct Foo
  priv other: I32
impl Foo
  priv fn free($r: Self$@)
    r.other = 0
fn close_it(x: Foo$@)
  x.free()
fn takes(x: Foo) {}
fn main()
  $f: = Foo::{ .other = 2 }
  close_it(f@)
  takes(f)

// The declaration that has the release tracked (Owned in std/lang.kspls).
impl Foo: Owned {}

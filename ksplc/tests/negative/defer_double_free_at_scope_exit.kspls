//< A defer's body is checked against the state at the point of leaving the scope
//<
//< Analyse at registration and nothing after the defer statement is visible, so this double free
//< passes with zero diagnostics (reversing the order detects it, the asymmetry that marks the bug;
//< ksplc/docs/DESIGN.md §11.1).
// EXPECT: variable 'b' may already be freed here
import "std/str"
import "std/str" { Str_builder }

fn main()
  $b: = Str_builder.new()
  defer b.free()
  b.free()

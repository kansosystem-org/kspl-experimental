//< A function written with `;` in place of its body is refused, free or inside an `impl`
//<
//< Nothing in the program would define it. A function defined in C, or in a library built from
//< KSPL, is declared in an `extern "C"` block instead.
// EXPECT: 'twice' has no body
// EXPECT: 'area' has no body
// EXPECT-NOT: [
pub fn twice(n: I32): I32

struct Box
  w: I32

impl Box
  pub fn area(r: Box): I32

fn main(): I32
  return twice(Box::{ .w = 1 }.area())

//< A cycle among constant definitions is rejected
//<
//< Otherwise the name goes straight into C's initialiser and the C compiler fails there
//< (ksplc/docs/DESIGN.md 2.1). **A backward reference is not a cycle** and has to pass; stopping it
//< binds top-level declarations to file order (sema's collect Pass 2a/2b, emit_top_level_vars).
// EXPECT: circular constant definition detected
// EXPECT-NOT: initializer element
pub const A: I32 = B
pub const B: I32 = A
// The passing side: a chain referring to constants declared later, and the shape using that as an
// array length.
pub const C: I32 = D + 1
pub const D: I32 = E * 2
pub const E: I32 = 5
pub $buf: U8[F] = ::{}
pub const F: Sz = 4
fn main()
  _x: = A
  _y: = C
  _z: = buf.len

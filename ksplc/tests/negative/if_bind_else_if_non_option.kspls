//< An `else if name: = expression` is held to `Option` as the first `if` of a chain is
//<
//< A `T!E` is not an `Option` either: its error side has a case of its own to handle, and a binding
//< would pass it in silence. The binding stands in the `else` here, where the check once never ran
//< and genc stopped on it instead.
// EXPECT: 'if <name>: = <expr>' binds an 'Option'
// EXPECT-NOT: ICE
enum Fail
  bad

fn first(n: I32): I32?
  return .some(n) if n == 1 else .none

fn second(n: I32): I32!Fail
  if n == 2
    return n
  throw .bad

fn main(): I32
  if a: = first(2)
    return a
  else if b: = second(2)
    return b
  return 0

//< `@` on an index access through `Index`, the trait that returns a value, is rejected
//<
//< `get` returns a copy, so the `@` is a temporary's address and a `p$ = v` write quietly misses
//< the container. The built-in slice and array and an `operator.Index_place` type give a true
//< element address with `a[i]@`; this case covers a type implementing `Index` alone.
// EXPECT: cannot take the address of an element accessed through the 'Index' interface

struct Pair
  a: I32
  b: I32

impl Pair: Index<|Sz, I32|>
  fn get(r: Self$@, index: Sz): I32
    return r.a if index == 0 else r.b

fn main(): I32
  p: Pair = ::{ .a = 1, .b = 2 }
  q: = p[0]@
  return q$

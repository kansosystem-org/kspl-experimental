//< Types: names, aliases and the literals that need one
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case alias_fn_ptr_hides_type
//< The same rule applies to a function pointer's alias too
//<
//< There is no declaration of what it succeeds, but the visibility works as a cap: **it cannot be
//< wider than any name appearing in the type expression**. Miss a type slipped into a parameter and
//< the shape passes where a side that cannot name it receives that value.
// EXPECT: target type 'Hidden' is less visible than the typedef
// EXPECT-NOT: [
priv struct Hidden
  v: I32

pub typedef Cb = fn(h: Hidden): I32

pub fn run(f: Cb): I32
  return 0 if f == null else 1

fn main(): I32
  return 0
// ==== case alias_wider_than_target
//< An alias cannot be more public than its target type
//<
//< An alias puts a type's name outward, so written more widely a side that cannot name the target
//< can receive its value, and the visibility written on the target stops taking effect (the same
//< rule as Rust's E0364 / E0365, Swift's public typealias and Kotlin's typealias).
// EXPECT: target type 'Hidden' is less visible than the typedef
// EXPECT-NOT: [
priv struct Hidden
  v: I32

pub typedef Exposed = Hidden

fn main(): I32
  e: Exposed = ::{ .v = 1 }
  return e.v
// ==== case cast_fn_type_signature
//< A cast between function types whose signatures differ is refused
//<
//< A call through it hands the function its arguments in the other signature's shape, undefined
//< behaviour that C compiles without a word. The parameters' names and an alias do not count, and
//< an address that arrives as `Void@` still becomes a function type.
// EXPECT: cannot cast 'fn(I32):I32' to 'fn(I64):I64': a function called through another signature receives its arguments and gives its result in the wrong shape
// EXPECT: Hint: write a function of that signature which calls this one
// EXPECT: cannot cast 'fn(I32):I32' to 'fn(I32,I32):I32'
// EXPECT: cannot cast 'fn(I32):I32' to 'fn(I32):Void'
// EXPECT: Finished with 3 error(s)
typedef Num = I32

priv fn twice(x: I32): I32
  return x * 2

fn main(): I32
  f: = twice
  _wide: = (fn(x: I64): I64)::f
  _more: = (fn(x: I32, y: I32): I32)::f
  _none: = (fn(x: I32): Void)::f
  renamed: = (fn(n: Num): Num)::f
  raw: = Void@::f
  back: = (fn(x: I32): I32)::raw
  return renamed(1) + back(2)
// ==== case cast_to_aggregate
//< A cast to or from an aggregate is refused in KSPL, not left to the C compiler
//<
//< C casts only to a scalar, so each of these would reach the C compiler as an invalid cast. An
//< enum without payloads cast from an integer, and a slice made from an array, stay casts.
// EXPECT: cannot cast to enum type 'cast_to_aggregate.E' with payloads
// EXPECT: cannot cast to optional type 'I32?'
// EXPECT: cannot cast to optional type 'cast_to_aggregate.P?'
// EXPECT: cannot cast to array type 'I64[2]'
// EXPECT: cannot cast to trait type 'cast_to_aggregate.Shape'
// EXPECT: cannot cast 'cast_to_aggregate.Shape' to 'I32'
// EXPECT-NOT: Plain
trait Shape
  fn area(r: Self): I32

priv struct P
  x: I32

impl P: Shape
  fn area(r: Self@): I32
    return r.x

priv enum E
  a(x: I32)
  b

priv enum Plain
  one
  two

fn main(): I32
  p: P = ::{ .x = 1 }
  arr: I32[2] = ::{ 1, 2 }
  _e: = E::5
  _o: = I32?::5
  _op: = P?::p
  _wide: = I64[2]::arr
  _s: = Shape::p
  held: Shape = p
  _n: = I32::held
  // The passing side.
  _ok_enum: = Plain::1
  _ok_view: = I32[]::arr
  return 0
// ==== case type_arg_bare_is_readonly
//< An **unmarked** type argument at a position declared mutable makes the target immutable
//<
//< In `struct Box<|$T|>` KSPL's default is immutable and the mark attaches to the mutable side.
//< Caution: **Pin it down together with the passing side**: `Box<|$I32|>` must stay writable
//< (`ksplc/tests/variance_test.kspls`), or a checker refusing both passes here too.
// EXPECT: cannot write through a read-only pointer
import "std/io"

priv struct Box<|$T|>
  p: T$@

$slot: I32 = 5

fn main(): I32
  ro: Box<|I32|> = ::{ .p = slot@ }
  ro.p$ = 9
  io.out().s("\{ro.p$\}\n")
  return 0
// ==== case type_arg_mut_method_body
//< An immutable type argument at a declared position cannot be written even in a method's body
//<
//< Unlike the built-in slice, whose `impl U8$[]` body an immutable slice can call and which fails
//< at run time, the generic body is instantiated per type argument, so its immutable version is
//< refused at translation time.
// EXPECT: cannot write through a read-only pointer
import "std/io"

priv struct Box<|$T|>
  p: T$@

impl<|T|> Box<|T|>
  fn poke(r: Self, v: T)
    r.p$ = v

$slot: I32 = 1

fn main(): I32
  ro: Box<|I32|> = ::{ .p = slot@ }
  ro.poke(99)
  io.out().s("\{slot\}\n")
  return 0
// ==== case type_arg_mut_not_named
//< The mutability mark on a type argument can be written only where the declaration declared it
//<
//< Caution: **It must not be ignored in silence.** Ignored, `Plain<|$I32|>` and `Plain<|I32|>`
//< become the same type, and whoever wrote it believes the target became mutable (Principle 5).
//< The shape that declares it is held by `ksplc/tests/variance_test.kspls`.
// EXPECT: '$' on a type argument is only allowed where the declaration names it
import "std/io"

priv struct Plain<|T|>
  v: T

fn main(): I32
  bad: Plain<|$I32|> = ::{ .v = 1 }
  io.out().s("\{bad.v\}\n")
  return 0
// ==== case type_arg_mut_only_method
//< An impl with `$` on the target's type argument attaches **only to the mutable version**
//<
//< The form is `impl<|T|> Box<|$T|>`; from the immutable version its method is "no such method".
//< **A method that writes goes in this shape**: in `impl<|T|> Box<|T|>` the declaration fails
//< (the case `type_arg_mut_method_body`). The passing side is `ksplc/tests/variance_test.kspls`.
// EXPECT: has no field or method named 'poke'
import "std/io"

priv struct Box<|$T|>
  p: T$@

impl<|T|> Box<|$T|>
  fn poke(r: Self, v: T)
    r.p$ = v

$slot: I32 = 1

fn main(): I32
  m: Box<|$I32|> = ::{ .p = slot@ }
  m.poke(1)
  ro: Box<|I32|> = ::{ .p = slot@ }
  ro.poke(99)
  io.out().s("\{slot\}\n")
  return 0
// ==== case type_arg_weaken_wrong_way
//< The one-step weakening goes **only in the weakening direction**
//<
//< `Box<|I32|>` does not pass as `Box<|$I32|>` (passing side: `ksplc/tests/variance_test.kspls`).
//< Caution: **The mark is checked in the text too.** Without it both sides display `Box<|I32|>`,
//< and "expected 'X', but got 'X'" passes (display_generic_arg_to in `sema/type/display.kspls`).
// EXPECT: Box<|$I32|>'
import "std/io"

priv struct Box<|$T|>
  p: T$@

priv fn takes_mut(b: Box<|$I32|>): I32
  b.p$ = 42
  return b.p$

$slot: I32 = 5

fn main(): I32
  ro: Box<|I32|> = ::{ .p = slot@ }
  io.out().s("\{takes_mut(ro)\}\n")
  return 0
// ==== case type_args_on_plain_type
//< Type arguments after a type that declares none are refused where they are written
//<
//< They would bind nothing (Principle 5), before a member, in a type position and on a struct
//< literal alike, as after a function that declares none. Let through, the call ran on the plain
//< type and the type position named a type no declaration holds.
//< Caution: Keep the passing side: the same names without the arguments.
// EXPECT: type 'Plain' is not generic, so '<|I32|>' names nothing: drop it
// EXPECT-NOT: has no field or method
// EXPECT-NOT: expected 'Plain
priv struct Plain
    v: I32

impl Plain
    fn mk(v: I32): Self
        return Self::{ .v = v }

priv fn through_type(): I32
    return Plain<|I32|>.mk(3).v

priv fn in_type_position(p: Plain<|I32|>): I32
    return p.v

priv fn on_a_literal(): I32
    return Plain<|I32|>::{ .v = 4 }.v

fn main(): I32
    // The passing side.
    p: Plain = Plain.mk(1)
    return p.v
// ==== case type_mismatch
//< A type mismatch: a string literal assigned to an I32
// EXPECT: expected 'I32', but got 'U8[]'
fn main()
  x: I32 = "not an int"
// ==== case type_name_as_value
//< A type's own name is not a value: with nothing expected it has no type, and with a type expected
//<
//< Let through, a primitive reaches genc as a bare `Primitive_type` node (an ICE) and a declared
//< type emits an undefined C symbol, a C compiler error instead of a diagnostic (Principle 8 in
//< `../../../docs/DESIGN.md`); expected to be a value, it was taken as one without a word.
// EXPECT: 'Sz' names a type, and a type is not a value
// EXPECT-NOT: cannot infer type for
// EXPECT: 'Row' names a type, and a type is not a value. Write the value itself, a cast ('Row::x')
// EXPECT: 'Self' names a type, and a type is not a value
// EXPECT: 'Pair<|I32|>' names a type, and a type is not a value
// EXPECT-NOT: [ICE]
priv typedef Op = fn(x: I32): I32

priv struct Row
  text: U8[]

priv struct Pair<|T|>
  a: T

impl Row
  fn probe(r: Self@): Sz
    b: = Self
    return r.text.len + Sz::b
  fn typed_self(): I32
    x: I32 = Self
    return x

fn case_typed(): I32
  f: Op = Row
  return f(1)

fn case_compared(f: Op): Bool
  return Pair<|I32|> == f

fn main(): I32
  p: = Sz
  d: = Row
  r: Row = ::{ .text = "x" }
  return I32::(r.probe() + Sz::p + Sz::d) + case_typed() + Row.typed_self() +
    I32::case_compared(null)
// ==== case typedef_cycle
//< A typedef that leads back to itself is refused once, naming the alias
//<
//< It never reaches an underlying type. The bare "circular typedef detected" named no alias, so in
//< a file of many the writer had to find the cycle by hand. **A use of the alias adds nothing**: a
//< mismatch against a type nothing can reach would only hide the cycle's error.
// EXPECT: circular typedef: 'A' leads back to itself
// EXPECT: Finished with 1 error(s)
typedef A = B
typedef B = A

fn main(): I32
    x: A = 0
    return x
// ==== case typedef_written_as_alias
//< Another language's keyword for a type alias suggests `typedef`, with the line to write
//<
//< `alias Id = I32` reads as a variable `alias` wanting a `:`, so the expectation list alone leads
//< nowhere (`append_typedef_spelling_hint` in `../../parse/syntax_msg.kspls`). Rust's, Go's and
//< Python's `type`, Swift's `typealias` and C++'s `using` get the same note; visibility stays.
// EXPECT: typedef_written_as_alias.kspls:8:11: error: expected ':'
// EXPECT: another name for a type is declared with 'typedef': 'pub typedef Id = I32'.
pub alias Id = I32

fn main(): I32
  x: Id = 3
  return x
// ==== case undefined_callee_once
//< An undefined function is reported once, by the name check
//<
//< A callee is resolved as a name before the call is checked, so the call's own report would count
//< the same mistake twice.
// EXPECT: undefined path or identifier 'nope'
// EXPECT: Please check for typos
// EXPECT: Finished with 1 error(s)
fn main(): I32
  nope()
  return 0
// ==== case undefined_ident
//< A reference to an undefined identifier
// EXPECT: undefined path or identifier
fn main()
  y: = undefined_thing_xyz
// ==== case undefined_ident_capitalized
//< An undefined name starting with a capital is reported in a value position too
//<
//< Miss it on "a capital means a type" and a misspelling passes: declared by inference it is an
//< internal error in genc (no type), elsewhere a C compiler error (Principle 2). The report stops
//< at one item, so only one position can be pinned down.
// EXPECT: undefined path or identifier 'Str_builde'
// EXPECT-NOT: Internal Compiler Error
fn main()
  _x: = Str_builde
// ==== case unknown_attribute
//< An attribute whose name is mistyped (`#inlne`)
//<
//< The grammar takes any identifier as an attribute name, so an unknown one parses and would
//< silently do nothing (an unimplemented one such as `#no_mangle` too). It is matched against
//< `is_known_attribute` in `ksplc/sema/decl/attrs.kspls` and refused.
// EXPECT: unknown attribute '#inlne'

#inlne
fn f() {}

fn main(): I32
  f()
  return 0
// ==== case unknown_field
//< Access to a field that does not exist
// EXPECT: has no field or method named
struct P
  priv x: I32
fn main()
  p: = P::{ .x = 1 }
  q: = p.nonexistent
// ==== case untyped_literal_bounds
//< Checks that an integer literal whose type is not yet decided fits the type actually computed
//<
//< **At the literal's position it cannot be checked**: the default I32 and a later wider type look
//< alike there, so a binary's node and an unannotated declaration's initialiser decide.
//< Caution: **Keep the non-firing side alongside**, or an unsettled literal turns `wide_ok` away.

// EXPECT: literal '2147483648' is out of range for type 'I32'
// EXPECT: literal '4294967296' is out of range for type 'I32'
// EXPECT: literal '-2147483649' is out of range for type 'I32'
// EXPECT: literal '8589934592' is out of range for type 'I32'
// EXPECT: literal '-4294967296' is out of range for type 'I32'
// EXPECT: literal '300' is out of range for type 'U8'
import "std/io"

fn main(): I32
  silent_wrap: = 2147483648
  silent_zero: = 4294967296
  silent_neg: = -2147483649
  // Even where the initialiser is an expression, it is looked at by the type computed (the
  // default I32 here).
  in_expr: = 8589934592 + 1
  // A negative literal on the left of a `-` is looked at by the type computed too (no expected
  // type, so the default I32).
  neg_in_expr: = -4294967296 - 1
  // Write the width and it passes. A type annotation or a suffix will do (that the errors do
  // not grow here is pinned down too).
  with_suffix: = 2147483648U32
  with_annotation: I64 = 4294967296
  at_bounds: = -2147483648
  // An expression where the expected type descends on one side alone. Promoted it is a U64, so
  // both literals fit.
  wide_ok: U64 = 4294967296 + 1
  // A literal that does not fit an I32 by default but fits the promoted U32.
  v32: U32 = 7U32
  hash_ok: = v32 * 0x85ebca6b
  // The side where a binary's right-hand literal takes the left-hand side's type. The criterion
  // being `U8`, 300 does not fit.
  v8: U8 = 5U8
  narrow_lit: U8 = v8 + 300
  // It passes if it fits.
  narrow_ok: U8 = v8 + 200
  // The expected type differs from the left-hand side's, so it is outside the exception.
  // Promoted to the default `I32`, 300 fits.
  wide_from_narrow: I32 = v8 + 300
  io.out()
    .s("\{I64::silent_wrap\}\{I64::silent_zero\}\{I64::silent_neg\}\{I64::in_expr\}\{I64::neg_in_expr\}\{I64::with_suffix\}\{with_annotation\}\{I64::at_bounds\}\{I64::wide_ok\}\{I64::hash_ok\}\{I64::narrow_lit\}\{I64::narrow_ok\}\{I64::wide_from_narrow\}\n")
  return 0
// ==== case value_name_as_type
//< A value's name is not a type, so a declaration typed with one is refused
//<
//< Let through, the name read as the value's type: `x: twice` declared an `I32` (the function's
//< return type), `y: g` the global's `I64`, and nothing was reported. A pointer to a function
//< is written as a function type. The inverse is
//< the case `type_name_as_value`.
// EXPECT: 'twice' is a function, not a type. A pointer to one has a function type
// EXPECT: 'twice' is a function, not a type
// EXPECT: 'same<|U8|>' is a function, not a type
// EXPECT: 'g' is a variable, not a type
// EXPECT: 'Holder<|I32|>.keep' is a member of a type, not a type
// EXPECT: 'Plain.v' is a member of a type, not a type
priv fn twice(x: I32): I32
    return x * 2

priv fn same<|T|>(x: T): T
    return x

priv struct Holder<|T|>
    v: T

impl<|T|> Holder<|T|>
    fn keep(x: T): T
        return x

priv struct Plain
    v: I32

priv g: I64 = 3

fn case_function(): I32
    x: twice = 5
    return x

fn case_pointer(): Bool
    p: twice@ = null
    return p == null

fn case_specialization(): I32
    z: same<|U8|> = 3
    return I32::z

fn case_variable(): I64
    y: g = 4
    return y

fn case_member(): I32
    m: Holder<|I32|>.keep = 3
    return I32::m

fn case_field(): I32
    v: Plain.v = 3
    return v

fn main()
    _a: = case_function() + I32::case_pointer() + case_specialization() + I32::case_variable() +
        case_member() + case_field()
// ==== case variant_where_no_enum
//< A `.variant` where the expected type is no enum is refused, naming that type
//<
//< The short form takes its enum from the place; an `I32` gives none, so the message says which
//< type the place expects and that the value is to be written in full.
// EXPECT: '.small' needs an enum here, but the expected type is 'I32'. Write the value in full
fn main(): I32
    x: I32 = .small
    return x

//< A leading `0` is refused in a type's array length too, where no expression is inferred
//<
//< The grammar refuses the spelling, so every place a literal can stand refuses it alike; a check
//< in the analysis would have to be repeated wherever a constant is folded.
// EXPECT: a decimal integer does not start with 0, and KSPL has no octal literal, so '09'
// EXPECT-NOT: or '0x
priv const table: U8[09] = ::{}

fn main(): I32
  return I32::table.len

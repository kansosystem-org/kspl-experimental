//< The counterpart of the two cases above
//<
//< Where the release happens once, or where it is reassigned after the release, no diagnostic comes
//< out. It is made to fail deliberately for a different reason (an undefined symbol), and an
//< EXPECT-NOT pins down that not one use-after-free diagnostic comes out.
// EXPECT: undefined path or identifier 'no_such_fn'
// EXPECT-NOT: may already be freed here
import "std/mem"
import "std/mem" { dealloc }
import "std/str"
import "std/str" { Str_builder }

priv struct S
  v: I32

impl S
  priv fn free(r: Self$@)
    dealloc(Void$@::r)

fn main()
  $p: = mem.alloc_as<|S|>()
  p.v = 1
  p.free()
  p = mem.alloc_as<|S|>()
  _y: = p.v
  p.free()

  b: = Str_builder.new()
  defer b.free()
  b.s("x")
  _n: = b.len

  no_such_fn()

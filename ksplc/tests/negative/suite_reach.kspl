//< A suite whose tests stand in other files it cannot call: a `priv` test, an alias left out
//< **It imports this package's fixtures** (`../suite_reach/`), so it compiles where it stands.
//< Let through, either would be a call the analysis refuses at the suite, far from the cause.
// EXPECT: test 'test_hidden' is 'priv', so the suite 'Tests' in another file cannot call it
// EXPECT: the import names no alias to call them through
import "ksplc/tests/suite_reach/hidden"
import "ksplc/tests/suite_reach/picked" { helper }
import "std/suite"

priv struct Tests
  n: I32

impl Tests: suite.Suite {}

fn main(): I32
  $t: = Tests::{ .n = helper() }
  t.run()
  return 0

//< A generic function is a value only as a specialization its type arguments name
//<
//< A value has no arguments to infer them from, so the bare name is refused at its line with what
//< to write; let through, it reaches C as a name no function has. Type arguments after a function
//< that declares none would bind nothing, so they are refused too, called or not.
//< Caution: Keep the passing side: `same<|I32|>` as a value, checked against the expected type.
// EXPECT: generic function 'same' cannot be used as a value without its type arguments
// EXPECT: name one specialization, 'same<|…|>', with a type written for each of 'T'
// EXPECT: function 'same<|I64|>' cannot be used as 'fn(I32):I32': its own type is 'fn(I64):I64'
// EXPECT: function 'twice' is not generic, so '<|I32|>' names nothing: drop it
// EXPECT-NOT: undeclared identifier
priv typedef Op = fn(x: I32): I32

priv fn same<|T|>(x: T): T
  return x

priv fn twice(a: I32): I32
  return a * 2

priv fn apply(f: Op, x: I32): I32
  return f(x)

priv fn bare(): I32
  return apply(same, 1)

priv fn wrong_type(): I32
  f: Op = same<|I64|>
  return f(2)

priv fn stray_on_value(): I32
  f: Op = twice<|I32|>
  return f(3)

priv fn stray_on_call(): I32
  return twice<|I32|>(4)

fn main(): I32
  // The passing side.
  ok: Op = same<|I32|>
  return ok(0) + bare() + wrong_type() + stray_on_value() + stray_on_call()

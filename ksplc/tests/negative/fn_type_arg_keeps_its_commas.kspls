//< A function type written as a type argument is one argument, commas and all
//<
//< Its name holds commas of its own (`fn(I32,I32):I32`); cut at every comma, the row reads it as
//< two and the messages name a type that is not there.
//< Caution: Always place the non-firing side alongside: a function of the right shape goes in.
// EXPECT: function 'one_arg' cannot be used as 'fn(I32,I32):I32'
// EXPECT-NOT: type arguments for generic
// EXPECT-NOT: 'fn(I32'
import "std/ds" { List }
import "std/mem" { Arena }

priv fn add_pair(a: I32, b: I32): I32
  return a + b

priv fn one_arg(a: I32): I32
  return a

fn main(): I32
  arena: = Arena.new(1 << 16)
  defer arena.free()
  $ops: = List<|fn(a: I32, b: I32): I32|>.new(arena)
  ops.push(add_pair)
  ops.push(one_arg)
  return I32::ops.len

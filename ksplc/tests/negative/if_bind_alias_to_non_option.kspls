//< An alias to a user's enum does not widen what `if <name>: = <expr>` unwraps
//<
//< Caution: **Resolving the alias must not lose the refusal.** The check reads the resolved name so
//< `typedef Opt = Option<|T|>` goes through; stop there and this alias to an enum goes through too,
//< and the day the enum grows **a branch passes in silence** (7.1 of docs/SPEC-language.md).
// EXPECT: 'if <name>: = <expr>' binds an 'Option'
// EXPECT-NOT: .some
enum Light
  red
  yellow
  green

typedef Signal = Light

fn pick(): Signal
  return Light.red

fn main(): I32
  if v: = pick()
    return I32::v
  return 0

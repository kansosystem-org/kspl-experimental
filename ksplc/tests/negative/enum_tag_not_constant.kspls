//< A tag is folded at translation time, so a run-time value cannot be one
//<
//< **It is refused rather than replaced by the counter's value**, which a C enumerator would
//< silently become.
// EXPECT: does not resolve to a compile-time constant
$count: I32 = 3

enum C
  a = count

fn main(): I32
  return I32::C.a

//< A value type argument its `const` parameter's type does not hold is refused at the use
//<
//< **Inside the instance nothing hanging on a type argument is reported**, so `Ring<|3000000000|>`
//< for `const n: I32` was truncated in silence, and `Ring<|true|>` was reported inside the
//< template's body (`check_const_arg` in `ksplc/sema/decl/mono.kspls`).
// EXPECT: const_type_arg_does_not_fit.kspls:22:6: error: type argument '3000000000' does not fit 'const n: I32'
// EXPECT: const_type_arg_does_not_fit.kspls:23:6: error: type argument 'true' does not fit 'const n: I32'
// EXPECT: const_type_arg_does_not_fit.kspls:24:6: error: type argument '1' does not fit 'const on: Bool'
// EXPECT-NOT: has no field or method named
// EXPECT-NOT: '-5' does not fit
struct Ring<|const n: I32|>
  v: I32

impl<|const n: I32|> Ring<|n|>
  fn get(r: Self): I32
    return n * 100 + r.v

struct Flag<|const on: Bool|>
  v: I32

fn main(): I32
  b: Ring<|3000000000|> = ::{ .v = 2 }
  c: Ring<|true|> = ::{ .v = 3 }
  d: Flag<|1|> = ::{ .v = 4 }
  e: Ring<|-5|> = ::{ .v = 5 }
  return b.get() + c.get() + d.v + e.get()

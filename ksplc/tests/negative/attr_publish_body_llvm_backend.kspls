//< Only the C backend emits weak linkage and a version's assembler name
//<
//< Accept them on LLVM and the same substance arises in both artifacts, unnoticed until the link
//< falls.
// ARGS: --target=llvm
// EXPECT: only implemented by the C backend
// EXPECT-NOT: [
#publish_body
pub fn pair_sum<|T|>(a: T, b: T): T
  return a + b

fn main(): I32
  return pair_sum<|I32|>(1, 2)

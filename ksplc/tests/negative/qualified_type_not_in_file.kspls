//< Once a name has an alias prefix, it is looked up only behind that alias
//<
//< A generic template is registered under its short name too, so drawing by the short name as well
//< makes even a name absent from that file count as found. Nothing comes out at the declaration's
//< position, and it falls far away at the place of use as "another type has no such method".
// EXPECT: undefined type 'io.List'
import "std/io"

fn take(_l: io.List<|I32|>) {}

fn main()
  io.out().s("unreachable\n")

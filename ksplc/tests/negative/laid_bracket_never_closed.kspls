//< An unclosed `(`: the Note names where it opened
//<
//< The lines after an open bracket read as its contents, so the failure lands on the next line,
//< where the `)` was expected. The Note sends the writer back to the bracket.
// EXPECT: laid_bracket_never_closed.kspls:14:3: error: expected ')'
// EXPECT: the '(' at line 13, column 11 is never closed, so what follows it was read
import "std/io"

priv fn add(a: I32, b: I32): I32
  return a + b

fn main(): I32
  x: = add(1, 2
  y: = 3
  io.out().s("\{x + y\}").c('\n')
  return 0

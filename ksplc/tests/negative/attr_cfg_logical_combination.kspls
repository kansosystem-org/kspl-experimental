//< `#cfg`'s argument is only "one flag name" or "`!` and one flag name"
//<
//< There is no logical combination.
//< Accept it in silence and `all(a, b)` is read as "a flag named `all`", so unless `all`
//< is defined this declaration always vanishes. Whoever wrote it meaning AND gets no clue at all.
// EXPECT: '#cfg' takes exactly one flag name
#cfg(all(alpha, beta))
fn combined(): I32
  return 1

fn main(): I32
  return combined()

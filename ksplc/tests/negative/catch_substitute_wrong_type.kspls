//< A `catch`'s substitute has the success type, so a float does not stand in for an `I32`
//<
//< **Let it through and the backends part**: C keeps 2 from `2.5`, LLVM emits `i32 2.5`, which
//< does not build. A float literal takes no integer type anywhere (`x: I32 = 2.5`, an argument).
// EXPECT: implicit conversion between 'F64' and 'I32' is forbidden
// EXPECT-NOT: error: expected
enum E
  bad

fn f(i: I32): I32?E
  if i < 0
    throw E.bad
  return i

fn take(x: I32): I32
  return x

fn main(): I32
  v: = f(-1) catch 2.5
  w: = f(-1) catch e
    fallback 4.5
  x: I32 = 2.5
  return v + w + x + take(3.5)

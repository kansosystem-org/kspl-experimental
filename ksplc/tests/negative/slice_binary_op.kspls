//< Checks that ksplc rejects a binary operation on a slice with a diagnostic
//<
//< Unstopped (infer_binary in ksplc/sema/body/expr.kspls), the C compiler's error on two
//< descriptors reaches the user instead (the same shape as "Failing fast through an exception or an ICE" in ksplc/docs/DESIGN.md), and `ksplc`
//< alone lets it through. A slice has no arithmetic or order; content comparison is `equals`.
// EXPECT: cannot be applied to slice type 'U8[]'
// EXPECT-NOT: slice_binary_op.kspls:1:1
pub fn main(): I32
  a: U8[] = "ab"
  b: U8[] = "cd"
  c: = a + b
  return I32::c.len

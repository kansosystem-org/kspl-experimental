//< The indentation notation: layout, colons and the top level
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case colons_as_generic_path
//< `::` after a generic type suggests the `.` spelling, with the type arguments as written
//<
//< **The instance's registered name must not reach the message** (`std_ds_List_I32`); it
//< names nothing the writer wrote.
// EXPECT: colons_as_generic_path.kspl:15:21: error: '::' is not a path separator in KSPL
// EXPECT: write 'List<|I32|>.new'
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: std_ds_List
import "std/ds" { List }
import "std/mem" { Arena }

fn main(): I32
  arena: = Arena.new(1024)
  defer arena.free()
  $xs: = List<|I32|>::new(arena)
  xs.push(1)
  return I32::xs.len
// ==== case colons_as_module_path
//< `::` used as a path through a module suggests the `.` spelling, in one error
//<
//< **A module is never a cast's type**, so `io::out()` can only be a path. Read as a cast, the type
//< check calls `io` an undefined type and the operand an undefined name, and neither names the fix.
// EXPECT: colons_as_module_path.kspl:13:5: error: '::' is not a path separator in KSPL
// EXPECT: write 'io.out'
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: undefined type
// EXPECT-NOT: undefined path
import "std/io"

fn main(): I32
  io::out().s("x\n")
  return 0
// ==== case colons_as_type_path
//< `::` used as a path through a type suggests the `.` spelling, in one error
//<
//< **A writer from Rust or C++ reaches for `Type::member`**, and in KSPL `::` is the cast. Read as
//< one, `new` is undefined and the cast fails, and the value it yields breaks the `defer` below:
//< three errors, none naming the fix. Read as the member, the mistake is the one error.
// EXPECT: colons_as_type_path.kspl:15:17: error: '::' is not a path separator in KSPL
// EXPECT: write 'Arena.new'
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: undefined path
// EXPECT-NOT: cannot cast
// EXPECT-NOT: read-only
import "std/mem" { Arena }

fn main(): I32
  arena: = Arena::new(1024)
  defer arena.free()
  return 0
// ==== case laid_block_without_body
//< A block with no content cannot be written with indentation alone
//<
//< Only a deeper line opens a step, so an empty block, **or one holding a comment alone**, has
//< nothing to open it. The fix keeps the braces ("The indentation notation (`.kspl`)" in
//< `../../../docs/DESIGN-notation.md`); without that Note the error reads as a ternary `if` not being level.
// EXPECT: a block with no body cannot be written by indentation alone
import "std/io"

fn main(): I32
  if 1 < 0
    // the content is a comment alone
  io.out().s("C\n")
  return 0
// ==== case laid_bracket_never_closed
//< An unclosed `(`: the Note names where it opened
//<
//< The lines after an open bracket read as its contents, so the failure lands on the next line,
//< where the `)` was expected. The Note sends the writer back to the bracket.
// EXPECT: laid_bracket_never_closed.kspl:14:3: error: expected ')'
// EXPECT: the '(' at line 13, column 11 is never closed. What follows it was read
import "std/io"

priv fn add(a: I32, b: I32): I32
  return a + b

fn main(): I32
  x: = add(1, 2
  y: = 3
  io.out().s("\{x + y\}").c('\n')
  return 0
// ==== case laid_choice_split_after_else
//< A conditional value broken after its `else`, outside parentheses
//<
//< **Breaking behind the `else` is not a continuation either.** A line ending in `else` is where a
//< statement's `else` opens its level, so only a bracket carries a value on.
// EXPECT: a conditional value split across lines goes in parentheses
fn pick(c: Bool): I32
  x: = 100000 + 200000 if c else
    2
  return x

fn main(): I32
  return pick(true)
// ==== case laid_choice_split_before_else
//< A conditional value broken before its `else`, outside parentheses
//<
//< **The `else` is there, one line down**, so "a postfix condition has no `else`" must
//< not be what is said.
// EXPECT: error: expected 'else'
// EXPECT: a conditional value split across lines goes in parentheses
// EXPECT-NOT: KSPL has no postfix condition
fn pick(c: Bool): I32
  x: = 100000 + 200000 if c
    else 2
  return x

fn main(): I32
  return pick(true)
// ==== case laid_choice_split_before_if
//< A conditional value broken before its `if`, outside parentheses
//<
//< **A line starting with `if` is a statement's heading**, so the value's first half stands alone
//< and the reader opens a level behind it. The Note names the parentheses that let a value break.
// EXPECT: a conditional value split across lines goes in parentheses
fn pick(c: Bool): I32
  x: = 100000 + 200000
    if c else 2
  return x

fn main(): I32
  return pick(true)
// ==== case laid_comma_missing_in_closed_call
//< A `,` missing inside a call whose bracket is closed further on
//<
//< **"Never closed" is settled over the rest of the text.** Here the `)` comes two lines down, so
//< the mistake is inside the bracket: the Note names the `,` between two items, not the bracket.
// EXPECT: laid_comma_missing_in_closed_call.kspl:13:7: error: expected ')'
// EXPECT: a ',' may be missing before '3'
// EXPECT-NOT: is never closed
priv fn add(a: I32, b: I32, c: I32): I32
  return a + b + c

fn main(): I32
  x: = add(1,
    2 3,
    4)
  return x
// ==== case laid_defer_behind_a_declaration
//< A `defer` written behind a declaration on the same line
//<
//< A `defer` is a statement of its own. The Note gives the line to write, with the declared name in
//< front of the call. So the writer does not have to work out the fix from the grammar.
// EXPECT: a 'defer' must start a separate statement
// EXPECT: Put 'defer xs.free()' on the next line
import "std/ds" { List }

fn main(): I32
  $xs: = List<|I32|>.new(null) defer .free()
  xs.push(1)
  return 0
// ==== case laid_defer_on_its_own_line
//< `defer .free()` on a line of its own: a cleanup that names nothing
//<
//< A `defer` takes the statement to run, and a method called on nothing has no receiver. The
//< leading `.` would otherwise be read as an enum's value, and "no type to infer it from" sends
//< the writer looking at enums.
// EXPECT: a 'defer' must name its resource. '.free()' has no receiver
// EXPECT: Write the variable: 'defer x.free()'
// EXPECT-NOT: cannot infer the enum type
import "std/ds" { List }

fn main(): I32
  $xs: = List<|I32|>.new(null)
  defer .free()
  xs.push(1)
  return 0
// ==== case laid_group_holds_one_value
//< Two values side by side inside grouping parentheses
//<
//< **Grouping parentheses hold one value**, so a `,` there would be as wrong as the gap. The Note
//< that names a missing `,` is only for a list's brackets.
// EXPECT: expected ')'
// EXPECT-NOT: may be missing
fn main(): I32
  x: = (1 2)
  return x
// ==== case laid_ideographic_space
//< Some characters look like indentation on screen but do not count as indentation
//<
//< **Easiest to tread on with Japanese input: the ideographic space (U+3000).** Only the half-width
//< space counts. So the line sits at column 0 and leaves the step. The syntax error says nothing
//< of the cause. A Note names the character (as Python's `invalid non-printable character U+00A0`).
// EXPECT: an ideographic space (U+3000)
import "std/io"

fn main(): I32
  io.out().s("A\n")
　io.out().s("B\n")
  return 0
// ==== case laid_interpolation_never_closed
//< An interpolation left open names its `\{`, not the string around it
//<
//< The string's own `"` closes nothing while the interpolation is open. So the rest of the file
//< reads as its code, and the parser fails at the end. "the string is never closed" sent the
//< writer to a quote that is right.
// EXPECT: laid_interpolation_never_closed.kspl:12:17: error: this interpolation is never closed
// EXPECT-NOT: this string is never closed
import "std/io"

fn main()
    a: = 1
    io.out().s("\{a}\n")
    io.out().s("x\n")
// ==== case laid_interpolation_syntax_error
//< A syntax error inside an interpolation gets the note its own text earns
//<
//< Stepping over the whole literal, the note looked past the error and blamed the call's `(`
//< around the string as never closed.
// EXPECT: laid_interpolation_syntax_error.kspl:11:20: error: expected
// EXPECT: Note: an exponent is written only on a floating-point literal
// EXPECT-NOT: is never closed
import "std/io"

fn main()
    io.out().s("\{1e3\}")
// ==== case laid_interpolation_syntax_error_bare
//< A syntax error inside an interpolation that earns no note gets none
//<
//< The call's `(` around the string is closed; naming it would send the writer to the wrong place.
// EXPECT: laid_interpolation_syntax_error_bare.kspl:9:22: error: expected
// EXPECT-NOT: Note:
import "std/io"

fn main()
    io.out().s("\{1 +\}")
// ==== case laid_label_lookalike
//< A declaration that fails partway through its line is not called a block with no body
//<
//< `x:` reads like a label, so the expected list holds a `{`; the note about an empty block fits
//< only a heading whose code has ended.
// EXPECT: laid_label_lookalike.kspl:8:8: error: expected
// EXPECT-NOT: a block with no body
fn main()
    x: [3]I32 = ::{}
// ==== case laid_name_outside_ascii
//< A name in another script names the ASCII rule, and the list names the notation's own marks
//<
//< Python, Rust, Swift, Java and C++ all take `かんそ` as a name, so the bare list would not say why
//< it is refused. The indentation notation writes no `}`, so the list names the block's end.
// EXPECT: laid_name_outside_ascii.kspl:9:5: error: expected the end of the block, an identifier
// EXPECT: Note: a name is written with ASCII letters, digits and '_' alone. 'か' cannot appear in a name.
// EXPECT-NOT: '}'
fn main(): I32
    かんそ: I32 = 3
    return かんそ
// ==== case laid_prototype_without_body
//< A function ending in `;` gets the same "has no body" as in the brace notation
//<
//< The written `;` alone ends the line, so the parse goes on to the analysis's message, beside the
//< refusal of the `;` itself.
// EXPECT: laid_prototype_without_body.kspl:8:1: error: 'f' has no body
// EXPECT: laid_prototype_without_body.kspl:8:12: error: a statement in the indentation notation ends at its line boundary
// EXPECT-NOT: expected
fn f(): I32;

fn main(): I32
    return 0
// ==== case laid_ragged_sibling
//< In the indentation notation, siblings in one block whose columns do not line up are rejected
//<
//< A piled step keeps only the heading's column (`Frame` in `../../parse/layout.kspl`). So the
//< `4 columns` line reads as outside the `if` but is inside it. Two readings make two programs,
//< which Principle 8 in `../../../docs/DESIGN-principles.md` refuses. **It carries no code**, so none can switch it.
// EXPECT: sibling lines use
// EXPECT-NOT: error: [
import "std/io"

fn main(): I32
  if 1 < 0
      io.out().s("6 columns\n")
    io.out().s("4 columns — not level with the sibling\n")
  io.out().s("2 columns\n")
  return 0
// ==== case laid_switch_case_indented
//< A `case` indented under its `switch`, the way Python's `match` lays its arms out
//<
//< **A `switch` opens no block**, so a deeper line opens one the grammar does not have. The Note
//< says where the arms go: at the `switch`'s column, the first on the line below.
// EXPECT: laid_switch_case_indented.kspl:9:12: error: expected 'case'
// EXPECT: Note: a 'switch' opens no block of its own. Each 'case' and 'default' opens one. Align them with 'switch'. Put the first 'case' on the next line.
fn main(): I32
  e: = 1
  switch e
    case 1
      return 1
    default
      return 2
// ==== case laid_switch_case_shallower
//< A `case` shallower than its `switch`
//<
//< **The head takes its first arm only at its own column.** A shallower line belongs to the level
//< outside, so the head is left ended. The error lands at its line's end, and no Note claims a
//< block.
// EXPECT: laid_switch_case_shallower.kspl:11:13: error: expected 'case'
// EXPECT-NOT: opens no block of its own
fn main(): I32
  e: = 1
  if e > 0
    switch e
  case 1
    return 1
  return 2
// ==== case laid_trailing_closure_absent
//< A closure written after a call's `)`, as Swift and Kotlin allow
//<
//< KSPL has none ("Appendix A: Features not carried, and what to write instead" in
//< `../../../docs/SPEC-language.md`). Alone, the expectation set asks for a `;`, so a Note names
//< it and two forms instead (`forbidden_spelling_hint` in `../../parse/syntax_msg.kspl`).
// EXPECT: KSPL has no trailing closure
// EXPECT: bind it to a name and pass that name
priv fn count_over(xs: I32[], pred: Callable1<|I32, Bool|>): Sz
  $n: Sz = 0
  for x in xs
    if pred.call(x)
      n += 1
  return n

fn main(): I32
  xs: = I32[]::{ 3, 9, 6 }
  floor: = 4
  big: = count_over(xs) fn(x: I32; floor: I32): Bool
    return x > floor
  return I32::big
// ==== case laid_trailing_semicolon
//< A `;` written at a statement's line end is refused on the `;`, naming the notation's rule
//<
//< Converted with a second `;` after it, it read as an empty statement and listed `'}'` and
//< `';'`, which this notation never writes (`written_terminator` in `parse/layout.kspl`).
// EXPECT: laid_trailing_semicolon.kspl:9:16: error: a statement in the indentation notation ends at its line boundary. This ';' is unnecessary. Delete it. A ';' stands only
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: expected '}'
fn main(): I32
    $x: I32 = 0;
    x += 1; x += 2
    return x
// ==== case laid_semicolon_after_block
//< A `;` right after a one-line block's `}` is refused on the `;`, naming that `}`
//<
//< It is read as a space, so the parse goes on and nothing else is reported (`block_end` in
//< `parse/layout.kspl`).
// EXPECT: laid_semicolon_after_block.kspl:9:38: error: the '}' before this ';' closes a block written on one line
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: expected
fn main(): I32
    $x: I32 = 0; if x == 0 { x += 1 }; x += 2
    return x
// ==== case laid_value_below_return
//< A value on the line below a lone `return`
//<
//< **A `return` alone is a bare return**, so the deeper line below it cannot be its value as well.
//< The Note says where the value starts, and that parentheses split a long one.
// EXPECT: a 'return' takes its value on the same line
fn message(): U8[]
  return
    "a message long enough that someone moved it below the return"

fn main(): I32
  return I32::message().len - 61
// ==== case toplevel_init_call
//< A call in a top-level variable's initialiser is rejected, since C needs a constant there
//<
//< The initialiser becomes the generated C's file-scope initialiser, and a call is run-time work.
//< Unrefused, only the C compiler's `initializer element is not constant` shows, with no
//< diagnostic at KSPL's layer.
// EXPECT: top-level variable initializer is not a compile-time constant
fn side(): I32
  return 7
$g: I32 = side()
fn main()
  if g == 0
    return
// ==== case toplevel_init_var_read
//< Reading another top-level variable is not a constant either
//<
//< In C too, `int b = a;` is not a constant expression at file scope.
//< A const reference, an enum variant and an address-taking `a@` are legitimate as constants, so
//< what is refused is only "reading a variable's value".
// EXPECT: top-level variable initializer is not a compile-time constant
$a: I32 = 1
$b: I32 = a
fn main()
  if b == 0
    return
// ==== case toplevel_type_required
//< A top-level declaration must carry a type annotation, and is rejected without one
//<
//< Made omittable, the declaration quietly becomes an `I32` and `g: = 2.5` truncates to 2 with no
//< diagnostic. Inference is for locals alone: the top level is a file's interface, so its type is
//< stated (docs/SPEC-language.md §4.1 "The range of type inference").
// EXPECT: top-level declaration 'g_f' requires a type annotation
// EXPECT: top-level declaration 'c_n' requires a type annotation

g_f: = 2.5
const c_n = 8

fn main()
  _x: = g_f
  _y: = c_n
// ==== case toplevel_type_required_ok
//< The counterpart of the case above
//<
//< A local and a local const may omit the annotation: the rule is the top level's alone, not a
//< stop on inference. The case fails on purpose through the same check, on a top-level variable.
// EXPECT: top-level declaration 'g_bare' requires a type annotation
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: 'local_

g_f: F64 = 2.5
const c_n: Sz = 8
g_bare: = 1

fn main()
  local_f: = 2.5
  const local_n = 8
  _x: = local_f + g_f
  _y: = local_n + c_n

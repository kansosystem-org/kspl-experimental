//< That ksplc gives a compound assignment the operand checks `a = a op b` gets
//<
//< Unstopped, `t /= f` on a `Bool` **falls on SIGFPE** where `f` is false, and `+=` on a slice or a
//< struct reaches the C compiler as `invalid operands to binary expression`. `&=` on a `Bool`
//< stays, as `t & f` does.
// EXPECT: Operator '/=' cannot be applied to 'Bool'
// EXPECT: Operator '+=' cannot be applied to slice type 'U8[]'
// EXPECT: compound assignment '+=' applies to numbers and 'Bool', not to
// EXPECT: write 'a = a + b'
// EXPECT-NOT: compound_assign_operands.kspls:18:
struct V
  x: I32

pub fn main(): I32
  $t: = true
  f: = false
  t /= f
  t &= f
  $s: U8[] = "ab"
  s += "cd"
  $v: = V::{ .x = 1 }
  v += V::{ .x = 2 }
  return v.x

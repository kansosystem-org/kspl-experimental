//< A `priv` type in a `pub` function's return value reaches a side that cannot name it
//<
//< It binds with `x: = make();`, and method calls and field reads work, so the `priv` its author
//< wrote is not in effect (docs/DESIGN.md Principle 5). For the reason only the return-value
//< position is checked, see docs/DESIGN.md §6.1.
// EXPECT: return type 'Hidden' is less visible than the function exposing it

priv struct Hidden
  v: I32

pub fn make(): Hidden
  return Hidden::{ .v = 1 }

fn main()
  _h: = make()

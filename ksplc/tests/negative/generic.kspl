//< Generics: type arguments, constraints and inference
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case generic_body_error_once
//< A mistake in a generic's body is reported once, however many instances meet it
//<
//< Each instance found it again with its own type in the text, so three calls gave three errors
//< at one place, and the follow-on "cannot infer" of the later instances came on top.
// EXPECT: generic_body_error_once.kspl:12:11: error: type 'generic_body_error_once.P' has no field
// EXPECT-NOT: type 'I32' has no field
// EXPECT-NOT: cannot infer type for 'q'
struct P
  x: I32

fn f<|T|>(v: T): T
  _q: = v.nofield
  return v

fn main(): I32
  _a: = f(P::{ .x = 1 })
  _b: = f(1)
  _c: = f(2I64)
  return 0
// ==== case generic_body_error_names_instance
//< An error in a generic's body names the instantiation it met, and the line that asked for it
//<
//< The line alone is the template's, and the mistake may be the caller's type argument. The chain
//< reaches the caller's own line, innermost first; a second instance meeting the same error adds
//< nothing, the error being reported once (`instance_notes` in `sema/session/ctx.kspl`).
// EXPECT: generic_body_error_names_instance.kspl:17:12: error: Operator '<' requires
// EXPECT: Note: in 'generic_body_error_names_instance.smaller<|generic_body_error_names_instance.Pt|>', instantiated at generic_body_error_names_instance.kspl:20:12.
// EXPECT: Note: in 'generic_body_error_names_instance.wrap<|generic_body_error_names_instance.Pt|>', instantiated at generic_body_error_names_instance.kspl:24:11.
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: Qt|>'
priv struct Pt
    x: I32
priv struct Qt
    y: I32

priv fn smaller<|T|>(a: T, b: T): Bool
    return a < b

priv fn wrap<|T|>(a: T, b: T): Bool
    return smaller<|T|>(a, b)

fn main(): I32
    _i: = wrap<|I32|>(1, 2)
    _p: = wrap<|Pt|>(Pt::{ .x = 1 }, Pt::{ .x = 2 })
    _q: = wrap<|Qt|>(Qt::{ .y = 1 }, Qt::{ .y = 2 })
    return 0
// ==== case generic_call_arg_types
//< A generic call's arguments are checked against the parameter types after instantiation too
//<
//< **At the call they cannot be checked**: `T`/`U` are bound to nothing, so the expected type is
//< `unknown`. Right after the instantiation is the one chance (check_args_against_instance in
//< sema/body/call.kspl); skipped, the generated C fails with a raw C error (Principle 2).

// ==========================================
// A difference in write permission (`T@` into a `T$@`'s position) is not exposed in the
// generated C, genc attaching no `const` to an immutable local, so only the KSPL side sees it.
// Caution: Always place the non-firing side alongside — a correct type, a numeric widening, and a
// function handed over as a value all have to pass.
// ==========================================

// EXPECT: expected 'I32', but got 'U8[]'
// EXPECT: expected 'Sz$@', but got 'Sz@'
// EXPECT-NOT: passing
import "std/io"

priv fn take<|T|>(_v: T, n: I32): I32
  return n

priv fn bump<|T|>(_v: T, slot: Sz$@)
  slot$ += 1

priv fn widen<|T|>(_v: T, n: I64): I64
  return n

priv fn apply<|T|>(v: T, f: fn(x: T): T): T
  return f(v)

priv fn twice(x: I32): I32
  return x * 2

fn main(): I32
  ro: Sz = 0
  $rw: Sz = 0
  // The stopping side ①: a different type is handed to a concrete parameter.
  bad_type: = take<|I32|>(1, "wrong")
  // The stopping side ②: a read-only pointer is handed to a parameter that writes.
  bump<|I32|>(1, ro@)
  // The passing side ①: the correct type.
  ok_type: = take<|I32|>(1, 2)
  // The passing side ②: a conversion that may pass (an I32 -> I64 widening).
  ok_widen: = widen<|I32|>(1, 3)
  // The passing side ③: a writable place.
  bump<|I32|>(1, rw@)
  // The passing side ④: a named function handed to a function-pointer argument.
  ok_fn: = apply<|I32|>(5, twice)
  io.out().s("\{bad_type\}\{ok_type\}\{I32::ok_widen\}\{rw\}\{ok_fn\}\n")
  return 0
// ==== case generic_constraint_in_template_body
//< A type-argument constraint broken **inside a template's body** reports the real error first
//<
//< Bodies come off a pending queue, so a violation by an instantiation inside a body is known only
//< after that instantiation's method bodies are checked. An `if`'s condition tries constant folding
//< under suppression, so the constraint check goes to the queue there: hence this path.
// EXPECT: does not explicitly implement interface
// EXPECT-NOT: std/ds.kspl
import "std/ds" { Map }

// It holds no hash/equals, so it does not satisfy ds.Hashable.
struct Bad
  x: I32

struct Wrap<|T|>
  v: T

impl<|T|> Wrap<|T|>
  fn go(r: Self@): I32
    if Map<|Bad, I32|>.new(null).len == 0
      return 1
    return I32::r.v

fn main(): I32
  w: Wrap<|I32|> = ::{ .v = 1 }
  return w.go()
// ==== case generic_constraint_via_static_call
//< A generic's type-argument constraint applies however the type is referred to
//<
//< This fixture covers "an inferred declaration + a static generic call"
//< (`m: = Map<|Point, I32|>.new(null);`). The type-annotation form (`m: Map<|Point, I32|> = …;`) is
//< not the only one checked.
// ==========================================
// EXPECT: does not explicitly implement interface
// The body of an instantiation whose constraint violation is known is not type-checked. Without
// that, derived errors pointing inside the standard library follow the real diagnostic (the one
// item above) and the reader can no longer tell the cause.
// EXPECT-NOT: has no field or method named 'hash'
// EXPECT-NOT: does not implement required method
// ==========================================
import "std/ds" { Map }

// It holds no hash/equals, so it does not satisfy ds.Hashable.
struct Point
  x: I32

fn main(): I32
  m: = Map<|Point, I32|>.new(null)
  return I32::m.len
// ==== case generic_decl_checked_as_plain
//< A generic struct's or enum's instance is refused where the same non-generic declaration is
//<
//< An instance fills its fields and variants through the same functions as a plain declaration
//< (fill_struct_fields and fill_enum_variants in ksplc/sema/decl/registry.kspl).
// EXPECT: field 'a' is already defined in struct
// EXPECT: struct fields cannot be of type 'Void'
// EXPECT: variant 'none' is already defined in enum

struct Twice<|T|>
  a: T
  a: I32

struct Holds_void<|T|>
  t: T
  v: Void

enum Twice_variant<|T|>
  none
  some(t: T)
  none

fn case_duplicate_field(): I32
  w: Twice<|I32|> = ::{ .a = 1 }
  return w.a

fn case_void_field(): I32
  w: Holds_void<|I32|> = ::{ .t = 1 }
  return w.t

fn case_duplicate_variant(): I32
  e: Twice_variant<|I32|> = .some(1)
  switch e case .some(t)
    return t
  default {}
  return 0

fn main()
  case_duplicate_field()
  case_void_field()
  case_duplicate_variant()
// ==== case generic_enum_variant_first_use
//< An error inside a generic enum's instance is reported when its first use is `E<|T|>.v`
//<
//< That shape instantiates the enum on the way to the variant, and the instance is cached. With
//< the instantiation's errors suppressed there, a later use finds the cached instance and the
//< error is never reported: the program goes on to the C compiler with a broken payload type.
// EXPECT: too few type arguments for generic 'Pair': it declares 2, but 1 given
pub struct Pair<|A, B|>
  a: A
  b: B

enum E<|T|>
  v
  w(x: Pair<|T|>)

fn main()
  e: = E<|I32|>.v
  switch e case .v {} default {}
// ==== case generic_field_less_visible
//< A generic's struct fields and enum payloads are checked the same way as a non-generic one's
//<
//< Without the check on an instance, merely wrapping it in a `pub struct W<|T|>` would leak a
//< `priv` type into other files (ksplc/docs/DESIGN-diagnostics.md "A check of the same nature is not copied
//< into two places").
// EXPECT: field type 'Hidden' is less visible than the field exposing it
// EXPECT: payload type 'Hidden' is less visible than the variant exposing it

priv struct Hidden
  v: I32

pub struct W<|T|>
  pub t: T
  pub h: Hidden

pub enum E<|T|>
  none
  some(t: T, h: Hidden)

fn main()
  w: W<|I32|> = ::{ .t = 1, .h = Hidden::{ .v = 2 } }
  e: E<|I32|> = E<|I32|>.some(1, Hidden::{ .v = 3 })
  switch e case .some(_t, h)
    _x: = w.h.v + h.v
  default {}
// ==== case generic_fn_infinite_instantiation
//< A generic function calling itself with a different type argument is stopped at a depth cap
//<
//< Without the cap the compilation does not finish. Call depth cannot measure it (each body goes
//< to the pending queue, so it returns to 0 per item), and each new mangled name misses the
//< instantiation cache (inst_chain_depth in ksplc/sema/session/ctx.kspl).
// EXPECT: generic function instantiation chain too deep
fn recur<|T|>(x: T)
  y: T[1]
  y[0] = x
  recur(y)

fn main()
  recur(1)
// ==== case generic_fn_value_needs_type_args
//< A generic function is a value only as a specialization its type arguments name
//<
//< A value has no arguments to infer them from, so the bare name is refused at its line with what
//< to write; let through, it reaches C as a name no function has. Type arguments after a function
//< that declares none would bind nothing, so they are refused too, called or not.
//< Caution: Keep the passing side: `same<|I32|>` as a value, checked against the expected type.
// EXPECT: generic function 'same' cannot be used as a value without its type arguments
// EXPECT: name one specialization, 'same<|…|>', with a type written for each of 'T'
// EXPECT: function 'same<|I64|>' cannot be used as 'fn(I32):I32': its own type is 'fn(I64):I64'
// EXPECT: function 'twice' is not generic, so '<|I32|>' names nothing: drop it
// EXPECT-NOT: undeclared identifier
priv typedef Op = fn(x: I32): I32

priv fn same<|T|>(x: T): T
  return x

priv fn twice(a: I32): I32
  return a * 2

priv fn apply(f: Op, x: I32): I32
  return f(x)

priv fn bare(): I32
  return apply(same, 1)

priv fn wrong_type(): I32
  f: Op = same<|I64|>
  return f(2)

priv fn stray_on_value(): I32
  f: Op = twice<|I32|>
  return f(3)

priv fn stray_on_call(): I32
  return twice<|I32|>(4)

fn main(): I32
  // The passing side.
  ok: Op = same<|I32|>
  return ok(0) + bare() + wrong_type() + stray_on_value() + stray_on_call()
// ==== case generic_method_chain_too_deep
//< A method that builds its own type one level deeper each time is stopped at the chain's limit
//<
//< **One error, at the cut.** The instance left unbuilt has no methods, and the call reaching it
//< used to add "has no field or method", naming a type 32 levels deep and suggesting an import.
// EXPECT: generic method table chain too deep: 'generic_method_chain_too_deep.Box2' came out nested
// EXPECT-NOT: has no field or method
struct Box2<|S|>
  inner: S

struct Chain<|S|>
  v: S
  n: I32

impl<|S|> Chain<|S|>
  fn deeper(r: Self): Chain<|Box2<|S|>|>
    return Chain<|Box2<|S|>|>::{ .v = Box2<|S|>::{ .inner = r.v }, .n = r.n }

  fn walk(r: Self, d: I32): I32
    if d <= 0
      return r.n
    return r.deeper().walk(d - 1)

fn main(): I32
  c: = Chain<|I32|>::{ .v = 1, .n = 2 }
  return c.walk(3)
// ==== case generic_spelling_in_diagnostic
//< A type in a diagnostic is shown as the user wrote it
//<
//< **Do not put an internal name out**: whoever wrote `List<|U8[]|>` cannot match a mangled name
//< to it ("A diagnostic points at 'the position the user wrote'" in `ksplc/docs/DESIGN-diagnostics.md`).
//< Caution: **Keep the `EXPECT-NOT`**: with two functions printing it, one still mangled passes.
// EXPECT: but got 'std.ds.List<|U8[]|>
// EXPECT-NOT: std_ds_List
import "std/ds" { List }
import "std/mem" { Arena }

fn main(): I32
  arena: = Arena.new(1024)
  defer arena.free()
  xs: = List<|U8[]|>.create(arena)
  n: I32 = xs
  return n
// ==== case generic_trait_arg_is_not_a_leak
//< A type variable that monomorphisation merely substitutes is no visibility leak
//<
//< The `Output` of `std.lang.Index<|Idx, Output|>` is replaced by the implementing type's own
//< type; `Output`, not a concrete type, is what was written, so no visibility diagnostic stands.
//< The case fails on purpose through the same check, at a field rather than a return value.
// EXPECT: field type 'Leaked' is less visible than the field exposing it
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: than the function exposing it

pub struct Row
  pub cells: I32[4]

impl Row: Index<|Sz, I32|>
  pub fn get(r: Self$@, index: Sz): I32
    return r.cells[index]

priv struct Leaked
  v: I32

pub struct Leaky
  pub slot: Leaked

fn main()
  row: Row = ::{ .cells = ::{ 1, 2, 3, 4 } }
  _x: = row[0]
// ==== case generic_type_args_missing
//< A generic type written with no type arguments is rejected
//<
//< A template holds a substance only once instantiated, so letting it through puts a type name with
//< no substance into the generated C.
// EXPECT: generic type 'W' is used without type arguments
struct W<|T|>
  v: T
fn main()
  _x: W
// ==== case generic_type_args_not_inferred
//< A type parameter no argument fixes is refused at the call, which is told what to write
//<
//< Bound from the first argument instead, `zero(5)` would take `I32` and `f(2)` leave `U` raw in C.
//< The expected type does not fix it. A `const` parameter is read where it stands as an array's
//< length or a generic's value argument: a slice has no length fixed at translation time, an `I32`
//< is no `Buf<|N|>`, and `fill` has no parameter where it stands.
// EXPECT: cannot infer the type argument 'T' of 'zero': no parameter's type mentions it
// EXPECT: cannot infer the type argument 'T' of 'zero': no parameter's type mentions it
// EXPECT: cannot infer the type argument 'U' of 'f': no parameter's type mentions it
// EXPECT: with a type written for each of 'T', 'U'
// EXPECT: cannot infer the type argument 'T' of 'count': the argument for 'xs' has type 'I32'
// EXPECT: cannot infer the const parameter 'N' of 'sum': the argument for 'v' has type 'I32[]', which has no length or value fixed at translation time where that parameter's type has 'N'
// EXPECT: 'sum<|…|>(…)', with an argument written for each of 'N'
// EXPECT: cannot infer the const parameter 'N' of 'cap': the argument for '_b' has type 'I32', which has no length or value fixed at translation time where that parameter's type has 'N'
// EXPECT: cannot infer the const parameter 'N' of 'fill': no parameter's type has it as an array's length or a generic's value argument, the places a const parameter is read from
// EXPECT: Finished with 7 error(s)
// EXPECT-NOT: expected 'U8[]'
import "std/ds" { List }

priv fn zero<|T|>(_n: I64): T
  return ::{}

priv fn f<|T, U|>(_v: T): U
  return ::{}

priv fn count<|T|>(xs: List<|T|>@): Sz
  return xs.len

priv fn sum<|const N: Sz|>(v: I32[N]): I32
  return v[0]

priv struct Buf<|const n: Sz|>
  data: U8[n]

priv fn cap<|const N: Sz|>(_b: Buf<|N|>@): Sz
  return N

priv fn fill<|const N: Sz|>(_x: I32): Sz
  return N

fn main(): I32
  _x: = zero(5)
  _y: U8[] = zero(7)
  _z: = f(2)
  _n: = count(5)
  _c: = cap(5)
  _d: = fill(1)
  s: I32[3] = ::{ 1, 2, 3 }
  return sum(I32[]::s)
// ==== case generic_const_length_conflict
//< Two arguments fixing one `const` parameter to different values refuse the call, naming both
//<
//< Either value chosen alone would make the instance refuse the other argument, as if only that
//< one were wrong. Written at the call, the value still decides, and the other array is refused.
//< An array's length and a generic's value argument (`Buf<|4|>`) are values alike.
// EXPECT: cannot infer the const parameter 'N' of 'both': the argument for 'a' (type 'I32[3]') fixes it to 3, and the argument for 'b' (type 'I32[4]') to 4
// EXPECT: Hint: pass arguments that agree on 'N'
// EXPECT: Hint: pass arguments that agree on 'N'
// EXPECT: expected 'I32[3]', but got 'I32[4]'
// EXPECT: Buf<|4|>@') fixes it to 4, and the argument for 'a' (type 'I32[3]') to 3
// EXPECT: Finished with 3 error(s)
priv fn both<|const N: Sz|>(a: I32[N], b: I32[N]): I32
  return a[0] + b[0]

priv struct Buf<|const n: Sz|>
  data: U8[n]

priv fn mixed<|const N: Sz|>(_b: Buf<|N|>@, a: I32[N]): I32
  return a[0]

fn main(): I32
  s: I32[3] = ::{ 1, 2, 3 }
  t: I32[4] = ::{ 1, 2, 3, 4 }
  b: = Buf<|4|>::{}
  return both(s, t) + both<|3|>(s, t) + mixed(b@, s)
// ==== case generic_arg_kind
//< An argument of the other kind than its parameter is refused where it is written, naming both
//<
//< In a generic's declaration its own `const` parameter where a type goes (`Hold<|N|>`), or its
//< type parameter where a value goes (`Buf<|T|>`, an array's length), is refused called or not.
//< Left to a call, it failed there as a mismatch blaming the call's argument. Outside a generic a
//< value for a type, or a type for a `const`, is refused where it is resolved, for a function's
//< type arguments too.
//< Caution: Keep the passing side: a constant's name, the generic's own `const` and an array of a
//< constant's length (a type, though a value stands inside it) each stand where they belong.
// EXPECT: 'Hold' takes a type for its parameter 'T', but 'N' is a const parameter, which stands for a value
// EXPECT: Hint: declare it without 'const' to pass a type through it
// EXPECT: 'Buf' takes a value for its parameter 'const n: Sz', but 'T' is a type parameter
// EXPECT: Hint: declare it 'const T: Sz' to pass a value through it
// EXPECT: 'N' is a const parameter, which stands for a value, not a type
// EXPECT: 'T' is a type parameter, but an array's length is a value
// EXPECT: 'Hold' takes a type for its parameter 'T', but this argument is a value
// EXPECT: 'Hold' takes a type for its parameter 'T', but this argument is a value
// EXPECT: 'Hold' takes a type for its parameter 'T', but this argument is a value
// EXPECT: 'Buf' takes a value for its parameter 'const n: Sz', but this argument is a type
// EXPECT: 'Buf' takes a value for its parameter 'const n: Sz', but this argument is a type
// EXPECT: 'fill' takes a value for its parameter 'const N: Sz', but this argument is a type
// EXPECT: 'id' takes a type for its parameter 'T', but this argument is a value
// EXPECT: Finished with 11 error(s)
priv struct Hold<|T|>
  v: T

priv struct Buf<|const n: Sz|>
  data: U8[n]

const k: Sz = 2

priv fn as_type<|const N: Sz|>(_h: Hold<|N|>@): Sz
  return N

priv fn as_value<|T|>(_b: Buf<|T|>@): Sz
  return 0

priv fn bare<|const N: Sz|>(_x: N): Sz
  return N

priv fn length<|T|>(): Sz
  _a: I32[T]
  return 0

priv fn passes<|U, const N: Sz|>(_h: Hold<|U[N]|>@, _b: Buf<|N|>@): Sz
  return N

priv fn fill<|const N: Sz|>(): Sz
  return N

priv fn id<|T|>(): Sz
  return sizeof(T)

fn main(): I32
  _a: Hold<|4|>
  _b: Hold<|k|>
  _c: Hold<|-1|>
  _d: Buf<|I32|>
  _e: Buf<|U8[]|>
  _f: = fill<|I32|>()
  _g: = id<|3|>()
  h: = Hold<|I32[k]|>::{ .v = ::{ 1, 2 } }
  b: = Buf<|k|>::{}
  _n: = passes(h@, b@)
  return 0
// ==== case generic_const_in_arithmetic
//< A `const` parameter standing only inside arithmetic is said to be why nothing fixes it
//<
//< Arithmetic on it (`I32[N * 2]`) is not solved for it, so the call writes the value. Without
//< the reason the refusal read as if no parameter mentioned it. In a generic's argument
//< (`Buf<|(N + 1)|>`) arithmetic is refused besides, at the declaration and once.
//< Caution: Keep the bare place beside it: there the argument still fixes it.
// EXPECT: a value passed as a type argument must be a literal, a negated literal or the name of a const
// EXPECT: cannot infer the const parameter 'N' of 'shifted': the parameter '_b' has it only inside arithmetic, 'N + 1', which is not solved for it
// EXPECT: cannot infer the const parameter 'N' of 'longer': the parameter 'v' has it only inside arithmetic, 'N * 2', which is not solved for it
// EXPECT: Hint: call one specialization, 'longer<|…|>(…)', with an argument written for each of 'N'
// EXPECT: Finished with 3 error(s)
priv struct Buf<|const n: Sz|>
  data: U8[n]

priv fn shifted<|const N: Sz|>(_b: Buf<|(N + 1)|>@): Sz
  return N

priv fn longer<|const N: Sz|>(v: I32[N * 2]): I32
  return v[0]

priv fn plain<|const N: Sz|>(v: I32[N]): I32
  return v[0]

fn main(): I32
  b: = Buf<|4|>::{}
  s: I32[4] = ::{ 1, 2, 3, 4 }
  _a: = shifted(b@)
  return longer(s) + longer<|2|>(s) + plain(s)
// ==== case generic_type_args_too_few
//< Fewer type arguments than the declaration has are rejected
//<
//< A type variable left unsubstituted goes straight into the generated C and the C compiler says
//< `unknown type name 'U'` ("Failing fast through an exception or an ICE" in ksplc/docs/DESIGN-compiler.md).
// EXPECT: too few type arguments for generic 'W': it declares 2, but 1 given
struct W<|T, U|>
  a: T
  b: U
fn main()
  _x: W<|I32|>
// ==== case generic_type_args_too_many
//< More type arguments than the declaration has are rejected
//<
//< What is left over is bound to no type variable, so nothing happens while whoever wrote it
//< believes it is "in effect" (docs/DESIGN-principles.md Principle 5).
// EXPECT: too many type arguments for generic 'W': it declares 1, but 2 given
struct W<|T|>
  v: T
fn main()
  _x: W<|I32, I32|>
// ==== case generic_type_call_needs_type_args
//< A call through a generic type writes the type's type arguments on it; nothing else binds them
//<
//< Each instance has its own copy of each method, and the call's arguments do not choose one: the
//< refusal says what to write. Let through, the name reached the lookup without any instance and
//< was reported as an undefined path, and a method's own type arguments after a type's that
//< declares none would bind nothing (Principle 5).
//< Caution: Keep the passing side: the method's own are inferred from the arguments, through a
//< generic type's instance and through a plain type alike.
// EXPECT: generic type 'Box' needs its type arguments before 'keep' can be called through it
// EXPECT: call one instance's, 'Box<|…|>.keep(…)', with a type written for each of 'T'
// EXPECT: generic type 'Box' needs its type arguments before 'pair' can be called through it
// EXPECT: generic type 'Option' needs its type arguments before 'some' can be called through it
// EXPECT: function 'Box.keep' is not generic, so '<|U8|>' names nothing: drop it
// EXPECT-NOT: undefined path
// EXPECT-NOT: undeclared
priv struct Box<|T|>
    v: T

impl<|T|> Box<|T|>
    fn keep(x: T): T
        return x
    fn pair<|U|>(_x: T, y: U): U
        return y

priv struct Plain
    v: I32

impl Plain
    fn same<|T|>(x: T): T
        return x

priv fn bare_static(): I32
    return Box.keep(1)

priv fn bare_generic_method(): I32
    return Box.pair(1, 2)

priv fn bare_enum(): I32?
    return Option.some(1)

priv fn stray_own(): I32
    return Box<|I32|>.keep<|U8|>(1)

fn main(): I32
    // The passing side.
    w: U16 = 300
    return I32::Box<|I32|>.pair(1, w) + I32::Plain.same(w)
// ==== case generic_undefined_type_arg_in_signature
//< A method signature using, as a type argument, a name that is not a type
//<
//< The name `t` is a typo for `S` (names_unknown_type in ksplc/sema/decl/resolve.kspl).
//< Caution: **Do not make a substance out of a typo.** A `Box2<|t|>` disagrees with the body's
//< `Chain<|Box2<|S|>|>`, lining up derived errors, and polymorphic recursion never stops compiling.
// EXPECT: undefined type 't'
// EXPECT-NOT: but got
struct Box2<|S|>
  inner: S

struct Chain<|S|>
  v: S
  n: I32

impl<|S|> Chain<|S|>
  fn deeper(r: Self): Chain<|Box2<|t|>|>
    return Chain<|Box2<|S|>|>::{ .v = Box2<|S|>::{ .inner = r.v }, .n = r.n }

  fn tag(r: Self): I32
    return r.n

fn main(): I32
  c: = Chain<|I32|>::{ .v = 1, .n = 2 }
  return c.deeper().deeper().tag()
// ==== case uninferable_var
//< A variable with neither a type annotation nor an initialiser is an error
//<
//< Its type cannot be settled.
// EXPECT: cannot infer type for 'x'
fn main(): I32
  x:
  x = 1
  return x

//< A call in a top-level variable's initialiser is rejected, since C needs a constant there
//<
//< The initialiser becomes the generated C's file-scope initialiser, and a call is run-time work;
//< unrefused, only the C compiler's `initializer element is not constant` surfaces, with no
//< diagnostic at KSPL's layer.
// EXPECT: top-level variable initializer is not a compile-time constant
fn side(): I32
  return 7
$g: I32 = side()
fn main()
  if g == 0
    return

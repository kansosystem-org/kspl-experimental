//< Constants: evaluation, overflow and what a constant may hold
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case const_cycle
//< A cycle among constant definitions is rejected
//<
//< Otherwise the name goes straight into C's initialiser and the C compiler fails there ("Failing
//< fast through an exception or an ICE" in ksplc/docs/DESIGN-compiler.md). **A backward reference is not a cycle** and must pass. A refusal of
//< it binds top-level declarations to file order (sema's collect Pass 2a/2b, emit_top_level_vars).
// EXPECT: circular constant definition detected
// EXPECT-NOT: initializer element
pub const A: I32 = B
pub const B: I32 = A
// The passing side: a chain referring to constants declared later, and the shape using that as an
// array length.
pub const C: I32 = D + 1
pub const D: I32 = E * 2
pub const E: I32 = 5
pub $buf: U8[F] = ::{}
pub const F: Sz = 4
fn main()
  _x: = A
  _y: = C
  _z: = buf.len
// ==== case const_init_call
//< A top-level `const`'s initialiser must be a constant expression, so a call in it is rejected
//<
//< It becomes a C file-scope initialiser, just like a variable's. Left unchecked, an initialiser
//< with a call in it passes through and becomes a C compiler error.
// EXPECT: top-level variable initializer is not a compile-time constant
fn one(): I32
  return 1

pub const X: I32 = one()

fn main()
  _y: = X
// ==== case const_init_overflow
//< A top-level initialiser is folded and checked for overflow even when nothing uses it
//<
//< Caution: **Leave it to `eval_constexpr` and it passes through.** That one runs only where a
//< value is needed (an array length, an enum tag, an index, a generic bound). An unfoldable
//< initialiser must pass silently. An unsigned wrap (`mod 2^N` by the specification) is fine.
// EXPECT: integer overflow in compile-time constant expression
// EXPECT-NOT: [W0
// EXPECT-NOT: is not a compile-time constant
pub struct Foo
  pub a: I32
  pub b: I32
pub enum Color
  red
  green

priv fn hook_impl() {}

// The firing side. The shape where only the middle overflows, the shape leaving the declared
// type's container, and the variable side are all looked at.
pub const BAD_ADD: I32 = 2147483647 + 1
pub const BAD_MID: I32 = (2147483647 + 1) - 1
pub const BAD_MUL: I32 = 100000 * 100000
pub const BAD_SUB: I32 = -2147483648 - 1
pub const BAD_I8: I8 = I8::127 + I8::1
pub $bad_var: I32 = 2147483647 + 1

// Initialisers that cannot be folded. All of them must pass.
pub const S: U8[] = "abc"
pub const ST: Foo = ::{ .a = 1, .b = 2 }
pub const COL: Color = Color.green
pub const ARR: I32[3] = ::{ 1, 2, 3 }
pub const SIZE_OF_FOO: Sz = sizeof(Foo)
pub const HOOK: fn() = hook_impl
pub $g: I32 = 7
pub const P: I32$@ = g@

// Inside the width. It must pass.
pub const OK_ADD: I32 = 2147483646 + 1
pub const OK_BIT: I32 = 1 << 30
pub const OK_MIN: I32 = -2147483647 - 1
pub const OK_CHAIN: I32 = OK_ADD - 1
pub const OK_U8_WRAP: U8 = U8::255 + U8::1
pub const OK_CHAR: U8 = 'x'

fn main(): I32
  _a: = BAD_ADD + BAD_MID + BAD_MUL + BAD_SUB + I32::BAD_I8 + bad_var
  _b: = S.len + ST.a + ARR[0] + SIZE_OF_FOO + g + P$
  _c: = OK_ADD + OK_BIT + OK_MIN + OK_CHAIN + I32::OK_U8_WRAP + I32::OK_CHAR
  _d: = COL
  _e: = HOOK
  return 0
// ==== case const_init_part_read
//< A top-level initializer reading a part of another value is refused, by ksplc itself
//<
//< Let through, C99 refuses a read of an element or a member in a file-scope initializer. gcc says
//< "initializer element is not constant"; clang lets some by. LLVM refuses it with
//< advice to use C. An array's `.len` is no read and passes.
// EXPECT: const_init_part_read.kspl:20:21: error: a top-level initializer cannot read a part of another value
// EXPECT: const_init_part_read.kspl:21:21: error: a top-level initializer cannot read a part
// EXPECT: const_init_part_read.kspl:22:20: error: a top-level initializer cannot read a part
// EXPECT: const_init_part_read.kspl:23:20: error: a top-level initializer cannot read a part
// EXPECT: const_init_part_read.kspl:24:20: error: a top-level initializer cannot read a part
// EXPECT: const_init_part_read.kspl:25:16: error: a top-level initializer cannot read a part
// EXPECT: Finished with 6 error(s)
// EXPECT-NOT: initializer element
pub struct P
  pub x: I32
  pub y: I32
pub const A: I32[_] = ::{ 1, 2, 3 }
pub const POINT_VALUE: P = ::{ .x = 4, .y = 5 }
pub const S: U8[] = "hello"
pub const Z1: I32 = A[2]
pub const Z2: I32 = POINT_VALUE.x
pub const Z3: U8 = "abc"[1]
pub const Z4: Sz = S.len
pub const Z5: Sz = "abc".len
pub $z6: U8@ = S.ptr
pub const OK_LEN: Sz = A.len

fn main(): I32
  return Z1 + Z2 + I32::Z3 + I32::Z4 + I32::Z5 + I32::OK_LEN + I32::z6$
// ==== case const_ptr_field_write
//< A write into a field at the target of a read-only pointer (`T@`)
//<
//< The type declares the target immutable. So it is refused, as a write to an element of a
//< read-only slice `T[]` is. A check of the element side alone lets a pointer's target through.
//< `P` itself is mutable (bare), so the refusal is shown to be on the type axis, not the binding's.
// EXPECT: cannot write through a read-only pointer
struct S
  f: I32
fn main()
  v: S = ::{ .f = 0 }
  p: S@ = S@::v@
  p.f = 1
// ==== case const_ptr_in_struct_field_write
//< A write into the target of a read-only pointer (`T@`) held as a struct's field
//<
//< A step that is "a pointer beyond a field access" has its immutability forced just the same.
//< It easily passes sema and fails on the generated C's `const`. For a field chain, only the root
//< is inferred. Then the type side is walked (write_target_type in sema/body/stmt.kspl).
// EXPECT: cannot write through a read-only pointer

struct S
  p: I32@

fn write_through_field(s: S$@)
  s.p$ = 1

fn main(): I32
  $v: I32 = 0
  s: = S::{ .p = v@ }
  s@.write_through_field()
  return v
// ==== case const_ptr_nested_deref_write
//< A multi-step dereference (`pp$$`) where the middle step is a read-only pointer (`I32@`)
//<
//< `pp$ = g2@` is correct (the outer step is `$@`), but `pp$$`'s target is immutable. If
//< write_target_type walks only `.` and not `$`, reject_write_through_const_ptr gives up
//< (fail-open). C still refuses by its const qualifier. LLVM has none, and the write holds.
// EXPECT: cannot write through a read-only pointer
$g: I32 = 1
$g2: I32 = 2

fn main()
  $inner: I32@ = g@
  pp: I32@$@ = inner@
  pp$ = g2@ // legitimate: the outer step (the inner pointer's slot) is mutable
  pp$$ = 99 // invalid: the inner step's target is read-only
// ==== case const_signed_overflow
//< Where folding is required, a signed overflow is rejected
//<
//< Caution: **Look at the intermediate result too**: `(2147483647 + 1) - 1` fits an `I32` at last.
//< **Decide by the operands' type width**, not `I64`'s boundary: `1 << 31` is 2^31, past `I32`'s
//< maximum, as `1I64 << 63` is past `I64`'s. A bit pattern is written unsigned and cast.
// EXPECT: integer overflow in compile-time constant expression
// EXPECT: Finished with 8 error(s)
// EXPECT-NOT: does not fit the enum's base type
// EXPECT-NOT: [W0
import "std/io"

// The shape where only the middle overflows. The final value fits an I32.
priv enum Mid_add
  a = (2147483647 + 1) - 1
priv enum Mid_mul
  b = (100000 * 100000) / 100000
// The lower boundary.
priv enum Mid_sub
  c = (-2147483647 - 2) + 1
// A left shift into the sign bit, at once and in two steps, as a tag and as a constant, and at
// `I64`.
priv enum Shift_top
  g = 1 << 31
  h = (1 << 30) << 1
const SHIFT_I64: I64 = 1I64 << 63
const SHIFT_I32: I32 = 1 << 31
const SHIFT_STEPS: I32 = (1 << 30) << 1

// Inside the width it passes (that the errors do not grow here is pinned down at the same time).
priv enum Ok_add
  d = (2147483646 + 1) - 1
priv enum Ok_bit
  e = 1 << 30
priv enum Ok_min
  f = -2147483647 - 1
priv enum Ok_pattern
  i = I32::(1U32 << 31)
  j = -1 << 30

fn main(): I32
  io.out()
    .s("\{Mid_add.a.variant_name()\}\{Ok_add.d.variant_name()\}\{Ok_bit.e.variant_name()\}\{Ok_min.f.variant_name()\}\{Mid_mul.b.variant_name()\}\{Mid_sub.c.variant_name()\}\{Shift_top.g.variant_name()\}\{SHIFT_I64\}\{SHIFT_I32\}\{SHIFT_STEPS\}\{Ok_pattern.i.variant_name()\}\n")
  return 0
// ==== case const_slice_descriptor_write
//< Replacing the descriptor through a pointer to an immutable slice descriptor (`U8$[]@`)
//<
//< The type declares the target immutable, so it is refused. `U8[]$@` (a mutable pointer to a
//< slice of immutable elements) is another type, where `P$ = other;` is allowed. Collapse the two
//< into one canonical type, or exempt writes through any pointer to a view type, and this passes.
// EXPECT: cannot write through a read-only pointer
fn main()
  a: U8[4] = ::{ 1, 2, 3, 4 }
  b: U8[4] = ::{ 5, 6, 7, 8 }
  sa: U8$[] = U8$[]::a
  sb: U8$[] = U8$[]::b
  p: U8$[]@ = sa@
  p$ = sb
// ==== case const_slice_elem_compound_assign
//< A **compound assignment** to an element of a read-only slice
//<
//< Caution: If a write on an index is checked only for `=`, `S[0] += v` rewrites the element. The C
//< compiler does not catch it: the generated C's const qualifier covers only the slice
//< descriptor's value (the `S.ptr` of `const Const_I32_Slice S` is not const).
// EXPECT: cannot write to an element of the read-only slice 'I32[]'. Use '$[]'

fn bump_first(s: I32[])
  s[0] += 7

fn main(): I32
  $a: I32[2] = ::{}
  bump_first(I32$[]::a)
  return a[0]
// ==== case const_type_arg_does_not_fit
//< A value type argument its `const` parameter's type does not hold is refused at the use
//<
//< **Inside the instance nothing hanging on a type argument is reported**, so `Ring<|3000000000|>`
//< for `const N: I32` was truncated in silence, and `Ring<|true|>` was reported inside the
//< template's body (`check_const_arg` in `ksplc/sema/decl/mono.kspl`).
// EXPECT: const_type_arg_does_not_fit.kspl:22:6: error: type argument '3000000000' does not fit 'const N: I32'
// EXPECT: const_type_arg_does_not_fit.kspl:23:6: error: type argument 'true' does not fit 'const N: I32'
// EXPECT: const_type_arg_does_not_fit.kspl:24:6: error: type argument '1' does not fit 'const ON: Bool'
// EXPECT-NOT: has no field or method named
// EXPECT-NOT: '-5' does not fit
struct Ring<|const N: I32|>
  v: I32

impl<|const N: I32|> Ring<|N|>
  fn get(r: Self): I32
    return N * 100 + r.v

struct Flag<|const ON: Bool|>
  v: I32

fn main(): I32
  b: Ring<|3000000000|> = ::{ .v = 2 }
  c: Ring<|true|> = ::{ .v = 3 }
  d: Flag<|1|> = ::{ .v = 4 }
  e: Ring<|-5|> = ::{ .v = 5 }
  return b.get() + c.get() + d.v + e.get()
// ==== case const_type_arg_expression
//< A computed value passed as a type argument is refused
//<
//< Only a literal, a negated literal or a const's name can stand there. Let `2 + 1` through and it
//< is read as a type, the instance is named after the node, and the C holds `return expr;`
//< (Principle 2). The three spellings the rule allows have to pass alongside.
// EXPECT: a value passed as a type argument must be a literal, a negated literal or the name of a const
fn size_of<|const N: I32|>(): I32
  return N

const THREE: I32 = 3

fn main(): I32
  a: = size_of<|3|>()
  b: = size_of<|-3|>()
  c: = size_of<|THREE|>()
  d: = size_of<|2 + 1|>()
  return a + b + c + d
// ==== case const_writable_elements
//< A `$` on the type side cannot be written for a fixed-length array's elements
//<
//< The elements are the array's own substance. So the write permission belongs to **the side
//< holding it** (the `$` before the name, or the receiver for a field). `T$[]` and `T$@` target a
//< separate substance and keep it on the type. A `$` on a `const` slice gets another diagnostic.
// EXPECT: a fixed-size array cannot carry '$' on its element type
// EXPECT: a fixed-size array cannot carry '$' on its element type
// EXPECT: const 'SL' declares writable elements

const ARR: U8$[4] = ::{ 1, 2, 3, 4 }
const SL: U8$[] = "abc"

fn main(): I32
  const LOCAL: U8$[2] = ::{ 1, 2 }
  return I32::ARR[0] + I32::SL[0] + I32::LOCAL[0]
// ==== case const_narrow_overflow
//< A constant that overflows its operands' width is refused, at every operator
//<
//< Folded at I64's width, `-2147483648 / -1` passed, and the C backend wrote a run-time division
//< into a file-scope initializer, which the C compiler refused; `-(-128I8)` passed as 128.
// EXPECT: const_narrow_overflow.kspl:7:16: error: integer overflow in compile-time constant
// EXPECT: const_narrow_overflow.kspl:8:15: error: integer overflow in compile-time constant
const P: I32 = -2147483648 / -1
const M: I8 = -(-128I8)

fn main(): I32
    return 0

//< An exception union's error type cannot be omitted
//<
//< `T?I32` is always written: `T?` would be a second spelling of the same type (TOOWTDI:
//< docs/DESIGN.md chapter 9). The expected-token list alone does not say a rule is behind it, so
//< the message names the spelling to use (forbidden_spelling_hint in ksplc/parse/syntax_msg.kspls).
// EXPECT: error
// EXPECT: there is no 'T?' shorthand

priv fn f(): Sz? {
    return 1;
}

fn main(): I32 {
    return I32::(f() catch 0);
}

//< A struct does not cast to a number
//<
//< **Let it through and C refuses it** ("aggregate value used where an integer was expected"),
//< far from the KSPL source.
// EXPECT: to 'I32': only a number, a Bool, a scalar enum or a pointer converts
struct S
  a: I32

fn main(): I32
  s: = S::{ .a = 1 }
  return I32::s

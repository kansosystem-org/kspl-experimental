//< A generic function that calls itself with **a deeper type argument**
//<
//< Monomorphisation makes a substance per type argument, so the run-time stop (`d <= 0`) does not
//< end the growth. **Do not put the per-step type disagreements out:** the outermost immutability
//< has no notation (`ksplc/sema/type/display.kspls`), so 50 alike lines would hide the cause.
// EXPECT: generic function instantiation chain too deep
// EXPECT-NOT: but got 'I32@'
fn h<|T|>(x: T, d: I32): T
  if d <= 0
    return x
  return h<|T@|>(x@, d - 1)$

fn main(): I32
  return h<|I32|>(0, 1)

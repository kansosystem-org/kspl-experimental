//< A string subject is refused, and the message names its type as written
//<
//< **The C spelling (`std_lang_Slice_U8_Const`) is a name the writer never wrote**, and a reader
//< cannot tell it is the `U8[]` they switched on.
// EXPECT: cannot 'switch' on 'U8[]': only scalars
// EXPECT-NOT: std_lang_Slice
fn main(): I32
  s: U8[] = "a"
  switch s case "a"
    return 1
  default
    return 0

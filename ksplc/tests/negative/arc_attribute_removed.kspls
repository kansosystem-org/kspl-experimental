//< The `#arc` attribute is not accepted
//<
//< ARC is expressed by conformance to the `Ref_counted` trait, whose check forces retain/release to
//< exist. As an attribute, `#arc` on a type without them draws nothing, and lower's synth_arc_stmt
//< inserts nothing in silence, so ARC not taking effect goes unnoticed.
// EXPECT: unknown attribute '#arc'
#arc
priv struct Bogus
  n: I32

fn main()
  a: Bogus = ::{ .n = 1 }
  _b: = a

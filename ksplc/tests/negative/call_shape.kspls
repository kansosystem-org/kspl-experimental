//< One subject per file, with one function for each case
//<
//< The file's marks are every case's marks gathered at the head. The same mark written N times
//< must match N places.
// EXPECT: cannot call 'x': it is a value of type 'I32', not a function
// EXPECT: argument count mismatch

// A call on a value that cannot be called. It is stopped by KSPL's diagnostic (rather than
// showing the user the C compiler's `called object type 'I32' is not a function`).
// A named
// function's symbol holds **the return type** in its type_id, so the branch taking a call
// expression's result type from "the target's type" is legitimate. That branch was hitting a
// plain variable too, so it put `I32 y = x(1);` out with no diagnostic.
fn case_call_non_callable()
  x: I32 = 5
  _y: = x(1)

// A disagreement in the argument count
fn add(a: I32, b: I32): I32
  return a + b
fn case_arg_count()
  z: = add(1)

fn main()
  case_call_non_callable()
  case_arg_count()

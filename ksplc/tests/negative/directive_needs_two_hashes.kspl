//< A setting that takes effect on a whole file is written with `##`
//<
//< Drop one `#` and it is read as an attribute: **the count of `#` settles the range, not the
//< position** (`##` the enclosing file, `#` what comes next), so the two sets of names grow apart.
//< Caution: **Do not copy the expectation set to the end.** The tail changes with the grammar.
// EXPECT: expected ')',
import "std/io";

#lint(H0704 = off)
fn main(): I32 {
    io.out().s("unreachable\n");
    return 0;
}

//< `==` on an enum whose variants carry data is refused unless the enum implements `Eq`
//<
//< A tagged union is a struct in C; let `==` through and the C compiler's `invalid operands to
//< binary expression` reaches the user (Principle 2).
//< Caution: Keep the non-firing side: a simple enum's `==` and a tagged union's `switch` pass.
// EXPECT: Operator '==' requires
// EXPECT: to implement 'Eq' interface
// EXPECT: its variants carry data, so it has no built-in '=='; take it apart with 'switch'
enum Simple
  a
  b

enum Tagged
  quit
  click(x: I32)

fn is_quit(e: Tagged): Bool
  switch e case .quit
    return true
  default
    return false

fn main()
  s: = Simple.a
  if s == Simple.b
    return
  t: = Tagged.click(3)
  if is_quit(t)
    return
  if t == Tagged.quit
    return

//< A type with a field hidden from the caller cannot be built from outside with `::{}`
//<
//< A field not written is filled with zero, so without refusing it a "value whose content should
//< not be settleable" can be made from outside (for a type holding an owning handle, a fake goes
//< about pointing at no substance).
// EXPECT: cannot be built here: field 'head' is not visible at this point
// EXPECT-NOT: [
import "std/mem" { Arena }

fn main(): I32
  a: Arena = ::{}
  return I32::sizeof(Arena) - I32::sizeof(a)

//< The same rule applies to a function pointer's alias too
//<
//< There is no declaration of what it succeeds, but the visibility works as a cap: **it cannot be
//< wider than any name appearing in the type expression**. Miss a type slipped into a parameter and
//< the shape passes where a side that cannot name it receives that value.
// EXPECT: target type 'Hidden' is less visible than the typedef
// EXPECT-NOT: [
priv struct Hidden
  v: I32

pub typedef Cb = fn(h: Hidden): I32

pub fn run(f: Cb): I32
  return 0 if f == null else 1

fn main(): I32
  return 0

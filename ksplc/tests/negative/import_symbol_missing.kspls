//< A selective import naming something the target lacks is rejected at the import line
//<
//< Unchecked, a misspelling in `import "p" { A };` passes the import line in silence, showing up
//< at the use as `undefined path or identifier` or, never used, nowhere at all
//< ("11.11 Name resolution with no namespace goes through one function" in `ksplc/docs/DESIGN.md`).
// EXPECT: has no symbol named 'Ci33'
import "std/checked_int" { Ci33 }

fn main(): I32
  return 0

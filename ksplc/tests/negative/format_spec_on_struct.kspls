//< A format setting applies only to numbers
//<
//< Even conforming to `Formattable`, there is nowhere for an alignment or a thousands separator to
//< apply, so the desugaring target `fmt_spec` does not resolve and it stops here.
// EXPECT: does not take the width / '0' / ',' items
// EXPECT-NOT: [
import "std/io"
import "std/strfmt"

struct P
  x: I32

impl P: Formattable
  fn fmt(r: Self, w: Writer): Writer
    return w.i(I64::r.x)

fn main(): I32
  p: = P::{ .x = 1 }
  io.out().s("\{p:5\}\n")
  return 0

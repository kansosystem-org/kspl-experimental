//< An integer and a float never meet implicitly, an integer literal included
//<
//< **Let them through and a value changes in silence**: `F32 0.5 + I64 16777217` gave 16777216.0,
//< since an integer beyond 24 bits does not fit an `F32`. An integer literal given a float type
//< (`f: F64 = 2`) passed on C and gave LLVM `store double 2`, which does not build; `2.0` is the
//< one spelling of that value.
// EXPECT: between 'F32' and 'I64' is forbidden to prevent data loss: neither holds every value of the other, so '+' has
// EXPECT: between 'F64' and 'I32' is forbidden to prevent data loss: neither holds every value of the other, so '*' has
// EXPECT: between 'F64' and 'I32' is forbidden to prevent data loss: neither holds every value of the other, so '-' has no type to compute in. Use explicit '::' cast, or write the integer literal as a float
// EXPECT: between 'I32' and 'F32' is forbidden to prevent data loss: neither holds every value of the other, so '<' has no type to compute in. Use explicit '::' cast, or write the integer literal as a float
// EXPECT: implicit conversion between 'I32' and 'F64' is forbidden to prevent data loss. Use explicit '::' cast, or write the integer literal as a float
// EXPECT: ternary operator branches have incompatible types: 'F64' and 'I32'
// EXPECT-NOT: error: expected
priv fn half(x: F64): F64
  return x / 2.0

fn main(): I32
  a: F32 = 0.5
  b: I64 = 16777217
  c: F64 = 1.5
  i: I32 = 3
  r1: = a + b
  r2: = c * i
  r3: = c - 1
  r4: = 2 < a
  r5: F64 = 2
  r6: = c if i > 0 else i
  return I32::(F64::r1 + r2 + r3 + r5 + r6 + half(2.0)) + I32::r4

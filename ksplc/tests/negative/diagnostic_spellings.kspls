//< A diagnostic spells a type as it can be written, and a suggested cast as one that compiles
//<
//< **Each spelled something else**: a generic trait as its instance's mangled name
//< (`std_lang_Eq_S`) and the cast suggested for `-1` as `U32::1`, which drops the minus. An
//< `I32!I32` spelled `I32!` is the case `result_type_spelled_whole` in `errors.kspls`.
// EXPECT: does not implement required method 'ne' of interface 'std.lang.Eq<|ksplc.tests.negative.diagnostic_spellings.S|>'
// EXPECT: cast explicitly ('U32::-1') if the truncation is intended
// EXPECT-NOT: std_lang_Eq
struct S
  v: I32

impl S: Eq<|S|>
  fn eq(r: Self, o: S): Bool
    return r.v == o.v

fn main()
  u: U32 = -1
  _z: = u

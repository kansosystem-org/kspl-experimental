//< A call to a generic type's method cannot write type arguments
//<
//< **There is nothing to bind them to:** they are the enclosing `impl`'s, settled by the receiver.
//< Dropped in silence, a contradiction (`get<|U8|>()` on a `Plain<|I32|>`) or a wrong count passes
//< (Principle 5). A method's **own** (`fn m<|T|>(…)`) is matched: `type_arg_mut_not_named.kspls`.
// EXPECT: type arguments cannot be written here
import "std/io"

priv struct Plain<|T|>
  v: T

impl<|T|> Plain<|T|>
  fn get(r: Self): T
    return r.v

fn main(): I32
  q: Plain<|I32|> = ::{ .v = 3 }
  io.out().s("unreachable\n")
  return q.get<|U8|>()

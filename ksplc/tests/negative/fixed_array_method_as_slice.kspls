//< A slice method called on a fixed-length array suggests the cast, not an import
//<
//< An array is not a slice, and Rust and C convert one implicitly, so a reader from either writes
//< `buf.sub(...)`. The note on importing an extension method points the wrong way there.
// EXPECT: a fixed-length array is not a slice
// EXPECT: 'U8$[]::(...)'
// EXPECT-NOT: an extension method is visible only where
fn main(): I32
  $buf: U8[8] = ::{}
  n: = buf.sub(0, 4).len
  return I32::n

//< Use after free (across a function boundary, method form)
//<
//< A method call's receiver heads the parameters but is absent from the argument list; without
//< mending that offset, a release wrapped in a method under a name other than `free` passes whole.
// EXPECT: may already be freed here
import "std/mem"
import "std/mem" { dealloc }

priv struct S
  v: I32

impl S
  priv fn free(r: Self$@)
    dealloc(Void$@::r)

  // The method's name not being `free`, a decision looking at the name alone does not count it
  // as a release.
  fn close_it(r: Self$@)
    r.free()

fn main()
  p: = mem.alloc_as<|S|>()
  p.close_it()
  _x: = p.v

// The declaration that has the release tracked (Owned in std/lang.kspls).
impl S: Owned {}

//< A `::{ ... }` for a type that has no fields
//<
//< A number, a boolean, an enum, and Result itself are such. **Let it through and the diagnostic
//< comes from the C compiler** (Principle 2 in `../../../docs/DESIGN.md`), or, for `::{ 1, 2 }`,
//< only a warning while the second value vanishes. An empty `::{}` means zero-filling and passes.
// ==========================================
// EXPECT: 'I32' has no fields to fill, so it cannot be built with '::{ ... }'. Write the value
// itself EXPECT: 'Bool' has no fields to fill
// EXPECT: has no fields to fill
// EXPECT: A Result is built by returning a value or throwing an error, and read with '?' or 'catch'
// ==========================================
pub enum Oops: U8
  bad = 3

fn main(): I32
  n: I32 = ::{ 1, 2 }
  b: Bool = ::{ .x = true }
  e: Oops = ::{ .bad = 1 }
  r: I32?Oops = ::{ .is_err = true, .error_code = Oops.bad }
  return n + (I32)::(r catch 0)

//< An alias cannot be more public than its target type
//<
//< An alias puts a type's name outward, so written more widely a side that cannot name the target
//< can receive its value, and the visibility written on the target stops taking effect (the same
//< rule as Rust's E0364 / E0365, Swift's public typealias and Kotlin's typealias).
// EXPECT: target type 'Hidden' is less visible than the typedef
// EXPECT-NOT: [
priv struct Hidden
  v: I32

pub typedef Exposed = Hidden

fn main(): I32
  e: Exposed = ::{ .v = 1 }
  return e.v

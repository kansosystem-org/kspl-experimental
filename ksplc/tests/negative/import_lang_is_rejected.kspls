//< `std/lang` is in every file without an import line, so writing one for it is an error
//<
//< **An error, not a lint:** writable, it gives two ways to the same name, "implicitly" and "by an
//< import line" (docs/DESIGN.md chapter 9); mend one alone and the other passes in silence. The
//< analysis goes on as though the line were absent, so the `Option` below has to resolve.
// EXPECT: is imported into every file
// EXPECT-NOT: undefined path or identifier 'Option'
import "std/lang"

fn find(): Option<|I32|>
  return Option<|I32|>.some(1)

fn main(): I32
  return find().unwrap_or(0)

//< A labelled `break` from a nested loop leaves the outer `for`
//<
//< An unlabelled `break` in the inner loop would leave only the inner one, so the outer loop would
//< still never end. `break outer` names the outer loop, so control reaches the function's end.
// EXPECT: function 'scan' is expected to return 'I32', but control may reach the end
fn scan(n: I32): I32
  outer: for
    for
      if n > 0
        break outer
      return 1

fn main(): I32
  return scan(3)

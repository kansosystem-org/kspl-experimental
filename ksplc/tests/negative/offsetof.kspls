//< One subject per file, with one function for each case
//<
//< The file's marks are every case's marks gathered at the head. The same mark written N times
//< must match N places.
// EXPECT: 'offsetof' names a field that
// EXPECT: 'offsetof' needs a struct type
// EXPECT: 'offsetof' needs a struct type

// A spelling mistake is not let through in silence. Mistake one position and a read or write
// lands on the neighbouring field.
priv struct S
  a: U8
  b: I64

fn case_offsetof_no_field(): I32
  return I32::offsetof(S, bb)

// Only a struct holds named fields.
fn case_offsetof_not_struct(): I32
  return I32::offsetof(I32, x)

// An enum's variants hold no position (they are tag values, not places).
priv enum E
  a
  b

fn case_offsetof_on_enum(): I32
  return I32::offsetof(E, a)

fn main()
  case_offsetof_no_field()
  case_offsetof_not_struct()
  case_offsetof_on_enum()

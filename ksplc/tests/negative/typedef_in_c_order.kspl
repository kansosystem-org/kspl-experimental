//< C's order for another name for a type writes the line back in KSPL's: the new name first
//<
//< `typedef U8[] Bytes;` fails on the `U8`, where the new name is wanted
//< (`append_typedef_spelling_hint` in `../../parse/syntax_msg.kspls`). The note is the
//< declaration's, not the notation's, so the brace notation gets it too.
// EXPECT: typedef_in_c_order.kspl:8:9: error: expected an identifier
// EXPECT: 'typedef' puts the new name first, the type after '=': 'typedef Bytes = U8[]'.
typedef U8[] Bytes;

fn main(): I32 {
    b: Bytes = "abc";
    return I32::b.len;
}

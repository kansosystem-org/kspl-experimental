//< Structs, enums, fields and globals
//< Each case below is compiled alone, as the file its head names.
// ==== case assign_through_alias_immutable
//< Another file's immutable global, written through its import alias, refuses the write
//< `fs.MAX_PATH_LEN` names that file's constant, not a field of a value `fs`. Read as a field, the
//< binding checked is `fs`, which names no value, and the write reaches the generated C.
// EXPECT: cannot assign to an immutable variable 'fs.MAX_PATH_LEN'
import "std/fs"

fn main(): I32
  fs.MAX_PATH_LEN = 3
  return 0
// ==== case assign_to_non_place
//< The diagnostic that rejects an assignment to an expression that is not a place
//< **Let it through and not one diagnostic comes out**: genc emits C like `&x = …` / `f() = …`,
//< and the C compiler's `expression is not assignable` reaches the user (Principle 2).
//< Caution: **Keep the stopping side last**: a passing side wrongly refused hides the `@` hint.
// EXPECT: cannot assign to this expression. It is a value, not a place
// EXPECT: '@' takes an address. '$' reads through a pointer
import "std/io"

priv struct P
  x: I32

fn main(): I32
  $n: = 1
  $arr: I32[4] = ::{ 0, 0, 0, 0 }
  $p: = P::{ .x = 0 }
  $ptr: I32$@ = n@
  s: I32$[] = I32$[]::arr
  // The passing side.
  n = 2
  p.x = 3
  arr[0] = 4
  ptr$ = 5
  (s.ptr + 1)$ = 6
  io.out().s("\{n\}\{p.x\}\{arr[0]\}\{arr[1]\}\n")
  // The stopping side: the result of taking an address is not a place (a mistyped `$`).
  n@ = 5
  return 0
// ==== case enum_payload_less_visible
//< A `priv` type in a `pub enum`'s payload is rejected as less visible than the variant
//< Allowed, code that cannot name that type could still bind and read it with `switch v case
//< .some(x) { x.v }`. It is the leak of a struct's `pub` field, under the same check
//< (docs/DESIGN-programming-language.md "Why a typedef cannot be published wider than its target"). A payload
//< has no visibility of its own, so the enum's side settles it.
// EXPECT: payload type 'Hidden' is less visible than the variant exposing it

priv struct Hidden
  v: I32

pub enum E
  none
  some(x: Hidden)

fn main()
  _e: = E.some(Hidden::{ .v = 1 })
// ==== case enum_tag_duplicate
//< Two variants of one enum may not share a tag
//< **Let it through and each backend picks its own answer**: C refuses the `switch` on it
//< ("duplicate case value"), and LLVM sends both cases to the first.
// EXPECT: variant 'b' has the tag 1. Variant 'a' already has that tag
enum D
  a = 1
  b = 1
  c = 0

fn main(): I32
  return I32::D.b
// ==== case enum_tag_not_constant
//< A tag is folded at translation time, so a run-time value cannot be one
//< **It is refused rather than replaced by the counter's value**, which a C enumerator would
//< silently become.
// EXPECT: is not a compile-time constant (only a `const`, an enum variant or a literal is)
$count: I32 = 3

enum C
  a = count

fn main(): I32
  return I32::C.a
// ==== case enum_tag_bare_sibling
//< A tag names an earlier variant through its enum, as every other place names a variant
//< **The bare name is no constant in scope**, so the general refusal would deny that a variant
//< folds; the report names the spelling that does.
// EXPECT: 'a' is a variant of 'E'. Name the variant through its enum here too ('E.a')
// EXPECT-NOT: is not a compile-time constant
enum E
  a = 1
  b = a + 1

fn main(): I32
  return I32::E.b
// ==== case enum_tag_out_of_base
//< A tag must fit the enum's base type, the written one and the one counted after it alike
//< **Let it through and the value changes silently**: `300` in a `U8` reads back as 44.
// EXPECT: enum tag 300 does not fit the enum's base type 'U8' (0 to 255)
// EXPECT: enum tag 256 does not fit the enum's base type 'U8' (0 to 255)
enum Y: U8
  a = 300
  b

enum Z: U8
  a = 255
  b

fn main(): I32
  return I32::Y.b + I32::Z.b
// ==== case enum_tagged_equality
//< `==` on an enum whose variants carry data is refused unless the enum implements `Eq`
//< A tagged union is a struct in C; let `==` through and the C compiler's `invalid operands to
//< binary expression` reaches the user (Principle 2).
//< Caution: Keep the non-firing side: a simple enum's `==` and a tagged union's `switch` pass.
// EXPECT: Operator '==' requires
// EXPECT: to implement 'Eq' interface
// EXPECT: Its variants carry data, so it has no built-in '=='. Take it apart with 'switch'
enum Simple
  a
  b

enum Tagged
  quit
  click(x: I32)

fn is_quit(e: Tagged): Bool
  switch e case .quit
    return true
  default
    return false

fn main()
  s: = Simple.a
  if s == Simple.b
    return
  t: = Tagged.click(3)
  if is_quit(t)
    return
  if t == Tagged.quit
    return
// ==== case field_called_as_method
//< A field written with `()` as though it were a method (`sys.args().len()`)
//< **A writer from Rust or C++ reaches for a method.** In KSPL, a slice's or a struct's `len` is a
//< field. The report names the field and its owner and removes the `()`. Joined, the callee's
//< pieces would spell a name that no function has. So they must not reach the message.
// EXPECT: cannot call 'len'. It is a field of 'std.sys.Args' with type 'Sz', not a method
// EXPECT: Read it without the '()': '.len'
// EXPECT-NOT: postfix
import "std/sys"

fn main(): I32
  n: = sys.args().len()
  return I32::n
// ==== case field_name_misspelt
//< A field that does not exist names the nearest field, never the import of an extension method
//< **Without a call only a field can stand there**, and no other file can add one. So the import
//< note would send the writer the wrong way. A name with no field near it gets no guess. The
//< member of a type with no fields (`I32`) gets neither note.
// EXPECT: field_name_misspelt.kspl:18:5: error: type 'field_name_misspelt.P' has no field or method named 'y'
// EXPECT: Note: the field with the nearest name is 'x'.
// EXPECT: has no field or method named 'totla'
// EXPECT: Note: the field with the nearest name is 'total'.
// EXPECT: type 'I32' has no field or method named 'z'
// EXPECT: has no field or method named 'unrelated'
// EXPECT-NOT: extension method
priv struct P
  x: I32
  total: I32

fn main(): I32
  $p: = P::{ .x = 1, .total = 2 }
  p.y = 3
  p.totla = 4
  p.x.z = 1
  p.unrelated = 5
  return p.x
// ==== case field_type_less_visible
//< A `priv` type in a `pub struct`'s `pub` field is rejected as less visible than the field
//< Allowed, even code that cannot name that type could read the value itself with `s.slot`. It is
//< the same kind of leak as at the return-value position. So the same check covers it
//< (docs/DESIGN-programming-language.md "Why a narrow type cannot stand where visibility is wide").
// EXPECT: field type 'Hidden' is less visible than the field exposing it

priv struct Hidden
  v: I32

pub struct Holder
  pub slot: Hidden

fn main()
  _h: = Holder::{ .slot = Hidden::{ .v = 1 } }
// ==== case field_type_visibility_ok
//< A field whose visibility is in balance with its type draws no visibility diagnostic
//< A `priv` field is stopped from outside by the visibility check, and a `priv struct`'s `pub`
//< field is held down to the struct's visibility, so neither leaks. The case fails on purpose
//< through the same check, at a return value rather than a field.
// EXPECT: return type 'Leaked' is less visible than the function exposing it
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: than the field exposing it

priv struct Hidden
  v: I32

pub struct Holder
  priv slot: Hidden

priv struct Inner_holder
  slot: Hidden

impl Holder
  pub fn sum(r: Self@): I32
    return r.slot.v

priv struct Leaked
  v: I32

pub fn leak(): Leaked
  return Leaked::{ .v = 3 }

fn main()
  h: = Holder::{ .slot = Hidden::{ .v = 1 } }
  i: = Inner_holder::{ .slot = Hidden::{ .v = 2 } }
  _s: = h.sum() + i.slot.v
// ==== case global_type_less_visible
//< A `priv` type in a `pub` global's type annotation is rejected as less visible than the global
//< Allowed, even code that cannot name that type could read the value itself with `lib.g`. It is
//< the same kind of leak as at the return-value and field positions. So the same check covers it
//< (docs/DESIGN-programming-language.md "Why a narrow type cannot stand where visibility is wide").
// EXPECT: declared type 'Hidden' is less visible than the declaration exposing it

priv struct Hidden
  v: I32

pub $g: Hidden = ::{}

fn main()
  g.v = 1
// ==== case global_type_visibility_ok
//< A global whose visibility is in balance with its type draws no visibility diagnostic
//< A global with its type annotation omitted is always an I32 (no user-defined type is reached), so
//< it is no hole in this check. The case fails on purpose through the same check, at a return value.
// EXPECT: return type 'Leaked' is less visible than the function exposing it
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: than the declaration exposing it

priv struct Hidden
  v: I32

priv $hidden_g: Hidden = ::{}
pub const PUBLIC_N: Sz = 4

priv struct Leaked
  v: I32

pub fn leak(): Leaked
  return Leaked::{ .v = 3 }

fn main()
  hidden_g.v = I32::PUBLIC_N
// ==== case packed_managed_field
//< An ARC-managed field `#packed` leaves under-aligned is refused where the struct declares it
//< Its count is kept through the field's address, which a pointer could not give aligned. A struct
//< holding one counts too; a raw pointer to one is not managed and passes.
// EXPECT: field 'r' holds the ARC-managed 'std.refcount.Rc<|I32|>'. Its count is kept through
// EXPECT: field 'h' holds the ARC-managed 'packed_managed_field.Holder'
// EXPECT: Finished with 2 error(s)
import "std/refcount" { Rc }

priv struct Holder
  r: Rc<|I32|>

#packed
priv struct Wire
  tag: U8
  r: Rc<|I32|>
  h: Holder
  p: Rc<|I32|>@

fn main(): I32
  w: Wire = ::{ .r = Rc<|I32|>.new(1) }
  return I32::w.tag
// ==== case recursive_generic_instantiation
//< A generic function that calls itself with **a deeper type argument**
//< Monomorphisation makes a substance per type argument, so the run-time stop (`d <= 0`) does not
//< end the growth. **Do not put the per-step type disagreements out:** the outermost immutability
//< has no notation (`ksplc/sema/type/display.kspl`), so 50 alike lines would hide the cause.
// EXPECT: generic function instantiation chain too deep
// EXPECT-NOT: but got 'I32@'
fn h<|T|>(x: T, d: I32): T
  if d <= 0
    return x
  return h<|T@|>(x@, d - 1)$

fn main(): I32
  return h<|I32|>(0, 1)
// ==== case struct_cast
//< Sema clearly rejects a direct `::` value cast to a struct type
//< Let through, a cast from a scalar or another struct becomes the invalid C `(StructType)value`
//< (see ksplc/sema/body/postfix.kspl). A source type implementing `Cast` (`Small::10`)
//< resolves to a cast() call and passes, so Small to Large, with no Cast, is used here.
//< The message names the trait as it is written, `std/lang`'s `Cast`, with the `impl` to add.
// EXPECT: cannot cast to struct type
// EXPECT: implements 'Cast<|struct_cast.Large|>' (std/lang's trait: 'impl struct_cast.Small: Cast<|struct_cast.Large|>')
// EXPECT-NOT: operator.Cast
struct Small
  val: I32

struct Large
  val: I64

impl I32: Cast<|Small|>
  fn cast(r: Self$@): Small
    return Small::{ .val = r$ }

fn main()
  a: = Small::10
  b: = Large::a
// ==== case struct_cast_names_the_type
//< A rejected cast to a struct names the type as its writer wrote it
//< **The instance's registered name must not reach the message** (`std_ds_List_I32`); it
//< names nothing the writer wrote.
// EXPECT: cannot cast to struct type 'std.ds.List<|I32|>'
// EXPECT-NOT: std_ds_List
import "std/ds" { List }

fn main(): I32
  _xs: = List<|I32|>::5
  return 0
// ==== case struct_literal_hidden_field
//< A type with a field hidden from the caller cannot be built from outside with `::{}`
//< A field not written is filled with zero. Without the refusal, code outside can make a "value
//< whose content it must not settle". For a type that holds an owning handle, a fake then points
//< at no substance.
// EXPECT: cannot be built here. Field 'head' is not visible at this point
// EXPECT-NOT: [
import "std/mem" { Arena }

fn main(): I32
  a: Arena = ::{}
  return I32::sizeof(Arena) - I32::sizeof(a)
// ==== case struct_literal_written_twice
//< A field or an array index written twice in one literal is refused, naming the first write
//< C takes the later value and only warns, so the earlier one would vanish while the program
//< builds. Each shape is a way to reach one place again: by name, by name after position, by index.
// EXPECT: struct_literal_written_twice.kspl:13:24: error: field 'x' is written twice in this literal: first by name on line 13, then here
// EXPECT: field 'x' is written twice in this literal: first by position on line 15, then here
// EXPECT: index 0 is written twice in this literal: first by position on line 17, then here
// EXPECT: Finished with 3 error(s)
struct P
    x: I32
    y: I32

fn case_name_twice(): P
    return ::{ .x = 1, .x = 2 }
fn case_name_after_position(): P
    return ::{ 5, .x = 6 }
fn case_index_after_position(): I32[3]
    return ::{ 1, 2, [0] = 9 }
// ==== case struct_too_many_initializers
//< A struct literal with more initializers than fields names the struct and its field count
//< The bare "too many initializers for struct" named neither, though the literal's type may come
//< from far off (an expected type, a parameter).
// EXPECT: P'. The type has 2 field(s)
// EXPECT: too many initializers for '
struct P
    x: I32
    y: I32

fn main()
    p: P = ::{ 1, 2, 3 }
    _u: = p.x
// ==== case struct_without_fields
//< A `struct` with `;` in place of its fields is refused outside an `extern` block
//< Nothing would say what it holds or how much space it takes. A type defined in C is declared in
//< an `extern "C"` block and held by pointer.
// EXPECT: 'Handle' has no fields
// EXPECT-NOT: [
pub struct Handle

fn main(): I32
  return 0

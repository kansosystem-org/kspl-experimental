//< A method with a default body has no vtable slot, so it cannot be called from a trait value
//<
//< Let it through and the call names a field absent from the C, falling at the C compiler with no
//< KSPL diagnostic (has_vtable_slot in `ksplc/base/ast_ext.kspls`). From a concrete type it stays
//< callable: that reaches the body copied per implementation.
// EXPECT: has a default body, so it has no vtable slot
// EXPECT-NOT: has no field or method named

pub struct Down
  pub n: I32

impl Down: Iter<|I32|>
  pub fn next(r: Self$@): Option<|I32|>
    if r.n <= 0
      return Option<|I32|>.none
    r.n -= 1
    return Option<|I32|>.some(r.n)

fn main()
  $d: = Down::{ .n = 3 }
  it: Iter<|I32|> = d@
  _n: = it.count()

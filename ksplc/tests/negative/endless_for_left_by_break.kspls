//< A `for` with no condition still ends where a `break` leaves it
//<
//< Only a loop no `break` leaves may end a function that returns a value ("Loops" in
//< `../../../docs/SPEC-language.md`). Here the `break` hands control to the function's end.
// EXPECT: function 'count_up' is expected to return 'I32', but control may reach the end
fn count_up(n: I32): I32
  $i: I32 = 0
  for
    if i > n
      break
    i += 1

fn main(): I32
  return count_up(3)

//< ksplc rejects an integer literal with more digits than any integer type holds
//<
//< The backend puts the characters straight into C / LLVM IR, so letting it through has the C
//< compiler say `integer literal is too large to be represented in any integer type` (and to the
//< user both the position and the cause become far from the KSPL source).
// EXPECT: is too large to be represented in any integer type
fn main()
  _x: U64 = 18446744073709551616

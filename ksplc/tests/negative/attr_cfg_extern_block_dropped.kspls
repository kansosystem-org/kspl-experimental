//< A `#cfg` put on an `extern` block drops the whole block
//<
//< The declarations inside need not be written one by one.
//< The flag not standing, the names inside exist nowhere.
// EXPECT: undefined path or identifier 'kspl_cfg_probe_a'
#cfg(cfg_probe_flag)
extern "C"
  pub fn kspl_cfg_probe_a(): I32
  pub fn kspl_cfg_probe_b(): I32

fn main(): I32
  return kspl_cfg_probe_a()

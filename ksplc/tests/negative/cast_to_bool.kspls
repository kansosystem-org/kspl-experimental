//< A number does not cast to `Bool`; the comparison that is meant is written instead
//<
//< **Let it through and the backends disagree**: C's `_Bool` makes `Bool::2` true, LLVM's `trunc`
//< false, so one source would give two answers.
// EXPECT: cannot cast 'I32' to 'Bool'
// EXPECT: cannot cast 'F64' to 'Bool'
fn of(x: I32): Bool
  return Bool::x

fn of_float(x: F64): Bool
  return Bool::x

fn main(): I32
  return I32::of(2) + I32::of_float(0.5)

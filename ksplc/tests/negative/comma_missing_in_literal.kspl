//< A `,` missing between two elements of a compound literal
//<
//< A value's `::{` holds a list as a call's `(` does, so the Note names the `,` there too.
// EXPECT: a ',' may be missing before '2'; the items of a list are parted by ','
fn main(): I32 {
  xs: I32[3] = ::{ 1 2, 3 };
  return xs[0];
}

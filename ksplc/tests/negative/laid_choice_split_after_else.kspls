//< A conditional value broken after its `else`, outside parentheses
//<
//< **Breaking behind the `else` is not a continuation either.** A line ending in `else` is where a
//< statement's `else` opens its level, so only a bracket carries a value on.
// EXPECT: a conditional value split across lines goes in parentheses
fn pick(c: Bool): I32
  x: = 100000 + 200000 if c else
    2
  return x

fn main(): I32
  return pick(true)

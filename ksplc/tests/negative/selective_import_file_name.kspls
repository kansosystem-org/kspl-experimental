//< The file name a selective import leaves out is suggested, with the `+` that brings it in
//<
//< `import "p" { A }` binds `A` alone, so `p.x` is undefined. The interpolation after it calls the
//< generic `put`, and instantiating it on a stand-in type would report errors inside `std/lang`
//< the user never wrote: the mistake is one error.
// EXPECT: brings in only the names listed
// EXPECT: import "std/io" + { ... }
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: 'io.err'
// EXPECT-NOT: std/lang
import "std/io" { File_stream }
import "std/sys"

fn main(): I32
  path: = sys.args()[0]
  io.err().s("wc: \{path\}\n")
  return 0

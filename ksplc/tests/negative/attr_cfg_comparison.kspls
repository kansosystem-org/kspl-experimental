//< `#cfg(sizeof(Sz) == 8)` is not accepted either
//<
//< `#cfg` drops before declarations are gathered, when no name or type is resolved, so a comparison
//< has no material. The refusal names a destination: `##error(cond, msg)`, evaluated after the
//< types are attached, takes a comparison (and sounds if it misses).
// EXPECT: '#cfg' takes exactly one flag name
// EXPECT: ##error(cond, msg)
#cfg(sizeof(Sz) == 8)
fn only_on_64bit(): I32
  return 1

fn main(): I32
  return only_on_64bit()

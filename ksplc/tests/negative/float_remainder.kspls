//< `%` and `%=` do not apply to a floating-point operand
//<
//< **Let it through and the backends part**: C refuses `%` on a `double`, while LLVM's `frem`
//< answers. A float remainder's sign has two readings, so the one meant is written out.
// EXPECT: operator '%' does not apply to 'F64'
// EXPECT: operator '%=' does not apply to 'F64'
fn rem(a: F64, b: F64): F64
  return a % b

fn main(): I32
  $x: F64 = 7.5
  x %= 2.0
  return I32::(rem(7.5, 2.0) + x)

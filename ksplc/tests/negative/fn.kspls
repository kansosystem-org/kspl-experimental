//< Functions: signatures, parameters, returns and calls
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case call_pointer_to_fn_ptr
//< A call on a **pointer to** a function pointer
//<
//< Peeled, it can be called, so that is advised. is_fn_ptr must not look at the canonical string's
//< leading `fn(` alone: since `ptr(X)` = `str(X) + "@"`, `fn(x: I32): I32@` looks like one too and,
//< as an indirect call, yields an invalid Void node (and a different diagnostic far away).
// EXPECT: Dereference it first
fn twice(x: I32): I32
  return x * 2

fn main()
  f: fn(x: I32): I32 = twice
  g: = f@
  _v: = g(3)
// ==== case call_shape
//< One subject, with one function for each of its shapes
//<
//< The marks are every function's marks gathered at the head. The same mark written N times
//< must match N places.
// EXPECT: cannot call 'x': it is a value of type 'I32', not a function
// EXPECT: argument count mismatch

// A call on a value that cannot be called. It is stopped by KSPL's diagnostic (rather than
// showing the user the C compiler's `called object type 'I32' is not a function`).
// A named
// function's symbol holds **the return type** in its type_id, so the branch taking a call
// expression's result type from "the target's type" is legitimate. That branch was hitting a
// plain variable too, so it put `I32 y = x(1);` out with no diagnostic.
fn case_call_non_callable()
  x: I32 = 5
  _y: = x(1)

// A disagreement in the argument count
fn add(a: I32, b: I32): I32
  return a + b
fn case_arg_count()
  z: = add(1)

fn main()
  case_call_non_callable()
  case_arg_count()
// ==== case callable_field_called
//< A field holding a `Callable1`, called as though it were a method
//<
//< What it holds is called through its `call`. Telling the writer to drop the `()`, as for a field
//< holding a value, would send them the wrong way.
// EXPECT: cannot call 'pred': it is a field of
// EXPECT: Call what it holds through 'call': '.pred.call(...)'
// EXPECT-NOT: Read it without
priv struct Holder
  pred: Callable1<|I32, Bool|>

fn keep(h: Holder@, x: I32): Bool
  return h.pred(x)

fn main(): I32
  return 0
// ==== case fn_name_to_generic_parameter
//< A function's name passed to a generic parameter gives it a type only where it names one function
//<
//< A non-generic function, a written specialization and a method named through its type each give
//< the function type of the function they name. A bare generic name names none, so it is refused at
//< its line with what to write, and so is a variadic function, which no function type holds; bound
//< to the mark of "a function", a call through the result had nothing to be checked against, nor C
//< to spell. A name passed where the parameter's type is fixed is checked against it.
//< Caution: Keep the passing side: the names that give a type, and a written type argument.
// EXPECT: generic function 'gf' cannot be used as a value without its type arguments
// EXPECT: generic type 'Holder' needs its type arguments before a method of it can be used as a value
// EXPECT: generic method 'gk' cannot be used as a value without its type arguments
// EXPECT: cannot infer the type arguments of 'pass_through' from function 'snprintf': it is variadic, and a function type holds no '...'
// EXPECT: then 'pass_through<|Op|>(…)'
// EXPECT: function 'text_len' cannot be used as 'fn(I32):I32': its own type is 'fn(U8[]):I32'
// EXPECT-NOT: from function 'twice'
// EXPECT-NOT: from function 'gf'
// EXPECT-NOT: from function 'keep'
import "std/libc" { snprintf }

priv fn twice(a: I32): I32
  return a * 2

priv fn text_len(_s: U8[]): I32
  return 3

priv fn gf<|T|>(_x: T): Sz
  return 100 + sizeof(T)

priv fn pass_through<|T|>(v: T): T
  return v

priv fn apply<|T|>(f: fn(x: T): T, v: T): T
  return f(v)

priv struct Holder<|T|>
  v: T

impl<|T|> Holder<|T|>
  fn keep(_r: Self@): Sz
    return 200 + sizeof(T)
  fn gk<|U|>(_r: Self@, _u: U): Sz
    return 1

priv typedef Op = fn(a: I32): I32

fn main(): I32
  bare: = pass_through(gf)
  bare_type: = pass_through(Holder.keep)
  bare_own: = pass_through(Holder<|I32|>.gk)
  variadic: = pass_through(snprintf)
  bad: = apply(text_len, 3)
  // The passing side.
  plain: = pass_through(twice)
  spec: = pass_through(gf<|U16|>)
  h: = Holder<|I32|>::{ .v = 1 }
  method: = pass_through(Holder<|I32|>.keep)
  written: = pass_through<|Op|>(twice)
  ok: I32 = written(1) + apply(twice, 2) + plain(3)
  return ok + I32::spec(2U16) + I32::method(h@)
// ==== case fn_param_void
//< A parameter written as Void is refused as Void, not as a missing type
//<
//< Both read the same "missing type annotation", which sent the writer looking for a type they had
//< written.
// EXPECT: parameter 'x' cannot be Void, which holds no value
fn f(x: Void): I32
    return 0

fn main()
    return
// ==== case fn_param_without_type
//< A declared function's parameter with no type is named, once
//<
//< A function's own signature was also read as a function-pointer type, so one omission gave two
//< errors, the first naming a function pointer the file does not hold.
// EXPECT: parameter 'x' has no type: write 'x: <type>'
// EXPECT-NOT: function-pointer
fn f(x): I32
    return 0

fn main()
    return
// ==== case fn_ptr_alias_chain_args
//< A call's arguments are checked even when a `typedef` names the function pointer type
//<
//< The call reads the parameters off the function type an alias chain ends at (fn_sig_of in
//< sema/type/env.kspls), so **however many links stand between, count and types are checked**.
//< Caution: Always place the non-firing side alongside: a correct call passes at one step and four.
// EXPECT: argument count mismatch. Expected 1, but got 3
// EXPECT: expected 'I32', but got 'U8[]'
import "std/io"

priv fn twice(a: I32): I32
  return a * 2

priv typedef A1 = fn(a: I32): I32
priv typedef A2 = A1
priv typedef A3 = A2
priv typedef A4 = A3

priv struct Slot
  priv op: A4

fn main(): I32
  one: A1 = twice
  four: A4 = twice
  bad_count: = four(1, 2, 3)
  bad_type: = four("nope")
  // The passing side: it can be called at one step and at four, and across a struct's field.
  s: = Slot::{ .op = twice }
  io.out().s("\{one(1)\} \{four(2)\} \{s.op(3)\} \{bad_count\} \{bad_type\}\n")
  return 0
// ==== case fn_ptr_param_without_type
//< A function-pointer type's parameter needs a type
//<
//< `fn(T): T` is "a typeless parameter named `T`", not "a parameter of type `T`". Inside a generic
//< only the return value's `T` resolves, so without refusing it the spelling mistake appears
//< nowhere and the generated C's argument list breaks.
// EXPECT: a parameter of this function-pointer type has no type
// EXPECT-NOT: [
priv fn inc(n: I32): I32
  return n + 1

priv fn twice<|T|>(v: T, f: fn(T): T): T
  return f(f(v))

fn main(): I32
  return twice<|I32|>(1, inc)
// ==== case fn_ptr_signature_mismatch
//< Sema catches a signature mismatch when a function is passed as a value
//<
//< A function pointer is a plain address in C, so a mismatch let through reaches the generated code
//< and is caught only by clang's -Wincompatible-function-pointer-types. A return value differing
//< alone is the worst: the caller reads a value that was never returned.
// EXPECT: function 'ret_differs' cannot be used as 'fn(I32):Bool'
// EXPECT: function 'param_differs' cannot be used as 'fn(I32):Bool'
// EXPECT: function 'arity_differs' cannot be used as 'fn(I32):Bool'

pub typedef Cb = fn(x: I32): Bool

pub struct Holder
  pub cb: Cb

priv fn ret_differs(_x: I32) {}

priv fn param_differs(_x: U8): Bool
  return true

priv fn arity_differs(_x: I32, _y: I32): Bool
  return true

priv fn matches(_x: I32): Bool
  return true

priv fn takes_cb(_cb: Cb) {}

fn main(): I32
  h: = Holder::{ .cb = ret_differs }
  takes_cb(param_differs)
  ok: = Holder::{ .cb = arity_differs }

  // This one passes (the same signature).
  good: = Holder::{ .cb = matches }
  return 1 if h.cb(0) || ok.cb(0) || good.cb(0) else 0
// ==== case fn_ptr_to_non_fn_type
//< A function used as a value is matched against the expected type, whatever that type is
//<
//< Caution: Exempt only "there is nothing to match against" (fn_value_type_id in
//< ksplc/sema/body/resolve_path.kspls); exempting "not a function pointer" lets this and `Callable`
//< through, to be learnt for the first time on the C side. Keep the non-firing side alongside.
// EXPECT: function 'big' cannot be used as 'Sz'
// EXPECT-NOT: cannot be used as 'fn(v: Sz):Bool'
// EXPECT-NOT: cannot be used as 'Void$@'
import "std/io"

priv fn big(v: Sz): Bool
  return v > 4

priv fn takes_fp(f: fn(v: Sz): Bool): Bool
  return f(9)

priv fn takes_raw(p: Void$@): Bool
  return p != null

pub fn main(): I32
  ok: = takes_fp(big) // the correct shape. it must pass
  raw: = takes_raw(Void$@::big) // the FFI relaxation. it must pass
  bad: Sz = big // this one alone stops
  io.out().s("\{ok\}\{raw\}\{bad\}").c('\n')
  return 0
// ==== case fn_ptr_where_callable_expected
//< A function pointer cannot be passed where a `Callable` is expected
//<
//< **ksplc must stop it.** Let through, it reaches generation (in C a function pointer is a plain
//< address) and clang reports a synthesised name and lines of std ("Failing fast through an exception or an ICE" in ksplc/docs/DESIGN.md). No
//< synthesised name goes in a diagnostic (ksplc/docs/DESIGN.md "A diagnostic points at 'the
//< position the user wrote'"): it names the call.
// EXPECT: this anonymous function cannot be used as
// EXPECT: add ';' before the closing paren of the signature
// EXPECT-NOT: _anon_fn_
import "std/ds" { List }
import "std/io"
import "std/mem" { Arena }
import "std/seq" as _seq

pub fn main(): I32
  arena: = Arena.new(4096)
  defer arena.free()
  $xs: = List<|Sz|>.new(null)
  defer xs.free()
  xs.push(1)
  xs.push(9)
  got: = xs@.where(fn(v: Sz): Bool {
    return v > 4;
  }).to_list(arena)
  io.out().s("unreachable \{got.len\}").c('\n')
  return 0
// ==== case fn_type_arg_keeps_its_commas
//< A function type written as a type argument is one argument, commas and all
//<
//< Its name holds commas of its own (`fn(I32,I32):I32`); cut at every comma, the row reads it as
//< two and the messages name a type that is not there.
//< Caution: Always place the non-firing side alongside: a function of the right shape goes in.
// EXPECT: function 'one_arg' cannot be used as 'fn(I32,I32):I32'
// EXPECT-NOT: type arguments for generic
// EXPECT-NOT: 'fn(I32'
import "std/ds" { List }
import "std/mem" { Arena }

priv fn add_pair(a: I32, b: I32): I32
  return a + b

priv fn one_arg(a: I32): I32
  return a

fn main(): I32
  arena: = Arena.new(1 << 16)
  defer arena.free()
  $ops: = List<|fn(a: I32, b: I32): I32|>.new(arena)
  ops.push(add_pair)
  ops.push(one_arg)
  return I32::ops.len
// ==== case fn_value_call_checked_by_type
//< A call through a function value is checked against the value's own type, whatever holds it
//<
//< The signature is read off the type (infer_value_call_args in `sema/body/call_args.kspls`), so a
//< value from a generic's field, a list or a call's result is checked as a local is, never as Void.
//< Caution: Always place the passing side alongside; a check refusing every call must not pass.
// EXPECT: argument count mismatch. Expected 1, but got 2
// EXPECT: argument count mismatch. Expected 1, but got 2
// EXPECT: expected 'I32', but got 'U8[]'
// EXPECT: expected 'I32', but got '(fn(I32):I32)@'
// EXPECT-NOT: 'Void'
import "std/ds" { List }

priv fn twice(a: I32): I32
  return a * 2

priv fn pick(): fn(a: I32): I32
  return twice

priv struct Box<|T|>
  priv v: T

fn main(): I32
  b: = Box<|fn(a: I32): I32|>::{ .v = twice }
  $ops: = List<|fn(a: I32): I32|>.new(null)
  defer ops.free()
  ops.push(twice)
  too_many: = b.v(1, 2)
  too_many_again: = pick()(1, 2)
  wrong_type: = ops.get(0)("nope")
  held: fn(a: I32): I32 = twice
  not_a_number: I32 = held@
  // The passing side: each shape called as its type says, its result used as an I32.
  found: = pick()
  ok: I32 = b.v(1) + ops.get(0)(2) + pick()(3) + found(4)
  return ok
// ==== case fn_value_operators
//< A function value takes `==` and `!=` alone, and two names give it no type
//<
//< A function's name takes its type from where it is written: compared with a typed value, it
//< takes that value's type in either order, but two names have none between them. An address has
//< no order or arithmetic that means anything. Let through, these reached C as arithmetic on an
//< address, and the LLVM IR compared an `i32` with a function's address.
//< Caution: Keep the passing side: a name compared with a typed function value, on either side.
// EXPECT: cannot compare 'twice' with 'thrice': each takes its type from the other side, and neither gives one
// EXPECT: bind one side to a variable first ('f: = …' takes its function type)
// EXPECT: cannot compare 'same<|I32|>' with 'Box<|I32|>.keep'
// EXPECT: operator '<' does not apply to a function: functions are compared only with '==' and '!='
// EXPECT: operator '+' does not apply to a function
// EXPECT: operator '-' does not apply to a function
// EXPECT: operator '+=' does not apply to a function
// EXPECT: function 'twice' cannot be used as 'I32': its own type is 'fn(I32):I32'
// EXPECT: function 'two' cannot be used as 'fn(I32):I32': its own type is 'fn(I32,I32):I32'
// EXPECT-NOT: global variable reference
// EXPECT-NOT: undeclared identifier
priv typedef Op = fn(x: I32): I32

priv fn twice(x: I32): I32
    return x * 2

priv fn thrice(x: I32): I32
    return x * 3

priv fn two(x: I32, y: I32): I32
    return x * y

priv fn same<|T|>(x: T): T
    return x

priv struct Box<|T|>
    v: T

impl<|T|> Box<|T|>
    fn keep(x: T): T
        return x

priv fn both_names(): Bool
    return twice == thrice

priv fn both_written(): Bool
    return same<|I32|> != Box<|I32|>.keep

priv fn ordered(f: Op): Bool
    return twice < f

priv fn arith(): I32
    return 1 + twice

priv fn negated(f: Op): Bool
    return -f == f

priv fn stepped(f: Op)
    $g: = f
    g += twice

priv fn not_a_function(): Bool
    return twice == 1

priv fn wrong_shape(f: Op): Bool
    return two != f

fn main(): I32
    // The passing side.
    f: Op = twice
    ok: = twice == f && f != thrice && same<|I32|> != f && Box<|I32|>.keep != f
    return 0 if ok else 1
// ==== case fn_value_variadic_binding
//< A variadic function's name bound with no type annotation is refused: no function type holds it
//<
//< A declaration with no type takes the function type of the function a name names (`f: = big`),
//< and a variadic one has none to give, since a function type holds no `...`. Let through, the
//< binding would carry the mark of a name with no type, which no C type spells.
//< Caution: Keep the passing side: a non-variadic name, an anonymous function and a call's result
//< are each a binding's type.
// EXPECT: cannot infer the type of 'all' from function 'printf': it is variadic, and a function type holds no '...'
// EXPECT-NOT: _anon_fn
import "std/io"

extern "C"
  fn printf(fmt: U8@, ...): I32

priv fn big(x: I32): Bool
  return x > 5

fn main(): I32
  // The stopping side: a variadic function has no function type.
  all: = printf
  // The passing side: each takes the function type of what it names.
  ptr: = big
  anon: = fn(x: I32): Bool
    return x > 1
  called: = big(7)
  io.out().s("\{ptr(7)\}\{anon(2)\}\{called\}\n")
  return 0
// ==== case fn_without_body
//< A function written with `;` in place of its body is refused, free or inside an `impl`
//<
//< Nothing in the program would define it. A function defined in C, or in a library built from
//< KSPL, is declared in an `extern "C"` block instead.
// EXPECT: 'twice' has no body
// EXPECT: 'area' has no body
// EXPECT-NOT: [
pub fn twice(n: I32): I32

struct Box
  w: I32

impl Box
  pub fn area(r: Box): I32

fn main(): I32
  return twice(Box::{ .w = 1 }.area())
// ==== case noreturn_outside_fallback
//< A `#noreturn` call is accepted as a value only as a `catch`'s fallback
//<
//< Caution: **Do not widen it to the return-value position.** Even past sema, genc emits C of the
//< form `return <Void>`, and only the C compiler falls, with zero diagnostics from KSPL. It stays
//< where the value is known to be discarded (`#noreturn` in `../../../docs/SPEC-language.md`).
// EXPECT: expected 'I32', but got 'Void'
priv enum Probe_error
  bad

priv fn probe(ok: Bool): I32!Probe_error
  if !ok
    throw Probe_error.bad
  return 7

fn main(): I32
  ok: = probe(true) catch panic("this one passes")
  if ok > 0
    return ok
  return panic("this one is refused")

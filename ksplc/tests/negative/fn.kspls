// EXPECT: a parameter whose type mentions a type parameter cannot have a default value

priv fn f<|T|>(a: T = 0): Sz
  return 0

fn main(): I32
  _x: = f<|I32|>(1)
  return 0
// ==== case param_default_in_closure
//< A closure is never called by name, so a default written on it would never take effect
//<
//< Written and silently ignored is the shape Principle 5 refuses.
// EXPECT: a closure parameter or capture cannot have a default value

fn main(): I32
  _f: = fn(a: I32, b: I32 = 2; ): I32
    return a + b
  return 0
// ==== case param_default_in_extern
//< C has no notion of a default, so nothing would fill it in (Principle 5)
// EXPECT: an extern function parameter cannot have a default value

extern "C"
  fn kspl_probe_default_arg(v: I32 = 0): I32

fn main(): I32
  return 0
// ==== case param_default_in_trait
//< The rules on how a default is written apply unchanged to a trait's declaration
//<
//< **The declaration side alone came to be writable, so that it has not loosened there is pinned
//< down.** The shape writing it on the implementation side is the case
//< `param_default_in_trait_impl`.
// EXPECT: a parameter default must be a literal
// EXPECT: a parameter without a default cannot follow one that has a default

priv trait Greeter
  fn greet(r: Self, n: I32 = 1 + 1): I32

priv trait Ordered
  fn pick(r: Self, a: I32 = 1, b: I32): I32

fn main(): I32
  return 0
// ==== case param_default_in_trait_impl
//< A default cannot be written on the implementation either
//<
//< A call through a trait resolves to the trait's declaration, so it does not look at the
//< implementation side's default (the same way C++'s inherited defaults break).
// EXPECT: a trait implementation cannot give a parameter a default value

priv trait Greeter
  fn greet(r: Self, n: I32): I32

priv struct A
  v: I32

impl A: Greeter
  fn greet(r: Self, n: I32 = 9): I32
    return r.v * n

fn main(): I32
  a: A = ::{ .v = 3 }
  return a.greet(1)
// ==== case param_default_not_literal
//< A default is a single literal
//<
//< Allow an expression and an allocation or a side effect happens without appearing in the call's
//< characters.
// EXPECT: a parameter default must be a literal

priv fn f(a: I32 = 1 + 1): I32
  return a

fn main(): I32
  return f()
// ==== case param_default_not_trailing
//< Defaults must be a run at the end of the parameter list
//<
//< "A default argument is allowed only for a foldable constant" in docs/DESIGN.md.
//< Have just one in the middle hold a default and the correspondence between a call's positions and
//< the parameters is not settled uniquely.
// EXPECT: a parameter without a default cannot follow one that has a default

priv fn f(a: I32 = 1, b: I32): I32
  return a + b

fn main(): I32
  return f(1, 2)
// ==== case return_type
//< A mismatch in the return type
// EXPECT: expected 'I32', but got 'U8[]'
fn f(): I32
  return "hello"
fn main()
  a: = f()
// ==== case return_type_less_visible
//< A `priv` type in a `pub` function's return value reaches a side that cannot name it
//<
//< It binds with `x: = make();`, and method calls and field reads work, so the `priv` its author
//< wrote is not in effect (docs/DESIGN.md Principle 5). For the reason only the return-value
//< position is checked, see docs/DESIGN.md "Why a narrow type may not sit in a position with wide
//< visibility".
// EXPECT: return type 'Hidden' is less visible than the function exposing it

priv struct Hidden
  v: I32

pub fn make(): Hidden
  return Hidden::{ .v = 1 }

fn main()
  _h: = make()
// ==== case return_type_visibility_ok
//< The counterpart of the case above
//<
//< Balanced visibility puts nothing out: a `priv` fn returning a `priv` type, a `priv struct`'s
//< `pub` method (held down to the impl target), a narrow argument type (nothing leaks outward).
//< An undefined symbol fails it on purpose; the EXPECT-NOT pins that no visibility error joins it.
// EXPECT: undefined path or identifier 'no_such_fn'
// EXPECT-NOT: is less visible than the

priv struct Hidden
  v: I32

impl Hidden
  // The impl target being priv, this `pub`'s effective visibility is file_private.
  fn clone(r: Self$@): Hidden
    return Hidden::{ .v = r.v }

priv fn make(): Hidden
  return Hidden::{ .v = 1 }

pub fn consume(h: Hidden): I32
  return h.v

fn main()
  h: = make()
  _c: = consume(h.clone())
  no_such_fn()

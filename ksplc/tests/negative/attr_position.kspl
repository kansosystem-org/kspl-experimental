//< An attribute is written **in front of** a declaration, one at a time with a `#`
//<
//< Neither a trailing one nor a comma list is accepted: **a `#` is written per attribute**, or the
//< later ones read as bare identifiers and the wording (`unknown attribute '#inline'`) mismatches.
//< What a signature holds there is demanded; `{` and `;` stopped the parse, the omissible `:` last.
// EXPECT: expected '{', ';', or ':'
import "std/io";

priv fn legacy() # inline, export { }

fn main(): I32 {
    legacy();
    io.out().s("unreachable\n");
    return 0;
}

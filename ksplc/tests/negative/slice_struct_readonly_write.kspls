//< Assigning to an element of an immutable slice (`Slice<|T|>` = `T[]`) is rejected
//<
//< **Talk about the elements:** "implement `Index_mut`" cannot be followed, since the elements'
//< immutability rides on a type argument. **Use the sugar's words:** `Slice<|I32|>` and `I32[]`
//< are one type, mended alike (`$[]`). `List<|T|>@` is `index_readonly_receiver.kspls`'s case.
// EXPECT: cannot write to an element of a read-only slice or array
import "std/io"

$buf: I32[2] = ::{ 1, 2 }

fn main(): I32
  s: Slice<|I32|> = ::{ .ptr = buf[0]@, .len = 2 }
  s[0] = 9
  io.out().s("\{s[0]\}\n")
  return 0

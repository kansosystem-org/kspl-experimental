//< A field holding a `Callable1`, called as though it were a method
//<
//< What it holds is called through its `call`. Telling the writer to drop the `()`, as for a field
//< holding a value, would send them the wrong way.
// EXPECT: cannot call 'pred': it is a field of
// EXPECT: Call what it holds through 'call': '.pred.call(...)'
// EXPECT-NOT: Read it without
priv struct Holder
  pred: Callable1<|I32, Bool|>

fn keep(h: Holder@, x: I32): Bool
  return h.pred(x)

fn main(): I32
  return 0

//< Literals, characters, strings and format specifiers
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case char_literal_one_byte
//< A character literal is one byte
//<
//< Caution: **Do not let a spelling through whose body is not spent in one byte**: let it through
//< and char_literal_byte **returns the leading byte alone in silence** (`あ` becomes 227). Text
//< that does not fit one byte is a string (`U8[]`); one-byte spellings must not be caught up in it.
// EXPECT: a character literal holds exactly one byte
// EXPECT-NOT: 'a' is more than one
// EXPECT-NOT: '\n' is more than one
// EXPECT-NOT: '\u0041' is more than one
pub fn take(): I32
  // Caution: **Place both a multi-byte character and the shape with two characters side by side.**
  // With one alone, both an implementation "returning UTF-8's leading byte" and one "returning
  // the first character" pass green.
  wide: U8 = 'あ'
  two: U8 = 'ab'
  ok_plain: U8 = 'a'
  ok_escape: U8 = '\n'
  ok_code: U8 = '\u0041'
  return I32::(wide + two + ok_plain + ok_escape + ok_code)
// ==== case format_spec_char_alone
//< The `\{b:c\}` that prints a byte **as a character** takes no other setting
//<
//< **It does not overlap a number's decoration**: one character has nowhere for a width, a
//< zero-fill, a thousands separator or a decimal count to apply, so one alongside is refused.
//< Read and discarded, it would be "written yet nothing happens" (Principle 5; as for hex).
// ==========================================
// EXPECT: combines 'width' with 'c'
// EXPECT: combines 'x' with 'c'
// That a lone `c` is not caught up in it is pinned down at the same time.
// EXPECT-NOT: format spec ':c'
// ==========================================
import "std/io" as io
import "std/strfmt"

pub fn take()
  b: U8 = 65U8
  io.out().s("ok=\{b:c\}\n")
  io.out().s("wide=\{b:3c\}\n")
  io.out().s("hex=\{b:xc\}\n")
// ==== case format_spec_char_type
//< Only `U8` accepts `\{v:c\}`
//<
//< **With the functions split, a type with nowhere to apply it stops at the interpolation with
//< "there is no such method"** (as hex is split off into `fmt_hex`). One shared function could
//< only ignore the argument, and that passes in silence.
// ==========================================
// EXPECT: type 'I32' does not take 'c'
// That the `U8` side is not caught up in it is pinned down at the same time.
// EXPECT-NOT: type 'U8' does not take
// ==========================================
import "std/io" as io
import "std/strfmt"

pub fn take()
  b: U8 = 65U8
  n: I32 = 7
  io.out().s("ok=\{b:c\}\n")
  io.out().s("int=\{n:c\}\n")
// ==== case format_spec_does_nothing
//< A format specifier that would be written yet do nothing is refused, one error per specifier
//<
//< **Each was accepted or misreported**: `.20` and `.25` printed 19 digits (std/strfmt clamps), a
//< lone `0` padded to no width, an empty `:` was a syntax error about a `(` never closed, and a
//< spec both unreadable and misordered gave two errors at one position (`check_format_spec` in
//< `ksplc/parse/desugar.kspls`).
// EXPECT: format spec ':.20' asks for more digits after the point than are written (at most 19)
// EXPECT: format spec ':0' has a zero-pad '0' and no width to pad to
// EXPECT: a ':' with no format spec after it
// EXPECT: unrecognized format spec ':,.2xq'; could not read 'q'
// EXPECT-NOT: combines ',' with 'x'
// EXPECT-NOT: format spec ':.19'
// EXPECT-NOT: is never closed
import "std/io"
import "std/strfmt"

fn main()
  f: = 2.5
  n: = 7
  io.out().s("[\{f:.19\}][\{f:.20\}][\{n:0\}][\{n:\}][\{n:,.2xq\}]\n")
// ==== case format_spec_hex_on_float
//< Hex is a setting only for integers
//<
//< There is no function putting a floating-point value's bit pattern out as it stands, so the
//< desugaring target `fmt_hex` does not resolve and it stops here.
// EXPECT: does not take 'x' / 'X'
// EXPECT-NOT: [
import "std/io"
import "std/strfmt"

fn main(): I32
  f: F64 = 3.5
  io.out().s("\{f:x\}\n")
  return 0
// ==== case format_spec_on_struct
//< A format setting applies only to numbers
//<
//< Even conforming to `Formattable`, there is nowhere for an alignment or a thousands separator to
//< apply, so the desugaring target `fmt_spec` does not resolve and it stops here.
// EXPECT: does not take the width / '0' / ',' items
// EXPECT-NOT: [
import "std/io"
import "std/strfmt"

struct P
  x: I32

impl P: Formattable
  fn fmt(r: Self, w: Writer): Writer
    return r.x.fmt(w)

fn main(): I32
  p: = P::{ .x = 1 }
  io.out().s("\{p:5\}\n")
  return 0
// ==== case format_spec_precision_on_int
//< The number of digits after the decimal point is a setting only for floating point
//<
//< Written against an integer it has nowhere to apply, so the desugaring target `fmt_prec` does not
//< resolve and it stops here. Ignored in silence, it becomes "it was written yet nothing happens".
// EXPECT: does not take '.N'
// EXPECT-NOT: [
import "std/io"
import "std/strfmt"

fn main(): I32
  n: I32 = 3
  io.out().s("\{n:.2\}\n")
  return 0
// ==== case literal_bad_code_point_escape
//< A `\uXXXX` is written with exactly four hexadecimal digits
//<
//< The digits, the value and the place are all three refused.
//< Caution: **Do not let a surrogate code point (D800–DFFF) through.** Not a code point, it
//< copies into UTF-8 as an invalid three-byte run that reads fine until a later check falls on it.
// EXPECT: takes exactly four hexadecimal digits
// EXPECT: names a surrogate
// EXPECT: is more than one byte in UTF-8
// EXPECT-NOT: '\u0041'
// EXPECT-NOT: '\u3042'
pub fn take(): I32
  ok_ascii: U8 = '\u0041'
  ok_wide: U8[] = "\u3042"
  short_hex: U8[] = "\u12"
  surrogate: U8[] = "\uD800"
  wide_in_char: U8 = '\u00E9'
  return I32::(ok_wide.len + short_hex.len + surrogate.len) + I32::ok_ascii + I32::wide_in_char
// ==== case literal_bounds
//< An integer literal that does not fit its range is an error
//<
//< **An unsettled literal is not judged as I32** (a numeric operator gives its right side no
//< expected type, pass_right_id in sema/body/expr.kspls), nor by absolute value (`I8 = -128`):
//< either bars correct code. Suffixed literals take their own road; `U8::300` truncates and passes.

// EXPECT: literal '2147483648' is out of range for type 'I32'
// EXPECT: literal '4294967296' is out of range for type 'U32'
// EXPECT: literal '300' is out of range for type 'U8'
// EXPECT: literal '400U8' is out of range for type 'U8'
// EXPECT: literal '-1' is out of range for type 'U32'
// EXPECT: literal '-129' is out of range for type 'I8'

// EXPECT-NOT: '128'
// EXPECT-NOT: '-128'
// EXPECT-NOT: '2147483647'
// EXPECT-NOT: '255'
// EXPECT-NOT: '0x85ebca6b'
// EXPECT-NOT: '18446744073709551615'

// EXPECT-NOT: '500'
fn mix(h: U32): U32
  return (h ^ (h >> 16)) * 0x85ebca6b

fn main(): I32
  over_i32: I32 = 2147483648
  over_u32: U32 = 4294967296
  over_u8: U8 = 300
  suffixed_u8: U8 = 400U8
  cast_u8: U8 = U8::500
  neg_u32: U32 = -1
  neg_i8: I8 = -129
  min_i8: I8 = -128
  max_i32: I32 = 2147483647
  max_u8: U8 = 255
  max_u64: U64 = 18446744073709551615
  return (1
    if over_i32 == 0 && over_u32 == 0 && over_u8 == 0 && suffixed_u8 == 0 && cast_u8 == 0 &&
    neg_u32 == 0 && neg_i8 == 0 && min_i8 == 0 && max_i32 == 0 && max_u8 == 0 && max_u64 == 0 &&
    mix(3) == 0 else 0)
// ==== case literal_unknown_escape
//< The characters allowed after a backslash inside a literal are fixed
//<
//< Let an unrecognised spelling through and `'\b'` (8 in C) quietly becomes `'b'`: something
//< written that does nothing (Principle 5). The place of refusal is the one
//< place is_known_escape in base/literal.kspls.
// ==========================================
// EXPECT: unknown escape '\b'
// EXPECT: unknown escape '\x'
// That the recognised spellings and raw strings are not caught up in it is pinned down at the
// same time.
// EXPECT-NOT: unknown escape '\n'
// EXPECT-NOT: unknown escape '\q'
// ==========================================
pub fn take(): I32
  ok: U8[] = "\n\r\t\0\'\"\\"
  raw: U8[] = """a\q b"""
  bad_char: U8 = '\b'
  bad_str: U8[] = "A\x41"
  return I32::(ok.len + raw.len + bad_str.len) + I32::bad_char
// ==== case raw_mutex_is_private
//< The plain lock (`thread.Raw_mutex`) is an internal part of std/thread and is not published
//<
//< Held apart from what it protects, the compiler cannot notice a caller forgetting lock() and
//< touching the data directly, so only `thread.Mutex<|T|>` (the two as one thing) is published, as
//< in Rust's std (std/docs/DESIGN.md "A mutex makes the lock and what it protects one thing").
// EXPECT: Raw_mutex
import "std/thread"

fn main()
  _m: = thread.Raw_mutex.new() catch
    return
// ==== case string_interp_outside_writer_chain
//< A string interpolation is syntax for writing into a Writer and produces no value
//<
//< It holds no storage, so off a Writer chain the interpolation itself is reported; undiagnosed,
//< it reaches Genc as `string_interp` and becomes an **ICE**. Desugar does not expand it where the
//< receiver is not a `.` chain, or an argument (`take` below) shows an unwritten name, `take.s`.
// EXPECT: string interpolation can only be written as the argument of a writer chain
// EXPECT: Build the value with 'Str_builder' first
import "std/io"

priv fn take(s: U8[]): Sz
  return s.len

fn main(): I32
  n: = 7
  // the assignment position (an ICE without the check)
  x: U8[] = "plain \{n\}"
  // a plain function's argument position (undefined identifier 'take.s' without the check)
  m: = take("arg \{n\}")
  io.out().s(x).s("\{m\}").c('\n')
  return 0
// ==== case string_line_continuation
//< A `\` at a line's end continues a **string** on the next line
//<
//< A character literal holds one byte on one line, so the mark there is refused like any other
//< (`line_continuation_span`, asked before `is_known_escape`, in ksplc/base/literal.kspls).
//< Caution: **Watch which refusal comes out:** read as a continuation, it draws a wrong complaint.
// EXPECT: unknown escape
// EXPECT-NOT: holds exactly one byte
pub fn take(): I32
  bad: U8 = '\
'
  return I32::bad
// ==== case interp_outside_s
//< An interpolated string is expanded only as `.s(<the string>)`
//<
//< The expansion writes the parts with `.s` and `put`, so another method's name (`flush`, `c`)
//< or an argument after the string would be dropped without a word.
// EXPECT: interp_outside_s.kspls:13:20: error: string interpolation can only be written
// EXPECT: interp_outside_s.kspls:15:9: error: string interpolation can only be written
// EXPECT: interp_outside_s.kspls:16:9: error: string interpolation can only be written
import "std/io"
import "std/str" { Str_builder }

fn main(): I32
    x: = 3
    io.out().flush("x=\{x\}")
    $b: = Str_builder.new()
    b.c("c=\{x\}")
    b.s("s=\{x\}", 9)
    b.free()
    return 0

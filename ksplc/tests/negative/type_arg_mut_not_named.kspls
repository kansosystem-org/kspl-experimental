//< The mutability mark on a type argument can be written only where the declaration declared it
//<
//< Caution: **It must not be ignored in silence.** Ignored, `Plain<|$I32|>` and `Plain<|I32|>`
//< become the same type, and whoever wrote it believes the target became mutable (Principle 5).
//< The shape that declares it is held by `ksplc/tests/variance_test.kspls`.
// EXPECT: '$' on a type argument is only allowed where the declaration names it
import "std/io"

priv struct Plain<|T|>
  v: T

fn main(): I32
  bad: Plain<|$I32|> = ::{ .v = 1 }
  io.out().s("\{bad.v\}\n")
  return 0

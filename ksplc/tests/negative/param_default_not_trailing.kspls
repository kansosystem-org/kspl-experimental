//< Defaults must be a run at the end of the parameter list
//<
//< "A default argument is allowed only for a foldable constant" in docs/DESIGN.md.
//< Have just one in the middle hold a default and the correspondence between a call's positions and
//< the parameters is not settled uniquely.
// EXPECT: a parameter without a default cannot follow one that has a default

priv fn f(a: I32 = 1, b: I32): I32
  return a + b

fn main(): I32
  return f(1, 2)

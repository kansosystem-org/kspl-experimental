//< A `,` missing inside a call whose bracket is closed further on
//<
//< **"Never closed" is settled over the rest of the text.** Here the `)` comes two lines down, so
//< the mistake is inside the bracket: the Note names the `,` between two items, not the bracket.
// EXPECT: laid_comma_missing_in_closed_call.kspls:13:7: error: expected ')'
// EXPECT: a ',' may be missing before '3'
// EXPECT-NOT: is never closed
priv fn add(a: I32, b: I32, c: I32): I32
  return a + b + c

fn main(): I32
  x: = add(1,
    2 3,
    4)
  return x

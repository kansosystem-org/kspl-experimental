//< The shape delimiting an enum's values with `,`
//<
//< **The expectation set alone does not convey it** — even with `';'` coming first, it cannot be
//< read as "it is `;` rather than `,`", so a Note stating the rule is carried alongside ("9.5
//< Every item in a declaration block ends with `;`" in `../../../docs/DESIGN.md`).
// EXPECT: expected ';', '(', or '='
// EXPECT: an enum value stands on its own, as a struct field does
enum Shade {
  light,
  mid,
}

fn main(): I32 {
  return 0 if Shade.light == Shade.light else 1;
}

//< Only `U8` accepts `\{v:c\}`
//<
//< **With the functions split, a type with nowhere to apply it stops at the interpolation with
//< "there is no such method"** (as hex is split off into `fmt_hex`). One shared function could
//< only ignore the argument, and that passes in silence.
// ==========================================
// EXPECT: type 'I32' does not take 'c'
// That the `U8` side is not caught up in it is pinned down at the same time.
// EXPECT-NOT: type 'U8' does not take
// ==========================================
import "std/io" as io
import "std/strfmt"

pub fn take()
  b: U8 = 65U8
  n: I32 = 7
  io.out().s("ok=\{b:c\}\n")
  io.out().s("int=\{n:c\}\n")

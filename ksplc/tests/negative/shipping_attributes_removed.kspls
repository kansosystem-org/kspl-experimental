//< `#publish_body` and `#size` are not accepted
//<
//< A library built from KSPL is shared with KSPL code as source, or reached through its C
//< interface (`--library=`, which writes it), so no body or opaque size crosses a binary.
// EXPECT: unknown attribute '#publish_body'
// EXPECT: unknown attribute '#size'
#publish_body
pub fn pair_sum<|T|>(a: T, b: T): T
  return a + b

#size(8)
pub struct Point
  pub x: I32
  pub y: I32

fn main(): I32
  return pair_sum<|I32|>(Point::{ .x = 1, .y = 2 }.x, 0)

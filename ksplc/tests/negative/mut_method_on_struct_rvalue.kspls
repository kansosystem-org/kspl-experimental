//< A `Self$@` method cannot be called directly on a call's result
//<
//< It rewrites its own memory, and a receiver's address is taken implicitly. Out of scope: `Self@`
//< methods, which write no memory of their own (with `Self` a `U8$[]` too, as `make test-place`
//< holds), and a chain returning a pointer (`b.s("x").c('!')`), which is handed over as it stands.
// EXPECT: cannot call a method that writes its receiver
// EXPECT: Bind it first
priv struct Point
  n: I32

impl Point
  fn new(n: I32): Point
    return Point::{ .n = n }
  fn set_n(r: Self$@, v: I32)
    r.n = v

fn main(): I32
  Point.new(1).set_n(5)
  return 0

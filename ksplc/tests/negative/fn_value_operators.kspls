//< A function value takes `==` and `!=` alone, and two names give it no type
//<
//< A function's name takes its type from where it is written: compared with a typed value, it
//< takes that value's type in either order, but two names have none between them. An address has
//< no order or arithmetic that means anything. Let through, these reached C as arithmetic on an
//< address, and the LLVM IR compared an `i32` with a function's address.
//< Caution: Keep the passing side: a name compared with a typed function value, on either side.
// EXPECT: cannot compare 'twice' with 'thrice': each takes its type from the other side, and neither gives one
// EXPECT: bind one side to a variable first ('f: = …' takes its function type)
// EXPECT: cannot compare 'same<|I32|>' with 'Box<|I32|>.keep'
// EXPECT: operator '<' does not apply to a function: functions are compared only with '==' and '!='
// EXPECT: operator '+' does not apply to a function
// EXPECT: operator '-' does not apply to a function
// EXPECT: operator '+=' does not apply to a function
// EXPECT: function 'twice' cannot be used as 'I32': its own type is 'fn(I32):I32'
// EXPECT: function 'two' cannot be used as 'fn(I32):I32': its own type is 'fn(I32,I32):I32'
// EXPECT-NOT: global variable reference
// EXPECT-NOT: undeclared identifier
priv typedef Op = fn(x: I32): I32

priv fn twice(x: I32): I32
    return x * 2

priv fn thrice(x: I32): I32
    return x * 3

priv fn two(x: I32, y: I32): I32
    return x * y

priv fn same<|T|>(x: T): T
    return x

priv struct Box<|T|>
    v: T

impl<|T|> Box<|T|>
    fn keep(x: T): T
        return x

priv fn both_names(): Bool
    return twice == thrice

priv fn both_written(): Bool
    return same<|I32|> != Box<|I32|>.keep

priv fn ordered(f: Op): Bool
    return twice < f

priv fn arith(): I32
    return 1 + twice

priv fn negated(f: Op): Bool
    return -f == f

priv fn stepped(f: Op)
    $g: = f
    g += twice

priv fn not_a_function(): Bool
    return twice == 1

priv fn wrong_shape(f: Op): Bool
    return two != f

fn main(): I32
    // The passing side.
    f: Op = twice
    ok: = twice == f && f != thrice && same<|I32|> != f && Box<|I32|>.keep != f
    return 0 if ok else 1

//< A call on a **pointer to** a function pointer
//<
//< Peeled, it can be called, so that is advised. is_fn_ptr must not look at the canonical string's
//< leading `fn(` alone: since `ptr(X)` = `str(X) + "@"`, `fn(x: I32): I32@` looks like one too and,
//< as an indirect call, yields an invalid Void node (and a different diagnostic far away).
// EXPECT: Dereference it first
fn twice(x: I32): I32
  return x * 2

fn main()
  f: fn(x: I32): I32 = twice
  g: = f@
  _v: = g(3)

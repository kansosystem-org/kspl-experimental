//< Directives, FFI, the target machine and `main`
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case c_keyword_name_clash
//< Rejects a C reserved word and its renamed form standing in the same scope
//<
//< **Look at a struct's fields too.** A field does not go onto the symbol table's scope,
//< so the check on locals (declare_symbol) does not reach. The check is placed in sema. Placed in
//< genc, the same source is refused on C and passes on LLVM.
// EXPECT: 'goto' is a C keyword
// EXPECT: 'do' is a C keyword
// EXPECT: 'long' is a C keyword
// EXPECT: 'union' is a C keyword
// EXPECT-NOT: 'while' is a C keyword

priv struct Fields_forward
  long: I32
  long_kw: I32 // the dodge's target is taken

priv struct Fields_backward
  union_kw: I32 // the dodge's target comes first
  union: I32

priv struct Fields_ok
  short: I32
  while_kw: I32 // `while` is a different name, so no clash

priv fn forward(): I32
  goto: I32 = 1
  goto_kw: I32 = 2 // the dodge's target is taken
  return goto + goto_kw

priv fn backward(): I32
  do_kw: I32 = 1 // the dodge's target comes first
  do: I32 = 2
  return do + do_kw

fn main(): I32
  while: I32 = forward() + backward() // no clash, so legitimate
  return while
// ==== case directive_argument_shape
//< The argument's shape differs per name
//<
//< `##error` takes a foldable expression, `##lint` takes `CODE = level`; the grammar accepts both.
//< Caution: **Sema refuses a shape not matching the name.** Let through, `##error(I0305 = off)`
//< loses the assertion and `##lint(sizeof(Sz) == 8)` sets no level, both in silence.
// EXPECT: error: '##error' takes a compile-time expression, not 'CODE = level'
// EXPECT: error: '##lint' takes 'CODE = level' settings, not an expression
// EXPECT: error: '##warning(cond)' or '##warning(cond, "message")'
##error(I0305 = off)
##lint(sizeof(Sz) == 8)
##warning(1 == 2, "a", "b")

fn main(): I32
  return 0
// ==== case directive_condition_not_constant
//< A `##error` whose condition does not fold says so, and does not print the file's own message
//<
//< Taken as false, the condition fired the message, which claimed a failure that did not happen.
// EXPECT: 'count' is not a compile-time constant
// EXPECT-NOT: error: the configuration is wrong
$count: I32 = 1
##error(count == 1, "the configuration is wrong")

fn main()
    return
// ==== case directive_error
##error(sizeof(Sz) == 2, "Sz must be 2 bytes")
// `##error(cond, msg)` stops the compilation where cond is false. It takes the same road as the
// other diagnostics, so a position is attached and it enters the trailing count too.
// The directive is placed on line 1. What the shebang rereading touches (has_shebang in
// ksplc/parse/source_fix.kspls) is only a line 1 opening with `#!`, so this line, opening with
// `##`, passes through.
// EXPECT: error: Sz must be 2 bytes
import "std/io"

fn main(): I32
  io.out().s("unreachable\n")
  return 0
// ==== case directive_message_escape
//< `##error`'s message is the string it spells, its escapes read as in any other string
//<
//< Cut at its quotes by hand, `\"` kept its backslash in the printed message.
// EXPECT: error: needs a "fast" build
// EXPECT-NOT: error: needs a \"fast\"
##error(1 == 0, "needs a \"fast\" build")

fn main()
    return
// ==== case directive_unknown_name
//< Sema, not the grammar, knows the directive names
//<
//< `directive_shape` in `ksplc/sema/decl/attrs.kspls`. **The grammar takes names openly**, so an
//< unknown name passing in silence is "written but nothing happens" (docs/DESIGN.md Principle 5).
//< An attribute name gets its destination, since `##` and `#` differ by one character.
// EXPECT: error: unknown directive '##foo'
// EXPECT: known: ##error ##warning ##lint
// EXPECT: error: unknown directive '##cfg'
// EXPECT: 'cfg' is an attribute — write '#cfg'
##foo(1 == 1)
##cfg(never)

fn main(): I32
  return 0
// ==== case ffi_struct_by_value_llvm
//< On the LLVM backend, even a plain POD struct cannot cross the C boundary by value
//<
//< genllvm does not implement the per-target ABI classification C uses for structs by value, so it
//< passes aggregates by sret/byval for internal calls alone (ksplc/docs/DESIGN.md "Passing an
//< aggregate is an explicit internal ABI"). The C backend accepts this program, hence `--to=llvm`.
// ARGS: --to=llvm
// EXPECT: structs cannot be passed or returned by value across C-FFI boundaries on the LLVM backend
// EXPECT-NOT: 'Wrapper'

pub struct Pod
  pub a: I32
  pub b: I32

// A struct merely being **inside** a struct is not an aggregate crossing by value, so it passes
// (no diagnostic comes out on this line).
pub struct Wrapper
  pub inner: Pod

#export
pub fn takes_pod_by_value(p: Pod): I32
  return p.a + p.b

#export
pub fn returns_pod_by_value(): Pod
  return Pod::{ .a = 1, .b = 2 }

#export
pub fn takes_pod_by_ptr(p: Pod$@): I32
  return p.a + p.b

fn main() {}
// ==== case ffi_unsafe_types
//< A type whose layout is Kanso's own cannot appear in an `#export`'s signature
//<
//< Wrapping it in a struct is the same, and the check walks inside (with the outermost layer alone
//< it could be dodged by merely wrapping; docs/DESIGN.md "The FFI boundary check looks inside the
//< type").
// EXPECT: interface values cannot cross C-FFI boundaries
// EXPECT: enums with payloads cannot cross C-FFI boundaries
// EXPECT: slices (T[]) cannot cross C-FFI boundaries
// EXPECT-NOT: 'Pod'

pub trait S
  fn a(r: Self$@): I32

pub struct Q
  pub n: I32

impl Q: S
  pub fn a(r: Self$@): I32
    return r.n

pub enum Tagged
  none
  some(v: I32)

pub struct Wrapped
  pub items: U8[]

// A plain POD and a plain integer enum pass (no diagnostic comes out on this line).
pub struct Pod
  pub a: I32
  pub p: Void$@

pub enum Plain
  a
  b

#export
pub fn takes_trait(s: S): I32
  return s.a()

#export
pub fn takes_tagged(t: Tagged): I32
  switch t case .some(v)
    return v
  default
    return 0

#export
pub fn takes_wrapped(w: Wrapped): Sz
  return w.items.len

#export
pub fn takes_pod(p: Pod, e: Plain): I32
  return p.a + I32::e

fn main() {}
// ==== case frame_pointer_through_local
//< A slice or an interface value pointing into the frame is refused through a local too
//<
//< **Let it through and it reads a dead frame**: `t: Shape = s; return t` printed 0 on C and
//< garbage on LLVM, and `s: = I32[]::a; return s` returned a view of a frame that is gone. The
//< mark follows a local set by its declaration or by `x = …`, from another marked local too
//< (`note_frame_pointer` in `ksplc/sema/body/stmt_escape.kspls`).
// EXPECT: cannot return 'cast': it was set from a slice or an interface value built from local storage
// EXPECT: cannot return 'lit': it was set from a slice or an interface value built from local storage
// EXPECT: cannot return 'shape': it was set from a slice or an interface value built from local storage
// EXPECT: cannot return 'second': it was set from a slice or an interface value built from local storage
// EXPECT: cannot return 'later': it was set from a slice or an interface value built from local storage
// EXPECT: cannot throw 'held': it was set from a slice or an interface value built from local storage
// EXPECT: cannot return 'boxed': it was set from a slice or an interface value built from local storage
// EXPECT-NOT: cannot return 'fine'
trait Shape
  fn area(r: Self): I32

struct Sq
  n: I32

impl Sq: Shape
  fn area(r: Self): I32
    return r.n * r.n

struct View
  s: I32[]

enum Bad
  view(v: I32[])

$keep: I32[2] = ::{ 3, 4 }

fn from_cast(): I32[]
  a: I32[2] = ::{ 1, 2 }
  cast: = I32[]::a
  return cast

fn from_literal(): I32[]
  lit: = I32[]::{ 1, 2 }
  return lit

fn from_upcast(): Shape
  $sq: = Sq::{ .n = 7 }
  shape: Shape = sq
  return shape

fn through_two(): I32[]
  a: I32[2] = ::{ 1, 2 }
  first: = I32[]::a
  second: = first
  return second

fn by_assignment(): I32[]
  a: I32[2] = ::{ 1, 2 }
  $later: I32[] = I32[]::keep
  later = I32[]::a
  return later

fn thrown(): I32!Bad
  a: I32[2] = ::{ 1, 2 }
  held: = I32[]::a
  throw Bad.view(held)

fn in_a_field(): View
  a: I32[2] = ::{ 1, 2 }
  boxed: = I32[]::a
  return View::{ .s = boxed }

fn fine(): I32[]
  fine: = I32[]::keep
  return fine

fn main()
  _a: = from_cast()
  _b: = from_literal()
  _c: = from_upcast()
  _d: = through_two()
  _e: = by_assignment()
  _f: = thrown() catch 0
  _g: = in_a_field()
  _h: = fine()
// ==== case inline_c_llvm_backend
//< `__kspl_inline_c` is refused on the LLVM backend
//<
//< LLVM IR cannot hold C source, so genllvm stops with an ICE if one reaches it. Only this sema
//< check keeps a program from getting there.
// ARGS: --to=llvm
// EXPECT: __kspl_inline_c is only supported on the C target
priv fn f()
  __kspl_inline_c("(void)0;")

fn main(): I32
  f()
  return 0
// ==== case lint_promote_to_error
//< `##lint(CODE = error)` promotes advice to an error
//<
//< The promotion includes "running that check", so it is refused even in an ordinary build that is
//< not in lint mode (without running it, promoting changes nothing = it can be written yet does not
//< take effect; ksplc/docs/DESIGN.md "lint is configured per diagnostic code, not by a group
//< name").
// EXPECT: error: [I0305]
##lint(I0305 = error)

priv fn f(): Void
  return

fn main()
  f()
// ==== case lint_unknown_code
//< A `##lint(...)`'s code is checked against the canonical source, ksplc/base/lint_codes.kspls
//<
//< Unmatched, a misspelling such as `##lint(I004 = off)` is silently void, so a suppression
//< believed in place is not. An unknown code must not pass with zero diagnostics
//< (ksplc/docs/DESIGN.md "lint is configured per diagnostic code, not by a group name").
// EXPECT: unknown diagnostic code 'I004'
// EXPECT: unknown lint level 'maybe'
##lint(I004 = off)
##lint(I0305 = maybe)

fn main() {}
// ==== case machine_32bit_error_directive
//< `##error` measures `Sz` on the machine `--machine` names, not on the one ksplc runs on
//<
//< A file that needs an 8-byte `Sz` says so with `##error`, and on a 32-bit machine it must stop
//< there. Measured at the host's 8 bytes, it would pass and build wrong sizes for the chip.
// ARGS: --machine=thumbv7m-none-eabi --freestanding
// EXPECT: this file needs an 8-byte Sz
##error(sizeof(Sz) == 8, "this file needs an 8-byte Sz")

fn main()
    return
// ==== case machine_32bit_slice_cast
//< A slice cast is judged by the element sizes of the machine `--machine` names
//<
//< On a 32-bit machine `Sz` is 4 bytes and `I64` 8, so viewing two `Sz` as `I64[]` keeps the
//< length 2 over 8 bytes and reads past the end. Measured at the host's widths, it would pass.
// ARGS: --machine=wasm32-unknown-unknown --freestanding
// EXPECT: the element size changes (4 -> 8 bytes)
struct Holder
    words: Sz[2]
    tail: I32

#export
fn second(): I64
    h: Holder = ::{ .words = ::{ 1, 2 }, .tail = 9 }
    wide: = I64[]::(h.words)
    return wide[1]

fn main()
    return
// ==== case main_priv
//< A `priv` main is refused
//<
//< The start-up code in `std/lang` calls main from another file, and a `priv` function is `static`
//< in the generated C. Let it through and the C compiler's "call to undeclared function" reaches
//< the user (Principle 2).
// EXPECT: main() cannot be 'priv'
priv fn main()
  return
// ==== case main_return_type_unusable
//< `main` may return only types that can become an exit code
//<
//< Returning nothing / an integer / a Result holding one of those as its value.
//< Caution: Make a Bool or a U8[] writable and
//< the return value is discarded in silence.
// EXPECT: main() must return nothing, an integer
// EXPECT: but returns 'Bool'
import "std/io"

fn main(): Bool
  io.out().s("this exit status goes nowhere\n")
  return true
// ==== case naked_fn_non_asm_statement
//< A `#naked` function holds assembly statements only
//<
//< **Let it through and clang refuses the C** ("non-ASM statement in naked function"), while gcc
//< builds code that writes to a stack frame the function never set up.
// EXPECT: a '#naked' function holds only '__kspl_asm_volatile(...)' statements
#naked
fn bare(): I32
  x: = 1
  return x

fn main(): I32
  return bare()

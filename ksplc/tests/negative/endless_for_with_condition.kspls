//< A `for` with a condition can end, even where the condition is always true
//<
//< Only the absence of a condition makes a loop endless; a constant `true` is [W0205]'s to remove,
//< and the loop is read as written.
// EXPECT: function 'below' is expected to return 'I32', but control may reach the end
fn below(n: I32): I32
  $i: I32 = 0
  for i < 100
    if i > n
      return i
    i += 1

fn main(): I32
  return below(3)

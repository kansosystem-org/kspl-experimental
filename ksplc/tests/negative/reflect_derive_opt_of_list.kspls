//< An optional field whose content is a container or an option cannot be walked
//<
//< The shape where the content's kind can point at itself is wanted, and that is `Field_kind`'s
//< payload (Field_info's in std/reflect).
// EXPECT: does not cover an option whose content is itself a list or an option

import "std/ds" { List }
import "std/reflect"

priv struct Wrapped
  xs: Option<|List<|I64|>|>

impl Wrapped: reflect.Reflectable {}

fn main(): I32
  return 0

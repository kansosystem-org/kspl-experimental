//< A `Self$@` method is rejected on an element of an immutable fixed-length array
//<
//< Caution: **Pin the element-receiver road (`a[i].m()`) down separately.** With a scalar (`x.m()`)
//< and a field (`s.f.m()`) rejected, the decision can still slip at the `[` step: reading
//< `strip_ptr(x) != x` as "x is a pointer" skips the check whole for a `U8 immut` element.
// EXPECT: cannot call a method that takes a writable receiver
// EXPECT: cannot call a method that takes a writable receiver

impl U8
  fn bump_byte(r: Self$@)
    r$ = 99

struct Holder
  buf: U8[4]

fn main(): I32
  arr: U8[4] = ::{ 1, 2, 3, 4 } // an immutable binding (no $)
  arr[0].bump_byte()
  h: Holder = ::{ .buf = ::{ 1, 2, 3, 4 } }
  h.buf[0].bump_byte()
  return I32::arr[0]

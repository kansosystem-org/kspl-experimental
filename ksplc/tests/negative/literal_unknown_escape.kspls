//< The characters allowed after a backslash inside a literal are fixed
//<
//< Let an unrecognised spelling through and `'\b'` (8 in C) quietly becomes `'b'`: something
//< written that does nothing (Principle 5). The place of refusal is the one
//< place is_known_escape in base/literal.kspls.
// ==========================================
// EXPECT: unknown escape '\b'
// EXPECT: unknown escape '\x'
// That the recognised spellings and raw strings are not caught up in it is pinned down at the
// same time.
// EXPECT-NOT: unknown escape '\n'
// EXPECT-NOT: unknown escape '\q'
// ==========================================
pub fn take(): I32
  ok: U8[] = "\n\r\t\0\'\"\\"
  raw: U8[] = """a\q b"""
  bad_char: U8 = '\b'
  bad_str: U8[] = "A\x41"
  return I32::(ok.len + raw.len + bad_str.len) + I32::bad_char

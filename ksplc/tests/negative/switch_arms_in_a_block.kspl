//< Braces around all of a `switch`'s arms, as C, Go, Swift and Rust write them
//<
//< **Each arm carries its own braces and the `switch` none**, so the `{` after the subject is
//< refused, and the Note names the shape to write.
// EXPECT: switch_arms_in_a_block.kspl:9:14: error: expected 'case'
// EXPECT: Note: a 'switch' opens no block of its own; each 'case' and 'default' opens one.
fn main(): I32 {
    e: = 1;
    switch e {
    case 1 {
        return 1;
    } default {
        return 2;
    }
    }
}

//< A mark and a name have to be next to each other
//<
//< **Allow them apart and a name on the line after a line holding only a `#` joins on** — reading
//< past whitespace skips newlines and line comments too, so characters the reader reads as an
//< expression become an attribute. A mark and a name are one token (`Attribute_prefix`).
// EXPECT: error: expected an attribute prefix
import "std/io";

#
cfg(never)
fn dead(): I32 {
  return 1;
}

fn main(): I32 {
  io.out().s("unreachable\n");
  return 0;
}

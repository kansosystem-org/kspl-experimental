//< A `switch` case takes no condition and no range of values
//< Each case below is compiled alone, as the file its head names.
// ==== case switch_case_condition_absent
//< A case takes no condition (`case .tap(x) if x > 0`)
//< **An `if` at the top of the case writes it**, so a condition would be a second way to write
//< one thing ("Appendix A: Features not carried, and what to write instead" in
//< `../../../docs/SPEC-programming-language.md`). The note names that `if`, not the ternary.
// EXPECT: error
// EXPECT: a case takes no condition
// EXPECT-NOT: needs all three parts
enum Gesture
  tap(x: I32)
  quit

fn on_gesture(g: Gesture): I32
  switch g
  case .tap(x) if x > 0
    return x
  case .tap, .quit
    return 0

fn main(): I32
  return on_gesture(.quit)
// ==== case switch_case_range_absent
//< A case takes no range of values (`case 'a' ..= 'z'`)
//< **Listing the values, or two comparisons, writes it.** The note names those, not `Range`,
//< which makes a sequence to loop over.
// EXPECT: error
// EXPECT: a case takes no range of values
// EXPECT-NOT: has no range syntax
fn kind(c: U8): I32
  switch c
  case 'a' ..= 'z'
    return 1
  default
    return 0

fn main(): I32
  return kind('q')

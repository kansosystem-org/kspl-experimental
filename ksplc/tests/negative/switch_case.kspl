//< A `switch` case takes no condition and no range of values
//< Each case below is compiled alone, as the file its head names.
// ==== case switch_case_condition_absent
//< A case takes no condition (`case .tap(x) if x > 0`)
//< **An `if` at the top of the case writes it**, so a condition would be a second way to write
//< one thing ("Appendix A: Features not carried, and what to write instead" in
//< `../../../docs/SPEC-programming-language.md`). The note names that `if`, not the ternary.
// EXPECT: error
// EXPECT: a case takes no condition
// EXPECT-NOT: needs all three parts
enum Gesture
  tap(x: I32)
  quit

fn on_gesture(g: Gesture): I32
  switch g
  case .tap(x) if x > 0
    return x
  case .tap, .quit
    return 0

fn main(): I32
  return on_gesture(.quit)
// ==== case switch_case_range_absent
//< A case takes no range of values (`case 'a' ..= 'z'`)
//< **Listing the values, or two comparisons, writes it.** The note names those, not `Range`,
//< which makes a sequence to loop over.
// EXPECT: error
// EXPECT: a case takes no range of values
// EXPECT-NOT: has no range syntax
fn kind(c: U8): I32
  switch c
  case 'a' ..= 'z'
    return 1
  default
    return 0

fn main(): I32
  return kind('q')
// ==== case switch_case_joined_payload_short
//< A variant joined by `,` needs a field for each name the case binds, of the same type
//< **Fewer names bind the leading fields**, so a longer payload passes; a shorter one, or one
//< whose leading field has another type, would leave the name with nothing to read.
// EXPECT: variant 'tap' carries 1 payload field(s), but this 'case' binds 2 name(s)
// EXPECT: variant 'key' holds 'U8' in field 1, but 'a' is bound as 'I32'
// EXPECT-NOT: smart capture
enum Ev
  click(x: I32, y: I32)
  tap(x: I32)
  key(c: U8, d: I32)
  quit

fn both(e: Ev): I32
  switch e
  case .click(a, b), .tap
    return a + b
  default
    return 0

fn lead(e: Ev): I32
  switch e
  case .click(a), .key
    return a
  default
    return 0

fn main(): I32
  return both(.quit) + lead(.quit)

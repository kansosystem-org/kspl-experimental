//< A variadic function's name bound with no type annotation is refused: no function type holds it
//<
//< A declaration with no type takes the function type of the function a name names (`f: = big`),
//< and a variadic one has none to give, since a function type holds no `...`. Let through, the
//< binding would carry the mark of a name with no type, which no C type spells.
//< Caution: Keep the passing side: a non-variadic name, an anonymous function and a call's result
//< are each a binding's type.
// EXPECT: cannot infer the type of 'all' from function 'printf': it is variadic, and a function type holds no '...'
// EXPECT-NOT: _anon_fn
import "std/io"

extern "C"
  fn printf(fmt: U8@, ...): I32

priv fn big(x: I32): Bool
  return x > 5

fn main(): I32
  // The stopping side: a variadic function has no function type.
  all: = printf
  // The passing side: each takes the function type of what it names.
  ptr: = big
  anon: = fn(x: I32): Bool
    return x > 1
  called: = big(7)
  io.out().s("\{ptr(7)\}\{anon(2)\}\{called\}\n")
  return 0

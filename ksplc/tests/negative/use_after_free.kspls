//< Use after free: a local that has been .free()d is passed as a value
//<
//< A use of the whole thing rather than a field access.
// EXPECT: may already be freed here
struct Foo
  priv other: I32
impl Foo
  priv fn free($r: Self$@)
    r.other = 0
fn takes(x: Foo) {}
fn main()
  $f: = Foo::{ .other = 2 }
  f.free()
  takes(f)

// The declaration that has the release tracked (Owned in std/lang.kspls).
impl Foo: Owned {}

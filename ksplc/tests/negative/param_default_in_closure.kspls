//< A closure is never called by name, so a default written on it would never take effect
//<
//< Written and silently ignored is the shape Principle 5 refuses.
// EXPECT: a closure parameter or capture cannot have a default value

fn main(): I32
  _f: = fn(a: I32, b: I32 = 2; ): I32
    return a + b
  return 0

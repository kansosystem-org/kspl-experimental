//< A `priv` type in a `pub enum`'s payload is rejected as less visible than the variant
//<
//< Allowed, code that cannot name that type could still bind and read it with
//< `switch v case .some(x) { x.v }`: the leak of a struct's `pub` field, under the same check
//< (docs/DESIGN.md §6.2). A payload has no visibility of its own, so the enum's side settles it.
// EXPECT: payload type 'Hidden' is less visible than the variant exposing it

priv struct Hidden
  v: I32

pub enum E
  none
  some(x: Hidden)

fn main()
  _e: = E.some(Hidden::{ .v = 1 })

//< `if name: = expression` unwraps only `Option`
//<
//< **Not on a user's enum:** `Option` is fixed at two variants, a user's enum can grow, and the day
//< it grows **a branch passes in silence** (7.1 of docs/SPEC-language.md). The wording names the
//< characters the user wrote (`synthesized_option_spelling` in `ksplc/base/ast_ext.kspls`).
// EXPECT: 'if <name>: = <expr>' binds an 'Option'
// EXPECT-NOT: .some
enum Light
  red
  yellow
  green

fn pick(): Light
  return Light.red

fn main(): I32
  if v: = pick()
    return I32::v
  return 0

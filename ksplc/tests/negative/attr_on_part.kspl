//< An attribute is written on the declaration itself
//<
//< Not on its **parts** (a parameter, a field, an enumerator): `#cfg` on one would change a call's
//< argument count, a literal or a `switch`'s exhaustiveness, and **every user splits by `#cfg`**.
//< What a part's position can hold is demanded; its head is **the side that stopped the parse**.
// EXPECT: expected ')', '$', an identifier
import "std/io";

pub fn takes(#cfg(never_defined) a: I32, b: I32): I32 {
    return a + b;
}

fn main(): I32 {
    io.out().s("\{takes(1, 2)\}\n");
    return 0;
}

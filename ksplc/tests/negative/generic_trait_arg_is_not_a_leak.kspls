//< A type variable that monomorphisation merely substitutes is no visibility leak
//<
//< The `Output` of `std.lang.Index<|Idx, Output|>` is replaced by the implementing type's own
//< type; `Output`, not a concrete type, is what was written, so no visibility diagnostic stands.
//< The program fails on purpose (an undefined symbol), and EXPECT-NOT finds no visibility one.
// EXPECT: undefined path or identifier 'no_such_fn'
// EXPECT-NOT: is less visible than the

pub struct Row
  pub cells: I32[4]

impl Row: _operator.Index<|Sz, I32|>
  pub fn get(r: Self$@, index: Sz): I32
    return r.cells[index]

fn main()
  row: Row = ::{ .cells = ::{ 1, 2, 3, 4 } }
  _x: = row[0]
  no_such_fn()

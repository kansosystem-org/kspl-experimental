//< An error inside a generic enum's instance is reported when its first use is `E<|T|>.v`
//<
//< That shape instantiates the enum on the way to the variant, and the instance is cached. With
//< the instantiation's errors suppressed there, a later use finds the cached instance and the
//< error is never reported: the program goes on to the C compiler with a broken payload type.
// EXPECT: too few type arguments for generic 'Pair': it declares 2, but 1 given
pub struct Pair<|A, B|>
  a: A
  b: B

enum E<|T|>
  v
  w(x: Pair<|T|>)

fn main()
  e: = E<|I32|>.v
  switch e case .v {} default {}

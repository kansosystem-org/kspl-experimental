//< Errors: `catch`, results and the error cap
//< Each case below is compiled alone, as the file its head names.
// ==== case catch_block_without_fallback
//< A `catch` block whose value can be read must provide one
//< Falling off its end silently leaves the binding at the zero value. `catch alt()` hands the value
//< over (Principle 8 in `../../../docs/DESIGN-principles.md`). `catch { }` reads as "ignore the
//< failure" and is the same hole. The four shapes handing the value to nobody must pass (`EXPECT-NOT`).
// EXPECT: 'catch' is expected to produce 'U8[]'
// EXPECT-NOT: Slice_U8
// EXPECT: without 'fallback'
// EXPECT-NOT: produce 'Sz'
import "std/io"

priv fn counted(): Sz!io.Io_error
  body: = io.read_file("/nowhere/at/all", null)!
  return body.len

fn main(): I32
  worked: = io.read_file("/nowhere/at/all", null) catch
    io.out().s("it failed\n")
  quiet: = io.read_file("/nowhere/at/all", null) catch {}
  _unread: = counted() catch {}
  counted() catch {}
  // These two are read. They stand because the handler never finishes. One leaves by a call that
  // declares `#noreturn`, the other by a loop with no condition and no `break`.
  from_panic: = counted() catch
    panic("this fixture is never run")
  from_loop: = counted() catch
    for {}
  io.out().s("\{worked.len\}/\{quiet.len\}/\{from_panic\}/\{from_loop\}\n")
  return 0
// ==== case catch_on_non_result
//< A `catch` cannot be written on an expression that is neither a Result nor an Option
//< Both operators reject a plain value before code generation; valid Results still pass.
// EXPECT: 'catch' cannot be written on type 'I32'. Write it only on a result ('T!E') or an optional ('T?')
// EXPECT: '!' operator can only be applied to a Result type
// EXPECT-NOT: is_err
import "std/ds" { List }
import "std/io"
import "std/mem" { Arena }

priv enum Probe_error
  nope

priv fn plain(x: I32): I32
  return x + 1

priv fn propagate_plain(): I32!Probe_error
  return plain(1)!

priv fn may_fail(x: I32): I32!Probe_error
  if x < 0
    throw Probe_error.nope
  return x + 1

fn main(): I32
  ar: = Arena(4096)
  $xs: = List<|I32|>(ar)
  xs.push(7)
  // The stopping side ①: a function call that does not return a Result.
  bad_call: = plain(1) catch -1
  // The stopping side ②: an index that returns a value.
  bad_index: = xs[0] catch -1
  // The passing side ①: a fallback expression on an expression returning a Result.
  ok_expr: = may_fail(1) catch -1
  // The passing side ②: a fallback statement on an expression returning a Result.
  ok_block: = may_fail(-1) catch e
    io.out().s("\{e\}\n")
    fallback -2
  // The passing side ③: a Result by way of a generic instantiation, read through an index
  // (`List<|I32!Probe_error|>`'s element is the Result).
  $rs: = List<|I32!Probe_error|>(ar)
  rs.push(may_fail(-1))
  ok_elem: = rs[0] catch -3
  io.out().s("\{bad_call\}\{bad_index\}\{ok_expr\}\{ok_block\}\{ok_elem\}\n")
  ar.free()
  return 0
// ==== case option_catch_with_value
//< A `catch` on an Option takes no substitute value, and the note names `unwrap_or`
//< A `Map`'s miss is none, not a failure, so `m[k] catch v` is the habit this catches.
//< `unwrap_or` already gives a value in `.none`'s place; a second spelling of it is refused.
// EXPECT: 'catch' with a value cannot be written on an optional ('I32?'). Give the value with 'unwrap_or' instead
// EXPECT: Note: write 'opt.unwrap_or(v)' to use 'v' where 'opt' is '.none'.
import "std/ds" { Map }
import "std/mem" { Arena }

fn main(): I32
  ar: = Arena(4096)
  $m: = Map<|I32, I32|>(ar)
  m[1] = 9
  got: = m[2] catch -3
  ar.free()
  return got
// ==== case option_catch_block_reaches_end
//< A `catch` block on an Option must leave, wherever its value goes
//< Its end reached, the binding would hold nothing. So the value is always bound after the
//< `catch`, a statement's included. A `fallback` would be `unwrap_or`'s second spelling.
// EXPECT: the 'catch' block on an optional ('I32?') can reach its end. End it with 'return', 'throw', 'break', 'continue' or a call that does not return, such as 'panic'
// EXPECT: 'fallback' cannot be written in a 'catch' block on an optional. Leave the block with 'return', 'throw', 'break' or 'continue'
// EXPECT: an optional ('I32?') has no error value, so its 'catch' takes no name. Remove 'e' and write 'catch { … }'
// EXPECT-NOT: must produce a value
priv fn find(k: I32): I32?
  return .some(k) if k > 0 else .none

priv fn reaches(): I32
  v: = find(1) catch
    find(2) catch { return 0 }
  return v

priv fn as_statement()
  find(3) catch {}

priv fn with_fallback(): I32
  v: = find(4) catch
    fallback 5
  return v

priv fn with_name(): I32
  v: = find(6) catch e
    return 0
  return v

fn main(): I32
  as_statement()
  // These stand: each block leaves, by a call that declares `#noreturn` or by a loop.
  a: = find(7) catch
    panic("this fixture is never run")
  b: = find(8) catch
    for {}
  return reaches() + with_fallback() + with_name() + a + b
// ==== case catch_substitute_wrong_type
//< A `catch`'s substitute has the success type, so a float does not stand in for an `I32`
//< **Let it through and the backends part**: C keeps 2 from `2.5`, LLVM emits `i32 2.5`, which
//< does not build. A float literal takes no integer type anywhere (`x: I32 = 2.5`, an argument).
// EXPECT: implicit conversion between 'F64' and 'I32' is forbidden
// EXPECT-NOT: error: expected
enum E
  bad

fn f(i: I32): I32!E
  if i < 0
    throw E.bad
  return i

fn take(x: I32): I32
  return x

fn main(): I32
  v: = f(-1) catch 2.5
  w: = f(-1) catch e
    fallback 4.5
  x: I32 = 2.5
  return v + w + x + take(3.5)
// ==== case error_cap_counts_itself
//< Compilation stops at 50 errors, the cap's own line being the 50th
//< **Counted apart from the 50, the summary says 51** while the specification promises 50
//< ("Compilation stops at 50 errors" in ksplc/docs/SPEC-tools.md).
// EXPECT: error: expected 'I32', but got 'Bool'
// EXPECT: Too many errors (>= 50). Further errors are suppressed.
// EXPECT: Finished with 50 error(s)
// EXPECT-NOT: Finished with 51
fn main()
  _v00: I32 = true
  _v01: I32 = true
  _v02: I32 = true
  _v03: I32 = true
  _v04: I32 = true
  _v05: I32 = true
  _v06: I32 = true
  _v07: I32 = true
  _v08: I32 = true
  _v09: I32 = true
  _v10: I32 = true
  _v11: I32 = true
  _v12: I32 = true
  _v13: I32 = true
  _v14: I32 = true
  _v15: I32 = true
  _v16: I32 = true
  _v17: I32 = true
  _v18: I32 = true
  _v19: I32 = true
  _v20: I32 = true
  _v21: I32 = true
  _v22: I32 = true
  _v23: I32 = true
  _v24: I32 = true
  _v25: I32 = true
  _v26: I32 = true
  _v27: I32 = true
  _v28: I32 = true
  _v29: I32 = true
  _v30: I32 = true
  _v31: I32 = true
  _v32: I32 = true
  _v33: I32 = true
  _v34: I32 = true
  _v35: I32 = true
  _v36: I32 = true
  _v37: I32 = true
  _v38: I32 = true
  _v39: I32 = true
  _v40: I32 = true
  _v41: I32 = true
  _v42: I32 = true
  _v43: I32 = true
  _v44: I32 = true
  _v45: I32 = true
  _v46: I32 = true
  _v47: I32 = true
  _v48: I32 = true
  _v49: I32 = true
  _v50: I32 = true
  _v51: I32 = true
  _v52: I32 = true
  _v53: I32 = true
  _v54: I32 = true
  _v55: I32 = true
  _v56: I32 = true
  _v57: I32 = true
  _v58: I32 = true
  _v59: I32 = true
// ==== case question_after_value
//< A `?` after a value is refused: it marks an optional type, and `f()!` passes a failure on
//< Rust's `f()?` is the likely slip (`forbidden_spelling_hint` in `../../parse/syntax_msg.kspl`).
// EXPECT: question_after_value.kspl:9:13: error: expected
// EXPECT: '?' marks an optional type ('I32?' is 'Option<|I32|>'). It does nothing after a value
fn h(): I32!I32
    return 1

fn g(): I32!I32
    a: = h()?
    return a
// ==== case result_error_type_optional
//< `T!E?` is refused: `?` would fold into the error type, which cannot be optional
//< The note names both readings the writer may have meant.
// EXPECT: result_error_type_optional.kspl:8:9: error: an error type cannot be optional
// EXPECT: Write an optional result as '(T!E)?'. If only the result's value can be absent, write 'T?!E'
enum E
    bad

fn g(): I32!E?
    return 1
// ==== case result_spelled_out
//< A result spelled out as a type is refused, naming `T!E`; the long form in an expression is not
// EXPECT: result_spelled_out.kspl:7:9: error: a result type is written 'T!E', not 'Result<|T, E|>'
// EXPECT: Finished with 1 error(s)
enum E
    bad

fn g(x: Result<|I32, E|>): I32
    return x catch 0

fn main()
    _v: = g(Result<|I32, E|>.ok(1))
// ==== case result_dropped
//< A result nobody takes apart is refused: a statement, and a binding whose name opens with `_`
//< `_` silences the unread-variable warning, so it would drop the failure with no word. `catch {}`
//< drops it on purpose, and a binding read later keeps it (the `EXPECT-NOT`).
// EXPECT: result_dropped.kspl:14:5: error: a result of type 'I32!result_dropped.E' is dropped
// EXPECT: result_dropped.kspl:15:5: error: a result of type 'I32!result_dropped.E' is dropped
// EXPECT: Finished with 2 error(s)
enum E
    bad

fn f(): I32!E
    return 1

fn main()
    f()
    _a: = f()
    f() catch {}
    b: = f()
    _n: = b catch 0
// ==== case result_type_spelled_whole
//< A Result type is spelled with its error type, `I32!I32`, never `I32!`
//< **The language has no `T!` shorthand**, so a diagnostic writing `I32!` names a type nobody
//< can write (`display_type_to` in `ksplc/sema/type/display.kspl`).
// EXPECT: function 'g' is expected to return 'I32!I32', but control may reach the end
// EXPECT-NOT: 'I32?'
fn g(): I32!I32
  _x: = 1

fn main()
  _v: = g() catch 0
// ==== case result_written_with_question
//< The old result spelling `I32?I32` names the `!` form: `I32?` is an optional, and whole
//< The failure lands on the name after it (`forbidden_spelling_hint` in
//< `../../parse/syntax_msg.kspl`).
// EXPECT: result_written_with_question.kspl:6:13: error: expected
// EXPECT: a result is written with '!' ('I32!Io_error'). 'I32?' is an optional type. No type name follows it.
fn h(): I32?I32
    return .some(1)
// ==== case sugar_spelled_out
//< A slice or an optional spelled out as a type is refused, naming the short form
//< The check refuses each place a type is written: a field, a `typedef`'s right side, a parameter,
//< a return type, a type argument, a grouped type and an `impl`'s target. Expressions count too.
//< A grouped type is a result or a function type. An expression whose head is `Option` keeps the
//< long form: no postfix can stand there. The types `T?` and `T[]` fold into pass (`kept`, `short`).
// EXPECT: sugar_spelled_out.kspl:29:9: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspl:30:10: error: a slice type is written 'T[]'
// EXPECT: sugar_spelled_out.kspl:32:17: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspl:34:17: error: a slice type is written 'T[]'
// EXPECT: sugar_spelled_out.kspl:36:20: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspl:36:36: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspl:41:18: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspl:44:17: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspl:47:19: error: a slice type is written 'T[]'
// EXPECT: sugar_spelled_out.kspl:54:11: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspl:61:20: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspl:63:19: error: a slice type is written 'T[]'
// EXPECT: Finished with 12 error(s)
// EXPECT-NOT: sugar_spelled_out.kspl:51:
// EXPECT-NOT: sugar_spelled_out.kspl:62:
// EXPECT-NOT: sugar_spelled_out.kspl:67:
import "std/ds" { List }
import "std/mem" { Arena }

enum Fault
  lost

struct Slot<|T|>
  held: Option<|T|>
  items: Slice<|T|>

typedef Maybe = Option<|I32|>

typedef Bytes = Slice<|$U8|>

priv fn doubled(x: Option<|I32|>): Option<|I32|>
  if v: = x
    return .some(v * 2)
  return .none

priv fn tried(): Option<|I32!Fault|>
  return .none

priv fn step(): Option<|fn(n: I32): I32|>
  return .none

priv fn total(xs: Slice<|I32|>): Sz
  return xs.len

impl<|T|> Slot<|T|>
  priv fn kept(r: Self): T?
    return r.held

impl<|T|> Option<|T|>
  priv fn spelled(r: Self): Bool
    return r.is_some()

priv fn empty(): Sz
  arena: = Arena(4096)
  defer arena.free()
  spelled: = List<|Option<|F32|>|>.create(arena)
  short: = List<|F32?|>.create(arena)
  sliced: = List<|Slice<|U8|>|>.create(arena)
  return spelled.len + short.len + sliced.len

fn main(): I32
  held: = Option<|I32|>.some(1)
  none: Maybe = .none
  if doubled(none).is_some() || tried().is_some() || step().is_some() || held.spelled()
    return 1
  return I32::empty()

//< A double free: .free() called twice on the same local
// EXPECT: may already be freed here
struct Foo
  priv other: I32
impl Foo
  priv fn free($r: Self$@)
    r.other = 0
fn main()
  $f: = Foo::{ .other = 2 }
  f.free()
  f.free()

// The declaration that has the release tracked (Owned in std/lang.kspls).
impl Foo: Owned {}

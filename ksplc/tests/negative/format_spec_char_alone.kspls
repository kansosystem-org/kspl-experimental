//< The `\{b:c\}` that prints a byte **as a character** takes no other setting
//<
//< **It does not overlap a number's decoration**: one character has nowhere for a width, a
//< zero-fill, a thousands separator or a decimal count to apply, so one alongside is refused.
//< Read and discarded, it would be "written yet nothing happens" (Principle 5; as for hex).
// ==========================================
// EXPECT: combines 'width' with 'c'
// EXPECT: combines 'x' with 'c'
// That a lone `c` is not caught up in it is pinned down at the same time.
// EXPECT-NOT: format spec ':c'
// ==========================================
import "std/io" as io
import "std/strfmt"

pub fn take()
  b: U8 = 65U8
  io.out().s("ok=\{b:c\}\n")
  io.out().s("wide=\{b:3c\}\n")
  io.out().s("hex=\{b:xc\}\n")

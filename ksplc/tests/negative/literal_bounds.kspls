//< An integer literal that does not fit its range is an error
//<
//< **An unsettled literal is not judged as I32** (a numeric operator gives its right side no
//< expected type, pass_right_id in sema/body/expr.kspls), nor by absolute value (`I8 = -128`):
//< either bars correct code. Suffixed literals take their own road; `U8::300` truncates and passes.

// EXPECT: literal '2147483648' is out of range for type 'I32'
// EXPECT: literal '4294967296' is out of range for type 'U32'
// EXPECT: literal '300' is out of range for type 'U8'
// EXPECT: literal '400U8' is out of range for type 'U8'
// EXPECT: literal '-1' is out of range for type 'U32'
// EXPECT: literal '-129' is out of range for type 'I8'

// EXPECT-NOT: '128'
// EXPECT-NOT: '-128'
// EXPECT-NOT: '2147483647'
// EXPECT-NOT: '255'
// EXPECT-NOT: '0x85ebca6b'
// EXPECT-NOT: '18446744073709551615'

// EXPECT-NOT: '500'
fn mix(h: U32): U32
  return (h ^ (h >> 16)) * 0x85ebca6b

fn main(): I32
  over_i32: I32 = 2147483648
  over_u32: U32 = 4294967296
  over_u8: U8 = 300
  suffixed_u8: U8 = 400U8
  cast_u8: U8 = U8::500
  neg_u32: U32 = -1
  neg_i8: I8 = -129
  min_i8: I8 = -128
  max_i32: I32 = 2147483647
  max_u8: U8 = 255
  max_u64: U64 = 18446744073709551615
  return (1
    if over_i32 == 0 && over_u32 == 0 && over_u8 == 0 && suffixed_u8 == 0 && cast_u8 == 0 &&
    neg_u32 == 0 && neg_i8 == 0 && min_i8 == 0 && max_i32 == 0 && max_u8 == 0 && max_u64 == 0 &&
    mix(3) == 0 else 0)

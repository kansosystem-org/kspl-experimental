//< The N of `#align(N)` being positive is not enough; it has to be a power of two
//<
//< **Let it through and it falls on the C compiler's side.** And where it was put on a variable,
//< the place it falls is a line of the generated C, so the `.kspl` that was written cannot be
//< reached (docs/DESIGN.md Principle 5).
// EXPECT: '#align(N)' needs N to be a positive constant power of two
// EXPECT-NOT: requested alignment
#align(3)
priv struct S
  v: I32

fn main(): I32
  s: S = ::{}
  return s.v

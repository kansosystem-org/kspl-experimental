//< No attribute (other than `#cfg`) can be written on an `extern` struct
//<
//< The generated C puts out only a forward declaration (`typedef struct X X;`), so neither an
//< attribute settling the layout nor a mark attached to the name has anywhere to reach. Ignored in
//< silence, whoever wrote it goes on believing it is in effect.
// EXPECT: attribute '#size' cannot be written on an 'extern' struct
// EXPECT: attribute '#align' cannot be written on an 'extern' struct
// EXPECT: attribute '#packed' cannot be written on an 'extern' struct
// EXPECT: attribute '#deprecated' cannot be written on an 'extern' struct
// EXPECT-NOT: [
extern "C"
  #size(8)
  struct Sized_c
  #align(8)
  struct Aligned_c
  #packed
  struct Packed_c
  #deprecated
  struct Old_c

fn main(): I32
  return 0

//< Type arguments after a type that declares none are refused where they are written
//<
//< They would bind nothing (Principle 5), before a member, in a type position and on a struct
//< literal alike, as after a function that declares none. Let through, the call ran on the plain
//< type and the type position named a type no declaration holds.
//< Caution: Keep the passing side: the same names without the arguments.
// EXPECT: type 'Plain' is not generic, so '<|I32|>' names nothing: drop it
// EXPECT-NOT: has no field or method
// EXPECT-NOT: expected 'Plain
priv struct Plain
    v: I32

impl Plain
    fn mk(v: I32): Self
        return Self::{ .v = v }

priv fn through_type(): I32
    return Plain<|I32|>.mk(3).v

priv fn in_type_position(p: Plain<|I32|>): I32
    return p.v

priv fn on_a_literal(): I32
    return Plain<|I32|>::{ .v = 4 }.v

fn main(): I32
    // The passing side.
    p: Plain = Plain.mk(1)
    return p.v

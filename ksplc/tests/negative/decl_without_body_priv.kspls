//< file has no body. It would become a shape noticed far away at link time, so it is stopped at the
//< declaration's position.
// EXPECT: must not be 'priv'
// EXPECT-NOT: [
priv fn hidden(n: I32): I32

fn main(): I32
  return hidden(1)

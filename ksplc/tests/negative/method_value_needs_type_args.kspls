//< A method is a value only through its type, with every type argument written
//<
//< Through its type it is the function taking the receiver first; the generic type's arguments go
//< on the type and the method's own after the method. Each refusal says what to write; let
//< through, the method reached C as a bare name no function has. Through a value (`p.read`) there
//< is no room for the receiver, and a trait's method is no one function.
//< Caution: Keep the passing side: `Box<|I32|>.keep` and `Plain.same<|I32|>` as values.
// EXPECT: generic method 'same' cannot be used as a value without its type arguments
// EXPECT: name one specialization, 'Plain.same<|…|>', with a type written for each of 'T'
// EXPECT: generic type 'Box' needs its type arguments before a method of it can be used as a value
// EXPECT: name one instance's, 'Box<|…|>.keep', with a type written for each of 'T'
// EXPECT: generic method 'pair' cannot be used as a value without its type arguments
// EXPECT: method 'read' cannot be used as a value through a value of type
// EXPECT: or name it through its type, 'Plain.read', and pass the receiver as its first argument
// EXPECT: trait method 'Shape.area' cannot be used as a value
// EXPECT: function 'Plain.twice' is not generic, so '<|I32|>' names nothing: drop it
// EXPECT: has no method named 'nosuch'
// EXPECT: method 'Box<|I32|>.keep' cannot be used as 'fn(I64):I64': its own type is 'fn(I32):I32'
// EXPECT-NOT: undeclared identifier
priv typedef Op = fn(x: I32): I32

priv trait Shape
    fn area(r: Self): I32

priv struct Plain
    v: I32

impl Plain
    fn read(r: Self@): I32
        return r.v
    fn twice(x: I32): I32
        return x * 2
    fn same<|T|>(x: T): T
        return x

priv struct Box<|T|>
    v: T

impl<|T|> Box<|T|>
    fn keep(x: T): T
        return x
    fn pair<|U|>(_x: T, y: U): U
        return y

priv fn bare_method(): Op
    return Plain.same

priv fn bare_type(): Op
    return Box.keep

priv fn bare_own(): fn(x: I32, y: U8): U8
    return Box<|I32|>.pair

priv fn through_value(): I32
    p: = Plain::{ .v = 1 }
    f: fn(): I32 = p.read
    return f()

priv fn trait_slot(): fn(s: Shape): I32
    return Shape.area

priv fn stray(): Op
    return Plain.twice<|I32|>

priv fn missing(): Op
    return Box<|I32|>.nosuch

priv fn wrong_type(): fn(x: I64): I64
    return Box<|I32|>.keep

fn main(): I32
    // The passing side.
    ok: Op = Box<|I32|>.keep
    ok2: Op = Plain.same<|I32|>
    return ok(0) + ok2(0) + through_value()

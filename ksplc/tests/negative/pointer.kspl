import "std/io"

trait Shape
  fn area(r: Self): I32

struct Sq
  n: I32

impl Sq: Shape
  fn area(r: Self): I32
    return r.n * r.n

struct View
  s: I32[]

fn kept_out_of_its_block(): I32
  $c: Callable1<|I32, I32|> = fn(x: I32; ): I32 { return x; }
  $s: I32[] = I32[]::{ 0 }
  $h: View = ::{ .s = I32[]::{ 0 } }
  $shape: Shape? = .none
  inner:
    n: = 5
    arr: I32[2] = ::{ 5, 6 }
    sq: = Sq::{ .n = 2 }
    c = fn(x: I32; n: I32): I32 { return x + n; }
    s = I32[]::arr
    h.s = I32[]::arr
    shape = .some(sq)
    t: = I32[]::arr
    s = t
  for $i: = 0; i < 2; i += 1
    s = I32[]::{ i, i }
  return c.call(1) + s[0] + h.s[0]

fn kept_where_it_lives($p: I32[]): I32
  outer: I32[2] = ::{ 1, 2 }
  $s: I32[] = I32[]::{ 0 }
  inner:
    s = I32[]::outer
    p = I32[]::outer
    t: = I32[]::outer
    s = t
    own: I32[2] = ::{ 3, 4 }
    $u: = I32[]::own
    u = I32[]::own
    s = I32[]::outer if u[0] > 0 else t
  return s[0] + p[0]

fn main()
  io.out().s("\{kept_out_of_its_block()\} \{kept_where_it_lives(I32[]::{ 0 })\}\n")

//< Pointers and permissions: `@`, read-only places and writes
//< Each case below is compiled alone, as the file its head names.
// ==== case addr_of_const_element
//< `@` on a read-only element must not pass it where a mutable pointer is expected
//< **The notation is right and only the permission drops.** Handed straight to a `U8$@`, the
//< expected type descends into `RO[0]`. The `const_of(U8)` -> `U8` conversion fits a copy. It
//< must not retype the place. `x` alone settles the type of `x@`, or a ROM write is lost.
// EXPECT: expected 'U8$@', but got 'U8@'
// EXPECT: expected 'U8$[]', but got 'U8[]'

const RO: U8[4] = ::{ 1, 2, 3, 4 }
const LIT: U8[] = "abc"

priv fn writes_through(p: U8$@)
  p$ = 9

priv fn writes_elem(s: U8$[])
  s[0] = 9

fn main(): I32
  writes_through(RO[0]@)
  writes_elem(LIT)
  return 0
// ==== case addr_of_immutable_binding
//< Taking an immutable binding's address must not let an out parameter rewrite it
//< Whether `x@` becomes a **mutable** pointer is settled by the binding, or the callee rewrites an
//< immutable `x`. **A slice and a pointer are no exception**, though their type settles whether an
//< element is writable through them. `p@` points at the variable `p` **itself**, not at its target.
// EXPECT: expected 'Sz$@', but got 'Sz@'
// EXPECT: expected 'U8[]$@', but got 'U8[]@'
// EXPECT: expected 'Sz$@$@', but got 'Sz$@@'

priv fn writes_out(p: Sz$@)
  p$ = 9

priv fn writes_slice(p: U8[]$@)
  p$ = "overwritten"

priv fn writes_ptr(p: Sz$@$@)
  p$ = null

fn main(): I32
  n: Sz = 0 // an immutable binding
  writes_out(n@)
  s: U8[] = "kept" // an immutable binding. an axis apart from element mutability (`U8$[]`)
  writes_slice(s@)
  p: Sz$@ = null // an immutable binding. an axis apart from the target being mutable
  writes_ptr(p@)
  return I32::n
// ==== case addr_of_literal
//< `@` on a string literal or a compound literal is refused, as on any value that is no place
//< C takes `&` of a compound literal, so only ksplc can stop it. The pointer would name a copy that
//< nobody reads again; returned from a function, it points into the ended frame.
// EXPECT: addr_of_literal.kspl:14:10: error: cannot take the address of a call result, literal
// EXPECT: addr_of_literal.kspl:17:7: error: cannot take the address of a call result, literal
// EXPECT: addr_of_literal.kspl:18:8: error: cannot take the address of a call result, literal
priv struct P
  n: I32

priv fn put(p: P$@)
  p.n = 3

priv fn gives(): U8[]@
  return "ab"@

fn main(): I32
  put(P::{ .n = 1 }@)
  s: = "cd"@
  return I32::(gives().len + s.len)
// ==== case addr_of_packed_field
//< A field `#packed` leaves under-aligned must not have its address taken, in any of the ways
//< A pointer carries no alignment of its own. So an access through it assumes its type's. A word
//< access at an odd address faults on a Cortex-M0. `@`, a receiver taken by pointer (a
//< method, an operator, a slice field's subscript) and a slice cast all take one. A one-byte field,
//< the struct itself and a field that keeps its alignment pass, as do reads and writes.
// EXPECT: as '@' would. A pointer to 'I32' promises 4. Copy the field into a local
// EXPECT: as 'bump', which takes its receiver by pointer, would. A pointer to
// EXPECT: as '+', which takes its receiver by pointer, would
// EXPECT: as '[]', which takes its receiver by pointer, would. A pointer to 'I32$[]'
// EXPECT: as a slice cast would. A pointer to 'I32$[2]' promises 4
// EXPECT: Finished with 5 error(s)

priv struct In
  x: I32

impl In
  fn bump(r: Self$@)
    r.x += 1

impl In: Add<|In, In|>
  fn add(r: Self@, o: In): In
    return In::{ .x = r.x + o.x }

#packed
priv struct Pk
  a: U8
  b: I32
  d: In
  nums: I32[2]
  s: I32$[]

#packed
#align(4)
priv struct Kept //< its field sits at a multiple of 4, and the struct starts at one
  pad: I32
  n: I32

priv fn take(p: I32$@): I32
  return p$

priv fn view(s: I32[]): Sz
  return s.len

fn main(): I32
  $m: Pk = ::{}
  $k: Kept = ::{}
  m.b = take(m.b@)
  m.d.bump()
  _sum: = m.d + m.d
  m.s[0] = 1
  _n: = view(I32[]::m.nums)
  _ok: = m.a@
  _whole: = m@
  m.d.x += m.nums[1]
  return take(k.n@)
// ==== case addr_of_packed_field_upcast
//< Making a trait value from a field that `#packed` leaves under-aligned is refused, as `@` is
//< The trait value keeps the field's address, and each method call through it assumes the type's
//< alignment. A field that keeps its alignment passes.
// EXPECT: as making a trait value would. A pointer to
// EXPECT: Finished with 1 error(s)

trait Show
  fn get(r: Self): I64

priv struct In
  v: I64

impl In: Show
  fn get(r: Self@): I64
    return r.v

#packed
priv struct Rec
  tag: U8
  inner: In

#packed
#align(8)
priv struct Kept //< its field sits at offset 8, and the struct starts at a multiple of 8
  pad: I64
  inner: In

priv fn show(s: Show): I64
  return s.get()

fn main(): I32
  r: Rec = ::{ .tag = 1, .inner = ::{ .v = 7 } }
  k: Kept = ::{}
  return I32::(show(r.inner) + show(k.inner))
// ==== case arc_assign_through_call
//< An assignment into an ARC-managed place must release the value it overwrites
//< With a call in the left-hand side's subexpression, the release's receiver cannot be made (the
//< expression being a clone, the call would run twice). Omitting the release in silence leaks the
//< original value, so the spelling is refused instead.
// EXPECT: cannot assign to an ARC-managed location whose left side contains a call
import "std/refcount" { Rc }

priv struct Holder
  rc: Rc<|I32|>

fn main(): I32
  $b: = Rc<|Holder|>(Holder::{ .rc = Rc<|I32|>(1) })
  empty: Rc<|I32|>[1] = ::{}
  b.get().rc = empty[0]
  return 0
// ==== case arc_protocol_not_callable
//< ARC's retain/release are an internal protocol only the compiler calls; a user cannot
//< Called by hand they double up with the inserted ones, and the automatic release writes into
//< memory an explicit one freed (use-after-free). The conforming impl's methods are priv, so a
//< direct call is refused (`case_trait_method_priv_upcast` in the case `trait_shape` in
//< `trait.kspl` covers an upcast).
// EXPECT: cannot access symbol
import "std/refcount" { Rc }

fn main()
  $a: = Rc<|I32|>(1)
  a.retain()
// ==== case mut_method_on_immut_array_elem
//< A `Self$@` method is rejected on an element of an immutable fixed-length array
//< Caution: **Test the element-receiver road (`a[i].m()`) separately.** Even with a scalar (`x.m()`)
//< and a field (`s.f.m()`) rejected, the decision can still slip at the `[` step. A reading of
//< `strip_ptr(x) != x` as "x is a pointer" skips the whole check for a `U8 immut` element.
// EXPECT: cannot call a method that takes a writable receiver
// EXPECT: cannot call a method that takes a writable receiver

impl U8
  fn bump_byte(r: Self$@)
    r$ = 99

struct Holder
  buf: U8[4]

fn main(): I32
  arr: U8[4] = ::{ 1, 2, 3, 4 } // an immutable binding (no $)
  arr[0].bump_byte()
  h: Holder = ::{ .buf = ::{ 1, 2, 3, 4 } }
  h.buf[0].bump_byte()
  return I32::arr[0]
// ==== case mut_method_on_struct_rvalue
//< A `Self$@` method cannot be called directly on a call's result
//< It rewrites its own memory, and a receiver's address is taken implicitly. Out of scope: `Self@`
//< methods, which write no memory of their own (also with `Self` a `U8$[]`, as `make test-place`
//< holds). A chain returning a pointer (`b.s("x").c('!')`) is out of scope too: it is handed over.
// EXPECT: cannot call a method that writes its receiver
// EXPECT: Bind the object first
priv struct Point
  n: I32

impl Point
  fn new(n: I32): Point
    return Point::{ .n = n }
  fn set_n(r: Self$@, v: I32)
    r.n = v

fn main(): I32
  Point(1).set_n(5)
  return 0
// ==== case mut_method_on_immut_slice_binding
//< A `Self$@` method on a slice writes its descriptor, so the slice's binding needs `$`
//< The descriptor is the binding's own value, as a struct's fields are. Treated as a pointer, the
//< slice would let an immutable `s` lose its last byte.
// EXPECT: mut_method_on_immut_slice_binding.kspl:19:3: error: cannot call a method that takes a writable receiver
// EXPECT: mut_method_on_immut_slice_binding.kspl:20:13: error: cannot make a
// EXPECT-NOT: mut_method_on_immut_slice_binding.kspl:23:
priv trait Shrink
  fn shrink(r: Self)

impl U8[]: Shrink
  fn shrink(r: Self$@)
    r.len -= 1

priv fn shrink_it(s: Shrink)
  s.shrink()

fn main(): I32
  s: U8[] = "abcd"
  s.shrink()
  shrink_it(s)
  $t: U8[] = "abcd"
  t.shrink()
  shrink_it(t)
  return I32::(s.len + t.len)
// ==== case mut_method_on_string_literal
//< A `Self$@` method cannot be called on a string literal, nor on another slice that is no place
//< Its descriptor is a copy, as a call's result is, so a write to its `len` is lost. The direct
//< call and a trait value ask one function (`receiver_is_copy`), so both refuse it.
// EXPECT: cannot call a method that writes its receiver
// EXPECT: value of a read-only location. 'U8[]' implements 'shrink'
priv trait Shrink
  fn shrink(r: Self)

impl U8[]: Shrink
  fn shrink(r: Self$@)
    r.len -= 1

priv fn shrink_it(s: Shrink)
  s.shrink()

fn main(): I32
  "abcd".shrink()
  shrink_it("abcd")
  return 0
// ==== case mutable_slice_from_readonly
//< A mutable slice must not be made from read-only memory
//< The descriptor holds a mutable pointer, so a write makes the C rewrite `.rodata`. KSPL is
//< silent. The program fails at run time on a host and writes to ROM on freestanding. Only read-only
//< memory is in scope: a cast to an immutable slice, or from a `$` binding's own memory, must pass.
// EXPECT: cannot cast a 'const' declaration to the mutable slice type 'U8$[]'
// EXPECT: cannot cast a string literal to the mutable slice type 'U8$[]'
// EXPECT-NOT: cannot cast a 'const' declaration to the mutable slice type 'U8[]'
import "std/io"

const RO: U8[4] = ::{ 1U8, 2U8, 3U8, 4U8 }

pub fn main(): I32
  bad_const: = U8$[]::RO // this one stops
  bad_literal: = U8$[]::"abc" // this one stops too
  ok_immutable: = U8[]::RO // an immutable slice passes
  $buf: U8[4] = ::{}
  ok_owned: = U8$[]::buf // memory one holds oneself passes
  io.out().s("\{bad_const.len\}\{bad_literal.len\}\{ok_immutable.len\}\{ok_owned.len\}\n")
  return 0
// ==== case writable_from_string_literal
//< A string literal must not be taken where a writable `U8$[]` or `U8$@` is expected
//< The literal is placed in read-only memory, so a write through the writable form faults on a
//< host and writes to ROM on freestanding. The implicit form is refused as the cast is: as an
//< argument, a field, a return value and a default value. `""` passes: with no element, the
//< bounds check refuses every write.
// EXPECT: a string literal cannot be used as 'U8$[]'
// EXPECT: a string literal cannot be used as 'U8$@'
// EXPECT-NOT: expected 'U8$[]', but got 'U8[]'
struct Holder
  s: U8$[]

priv fn writes_elem(s: U8$[])
  s[0] = 9

priv fn writes_through(p: U8$@)
  p$ = 9

priv fn gives(): U8$[]
  return "abc"

priv fn with_default(s: U8$[] = "abc"): Sz
  return s.len

fn main(): I32
  writes_elem("abc")
  writes_through("abc")
  h: = Holder::{ .s = "abc" }
  empty: U8$[] = "" // passes: nothing in it can be written
  return I32::(h.s.len + gives().len + with_default() + empty.len)
// ==== case read_only_pointer_as_writable_void
//< A read-only pointer must not become a writable `Void$@`
//< The callee could write through it, to a `const` in ROM among others. A writable pointer passes,
//< and so does any pointer as the read-only `Void@` or through the explicit cast.
// EXPECT: a read-only 'I32@' cannot be passed as a writable 'Void$@'
// EXPECT-NOT: a read-only 'I32$@'
const N: I32 = 5

priv fn writes(p: Void$@): Sz
    return Sz::(p != null)

priv fn reads(p: Void@): Sz
    return Sz::(p != null)

fn main(): I32
    $m: I32 = 1
    bad: = writes(N@) // refused: read-only memory
    ok_writable: = writes(m@)
    ok_read_only: = reads(N@)
    ok_cast: = writes(Void$@::m@)
    return I32::(bad + ok_writable + ok_read_only + ok_cast)
// ==== case null_without_a_type
//< A declaration from `null` alone names its pointer type
//< `null` fits every pointer type, so it gives the name none. Taking `Void@` in silence would
//< leave each use to cast it back.
// EXPECT: cannot infer type for 'p'. 'null' fits every pointer type. Write the type: 'p: T@ = null'
// EXPECT-NOT: cannot infer type for 'q'
fn main(): I32
  p: = null
  q: I32@ = null
  return 0 if p == q else 1
// ==== case pointer_forms
//< One subject, with one function for each of its shapes
//< The marks are every function's marks gathered at the head. The same mark written N times
//< must match N places.
// EXPECT: operator '+' cannot be applied to 'Sz' and 'I32@'
// EXPECT: operator '-' cannot be applied to 'Sz' and 'I32@'
// EXPECT: operator '+' cannot be applied to 'I32@' and 'I32@'
// EXPECT: operator '*' cannot be applied to 'I32@' and 'I32'
// EXPECT: operator '*=' cannot be applied to the pointer type 'I32@'
// EXPECT: the step of '+=' on the pointer type 'I32@' must be an integer
// EXPECT: cannot subtract 'U8@' from 'I32@'
// EXPECT: point to the same type
// EXPECT: cannot take the address of a call result, literal, or computed value
// EXPECT: Bind it first
// EXPECT: cannot take a pointer to a fixed-size array

// The shapes it does not hold, among the arithmetic taking a pointer as an operand.
// The three shapes that can be written are in "6.2 Pointer arithmetic and implicit
// dereferencing" in `../../../docs/SPEC-programming-language.md`.
priv fn op(n: Sz): Sz
  return n

fn case_ptr_arith_bad_forms(): I32
  a: I32[4] = ::{ 1, 2, 3, 4 }
  $p: = a[0]@
  q: = a[2]@
  x1: Sz = op(1) + p
  x2: Sz = op(1) - p
  x3: Sz = Sz::(p + q)
  x4: Sz = Sz::(p * 2)
  p *= 2
  p += q
  return (I32)::(x1 + x2 + x3 + x4)

// A subtraction between pointers whose target types differ.
// **The answer being "how many elements", it cannot subtract unless the element size is settled
// to one** ("6.2 Pointer arithmetic and implicit dereferencing" in
// `../../../docs/SPEC-programming-language.md`). Let it through without refusing and KSPL's diagnostics are
// zero, with only the C compiler's `invalid operands to binary expression` coming out.
fn case_ptr_diff_mismatched(): I32
  a: I32 = 1
  b: U8 = 2
  d: = a@ - b@
  return (I32)::d

// Put `@` on an expression that is not a place (a function's return value) and the generated C
// becomes `&a temporary`. Without refusing here, what reaches the user is a raw C compiler error
// rather than KSPL's diagnostic.
import "std/ds" { List }
import "std/mem" { Arena }

fn take(l: List<|U8[]|>$@): Sz
  return l.len

fn make(arena: Arena$@): List<|U8[]|>
  return List<|U8[]|>(arena)

fn case_addr_of_rvalue(): I32
  a: = Arena(4096)
  defer a.free()
  return I32::take(make(a)@)

// A pointer to a fixed-length array. It can be written as a type, but no expression making that
// value exists (`a@` decays to a pointer to the first element, as in C). The type-checking step
// refuses it. Otherwise a type could be declared but never assigned
// (docs/DESIGN-principles.md Principle 5).
fn case_pointer_to_fixed_array()
  $a: I32[3] = ::{ 1, 2, 3 }
  _p: I32[3]@ = a@

fn main()
  case_ptr_arith_bad_forms()
  case_ptr_diff_mismatched()
  case_addr_of_rvalue()
  case_pointer_to_fixed_array()
// ==== case readonly_write
//< One subject, with one function for each of its shapes
//< The marks are every function's marks gathered at the head. The same mark written N times
//< must match N places.
// EXPECT: cannot write through a read-only pointer
// EXPECT: cannot write through a read-only pointer
// EXPECT: cannot write through a read-only pointer
// EXPECT: cannot write to an element of the read-only slice 'U8[]'

// The shape writing through a read-only pointer (`T@`) by way of a `$` (an explicit dereference).
// It pairs with the case `const_ptr_field_write` in `const.kspl` (by way of a `.`). It confirms
// that the `$` side's road is shut too. Both shapes easily pass through.
fn case_const_ptr_deref_write()
  x: I32 = 1
  p: I32@ = I32@::x@
  p$ = 5

// A variant of the case `const_ptr_in_struct_field_write` in `const.kspl`. It writes into a
// "field" at the target: `s.p.n = v` crosses two pointers (`s` and `s.p`), the latter immutable.
// The check saw the first crossing (`s` is a mutable pointer) and stopped at "a pointer was
// crossed, so the binding's mutability is not asked about". It did not see that `s.p` midway
// is immutable.
struct Inner
  n: I32

struct S
  p: Inner@

fn write_through_field(s: S$@)
  s.p.n = 1

fn case_const_ptr_in_struct_field_member_write(): I32
  $i: Inner = Inner::{ .n = 0 }
  s: = S::{ .p = i@ }
  s@.write_through_field()
  return i.n

// The shape taking an element out by an index (a read-only pointer `I32@`) and writing into its
// target. The array itself and the element's slot are mutable (`I32@[2]`), but what the element
// points at is immutable, so it is refused.
// The regression: the same fail-open as the case `const_ptr_nested_deref_write` in `const.kspl`.
// write_target_type returned unknown on a `[` (an index) too. So the check gave up, and on the
// LLVM backend the write held.
$g: I32 = 1

fn case_const_ptr_via_subscript_write()
  $arr: I32@[2] = ::{ g@, g@ }
  arr[0]$ = 99 // invalid: what the element points at is read-only

// A write to an element of a read-only slice. Even with the bounds check passing, it can foul
// read-only data such as a string literal directly and segfault, so it should be refused.
fn case_const_slice_write()
  s: U8[] = "hello"
  s[0] = U8::'X'

fn main()
  case_const_ptr_deref_write()
  case_const_ptr_in_struct_field_member_write()
  case_const_ptr_via_subscript_write()
  case_const_slice_write()
// ==== case write_elem_through_const_ptr
//< Elements must not be rewritable through a pointer to a read-only slice
//< `p[0] = v` on a `p: U8[]@` auto-dereferences (`docs/SPEC-programming-language.md` §6.2.1), so the elements'
//< check must peel the pointer step off. A `U8$[]@` (an immutable pointer to a **mutable** slice)
//< has writable elements: the descriptor's (ptr+len) mutability is a different step.
//< The slice is named, not the pointer: `$[]` goes on the slice's step.
// EXPECT: cannot write to an element of the read-only slice 'U8[]'. Use '$[]'

fn main(): I32
  $buf: U8[4] = ::{ 'a', 'b', 'c', 'd' }
  imm: U8[] = U8[]::{ .ptr = buf[0]@, .len = 4 }
  p: U8[]@ = imm@ // both the elements and the descriptor are read-only
  p[0] = 'Z'
  return I32::buf[0]
// ==== case write_elem_through_const_recv
//< A method with a read-only receiver cannot write an element of an array field
//< `U8[4]`'s step holds the elements' mutability, but **the road reaching it** crosses `r: Self@`,
//< so the index goes through enforce_mutability. Without it the C backend rejects it only by the
//< generated C's const (the diagnostic points at the artifact) and the LLVM backend writes 99.
// EXPECT: cannot write through a read-only pointer

struct Holder
  buf: U8[4]

impl Holder
  fn ro_write(r: Self@): U8
    r.buf[0] = 99
    return r.buf[0]

fn main(): I32
  $h: Holder = ::{ .buf = ::{ 1, 2, 3, 4 } }
  return I32::h.ro_write()
// ==== case write_through_ptr_arith
//< A write through pointer arithmetic on a read-only pointer is rejected
//< `p + 1` keeps `p`'s pointer type, but a road check (write_target_type) walking only `.` / `$` /
//< `[` returns unknown on a binary operation and gives up (fail-open). The gap hides because
//< **handing it as an argument** (`wants_mut(p + 1)`) is refused while a direct write slips by.
// EXPECT: cannot write through a read-only pointer
// EXPECT: cannot write through a read-only pointer

const RO: U8[4] = ::{ 1, 2, 3, 4 }

// p: U8@ is the promise "I do not write to the target".
priv fn breaks_promise(p: U8@)
  (p + 1)$ = 9

fn main(): I32
  q: = RO@ // U8@
  (q + 1)$ = 9
  breaks_promise(RO@)
  return I32::RO[1]
// ==== case raw_address_cast
//< An integer becomes a pointer only in code marked `#raw_address`
//< **On a machine without a fixed memory map such an address is nearly always a slip**, and C
//< compiles it without a word. Any integer counts (a constant, `Sz`), as does any pointer type
//< (`Void$@`, a function type). A marked function and a marked top-level `const` keep the cast.
//< What is neither a pointer nor an integer becomes no pointer anywhere, marked or not.
// EXPECT: Cannot cast 'I32' to 'U32@' here
// EXPECT: Cannot cast 'Sz' to 'Void$@' here
// EXPECT: Cannot cast 'U32' to 'fn():Void' here
// EXPECT: Cannot cast 'I32' to 'U8@' here
// EXPECT: Hint: for a device's register or other memory at a fixed address, mark the function
// EXPECT: cannot cast 'Bool' to 'I8@': only a pointer, a function or 'null' converts to a pointer
// EXPECT-NOT: to 'U16@'
// EXPECT-NOT: to 'U64@'
// EXPECT-NOT: to 'I16$@'

#raw_address
const MARKED: U64@ = U64@::0x4000_0000
const UNMARKED: U8@ = U8@::0x4000_0004

#raw_address
priv fn register(at: U32): U16
  scratch: = I16$@::(Sz::at)
  _keep: = scratch
  return (U16@::at)$

priv fn constant(): U32
  return (U32@::0x4000_0000)$

priv fn context(n: Sz): Void$@
  return Void$@::n

priv fn callback(at: U32)
  f: = (fn(): Void)::at
  f()

#raw_address
priv fn not_an_address(b: Bool): I8@
  return I8@::b

fn main(): I32
  callback(0)
  _p: = context(0)
  _q: = not_an_address(false)
  _m: = MARKED
  _u: = UNMARKED
  return I32::register(0) + I32::constant()
// ==== case raw_address_slice_length
//< A slice's length cast to a pointer names `.ptr` in the hint
//< `U8$@::buf.len` for `buf.ptr` is the slip the rule is first meant to catch.
// EXPECT: Cannot cast 'Sz' to 'U8$@' here
// EXPECT: Hint: this is the slice's length. Did you mean its address, '.ptr'?

priv fn first(buf: U8$[]): U8
  p: = U8$@::buf.len
  return p$

fn main(): I32
  $a: U8[2] = ::{ 1, 2 }
  return I32::first(U8$[]::a)

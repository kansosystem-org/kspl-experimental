// The shapes it does not hold, among the arithmetic taking a pointer as an operand.
// The three shapes that can be written are in "6.2 Pointer arithmetic and implicit
// dereferencing" in `../../../docs/SPEC-programming-language.md`.
priv fn op(n: Sz): Sz

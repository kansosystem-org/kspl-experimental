//< A release is not only the method form (`x.free()`)
//<
//< A `dealloc(x)` is a release too, and its actual argument ordinarily carries a cast to `Void$@`,
//< so the wrappings (`@` / `::`) are peeled off and it is walked back to the original local
//< (ksplc/docs/DESIGN.md §11.2).
// EXPECT: variable 'p' may already be freed here
import "std/mem"
import "std/mem" { dealloc }

priv struct S
  v: I32

fn main()
  p: = mem.alloc_as<|S|>()
  dealloc(Void$@::p)
  _x: = p.v

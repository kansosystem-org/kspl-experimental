//< `std/lang`'s import alias is present in every file implicitly
//<
//< So a wrong name gets "lang is there, but does not export that name". **Say "the prefix is not
//< known" and the alias is out:** `impl My_type: lang.Ref_counted` is unwritable, and a file that
//< declares the same name cannot conform to a trait the compiler knows (docs/DESIGN.md 3.2.4).
// EXPECT: 'lang' names a file, but it does not export 'Nope'
// EXPECT-NOT: neither a known import alias nor a type
import "std/io"

pub fn main(): I32
  io.out().s("\{lang.Nope\}").c('\n')
  return 0

//< A `\uXXXX` is written with exactly four hexadecimal digits
//<
//< The digits, the value and the place are all three refused.
//< Caution: **Do not let a surrogate code point (D800–DFFF) through.** Not a code point, it
//< copies into UTF-8 as an invalid three-byte run that reads fine until a later check falls on it.
// EXPECT: takes exactly four hexadecimal digits
// EXPECT: names a surrogate
// EXPECT: is more than one byte in UTF-8
// EXPECT-NOT: '\u0041'
// EXPECT-NOT: '\u3042'
pub fn take(): I32
  ok_ascii: U8 = '\u0041'
  ok_wide: U8[] = "\u3042"
  short_hex: U8[] = "\u12"
  surrogate: U8[] = "\uD800"
  wide_in_char: U8 = '\u00E9'
  return I32::(ok_wide.len + short_hex.len + surrogate.len) + I32::ok_ascii + I32::wide_in_char

//< In the indentation notation, siblings in one block whose columns do not line up are rejected
//<
//< A piled step keeps only the heading's column (`Frame` in `../../parse/layout.kspls`), so the
//< `4 columns` line reads as outside the `if` yet is inside it: two readings, two programs, which
//< Principle 8 in `../../../docs/DESIGN.md` refuses. **It carries no code**, so none can switch it.
// EXPECT: but its siblings sit
// EXPECT-NOT: [W0105]
import "std/io"

fn main(): I32
  if 1 < 0
      io.out().s("6 columns\n")
    io.out().s("4 columns — not level with the sibling\n")
  io.out().s("2 columns\n")
  return 0

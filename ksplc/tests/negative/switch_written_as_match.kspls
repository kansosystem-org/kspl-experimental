//< Rust's and Python's `match` suggests `switch`, its cases opening with `case`
//<
//< The note writes the head with the subject the line gave; `match` stays a name, as the call on
//< the first line of `main` shows.
// EXPECT: switch_written_as_match.kspls:12:11: error: expected ':'
// EXPECT: KSPL branches on a value with 'switch'; each case opens with 'case', with no braces around them all: 'switch x case ...'.
fn match(n: I32): I32
    return n

fn main()
    x: = match(1)
    match x
    case 1
        return
    default
        return

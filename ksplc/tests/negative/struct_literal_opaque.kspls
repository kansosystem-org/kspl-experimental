//< An opaque type (a `struct` declaring only its size and alignment) cannot be made by a literal
//<
//< Holding no fields is not "they were all written". The content is merely absent on this side,
//< and nothing guarantees that a zero-filled value is a valid value of that type.
// EXPECT: is opaque here
// EXPECT-NOT: [
#size(8)
#align(8)
priv struct Handle

priv fn take(_h: Handle): Sz
  return sizeof(Handle)

fn main(): I32
  return I32::take(Handle::{})

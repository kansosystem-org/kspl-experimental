//< A format specifier that would be written yet do nothing is refused, one error per specifier
//<
//< **Each was accepted or misreported**: `.20` and `.25` printed 19 digits (std/strfmt clamps), a
//< lone `0` padded to no width, an empty `:` was a syntax error about a `(` never closed, and a
//< spec both unreadable and misordered gave two errors at one position (`check_format_spec` in
//< `ksplc/parse/desugar.kspls`).
// EXPECT: format spec ':.20' asks for more digits after the point than are written (at most 19)
// EXPECT: format spec ':0' has a zero-pad '0' and no width to pad to
// EXPECT: a ':' with no format spec after it
// EXPECT: unrecognized format spec ':,.2xq'; could not read 'q'
// EXPECT-NOT: combines ',' with 'x'
// EXPECT-NOT: format spec ':.19'
// EXPECT-NOT: is never closed
import "std/io"
import "std/strfmt"

fn main()
  f: = 2.5
  n: = 7
  io.out().s("[\{f:.19\}][\{f:.20\}][\{n:0\}][\{n:\}][\{n:,.2xq\}]\n")

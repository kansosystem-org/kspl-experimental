//< Closures and ownership: captures, moves and freeing twice
//< Each case below is compiled alone, as the file its head names.
// ==== case anon_fn_generic_param
//< An anonymous function cannot use the enclosing type argument
//< It is lifted to a non-generic top-level function passed as a pointer **value**, so nothing can
//< settle the instantiation. **That the reason and the alternative are stated** is pinned down.
//< Caution: Keep the two passing sides alongside (forwarded_gen_params in parse/desugar.kspl).
// EXPECT: an anonymous function cannot use the enclosing type parameter 'T'
// EXPECT: an anonymous function cannot use the enclosing type parameter 'N'
// EXPECT: Add a capture list to make it a closure
// EXPECT-NOT: missing import alias prefix
import "std/io"

priv typedef Int_op = fn(a: I32): I32

priv fn app_ptr(a: I32, f: Int_op): I32
  return f(a)

priv fn app_call<|T|>(v: T, f: Callable1<|T, T|>): T
  return f.call(v)

priv struct Holder<|T|>
  priv v: T

impl<|T|> Holder<|T|>
  pub fn probe(r: Self$@): I32
    // The stopping side: the anonymous function writes the enclosing `T`.
    bad: = app_call<|T|>(r.v, fn(x: T): T {
      return x;
    })
    // The passing side: write a capture list and it becomes a closure, which can copy `T` across.
    ok_closure: = app_call<|T|>(r.v, fn(x: T; ): T {
      return x;
    })
    // The passing side: an anonymous function that does not touch the type arguments becomes a
    // function pointer as it stands, even inside a generic.
    ok_ptr: = app_ptr(1, fn(a: I32): I32 {
      return a + 1;
    })
    return I32::bad * 0 + I32::ok_closure * 0 + ok_ptr

// The stopping side: a `const` parameter read in an anonymous function's body. Let through, the
// lifted body has no `N`, and the C compiler reports it.
priv fn count_of<|const N: Sz|>(a: I32[N]): Sz
  f: fn(x: I32): Sz = fn(x: I32): Sz {
    return Sz::x + N;
  }
  return f(a[0])

fn main(): I32
  $h: = Holder<|I32|>::{ .v = 3 }
  a: I32[2] = ::{ 1, 2 }
  io.out().s("\{h.probe()\} \{count_of(a)\}\n")
  return 0
// ==== case anon_fn_no_capture
//< An anonymous function does not capture the outer locals
//< The body is lifted to a top-level function (desugar_fn_lit in ksplc/parse/desugar.kspl). So the
//< outer locals are not visible. **The message states the reason**. Two passing cases stand beside it.
//< Caution: Only one capture is placed: an unresolved path is reported only at the first one.
// EXPECT: error: undefined path or identifier 'n'
// EXPECT: an anonymous function cannot capture 'n' from the enclosing scope
// EXPECT-NOT: check for typos
import "std/io"

const G_LIMIT: I32 = 4

priv fn take(f: fn(x: I32): Bool): Bool
  return f(9)

fn main(): I32
  n: = 5
  bad_local: = take(fn(x: I32): Bool {
    return x > n;
  })
  // The passing side: looking only at its own arguments / looking at a top-level const.
  ok_param: = take(fn(x: I32): Bool {
    return x > 0;
  })
  ok_global: = take(fn(x: I32): Bool {
    return x > G_LIMIT;
  })
  io.out().s("\{bad_local\}\{ok_param\}\{ok_global\}\n")
  return 0
// ==== case anon_fn_no_capture_receiver
//< From an anonymous function written inside a method, the receiver is not visible
//< It is lifted to a top-level function that does not receive `Self`, so `r` is a name that is
//< nowhere. The message must name **the side that could not be resolved** (`r`). Naming the `v` of
//< `r.v` blames a name that exists, and its advice cannot be followed.
// EXPECT: error: undefined path or identifier 'r'
// EXPECT: an anonymous function cannot capture 'r' from the enclosing scope
// EXPECT-NOT: is neither a known import alias nor a type
import "std/io"

priv struct Box
  priv v: I32

priv fn take(f: fn(x: I32): Bool): Bool
  return f(9)

impl Box
  fn over_v(r: Self@): Bool
    return take(fn(x: I32): Bool {
      return x > r.v;
    })

fn main(): I32
  b: = Box::{ .v = 7 }
  io.out().s("\{b.over_v()\}\n")
  return 0
// ==== case closure_at_top_level
//< A closure can be written only inside a block
//< The environment is a temporary on the caller's frame, and the top level has nowhere to declare
//< it. **That the reason is stated is pinned down**, not an error naming `_anon_env_v_1`. A
//< function with no capture list holds no environment and has to pass in a top-level `const`.
// EXPECT: a closure must appear inside a function body
// EXPECT-NOT: undefined path or identifier
import "std/io"

priv typedef Int_op = fn(a: I32): I32

priv struct Slot
  priv op: Int_op

// The passing side: an anonymous function can be placed in a top-level const and in a struct's
// field.
priv const G_OP: Int_op = fn(a: I32): I32
  return a * 2
priv const G_SLOT: Slot = Slot::{ .op = fn(a: I32): I32 {
  return a + 1;
} }

// The stopping side: the shape with a capture list written cannot be placed outside a block.
priv const G_PRED: Callable1<|I32, Bool|> = fn(x: I32; ): Bool
  return x > 0

fn main(): I32
  io.out().s("\{G_OP(4)\}/\{G_SLOT.op(4)\}/\{G_PRED.call(1)\}\n")
  return 0
// ==== case closure_called_as_function
//< A closure called as a function, `f(1)`, is told to go through its `call` method
//< **The message names the `Callable` the closure conforms to**, not the environment struct the
//< compiler made (`_anon_env_1`, in a module its file's path names), a type the writer never wrote.
// EXPECT: cannot call 'f'. It is a closure, which conforms to 'std.lang.Callable1<|I32, I32|>', not a function
// EXPECT: Call it through its 'call' method: 'f.call(...)'
// EXPECT-NOT: _anon_env
import "std/io"

fn main(): I32
  k: = 2
  f: = fn(x: I32; k: I32): I32 { return x + k; }
  bad: = f(1)
  // The passing side.
  good: = f.call(1)
  io.out().s("\{bad\}/\{good\}\n")
  return 0
// ==== case closure_capture_closure
//< A closure cannot capture another closure
//< The capture's field is the type written (`Callable1<|…|>`). But the synthesised environment
//< struct comes over. Without the note, the user reads `_anon_env_1`, a type they did not write
//< (anon_env_prefix in ksplc/base/ast.kspl). Handing it over as an **argument** must pass.
// EXPECT: a closure's type is its synthesized environment
// EXPECT: A closure cannot capture another closure
import "std/io"

priv fn app(a: I32, f: Callable1<|I32, I32|>): I32
  return f.call(a)

priv fn app2(a: I32, g: Callable1<|I32, I32|>, f: Callable2<|I32, I32, I32|>): I32
  return f.call(a, g.call(a))

fn main(): I32
  inner: = fn(x: I32; ): I32
    return x * 3
  // The stopping side: it tries to capture the inner closure.
  bad: = app(4, fn(x: I32; inner: Callable1<|I32, I32|>): I32 {
    return inner.call(x) + 1;
  })
  // The passing side: handed over as an argument, they can be combined.
  ok: = app2(4, inner, fn(_x: I32, gx: I32; ): I32 {
    return gx + 1;
  })
  io.out().s("\{bad\}/\{ok\}\n")
  return 0
// ==== case closure_capture_rules
//< The diagnostics for mistyping a closure's capture list (`fn(x: I32; n: I32): Bool { … }`)
//< Caution: Always place the non-firing side alongside. A correctly written closure has to pass.
//< The grammar (capture_list) rejects nothing behind the `;` (`fn(x: I32; )`). So the desugaring
//< side has no check for it. An unreachable check "can be written yet does not work".
// EXPECT: capture 'a' needs a type annotation
// EXPECT: a capture must not be marked '$'. Captures are read-only
// EXPECT: a closure with captures must take exactly 1 or 2 parameters
// EXPECT: capture 'arr' is a fixed-length array ('I32[3]'). A closure holds each capture by pointer
// EXPECT: 'k' is named twice in this closure's signature
// EXPECT: 'x' is named twice in this closure's signature
// EXPECT-NOT: _anon_env
import "std/io"

priv fn apply1(p: Callable1<|I32, Bool|>): Bool
  return p.call(9)

fn main(): I32
  a: = 1
  $b: = 2
  c: = 3
  ok: = 5
  // A capture with the type omitted. A declaration written in a signature must have a type
  // annotation (`../../../docs/SPEC-programming-language.md` §4.1).
  bad_no_type: = apply1(fn(x: I32; a): Bool {
    return x > a;
  })
  // A capture is read-only, so a `$` cannot be attached.
  bad_mut: = apply1(fn(x: I32; $b: I32): Bool {
    return x > b;
  })
  // Zero arguments. It hits neither Callable1 nor Callable2.
  bad_arity: = apply1(fn(; c: I32): Bool {
    return c > 0;
  })
  // A fixed-length array: a capture is held by pointer, and no pointer to an array can be made.
  arr: I32[3] = ::{ 1, 2, 3 }
  bad_array: = apply1(fn(x: I32; arr: I32[3]): Bool {
    return x > arr[0];
  })
  // A name twice, among the captures or across a parameter and a capture.
  k: = 6
  bad_twice: = apply1(fn(x: I32; k: I32, k: I32): Bool {
    return x > k;
  })
  x: = 7
  bad_shadow: = apply1(fn(x: I32; x: I32): Bool {
    return x > 0;
  })
  // The passing side.
  good: = apply1(fn(x: I32; ok: I32): Bool {
    return x > ok;
  })
  io.out().s("\{bad_no_type\}\{bad_mut\}\{bad_arity\}\{good\}\n")
  io.out().s("\{bad_array\}\{bad_twice\}\{bad_shadow\}\n")
  return 0
// ==== case closure_capture_sema
//< The **existing checks** enforce the two restrictions on a captured closure
//< Writing a capture fails: `call` rebinds it to an immutable local (`build_closure_src` in
//< parse/desugar.kspl). Returning it fails: the environment lives in the caller's frame
//< ("Which pointers into a frame are stopped from leaving it" of
//< docs/DESIGN-programming-language.md). If this starts to pass, the synthesis fell out of those checks.

// ==========================================
// Caution: Always place the non-firing side alongside — a capture only read, and a closure spent
// inside the call, have to pass.
// ==========================================

// EXPECT: cannot assign to an immutable variable 'd'
// EXPECT: cannot return a closure: it keeps pointers to its captured variables
import "std/io"

priv fn apply1(p: Callable1<|I32, Bool|>): Bool
  return p.call(9)

priv fn leak(): Callable1<|I32, Bool|>
  e: = 1
  return fn(x: I32; e: I32): Bool
    return x > e

fn main(): I32
  d: = 4
  ok: = 5
  bad_write: = apply1(fn(x: I32; d: I32): Bool {
    d = 1; return x > d;
  })
  good: = apply1(fn(x: I32; ok: I32): Bool {
    return x > ok;
  })
  io.out().s("\{bad_write\}\{good\}\{leak().call(1)\}\n")
  return 0
// ==== case closure_stored_outside_frame
//< A closure stored where it outlives its function is refused, as returning it is
//< Its environment points into the frame, so a global or a place behind a pointer keeps a dead
//< frame and the later call crashes. `kept_inside` stores into the frame and passes: the count is exact.
// EXPECT: cannot store a closure: it keeps pointers to its captured variables, which live in this function's frame. It would be stored behind a pointer
// EXPECT: cannot store a closure: it keeps pointers to its captured variables, which live in this function's frame. It would be stored behind a pointer
// EXPECT: cannot store a closure: it keeps pointers to its captured variables, which live in this function's frame. It would be stored into the global 'g', which
// EXPECT: cannot store a closure: it keeps pointers to its captured variables, which live in this function's frame. It would be stored into the global 'g_opt', which
// EXPECT: cannot store a closure: it keeps pointers to its captured variables, which live in this function's frame. It would be stored into the global 'g_holder', which
// EXPECT: cannot store 'c': it was set from a slice or an interface value built from local storage
// EXPECT: Finished with 6 error(s)
import "std/io"

priv struct Holder
  c: Callable1<|I32, I32|>?

priv $g: Callable1<|I32, I32|>
priv $g_opt: Callable1<|I32, I32|>? = .none
priv $g_holder: Holder = ::{ .c = .none }
priv $g_ptr: fn(x: I32): I32

impl Holder
  priv fn arm(r: Self$@, n: I32)
    r.c = .some(fn(x: I32; n: I32): I32 { return x + n; })

priv fn into_global(n: I32)
  g = fn(x: I32; n: I32): I32 { return x + n; }

priv fn wrapped_in_option(n: I32)
  g_opt = .some(fn(x: I32; n: I32): I32 { return x + n; })

priv fn into_global_field(n: I32)
  g_holder.c = .some(fn(x: I32; n: I32): I32 { return x * n; })

priv fn through_param(h: Holder$@, n: I32)
  h.c = .some(fn(x: I32; n: I32): I32 { return x - n; })

priv fn through_local_name(n: I32)
  c: Callable1<|I32, I32|> = fn(x: I32; n: I32): I32 { return x + n; }
  g = c

priv fn kept_inside(n: I32): I32
  $h: Holder = ::{ .c = .none }
  h.c = .some(fn(x: I32; n: I32): I32 { return x + n; })
  g_ptr = fn(x: I32): I32 { return x + 1; }
  if c: = h.c
    return c.call(1) + g_ptr(1)
  return 0

fn main()
  $h: Holder = ::{ .c = .none }
  into_global(1)
  wrapped_in_option(1)
  into_global_field(1)
  through_param(h@, 1)
  through_local_name(1)
  h.arm(2)
  io.out().s("\{kept_inside(1)\}\n")
// ==== case double_free
//< A double free: .free() called twice on the same local
// EXPECT: may already be freed here
struct Foo
  priv other: I32
fn main()
  $f: = Foo::{ .other = 2 }
  f.free()
  f.free()

// The declaration that has the release tracked (Manual_free in std/lang.kspl).
impl Foo: Manual_free
  priv fn free($r: Self$@)
    r.other = 0
// ==== case move_only_array_and_payload
//< Move_only's structural derivation also walks an enum's payload and an array's elements
//< Without that walk, a struct can hold an array of owning handles by value. It is then copied
//< silently and becomes a double free (ksplc/docs/DESIGN-diagnostics.md "A check of one kind lives
//< in one place").
// EXPECT: was moved out of and cannot be used again
import "std/mem"

priv struct Handle
  v: I32

impl Handle: Move_only {}

priv struct Holds_array
  a: Handle[2]

priv fn take(h: Holds_array): I32
  return h.a[0].v

fn main()
  h: Holds_array = ::{ .a = ::{::{ .v = 1 }, ::{ .v = 2 } } }
  _a: = take(h)
  _b: = take(h)
// ==== case move_only_borrow_is_ok
//< The counterpart of the case above: a borrow by `@` and a method call are not moves
//< Should these be wrongly treated as moves, `Mutex<|T|>` becomes unusable in earnest (even lock()
//< could be called only once). The case fails on purpose through the same check, on another value.
// EXPECT: variable 'gone' was moved out of
// EXPECT: Finished with 1 error(s)
// EXPECT-NOT: variable 'mx'
import "std/thread"

priv fn bump(m: thread.Mutex<|I32|>$@): Void$@
  p: = m.lock()
  p$ += 1
  m.unlock()
  return null

fn main()
  $mx: = thread.Mutex<|I32|>(0) catch
    return
  p: = mx.lock()
  p$ += 1
  mx.unlock()
  $t: = thread.Thread.spawn<|thread.Mutex<|I32|>|>(bump, mx@) catch
    return
  t.free()

  $gone: = thread.Mutex<|I32|>(0) catch
    return
  _kept: = gone
  gone.unlock()
// ==== case move_only_field_moved_out
//< A `Move_only` field read as a value moves out of its local, as the whole binding would
//< **Every read as a value is a move, a field's included**: `take(b.m)` twice hands one handle out
//< twice. After it, the field, what lies below it and the whole binding are gone. Another field
//< stays. A new value in the field gives it back (the last function passes).
// EXPECT: move_only_field_moved_out.kspl:30:27: error: field 'b.m' was moved out of
// EXPECT: move_only_field_moved_out.kspl:33:29: error: field 'o.b.m' was moved out of
// EXPECT: move_only_field_moved_out.kspl:36:31: error: field 'b.m' was moved out of
// EXPECT: move_only_field_moved_out.kspl:40:10: error: field 'b.m' was moved out of
// EXPECT: move_only_field_moved_out.kspl:45:15: error: field 'b.m' was moved out of
// EXPECT: Finished with 5 error(s)
priv struct M
  v: I32

impl M: Move_only {}

priv struct Box
  m: M
  n: M

priv struct Outer
  b: Box

priv fn take(m: M): I32
  return m.v

priv fn take_box(b: Box): I32
  return b.n.v

priv fn twice(b: Box): I32
  return take(b.m) + take(b.m)

priv fn twice_below(o: Outer): I32
  return take(o.b.m) + take(o.b.m)

priv fn then_whole(b: Box): I32
  return take(b.m) + take_box(b)

priv fn then_read(b: Box): I32
  _x: = take(b.m)
  return b.m.v

priv fn on_every_pass(b: Box, n: I32): I32
  $t: I32 = 0
  for $i: I32 = 0; i < n; i += 1
    t += take(b.m)
  return t

priv fn apart_and_given_back($b: Box): I32
  $t: = take(b.m) + take(b.n)
  b.m = ::{ .v = 3 }
  t += take(b.m)
  return t

fn main(): I32
  b: Box = ::{ .m = ::{ .v = 1 }, .n = ::{ .v = 2 } }
  o: Outer = ::{ .b = ::{ .m = ::{ .v = 1 }, .n = ::{ .v = 2 } } }
  return twice(b) + twice_below(o)
// ==== case move_only_result_payload
//< Move_only's structural derivation also walks a Result's success payload
//< A `Handle!E` holds the handle by value, as `Handle?` does. Copied in silence, two
//< places would each own it and free it twice.
// EXPECT: was moved out of and cannot be used again
priv struct Handle
  v: I32

impl Handle: Move_only {}

priv enum Open_error
  missing

priv fn open(): Handle!Open_error
  return Handle::{ .v = 1 }

priv fn take(_r: Handle!Open_error) {}

fn main()
  r: = open()
  take(r)
  take(r)
// ==== case move_only_value_receiver_moves
//< A method that takes a Move_only receiver by value (`r: Self`) moves it; a pointer receiver lends
//< Let through, `h.consume()` then `take(h)` handed one handle to two owners, which both release.
//< A move in a branch or a loop is tracked as an argument's is. `Self@` / `Self$@` calls and a
//< field read stay reads, and a new value makes the binding usable again.
// EXPECT: move_only_value_receiver_moves.kspl:27:17: error: variable 'h' was moved out of
// EXPECT: move_only_value_receiver_moves.kspl:31:12: error: variable 'b' was moved out of
// EXPECT: move_only_value_receiver_moves.kspl:35:5: error: variable 'l' was moved out of
// EXPECT: Finished with 3 error(s)
priv struct H
  fd: I32

impl H: Move_only
  priv fn consume(r: Self): I32
    return r.fd
  priv fn peek(r: Self@): I32
    return r.fd
  priv fn poke(r: Self$@)
    r.fd += 1

priv fn take(h: H): I32
  return h.fd

fn main(): I32
  $h: = H::{ .fd = 3 }
  h.poke()
  $total: = h.peek() + h.fd + h.consume()
  total += take(h)
  $b: = H::{ .fd = 4 }
  if total > 0
    total += b.consume()
  total += b.peek()
  $l: = H::{ .fd = 5 }
  for i in Range.asc(2)
    total += I32::i
    l.consume()
  $kept: = H::{ .fd = 6 }
  total += kept.consume()
  kept = H::{ .fd = 7 }
  return total + kept.consume()
// ==== case move_only_moved_inside_a_borrow
//< A call's or an index's argument moves, though the call is a receiver or sits under `@`
//< Let through, `mk(h).get()` twice built two values from one handle, and `xs[mk(h).n]@` twice
//< did too. Only the place a receiver names is borrowed, never what a call or a literal in it copies.
// EXPECT: move_only_moved_inside_a_borrow.kspl:34:15: error: variable 'h' was moved out of
// EXPECT: move_only_moved_inside_a_borrow.kspl:36:25: error: variable 'g' was moved out of
// EXPECT: move_only_moved_inside_a_borrow.kspl:40:15: error: variable 'k' was moved out of
// EXPECT: move_only_moved_inside_a_borrow.kspl:43:28: error: variable 'j' was moved out of
// EXPECT: Finished with 4 error(s)
priv struct H
  fd: I32

impl H: Move_only {}

priv struct W
  n: I32

impl W
  priv fn get(r: Self@): I32
    return r.n

priv fn mk(h: H): W
  return W::{ .n = h.fd }

priv struct V
  h: H

impl V
  priv fn peek(r: Self@): I32
    return r.h.fd

fn main(): I32
  h: = H::{ .fd = 1 }
  $total: = mk(h).get()
  total += mk(h).get()
  g: = H::{ .fd = 2 }
  total += mk(g).n + mk(g).n
  k: = H::{ .fd = 0 }
  $xs: I32[4] = ::{}
  _p: = xs[mk(k).n]@
  _q: = xs[mk(k).n]@
  j: = H::{ .fd = 3 }
  total += V::{ .h = j }.peek()
  return total + V::{ .h = j }.peek()
// ==== case move_only_use_after_move
//< Copying a `Move_only` value moves it, so the original binding cannot be used after that
//< Allow the copy and the owning handle is duplicated: both release, destroying the same OS object
//< or memory twice. `thread.Mutex<|T|>` holds a `Raw_mutex`, which conforms to `Move_only`, as a
//< value field, so it is Move_only structurally.
// EXPECT: was moved out of and cannot be used again
import "std/thread"

fn main()
  $mx: = thread.Mutex<|I32|>(0) catch
    return
  $copy: = mx
  copy.unlock()
  mx.unlock()

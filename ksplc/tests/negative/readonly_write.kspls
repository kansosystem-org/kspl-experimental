//< One subject per file, with one function for each case
//<
//< The file's marks are every case's marks gathered at the head. The same mark written N times
//< must match N places.
// EXPECT: cannot write through a read-only pointer
// EXPECT: cannot write through a read-only pointer
// EXPECT: cannot write through a read-only pointer
// EXPECT: cannot write to an element of a read-only slice or array

// The shape writing through a read-only pointer (`T@`) by way of a `$` (an explicit dereference).
// It is a verification paired with const_ptr_field_write.kspls (by way of a `.`), confirming that
// the `$` side's road is shut too (both are shapes that easily pass through).
fn case_const_ptr_deref_write()
  x: I32 = 1
  p: I32@ = I32@::x@
  p$ = 5

// A derivation of the above (const_ptr_in_struct_field_write.kspls), for writing into a "field" at
// the target. `s.p.n = v` holds two pointer crossings on its road (`s` and `s.p`), and the latter
// is immutable.
// Having seen the first crossing (`s` being a mutable pointer) it cut short at "a pointer was
// crossed, so the binding's mutability is not asked about", and did not look at `s.p` midway
// being immutable.
struct Inner
  n: I32

struct S
  p: Inner@

fn write_through_field(s: S$@)
  s.p.n = 1

fn case_const_ptr_in_struct_field_member_write(): I32
  $i: Inner = Inner::{ .n = 0 }
  s: = S::{ .p = i@ }
  s@.write_through_field()
  return i.n

// The shape taking an element out by an index (a read-only pointer `I32@`) and writing into its
// target. The array itself and the element's slot are mutable (`I32@[2]`), but what the element
// points at is immutable, so it is refused.
// The regression: the same fail-open as const_ptr_nested_deref_write.kspls. write_target_type
// returned unknown on a `[` (an index) too, so the check was given up and on the LLVM backend the
// write held.
$g: I32 = 1

fn case_const_ptr_via_subscript_write()
  $arr: I32@[2] = ::{ g@, g@ }
  arr[0]$ = 99 // invalid: what the element points at is read-only

// A write to an element of a read-only slice. Even with the bounds check passing, it can foul
// read-only data such as a string literal directly and segfault, so it should be refused.
fn case_const_slice_write()
  s: U8[] = "hello"
  s[0] = U8::'X'

fn main()
  case_const_ptr_deref_write()
  case_const_ptr_in_struct_field_member_write()
  case_const_ptr_via_subscript_write()
  case_const_slice_write()

//< The plain lock (`thread.Raw_mutex`) is an internal part of std/thread and is not published
//<
//< Held apart from what it protects, the compiler cannot notice a caller forgetting lock() and
//< touching the data directly, so only `thread.Mutex<|T|>` (the two as one thing) is published, as
//< in Rust's std (std/docs/DESIGN.md "A mutex makes the lock and what it protects one thing").
// EXPECT: Raw_mutex
import "std/thread"

fn main()
  _m: = thread.Raw_mutex.new() catch
    return

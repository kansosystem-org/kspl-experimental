//< A type built through typedefs is held to the written limit, counted once they are expanded
//< Each typedef stays under `MAX_TYPE_POSTFIX` (ksplc/base/ast.kspl) on its own line, but `Deep`
//< names `Half` and adds as many again: 300 steps. Unchecked, a few such lines made a type
//< thousands of steps deep, which took minutes. `Fits` stops at exactly 256 and is accepted.
// EXPECT: deep_typedef_chain.kspl:10:1: error: type nesting too deep: 'Deep' expands to 300
// EXPECT-NOT: deep_typedef_chain.kspl:11
// EXPECT-NOT: deep_typedef_chain.kspl:12
typedef Base = I32
typedef Half = Base[][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][]
typedef Deep = Half@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
typedef More = Half@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
typedef Fits = More
pub fn main(): I32
    _f: Fits? = .none
    return 0

//< Two instances of one generic that the generated C would spell alike
//< **It imports this package's fixtures** (`../c_name_clash/`), so it compiles where it stands.
//< Unrefused, the second instance is merged into the first, and runs the first's body.
// EXPECT: _size_of_ksplc_tests_c_name_clash_a_b_c_Foo' in the generated C, and so does
import "ksplc/tests/c_name_clash/a/b_c" as two
import "ksplc/tests/c_name_clash/a_b/c" as one

fn size_of<|T|>(): Sz
    return sizeof(T)

fn main(): I32
    return I32::(size_of<|one.Foo|>() + size_of<|two.Foo|>()) - 8

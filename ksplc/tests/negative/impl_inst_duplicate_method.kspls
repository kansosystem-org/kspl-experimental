//< Two impls that define the same method name are rejected
//<
//< The template's table overwrites by name, so **letting it through leaves only the one collected
//< later, and the earlier implementation is written yet does not take effect** (Principle 5).
// EXPECT: method 'doubled' is already defined for this type
import "std/io"

pub struct Boxed<|T|>
  pub val: T

impl<|T|> Boxed<|T|>
  pub fn doubled(r: Self): T
    return r.val

impl Boxed<|I8|>
  pub fn doubled(r: Self): I8
    return r.val * 2I8

fn main(): I32
  io.out().s("unreachable\n")
  return 0

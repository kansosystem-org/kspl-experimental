//< ARC's retain/release are an internal protocol only the compiler calls; a user cannot
//<
//< Called by hand they double up with the inserted ones, and the automatic release writes into
//< memory an explicit one freed (use-after-free). The conforming impl's methods are priv, so a
//< direct call is refused (`case_trait_method_priv_upcast` in trait_shape.kspls covers an upcast).
// EXPECT: cannot access symbol
import "std/refcount" { Rc }

fn main()
  $a: = Rc<|I32|>.new(1)
  a.retain()

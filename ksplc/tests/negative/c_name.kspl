//< A name the generated C would spell like one the program does not declare
//< The two-declaration meetings stand in their own files (`c_name_types_meet.kspl`,
//< `c_name_instances_meet.kspl`), since they import this package's folders.
// ==== case bounds
//< A function of the file `bounds` spelled like the C runtime's bounds check
//< The case's name is the file's, so `check` is `kspl_bounds_check` in C. Unrefused, the C compiler
//< reports "conflicting types", inside the runtime.
// EXPECT: 'check' takes the name 'kspl_bounds_check' in the generated C, and so does the C runtime
fn check(): I32
    return 3

fn main(): I32
    return check() - 3
// ==== case type_meets_array
//< A struct spelled like the C struct of an array of another struct
//< `Foo[4]` is the C struct `<file>_Foo_Array_4`. Unrefused, C defines that struct twice.
// EXPECT: 'Foo_Array_4' takes the name 'type_meets_array_Foo_Array_4' in the generated C, and so does 'type_meets_array.Foo$[4]'
struct Foo
    x: I32

struct Foo_Array_4
    y: I64

fn main(): I32
    $a: Foo[4] = ::{}
    a[1].x = 5
    b: = Foo_Array_4::{ .y = 7 }
    return a[1].x + I32::b.y - 12

//< Operator overloading covers only the traits of `std/lang` themselves
//<
//< A same-named trait in one's own file does not desugar `a + b` / `T::v` / `a[i]`. Decided by a
//< name suffix match (`.Add`), it is misread as the operator trait: no KSPL diagnostic, and the
//< **invalid C** taking the receiver for a fat pointer fails as a clang error no user can map.
// EXPECT: requires
// EXPECT: to implement 'Add' interface
pub trait Add
  fn add(r: Self, o: Self): Self

pub struct V
  pub x: I32

impl V: Add
  pub fn add(r: Self, o: Self): Self
    return ::{ .x = r.x + o.x }

fn main()
  a: V = ::{ .x = 1 }
  b: V = ::{ .x = 2 }
  _c: = a + b

//< A closure written behind a call's `)` in the brace notation
//<
//< The same settlement as `laid_trailing_closure_absent.kspls`: the Note is the notation's, not the
//< layout's, so the brace notation gets it too (`forbidden_spelling_hint` in
//< `../../parse/syntax_msg.kspls`).
// EXPECT: error
// EXPECT: KSPL has no trailing closure
priv fn count_over(xs: I32[], pred: Callable1<|I32, Bool|>): Sz {
    return xs.len;
}

fn main(): I32 {
    xs: = I32[]::{ 3, 9, 6 };
    big: = count_over(xs) fn(x: I32; ): Bool { return x > 4; };
    return I32::big;
}

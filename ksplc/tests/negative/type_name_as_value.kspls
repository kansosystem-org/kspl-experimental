//< A type's own name is not a value, so a declaration set to one has no type to take
//<
//< Let through, a primitive reaches genc as a bare `Primitive_type` node (an ICE) and a declared
//< type emits an undefined C symbol, a C compiler error instead of a diagnostic (Principle 8 in
//< `../../../docs/DESIGN.md`). A primitive, a declared type and `Self` resolve by three roads.
// EXPECT: 'Sz' names a type, and a type is not a value
// EXPECT: cannot infer type for
// EXPECT-NOT: [ICE]
priv struct Row
  text: U8[]

impl Row
  fn probe(r: Self@): Sz
    b: = Self
    return r.text.len + Sz::b

fn main(): I32
  p: = Sz
  d: = Row
  r: Row = ::{ .text = "x" }
  return I32::(r.probe() + Sz::p + Sz::d)

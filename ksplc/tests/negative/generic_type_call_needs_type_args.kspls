//< A call through a generic type writes the type's type arguments on it; nothing else binds them
//<
//< Each instance has its own copy of each method, and the call's arguments do not choose one: the
//< refusal says what to write. Let through, the name reached the lookup without any instance and
//< was reported as an undefined path, and a method's own type arguments after a type's that
//< declares none would bind nothing (Principle 5).
//< Caution: Keep the passing side: the method's own are inferred from the arguments, through a
//< generic type's instance and through a plain type alike.
// EXPECT: generic type 'Box' needs its type arguments before 'keep' can be called through it
// EXPECT: call one instance's, 'Box<|…|>.keep(…)', with a type written for each of 'T'
// EXPECT: generic type 'Box' needs its type arguments before 'pair' can be called through it
// EXPECT: generic type 'Option' needs its type arguments before 'some' can be called through it
// EXPECT: function 'Box.keep' is not generic, so '<|U8|>' names nothing: drop it
// EXPECT-NOT: undefined path
// EXPECT-NOT: undeclared
priv struct Box<|T|>
    v: T

impl<|T|> Box<|T|>
    fn keep(x: T): T
        return x
    fn pair<|U|>(_x: T, y: U): U
        return y

priv struct Plain
    v: I32

impl Plain
    fn same<|T|>(x: T): T
        return x

priv fn bare_static(): I32
    return Box.keep(1)

priv fn bare_generic_method(): I32
    return Box.pair(1, 2)

priv fn bare_enum(): Option<|I32|>
    return Option.some(1)

priv fn stray_own(): I32
    return Box<|I32|>.keep<|U8|>(1)

fn main(): I32
    // The passing side.
    w: U16 = 300
    return I32::Box<|I32|>.pair(1, w) + I32::Plain.same(w)

//< Errors: `catch`, results and the error cap
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case catch_block_without_fallback
//< A `catch` block whose value can be read must provide one
//<
//< Falling off its end leaves the binding the zero value in silence, while `catch alt()` hands the
//< value over (Principle 8 in `../../../docs/DESIGN.md`); `catch { }` reads as "ignore the failure"
//< and is the same hole. The four shapes handing the value to nobody must pass (the `EXPECT-NOT`).
// EXPECT: 'catch' is expected to produce 'std_lang_Slice_U8_Const'
// EXPECT: without 'fallback'
// EXPECT-NOT: produce 'Sz'
import "std/io"

priv fn counted(): Sz!io.Io_error
  body: = io.read_file("/nowhere/at/all")!
  return body.len

fn main(): I32
  worked: = io.read_file("/nowhere/at/all") catch
    io.out().s("it failed\n")
  quiet: = io.read_file("/nowhere/at/all") catch {}
  _unread: = counted() catch {}
  counted() catch {}
  // These two are read, so what lets them stand is that the handler never finishes: one leaves by
  // a call declaring `#noreturn`, the other by a loop with no condition and no `break`.
  from_panic: = counted() catch
    panic("this fixture is never run")
  from_loop: = counted() catch
    for {}
  io.out().s("\{worked.len\}/\{quiet.len\}/\{from_panic\}/\{from_loop\}\n")
  return 0
// ==== case catch_on_non_result
//< A `catch` cannot be written on an expression that is not a Result
//<
//< **The same check as `!`'s is wanted on both** (sema/body/postfix.kspls, infer_catch_chain in
//< sema/body/expr.kspls): with one alone the C compiler falls on the generated C, no diagnostic
//< from ksplc (Principle 2). An index is trodden too, and a `catch` on a Result has to pass.
// EXPECT: 'catch' operator can only be applied to a Result type
// EXPECT-NOT: is_err
import "std/ds" { Map, List }
import "std/io"
import "std/mem" { Arena }

priv enum Probe_error
  nope

priv fn plain(x: I32): I32
  return x + 1

priv fn may_fail(x: I32): I32!Probe_error
  if x < 0
    throw Probe_error.nope
  return x + 1

fn main(): I32
  ar: = Arena.new(4096)
  $xs: = List<|I32|>.new(ar)
  xs.push(7)
  // The stopping side ①: a function call that does not return a Result.
  bad_call: = plain(1) catch -1
  // The stopping side ②: an index that returns a value.
  bad_index: = xs[0] catch -1
  // The passing side ①: a fallback expression on an expression returning a Result.
  ok_expr: = may_fail(1) catch -1
  // The passing side ②: a fallback statement on an expression returning a Result.
  ok_block: = may_fail(-1) catch e
    io.out().s("\{e\}\n")
    fallback -2
  // The passing side ③: a Result by way of a generic instantiation (`Map.get` returns
  // `V!Ds_error`).
  $m: = Map<|U8[], I32|>.new(ar)
  m["k"] = 9
  ok_map: = m["nope"] catch -3
  io.out().s("\{bad_call\}\{bad_index\}\{ok_expr\}\{ok_block\}\{ok_map\}\n")
  ar.free()
  return 0
// ==== case catch_substitute_wrong_type
//< A `catch`'s substitute has the success type, so a float does not stand in for an `I32`
//<
//< **Let it through and the backends part**: C keeps 2 from `2.5`, LLVM emits `i32 2.5`, which
//< does not build. A float literal takes no integer type anywhere (`x: I32 = 2.5`, an argument).
// EXPECT: implicit conversion between 'F64' and 'I32' is forbidden
// EXPECT-NOT: error: expected
enum E
  bad

fn f(i: I32): I32!E
  if i < 0
    throw E.bad
  return i

fn take(x: I32): I32
  return x

fn main(): I32
  v: = f(-1) catch 2.5
  w: = f(-1) catch e
    fallback 4.5
  x: I32 = 2.5
  return v + w + x + take(3.5)
// ==== case error_cap_counts_itself
//< Compilation stops at 50 errors, the cap's own line being the 50th
//<
//< **Counted apart from the 50, the summary says 51** while the specification promises 50
//< ("Compilation stops at 50 errors" in ksplc/docs/SPEC-tools.md).
// EXPECT: Too many errors (>= 50). Further errors are suppressed.
// EXPECT: Finished with 50 error(s)
// EXPECT-NOT: Finished with 51
fn main()
  _v00: I32 = true
  _v01: I32 = true
  _v02: I32 = true
  _v03: I32 = true
  _v04: I32 = true
  _v05: I32 = true
  _v06: I32 = true
  _v07: I32 = true
  _v08: I32 = true
  _v09: I32 = true
  _v10: I32 = true
  _v11: I32 = true
  _v12: I32 = true
  _v13: I32 = true
  _v14: I32 = true
  _v15: I32 = true
  _v16: I32 = true
  _v17: I32 = true
  _v18: I32 = true
  _v19: I32 = true
  _v20: I32 = true
  _v21: I32 = true
  _v22: I32 = true
  _v23: I32 = true
  _v24: I32 = true
  _v25: I32 = true
  _v26: I32 = true
  _v27: I32 = true
  _v28: I32 = true
  _v29: I32 = true
  _v30: I32 = true
  _v31: I32 = true
  _v32: I32 = true
  _v33: I32 = true
  _v34: I32 = true
  _v35: I32 = true
  _v36: I32 = true
  _v37: I32 = true
  _v38: I32 = true
  _v39: I32 = true
  _v40: I32 = true
  _v41: I32 = true
  _v42: I32 = true
  _v43: I32 = true
  _v44: I32 = true
  _v45: I32 = true
  _v46: I32 = true
  _v47: I32 = true
  _v48: I32 = true
  _v49: I32 = true
  _v50: I32 = true
  _v51: I32 = true
  _v52: I32 = true
  _v53: I32 = true
  _v54: I32 = true
  _v55: I32 = true
  _v56: I32 = true
  _v57: I32 = true
  _v58: I32 = true
  _v59: I32 = true
// ==== case question_after_value
//< A `?` after a value is refused: it marks an optional type, and `f()!` passes a failure on
//<
//< Rust's `f()?` is the likely slip (`forbidden_spelling_hint` in `../../parse/syntax_msg.kspls`).
// EXPECT: question_after_value.kspls:10:13: error: expected
// EXPECT: '?' marks an optional type ('I32?' is 'Option<|I32|>') and does nothing after a value
fn h(): I32!I32
    return 1

fn g(): I32!I32
    a: = h()?
    return a
// ==== case result_error_type_optional
//< `T!E?` is refused: `?` would fold into the error type, which cannot be optional
//<
//< The note names both readings the writer may have meant.
// EXPECT: result_error_type_optional.kspls:9:12: error: an error type cannot be optional
// EXPECT: an optional result is written '(T!E)?', and a result whose value may be absent 'T?!E'
enum E
    bad

fn g(): I32!E?
    return 1
// ==== case result_type_spelled_whole
//< A Result type is spelled with its error type, `I32!I32`, never `I32!`
//<
//< **The language has no `T!` shorthand**, so a diagnostic writing `I32!` names a type nobody
//< can write (`display_type_to` in `ksplc/sema/type/display.kspls`).
// EXPECT: function 'g' is expected to return 'I32!I32', but control may reach the end
// EXPECT-NOT: 'I32?'
fn g(): I32!I32
  _x: = 1

fn main()
  _v: = g() catch 0
// ==== case result_written_with_question
//< The old result spelling `I32?I32` names the `!` form: `I32?` is an optional, and whole
//<
//< The failure lands on the name after it (`forbidden_spelling_hint` in
//< `../../parse/syntax_msg.kspls`).
// EXPECT: result_written_with_question.kspls:7:13: error: expected
// EXPECT: a result is written with '!' ('I32!Io_error'); 'I32?' is an optional, and no name follows it.
fn h(): I32?I32
    return .some(1)
// ==== case sugar_spelled_out
//< A slice or an optional spelled out as a type is refused, naming the short form
//<
//< Every place a type is written is refused: a field, a `typedef`'s right side, a parameter, a
//< return type, a type argument (an expression's included), a grouped result or function type and
//< an `impl`'s target. An expression whose head is `Option` keeps the long form, as no postfix can
//< stand there, and the types `T?` and `T[]` fold into are not refused (`kept` and `short`).
// EXPECT: sugar_spelled_out.kspls:30:9: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspls:31:10: error: a slice type is written 'T[]'
// EXPECT: sugar_spelled_out.kspls:33:17: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspls:35:17: error: a slice type is written 'T[]'
// EXPECT: sugar_spelled_out.kspls:37:20: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspls:37:36: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspls:42:18: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspls:45:17: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspls:48:19: error: a slice type is written 'T[]'
// EXPECT: sugar_spelled_out.kspls:55:11: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspls:62:20: error: an optional type is written 'T?'
// EXPECT: sugar_spelled_out.kspls:64:19: error: a slice type is written 'T[]'
// EXPECT: Finished with 12 error(s)
// EXPECT-NOT: sugar_spelled_out.kspls:52:
// EXPECT-NOT: sugar_spelled_out.kspls:63:
// EXPECT-NOT: sugar_spelled_out.kspls:68:
import "std/ds" { List }
import "std/mem" { Arena }

enum Fault
  lost

struct Slot<|T|>
  held: Option<|T|>
  items: Slice<|T|>

typedef Maybe = Option<|I32|>

typedef Bytes = Slice<|$U8|>

priv fn doubled(x: Option<|I32|>): Option<|I32|>
  if v: = x
    return .some(v * 2)
  return .none

priv fn tried(): Option<|I32!Fault|>
  return .none

priv fn step(): Option<|fn(n: I32): I32|>
  return .none

priv fn total(xs: Slice<|I32|>): Sz
  return xs.len

impl<|T|> Slot<|T|>
  priv fn kept(r: Self): T?
    return r.held

impl<|T|> Option<|T|>
  priv fn spelled(r: Self): Bool
    return r.is_some()

priv fn empty(): Sz
  arena: = Arena.new(4096)
  defer arena.free()
  spelled: = List<|Option<|F32|>|>.create(arena)
  short: = List<|F32?|>.create(arena)
  sliced: = List<|Slice<|U8|>|>.create(arena)
  return spelled.len + short.len + sliced.len

fn main(): I32
  held: = Option<|I32|>.some(1)
  none: Maybe = .none
  if doubled(none).is_some() || tried().is_some() || step().is_some() || held.spelled()
    return 1
  return I32::empty()

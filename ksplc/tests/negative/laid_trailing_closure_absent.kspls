//< A closure written after a call's `)`, as Swift and Kotlin allow
//<
//< KSPL has none ("Appendix A: Features not carried, and what to write instead" in
//< `../../../docs/SPEC-language.md`). Alone, the expectation set asks for a `;`, so a Note names
//< it and two forms instead (`forbidden_spelling_hint` in `../../parse/syntax_msg.kspls`).
// EXPECT: KSPL has no trailing closure
// EXPECT: bind it to a name first
priv fn count_over(xs: I32[], pred: Callable1<|I32, Bool|>): Sz
  $n: Sz = 0
  for x in xs
    if pred.call(x)
      n += 1
  return n

fn main(): I32
  xs: = I32[]::{ 3, 9, 6 }
  floor: = 4
  big: = count_over(xs) fn(x: I32; floor: I32): Bool
    return x > floor
  return I32::big

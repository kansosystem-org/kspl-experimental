//< The shape that dropped a closing bracket
//<
//< Not the `;` alone: a `)` closing a run and a `}` closing a step are buried at the tail for the
//< same reason (an outer rule piles them). The `,` and the operators miss on the "it may be
//< absent" side and only the `)` stops the parse, so the `)` must lead the expectations.
// EXPECT: expected ')',
// EXPECT-NOT: expected ',',
fn takes(x: I32, y: I32): I32 {
  return x + y;
}

fn main(): I32 {
  return takes(1, 2 - 3;
}

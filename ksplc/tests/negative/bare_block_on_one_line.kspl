//< The same bare block, written on one line
//<
//< **This is the shape a check reading the text alone walks past** — it looks for a `{` standing
//< alone on its line, and here there is none. The parse stops at the `{` either way
//< (`forbidden_spelling_hint` in `../../parse/syntax_msg.kspls`).
// EXPECT: a bare block carries a label
fn main(): I32 {
  before: I32 = 1;
  { before += 1; }
  return before - 2;
}

//< Attributes: where `#` attributes may stand and what each takes
//<
//< Each case below is compiled alone, as the file its head names.
// ==== case attr_align_not_power_of_two
//< The N of `#align(N)` being positive is not enough; it has to be a power of two
//<
//< **Let it through and it falls on the C compiler's side.** And where it was put on a variable,
//< the place it falls is a line of the generated C, so the `.kspl` that was written cannot be
//< reached (docs/DESIGN.md Principle 5).
// EXPECT: '#align(N)' needs N to be a positive constant power of two
// EXPECT-NOT: requested alignment
#align(3)
priv struct S
  v: I32

fn main(): I32
  s: S = ::{}
  return s.v
// ==== case attr_cfg_boolean_operator
//< `#cfg(a && b)` is not accepted either
//<
//< Before, it gated on the first identifier alone and the remaining attribute expression fell
//< straight into the generated C, becoming "a C error absent from the KSPL source".
// EXPECT: '#cfg' takes exactly one flag name
#cfg(alpha && beta)
fn combined(): I32
  return 1

fn main(): I32
  return combined()
// ==== case attr_cfg_comparison
//< `#cfg(sizeof(Sz) == 8)` is not accepted either
//<
//< `#cfg` drops before declarations are gathered, when no name or type is resolved, so a comparison
//< has no material. The refusal names a destination: `##error(cond, msg)`, evaluated after the
//< types are attached, takes a comparison (and sounds if it misses).
// EXPECT: '#cfg' takes exactly one flag name
// EXPECT: ##error(cond, msg)
#cfg(sizeof(Sz) == 8)
fn only_on_64bit(): I32
  return 1

fn main(): I32
  return only_on_64bit()
// ==== case attr_cfg_extern_block_dropped
//< A `#cfg` put on an `extern` block drops the whole block
//<
//< The declarations inside need not be written one by one.
//< The flag not standing, the names inside exist nowhere.
// EXPECT: undefined path or identifier 'kspl_cfg_probe_a'
#cfg(cfg_probe_flag)
extern "C"
  pub fn kspl_cfg_probe_a(): I32
  pub fn kspl_cfg_probe_b(): I32

fn main(): I32
  return kspl_cfg_probe_a()
// ==== case attr_cfg_extern_block_kept
//< The opposite case
//<
//< Where the flag stands, the block's content stays as it is (get the argument count wrong and it
//< is properly type-checked). Had it dropped, it would be a different diagnostic, "undefined".
// ARGS: --define=cfg_probe_flag
// EXPECT: argument count mismatch. Expected 0, but got 2
#cfg(cfg_probe_flag)
extern "C"
  pub fn kspl_cfg_probe_a(): I32

fn main(): I32
  return kspl_cfg_probe_a(1, 2)
// ==== case attr_cfg_logical_combination
//< `#cfg`'s argument is only "one flag name" or "`!` and one flag name"
//<
//< There is no logical combination.
//< Accept it in silence and `all(a, b)` is read as "a flag named `all`", so unless `all`
//< is defined this declaration always vanishes. Whoever wrote it meaning AND gets no clue at all.
// EXPECT: '#cfg' takes exactly one flag name
#cfg(all(alpha, beta))
fn combined(): I32
  return 1

fn main(): I32
  return combined()
// ==== case attr_fn_align_llvm_backend
//< An `#align(N)` on a function is an error on the LLVM backend
//<
//< genc merely copies the expression into C as it stands, so the constant value is kept nowhere.
//< The LLVM side needs a number and cannot emit one, so rather than dropping it in silence it is
//< an error. An `#align(N)` on a struct is folded by sema, so it takes effect on both backends.
// ARGS: --to=llvm
// EXPECT: attribute '#align' is only implemented by the C backend
#align(16)
fn hot() {}

fn main(): I32
  return 0
// ==== case attr_interrupt_llvm_backend
//< `#interrupt` is implemented only on the C backend (LLVM IR has no portable counterpart)
//<
//< An attribute taking effect on one backend alone is believed to be in effect by whoever wrote it,
//< so rather than being ignored in silence it is an error.
// ARGS: --to=llvm
// EXPECT: attribute '#interrupt' is only implemented by the C backend
#interrupt
fn on_tick() {}

fn main(): I32
  return 0
// ==== case attr_link_not_a_name
//< `#link` takes one library name as `-l` does: not a flag, a file, a path, or two names
//<
//< The name reaches the link line as the one word `-l<name>`, and a build script's shell as a word
//< (`$(cat prog.libs)`). A flag or a search path in the source is a link line for one machine only.
//< The rule is `is_library_name` in `ksplc/base/ast_ext.kspls`.
// EXPECT: '#link' takes one library name, as a string
// EXPECT: '#link' takes one library name, as a string
// EXPECT: '#link' takes one library name, as a string
// EXPECT: '#link' takes one library name, as a string
// EXPECT: '#link' takes one library name, as a string
// EXPECT: '#link' takes one library name, as a string
// EXPECT: '#link' takes one library name, as a string
#link("-lopenblas")
extern "C"
  fn flag_given(): I32

#link("libopenblas.so")
extern "C"
  fn file_given(): I32

#link("/opt/blas/lib/openblas")
extern "C"
  fn place_given(): I32

#link(openblas)
extern "C"
  fn name_unquoted(): I32

#link("ssl", "crypto")
extern "C"
  fn two_given(): I32

#link
extern "C"
  fn none_given(): I32

#link("open blas")
extern "C"
  fn split_in_two(): I32

fn main(): I32
  return 0
// ==== case attr_noreturn_comes_back
//< A `#noreturn` function is refused each way control comes back: `return`, `throw`, `!`, its end
//<
//< C trusts the attribute and only warns, and a caller compiled on the promise runs on into
//< whatever follows the call. A function literal inside is a body of its own; the passing side ends.
// EXPECT: attr_noreturn_comes_back.kspls:18:9: error: 'return' returns to the caller, but the function is declared '#noreturn'
// EXPECT: attr_noreturn_comes_back.kspls:22:5: error: 'throw' returns to the caller
// EXPECT: attr_noreturn_comes_back.kspls:27:11: error: '!' returns to the caller
// EXPECT: function 'case_falls_off' is declared '#noreturn', but control may reach the end of its body
// EXPECT: Finished with 4 error(s)
import "std/sys"

priv enum Er
    bad

#noreturn
priv fn case_return(n: I32)
    if n > 0
        return
    sys.exit(2)
#noreturn
priv fn case_throw(): I32!Er
    throw .bad
priv fn may(): I32!Er
    return 1
#noreturn
priv fn case_propagate(): I32!Er
    _x: = may()!
    for {}
#noreturn
priv fn case_falls_off(n: I32)
    if n > 0
        sys.exit(1)
#noreturn
priv fn ends(n: I32)
    _inner: = fn(): I32
        return 1
    if n > 0
        sys.exit(1)
    else
        panic("stop")

fn main()
    if sys.args().len > 5
        case_return(1)
        case_throw() catch 0
        case_propagate() catch 0
        case_falls_off(1)
    ends(1)
// ==== case attr_on_extern_struct
//< No attribute (other than `#cfg`) can be written on an `extern` struct
//<
//< The generated C puts out only a forward declaration (`typedef struct X X;`), so neither an
//< attribute settling the layout nor a mark attached to the name has anywhere to reach. Ignored in
//< silence, whoever wrote it goes on believing it is in effect.
// EXPECT: attribute '#align' cannot be written on an 'extern' struct
// EXPECT: attribute '#packed' cannot be written on an 'extern' struct
// EXPECT: attribute '#deprecated' cannot be written on an 'extern' struct
// EXPECT-NOT: [
extern "C"
  #align(8)
  struct Aligned_c
  #packed
  struct Packed_c
  #deprecated
  struct Old_c

fn main(): I32
  return 0
// ==== case attr_on_fn
//< One subject, with one function for each of its shapes
//<
//< The marks are every function's marks gathered at the head. The same mark written N times
//< must match N places.
// EXPECT: attributes '#inline' and '#noinline' contradict each other
// EXPECT: attribute '#export' has no effect on a 'priv' declaration

// `#inline` and `#noinline` say opposite things. Which wins where both can be written appears
// nowhere in the code, so the loser is left believed to be in effect as well (Principle 5).
#inline
#noinline
priv fn twice(a: U32): U32
  return a * 2

fn case_attr_inline_noinline_conflict(): I32
  return I32::twice(2)

// `priv` is the setting that nobody outside this file can use it, and a free function becomes
// `static` (internal linkage) in the generated C too. Put the name out plainly and it still
// cannot be joined from outside (it does not appear at the exit on wasm either). It is a spelling
// where nothing happens when written, so it is refused (Principle 5).
// To put it out to C or
// wasm, unspecified is enough; `pub` is for putting it out to KSPL's other packages.
#export
priv fn hidden_but_exported(): I32
  return 1

fn case_export_priv(): I32
  return hidden_but_exported() - 1

fn main()
  case_attr_inline_noinline_conflict()
  case_export_priv()
// ==== case attr_on_stmt_wrong
//< The only attribute writable on a statement is `#cfg`
//<
//< Anything else has nobody to read it there, so it is an error as on a declaration.
//< Caution: **The spelling check must take effect here too.** Normalisation eats `#cfg` and sema
//< picks the rest up (elide_attributed_stmt in ksplc/parse/normalize.kspls), or they vanish.
// EXPECT: attribute '#inline' does nothing here; it applies to functions
// EXPECT: attribute '#export' does nothing here; it applies to functions, variables, and constants
// EXPECT: unknown attribute '#inlne'
import "std/io"

fn main(): I32
  #inline
  io.out().s("unreachable\n")

  #export
  #cfg(!never_defined)
  if true
    io.out().s("unreachable\n")

  #inlne
  return 0
// ==== case attr_section_needs_noinline
//< A function's `#section` takes effect only when paired with `#noinline`
//<
//< An optimising C compiler expands the body into the caller, so the named section holds nothing
//< (under `-Os` it vanishes). Let through in silence, whoever placed it believes it is there; on
//< bare metal, code meant to run while XIP is stopped still executes from Flash (Principle 5).
// EXPECT: attribute '#section' on a function needs '#noinline' as well
#section(".ram_text")
priv fn burn(a: U32): U32
  return a + 1

fn main(): I32
  return I32::burn(1)
// ==== case attr_section_not_a_name
//< `#section` takes one plain name of letters, digits, `_` and `.`
//<
//< The name reaches the C, the LLVM IR and the assembler's `.section` line as written. A quote, a
//< `\`, a trigraph (`??/` under `-std=c99`) or a `;` would end it early, and what followed would be
//< code the source never declared. The rule is `is_section_name` in `ksplc/base/ast_ext.kspls`.
// EXPECT: '#section' takes one section name, as a plain string
// EXPECT: '#section' takes one section name, as a plain string
// EXPECT: '#section' takes one section name, as a plain string
// EXPECT: '#section' takes one section name, as a plain string
// EXPECT: '#section' takes one section name, as a plain string
#section("??/\") I32 kspl_injected; I32 g_trigraph; //")
$g_trigraph: I32 = 1

#section(".data; .text")
$g_semicolon: I32 = 1

#section("")
$g_empty: I32 = 1

#section(data)
$g_unquoted: I32 = 1

#section(".a", ".b")
$g_two: I32 = 1

#section(".ram_text")
$g_fine: I32 = 1

fn main(): I32
  return g_trigraph + g_semicolon + g_empty + g_unquoted + g_two + g_fine
// ==== case attr_wrong_target
//< An attribute is accepted only at a position listed in its "target" field
//<
//< The table in chapter 10 of docs/SPEC-language.md. An attribute at the wrong position has its
//< spelling and name right, so letting it through in silence leaves no clue that "it is written
//< yet nothing happens" (Principle 5).
// ==========================================
// EXPECT: attribute '#inline' does nothing here; it applies to functions
// EXPECT: attribute '#packed' does nothing here; it applies to structs
// EXPECT: attribute '#interrupt' does nothing here; it applies to functions
// EXPECT: attribute '#deprecated' does nothing here
// EXPECT: attribute '#align' does nothing here; it applies to structs, functions, variables, and
// constants
// EXPECT: attribute '#link' does nothing here; it applies to 'extern' blocks
// ==========================================
import "std/io"

#inline
pub struct S
  pub a: I32

#packed
pub fn takes(p: I32): I32
  return p

#interrupt
pub const limit: I32 = 4

// A `typedef` does not appear inside an expression, so putting the deprecation mark on it leaves
// nowhere for it to sound.
#deprecated
pub typedef Meters = I32

#align(8)
pub enum Kind
  a
  b

// The library a declaration is found in is named on the `extern` block holding it.
#link("m")
pub fn cosine(x: F64): F64
  return x

fn main(): I32
  io.out().s("unreachable\n")
  return 0

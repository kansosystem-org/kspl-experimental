//< That ksplc refuses arithmetic, shifts and the unary `-` / `~` on a `Bool`
//<
//< Unstopped it breaks in silence: `b1 / b2` **falls on SIGFPE** on a false divisor, and
//< `false - true`, `-true` and `~true` give `true`. Comparisons, `& | ^`, `&& ||` and `!` stay; a
//< `Bool[N]` element and an alias are refused too (`is_bool` in `ksplc/sema/type/query.kspl`).

// EXPECT: Operator '+' cannot be applied to 'Bool'
// EXPECT: Operator '-' cannot be applied to 'Bool'
// EXPECT: Operator '*' cannot be applied to 'Bool'
// EXPECT: Operator '/' cannot be applied to 'Bool'
// EXPECT: Operator '%' cannot be applied to 'Bool'
// EXPECT: Operator '<<' cannot be applied to 'Bool'

// EXPECT: Unary operator '-' cannot be applied to 'Bool'
// EXPECT: Unary operator '~' cannot be applied to 'Bool'
// EXPECT: Operator '>>' cannot be applied to 'Bool'
// EXPECT: cannot be applied to 'ksplc.tests.negative.bool_arithmetic.Flag'
// EXPECT-NOT: bool_arithmetic.kspl:1:1
priv const FLAGS: Bool[2] = ::{ true, false }

typedef Flag = Bool

fn main()
    t: Bool = true
    f: Bool = false
    a: = t + f
    b: = t - f
    c: = t * f
    d: = t / f
    e: = t % f
    g: = t << f
    h: = -t
    i: = ~t
    j: = (t == f) && (t < f) && (t & f) && (t | f) && (t ^ f) && !t
    k: = FLAGS[0] >> FLAGS[1]
    m: Flag = true
    n: = m * m
    _all: = a || b || c || d || e || g || h || i || j || k || n

//< A generic's type-argument constraint applies however the type is referred to
//<
//< This fixture covers "an inferred declaration + a static generic call"
//< (`m: = Map<|Point, I32|>.new();`). The type-annotation form (`m: Map<|Point, I32|> = …;`) is
//< not the only one checked.
// ==========================================
// EXPECT: does not explicitly implement interface
// The body of an instantiation whose constraint violation is known is not type-checked. Without
// that, derived errors pointing inside the standard library follow the real diagnostic (the one
// item above) and the reader can no longer tell the cause.
// EXPECT-NOT: has no field or method named 'hash'
// EXPECT-NOT: does not implement required method
// ==========================================
import "std/ds" { Map }

// It holds no hash/equals, so it does not satisfy ds.Hashable.
struct Point
  x: I32

fn main(): I32
  m: = Map<|Point, I32|>.new()
  return I32::m.len

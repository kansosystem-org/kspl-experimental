//< The number of digits after the decimal point is a setting only for floating point
//<
//< Written against an integer it has nowhere to apply, so the desugaring target `fmt_prec` does not
//< resolve and it stops here. Ignored in silence, it becomes "it was written yet nothing happens".
// EXPECT: does not take '.N'
// EXPECT-NOT: [
import "std/io"
import "std/strfmt"

fn main(): I32
  n: I32 = 3
  io.out().s("\{n:.2\}\n")
  return 0

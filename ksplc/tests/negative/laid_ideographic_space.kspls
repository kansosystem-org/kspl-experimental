//< Some characters look like indentation on screen but do not count as indentation
//<
//< **Easiest to tread on with Japanese input: the ideographic space (U+3000).** Only the half-width
//< space counts, so the line sits at column 0, leaves the step, and the syntax error says nothing
//< of the cause; a Note names the character (as Python's `invalid non-printable character U+00A0`).
// EXPECT: an ideographic space (U+3000)
import "std/io"

fn main(): I32
  io.out().s("A\n")
　io.out().s("B\n")
  return 0

//< `unknown type name 'U'` (ksplc/docs/DESIGN.md 2.1).
// EXPECT: too few type arguments for generic 'W': it declares 2, but 1 given
struct W<|T, U|>
  a: T
  b: U
fn main()
  _x: W<|I32|>

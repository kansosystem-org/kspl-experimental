//< The rules on how a default is written apply unchanged to a trait's declaration
//<
//< **The declaration side alone came to be writable, so that it has not loosened there is pinned
//< down.** The shape writing it on the implementation side is param_default_in_trait_impl.kspls.
// EXPECT: a parameter default must be a literal
// EXPECT: a parameter without a default cannot follow one that has a default

priv trait Greeter
  fn greet(r: Self, n: I32 = 1 + 1): I32

priv trait Ordered
  fn pick(r: Self, a: I32 = 1, b: I32): I32

fn main(): I32
  return 0

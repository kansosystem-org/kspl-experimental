//< `--target=llvm` cannot lower that (Field_info's in std/reflect).
// EXPECT: does not cover a list whose element is itself a list

import "std/ds" { List }
import "std/reflect"

priv struct Deep
  rows: List<|List<|I64|>|>

impl Deep: reflect.Reflectable {}

fn main(): I32
  return 0

//< The second file of `tests/suite/file_path_test.kspl`'s program
//< It holds the unmarked declarations the entry file uses from the same package.
struct Holder //< the type main uses, for `tests/suite/file_path_test.kspl`
    //< Caution: **It must have no visibility marker.** The test confirms that the import is seen as
    //< the same package however its path is written; making it `pub` skips the path being checked.
    v: I32

fn held(h: Holder): I32
    return h.v

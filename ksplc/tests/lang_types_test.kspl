//< The language rules around types, places, conversion and visibility, checked by running them
//< The syntax and basic-type rules are in `lang_test.kspl`. A failure here is checked against a
//< different document.
import "std/chars" as std_chars
import "std/ds" { List, Map }
import "std/io"
import "std/mem" + { Arena, dealloc }
import "std/ring"
import "std/str" { Str_builder }
import "std/sys"
import "std/verdict"

// ==========================================

// The slice descriptor literal (`T[]::{ .ptr = ..., .len = ... }`), above all nested (`U8[]$[]`).
// It is the only way to build a slice of a length counted at run time. A field's expected type
// off by one level lets a single-level literal pass **without a type check** ("Immutability
// marks in a type" in ksplc/docs/DESIGN-sema.md).

// ==========================================

// A literal with no field names, given to a slice type, is read as a list of elements.
// Caution: **Test it together with the descriptor literal.** One alone passes green even when
// the field names fail to tell them apart (`U8[]::{ .ptr = …, .len = … }` read as two elements).

priv fn count_of(xs: U8[][]): Sz //<
    //< It returns how many elements xs holds
    //< **Test elements that are identifiers too.** An identifier first is easily read as a field
    //< name, which reaches the C and fails there.
    return xs.len

fn test_slice_elem_literal()
    verdict.start("[Slice] a run of elements handed to a slice type test...")
    assert(count_of(U8[][]::{ "a", "bb", "ccc" }) == 3, "a run of elements passes as a slice")
    chars: = U8[]::{ 'x', 'y' }
    assert(chars.len == 2 && chars[0] == 'x' && chars[1] == 'y',
        "the elements' values and order are kept")
    a: U8 = 'p'
    b: U8 = 'q'
    named_elems: = U8[]::{ a, b }
    assert(named_elems.equals("pq"), "a run of identifiers is a run of elements too")
    $store: U8[4] = ::{ 'w', 'x', 'y', 'z' }
    desc: = U8[]::{ .ptr = store[0]@, .len = 3 }
    assert(desc.equals("wxy"), "a run with names written is a descriptor assembly")
    verdict.pass("a run of elements and a descriptor assembly split by how they are written.")

fn test_slice_descriptor_literals(arena: Arena$@)
    verdict.start("[Slice] the slice descriptor literal test...")

    // Single step: a mutable view from a mutable area, an immutable view from an immutable string.
    raw: = U8$@::arena.alloc(4)
    for i in Range.asc(4)
        (raw + i)$ = ('a' + U8::i)
    mut_view: = U8$[]::{ .ptr = raw, .len = 4 }
    (mut_view.ptr + 0)$ = 'z'
    assert(mut_view.equals("zbcd"), "a single-step mutable view descriptor")

    src: U8[] = "hello"
    imm_view: = U8[]::{ .ptr = src.ptr + 1, .len = 3 }
    assert(imm_view.equals("ell"), "a single-step immutable view descriptor")

    // Nested: a mutable slice of immutable views, counted at run time.
    slots: = U8[]$@::arena.alloc(sizeof(U8[]) * 3)
    (slots + 0)$ = "ab"
    (slots + 1)$ = "cde"
    (slots + 2)$ = ""
    nested: = U8[]$[]::{ .ptr = slots, .len = 3 }
    $total: Sz = 0
    for i in Range.asc(nested.len)
        total += nested[i].len
    assert(total == 5, "a nested slice descriptor can be assembled and each element read")
    assert(nested[1].equals("cde"), "a nested element can be read by subscript too")
    // `.ptr`'s type keeps the element type (`U8[]@`, not `U8@`); the check is that this compiles.
    slot_ptr: U8[]@ = nested.ptr
    assert(slot_ptr.equals("ab"), "a nested `.ptr` is a pointer to the element (an immutable view)")
    assert((nested.ptr + 1).len == 3, "`.len` works on a pointer to a slice too")

    // --- `.` and `[]` through a pointer ---
    // `.` and `[]` dereference a pointer whatever the number of levels. `[]` does so only where the
    // target holds its own length ("Member access and indexing through a pointer" in
    // docs/SPEC-programming-language.md). A built-in member, a subscript and a method all follow it
    // (receiver_base_id in sema/type/env.kspl).
    pm: U8$[]@ = mut_view@
    pi: U8[]@ = imm_view@
    assert(pm.len == 4 && pi.len == 3, "`.len` works on a U8$[]@ / U8[]@")
    (pm.ptr + 1)$ = 'Y'
    assert(mut_view.equals("zYcd"), "a write through a U8$[]@'s `.ptr` reaches the original")
    assert((pi.ptr + 0)$ == 'e', "a U8[]@'s `.ptr` can read the element")
    // A subscript dereferences the same way, as a left side too (`ps[i] = v` reaches the buffer).
    assert(pm[0] == 'z' && pi[0] == 'e', "`[]` works on a pointer to a slice")
    pm[3] = 'W'
    wrote_through_index: = mut_view.equals("zYcW")
    assert(wrote_through_index,
        "a `[]` assignment through a pointer to a slice reaches the original")
    // A multi-level pointer too.
    ppm: U8$[]@@ = pm@
    assert(ppm.len == 4 && ppm[0] == 'z', "`.` and `[]` reach through a multi-step pointer too")

    // --- an empty array literal becomes a slice of length 0 ---
    // Only this shape makes an array type with zero elements (sema rejects a declaration written
    // `T[0]`). C does not allow an array of length 0, so genc puts one element there
    // (gen/c/decl.kspl).
    empty: = U8[]::{}
    assert(empty.len == 0, "an immutable slice made from an empty array literal has length 0")

    verdict
        .pass("a descriptor literal has its fields' types checked whether single-step or nested, \
            and a built-in member works through a pointer too.")

// ==========================================
// An alias carrying an immutable qualifier resolves all the way; the normalization resolves
// aliases and strips qualifiers **in turn**.
// ==========================================
priv typedef Meters = I32

priv fn meters_plus_one(p: Meters@): I32
    return p$ + 1

// ==========================================
// An enum's variant name.
// Caution: **For an enum where the user wrote a `fmt`, that one must win.** Otherwise the format
// written by hand is quietly ignored.
// ==========================================
priv enum Vn_plain
    alpha
    beta(x: I32)
    gamma

priv enum Vn_custom
    one
    two

impl Vn_custom: Formattable
    fn fmt(_r: Self, w: Writer): Writer
        return w.s("<custom>")

fn test_enum_variant_name()
    verdict.start("[enum] the synthesis of a variant name, and interpolation test...")

    a: = Vn_plain.alpha
    b: = Vn_plain.beta(7)
    g: = Vn_plain.gamma
    assert(a.variant_name().equals("alpha"), "variant_name: with no payload")
    b_name: = b.variant_name()
    assert(b_name.equals("beta"), "variant_name: it returns the name alone with a payload too")
    assert(g.variant_name().equals("gamma"), "variant_name: the third variant")

    $sb: = Str_builder.new()
    sb.s("\{a\}/\{b\}")
    assert(sb.slice().equals("alpha/beta"), "interpolation goes through variant_name")

    // The user's fmt wins
    c: = Vn_custom.two
    sb.clear().s("\{c\}")
    assert(sb.slice().equals("<custom>"), "a fmt the user wrote takes priority")
    c_name: = c.variant_name()
    assert(c_name.equals("two"), "variant_name has grown even with a fmt of one's own")

    // On another file's (std's) enum too
    e: I32? = .none
    assert(e.variant_name().equals("none"), "it is synthesized for a generic enum too")

    verdict
        .pass("the synthesized variant_name is right for every variant, interpolation goes through \
            it, and the user's fmt takes priority.")

// ==========================================
// **A container holding** a nested view type **as its element**: "the element is immutable" and
// "its frame is mutable" are separate levels.
// Note: ksplc's own tests reject a write to an element (`make test-place`'s "a step's type").
// ==========================================
fn test_container_of_nested_views(arena: Arena$@)
    verdict.start("[Slice] a container holding nested views as its elements test...")
    $l: = List<|U8[][]|>.new(arena)
    l.push(U8[][]::{ "ab", "cde" })
    l.push(U8[][]::{ "f" })
    assert(l.len == 2, "nested views can be pushed onto a List as elements")
    assert(l.get(0)[1].equals("cde"),
        "a pushed element can be read by subscript down to its inner element")
    assert(l.get(1).len == 1, "the length is kept per element")
    verdict.pass("even with immutable views as the elements, the frame they sit in is mutable.")

fn test_const_alias_resolves_through()
    verdict.start("[Alias] resolving an alias carrying an immutable qualifier test...")
    m: Meters = 41
    assert(meters_plus_one(m@) == 42, "a Meters@'s target can be handled as a number")
    verdict.pass("the alias resolution and the immutable qualifier's peeling work alternately.")

priv struct Alias_box<|T|>
    val: T

priv typedef Named_box = Alias_box<|I32|>
priv typedef Named_error = I32

priv fn base_box_result(v: Alias_box<|I32|>): Alias_box<|I32|>!I32
    return v

priv fn named_box_result(v: Named_box): Named_box!Named_error
    return base_box_result(v)!

priv fn read_named_result(v: Named_box!Named_error): I32
    box: = v catch
        return -1
    return box.val

fn test_alias_as_generic_argument()
    verdict.start("[Alias] aliases and their targets share generic instances...")
    box: = Named_box::{ .val = 7 }
    result: Named_box!Named_error = base_box_result(box)
    assert(read_named_result(result) == 7, "a result annotation accepts the underlying type")
    assert(read_named_result(base_box_result(box)) == 7, "a result argument accepts it too")
    assert(read_named_result(named_box_result(box)) == 7, "the alias also works as a return type")
    nested: Alias_box<|Named_box|> = ::{ .val = box }
    base: Alias_box<|Alias_box<|I32|>|> = nested
    assert(base.val.val == 7, "a nested generic accepts the alias as the same type argument")
    boxes: = Named_box[]::{ box }
    assert(boxes[0].val == 7, "a read-only slice keeps the qualifier around the resolved alias")
    verdict.pass("aliases share result and nested-generic instances with their targets.")

fn test_alias_element_acts_as_its_base() //<
    //< It checks an alias read out of an immutable slice acts as its base type
    //< Caution: **Read the alias out of an immutable slice.** The element is the alias under an
    //< immutable mark. Stripping each once leaves the alias itself, which conforms to nothing.
    //< The interpolation then reports "does not implement 'Formattable'".
    verdict.start("[Alias] an alias read out of an immutable slice acts as its base type test...")
    ms: = Meters[]::{ 3, 4 }
    $b: = Str_builder.new()
    b.s("\{ms[0]\} \{-ms[1]\} \{ms[0] < ms[1]\}")
    assert(b.slice().equals("3 -4 true"), "an element formats, negates and compares as an I32")
    verdict.pass("an alias's element peels to its base however the marks and the alias stack.")

// ==========================================
// A subscript's type is the implementation's `Idx` (`trait Index<|Idx, Output|>`), not `Sz`.
// ==========================================
priv struct Str_keyed
    base: I32

impl Str_keyed: Index<|U8[], I32|>
    fn get(r: Self, key: U8[]): I32
        return r.base + I32::key.len

impl Str_keyed: Index_mut<|U8[], I32|>
    fn set(r: Self$@, key: U8[], value: I32)
        r.base = value - I32::key.len

fn test_index_key_type_follows_the_impl(arena: Arena$@)
    verdict.start("[Index] a subscript's type follows the implementation's declaration test...")
    $t: Str_keyed = ::{ .base = 10 }
    assert(t["abc"] == 13, "an Index implementation taking a non-Sz subscript (U8[]) resolves")
    assert(t[""] == 10, "an empty key works too")
    // Caution: Test both a read and a write. A subscript's type is looked up in two places,
    // `Index.get` and `Index_mut.set`, so with only one the other stays pinned to `Sz`.
    t["xy"] = 20
    assert(t.base == 18, "an Index_mut implementation taking a non-Sz subscript can be assigned to")
    // An instantiated implementation must resolve the same way. Its parameter can hold no copy of
    // the type after substitution. Falling back to `Sz` there rejects the key.
    $m: = Map<|U8[], I32|>.new(arena)
    m["k"] = 9
    assert(m["k"].unwrap_or(-1) == 9, "an instantiated Map<|U8[], I32|> reads and writes with `[]`")
    assert(m["nope"].unwrap_or(-1) == -1, "a missing key reads as none")
    verdict
        .pass("a subscript's expected type is not pinned to Sz but taken from the implementation's \
            declaration.")

// ==========================================
// "A subscript returning a place" (`Index_place`): the shapes that a value get/set
// (`Index` / `Index_mut`) cannot express work on a type implementing `at` as on a built-in slice.
// ==========================================
priv struct Cell
    n: I32

fn test_index_place_gives_real_places(arena: Arena$@)
    verdict.start("[Index_place] a subscript returns the element's \"place\" test...")

    l: = List<|I32|>.create(arena)
    l.push(10)
    l.push(20)

    // (1) a plain assignment
    l[0] = 1
    assert(l[0] == 1, "simple assignment through at() must reach the element")

    // (2) a compound assignment (impossible with a value get/set)
    l[1] += 5
    assert(l[1] == 25, "compound assignment through at() must read-modify-write in place")

    // (3) taking the element's address (with a value get it would be a copy's address)
    p: = l[0]@
    p$ = 7
    assert(l[0] == 7, "the address taken from at() must be the element itself")

    // (4) a struct element's field can be updated directly (without going through a copy)
    cl: = List<|Cell|>.create(arena)
    cl.push(Cell::{ .n = 3 })
    cl[0].n = 99
    assert(cl[0].n == 99, "a field of a struct element must be updatable in place")

    verdict
        .pass("what at() returns is the element's place, and an assignment, a compound assignment \
            and taking an address work just as on a built-in slice.")

// ==========================================
// A template's body is analysed in the template's file, but its `T` is the user's. Cell is
// file_private here, so the visibility check sees std/ds.kspl's body writing `T`.
// ==========================================
fn test_private_type_arg_reaches_template_body(arena: Arena$@)
    verdict.start("[generics] a file_private type argument reaches a template's body test...")

    l: = List<|Cell|>.create(arena)
    l.push(Cell::{ .n = 11 })
    l.push(Cell::{ .n = 22 })

    view: = l.slice()
    assert(view.len == 2, "List.slice must borrow every element")
    assert(view[1].n == 22, "the borrowed view must read the List's own storage")

    view[0].n = 33
    assert(l[0].n == 33, "the view must be a borrow, not a copy")

    verdict
        .pass("a template body instantiated with a file_private type is analysed, and the borrowed \
            view points at the original data.")

// ==========================================
// The NUL check on a string passed across the C boundary. A KSPL slice can contain a NUL, and C
// stops reading at the first one.
// ==========================================
fn test_embedded_nul_is_rejected_at_c_boundary()
    verdict.start("[NUL] the NUL check on a string handed across the C boundary test...")

    assert("ok.txt\0../../etc/passwd".contains_nul(), "contains_nul must detect a NUL")
    assert(!"ok.txt".contains_nul(), "contains_nul must not fire on a clean string")

    // io.open: a path containing a NUL is not opened and becomes an Io_error (C would see only
    // "ok.txt").
    $open_rejected: = false
    io.open("ok.txt\0../../etc/passwd", "r") catch
        open_rejected = true
    assert(open_rejected, "io.open must reject a path containing a NUL")

    // sys.get_env: a name containing a NUL is not looked up and gives .none.
    if _v: = sys.get_env("PATH\0IGNORED")
        panic("get_env must reject a name containing a NUL")

    // A name containing no NUL is looked up.
    switch sys.get_env("PATH")
    case .some {}
    case .none
        panic("get_env must still resolve a clean name")

    verdict
        .pass("a string containing a NUL is not truncated at the C boundary; the conversion itself \
            fails.")
// ==========================================
// A defer's block reads an outer variable when the scope is left, not when the defer was
// registered.
// There is no capture-list notation (`defer a, b { ... }`).
// ==========================================
priv fn defer_sees_value_at_scope_exit(): Sz
    $n: Sz = 1
    $observed: Sz = 0
    until_exit:
        defer observed = n
        n = 100
    return observed

priv fn defer_frees_grown_buffer() //<
    //< It checks a deferred free releases the builder's buffer after it has grown
    //< A frozen copy with `cap == 0` would leak the whole buffer.
    $b: = Str_builder.new()
    for _i in Range.asc(200)
        b.s("0123456789")
    assert(b.slice().len == 2000, "the builder must actually hold the appended bytes")

priv fn defer_explicit_snapshot(): Sz //<
    //< Where the value at registration is needed, the user copies it explicitly
    $n: Sz = 1
    $observed: Sz = 0
    until_exit:
        snapshot: = n
        defer observed = snapshot
        n = 100
    return observed

fn test_defer_reads_values_at_scope_exit()
    verdict.start("[defer] a block reads the value at the moment the scope is left test...")

    at_exit: = defer_sees_value_at_scope_exit()
    assert(at_exit == 100,
        "a defer block must read its variables at scope exit, not at registration")

    heap_before: = mem.heap_used_bytes()
    defer_frees_grown_buffer()
    heap_after: = mem.heap_used_bytes()
    assert(heap_after == heap_before,
        "`defer { b.free(); }` must free the buffer the builder actually owns at scope exit")

    snapshot: = defer_explicit_snapshot()
    assert(snapshot == 1, "an explicitly copied snapshot must keep the value it had at registration")

    verdict
        .pass("it reads the value at the moment of leaving, and the value at registration can be \
            kept by copying it oneself.")
// ==========================================
// The three safe shapes of returning a trait value (a global, the heap, a pointer's target) pass
// the check that stops a value's upcast. That upcast synthesizes `&value` into {obj, vtable}.
// ==========================================
priv struct Up_sq
    n: I32

impl Up_sq: Up_shape
    fn area(r: Self$@): I32
        return r.n * r.n

priv trait Up_shape
    fn area(r: Self): I32

priv struct Up_bare //<
    //< The shape with the methods in the inherent impl and the conforming impl left empty
    //< **A vtable is built from the target type's method table.** Treat an empty conformance as
    //< unused and the C references a vtable that is never emitted.
    n: I32

impl Up_bare
    fn area(r: Self$@): I32
        return r.n + 1

impl Up_bare: Up_shape {}

priv $up_global: Up_sq = ::{ .n = 3 }

priv fn up_from_global(): Up_shape
    return up_global

priv fn up_from_ptr(p: Up_sq$@): Up_shape
    return p

priv fn up_from_pointee(p: Up_sq$@): Up_shape
    return p$

priv struct Up_holder //< holds a conforming value by value, reached through a pointer below
    sq: Up_sq

// A field behind a pointer lives where the pointer points, not in this frame. So it can be
// returned upcast (is_frame_storage in sema/body/stmt_escape.kspl).
priv fn up_from_pointee_field(h: Up_holder$@): Up_shape
    return h.sq

fn test_trait_upcast_lifetimes()
    verdict.start("[trait] the three shapes a value can be returned in test...")

    g: = up_from_global()
    assert(g.area() == 9, "upcasting a global must stay valid after return")

    hp: = mem.alloc_as<|Up_sq|>()
    defer dealloc(Void$@::hp)
    hp.n = 5
    h: = up_from_ptr(hp)
    assert(h.area() == 25, "upcasting a heap pointer must stay valid after return")

    $local: Up_sq = ::{ .n = 4 }
    p: = up_from_pointee(local@)
    assert(p.area() == 16, "upcasting through a pointer must address the pointee, not a frame")

    $holder: Up_holder = ::{ .sq = ::{ .n = 6 } }
    f: = up_from_pointee_field(holder@)
    assert(f.area() == 36, "upcasting a field behind a pointer must address the pointee's field")

    verdict.pass("")

fn test_trait_upcast_from_empty_conformance() //<
    //< The vtable an upcast names is the same one whatever the receiver's immutable qualifier
    //< Caution: **Always include the `@` of an immutable binding.** It is `T immut@`, so stripping
    //< that leaves one level of qualifier passes the mutable-binding and value-only checks and
    //< fails only here.
    verdict.start("[trait] an upcast works even with an empty conforming impl test...")

    $b: Up_bare = ::{ .n = 41 }
    s: Up_shape = b@
    assert(s.area() == 42, "an empty conformance impl must still produce a vtable")

    verdict
        .pass("a type satisfying a conformance with inherent methods can be raised to a trait value \
            too.")

fn test_trait_upcast_ignores_constness()
    verdict.start("[trait] the same vtable is named whatever the immutable qualifier test...")

    immut: Up_sq = ::{ .n = 7 }
    from_const_ptr: Up_shape = immut@
    assert(from_const_ptr.area() == 49, "upcast from an immutable binding's pointer")

    $mut: Up_sq = ::{ .n = 8 }
    from_mut_ptr: Up_shape = mut@
    assert(from_mut_ptr.area() == 64, "upcast from a mutable binding's pointer")

    from_value: Up_shape = immut
    assert(from_value.area() == 49, "upcast from a value")

    verdict.pass("the immutable, the mutable and the value all three resolve to the same vtable.")

priv typedef Up_named = Up_sq

fn test_trait_upcast_through_an_alias_pointer() //<
    //< It checks a pointer to an alias upcasts to a trait as its base type
    //< Caution: **Give the trait a pointer to the alias.** Removing the pointer level leaves the
    //< alias as the conforming type. The conformance check then rejects it ("does not explicitly
    //< implement"), and the vtable is named after the alias, which nothing defines.
    verdict.start("[trait] a pointer to an alias upcasts as its base type test...")

    $named: Up_named = ::{ .n = 6 }
    p: Up_named$@ = named@
    from_ptr: Up_shape = p
    from_binding: Up_shape = named@
    assert(from_ptr.area() == 36 && from_binding.area() == 36,
        "a pointer to an alias reaches its base type's vtable")

    verdict.pass("a pointer to an alias conforms and dispatches as its base type.")
// ==========================================
// A return value needing a conversion inside a Result, such as `Trait!Err` / `Void$@!Err`.
// Against a Result expected type, convert to the ok type first, then wrap. Wrapping only on an
// exact match leaves these functions able only to throw.
// ==========================================
priv enum Wrap_err
    bad

priv $wrap_global: Up_sq = ::{ .n = 6 }

priv fn wrap_from_ptr(p: Up_sq$@): Up_shape!Wrap_err
    return p

priv fn wrap_from_global(): Up_shape!Wrap_err
    return wrap_global

priv fn wrap_throws(): Up_shape!Wrap_err
    throw .bad

priv fn wrap_void_ptr(p: I32$@): Void$@!Wrap_err
    return p

fn test_result_wraps_coerced_value()
    verdict.start("[result] a return value needing a conversion inside a Result test...")

    hp: = mem.alloc_as<|Up_sq|>()
    defer dealloc(Void$@::hp)
    hp.n = 5
    a: = wrap_from_ptr(hp) catch
        assert(false, "upcasting a pointer inside a Result must succeed")
        return
    assert(a.area() == 25, "an interface upcast must survive the Result wrapper")

    b: = wrap_from_global() catch
        assert(false, "upcasting a global inside a Result must succeed")
        return
    assert(b.area() == 36, "a global upcast must survive the Result wrapper")

    $threw: = false
    _c: = wrap_throws() catch
        threw = true
        fallback b
    assert(threw, "the throw path of an interface-returning Result must still work")

    $n: I32 = 11
    vp: = wrap_void_ptr(n@) catch
        assert(false, "widening a typed pointer to Void$@ inside a Result must succeed")
        return
    assert((I32$@::vp)$ == 11, "the pointer widening must round-trip through the Result")

    verdict.pass("")
// ==========================================
// Checks `return f()!;` for a function returning `Void`.
// Caution: Test a Void call not wrapped in a Result with it. `return plain_void(x);`'s call appears
// only in that expression, so skipping too much silently deletes the call and its side effect.
// ==========================================
priv enum Void_ret_err
    bad

priv $void_ret_side: I32 = 0

priv fn void_ret_inner(x: I32): Void!Void_ret_err
    if x < 0
        throw .bad
    void_ret_side += x

priv fn void_ret_plain(x: I32)
    void_ret_side += x * 10

priv fn void_ret_forward(x: I32): Void!Void_ret_err
    return void_ret_inner(x)!

priv fn void_ret_wrap_plain(x: I32): Void!Void_ret_err
    return void_ret_plain(x)

fn test_void_result_return_forms()
    verdict.start("[Void!E] the return of a Result returning Void test...")

    void_ret_side = 0
    void_ret_forward(3) catch
        assert(false, "forwarding a successful Void result must not throw")
        return
    assert(void_ret_side == 3, "`return f()!;` performs the call inside exactly once")

    $threw: = false
    void_ret_forward(-1) catch
        threw = true
    assert(threw, "`return f()!;` hands a failure to the caller")
    assert(void_ret_side == 3, "a failed call leaves no side effect")

    void_ret_wrap_plain(2) catch
        assert(false, "wrapping a plain Void call must not throw")
        return
    assert(void_ret_side == 23, "`return plain_void(x);`'s call does not disappear")

    verdict.pass("a collapsed `!` is skipped and an uncollapsed Void is put out.")

// ==========================================
// A Result is an ordinary value (`T!E` is std/lang's enum `Result<|T, E|>`). It is stored, passed
// and switched on. `.ok(v)` / `.err(e)` build it. A result whose value is a result keeps both
// levels.
// ==========================================

priv enum Held_err
    lost(code: I32)

priv struct Held //< a Result kept in a field, read later
    outcome: I32!Held_err

priv fn held_half(n: I32): I32!Held_err
    if n % 2 != 0
        return .err(.lost(n))
    return .ok(n / 2)

priv fn held_code(r: I32!Held_err): I32 //< the error's code, or -1 on success
    switch r
    case .ok
        return -1
    case .err(e)
        switch e
        case .lost(c)
            return c

priv fn held_nested(n: I32): (I32!Held_err)!Held_err
    if n < 0
        throw .lost(0)
    return held_half(n)

fn test_result_is_a_value()
    verdict.start("[T!E] a Result as an ordinary value test...")

    kept: Held[2] = ::{ Held::{ .outcome = held_half(8) }, Held::{ .outcome = held_half(5) } }
    assert((kept[0].outcome catch 0) == 4, "a Result kept in a field gives its value")
    assert(held_code(kept[1].outcome) == 5, "a switch reads the error a field keeps")
    assert(held_code(kept[0].outcome) == -1, "a switch reads the success a field keeps")

    inner: = held_nested(6) catch held_half(1)
    assert((inner catch 0) == 3, "a result whose value is a result keeps the inner one")
    failed: = held_nested(-1) catch held_half(1)
    assert(held_code(failed) == 1, "the substitute stands in for the inner result")

    built: I32!Held_err = .ok(41)
    assert((built catch 0) == 41, "`.ok(v)` builds a Result where one is expected")

    verdict.pass("a Result is stored, passed, switched on and nested.")

// ==========================================
// The implicit conversion that relaxes immutability works through an alias too (a raw
// `strip_const_deep` comparison gives "expected 'P', but got 'I32$@'"). The one check is
// `same_shape_ignoring_const`, shared with the ternary operator.
// ==========================================

priv typedef Al_ptr = I32@ //<
    //< An alias of a read-only pointer, the target of the relaxing conversion
    //< **It must be the relaxing direction only.** Immutable back to mutable stays rejected.
    //< **Only the outermost alias is resolved** (the reason is at same_shape_ignoring_const).
priv typedef Al_arr = I32@[2]

fn test_alias_does_not_block_const_relaxation()
    verdict.start("[alias] relaxing immutability through an alias test...")

    $v: I32 = 7
    $w: I32 = 8
    // A mutable pointer can be passed as an immutable pointer written as an alias.
    p: Al_ptr = v@
    assert(p$ == 7, "a mutable pointer can be handed to an immutable pointer written as an alias")
    // The ternary operator's type unification uses the same check.
    pick: Al_ptr = v@ if p$ == 7 else w@
    assert(pick$ == 7, "an alias resolves in the unification of a ternary operator's branches too")
    // An alias pointing at an array; the element is not an alias (same_shape_ignoring_const).
    $arr: Al_arr = ::{}
    arr[0] = v@
    arr[1] = w@
    assert(arr[0]$ + arr[1]$ == 15, "the outermost resolves for an alias pointing at an array too")

    verdict.pass("an alias does not stop the implicit conversion.")

priv struct Hold<|T|> //<
    //< A composite type that each of two or more type arguments is bound from **inside**
    //< **Choose by position.** In `f<|K, V|>(m: Map<|K, V|>)` both hit the same parameter; K takes
    //< the 0th type argument, V the 1st (bind_path in `ksplc/sema/body/generic_infer.kspl`).
    v: T

priv fn two_bare<|S, T|>(_a: S, _b: T): Sz
    return 1

priv fn bare_then_nested<|S, T|>(_a: S, _p: Hold<|T|>): Sz
    return 2

priv fn nested_then_bare<|T, S|>(_p: Hold<|T|>, _a: S): Sz
    return 3

priv fn nested_in_trait<|S, T|>(_a: S, _p: Callable1<|T, Bool|>): Sz
    return 4

priv fn first_of<|T|>(xs: T[]): T //< `T[]` is `Slice<|T|>`: the element binds, not the slice
    return xs[0]

priv fn first_held<|T|>(xs: Hold<|T|>[]): T //< the variable one list further down
    return xs[0].v

priv fn put_first<|T|>(xs: T$[], v: T) //< a writable slice binds its element too
    xs[0] = v

priv fn apply_to<|T, U|>(f: fn(x: T): U, v: T): U //< `U` stands only in a function type's result
    return f(v)

priv fn widen_i32(x: I32): I64
    return I64::x * 2

priv fn through<|T|>(p: T@): T //< a pointer's target binds
    return p$

priv fn second_of<|T|>(a: T[2]): T //< a fixed array's element binds, not the whole array
    return a[1]

fn test_generic_args_infer_from_composites()
    verdict.start("[Types] inferring a type argument from inside a composite type test...")
    h: = Hold<|I32|>::{ .v = 1 }
    pred: Callable1<|I32, Bool|> = fn(x: I32; ): Bool
        return x > 0
    assert(two_bare(h, 5) == 1, "the plain-against-plain shape")
    assert(bare_then_nested(5, h) == 2, "it resolves with a composite type after a plain one")
    assert(nested_then_bare(h, 5) == 3,
        "the plain behind resolves with the composite type first too")
    assert(nested_in_trait(5, pred) == 4, "it resolves from inside a trait's type argument too")
    $arr: I32[2] = ::{ 7, 8 }
    put_first(I32$[]::arr, 6)
    assert(first_of(I32[]::arr) == 6, "a slice's element binds, written or writable")
    held: Hold<|I32|>[1] = ::{ h }
    assert(first_held(Hold<|I32|>[]::held) == 1, "it resolves through a slice of an instance")
    assert(apply_to(widen_i32, 21) == 42, "a function type's result binds from the named function")
    assert(through(h.v@) == 1, "a pointer's target binds")
    assert(second_of(arr) == 8, "an array's element binds")
    verdict
        .pass("with two or more type arguments the binding target is decided by the position inside \
            a composite type.")

// ==========================================
// A `const` parameter written as an array's length or as a generic's value argument is read off
// the argument (`bind_value` in `ksplc/sema/body/generic_infer.kspl`). Two values that disagree,
// a slice and a call where nothing fixes it are refused (the cases `generic_const_length_conflict`
// and `generic_type_args_not_inferred` in `tests/negative/generic.kspl`).
// ==========================================

priv fn total_of<|const N: Sz|>(v: I32[N]): Sz //< `N` bounds the loop and sizes a type
    $t: Sz = 0
    for i in Range.asc(N)
        t += Sz::v[i]
    return t * 100 + sizeof(I32[N])

priv fn grid_shape<|const R: Sz, const C: Sz|>(_g: I32[C][R]): Sz //< each level binds its own
    return R * 10 + C

priv fn held_len<|const N: Sz|>(h: Hold<|I32[N]|>@): Sz //< inside a generic's argument too
    return N + Sz::h.v[0]

priv fn forwarded<|const M: Sz|>(a: I32[M]): Sz //< an instance's array passes its length on
    return total_of(a)

fn test_const_args_infer_from_array_lengths()
    verdict.start("[Types] inferring a const parameter from an array's length test...")
    s: I32[3] = ::{ 1, 2, 3 }
    assert(total_of(s) == 612, "N is 3: the loop sums three elements and the type holds 12 bytes")
    assert(total_of<|3|>(s) == total_of(s), "written, the value is the one inferred")
    g: I32[3][2] = ::{::{ 1, 2, 3 }, ::{ 4, 5, 6 } }
    assert(grid_shape(g) == 23, "a nested array binds the outer and the inner length")
    h: = Hold<|I32[4]|>::{ .v = ::{ 7, 0, 0, 0 } }
    assert(held_len(h@) == 11, "an array inside a generic's type argument binds its length")
    assert(forwarded(s) == 612, "a generic passes its own const parameter's array on")
    verdict.pass("a const parameter takes the length of the array written where it stands.")

priv struct Cbuf<|const N: Sz|> //< a generic with a value argument to read a `const` one off
    data: U8[N]

priv struct Cflag<|const ON: Bool|> //< the same, with a value that is no number
    x: I32

priv fn cbuf_cap<|const N: Sz|>(_b: Cbuf<|N|>@): Sz //< behind a pointer
    return N

priv fn held_cap<|const N: Sz|>(_h: Hold<|Cbuf<|N|>|>@): Sz //< inside another generic's argument
    return N

priv fn row_shape<|const N: Sz, const K: Sz|>(_r: Cbuf<|N|>[K]): Sz //< an array of them
    return N * 10 + K

priv fn cbuf_and_array<|const N: Sz|>(_b: Cbuf<|N|>@, v: I32[N]): Sz //< two sources that agree
    return N + Sz::v[0]

priv fn flag_of<|const B: Bool|>(_f: Cflag<|B|>@): Bool
    return B

priv fn ring_cap<|const N: Sz|>(_r: ring.Ring<|N|>@): Sz //< another file's, through its import
    return N

fn test_const_args_infer_from_value_args()
    verdict.start("[Types] inferring a const parameter from a generic's value argument test...")
    b: = Cbuf<|8|>::{}
    assert(cbuf_cap(b@) == 8, "N is the 8 of 'Cbuf<|8|>', read behind a pointer")
    assert(cbuf_cap<|8|>(b@) == cbuf_cap(b@), "written, the value is the one inferred")
    h: = Hold<|Cbuf<|5|>|>::{}
    assert(held_cap(h@) == 5, "a value argument inside another generic's type argument binds")
    r: Cbuf<|2|>[3] = ::{}
    assert(row_shape(r) == 23, "an array of them binds the value argument and the length")
    s: I32[8] = ::{ 4, 0, 0, 0, 0, 0, 0, 0 }
    assert(cbuf_and_array(b@, s) == 12, "a value argument and an array's length agreeing")
    f: = Cflag<|true|>::{}
    assert(flag_of(f@), "a Bool value binds as a number does")
    $store: U8[4] = ::{}
    q: = ring.Ring<|4|>.new(U8$[]::store)
    assert(ring_cap(q@) == 4, "another file's generic, named through its import")
    verdict.pass("a const parameter takes the value a generic's argument has where it stands.")

// ==========================================
// Two numeric operands of different types compute in the one that holds every value of the other
// (`get_promoted_numeric_type` in `ksplc/sema/type/query.kspl`). A pair with none is refused
// (the case `numeric_operands_no_common_type` in `tests/negative/numbers.kspl`). The type is
// always one of the two.
// ==========================================

priv fn add_u8_i16(a: U8, b: I16): I16
    return a + b

priv fn add_i16_u8(a: I16, b: U8): I16
    return a + b

priv fn mix_widths(a: U16, b: I32, n: Sz, w: I64, u: U32): I64
    return w + n * b + u + a

fn test_numeric_operands_promote_to_the_holder()
    verdict.start("[Types] mixed numeric operands compute in the side holding the other test...")
    assert(add_u8_i16(1, 1000) == 1001, "U8 + I16 computes at I16, not truncated to U8")
    assert(add_i16_u8(-2, 1) == -1, "I16 + U8 computes at I16 whichever side the I16 stands on")
    assert(mix_widths(1, -2, 3, 10, 4000000000) == 4000000005,
        "Sz takes I32, I64 takes Sz and U32, and nothing is narrowed on the way")
    f: F32 = 0.5
    d: F64 = 0.25
    assert(f + d == 0.75, "F32 widens into F64")
    u: U32 = 0
    assert(u < 1 && u * 0x85ebca6b == 0, "an integer literal takes the U32 on the other side")
    big: U8 = 200
    s: I16 = -1
    picked: = big if s < 0 else s
    assert(picked == 200, "the ternary's branches meet the same way (U8 and I16 at I16)")
    verdict.pass("each pair computes in the operand type holding the other.")

// ==========================================
// Type arguments written at a generic call are known before its arguments, so they type them as
// any call's parameters do (`instance_for_written_args` in `ksplc/sema/body/call.kspl`).
// ==========================================
priv struct Typed_pt
    x: I32

priv struct Typed_box<|T|>
    v: T

impl<|T|> Typed_box<|T|>
    priv fn make(v: T): Typed_box<|T|>
        return ::{ .v = v }

priv fn larger<|T|>(a: T, b: T): T
    return a if a > b else b

fn test_written_type_args_type_the_arguments()
    verdict.start("[Types] type arguments written at a call type its arguments test...")
    assert(larger<|U8|>(200, 100) == 200, "an untyped literal takes the written U8")
    b: = Typed_box<|Typed_pt|>.make(::{ .x = 2 })
    assert(b.v.x == 2, "a literal with its type left out builds the written type's struct")
    verdict.pass("a written type argument types the arguments, literals and struct literals alike.")

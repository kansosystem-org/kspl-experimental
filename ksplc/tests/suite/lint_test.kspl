#!/usr/bin/env -S ksplc run
//< It checks each diagnostic fires in the fixtures of [`../lint`](../lint), and not on correct code
//< Caution: a repository's lint gate checks only "zero Information diagnostics in its own code".
//< So it passes even where the lint is broken and never fires. This file pins down that it fires.
//< [`harness_expect.kspl`](../support/harness_expect.kspl) runs them.
import "ksplc/tests/support/harness"
import "ksplc/tests/support/harness_expect"

fn main(): I32
    arena: = harness.begin(256 * 1024 * 1024)
    harness_expect.run_suite("lint", "tests/lint", false, true, false, arena)
    return harness.finish()

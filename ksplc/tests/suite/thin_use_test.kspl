#!/usr/bin/env -S ksplc run
//< The test of what is demanded of "a thin user that uses just one of std's APIs"
//< It checks that **the compilation passes** and **how much one std file brings along**. The
//< repository's own programs use std widely, so they always reach an instantiation another way too.
//< Caution: Add a shape where a std function returns a concrete generic type (`ds.List<|U8[]|>` and
//< the like) and add one entry here. It checks only compiling with zero errors (it is not run).
import "ksplc/tests/support/harness"
import "ksplc/tests/support/harness_build"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"

priv const CASE_SPLIT: U8[] =
    """import "std/str"
import "std/io"

fn main(): I32
  $lines: = "a,b,c".split(',', null)
  defer lines.free()
  $n: Sz = 0
  for line in lines
    n += line.len

  io.out().s("\{I64::n\}\n")
  return 0

"""

priv const CASE_READ_DIR: U8[] =
    """import "std/fs"
import "std/mem"
import "std/io"

fn main(): I32
  a: = mem.Arena(4096)
  defer a.free()
  entries: = fs.read_dir(".", a) catch
    return 1

  for name in entries
    io.out().s(name).s("\n")

  return 0

"""

priv const CASE_JSON_ARR: U8[] =
    """import "std/json"
import "std/mem"
import "std/io"

fn main(): I32
  a: = mem.Arena(4096)
  defer a.free()
  v: = json.parse("[1, 2]", a) catch
    return 1

  $sum: I64 = 0
  for item in v.val.arr_list(a)
    sum += item.as_int().unwrap_or(0)

  io.out().s("\{sum\}\n")
  return 0

"""

priv const CASE_JSONRPC_FRAME: U8[] =
    """import "std/jsonrpc"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/io"

fn main(): I32
  a: = Arena(4096)
  defer a.free()
  $acc: = Str_builder()
  jsonrpc.frame_into(acc@, "{}")
  got: = jsonrpc.take_frame(acc@, jsonrpc.MAX_BODY_BYTES, a) catch
    return 1

  switch got case .some(body)
    io.out().s(body).s("\n")
  case .none
    return 1

  return 0

"""

priv const CASE_MAP_ENTRIES: U8[] =
    """import "std/ds"
import "std/mem"
import "std/io"

fn main(): I32
  a: = mem.Arena(4096)
  defer a.free()
  $m: = ds.Map<|I32, I32|>(a)
  m.set(1, 10)
  $sum: I32 = 0
  for e in m.items()
    sum += e.value

  io.out().s("\{I64::sum\}\n")
  return 0

"""

// The predicate is a closure: `where` takes a `Callable1`, not a function pointer. A `;` is
// needed even with no capture ("Why capture is made explicit and escape is forbidden" in
// `docs/DESIGN-programming-language.md`).
// Caution: **Do not call `find_all`.** It instantiates `List<|Match|>`, hiding the tested shape:
// "only an uncalled `pub fn`'s return value names the instance".
priv const CASE_REGEX_THIN: U8[] =
    """
import "std/io"
import "std/regex" { Regex }

fn main(): I32
  $rx: = Regex.compile("[a-z]+") catch
    return 1

  hit: = rx.is_match("abc")
  io.out().s("ok\n" if hit else "no\n")
  rx.free()
  return 0

"""

// Caution: **Do not call `wait`.** It instantiates `List<|Ready|>`, hiding the tested shape:
// "only the `T!E` of an uncalled `pub fn`'s return value remains".
priv const CASE_REACTOR_THIN: U8[] =
    """
import "std/io"
import "std/reactor" { Reactor }

fn main(): I32
  _r: = Reactor()
  io.out().s("ok\n")
  return 0

"""

priv const CASE_SEQ_WHERE: U8[] =
    """import "std/ds"
import "std/seq" as _seq
import "std/mem"
import "std/io"

fn main(): I32
  a: = mem.Arena(4096)
  defer a.free()
  $l: = ds.List<|I32|>(a)
  l.push(1)
  l.push(2)
  io.out().s("\{I64::l.where(fn(x: I32@; ): Bool { return x$ % 2 == 0; }).count()\}\n")
  return 0

"""

// An instance named only by a function nobody calls is dropped with it. So is every function
// type and array naming it. C declares those ahead of their use, and one left behind names a
// struct C never sees (`unknown type name`).
priv const CASE_DEAD_INSTANCE: U8[] =
    """import "std/io"

priv struct Box<|T|>
  v: T


impl<|T|> Box<|T|>
  fn get(r: Self@): T
    return r.v



priv struct Cell<|T|>
  v: T


fn unused(): I32
  b: = Box<|I32|>::{ .v = 8 }
  get: = Box<|I32|>.get
  cells: = Cell<|I64|>[2]::{ ::{ .v = 1 }, ::{ .v = 2 } }
  return get(b@) + I32::cells[1].v


fn main(): I32
  io.out().s("ok\n")
  return 0

"""

priv const SMALL_C_MAX_LINES: Sz = 9000 //< the cap on the generated C's line count
    //< **The compilation succeeds even when it fails to drop them**; the generated C only grows
    //< several times over. The cap is about 1.5 times the current value, failing when the order of
    //< magnitude changes; the current value is shown on passing.

priv const BASE_FILES: U8[][2] = ::{ "std/lang", "std/libc" } //<
    //< The base: the files that go into every program
    //< Each `List<|X|>` instantiated brings, through `where` / `select`'s signatures, the **type
    //< declarations** of `List_seq<|X|>` / `Keep<|...|>` / `X?` / `Callable1<|X, Bool|>`.
    //< **A type that appears only in a signature is dropped after that function is**: dead-code
    //< removal runs for functions, then types (`../../lower/prune.kspl`).
priv const BASE_MAX_LINES: Sz = 669 //<
    //< The cap on the base's line count
    //< One line is `#cfg(!freestanding)`'s directive, not code in the generated C (a freestanding
    //< build imports one **fewer**)
    //< **Nothing counted by this cap can be placed anywhere but `std/lang`.**
    //< Caution: **Raise it for two reasons only**: translating a file into English (or bringing it
    //< back inside the width after that). And a compiler-known type that belongs in `std/lang`.

priv const EXT: U8[] = ".kspl" //<
    //< **Hold the extension in one place**

// The files that bring nothing but themselves besides BASE. An import under `#cfg` counts:
// `std/chars` is not here, as a freestanding build brings `std/mem` along for `memcmp`.
priv const LEAF_FILES: U8[][11] = ::{ "std/bytes", "std/math", "std/checked_int", "std/mem",
    "std/reflect", "std/ring", "std/prng", "std/bignat", "std/log", "std/stack_limit", "std/suite" }

priv const HEAVIEST: U8[] = "std/str" //< the heaviest unit
    //< **`std/io` is not in here.** Writer / Formattable are in std/lang, so string handling pays
    //< for no file I/O (io still brings str along).

priv const CORE_MAX_LINES: Sz = 3670 //<
    //< The cap on the line count of the chunk the heaviest unit reaches
    //< **An added line costs every program that uses strings**, such as a format's field padding
    //< that even programs not using it pay for.
    //< Caution: **Update it to the current value whenever it changes, up or down.** Left loose, it
    //< can silently grow by the slack, with no run that fails.

priv struct Std_file
    name: U8[]
    lines: Sz
    entry: Bool //< whether it defines `main`, so a program holding its own cannot import it

priv struct Edge //< an import's edge
    //< "The source's index" and "the target's name", avoiding nested generics.
    from: Sz
    to: U8[]
    under: U8[] //< the `#cfg(...)` on the line above the import; empty where there is none

priv enum Build //< which imports a walk follows
    all //< every one, a `#cfg` one included (what the leaves and the cycles are judged by)
    hosted //< all but those under `#cfg(freestanding)`
    free //< all but those under `#cfg(!freestanding)`

priv fn follows(e: Edge, build: Build): Bool //< whether a walk for `build` takes the edge
    switch build
    case .hosted
        return !e.under.equals("#cfg(freestanding)")
    case .free
        return !e.under.equals("#cfg(!freestanding)")
    default {}
    return true

priv fn index_of(files: List<|Std_file|>@, name: U8[]): I32
    for i in Range.asc(files.len)
        if files.get(i).name.equals(name)
            return I32::i
    return -1

priv fn imported_std_name(line: U8[]): U8[] //<
    //< It returns the logical name an `import "std/..."` line imports (empty if it is not one)
    head: = "import \""
    t: = line.trim_start()
    if !t.starts_with(head)
        return ""
    rest: = t.sub_from(head.len)
    if !rest.starts_with("std/")
        return ""
    if close: = rest.find_char('"')
        return rest.sub(0, close)
    return ""

priv fn collect_std(files: List<|Std_file|>$@, edges: List<|Edge|>$@, arena: Arena$@): Bool //<
    //< It gathers the `.kspl` files of the `std` the compiler reads, each named as it is imported
    std: = harness.std_dir()
    found: = fs.walk_files(std, fs.skip_build_output, arena) catch
        return false
    for path in found
        if !path.ends_with(EXT) || path.len <= std.len
            continue
        rel: = arena.text().s("std/").s(path.sub_from(std.len + 1)).take()
        text: = io.read_file(path, null) catch
            continue
        // Caution: **Do not trim by length.** A changed extension leaves a name with a trailing
        // `.`.
        entry: = text.starts_with("fn main(") || text.find_str("\nfn main(").is_some()
        files
            .push(Std_file::{ .name = rel.strip_suffix(EXT), .lines = text.count_str("\n"),
            .entry = entry })
        idx: = files.len - 1
        $above: U8[] = ""
        for line in text.lines(arena)
            to: = imported_std_name(line)
            if to.len > 0
                edges.push(Edge::{ .from = idx, .to = to, .under = above })
            t: = line.trim_spaces()
            above = t if t.starts_with("#cfg(") else ""

    return files.len > 0

priv fn closure(files: List<|Std_file|>@, edges: List<|Edge|>@, name: U8[], build: Build,
    arena: Arena$@): List<|U8[]|> //<
        //< The names of the std files reached by walking imports from name (name and BASE too).
    $seen: = List<|U8[]|>(arena)
    $stack: = List<|U8[]|>(arena)
    stack.push(name)
    for b in BASE_FILES
        stack.push(b)
    for stack.len > 0
        cur: = stack.get(stack.len - 1)
        stack.len -= 1
        if seen.contains(cur)
            continue
        at: = index_of(files, cur)
        if at < 0
            continue
        seen.push(cur)
        for e in edges
            if e.from == Sz::at && follows(e, build)
                stack.push(e.to)
    return seen

priv const TIER_HEAD: U8[] = "| What is used |" //< the head of the tier table in std's README.md

priv fn numbers_in(cell: U8[], arena: Arena$@): List<|Sz|> //< each run of digits, in order
    $out: = List<|Sz|>(arena)
    $cur: Sz = 0
    $inside: = false
    for ch in cell
        if ch.is_digit()
            cur = cur * 10 + Sz::(ch - '0')
            inside = true
        else if inside
            out.push(cur)
            cur = 0
            inside = false
    if inside
        out.push(cur)
    return out

priv fn check_tier_table(files: List<|Std_file|>@, edges: List<|Edge|>@,
    base_names: List<|U8[]|>@, arena: Arena$@) //<
        //< Checks the table "How many files one import brings along" in std's README.md
        //< A row's number is a hosted build's; `(N on a freestanding build ...)` is that build's,
        //< and `N+` is a floor. **Hand-kept, it drifted by a file or more** when an import was
        //< added, and nothing failed.
    path: = fs.join(harness.std_dir(), "README.md", arena)
    doc: = io.read_file(path, null) catch ""
    $bad: = List<|U8[]|>(arena)
    $rows: Sz = 0
    $inside: = false
    for line in doc.lines(arena)
        if !inside
            inside = line.starts_with(TIER_HEAD)
            continue
        if !line.starts_with("|")
            break
        cells: = line.split('|', arena)
        if cells.len < 3 || cells.get(2).trim_spaces().starts_with("--")
            continue
        rows += 1
        want: = numbers_in(cells.get(2), arena)
        floor: = cells.get(2).find_char('+').is_some()
        free_given: =
            want.len > 1 && cells.get(2).find_str("freestanding").is_some()
        if want.len == 0
            bad.push(arena.text().s("a row gives no count: ").s(line).take())
            continue
        for name in cells.get(1).split('`', arena)
            if name.len == 0 || name.find_char(' ').is_some() || !name[0].is_lower()
                continue
            file: = arena.text().s("std/").s(name).take()
            if base_names.contains(file)
                if want.get(0) != base_names.len
                    bad
                        .push(arena.text().s(name).s(": BASE is \{base_names.len\} files").take())
                continue
            if index_of(files, file) < 0
                bad.push(arena.text().s(name).s(" is no file of std").take())
                continue
            hosted: = closure(files, edges, file, .hosted, arena).len
            free: = closure(files, edges, file, .free, arena).len
            want_free: = want.get(1) if free_given else want.get(0)
            ok: =
                hosted >= want.get(0) if floor else hosted == want.get(0) && free == want_free
            if !ok
                bad
                    .push(arena.text().s(name).s(" brings \{hosted\} (freestanding \{free\}), ")
                    .s("the row says ").s(cells.get(2).trim_spaces()).take())
    detail: = arena.text().s(path).s(":")
    for one in bad
        detail.s("\n    ").s(one)
    if rows == 0
        detail.s(" no table was read")
    verdict.check(arena.text().s("std's tier table counts the files one import brings (\{rows\} ")
        .s("rows)").take(), rows > 0 && bad.len == 0, detail.take())

priv fn sum_lines(files: List<|Std_file|>@, names: List<|U8[]|>@): Sz
    $total: Sz = 0
    for i in Range.asc(names.len)
        at: = index_of(files, names.get(i))
        if at >= 0
            total += files.get(at).lines
    return total

priv fn thin_case(slot: U8[], name: U8[], src: U8[], arena: Arena$@) //<
    //< Checks that a thin user compiles as one file
    //< cwd is the working directory and std is given by `--std-dir=` (as `harness.ksplc` does);
    //< from the repository root the default "std" would match.
    dir: = harness.sandbox(arena.text().s("thin_\{slot\}").take())
    io.write_file(fs.join(dir, "thin.kspl", arena), src) catch
        verdict.check(name, false, "cannot write the material")
        return
    r: = harness.run_in(harness.ksplc_argv(U8[][]::{ "thin.kspl", "thin.c" }), dir)
    if !verdict.check(name, r.exited_with(0) && r.out.find_str("error:").is_none(), r.out)
        return
    // Caution: **Build the generated C too.** A thin user fails as "zero diagnostics yet the C does
    // not build" (an uncalled `pub fn`'s `T!E` with its inner type undeclared). That reaches the
    // user as **a raw C compiler error** that no other test sees.
    b: = harness_build.build_exe(U8[][]::{ fs.join(dir, "thin.c", arena) },
        fs.join(dir, "thin.exe", arena), U8[][]::harness_build.DEFAULT_CFLAGS)
    verdict.check(arena.text().s(name).s(": the C put out builds").take(), b.exited_with(0), b.out)

priv fn solo_case(name: U8[], arena: Arena$@) //<
    //< Whether a program that imports **just** one file of std builds
    //< **The stage table does not check this.** It measures the closure of the written `import`s.
    //< But an extension method on a built-in type (`s.sub()` / `c.is_digit()`) makes **a dependency
    //< in no import**. It checks only "is it complete with that one file" (an empty `main`).
    dir: = harness.sandbox("solo")
    src: = arena.text().s("import \"").s(name).s("\"\n\nfn main(): I32\n  return 0\n\n").take()
    io.write_file(fs.join(dir, "solo.kspl", arena), src) catch
        verdict.check(name, false, "cannot write the material")
        return
    r: = harness.run_in(harness.ksplc_argv(U8[][]::{ "solo.kspl", "solo.c" }), dir)
    verdict.check(arena.text().s("\{name\} is closed with one file").take(), r.exited_with(0),
        r.out)

priv fn check_no_unused_stage_types(gen: U8[], arena: Arena$@) //<
    //< Checks that a program with no chain has no stage type of `std/seq` left in it
    //< **It is needed besides the line-count cap.** A test may match text; the compiler need not.
    name: = "a program writing no chain has no stage type left"
    stage_names: U8[][3] = ::{ "std_seq_List_seq", "std_seq_Keep", "std_seq_Conv" }
    for stage in stage_names
        if gen.find_str(stage).is_some()
            verdict.check(name, false,
                arena.text().s("'\{stage\}' is left in the generated C. ")
                .s("a generic's body nobody names cannot be dropped (ksplc/lower/prune.kspl)")
                .take())
            return
    verdict.check(name, true, "")

fn main(): I32
    arena: = harness.begin(256 * 1024 * 1024)
    io.out().s("# single use\n")
    thin_case("split", "str.split", CASE_SPLIT, arena)
    thin_case("read_dir", "fs.read_dir", CASE_READ_DIR, arena)
    thin_case("json", "json.Value.arr_list", CASE_JSON_ARR, arena)
    thin_case("jsonrpc", "jsonrpc.take_frame", CASE_JSONRPC_FRAME, arena)
    thin_case("map", "ds.Map.entries", CASE_MAP_ENTRIES, arena)
    thin_case("seq", "seq combinator on ds.List", CASE_SEQ_WHERE, arena)
    thin_case("regex", "regex.is_match (find_all is not called)", CASE_REGEX_THIN, arena)
    thin_case("reactor", "reactor.Reactor.new (wait is not called)", CASE_REACTOR_THIN, arena)
    thin_case("dead", "an instance named only by a function nobody calls", CASE_DEAD_INSTANCE,
        arena)

    // -- no function unreachable from a root is left in the generated C -- A generic makes every
    // method on each instantiation, `std/seq`'s additions to `List<|T|>` included.
    // `ksplc/lower/prune.kspl` drops what no root reaches.
    small_name: = arena.text()
        .s("a small program's generated C is within \{SMALL_C_MAX_LINES\} lines").take()
    dir: = harness.sandbox("thin_small")
    io.write_file(fs.join(dir, "small.kspl", arena), CASE_READ_DIR) catch
        return harness.fatal("cannot write the material")
    r: = harness.run_in(harness.ksplc_argv(U8[][]::{ "small.kspl", "small.c" }), dir)
    if !r.exited_with(0)
        verdict.check(small_name, false, r.out)
    else
        gen: = io.read_file(fs.join(dir, "small.c", arena), null) catch ""
        n: = gen.count_str("\n")
        verdict.check(small_name, n <= SMALL_C_MAX_LINES,
            arena.text()
            .s("the generated C went to \{n\} lines, over the cap \{SMALL_C_MAX_LINES\}. ")
            .s("removal of functions unreachable from a root may not be taking effect").take())
        check_no_unused_stage_types(gen, arena)

    // -- how much comes along when one std is imported --
    $files: = List<|Std_file|>(arena)
    $edges: = List<|Edge|>(arena)
    if !collect_std(files@, edges@, arena)
        return harness.fatal("std's files cannot be gathered")
    $base_names: = List<|U8[]|>(arena)
    for b in BASE_FILES
        base_names.push(b)
    base_lines: = sum_lines(files@, base_names@)
    verdict.check(arena.text().s("the \{BASE_FILES.len\} files that go into every program are ")
        .s("\{BASE_MAX_LINES\} lines or under (now \{base_lines\} lines)").take(),
        base_lines <= BASE_MAX_LINES,
        "std/lang has swelled. It is every program's minimum, so what is added here nobody can \
            avoid")

    // The leaves: files that bring nothing but themselves besides BASE.
    $leaves: = List<|U8[]|>(arena)
    for i in Range.asc(files.len)
        name: = files.get(i).name
        if base_names.contains(name)
            continue
        reach: = closure(files@, edges@, name, .all, arena)
        if reach.len == base_names.len + 1
            leaves.push(name)
    $extra: = ""
    for i in Range.asc(leaves.len)
        $known: = false
        for k in LEAF_FILES
            if leaves.get(i).equals(k)
                known = true
        if !known && extra.len == 0
            extra = leaves.get(i)
    verdict.check(arena.text()
        .s("\{LEAF_FILES.len\} bring along nothing but themselves besides BASE").take(),
        leaves.len == LEAF_FILES.len && extra.len == 0,
        arena.text().s("the row of leaves changed: \{extra\}").take())

    // **No file of std may be in a cycle**, or the stages collapse into one chunk. A cycle is a
    // path back to itself over one edge or more. BASE's two are not counted: `std/lang` goes into
    // every file, so `libc` always gets back through lang.
    $looped: = ""
    for i in Range.asc(files.len)
        name: = files.get(i).name
        if base_names.contains(name)
            continue
        for e in edges
            if e.from != i || looped.len > 0
                continue
            if base_names.contains(e.to)
                continue
            back: = closure(files@, edges@, e.to, .all, arena)
            if back.contains(name)
                looped = arena.text().s(name).s(" <-> ").s(e.to).take()
    verdict.check("std has no import cycle", looped.len == 0,
        arena.text().s("there is a cycle: \{looped\} (the stages collapse into a chunk. ")
        .s("Cut the edge with the smallest reason)").take())

    // `std/lang` goes into every file and cannot be named, and an entry point brings a second
    // `main`.
    for i in Range.asc(files.len)
        f: = files.get(i)
        if !f.entry && !f.name.equals("std/lang")
            solo_case(f.name, arena)

    check_tier_table(files@, edges@, base_names@, arena)

    core_reach: = closure(files@, edges@, HEAVIEST, .all, arena)
    core_lines: = sum_lines(files@, core_reach@)
    verdict.check(arena.text()
        .s("the chunk's amount is \{CORE_MAX_LINES\} lines or under (now \{core_lines\} lines)")
        .take(), core_lines <= CORE_MAX_LINES,
        "the chunk has swelled. What is added to a chunk file, every program that uses it pays for")
    return harness.finish()

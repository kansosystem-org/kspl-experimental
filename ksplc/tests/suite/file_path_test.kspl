#!/usr/bin/env -S ksplc run
//< It pins down that spelling the entry file's path differently does not change a logical name
//< The logical name is used in name mangling, diagnostics and the generated C's `#line`. The test
//< program is two files, as one file does not exercise declarations without a visibility marker.

// ==========================================
//   1. an absolute path, and one spelt through `..`, pass too. Main uses lib's **unmarked**
//      declarations, seen only inside the one package
//   2. the generated C does not differ by one byte — no spelling leaks into the mangled name
// The files belong to this package, so their name is `ksplc/…` read from the package's top. The
// top is found with `..` folded ("A path's `..` is resolved by its spelling" in
// `../../../docs/DESIGN-repository.md`).
// ==========================================
import "ksplc/base/core" as _base_core // `strip_file_uri_on`
import "ksplc/base/locate" as base_locate
import "ksplc/tests/support/harness"
import "std/chars"
import "std/fs"
import "std/io"
import "std/math"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strfmt" as _strfmt
import "std/verdict"

priv const REL_ENTRY: U8[] = "tests/filepath/main.kspl"
priv const DOTTED_ENTRY: U8[] = "tests/filepath/../filepath/main.kspl" //<
    //< The same file through a folder and back out of it

priv fn diff_detail(a: U8[], b: U8[], arena: Arena$@): U8[] //<
    //< It returns the bytes around the first position where the generated C in a and b disagree
    //< It returns empty where they are the same.
    //< Caution: **Compare the bytes rather than a line count or a count of marks.** A spelling that
    //< leaks in neither grows nor shrinks anything, so counts cannot notice a changed name.
    if a.equals(b)
        return ""
    d: = arena.text()
    d.s("relative \{a.len\} bytes / the other \{b.len\} bytes")
    shorter: = math.min(a.len, b.len)
    for i in Range.asc(shorter)
        if a[i] != b[i]
            from: = i - 60 if i > 60 else 0
            d.s("\nthe first difference: ")
                .s(a.sub(from, i + 60 - from if i + 60 <= a.len else a.len - from))
            break
    return d.take()

priv fn same_c(name: U8[], entry: U8[], rel: U8[], dir: U8[], arena: Arena$@) //<
    //< It compiles the files through another spelling and checks the C equals the relative one's
    gen: = arena.text().s("\{dir\}/\{name\}.c").take()
    r: = harness.ksplc(U8[][]::{ entry, gen })
    if !verdict.check(arena.text().s("it compiles with the \{name\} entry path too").take(),
        r.exited_with(0), r.out)
        return
    b: = io.read_file(gen, null) catch
        fallback ""
    verdict.check(arena.text().s("the \{name\} entry path gives the same C").take(),
        rel.len > 0 && rel.equals(b), diff_detail(rel, b, arena))

priv fn check_drive_letter() //<
    //< A drive letter in either case is one drive on Windows, and two names elsewhere
    //< **The Windows answer is checked on every OS**, through the parameter that says a path can
    //< open with a drive. An editor writes `c:` in a URI where the working folder has `C:`.
    rest: = base_locate.rest_under_drive("c:/w/src/a.kspl", "C:\\w", true)
    verdict.check("a drive letter in another case is the same drive on Windows",
        rest.equals("src/a.kspl"), rest)
    other: = base_locate.rest_under_drive("d:/w/src/a.kspl", "C:\\w", true)
    verdict.check("another drive letter is another drive", other.len == 0, other)
    folder: = base_locate.rest_under_drive("C:/W/src/a.kspl", "C:\\w", true)
    verdict.check("only the drive letter is matched in either case", folder.len == 0, folder)
    posix: = base_locate.rest_under_drive("c:/w/src/a.kspl", "C:/w", false)
    verdict.check("with no drives, `c:` and `C:` are two folders", posix.len == 0, posix)

priv fn check_file_uri() //<
    //< An editor's `file:` URI names a path that opens with its drive on Windows alone
    //< **Both answers are checked on every OS**, through the parameter that says the OS is Windows.
    for uri in U8[][2]::{ "file:///c%3A/w/a.kspl", "file:///c:/w/a.kspl" }
        win: = uri.strip_file_uri_on(true)
        verdict.check("on Windows a URI's drive opens the path", win.equals("c:/w/a.kspl"), win)
        posix: = uri.strip_file_uri_on(false)
        verdict.check("elsewhere `/c:` is a folder under the root",
            posix.equals("/c:/w/a.kspl"), posix)
    spaced: = "file:///home/a%20b/x.kspl".strip_file_uri_on(true)
    verdict.check("a path with no drive keeps its `/` on Windows",
        spaced.equals("/home/a b/x.kspl"), spaced)

fn main(): I32
    arena: = harness.begin(1 << 22)
    check_drive_letter()
    check_file_uri()
    dir: = harness.sandbox("filepath")
    rel_c: = arena.text().s("\{dir\}/rel.c").take()
    abs_entry: = fs.absolute(REL_ENTRY, arena) catch
        return harness.fatal("the working directory cannot be read")

    r1: = harness.ksplc(U8[][]::{ REL_ENTRY, rel_c })
    if !verdict.check("it compiles with a relative entry path", r1.exited_with(0), r1.out)
        return harness.finish()
    a: = io.read_file(rel_c, null) catch
        fallback ""
    same_c("absolute-path", abs_entry, a, dir, arena)
    same_c("dotted", DOTTED_ENTRY, a, dir, arena)
    return harness.finish()

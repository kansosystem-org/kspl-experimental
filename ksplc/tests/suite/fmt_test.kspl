#!/usr/bin/env -S ksplc run
//< The test that pins down `ksplc fmt`'s formatting result
//<
//< The formatter **rewrites the whole repository**, so a defect adds a mass of unrelated
//< differences and review stops working.

// ==========================================
//   1. **idempotence**: the first and second outputs agree (or every `make fmt` makes a difference)
//   2. **the space between tokens**: telling apart look-alikes such as a unary and a binary "-"
// ==========================================
import "ksplc/tests/support/fmt_cache"
import "ksplc/tests/support/fmt_material"
import "ksplc/tests/support/harness"
import "std/chars" // classifying and extracting single characters
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" // `arena.text()`
import "std/sys"
import "std/verdict"

priv fn fmt(path: U8[], style: U8[] = ""): verdict.Run_out //< the formatting's result
    //<
    //< On failure, code is non-zero and out holds that output. A `style` is passed as `--style=`.
    if style.len == 0
        return harness.run(U8[][]::{ harness.ksplc_exe(), "fmt", path })
    return harness.run(U8[][]::{ harness.ksplc_exe(), "fmt", style, path })

priv fn write_src(slot: U8[], name: U8[], body: U8[], arena: Arena$@): U8[] //<
    //< It returns the path of the working directory holding one input file, or empty on failure
    dir: = harness.sandbox(arena.text().s("fmt_\{slot\}").take())
    path: = fs.join(dir, name, arena)
    io.write_file(path, body) catch
        return ""
    return path

priv fn differs(want: U8[], got: U8[], arena: Arena$@): U8[] //<
    //< Why one formatting result is not the expected one, with both shapes shown
    //<
    //< **One sentence for every case**, rather than a wrapping call ([H0802]) at each.
    return arena.text()
        .s("the formatting differs from what was expected\n--- expected ---\n\{want\}--- actual \
            ---\n\{got\}").take()

priv fn case_stable(slot: U8[], name: U8[], src: U8[], arena: Arena$@) //<
    //< Checks that formatting an already formatted shape changes nothing
    case_becomes(slot, name, src, src, arena)

priv fn case_becomes(slot: U8[], name: U8[], src: U8[], want: U8[], arena: Arena$@,
    style: U8[] = "") //<
        //< Checks that formatting `src` (with `style`, a whole `--style=…`) writes `want`
    path: = write_src(slot, "a.kspl", src, arena)
    if path.len == 0
        verdict.check(name, false, "cannot place the material")
        return
    r: = fmt(path, style)
    if !r.exited_with(0)
        verdict.check(name, false, arena.text().s("fmt failed\n\{r.out\}").take())
        return
    verdict.check(name, r.out.equals(want), differs(want, r.out, arena))

priv fn case_idempotent(slot: U8[], name: U8[], src: U8[], arena: Arena$@) //<
    //< Checks that formatting src twice changes nothing on the second pass
    path: = write_src(slot, "a.kspl", src, arena)
    if path.len == 0
        verdict.check(name, false, "cannot place the material")
        return
    first: = fmt(path)
    if !first.exited_with(0)
        verdict.check(name, false,
            arena.text().s("the first fmt failed\n\{first.out\}").take())
        return
    second_path: = fs.join(sys.get_dir_name(path), "b.kspl", arena)
    io.write_file(second_path, first.out) catch
        verdict.check(name, false, "the first result cannot be written")
        return
    second: = fmt(second_path)
    if !second.exited_with(0)
        verdict.check(name, false,
            arena.text().s("the second fmt failed\n\{second.out\}").take())
        return
    verdict.check(name, first.out.equals(second.out),
        harness.arena().text()
        .s("it changed on the second\n--- first ---\n\{first.out\}--- second ---\n\{second.out\}")
        .take())

priv fn case_carried_string(arena: Arena$@) //<
    //< A string too long for the line is carried onto the next one, at a space
    //<
    //< **The input is the one-line shape, not the answer**: given the carried shape, a formatter
    //< that copies a literal's spelling unchanged passes.
    name: = "a string too long for the line is carried onto the next one"
    path: = write_src("carried", "a.kspl", fmt_material.SRC_CARRIED_IN, arena)
    if path.len == 0
        verdict.check(name, false, "cannot place the material")
        return
    r: = fmt(path)
    if !r.exited_with(0)
        verdict.check(name, false, arena.text().s("fmt failed\n\{r.out\}").take())
        return
    verdict.check(name, r.out.equals(fmt_material.SRC_CARRIED_STRING),
        differs(fmt_material.SRC_CARRIED_STRING, r.out, arena))
    again: = write_src("carried2", "a.kspl", r.out, arena)
    if again.len == 0
        verdict.check("a carried string does not move on the second formatting", false,
            "cannot place the material")
        return
    second: = fmt(again)
    verdict.check("a carried string does not move on the second formatting",
        second.exited_with(0) && second.out.equals(r.out),
        arena.text().s("--- first ---\n\{r.out\}--- second ---\n\{second.out\}").take())

priv fn case_unknown_style_key(arena: Arena$@) //<
    //< Checks that an unknown `--style` key is not silently ignored
    //<
    //< Ignored, a typo formats with the default and reports success, so it must fail naming the
    //< key.
    name: = "an unknown `--style` key is rejected"
    path: = write_src("style", "a.kspl", "fn f(): I32\n    return 1\n", arena)
    if path.len == 0
        verdict.check(name, false, "cannot place the material")
        return
    exe: = harness.ksplc_exe()
    bad: = harness.run(U8[][]::{ exe, "fmt", "--style=IndentWith: 8", path })
    if bad.exited_with(0)
        verdict.check(name, false,
            arena.text().s("the mistyped 'IndentWith' passed\n\{bad.out\}").take())
        return
    if bad.out.find_str("IndentWith").is_none()
        why: = harness.arena().text()
            .s("the rejected key is not in the output, so which is bad cannot be \
                traced\n\{bad.out\}").take()
        verdict.check(name, false, why)
        return
    // Caution: A correct key must pass. If everything were rejected, the case above would pass too.
    good: = harness.run(U8[][]::{ exe, "fmt", "--style=IndentWidth: 8", path })
    verdict.check(name, good.exited_with(0),
        arena.text().s("the correct 'IndentWidth' was rejected\n\{good.out\}").take())

priv fn case_syntax_error_as_written(arena: Arena$@) //<
    //< A syntax error `ksplc fmt` meets shows the line as written, as a compile shows it
    //<
    //< Caution: **The formatter reads the indentation notation through the conversion to braces**,
    //< so a line taken from the converted text shows a `;` nobody typed (`mend_as_read` in
    //< `ksplc/parse/load.kspl`).
    name: = "a syntax error shows its line as written"
    path: =
        write_src("aswritten", "a.kspl", "fn main(): I32\n    x: I32 = \"a\" \"b\"\n", arena)
    if path.len == 0
        verdict.check(name, false, "cannot place the material")
        return
    r: = fmt(path)
    verdict.check(name,
        !r.exited_with(0) && r.out.find_str("2 |     x: I32 = \"a\" \"b\"\n").is_some(),
        arena.text().s("the line is not shown as written\n\{r.out\}").take())

fn main(): I32
    arena: = harness.begin(64 * 1024 * 1024)
    io.out().s("# ksplc fmt\n")
    case_stable("unary", "no space is put into a unary minus", fmt_material.SRC_UNARY, arena)
    case_stable("binary", "a space is put before and after a binary minus",
        fmt_material.SRC_BINARY, arena)
    case_stable("empty", "an empty block is folded with no space in it",
        fmt_material.SRC_EMPTY_BLOCK, arena)
    case_stable("attrs", "one attribute per line", fmt_material.SRC_ATTRS, arena)
    case_stable("brace", "a brace in a character literal is not read as an interpolation opening",
        fmt_material.SRC_BRACE_CHAR, arena)
    case_stable("listcmt",
        "a comment between a compound literal's elements keeps its line and level",
        fmt_material.SRC_LIST_COMMENT, arena)
    case_stable("listshort", "a comment above a short element of a compound literal keeps its line",
        fmt_material.SRC_LIST_SHORT, arena)
    case_stable("docparams", "a signature broken one parameter per line keeps its indentation",
        fmt_material.SRC_DOC_PARAMS, arena)
    case_stable("valuebelow", "a value opening below its `=` keeps its indentation",
        fmt_material.SRC_VALUE_BELOW, arena)
    case_stable("closure", "a closure's `;` stays on its signature's line",
        fmt_material.SRC_CLOSURE_SEP, arena)
    case_carried_string(arena)
    case_becomes("catchwide",
        "`catch <value>` that would pass the limit goes to the next line whole, and one that fits \
            stays", fmt_material.SRC_CATCH_WIDE_IN, fmt_material.SRC_CATCH_WIDE_OUT, arena)
    case_becomes("commentcut",
        "a comment line past the limit is cut, its rest joining the paragraph's next line",
        fmt_material.SRC_COMMENT_CUT_IN, fmt_material.SRC_COMMENT_CUT_OUT, arena)
    case_stable("commentkept", "a cut comment does not move on the second formatting",
        fmt_material.SRC_COMMENT_CUT_OUT, arena)
    case_becomes("rejoined",
        "a chain holding a carried string that fits is joined in one formatting",
        fmt_material.SRC_REJOINED_IN, fmt_material.SRC_REJOINED_OUT, arena)
    // The input is the one-line shape, not the answer, as with a carried string.
    case_becomes("choice",
        "a value too long for its line takes parentheses or stays on the `return` line",
        fmt_material.SRC_CHOICE_IN, fmt_material.SRC_CHOICE_OUT, arena)
    case_becomes("defer", "a defer holding one statement is written without its block",
        fmt_material.SRC_DEFER_IN, fmt_material.SRC_DEFER_OUT, arena)
    case_becomes("firstarm", "a switch's first arm goes below it, at its column",
        fmt_material.SRC_FIRST_ARM_IN, fmt_material.SRC_FIRST_ARM_OUT, arena)
    case_becomes("emptyarm", "an empty arm and the arm after it each start a line",
        fmt_material.SRC_EMPTY_ARM_IN, fmt_material.SRC_EMPTY_ARM_OUT, arena)
    case_stable("deferout", "a bare defer and the blocks that stay do not move",
        fmt_material.SRC_DEFER_OUT, arena)
    case_stable("choicebr", "a split value in parentheses does not move",
        fmt_material.SRC_CHOICE_OUT, arena)
    // The three unmoved shapes test the other half. A formatter moving every trailing mark down
    // would pass the first alone. Then the run after a return type would quietly become the
    // declaration's own.
    case_becomes("below", "a description too long for its line stands below the mark",
        fmt_material.SRC_SUMMARY_IN, fmt_material.SRC_SUMMARY_OUT, arena)
    // Caution: **Format it twice.** A moved text still too long below the mark must stay whole on
    // the second formatting too. Else the summary grows a line only then, and `[W0213]` reports it.
    case_idempotent("belowtwice", "a description moved below changes nothing the second time",
        fmt_material.SRC_SUMMARY_IN, arena)
    // A narrow width breaks lines the default never does; the output must read as the input did,
    // and stay put.
    case_becomes("narrow", "at a narrow width a line breaks only where the reader joins it back",
        fmt_material.SRC_NARROW_IN, fmt_material.SRC_NARROW_OUT, arena, "--style=ColumnLimit: 40")
    case_becomes("narrowkept", "a narrow formatting does not move on the second formatting",
        fmt_material.SRC_NARROW_OUT, fmt_material.SRC_NARROW_OUT, arena, "--style=ColumnLimit: 40")
    // Idempotent either way, so only the expected value catches it.
    case_stable("innercmt", "a comment inside the braces is put out unbroken at the right level",
        fmt_material.SRC_INNER_COMMENT_IN, arena)
    // Caution: Check that the blank line after `}` is kept. It is the writer's paragraph
    // separator; dropped, functions and methods run into one another.
    case_becomes("blank",
        "the blank lines at a block's two ends are dropped and the one after `}` is kept",
        fmt_material.SRC_BLANK_IN, fmt_material.SRC_BLANK_OUT, arena)
    // Caution: Check that the file's heading does not move. It sits right above the first import,
    // so "a comment right above belongs to the import below" would move it along.
    case_becomes("imports", "the imports are sorted by name (the heading does not move)",
        fmt_material.SRC_IMPORTS_IN, fmt_material.SRC_IMPORTS_OUT, arena)
    // Caution: Check that a branch with a comment is not folded. Folded, the comment would take
    // the rest of the block's line with it.
    case_becomes("short", "AllowShortBlocks folds only a one-statement block with no comment",
        fmt_material.SRC_SHORT_IN, fmt_material.SRC_SHORT_OUT, arena,
        "--style=AllowShortBlocks: true")
    case_idempotent("messy", "the second formatting changes nothing (idempotent)",
        fmt_material.SRC_MESSY, arena)
    // Caution: Test the bodies that are not folded too. Folding a two-statement body, one with a
    // comment, or one over the column width breaks the comment or the width setting.
    case_becomes("shortfn", "AllowShortFunctions folds the body of a one-statement fn",
        fmt_material.SRC_SHORT_FN_IN, fmt_material.SRC_SHORT_FN_OUT, arena,
        "--style=AllowShortFunctions: true")
    case_becomes("bareline", "a one-line block leaves its last `;` out",
        fmt_material.SRC_BARE_LINE_IN, fmt_material.SRC_BARE_LINE_OUT, arena,
        "--style=AllowShortFunctions: true, AllowShortBlocks: true")
    case_unknown_style_key(arena)
    case_syntax_error_as_written(arena)
    fmt_cache.run(arena)
    return harness.finish()

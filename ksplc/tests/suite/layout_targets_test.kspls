#!/usr/bin/env -S ksplc run
//< The test that pins down that every size ksplc folds is the target machine's, for each machine
//<
//< For each row of the table of machines (`base/target.kspls`) the probe is compiled with
//< `--machine` and its C compiled by clang for the same machine: the C checks each folded number,
//< so one laid out wrongly fails there. **Each check is shown to fire**: a 32-bit machine's C
//< compiled for a 64-bit one, and the other way round, must fail. Where `wasm-ld` and `node` are
//< found, the wasm32 build runs, and each way a folded size decides the program answers 32 bits.
import "ksplc/base/target" as base_target
import "ksplc/tests/support/harness"
import "ksplc/usage"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/strfmt" as _strfmt
import "std/verdict"

priv const probe: U8[] = "tests/prog/layout_probe.kspls"
priv const probe_rt: U8[] = "tests/prog/layout_probe_rt.c"
priv const clang: U8[] = "clang" //< the C compiler: `--target` names any machine to it alone
priv const check_name: U8[] = "kspl_folded_for_" //<
    //< how a check's name begins, the machine after it
priv const min_checks: Sz = 20 //< the probe folds at least this many numbers on every machine
priv const wasm_machine: U8[] = "wasm32-unknown-unknown"

priv struct Answer //< one entry point of the probe and what it returns on wasm32
    name: U8[]
    want: U8[]

priv const wasm_answers: Answer[10] = ::{
    Answer::{ .name = "two_ptrs", .want = "8" },
    Answer::{ .name = "word_bits_if", .want = "32" },
    Answer::{ .name = "word_bits_const", .want = "32" },
    Answer::{ .name = "word_bits_top", .want = "32" },
    Answer::{ .name = "word_bits_case", .want = "32" },
    Answer::{ .name = "wide_len", .want = "48" },
    Answer::{ .name = "sizes_sum", .want = "94" },
    Answer::{ .name = "cast_len", .want = "2" },
    Answer::{ .name = "json_count", .want = "7" },
    Answer::{ .name = "json_after", .want = "99" },
} //<
    //< The numbers are wasm32's as clang lays it out (4-byte pointers and `Sz`, `I64` aligned to 8)
    //<
    //< A wrong fold shows as another number: 64 bits for `Sz`, 16 for two pointers, a JSON field
    //< read from the bytes of the next.

priv fn generate(dir: U8[], machine: U8[], arena: Arena$@): U8[] //<
    //< The probe's C for the machine, or empty where ksplc refuses it (the check is reported)
    out: = fs.join(dir, arena.text().s(machine).s(".c").take(), arena)
    r: = harness
        .ksplc(U8[][]::{ arena.text().s("--machine=").s(machine).take(), "--freestanding", probe,
        out })
    if !verdict.check(arena.text().s("\{machine\}: ksplc compiles the probe").take(), r.code == 0,
        r.out)
        return ""
    mark: = arena.text().s("typedef char ").s(check_name).take()
    count: = harness.read_generated(out).count_str(mark)
    verdict.check(arena.text().s("\{machine\}: the C checks every folded number").take(),
        count >= min_checks,
        arena.text().s("\{count\} checks, fewer than \{min_checks\}").take())
    return out

priv fn compile_for(c_file: U8[], machine: U8[], obj: U8[]): verdict.Run_out //<
    //< clang compiling the C for the machine, warnings refused (Principle 2)
    return harness
        .run(U8[][]::{ clang,
        harness.arena().text().s("--target=\{machine\}").take(), "-ffreestanding", "-std=c99", "-O2",
        "-Wall", "-Werror", "-c", c_file, "-o", obj })

priv fn check_machines(dir: U8[], arena: Arena$@): U8[] //<
    //< Every machine's C compiles for that machine; returns wasm32's C for the run that follows
    $wasm_c: U8[] = ""
    for m in base_target.machines
        name: = m.name
        c_file: = generate(dir, name, arena)
        if c_file.len == 0
            continue
        r: = compile_for(c_file, name, arena.text().s(c_file).s(".o").take())
        verdict.check(arena.text().s("\{name\}: clang agrees with every folded number").take(),
            r.code == 0, r.out)
        if name.equals(wasm_machine)
            wasm_c = c_file
    return wasm_c

priv const mismatched: U8[][2] = ::{ "thumbv7m-none-eabi", "x86_64-linux-gnu" } //<
    //< A 32-bit and a 64-bit machine, each one's C compiled for the other

priv const wasm_tools: U8[][2] = ::{ "wasm-ld", "node" } //< what building and running wasm32 takes

priv fn check_fires(dir: U8[], arena: Arena$@) //<
    //< A C folded for one machine and compiled for another fails at a check naming the first
    for i in Range.asc(2)
        folded: = mismatched[i]
        other: = mismatched[1 - i]
        c_file: = fs.join(dir, arena.text().s(folded).s(".c").take(), arena)
        r: = compile_for(c_file, other, fs.join(dir, "mismatch.o", arena))
        named: = arena.text().s(check_name).s(folded.replace("-", "_", arena)).take()
        verdict.check(arena.text().s("\{folded\}'s C compiled for \{other\} fails at a check")
            .take(), r.code != 0 && r.out.find_str(named).is_some(), r.out)

priv fn has_tool(name: U8[]): Bool //< whether the tool answers `--version`
    return harness.run(U8[][]::{ name, "--version" }).code == 0

priv const node_script: U8[] =
    "const m = await WebAssembly.instantiate(require('fs').readFileSync(process.argv[1]));for \
        (const n of process.argv.slice(2)) console.log(n + '=' + m.instance.exports[n]());" //<
            //< Calls each named entry point of the module and prints `name=value`, one a line
            //<
            //< The module imports nothing: the link refuses an undefined name, so none is borrowed.

priv fn check_wasm_run(dir: U8[], wasm_c: U8[], arena: Arena$@) //<
    //< The wasm32 build answers each way a folded size decides the program as wasm32 lays it out
    name: = "the probe built for wasm32 answers as wasm32 lays values out"
    if wasm_c.len == 0
        verdict.check(name, false, "no wasm32 C to build")
        return
    for tool in wasm_tools
        if !has_tool(tool)
            verdict.skip_check(name, arena.text().s("\{tool\} is not installed").take())
            return
    rt_o: = fs.join(dir, "rt.o", arena)
    probe_o: = arena.text().s(wasm_c).s(".o").take()
    if !verdict.check("the wasm32 helpers compile",
        compile_for(probe_rt, wasm_machine, rt_o).code == 0, "")
        return
    module: = fs.join(dir, "probe.wasm", arena)
    link: = harness
        .run(U8[][]::{ "wasm-ld", "--no-entry", "--gc-sections", probe_o, rt_o, "-o", module })
    if !verdict.check("the wasm32 module links, borrowing nothing", link.code == 0, link.out)
        return
    $argv: = List<|U8[]|>.new(arena)
    for word in U8[][]::{ "node", "-e",
        arena.text().s("(async () => { ").s(node_script).s(" })()").take(), module }
        argv.push(word)
    for a in wasm_answers
        argv.push(a.name)
    ran: = harness.run(argv.slice())
    if !verdict.check("the wasm32 module runs under node", ran.code == 0, ran.out)
        return
    for a in wasm_answers
        line: = arena.text().s(a.name).c('=').s(a.want).c('\n').take()
        verdict.check(arena.text().s("wasm32: \{a.name\} returns \{a.want\}").take(),
            ran.out.find_str(line).is_some(), ran.out)

priv const unlisted_host: U8[] = "riscv64-linux-gnu" //< a host machine the table has no row for

priv const analysing: U8[][7] = ::{ "compile", "lint", "lsp", "lsp-worker", "run", "build", "info" } //<
    //< The subcommands that lay values out, each of which must refuse a machine it has no row for

priv const parsing_only: U8[][5] = ::{ "fmt", "doc", "explain", "emit-runtime", "clean" } //<
    //< The subcommands that read no type, which run on a machine the table lacks

priv fn refusal(face: U8[], named: U8[], host: U8[], arena: Arena$@): U8[] //<
    //< What the subcommand says of the machine, empty where it goes on
    $b: = Str_builder.new()
    defer b.free()
    usage.machine_refusal_to(face, named, host, b@)
    return arena.dup_str(b.slice())

priv fn check_unlisted_host(arena: Arena$@) //<
    //< On a host the table lacks, every subcommand that lays values out says so, and no other asks
    //<
    //< The host is handed in as the table lookup reads it, as `kspl_host_machine` would answer on
    //< such a machine. **Each refusal names the host, `--machine=` and the known machines**; left
    //< unasked, the layout reaches an unknown machine and ksplc stops with an internal error.
    for face in analysing
        said: = refusal(face, "", unlisted_host, arena)
        verdict.check(arena.text().s("an unlisted host: \{face\} refuses, naming the fix").take(),
            said.find_str(unlisted_host).is_some() && said.find_str("--machine=").is_some() &&
            said.find_str("thumbv7m-none-eabi").is_some(), said)
    for face in parsing_only
        said: = refusal(face, "", unlisted_host, arena)
        verdict.check(arena.text().s("an unlisted host: \{face\} runs, reading no type").take(),
            said.len == 0, said)
    said: = refusal("compile", "pdp11-unknown", "x86_64-linux-gnu", arena)
    verdict.check("a named machine the table lacks is refused by its own name",
        said.find_str("'pdp11-unknown'").is_some(), said)
    verdict.check("a listed host needs no machine named",
        refusal("lsp", "", "x86_64-linux-gnu", arena).len == 0, "")

fn main(): I32
    arena: = harness.begin(64 * 1024 * 1024)
    dir: = harness.sandbox("layout_targets") catch
        return harness.fatal("cannot make a working directory")
    io.out().s("# the sizes ksplc folds, for each machine it knows\n")
    if !has_tool(clang)
        return harness.fatal("clang is not installed: it alone builds for every machine")
    wasm_c: = check_machines(dir, arena)
    check_fires(dir, arena)
    check_wasm_run(dir, wasm_c, arena)
    check_unlisted_host(arena)
    return harness.finish()

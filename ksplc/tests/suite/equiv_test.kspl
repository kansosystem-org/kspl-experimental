#!/usr/bin/env -S ksplc run
//< The backend-equivalence test
//< It builds the same program (`tests/prog/equiv.kspl`) on the C and the LLVM backend, runs both
//< and checks that their standard output agrees. The C is built under clang and gcc both, where
//< both are installed. Each fills in what C leaves open (an evaluation order) its own way. It is
//< built once more with C's traps for a misaligned access and a signed overflow, and at `-O2`
//< under each compiler, where C's own assumptions (strict aliasing) could change the answer.
//< Caution: **Link through the harness's function.** List the libraries yourself, and the two
//< builds run under different conditions (Windows's stack size and the like). That shows as "a
//< difference between the backends' output". The source is passed as a **relative path**
//< (resolved at cwd = the root).
import "ksplc/tests/support/harness"
import "ksplc/tests/support/harness_build"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"

priv const SRC: U8[] = "tests/prog/equiv.kspl"
priv const FOR_INDEX: U8[] = "__k_for_idx" //< how the C names the index of a `for … in`

priv const TRAP_CFLAGS: U8[][_] = ::{ "-std=c99", "-O0",
    "-fsanitize=alignment,signed-integer-overflow",
    "-fsanitize-trap=alignment,signed-integer-overflow" } //<
        //< C's traps for what C leaves undefined and KSPL defines, which stop the program
        //< A trap needs no sanitizer library, so every C compiler the suite runs on can build it.
        //< **At `-O0` a misaligned store or an `int` overflow still answers right.** So only a trap
        //< shows that the C is undefined.

priv const OPT_CFLAGS: U8[][_] = ::{ "-std=c99", "-O2" } //<
    //< The level a program ships at (`ksplc build`), where the optimizer acts on C's assumptions
    //< A store through one pointer type and a read through another (`pun_word` in
    //< `tests/prog/equiv_shapes.kspl`) keep the old value at `-O2` unless the build passes ksplc's
    //< `-fno-strict-aliasing` (`info exe-flags`, which the harness adds).

priv const TRAP_PROBE: U8[] =
    """static int words[2];
int main(void) {
    volatile int one = 1;
    int *q = (int *)((char *)words + one);
    *q = 3;
    return 0;
}
""" //< a misaligned store, which a build with trap_cflags must stop on

priv struct Built //< the result of building and running
    //< Caution: **Do not mix "it did not build" with "the output was empty".**
    ok: Bool
    out: U8[]

priv fn built(ok: Bool, out: U8[]): Built
    return Built::{ .ok = ok, .out = out }

priv fn build_run(llvm: Bool, gen: U8[], exe: U8[], cflags: U8[][], arena: Arena$@): Built //<
    //< It builds and runs on one of the backends
    $args: = List<|U8[]|>(arena)
    if llvm
        args.push("--to=llvm")
    args.push(SRC)
    args.push(gen)
    g: = harness.ksplc(args.slice())
    if !g.exited_with(0)
        return built(false, g.out)
    b: =
        (harness_build.build_llvm_exe(U8[][]::{ gen }, exe, cflags) if llvm
        else harness_build.build_exe(U8[][]::{ gen }, exe, cflags))
    if !b.exited_with(0)
        return built(false, b.out)
    return run_built(exe, arena)

priv fn run_built(exe: U8[], arena: Arena$@): Built //< it runs a built executable
    // Caution: **Compare the exit code as well.** The path that turns `main`'s Result error type
    // into the process's exit code prints nothing to standard output (`emit_numeric_to_i32` in
    // gen/llvm/types.kspl). Compare only the output and a disagreement on that path **leaves
    // nothing on the screen**.
    r: = harness.run(U8[][]::{ exe })
    return built(true,
        arena.text().s(r.out).s("exit=\{r.code.unwrap_or(-1)\}\n").take())

priv fn other_cc(): U8[] //< the other family's C compiler (gcc beside clang), empty where none
    //< Caution: **Ask the compiler what it is.** macOS's `gcc` is clang, and a build under it would
    //< pass for the gcc check while seeing clang's order.
    switch harness_build.is_clang(harness.cc())
    case .some(mine)
        other: = "gcc" if mine else "clang"
        switch harness_build.is_clang(other)
        case .some(theirs)
            if theirs != mine
                return other
        default {}
    default {}
    return ""

priv fn binary_literals(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< The binary literals left in the generated C
    //< Caution: **Leave no binary literal in the generated C.** C99 has no `0b1010`; it passes only
    //< as a gcc/clang extension, where the values agree, so this checks the text.
    $out: = List<|U8[]|>(arena)
    for i in Range.asc(text.len)
        if text[i] != '0' || i + 2 >= text.len
            continue
        if text[i + 1] != 'b' && text[i + 1] != 'B'
            continue
        if i > 0 && (text[i - 1].is_alnum() || text[i - 1] == '_')
            continue
        $end: = i + 2
        for end < text.len && (text[end] == '0' || text[end] == '1')
            end += 1
        if end > i + 2 &&
            !(end < text.len && (text[end].is_alnum() || text[end] == '_'))
            out.push(text.sub(i, end - i))
    return out

fn main(): I32
    arena: = harness.begin(64 * 1024 * 1024)
    dir: = harness.sandbox("equiv")
    work: = dir
    c_gen: = fs.join(work, "c.c", arena)
    c: =
        build_run(false, c_gen, fs.join(work, "c.exe", arena),
        U8[][]::harness_build.DEFAULT_CFLAGS, arena)
    if !c.ok
        verdict.check("the C backend's build", false, c.out)
        return harness.finish()
    gen_text: = io.read_file(c_gen, null) catch
        return harness.fatal("cannot read the generated C")
    lits: = binary_literals(gen_text, arena)
    found: = arena.text()
    for i in Range.asc(lits.len)
        found.s(", " if i > 0 else "").s(lits.get(i))
    verdict.check("there is no binary literal in the generated C", lits.len == 0, found.take())
    check_for_in_index(gen_text, arena)
    check_traps(work, c_gen, c.out, arena)
    check_level(harness.cc(), c_gen, fs.join(work, "c_o2.exe", arena), c.out, arena)
    alt_cc: = other_cc()
    // **Mandatory where `KANSO_REQUIRE_BOTH_CC=1`** (set on Linux, whose image holds both).
    if alt_cc.len == 0
        harness.require_or_skip("the C output agrees under gcc and clang", "KANSO_REQUIRE_BOTH_CC",
            "only one of the two C compilers is installed")
    else
        alt_exe: = fs.join(work, "c_alt.exe", arena)
        a: = harness_build.build_exe_with(alt_cc, U8[][]::{ c_gen }, alt_exe,
            U8[][]::harness_build.DEFAULT_CFLAGS)
        if !a.exited_with(0)
            verdict.check("the C build under the other compiler", false, a.out)
        else
            alt: = run_built(alt_exe, arena)
            verdict.check("the C output agrees under gcc and clang", c.out.equals(alt.out),
                harness_build.first_diff(c.out, harness.cc(), alt.out, alt_cc, arena))
        check_level(alt_cc, c_gen, fs.join(work, "c_alt_o2.exe", arena), c.out, arena)
    l: =
        build_run(true, fs.join(work, "l.ll", arena), fs.join(work, "l.exe", arena),
        U8[][]::harness_build.LLVM_CFLAGS, arena)
    if !l.ok
        verdict.check("the LLVM backend's build", false, l.out)
        return harness.finish()
    verdict.check("the C and LLVM output agree", c.out.equals(l.out),
        harness_build.first_diff(c.out, "C", l.out, "LLVM", arena))
    return harness.finish()

priv fn check_level(cc: U8[], c_gen: U8[], exe: U8[], want: U8[], arena: Arena$@) //<
    //< The C built by cc at `-O2` prints what the `-O0` build does
    b: = harness_build.build_exe_with(cc, U8[][]::{ c_gen }, exe, U8[][]::OPT_CFLAGS)
    name: = arena.text().s("the C output agrees at -O0 and -O2 under ").s(cc).take()
    if !b.exited_with(0)
        verdict.check(name, false, b.out)
        return
    got: = run_built(exe, arena)
    verdict.check(name, got.out.equals(want),
        harness_build.first_diff(want, "-O0", got.out, "-O2", arena))

priv fn check_for_in_index(text: U8[], arena: Arena$@) //<
    //< Every index a `for … in` counts with is an `Sz`, as wide as the length it is held below
    //< An `I32` index wraps past 2^31 and reads outside a longer slice. Running that many steps
    //< costs seconds, so the text of the declaration is checked; sema gives both backends the type.
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for line in text.lines(arena)
        t: = line.trim_spaces()
        // A declaration is the one line where nothing but a type stands before the name.
        at: = t.find_str(FOR_INDEX).unwrap_or(0)
        head: = t.sub(0, at)
        if at == 0 || head.find_str("=").is_some() || head.find_str("(").is_some()
            continue
        seen += 1
        if !head.ends_with("Sz ")
            bad.push(t)
    verdict.check_list("a `for … in` counts its index in `Sz`", seen, "indexes", bad@,
        "declare the index as `Sz` (build_index_loop in `sema/body/for_in.kspl`)")

priv fn check_traps(work: U8[], c_gen: U8[], want: U8[], arena: Arena$@) //<
    //< The C built with trap_cflags prints what the plain build does, and the traps can fire
    probe_c: = fs.join(work, "trap_probe.c", arena)
    io.write_file(probe_c, TRAP_PROBE) catch
        verdict.check("a misaligned store stops a build with C's traps", false,
            "cannot write the probe")
        return
    probe_exe: = fs.join(work, "trap_probe.exe", arena)
    pb: = harness_build.build_exe(U8[][]::{ probe_c }, probe_exe, U8[][]::TRAP_CFLAGS)
    verdict.check("a misaligned store stops a build with C's traps",
        pb.exited_with(0) && !harness.run(U8[][]::{ probe_exe }).exited_with(0), pb.out)
    trap_exe: = fs.join(work, "c_trap.exe", arena)
    tb: = harness_build.build_exe(U8[][]::{ c_gen }, trap_exe, U8[][]::TRAP_CFLAGS)
    if !tb.exited_with(0)
        verdict.check("the C build with C's traps", false, tb.out)
        return
    t: = run_built(trap_exe, arena)
    got: = t.out.lines(arena)
    verdict.check("the C output agrees with C's traps for a misaligned access and a signed overflow",
        t.out.equals(want),
        arena.text().s("it ended with '").s(got.get(got.len - 1) if got.len > 0 else "")
        .s("'; a trap stops it early, with a signal's exit code").take())

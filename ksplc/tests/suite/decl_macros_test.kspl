#!/usr/bin/env -S ksplc run
//< It checks that KSPL handles **every one** of the names the declaration-half headers `#define`
//< In ISO C99, and in GNU C mode, which adds names such as `linux` and `unix`.
//< Caution: **Do not keep the list of replaced names by hand.** Which names get replaced changes
//< with libc's version. A name erased by `#undef` disappears from `-dM -E`'s output, so the output
//< itself lists the names not yet erased. **Do not pin down which names or how many pass**, only
//< that every one is handled.
import "ksplc/tests/support/harness"
import "ksplc/tests/support/harness_build"
import "std/chars"
import "std/ds" { List, Map }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"

priv const IMPL_MARK: U8[] = "/* ---- kspl runtime implementation half ---- */\n" //<
    //< The mark for the start of the definition half
    //< The source is `IMPL_HALF_MARK` in `ksplc/gen/runtime.kspl`.

priv fn is_kspl_identifier(name: U8[], keywords: Map<|U8[], Bool|>@): Bool //<
    //< Whether the name can be written as a KSPL identifier
    //< **A name that cannot be written is out of scope.** `true` / `false` stop at KSPL's syntax
    //< diagnostic before reaching C.
    if name.len == 0
        return false
    if !(name[0].is_alpha() || name[0] == '_')
        return false
    for i in Range.asc(name.len)
        if !(name[i].is_alnum() || name[i] == '_')
            return false
    return !keywords.get(name).unwrap_or(false)

priv fn is_snake_case(name: U8[]): Bool //<
    //< Whether [I0502] stays silent on name at every position where a bare name is written
    //< Those positions are a local variable, a formal parameter and a field.
    //< **This sets the check's scope.** Loosen it and the test demands names the naming check
    //< rejects; tighten it and names that really can collide are missed.
    if name.len == 0 || !name[0].is_lower()
        return false
    for i in Range.asc(name.len)
        if !(name[i].is_lower() || name[i].is_digit() || name[i] == '_')
            return false
    return true

priv fn is_upper_snake_case(name: U8[]): Bool //<
    //< Whether [I0502] stays silent on name as a local constant, the other position written bare
    //< The headers spell most of their constants so (`M_E`, `SIZE_MAX`, `SIGINT`).
    if name.len == 0 || !name[0].is_upper()
        return false
    for i in Range.asc(name.len)
        if !(name[i].is_upper() || name[i].is_digit() || name[i] == '_')
            return false
    return true

priv fn keywords_of(arena: Arena$@): Map<|U8[], Bool|>$@ //<
    //< It collects the reserved words from `ksplc info keywords`'s output (one per line)
    out: = arena.create(Map<|U8[], Bool|>(arena))
    r: = harness.ksplc_bare(U8[][]::{ "info", "keywords" })
    if !r.exited_with(0)
        return out
    for line in r.out.lines(arena)
        if line.len > 0
            out.set(line, true)
    return out

priv fn object_macro_name(line: U8[]): U8[] //<
    //< From one line of `cc -dM -E`, it extracts an object-like macro's name
    //< Caution: **Do not include the function-like form (`#define max(a,b) ...`).** It expands only
    //< before a `(`, so an identifier of the same name is safe. A space right after the name tells
    //< them apart.
    head: U8[] = "#define "
    if !line.starts_with(head)
        return ""
    rest: = line.sub_from(head.len)
    $i: Sz = 0
    for i < rest.len && (rest[i].is_alnum() || rest[i] == '_')
        i += 1
    if i == 0 || i >= rest.len || !rest[i].is_space()
        return ""
    return rest.sub(0, i)

priv fn program_using(names: List<|U8[]|>, consts: List<|U8[]|>, arena: Arena$@): U8[] //<
    //< It builds one KSPL program that uses each of names wherever a bare name is written
    //< Each of consts is a local constant. Caution: **Put them into one program.** One per name
    //< means dozens of builds; in one, the C compiler's error still names the name that failed.
    b: = arena.text()
    b.s("priv fn local_consts(): I32\n  $total: I32 = 0\n")
    for n in consts
        b.s("  const ").s(n).s(": I32 = 1\n  total += ").s(n).s("\n")
    b.s("  return total\n\n")
    // Caution: **Write Holder only when names holds one.** A struct needs a field, and on Windows
    // GNU mode adds only constants (`WIN32`, `WINNT`), so names can be empty while consts is not.
    if names.len > 0
        b.s("struct Holder\n")
        for n in names
            b.s("  ").s(n).s(": I32\n")
        b.s("\n")
        // Each name as an enum's case with a payload, which names the union's member.
        b.s("enum Cases\n")
        for n in names
            b.s("  ").s(n).s("(v: I32)\n")
        b.s("\npriv fn case_value(c: Cases): I32\n  switch c\n")
        for n in names
            b.s("  case .").s(n).s("(v)\n    return v\n")
        b.s("\n")
    // Caution: **Put the formal parameter and the local in different functions.** The same name for
    // both in one function is a redefinition in C, a fault of the test program rather than of KSPL.
    for n in names
        b.s("priv fn take_").s(n).s("(").s(n).s(": I32): I32\n  return ").s(n).s("\n\n")
        b.s("priv fn local_").s(n).s("(v: I32): I32\n  ").s(n).s(": = v + 1\n  return ").s(n)
            .s("\n\n")
    b.s("fn main(): I32\n  $total: I32 = 0\n")
    if names.len > 0
        b.s("  h: Holder = ::{ ")
        for n in names
            b.s(".").s(n).s(" = 1, ")
        b.s("}\n  held: Holder@ = h@\n")
    for n in names
        b.s("  total += take_").s(n).s("(h.").s(n).s(") + held.").s(n).s(" + local_").s(n)
            .s("(1) + case_value(Cases.").s(n).s("(1))\n")
    b.s("  total += local_consts()\n  return 0 if total > 0 else 1\n")
    return b.take()

priv fn check_gnu_mode(decl: U8[], iso: U8[], keywords: Map<|U8[], Bool|>@, work: U8[],
    arena: Arena$@) //<
        //< That the names GNU C mode alone defines as macros (`linux`, `unix`) pass as bare names
        //< `iso` is the ISO mode's `-dM -E` output. The material builds with `-std=gnu11`, the mode
        //< a C compiler takes when no `-std` is given.
    probe: = harness.run(U8[][]::{ harness.cc(), "-std=gnu11", "-dM", "-E", decl })
    if !probe.exited_with(0)
        verdict.check("cc lists the GNU mode's macros (`-std=gnu11 -dM -E`)", false, probe.out)
        return
    $in_iso: = Map<|U8[], Bool|>(arena)
    for line in iso.lines(arena)
        in_iso.set(object_macro_name(line), true)
    $names: = List<|U8[]|>(arena)
    $consts: = List<|U8[]|>(arena)
    for line in probe.out.lines(arena)
        name: = object_macro_name(line)
        if name.len == 0 || in_iso.get(name).unwrap_or(false) ||
            !is_kspl_identifier(name, keywords)
            continue
        if is_snake_case(name)
            names.push(name)
        else if is_upper_snake_case(name)
            consts.push(name)
    if names.len == 0 && consts.len == 0
        return
    src: = fs.join(work, "gnu_macro_names.kspl", arena)
    io.write_file(src, program_using(names, consts, arena)) catch
        verdict.check("the GNU mode's material is written", false, src)
        return
    gen: = fs.join(work, "gnu_macro_names.c", arena)
    exe: = fs.join(work, "gnu_macro_names.exe", arena)
    t: = harness.ksplc(U8[][]::{ src, gen })
    $out: = t.out
    $ok: = t.exited_with(0)
    if ok
        b: = harness_build.build_exe(U8[][]::{ gen }, exe, U8[][]::{ "-std=gnu11", "-O0" })
        ok = b.exited_with(0) && harness.run(U8[][]::{ exe }).exited_with(0)
        out = b.out
    verdict.check("every name GNU mode alone defines as a macro passes as a bare name", ok,
        arena.text().s("Add the name the C compiler's error named to `is_gnu_macro` in ")
        .s("`ksplc/base/c_name.kspl`.\n").s(out).take())

fn main(): I32
    arena: = harness.begin(16 * 1024 * 1024)
    work: = harness.sandbox("declmacro")

    // The declaration half; `emit-runtime` does not take `--std-dir`, so ksplc_bare is used.
    rt: = fs.join(work, "runtime.c", arena)
    e: = harness.ksplc_bare(U8[][]::{ "emit-runtime", rt })
    if !e.exited_with(0)
        return harness.fatal(arena.text().s("emit-runtime failed\n\{e.out\}").take())
    text: = harness.read_generated(rt)
    cut: Sz = text.find_str(IMPL_MARK) catch
        return harness.fatal("no mark for the body half (impl_half_mark in ksplc/gen/runtime.kspl)")
    decl: = fs.join(work, "decl_half.c", arena)
    half: = arena.text()
    half.s(text.sub(0, cut)).s("\nint main(void) { return 0; }\n")
    io.write_file(decl, half.take()) catch
        return harness.fatal("the declaration half cannot be written")

    probe: = harness.run(U8[][]::{ harness.cc(), "-std=c99", "-dM", "-E", decl })
    if !probe.exited_with(0)
        return harness
            .fatal(arena.text().s("cc cannot list the declaration half's macros (`-dM -E`)\n")
            .s(probe.out).take())
    keywords: = keywords_of(arena)
    check_gnu_mode(decl, probe.out, keywords, work, arena)
    $names: = List<|U8[]|>(arena)
    $consts: = List<|U8[]|>(arena)
    $skipped: Sz = 0
    for line in probe.out.lines(arena)
        name: = object_macro_name(line)
        if name.len == 0
            continue
        // Neither spelling: the naming check rejects it, so it is out of scope.
        if !is_kspl_identifier(name, keywords)
            skipped += 1
        else if is_snake_case(name)
            names.push(name)
        else if is_upper_snake_case(name)
            consts.push(name)
        else
            skipped += 1
    verdict.check("the counting up is not empty (cc's output is being read)",
        names.len > 0 || consts.len > 0 || skipped > 0, probe.out)
    verdict.check("the constants' spelling is counted up too (`SIZE_MAX` from <stdint.h>)",
        consts.len > 0, probe.out)
    if names.len == 0 && consts.len == 0
        return harness.finish()

    src: = fs.join(work, "decl_macro_names.kspl", arena)
    body: = program_using(names, consts, arena)
    io.write_file(src, body) catch
        return harness.fatal("cannot write the material")
    b: = harness_build.build_and_run(src, work, "decl_macro_names", U8[][]::{})
    why: = arena.text()
    why
        .s("the material using the \{names.len + consts.len\} counted up at every position does not \
            build.\n").s("Caution: Add the name the C compiler's error named to the `#undef` in ")
        .s("`ksplc/gen/c/ctx.kspl`,\nor if it cannot be erased, to `is_preamble_macro` in ")
        .s("`ksplc/base/c_name.kspl`.\n").s(b.out)
    note: = why.take()
    verdict.check("every name the declaration half's macros replace passes as a bare name",
        b.built && b.code.unwrap_or(-1) == 0, note)
    return harness.finish()

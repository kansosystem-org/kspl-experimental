#!/usr/bin/env -S ksplc run
//< Two vendors ship libraries built from KSPL, and a C and a KSPL customer link them
//<
//< The vendors' sources are in `ksplc/tests/ship/`; every command is one the shipping section of
//< `ksplc/docs/SPEC-tools.md` shows. The same two libraries built without `--library` must collide
//< at the link, or the check that they no longer do proves nothing.
//< Caution: **Link both forms, static and shared**: a symbol left visible collides only in an
//< archive, and in a shared library binds to the other library's copy without a word.
import "ksplc/tests/support/harness"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena, dealloc }
import "std/str"
import "std/strfmt" as _strfmt
import "std/subproc"
import "std/sys"
import "std/verdict"

priv const fixture_dir: U8[] = "tests/ship" //< the vendors' and the customers' sources

priv const output_cap: Sz = 64 * 1024 //< how much of each of a customer's outputs is kept

priv const libs: U8[][2] = ::{ "greet", "count" } //< the two vendors' libraries

priv const exports: U8[][6] = ::{ "count_parse", "count_words", "greet_gone_peer", "greet_hello",
    "greet_norm", "greet_stop" } //< every `#export` of the two, which alone may stay visible outside them

priv const c_expected: U8[] =
    """host starts
hello 0
hello 1
norm of (3, 4) is 5.0
count: 3 words
host: parsed 1234, then code 1
host: a write to a gone peer failed
host ends
""" //< what the C customer prints, its library calls between its own lines

priv const app_expected: U8[] =
    """app starts
hello 0
hello 1
hello 2
norm of (6, 8) is 10.0
app: 24 bytes, norm 10
""" //< what the KSPL customer prints

priv const header_flags: U8[][6] = ::{ "-std=c99", "-Wall", "-Wextra", "-Werror",
    "-Wstrict-prototypes", "-fsyntax-only" } //< the strictest C99 a customer may build with

priv const cross_cc: U8[] = "x86_64-w64-mingw32-gcc" //< the cross compiler for Windows
priv const cross_ar: U8[] = "x86_64-w64-mingw32-ar"

priv struct Toolchain //< one C toolchain, as the steps below spell a library with it
    cc: U8[]
    ar: U8[]
    windows: Bool //< a `.dll` with its import library, not a `.so`
    macho: Bool //< a `.dylib` found through `@rpath`
    link_libs: U8[][] //< `ksplc info link-libs`'s answer for this toolchain's target

priv fn has_tool(name: U8[]): Bool //< whether the tool answers `--version`
    return harness.run(U8[][]::{ name, "--version" }).code == 0

priv fn link_libs_for(cc: U8[], arena: Arena$@): U8[][] //<
    //< `ksplc info link-libs` asked for the target `cc` builds for
    //<
    //< ksplc reads the target from `CC`, so it is set for the one question and then put back.
    before: = arena.dup_str(sys.get_env("CC").unwrap_or(""))
    sys.set_env("CC", cc) catch panic("CC could not be set")
    r: = harness.run(U8[][]::{ harness.ksplc_exe(), "info", "link-libs" })
    if before.len > 0
        sys.set_env("CC", before) catch panic("CC could not be set")
    else
        sys.unset_env("CC") catch panic("CC could not be unset")
    $out: = List<|U8[]|>.new(arena)
    for w in r.out.trim_spaces().split(' ', arena)
        if w.len > 0
            out.push(w)
    return out.slice()

priv fn ok_step(name: U8[], argv: U8[][], dir: U8[]): Bool //<
    //< runs one step; its failure is a FAIL
    r: = harness.run_in(argv, dir)
    return verdict.check(name, r.code == 0, r.out)

priv fn argv_of(head: U8[][], tail: U8[][], arena: Arena$@): U8[][] //< two runs of words as one
    $out: = List<|U8[]|>.new(arena)
    for w in head
        out.push(w)
    for w in tail
        out.push(w)
    return out.slice()

priv fn copy_in(names: U8[][], to: U8[], arena: Arena$@): Bool //< copies fixtures into a place
    for n in names
        body: = io.read_file(fs.join(fixture_dir, n, arena)) catch
            return false
        defer dealloc(Void$@::body.ptr)
        io.write_file(fs.join(to, n, arena), body) catch
            return false
    return true

priv fn vendor_builds(vendor: U8[], arena: Arena$@): Bool //<
    //< Each vendor's C and interfaces, as the vendor makes them: one compile writes them all
    $all: = true
    for lib in libs
        $argv: = List<|U8[]|>.new(arena)
        argv.push(arena.text().s("--library=\{lib\}.h").take())
        // **greet ships both forms from the one compile**; count ships its C header alone.
        if lib.equals("greet")
            argv.push("--library=greet_api.kspls")
        argv.push(arena.text().s("\{lib\}.kspls").take())
        argv.push(arena.text().s("\{lib\}.c").take())
        all =
            all &&
            ok_step(arena.text().s("vendor \{lib\} builds with --library and writes its interfaces")
            .take(), harness.ksplc_argv(argv.slice()), vendor)
    return all

priv fn check_private(vendor: U8[], obj_dir: U8[], arena: Arena$@) //<
    //< Only the `#export` functions are visible outside each library's object
    //<
    //< **Every runtime and std function is in the object**, used or not, so this catches a
    //< definition that left out `KSPL_LINK` without listing names.
    name: = "only the #export functions are visible outside a --library object"
    nm: = "nm"
    if !has_tool(nm)
        verdict.skip_check(name, "nm is not installed")
        return
    $bad: = List<|U8[]|>.new(arena)
    for lib in libs
        r: = harness.run_in(U8[][]::{ nm, "--defined-only", "--extern-only",
            fs.join(obj_dir, arena.text().s("\{lib\}.o").take(), arena) }, vendor)
        if r.code != 0
            bad.push(arena.text().s("nm cannot read \{lib\}.o: \{r.out\}").take())
            continue
        for line in r.out.lines(arena)
            sym: = last_word(line, arena)
            if sym.len > 0 && line.find_char(':').is_none() && !is_export(sym)
                bad
                    .push(arena.text().s("\{lib\}.o: ").s(line.trim_spaces()).take())
    verdict.check(name, bad.len == 0, "\n".join(bad, arena))

priv fn last_word(line: U8[], arena: Arena$@): U8[] //< a line's last word (nm's symbol name)
    $last: = ""
    for w in line.trim_spaces().split(' ', arena)
        if w.len > 0
            last = w
    return last

priv fn is_export(sym: U8[]): Bool //< whether it is one of the `#export` names
    for e in exports
        if sym.equals(e)
            return true
    return false

priv fn build_static(tc: Toolchain, vendor: U8[], dir: U8[], arena: Arena$@): Bool //<
    //< Each library as an archive in `dir`: an object, then `ar`
    $all: = true
    for lib in libs
        obj: = fs.join(dir, arena.text().s("\{lib\}.o").take(), arena)
        all =
            all &&
            ok_step(arena.text().s("\{lib\}'s C compiles with \{tc.cc\}").take(),
            U8[][]::{ tc.cc, "-std=c99", "-c", arena.text().s("\{lib\}.c").take(), "-o", obj },
            vendor)
        all =
            all &&
            ok_step(arena.text().s("lib\{lib\}.a is archived with \{tc.ar\}").take(),
            U8[][]::{ tc.ar, "rcs",
            fs.join(dir, arena.text().s("lib\{lib\}.a").take(), arena), obj }, vendor)
    return all

priv fn build_shared(tc: Toolchain, vendor: U8[], dir: U8[], arena: Arena$@): Bool //<
    //< Each library as a shared one in `dir`, with its link libraries named
    $all: = true
    for lib in libs
        $argv: = List<|U8[]|>.new(arena)
        argv.push(tc.cc)
        argv.push("-std=c99")
        argv.push(arena.text().s("\{lib\}.c").take())
        if tc.windows
            argv.push("-shared")
            // Caution: **Keep `-static-libgcc`**: without it the DLL needs MinGW's libgcc_s, which
            // a customer's machine lacks ("Shipping a library and using it" in
            // ksplc/docs/SPEC-tools.md).
            argv.push("-static-libgcc")
            argv.push("-o")
            argv.push(fs.join(dir, arena.text().s("\{lib\}.dll").take(), arena))
            argv
                .push(arena.text().s("-Wl,--out-implib,")
                .s(fs.join(dir, arena.text().s("lib\{lib\}.dll.a").take(), arena)).take())
        else if tc.macho
            argv.push("-dynamiclib")
            argv
                .push(arena.text().s("-Wl,-install_name,@rpath/lib\{lib\}.dylib").take())
            argv.push("-o")
            argv
                .push(fs.join(dir, arena.text().s("lib\{lib\}.dylib").take(), arena))
        else
            argv.push("-fPIC")
            argv.push("-shared")
            argv.push("-o")
            argv
                .push(fs.join(dir, arena.text().s("lib\{lib\}.so").take(), arena))
        for w in tc.link_libs
            argv.push(w)
        all =
            all &&
            ok_step(arena.text().s("lib\{lib\} links as a shared library with \{tc.cc\}").take(),
            argv.slice(), vendor)
    return all

priv fn link_main(tc: Toolchain, vendor: U8[], dir: U8[], shared: Bool, arena: Arena$@): U8[] //<
    //< The C customer linked against the libraries in `dir`; the executable's path, or empty
    exe: = fs.join(dir, "main.exe", arena)
    $argv: = List<|U8[]|>.new(arena)
    argv.push(tc.cc)
    argv.push("-std=c99")
    argv.push("main.c")
    argv.push(arena.text().s("-L").s(dir).take())
    argv.push("-lgreet")
    argv.push("-lcount")
    // A shared library is found beside the executable on Windows, elsewhere through the rpath.
    if shared && !tc.windows
        argv.push(arena.text().s("-Wl,-rpath,").s(dir).take())
    for w in tc.link_libs
        argv.push(w)
    argv.push("-o")
    argv.push(exe)
    form: = "shared" if shared else "static"
    ok: =
        ok_step(arena.text().s("main.c links both \{form\} libraries with \{tc.cc\}").take(),
        argv.slice(), vendor)
    return exe if ok else ""

priv fn check_runs(name: U8[], argv: U8[][], expected: U8[], dir: U8[], arena: Arena$@) //<
    //< Runs a customer and compares its standard output, with Windows's line ends read as `\n`
    //<
    //< **Only standard output is compared**: a customer prints there alone, while a host the run
    //< goes through (Wine) writes its own notices to standard error. Stderr is still shown on a
    //< failure.
    r: = subproc.run_capture(argv, dir, verdict.default_timeout_ms, output_cap, arena)
    got: = r.stdout_data.replace("\r\n", "\n", arena)
    ended: = !r.spawn_failed && !r.timed_out
    verdict.check(name, ended && r.exit_code == 0 && got.equals(expected),
        arena.text().s("exit code \{r.exit_code\} (started \{!r.spawn_failed\}, timed out ")
        .s("\{r.timed_out\}); it printed:\n\{got\}\non standard error:\n").s(r.stderr_data).take())

priv fn check_collision(tc: Toolchain, vendor: U8[], dir: U8[], arena: Arena$@) //<
    //< The two libraries built without `--library` collide at the link
    //<
    //< **This is the failure `--library` removes**; were it to link, the check above that the
    //< libraries link together would show nothing.
    for lib in libs
        c_file: = arena.text().s("plain_\{lib\}.c").take()
        obj: = fs.join(dir, arena.text().s("\{lib\}.o").take(), arena)
        if !ok_step(arena.text().s("\{lib\} builds without --library").take(),
            harness
            .ksplc_argv(U8[][]::{ arena.text().s("\{lib\}.kspls").take(), c_file }), vendor)
            return
        if !ok_step(arena.text().s("\{lib\}'s plain C compiles").take(),
            U8[][]::{ tc.cc, "-std=c99", "-c", c_file, "-o", obj }, vendor)
            return
        harness.run_in(U8[][]::{ tc.ar, "rcs",
            fs.join(dir, arena.text().s("lib\{lib\}.a").take(), arena), obj }, vendor)
    $argv: = List<|U8[]|>.new(arena)
    for w in U8[][]::{ tc.cc, "-std=c99", "main.c",
        arena.text().s("-L").s(dir).take(), "-lgreet", "-lcount" }
        argv.push(w)
    for w in tc.link_libs
        argv.push(w)
    argv.push("-o")
    argv.push(fs.join(dir, "main.exe", arena))
    r: = harness.run_in(argv.slice(), vendor)
    collided: =
        r.code != 0 &&
        (r.out.find_str("multiple definition").is_some() ||
        r.out.find_str("duplicate symbol").is_some())
    verdict.check("two libraries built without --library collide at the link", collided,
        arena.text().s("exit code \{r.code\}:\n\{r.out\}").take())

priv fn check_stop(exe: U8[], dir: U8[], arena: Arena$@) //<
    //< A panic inside a library ends the program, its own output written first
    //<
    //< Standard output is a pipe here, fully buffered, so its line shows only if the panic flushed
    //< it. The two streams are read joined, so their order is not checked.
    r: = harness.run_in(U8[][]::{ exe, "stop" }, dir)
    out: = r.out.replace("\r\n", "\n", arena)
    verdict.check("a panic in a library ends the program, its earlier output flushed",
        r.code != 0 && out.find_str("greet stops here\n").is_some() &&
        out.find_str("panic: greet was asked to stop").is_some(),
        arena.text().s("exit code \{r.code\}; it printed:\n\{out\}").take())

priv fn kspl_customer(tc: Toolchain, vendor: U8[], root: U8[], arena: Arena$@) //<
    //< The KSPL customer, given greet's interface and archive but not its source
    customer: = fs.join(root, "customer", arena)
    fs.mkdir_all(customer) catch
        verdict.check("the customer's place can be made", false, customer)
        return
    if !copy_in(U8[][]::{ "app.kspls" }, customer, arena)
        verdict.check("the KSPL customer's source can be copied", false, "")
        return
    for name in U8[][]::{ "greet_api.kspls", "libgreet.a" }
        from: = fs.join(vendor if name.ends_with(".kspls")
            else fs.join(vendor, "static", arena), name, arena)
        body: = io.read_file(from) catch
            verdict.check(arena.text().s("\{name\} reaches the customer").take(), false, from)
            return
        defer dealloc(Void$@::body.ptr)
        io.write_file(fs.join(customer, name, arena), body) catch
            verdict.check(arena.text().s("\{name\} reaches the customer").take(), false, customer)
            return
    if !ok_step("the KSPL customer builds against greet's interface",
        harness.ksplc_argv(U8[][]::{ "--emit-libs=app.libs", "app.kspls", "app.c" }), customer)
        return
    named: = harness.read_generated(fs.join(customer, "app.libs", arena))
    verdict.check("the KSPL customer's --emit-libs carries the library greet names",
        named.find_str("-lm").is_some(),
        arena.text().s("app.libs holds: \{named\}").take())
    exe: = fs.join(customer, "app.exe", arena)
    if !ok_step("the KSPL customer links libgreet.a",
        argv_of(U8[][]::{ tc.cc, "-std=c99", "app.c", "-L.", "-lgreet", "@app.libs" },
        argv_of(tc.link_libs, U8[][]::{ "-o", exe }, arena), arena), customer)
        return
    check_runs("the KSPL customer runs with greet's library", U8[][]::{ exe }, app_expected,
        customer, arena)

priv fn cross_windows(root: U8[], arena: Arena$@) //<
    //< The same sources built for Windows with the cross compiler, run only under Wine
    //<
    //< Caution: **Name what was not run**: a check left out in silence reads as one that passed.
    names: = U8[][]::{ "the libraries cross-compile and link for Windows (static and DLL)",
        "the Windows programs run under Wine" }
    if !has_tool(cross_cc) || !has_tool(cross_ar)
        for n in names
            verdict.skip_check(n,
                arena.text().s("\{cross_cc\} is not installed").take())
        return
    vendor: = fs.join(root, "win", arena)
    fs.mkdir_all(vendor) catch
        verdict.check(names[0], false, vendor)
        return
    // The interfaces and the generated C do not depend on the target, so the host's are reused.
    for name in U8[][]::{ "greet.c", "count.c", "greet.h", "count.h", "main.c" }
        body: =
            io.read_file(fs.join(fs.join(root, "vendor", arena), name, arena)) catch
            verdict.check(names[0], false, arena.text().s("\{name\} is missing").take())
            return
        defer dealloc(Void$@::body.ptr)
        io.write_file(fs.join(vendor, name, arena), body) catch {}
    tc: = Toolchain::{ .cc = cross_cc, .ar = cross_ar, .windows = true, .macho = false,
        .link_libs = link_libs_for(cross_cc, arena) }
    static_dir: = fs.join(vendor, "static", arena)
    shared_dir: = fs.join(vendor, "shared", arena)
    fs.mkdir_all(static_dir) catch {}
    fs.mkdir_all(shared_dir) catch {}
    ok: =
        build_static(tc, vendor, static_dir, arena) &&
        build_shared(tc, vendor, shared_dir, arena)
    static_exe: = link_main(tc, vendor, static_dir, false, arena) if ok else ""
    shared_exe: = link_main(tc, vendor, shared_dir, true, arena) if ok else ""
    verdict.check(names[0], static_exe.len > 0 && shared_exe.len > 0, "a step above failed")
    wine: = "wine" if has_tool("wine") else "wine64"
    if !has_tool(wine)
        verdict.skip_check(names[1], "Wine is not installed")
        return
    if static_exe.len == 0 || shared_exe.len == 0
        verdict.check(names[1], false, "nothing was built to run")
        return
    check_runs("the static Windows program runs under Wine", U8[][]::{ wine, static_exe },
        c_expected, static_dir, arena)
    check_runs("the DLL Windows program runs under Wine", U8[][]::{ wine, shared_exe }, c_expected,
        shared_dir, arena)

priv fn host_toolchain(arena: Arena$@): Toolchain //<
    //< the host's C compiler, as `harness.cc` names it
    target: = harness.cc_target()
    windows: =
        target.find_str("mingw").is_some() || target.find_str("windows").is_some() ||
        target.find_str("cygwin").is_some() || (target.len == 0 && sys.is_windows())
    macho: =
        target.find_str("darwin").is_some() || target.find_str("apple").is_some()
    return Toolchain::{ .cc = harness.cc(), .ar = "ar", .windows = windows, .macho = macho,
        .link_libs = link_libs_for(harness.cc(), arena) }

fn main(): I32
    arena: = harness.begin(64 * 1024 * 1024)
    io.out().s("# shipping libraries built from KSPL\n")
    root: = harness.sandbox("ship")
    vendor: = fs.join(root, "vendor", arena)
    static_dir: = fs.join(vendor, "static", arena)
    shared_dir: = fs.join(vendor, "shared", arena)
    plain_dir: = fs.join(vendor, "plain", arena)
    for d in U8[][]::{ static_dir, shared_dir, plain_dir }
        fs.mkdir_all(d) catch
            return harness.fatal("cannot make a working directory")
    if !copy_in(U8[][]::{ "greet.kspls", "count.kspls", "main.c" }, vendor, arena)
        return harness
            .fatal(arena.text().s("the fixtures in \{fixture_dir\} cannot be copied").take())
    tc: = host_toolchain(arena)
    if !vendor_builds(vendor, arena)
        return harness.finish()
    strict: = argv_of(U8[][]::header_flags, U8[][]::{ "main.c" }, arena)
    ok_step("the generated headers compile under -std=c99 -Wall -Wextra -Werror -Wstrict-prototypes",
        argv_of(U8[][]::{ tc.cc }, strict, arena), vendor)
    if build_static(tc, vendor, static_dir, arena)
        check_private(vendor, static_dir, arena)
        exe: = link_main(tc, vendor, static_dir, false, arena)
        if exe.len > 0
            check_runs("the C customer runs with both static libraries", U8[][]::{ exe }, c_expected,
                static_dir, arena)
            check_stop(exe, static_dir, arena)
        kspl_customer(tc, vendor, root, arena)
    if build_shared(tc, vendor, shared_dir, arena)
        exe: = link_main(tc, vendor, shared_dir, true, arena)
        if exe.len > 0
            check_runs("the C customer runs with both shared libraries", U8[][]::{ exe }, c_expected,
                shared_dir, arena)
    check_collision(tc, vendor, plain_dir, arena)
    if !tc.windows
        cross_windows(root, arena)
    return harness.finish()

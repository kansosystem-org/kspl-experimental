#!/usr/bin/env -S ksplc run
//< It pins down at which boundary each of visibility's three levels closes
//<
//< The convention is "Visibility" in `docs/SPEC-programming-language.md`; the properties pinned
//< down are below.
//< Caution: **Pair a case that fires with one that does not.** One kind alone notices neither too
//< strict (closing at the folder) nor too loose (visible from anywhere).
import "ksplc/tests/support/harness"
import "ksplc/tests/support/harness_markers"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/strfmt" as _strfmt
import "std/subproc" { Job }
import "std/verdict"

// ==========================================
//   * no marker is visible across folders, as long as it is inside the package
//   * no marker is invisible across packages
//   * `pub` is visible across packages too
//   * `priv` is invisible even from another file of the same package
//   * selecting a name or naming a type through an alias changes none of it (refused where written)
//   * a function's bare name reaches no other file, a generic's neither. It answers for the file
//     that declares it, and for one that names it in a selective import
//   * nor does a generic type's or a typedef's: another file's `priv` one is an undefined type
//   * a name another file declares, written without its alias, says which alias to write
// ==========================================

priv const LIB_BODY: U8[] = //< two folders of different depth inside the package `alpha`
    "const SECRET: I32 = 7\npub const OPEN: I32 = 9\npriv const HIDDEN: I32 = 5\n"

priv struct Case //< one case
    //<
    //< extra_rels/extra_bodies are the files beside the library; entry is the file compiled.
    name: U8[]
    extra_rels: U8[][]
    extra_bodies: U8[][]
    entry: U8[]
    expect: U8[] //< empty means the check is "no error is reported"
    alone: Bool //< the expected error is the only one reported

priv const SAME_GEN: U8[] = //< a generic `same` declared `priv`, called inside its file only
    "priv fn same<|T|>(a: T, b: T): Bool { return a == b; }\npub fn check(): Bool { return same(1, \
        1); }\n"

priv const BOX_GEN: U8[] = //< a generic type declared `priv`, used inside its file only
    "priv struct Box<|T|> { v: T; }\npub fn mk(): I32 { b: Box<|I32|> = Box<|I32|>::{ .v = 1 }; \
        return b.v; }\n"

priv const PUB_LIB: U8[] = //< a function, a generic type and a plain type, all `pub`
    "pub fn twice(x: I32): I32 { return x * 2; }\npub struct Box<|T|> { pub v: T; }\npub struct \
        Plain { pub v: I32; }\n"

priv const CASES: Case[] = Case[]::{
    Case::{ .name = "unspecified is visible from another folder inside the same package",
        .extra_rels = U8[][]::{ "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ "import \"alpha/deep/lib\" as lib\npub fn touch(): I32 { return \
            lib.SECRET; }\n" }, .entry = "alpha/mid.kspl", .expect = "" },
    Case::{ .name = "unspecified is invisible across packages",
        .extra_rels = U8[][]::{ "beta/main.kspl" },
        .extra_bodies = U8[][]::{ "import \"alpha/deep/lib\" as lib\nfn main(): I32 { return \
            lib.SECRET; }\n" }, .entry = "beta/main.kspl",
        .expect = "cannot access symbol 'SECRET'" },
    Case::{ .name = "pub is visible across packages too",
        .extra_rels = U8[][]::{ "beta/main.kspl" },
        .extra_bodies = U8[][]::{ "import \"alpha/deep/lib\" as lib\nfn main(): I32 { return \
            lib.OPEN; }\n" }, .entry = "beta/main.kspl", .expect = "" },
    Case::{ .name = "priv is invisible even from another file of the same package",
        .extra_rels = U8[][]::{ "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ "import \"alpha/deep/lib\" as lib\npub fn touch(): I32 { return \
            lib.HIDDEN; }\n" }, .entry = "alpha/mid.kspl",
        .expect = "cannot access symbol 'HIDDEN'" },
    Case::{ .name = "a selective import of what its file cannot see is refused at the import",
        .extra_rels = U8[][]::{ "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ "import \"alpha/deep/lib\" { HIDDEN }\npub fn touch(): I32 { \
            return HIDDEN; }\n" }, .entry = "alpha/mid.kspl",
        .expect = "cannot access symbol 'HIDDEN'" },
    Case::{ .name = "and of a type, whose uses ask nothing of their own",
        .extra_rels = U8[][]::{ "alpha/deep/shape.kspl", "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ "priv struct Cell { v: I32; }\n",
        "import \"alpha/deep/shape\" { Cell }\npub fn touch(): I32 { c: Cell = Cell::{ .v = 1 }; \
            return c.v; }\n" }, .entry = "alpha/mid.kspl",
        .expect = "cannot access symbol 'Cell'" },
    Case::{ .name = "a priv generic's bare name does not answer for another file's own function",
        .extra_rels = U8[][]::{ "alpha/deep/gen.kspl", "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ SAME_GEN,
        "import \"alpha/deep/gen\" as gen\nfn same(a: I32, b: I32): Bool { return a != b; }\npub fn \
            touch(): Bool { return gen.check() && same(1, 2); }\n" }, .entry = "alpha/mid.kspl",
        .expect = "" },
    Case::{ .name = "nor does a pub generic's, across packages",
        .extra_rels = U8[][]::{ "alpha/deep/gen.kspl", "beta/main.kspl" },
        .extra_bodies = U8[][]::{ "pub fn same<|T|>(a: T, b: T): Bool { return a == b; }\n",
        "import \"alpha/deep/gen\" as gen\nfn same(a: I32, b: I32): Bool { return a != b; }\nfn \
            main(): I32 { if gen.same(1, 1) && same(1, 2) { return 0; } return 1; }\n" },
        .entry = "beta/main.kspl", .expect = "" },
    Case::{ .name = "a bare name only another file declares stays undefined",
        .extra_rels = U8[][]::{ "alpha/deep/gen.kspl", "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ SAME_GEN,
        "import \"alpha/deep/gen\" as gen\npub fn touch(): Bool { return gen.check() && same(1, 2); \
            }\n" }, .entry = "alpha/mid.kspl", .expect = "undefined path or identifier 'same'" },
    Case::{ .name = "a selective import calls the generic it names, not another file's namesake",
        .extra_rels = U8[][]::{ "alpha/deep/gen.kspl", "gamma/other.kspl", "beta/main.kspl" },
        .extra_bodies = U8[][]::{ "pub fn pick<|T|>(a: T, b: T): T { return a; }\n",
        "pub fn pick<|T|>(a: T): T { return a; }\npub fn g(): I32 { return pick(1); }\n",
        "import \"alpha/deep/gen\" { pick }\nimport \"gamma/other\" as other\nfn main(): I32 { \
            return pick(1, 2) + other.g(); }\n" }, .entry = "beta/main.kspl", .expect = "" },
    Case::{ .name = "and under the name a selective import gives it",
        .extra_rels = U8[][]::{ "alpha/deep/gen.kspl", "beta/main.kspl" },
        .extra_bodies = U8[][]::{ "pub fn pick<|T|>(a: T, b: T): T { return a; }\n",
        "import \"alpha/deep/gen\" { pick as choose }\nfn main(): I32 { return choose(1, 2); }\n" },
        .entry = "beta/main.kspl", .expect = "" },
    Case::{ .name = "another file's priv generic type is undefined here, and nothing more",
        .extra_rels = U8[][]::{ "alpha/deep/box.kspl", "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ BOX_GEN,
        "import \"alpha/deep/box\" as box\npub fn touch(): I32 { _b: = Box<|I32|>::{ .v = 2 }; \
            return box.mk(); }\n" }, .entry = "alpha/mid.kspl", .expect = "undefined type 'Box'",
        .alone = true },
    Case::{ .name = "and a field naming it says no more either",
        .extra_rels = U8[][]::{ "alpha/deep/box.kspl", "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ BOX_GEN,
        "import \"alpha/deep/box\" as box\npub struct Wrap { pub b: Box<|I32|>; }\npub fn touch(): \
            I32 { return box.mk(); }\n" }, .entry = "alpha/mid.kspl",
        .expect = "undefined type 'Box'", .alone = true },
    Case::{ .name =
        "another file's priv type, named through its import alias, is refused at the use",
        .extra_rels = U8[][]::{ "alpha/deep/shape.kspl", "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ "priv struct Cell { v: I32; }\npub struct Open { pub v: I32; }\n",
        "import \"alpha/deep/shape\" as shape\npub fn touch(c: shape.Cell@): I32 { return 0; }\n" },
        .entry = "alpha/mid.kspl", .expect = "cannot access symbol 'Cell'", .alone = true },
    Case::{ .name = "and so is its priv generic type",
        .extra_rels = U8[][]::{ "alpha/deep/box.kspl", "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ BOX_GEN,
        "import \"alpha/deep/box\" as box\npub fn touch(b: box.Box<|I32|>@): I32 { return box.mk(); \
            }\n" }, .entry = "alpha/mid.kspl", .expect = "cannot access symbol 'Box'",
        .alone = true },
    Case::{ .name = "while its pub type is named through the alias",
        .extra_rels = U8[][]::{ "alpha/deep/shape.kspl", "beta/main.kspl" },
        .extra_bodies = U8[][]::{ "priv struct Cell { v: I32; }\npub struct Open { pub v: I32; }\n",
        "import \"alpha/deep/shape\" as shape\nfn main(): I32 { o: shape.Open = shape.Open::{ .v = \
            0 }; return o.v; }\n" }, .entry = "beta/main.kspl", .expect = "" },
    Case::{ .name = "another file's priv typedef is an undefined type here",
        .extra_rels = U8[][]::{ "alpha/deep/num.kspl", "alpha/mid.kspl" },
        .extra_bodies = U8[][]::{ "priv typedef Num = I32\npub fn one(): Num { return 1; }\n",
        "import \"alpha/deep/num\" as num\npub fn touch(): I32 { n: Num = num.one(); return n; }\n" },
        .entry = "alpha/mid.kspl", .expect = "undefined type 'Num'" },
    Case::{ .name =
        "a function written without the alias its file is imported under says what to write",
        .extra_rels = U8[][]::{ "alpha/deep/wide.kspl", "beta/main.kspl" },
        .extra_bodies = U8[][]::{ PUB_LIB,
        "import \"alpha/deep/wide\" as _p\nfn main(): I32 { return twice(1); }\n" },
        .entry = "beta/main.kspl",
        .expect =
        "missing import alias prefix. 'twice' is declared in 'alpha/deep/wide'. This file imports \
            it as '_p'. Write '_p.twice'", .alone = true },
    Case::{ .name = "and so does a generic type, in the same words",
        .extra_rels = U8[][]::{ "alpha/deep/wide.kspl", "beta/main.kspl" },
        .extra_bodies = U8[][]::{ PUB_LIB,
        "import \"alpha/deep/wide\" as _p\nfn main(): I32 { b: Box<|I32|> = _p.Box<|I32|>::{ .v = 1 \
            }; return b.v; }\n" }, .entry = "beta/main.kspl",
        .expect =
        "missing import alias prefix. 'Box' is declared in 'alpha/deep/wide'. This file imports it \
            as '_p'. Write '_p.Box'" },
    Case::{ .name = "and a plain type",
        .extra_rels = U8[][]::{ "alpha/deep/wide.kspl", "beta/main.kspl" },
        .extra_bodies = U8[][]::{ PUB_LIB,
        "import \"alpha/deep/wide\" as _p\nfn main(): I32 { p: Plain = _p.Plain::{ .v = 1 }; return \
            p.v; }\n" }, .entry = "beta/main.kspl",
        .expect =
        "missing import alias prefix. 'Plain' is declared in 'alpha/deep/wide'. This file imports \
            it as '_p'. Write '_p.Plain'" },
}

priv fn prepare(c: Case, index: Sz, arena: Arena$@): Job //<
    //< It makes one case's directory, writes the files, and builds the Job to run there
    $nb: = Str_builder.new()
    defer nb.free()
    name: = U8[]::arena.dup_str(nb.s("vis_\{index\}").slice())
    dir: = harness.sandbox(name)
    if dir.len == 0
        return Job::{ .argv = U8[][]::{}, .cwd = "" }
    rels: = List<|U8[]|>.create(arena)
    bodies: = List<|U8[]|>.create(arena)
    rels.push("alpha/deep/lib.kspl")
    bodies.push(LIB_BODY)
    for i in Range.asc(c.extra_rels.len)
        rels.push(c.extra_rels[i])
        bodies.push(c.extra_bodies[i])
    fs.write_tree(dir, rels.slice(), bodies.slice(), arena) catch {}
    return Job::{ .argv = harness.ksplc_argv(U8[][]::{ c.entry, "out.c" }), .cwd = dir }

fn main(): I32
    arena: = harness.begin(64 * 1024 * 1024)
    run_one_main(arena)
    io.out()
        .s("# the boundary visibility closes at: \{CASES.len\} (\{verdict.jobs()\} in parallel)\n")

    jobs: = List<|Job|>.create(arena)
    for $i: = 0; i < CASES.len; i += 1
        jobs.push(prepare(CASES[i], i, arena))
    outs: = harness.run_all(jobs.slice(), "visibility")

    for $i: = 0; i < CASES.len; i += 1
        c: = CASES[i]
        out: = outs.get(i).out
        if c.expect.len > 0
            verdict.check(c.name,
                out.find_str(c.expect).is_some() &&
                (!c.alone || out.count_str("error:") == 1), out)
        else
            // A pass means "no error", not the exit code, which may fail for another reason.
            verdict.check(c.name, out.find_str("error:").is_none(), out)
    return harness.finish()

// ==========================================
// It pins down that a program has only one entry point (two files, so not a fixture case). If
// this were not rejected, **nothing would fail on a mix-up**: `find_main_symbol` in
// `ksplc/sema/type/env.kspl` returns the first hit, so the walk order would pick the entry point.
// Caution: Pair a case that fires with one that does not. Too strict, it rejects even a program
// that merely imports a file holding no `main`.
// ==========================================
// The entry file, calling the imported `helper`.
priv const ENTRY_SRC: U8[] = """import "lib" { helper }
fn main(): I32
  return helper()
"""

// The imported file holds a `main`: rejected.
priv const LIB_WITH_MAIN: U8[] = """fn main(): I32
  return 2
pub fn helper(): I32
  return 1
"""

// The same without that `main`: passes.
priv const LIB_PLAIN: U8[] = """pub fn helper(): I32
  return 1
"""

priv fn check_main_case(slot: U8[], name: U8[], lib_src: U8[], expect: U8[][], deny: U8[][],
    arena: Arena$@) //<
        //< One case: the base and main.kspl in the working directory, one run, the marks matched.
        //<
        //< Caution: Make cwd the working directory. Resolving `import "lib"` starts from cwd.
    dir: = harness.sandbox(arena.text().s("onemain_\{slot\}").take())
    names: = U8[][]::{ "lib.kspl", "main.kspl" }
    fs.write_tree(dir, names, U8[][]::{ lib_src, ENTRY_SRC }, arena) catch
        verdict.check(name, false, "cannot place the material")
        return
    $args: = List<|U8[]|>.new(arena)
    args.push("main.kspl")
    args.push("main.c")
    r: = harness.run_in(harness.ksplc_argv(args.slice()), dir)
    harness_markers.check(name, expect, deny, r.out)

priv fn run_one_main(arena: Arena$@) //< only one main per program
    none: = U8[][]::{}
    io.out().s("# only one main per program: 2\n")

    // **A mark must appear at both positions**, or the reader cannot tell which to remove.
    check_main_case("two", "an import target holding a main is refused", LIB_WITH_MAIN,
        U8[][]::{ "lib.kspl:1:1:", "main.kspl:2:1:", "defines main() 2 times" }, none, arena)

    // Against being too strict: importing a file holding no `main` is ordinary.
    check_main_case("one", "an import target holding no main passes", LIB_PLAIN, none,
        U8[][]::{ "error:", "defines main()" }, arena)

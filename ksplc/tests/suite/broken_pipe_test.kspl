#!/usr/bin/env -S ksplc run
//< The test that pins down what happens on a write with nobody to receive it
//< The behaviour itself is in `ksplc/gen/runtime/hosted_io.c`.
//< **POSIX ends the process when a write goes to a pipe the reader has closed** (SIGPIPE's
//< default). A server sees clients leave, so by default it **vanishes without printing anything**
//< when one goes, and nothing points at the cause.

// ==========================================
// It checks three things, and **missing any one is a different way of breaking**. Writing to an
// ended peer must not crash (else the server vanishes when its peer leaves). It must end quietly
// when the destination goes (else `prog \| head` runs on with no destination). A started child
// must keep the default (else `yes \| head` never ends, the ignore setting outliving exec).
// Caution: **No check passes unless its probe ran.** Each first requires an exit status or a
// line the probe writes. A probe that never started writes nothing, and "it said nothing wrong"
// would then pass. So the checks run on Windows start no shell: they reach the probe directly.
// ==========================================

import "ksplc/tests/support/harness"
import "ksplc/tests/support/harness_build"
import "std/chars"
import "std/ds"
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/subproc"
import "std/sys"
import "std/verdict"

// The probe that writes to an ended child: it must get an error back, not crash.
// Caution: **Write after waiting for the child to end.** Written sooner, the write succeeds, and
// the check goes green having checked nothing. **The wait for the end stops only a child that never
// ends**, past 300 s: a busy machine can take seconds to start and end a shell.
priv const DEAD_CHILD_SRC: U8[] =
    """import "std/io"
import "std/str" { Str }
import "std/subproc"
import "std/sys"

fn main(): I32
  $ch: = subproc.spawn_piped(U8[][]::{ "/bin/sh", "-c", "exit 0" }, "") catch
    io.out().s("NO-CHILD\n")
    return 1

  for i in Range.asc(30000)
    if !ch.alive()
      break

    sys.sleep_ms(10)

  if ch.alive()
    io.out().s("STILL-ALIVE\n")
    return 1

  $buf: = Str()
  buf.s("Content-Length: 58\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":1}")
  $refused: = false
  for i in Range.asc(20)
    ch.write(buf.slice(), 1000) catch
      refused = true

    if refused
      break


  ch.kill()
  io.out().s("REFUSED\n" if refused else "ACCEPTED\n")
  return 0

"""

// The probe that writes a lot and creates the mark file **only once it has written it all**. A
// POSIX shell cannot give each pipe stage's status (`PIPESTATUS` is bash's). So **no mark = it
// ended part way**.
// Caution: **Write more than the buffer.** An amount that fits is never flushed, so the probe
// never gets the chance to notice the destination is gone.
priv const LOUD_SRC: U8[] =
    """import "std/io"
import "std/sys"

fn main()
  // Caution: Take the argument first (write `sys.args()[1]` directly and C's back cannot take an
  // address).
  $a: = sys.args()
  for i in Range.asc(200000)
    io.out().s("line \{i\} this is a line long enough to go on writing past the buffer\n")

  io.write_file(a[1], "done") catch {}

"""

// The same probe writing one byte per call, the path a `.c()` takes.
priv const LOUD_BYTES_SRC: U8[] =
    """import "std/io"
import "std/sys"

fn main()
  $a: = sys.args()
  for _i in Range.asc(2000000)
    io.out().c('x').c('\n')

  io.write_file(a[1], "done") catch {}

"""

// The same probe with its own SIGPIPE handler, which counts each delivery. It writes the count to
// standard error at the end, after the mark file.
priv const HANDLED_SRC: U8[] =
    """import "std/io"
import "std/sys"

priv $pipes_seen: I32 = 0

priv fn count_pipe(_sig: I32): Void
  pipes_seen += 1

fn main()
  $a: = sys.args()
  sys.set_signal_handler(13, count_pipe)
  for i in Range.asc(200000)
    io.out().s("line \{i\} this is a line long enough to go on writing past the buffer\n")

  io.write_file(a[1], "done") catch {}
  io.err().s("HANDLED \{pipes_seen\}\n")

"""

// The probe that plays `head`: it starts the writer its arguments name, reads a little of its
// standard output, then stops reading. It prints `CODE <n>`, the writer's exit status, and below
// it what the writer wrote to standard error. It ends with 0 only where it read something and
// the writer ended. **It needs no shell**, so the same check runs on every OS.
priv const HEAD_SRC: U8[] =
    """import "std/io"
import "std/str" { Str }
import "std/subproc"
import "std/sys"

fn main(): I32
  $a: = sys.args()
  $ch: = subproc.spawn_piped(U8[][]::{ a[1], a[2] }, "") catch
    io.out().s("NO-CHILD\n")
    return 1

  $buf: U8[4096] = ::{}
  got: = ch.read(U8$[]::buf, 300000) catch 0
  ch.close_stdout()
  defer $err: = Str()
  for _i in Range.asc(100000)
    n: = ch.read_err(U8$[]::buf, 300000) catch
      break

    err.s(U8[]::{ .ptr = buf[0]@, .len = n })

  $code: I32 = -1
  $ended: = false
  for _i in Range.asc(30000)
    if c: = ch.exit_code()
      code = c
      ended = true
      break

    sys.sleep_ms(10)

  ch.kill()
  io.out().s("READ \{got\}\nCODE \{code\}\n").s(err.slice())
  return 0 if got > 0 && ended else 2

"""

// The probe printing the signals a started child ignores (Linux's `/proc/self/status`).
priv const CHILD_SIG_SRC: U8[] =
    """import "std/io"
import "std/mem" { Arena }
import "std/subproc"

fn main()
  arena: = Arena(1024 * 1024)
  defer arena.free()
  r: = subproc.run_capture(U8[][]::{ "/bin/sh", "-c", "grep ^SigIgn: /proc/self/status" }, "",
    300000, 4096, arena) catch
    return
  io.out().s("\{r.stdout_data\}")

"""

// The probe that writes one line and ends with 0: by `sys.exit` where it is given an argument, by
// returning from `main` otherwise.
priv const ONE_LINE_SRC: U8[] =
    """import "std/io"
import "std/sys"

fn main(): I32
  io.out().s("one line\n")
  if sys.args().len > 1
    sys.exit(0)

  return 0

"""

priv const REFUSED_LINE: U8[] = "standard output could not be written" //<
    //< What the runtime writes where standard output was refused (`kspl_check_stdout_at_exit`)

priv const SIGPIPE_BIT: U8[] = "1000" //< the mark for ignoring SIGPIPE (number 13)
    //< `SigIgn` in `/proc/<pid>/status` is 64 hex digits.

priv fn build(name: U8[], src: U8[], work: U8[], arena: Arena$@): U8[] //< it builds one probe
    //< If it cannot be built, it returns empty.
    s_path: = fs.join(work, arena.text().s("\{name\}.kspl").take(), arena)
    gen: = fs.join(work, arena.text().s("\{name\}.c").take(), arena)
    exe: = fs.join(work, arena.text().s("\{name\}.exe").take(), arena)
    io.write_file(s_path, src) catch
        verdict.check(arena.text().s("\{name\}: the source can be written").take(), false, s_path)
        return ""
    c: = harness.ksplc(U8[][]::{ s_path, gen })
    if !c.exited_with(0)
        verdict.check(arena.text().s("\{name\}: it translates to C").take(), false, c.out)
        return ""
    b: = harness_build.build_exe(U8[][]::{ gen }, exe, U8[][]::{ "-std=c99", "-O0", "-w" })
    if !b.exited_with(0)
        verdict.check(arena.text().s("\{name\}: it builds").take(), false, b.out)
        return ""
    return exe

priv fn check_dead_child(work: U8[], arena: Arena$@) //<
    //< Checks that writing to a peer that has ended does not crash
    exe: = build("deadchild", DEAD_CHILD_SRC, work, arena)
    if exe.len == 0
        return
    r: = harness.run(U8[][]::{ exe })
    // Caution: **Check the exit status too.** With only the error checked, a crash **after the
    // write** passes.
    verdict.check("writing to a peer that has ended does not crash", r.exited_with(0),
        arena.text()
        .s("exit status \{r.code.unwrap_or(-1)\} (141 = died by SIGPIPE) / output: \{r.out\}")
        .take())
    verdict.check("a write to a peer that has ended gets an error back",
        r.out.find_str("REFUSED").is_some(), r.out)

priv fn check_head( //< checks that it ends quietly once the destination is gone
    //< It writes as `how` says, and `head` is the probe that reads it. **On Windows the program
    //< runs on to its end**, with no SIGPIPE, as `hosted_io.c` decides.
    //< It must then end with its own code and not report the closed pipe as an error.
    name: U8[],
    src: U8[],
    how: U8[],
    head: U8[],
    windows: Bool,
    work: U8[],
    arena: Arena$@,
)
    exe: = build(name, src, work, arena)
    if exe.len == 0
        return
    // Caution: **Check the positive control first.** Without it, a run where the probe could write
    // nothing looks like "it ended quietly".
    full_mark: = fs.join(work, arena.text().s("\{name\}_full.txt").take(), arena)
    full: = harness.run(U8[][]::{ exe, full_mark })
    verdict.check(arena.text().s("with a counterpart connected it can write to the end \{how\}")
        .take(), full.exited_with(0) && fs.exists(full_mark),
        arena.text().s("exit status \{full.code.unwrap_or(-1)\}").take())
    cut_mark: = fs.join(work, arena.text().s("\{name\}_cut.txt").take(), arena)
    piped: = harness.run(U8[][]::{ head, exe, cut_mark })
    // Caution: **Require that the writer ran before anything else is checked.** Each check below
    // looks for something missing, which a writer that never started would pass.
    ran: = arena.text().s("the writer ran, and its reader stopped part way \{how\}").take()
    verdict.check(ran, piped.exited_with(0),
        arena.text()
        .s("the reader's exit status \{piped.code.unwrap_or(-1)\} / output: \{piped.out\}").take())
    if !piped.exited_with(0)
        return
    stops: = arena.text().s("once the destination goes it ends without writing it all \{how\}")
        .take()
    ends: = arena.text().s("once the destination goes it ends with its own code \{how\}").take()
    if windows
        verdict.skip_check(stops, "Windows has no SIGPIPE, so the program runs on to its end")
        verdict.check(ends,
            piped.out.find_str("CODE 0\n").is_some() && fs.exists(cut_mark), piped.out)
    else
        // 141 is 128 + SIGPIPE (13): the default that the runtime puts back and raises.
        verdict.check(stops,
            !fs.exists(cut_mark) && piped.out.find_str("CODE 141\n").is_some(), piped.out)
    // The check of standard output at exit keeps quiet for a closed pipe.
    verdict.check(arena.text().s("a closed pipe ends it without a word \{how\}").take(),
        piped.out.find_str(REFUSED_LINE).is_none(), piped.out)

priv fn check_own_handler(head: U8[], work: U8[], arena: Arena$@) //<
    //< Checks that a SIGPIPE handler the program set stays in charge of a closed pipe
    //< The runtime must not put the default back over it. The program runs on to its end, and
    //< the check of standard output at exit then reports the refused write.
    exe: = build("handled", HANDLED_SRC, work, arena)
    if exe.len == 0
        return
    mark: = fs.join(work, "handled_cut.txt", arena)
    piped: = harness.run(U8[][]::{ head, exe, mark })
    verdict.check("the writer with its own handler ran, and its reader stopped part way",
        piped.exited_with(0),
        arena.text()
        .s("the reader's exit status \{piped.code.unwrap_or(-1)\} / output: \{piped.out\}").take())
    if !piped.exited_with(0)
        return
    // Caution: **Require the count the probe writes at its end.** A probe that died part way
    // writes none, and the exit status alone could pass by chance.
    verdict.check("the program's own SIGPIPE handler runs, and the program runs on to its end",
        fs.exists(mark) && piped.out.find_str("HANDLED 0\n").is_none() &&
        piped.out.find_str("HANDLED ").is_some(), piped.out)
    verdict.check("the refused standard output then fails the exit with one line",
        piped.out.find_str("CODE 1\n").is_some() &&
        piped.out.find_str(REFUSED_LINE).is_some(), piped.out)

priv fn run_to_files(argv: U8[][], out_path: U8[], err_path: U8[]): I32? //<
    //< runs a probe with its outputs going to files, and returns its exit status
    //< None where it could not start, or ran past 300 s and was stopped.
    $child: = subproc.spawn_redirect(argv, "", out_path, err_path) catch
        return .none
    for _i in Range.asc(30000)
        if !child.alive()
            break
        sys.sleep_ms(10)
    if child.alive()
        child.kill()
        return .none
    return child.wait()

priv fn check_refused_stdout(work: U8[], arena: Arena$@) //<
    //< Checks that standard output refused for another reason than a closed pipe fails the exit
    //< `/dev/full` refuses every write as a full disk does. **The probe starts with no shell**, its
    //< outputs going to files, so the positive control runs on Windows too.
    exe: = build("oneline", ONE_LINE_SRC, work, arena)
    if exe.len == 0
        return
    err_path: = fs.join(work, "oneline_err.txt", arena)
    // The positive control: the same probe, written whole, ends with 0 and no line. **Its output
    // must be there**, the mark that it ran.
    out_path: = fs.join(work, "oneline_out.txt", arena)
    fine: = run_to_files(U8[][]::{ exe }, out_path, err_path)
    fine_out: = io.read_file(out_path, arena) catch ""
    fine_err: = io.read_file(err_path, arena) catch ""
    verdict.check("standard output written whole ends with the program's code",
        fine.unwrap_or(-1) == 0 && fine_out.find_str("one line").is_some() &&
        fine_err.find_str(REFUSED_LINE).is_none(),
        arena.text()
        .s("exit status \{fine.unwrap_or(-1)\} / output: \{fine_out\} / error: \{fine_err\}").take())
    name: = "standard output refused fails the exit with one line"
    if !fs.exists("/dev/full")
        verdict.skip_check(name, "this OS has no /dev/full")
        return
    for how in U8[][]::{ "", "exit" }
        argv: = U8[][]::{ exe, how } if how.len > 0 else U8[][]::{ exe }
        r: = run_to_files(argv, "/dev/full", err_path)
        said: = io.read_file(err_path, arena) catch ""
        by: U8[] = "sys.exit" if how.len > 0 else "return"
        verdict.check(arena.text().s("\{name\} (by \{by\})").take(),
            r.unwrap_or(-1) == 1 && said.find_str(REFUSED_LINE).is_some(),
            arena.text().s("exit status \{r.unwrap_or(-1)\} / error: \{said\}").take())

priv fn check_child_default(work: U8[], arena: Arena$@) //<
    //< Checks that a started child keeps SIGPIPE's default
    exe: = build("childsig", CHILD_SIG_SRC, work, arena)
    if exe.len == 0
        return
    r: = harness.run(U8[][]::{ exe })
    said: = r.out
    if said.find_str("SigIgn:").is_none()
        verdict.skip_check("a started child holds SIGPIPE's default",
            arena.text().s("it cannot be read from `/proc/self/status`: \{said\}").take())
        return
    // The bit for number 13 (0x1000) is not set in the lowest four digits.
    tail: = said.sub(said.len - 5, 4) if said.len >= 5 else said
    verdict.check("a started child holds SIGPIPE's default", !tail.equals(SIGPIPE_BIT),
        arena.text().s("the child inherits the ignoring: \{said\}").take())

fn main(): I32 //<
    //< It runs the broken-pipe cases; on Windows, all but the checks of SIGPIPE itself
    //< Caution: **The suite's own process cannot test it** — the seed runs the suite, with the old
    //< runtime it carries. **The test builds the current `ksplc`** (`harness_build`).
    arena: = harness.begin(64 * 1024 * 1024)
    work: = harness.sandbox("brokenpipe")
    // **Windows has no SIGPIPE**: a write to a closed pipe returns a failure (hosted_io.c's Windows
    // branch). So only the checks of what it writes and how it ends run there. Its C library names
    // that failure in a way of its own, which only a Windows run reaches.
    windows: =
        harness.cc_target().find_str("windows").is_some() ||
        harness.cc_target().find_str("mingw").is_some()
    head: = build("head", HEAD_SRC, work, arena)
    if head.len > 0
        check_head("loud", LOUD_SRC, "(a string per call)", head, windows, work, arena)
        check_head("loud_bytes", LOUD_BYTES_SRC, "(a byte per call)", head, windows, work, arena)
    check_refused_stdout(work, arena)
    if windows
        verdict.skip_check("the checks of SIGPIPE itself", "Windows has no SIGPIPE")
        return harness.finish()
    if head.len > 0
        check_own_handler(head, work, arena)
    check_dead_child(work, arena)
    check_child_default(work, arena)
    return harness.finish()

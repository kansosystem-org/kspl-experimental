#!/usr/bin/env -S ksplc run
//< The rules for places, and for whether they may be touched, run as programs
//< The rules are "Places, and the rules for when they may be written" in
//< `docs/SPEC-programming-language.md`.
//< Caution: **Test the shapes that should pass together with them**, or rejecting everything goes
//< green too. `tests/negative/` holds one case per syntax (`.f` / `[i]` / `$` / a capture /
//< defer) for the paths; here are the rules themselves.
import "ksplc/tests/support/harness"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/strfmt" as _strfmt
import "std/subproc"
import "std/verdict"

// The common part of each program: five kinds of target, mutable and immutable receivers, and a
// function taking a mutable pointer.
// Caution: **Do not drop the level that holds a struct as an element.** With only plain elements
// (`I32[]`), no path reaching **a field inside** an element (`b.si[0].n`) is taken.
priv const HEAD: U8[] =
    """import "std/ds" { List, Map }

priv struct Cell { n: I32; }
impl Cell
  fn bumpc(r: Self$@)
    r.n += 1


impl I32
  fn bump32(r: Self$@)
    r$ += 1


priv struct Box { n: I32; imm: I32[]; mut: I32$[]; si: Cell[]; sm: Cell$[]; arr: I32[2]; }
impl Box
  fn bump(r: Self$@)
    r.n += 1

  fn peek(r: Self@): I32
    return r.n


priv fn takes_mut(p: I32$@)
  p$ = 9

priv fn make_box(): Box
  return Box::{}

priv struct Bag { items: List<|I32|>; }
priv fn make_cells(): List<|Cell|>
  return List<|Cell|>(null)

priv fn make_bag(): Bag
  return Bag::{ .items = List<|I32|>(null) }

priv fn make_map(): Map<|I32, I32|>
  return Map<|I32, I32|>(null)

impl I32$[]
  fn zero_all(r: Self@)
    for $i: Sz = 0; i < r.len; i += 1
      r[i] = 0


  fn same(r: Self@): I32$[]
    return r$


"""

priv const TAIL: U8[] = """

fn main(): I32
  return 0

"""

priv struct Case
    rule: U8[] //< the rule being broken (empty in the control)
    op: U8[] //< the operation's name
    body: U8[]

priv const DENY: Case[] = Case[]::{ //< every one is a shape that **should be rejected**
    // route: it reaches through the read-only pointer Box@.
    Case::{ .rule = "route", .op = "write", .body = "priv fn t(b: Box@) { b.n = 1; }" },
    Case::{ .rule = "route", .op = "address", .body = "priv fn t(b: Box@) { takes_mut(b.n@); }" },
    Case::{ .rule = "route", .op = "mutable receiver", .body = "priv fn t(b: Box@) { b.bump(); }" },
    // root: the binding is immutable (no `$` in front of the name).
    Case::{ .rule = "root", .op = "write", .body = "priv fn t() { b: Box = ::{}; b.n = 1; }" },
    Case::{ .rule = "root", .op = "address",
        .body = "priv fn t() { b: Box = ::{}; takes_mut(b.n@); }" },
    Case::{ .rule = "root", .op = "mutable receiver",
        .body = "priv fn t() { b: Box = ::{}; b.bump(); }" },
    // step's type: the element touched is immutable (the root is mutable, no pointer crossed).
    Case::{ .rule = "step's type", .op = "write",
        .body = "priv fn t() { $b: Box = ::{}; b.imm[0] = 1; }" },
    Case::{ .rule = "step's type", .op = "address",
        .body = "priv fn t() { $b: Box = ::{}; takes_mut(b.imm[0]@); }" },
    Case::{ .rule = "step's type", .op = "mutable receiver",
        .body = "priv fn t() { $b: Box = ::{}; b.si[0].bumpc(); }" },
    // The step's type, touching **a field inside** an element (the subscript not outermost). All
    // three operations, since blocking one leaves the rest as a way around.
    Case::{ .rule = "step's type, inside an element", .op = "write",
        .body = "priv fn t() { $b: Box = ::{}; b.si[0].n = 1; }" },
    Case::{ .rule = "step's type, inside an element", .op = "address",
        .body = "priv fn t() { $b: Box = ::{}; takes_mut(b.si[0].n@); }" },
    Case::{ .rule = "step's type, inside an element", .op = "mutable receiver",
        .body = "priv fn t() { $b: Box = ::{}; b.si[0].n.bump32(); }" },
    // a temporary: a write vanishes into the temporary copy, so **only the writing receiver** is
    // rejected (the reading one passes under allow below).
    Case::{ .rule = "a temporary", .op = "mutable receiver",
        .body = "priv fn t() { make_box().bump(); }" },
    // A field or an array element of a temporary is part of it, so it is no place either; its
    // address in C would be `&f().n`.
    Case::{ .rule = "a temporary's field", .op = "write",
        .body = "priv fn t() { make_box().n = 1; }" },
    Case::{ .rule = "a temporary's field", .op = "address",
        .body = "priv fn t() { takes_mut(make_box().n@); }" },
    Case::{ .rule = "a temporary's field", .op = "mutable receiver",
        .body = "priv fn t() { make_box().n.bump32(); }" },
    Case::{ .rule = "a temporary's array element", .op = "write",
        .body = "priv fn t() { make_box().arr[0] = 1; }" },
    // An element a container owns (its `at` takes `Self$@`) is part of it as a field is, so all
    // three operations are refused; a write through `at` would change a copy.
    Case::{ .rule = "a temporary's owned element", .op = "write",
        .body = "priv fn t() { make_bag().items[0] = 1; }" },
    Case::{ .rule = "a temporary's owned element", .op = "compound write",
        .body = "priv fn t() { make_bag().items[0] += 1; }" },
    Case::{ .rule = "a temporary's owned element", .op = "address",
        .body = "priv fn t() { takes_mut(make_bag().items[0]@); }" },
    Case::{ .rule = "a temporary's owned element", .op = "mutable receiver",
        .body = "priv fn t() { make_cells()[0].bumpc(); }" },
    Case::{ .rule = "a temporary's owned element", .op = "write inside it",
        .body = "priv fn t() { make_cells()[0].n = 1; }" },
    // `Index_mut`'s `set(r: Self$@, …)` follows the method call's rule on a temporary.
    Case::{ .rule = "a temporary", .op = "write through 'set'",
        .body = "priv fn t() { make_map()[1] = 2; }" },
    // Where only a writing `at` reads, a temporary has no way to read.
    Case::{ .rule = "a temporary", .op = "read through a writing 'at' alone",
        .body =
        "priv struct Own { a: I32[2]; }\nimpl Own: Index_place<|Sz, I32|>\n  fn at(r: Self$@, i: \
            Sz, _file: U8[], _line: Sz): I32$@\n    return r.a[i]@\n\n\npriv fn t(): I32 { return \
            Own::{}[0]; }" },
    // A method's call gets the same rules as a function's: a value it returns is a temporary.
    Case::{ .rule = "a temporary a method returns", .op = "write to an owned element",
        .body =
        "impl Bag\n  fn copy(r: Self@): List<|I32|>\n    return r.items\n\n\npriv fn t(g: Bag@) { \
            g.copy()[0] = 1; }" },
    Case::{ .rule = "a temporary a method returns", .op = "write to an array element",
        .body =
        "impl Box\n  fn val(r: Self@): Box\n    return r$\n\n\npriv fn t(b: Box@) { b.val().arr[0] \
            = 1; }" },
}

// Shapes that break none of the rules, so rejecting everything is not green.
priv const ALLOW: Case[] = Case[]::{
    Case::{ .rule = "", .op = "write", .body = "priv fn t() { $b: Box = ::{}; b.n = 1; }" },
    Case::{ .rule = "", .op = "address",
        .body = "priv fn t() { $b: Box = ::{}; takes_mut(b.n@); }" },
    Case::{ .rule = "", .op = "mutable receiver",
        .body = "priv fn t() { $b: Box = ::{}; b.bump(); }" },
    Case::{ .rule = "", .op = "a write to a mutable element",
        .body = "priv fn t() { $b: Box = ::{}; b.mut[0] = 1; }" },
    Case::{ .rule = "", .op = "a write inside a mutable element",
        .body = "priv fn t() { $b: Box = ::{}; b.sm[0].n = 1; }" },
    Case::{ .rule = "", .op = "an address inside a mutable element",
        .body = "priv fn t() { $b: Box = ::{}; takes_mut(b.sm[0].n@); }" },
    Case::{ .rule = "", .op = "a mutable receiver on a mutable element",
        .body = "priv fn t() { $b: Box = ::{}; b.sm[0].bumpc(); }" },
    Case::{ .rule = "", .op = "a mutable receiver inside a mutable element",
        .body = "priv fn t() { $b: Box = ::{}; b.sm[0].n.bump32(); }" },
    // The way out: an explicit cast states intent and must pass.
    Case::{ .rule = "", .op = "immutability taken off by an explicit cast",
        .body = "priv fn t() { $b: Box = ::{}; (Cell$[]::b.si)[0].n = 1; }" },
    Case::{ .rule = "", .op = "an immutable receiver can be called even read-only",
        .body = "priv fn t(b: Box@): I32 { return b.peek(); }" },
    Case::{ .rule = "", .op = "across a pointer the root's `$` is not wanted",
        .body = "priv fn t(p: Box$@) { p.n = 1; p.bump(); takes_mut(p.n@); }" },
    // **A reading receiver on a temporary passes.** lower stores it in the call's block frame, as
    // though bound by `x: = make_box();`.
    Case::{ .rule = "", .op = "a reading receiver on a temporary",
        .body = "priv fn t(): I32 { return make_box().peek(); }" },
    // **If `Self` is a mutable slice, the writing receiver takes a temporary too.** The receiver is
    // `Self@` and the write reaches **what the descriptor points at**: the caller's memory changes.
    Case::{ .rule = "", .op = "a write to a temporary's slice",
        .body = "priv fn t() { $b: Box = ::{}; b.mut.same().zero_all(); }" },
    // **A pointer a call returns leads to a place**, so its fields take all three operations.
    Case::{ .rule = "", .op = "the three operations through a returned pointer",
        .body =
        "priv fn on(p: Box$@): Box$@ { return p; }\npriv fn t(p: Box$@) { on(p).n = 1; \
            on(p).bump(); takes_mut(on(p).n@); on(p).arr[0] = 2; }" },
    // **An element of a temporary is read** through a copy of the container in a slot.
    Case::{ .rule = "", .op = "a read of a temporary's owned element",
        .body =
        "priv fn t(): I32 { return make_bag().items[0] + make_cells()[0].n + \
            make_map()[1].unwrap_or(0); }" },
    // **A pointer or a slice a method returns leads to a place**, as a function's does; the
    // subscript's receiver is inferred once, so the method call is not read twice.
    Case::{ .rule = "", .op = "writes through subscripts on a method's result",
        .body =
        "impl Bag\n  fn lst(r: Self$@): List<|I32|>$@\n    return r.items@\n\n\nimpl Box\n  fn \
            me(r: Self$@): Box$@\n    return r\n\n\npriv fn t(g: Bag$@, b: Box$@) { g.lst()[0] = 1; \
            g.lst()[0] += 1; b.me().mut[0] = 2; b.me().arr[1] *= 3; b.me().me().n = 4; }" },
    // A temporary slice's element lies in memory the slice points at, so it is written.
    Case::{ .rule = "", .op = "a write to a temporary slice's element",
        .body =
        "priv fn on(s: I32$[]): I32$[] { return s; }\npriv fn t() { $b: Box = ::{}; on(b.mut)[0] = \
            1; }" },
}

priv struct Verdict //< the result of building one program and only compiling it
    //< It holds "did it pass" and the first error line.
    compiled: Bool
    first_error: U8[]

priv fn compile_only(dir: U8[], index: Sz, body: U8[], arena: Arena$@): Verdict
    defer $nb: = Str_builder()
    nb.s("p\{index\}")
    stem: = nb.slice()
    src: = fs.join(dir, arena.text().s("\{stem\}.kspl").take(), arena)
    gen: = fs.join(dir, arena.text().s("\{stem\}.c").take(), arena)
    defer $sb: = Str_builder()
    sb.s(HEAD).s(body).s(TAIL)
    io.write_file(src, sb.slice()) catch
        return Verdict::{ .compiled = false, .first_error = "cannot write the material" }
    r: = harness.ksplc(U8[][]::{ src, gen })
    if r.exited_with(0)
        return Verdict::{ .compiled = true, .first_error = "" }
    for ln in r.out.lines(arena)
        if ln.find_str("error:").is_some()
            return Verdict::{ .compiled = false, .first_error = ln.trim_spaces() }
    return Verdict::{ .compiled = false, .first_error = r.out.trim_end() }

fn main(): I32
    arena: = harness.begin(512 * 1024 * 1024)
    run_write_perm(arena)
    dir: = harness.sandbox("place")

    for i in Range.asc(DENY.len)
        c: = DENY[i]
        v: = compile_only(dir, i, c.body, arena)
        name: = arena.text().s("[\{c.rule\}] \{c.op\} is refused").take()
        verdict.check(name, !v.compiled, "it passes")
    for i in Range.asc(ALLOW.len)
        c: = ALLOW[i]
        v: = compile_only(dir, DENY.len + i, c.body, arena)
        name: = arena.text().s("[control] \{c.op\}").take()
        why: = arena.text().s("refused: \{v.first_error\}").take()
        verdict.check(name, v.compiled, why)
    return harness.finish()

// ==========================================
// That ksplc itself rejects a write to something read-only. Each read-only source is written
// through each path, and what ksplc accepts is compiled as C with its warnings on. **C sees only
// part of it:** a slice's `const` stays on its descriptor ("Genc orders its type definitions
// after stripping immutability marks" in `ksplc/docs/DESIGN-backends.md`). So only ksplc can catch
// a write through a slice.
// ==========================================
// The verdict per case, assuming that a write C warns about is one ksplc should reject:
//   * ksplc rejected it             -> OK (this part asserts nothing about "should it be
//     rejected")
//   * ksplc passed & C silent too   -> OK (a valid write, or the explicit cast as a way out)
//   * ksplc passed & C complains    -> **FAIL** (a gap in ksplc's checks)
// ==========================================

priv struct Root //< the read-only sources
    //< Caution: **Keep the row as a const**; built in a function, the descriptor points at the
    //< frame.
    slot: U8[]
    globals: U8[]
    locals: U8[]
    expr: U8[]

priv struct Write //< the write's path
    //< The source's expression goes into `<e>`; ksplc rejects an invalid combination.
    slot: U8[]
    body: U8[]

priv const HOLDER_DECL: U8[] =
    """struct Holder { buf: U8[4]; n: I32; }
impl Holder { fn bump_holder(r: Self$@) { r.n = 7; } }
"""

priv const HOLDER2_DECL: U8[] =
    """struct Holder2 { buf: U8[4]; n: I32; }
impl Holder2 { fn bump_holder(r: Self$@) { r.n = 7; } }
const RO_ST: Holder2 = ::{ .buf = ::{ 1, 2, 3, 4 }, .n = 0 }
"""

priv const NESTED_MUT_LOCALS: U8[] =
    """$in_a: U8[4] = ::{ 1, 2, 3, 4 };
  $sl_a: U8$[][1] = ::{ U8$[]::in_a };
  nested: U8$[]$[] = U8$[]$[]::sl_a;"""

priv const NESTED_RO_LOCALS: U8[] =
    """$sl_b: U8[][1] = ::{ "abcd" };
  nested_ro: U8[]$[] = U8[]$[]::sl_b;"""

priv fn roots(arena: Arena$@): List<|Root|>
    $out: = List<|Root|>(arena)
    out
        .push(Root::{ .slot = "const_array", .globals = "const RO_ARR: U8[4] = ::{ 1, 2, 3, 4 };",
        .locals = "", .expr = "RO_ARR" })
    out
        .push(Root::{ .slot = "const_slice", .globals = "const RO_SL: U8[] = \"abcd\";",
        .locals = "", .expr = "RO_SL" })
    out
        .push(Root::{ .slot = "local_immut_array", .globals = "",
        .locals = "loc_arr: U8[4] = ::{ 1, 2, 3, 4 };", .expr = "loc_arr" })
    out
        .push(Root::{ .slot = "local_immut_slice", .globals = "",
        .locals = "loc_sl: U8[] = \"abcd\";", .expr = "loc_sl" })
    out
        .push(Root::{ .slot = "ro_ptr", .globals = "const RO_ARR: U8[4] = ::{ 1, 2, 3, 4 };",
        .locals = "rp: U8@ = RO_ARR[0]@;", .expr = "rp" })
    out
        .push(Root::{ .slot = "ro_ptr_to_ptr", .globals = "const RO_ARR: U8[4] = ::{ 1, 2, 3, 4 };",
        .locals = "rp: U8@ = RO_ARR[0]@;\n  rpp: U8@@ = rp@;", .expr = "rpp" })
    out
        .push(Root::{ .slot = "ptr_to_ro_slice", .globals = "",
        .locals = "loc_sl: U8[] = \"abcd\";\n  psl: U8[]@ = loc_sl@;", .expr = "psl" })
    out
        .push(Root::{ .slot = "ro_ptr_to_struct", .globals = HOLDER_DECL,
        .locals = "$hv: Holder = ::{ .buf = ::{ 1, 2, 3, 4 }, .n = 0 };\n  hp: Holder@ = hv@;",
        .expr = "hp" })
    // A mutable binding too: even a valid write whose generated C fails (an assignment to a C
    // struct with immutable elements, say) is ksplc's mistake.
    out
        .push(Root::{ .slot = "mut_binding_array", .globals = "",
        .locals = "$mut_arr: U8[4] = ::{ 1, 2, 3, 4 };", .expr = "mut_arr" })
    out
        .push(Root::{ .slot = "const_struct", .globals = HOLDER2_DECL, .locals = "",
        .expr = "RO_ST" })
    // **Nested view types are among the sources too.** Otherwise the implicit conversion of "a
    // slice of mutable slices" to "a slice of immutable slices" is never tested. That conversion
    // lets the callee write a read-only value into a mutable frame.
    out
        .push(Root::{ .slot = "nested_mut_slices", .globals = "", .locals = NESTED_MUT_LOCALS,
        .expr = "nested" })
    out
        .push(Root::{ .slot = "nested_ro_slices", .globals = "", .locals = NESTED_RO_LOCALS,
        .expr = "nested_ro" })
    return out

priv fn writes(arena: Arena$@): List<|Write|>
    $out: = List<|Write|>(arena)
    out.push(Write::{ .slot = "index", .body = "<e>[0] = 9;" })
    out.push(Write::{ .slot = "index_compound", .body = "<e>[0] += 1;" })
    out.push(Write::{ .slot = "deref", .body = "<e>$ = 9;" })
    out.push(Write::{ .slot = "deref_twice", .body = "<e>$$ = 9;" })
    out.push(Write::{ .slot = "deref_after_add", .body = "(<e> + 1)$ = 9;" })
    out.push(Write::{ .slot = "deref_after_sub", .body = "(<e> - 0)$ = 9;" })
    out.push(Write::{ .slot = "index_through_deref", .body = "<e>$[0] = 9;" })
    out.push(Write::{ .slot = "field", .body = "<e>.n = 9;" })
    out.push(Write::{ .slot = "field_index", .body = "<e>.buf[0] = 9;" })
    out.push(Write::{ .slot = "field_index_compound", .body = "<e>.buf[0] += 1;" })
    out.push(Write::{ .slot = "pass_elem_addr_as_mut", .body = "sink_ptr(<e>[0]@);" })
    out.push(Write::{ .slot = "pass_addr_as_mut", .body = "sink_ptr(<e>@);" })
    out.push(Write::{ .slot = "pass_as_mut_slice", .body = "sink_slice(<e>);" })
    out.push(Write::{ .slot = "bind_elem_addr_then_write", .body = "q: = <e>[0]@;\n  q$ = 9;" })
    out.push(Write::{ .slot = "bind_addr_then_write", .body = "q: = <e>@;\n  q$ = 9;" })
    out
        .push(Write::{ .slot = "bind_addr_then_add_write", .body = "q: = <e>@;\n  (q + 1)$ = 9;" })
    out.push(Write::{ .slot = "pass_field_addr_as_mut", .body = "sink_ptr(<e>.buf[0]@);" })
    out
        .push(Write::{ .slot = "bind_field_addr_then_write",
        .body = "q: = <e>.buf[0]@;\n  q$ = 9;" })
    // A receiver's address is taken implicitly: with only assignment blocked, a `Self$@` method
    // still writes.
    out.push(Write::{ .slot = "mut_method_on_elem", .body = "<e>[0].bump();" })
    out.push(Write::{ .slot = "mut_method_on_place", .body = "<e>.bump_holder();" })
    out.push(Write::{ .slot = "mut_method_via_deref", .body = "<e>$.bump();" })
    // Weakening only the inner level to read-only. The callee puts a read-only value into the
    // frame, and the caller reads it back as mutable (the variance hole).
    out.push(Write::{ .slot = "pass_weakening_inner", .body = "sink_nested(<e>);" })
    out.push(Write::{ .slot = "write_nested_elem", .body = "<e>[0][0] = 9;" })
    return out

priv const PROG_MIDDLE: U8[] =
    """
impl U8
  fn bump(r: Self$@)
    r$ = 7



priv fn sink_ptr(p: U8$@)
  p$ = 7


priv fn sink_slice(s: U8$[])
  s[0] = 7


priv fn sink_nested(s: U8[]$[])
  s[0] = "x"


fn main(): I32
"""

priv fn build_case(r: Root, w: Write, arena: Arena$@): U8[]
    return arena.text().s(r.globals).s("\n").s(PROG_MIDDLE).s("  ").s(r.locals).s("\n  ")
        .s(w.body.replace("<e>", r.expr, arena)).s("\n  return 0\n\n").take()

priv fn c_complains(out: U8[]): Bool //< the C compiler's finding
    //< **A warning counts as an error** (the repository is at zero warnings, and clang warns on a
    //< discarded const qualifier).
    return out.find_str("error:").is_some() || out.find_str("warning:").is_some()

priv fn must_accept(slot: U8[], src: U8[], dir: U8[], arena: Arena$@) //<
    //< checks that a valid write passes
    //< **ksplc is right to reject every combination above**, so rejecting everything would go
    //< green. A valid write and the explicit cast's way out catch rejecting too much.
    name: = arena.text().s("a lawful write passes: \{slot\}").take()
    kspl: = fs.join(dir, arena.text().s("ok_\{slot\}.kspl").take(), arena)
    gen: = fs.join(dir, arena.text().s("ok_\{slot\}.c").take(), arena)
    obj: = fs.join(dir, arena.text().s("ok_\{slot\}.o").take(), arena)
    io.write_file(kspl, src) catch
        verdict.check(name, false, "cannot write the material")
        return
    // Run from the working directory, as below, so the file's name is its own, not a path.
    r: = harness.run_in(harness.ksplc_argv(U8[][]::{ kspl, gen }), dir)
    if !r.exited_with(0)
        verdict.check(name, false,
            arena.text()
            .s("ksplc refused it (excessive check)\n\{src\}--- diagnostics ---\n\{r.out\}").take())
        return
    cc: = harness.run_in(U8[][]::{ harness.cc(), "-std=c99", "-Wall", "-c", gen, "-o", obj }, dir)
    verdict.check(name, cc.exited_with(0) && !c_complains(cc.out),
        arena.text().s("C refused it\n\{src\}--- C's finding ---\n\{cc.out\}").take())

priv const OK_MUT_LOCAL_ARRAY: U8[] =
    """fn main(): I32
  $arr: U8[4] = ::{ 1, 2, 3, 4 }
  arr[0] = 9
  return I32::arr[0]

"""

priv const OK_MUT_PTR_ARITH: U8[] =
    """fn main(): I32
  $arr: U8[4] = ::{ 1, 2, 3, 4 }
  p: = arr[0]@
  (p + 1)$ = 9
  return I32::arr[1]

"""

priv const OK_MUT_SLICE_THROUGH_CONST_DESCRIPTOR_PTR: U8[] =
    """fn main(): I32
  $arr: U8[4] = ::{ 1, 2, 3, 4 }
  sl: U8$[] = U8$[]::arr
  psl: U8$[]@ = sl@
  psl[3] = 9
  return I32::arr[3]

"""

priv const OK_MUT_RECEIVER_FIELD_AND_ELEM: U8[] =
    """struct Holder { buf: U8[4]; n: I32; }

impl Holder
  fn write(r: Self$@)
    r.n = 9
    r.buf[0] = 9



fn main(): I32
  $h: Holder = ::{ .buf = ::{ 1, 2, 3, 4 }, .n = 0 }
  h.write()
  return I32::h.buf[0]

"""

priv const OK_WHOLE_ARRAY_ASSIGN: U8[] =
    """fn main(): I32
  $a: U8[18] = ::{ 1 }
  $b: U8[18] = ::{ 2 }
  a = b
  return I32::a[0]

"""

priv const OK_EXPLICIT_CAST_ESCAPE_HATCH: U8[] =
    """const RO: U8[4] = ::{ 1, 2, 3, 4 }

fn main(): I32
  p: U8$@ = U8$@::(RO@)
  p$ = 9
  return I32::RO[0]

"""

priv fn run_write_perm(arena: Arena$@) //< what passes ksplc passes C without a warning
    dir: = harness.sandbox("write_perm")
    work: = dir
    must_accept("mut_local_array", OK_MUT_LOCAL_ARRAY, work, arena)
    must_accept("mut_ptr_arith", OK_MUT_PTR_ARITH, work, arena)
    must_accept("mut_slice_through_const_descriptor_ptr", OK_MUT_SLICE_THROUGH_CONST_DESCRIPTOR_PTR,
        work, arena)
    must_accept("mut_receiver_field_and_elem", OK_MUT_RECEIVER_FIELD_AND_ELEM, work, arena)
    must_accept("whole_array_assign", OK_WHOLE_ARRAY_ASSIGN, work, arena)
    must_accept("explicit_cast_escape_hatch", OK_EXPLICIT_CAST_ESCAPE_HATCH, work, arena)

    // --- the combinations ---
    rs: = roots(arena)
    ws: = writes(arena)
    $names: = List<|U8[]|>(arena)
    $srcs: = List<|U8[]|>(arena)
    $gens: = List<|U8[]|>(arena)
    $jobs: = List<|subproc.Job|>(arena)
    for ri in Range.asc(rs.len)
        for wi in Range.asc(ws.len)
            r: = rs.get(ri)
            w: = ws.get(wi)
            stem: = arena.text().s("c\{ri\}_\{wi\}").take()
            kspl: = fs.join(work, arena.text().s("\{stem\}.kspl").take(), arena)
            gen: = fs.join(work, arena.text().s("\{stem\}.c").take(), arena)
            io.write_file(kspl, build_case(r, w, arena)) catch
                continue
            names.push(arena.text().s("\{r.slot\} / \{w.slot\}").take())
            srcs.push(kspl)
            gens.push(gen)
            jobs
                .push(subproc.Job::{ .argv = harness.ksplc_argv(U8[][]::{ kspl, gen }),
                .cwd = work })
    io.out().s("# writes to an immutable place: \{jobs.len\} ways\n")
    gen_outs: = harness.run_all(jobs.slice(), "write_perm_gen")

    // Only what ksplc accepted is passed on to C.
    $cc_jobs: = List<|subproc.Job|>(arena)
    $cc_index: = List<|Sz|>(arena)
    $rejected: Sz = 0
    for i in Range.asc(jobs.len)
        if !gen_outs.get(i).exited_with(0)
            rejected += 1
            continue
        gen: = gens.get(i)
        obj: = arena.text().s("\{gen\}.o").take()
        cc_jobs
            .push(subproc.Job::{ .argv = U8[][]::{ harness.cc(), "-std=c99", "-Wall", "-c", gen,
            "-o", obj }, .cwd = work })
        cc_index.push(i)
    cc_outs: = harness.run_all(cc_jobs.slice(), "write_perm_cc")
    $gaps: Sz = 0
    $both_ok: Sz = 0
    for j in Range.asc(cc_jobs.len)
        out: = cc_outs.get(j)
        i: = cc_index.get(j)
        if out.exited_with(0) && !c_complains(out.out)
            both_ok += 1
            continue
        gaps += 1
        src: = io.read_file(srcs.get(i), null) catch ""
        verdict.check(arena.text().s("ksplc did not turn it away and C did: \{names.get(i)\}")
            .take(), false,
            arena.text().s("\{src\}--- C's finding ---\n\{out.out\}").take())
    verdict.check(arena.text()
        .s("what passed ksplc passes C without a warning too (\{jobs.len\} ways checked: ")
        .s("ksplc refused \{rejected\} / both passed \{both_ok\})").take(), gaps == 0,
        arena.text().s("\{gaps\} gaps in the checks").take())

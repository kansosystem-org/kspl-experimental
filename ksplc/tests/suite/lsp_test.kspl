//< A smoke test of the LSP supervisor's recovery from a crash or a hang, and of its answers
//< The language server is a supervisor process plus a worker. `std/jsonrpc` provides the framing
//< (Content-Length, the id, the standard error, the timeout). `../support/lsp_client.kspl` builds
//< LSP's params.
//< **The workspace is this package's own folder**, where the suite runs. The root's `lsp-tree`
//< answers the queries that only the whole tree can answer, on the same client. Examples are a
//< word read across every package, and callers in another package's demos.
import "ksplc/tests/support/harness"
import "ksplc/tests/support/jsonrpc_client"
import "ksplc/tests/support/jsonrpc_client_check"
import "ksplc/tests/support/lsp_client"
import "ksplc/tests/support/lsp_hover"
import "ksplc/tests/support/lsp_outline" + { HEAVY_MS, incoming, off_words, prepare_fn,
    read_tokens }
import "ksplc/tests/support/lsp_pick"
import "ksplc/tests/support/lsp_read" { col_in_line, decl_line, end_text, from_names, is_missing }
import "ksplc/tests/support/lsp_recover"
import "ksplc/tests/support/lsp_rename"
import "ksplc/tests/support/lsp_spell"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/json" + { Json_builder }
import "std/jsonrpc"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strfmt" as _strfmt
import "std/subproc"
import "std/sys"
import "std/verdict"

priv const SRC: U8[] = "fn main(): Void\n    var x = 1\n\n"
// The source that **parses**, for the colouring. The colours come from the syntax tree, so a
// document that does not parse comes back empty (`ksplc/lsp/semtok.kspl`'s header). A function's
// name, a type's position, a struct's name and fields, and an import's alias are all in one.
// **An enum too**: the compiler gives it a `variant_name` from a string of its own, which must
// colour nothing (`made_by_compiler` in `ksplc/base/ast_ext.kspl`).
priv const SEMTOK_SRC: U8[] =
    """struct Pair
  left: I32
  right: I32


fn add(a: I32, b: I32): I32
  return a + b


enum Side
  near
  far

"""
priv const SEMTOK_URI: U8[] = "file:///s.kspl"
priv const PROBE_URI: U8[] = "file:///t.kspl"

priv const CH_FILE: U8[] = "lsp/call_hier.kspl" //<
    //< The Call Hierarchy's starting file, named from the package's top
    //< This Call Hierarchy comes with a workspace walk.
priv const CH_DECL: U8[] = "fn prepare_call_hierarchy"

priv const AFTER_HANG_MS: I32 = 10000 + lsp_client.READ_MS //<
    //< how long a hover after the hang hook may take
    //< The supervisor's watchdog (`WORKER_TIMEOUT_MS` in `ksplc/lsp/server.kspl`, 10 s) must give
    //< up first. The worker it starts in place must analyse the probe, which takes as long as
    //< any first answer (`lsp_client.READ_MS`). The 10 s is written again here: the constant is the
    //< supervisor's own. Importing the server would build the language server into this suite.

// ==========================================
// A hover on a slice's own `len` and `ptr`
// ==========================================

// **They are answered inside the compiler** (`check_builtin_dot_access` in
// `../../sema/body/dot.kspl`), not by a declaration the editor walks to.
// Caution: **Ask again after the answer.** The supervisor returns `null` for a dying worker too,
// so one response cannot tell a crash from a quiet "nothing to say".
priv const BUILTIN_SRC: U8[] =
    """fn probe(s: U8[]): Sz
  n: = s.len
  p: = s.ptr
  return n + Sz::p$

"""

priv const BUILTIN_URI: U8[] = "file:///builtin_probe.kspl"
priv const BUILTIN_DECLS: U8[][2] = ::{ "  n: =", "  p: =" }
priv const BUILTIN_MARKS: U8[][2] = ::{ ".len", ".ptr" }
priv const BUILTIN_WANTS: U8[][2] = ::{ "len: Sz", "ptr: U8@" }

priv fn check_hover_builtin_member(c: jsonrpc_client.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(BUILTIN_URI, BUILTIN_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    defer lsp_client.close(c, BUILTIN_URI, arena)
    for i in Range.asc(BUILTIN_DECLS.len)
        decl: = BUILTIN_DECLS[i]
        col: = col_in_line(BUILTIN_SRC, decl, BUILTIN_MARKS[i], arena) + 2
        pos: = lsp_client.at_pos(BUILTIN_URI, decl_line(BUILTIN_SRC, decl, arena), col, arena)
        label: = arena.text().s("a hover on a slice's own '").s(BUILTIN_MARKS[i]).s("' answers")
            .take()
        got: = c.request("textDocument/hover", pos, lsp_client.READ_MS, arena) catch e
            verdict.check(label, false, end_text(e))
            continue
        text: = lsp_client.hover_text(got.val)
        verdict.check(label, text.find_str(BUILTIN_WANTS[i]).is_some(),
            lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))
    // The worker is still the same one; a remade one would not know this document.
    live: = lsp_client.at_pos(BUILTIN_URI, decl_line(BUILTIN_SRC, "fn probe", arena), 3, arena)
    alive: = c.request("textDocument/hover", live, lsp_client.READ_MS, arena) catch e
        verdict.check("the analysis side is still standing after them", false, end_text(e))
        return
    a_text: = lsp_client.hover_text(alive.val)
    verdict.check("the analysis side is still standing after them",
        a_text.find_str("probe").is_some(),
        lsp_client.why(c, arena.text().s("'").s(a_text).s("'").take(), arena))

// ==========================================
// A variant reached through an alias
// ==========================================

// **The value's type is the name written** (`Form.line(3)` is a `Form`) while the variant is the
// enum's. So the hover and the jump look it up on the type the alias names. Looked up on the alias,
// both come back empty (resolve_enum_variant_def in `../../lsp/nav.kspl`).
priv const ALIAS_SRC: U8[] =
    """enum Shape
  dot
  line(len: I32)

typedef Form = Shape

fn probe(): Form
  return Form.line(3)
"""

priv const ALIAS_URI: U8[] = "file:///alias_probe.kspl"
priv const ALIAS_USE: U8[] = "  return Form.line(3)"

priv fn check_variant_through_alias(c: jsonrpc_client.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(ALIAS_URI, ALIAS_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    defer lsp_client.close(c, ALIAS_URI, arena)
    pos: = lsp_client.at_pos(ALIAS_URI, decl_line(ALIAS_SRC, ALIAS_USE, arena),
        col_in_line(ALIAS_SRC, ALIAS_USE, "line", arena) + 1, arena)
    shown: = "a hover on a variant reached through an alias shows the variant"
    got: = c.request("textDocument/hover", pos, lsp_client.READ_MS, arena) catch e
        verdict.check(shown, false, end_text(e))
        return
    text: = lsp_client.hover_text(got.val)
    verdict.check(shown, text.find_str("line(len: I32)").is_some(),
        lsp_client.why(c, arena.text().s("'").s(text).s("'").take(), arena))
    jump: = "a jump from it lands on the enum's variant"
    went: =
        c.request("textDocument/definition", pos, lsp_client.READ_MS, arena) catch e
        verdict.check(jump, false, end_text(e))
        return
    landed: = went.val.get("result").get("range").get("start").get("line").as_int().unwrap_or(-1)
    verdict.check(jump, landed == I32::decl_line(ALIAS_SRC, "  line(len: I32)", arena),
        lsp_client.why(c, arena.text().s("line \{landed\}").take(), arena))

// ==========================================
// A shebang line gives no diagnostic in an editor buffer either
// ==========================================

// **An editor buffer takes a different path from a disk read.** If only the disk read masks the
// shebang (mask_shebang in parse/source_fix.kspl), the `#` is analysed as an attribute. Then a
// syntax error appears **on the file's first character, only in the editor**, while lint / run /
// fmt stay green.
priv const SHEBANG_SRC: U8[] =
    """#!/usr/bin/env -S ksplc run
import "std/io"

fn main(): I32
    io.out().s("ok\n")
    return 0

"""

priv const SHEBANG_URI: U8[] = "file:///shebang_probe.kspl"

// **Inside the workspace one buffer goes by three names** (opened path, logical name, that name
// with its extension). A check walking every name must report once.
// Caution: **Keep these two on escaped lines, not in a `"""` text.** The check reads lines, so a
// line opening with `//<` would be this file's own mark. These two are wrong on purpose.
priv const DESCRIBED_SRC: U8[] =
    "#!/usr/bin/env -S ksplc run\n//< A script that describes itself under its start-up \
        line\nimport \"std/io\"\n\nfn main()\n  io.out().s(\"ok\\n\")\n"

priv const DANGLING_SRC: U8[] =
    "//< A file that describes itself\nimport \"std/io\"\n\nfn main()\n  x: = 1\n  //< this \
        continues nothing\n  if x > 0\n    io.out().s(\"ok\\n\")\n"

// The two are opened inside the workspace (outside it the three names are two). **No file exists
// under either name** (there is no `lsp_probe/`): the buffer is all the server reads.
priv const DESCRIBED_REL: U8[] = "lsp_probe/shebang_described.kspl"
priv const DANGLING_REL: U8[] = "lsp_probe/dangling.kspl"

priv struct Published //< what the next publishDiagnostics for one document said
    found: Bool
    diags: List<|json.Value|>

priv fn published_for(c: jsonrpc_client.Client$@, tail: U8[], arena: Arena$@): Published //<
    //< Reads messages until one publishes the diagnostics of the URI ending `tail`
    for _k in Range.asc(8)
        msg: = c.read_msg(lsp_client.READ_MS, arena) catch
            break
        if !msg.val.get("method").as_str().unwrap_or("").equals("textDocument/publishDiagnostics")
            continue
        p: = msg.val.get("params")
        if !p.get("uri").as_str().unwrap_or("").ends_with(tail)
            continue
        return Published::{ .found = true,
            .diags = p.get("diagnostics").arr_list(arena) }
    return Published::{ .found = false, .diags = List<|json.Value|>.new(arena) }

priv fn said(got: Published, arena: Arena$@): U8[] //< what a failing check shows of `got`
    if !got.found
        return "(no publishDiagnostics came)"
    b: = arena.text()
    for d in got.diags
        b.s(d.get("message").as_str().unwrap_or("")).c('\n')
    return b.s("\{got.diags.len\} diagnostic(s)").take()

// ==========================================
// The diagnostic's column and length are in UTF-16 units
// Caution: **Do not say them in bytes.** LSP takes both in UTF-16 units, so bytes make **the
// squiggle stretch over a string containing non-ASCII** and onto the next word.
// ==========================================
priv const WIDE_SRC: U8[] = "fn main(): I32\n  n: I32 = \"かんそ\"\n  return n\n\n"
priv const WIDE_URI: U8[] = "file:///wide_probe.kspl"
priv const WIDE_FROM: I64 = 11I64 //<
    //< The `"かんそ"` of ` n: I32 = "かんそ";` is 5 units in UTF-16 (11 in bytes)
priv const WIDE_TO: I64 = 16I64

priv fn check_wide_range(c: jsonrpc_client.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(WIDE_URI, WIDE_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    defer lsp_client.close(c, WIDE_URI, arena)
    $found: = false
    $from: I64 = -1I64
    $to: I64 = -1I64
    for _k in Range.asc(12)
        msg: = c.read_msg(HEAVY_MS, arena) catch
            break
        if !msg.val.get("method").as_str().unwrap_or("").equals("textDocument/publishDiagnostics")
            continue
        p: = msg.val.get("params")
        if !p.get("uri").as_str().unwrap_or("").ends_with("wide_probe.kspl")
            continue
        got: = p.get("diagnostics").arr_list(arena)
        if got.len == 0
            continue
        r: = got.get(0).get("range")
        found = true
        from = r.get("start").get("character").as_int().unwrap_or(-1I32)
        to = r.get("end").get("character").as_int().unwrap_or(-1I32)
        break
    d: = arena.text().s("\{from\}..\{to\}").take() if found else "(no diagnostic came)"
    verdict.check("the diagnostic's range comes in UTF-16 units",
        found && from == WIDE_FROM && to == WIDE_TO, d)

// A misaligned column in the indentation notation reaches the editor.
// **The compiler and the editor rewrite the indentation separately.** The check is that the
// error reaches the screen, not the count (an empty `if` adds an `[I0307]` beside it). It carries
// no code, so the match is on its wording.
priv const RAGGED_SRC: U8[] =
    """import "std/io"

fn main(): I32
  if 1 < 0
      io.out().s("6 columns\\n")
    io.out().s("4 columns, not level with the sibling\\n")
  io.out().s("2 columns\\n")
  return 0
"""
priv const RAGGED_URI: U8[] = "file:///ragged_probe.kspl"

priv fn check_ragged_reaches(c: jsonrpc_client.Client$@, arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(RAGGED_URI, RAGGED_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    defer lsp_client.close(c, RAGGED_URI, arena)
    $found: = false
    $ragged: = false
    for _k in Range.asc(12)
        msg: = c.read_msg(HEAVY_MS, arena) catch
            break
        if !msg.val.get("method").as_str().unwrap_or("").equals("textDocument/publishDiagnostics")
            continue
        p: = msg.val.get("params")
        if !p.get("uri").as_str().unwrap_or("").ends_with("ragged_probe.kspl")
            continue
        found = true
        for one in p.get("diagnostics").arr_list(arena)
            if one.get("message").as_str().unwrap_or("").find_str("sibling lines use").is_some()
                ragged = true
        break
    seen: = "the cautions did not come" if found else "(no publishDiagnostics came)"
    verdict.check("a column slip in the indentation notation reaches the editor", found && ragged,
        lsp_client.why(c, seen, arena))

priv fn check_shebang(c: jsonrpc_client.Client$@, top: U8[], arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(SHEBANG_URI, SHEBANG_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    defer lsp_client.close(c, SHEBANG_URI, arena)
    got: = published_for(c, "shebang_probe.kspl", arena)
    verdict.check("no diagnostic comes out on a shebang script being edited",
        got.found && got.diags.len == 0, lsp_client.why(c, said(got, arena), arena))
    described: = lsp_client.uri_of(top, DESCRIBED_REL, arena)
    c.notify("textDocument/didOpen", lsp_client.did_open(described, DESCRIBED_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    defer lsp_client.close(c, described, arena)
    quiet: = published_for(c, DESCRIBED_REL, arena)
    verdict.check("a script described under its start-up line puts out no diagnostic in the editor",
        quiet.found && quiet.diags.len == 0, lsp_client.why(c, said(quiet, arena), arena))
    dangling: = lsp_client.uri_of(top, DANGLING_REL, arena)
    c.notify("textDocument/didOpen", lsp_client.did_open(dangling, DANGLING_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    defer lsp_client.close(c, dangling, arena)
    once: = published_for(c, DANGLING_REL, arena)
    one: =
        once.found && once.diags.len == 1 &&
        once.diags.get(0).get("message").as_str().unwrap_or("").starts_with("[W0209]")
    verdict.check("a continuation continuing nothing is reported once, as the command line does",
        one, lsp_client.why(c, said(once, arena), arena))

// ==========================================
// Code covered by `#cfg()` can be read once the flag is set. **Code under an unset flag is dropped
// before the analysis** (as in the compiler), so there **the editor's features look dead**.
// ==========================================
priv const CFG_SRC: U8[] =
    """import "std/io"

#cfg(probe_flag)
fn cfg_only_fn(): Void
    io.out().s("x")

"""

priv const CFG_URI: U8[] = "file:///cfg_probe.kspl"

// ==========================================
// A document that was didClose does not come back after the worker is remade
// ==========================================

priv const CLOSE_SRC: U8[] = "fn main(): I32\n  probe: I64 = 1\n  return 0\n\n" //<
    //< The source of the document the restore check closes
    //< The supervisor remembers the open documents' text, and hands it to a remade worker.
    //< **The supervisor's record marks the document closed**, or a closed document revives in the
    //< remade worker.
    //< Caution: **Test it with a dedicated client.** Its supervisor holds these two documents and
    //< no other, so what comes back after the crash is theirs alone.
priv const CLOSED_URI: U8[] = "file:///closed_probe.kspl"
priv const OPEN_URI: U8[] = "file:///stays_open_probe.kspl"

// What the supervisor logs when the test hooks do their work (`ksplc/lsp/server.kspl`). **A hook
// that does nothing leaves the checks after it answering as if the worker had been remade**.
priv const CRASH_LOG: U8[] = "worker request failed while handling '$/ksplTestCrash': pipe closed"
priv const HANG_LOG: U8[] =
    "worker request failed while handling '$/ksplTestHang': no output within the watchdog window"
// The crash's log line when the only document left open is the probe the hovers ask about.
// **Every check on the shared client closes what it opened** (`lsp_client.close`). The remade
// worker analyses every open document again, one at a time while the editor is idle. So each one
// left behind is work a request can find under way.
priv const RESTORES_PROBE: U8[] =
    "'$/ksplTestCrash': pipe closed (the worker exited). Restarting the worker. Open documents to \
        restore: 1"

priv fn gave_up(c: jsonrpc_client.Client$@, line: U8[], arena: Arena$@): Bool //<
    //< Whether the supervisor's log carries `line`, copied at once (`err_tail` borrows its buffer)
    return arena.text().s(c.err_tail()).take().find_str(line).is_some()

priv fn probe_hover(c: jsonrpc_client.Client$@, uri: U8[], arena: Arena$@): U8[]
    got: =
        c.request("textDocument/hover", lsp_client.at_pos(uri, 1, 3, arena), lsp_client.READ_MS,
        arena) catch
        return ""
    return lsp_client.hover_text(got.val)

priv fn check_didclose(exe: U8[], arena: Arena$@)
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, "", arena) catch
        verdict.check("a document left open is restored after the worker is remade", false,
            "the client cannot be started")
        return
    defer c.free()
    _init: =
        c.request("initialize", lsp_client.empty_obj(arena), lsp_client.READ_MS, arena) catch {}
    for uri in U8[][]::{ CLOSED_URI, OPEN_URI }
        c.notify("textDocument/didOpen", lsp_client.did_open(uri, CLOSE_SRC, arena),
            lsp_client.SEND_MS, arena) catch {}
    lsp_client.close(c@, CLOSED_URI, arena)
    c.notify("$/ksplTestCrash", lsp_client.empty_obj(arena), lsp_client.SEND_MS, arena) catch {}
    stays: = probe_hover(c@, OPEN_URI, arena)
    verdict.check("the crash hook ends the worker before the restore is checked",
        gave_up(c@, CRASH_LOG, arena), lsp_client.why(c@, "", arena))
    d4: = lsp_client.why(c@, arena.text().s("'").s(stays).s("'").take(), arena)
    ok11: = stays.find_str("I64").is_some()
    verdict.check("a document left open is restored after the worker is remade", ok11, d4)
    gone: = probe_hover(c@, CLOSED_URI, arena)
    d5: = lsp_client.why(c@, arena.text().s("'").s(gone).s("'").take(), arena)
    ok10: = gone.find_str("I64").is_none()
    verdict.check("a document that was didClose is not restored after the worker is remade", ok10,
        d5)

priv fn check_cfg(c: jsonrpc_client.Client$@, exe: U8[], arena: Arena$@)
    c.notify("textDocument/didOpen", lsp_client.did_open(CFG_URI, CFG_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    defer lsp_client.close(c, CFG_URI, arena)
    off: = lsp_client.answer(c, "textDocument/hover",
        lsp_client.at_pos(CFG_URI, 3, 4, arena), lsp_client.READ_MS, arena)
    off_text: = lsp_client.hover_text(off)
    // Caution: **It must not return null.** A dropped declaration is not in the AST, so without a
    // reason it looks like "nothing at that position" and the feature seems dead.
    d13: = lsp_client.why(c, arena.text().s("'").s(off_text).s("'").take(), arena)
    ok5: =
        off_text.find_str("#cfg(probe_flag)").is_some() &&
        off_text.find_str("not analyzed").is_some()
    verdict.check("what sits under an unraised #cfg answers with a reason", ok5, d13)
    // The analysis worker is a separate process: only an environment variable reaches it.
    sys.set_env("KSPLC_DEFINES", "probe_flag") catch panic("KSPLC_DEFINES could not be set")
    $c2: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, "", arena) catch
        verdict.check("raised by KSPLC_DEFINES, what is under #cfg can be hovered too", false,
            "the client cannot be started")
        return
    defer c2.free()
    _init: =
        c2.request("initialize", lsp_client.empty_obj(arena), lsp_client.READ_MS, arena) catch {}
    c2.notify("textDocument/didOpen", lsp_client.did_open(CFG_URI, CFG_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    on: = lsp_client.answer(c2@, "textDocument/hover",
        lsp_client.at_pos(CFG_URI, 3, 4, arena), lsp_client.READ_MS, arena)
    on_text: = lsp_client.hover_text(on)
    detail2: = lsp_client.why(c2@,
        arena.text().s("'").s(on_text).s("'").take(), arena)
    ok4: = on_text.find_str("cfg_only_fn").is_some()
    verdict.check("raised by KSPLC_DEFINES, what is under #cfg can be hovered too", ok4, detail2)
    // Caution: **Delete it; do not set it empty.** `set_env` rejects an empty value, so that leaves
    // the flag set for every server started after this one.
    sys.unset_env("KSPLC_DEFINES") catch panic("KSPLC_DEFINES could not be unset")

// ==========================================
// The language server walks the workspace itself. **The client passes no list** (the reason is in
// `ksplc/lsp/workspace.kspl`'s header).
// So the test makes **its own working directory**, not relying on this repository's `.gitignore`.
// ==========================================

// Caution: **Write the working directory's files in the default notation.** A file in the other
// notation takes a path of its own; this checks the default.
priv const WALK_RELS: U8[][5] = ::{ ".gitignore", "pkg/lib.kspl", "user.kspl", "built/copy.kspl",
    "saved.kspl" }
priv const WALK_LIB: U8[] = "fn hit(): I32\n  return 0\n" //<
    //< The library file of the workspace-walk probe
    //< Caution: **Write the imports as paths from the root** (paths holding a `/`). A path without
    //< one resolves **from that file's folder**, so only the copy in `built/` stops resolving, and
    //< **skipped cannot be told from unresolved**. `use` and `stray` have different names to show
    //< the reading order does not change the answer.
priv const WALK_USER: U8[] = "import \"pkg/lib\"\n\nfn use(): I32\n  return lib.hit()\n"
priv const WALK_COPY: U8[] = "import \"pkg/lib\"\n\nfn stray(): I32\n  return lib.hit()\n"
// A file as a Windows editor saves it: a BOM first, and every line ending in `\r\n`. **The walk
// reads it from the disk itself**, so only the walk's own reading can handle it.
priv const WALK_SAVED: U8[] =
    "\uFEFFimport \"pkg/lib\"\r\n\r\nfn saved(): I32\r\n  return lib.hit()\r\n"
priv const WALK_BODIES: U8[][5] = ::{ "built/\n", WALK_LIB, WALK_USER, WALK_COPY, WALK_SAVED }

priv fn walk_changes(exe: U8[], dir: U8[], arena: Arena$@): json.Value //<
    //< It starts the language server in that directory and counts `hit`'s rename destinations
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, dir, arena) catch
        return .null_val
    defer c.free()
    $b: = Json_builder.new(arena)
    _ready: =
        c.request("initialize", b.obj().build(), lsp_client.READ_MS, arena) catch
        return .null_val
    pos: = b.obj().set("line", b.int_val(0I64)).set("character", b.int_val(3I64)).build()
    doc: = b.obj().set("uri", b.str_val("pkg/lib.kspl")).build()
    params: = b.obj().set("textDocument", doc).set("position", pos)
        .set("newName", b.str_val("tap")).build()
    return lsp_client.answer(c@, "textDocument/rename", params, HEAVY_MS, arena)

priv fn check_walk(exe: U8[], arena: Arena$@)
    dir: = harness.sandbox("lsp_walk")
    fs.write_tree(dir, U8[][]::WALK_RELS, U8[][]::WALK_BODIES, arena) catch
        verdict.check("it reaches the caller with no file list passed in", false,
            "it cannot be placed in the working directory")
        return
    changes: = walk_changes(exe, dir, arena).get("result").get("changes")
    d1: = lsp_client.dump(changes, arena)
    // **Check that it reaches the caller**: `lib.kspl` does not import `user.kspl`, so only the
    // walk reaches it.
    verdict.check("it reaches the caller with no file list passed in",
        changes.find("pkg/lib.kspl").is_some() && changes.find("user.kspl").is_some(), d1)
    // Caution: **It must not enter a folder `.gitignore` named.**
    verdict.check("a folder `.gitignore` named is not walked",
        !changes.find("built/copy.kspl").is_some(), d1)
    // **The walk reads what a compile reads** (`settle` in `ksplc/parse/source_fix.kspl`). If not
    // cleaned, the BOM fails the file's first line, and the walk drops it. The column is right only
    // where the BOM is not counted.
    at: = changes.get("saved.kspl").get_at(0).get("range").get("start")
    verdict.check("a file saved with a BOM and \\r\\n is walked as a compile reads it",
        at.get("line").as_int().unwrap_or(-1) == 3 &&
        at.get("character").as_int().unwrap_or(-1) == 13, d1)

// ==========================================
// A workspace request (references, rename, the callers) is built and thrown away on the same arena
// as the document's analysis. **The document's answers must come back whole after it**: the rewind
// clears what the analysis keeps beside its tree, such as the ranges a `#cfg()` dropped.
// ==========================================
priv const CFG_WALK_SRC: U8[] =
    "#cfg(probe_flag)\nfn cfg_only_fn()\n    return\n\nfn kept(): I32\n    return 0\n"

priv fn dropped_reason(c: jsonrpc_client.Client$@, arena: Arena$@): U8[] //<
    //< The hover on the name under the unraised `#cfg`
    got: =
        c.request("textDocument/hover", lsp_client.at_pos("cfg_walk.kspl", 1, 4, arena),
        lsp_client.READ_MS, arena) catch
        return ""
    return lsp_client.hover_text(got.val)

priv fn check_cfg_after_walk(exe: U8[], arena: Arena$@)
    name: = "what sits under an unraised #cfg keeps its reason after a references request"
    dir: = harness.sandbox("lsp_cfg_walk")
    fs.write_tree(dir, U8[][]::{ "cfg_walk.kspl" }, U8[][]::{ CFG_WALK_SRC }, arena) catch
        verdict.check(name, false, "it cannot be placed in the working directory")
        return
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, dir, arena) catch
        verdict.check(name, false, "the client cannot be started")
        return
    defer c.free()
    _init: =
        c.request("initialize", lsp_client.empty_obj(arena), lsp_client.READ_MS, arena) catch {}
    c.notify("textDocument/didOpen",
        lsp_client.did_open("cfg_walk.kspl", CFG_WALK_SRC, arena), lsp_client.SEND_MS, arena) catch {}
    before: = dropped_reason(c@, arena)
    _uses: =
        c.request("textDocument/references", lsp_client.at_pos("cfg_walk.kspl", 4, 4, arena),
        HEAVY_MS, arena) catch {}
    after: = dropped_reason(c@, arena)
    d: = lsp_client.why(c@,
        arena.text().s("before '\{before\}', after '\{after\}'").take(), arena)
    verdict.check(name,
        before.find_str("not analyzed").is_some() &&
        after.find_str("not analyzed").is_some(), d)

// ==========================================
// The workspace view checks the bodies naming the word, and those naming a generic that does
// (`Bodies.mentioning` in `ksplc/sema/session/ctx.kspl`). **A caller inside a generic exists only
// in an instance**, made here by `start`, whose body never names `hit`. Checked by the word alone,
// `relay` would drop out of `hit`'s callers.
// ==========================================
priv const RELAY_RELS: U8[][3] = ::{ "pkg/lib.kspl", "pkg/gen.kspl", "user.kspl" }
priv const RELAY_BODIES: U8[][3] = ::{ "fn hit(): I32\n    return 0\n",
    "import \"pkg/lib\"\n\nfn relay<|T|>(x: T): I32\n    return lib.hit()\n",
    "import \"pkg/gen\"\nimport \"pkg/lib\"\n\nfn start(): I32\n    return gen.relay(1)\n\nfn \
        direct(): I32\n    return lib.hit()\n" }

priv fn check_generic_caller(exe: U8[], arena: Arena$@)
    name: = "a caller inside a generic is found though its instance is made by a body not naming it"
    dir: = harness.sandbox("lsp_relay")
    fs.write_tree(dir, U8[][]::RELAY_RELS, U8[][]::RELAY_BODIES, arena) catch
        verdict.check(name, false, "it cannot be placed in the working directory")
        return
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, dir, arena) catch
        verdict.check(name, false, "the language server cannot be started")
        return
    defer c.free()
    _ready: =
        c.request("initialize", lsp_client.empty_obj(arena), lsp_client.READ_MS, arena) catch
        verdict.check(name, false, "initialize does not return")
        return
    prep: = prepare_fn(c@, RELAY_RELS[0], RELAY_BODIES[0], "fn hit", arena)
    if !verdict.check("prepareCallHierarchy lands on the generic's callee", prep.found,
        lsp_client.why(c@, prep.raw, arena))
        return
    got: = incoming(c@, prep.item, arena)
    names: = from_names(got.calls@, arena)
    shown: = lsp_client.why(c@, lsp_client.join(names@, arena), arena)
    // The instance answers under its own name (`pkg_gen_relay_I32`), as every instance does.
    $in_relay: = false
    for n in names
        in_relay = in_relay || n.find_str("relay").is_some()
    verdict.check(name, in_relay && names.contains("direct"), shown)

// ==========================================
// The worker keeps showing it is alive even in the middle of one heavy request. The supervisor
// detects a hang by "how long it has been silent" (worker_timeout_ms in ksplc/lsp/server.kspl).
// Here the worker is driven directly, not through the supervisor.
// ==========================================
priv fn check_worker_alive(exe: U8[], top: U8[], ch_text: U8[], arena: Arena$@)
    $w: = subproc.spawn_piped(U8[][]::{ exe, "lsp-worker" }, "") catch
        verdict.check("it goes on telling it is alive mid-way through a heavy didOpen", false,
            "the worker cannot be started")
        return
    defer w.kill()
    $b: = Json_builder.new(arena)
    root: = b.obj().set("rootUri", b.str_val(top)).build()
    $frames: = Str_builder.new()
    jsonrpc.frame_into(frames@, jsonrpc.encode("initialize", root, 1, arena))
    opened: = jsonrpc.encode("textDocument/didOpen",
        lsp_client.did_open(CH_FILE, ch_text, arena), -1, arena)
    jsonrpc.frame_into(frames@, opened)
    bad_uri: = "file:///kspl-test-missing-import.kspl"
    bad_params: = lsp_client.did_open(bad_uri,
        "import \"std/no_such_worker_test_module\"; fn main() {}", arena)
    bad_open: = jsonrpc.encode("textDocument/didOpen", bad_params, -1, arena)
    jsonrpc.frame_into(frames@, bad_open)
    jsonrpc.frame_into(frames@,
        jsonrpc.encode("textDocument/didClose", lsp_client.at_doc(bad_uri, arena), -1, arena))
    w.write(frames.slice(), 300000) catch
        verdict.check("it goes on telling it is alive mid-way through a heavy didOpen", false,
            "the worker took no request")
        return
    w.close_stdin() // if not closed, the worker keeps waiting: it answers after reading everything
    $answers: = Str_builder.new()
    buf: = U8$[]::{ .ptr = U8$@::arena.alloc(64 * 1024), .len = 64 * 1024 }
    for _k in Range.asc(4000)
        got: = w.read(buf, 300000) catch
            break
        answers.s(buf.sub(0, got))
    // Only the heavy didOpen counts: the following failed load must not supply its marks.
    done: = "__KSPL_WORKER_DONE__"
    first: = answers.slice().find_str(done).unwrap_or(answers.len)
    heavy: = answers.slice().sub_from(first + done.len)
    seen: = heavy.sub(0, heavy.find_str(done).unwrap_or(0)).count_str("__KSPL_WORKER_ALIVE__")
    d14: = arena.text().s("\{seen\} liveness marks").take()
    verdict.check("it goes on telling it is alive mid-way through a heavy didOpen", seen > 0, d14)
    $code: I32 = -1
    for _i in Range.asc(100)
        if ended: = w.exit_code()
            code = ended
            break
        sys.sleep_ms(10)
    nerr: = w.read_err(buf, 100) catch 0
    verdict.check("a worker frees a document whose import cannot be loaded", code == 0,
        arena.text().s("exit=\{code\}: ").s(buf.sub(0, nerr)).take())

fn main(): I32
    arena: = harness.begin(512 * 1024 * 1024)
    exe: = harness.ksplc_exe()
    // Caution: Start it with the server left running (the reason is in `lsp_client.kspl`'s
    // header).
    sys.set_env("KSPLC_STD_DIR", harness.std_dir()) catch panic("KSPLC_STD_DIR could not be set")
    jsonrpc_client_check.run(exe, arena)
    // The workspace is the package's top, where the suite runs (an empty path inherits it).
    top: = fs.absolute("", arena) catch
        return harness.fatal("the working directory cannot be read")
    $c: =
        lsp_client.start(exe, U8[][]::{ .ptr = null, .len = 0 }, "", arena) catch
        return harness.fatal("the language server cannot be started")
    defer c.free()

    init: =
        c.request("initialize", lsp_client.empty_obj(arena), lsp_client.READ_MS, arena) catch e
        return harness
            .fatal(arena.text().s("initialize does not return \{end_text(e)\}").take())
    d15: = lsp_client.dump(init.val, arena)
    ok3: = !is_missing(init.val.get("result").get("capabilities"))
    verdict.check("initialize returns capabilities", ok3, d15)

    c.notify("textDocument/didOpen", lsp_client.did_open(PROBE_URI, SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    // A request discards didOpen's publishDiagnostics while waiting for its own id.
    probe_pos: = lsp_client.at_pos(PROBE_URI, 1, 8, arena)
    hover1: = lsp_client.answer(c@, "textDocument/hover", probe_pos, lsp_client.READ_MS, arena)
    verdict.check("hover answers (before the injection)", !is_missing(hover1),
        lsp_client.why(c@, "", arena))

    // The source's colouring.
    // Caution: **Having announced it, answer**, or the editor waits.
    caps: = init.val.get("result").get("capabilities").get("semanticTokensProvider")
    legend: = caps.get("legend")
    types_n: = legend.get("tokenTypes").arr_list(arena).len
    verdict.check("it names semanticTokens and puts the legend out",
        types_n > 0 && legend.get("tokenModifiers").arr_list(arena).len > 0, d15)
    // Caution: **Test it on a source that parses.**
    c.notify("textDocument/didOpen", lsp_client.did_open(SEMTOK_URI, SEMTOK_SRC, arena),
        lsp_client.SEND_MS, arena) catch {}
    sem: = lsp_client.answer(c@, "textDocument/semanticTokens/full",
        lsp_client.at_doc(SEMTOK_URI, arena), lsp_client.READ_MS, arena)
    sem_data: = sem.get("result").get("data")
    toks: = read_tokens(sem_data, types_n, arena)
    d_sem: = lsp_client.dump(sem, arena)
    // The tokens are `Pair`, `I32` x5, `add`, `a` and `b`.
    verdict.check("semanticTokens returns content", toks.count >= 6, d_sem)
    // Caution: **Keep the five numbers of each token together**, or the colour lands off the text.
    verdict.check("the kind's number stays inside the legend", !toks.over, d_sem)
    verdict.check("the positions are ascending", !toks.back, d_sem)
    verdict.check("it puts out no token of length 0", !toks.empty, d_sem)
    // **The check is what each one covers**, not only the count. What the compiler made, placed at
    // its own string's positions, colours `t Pa` and `g` in the file's first lines.
    verdict.check("every token covers one whole name as written",
        off_words(sem_data, SEMTOK_SRC, arena) == 0, d_sem)
    lsp_client.close(c@, SEMTOK_URI, arena)
    lsp_outline.run_outline(c@, init.val.get("result").get("capabilities"), arena)

    // **A document that fails to parse is coloured as far as it parsed.** The editor reads it a
    // second time ("Only the editor's parse recovers from a syntax error" in
    // `ksplc/docs/DESIGN-tools.md`) and colours the valid declarations around it.
    // Caution: **The skipped text is still not coloured**, and nothing is guessed
    // (`lsp/semtok.kspl`'s header). The probe's `fn main` is valid and its `var x = 1;` is not, so
    // the answer is one token.
    bad: = lsp_client.answer(c@, "textDocument/semanticTokens/full",
        lsp_client.at_doc(PROBE_URI, arena), lsp_client.READ_MS, arena)
    bad_toks: = read_tokens(bad.get("result").get("data"), types_n, arena)
    verdict.check("a source that does not pass is coloured as far as it parsed",
        !is_missing(bad.get("result")) && bad_toks.count == 1 && !bad_toks.over && !bad_toks.back,
        lsp_client.dump(bad, arena))

    check_wide_range(c@, arena)

    ch_text: = io.read_file(CH_FILE, null) catch
        return harness.fatal("the call hierarchy's starting point cannot be read")
    prep: = prepare_fn(c@, CH_FILE, ch_text, CH_DECL, arena)
    d16: = lsp_client.why(c@, prep.raw, arena)
    verdict.check("prepareCallHierarchy returns one function", prep.found, d16)
    if prep.found
        calls: = incoming(c@, prep.item, arena).calls
        // An array rather than null is the point: a crashed worker makes the supervisor return
        // null.
        d17: = lsp_client.why(c@, "", arena)
        verdict.check("incomingCalls returns the callers (the whole workspace)", calls.len > 0, d17)
    lsp_client.close(c@, CH_FILE, arena)
    check_generic_caller(exe, arena)
    lsp_recover.check_template_bound(c@, arena)
    check_shebang(c@, top, arena)
    check_ragged_reaches(c@, arena)
    lsp_spell.check_hover_types(c@, arena)
    lsp_spell.check_hover_away(c@, arena)
    lsp_spell.check_hover_prelude(c@, arena)
    lsp_spell.check_hover_self_param(c@, arena)
    lsp_spell.check_hover_receiver(c@, arena)
    lsp_spell.check_hover_label(c@, arena)
    lsp_spell.check_hover_generic_body(c@, arena)
    lsp_spell.check_hover_default_arg(c@, arena)
    lsp_spell.check_hover_owner(c@, arena)
    lsp_hover.check_hover_marks(c@, arena)
    lsp_hover.check_hover_values(c@, arena)
    lsp_spell.check_uri_spelling(c@, top, arena)
    check_hover_builtin_member(c@, arena)
    check_variant_through_alias(c@, arena)
    lsp_hover.run_docs(c@, arena)
    lsp_recover.run_recover(c@, arena)

    c.notify("$/ksplTestCrash", lsp_client.empty_obj(arena), lsp_client.SEND_MS, arena) catch {}
    after_crash: = lsp_client.answer(c@, "textDocument/hover", probe_pos, lsp_client.READ_MS, arena)
    d19: = lsp_client.why(c@, "", arena)
    verdict.check("the crash hook ends the worker", gave_up(c@, CRASH_LOG, arena), d19)
    verdict.check("a recovery has only the probe to restore",
        gave_up(c@, RESTORES_PROBE, arena), d19)
    ok2: = !is_missing(after_crash)
    verdict.check("hover answers after a crash too (the supervisor remakes the worker)", ok2, d19)

    c.notify("$/ksplTestHang", lsp_client.empty_obj(arena), lsp_client.SEND_MS, arena) catch {}
    after_hang: = lsp_client.answer(c@, "textDocument/hover", probe_pos, AFTER_HANG_MS, arena)
    d20: = lsp_client.why(c@, "", arena)
    verdict.check("the hang hook trips the watchdog", gave_up(c@, HANG_LOG, arena), d20)
    ok1: = !is_missing(after_hang)
    verdict.check("hover answers after a hang too (the watchdog brings it back)", ok1, d20)

    check_cfg(c@, exe, arena)
    check_didclose(exe, arena)
    lsp_recover.run_empty(exe, arena)
    lsp_recover.run_restart(exe, arena)
    check_worker_alive(exe, top, ch_text, arena)
    check_walk(exe, arena)
    lsp_rename.run_rename(exe, init.val.get("result").get("capabilities"), arena)
    check_cfg_after_walk(exe, arena)
    lsp_recover.run_package(exe, arena)
    lsp_pick.check_completion(c@, arena)
    lsp_pick.check_completion_generic(c@, arena)
    return harness.finish()

//< ksplc's tests, run as a program of their own (`make test` in this package's folder)
//< **This is the only way to run ksplc's tests on their own.** `all.kspl`'s suite runs them; this
//< file only gives them a `main`, so a copy of the package with nothing around it can run them.
import "ksplc/tests/all"
import "std/io"
import "std/mem" { Arena }
import "std/verdict"

fn main(): I32 //< the exit code is the checks' verdict (`verdict.finish`)
    // Line by line, so a run that crashes shows how far it got.
    io.set_line_buffered()
    defer arena: = Arena.new(1024 * 1024)
    all.run_ksplc(arena)
    return verdict.finish()

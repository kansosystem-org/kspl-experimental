//< Which node kinds and which token spellings the printer treats alike
//<
//< `rules` sorts the node kinds (a block, a bracketed container, a list, a statement or a
//< declaration). The checks on `U8[]` sort a token's spelling (an operator, a bracket, a keyword
//< that needs a space after it).
import "ksplc/base/ast_kinds" as base_ast_kinds
import "ksplc/base/core" as base_core
import "std/str" // `equals`

priv const F_FLAG_BLOCK_KIND: I32 = 1
priv const F_FLAG_BRACE_CONTAINER: I32 = 2
priv const F_FLAG_LIST_KIND: I32 = 4
priv const F_FLAG_STMT_OR_DECL: I32 = 8

struct Fmt_rules
    flags: I32[base_core.MAX_AST_KINDS]
    is_init: Bool

$rules: Fmt_rules = ::{}

impl Fmt_rules
    priv fn set_flag(r: Self$@, kind_id: base_ast_kinds.Ast_kind, flag: I32)
        if kind_id >= 0 && Sz::kind_id < r.flags.len
            r.flags[kind_id] = r.flags[kind_id] | flag

    fn init(r: Self$@)
        if r.is_init
            return
        r.is_init = true

        for i in Range.asc(r.flags.len)
            r.flags[i] = 0

        r.set_flag(.k_stmt_block, F_FLAG_BLOCK_KIND)
        r.set_flag(.k_stmt_labeled_block, F_FLAG_BLOCK_KIND | F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_struct, F_FLAG_BLOCK_KIND | F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_enum, F_FLAG_BLOCK_KIND | F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_trait, F_FLAG_BLOCK_KIND | F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_impl, F_FLAG_BLOCK_KIND | F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_stmt_switch, F_FLAG_BLOCK_KIND)
        r.set_flag(.k_decl_extern_block, F_FLAG_BLOCK_KIND | F_FLAG_STMT_OR_DECL)

        r.set_flag(.k_expr_compound, F_FLAG_BRACE_CONTAINER)
        r.set_flag(.k_struct_literal, F_FLAG_BRACE_CONTAINER)
        r.set_flag(.k_type_fn_sig, F_FLAG_BRACE_CONTAINER)
        r.set_flag(.k_type_args, F_FLAG_BRACE_CONTAINER)
        r.set_flag(.k_type_gen_params, F_FLAG_BRACE_CONTAINER)
        r.set_flag(.k_decl_import, F_FLAG_BRACE_CONTAINER | F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_expr_postfix, F_FLAG_BRACE_CONTAINER)
        r.set_flag(.k_type_postfix, F_FLAG_BRACE_CONTAINER)
        r.set_flag(.k_enum_variant, F_FLAG_BRACE_CONTAINER | F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_string_expr, F_FLAG_BRACE_CONTAINER)

        r.set_flag(.k_expr_args, F_FLAG_LIST_KIND)
        r.set_flag(.k_param_list, F_FLAG_LIST_KIND)
        r.set_flag(.k_identifier_list, F_FLAG_LIST_KIND)
        r.set_flag(.k_enum_payload, F_FLAG_LIST_KIND)
        r.set_flag(.k_enum_field, F_FLAG_LIST_KIND)
        // An attribute list (`#a #b`) has no commas, so no f_flag_list_kind: the comma rule would
        // cut into it.

        r.set_flag(.k_stmt, F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_top_level_item, F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_top, F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_extern, F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_fn, F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_const, F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_typedef, F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_decl_var, F_FLAG_STMT_OR_DECL)
        r.set_flag(.k_struct_field, F_FLAG_STMT_OR_DECL)

    priv fn has_flag(r: Self$@, kind_id: I32, flag: I32): Bool
        return kind_id >= 0 && kind_id < r.flags.len && (r.flags[kind_id] & flag) != 0
    fn is_block(r: Self$@, kind_id: I32): Bool
        return r.has_flag(kind_id, F_FLAG_BLOCK_KIND)
    fn is_brace_container(r: Self$@, kind_id: I32): Bool
        return r.has_flag(kind_id, F_FLAG_BRACE_CONTAINER)
    fn is_list(r: Self$@, kind_id: I32): Bool
        return r.has_flag(kind_id, F_FLAG_LIST_KIND)
    fn is_stmt_or_decl(r: Self$@, kind_id: I32): Bool
        return r.has_flag(kind_id, F_FLAG_STMT_OR_DECL)

impl U8[]
    fn is_space_required_keyword(r: Self): Bool
        return r.equals("return") || r.equals("throw") || r.equals("fallback") ||
            r.equals("case") || r.equals("default") || r.equals("else") || r.equals("switch") ||
            r.equals("catch") || r.equals("as") || r.equals("import") || r.equals("embed") ||
            r.equals("extern") || r.equals("impl") || r.equals("trait") || r.equals("if") ||
            r.equals("for") || r.equals("defer")

    fn is_op(r: Self): Bool
        return r.equals("=") || r.equals("==") || r.equals("!=") || r.equals("<=") ||
            r.equals(">=") || r.equals("<") || r.equals(">") || r.equals("+") || r.equals("-") ||
            r.equals("*") || r.equals("/") || r.equals("%") || r.equals("&&") || r.equals("||") ||
            r.equals("!") || r.equals("~") || r.equals("+=") || r.equals("-=") ||
            r.equals("*=") || r.equals("/=") || r.equals("%=") || r.equals("<<=") ||
            r.equals(">>=") || r.equals("&=") || r.equals("|=") || r.equals("^=") ||
            r.equals("|") || r.equals("&") || r.equals("^") || r.equals("<<") || r.equals(">>") ||
            r.equals("catch") || r.equals("::") || r.equals("assign_op") || r.equals(":") ||
            r.equals("->")

    fn is_unary_prefix(r: Self): Bool
        return r.equals("!") || r.equals("~")

    fn is_closing_bracket(r: Self): Bool
        return r.equals(")") || r.equals("]") || r.equals("}") || r.equals("|>")
    fn is_compound_sigil(r: Self): Bool //<
        //< A compound literal's opening sigil, `::{`
        return r.equals("::{")

    fn is_opening_bracket(r: Self): Bool
        return r.equals("(") || r.equals("[") || r.equals("{") || r.is_compound_sigil() ||
            r.equals("<|")

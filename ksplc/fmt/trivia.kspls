//< What the formatter does with what stands between two tokens: comments and blank lines
//<
//< **`printer.kspls` writes the tokens; this file handles what lies between them.** A comment keeps
//< the line and level it was written on, a blank line the author placed stays as one, and a `//<`
//< too long for its line moves its text to the line below.
import "ksplc/base/lines" { line_end, opens_its_line }
import "ksplc/fmt/printer" { Formatter }
import "ksplc/fmt/source" as fmt_source
import "std/chars"
import "std/str" { Str_builder }

impl Formatter
  fn pull_trailing_comment(r: Self$@, open_offset: Sz, close_offset: Sz) //<
    //< The comment after an inserted `}` belongs to the line before it
    //<
    //< The conversion to braces moves no line or column, so where a block's last line ends in a
    //< comment, the only place left for the `}` is after it.
    //< Caution: **Only for an inserted `}`.** An inserted `}` lands after a line's code, so a `}`
    //< that starts its line was typed (a value's, or a block's the notation keeps), and the comment
    //< after it stays as written. In the brace notation the author placed everything.
    if !r.from_layout || opens_its_line(r.src, close_offset)
      return
    // Caution: **Skip the inserted marks** (`fmt_source.past_mended_marks`). Stop at the first of a
    // run of `}` and `;` and the comment goes to the outermost close, landing on a `}` line rather
    // than on the line whose code it describes.
    after: = fmt_source.past_mended_marks(r.src, close_offset)
    if r.last_offset <= close_offset && after + 1 < r.src.len && (r.src.ptr + after)$ == '/' &&
      (r.src.ptr + after + 1)$ == '/'
      r.write_one_comment(after)
    r.pull_tail_comment_lines(open_offset, close_offset, after)

  priv fn pull_tail_comment_lines(r: Self$@, open_offset: Sz, close_offset: Sz, after: Sz) //<
    //< It writes the comment lines below the inserted `}`, still inside its block
    //<
    //< `merge` in `../parse/layout.kspls` walks only code lines, so the `}` lands above them.
    //< Caution: **Skip past the inserted marks, then let the ordinary trivia code write the
    //< lines.** Only that code keeps the author's blank lines; a second copy here would break
    //< Principle 6 in `../../docs/DESIGN.md`.
    // **A container that closes on anything but `}` has no recorded opening** (`scan_body` notes
    // only `{` and a compound sigil): a `)` arrives with 0, which would read from the file's start.
    if open_offset == 0 || open_offset >= close_offset
      return
    body: = fmt_source.body_indent_after(r.src, open_offset, close_offset)
    end: = fmt_source.tail_comment_end(r.src, close_offset, after, body)
    if end == 0
      return
    // The level is still the block's inner one — the caller lowers it once this returns.
    r.seek_to(after)
    r.catch_up_trivia(end, false)

  fn note_displaced(r: Self$@, close_offset: Sz) //<
    //< It records a line comment the author put after a `}` this printing leaves out
    //<
    //< **The mirror of `pull_trailing_comment`**: here the author typed the `}`, and the comment
    //< after it loses its line in a round trip through the indentation notation.
    if r.from_layout
      return
    // **A `;` after the `}` goes with it**: the notation leaves that terminator out as well.
    $at: = close_offset + 1
    for at < r.src.len &&
      ((r.src.ptr + at)$ == ' ' || (r.src.ptr + at)$ == '\t' || (r.src.ptr + at)$ == ';')
      at += 1
    if at + 1 < r.src.len && (r.src.ptr + at)$ == '/' && (r.src.ptr + at + 1)$ == '/'
      r.displaced.push(at)

  priv fn write_one_comment(r: Self$@, at: Sz) //<
    //< It writes one line comment, from `at` to the line's end
    //<
    //< It moves the position past the comment, so the comment is not written twice.
    e: = line_end(r.src, at)
    r.write_space()
    r.write_raw(U8[]::{ .ptr = r.src.ptr + at, .len = e - at })
    r.write_nl()
    r.seek_to(e)

  fn write_blank_line(r: Self$@) //< it outputs one blank line
    //<
    //< Partway through a line it ends the line first.
    r.write_nl()
    r.out.c('\n')
    r.flags.is_line_start = true
    r.current_col = 0
    r.last_char = '\n'
    r.flags.wrap_indent = false
    // The run of `//<` is contiguous, so the blank line closes it.
    r.summary_run_open = false

  fn blank_groups_nothing(r: Self$@, next_char: U8): Bool //<
    //< Whether a blank line touches a block's edge
    //<
    //< That is right after the `{` or right before the `}`. With nothing on one side, it separates
    //< no groups.
    //< Caution: **Do not drop the blank line on the line *after* a `}`.** It is the author's
    //< paragraph break, the last way of grouping that the formatter leaves.
    return r.last_char == '{' || next_char == '}'

  fn write_pre_comment_sep(r: Self$@, new_lines: Sz, is_suppressed: Bool) //<
    //< It chooses and writes the separator before a comment
    //<
    //< That is a kept blank line, a kept newline, or plain whitespace. A blank line before the
    //< comment (new_lines > 1) is kept as one; the next character is not known yet, so only the
    //< block's start is checked.
    // **A pending newline wins over the suppression**, and its flag is cleared once written. A
    // comment on the token's line (new_lines == 0) trails and stays.
    if r.flags.force_next_nl && new_lines > 0
      // Caution: **Keep the blank line the author placed**, or the heading of a second import group
      // joins the group above.
      if new_lines > 1 && !r.blank_groups_nothing(0)
        r.write_blank_line()
      else
        r.write_nl()
      // Caution: **Ask whether the line continues; do not just clear the flag.** A comment among a
      // bracket's wrapped elements takes their indent; at column 0 the indentation notation reads a
      // new top-level item and inserts a `{` where the element was.
      r.flags.wrap_indent = r.in_continuation()
      r.flags.force_next_nl = false
      return
    if new_lines > 1 && !is_suppressed && !r.blank_groups_nothing(0)
      r.write_blank_line()
    else if new_lines > 0 && !is_suppressed
      r.write_nl()
    else if !r.flags.is_line_start
      r.write_space()

  priv fn carries_summary_down(r: Self$@, text: U8[], trailing: Bool): Bool //<
    //< Whether a trailing `//<` should move its text to the line below
    //<
    //< The rule for a description too long for its line ("The documentation a declaration carries"
    //< in `../../docs/DESIGN.md`): the width decides.
    //< Caution: **Only on the line where the declaration opens.** A mark after a return type, on
    //< the line where a wrapped heading closes, describes the return; moved down it would read as
    //< the declaration's own (`mark_offset` in `../base/ast_doc.kspls`). `line_wrapped` tells them
    //< apart.
    if !trailing || r.flags.is_line_start || !text.starts_with("//<")
      return false
    if text.sub_from(3).trim_spaces().len == 0
      return false
    if r.line_wrapped
      return false
    return r.current_col + r.line_dropped + text.len > r.config.column_limit

  priv fn write_summary_below(r: Self$@, text: U8[]) //<
    //< It leaves the mark on the line and writes its text on the line below, one step in
    //<
    //< The mark is written trailing, so `track_summary_run` opens the run here and `indent_for`
    //< takes the column from it — the same column a hand-written continuation uses.
    r.write_raw("//<")
    r.write_nl()
    $line: = Str_builder.new()
    defer line.free()
    line.s("//< ").s(text.sub_from(3).trim_spaces())
    r.write_raw(line.slice())

  fn catch_up_trivia(r: Self$@, target_offset: Sz, force_no_nl: Bool)
    if target_offset <= r.last_offset
      return

    $i: = r.last_offset
    $end: = target_offset
    if end > r.src.len
      end = r.src.len

    $new_lines: Sz = 0
    is_suppressed: = r.suppress_nl_depth > 0 || force_no_nl

    for i < end
      c: = (r.src.ptr + i)$
      if c == '\n'
        new_lines += 1
        i += 1
      else if c == ' ' || c == '\t' || c == '\r'
        i += 1
      else if c == '/' && i + 1 < end
        nc: = (r.src.ptr + i + 1)$
        if nc == '/'
          r.write_pre_comment_sep(new_lines, is_suppressed)

          c_start: = i
          for i < end && (r.src.ptr + i)$ != '\n'
            i += 1
          comment_slice: = U8[]::{ .ptr = r.src.ptr + c_start, .len = i - c_start }
          if r.carries_summary_down(comment_slice, new_lines == 0)
            r.write_summary_below(comment_slice)
          else
            r.write_raw(comment_slice)
          new_lines = 0
          r.write_nl()
        else
          i += 1
      else
        break

    next_char: U8 = (r.src.ptr + i)$ if i < r.src.len else 0
    // No whitespace from trivia goes before a '.' (calc_spacing_requirement adds it for
    // 'return .Ok'). An empty block gets none even with the newline folded, or two passes give
    // `{ }` then `{}` and fmt is not idempotent.
    no_space_before: =
      (next_char == ')' || next_char == ']' || next_char == '>' || next_char == ',' ||
      next_char == ';' || next_char == '.') || (next_char == '}' && r.last_char == '{')
    no_space_after: = (r.last_char == '(' || r.last_char == '[' || r.last_char == '<')

    // `end_with_one_nl` ends the file (doing it here as well would double the newline).
    if new_lines > 1
      if !is_suppressed && r.blank_groups_nothing(next_char)
        // A blank line that separates nothing is dropped; only the line is ended (or the `}` moves
        // up).
        r.write_nl()
      else if !is_suppressed
        r.write_blank_line()
      else if !r.flags.is_line_start && !no_space_after && !no_space_before
        r.write_space()
    else if new_lines == 1
      if !is_suppressed && !r.flags.is_line_start && !r.flags.force_next_nl && !no_space_after &&
        !no_space_before
        r.write_space()
      else if is_suppressed && !r.flags.is_line_start && !no_space_after && !no_space_before
        r.write_space()

    r.seek_to(target_offset)

//< The printer: it walks the tree and writes each token out
//<
//< It moves forward through the original text only, never back.
//<
//< **This file decides, token by token, where a line breaks and how far it is indented**; what
//< stands between two tokens (comments, blank lines) belongs to `trivia.kspls`, and the checks
//< that read no printer state (a space, a wrap) to `space.kspls`. `text.kspls` is the entry point.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_doc" { is_continuation_line }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/lines" { line_start, skip_blanks }
import "ksplc/fmt/kinds" as fmt_kinds
import "ksplc/fmt/measure" as fmt_measure
import "ksplc/fmt/source" as fmt_source
import "ksplc/fmt/space" { Fmt_flags, calc_spacing_requirement, check_line_wrap, join_string_lines,
  string_piece_end }
import "ksplc/fmt/style" { Config }
import "ksplc/fmt/trivia" as fmt_trivia
import "ksplc/parse/line_cont" { breaks_off_a_value, ends_in_catch, takes_value_on_its_line }
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }

fn init()
  fmt_kinds.rules.init()

struct Formatter
  out: Str_builder
  config: Config
  indent_level: Sz
  current_col: Sz
  src: U8[]
  last_offset: Sz
  last_char: U8
  last_text: Str_builder
  code_end: Sz //<
    //< How far into `out` the code on the line being written reaches
    //<
    //< `out` can end in a trailing comment, and `line_continues` in `../parse/line_cont.kspls`
    //< needs the code alone. Only `set_last_text` moves it.
  suppress_nl_depth: Sz
  pending_seg_len: Sz
  pending_dot_break_ok: Bool //<
    //< Whether the `.` of pending_seg_len's chain may be a wrapping point
    //<
    //< It may in a true chain, and in a call with no `,` to break at instead.
  from_layout: Bool //<
    //< Whether the source read was the indentation notation (`.kspls`)
    //<
    //< In that notation `../parse/layout.kspls` inserts every `{` `}` `;`, and
    //< `pull_trailing_comment` uses this to recognize an inserted mark.
  layout: Bool //<
    //< Whether to print in the indentation notation (`.kspls`)
    //<
    //< **Only the spelling changes**: the tree and the decisions are the same, and a block's
    //< braces and a statement's terminator are not written (the heading of `ksplc/kspl.kspeg`).
  paren_depth: Sz //<
    //< The depth of the round and square brackets
    //<
    //< Caution: **Do not remove braces inside a bracket** — a newline there does not become a
    //< level, so removing them cannot be undone (the continuation rules in
    //< `../parse/layout.kspls`).
  paren_indent_level: Sz //<
    //< The indent level held when the outermost bracket opened
    //<
    //< **A newline inside a bracket keeps the wrapping indent only while this is unchanged.** A
    //< block opened inside (a closure body) indents by its level, and the wrapping indent on top
    //< pushes it one step too far.
  line_indent: Sz //<
    //< The column the line now being written starts at
    //<
    //< A trailing comment reads it to find where its line began.
  line_wrapped: Bool //<
    //< Whether the line now being written opened as a wrapping continuation
    //<
    //< **The level can change after the line opens** (a declaration opening a block), so
    //< `line_indent` cannot tell. The code that moves a long trailing `//<` to the next line reads
    //< it: it may do so only on a line that opens the declaration.
  line_dropped: Sz //<
    //< How many columns the marks hidden on this line would have taken in the brace notation
    //<
    //< **The two notations are one program, so the shape must not depend on which one is written.**
    //< Leaving a `{` off makes a line two columns narrower, so a description could fit in one
    //< notation and not the other, and a round trip would not return the same text.
  summary_cont_col: Sz //<
    //< Where a `//<` continuing the open run is written
    //<
    //< It is one step in from the line that opened the run. **`summary_run_open` says whether a
    //< run is open** — 0 is a real column (a run opened at the top level), so it cannot mean
    //< "none".
  summary_run_open: Bool
  flags: Fmt_flags
  ternary_depth: Sz //<
    //< The bracket depth at which the conditional value now being watched opened, or -1
    //<
    //< **Only a value standing outside every bracket is watched.** Inside one a line may break
    //< anywhere, so a split there needs nothing more.
  ternary_broke: Bool //< whether a line broke inside that value, at its own depth
  bare_close: Sz //<
    //< The `}` of the block now written on one line in the indentation notation, or -1
    //<
    //< **Its last `;` is left out**, which the indentation reader puts back (`supply_block_end` in
    //< `../parse/layout.kspls`); a `;` between two statements stays.
  paren_spans: List<|Sz|> //<
    //< The start and end of each conditional value split outside every bracket, in pairs
    //<
    //< **The formatter only rearranges the tokens it was given**, so the parentheses such a value
    //< needs go into the text and it is formatted again (`with_parens` below), as the imports'
    //< reordering does.
  displaced: List<|Sz|> //<
    //< The start of each line comment that follows a `}` this printing leaves out
    //<
    //< **The indentation notation writes no line for that `}`**, so the comment lands on another
    //< line and a round trip does not bring it back (`note_displaced` in `trivia.kspls`; the
    //< lint reports each one as `[I0805]`).
  too_deep: Bool //<
    //< Set when format_internal's recursion goes past max_fmt_depth below
    //<
    //< **The caller checks it before writing back (--in-place)**, or the source file is
    //< overwritten with output cut off partway.

priv const max_fmt_depth: Sz = 2000 //<
  //< The depth format_internal stops at
  //<
  //< It is a safety valve that needs no grammar or parser change. format_internal recurses once
  //< per tree level, and max_parse_depth (kspeg/rule.kspls) already bounds the trees that reach it.

priv struct Body_scan //< the children of a node, counted in one pass
  //<
  //< `body_count` is the number of real members **after** the opening brace. The braces' positions
  //< let `has_comment_in` look in the original for a comment inside. **A compound literal's sigil
  //< counts as the opening brace** (`::{` / `.{`).
  content_count: Sz
  body_count: Sz
  body_inner: Ast_node$@
  open_brace_off: Sz
  close_brace_off: Sz

priv fn brace_span_ok(body: Body_scan): Bool //<
  //< Whether the braces scanned really enclose a range (both found, and in order)
  return body.open_brace_off > 0 && body.close_brace_off > body.open_brace_off

priv fn scan_body(node: Ast_node$@): Body_scan
  $out: = Body_scan::{ .content_count = 0, .body_count = 0, .body_inner = null, .open_brace_off = 0,
    .close_brace_off = 0 }
  $seen_open_brace: = false
  for ch in node.children
    if ch.is_literal("{") || ch.text.is_compound_sigil()
      seen_open_brace = true
      out.open_brace_off = ch.loc.offset
    if ch.is_literal("}")
      out.close_brace_off = ch.loc.offset
    if ch.kind_id != .k_literal && ch.kind_id != .k_empty && ch.kind_id != .k_underscore
      out.content_count += 1
      if seen_open_brace
        out.body_count += 1
        if out.body_inner == null
          out.body_inner = ch
  return out

// ---------------------------------------------------------
// Formatter Implementation
// ---------------------------------------------------------

impl Formatter
  fn new(config: Config, src: U8[], layout: Bool, from_layout: Bool): Formatter
    return Formatter::{ .out = Str_builder.new(), .config = config, .indent_level = 0,
      .current_col = 0, .src = src, .last_offset = 0, .last_char = '\n',
      .last_text = Str_builder.new(), .code_end = 0, .suppress_nl_depth = 0, .pending_seg_len = 0,
      .pending_dot_break_ok = false, .too_deep = false, .from_layout = from_layout,
      .layout = layout, .paren_depth = 0, .paren_indent_level = 0, .line_indent = 0,
      .line_wrapped = false, .line_dropped = 0, .summary_cont_col = 0, .summary_run_open = false,
      .ternary_depth = -1, .ternary_broke = false, .bare_close = -1,
      .paren_spans = List<|Sz|>.new(), .displaced = List<|Sz|>.new(),
      .flags = Fmt_flags::{
      .is_line_start = true,
      .wrap_indent = false,
      .last_was_unary_minus = false,
      .force_next_nl = false,
      .last_was_no_space = false,
      .in_type_expr = false,
    } }

  fn free(r: Self$@)
    r.out.free()
    r.last_text.free()
    r.paren_spans.free()
    r.displaced.free()

  fn in_continuation(r: Self$@): Bool //<
    //< Whether the line being written carries on, so its wrapping indent is kept
    //<
    //< Caution: **Keep the wrapping indent where the line carries on.** Dropping it puts the next
    //< token at column 0, where the indentation notation starts a new declaration (for example, a
    //< value that starts below its `=`).
    //< A line carries on in two cases: inside a bracket, and after a mark that breaks a value off
    //< (`breaks_off_a_value` in `../parse/line_cont.kspls`).
    if r.paren_depth > 0 && r.indent_level == r.paren_indent_level
      return true
    // **Only where a comment ended the line.** A line the formatter broke itself, or one broken
    // between a level's items (`::{ … }`'s), already takes its indent from that level, and true
    // there would push every such item one step further in.
    line: = r.out.slice()
    if r.code_end > line.len || !r.comment_trails(line)
      return false
    // Read the line's code, not its last token: whether a `:` marks a label or a heading depends
    // on what stands before it on the line.
    b: = line_start(line, r.code_end)
    return breaks_off_a_value(line.sub(b, r.code_end - b).trim_spaces())

  priv fn comment_trails(r: Self$@, line: U8[]): Bool //<
    //< Whether what follows the line's code, apart from blanks, is a comment
    i: = skip_blanks(line, r.code_end)
    return i + 1 < line.len && line[i] == '/' && line[i + 1] == '/'

  fn write_nl(r: Self$@)
    r.flags.wrap_indent = r.in_continuation()
    if !r.flags.is_line_start
      if r.ternary_depth >= 0 && r.paren_depth == r.ternary_depth
        r.ternary_broke = true
      for r.out.len > 0 && (r.out.ptr + r.out.len - 1)$ == ' '
        r.out.len -= 1
        r.current_col -= 1
      r.out.c('\n')
      r.flags.is_line_start = true
      r.current_col = 0
      r.last_char = '\n'

  fn skip_token(r: Self$@, node: Ast_node$@) //<
    //< It advances the position without writing, for a mark the notation leaves out
    //<
    //< Caution: **Advance the position** — otherwise the code that collects comments later
    //< (`catch_up_trivia`) counts again from before that mark.
    // **A `{` takes a space in front of it and a `;` does not**, which is the width the brace
    // notation would have used on this line (`line_dropped`).
    r.line_dropped += 2 if node.is_literal("{") else node.text.len
    r.seek_to(node.loc.offset + node.text.len)

  fn seek_to(r: Self$@, at: Sz) //< it moves the reading position forward, never back
    //<
    //< `pull_trailing_comment` writes a comment before the token it follows, and a plain
    //< assignment would move the position back so that comment is written twice.
    if at > r.last_offset
      r.last_offset = at

  fn write_space(r: Self$@)
    if !r.flags.is_line_start && r.last_char != ' ' && r.last_char != '\n'
      r.out.c(' ')
      r.current_col += 1
      r.last_char = ' '
  fn end_with_one_nl(r: Self$@) //< it closes the output with exactly one newline
    //<
    //< **This is the one place that decides how the file ends.** Line-based tools expect each line
    //< to end with a newline (`wc -l` counts one line fewer without it).
    for r.out.len > 0 && (r.out.ptr + r.out.len - 1)$ == '\n'
      r.out.len -= 1
    r.out.c('\n')
  fn calc_will_break(r: Self$@, last_txt: U8[], text: U8[], require_space: Bool, text_len: Sz,
    dot_break_ok: Bool): Bool //<
      //< The wrapping decision shared by write_token and format_internal (a string token)
    if r.flags.is_line_start
      return false
    space_len: Sz = 1 if require_space else 0
    return check_line_wrap(last_txt, text, require_space, r.current_col, space_len, text_len,
      r.config.column_limit, dot_break_ok, r.ends_open_catch())

  priv fn ends_open_catch(r: Self$@): Bool //<
    //< Whether what stands on this line so far ends in `catch` or `catch <name>`
    //<
    //< It reads the output back with the reader's own check (`ends_in_catch` in
    //< `../parse/line_cont.kspls`): the last token alone does not show the pair. It skips only
    //< blanks, so it never reads the line above.
    return ends_in_catch(r.out.slice())

  fn set_last_text(r: Self$@, content: U8[]) //<
    //< It replaces last_text with content and moves `code_end` to the output's end
    r.last_text.free()
    r.last_text = Str_builder.new()
    r.last_text.s(content)
    r.code_end = r.out.len

  priv fn indent_for(r: Self$@, text: U8[]): Sz //<
    //< The column a line opening with `text` is written at
    //<
    //< **A `//<` continuing the run above it goes one step in from the line that opened the run**,
    //< so it reads as part of that declaration rather than as a block beside it. After an opener
    //< ending in `{` that is the body's own indent, so the shape holds with or without contents.
    if r.summary_run_open && is_continuation_line(text, 0)
      return r.summary_cont_col
    $spaces: = r.indent_level * r.config.indent_width
    if r.flags.wrap_indent
      spaces += r.config.indent_width
    return spaces

  priv fn track_summary_run(r: Self$@, text: U8[], at_line_start: Bool) //<
    //< It tracks the open `//<` run as lines are written
    //<
    //< A run opens on a trailing `//<` and closes on anything else written: the
    //< contiguous run `../base/ast_doc.kspls` reads (a lone continuation, `[W0209]`, opens none).
    if !is_continuation_line(text, 0)
      r.summary_run_open = false
      return
    if !at_line_start
      r.summary_cont_col = r.line_indent + r.config.indent_width
      r.summary_run_open = true

  priv fn write_indent_at(r: Self$@, col: Sz) //<
    //< It writes an indent of `col` spaces on a line just started
    //<
    //< It is `write_raw`'s line start, for the one caller that sets the column itself.
    for _i in Range.asc(col)
      r.out.c(' ')
    r.flags.is_line_start = false
    r.current_col = col
    r.line_indent = col
    r.line_wrapped = true
    r.line_dropped = 0
    r.last_char = ' '

  fn write_carried_string(r: Self$@, text: U8[]) //<
    //< It writes a joined literal, carrying it onto the next line where it does not fit
    //<
    //< The `\` after each piece stands for no byte, and a carried piece is indented one step from
    //< the opening line, as a `//<` run is ("Escape sequences" in `../../docs/SPEC-language.md`).
    //< Caution: **Measure each piece from the column it starts at.** Measured from the first, a
    //< continuation comes out short by that indent and formatting never reaches a fixed point.
    open_col: = r.indent_for(text) if r.flags.is_line_start else r.line_indent
    cont_col: = open_col + r.config.indent_width
    $from: Sz = 0
    for from < text.len
      col: = open_col if from == 0 && r.flags.is_line_start else r.current_col
      end: = string_piece_end(text, from, r.config.column_limit - col)
      if end >= text.len || end <= from
        r.write_raw(text.sub_from(from))
        return
      r.write_raw(text.sub(from, end - from))
      r.write_raw("\\")
      r.write_nl()
      r.write_indent_at(cont_col)
      from = end

  fn write_raw(r: Self$@, text: U8[])
    if text.len == 0
      return

    at_line_start: = r.flags.is_line_start
    if at_line_start
      spaces: = r.indent_for(text)
      for _i in Range.asc(spaces)
        r.out.c(' ')
      r.flags.is_line_start = false
      r.current_col = spaces
      r.line_indent = spaces
      r.line_wrapped = r.flags.wrap_indent
      r.line_dropped = 0
    r.track_summary_run(text, at_line_start)

    r.out.s(text)
    r.current_col += text.len
    r.last_char = (text.ptr + text.len - 1)$

  fn write_token(r: Self$@, node: Ast_node$@, no_space_mode: Bool)
    if node.text.len == 0 || node.kind_id == .k_empty || node.kind_id == .k_underscore
      return

    $text: = node.text
    $advance_len: = text.len
    kind: = node.kind_id
    // The joined spelling of a string literal, held for as long as `text` points into it.
    $joined: = Str_builder.new()
    defer joined.free()
    $carry: = false
    if kind == .k_assign_op || (kind == .k_literal && node.text.equals("assign_op"))
      op_len: = node.get_assign_op_len(r.src)
      offset: = fmt_source.skip_space_from(r.src, node.loc.offset)
      if op_len > 0
        text = U8[]::{ .ptr = r.src.ptr + offset, .len = op_len }
        advance_len = (offset - node.loc.offset) + op_len
    else if kind == .k_string || kind == .k_string_interp || kind == .k_char
      span: = node.get_string_span(r.src)
      text = U8[]::{ .ptr = r.src.ptr + node.loc.offset, .len = span }
      advance_len = span
      // A literal is laid out from its joined spelling, so its place on the line decides where it
      // breaks, and formatting twice gives the same result.
      if kind != .k_char && join_string_lines(text, joined@)
        carry = true
        text = joined.slice()
    else
      text = text.trim_spaces()
      if text.len == 0
        r.seek_to(node.loc.offset + advance_len)
        return

    last_txt: = r.last_text.slice()
    // Caution: **Join `}` and `else` on one line only where nothing stands between them.** A
    // comment in between would move onto the `}` line, its later lines would break off at a level
    // of their own, and the `else` cannot follow on that line anyway.
    force_no_nl: =
      last_txt.equals("}") && follows_a_block(text) &&
      !fmt_source.has_comment_in(r.src, r.last_offset, node.loc.offset)
    r.catch_up_trivia(node.loc.offset, force_no_nl)

    // Caution: **Do not move the first `case` to the next line.** A `switch` has no braces, so that
    // would create a level where there are no braces, while the notation removes only blocks and
    // terminators ("The indentation notation (`.kspls`)" in `docs/DESIGN.md`). Each later `case`
    // already starts on a new line, where the preceding block closed.
    if r.flags.force_next_nl
      // **In the indentation notation it is not joined.** The `}` disappears, so joining would put
      // the `else` or `case` on the preceding block's last statement.
      is_continuation_kw: = !r.layout && follows_a_block(text)
      if !text.equals(";") && !text.equals(",") && !is_continuation_kw
        if !r.flags.is_line_start
          r.write_nl()
        // **Inside a bracket the indent is kept** (the reason is at `Formatter.in_continuation`).
        r.flags.wrap_indent = r.in_continuation()
      r.flags.force_next_nl = false

    if text.equals(";") || text.equals("{") || text.equals("}") || text.equals("]") ||
      text.equals(")")
      r.flags.wrap_indent = false

    $require_space: = calc_spacing_requirement(last_txt, text, r.flags, no_space_mode)
    // A `-` is unary where the preceding token is **a place where an expression begins**.
    // Caution: Do not list the preceding tokens one by one. A missed one is taken as binary and
    // printed `::{ - 1` / `else - 2`; the existing predicates keep up as brackets and keywords are
    // added.
    if text.equals("-")
      r.flags.last_was_unary_minus =
        last_txt.is_opening_bracket() || last_txt.is_space_required_keyword() ||
        last_txt.is_op() || last_txt.equals(",") || last_txt.equals(";")
    else
      r.flags.last_was_unary_minus = false
    // On a chain's `.`, wrapping is decided by the width of the whole .m(args) that follows
    // (pending_seg_len, set by format_internal); measured per token, a segment looks too short,
    // especially with a string argument.
    $text_len: = text.len
    $dot_break_ok: = false
    if text.equals(".") && r.pending_seg_len > 0
      text_len = r.pending_seg_len
      dot_break_ok = r.pending_dot_break_ok
    r.pending_seg_len = 0
    r.pending_dot_break_ok = false

    will_break: =
      !takes_value_on_its_line(last_txt) &&
      r.calc_will_break(last_txt, text, require_space, text_len, dot_break_ok)

    if will_break
      r.write_nl()
      // Caution: **In the indentation notation, an arm or an `else` after a `}` is not a
      // continuation.** Indented one step, `default` after `case .a {}` reads as a statement of the
      // block above and the file no longer parses.
      r.flags.wrap_indent = !(r.layout && last_txt.equals("}") && is_arm_or_else(text))
      require_space = false
    else if require_space && !r.flags.is_line_start
      r.write_space()

    if carry
      r.write_carried_string(text)
    else
      r.write_raw(text)
    r.seek_to(node.loc.offset + advance_len)
    r.set_last_text(text)
    r.flags.last_was_no_space = no_space_mode

  fn format(r: Self$@, node: Ast_node$@)
    r.format_internal(node, false, false, 0)

  priv fn break_before_choice(r: Self$@, node: Ast_node$@, i: Sz) //<
    //< It breaks before a conditional value's `if` / `else` (`i`) whose choice does not fit
    //<
    //< A choice runs from the keyword through the value after it, and for an `else` that opens a
    //< chain's next choice (`else b if d`) through that choice's condition too, so a chain breaks
    //< between its choices and never between an `if` and its condition.
    if r.flags.is_line_start
      return
    next: = node.get_child(i + 1)
    $seg: =
      node.get_child(i).calc_text_len(r.src) + 1 + next.calc_text_len(r.src)
    if node.get_child(i).is_keyword("else") && next.is_choice()
      seg =
        4 + 1 + next.get_child(0).calc_text_len(r.src) + 4 + next.get_child(2)
        .calc_text_len(r.src)
    if r.current_col + 1 + seg <= r.config.column_limit
      return
    r.write_nl()
    r.flags.wrap_indent = true

  priv fn writes_bare(r: Self$@, block: Ast_node$@, depth: Sz): Bool //<
    //< It writes a one-statement `defer` bare (`defer buf.free()`), and returns whether it did
    //<
    //< It does so where the block holds one expression statement and no comment.
    //<
    //< **One spelling for one cleanup.** The grammar accepts the statement bare or in a block
    //< (`stmt_defer` in `../kspl.kspeg`), so the formatter chooses for the one-statement case.
    body: = scan_body(block)
    if body.body_count != 1 || body.body_inner == null ||
      !body.body_inner.is_expr_statement() || !brace_span_ok(body) ||
      fmt_source.has_comment_in(r.src, body.open_brace_off, body.close_brace_off)
      return false
    r.seek_to(body.open_brace_off + 1)
    r.format_internal(body.body_inner, false, false, depth + 1)
    r.seek_to(body.close_brace_off + 1)
    return true

  fn wrap_before_next_element(r: Self$@, node: Ast_node$@, i: Sz, is_comma: Bool, is_assign: Bool) //<
    //< It breaks the line early where the next element does not fit on it
    //<
    //< It runs right after writing a separator (`,` / `=` / a logical operator / a return value's
    //< `:`). `i` is the position of that separator.
    //< Caution: **Do not wrap where the right side of an `=` is block-like or a dot chain.** Those
    //< break on their own, so a break before them leaves the `=` alone at a line's end.
    next_len: =
      (node.calc_next_element_len(i + 1, r.src) if is_comma
      else node.get_child(i + 1).calc_text_len(r.src))
    if r.current_col + 1 + next_len <= r.config.column_limit || r.flags.is_line_start
      return
    if is_assign
      peek_ch: = node.get_child(i + 1)
      if peek_ch.is_block_like() || peek_ch.has_dot_chain(r.src)
        return
    // Caution: **Do not break before a line comment the author put on this line.** The break moves
    // it down, so a `//<` no longer sits on the line it describes and is not read as its
    // documentation (`decl_summary` in `../base/ast_doc.kspls`); in the indentation notation it
    // separates the heading from its value and the file no longer parses.
    if fmt_source.has_comment_in(r.src, r.last_offset, node.get_child(i + 1).loc.offset)
      return
    r.write_nl()
    r.flags.wrap_indent = true

  fn format_internal(r: Self$@, node: Ast_node$@, no_space_mode: Bool,
    allow_single_line_block: Bool, depth: Sz)
    if node == null
      return
    if depth >= max_fmt_depth
      r.too_deep = true
      return
    // **A conditional value split outside every bracket is put in parentheses.** A line starting
    // with its `if` or `else` cannot be told apart from a statement's heading, and a newline inside
    // a bracket never starts one (`../parse/layout.kspls`). The split is read from what this pass
    // wrote, not guessed.
    if node.is_choice() && r.paren_depth == 0 && r.ternary_depth < 0
      r.ternary_depth = 0
      r.ternary_broke = false
      r.format_internal(node, no_space_mode, allow_single_line_block, depth + 1)
      if r.ternary_broke
        r.paren_spans.push(fmt_source.skip_space_from(r.src, node.loc.offset))
        r.paren_spans.push(node.source_end(r.src))
      r.ternary_depth = -1
      return

    if node.kind_id == .k_string_interp || node.kind_id == .k_string
      r.catch_up_trivia(node.loc.offset, true)
      // A whole string (its \{...\} interpolations included) is one token, so its leading space
      // and its wrapping are decided by calc_spacing_requirement / check_line_wrap, as for the
      // other leaves.
      span: = node.get_string_span(r.src)
      raw_text: = U8[]::{ .ptr = r.src.ptr + node.loc.offset, .len = span }
      // Laid out from its joined spelling, as in `write_token`.
      $joined: = Str_builder.new()
      defer joined.free()
      carry: = join_string_lines(raw_text, joined@)
      text: = joined.slice() if carry else raw_text
      last_txt: = r.last_text.slice()
      require_space: = calc_spacing_requirement(last_txt, text, r.flags, no_space_mode)

      will_break: =
        !takes_value_on_its_line(last_txt) &&
        r.calc_will_break(last_txt, text, require_space, text.len, false)
      if will_break
        r.write_nl()
        r.flags.wrap_indent = true
      else if require_space && !r.flags.is_line_start
        r.write_space()
      if carry
        r.write_carried_string(text)
      else
        r.write_raw(text)
      r.seek_to(node.loc.offset + span)

      r.set_last_text("\"")
      return

    kind_id: = node.kind_id
    len: = node.children.len
    $my_no_space: = no_space_mode

    if kind_id == .k_type_args || kind_id == .k_type_gen_params || kind_id == .k_type_postfix
      my_no_space = true

    was_in_type_expr: = r.flags.in_type_expr
    if kind_id == .k_type_expr
      r.flags.in_type_expr = true

    body: = scan_body(node)
    content_count: = body.content_count
    body_count: = body.body_count
    body_inner: = body.body_inner

    $is_extern: = false
    if kind_id == .k_top_level_item
      is_extern = node.has_literal_child("{")

    $force_multiline: = false
    $is_block: = fmt_kinds.rules.is_block(kind_id) || is_extern
    $is_brace_container: = false

    // Three ways fold a block onto one line: (1) an empty body folds to "{}".
    // Caution: **(1) and (3) both require no comment inside.** If folded, only the comment's first
    // line moves onto the `{` line and the rest splits across the brace (and loses a level of
    // indentation).
    // The split shape is **idempotent**, so `test-fmt-tree` does not catch it.
    has_inner_comment: = fmt_source.has_comment_in(r.src, body.open_brace_off,
      body.close_brace_off)
    if is_block
      force_multiline = true
      if body_count == 0 && !has_inner_comment
        is_block = false
        is_brace_container = true
        force_multiline = false
      else if kind_id == .k_stmt_block && body_count == 1
        is_short_ctrl: = body_inner.is_short_control_stmt()
        enable_single_line: =
          allow_single_line_block || (r.config.allow_short_blocks && is_short_ctrl)

        // A comment folded onto the `{` line could not return to the default spelling either.
        if enable_single_line && !has_inner_comment && !body_inner.contains_multiline_block()
          inner_len: = body_inner.calc_text_len(r.src)
          // +10 is the margin for what calc_text_len does not count ("{ " / " }", the separators).
          if r.current_col + inner_len + 10 <= r.config.column_limit
            is_block = false
            is_brace_container = true
            force_multiline = false
    else if fmt_kinds.rules.is_brace_container(kind_id)
      is_brace_container = true

    is_list: = fmt_kinds.rules.is_list(kind_id)
    if (is_list || is_brace_container) && !force_multiline
      // A trailing comma says "keep it multi-line": it is not folded even where it fits (as
      // rustfmt does).
      trailing_comma: = node.has_trailing_comma()
      if content_count > 0 && trailing_comma
        force_multiline = true
      // **A comment inside a brace container forces it multi-line too**, as a block's body does
      // (`has_inner_comment` above). **Braces only, not brackets**: on a call's argument list it
      // would break a method chain, moving each link's `)` to the start of the next line (`b.obj(`
      // / `).set(…`).
      if is_brace_container && brace_span_ok(body) &&
        fmt_source.has_comment_in(r.src, body.open_brace_off, body.close_brace_off)
        force_multiline = true

    $my_brace_suppress: = is_brace_container && !force_multiline
    my_list_suppress: = is_list && !force_multiline
    if my_list_suppress
      r.suppress_nl_depth += 1

    if len == 0 || kind_id == .k_identifier || kind_id == .k_keyword || kind_id == .k_literal ||
      kind_id == .k_primitive_type || kind_id == .k_string || kind_id == .k_char ||
      kind_id == .k_integer || kind_id == .k_float || kind_id == .k_bool || kind_id == .k_null
      r.write_token(node, my_no_space)
      return

    // Caution: **Read the setting at the `fn`.** The k_stmt_block inside does not know whose body
    // it is, so an `if`'s body would get the same handling (which is AllowShortBlocks' job).
    $pass_allow_single: = false
    if kind_id == .k_stmt_defer || (kind_id == .k_decl_fn && r.config.allow_short_functions)
      pass_allow_single = true
    was_bare_close: = r.bare_close
    if r.layout && my_brace_suppress && kind_id == .k_stmt_block && body_count == 1
      r.bare_close = body.close_brace_off

    for i in Range.asc(len)
      child: = node.get_child(i)
      c_text: = child.text
      is_close_brace: = c_text.is_closing_bracket()
      is_open_brace: = c_text.is_opening_bracket()
      is_block_close: = child.is_literal("}")
      is_block_open: = child.is_literal("{")
      is_semi: = child.is_literal(";")
      // A `;` ends a statement, except where it splits a header: a loop's three parts, and a
      // closure signature's parameters from its captures (`fn(x: I32; n: I32)`, even with no
      // capture after it). Those get a space, never a newline.
      ends_stmt: =
        is_semi && kind_id != .k_stmt_loop && kind_id != .k_loop_init &&
        kind_id != .k_expr_fn_lit_sig
      is_comma: = child.is_literal(",")
      is_assign: = child.kind_id == .k_assign_op || child.is_literal("=")
      is_logical: = child.is_literal("&&") || child.is_literal("||")
      // The `:` before a type_fn_sig's return type (a param's own `:` sits in its param_list, a
      // separate node). As with is_assign, it checks ahead whether the whole return type fits, so
      // no wrap lands inside it ("Void" fitting and "Void?Sema_error" not).
      is_ret_colon: = kind_id == .k_type_fn_sig && child.is_literal(":")

      if (is_brace_container && force_multiline && is_close_brace) || (is_block && is_block_close)
        // Caution: **Write the inner trivia before lowering the level.** A comment right before a
        // `}` belongs to the block, so written after the level drops it lines up one level too
        // shallow. In an empty block this is its only chance to be written at all.
        r.catch_up_trivia(child.loc.offset, false)
        r.pull_trailing_comment(body.open_brace_off, child.loc.offset)
        if r.indent_level > 0
          r.indent_level -= 1
        r.flags.force_next_nl = true

      if kind_id == .k_expr_ternary &&
        (child.is_keyword("if") || child.is_keyword("else"))
        r.break_before_choice(node, i)
      if kind_id == .k_stmt_defer && child.kind_id == .k_stmt_block &&
        r.writes_bare(child, depth)
        continue
      if is_comma || is_assign || is_logical || is_ret_colon
        r.format_internal(child, my_no_space, pass_allow_single, depth + 1)
        if is_comma && force_multiline && kind_id != .k_stmt_match
          r.flags.force_next_nl = true
        else if i + 1 < len
          r.wrap_before_next_element(node, i, is_comma, is_assign)
        continue
      // On a chain (x.y.m(...)) the width of the next .m(args) goes to pending_seg_len.
      if kind_id == .k_expr_postfix && i >= 1 && child.src_starts_with_dot(r.src)
        r.pending_seg_len = node.calc_chain_segment_len(i, r.src)
        r.pending_dot_break_ok =
          node.has_multi_dot_chain(r.src) || !node.chain_segment_has_comma(i, r.src)

      // **One attribute per line.** Joined (`#export #cfg(x)`), they cannot be read one at a time,
      // and adding one changes the whole line in a diff.
      if kind_id == .k_attribute_list && i > 0 && child.kind_id == .k_attribute &&
        r.suppress_nl_depth == 0
        r.flags.force_next_nl = true
      // In the indentation notation, a block's braces and a statement's terminator are not
      // written, **except inside a bracket** (the caution at `paren_depth`). A one-line block's
      // last `;` is left out there too: the reader puts it back wherever the block stands
      // (`bare_close`).
      hide: =
        (ends_stmt && r.bare_close >= 0 &&
        fmt_source.skip_space_from(r.src, child.loc.offset + 1) == r.bare_close) ||
        (r.layout && r.paren_depth == 0 && r.suppress_nl_depth == 0 &&
        ((is_block && body_count > 0 && (is_block_open || is_block_close)) || ends_stmt))
      if hide
        // Caution: **Write the trivia before skipping.** A comment right before the hidden mark
        // is the author's, and skipping the token alone moves the reading position past it, so
        // it is silently lost.
        r.catch_up_trivia(child.loc.offset, false)
        if is_block_close
          r.note_displaced(child.loc.offset)
        r.skip_token(child)
      else
        r.format_internal(child, my_no_space, pass_allow_single, depth + 1)
      if child.is_literal("(") || child.is_literal("[")
        if r.paren_depth == 0
          r.paren_indent_level = r.indent_level
        r.paren_depth += 1
      else if child.is_literal(")") || child.is_literal("]")
        if r.paren_depth > 0
          r.paren_depth -= 1
      if my_brace_suppress && is_close_brace
        if r.suppress_nl_depth > 0
          r.suppress_nl_depth -= 1
        my_brace_suppress = false
      if my_brace_suppress && is_open_brace
        r.suppress_nl_depth += 1

      // Caution: **An attribute goes on the line before the declaration, not onto it.** Joined
      // (`#cfg(x) pub fn f()`), a search from the line's head (`grep '^pub fn'`) misses it.
      if child.kind_id == .k_attribute_list && r.suppress_nl_depth == 0
        r.flags.force_next_nl = true

      if (is_brace_container && force_multiline && is_open_brace) || (is_block && is_block_open)
        r.flags.force_next_nl = true
        r.indent_level += 1

      if ends_stmt
        if r.suppress_nl_depth > 0
          r.write_space()
        else
          r.flags.force_next_nl = true
      else if is_semi
        r.write_space()

    r.bare_close = was_bare_close
    if my_list_suppress && r.suppress_nl_depth > 0
      r.suppress_nl_depth -= 1

    if fmt_kinds.rules.is_stmt_or_decl(kind_id) && r.suppress_nl_depth == 0
      r.flags.force_next_nl = true

    r.flags.in_type_expr = was_in_type_expr

priv fn follows_a_block(text: U8[]): Bool //<
  //< Whether the word may follow a block's `}` on that line: an arm, an `else`, or a `catch`
  return is_arm_or_else(text) || text.equals("catch")

priv fn is_arm_or_else(text: U8[]): Bool //<
  //< Whether the word is a `switch` arm's head or an `else`, which line up with the heading above
  //<
  //< **A `catch` is not one**: after a block it continues the line (`lead_cont_words` in
  //< `../parse/layout.kspls`), so a break before it takes a continuation's indent.
  return text.equals("case") || text.equals("default") || text.equals("else")

fn with_parens(src: U8[], spans: List<|Sz|>@, arena: Arena$@): U8[] //<
  //< The text with `(` and `)` put around each span `paren_spans` collected
  //<
  //< Caution: **The caller must parse again**, for the reason given at `reorder` in `import.kspls`.
  out: = arena.text()
  $at: Sz = 0
  for $k: Sz = 0; k + 1 < spans.len; k += 2
    from: = spans.get(k)
    to: = spans.get(k + 1)
    out.s(src.sub(at, from - at)).s("(").s(src.sub(from, to - from)).s(")")
    at = to
  out.s(src.sub_from(at))
  return out.take()

// It owns memory and releases it with `free()` (why it must conform: `Owned` in std/lang.kspls).
impl Formatter: Owned {}

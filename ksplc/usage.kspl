//< The usage and the help text, and what each subcommand accepts, kept apart from `main.kspl`
//<
//< **The table of which options apply to which subcommand (`flag_faces`) is here and nowhere
//< else**, and `check_flag_faces` refuses an option given where it does nothing (Principle 5).
// ==========================================
// Caution: **Do not list the options by hand** (see `print_faces_and_flags`).
// ==========================================
import "ksplc/base/core" as base_core
import "ksplc/base/target" as base_target
import "std/argparse"
import "std/chars"
import "std/ds" { List }
import "std/io"
import "std/str" + { Str_builder }
import "std/sys"

enum Info_topic //< the subjects `ksplc info` answers
    //<
    //< **A subject is named after its variant**, with `_` written `-` (`std_dir` is `std-dir`). So
    //< the usage, the parser and the message that rejects a wrong one use one spelling.
    std_dir //<
        //< The resolved folder of the standard library (like `rustc --print sysroot`)
        //<
        //< The LSP, an editor extension and a build script then share the CLI's resolution.
    link_libs //<
        //< The libraries needed to link the artifact
        //<
        //< ksplc/tools/run.kspl is the canonical source of the answer; the Makefile's LDLIBS is a
        //< copy, which `make test-link-rules` compares with it.
    exe_flags //<
        //< The options ksplc itself passes when building an executable
        //<
        //< They are separate from the libraries: without those the build fails, while dropping
        //< these changes the conditions it builds under.
    cache_dir //<
        //< The folder of the disk cache (ksplc/base/cache.kspl), in the OS's cache area
        //<
        //< It is hidden there, so **its growth cannot be checked** without this answer.
    keywords //<
        //< The reserved words the grammar collected; the only subject that needs the grammar built.
    machine //<
        //< The machine a compile is for when `--machine` names none: the one ksplc runs on
        //<
        //< A build script then names to the C compiler the machine ksplc folded sizes for.
    package //<
        //< The package the current folder is in: its name, then what it uses
        //<
        //< **Two empty lines are a valid answer too** (no folder above names one), so a script need
        //< not read `ksplc.cfg` itself.

impl Info_topic
    fn info_topic_name(t: Self): U8[] //< a subject as the command line writes it
        return t.variant_name().replace("_", "-", base_core.arena)

const INFO_TOPIC_ORDER: Info_topic[7] = ::{ Info_topic.std_dir, Info_topic.link_libs,
    Info_topic.exe_flags, Info_topic.cache_dir, Info_topic.keywords, Info_topic.machine,
    Info_topic.package } //<
        //< The subjects in the order the usage lists them
        //<
        //< Caution: **Add a new subject here too.** Otherwise `ksplc info` rejects it and the usage
        //< does not list it, though the enum and the answering `switch` have it.

fn info_topics(): U8[] //< every subject, separated by spaces, in the usage's order
    $b: = Str_builder.new()
    for t in INFO_TOPIC_ORDER
        if b.len > 0
            b.c(' ')
        b.s(t.info_topic_name())
    return base_core.arena.dup_str(b.slice())

fn parse_info_topic(name: U8[]): Info_topic //< it reads the subject's name
    //<
    //< Where the name is unknown, it exits with the list appended to the message.
    for t in INFO_TOPIC_ORDER
        if t.info_topic_name().equals(name)
            return t
    error_exit(base_core.arena.text()
        .s("ksplc info: unknown subject '\{name\}'. The usable ones are: \{info_topics()\}\n")
        .take())
    return .std_dir

fn refuse_unread_std_dir(p: argparse.Parser$@, topic: Info_topic) //<
    //< It rejects `--std-dir=` on a subject whose answer does not read it
    //<
    //< `info` takes the option for `std-dir` alone; `flag_faces` sees only the subcommand, so taken
    //< silently on another subject it would change nothing (Principle 5 in
    //< docs/DESIGN-principles.md).
    switch topic
    case .std_dir
        return
    default {}
    if !p.saw("--std-dir")
        return
    msg: = base_core.arena.text()
        .s("ksplc info \{topic.info_topic_name()\}: '--std-dir' does not change this subject's \
            answer. It changes only the std-dir answer\n").take()
    error_exit(msg)

fn flag_faces(flag: U8[]): U8[] //< the subcommands an option applies to
    //<
    //< **The table is here and nowhere else, and every option has a row**: empty is refused at
    //< every run (`check_flag_faces`). `--lint` applies to compiling too, whose diagnostics it can
    //< silence as well.
    if flag.equals("--style") || flag.equals("--in-place")
        return "fmt"
    // What a compile's output is written in: c / llvm. Not `info`: `link-libs` / `exe-flags`
    // follow the C compiler's target triple (`target_kind` in ksplc/tools/run.kspl), which the
    // language written does not change.
    if flag.equals("--to")
        return "compile"
    // Caution: **Make it apply to lint too**, or a package built only freestanding (`kspage/`'s
    // browser entry point) misses the `#cfg(freestanding)` declarations and cannot be linted.
    if flag.equals("--freestanding")
        return "compile emit-runtime lint"
    // Not `run` / `build`: they compile for the machine ksplc runs on and start or link the result
    // there. Lint, since a folded size decides a static `if` and an `##error`.
    if flag.equals("--machine")
        return "compile lint"
    if flag.equals("--std-dir")
        return "compile run build lint info doc"
    if flag.equals("--pkg-src-dir")
        return "compile run build lint doc"
    if flag.equals("--cflags")
        return "build"
    // Only `run`: a compile writes a file named after its input, and a source with no file names
    // none (standard input, `-`, is the compile's way in).
    if flag.equals("--eval")
        return "run"
    // Not `run`: it caches one program a script, which a sanitized one would have to be kept apart
    // from; `build` makes one. Not `emit-runtime`: the runtime is C, which the C compiler marks.
    if flag.equals("--sanitize")
        return "compile build"
    if flag.equals("--define")
        return "compile run build lint"
    // `doc` reads it as the record does: `all` shows what a package keeps to itself too.
    if flag.equals("--surface-scope")
        return "compile doc"
    if flag.equals("--lint") || flag.equals("--diagnostic-format")
        return "compile lint"
    if flag.equals("--stats")
        return "compile fmt"
    if flag.equals("--split") || flag.equals("--emit-deps") || flag.equals("--emit-libs") ||
        flag.equals("--emit-surface") || flag.equals("--library") || flag.equals("--program")
        return "compile"
    return ""

const MACHINE_FACES: U8[] = "compile lint lsp lsp-worker run build info" //<
    //< The subcommands that lay values out, and so need a machine ksplc has widths for
    //<
    //< `info` asks for it only on its `machine` subject. **The rest read no type** (`fmt` and
    //< `doc` parse alone), so they run on a machine the table lacks.

fn machine_refusal_to(face: U8[], named: U8[], host: U8[], m: Str_builder$@) //<
    //< Why the subcommand cannot lay values out for the machine, onto m; nothing where it can
    //<
    //< `named` is `--machine`'s (empty where none is given), `host` the machine ksplc runs on.
    //< **Every subcommand in `machine_faces` asks this before it starts**: a machine left unasked
    //< reaches the layout and stops ksplc with an internal error, naming no fix.
    if !faces_include(MACHINE_FACES, face)
        return
    name: = named if named.len > 0 else host
    if _known: = base_target.find(name)
        return
    if named.len > 0
        m.s("--machine: '\{name\}' is not a machine ksplc knows.")
    else if faces_include(flag_faces("--machine"), face)
        m
            .s("ksplc \{face\}: the machine ksplc runs on ('\{host\}') is not in its table of \
                machines. ksplc therefore has no widths for laying out values. Name the machine the \
                output is for with --machine=<triple>.")
    else
        m
            .s("ksplc \{face\}: the machine ksplc runs on ('\{host\}') is not in its table of \
                machines. This subcommand lays values out for the machine it runs on. A compile or \
                a lint names the machine with --machine=<triple> instead.")
    m.s(" The machines it knows: ")
    base_target.known_names_to(m)
    m.c('\n')

fn faces_include(faces: U8[], face: U8[]): Bool //<
    //< Whether the name is a whole entry of the whitespace-separated list
    //<
    //< Caution: Do not use a substring match ("run" would match "emit-runtime").
    $i: Sz = 0
    for i < faces.len
        if !faces.starts_with(face, i)
            i += 1
            continue
        before_ok: = i == 0 || (faces.ptr + (i - 1))$ == ' '
        j: = i + face.len
        if before_ok && (j >= faces.len || (faces.ptr + j)$ == ' ')
            return true
        i += 1
    return false

fn check_flag_faces(p: argparse.Parser$@, face: U8[]) //<
    //< It rejects an option that does not apply to this subcommand
    //<
    //< The error names the subcommands the option applies to.
    for name in option_names(p)
        faces: = flag_faces(name)
        // Caution: **Refuse an option with no row, given or not.** Read as "it applies everywhere",
        // a row left out lets the option be written where it does nothing.
        if faces.len == 0
            said: = base_core.arena.text()
                .s("ksplc: internal error: '\{name\}' has no row in `flag_faces` \
                    (ksplc/usage.kspl)\n").take()
            error_exit(said)
        if !p.saw(name) || faces_include(faces, face)
            continue
        $m: = Str_builder.new()
        m
            .s("ksplc \{face\}: '\{name\}' does not take effect on this subcommand. It takes effect \
                on: \{faces\}\n")
        error_exit(m.slice())

priv fn option_names(p: argparse.Parser$@): List<|U8[]|> //< every option the parser declares
    $names: = List<|U8[]|>.new(base_core.arena)
    p.append_names(names@)
    return names

fn refuse_empty_values(p: argparse.Parser$@) //<
    //< It rejects an option given with nothing after its `=` (`--emit-deps=`)
    //<
    //< **No option of ksplc means anything by an empty value.** Taken, it would read as the default
    //< or be ignored, and the writer would believe it took effect.
    for name in option_names(p)
        if p.saw_empty(name)
            error_exit(base_core.arena.text()
                .s("Error: \{argparse.Argument_error.missing_value(name)\}\n").take())

fn help_with_topics(head: U8[], topics: U8[]): U8[] //<
    //< It appends the list of subjects to a subcommand's description
    //<
    //< Caution: **Copy it to the arena**; the parser keeps it, and `--help` reads it later.
    b: = base_core.arena.text()
    b.s(head).s(" (").s(topics).c(')')
    return b.take()

fn usage_for_topics(face: U8[], topics: U8[]): U8[] //<
    //< The usage of a subcommand that takes a subject
    return base_core.arena.text()
        .s("usage: ksplc \{face\} <\{topics.replace(" ", "|", base_core.arena)\}>\n").take()

// The argument Parser, for the usage list.
// Caution: Set it right after Mode.new builds it; if left null, no option is listed.
$cli: argparse.Parser$@ = null

fn print_words(words: List<|U8[]|>@) //< the usage's description
    //<
    //< Caution: **Do not write each option's one-line description**; cli.print_usage below prints
    //< them from the declarations. **Print the queries' answers in this form**: they go straight to
    //< the shell's word splitting.
    for i in Range.asc(words.len)
        io.out().s(" " if i > 0 else "").s(words.get(i))
    io.out().c('\n')

priv struct Face //< a subcommand and the command line it takes
    name: U8[] //< the name `flag_faces` uses; `compile` is the default, typed with no name
    form: U8[] //< its command line, as its usage line writes it

priv const FACES: Face[11] = ::{ Face::{ .name = "compile",
    .form = "ksplc [options...] <input.kspl> <output.c>" },
    Face::{ .name = "run",
    .form = "ksplc run [options...] <script.kspl> | - | --eval=<source> [args...]" },
    Face::{ .name = "build", .form = "ksplc build [options...] <input.kspl> <output.exe>" },
    Face::{ .name = "fmt", .form = "ksplc fmt [options...] <input.kspl>..." },
    Face::{ .name = "lint", .form = "ksplc lint [options...] <input.kspl>" },
    Face::{ .name = "lsp", .form = "ksplc lsp" },
    Face::{ .name = "info", .form = "ksplc info <subject>" },
    Face::{ .name = "clean", .form = "ksplc clean" },
    Face::{ .name = "emit-runtime", .form = "ksplc emit-runtime [options...] <output.c>" },
    Face::{ .name = "explain", .form = "ksplc explain <code>" },
    Face::{ .name = "doc", .form = "ksplc doc <file>[.<name>] | <folder>" } } //<
        //< The subcommands the usage lists, each with its command line
        //<
        //< Caution: **List the options per subcommand** (`print_faces_and_flags`); in one flat
        //< list, a reader cannot tell which applies where without trying.

fn usage_of(face: U8[]): U8[] //< the one usage line of a subcommand, for refusing its arguments
    for f in FACES
        if f.name.equals(face)
            return base_core.arena.text().s("usage: ").s(f.form).c('\n').take()
    return base_core.arena.text().s("usage: ksplc ").s(face).c('\n').take()

fn print_usage(out: Writer) //<
    //< the whole usage: `io.out()` for `--help`, `io.err()` after a refusal
    for i in Range.asc(FACES.len)
        out.s("usage: " if i == 0 else "       ").s(FACES[i].form)
        if i == 0
            out.s("          compile (the default subcommand)")
        out.c('\n')
    $usage: =
        """

        `run` builds and runs the script. It caches the result in $KSPLC_CACHE_DIR, which defaults
        to the OS's cache directory. Place ksplc's options before the script's path. Arguments
        after that path go to the script unchanged. In place of the path, use `-` to read the
        program from standard input. Use --eval=<source> to take it from the command line.
        Both forms use `-` as the file name in the current folder. All following arguments go to
        the program. Put `--` before the first argument if it starts with `-`. A compile also
        reads standard input when its input is `-`.

        For `import "std/..."`, look for the standard library in this order:
          1. --std-dir=DIR
          2. The environment variable KSPLC_STD_DIR
          3. std/ beside the ksplc executable
          4. ../lib/kspl/std from the executable's folder
          5. "std" in the current folder
        `ksplc info std-dir` reports the selected directory.
        """
        .dedent()
    defer usage.free()
    out.s(usage.slice())
    out.s("\ninfo's subjects: ").s(info_topics()).c('\n')
    if cli != null
        print_faces_and_flags(out, cli)
        out.c('\n')
        cli.print_options(out)

fn print_faces_and_flags(out: Writer, p: argparse.Parser$@) //<
    //< It lists the options that apply, per subcommand
    //<
    //< Caution: **Build the list from `flag_faces`**; a list written by hand drifts silently.
    names: = option_names(p)
    out
        .s("\nThe options that take effect per subcommand (an option not here is an error on that \
            subcommand):\n")
    for face in FACES
        $line: = Str_builder.new()
        line.s("  ").s(face.name).c(':')
        for name in names
            f: = flag_faces(name)
            if f.len > 0 && faces_include(f, face.name)
                line.c(' ').s(name)
        out.s(line.slice()).c('\n')
    out.s("  on every subcommand: --help\n")

fn usage_exit(): Void //< it prints the usage as an argument error and exits
    print_usage(io.err())
    sys.exit(1)

fn error_exit(msg: U8[]): Void //< it prints one message and exits
    //<
    //< Caution: **Make the exit code non-zero**, or a calling script carries on unaware of the
    //< error. **Write it to standard error**: a caller reading the output (`$(ksplc info ...)`)
    //< would otherwise take the refusal for the answer.
    io.err().s(msg)
    sys.exit(1)

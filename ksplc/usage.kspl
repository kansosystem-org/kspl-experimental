//< The usage and the help text, and `info`'s subjects, kept apart from `main.kspl`
//< **The subcommands, their usage lines and which options each takes are declared once**, in
//< `cli.kspl`, and `std/argparse` writes the usage from those declarations. This file adds only
//< the text no declaration holds.
// ==========================================
// Caution: **Do not list the subcommands or the options by hand**; a copied list drifts silently.
// ==========================================
import "ksplc/base/core" as base_core
import "std/argparse"
import "std/ds" { List }
import "std/io"
import "std/str" + { Str_builder }
import "std/sys"

enum Info_topic //< the subjects `ksplc info` answers
    //< **A subject is named after its variant**, with `_` written `-` (`std_dir` is `std-dir`). So
    //< the usage, the parser and the message that rejects a wrong one use one spelling.
    std_dir //<
        //< The resolved folder of the standard library (like `rustc --print sysroot`)
        //< The LSP, an editor extension and a build script then share the CLI's resolution.
    link_libs //<
        //< The libraries needed to link the artifact
        //< ksplc/tools/run.kspl is the canonical source of the answer; the Makefile's LDLIBS is a
        //< copy, which `make test-link-rules` compares with it.
    exe_flags //<
        //< The options ksplc itself passes when building an executable
        //< They are separate from the libraries: without those the build fails, while dropping
        //< these changes the conditions it builds under.
    cache_dir //<
        //< The folder of the disk cache (ksplc/base/cache.kspl), in the OS's cache area
        //< It is hidden there, so **its growth cannot be checked** without this answer.
    keywords //<
        //< The reserved words the grammar collected; the only subject that needs the grammar built.
    package //<
        //< The package the current folder is in: its name, then what it uses
        //< **Two empty lines are a valid answer too** (no folder above names one), so a script need
        //< not read `ksplc.cfg` itself.

impl Info_topic
    fn info_topic_name(t: Self): U8[] //< a subject as the command line writes it
        return t.variant_name().replace("_", "-", base_core.arena)

fn info_topics(): U8[] //< every subject, separated by spaces, in the enum's order
    defer $b: = Str_builder()
    for t in Info_topic.variants()
        if b.len > 0
            b.c(' ')
        b.s(t.info_topic_name())
    return base_core.arena.dup_str(b.slice())

fn parse_info_topic(name: U8[]): Info_topic //< it reads the subject's name
    //< Where the name is unknown, it exits with the list appended to the message.
    for t in Info_topic.variants()
        if t.info_topic_name().equals(name)
            return t
    error_exit(base_core.arena.text()
        .s("ksplc info: unknown subject '\{name\}'. The usable ones are: \{info_topics()\}\n")
        .take())
    return .std_dir

fn refuse_unread_std_dir(p: argparse.Parser$@, topic: Info_topic) //<
    //< It rejects `--std-dir=` on a subject whose answer does not read it
    //< `info` takes the option for `std-dir` alone. argparse sees only the subcommand (`only_for`
    //< in `cli.kspl`), so taken silently on another subject it would change nothing (Principle 5 in
    //< docs/DESIGN-principles.md).
    switch topic
    case .std_dir
        return
    default {}
    if !p.saw("--std-dir")
        return
    msg: = base_core.arena.text()
        .s("ksplc info \{topic.info_topic_name()\}: '--std-dir' does not change this subject's \
            answer. It changes only the std-dir answer\n").take()
    error_exit(msg)

fn refuse_empty_values(p: argparse.Parser$@) //<
    //< It rejects an option given with nothing after its `=` (`--emit-deps=`)
    //< **No option of ksplc means anything by an empty value.** Taken, it would read as the default
    //< or be ignored, and the writer would believe it took effect.
    $names: = List<|U8[]|>(base_core.arena)
    p.append_names(names@)
    for name in names
        if p.saw_empty(name)
            error_exit(base_core.arena.text()
                .s("Error: \{argparse.Argument_error.missing_value(name)\}\n").take())

fn help_with_topics(head: U8[], topics: U8[]): U8[] //<
    //< It appends the list of subjects to a subcommand's description
    //< Caution: **Copy it to the arena**; the parser keeps it, and `--help` reads it later.
    b: = base_core.arena.text()
    b.s(head).s(" (").s(topics).c(')')
    return b.take()

fn usage_for_topics(face: U8[], topics: U8[]): U8[] //<
    //< The usage of a subcommand that takes a subject
    return base_core.arena.text()
        .s("usage: ksplc \{face\} <\{topics.replace(" ", "|", base_core.arena)\}>\n").take()

// The argument Parser, for the usage list.
// Caution: Set it right after Mode.new (`cli.kspl`) builds it; if left null, no usage is printed.
$cli: argparse.Parser$@ = null

fn print_words(words: List<|U8[]|>@) //< the usage's description
    //< Caution: **Do not write each option's one-line description**; cli.print_usage below prints
    //< them from the declarations. **Print the queries' answers in this form**: they go straight to
    //< the shell's word splitting.
    for i in Range.asc(words.len)
        io.out().s(" " if i > 0 else "").s(words.get(i))
    io.out().c('\n')

fn print_usage(out: Writer) //<
    //< the whole usage: `io.out()` for `--help`, `io.err()` after a refusal
    //< argparse writes each subcommand's line, the options each takes and the lists, from the
    //< declarations. The text between is ksplc's own.
    if cli == null
        return
    about: =
        """
        `run` builds and runs the script. It caches the result in $KSPLC_CACHE_DIR, which defaults
        to the OS's cache directory. Place ksplc's options before the script's path. Arguments
        after that path go to the script unchanged. In place of the path, use `-` to read the
        program from standard input. Use --eval=<source> to take it from the command line.
        Both forms use `-` as the file name in the current folder. All following arguments go to
        the program. Put `--` before the first argument if it starts with `-`. A compile also
        reads standard input when its input is `-`.

        For `import "std/..."`, look for the standard library in this order:
          1. --std-dir=DIR
          2. The environment variable KSPLC_STD_DIR
          3. std/ beside the ksplc executable
          4. ../lib/kspl/std from the executable's folder
          5. "std" in the current folder
        `ksplc info std-dir` reports the selected directory.

        """
        .dedent(base_core.arena)
    // The parser keeps it past this call, so it is built in the pipeline's arena.
    cli.about = base_core.arena.text().s(about).s("info's subjects: ").s(info_topics()).take()
    cli.print_usage(out)

fn command_usage_exit(face: U8[]): Void //<
    //< it prints one subcommand's usage line as an argument error and exits
    if cli != null
        cli.print_command_usage(face, io.err())
    sys.exit(1)

fn usage_exit(): Void //< it prints the usage as an argument error and exits
    print_usage(io.err())
    sys.exit(1)

fn error_exit(msg: U8[]): Void //< it prints one message and exits
    //< Caution: **Make the exit code non-zero**, or a calling script carries on unaware of the
    //< error. **Write it to standard error**: a caller reading the output (`$(ksplc info ...)`)
    //< would otherwise take the refusal for the answer.
    io.err().s(msg)
    sys.exit(1)

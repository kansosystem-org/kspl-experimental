//< Where a line of source text begins and ends, and where its leading blanks stop
//< The line-start table (`line_starts`) turns an offset into a line and a column, for a
//< diagnostic and for the LSP.
//< A line ends at its `\n`; a `\r` before it belongs to the line. A blank is a space or a tab.
//< Caution: **The indentation notation counts only the space** (`../parse/layout.kspl`), so
//< a reader of its columns does not skip blanks through here.
import "std/chars" // `sub`, `next_codepoint`
import "std/ds" { List }
import "std/mem" { Arena }

fn line_start(src: U8[], at: Sz): Sz //< where the line holding `at` begins
    $i: = at
    for i > 0 && src[i - 1] != '\n'
        i -= 1
    return i

fn line_end(src: U8[], at: Sz): Sz //< where the line holding `at` ends: its `\n` or the end
    $i: = at
    for i < src.len && src[i] != '\n'
        i += 1
    return i

fn next_line_start(src: U8[], at: Sz): Sz //<
    //< Where the line after the one holding `at` begins, or the text's end
    e: = line_end(src, at)
    return e + 1 if e < src.len else src.len

fn line_from(src: U8[], at: Sz): U8[] //< the text from `at` to its line's end, without the `\n`
    return src.sub(at, line_end(src, at) - at)

fn skip_blanks(src: U8[], at: Sz): Sz //< the first position at or after `at` that is not a blank
    $i: = at
    for i < src.len && (src[i] == ' ' || src[i] == '\t')
        i += 1
    return i

fn opens_its_line(src: U8[], at: Sz): Bool //< whether only blanks stand before `at` on its line
    $i: = at
    for i > 0 && (src[i - 1] == ' ' || src[i - 1] == '\t')
        i -= 1
    return i == 0 || src[i - 1] == '\n'

struct Line_info //< where an offset stands: its line, and its column counted two ways
    line: Sz
    char_idx: Sz
    disp_col: Sz
    line_start: Sz

impl U8[]
    fn get_line_info(r: U8[], target_offset: Sz, starts: List<|Sz|>$@): Line_info //<
        //< char_idx: the UTF-16 code-unit offset given to the LSP (a surrogate pair's worth is +2)
        //< disp_col: the 1-based display column for the CLI's diagnostic display (in code points).
        //< Caution: **Always pass the line-start table (line_starts).** Recounting makes N lookups
        //< in one file O(size × N). **Do not write a second conversion**: line_for_offset gives the
        //< line only, this one the column or UTF-16; both use the same table.
        line: = line_for_offset(starts, target_offset)
        line_start: = starts.get(line - 1) if line >= 1 && line - 1 < starts.len else 0
        $info: = Line_info::{ .line = line, .char_idx = 0, .disp_col = 1,
            .line_start = line_start }
        $i: = line_start
        for i < target_offset && i < r.len
            c: = (r.ptr + i)$
            if c == '\n'
                info.line += 1
                info.char_idx = 0
                info.disp_col = 1
                info.line_start = i + 1
                i += 1
            else if c == '\r'
                i += 1
            else
                step: = r.next_codepoint(i)
                info.char_idx += 2 if step == 4 else 1
                info.disp_col += 1
                i += step
        return info

    fn line_starts(r: U8[], arena: Arena$@): List<|Sz|>$@ //<
        //< Each line's starting byte offset (ascending; index 0 is 0, the start of line 1)
        //< Caution: **Build it once per file and pass it along** (the reason is at get_line_info
        //< above).
        starts: = arena.create(List<|Sz|>(arena))
        starts.push(0)
        for i in Range.asc(r.len)
            if (r.ptr + i)$ == '\n'
                starts.push(i + 1)
        return starts

fn line_for_offset(starts: List<|Sz|>@, offset: Sz): Sz //<
    //< The 1-based line number of the offset, by binary search in the table from `line_starts`
    //< Caution: The table must come from `line_starts` (ascending, with 0 first).
    $lo: Sz = 0
    $hi: Sz = starts.len
    for lo < hi
        mid: = lo + (hi - lo) / 2
        if starts.get(mid) <= offset
            lo = mid + 1
        else
            hi = mid
    return lo

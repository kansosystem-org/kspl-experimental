import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/core" as base_core
import "ksplc/base/lines" { line_end, line_from, line_start, skip_blanks }
import "std/chars" // `trim_spaces`
import "std/ds" { List }
import "std/str" { Str_builder }

// ==========================================
// Reading the documentation a declaration carries (`//<`).
//
// **One reader for everything that shows it**: the record (`tools/surface.kspls`), the declaration
// file (`tools/decls.kspls`) and the editor's hover (`lsp/hover.kspls`) (Principle 6). The marker
// and the summary/detail rule are in "The documentation a declaration carries" in
// `../../docs/DESIGN.md`. A following line that starts with the mark continues a `//<` and is
// joined into the record's one line. **`///` and `//!` are not read** (`is_unread_mark`).
// ==========================================

fn end_of(n: Ast_node$@): Sz //< the section's end (the next character's position)
  sp: = n.get_span_offset()
  return sp.offset + sp.span

fn brace_at(n: Ast_node$@): Sz //< the position of the `{` where the contents begin
  //<
  //< Where there is none (only a heading), the section's end.
  for c in n.children
    if c.is_literal("{")
      return c.loc.offset
  return end_of(n)

priv fn is_sentence_closer(c: U8): Bool //< the marks that may follow a sentence's last word
  //<
  //< A backtick, a bracket, a quote and a bold mark come after the full stop and are skipped.
  return c == '`' || c == ')' || c == ']' || c == '}' || c == '"' || c == '\'' || c == '*'

priv fn wants_a_stop(text: U8[]): Bool //<
  //< Whether `text` needs a full stop before another description is joined to it
  //<
  //< **A comma or a dash at the end needs none**: the writer left the line open.
  $e: = text.len
  for e > 0 && is_sentence_closer(text[e - 1])
    e -= 1
  if e == 0
    return false
  c: = text[e - 1]
  return c != '.' && c != '!' && c != '?' && c != ':' && c != ';' && c != ',' && c != '-'

priv fn described(summary: U8[], account: U8[]): U8[] //<
  //< It joins a summary and the detail below it into one description
  //<
  //< It adds a full stop where the summary has none. By house style a `//<` is a fragment, so the
  //< two joined as they are read as a broken sentence. **This is not `joined`**, which also builds
  //< the record's signature column, where a stop would land inside the code (`pub. fn f()`).
  if summary.len == 0 || account.len == 0
    return joined(summary, account)
  $s: = Str_builder.new()
  defer s.free()
  s.s(summary)
  if wants_a_stop(summary)
    s.c('.')
  s.c(' ')
  s.s(account)
  return base_core.arena.dup_str(s.slice())

fn joined(a: U8[], b: U8[]): U8[] //< it joins two words with a space (an empty word is skipped)
  words: U8[][2] = ::{ a, b }
  $s: = Str_builder.new()
  defer s.free()
  for w in words
    if w.len == 0
      continue
    if s.slice().len > 0
      s.c(' ')
    s.s(w)
  return base_core.arena.dup_str(s.slice())

fn is_continuation_line(src: U8[], at: Sz): Bool //<
  //< Whether the line starting at `at` holds nothing but a `//<` and its text
  //<
  //< The only place that decides what a continuation looks like: the reader below and `[W0209]`
  //< both ask here (Principle 6).
  j: = skip_blanks(src, at)
  return j + 3 <= src.len && src.sub(j, 3).equals("//<")

priv fn has_trailing_summary(src: U8[], at: Sz): Bool //<
  //< Whether the line starting at `at` has a `//<` after something else
  //<
  //< That is what a continuation below continues; a line with only the mark is a continuation.
  line: = line_from(src, at)
  mark: = line.find_str("//<")
  return mark > 0 && line.sub(0, mark).trim_spaces().len > 0

fn opens_a_summary_run(src: U8[], at: Sz): Bool //<
  //< Whether a continuation directly below the line at `at` would continue something
  //<
  //< Only a line with a `//<` after something else, or a continuation, starts a run. That is the
  //< whole rule; `[W0209]` asks here rather than writing it again (Principle 4).
  return has_trailing_summary(src, at) || is_continuation_line(src, at)

fn is_bare_summary(src: U8[], at: Sz): Bool //<
  //< Whether the line at `at` has a `//<` with no text of its own
  //<
  //< The anchor shape: the whole description is in the continuations below. It asks
  //< `has_trailing_summary`, and `[W0210]` asks here, so the shape is written once (Principle 4).
  if !has_trailing_summary(src, at)
    return false
  line: = line_from(src, at)
  mark: = line.find_str("//<")
  return line.sub_from(mark + 3).trim_spaces().len == 0

struct Doc_run //< one `//<` run, split where a mark with no text appears inside it
  summary: U8[] //< the run's first paragraph, which is what goes into a declaration file
  detail: U8[] //< the text after the first splitting mark, joined into one line
  lines: Sz //< how many lines the summary spans

priv fn run_at(src: U8[], at: Sz, limit: Sz): Doc_run //<
  //< The run that the line at `at` starts, with the continuations below it
  //<
  //< It reads only before `limit`, and joins each part into one line, as one record entry is one
  //< line
  //<
  //< **A mark with no text splits the run; it does not end it.** The rule is PEP 257's (a
  //< summary line, a blank line, the rest) rather than a first sentence cut at a `.`, which breaks
  //< on `e.g.` and on version numbers. **Such marks at the start of the run split nothing**: under
  //< an anchor, such a mark is part of the anchor's shape.
  e: = line_end(src, at)
  line: = src.sub(at, e - at)
  mark: = line.find_str("//<")
  if mark < 0 || at + Sz::mark >= limit
    return Doc_run::{ .summary = "", .detail = "", .lines = 0 }
  $head: = Str_builder.new()
  defer head.free()
  $tail: = Str_builder.new()
  defer tail.free()
  head.s(line.sub_from(mark + 3).trim_spaces())
  $lines: Sz = 1 if head.slice().len > 0 else 0
  $parted: = false
  // A blank line and a plain `//` are not continuations, so they end the run without a case of
  // their own.
  $i: = e
  for i < src.len
    j: = i + 1
    if j >= limit || !is_continuation_line(src, j)
      break
    k: = skip_blanks(src, j)
    stop: = line_end(src, k + 3)
    piece: = src.sub(k + 3, stop - k - 3).trim_spaces()
    i = stop
    if piece.len == 0
      parted = parted || head.slice().len > 0
      continue
    into: = tail@ if parted else head@
    if !parted
      lines += 1
    if into.slice().len > 0
      into.c(' ')
    into.s(piece)
  return Doc_run::{ .summary = base_core.arena.dup_str(head.slice()),
    .detail = base_core.arena.dup_str(tail.slice()), .lines = lines }

enum Summary_fault //< what keeps a run's summary from being one line saying what the thing is
  none //< nothing: it is one line, and a description
  too_long(lines: Sz) //< it spans more than one line
  label //< it starts with `Caution:` or `Note:`, which say what to watch for, not what it is

fn summary_fault_at(src: U8[], at: Sz): Summary_fault //<
  //< What is wrong with the summary of the run behind the code on the line at `at`
  //<
  //< **`[W0213]` asks the same reader the hover uses**, so the two cannot disagree on where a
  //< summary ends (Principle 4). A line with no `//<` after code has no run of its own.
  if !has_trailing_summary(src, at)
    return Summary_fault.none
  return fault_of(run_at(src, at, src.len))

fn file_summary_fault(src: U8[], at: Sz): Summary_fault //<
  //< What is wrong with the summary of the file's own run, which begins at `at`
  return fault_of(run_at(src, at, src.len))

priv fn fault_of(run: Doc_run): Summary_fault
  if run.lines > 1
    return Summary_fault.too_long(run.lines)
  if run.summary.starts_with("Caution:") || run.summary.starts_with("Note:")
    return Summary_fault.label
  return Summary_fault.none

priv fn summary_run(src: U8[], at: Sz, limit: Sz): U8[] //<
  //< Only the run's first paragraph, for a thing that has no room for a second
  return run_at(src, at, limit).summary

fn file_doc_at(src: U8[]): Sz //<
  //< Where the run that describes the file begins (**`src.len` where there is none**)
  //<
  //< **It comes before the first line of code**, maybe after an ordinary banner for whoever edits
  //< the file; this run is for its callers (as with Rust's `//!` and Go's package comment).
  //< Caution: **Check for a continuation before checking for a comment.** A `//<` starts with
  //< `//` too, so the looser test first would skip the run.
  $at: Sz = 0
  for at < src.len
    stop: = line_end(src, at)
    line: = src.sub(at, stop - at).trim_spaces()
    if is_continuation_line(src, at)
      return at
    if line.len > 0 && !(line.len >= 2 && line.sub(0, 2).equals("//"))
      return src.len
    at = stop + 1
  return src.len

fn file_doc_end(src: U8[], from: Sz): Sz //<
  //< Where the run beginning at `from` ends (the first line past it)
  //<
  //< **`[W0209]` asks this**, so the file's run is not mistaken for lines that continue nothing.
  $i: = from
  for i < src.len
    if !is_continuation_line(src, i)
      return i
    i = line_end(src, i) + 1
  return src.len

fn file_doc(src: U8[]): U8[] //< what a file says about itself (**empty where it says nothing**)
  //<
  //< The same two parts as a declaration's, joined the same way for the record's one line.
  at: = file_doc_at(src)
  if at >= src.len
    return ""
  run: = run_at(src, at, src.len)
  return described(run.summary, run.detail)

fn is_unread_mark(comment: U8[]): Bool //<
  //< whether a line comment starts with a documentation mark that is not read, `///` or `//!`
  //<
  //< **Wherever they exist, they point elsewhere than a KSPL description does**: `///` at the
  //< thing after it, `//!` at the thing around it. Four or more slashes are a banner, as in Rust.
  return comment.starts_with("//!") ||
    (comment.starts_with("///") && !comment.starts_with("////"))

priv fn mark_offset(src: U8[], at: Sz, brace: Sz): Sz //<
  //< Which line holds the declaration's own run
  //<
  //< It is the head's first line or its last; a one-line head is both. On a wrapped head the first
  //< line is taken, as a run there would read as the last parameter's.
  //< **Only a mark with no text is taken from the last line**; one with text describes the return
  //< type (`return_doc`), as "The documentation a declaration carries" in `../../docs/DESIGN.md`
  //< decides.
  e: = line_end(src, at)
  if src.sub(at, e - at).find_str("//<") >= 0
    return at
  if brace >= src.len || src[brace] != '{' || brace <= e
    return at
  return brace if is_bare_summary(src, line_start(src, brace)) else at

fn decl_summary(src: U8[], n: Ast_node$@): U8[] //<
  //< A declaration's own summary, on whichever line its run is
  //<
  //< Only the first paragraph, as a declaration file holds; the detail stays with the body.
  return run_at(src, mark_offset(src, n.loc.offset, body_brace(src, n)), src.len).summary

fn doc_of(src: U8[], at: Sz, brace: Sz): U8[] //< the documentation one declaration carries
  //<
  //< **The summary and the detail are joined into one column**, as the record has one entry per
  //< line.
  run: = run_at(src, mark_offset(src, at, brace), src.len)
  return described(run.summary, run.detail)

fn doc_parted(src: U8[], at: Sz, brace: Sz): U8[] //<
  //< The same description, with the summary and the detail kept apart
  //<
  //< **The editor has room the record lacks**: a hover is Markdown, so a blank line separates what
  //< goes into a declaration file (the summary) from what stays with the body. Both read the same
  //< run.
  run: = run_at(src, mark_offset(src, at, brace), src.len)
  summary: = run.summary
  account: = run.detail
  if summary.len == 0 || account.len == 0
    return joined(summary, account)
  $s: = Str_builder.new()
  defer s.free()
  s.s(summary)
  if wants_a_stop(summary)
    s.c('.')
  s.s("\n\n").s(account)
  return base_core.arena.dup_str(s.slice())

priv fn has_contents(n: Ast_node$@): Bool //<
  //< Whether this kind of declaration has contents where a run can go
  //<
  //< One with none (an interface method's requirement, a `const`, a `typedef`, a field, a variant)
  //< has only a trailing `//<` (see the file head).
  switch n.kind_id case .k_decl_fn, .k_decl_struct, .k_decl_enum, .k_decl_trait, .k_decl_impl,
    .k_stmt_block
    return true
  default {}
  return false

fn body_brace(src: U8[], n: Ast_node$@): Sz //<
  //< Where a declaration's contents begin, found **in the source**; its end where there are none
  //<
  //< Caution: **Do not look for a `{` among the children.** `normalize` drops a declaration's
  //< braces (`is_trivia_node` in `../parse/normalize.kspls`), so the editor's tree has none.
  //< **Count the round and square brackets**, or a default argument's `::{ … }` looks like a body.
  sp: = n.get_span_offset()
  $end: = sp.offset + sp.span
  if end > src.len
    end = src.len
  if !has_contents(n)
    return end
  $depth: Sz = 0
  $i: = sp.offset
  for i < end
    c: = src[i]
    if c == '/' && i + 1 < end && src[i + 1] == '/'
      i = line_end(src, i)
      continue
    if c == '"' || c == '\''
      i = past_literal(src, i, end)
      continue
    if c == '(' || c == '['
      depth += 1
    else if c == ')' || c == ']'
      depth -= 1
    else if c == '{' && depth == 0
      return i
    i += 1
  return end

priv fn past_literal(src: U8[], at: Sz, end: Sz): Sz //<
  //< The position just past the string or character literal that starts at `at`
  quote: = src[at]
  $i: = at + 1
  for i < end
    c: = src[i]
    i += 1
    if c == '\\' && i < end
      i += 1
      continue
    if c == quote
      break
  return i

struct Param_doc //< one parameter, as it is written and as it is described
  name: U8[] //< the parameter\'s name, as the signature writes it
    //<
    //< Read from the identifier, so the description follows a rename.
  doc: U8[] //< what its `//<` said, with the run below it joined on

fn param_docs(src: U8[], n: Ast_node$@, out: List<|Param_doc|>$@) //<
  //< Every parameter a declaration takes, in the order written, each with its own `//<`
  //<
  //< That is the `//<` on the parameter's own line, empty where there is none.
  //< The editor shows it below a signature, on hover and while the call is typed.
  params: = n.get_fn_params()
  if params == null
    return
  end: = body_brace(src, n)
  for i in Range.asc(params.children.len)
    p: = params.children[i]
    if p.kind_id != .k_fn_param
      continue
    id_n: = p.find_child(.k_identifier)
    name: = id_n.text if id_n != null else p.text
    out
      .push(Param_doc::{ .name = name,
      .doc = summary_within(src, p.loc.offset, next_param_at(params, i, end)) })

fn return_doc(src: U8[], n: Ast_node$@): U8[] //<
  //< The `//<` on the line of the return type, empty where there is none
  //<
  //< The editor shows it after the return type, as a parameter's after the parameter.
  //< Caution: **Read it only where the return type is not on the declaration's first line.**
  //< On a one-line signature the mark describes the declaration (`decl_summary`); read here, every
  //< one would give its summary as what it returns.
  t: = n.get_decl_type_node()
  if t == null
    return ""
  if line_end(src, n.loc.offset) >= t.loc.offset
    return ""
  // **A mark with no text there belongs to the declaration, not the return type**: it is a
  // wrapped head's anchor (`mark_offset` above).
  if is_bare_summary(src, line_start(src, t.loc.offset))
    return ""
  return summary_run(src, t.loc.offset, src.len)

priv fn next_param_at(params: Ast_node$@, i: Sz, end: Sz): Sz //<
  //< Where the parameter after the one at `i` starts, or `end` where it is the last
  for j in Range.asc(params.children.len)
    p: = params.children[j]
    if j > i && p.kind_id == .k_fn_param
      return p.loc.offset
  return end

priv fn summary_within(src: U8[], at: Sz, limit: Sz): U8[] //<
  //< The `//<` a parameter carries, with its continuations
  //<
  //< `limit` is where the next parameter starts. **A mark found only past it is not this
  //< one\'s**; the guard is in `summary_run`, shared with the declaration\'s own summary.
  return summary_run(src, at, limit)

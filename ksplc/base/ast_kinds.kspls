import "std/chars" // `sub_from`

enum Ast_kind: I32
    k_unknown = 0
    k_empty
    k_underscore
    k_keyword
    k_file
    k_decl_directive
    k_attribute_prefix
    k_directive_prefix
    k_enum_payload
    k_stmt_goto
    k_stmt_label
    k_expr_upcast
    k_expr_sizeof
    k_expr_offsetof
    k_enum_init
    k_enum_init_call
    k_implicit_enum
    k_struct_literal
    k_method_access
    k_generic_path
    k_generic_method
    k_result_wrap
    k_string_interp
    k_program
    k_visibility
    k_top_level_item
    k_decl_import
    k_decl_import_plus
    k_decl_import_selector_list
    k_decl_import_selector
    k_decl_embed
    k_decl_extern_block
    k_decl_extern
    k_decl_extern_struct
    k_decl_top
    k_lint_setting
    k_decl_const
    k_decl_var
    k_decl_var_item
    k_decl_fn_proto
    k_decl_fn
    k_type_fn_sig
    k_param_list
    k_fn_param
    k_type_gen_params
    k_type_gen_param
    k_type_constraint
    k_decl_alias
    k_decl_trait
    k_decl_struct
    k_struct_field
    k_decl_enum
    k_enum_variant
    k_enum_field
    k_decl_impl
    k_stmt_block
    k_stmt
    k_stmt_return
    k_stmt_throw
    k_stmt_fallback
    k_stmt_break
    k_stmt_continue
    k_stmt_defer
    k_stmt_if
    k_if_bind
    k_label
    k_stmt_loop
    k_loop_init
    k_loop_step
    k_stmt_match
    k_stmt_labeled_block
    k_match_pattern
    k_identifier_list
    k_stmt_expr
    // The two kinds that hold text the editor's lenient parse skipped. **They carry the text and
    // nothing else**: no name and no declaration is invented, or the invented one would enter the
    // symbol table and be offered by completion (the grounds are "What a broken node holds" in
    // `../docs/DESIGN.md`).
    k_stmt_broken
    k_item_broken
    k_assign_op
    k_expr
    k_expr_ternary
    k_expr_catch_chain
    k_expr_catch
    k_expr_or
    k_expr_and
    k_expr_cmp
    k_expr_add
    k_expr_mul
    k_expr_cast
    k_expr_unary
    k_expr_postfix
    k_expr_implicit_dot
    k_expr_primary
    k_expr_fn_lit
    k_expr_fn_lit_sig
    k_capture_list
    k_expr_path
    k_type_path
    k_type_args
    k_type_arg
    k_expr_args
    k_expr_compound
    k_expr_field_init
    k_type_expr
    k_type_postfix
    k_type_atom
    k_attribute_list
    k_attribute
    k_identifier
    k_string
    k_string_part
    k_string_expr
    k_string_content
    k_format_spec
    k_literal
    k_integer
    k_float
    k_bool
    k_null
    k_char
    k_primitive_type
    k_max

impl Ast_kind
    fn builtin_name(r: Self): U8[] //<
        //< The name the grammar gives this kind
        //<
        //< The variant's own name past `k_`, but for the kinds the grammar spells otherwise (its
        //< token rules are capitalised).
        //< Caution: **A kind the grammar spells otherwise needs its own case here**, or the
        //< start-up check stops on "Grammar sync error" (ksplc/docs/DESIGN.md §1.3).
        switch r
        case .k_unknown, .k_max
            return ""
        case .k_underscore
            return "_"
        case .k_keyword
            return "Keyword"
        case .k_attribute_prefix
            return "Attribute_prefix"
        case .k_directive_prefix
            return "Directive_prefix"
        case .k_identifier
            return "Identifier"
        case .k_string
            return "String"
        case .k_string_part
            return "String_part"
        case .k_string_expr
            return "String_expr"
        case .k_string_content
            return "String_content"
        case .k_format_spec
            return "Format_spec"
        case .k_literal
            return "Literal"
        case .k_integer
            return "Integer"
        case .k_float
            return "Float"
        case .k_bool
            return "Bool"
        case .k_null
            return "Null"
        case .k_char
            return "Char"
        case .k_primitive_type
            return "Primitive_type"
        default
            return r.variant_name().sub_from(2)

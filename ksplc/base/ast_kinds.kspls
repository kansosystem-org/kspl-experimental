  k_literal
  k_integer
  k_float
  k_bool
  k_null
  k_char
  k_primitive_type
  k_max

impl Ast_kind
  fn builtin_name(r: Self): U8[]
    switch r case .k_unknown
      return ""
    case .k_empty
      return "empty"
    case .k_underscore
      return "_"
    case .k_keyword
      return "Keyword"
    case .k_file
      return "file"
    case .k_decl_directive
      return "decl_directive"
    case .k_attribute_prefix
      return "Attribute_prefix"
    case .k_directive_prefix
      return "Directive_prefix"
    case .k_enum_payload
      return "enum_payload"
    case .k_stmt_goto

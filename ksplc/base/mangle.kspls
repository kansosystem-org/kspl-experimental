//< Turns KSPL's names and type names into C / LLVM identifiers
//<
//< Caution: **Do not write a copy of this in each caller**, or one type gets two names, and that
//< shows only at link time. The words of a type name (`core.immut_mark` / `slice_fqn`) live in
//< `ksplc/base/core.kspls`.
//< **These are extension methods, so a caller must import this file** ("An extension method
//< requires the import" in `docs/SPEC-language.md`).
import "ksplc/base/core"
import "std/str" { Str_builder }

impl U8[]
  fn find_char_out(r: U8[], ch: U8): I32
    $depth: = 0
    for $i: = 0; i < r.len; i += 1
      if r.starts_with("<|", i)
        depth += 1
        i += 1
      else if r.starts_with("|>", i)
        if depth > 0
          depth -= 1
        i += 1
      else if (r.ptr + i)$ == ch && depth == 0
        return i
    return -1

  fn rfind_char_out(r: U8[], ch: U8): I32
    $depth: = 0
    for $i: = I32::r.len - 1; i >= 0; i -= 1
      if i >= 1 && (r.ptr + i - 1)$ == '|' && (r.ptr + i)$ == '>'
        depth += 1
        i -= 1
      else if i >= 1 && (r.ptr + i - 1)$ == '<' && (r.ptr + i)$ == '|'
        if depth > 0
          depth -= 1
        i -= 1
      else if (r.ptr + i)$ == ch && depth == 0
        return i
    return -1

  fn mangle_c_identifier_to(r: U8[], w: Writer): Writer
    $res: = w
    $pending_under: = false
    $has_output: = false
    for i in Range.asc(r.len)
      c: = (r.ptr + i)$
      if !c.is_alnum()
        if has_output
          pending_under = true
      else
        if pending_under
          res = res.c('_')
          pending_under = false
        res = res.c(c)
        has_output = true
    return res

  fn mangle_c_identifier(r: U8[]): Str_builder
    res: = Str_builder.new()
    r.mangle_c_identifier_to(res)
    return res

  fn mangle_type_name_to(r: U8[], w: Writer): Writer
    $res: = w
    $pending_under: = false
    $has_output: = false

    for $i: = 0; i < r.len;
      // core.immut_mark becomes "Const" after what it qualifies (`U8 immut[]` -> `U8_Const_Slice`).
      // mangle_type_id_to_impl in sema/type/env.kspls places it elsewhere, but this one names only
      // symbols (monomorphization instances), never types, so the two do not collide.
      if r.sub_from(i).starts_with(core.immut_mark)
        if has_output
          res = res.s("_")
        res = res.s("Const")
        pending_under = false
        has_output = true
        i += I32::core.immut_mark.len
        continue
      if i + 1 < r.len && (r.ptr + i)$ == '[' && (r.ptr + i + 1)$ == ']'
        if has_output
          res = res.s("_")
        // Do not write the name inline; its canonical source is slice_ident in core.kspls.
        res = res.s(core.slice_ident())
        pending_under = false
        has_output = true
        i += 2
        continue

      c: = (r.ptr + i)$
      $word: = ""
      switch c case '@'
        word = "Ptr"
      case '?'
        word = "Result"
      case '['
        word = "Array_"
      case '.', '/', '\\', '<', ',', '|', '(', ')', ':', ' ', '!'
        if has_output
          pending_under = true
      case ']', '*', '>' { // Ignore
      } default
        // Anything but a C identifier's characters (ASCII [A-Za-z0-9_]) becomes a separator: a
        // path in a type name's prefix may hold others ("OneDrive - Kanso System").
        if c.is_alnum()
          if pending_under
            res = res.s("_")
            pending_under = false
          res = res.c(c)
          has_output = true
        else if has_output
          pending_under = true

      if word.len > 0
        if has_output
          res = res.s("_")
        res = res.s(word)
        pending_under = false
        has_output = true
      i += 1
    return res

  fn mangle_type_name(r: U8[]): Str_builder
    res: = Str_builder.new()
    r.mangle_type_name_to(res)
    return res

  fn is_mut_binding_kw(r: Self): Bool //<
    //< Whether a binding keyword makes the binding mutable
    //<
    //< "let" / "var" / "var_synth" are marks set by parse/normalize_decl.kspls, not grammar: `$x`
    //< -> "var", unmarked -> "let", a synthesized one (a for-in expansion) -> "var_synth".
    return !r.equals("let") && !r.equals("const")

  fn get_clean_base_type(r: U8[]): U8[] //<
    //< It returns the base type name without the trailing pointer `@` and the immutability mark
    //<
    //< Where a type id exists, use `Env.base_type_name` in sema/type/env.kspls (the same operation,
    //< done on the type's structure). This one is only a fallback for **type names taken from an
    //< AST that has no types yet**; its only caller is the check for unresolved dependencies in
    //< gen/c/root.kspls.
    $s1: = r
    // The mark may sit inside the `@` (`U8 immut@`), so the two are removed in turn.
    for s1.ends_with("@") || s1.ends_with(core.immut_mark)
      if s1.ends_with("@")
        s1 = s1.sub(0, s1.len - 1)
      else
        s1 = s1.sub(0, s1.len - core.immut_mark.len)
    return s1

//< Where the on-disk cache lives, and the "identity of ksplc itself" that caches share
//< Note: It lives in base, below its users (`ksplc/parse/ast_cache.kspl`, `ksplc/tools/run.kspl`
//< and `ksplc/fmt/file.kspl`), since the parse layer must not import a tool.
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/math"
import "std/mem" { Arena, dealloc }
import "std/sha256"
import "std/str" { Str_builder }
import "std/strnum"
import "std/sys"

const CACHE_ENV_NAME: U8[] = "KSPLC_CACHE_DIR" //< the variable that sets the cache folder
    //< It is also the fallback where neither HOME nor LOCALAPPDATA gives a folder.

const AST_KIND: U8[] = "ast" //< the kinds of cache, one subfolder each
    //< The path is `<cache folder>/<kind>/…`.
    //< Caution: Add each new kind to clear_all too, or `ksplc clean` silently leaves it behind.
const RUN_KIND: U8[] = "run"
const FMT_KIND: U8[] = "fmt"

fn exit_unlocated(tool: U8[]) //< it ends a command that finds no folder for its cache
    //< `tool` names the command in the message (`ksplc`, `ksplc run`).
    //< Caution: **Always name the fix** (the environment variable). In an environment with neither
    //< HOME nor LOCALAPPDATA it is the only way to set the folder.
    io.err().s(tool).s(": cannot locate a cache directory. Set \{CACHE_ENV_NAME\} to choose one\n")
    sys.exit(1)

fn refused_root(root: U8[], arena: Arena$@): U8[] //<
    //< Why the cache folder cannot be used; empty where it can
    //< **What it holds is built into the user's programs.** A normalized AST can carry inline
    //< assembly, and `ksplc run` runs what it finds there. So a folder that another user could
    //< write is refused, as git refuses a repository another user owns ("A cache folder that others
    //< can write is refused" in `std/docs/DESIGN-system.md`). This user makes a missing folder here
    //< first. If that fails, the caller's own creation reports it.
    fs.mkdir_all(root) catch {}
    switch fs.dir_trust(root)
    case .foreign
        return arena.text()
            .s("the cache directory \{root\} belongs to another user. A file planted there would be \
                built into your programs. Set \{CACHE_ENV_NAME\} to a directory of your own").take()
    case .shared
        return arena.text()
            .s("the cache directory \{root\} can be written by its group or by everyone. A file \
                planted there would be built into your programs. Run 'chmod go-w \{root\}', or set \
                \{CACHE_ENV_NAME\} to a directory of your own").take()
    default
        return ""

fn exit_refused(tool: U8[], why: U8[]) //< it ends a command whose cache folder is refused
    io.err().s(tool).s(": ").s(why).c('\n')
    sys.exit(1)

priv $root_warned: Bool = false //<
    //< whether the AST cache's refusal has been reported in this process

fn append_cache_root(out: Str_builder$@): Bool //< it writes the cache folder into out
    //< True where a folder was found. It follows XDG's convention; Windows uses %LOCALAPPDATA%.
    explicit: = sys.get_env(CACHE_ENV_NAME).unwrap_or("")
    if explicit.len > 0
        out.s(explicit)
        return true
    xdg: = sys.get_env("XDG_CACHE_HOME").unwrap_or("")
    if xdg.len > 0
        out.s(xdg).s("/ksplc")
        return true
    local_app: = sys.get_env("LOCALAPPDATA").unwrap_or("")
    if local_app.len > 0
        out.s(local_app).s("/ksplc/cache")
        return true
    home: = sys.get_env("HOME").unwrap_or("")
    if home.len > 0
        out.s(home).s("/.cache/ksplc")
        return true
    return false

fn append_self_identity(out: Str_builder$@): Bool //<
    //< It writes into out the name that tells this build of ksplc apart
    //< **It must be part of the cache's key.** The grammar (`ksplc/kspl.kspeg`) and the
    //< normalization live inside ksplc. So a rebuilt ksplc can answer the same source differently.
    //< Caution: On false, do not use the cache at all, rather than use it without the key.
    cmd_args: = sys.args()
    self_path: = cmd_args[0]
    info: = fs.stat(self_path) catch fs.File_info::{ .size = 0, .kind = .other, .mtime = 0 }
    if info.size <= 0
        return false
    out.s("\{self_path\}\0\{info.size\}\0\{info.mtime\}\0")
    return true

const HASH_HEX_LEN: Sz = sha256.HEX_LEN //< a sha256 as 64 hexadecimal characters
    //< It is the cache's file name, and the key written inside it.

typedef Hash_hex = U8[HASH_HEX_LEN]

fn hash_hex(data: U8[]): Hash_hex //< the digest as fixed-size text, without allocating
    hex: U8[HASH_HEX_LEN] = ::{}
    sha256.write_hex(sha256.hash(data), U8$[]::hex)
    return hex

// ==========================================
// Cleaning the cache. A rebuilt ksplc cannot use any entry the old one made (the key holds ksplc's
// identity). So **without cleaning, the cache grows by megabytes per build**. It is split into
// folders with hexadecimal names. Old ones are removed only when a new one is created.
// ==========================================
priv const GEN_NAME_LEN: Sz = 16

priv const MAX_GENERATIONS: Sz = 8 //< how many generations are kept
    //< Caution: **Do not make it too small.** The self-hosting check runs seed / stage1 / stage2
    //< and the LLVM backend's build: **different ksplcs in turn**. The maximum size is the count ×
    //< one generation's size, tens of MB once `--define` variants add up in one.

priv fn is_hex_digit(c: U8): Bool
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')

priv fn is_hex_name(name: U8[], name_len: Sz): Bool //<
    //< Whether a name is one the cleaning can remove (name_len hexadecimal digits)
    //< Caution: **Check this before removing**, so anything unrelated in the folder stays.
    if name.len != name_len
        return false
    for i in Range.asc(name.len)
        if !is_hex_digit((name.ptr + i)$)
            return false
    return true

priv fn is_own_dir(path: U8[]): Bool //< whether it is a folder itself, not a link to one
    //< Caution: **Do not descend through a link.** The cleaning removes what it lists. So a link
    //< planted in a shared cache (`run/<hex>` pointing at a home folder) would make it empty the
    //< target. Inside a folder, the link itself is removed (`fs.remove_path` does not follow it).
    //< At the top it is left alone, like anything else the cleaning does not recognise.
    return !fs.is_link(path) && fs.is_dir(path)

priv fn remove_cache_dir(dir: U8[], levels: Sz, arena: Arena$@): Bool //<
    //< It removes the files in a folder the cleaning chose, then the folder itself
    //< True on success. **It goes at most `levels` folders deep**, counting `dir` as one: two for
    //< a `ksplc run` slot, whose `obj/` is one level below. It gives up at a subfolder below that,
    //< so it removes nothing unexpected.
    names: = fs.read_dir(dir, arena) catch
        return false
    for name in names
        child: = fs.join(dir, name, arena)
        if is_own_dir(child)
            if levels <= 1 || !remove_cache_dir(child, levels - 1, arena)
                return false // an unexpected layout; leave it alone
            continue
        fs.remove_path(child) catch
            return false
    fs.remove_path(dir) catch
        return false
    return true

priv const USED_MARKER: U8[] = "used" //< the "last used" mark, holding that time in seconds
    //< **The folder's own time is not enough.** A hit writes nothing, so the time stays old and
    //< **the most used slot would be the first removed**.
    //< The time is written in the file rather than read from its metadata. So prune_dirs compares
    //< against the clock that wrote it, and a test can create a slot last used an hour ago.

fn touch_dir(dir: U8[], arena: Arena$@) //< it marks dir as "used just now"
    //< Caution: **Call it every time**, or a slot removed mid-run makes that process fail for no
    //< visible reason.
    path: = fs.join(dir, USED_MARKER, arena)
    io.write_file(path, arena.text().s("\{sys.wall_seconds()\}").take()) catch {}

priv fn used_time(dir: U8[], dir_time: I64, arena: Arena$@): I64 //< the time dir was last used
    //< The time the mark holds; where it holds none (empty, or no mark), the newer of the mark
    //< file's own time and the folder's.
    path: = fs.join(dir, USED_MARKER, arena)
    info: = fs.stat(path) catch
        return dir_time
    file_time: = math.max(info.mtime, dir_time)
    text: = io.read_file(path, null) catch
        return file_time
    defer dealloc(Void$@::text.ptr)
    return text.to_i64() catch file_time

fn prune_dirs(base_dir: U8[], name_len: Sz, keep: Sz, spare_secs: I64, live: U8[], arena: Arena$@) //<
    //< It removes the least recently used folders under `base_dir`, keeping keep of them
    //< It looks only at folders named by name_len hexadecimal digits. Beyond keep, it also spares
    //< any used within the last spare_secs seconds.
    //< `live` (in use now) is never removed but counts towards keep. A spare_secs of 0 spares none.
    //< Caution: **Call it only when a new folder was created**, or every hit reads the folder too.
    names: = fs.read_dir(base_dir, arena) catch
        return
    $kept: = List<|U8[]|>.new(arena)
    $times: = List<|I64|>.new(arena)
    $room: = keep
    for name in names
        if !is_hex_name(name, name_len)
            continue
        full: = fs.join(base_dir, name, arena)
        if !is_own_dir(full)
            continue
        if full.equals(live)
            room = room - 1 if room > 0 else 0
            continue
        info: = fs.stat(full) catch
            continue
        kept.push(full)
        times.push(used_time(full, info.mtime, arena))
    if kept.len <= room
        return
    // Keep the newest. The count is about keep, so it removes the oldest in a loop, not sorting.
    cutoff: = sys.wall_seconds() - spare_secs
    for kept.len > room
        $oldest: Sz = 0
        for i in Range.new(1, kept.len, 1)
            if times.get(i) < times.get(oldest)
                oldest = i
        // Caution: **Stop at the first one used within spare_secs.** It can be another process's,
        // still being written, and every one left is newer still.
        if spare_secs > 0 && times.get(oldest) >= cutoff
            return
        remove_cache_dir(kept.get(oldest), 2, arena)
        kept.set(oldest, kept.get(kept.len - 1))
        times.set(oldest, times.get(kept.len - 1))
        kept.len -= 1
        times.len -= 1

fn append_generation_dir(kind: U8[], out: Str_builder$@, arena: Arena$@): Bool //<
    //< It writes `<cache folder>/<kind>/<generation>` into out and creates that folder
    //< False where no folder is found (then no cache). Old generations go only when one is created.
    defer $self_id: = Str_builder.new()
    if !append_self_identity(self_id@)
        return false
    hex: = hash_hex(self_id.slice())

    defer $root: = Str_builder.new()
    if !append_cache_root(root@)
        return false
    // A refused folder costs only the cache, so the compile goes on without it, said once.
    why: = refused_root(root.slice(), arena)
    if why.len > 0
        if !root_warned
            root_warned = true
            io.err().s("ksplc: not using the cache: ").s(why).c('\n')
        return false
    base_dir: = fs.join(root.slice(), kind, arena)
    dir: = fs.join(base_dir, (U8[]::hex).sub(0, GEN_NAME_LEN), arena)
    is_new: = !fs.is_dir(dir)
    fs.mkdir_all(dir) catch
        return false
    // Nothing is spared: a generation removed mid-run only costs that run some misses, since every
    // write into it is a rename that can fail.
    if is_new
        prune_dirs(base_dir, GEN_NAME_LEN, MAX_GENERATIONS, 0, dir, arena)
    out.s(dir)
    return true

fn clear_all(out: Str_builder$@, arena: Arena$@): Bool //<
    //< It removes everything in the cache folder and writes that folder's path into out
    //< False where no folder is found. Only folders with hexadecimal names go, so a
    //< `KSPLC_CACHE_DIR` that holds other things loses nothing else.
    if !append_cache_root(out)
        return false
    why: = refused_root(out.slice(), arena)
    if why.len > 0
        exit_refused("ksplc", why)
    prune_dirs(fs.join(out.slice(), AST_KIND, arena), GEN_NAME_LEN, 0, 0, "", arena)
    prune_dirs(fs.join(out.slice(), RUN_KIND, arena), HASH_HEX_LEN, 0, 0, "", arena)
    prune_dirs(fs.join(out.slice(), FMT_KIND, arena), GEN_NAME_LEN, 0, 0, "", arena)
    return true

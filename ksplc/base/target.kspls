//< The machines ksplc lays a value out for, and the one this compile is for
//<
//< **This table is the only place a machine's widths are written.** The layout
//< (`calc_type_layout` in `../sema/decl/layout.kspls`), `Sz`'s width and genllvm's triple read it;
//< a number folded from it is checked by the C compiler at the line that folded it
//< ("A folded layout number is checked by the C compiler" in `../docs/DESIGN.md`).
import "ksplc/base/core" as base_core
import "ksplc/base/diag" as base_diag
import "std/str" { Str_builder }

struct Machine //< one machine, with the widths its C compiler lays a value out by
    name: U8[] //< the triple `--machine` takes, which the C compiler names the machine by too
    pointer_bytes: Sz //<
        //< a data pointer (`T@`), and so a slice's `ptr` and each half of a trait value
    fn_pointer_bytes: Sz //< a function pointer
    sz_bytes: Sz //< `Sz`, which is C's `ptrdiff_t`
    wide_align: Sz //< the alignment of an `I64`, a `U64` and an `F64` inside a struct
    llvm_triple: U8[] //<
        //< The `target triple` genllvm names, or empty where genllvm lays nothing out
        //<
        //< genllvm's IR is written for 8-byte pointers and `Sz` (`{ ptr, i64 }` slices), so a
        //< machine without a triple is refused `--to=llvm` rather than given wrong offsets.

const machines: Machine[8] = ::{
    Machine::{ .name = "x86_64-linux-gnu", .pointer_bytes = 8, .fn_pointer_bytes = 8, .sz_bytes = 8,
        .wide_align = 8, .llvm_triple = "x86_64-unknown-linux-gnu" },
    Machine::{ .name = "aarch64-linux-gnu", .pointer_bytes = 8, .fn_pointer_bytes = 8,
        .sz_bytes = 8, .wide_align = 8, .llvm_triple = "aarch64-unknown-linux-gnu" },
    Machine::{ .name = "x86_64-apple-darwin", .pointer_bytes = 8, .fn_pointer_bytes = 8,
        .sz_bytes = 8, .wide_align = 8, .llvm_triple = "x86_64-apple-darwin" },
    Machine::{ .name = "arm64-apple-darwin", .pointer_bytes = 8, .fn_pointer_bytes = 8,
        .sz_bytes = 8, .wide_align = 8, .llvm_triple = "arm64-apple-darwin" },
    Machine::{ .name = "x86_64-w64-windows-gnu", .pointer_bytes = 8, .fn_pointer_bytes = 8,
        .sz_bytes = 8, .wide_align = 8, .llvm_triple = "x86_64-w64-windows-gnu" },
    Machine::{ .name = "thumbv7m-none-eabi", .pointer_bytes = 4, .fn_pointer_bytes = 4,
        .sz_bytes = 4, .wide_align = 8, .llvm_triple = "" },
    Machine::{ .name = "thumbv6m-none-eabi", .pointer_bytes = 4, .fn_pointer_bytes = 4,
        .sz_bytes = 4, .wide_align = 8, .llvm_triple = "" },
    Machine::{ .name = "wasm32-unknown-unknown", .pointer_bytes = 4, .fn_pointer_bytes = 4,
        .sz_bytes = 4, .wide_align = 8, .llvm_triple = "" },
} //<
    //< Every machine ksplc knows, the one it runs on among them
    //<
    //< Caution: **Spell a row's name as `kspl_host_machine` in `../gen/runtime/hosted.c` builds
    //< it**: on a machine whose name is missing here, ksplc refuses to compile without `--machine`.

fn find(name: U8[]): Option<|Machine|> //< the machine of that name, or none where none is known
    for m in machines
        if m.name.equals(name)
            return Option<|Machine|>.some(m)
    return Option<|Machine|>.none

fn known_names_to(out: Str_builder$@) //< every machine's name, separated by `, `, onto out
    for i in Range.asc(machines.len)
        out.s(", " if i > 0 else "").s(machines[i].name)

extern "C"
    fn kspl_host_machine(buf: U8$@, cap: Sz): Sz //< the machine ksplc was compiled for; else 0

priv $host_known: Bool = false
priv $host_answer: U8[] = ""

fn host_name(): U8[] //< the machine ksplc runs on, as the triple its C compiler's macros give
    if host_known
        return host_answer
    $buf: U8[64] = ::{}
    n: = kspl_host_machine(buf[0]@, 64)
    host_answer = base_core.perm_arena.dup_str(U8[]::{ .ptr = buf[0]@, .len = n })
    host_known = true
    return host_answer

fn named_name(): U8[] //<
    //< the machine this compile is for: `--machine`'s, else the one ksplc runs on
    return base_core.config.machine if base_core.config.machine.len > 0 else host_name()

fn current(): Machine //< the machine this compile lays values out for
    //<
    //< Caution: **Refuse an unknown name before analysing** (`machine_refusal` in
    //< `../usage.kspls`, for every subcommand that lays values out): here an unknown one is a
    //< broken invariant, not the user's mistake.
    switch find(named_name()) case .some(m)
        return m
    case .none {}
    base_diag.ice_assert(false, "base_target.current: the machine was not checked before use")
    return machines[0]

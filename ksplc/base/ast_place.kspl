//< The syntactic predicates: what a node's kinds and children alone tell
//< **They answer a different question from the accessors (the `get_*` of `ast_ext.kspl`).**
//< Sema and Lower ask the same functions, so the two never judge one shape apart.
//< Caution: **Whether a node names a place is not here**: it needs types. `p.x` through a pointer
//< is a place and `f().x` is not, so `is_place_expr` and its kin are `Env`'s
//< (`sema/type/query.kspl`).
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "std/ds"

impl Ast_node
    fn has_side_effect(r: Self$@): Bool
        if r == null
            return false
        k: = r.kind_id
        if k == .k_method_access || k == .k_enum_init_call || k == .k_expr_catch ||
            k == .k_stmt_switch || k == .k_stmt_if
            return true
        if k == .k_expr_postfix
            op: = r.get_postfix_op()
            if op != null && op.text.equals("(")
                return true
        if k == .k_assign_op || k == .k_stmt_expr
            return true
        for child in r.children
            if child.has_side_effect()
                return true
        return false

    fn is_trait_index_access(r: Self$@): Bool
        if r == null || r.kind_id != .k_expr_postfix || r.def_node == null
            return false
        op: = r.get_postfix_op()
        return op != null && op.text.equals("[")

    fn spells_readonly_ptr(r: Self@): Bool //<
        //< Whether a type name's **outermost postfix** is a read-only pointer (`@`)
        //< **It reads the names; there is no type id yet.** The outermost is **the last** postfix
        //< (`U8$[]@`: `$[]`, then `@`).
        if r == null
            return false
        $last: Ast_node$@ = null
        for p in r.children
            if p.kind_id == .k_type_postfix
                last = p
        return last != null && last.text.equals("@")

    fn is_path_or_ident(r: Self$@): Bool
        if r == null
            return false
        k: = r.kind_id
        return k == .k_identifier || k == .k_expr_path || k == .k_type_path || k == .k_generic_path

    priv fn spells_same_place(r: Self$@, other: Self$@): Bool //<
        //< Whether both spell one place that reading runs no code for: a name, or its fields
        //< `a`, `a.b.c` and `(a).b` qualify. An index, a call or a cast does not: `xs[i]` checks
        //< its bound and may stop, so two of them are not one read. The two names stand in one
        //< expression or statement, so they bind the same declaration.
        a: = r.without_parens()
        b: = other.without_parens()
        if a == null || b == null
            return false
        if a.is_path_or_ident() && b.is_path_or_ident()
            return a.text.len > 0 && a.text.equals(b.text)
        if a.kind_id != .k_expr_postfix || b.kind_id != .k_expr_postfix ||
            !a.postfix_op_text().equals(".") || !b.postfix_op_text().equals(".")
            return false
        am: = a.get_postfix_member()
        bm: = b.get_postfix_member()
        return am != null && bm != null && am.text.len > 0 && am.text.equals(bm.text) &&
            a.get_postfix_receiver().spells_same_place(b.get_postfix_receiver())

    fn spells_same_value(r: Self$@, other: Self$@): Bool //<
        //< Whether both are one expression, written alike, that runs no call: it gives one value
        //< `x`, `p.n`, `(a ^ b)` and `xs[i] + 1` qualify; `f()` does not. A check it holds (an
        //< index's bound) gives the same answer both times.
        a: = r.without_parens()
        b: = other.without_parens()
        if a == null || b == null || a.kind_id != b.kind_id || !a.text.equals(b.text) ||
            a.children.len != b.children.len || a.has_side_effect()
            return false
        for i in Range.asc(a.children.len)
            if !a.get_child(i).spells_same_value(b.get_child(i))
                return false
        return true

    fn without_parens(r: Self$@): Self$@ //< the node inside any brackets around it
        $at: = r
        for at != null && at.kind_id == .k_expr_primary && at.has_parentheses()
            at = at.get_primary_inner_expr()
        return at

    fn is_self_assignment(r: Self$@): Bool //<
        //< Whether an assignment statement stores a place into itself, changing nothing
        //< `x = x`, `p.n = p.n`, and `b &= b` / `b |= b`, which give `b` back.
        if r == null || r.kind_id != .k_stmt_expr
            return false
        left: = r.get_assign_left()
        op: = r.get_assign_op()
        if left == null || op == null
            return false
        return (op.text.equals("=") || op.text.equals("&=") || op.text.equals("|=")) &&
            left.spells_same_place(r.get_assign_right())

    fn is_noreturn_call(r: Ast_node$@): Bool //<
        //< Whether it is a call to a function that declares `#noreturn`
        //< **The declaration is trusted**, as with C's `__attribute__((noreturn))`: if such a
        //< function does return, control continues with no value stored. What follows one is
        //< unreachable ([W0201], `df_stmt_expr` in `../sema/flow/track.kspl`).
        if r.kind_id != .k_expr_postfix
            return false
        op: = r.get_postfix_op()
        if op == null || !op.text.equals("(")
            return false
        $callee: = r.get_child(0)
        // A method's declaration hangs on its name (`r.ice_panic(…)`).
        if callee != null && callee.kind_id == .k_method_access
            callee = callee.get_postfix_member()
        return callee != null && callee.def_node != null &&
            callee.def_node.has_attribute("noreturn")

    fn is_endless_loop(r: Ast_node$@): Bool //<
        //< Whether this `for` never ends: it has no condition, and no `break` leaves it
        //< **The one judgement of a loop's end**, read by the missing-return check and the catch
        //< block's (`is_guaranteed_to_leave` in `../sema/body/analyze.kspl`) and by [W0201]
        //< (`df_stmt_for` in `../sema/flow/stmt.kspl`). `continue` does not leave the loop. A
        //< condition that is constant `true` still counts as a condition, which [W0205] asks to
        //< drop.
        if r == null || r.kind_id != .k_stmt_for || r.is_left_by_break()
            return false
        cond: = r.get_loop_cond()
        return cond == null || cond.kind_id == .k_empty

    fn has_vtable_slot(r: Ast_node$@): Bool //<
        //< Whether a trait's method holds a vtable slot (one with a default body does not)
        //< **This is the canonical source.** A default body is copied per implementation and has no
        //< slot, so a trait value cannot reach it. Only a concrete type or a type parameter calls
        //< it.
        return r != null && r.kind_id == .k_decl_fn_proto

    fn has_keyword(r: Ast_node@, kw: U8[]): Bool
        if r == null
            return false
        for c in r.children
            if c.kind_id == .k_keyword && c.text.equals(kw)
                return true
        return false

    fn has_literal_child(r: Ast_node@, text: U8[]): Bool
        if r == null
            return false
        for c in r.children
            if c.is_literal(text)
                return true
        return false

    fn is_const_param_default(r: Self$@): Bool //<
        //< whether it is a shape allowed as a default value
        //< The literals, a negative number, and the caller positions (`caller_file` /
        //< `caller_line`), which **the caller replaces with a literal** (fill_default_args in
        //< sema/body/call.kspl).
        return r.is_value_literal() || r.is_negative_number() || r.caller_loc_kind().len > 0

    fn is_negative_number(r: Self$@): Bool //<
        //< Whether it is a unary minus directly before a number literal (`-1`, `-1.5`)
        //< **A negative default is one value, as it reads** (`fn f(b: I32 = -1)`), while `-x` and
        //< `- -1` stay expressions. The minus and the digits are checked as one value against the
        //< type, as everywhere ("The rules that fix a literal's type" in the spec).
        if r.kind_id != .k_expr_unary || r.children.len < 2
            return false
        op: = r.get_unary_op()
        target: = r.get_unary_target()
        return op != null && op.text.equals("-") && target != null &&
            (target.kind_id == .k_integer || target.kind_id == .k_float)

    fn is_value_literal(r: Self$@): Bool //<
        //< Whether it is a value written out (a number, a character, a string, `true`, `null`)
        switch r.kind_id
        case .k_integer, .k_float, .k_bool, .k_char, .k_string, .k_null
            return true
        default
            return false

    fn caller_loc_kind(r: Self$@): U8[] //<
        //< Whether it is a default value pointing at the caller's position
        //< `"caller_file"` / `"caller_line"`, or empty.
        //< **They are accepted only as a default value, on purpose**: that position takes no other
        //< identifier, so these never hide a user's name.
        switch r.kind_id
        case .k_identifier, .k_expr_path {}
        default
            return ""
        if r.text.equals("caller_file") || r.text.equals("caller_line")
            return r.text
        return ""

    fn was_parenthesized(r: Self@): Bool //<
        //< Whether normalization (elide_node) removed parentheses around it
        //< The mark it leaves is the inner node's ival (-1, -2, ... per layer).
        //< The k_expr_primary is gone by then, so this is the lint's only clue. True for any count.
        return r != null && r.ival < 0

    fn has_redundant_extra_parens(r: Self@): Bool //<
        //< Whether it is wrapped in two or more layers of parentheses
        //< The outer layer is always unwanted, even where precedence needs the inner one: it
        //< changes neither the meaning nor the safety.
        return r != null && r.ival <= -2

    fn is_postfix_safe_kind(r: Self$@): Bool //<
        //< Whether it can be a postfix operator's operand without parentheses
        //< (`.` `[` `(` `@` `$` `::` `!`). The grammar starts an expr_postfix at an expr_primary
        //< only, so a binary, unary, ternary, catch, sizeof or upcast is not included.
        if r == null
            return false
        k: = r.kind_id
        return k == .k_expr_postfix || k == .k_identifier || k == .k_expr_path || k == .k_literal ||
            k == .k_integer || k == .k_float || k == .k_bool || k == .k_null || k == .k_char ||
            k == .k_string || k == .k_string_interp || k == .k_primitive_type ||
            k == .k_expr_implicit_dot || k == .k_expr_compound || k == .k_expr_primary ||
            k == .k_method_access || k == .k_generic_method || k == .k_generic_path ||
            k == .k_enum_init || k == .k_enum_init_call || k == .k_implicit_enum ||
            k == .k_struct_literal

    fn is_plain_name(r: Self$@): Bool //< whether it is spelled as one name
        //< An identifier or a path of one segment. A switch's subject has to be one (genc writes it
        //< more than once), so Lower binds any other to a temporary.
        k: = r.kind_id
        return k == .k_identifier || k == .k_type_path || k == .k_generic_path ||
            (k == .k_expr_path && r.children.len <= 1)

    fn is_member_access(r: Self$@): Bool //<
        //< Whether it is a member-access node kind (lsp/hover.kspl asks it in several places)
        return r.kind_id == .k_expr_postfix || r.kind_id == .k_method_access

    fn is_prefix_cast_result(r: Self$@): Bool //<
        //< Whether a cast was written prefixed, "Type::(value)"
        //< Normalization gives it the same shape as a postfix "value::Type" ([value, "::", Type]).
        //< The prefix form is not an expr_primary, so a following postfix operation (.field) needs
        //< parentheses; the postfix one does not.
        return r != null && r.kind_id == .k_expr_postfix && r.text.equals("::") &&
            r.children.len == 3 && r.loc.offset != r.get_child(0).loc.offset

    fn is_explicit_cast(r: Self$@): Bool //<
        //< Whether it is an explicit cast's result
        //< A prefix `Type::(v)` and a postfix `v::Type` are both normalized to a postfix `::`.
        //< It decides whether the value can escape immutability.
        if r == null || r.kind_id != .k_expr_postfix || r.children.len < 2
            return false
        op: = r.safe_get_child(1)
        return op != null && op.text.equals("::")

    fn has_explicit_cast_in_chain(r: Self$@): Bool //<
        //< Whether there is an explicit cast anywhere on a postfix chain
        //< `is_explicit_cast` looks at **only the first operator**; a chain is flat (`[receiver,
        //< operator, operand, ...]`), so it misses the `::` of `a.b::C`.
        if r == null || r.kind_id != .k_expr_postfix
            return false
        for $i: = 1; i < r.children.len; i += 1
            if r.get_child(i).text.equals("::")
                return true
        return false

    fn is_default_arm(r: Self@): Bool //< whether a lowered `switch` arm is its `default`
        return r.text.equals("default")

    fn is_generic_template(r: Self@): Bool
        if r == null
            return false
        for c in r.children
            if c.kind_id == .k_type_gen_params
                return true
            if (c.kind_id == .k_type_expr || c.kind_id == .k_type_fn_sig) &&
                c.find_child(.k_type_gen_params) != null
                return true
        return false

    fn is_const_gen_param(r: Self$@): Bool //<
        //< Whether one type parameter is `const` (`const N: Sz`)
        //< Caution: **Ask this rather than looking for the keyword**, as with gen_param_name.
        if r == null || r.kind_id != .k_type_gen_param
            return false
        kw: = r.find_child(.k_keyword)
        return kw != null && kw.text.equals("const")

    fn has_variadic_param(r: Self$@): Bool
        params: = r.get_fn_params()
        if params == null
            return false
        for p in params.children
            if p.text.equals("...")
                return true
        return false

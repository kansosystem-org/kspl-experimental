//< The syntactic expression predicates: what a node's kinds and children alone tell
//< **They answer a different question from the accessors (the `get_*` of `ast_ext.kspl`).**
//< Sema and Lower ask the same functions, so the two never judge one shape apart.
//< Caution: **Whether a node names a place is not here**: it needs types. `p.x` through a pointer
//< is a place and `f().x` is not, so `is_place_expr` and its kin are `Env`'s
//< (`sema/type/query.kspl`).
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "std/str"

impl Ast_node
    fn has_side_effect(r: Self$@): Bool
        if r == null
            return false
        k: = r.kind_id
        if k == .k_method_access || k == .k_enum_init_call || k == .k_expr_catch ||
            k == .k_stmt_switch || k == .k_stmt_if
            return true
        if k == .k_expr_postfix
            op: = r.get_postfix_op()
            if op != null && op.text.equals("(")
                return true
        if k == .k_assign_op || k == .k_stmt_expr
            return true
        for child in r.children
            if child.has_side_effect()
                return true
        return false

    fn is_trait_index_access(r: Self$@): Bool
        if r == null || r.kind_id != .k_expr_postfix || r.def_node == null
            return false
        op: = r.get_postfix_op()
        return op != null && op.text.equals("[")

    fn spells_readonly_ptr(r: Self$@): Bool //<
        //< Whether a type name's **outermost postfix** is a read-only pointer (`@`)
        //< **It reads the names; there is no type id yet.** The outermost is **the last** postfix
        //< (`U8$[]@`: `$[]`, then `@`).
        if r == null
            return false
        $last: Ast_node$@ = null
        for p in r.children
            if p.kind_id == .k_type_postfix
                last = p
        return last != null && last.text.equals("@")

    fn is_path_or_ident(r: Self$@): Bool
        if r == null
            return false
        k: = r.kind_id
        return k == .k_identifier || k == .k_expr_path || k == .k_type_path || k == .k_generic_path

    fn is_callable_target(r: Self$@): Bool
        return r != null && r.is_path_or_ident()

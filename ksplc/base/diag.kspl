//< Printing a diagnostic: as text or one line of JSON on stderr, or kept for the language server
//< **`print_diagnostic` is the one writer for both forms** (`print_unplaced` for an error with no
//< place in a source). It counts the place once, so the text and the JSON never disagree. Under
//< the language server the findings are collected in `lsp_diags` instead. An internal compiler
//< error stops the run through `ice_panic` / `ice_assert`.
import "ksplc/base/as_written" as base_as_written
import "ksplc/base/core" as base_core
import "ksplc/base/locate" as base_locate
import "std/chars"
import "std/ds" { List, Map }
import "std/io"
import "std/json" + { Json_builder }
import "std/math"
import "std/mem" { Arena }
import "std/str" { Str_builder }

enum Diagnostic_severity: I32
    error = 1
    warning = 2
    information = 3
    hint = 4

impl Diagnostic_severity
    fn to_lsp_severity(r: Self@): I32 //<
        //< The number the LSP uses for this severity
        //< Caution: Take the receiver as read-only (`Self@`); a `Self$@` method cannot be called on
        //< a read-only value.
        return I32::r$

    fn name(r: Self): U8[] //< the word that heads a diagnostic, in the text and in JSON alike
        return r.variant_name()

fn code_of(msg: U8[]): U8[] //<
    //< Extracts CODE from a diagnostic's leading "[CODE] ..." (empty if it does not start with "[")
    if msg.len < 3 || (msg.ptr + 0)$ != '['
        return ""
    for i in Range.new(1, msg.len, 1)
        if (msg.ptr + i)$ == ']'
            return U8[]::{ .ptr = msg.ptr + 1, .len = i - 1 }
    return ""

struct Lsp_diagnostic
    file: U8$[]
    severity: Diagnostic_severity
    line: Sz
    col: Sz
    len: Sz
    msg: U8$[]

struct Lsp_diag_manager
    list: List<|Lsp_diagnostic|>
    seen: Map<|U8[], Bool|> //<
        //< The diagnostics already collected (file:line:column:severity:message)
        //< The keys live on the arena the LSP rewinds, so drop them **together with** list.
        //< Caution: **Do not look for duplicates by walking the list.** That is quadratic and slows
        //< the editor on a document with many findings.
$lsp_diags: Lsp_diag_manager = ::{}

impl Lsp_diag_manager
    fn clear(r: Self$@)
        r.list.clear()
        // A Map cannot be emptied, so it is created again; its keys live as long as list.
        r.seen.free()
        r.seen = Map<|U8[], Bool|>.new(null)

fn log(): Writer
    return io.err()

#noreturn
fn ice_panic(msg: U8$[])
    log()
        .s("\n=========================================\n[Internal Compiler Error] \
            \{msg\}\n=========================================\n")
    panic("ICE")

fn io_line(e: io.Io_error, kind: U8[]): U8[] //<
    //< One line naming an I/O failure, `<kind>/<variant>: <details>`, on the arena
    //< The parse phase's I/O errors, the top-level ones and the formatter's share it.
    out: = base_core.arena.text()
    switch e
    case .file_not_found(path)
        out.s("\{kind\}/file_not_found: file not found or unreadable: \{path\}\n")
    case .read_failed(path)
        out.s("\{kind\}/read_failed: failed to read file: \{path\}\n")
    case .write_failed(path)
        out.s("\{kind\}/write_failed: failed to write file: \{path\}\n")
    default
        out.s("\{kind\}/other: generic I/O error\n")
    return out.take()

fn ice_assert(cond: Bool, msg: U8$[])
    if !cond
        ice_panic(msg)

// One diagnostic as one line of JSON on stderr (`--diagnostic-format=json`; the keys and their
// meaning, the closing object's too, are "Diagnostics a program reads" in
// `ksplc/docs/SPEC-tools.md`). An unknown position is passed as zero and printed as `null`: a
// settings file gives only a line, and some errors have no place at all.
priv fn print_json(file: U8[], line: Sz, column: Sz, end_column: Sz, msg: U8[],
    severity: Diagnostic_severity, is_syntax: Bool)
    defer arena: = Arena.new(4096)
    $b: = Json_builder.new(arena)
    code: = code_of(msg)
    // The code has its own key, so the message drops its leading `[CODE] `.
    text: = msg.sub_from(code.len + 2).trim_start() if code.len > 0 else msg
    row: = b.obj().set("severity", b.str_val(severity.name()))
        .set("code", b.str_val(code) if code.len > 0 else b.null_val())
        .set("kind", b.str_val("syntax") if is_syntax else b.null_val())
        .set("message", b.str_val(text))
        .set("file", b.str_val(file) if file.len > 0 else b.null_val())
        .set("line", json_num(b@, line)).set("column", json_num(b@, column))
        .set("end_column", json_num(b@, end_column)).build()
    switch severity
    case .error
        json_written.errors += 1
    case .warning
        json_written.warnings += 1
    case .information
        json_written.informations += 1
    case .hint
        json_written.hints += 1
    print_json_row(row)

priv fn print_json_row(row: json.Value) //< one object as one line of stderr
    defer $out: = Str_builder.new()
    row.dump(out@)
    log().s(out.slice()).c('\n')

priv struct Json_written //< the objects `print_json` wrote, by severity
    errors: Sz
    warnings: Sz
    informations: Sz
    hints: Sz
priv $json_written: Json_written = ::{}

fn print_json_closing(succeeded: Bool) //<
    //< The closing object: the last line of a compile or lint that reached its verdict, under json
    //< **It counts the objects written above it**, not the analysis's tally. So a reader that
    //< counts the lines itself always gets the same numbers (an error the parse stopped on is in no
    //< tally).
    defer arena: = Arena.new(4096)
    $b: = Json_builder.new(arena)
    row: = b.obj().set("result", b.str_val("succeeded" if succeeded else "failed"))
        .set("errors", b.int_val(json_written.errors))
        .set("warnings", b.int_val(json_written.warnings))
        .set("informations", b.int_val(json_written.informations))
        .set("hints", b.int_val(json_written.hints)).build()
    print_json_row(row)

priv fn json_num(b: Json_builder$@, v: Sz): json.Value //< a position, or `null` where it is 0
    return b.null_val() if v == 0 else b.int_val(v)

fn print_unplaced(file: U8[], line: Sz, msg: U8[]) //<
    //< An error placed in no source: a settings file's line, or nowhere at all (`file` empty)
    if base_core.config.diag_json
        print_json(file, line, 0, 0, msg, .error, false)
    else if file.len > 0
        log().s(file).s(":\{line\}: error: ").s(msg).c('\n')
    else
        log().s("\nerror: ").s(msg).c('\n')

// The length of the mark passed to the LSP (in UTF-16 units).
// Caution: **Do not pass a byte count.** The LSP counts the column and the length in UTF-16
// units, so bytes make **the squiggle run over the next name after a non-ASCII one**. The
// column is `char_idx` (`disp_col` counts code points and drifts outside the BMP).
priv fn lsp_wide(source: U8[], offset: Sz, length: Sz, info: base_core.Line_info,
    starts: List<|Sz|>$@): Sz
    // Caution: **Do not make it 0** (a mark with no width does not show in an editor).
    if length == 0
        return 1
    // **Cut what crosses the line end**: this reports one line only.
    end_off: = source.len if offset + length > source.len else offset + length
    to: = source.get_line_info(end_off, starts)
    if to.line != info.line
        return 1
    wide: = to.char_idx - info.char_idx
    return 1 if wide == 0 else wide

fn shown_file(file_name: U8[]): U8[] //<
    //< A source's name as a diagnostic shows it, on the arena
    //< **The file is named so it can be opened.** A declared package's file is named by the path
    //< it was read from (`disk_name` in `locate.kspl`). Anything else is named by its logical name.
    //< Caution: **Do not copy the extension here.** base/core.kspl holds it (`with_source_ext`).
    //< With a copy, a renamed extension leaves the diagnostics on the old one.
    return base_core.arena.dup_str(base_locate.disk_name(file_name).with_source_ext())

fn print_diagnostic(file_name: U8[], source: U8[], offset: Sz, length: Sz, msg: U8[],
    severity: Diagnostic_severity, starts: List<|Sz|>$@)
    print_placed(file_name, source, offset, length, msg, severity, starts, false)

fn print_syntax_error(file_name: U8[], source: U8[], offset: Sz, msg: U8[],
    starts: List<|Sz|>$@) //<
        //< A syntax error, which a program reading the JSON form tells apart by its `kind`
        //< **An error has no code** (a code could be switched off). So the kind tells such a reader
        //< that the text could not be read, and that nothing after it was analysed.
    print_placed(file_name, source, offset, 1, msg, .error, starts, true)

priv fn print_placed(file_name: U8[], source: U8[], offset: Sz, length: Sz, msg: U8[],
    severity: Diagnostic_severity, starts: List<|Sz|>$@, is_syntax: Bool)
    out_file: = shown_file(file_name)

    actual_offset: = math.min(source.len, offset)
    info: = source.get_line_info(actual_offset, starts)
    line: = info.line
    column: = info.disp_col
    line_start: = info.line_start

    if base_core.config.is_lsp
        if base_core.arena != null
            defer $key_b: = Str_builder.new()
            key_b.s("\{out_file\}:\{line\}:\{column\}:\{severity.to_lsp_severity()\}:\{msg\}")
            key: = key_b.slice()
            if lsp_diags.seen@.get(key).unwrap_or(false)
                return
            perm_key: = base_core.arena.dup_str(key)
            lsp_diags.seen@.set(perm_key, true)
            dup: = base_core.arena.dup_str(msg)
            file_dup: = base_core.arena.dup_str(out_file)

            lsp_diags.list
                .push(Lsp_diagnostic::{ .file = file_dup, .severity = severity, .line = line - 1,
                .col = info.char_idx,
                .len = lsp_wide(source, actual_offset, length, info, starts),
                .msg = U8$[]::{ .ptr = dup.ptr, .len = dup.len } })
        return

    // It prints **the line as the writer typed it**.
    // Caution: **Do not print the rewritten line** (see the head of base/as_written.kspl).
    // The rewrite moves no line number. For a file with nothing stored the lookup returns empty;
    // then the text as read is printed.
    $line_text: = base_as_written.as_written_line(file_name, line)
    if line_text.len == 0
        $line_end: = line_start
        for line_end < source.len && (source.ptr + line_end)$ != '\n' &&
            (source.ptr + line_end)$ != '\r'
            line_end += 1
        line_text = U8[]::{ .ptr = source.ptr + line_start, .len = line_end - line_start }
    $num_digits: Sz = 1
    for $temp: = line; temp >= 10; temp /= 10
        num_digits += 1

    // The underline, **counted in characters like the column** (a byte count overruns a line with
    // non-ASCII): at least one, stopping at the line end. Both outputs use one count, so the JSON
    // and the carets never mark different text.
    end_info: = source.get_line_info(source.len if actual_offset + length > source.len
        else actual_offset + length, starts)
    line_chars: = line_text.count_codepoints()
    $span_len: Sz =
        (end_info.disp_col - column) if end_info.line == line else line_chars + 1 - column
    if column + span_len > line_chars + 1
        span_len = line_chars + 1 - column
    if span_len < 1
        span_len = 1
    if base_core.config.diag_json
        print_json(out_file, line, column, column + span_len, msg, severity, is_syntax)
        return

    // A line longer than the window shows only the part around the column, cut with `…` at
    // either end. **Printed whole, a generated or minified line fills the screen** and the caret
    // lands far below the text it marks. The position in the head stays the line's own.
    $first: Sz = 1
    $last: Sz = line_chars
    if line_chars > SHOWN_LINE_CHARS
        first = column - SHOWN_LINE_LEAD if column > SHOWN_LINE_LEAD else 1
        last = first + SHOWN_LINE_CHARS - 1
        if last > line_chars
            last = line_chars
            first = last - SHOWN_LINE_CHARS + 1
    cut_head: = first > 1
    cut_tail: = last < line_chars
    shown: = line_text.sub(byte_at_char(line_text, first - 1),
        byte_at_char(line_text, last) - byte_at_char(line_text, first - 1))
    if column + span_len - 1 > last + 1
        span_len = last + 1 - column if last + 1 > column else 1
    log_w: = log()
    log_w.s("\{out_file\}:\{line\}:\{column\}: \{severity.name()\}: \{msg\}\n")
    log_w.s("\{line\} | ").s("…" if cut_head else "").s(shown).s("…" if cut_tail else "")
        .s("\n")
    repeat_char(log_w, " ", num_digits)
    log_w.s(" | ")
    repeat_char(log_w, " ", column - first + (1 if cut_head else 0))
    repeat_char(log_w, "^", span_len)
    log_w.s("\n")

priv const SHOWN_LINE_CHARS: Sz = 120 //< the most characters of a source line a diagnostic shows
priv const SHOWN_LINE_LEAD: Sz = 40 //< how many characters before the column a cut line keeps

priv fn byte_at_char(text: U8[], n: Sz): Sz //<
    //< The byte offset where the `n`th character (from 0) starts, or the length past the last
    //< It counts characters as `count_codepoints` does (lead bytes only), so the two agree.
    $seen: Sz = 0
    for i in Range.asc(text.len)
        if ((text.ptr + i)$ & 0xC0U8) != 0x80U8
            if seen == n
                return i
            seen += 1
    return text.len

priv fn repeat_char(w: Writer, ch: U8[], count: Sz) //<
    //< It writes one character `count` times, for a diagnostic's gutter and underline
    for _i in Range.asc(count)
        w.s(ch)

impl Lsp_diag_manager: Manual_free
    fn free(r: Self$@)
        r.list.free()
        r.seen.free()

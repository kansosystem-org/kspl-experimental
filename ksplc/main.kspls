//< `ksplc`'s entry point: it reads the command line and starts the subcommand asked for
//<
//< **Each subcommand is a variant of `Mode`**, parsed by `std/argp` as a command, so a second
//< subcommand on one line is refused rather than one silently winning. The usage and the help text
//< are `usage.kspls`'s. A run that ends with heap still in use reports the leak and fails.
import "kspeg/engine" as kspeg
import "kspeg/notation" as kspeg_notation
import "ksplc/base/ast_kinds" as base_ast_kinds
import "ksplc/base/cache" as base_cache
import "ksplc/base/core" as base_core
import "ksplc/base/diag" as base_diag
import "ksplc/base/lint_codes" as base_lint_codes
import "ksplc/base/locate" as base_locate
import "ksplc/base/package" as base_package
import "ksplc/base/setup" as base_setup
import "ksplc/base/stats" as base_stats
import "ksplc/base/target" as base_target
import "ksplc/fmt/file" as fmt_file
import "ksplc/fmt/printer" as fmt_printer
import "ksplc/fmt/style" as fmt_style
import "ksplc/lsp/server" as lsp_server
import "ksplc/lsp/worker" as lsp_worker
import "ksplc/parse/load" as parse_load
import "ksplc/pipeline"
import "ksplc/tools/doc" as tools_doc
import "ksplc/tools/explain" as tools_explain
import "ksplc/tools/interface" as tools_interface
import "ksplc/tools/keywords" as tools_keywords
import "ksplc/tools/run" as tools_run
import "ksplc/tools/surface" as tools_surface
import "ksplc/usage"
import "std/argp"
import "std/chars"
import "std/ds" { List }
import "std/io"
import "std/mem" + { Arena }
import "std/str" { Str_builder }
import "std/strfmt"
import "std/strnum" // `to_i64` / `to_f64` / `parse_size`
import "std/sys"

embed "ksplc/kspl.kspeg" as kspl_grammar

priv const max_split_units: Sz = 256 //< `--split=`'s upper bound
    //<
    //< Each translation unit reads the whole shared header again, so **a split far beyond the core
    //< count is slower**. The bound catches an accident (a mistyped order of magnitude).

priv enum Mode //< what the tool was asked to do
    compile(in_path: U8[], out_path: U8[], deps_path: U8[], libs_path: U8[]) //<
        //< It translates one file.
        //<
        //< Where deps_path is not empty, the list of every source read is written there
        //< (`--emit-deps=`); where libs_path is not empty, the libraries the program names
        //< (`--emit-libs=`).
    fmt(in_files: List<|U8[]|>$@, in_place: Bool, config: fmt_style.Config, to: U8[])
    lsp
    lsp_worker
    lint(in_path: U8[])
    run(script: U8[], script_args: List<|U8[]|>$@) //<
        //< It builds a script and runs it, with the result cached (ksplc/tools/run.kspls).
    build(in_path: U8[], out_path: U8[], cflags: U8[]) //<
        //< It builds one executable, with cflags after ksplc's own flags (ksplc/tools/run.kspls).
    info(topic: usage.Info_topic) //<
        //< a query (`ksplc info <subject>`). It prints the answer and exits
    clean //<
        //< The cleanup (`ksplc clean`): it empties the disk cache
        //<
        //< It is kept apart from the query: on the same subcommand as a subject that only reads, a
        //< typo could become a deletion.
    emit_runtime(out_path: U8[]) //<
        //< It writes the C runtime's source out as one translation unit
        //<
        //< `--to=llvm`'s IR links against it ("The backends (Genc / Genllvm) and the runtime
        //< ABI" in ksplc/docs/DESIGN.md).
    explain(code: U8[]) //< it prints one diagnostic code's section of the tools specification
    doc(target: U8[]) //< it prints what a file, an entry or a folder publishes (`tools/doc.kspls`)

priv struct Cli //< what the command line asked for, before it is checked
    fmt_in_place: Bool
    to_name: U8[]
    fmt_config: fmt_style.Config
    script_args: List<|U8[]|>$@
    deps_path: U8[]
    libs_path: U8[]
    surface_scope: U8[]
    style: U8[]
    std_dir: U8[]
    pkg_src_dir: U8[]
    split_units: U8[]
    diag_format: U8[]
    cflags: U8[]
    lint_specs: List<|U8[]|>$@

priv fn declare_options(p: argp.Parser$@, o: Cli$@) //< it declares every subcommand and option
    // A mode is a command rather than a flag so that argp sees it set twice; as a flag,
    // `ksplc fmt --lsp` would pass and the later one would silently win.
    p.subcommand("fmt", "format the source")
    p.subcommand("lint", "do the static analysis alone")
    p.subcommand("lsp", "run as the language server")
    p.subcommand("lsp-worker", "run as the language server's analysis worker")
    p.subcommand_trailing("run", "build a script and run it", o.script_args)
    p.subcommand("build", "build an executable from a program")
    p.subcommand("info", usage.help_with_topics("answer a query", usage.info_topics()))
    p.subcommand("clean", "empty the disk cache")
    p.subcommand("emit-runtime", "write the C runtime's source out as one translation unit")
    p.subcommand("explain", "print what a diagnostic code means and what to do about it")
    p.subcommand("doc", "print what a file, one entry or a folder publishes, from its source")
    p.positional("<input.kspl>... [output]")
    p.str_list_opt("--define", base_core.config.defines,
        "define a flag for #cfg() (it can be repeated)")
    p.str_opt("--emit-deps", o.deps_path@, "where to write the list of every source read")
    p.str_opt("--emit-libs", o.libs_path@,
        "where to write the libraries the program names with #link, as -l words")
    p.str_opt("--emit-surface", base_core.config.surface_path@,
        "where to write the record of the API being published (for putting one version against \
            another)")
    p.str_opt("--surface-scope", o.surface_scope@,
        "what --emit-surface writes: pub (the default, what the package publishes) or all \
            (everything a sibling file may reach, for a package that publishes nothing)")
    p.str_opt("--machine", base_core.config.machine@,
        "the machine the output is for, as a triple (the default is the one ksplc runs on)")
    p.str_opt("--std-dir", o.std_dir@, "where to look for the standard library")
    p.str_opt("--pkg-src-dir", o.pkg_src_dir@,
        "where to look for the source of a package other than std")
    p.str_opt("--split", o.split_units@,
        "the number of translation units to split the generated C into (the default is 1)")
    p.str_opt("--cflags", o.cflags@,
        "flags for the C compiler, added after ksplc's own so the last one wins (\"-O0 -g\")")
    p.str_opt("--style", o.style@, "the formatting settings (\"IndentWidth: 4, ColumnLimit: 100\")")
    p.str_opt("--to", o.to_name@,
        "what the output is written in: a compile's c (the default) or llvm, fmt's kspl or kspls \
            (the default is the input's)")
    p.str_list_opt("--lint", o.lint_specs, "lint's CODE=off|on|error (it can be repeated)")
    p.str_opt("--diagnostic-format", o.diag_format@,
        "how diagnostics are written: text (the default) or json (one JSON object per line)")
    p.flag("--stats", base_core.config.enable_stats@,
        "put the time taken per phase out (for fmt, how often its cache answered)")
    p.flag("--freestanding", base_core.config.is_freestanding@,
        "generate for an environment with no OS")
    p.str_list_opt("--library", base_core.config.interface_paths,
        "build a library and write its interface there: a .h for C, a .kspls or .kspl for KSPL (it \
            can be repeated); only #export functions are visible outside it, its runtime and std \
            are its own")
    p.flag("--in-place", o.fmt_in_place@, "write the formatting result back into the source")

priv fn refuse_command_line(e: argp.Argp_error) //<
    //< it reports a command line argp refused, and exits
    switch e
    case .help_requested
        // On run, argp passes a `--help` after the script to the script, so this one is
        // ksplc's.
        usage.print_usage(io.out())
        sys.exit(0)
    case .unknown_option(n)
        // Caution: Never treat an unknown option as an input file name: a typo would be
        // ignored, and a path cut by the shell's word splitting would fail as file names,
        // cause unseen.
        io.err().s("Error: unknown option: \{n\}\n")
        usage.usage_exit()
    case .multiple_commands(_n)
        usage.error_exit("Error: Multiple execution modes specified.\n")
    default
        io.err().s("Error: \{e\}\n")
        usage.usage_exit()

priv fn apply_options(o: Cli$@, mode_name: U8[]) //<
    //< It checks the options every mode shares and puts them into the configuration
    // **An unknown name is rejected rather than replaced by the default.** Otherwise a mistyped
    // scope would write only the published API and look as though it had worked.
    if o.surface_scope.equals("all")
        base_core.config.surface_all = true
    else if o.surface_scope.len > 0 && !o.surface_scope.equals("pub")
        usage
            .error_exit(base_core.arena.text().s("--surface-scope: expected pub or all, not ")
            .s(o.surface_scope).c('\n').take())
    // Rejected rather than replaced by text, as `--surface-scope` is: a typo would look like a
    // tool reading no diagnostics at all.
    if o.diag_format.equals("json")
        base_core.config.diag_json = true
    else if o.diag_format.len > 0 && !o.diag_format.equals("text")
        usage.error_exit("--diagnostic-format: expected text or json\n")
    // `--to` names what the output is written in; a compile's languages are c and llvm.
    if mode_name.equals("compile") && o.to_name.equals("llvm")
        base_core.config.target = .llvm
    else if mode_name.equals("compile") && o.to_name.len > 0 && !o.to_name.equals("c")
        usage.error_exit("--to: a compile writes 'c' or 'llvm'\n")
    // `info` asks only on its `machine` subject, once the subject is read (below).
    if !mode_name.equals("info")
        check_machine(mode_name)
    if o.split_units.len > 0
        n: = o.split_units.to_i64() catch 0
        if n < 1 || n > I64::max_split_units
            usage.error_exit("--split: expected a number from 1 to 256\n")
        base_core.config.unit_count = Sz::n
    // Only the C backend can split: genllvm has no forward-declaration phase ("Genllvm (LLVM
    // IR): why the structure itself differs" in ksplc/docs/DESIGN.md) and emits the string pool
    // at the end. Accepting it without effect is not allowed (docs/DESIGN.md Principle 5).
    if base_core.config.unit_count > 1 && base_core.is_llvm_target()
        usage.error_exit("--split: only the C backend can split output into translation units.\n")
    if base_core.is_library()
        refuse_with_library()
        check_interface_paths()
    if base_core.config.is_freestanding
        // It ties is_freestanding to cfg(freestanding), so this flag alone enables std/sys's
        // freestanding panic and the like, with no --define=freestanding to remember.
        base_core.config.defines.push("freestanding")
    if o.style.len > 0
        // fmt_printer holds the name used in the diagnostic. Kept apart from the list of
        // accepted keys, the two would drift, and a newly added key would be missing from the
        // diagnostic.
        bad: = fmt_style.apply_style(o.style, o.fmt_config@, base_core.arena)
        if bad.len > 0
            usage.error_exit(bad)
    // Applied one at a time, in order; overwriting would keep only the last (so a
    // str_list_opt).
    for spec in o.lint_specs
        apply_lint_setting(spec)
    if o.std_dir.len > 0
        base_core.config.std_dir = o.std_dir
    if o.pkg_src_dir.len > 0
        base_core.config.pkg_src_dir = o.pkg_src_dir

priv fn only_input(in_files: List<|U8[]|>$@, refusal: U8[]): U8[] //<
    //< The one input a subcommand takes; any other count exits with `refusal`, its usage
    if in_files.len != 1
        usage.error_exit(refusal)
    return in_files.get(0)

priv fn read_mode(p: argp.Parser$@, mode_name: U8[], in_files: List<|U8[]|>$@, o: Cli$@): Mode //<
    //< The mode the subcommand names, with its inputs checked
    $mode: Mode
    if mode_name.equals("fmt")
        if in_files.len == 0
            usage.error_exit(usage.usage_of("fmt"))
        if o.to_name.len > 0 && !o.to_name.equals("kspl") && !o.to_name.equals("kspls")
            usage.error_exit("--to: the only notations that can be put out are kspl and kspls\n")
        mode = .fmt(in_files, o.fmt_in_place, o.fmt_config, o.to_name)
    else if mode_name.equals("lsp")
        mode = .lsp
    else if mode_name.equals("lsp-worker")
        mode = .lsp_worker
    else if mode_name.equals("lint")
        mode = .lint(only_input(in_files, usage.usage_of("lint")))
    else if mode_name.equals("info")
        subject: =
            only_input(in_files, usage.usage_for_topics("info", usage.info_topics()))
        topic: = usage.parse_info_topic(subject)
        usage.refuse_unread_std_dir(p, topic)
        switch topic
        case .machine
            check_machine(mode_name)
        default {}
        mode = .info(topic)
    else if mode_name.equals("clean")
        // **It takes no subject**: there is one thing to clean, and a word after it would change
        // nothing.
        if in_files.len != 0
            usage.error_exit(usage.usage_of("clean"))
        mode = .clean
    else if mode_name.equals("emit-runtime")
        mode = .emit_runtime(only_input(in_files, usage.usage_of("emit-runtime")))
    else if mode_name.equals("explain")
        asked: = only_input(in_files, usage.usage_of("explain"))
        code: = tools_explain.canonical_code(asked, base_core.arena)
        // An error has no code, so a message the reader wants explained may well have none.
        if !base_lint_codes.is_known(code)
            msg: = base_core.arena.text().s("ksplc explain: '").s(asked)
                .s("' is not a diagnostic code. Only a warning, an information or a hint carries \
                    one (the table is 5.4 in ksplc/docs/SPEC-tools.md); an error's message is its \
                    own explanation.\n").take()
            usage.error_exit(msg)
        mode = .explain(code)
    else if mode_name.equals("doc")
        mode = .doc(only_input(in_files, usage.usage_of("doc")))
    else if mode_name.equals("run")
        if in_files.len == 0
            usage.error_exit(usage.usage_of("run"))
        // `--to=llvm` / `--freestanding` / `--library` are not valid for run, and
        // check_flag_faces has already rejected them (its per-subcommand table is the canonical
        // source; docs/DESIGN.md Principle 6).
        mode = .run(in_files.get(0), o.script_args)
    else if mode_name.equals("build")
        if in_files.len != 2
            usage.error_exit(usage.usage_of("build"))
        mode = .build(in_files.get(0), in_files.get(1), o.cflags)
    else
        if in_files.len != 2
            // It rejects "too many" as well as "too few". If it silently used the first two, a
            // path cut by the shell's word splitting (one containing a space) would compile an
            // unrelated file for no clear reason.
            if in_files.len > 2
                io.err().s("Error: too many input files (expected <input.kspl> <output.c>):\n")
                for f in in_files
                    io.err().s("  ").s(f).c('\n')
            usage.usage_exit()
        mode =
            .compile(in_files.get(0), in_files.get(1), o.deps_path, o.libs_path)
    return mode

impl Mode
    priv fn new(): Self
        base_core.config.defines = List<|U8[]|>.create(base_core.arena)
        base_core.config.interface_paths = List<|U8[]|>.create(base_core.arena)
        base_core.config.target = .c
        $o: = Cli::{ .fmt_in_place = false, .to_name = "",
            .fmt_config = fmt_style.Config.default_fmt(),
            .script_args = List<|U8[]|>.create(base_core.arena), .deps_path = "", .libs_path = "",
            .surface_scope = "", .style = "", .std_dir = "", .pkg_src_dir = "", .split_units = "",
            .diag_format = "", .cflags = "",
            .lint_specs = List<|U8[]|>.create(base_core.arena) }
        p: = argp.Parser.create("ksplc", "", base_core.arena)
        // Kept so print_usage can build the usage list from the declarations.
        usage.cli = p
        declare_options(p, o@)
        p.parse(sys.args(), base_core.arena) catch e
            refuse_command_line(e)

        in_files: = p.rest
        // Caution: Never treat a bare `-` as an input file name. argp passes it on as "standard
        // input", which ksplc does not read, so here it is always an accident of word splitting.
        for f in in_files
            if f.equals("-")
                io.err().s("Error: unknown option: -\n")
                usage.usage_exit()
        $mode_name: U8[] = p.command
        if mode_name.len == 0
            mode_name = "compile"
        // Caution: **Check it right after the subcommand is decided.** Placed after the options are
        // read, an option that has no effect would still have its side effects (a cfg, a setting).
        usage.check_flag_faces(p, mode_name)
        usage.refuse_empty_values(p)
        apply_options(o@, mode_name)
        return read_mode(p, mode_name, in_files, o@)

    priv fn dispatch(r: Self): Void!pipeline.Compile_error //<
        //< it dispatches to the handling for each mode
        //<
        //< **Only a mode that parses builds the grammar** (`kspl_parser`): a query an editor or
        //< build script makes at every start-up need not pay for it. run neither: on a cache hit,
        //< start-up alone is enough (a build calls ksplc again as a child, which parses).
        switch r
        case .info(topic)
            answer_info(topic)!
        case .clean
            arena: = Arena.new(8 * 1024)
            defer arena.free()
            $dir: = Str_builder.new()
            defer dir.free()
            if !base_cache.clear_all(dir@, arena)
                base_cache.exit_unlocated("ksplc")
            io.out().s("ksplc: cleared ").s(dir.slice()).c('\n')
        case .emit_runtime(out_path)
            pipeline.emit_runtime(out_path)!
        case .explain(code)
            if !tools_explain.print_explanation(code, base_core.arena)
                msg: = base_core.arena.text().s("ksplc explain: '").s(code)
                    .s("' is registered but has no section in ksplc/docs/SPEC-tools.md\n").take()
                usage.error_exit(msg)
        case .doc(target)
            parser: = kspl_parser()!
            defer parser.free_memo()
            if !tools_doc.print_doc(target, parser)
                sys.exit(1)
        case .run(script, script_args)
            tools_run.run_script(script, script_args) // it does not return (it exits on the script's code)
        case .build(in_path, out_path, flags)
            tools_run.build_program(in_path, out_path, flags) // it does not return
        case .fmt(fmt_files, in_place, config, to)
            parser: = kspl_parser()!
            defer parser.free_memo()
            // Caution: **Format the rest even where one fails.** A `!` here leaves every later file
            // unformatted, the tree formatted partway without anyone seeing it, and a retry
            // stopping at the same place. format_file has printed each file's diagnostics; the
            // failed names go last.
            $failed: = List<|U8[]|>.new(null)
            defer failed.free()
            $fixed: = fmt_file.Fixed_points.open()
            for f_path in fmt_files
                // The output notation is what `--to` says, else the input's.
                to_layout: = to.equals("kspls") if to.len > 0 else f_path.is_laid_out()
                fmt_file.format_file(f_path, parser, config, in_place, to_layout, fixed@) catch _e
                    failed.push(f_path)
            fixed.print_stats()
            if failed.len > 0
                io.err().s("\nfmt failed on \{failed.len\} file(s):\n")
                for f in failed
                    io.err().s("  -> ").s(f).c('\n')
                throw .fmt_failed
        case .lsp
            parser: = kspl_parser()!
            defer parser.free_memo()
            base_core.append_defines_from_env()
            lsp_server.run_lsp_supervisor(parser)
        case .lsp_worker
            parser: = kspl_parser()!
            defer parser.free_memo()
            // Caution: **Set the defines on both the supervisor and the worker.** The worker
            // analyses, and the supervisor only relays. With only one, code under a `#cfg` goes
            // unanalysed and both the diagnostics and hover come back empty.
            base_core.append_defines_from_env()
            lsp_worker.run_lsp_worker(parser)
        case .lint(in_path)
            parser: = kspl_parser()!
            defer parser.free_memo()
            run_compiler(in_path, "", "", "", parser, true)!
        case .compile(in_path, out_path, deps_path, libs_path)
            parser: = kspl_parser()!
            defer parser.free_memo()
            run_compiler(in_path, out_path, deps_path, libs_path, parser, false)!

priv fn check_machine(face: U8[]) //<
    //< It refuses a machine ksplc has no widths for, listing the ones it has
    //<
    //< **Refused, never guessed**: a guess folds sizes the C compiler disagrees with. A machine
    //< genllvm cannot lay out is refused `--to=llvm` here too, so no IR with wrong offsets is
    //< written.
    //< Caution: **The language server's refusal goes to standard error**: its standard output is
    //< the protocol, where a line of text reads as a broken message and names nothing.
    $said: = Str_builder.new()
    defer said.free()
    usage.machine_refusal_to(face, base_core.config.machine, base_target.host_name(), said@)
    if said.len > 0
        if face.starts_with("lsp")
            io.err().s(said.slice())
            sys.exit(1)
        usage.error_exit(said.slice())
    if !base_core.is_llvm_target()
        return
    name: = base_target.named_name()
    if m: = base_target.find(name)
        if m.llvm_triple.len == 0
            refusal: = base_core.arena.text()
                .s("--to=llvm: the LLVM backend lays out only machines with 8-byte pointers, and \
                    '\{name\}' is not one. Write C for it (--to=c, the default)\n").take()
            usage.error_exit(refusal)

priv fn refuse_with_library() //<
    //< It refuses an option `--library` cannot work with
    //<
    //< Each needs a symbol of the library visible outside it, which `--library` makes `static`
    //< ("How linkage is chosen" in ksplc/docs/DESIGN.md).
    if base_core.config.unit_count > 1
        usage
            .error_exit("--library: --split cannot be combined: the units reach each other's \
                functions, which a library makes static. Build a library as one unit\n")
    if base_core.is_llvm_target()
        usage
            .error_exit("--library: --to=llvm cannot be combined: the IR links its runtime from \
                another file, which a library's own runtime cannot be. Build a library with \
                --to=c\n")
    if base_core.config.is_freestanding
        usage
            .error_exit("--library: --freestanding cannot be combined: the C compiler calls the \
                bare-metal runtime's helpers (__aeabi_memcpy and the like) by name from any object, \
                so they cannot be private. A bare-metal image is built from source\n")

priv fn check_interface_paths() //<
    //< It refuses a `--library=` interface that cannot be written
    //<
    //< The form follows the extension, so any other name would leave the reader guessing what was
    //< meant; a path named twice would be written twice.
    paths: = base_core.config.interface_paths
    for i in Range.asc(paths.len)
        path: = paths.get(i)
        switch tools_interface.form_of(path)
        case .none
            why: = base_core.arena.text().s("--library: '").s(path)
                .s("' names neither form of interface: end it in .h for C, or in .kspls or .kspl \
                    for KSPL\n").take()
            usage.error_exit(why)
        default {}
        for j in Range.asc(i)
            if paths.get(j).equals(path)
                why: = base_core.arena.text().s("--library: '").s(path).s("' is named twice\n")
                    .take()
                usage.error_exit(why)

priv fn kspl_parser(): kspeg.Target$@!pipeline.Compile_error //<
    //< The parser the embedded grammar builds; the caller frees its memo (`free_memo`)
    $meta: = kspeg_notation.Meta.new(kspl_grammar, base_core.arena)
    return meta.parse_grammar() catch e
        throw .parse(.kspeg(e))

priv fn answer_info(topic: usage.Info_topic): Void!pipeline.Compile_error //< it answers a query
    switch topic
    case .std_dir
        io.out().s(base_locate.std_dir()).c('\n')
    case .link_libs
        print_flag_words(tools_run.append_link_libs)
    case .exe_flags
        print_flag_words(tools_run.append_exe_flags)
    case .cache_dir
        $dir: = Str_builder.new()
        defer dir.free()
        if !base_cache.append_cache_root(dir@)
            base_cache.exit_unlocated("ksplc")
        io.out().s(dir.slice()).c('\n')
    case .keywords
        // The only subject that needs the grammar.
        parser: = kspl_parser()!
        defer parser.free_memo()
        tools_keywords.run_keyword_dump(parser)
    case .machine
        io.out().s(base_target.named_name()).c('\n')
    case .package
        decl: = base_package.here()
        io.out().s(decl.name).c('\n')
        usage.print_words(decl.uses)

priv fn print_flag_words(append: fn(list: List<|U8[]|>$@, arena: Arena$@)) //<
    //< The words `append` gives (`tools_run.append_link_libs` and its like), as a query answers
    arena: = Arena.new(8 * 1024)
    defer arena.free()
    $words: = List<|U8[]|>.new(arena)
    defer words.free()
    append(words@, arena)
    usage.print_words(words@)

priv fn print_diag_summary(compiler: pipeline.Compiler$@, is_lint: Bool) //<
    //< The summary of the diagnostics' counts
    //<
    //< With neither an error nor a warning it prints nothing. **It is printed only after every
    //< stage has finished** (the one `defer` in run_compiler); earlier, later stages' counts miss
    //< it.
    if compiler == null || compiler.sema == null
        return
    errs: = compiler.sema.diags.counts.errors
    warns: = compiler.sema.diags.counts.warnings
    if !is_lint && errs == 0 && warns == 0
        return
    io.out().s("Finished with \{errs\} error(s), \{warns\} warning(s)")
    if is_lint
        io.out()
            .s(", \{compiler.sema.diags.counts.infos\} information(s), and \
                \{compiler.sema.diags.counts.hints\} hint(s)")
    io.out().s(".\n")
    // Caution: **Name the command where the codes are.** An explanation nobody is told about goes
    // unread; the lint gate reads only the line above, and a clean run names no code.
    codes: = compiler.sema.diags.counts.codes
    if codes.len > 0
        io.out().s("The codes above are explained by `ksplc explain <code>`: ")
        for i in Range.asc(codes.len)
            io.out().s(", " if i > 0 else "").s(codes.get(i))
        io.out().s(".\n")

priv fn run_compiler(in_path: U8[], out_path: U8[], deps_path: U8[], libs_path: U8[],
    parser: kspeg.Target$@, is_lint: Bool): Void!pipeline.Compile_error
    start_time: = sys.mono_us()
    mod_name: = in_path.strip_kspl_ext()

    t0: = sys.mono_us()
    base_stats.reset_bytes()
    compiler: = pipeline.Compiler.new(parser)
    defer compiler.free()
    compiler.parse_file(mod_name, "", false)!

    expected_max: = I32::base_ast_kinds.Ast_kind.k_max
    current_size: = base_core.pools.get_kind_pool_size()
    if current_size > expected_max
        unknown_name: = base_core.pools.get_kind_str(expected_max, "Unknown")
        $err_msg: = Str_builder.new()
        defer err_msg.free()
        err_msg
            .s("Grammar sync error: Rule '\{unknown_name\}' is defined in kspl.kspeg but missing \
                from Ast_kind enum.")
        base_diag.ice_panic(err_msg.slice())

    t1: = sys.mono_us()
    // **It does not print here.** The stage numbers are read as one block, printed once by
    // `pipeline.print_stats_report` after every stage (base/stats.kspls collects them).
    base_stats.stages.parse = base_stats.end_stage(t0, t1)

    compiler.run_semantic_analysis(mod_name, is_lint, false, .everywhere) catch {}

    // Caution: **Print the summary only once, after every stage has finished.** Printed after
    // sema, it misses what Lower and the code generation added and fails while saying "0 error(s)".
    // As a defer it is printed through any throw below, but not on the depth limit's `sys.exit`:
    // a count after a cut-off that skipped the counting would be a lie.
    defer print_diag_summary(compiler, is_lint)

    $errs: = 0
    if compiler.sema != null
        errs = compiler.sema.diags.counts.errors

    if !compiler.is_valid || errs > 0
        throw .sema(.analysis_failed)
    if is_lint
        return

    // Caution: **Write the interfaces before lower**, which rewrites the names they read. **Stop
    // at the first refused**: the next form would report the same refusal again.
    $interface_texts: = List<|U8[]|>.new(base_core.arena)
    for path in base_core.config.interface_paths
        text: = tools_interface.render(compiler.root_file, compiler.sema,
            tools_interface.form_of(path), path, compiler.base_parser)
        interface_texts.push(text)
        if compiler.sema.diags.counts.errors > errs
            throw .sema(.analysis_failed)
    $surface_text: U8[] = ""
    if base_core.config.surface_path.len > 0
        // The API record copies the spelling as written, so it needs a tree that still has its
        // trivia. Only this tree is parsed again from the source already read.
        // Caution: **Never fall back to an empty tree**: the record would be written empty, and
        // `make test-surface` would read every published name as removed. The file parsed once
        // already, so a source not held or a second parse that fails is the compiler's own fault.
        main_src: = compiler.source_map.get(compiler.sema.main_file) catch ""
        base_diag.ice_assert(main_src.len > 0, "--emit-surface: the main file's source is not held")
        raw_root: =
            parse_load.parse_raw_ast(main_src, compiler.sema.main_file, compiler.base_parser)
            catch null
        base_diag.ice_assert(raw_root != null,
            "--emit-surface: the main file parsed once and not again")
        surface_text = tools_surface.render_surface(raw_root, main_src, compiler.sema.main_file)

    compiler.run_lower_and_codegen(out_path)!
    // Lower and the code generation also report diagnostics with sema.err() (the retain/release
    // insertion reaching its depth limit, and the like). The errs check above comes before that,
    // so without checking the error count again here it would exit with code 0 while printing
    // errors (and the caller could not detect that the build failed).
    if compiler.sema.diags.counts.errors > errs
        throw .sema(.analysis_failed)
    // It writes only after success. A failed compilation's dependency list would look like "the
    // latest" next time (`ksplc run`'s cache would reuse a broken build).
    if deps_path.len > 0
        tools_run.write_deps_file(deps_path, compiler.loaded_files)
    // Caution: **A libs file that fails to write fails the compile.** A build reading it would link
    // without the library and fail on undefined names, far from the cause.
    if libs_path.len > 0
        tools_run.write_libs_file(libs_path, compiler.root_file) catch e
            throw .io(e)
    // Caution: **An API record or an interface that fails to write fails the compile**, as a libs
    // file does: `make test-surface` would compare against a record left from an earlier run.
    if base_core.config.surface_path.len > 0
        io.write_file(base_core.config.surface_path, surface_text) catch e
            throw .io(e)
    for i in Range.asc(interface_texts.len)
        io.write_file(base_core.config.interface_paths.get(i), interface_texts.get(i)) catch e
            throw .io(e)

    end_time: = sys.mono_us()

    pipeline.print_stats_report(end_time - start_time, base_core.arena.get_total_used(),
        base_core.arena.get_total_allocated(), base_core.arena.headroom(),
        mem.heap_peak_used_bytes())

impl io.Io_error
    priv fn report_and_exit(r: Self, kind: U8[]) //<
        //< It reports an io.Io_error as one line, `<kind>/<variant>: <details>`, and exits
        //<
        //< The parse phase's io errors and the top-level io errors that belong to no phase share
        //< it.
        usage.error_exit(base_diag.io_line(r, kind))

impl pipeline.Compile_error
    priv fn report_and_exit(r: Self$@) //<
        //< It reports a propagated error as one line, `<category>/<variant>: <details>`, and exits
        //<
        //< The part before the colon (`parse/syntax_error`, or a bare `codegen`) is the error's
        //< identifier unchanged. **A line closing a run whose diagnostics are printed goes with the
        //< summary, on standard output**; any other is an error of its own, on standard error.
        //< Caution: **Do not put the closing line on standard error**: under
        //< `--diagnostic-format=json` that stream holds the diagnostics alone, and the line adds
        //< nothing they did not say.
        $msg: = Str_builder.new()
        defer msg.free()
        $closes: = false
        switch r$
        case .parse(p_err)
            switch p_err
            case .syntax_error
                closes = true
                msg.s("parse/syntax_error: compilation terminated (see diagnostics above)\n")
            case .circular_import(path)
                msg
                    .s("parse/circular_import: circular import across directory boundaries is \
                        forbidden: \{path\}\n")
            case .kspeg(kspeg_err)
                switch kspeg_err
                case .fatal(e_msg)
                    msg.s("parse/kspeg: \{e_msg\}\n")
                default
                    msg.s("parse/kspeg: failed to parse kspl.kspeg grammar itself\n")
            case .io(io_err)
                io_err.report_and_exit("parse/io") // the helper reports and exits
        case .sema(s_err)
            switch s_err
            case .analysis_failed
                closes = true
                msg.s("sema/analysis_failed: compilation terminated (see diagnostics above)\n")
            case .not_constant
                msg.s("sema/not_constant: expression is not a compile-time constant\n")
            case .division_by_zero
                msg.s("sema/division_by_zero: division or modulo by zero\n")
            case .invalid_argument
                msg.s("sema/invalid_argument: invalid argument\n")
            case .nesting_too_deep
                closes = true
                msg.s("sema/nesting_too_deep: compilation terminated (see diagnostics above)\n")
        case .io(io_err)
            io_err.report_and_exit("io") // the helper reports and exits
        case .codegen
            closes = true
            msg.s("codegen: compilation terminated (see diagnostics above)\n")
        case .fmt_failed
            closes = true
            msg.s("fmt/failed: some files could not be formatted (listed above)\n")
        // The io case has already exited inside the helper. The rest are reported here, the same
        // way.
        if msg.len == 0
            msg.s("unknown: unrecognized error\n")
        if !closes
            usage.error_exit(msg.slice())
        io.out().s(msg.slice())
        sys.exit(1)

priv fn apply_lint_setting(spec: U8[]) //< it applies one `--lint=CODE=level`
    //<
    //< Both the code and the level are checked against the registry, and an unknown one is an
    //< error (so a typo cannot silently do nothing; the same rule as `##lint`).
    $eq: Sz = 0
    switch spec.find_char('=')
    case .some(at)
        eq = at
    case .none
        usage.error_exit("--lint expects CODE=level (for example --lint=I0307=off)\n")
    code: = spec.sub(0, eq)
    level_name: = spec.sub_from(eq + 1)
    if !base_lint_codes.is_known(code)
        usage.error_exit("--lint: unknown diagnostic code\n")
    switch base_lint_codes.Lint_level.parse(level_name)
    case .some(level)
        base_lint_codes.set_global_level(code, level)
        // Raising it to an error also means "run that check" (the intent must be to reject it in an
        // ordinary build too).
        switch level
        case .error
            base_core.config.cli_raises_lint = true
        default {}
    case .none
        usage.error_exit("--lint: unknown level (expected 'off', 'on', or 'error')\n")

const internal_trace_env_name: U8[] = "KSPLC_INTERNAL_TRACE" //<
    //< The environment variable that decides whether ksplc prints its own `!` propagation trace
    //<
    //< `sys.print_trace` prints the trace.

priv fn print_internal_trace() //<
    //< It prints the propagation trace when exiting on a `Compile_error`, and only when asked
    //<
    //< Caution: **Never print it by default.** Every `Compile_error` branch is a failure whose
    //< diagnostic is already printed (a syntax error, a sema failure, an io failure), and the trace
    //< describes **ksplc's own control flow, not the user's program**: one missing semicolon would
    //< give 13 internal frames of 18, the parser engine's own among them (for the reason Principle
    //< 2 hides the raw C errors).
    if v: = sys.get_env(internal_trace_env_name)
        if v.len > 0
            sys.print_trace()

fn main(): Void!I32
    with_setup:
        base_setup.init()
        defer base_setup.fin()

        parse_load.init()
        defer parse_load.fin()

        fmt_printer.init()

        mode: = Mode.new()
        mode.dispatch() catch e
            print_internal_trace()
            e.report_and_exit()

    heap_used: = mem.heap_used_bytes()
    if heap_used != 0
        $final_msg: = Str_builder.new()
        defer final_msg.free()
        final_msg.s("Final Global Heap : \{heap_used:,\} bytes (Should be 0 - memory leak)\n")
        usage.error_exit(final_msg.slice())

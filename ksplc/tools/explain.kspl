//< `ksplc explain [<code> | <start>]`: one code's section of the diagnostics specification, or a list
//< The text is `ksplc/docs/SPEC-diagnostics.md` itself, embedded at build time, with no second copy
//< to drift. The list is its section headings, so a code given a section is listed with no other
//< edit. The codes come from `ksplc/base/lint_codes.kspl`; `case_explain` in
//< `tests/suite/cli_test.kspl` checks that each has a section.
import "ksplc/base/lint_codes" as base_lint_codes
import "std/chars"
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }

embed "ksplc/docs/SPEC-diagnostics.md" as diagnostics_spec

const SPEC_NAME: U8[] = "ksplc/docs/SPEC-diagnostics.md" //<
    //< the document the text is taken from

struct Explanation //< one code's section, and the chapter it is in
    text: U8[] //< from the `### [CODE]` heading to the line before the next heading
    chapter: U8[] //< the `##` heading above it, marks left out (`2. The list of warnings (W)`)

fn canonical_code(raw: U8[], arena: Arena$@): U8[] //< the code as the table spells it
    //< A code is a capital letter and four digits, so normalizing it only upper-cases the letter.
    b: = arena.text()
    for c in raw
        b.c(c - 'a' + 'A' if c >= 'a' && c <= 'z' else c)
    return b.take()

priv fn heading_level(line: U8[]): Sz //< how many `#` start a heading, 0 if the line is not one
    //< Caution: **A heading needs a space after its marks**: `#cfg(freestanding)` in an example is
    //< not a heading, and would cut the section short.
    $n: Sz = 0
    for n < line.len && n < 6 && line[n] == '#'
        n += 1
    return n if n > 0 && n < line.len && line[n] == ' ' else 0

priv fn is_fence(line: U8[]): Bool //< whether the line opens or closes a code block
    return line.trim_start().starts_with("```")

fn section_of(code: U8[], arena: Arena$@): Explanation //< the code's section; empty text if none
    //< A section runs to the next heading of any level outside a code block, and its trailing blank
    //< lines and a trailing `---` are dropped.
    head: = arena.text().s("### [").s(code).s("]").take()
    $chapter: U8[] = ""
    $in_fence: = false
    $taking: = false
    $body: = Str_builder.new()
    $kept: Sz = 0 // the length of `body` up to its last line that is neither blank nor `---`
    for line in diagnostics_spec.lines(arena)
        if is_fence(line)
            in_fence = !in_fence
        level: = 0 if in_fence else heading_level(line)
        if taking && level > 0
            break
        if level == 2
            chapter = line.sub_from(3)
        if !taking && level == 3 &&
            (line.starts_with(head) && (line.len == head.len || line[head.len] == ' '))
            taking = true
        if !taking
            continue
        body.s(line).c('\n')
        t: = line.trim_spaces()
        if t.len > 0 && !t.equals("---")
            kept = body.len
    return Explanation::{ .text = arena.dup_str(body.slice().sub(0, kept)), .chapter = chapter }

fn answer(asked: U8[], arena: Arena$@): U8[] //<
    //< prints a code's section, or the codes a start begins
    //< Returns why nothing was printed, empty when something was.
    if !base_lint_codes.is_known(asked)
        if print_list(asked, arena) > 0
            return ""
        return arena.text()
            .s("ksplc explain: no diagnostic code starts with '\{asked\}'; `ksplc explain` lists \
                them all\n").take()
    if !print_explanation(asked, arena)
        return arena.text().s("ksplc explain: '\{asked\}' has no section in \{SPEC_NAME\}\n").take()
    return ""

fn is_code_start(text: U8[]): Bool //< whether it can start a code: `W`, `I0`, `H080`
    //< A code is a letter (`W`, `I` or `H`) then four digits, so a start is the letter and up to
    //< three of them.
    if text.len == 0 || text.len > 4 ||
        !(text[0] == 'W' || text[0] == 'I' || text[0] == 'H')
        return false
    for c in text.sub_from(1)
        if !c.is_digit()
            return false
    return true

fn print_list(start: U8[], arena: Arena$@): Sz //< lists the codes that begin with `start`
    //< One line each, `W0101  An out-of-bounds array access`, in the specification's order; an
    //< empty start lists every code. **It is the section headings**, so it cannot disagree with
    //< what `ksplc explain <code>` prints. Returns how many were listed.
    $n: Sz = 0
    $in_fence: = false
    for line in diagnostics_spec.lines(arena)
        if is_fence(line)
            in_fence = !in_fence
        if in_fence || heading_level(line) != 3 || !line.starts_with("### [")
            continue
        close: = line.find_char(']').unwrap_or(0)
        code: = line.sub(5, close - 5) if close > 5 else ""
        if !base_lint_codes.is_known(code) || !code.starts_with(start)
            continue
        io.out().s(code).s("  ").s(line.sub_from(close + 1).trim_spaces())
        if !base_lint_codes.is_default_on(code)
            io.out().s("  (off by default)")
        io.out().c('\n')
        n += 1
    if n > 0
        io.out().s("\n`ksplc explain <code>` prints what one means and what to do about it.\n")
    return n

fn print_explanation(code: U8[], arena: Arena$@): Bool //< it prints the section; false if none
    //< The Markdown is printed as written, as `rustc --explain` does, followed by its source. Its
    //< links are relative to `ksplc/docs/`. A bare section number refers to that document.
    e: = section_of(code, arena)
    if e.text.len == 0
        return false
    io.out().s(e.text).s("\nFrom \"").s(e.chapter).s("\" in ").s(SPEC_NAME)
        .s(" (its links count from ksplc/docs/).\n")
    return true

//< `ksplc info keywords`: the grammar's keywords, derived from the grammar itself
//< **The list is read from `../kspl.kspeg`, never kept by hand**, so it cannot drift from what the
//< parser accepts.
import "kspeg/engine" as kspeg
import "ksplc/base/core" as base_core
import "std/chars"
import "std/ds" { List }
import "std/io"
import "std/seq"
import "std/str"

fn run_keyword_dump(parser: kspeg.Target$@) //<
    //< It prints the grammar's keywords on standard output, one per line, sorted, each once
    //< Caution: Do not read the synthesized `_Keyword` for the list; its shape is the engine's
    //< choice. Each rule's own keywords are its canonical form.
    every_name: = List<|U8[]|>.create(base_core.arena)
    for entry in parser.keywords_by_rule()
        for kw in entry.keywords
            every_name.push(kw)
    uniq: = every_name.distinct(fn(a: U8[]@, b: U8[]@; ): Bool {
        return a.equals(b$);
    }, base_core.arena)
    sorted: = uniq.order_by(fn(a: U8[]@, b: U8[]@; ): I32 {
        return a.compare(b$);
    }, base_core.arena)
    for kw in sorted
        io.out().s(kw).c('\n')

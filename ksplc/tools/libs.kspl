//< The libraries a program names (`##link`)
//< A compile writes them with `--emit-libs=` (`libs_text`), and `ksplc run` and `ksplc build`
//< read them back for the link (`append_named_libs`). Split from `run.kspl` for length.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as _base_ast_ext // `link_name`
import "ksplc/base/core" as base_core
import "std/chars" // `trim_spaces`
import "std/ds" { List }
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }

fn libs_text(root: Ast_node$@): U8[] //<
    //< The libraries the kept `##link`s name, as the libs file holds them (`--emit-libs=`)
    //< One line of `-l<name>` words (the shape `info link-libs` answers in), empty where none is
    //< named; the reader is append_named_libs below. The compile writes it with its other outputs.
    defer $names: = List<|U8[]|>(null)
    append_program_libs(root, names@)
    out: = base_core.arena.text()
    for i in Range.asc(names.len)
        out.s(" " if i > 0 else "").s("-l").s(names.get(i))
    out.c('\n')
    return out.take()

fn append_program_libs(root: Ast_node$@, names: List<|U8[]|>$@) //<
    //< It appends the libraries the kept `##link`s name, in the order a link needs them
    //< **A file's names come before those of the files it imports.** A linker reading once from the
    //< left needs that. Each name comes once, at its first place. A `##link` in a group that `#cfg`
    //< dropped is absent, so a library follows the flag that keeps its declarations.
    // root holds each file's declarations together, a file after the files it imports ("dependency
    // -> self" in `../parse/load.kspl`), so the files are walked from the last.
    decls: = root.children
    $end: = decls.len
    for end > 0
        file: = decls.get(end - 1).loc.file()
        $start: = end - 1
        for start > 0 && decls.get(start - 1).loc.file().equals(file)
            start -= 1
        for i in Range(start, end, 1)
            append_link_names(decls.get(i), names)
        end = start

priv fn append_link_names(decl: Ast_node$@, names: List<|U8[]|>$@) //<
    //< It adds the names a `##link` directive names that are not yet in names
    if decl.kind_id != .k_decl_directive
        return
    prefix: = decl.find_child(.k_directive_prefix)
    if prefix == null || !prefix.text.equals("##link")
        return
    for arg in decl.children
        name: = arg.link_name()
        if name.len > 0 && !names.contains(name)
            names.push(name)

fn append_named_libs(libs_path: U8[], list: List<|U8[]|>$@, arena: Arena$@): Bool //<
    //< It appends to list the libraries the compile wrote (`--emit-libs`)
    //< False where the file cannot be read: the compile always writes it, and linking without it
    //< fails on undefined names, far from the cause.
    text: = io.read_file(libs_path, arena) catch
        return false
    for word in text.trim_spaces().split(' ', arena)
        if word.len > 0
            list.push(word)
    return true

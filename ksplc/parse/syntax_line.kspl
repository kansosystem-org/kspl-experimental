//< One line of the parser's text, read for a syntax error's note
//< A note reads the failing line's code, its words and the lines around it. **Only the text is
//< read**: these guesses never decide whether the source parses.
import "ksplc/base/lines" { line_end, line_start }
import "ksplc/base/literal" { literal_end }
import "std/chars"
import "std/ds" as _ds // `equals`

struct Code_line //< one line's code, without the comment or surrounding blanks
    indent: Sz
    code: U8[]
    next_at: Sz //< where the line after it begins

fn code_line(src: U8[], at: Sz): Code_line //< the line beginning at `at`
    e: = line_end(src, at)
    $b: = at
    for b < e && src[b] == ' '
        b += 1
    $c: = b
    for c < e
        if src[c] == '"' || src[c] == '\''
            c = literal_end(src, c)
            continue
        if src.starts_with("//", c)
            break
        c += 1
    if c > e
        c = e
    return Code_line::{ .indent = b - at, .code = drop_mended_tail(src.sub(b, c - b)),
        .next_at = e + 1 }

fn drop_mended_tail(code: U8[]): U8[] //<
    //< The line's own text, without the marks the indentation reader added after it
    //< The text read here is the parser's, whose lines end in that reader's ` {` / `;` / ` }`
    //< (`to_braces` in `layout.kspl`).
    $n: = code.len
    for n > 0
        if code[n - 1] == ' ' || code[n - 1] == '\r' || code[n - 1] == ';'
            n -= 1
        else if n >= 2 && code[n - 2] == ' ' && (code[n - 1] == '{' || code[n - 1] == '}')
            n -= 2
        else
            break
    return code.sub(0, n)

fn next_code_line(src: U8[], after: Code_line): Code_line //<
    //< The first line after `after` holding code
    //< Blank lines and comment lines are skipped, as the indentation notation skips them.
    $l: = code_line(src, after.next_at)
    for l.code.len == 0 && l.next_at <= src.len
        l = code_line(src, l.next_at)
    return l

fn previous_code_line(src: U8[], line_at: Sz): U8[] //<
    //< The code of the last line holding code before the line beginning at `line_at`, or empty
    $at: = line_at - 1
    for at > 0
        start: = line_start(src, at - 1)
        l: = code_line(src, start)
        if l.code.len > 0
            return l.code
        at = start
    return ""

fn word_start(head: U8[], at: Sz): Sz //<
    //< Where the first word at or after `at` begins
    $j: = at
    for j < head.len && !head[j].is_alnum()
        j += 1
    return j

fn word_end(head: U8[], at: Sz): Sz //< the end of the word running from `at`
    $e: = at
    for e < head.len && head[e].is_alnum()
        e += 1
    return e

fn starts_with_word(code: U8[], word: U8[]): Bool //< whether the code's first word is `word`
    return code.starts_with(word) &&
        (code.len == word.len || !code[word.len].is_alnum())

fn ends_with_word(code: U8[], word: U8[]): Bool //< whether the code's last word is `word`
    if code.len < word.len || !code.sub_from(code.len - word.len).equals(word)
        return false
    return code.len == word.len || !code[code.len - word.len - 1].is_alnum()

fn is_word_byte(byte: U8): Bool //< whether the byte can stand in a name
    return byte.is_alnum() || byte == '_'

fn word_end_with_underscore(code: U8[], at: Sz): Sz //< the end of the name running from `at`
    $e: = at
    for e < code.len && is_word_byte(code[e])
        e += 1
    return e

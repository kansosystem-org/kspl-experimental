//< Rewrites the indentation notation (`.kspl`) into the brace notation for the analyser
//<
//< **The two notations differ in three marks only**: indenting, outdenting and a newline stand
//< for `{`, `}` and `;`. No lines are added: the `{` goes at the end of the heading line and the
//< `}` at the end of the block's last line.
//< **Only blocks and terminators disappear.** What remains is `T::{ … }`, `import … { … }`, a
//< string's interpolation, and a block's braces where it fits on one line. The `;` of a C-style
//< loop heading, of a closure's captures, and between two statements on one line remains too.
import "ksplc/base/core" as _base_core // `is_one_of`
import "ksplc/base/lines" as base_lines
import "ksplc/parse/line_cont" { ends_in_catch, is_label_only, joins_next }
import "ksplc/parse/source_fix" as parse_source_fix
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }

struct Note //< a problem found in the indentation
    //<
    //< **No diagnostic is printed here**, so that no second reporter states a syntax error before
    //< the analyser does (Principle 6). What it finds is returned as a value. It is reported once
    //< sema starts (`report_layout_notes` in `../source_checks.kspl`).
    kind: Note_kind
    line: Sz //<
        //< Which line it is (1-based)
        //<
        //< **A line, because line numbers are the same before and after the conversion** (inserted
        //< text goes at a line's end, or replaces a space).
        //< Caution: **Do not report a column** — it would need the inserted text added back, and
        //< every user manages with a line.

enum Note_kind
    ragged(want: Sz, got: Sz) //<
        //< Siblings on the same level are not aligned to one column.
        //<
        //< Caution: **The conversion hides it silently** — only the heading's column is pushed, so
        //< any deeper line joins the level whatever its column (see `to_braces`).
    tab //<
        //< A tab is used for indentation.
        //<
        //< **A tab is not counted in the column** (the walk below counts only spaces). So that line
        //< is treated as column 0, and ends up outside the level around it.
    terminator(col: Sz) //<
        //< A statement's line ends in a written `;`, where the line's end already ends it
        //<
        //< `col` is the `;`'s byte within its line: nothing is inserted before it on that line.
        //< **No `;` is added after it.** So the parse goes on, and `fn f(): I32;` meets the
        //< analysis's own "has no body" rather than a syntax error about an empty statement.
    block_end(col: Sz) //<
        //< A `;` written right after a one-line block whose `}` already ended the statement
        //<
        //< `col` is the `;`'s byte within its line. **The `;` is read as a space**, so the parse
        //< goes on and this note is the one report (`if x { f() }; g()` reads as `if x { f() }
        //< g()`).

priv const tab_byte: U8 = '\t' //< one level of indentation
    //<
    //< Caution: **Do not guess its width.** Levels are told apart only by deeper or shallower; a
    //< fixed width would mistake a line continued by indentation for a level.

priv const cr_byte: U8 = '\r' //< the `\r` at the end of a line (CRLF)
    //<
    //< **Do not treat it as a character.** A CRLF blank line would read as not blank, and a
    //< terminator or brace put after the `\r` breaks the text. **Do not drop a `\r` inside a
    //< string.** `open_str` keeps that one, which is part of the newline a raw string holds.

// The block-opening headings that need no `;` after the block closes; **any other gets one** (the
// `r: = f() catch` kind, a block inside an expression). `"label:"` is a marker: no name contains a
// `:`.
priv const block_heads: U8[][14] = ::{ "fn", "struct", "enum", "trait", "impl", "extern", "if",
    "else", "for", "switch", "case", "default", "defer", "label:" }

priv const labelled_heads: U8[][3] = ::{ "for", "switch", "if" } //<
    //< What a label can stand before (a bare block's label stands alone: `is_label_only`)
    //<
    //< Caution: **Not every block heading**: `p: fn(x: I32): Bool = fn(…)` would read as the label
    //< `p:` before `fn`, and the closure's block then got no `;` after it.

priv const head_skips: U8[][2] = ::{ "pub", "priv" } //<
    //< The words that can come before a heading without being the heading

priv struct Phys //< one physical line
    line: Sz //< which line it is (1-based)
    indent: Sz //< the number of leading spaces
    code_start: Sz //< the first non-whitespace (line_end where there is no code)
    code_end: Sz //< just after the last non-whitespace, the line comment excluded
    line_end: Sz //< the newline's position (src.len where there is none)
    blank: Bool //< no code (a blank line, or a line comment alone)
    joins: Bool //<
        //< The line continues the logical line above it
        //<
        //< Its start is inside a bracket or a string, or a mark joins it (`joins_next` in
        //< `line_cont.kspl`). Blank lines in between are passed over, as a comment can stand there.
    seg_from: Sz //<
        //< Where the logical line's last statement starts: past its last `;` outside every bracket
        //<
        //< **The heading is read from here**, so in `import "std/io"; fn main() { … }` the line is
        //< a `fn`'s. **It can lie on a line above**: a `for` heading wrapped after its first `;`
        //< is still the `for`'s, and its later `;` split nothing.

priv struct Logical //< one logical line (= one statement or declaration)
    line: Sz //< which line it is (1-based), kept only for reporting a note
    indent: Sz
    head: U8[] //< the leading word (after skipping the visibility and the label)
    code_start: Sz //< the first non-whitespace
    code_end: Sz //< the `{` `;` `}` are inserted here
    attr: Bool //< a line holding only an attribute (`#name`); it takes no terminator

priv struct Insert //< one insertion
    //<
    //< Caution: **Do not reorder by position** — the order of several insertions at the same
    //< position (`; }`, `} }`) matters.
    at: Sz
    text: U8[]
    drop: Sz //<
        //< How many source bytes from `at` it replaces (0 = a pure insertion)
        //<
        //< **A one-line block's `;` replaces the space before its `}`**, so no column moves
        //< (diagnostics and the editor read positions from the converted text).

priv const max_line_opens: Sz = 32 //< how many brackets one physical line can hold open at once

priv struct Line_open //< a bracket opened on the physical line being walked
    at: Sz
    kind: U8 //<
        //< `(` `[`, `{` for a block's brace, `v` for a value's (`T::{ … }`, `import … { … }`)
    stmt_from: Sz //< where the block's last statement began: just past the `{` or its last `;`

// The walk: it skips strings, characters and line comments, counts bracket depth and splits the
// source into physical lines.
// Caution: **Count braces as brackets too.** The only braces left in a `.kspl` are values
// (`T::{ … }`, `import … { … }`, interpolation), so a value spanning lines stays one logical line.
// ---------------------------------------------------------
priv fn begins_anew(c: U8): Bool //<
    //< Whether a line starting with this byte starts something new
    //<
    //< Otherwise it continues what the line above left open.
    //<
    //< **A closing bracket continues**: a value written over several lines puts its `}` at column
    //< 0, and reading that as a new start breaks valid source.
    return c != ')' && c != ']' && c != '}' && c != ',' && c != '\n' && c != '\r'

priv fn scan_phys(src: U8[], notes: List<|Note|>$@, semis: List<|Insert|>$@, arena: Arena$@):
    List<|Phys|>
    $out: = List<|Phys|>.new(arena)
    $depth: Sz = 0
    $opens: Line_opens = ::{}
    // A string left open: 0 = none, 1 = a raw string (`"""`), 2 = a plain string. **A plain string
    // can cross lines too**: `String_content` accepts a newline, so a `= "` can close lines later
    // with `";` (`make test-place`).
    $open_str: Sz = 0
    // The logical line being gathered: its first line's column and code start (-1 before any
    // code), and where its code ends so far.
    $lead_indent: Sz = 0
    $lead_start: Sz = -1
    $lead_end: Sz = 0
    // Where the logical line's last statement starts, and the one before it. Caution: **Carry them
    // onto a line that joins.** Started afresh there, the `;` of a `for` heading wrapped after its
    // first `;` reads as a statement's end, and an `import`'s `{ … }` below its path as a block.
    $seg_from: Sz = 0
    $seg_before: Sz = 0
    $seg_closed_block: = false // a block closed outside every bracket in this statement
    $i: Sz = 0
    for i < src.len
        line_start: = i
        $indent: Sz = 0
        $look: = i
        for look < src.len && src[look] == ' ' && open_str == 0
            indent += 1
            look += 1
        // **An open bracket ends at a line that starts something new** (`begins_anew`), or one
        // unclosed `(` would read the rest of the file as its arguments.
        // Caution: **A string left open is not cut off** — a raw string holds its own lines, and
        // one of them can start at column 0.
        if indent == 0 && open_str == 0 && look < src.len && begins_anew(src[look])
            depth = 0
        inner: = depth > 0 || open_str > 0
        i = look
        code_start: = i
        has_code: = open_str == 0 && !holds_no_code(src, i)
        joins: =
            inner ||
            (has_code && lead_start >= 0 &&
            joins_above(src, lead_start, lead_end, lead_indent, indent, i))
        if has_code && (!joins || seg_from >= lead_end)
            // A new statement starts here: a new logical line, or one joined below a `;`.
            seg_from = i
            seg_before = i
            seg_closed_block = false
        if has_code && !joins
            lead_indent = indent
            lead_start = i
        opens.n = 0
        opens.import_seg = starts_import(src, seg_from)
        opens.seg_from = seg_from
        opens.has_closed = false
        // Caution: **Note a tab only on a line with contents.** A line of only tabs is blank, and
        // a note on it leaves nothing to fix.
        tab_at: = i if i < src.len && src[i] == tab_byte && open_str == 0 else -1
        $code_end: = i
        $done: = false
        for !done && i < src.len
            c: = src[i]
            if c == '\n'
                done = true
                continue
            if open_str > 0
                i = string_goes_on(src, i, open_str@)
                code_end = i
                continue
            if src.starts_with("//", i)
                // A line comment; code_end does not move.
                i = base_lines.line_end(src, i)
                continue
            if c == '"'
                i = skip_string(src, i, open_str@)
                code_end = i
                continue
            if c == '\''
                i = skip_char(src, i)
                code_end = i
                continue
            stray: = opens.step(src, i, semis)
            if stray
                notes
                    .push(Note::{ .kind = .block_end(i - line_start), .line = out.len + 1 })
                semis.push(Insert::{ .at = i, .text = " ", .drop = 1 })
            else if c == ';' && depth == 0 &&
                splits_statements(src, seg_from, i, seg_closed_block)
                seg_before = seg_from
                seg_from = skip_spaces(src, i + 1, src.len)
                seg_closed_block = false
                opens.import_seg = starts_import(src, seg_from)
                opens.seg_from = seg_from
            if c == '(' || c == '['
                depth += 1
            else if c == ')' || c == ']'
                depth = depth - 1 if depth > 0 else 0
            else if c == '{'
                depth += 1
            else if c == '}'
                depth = depth - 1 if depth > 0 else 0
                seg_closed_block =
                    seg_closed_block ||
                    (depth == 0 && opens.has_closed && opens.closed_at == i)
            else if c == '<' && i + 1 < src.len && src[i + 1] == '|'
                depth += 1
                i += 1
                code_end = i + 1
            else if c == '|' && i + 1 < src.len && src[i + 1] == '>'
                depth = depth - 1 if depth > 0 else 0
                i += 1
                code_end = i + 1
            i += 1
            if c != ' ' && c != tab_byte && c != cr_byte
                code_end = i
        line_end: = i
        if i < src.len
            i += 1 // skip the newline
        blank: = code_end <= code_start
        no: = out.len + 1
        if tab_at >= 0 && !blank
            notes.push(Note::{ .kind = .tab, .line = no })
        if !blank
            lead_end = code_end
        // A `;` ending the line starts no statement on it, so the heading is the one it ended.
        out
            .push(Phys::{ .line = no, .indent = indent, .code_start = code_start,
            .code_end = code_end, .line_end = line_end, .blank = blank, .joins = joins,
            .seg_from = seg_from if seg_from < code_end else seg_before })
        _unused: = line_start
    return out

priv struct Line_opens //< the brackets held open on the physical line being walked
    items: Line_open[max_line_opens]
    n: Sz //< how many are open; past `max_line_opens` the ones beyond are counted, not kept
    import_seg: Bool //<
        //< the statement outside every bracket is an `import`, whose `{ … }` is a value
    seg_from: Sz //< where the statement outside every bracket starts
    has_closed: Bool //< a block's `}` was seen on this line; `closed_at` is valid
    closed_at: Sz //< where the last block's `}` stands
    closed_ends: Bool //< whether that `}` ends its statement: the statement's heading opens a block

impl Line_opens
    fn step(r: Self$@, src: U8[], i: Sz, semis: List<|Insert|>$@): Bool //<
        //< It processes the byte at `i`: a bracket opening or closing, or a statement's `;`
        //<
        //< The `;` ends a statement of the block it stands in. **It returns true for a `;` the
        //< `}` before it already ended** (`block_end`), which the caller turns into a space.
        c: = src[i]
        if c == '(' || c == '[' || c == '{'
            if r.n < max_line_opens
                value: =
                    c == '{' &&
                    (r.import_seg || (i >= 2 && src[i - 1] == ':' && src[i - 2] == ':'))
                r.items[r.n] = Line_open::{ .at = i, .kind = 'v' if value else c,
                    .stmt_from = i + 1 }
            r.n += 1
        else if c == ')' || c == ']' || c == '}'
            if r.n > 0
                r.n -= 1
                if c == '}' && r.n < max_line_opens && r.items[r.n].kind == '{'
                    supply_block_end(src, r.items[r.n], i, semis)
                    from: =
                        (r.items[r.n - 1].stmt_from
                        if r.n > 0 && r.n <= max_line_opens && r.items[r.n - 1].kind == '{'
                        else r.seg_from)
                    r.has_closed = true
                    r.closed_at = i
                    r.closed_ends =
                        is_block_head(heading_of(src, skip_spaces(src, from, i), i))
        else if c == ';'
            $before: = i
            for before > 0 && (src[before - 1] == ' ' || src[before - 1] == tab_byte)
                before -= 1
            if r.has_closed && r.closed_ends && before > 0 && before - 1 == r.closed_at
                return true
            if r.n > 0 && r.n <= max_line_opens && r.items[r.n - 1].kind == '{'
                r.items[r.n - 1].stmt_from = i + 1
        return false

priv fn starts_import(src: U8[], at: Sz): Bool //< whether an `import` starts at `at`
    return src.starts_with("import", at) &&
        (at + 6 >= src.len || !src[at + 6].is_alnum())

priv fn splits_statements(src: U8[], seg_from: Sz, at: Sz, closed_block: Bool): Bool //<
    //< Whether the `;` at `at`, outside every bracket, ends a statement
    //<
    //< Another statement then starts on the line.
    //< **A C-style loop heading's `;` does not** (`for $i: Sz = 0; i < n; i += 1`): it belongs to
    //< the `for` until that loop's block has closed on the line.
    return closed_block || !head_word(src, seg_from, at).equals("for")

priv fn supply_block_end(src: U8[], o: Line_open, close: Sz, semis: List<|Insert|>$@) //<
    //< It inserts the missing `;` after the last statement of a block opened and closed on one line
    //<
    //< It follows the same rule as a line's end: a statement ending in `}` takes one unless its
    //< heading opens a block.
    $last: = close - 1
    for last > o.at && (src[last] == ' ' || src[last] == tab_byte)
        last -= 1
    if last == o.at || src[last] == ';'
        return
    if src[last] == '}' &&
        is_block_head(heading_of(src, skip_spaces(src, o.stmt_from, last), last + 1))
        return
    if src[close - 1] == ' '
        semis.push(Insert::{ .at = close - 1, .text = ";", .drop = 1 })
        return
    semis.push(Insert::{ .at = close, .text = ";" })

priv fn skip_string(src: U8[], at: Sz, open_str: Sz$@): Sz //<
    //< It skips a string starting with a `"`
    //<
    //< Left open at the line's end, it sets `open_str` (1 raw, 2 plain) and returns at the newline.
    raw: = src.starts_with("\"\"\"", at)
    open_str$ = 1 if raw else 2
    return string_goes_on(src, at + 3 if raw else at + 1, open_str)

priv fn skip_interp(src: U8[], at: Sz): Sz //<
    //< It skips an interpolation's expression, from past its `\{` to past its `\}`
    //<
    //< Caution: **A quote inside it opens a string of its own** (`\{"""ab""".len\}`). Read as the
    //< end of the string around it, a raw string would seem left open, and the line get no `;`.
    //< It stops at a newline, which the string around it then reports open.
    $j: = at
    for j < src.len && src[j] != '\n'
        if src[j] == '\\' && j + 1 < src.len && src[j + 1] == '}'
            return j + 2
        if src[j] == '"'
            $inner_open: Sz = 0
            j = skip_string(src, j, inner_open@)
            if inner_open != 0
                return j
            continue
        if src[j] == '\''
            j = skip_char(src, j)
            continue
        j += 1
    return j

priv fn skip_char(src: U8[], at: Sz): Sz
    $j: = at + 1
    for j < src.len
        if src[j] == '\\' && j + 1 < src.len
            j += 2
            continue
        if src[j] == '\'' || src[j] == '\n'
            return j + 1
        j += 1
    return src.len

priv fn string_goes_on(src: U8[], at: Sz, open_str: Sz$@): Sz //<
    //< It walks a string's contents from `at` to past its close, or to the line's end
    //<
    //< `open_str` says which kind is open (1 raw, 2 plain), and is 0 once it closes. **The one walk
    //< for a string's contents**, its first line and the lines a `\` continues alike. Walked apart,
    //< a continued line would read the quotes of a string inside `\{ … \}` as the outer string's.
    $j: = at
    for j < src.len
        if open_str$ == 1
            if src[j] == '"' && src.starts_with("\"\"\"", j)
                open_str$ = 0
                return j + 3
        else
            if src[j] == '\\' && j + 1 < src.len && src[j + 1] == '{'
                j = skip_interp(src, j + 2)
                continue
            // Caution: **A `\` at a line's end does not skip the newline.** It continues the text
            // with the string still open; skipping it would join two physical lines and shift every
            // line number below.
            if src[j] == '\\' && j + 1 < src.len && src[j + 1] != '\n' && src[j + 1] != '\r'
                j += 2
                continue
            if src[j] == '"'
                open_str$ = 0
                return j + 1
        if src[j] == '\n'
            return j
        j += 1
    open_str$ = 0
    return src.len

fn next_line_comment(src: U8[], from: Sz): Sz //<
    //< Where the next line comment at or past `from` starts (`src.len` where none does)
    //<
    //< **It skips string and character literals**, raw ones across lines too. So a `//` inside a
    //< URL or inside program text held in a string is not taken for a comment.
    //< Caution: **Start it on code, never inside a string.** It reads from wherever it starts.
    $i: = from
    for i < src.len
        c: = src[i]
        if src.starts_with("//", i)
            return i
        if c == '"'
            $open_str: Sz = 0
            i = skip_string(src, i, open_str@)
            for open_str > 0 && i < src.len
                i = string_goes_on(src, i + 1, open_str@)
            continue
        if c == '\''
            i = skip_char(src, i)
            continue
        i += 1
    return src.len

// ---------------------------------------------------------
// Whether a line continues: **indentation alone is not enough.** KSPL's formatting wraps a long
// expression, so a deeper indentation can mean "a level" or "a continuation". The marks are in
// `line_cont.kspl`, which the formatter asks too. This is the half that depends on the line's own
// indentation.
// ---------------------------------------------------------

priv fn joins_above(src: U8[], lead_start: Sz, lead_end: Sz, lead_indent: Sz, indent: Sz, at: Sz):
    Bool //<
        //< Whether the line whose code starts at `at` joins the logical line above it
        //<
        //< That line's code runs `lead_start`..`lead_end`, its first line at column `lead_indent`.
        //< The marks decide (`joins_next`), but **the level after a `catch` is a block, not a
        //< continuation**: a line deeper than `lead_indent` there opens it.
    if ends_in_catch(src.sub(0, lead_end)) && indent > lead_indent
        return false
    return joins_next(src.sub(lead_start, lead_end - lead_start), src.sub_from(at))

priv fn holds_no_code(src: U8[], at: Sz): Bool //<
    //< Whether the line from `at`, outside every string, holds blanks and at most a line comment
    $j: = at
    for j < src.len && (src[j] == ' ' || src[j] == tab_byte || src[j] == cr_byte)
        j += 1
    return j >= src.len || src[j] == '\n' || src.starts_with("//", j)

// ---------------------------------------------------------
// Gathering into logical lines
// ---------------------------------------------------------
priv fn merge(src: U8[], phys: List<|Phys|>@, arena: Arena$@): List<|Logical|>
    $out: = List<|Logical|>.new(arena)
    $i: Sz = 0
    for i < phys.len
        p: = phys.get(i)
        if p.blank && !p.joins
            i += 1
            continue
        $last: = p
        $j: = i + 1
        for j < phys.len
            $k: = j
            // Caution: **Do not cut at a comment line.** A comment can stand partway through a
            // wrapped expression (the run of `.set(…)` in `ksplc/lsp/worker.kspl`) or between an
            // `=` and its value. The next line with code decides (`joins` in `scan_phys`).
            for k < phys.len && phys.get(k).blank && !phys.get(k).joins
                k += 1
            if k >= phys.len || !phys.get(k).joins
                break
            q: = phys.get(k)
            if !q.blank
                last = q
            j = k + 1
        // The heading is the last statement's: the one the line's end and a deeper line belong to.
        head: = heading_of(src, last.seg_from, last.code_end)
        out
            .push(Logical::{ .line = p.line, .indent = p.indent, .head = head,
            .code_start = p.code_start, .code_end = last.code_end, .attr = is_attribute(head) })
        i = j
    return out

priv fn head_word(src: U8[], from: Sz, to: Sz): U8[] //< a logical line's leading word
    //<
    //< The visibility (`pub` / `priv`) and a label (`<name>:`) are skipped.
    if is_label_only(src.sub(from, to - from))
        return "label:"
    $s: = from
    $word: U8[] = ""
    // Caution: **Limit the number of rounds.** Only the visibility and a label are skipped, so
    // anything beyond that is broken source (rejecting it is the compiler's job).
    for _k in Range.asc(head_skips.len + 2)
        $e: = s
        for e < to && src[e].is_alnum()
            e += 1
        word = src.sub(s, e - s)
        if word.len == 0
            // Caution: **Return the word after the `#` too.** The `#` alone makes an attribute
            // (`#cfg(…)`) and a directive (`##lint(…)`) look alike, and `is_attribute` below cannot
            // tell them apart.
            if s < to && src[s] == '#'
                $h: = s
                for h < to && src[h] == '#'
                    h += 1
                for h < to && src[h].is_alnum()
                    h += 1
                return src.sub(s, h - s)
            return src.sub(s, 1 if s < to else 0)
        // A label (`outer: for …`) is skipped.
        // Caution: **Tell it apart from `x: T = …`** — after a label there is always `for`,
        // `switch` or `if`, while a type can begin with `fn` (labelled_heads).
        if e < to && src[e] == ':' && is_labelled_head(next_word(src, e + 1, to))
            s = skip_spaces(src, e + 1, to)
            continue
        $skip: = false
        for h in head_skips
            if word.equals(h)
                skip = true
        if !skip
            return word
        s = skip_spaces(src, e, to)
    return word

priv fn skip_spaces(src: U8[], from: Sz, to: Sz): Sz //< base_lines.skip_blanks, stopping at `to`
    return base_lines.skip_blanks(src.sub(0, to), from)

priv fn next_word(src: U8[], from: Sz, to: Sz): U8[]
    s: = skip_spaces(src, from, to)
    $e: = s
    for e < to && src[e].is_alnum()
        e += 1
    return src.sub(s, e - s)

priv fn is_labelled_head(word: U8[]): Bool
    return word.is_one_of(U8[][]::labelled_heads)

priv fn is_block_head(word: U8[]): Bool
    return word.is_one_of(U8[][]::block_heads)

fn heads_a_block(code: U8[]): Bool //<
    //< Whether a line's leading word, after `pub` / `priv`, opens a block, or the line is a label
    //<
    //< The syntax messages ask it too (`syntax_msg.kspl`), so both use one list.
    return is_block_head(head_word(code, 0, code.len))

priv fn is_attribute(head: U8[]): Bool //< whether the line is an attribute (`#name`)
    //<
    //< **A directive (`##name(…)`) is not** — that one ends in a `;`.
    return head.len > 0 && head[0] == '#' && !head.starts_with("##")

// ---------------------------------------------------------
// The assembly
// ---------------------------------------------------------

priv struct Frame //< one level on the stack of open levels
    //<
    //< **Remember each level's column, not the indent width** (indenting by two and by four work
    //< the same).
    //< Caution: **Do not keep the closing position per level.** Every level closes at "the end of
    //< the logical line last seen". Kept per level, only the inner one moves forward, and the outer
    //< one closes at its heading.
    indent: Sz
    head: U8[]
    body: Sz //<
        //< The column of this level's first child. 0 = not seen yet.
        //<
        //< **Kept only to report whether siblings align; do not close levels by it**, or the rule
        //< above (the column, not the width) breaks.

struct Mended //< a source as an entry point read it, made ready for the parser
    written: U8[] //< the text as written, normalized (`settle` in `source_fix.kspl`)
    code: U8[] //< that text in the brace notation, which the parser reads

fn mend(raw: U8[], notes: List<|Note|>$@, arena: Arena$@): Mended //<
    //< The bytes an entry point read, normalized and converted into braces
    //<
    //< **Every entry point for a source goes through here.** These are the loader for what it
    //< opens, the formatter, and the language server for what the editor sends and what it reads
    //< from disk.
    //< Caution: **Mend only the bytes you read yourself.** Converted a second time, the `{` the
    //< first conversion inserted count as brackets and the text breaks.
    written: = parse_source_fix.settle(raw, arena)
    code: = to_braces(written, notes, arena)
    return Mended::{ .written = written, .code = code }

fn to_braces(src: U8[], notes: List<|Note|>$@, arena: Arena$@): U8[] //<
    //< It converts `src` into the brace notation
    //<
    //< **Pass `notes` empty**: it only appends the problems found, and never reads them.
    $ins: = List<|Insert|>.new(arena)
    phys: = scan_phys(src, notes, ins@, arena)
    lines: = merge(src, phys@, arena)
    $stack: = List<|Frame|>.new(arena)
    $last_end: Sz = 0
    for n in Range.asc(lines.len)
        cur: = lines.get(n)
        // Caution: **Close levels at the same column too.** A sibling's line is at the same column
        // as the heading, so comparing with `<` would push the next heading while the level is
        // still open.
        for stack.len > 0 && cur.indent <= stack.get(stack.len - 1).indent
            top: = stack.get(stack.len - 1)
            stack.len -= 1
            close_block(ins@, top, last_end)
        // Whether the siblings are aligned; by here `cur` is a direct child of the top level.
        // Caution: **Check after closing** — before it, the comparison would be against a
        // level already left.
        if stack.len > 0
            $top_now: = stack.get(stack.len - 1)
            if top_now.body == 0
                top_now.body = cur.indent
                stack.set(stack.len - 1, top_now)
            else if top_now.body != cur.indent
                notes
                    .push(Note::{ .kind = .ragged(top_now.body, cur.indent), .line = cur.line })
        next_deeper: = n + 1 < lines.len && lines.get(n + 1).indent > cur.indent
        if next_deeper
            ins.push(Insert::{ .at = cur.code_end, .text = " {" })
            stack.push(Frame::{ .indent = cur.indent, .head = cur.head, .body = 0 })
        else if !cur.attr && !closes_inline_block(src, cur) && !arms_follow(cur, lines@, n)
            if ends_in_block_end(src, cur)
                // The `;` became a space, and its note is out (`block_end`).
                last_end = cur.code_end
                continue
            if src[cur.code_end - 1] == ';'
                notes.push(written_terminator(src, cur))
            else
                ins.push(Insert::{ .at = cur.code_end, .text = ";" })
        last_end = cur.code_end
    for stack.len > 0
        top: = stack.get(stack.len - 1)
        stack.len -= 1
        close_block(ins@, top, last_end)
    return splice(src, ins@, arena)

priv const defer_statement: U8[] = "defer statement" //<
    //< The head word for a `defer` holding one statement (`defer buf.free()`)
    //<
    //< It opens no level of its own.
    //<
    //< The space keeps it from matching any written word, as with `"label:"`.

priv fn heading_of(src: U8[], from: Sz, to: Sz): U8[] //<
    //< The line's head word, telling apart a `defer` that holds one statement
    //<
    //< Caution: **Only a `defer` alone or before a `{` opens its own level.** Treated as one,
    //< `defer f() catch {}` would end in the block's `}` and get no terminator. A `catch` level
    //< below `defer f() catch e` would close without one. The next statement would be read into it.
    head: = head_word(src, from, to)
    if !head.equals("defer")
        return head
    $s: = from + 5
    for s < to && src[s] == ' '
        s += 1
    return head if s >= to || src[s] == '{' else defer_statement

priv fn closes_inline_block(src: U8[], cur: Logical): Bool //<
    //< Whether the line opens and closes a block on itself
    //<
    //< That is `fn f() {}` / `for {}` / `case .x {}` / `defer { … }`.
    //<
    //< Caution: **Add no terminator**: `fn f() {};` is not in the grammar. The heading word tells
    //< it apart, as an `x: = T::{ … }` ends in a `}` too but is a value and needs one.
    return cur.code_end > 0 && src[cur.code_end - 1] == '}' && is_block_head(cur.head)

priv fn ends_in_block_end(src: U8[], cur: Logical): Bool //<
    //< Whether `cur` ends in a `;` written after the `}` of its own one-line block (`block_end`)
    if src[cur.code_end - 1] != ';' || !is_block_head(cur.head)
        return false
    $before: = cur.code_end - 1
    for before > cur.code_start && (src[before - 1] == ' ' || src[before - 1] == tab_byte)
        before -= 1
    return before > cur.code_start && src[before - 1] == '}'

priv fn written_terminator(src: U8[], cur: Logical): Note //<
    //< The note for a `;` written at the end of `cur`, on the physical line that holds it
    $line: = cur.line
    for k in Range.new(cur.code_start, cur.code_end, 1)
        if src[k] == '\n'
            line += 1
    start: = base_lines.line_start(src, cur.code_end - 1)
    return Note::{ .kind = .terminator(cur.code_end - 1 - start), .line = line }

priv fn arms_follow(cur: Logical, lines: List<|Logical|>@, n: Sz): Bool //<
    //< Whether `cur` (the `n`th line) is a `switch`'s head whose first `case` is the next line
    //<
    //< **The head then takes no terminator**: the `case` continues it, as a later arm continues the
    //< `}` before it. A comment or blank line between them is no logical line, so changes nothing.
    //< Caution: **Only at the head's own column.** A deeper `case` would open a block `switch` does
    //< not have, and a shallower one belongs to the level outside; both stay refused.
    if !cur.head.equals("switch") || n + 1 >= lines.len
        return false
    next: = lines.get(n + 1)
    return next.indent == cur.indent && next.head.equals("case")

priv fn close_block(ins: List<|Insert|>$@, top: Frame, at: Sz) //<
    //< It closes a block, with a `;` after unless its heading word is in `block_heads`
    ins.push(Insert::{ .at = at, .text = " }" if is_block_head(top.head) else " };" })

priv fn splice(src: U8[], ins: List<|Insert|>@, arena: Arena$@): U8[] //<
    //< it applies the insertions, keeping the order of those at the same position (see `Insert`)
    $order: = List<|Sz|>.new(arena)
    for k in Range.asc(ins.len)
        order.push(k)
    // Stably, by ascending position (a plain insertion sort; the count is the line count).
    for a in Range.asc(order.len)
        $b: = a
        for b > 0 && ins.get(order.get(b - 1)).at > ins.get(order.get(b)).at
            x: = order.get(b - 1)
            order.set(b - 1, order.get(b))
            order.set(b, x)
            b -= 1
    out: = arena.text()
    $at: Sz = 0
    for k in Range.asc(order.len)
        one: = ins.get(order.get(k))
        if one.at > at
            out.s(src.sub(at, one.at - at))
            at = one.at
        out.s(one.text)
        at += one.drop
    if at < src.len
        out.s(src.sub_from(at))
    return out.take()

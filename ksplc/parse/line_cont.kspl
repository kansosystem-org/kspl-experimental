//< Which marks and words at a line's end or start join two physical lines into one logical line
//<
//< **The reader of `.kspl` and the formatter that writes it both ask here.** Otherwise a mark on
//< only one list makes the formatter break a line where the reader ends it (Principle 6 in
//< `../../docs/DESIGN-principles.md`).
//< Caution: **The one join indentation decides stays with the reader.** A line ending in `catch`
//< joins the next only at the same column (`joins_above` in `layout.kspl`). `joins_next` says
//< what the text alone decides, and the formatter never ends a line with `catch`.
import "ksplc/base/core" as _base_core // `is_one_of`
import "std/chars" // `is_alnum`
import "std/str" // `equals`

priv const CONT_WORDS: U8[][3] = ::{ "as", "in", "catch" } //<
    //< The words that continue a line onto the next when they end it
    //<
    //< **A word that also stands alone does not continue a value.** A conditional value's `if` /
    //< `else` and a `return` / `throw` / `fallback` are not here. A line starting or ending with
    //< one also reads as a statement. So a value split there goes in parentheses (the rule is "The
    //< indentation notation (`.kspl`)" in `../../docs/DESIGN-notation.md`).

priv const LEAD_CONT_WORDS: U8[][1] = ::{ "catch" } //<
    //< The words that continue the previous line when they start a line
    //<
    //< No statement begins with one.
    //< Caution: **Do not add `defer`.** At a line's start it is a heading that opens a block; read
    //< as a continuation, its whole block moves one statement earlier.

fn joins_next(code: U8[], next: U8[]): Bool //<
    //< Whether a line ending in `code` and the line below, whose code starts `next`, read as one
    //<
    //< `code` is the line's code without a trailing comment or blanks; `next` can run past the
    //< next line's first word. **Inside a bracket every newline joins**, whatever this says: the
    //< caller knows the depth.
    if line_continues(code) || (next.len > 0 && starts_cont(next[0]))
        return true
    if word_at(next, 0).is_one_of(U8[][]::LEAD_CONT_WORDS)
        return true
    $s: = code.len
    for s > 0 && code[s - 1].is_alnum()
        s -= 1
    return code.sub_from(s).is_one_of(U8[][]::CONT_WORDS)

priv fn word_at(text: U8[], at: Sz): U8[] //< the run of name characters starting at `at`
    $e: = at
    for e < text.len && text[e].is_alnum()
        e += 1
    return text.sub(at, e - at)

fn line_continues(code: U8[]): Bool //<
    //< Whether a line whose code is `code` continues onto the line below
    //<
    //< `code` is the line's code, without a trailing comment or surrounding blanks
    //<
    //< Caution: **A label's line is not a continuation**; its `:` opens a block. **Nor is a `|>` a
    //< comparison**: `: List<|Row|>` ends a heading, and the level below would be pulled in. Both
    //< guards live here, since a caller that forgot one would go unnoticed.
    if code.len == 0 || is_label_only(code)
        return false
    if code.len >= 2 && code[code.len - 1] == '>' && code[code.len - 2] == '|'
        return false
    return ends_open(code[code.len - 1])

fn breaks_off_a_value(code: U8[]): Bool //<
    //< Whether the line's code breaks off partway through a value, so the line below holds the rest
    //<
    //< The formatter asks: the continuation of such a line needs an indent that no level gives it.
    //< **A `,` does not break a value off**; it closes an item, which its level indents (the caller
    //< handles a bracket's items first).
    return code.len > 0 && code[code.len - 1] != ',' && line_continues(code)

fn is_label_only(code: U8[]): Bool //<
    //< Whether the line is only `<name>:` (the heading of a labelled block)
    $e: Sz = 0
    for e < code.len && code[e].is_alnum()
        e += 1
    return e > 0 && e + 1 == code.len && code[e] == ':'

fn ends_in_catch(code: U8[]): Bool //<
    //< Whether the code ends in `catch` or in `catch <name>`, ignoring trailing blanks
    //<
    //< **The one check for that pair**: the only spelling that opens the next level without ending
    //< in a mark (a block inside an expression). The reader asks it of a line it reads, the
    //< formatter of the line it is writing, where a break would lose the handler's value.
    $e: = code.len
    for _w in Range.asc(2)
        for e > 0 && code[e - 1] == ' '
            e -= 1
        $s: = e
        for s > 0 && code[s - 1].is_alnum()
            s -= 1
        if s == e
            return false
        if code.sub(s, e - s).equals("catch")
            return true
        e = s
    return false

fn takes_value_on_its_line(word: U8[]): Bool //<
    //< Whether a statement's word takes its value on its own line (`return` / `throw` / `fallback`)
    //<
    //< **A line holding one of them alone is a statement of its own** (a bare `return`). So a value
    //< on a deeper line below reads as the next statement, not as its value.
    return word.equals("return") || word.equals("throw") || word.equals("fallback")

priv fn ends_open(c: U8): Bool //<
    //< The marks that continue a line onto the next when they end it
    //<
    //< The last character of a two-character operator (`&&` `==` `<<`) is on this list too.
    //< Caution: **Do not add the `!`.** At a line's end it passes an error on (`f()!`); at a
    //< line's start, `starts_cont` below handles it (a wrapped `T!E`, or a `!x` operand).
    return c == ',' || c == '=' || c == ':' || c == '+' || c == '-' || c == '*' || c == '/' ||
        c == '%' || c == '|' || c == '&' || c == '^' || c == '<' || c == '>' || c == '~'

fn starts_cont(c: U8): Bool //<
    //< The marks that make a line continue the previous one when they start it
    return c == '.' || c == ')' || c == ']' || c == ',' || c == '|' || c == '&' || c == '+' ||
        c == '-' || c == '*' || c == '/' || c == '%' || c == '^' || c == '=' || c == '<' || c == '>'
        || c == '!' || c == '~'

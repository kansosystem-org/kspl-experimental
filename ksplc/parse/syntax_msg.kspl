//< What to say when the syntax cannot be parsed
//<
//< **This file only guesses from the text that could not be parsed.** Loading and analysis belong
//< to `load.kspl`; this file reads only `kspeg`'s list of expectations and the source text (**one
//< way**: it does not import `load.kspl`). Each guess targets one known shape.

import "kspeg/engine" as kspeg
import "kspeg/expected" { Expected }
import "ksplc/base/core" as base_core
import "ksplc/base/lines" { line_end, line_start }
import "ksplc/base/literal" { interpolation_open_at, literal_end }
import "ksplc/parse/layout" { heads_a_block }
import "ksplc/parse/line_cont" { takes_value_on_its_line }
import "std/chars"
import "std/str" { Str_builder }
import "std/strfmt" as _strfmt // the `:x` of a hint

priv fn skip_space_back(src: U8[], pos: Sz): Sz
    $i: = pos - 1
    for i >= 0 &&
        (src[i] == ' ' || src[i] == '\t' || src[i] == '\n' || src[i] == '\r')
        i -= 1
    return i

priv fn enclosing_block_head(src: U8[], pos: Sz): U8[] //<
    //< The heading word (`enum` / `struct` / `fn` …) of the level enclosing the failure position
    //<
    //< Empty where none is found. **Comments and strings are not skipped**: a `{` in one can shift
    //< the result, but the answer only chooses a note, never a verdict.
    $depth: Sz = 0
    $i: = pos - 1
    for i >= 0
        if src[i] == '}'
            depth += 1
        else if src[i] == '{'
            if depth == 0
                break
            depth -= 1
        i -= 1
    if i < 0
        return ""
    start: = line_start(src, i)
    return first_word_after_visibility(src.sub(start, i - start))

priv fn first_word_after_visibility(head: U8[]): U8[] //<
    //< The first word on the heading line, skipping the visibility (`pub` / `priv`)
    $s: = word_start(head, 0)
    $e: = word_end(head, s)
    if head.sub(s, e - s).equals("pub") || head.sub(s, e - s).equals("priv")
        s = word_start(head, e)
        e = word_end(head, s)
    return head.sub(s, e - s)

priv fn word_start(head: U8[], at: Sz): Sz //<
    //< Where the first word at or after `at` begins
    $j: = at
    for j < head.len && !head[j].is_alnum()
        j += 1
    return j

priv fn word_end(head: U8[], at: Sz): Sz //< the end of the word running from `at`
    $e: = at
    for e < head.len && head[e].is_alnum()
        e += 1
    return e

priv fn starts_a_statement(src: U8[], pos: Sz): Bool //<
    //< Whether a statement begins at that position
    //<
    //< **The start of a body counts too**, so the first statement of a function is one.
    before: = skip_space_back(src, pos)
    return (true if before < 0
        else src[before] == ';' || src[before] == '{' || src[before] == '}')

priv fn forbidden_spelling_hint(src: U8[], pos: Sz): U8[] //<
    //< The sentence explaining a spelling **the specification chose not to have**, or empty
    //<
    //< The expected set alone (`expected 'pub', 'priv', …`) does not say a decision exists. Each
    //< shape is recognized by looking at both sides of the failure position.
    if pos < 0 || pos > src.len
        return ""
    // A bare block (`{ … }` as a statement of its own): `stmt` does not include `stmt_block`
    // (`../kspl.kspeg`), so the failure lands on the `{`.
    // Caution: **Ask what stands before it.** A valid `{` (`if cond {`, `T::{ … }`) has a name
    // or a mark in front; only one where a statement begins is bare.
    if pos < src.len && src[pos] == '{' && starts_a_statement(src, pos)
        return "\n  Note: a bare block carries a label. Name its purpose ('while_locked: { ... }'). \
            Without a heading, it looks like a continuation of the previous statement."
    // A block under a `switch`: C's, Go's, Swift's and Rust's `switch x {`, or a `.kspl` `case`
    // indented under its head, whose `{` the indentation reader put there.
    if pos < src.len && src[pos] == '{' && is_switch_head(src, line_start(src, pos), pos)
        return "\n  Note: a 'switch' opens no block of its own. Each 'case' and 'default' opens \
            one. Align them with 'switch'. Put the first 'case' on the next line."
    // `?` after a value (`f()?`): only a type takes it, so the failure lands on it there.
    if pos < src.len && src[pos] == '?'
        return "\n  Note: '?' marks an optional type ('I32?' is 'Option<|I32|>'). It does nothing \
            after a value. Use 'f()!' to pass on a call's failure. Use 'if v: = x' to get an \
            optional's value."
    // A result in the old spelling (`I32?Io_error`): `I32?` is whole, so the name after it fails.
    before: = skip_space_back(src, pos)
    if before >= 0 && src[before] == '?' && pos < src.len && src[pos].is_alpha()
        return "\n  Note: a result is written with '!' ('I32!Io_error'). 'I32?' is an optional \
            type. No type name follows it."
    // The range syntax `a..b` / the slice syntax `a[i..j]`: the failure lands on the second `.`.
    if pos >= 1 && pos < src.len && src[pos] == '.' && src[pos - 1] == '.'
        return "\n  Note: KSPL has no range syntax ('a..b'). Write the bounds in the loop header \
            ('for $i: = a; i < b; i += 1'). Use 'x.sub(start, len)' for a sub-slice."
    prev: = skip_space_back(src, pos)
    // A trailing closure (`count_over(xs) fn(x: I32; ): Bool`, Swift's and Kotlin's shape). Nothing
    // in KSPL puts a `fn` right after a call's `)`, so the failure lands on the `fn`.
    if prev >= 0 && src[prev] == ')' && src.starts_with("fn", pos) &&
        word_end(src, pos) == pos + 2
        return "\n  Note: KSPL has no trailing closure. Pass the closure inside the call's \
            parentheses ('f(xs, fn(x: I32; ): Bool { return x > 0 })'). Alternatively, bind it to a \
            name and pass that name."
    // A postfixed `if` (`return x if cond;` / `return if cond;`): an unmatched ternary's shape.
    // Caution: A ternary (`a if cond else b`) exists, so do not say "an `if` cannot be written";
    // what is missing is a branch.
    if statement_has_if_without_else(src, pos)
        return "\n  Note: 'if' as an expression needs all three parts ('a if cond else b'). KSPL \
            has no postfix condition ('x if cond'). To branch without a value, write 'if cond { ... \
            }' first."
    // An enum's values separated by `,`. **The expected set alone does not make it clear**: its
    // `';'` does not read as "a `;`, not a `,`".
    if pos < src.len && src[pos] == ',' && enclosing_block_head(src, pos).equals("enum")
        return "\n  Note: an enum value stands on its own, as a struct field does. Separate enum \
            values with ';'. Use ',' only between fields inside a payload ('mid(level: I32, tone: \
            U8)')."
    return ""

priv fn is_switch_head(src: U8[], from: Sz, to: Sz): Bool //<
    //< Whether the line's text up to `to` is a `switch` and its subject alone, a label allowed
    //<
    //< **A `case` written makes it not**: a `{` failing after one is that arm's own.
    $code: = src.sub(from, to - from).trim_spaces()
    e: = word_end(code, 0)
    if e > 0 && e < code.len && code[e] == ':' && !code.starts_with("::", e)
        code = code.sub_from(e + 1).trim_spaces()
    return starts_with_word(code, "switch") && code.find_str(" case ").is_none() &&
        !ends_with_word(code, "case")

priv fn odd_indent_name(src: U8[], pos: Sz): U8[] //<
    //< The name of what starts the failing line looking like whitespace but is not, or empty
    //<
    //< Caution: **Text can look like indentation without counting as it.** Only the ASCII space
    //< counts (`layout.kspl`), so such a line is at column 0 and the error says "a declaration
    //< ought to come". **Check for the fullwidth space first.**
    if pos < 0 || pos > src.len
        return ""
    $s: = line_start(src, pos)
    for s < src.len && src[s] == ' '
        s += 1
    if s >= src.len
        return ""
    if src.starts_with("\u3000", s)
        return "an ideographic space (U+3000)"
    if src.starts_with("\u00A0", s)
        return "a no-break space (U+00A0)"
    if src[s] == '\t'
        return "a tab"
    if src[s] == 0x0cU8
        return "a form feed (U+000C)"
    if src[s] == 0x0bU8
        return "a vertical tab (U+000B)"
    return ""

priv fn block_head_without_body(src: U8[], pos: Sz): Bool //<
    //< Whether the failing line is a heading that opens a level with no deeper line after it
    //<
    //< **An empty level and one holding only comments are both this**: a comment line makes no
    //< level. It looks only at whether the next line with contents is deeper.
    if pos < 0 || pos > src.len
        return false
    s: = line_start(src, pos)
    // **Only where the line's code has ended.** A heading fails where its `{` would stand. A
    // failure partway through the line is a mistake there (`x: [3]I32` read as a label).
    head: = code_line(src, s)
    if pos < s + head.indent + head.code.len
        return false
    $head_indent: Sz = 0
    for s + head_indent < src.len && src[s + head_indent] == ' '
        head_indent += 1
    $i: = line_end(src, s)
    // It looks for the next line with contents, skipping blank lines and comment-only lines.
    for i < src.len
        i += 1
        $n: Sz = 0
        for i + n < src.len && src[i + n] == ' '
            n += 1
        at: = i + n
        if at >= src.len
            return true
        if src[at] == '\n' || src.starts_with("//", at)
            i = line_end(src, at)
            continue
        return n <= head_indent
    return true

priv struct Code_line //< one line's code, without the comment or surrounding blanks
    indent: Sz
    code: U8[]
    next_at: Sz //< where the line after it begins

priv fn code_line(src: U8[], at: Sz): Code_line //< the line beginning at `at`
    e: = line_end(src, at)
    $b: = at
    for b < e && src[b] == ' '
        b += 1
    $c: = b
    for c < e
        if src[c] == '"' || src[c] == '\''
            c = literal_end(src, c)
            continue
        if src.starts_with("//", c)
            break
        c += 1
    if c > e
        c = e
    return Code_line::{ .indent = b - at, .code = drop_mended_tail(src.sub(b, c - b)),
        .next_at = e + 1 }

priv fn drop_mended_tail(code: U8[]): U8[] //<
    //< The line's own text, without the marks the indentation reader added after it
    //<
    //< The text read here is the parser's, whose lines end in that reader's ` {` / `;` / ` }`
    //< (`to_braces` in `layout.kspl`).
    $n: = code.len
    for n > 0
        if code[n - 1] == ' ' || code[n - 1] == '\r' || code[n - 1] == ';'
            n -= 1
        else if n >= 2 && code[n - 2] == ' ' && (code[n - 1] == '{' || code[n - 1] == '}')
            n -= 2
        else
            break
    return code.sub(0, n)

priv fn next_code_line(src: U8[], after: Code_line): Code_line //<
    //< The first line after `after` holding code
    //<
    //< Blank lines and comment lines are skipped, as the indentation notation skips them.
    $l: = code_line(src, after.next_at)
    for l.code.len == 0 && l.next_at <= src.len
        l = code_line(src, l.next_at)
    return l

priv fn ends_with_word(code: U8[], w: U8[]): Bool //< whether the code's last word is `w`
    if code.len < w.len || !code.sub_from(code.len - w.len).equals(w)
        return false
    return code.len == w.len || !code[code.len - w.len - 1].is_alnum()

priv fn starts_with_word(code: U8[], w: U8[]): Bool //< whether the code's first word is `w`
    return code.starts_with(w) && (code.len == w.len || !code[w.len].is_alnum())

priv fn append_split_value_hint(msg: Str_builder$@, src: U8[], pos: Sz): Bool //<
    //< It writes the sentence naming the parentheses a value split onto a deeper line needs
    //<
    //< It does so where the failing line continues a value onto a deeper line in a way the
    //< indentation notation does not accept.
    //<
    //< Two shapes: a conditional value broken at its `if` / `else`, and a value below a lone
    //< `return` / `throw` / `fallback` (the rule is "The indentation notation (`.kspl`)" in
    //< `../../docs/DESIGN-notation.md`).
    if pos < 0 || pos > src.len
        return false
    cur: = code_line(src, line_start(src, pos))
    next: = next_code_line(src, cur)
    if cur.code.len == 0 || next.indent <= cur.indent || next.code.len == 0
        return false
    if takes_value_on_its_line(cur.code)
        w: = cur.code
        msg.s("\n  Note: a '").s(w)
            .s("' takes its value on the same line. A deeper line below a lone '").s(w)
            .s("' is not read as its value. Start the value on the '").s(w)
            .s("' line. Put a long value in parentheses to split it across lines.")
        return true
    split_choice: =
        ((ends_with_word(cur.code, "if") || ends_with_word(cur.code, "else")) &&
        cur.code.find_char(' ').is_some()) || starts_with_word(next.code, "if") ||
        starts_with_word(next.code, "else")
    if !split_choice || heads_a_block(cur.code)
        return false
    msg
        .s("\n  Note: a conditional value split across lines goes in parentheses ('(a if c' on one \
            line and 'else b)' on the next). Outside parentheses, a line starting or ending with \
            'if' or 'else' reads as a statement.")
    return true

priv fn append_trailing_defer_hint(msg: Str_builder$@, src: U8[], pos: Sz): Bool //<
    //< It writes the sentence saying a `defer` must start its own statement, where it fails on one
    //<
    //< The sentence includes the line to write: the call as written, or, for a bare call, with the
    //< declared name in front.
    //<
    //< A `defer` that starts a statement parses, so failing on one means it follows another
    //< (`buf: = Str_builder.new() defer .free()`, or after the `}` of a `catch` block).
    if pos < 0 || !src.starts_with("defer", pos) || word_end(src, pos) != pos + 5
        return false
    name: = declared_name(src, statement_start(src, pos))
    call: = code_line(src, pos + 5).code
    msg.s("\n  Note: a 'defer' must start a separate statement. ")
    if name.len > 0 && call.starts_with(".")
        msg.s("Put 'defer ").s(name).s(call).s("' on the next line.")
    else if call.len > 0 && !call.starts_with(".")
        msg.s("Put 'defer ").s(call).s("' on the next line.")
    else
        msg.s("Put it on the next line. Name what it cleans up ('defer x.free()').")
    return true

priv const other_typedef_words: U8[][4] = ::{ "alias", "type", "typealias", "using" } //<
    //< The words other languages use to give a type another name, where KSPL writes `typedef`
    //<
    //< They are D's; Rust's, Go's and Python's; Swift's and Kotlin's; C++'s.

priv fn append_typedef_spelling_hint(msg: Str_builder$@, src: U8[], pos: Sz): Bool //<
    //< It writes the `typedef` line to use instead of another language's or C's type alias
    //<
    //< It does so where the failing line gives a type another name with another language's keyword
    //< or in C's order.
    //<
    //< `alias Id = I32` fails on the `Id`: the word reads as a variable's name needing a `:`. C's
    //< `typedef I32 Id` fails on the `I32`, and `typedef U8[] Bytes` on the `[`.
    if pos < 0 || pos > src.len
        return false
    code: = code_line(src, line_start(src, pos)).code
    $s: Sz = 0
    first: = code.sub(0, word_end(code, 0))
    if first.equals("pub") || first.equals("priv")
        s = word_start(code, first.len)
    e: = word_end(code, s)
    word: = code.sub(s, e - s)
    after: = code.sub_from(e).trim_spaces()
    if word.equals("typedef")
        $k: = after.len
        for k > 0 && after[k - 1].is_alnum()
            k -= 1
        if after.find_char('=').is_some() || k == 0 || k == after.len ||
            !after[k].is_alpha()
            return false
        msg.s("\n  Note: 'typedef' puts the new name first. Put the type after '=': '")
            .s(code.sub(0, s)).s("typedef ").s(after.sub_from(k)).s(" = ")
            .s(after.sub(0, k).trim_spaces()).s("'.")
        return true
    rest: = after.sub_from(word_end(after, 0)).trim_spaces()
    if word_end(after, 0) == 0 || !rest.starts_with("=") || rest.starts_with("==")
        return false
    for w in other_typedef_words
        if word.equals(w)
            msg.s("\n  Note: use 'typedef' to declare another name for a type: '")
                .s(code.sub(0, s)).s("typedef ").s(after).s("'.")
            return true
    return false

priv fn append_statement_word_hint(msg: Str_builder$@, src: U8[], pos: Sz): Bool //<
    //< It writes KSPL's head where a statement opens with `while`, `loop` or `match`
    //<
    //< Each reads as a name followed by what no name takes, so the expectation list alone leads
    //< nowhere. **The words stay names**: the note only explains an error the line already has.
    if pos < 0 || pos > src.len
        return false
    code: = code_line(src, line_start(src, pos)).code
    e: = word_end(code, 0)
    word: = code.sub(0, e)
    rest: = code.sub_from(e).trim_spaces()
    // A name in use (`match(x)`, `loop: = 1`, `match.len`) is followed by no space or by a mark.
    if e == 0 || (e < code.len && code[e] != ' ') || rest.starts_with("=") ||
        rest.starts_with(":") || rest.starts_with(".")
        return false
    head: = rest.sub(0, rest.find_char('{').unwrap_or(rest.len)).trim_spaces()
    if word.equals("while") && head.len > 0
        msg
            .s("\n  Note: every loop is written with 'for'. A condition alone repeats the loop \
                while the condition holds: 'for ").s(head).s("'.")
        return true
    if word.equals("loop") && head.len == 0
        msg
            .s("\n  Note: every loop is written with 'for'. A bare 'for' repeats until a 'break' \
                leaves it.")
        return true
    if !word.equals("match") || head.len == 0
        return false
    msg
        .s("\n  Note: KSPL branches on a value with 'switch'. Start each case with 'case'. Do not \
            enclose all cases in braces: 'switch ").s(head)
        .s("" if head.find_str(" case ").is_some() else " case ...").s("'.")
    return true

priv fn statement_start(src: U8[], pos: Sz): Sz //<
    //< Where the statement holding `pos` starts
    //<
    //< That is after the `;` or the opening bracket before it; a bracket closed along the way is
    //< skipped whole.
    //<
    //< **Comments and strings are not skipped**, as in `enclosing_block_head`; the answer only
    //< affects what a note suggests.
    $depth: Sz = 0
    $i: = pos - 1
    for i >= 0
        ch: = src[i]
        if ch == '}' || ch == ')' || ch == ']'
            depth += 1
        else if ch == '{' || ch == '(' || ch == '['
            if depth == 0
                break
            depth -= 1
        else if ch == ';' && depth == 0
            break
        i -= 1
    return i + 1

priv fn declared_name(src: U8[], from: Sz): U8[] //<
    //< The name a statement beginning at `from` declares (`buf` of `$buf: = …`), or empty
    //<
    //< **A `::` is not a declaration's `:`.** `T::{ … }` and a cast hold one after a name.
    $s: = from
    for s < src.len &&
        (src[s] == ' ' || src[s] == '\t' || src[s] == '\n' || src[s] == '\r')
        s += 1
    if s < src.len && src[s] == '$'
        s += 1
    e: = word_end(src, s)
    if e == s || src[s].is_digit()
        return ""
    $c: = e
    for c < src.len && src[c] == ' '
        c += 1
    if c >= src.len || src[c] != ':' || src.starts_with("::", c)
        return ""
    return src.sub(s, e - s)

priv fn statement_has_if_without_else(src: U8[], pos: Sz): Bool //<
    //< Whether the statement before `pos` (back to a `;` `{` `}`) has an `if` and no `else`
    $start: = pos - 1
    for start >= 0 && src[start] != ';' && src[start] != '{' && src[start] != '}'
        start -= 1
    span: = src.sub(start + 1, pos - start - 1)
    return span.find_str(" if").is_some() && span.find_str(" else").is_none()

priv const max_open: Sz = 64 //< how many brackets can be open before the count below gives up

priv fn append_unclosed_bracket_hint(msg: Str_builder$@, src: U8[], pos: Sz): Bool //<
    //< It writes the sentence naming where an unclosed `(` or `[` around the failure opened
    //<
    //< The rule is "What a syntax error names" in `../docs/DESIGN-parse.md`.
    //<
    //< **"Never closed" is checked over the rest of the text.** A bracket closed further on means
    //< the mistake is inside it (a missing `,`). Naming the bracket would mislead the author.
    //< **A `{` is left out**: in the brace notation it can be a block's rather than a value's.
    at: = innermost_open(src, pos)
    if at < 0 || src[at] == '{'
        return false
    closer: = ')' if src[at] == '(' else ']'
    if pos < src.len && (src[pos] == ')' || src[pos] == ']') && src[pos] != closer
        msg.s("\n  Note: this '").c(src[pos]).s("' cannot close the '").c(src[at]).s("' at ")
        append_place(msg, src, at)
        msg.s(". Only a '").c(closer).s("' can close it.")
        return true
    $depth: Sz = 0
    $j: = pos
    for j < src.len
        c: = src[j]
        if c == '(' || c == '[' || c == '{'
            depth += 1
        else if is_closer(c)
            if depth == 0
                if c == closer
                    return false
                break
            depth -= 1
        j = text_step(src, j)
    msg.s("\n  Note: the '").c(src[at]).s("' at ")
    append_place(msg, src, at)
    msg
        .s(" is never closed. What follows it was read as its contents. Close it where its contents \
            end.")
    return true

priv fn innermost_open(src: U8[], pos: Sz): Sz //<
    //< Where the innermost bracket still open at `pos` opened, or -1 where none is
    //<
    //< It is also -1 where they nest deeper than `max_open`.
    $open: Sz[max_open] = ::{}
    $n: Sz = 0
    $i: Sz = 0
    for i < pos && i < src.len
        c: = src[i]
        // **Where `pos` lies inside a literal, look inside its interpolation**: stepping over the
        // whole literal would leave the call's `(` around it open and blame that.
        if (c == '"' || c == '\'') && literal_end(src, i) > pos
            inner: = interpolation_open_at(src, i, pos)
            if inner < 0
                return -1
            n = 0
            i = inner + 2
            continue
        if c == '(' || c == '[' || c == '{'
            if n == max_open
                return -1
            open[n] = i
            n += 1
        else if is_closer(c) && n > 0
            n -= 1
        i = text_step(src, i)
    return open[n - 1] if n > 0 else -1

priv fn opened_by_layout(src: U8[], at: Sz): Bool //<
    //< Whether the `{` at `at` is one the indentation reader put in, rather than one written
    //<
    //< The reader puts ` {` at the end of a heading's code (`to_braces` in `layout.kspl`). A
    //< written `{` that ends a line stands inside a call's brackets (a closure's body) or after
    //< `::` (a value). A written block's `{` has its body on its own line.
    if at < 1 || src[at] != '{' || src[at - 1] != ' '
        return false
    $j: = at + 1
    for j < src.len && src[j] == ' '
        j += 1
    if j < src.len && src[j] != '\n' && !src.starts_with("//", j)
        return false
    around: = innermost_open(src, at)
    return around < 0 || src[around] == '{'

priv fn append_non_ascii_hint(msg: Str_builder$@, src: U8[], pos: Sz): Bool //<
    //< It writes the sentence naming a character outside ASCII where a name or a mark was expected
    //<
    //< Python, Rust, Swift, Java and C++ all take a name in other scripts (`café`, `かんそ`). So
    //< the writer expects it to work. KSPL's names are ASCII ("Identifiers and naming rules" in
    //< `docs/SPEC-language.md`), and the expected list alone does not say why `か` is refused.
    if pos >= src.len || src[pos] < 0x80U8
        return false
    $end: = pos + 1
    for end < src.len && (src[end] & 0xC0U8) == 0x80U8
        end += 1
    msg.s("\n  Note: a name is written with ASCII letters, digits and '_' alone. '")
        .s(src.sub(pos, end - pos))
        .s("' cannot appear in a name. Spell the name in ASCII. Put other text in a string or a \
            comment.")
    return true

priv fn append_missing_comma_hint(msg: Str_builder$@, src: U8[], pos: Sz): Bool //<
    //< It writes the sentence naming a `,` that can be missing between two items of a list
    //<
    //< It does so where two items stand side by side inside a list's brackets ("What a syntax
    //< error names" in `../docs/DESIGN-parse.md`).
    //<
    //< **Only a list's brackets**: a call's or a signature's `(`, which has a name or a closing
    //< bracket right in front of it, and a value's `::{`. Grouping parentheses hold one value.
    at: = innermost_open(src, pos)
    if at < 1 || pos >= src.len || !starts_item(src, pos)
        return false
    before: = src[at - 1]
    call: =
        src[at] == '(' &&
        (before.is_alnum() || before == ')' || before == ']' || before == '>')
    value: = src[at] == '{' && at >= 2 && before == ':' && src[at - 2] == ':'
    prev: = skip_space_back(src, pos)
    if !(call || value) || prev <= at || prev + 1 == pos || !ends_item(src[prev])
        return false
    e: = word_end(src, pos)
    msg.s("\n  Note: a ',' may be missing before ")
    if e > pos
        msg.s("'").s(src.sub(pos, e - pos)).s("'")
    else
        msg.s("this item")
    msg.s(". Separate the items of a list with ','.")
    return true

priv fn append_leading_zero_hint(msg: Str_builder$@, src: U8[], pos: Sz): Bool //<
    //< It writes the sentence naming a decimal integer that starts with `0`, which KSPL refuses
    //<
    //< C reads `0755` as octal (493), and KSPL has no octal literal, so the spelling is not read at
    //< all rather than read as a different number. The failure lands on the digits' end (a float's
    //< `.` was expected) or on the `0` itself.
    $start: = pos if pos < src.len else src.len
    for start > 0 && (src[start - 1].is_digit() || src[start - 1] == '_')
        start -= 1
    if start >= src.len || src[start] != '0' || start + 1 >= src.len ||
        !(src[start + 1].is_digit() || src[start + 1] == '_')
        return false
    if start > 0 && (src[start - 1].is_alnum() || src[start - 1] == '.')
        return false
    $end: = start
    $octal: U64 = 0
    $is_octal: = true
    for end < src.len && (src[end].is_digit() || src[end] == '_')
        if src[end] != '_'
            is_octal = is_octal && src[end] <= '7' && octal < 0x1000000000000000U64
            octal = octal * 8U64 + U64::(src[end] - '0')
        end += 1
    spelled: = src.sub(start, end - start)
    $rest: = start
    for rest < end - 1 && (src[rest] == '0' || src[rest] == '_')
        rest += 1
    msg.s("\n  Note: a decimal integer does not start with 0. KSPL has no octal literal. '")
        .s(spelled).s("' is not read. Write '").s(src.sub(rest, end - rest))
        .s("' for the decimal value")
    if is_octal
        msg.s(", or '0x\{octal:x\}' for the octal one C would read")
    msg.s(".")
    return true

priv fn append_integer_exponent_hint(msg: Str_builder$@, src: U8[], pos: Sz): Bool //<
    //< It writes the sentence naming an exponent written on an integer (`1e5`)
    //<
    //< C, Rust and Python read `1e5` as a floating-point number. KSPL takes an exponent only after
    //< a `.`. So the failure lands on the `e`, with an expected set that does not say why.
    if pos <= 0 || pos + 1 >= src.len || (src[pos] != 'e' && src[pos] != 'E')
        return false
    after: = src[pos + 1]
    if !(after.is_digit() ||
        ((after == '-' || after == '+') && pos + 2 < src.len && src[pos + 2].is_digit()))
        return false
    $start: = pos
    for start > 0 && (src[start - 1].is_digit() || src[start - 1] == '_')
        start -= 1
    if start == pos ||
        (start > 0 && (src[start - 1].is_alnum() || src[start - 1] == '.'))
        return false
    $end: = pos + 2
    for end < src.len && src[end].is_digit()
        end += 1
    digits: = src.sub(start, pos - start)
    msg.s("\n  Note: an exponent is written only on a floating-point literal, after a '.'. Write '")
        .s(digits).s(".0").s(src.sub(pos, end - pos))
        .s("' for an F64, or the integer's digits in full.")
    return true

priv fn starts_item(src: U8[], at: Sz): Bool //<
    //< Whether an item of a list can begin at `at`
    //<
    //< That is a name, a number, a literal, a bracket, an enum's `.value` or a parameter's `$`, and
    //< none of `carrying_words`.
    c: = src[at]
    if !(c.is_alnum() || c == '"' || c == '\'' || c == '(' || c == '.' || c == '$')
        return false
    w: = src.sub(at, word_end(src, at) - at)
    return !w.is_one_of(U8[][]::carrying_words)

priv const carrying_words: U8[][5] = ::{ "as", "in", "catch", "if", "else" } //<
    //< The words that stand between two values and continue the first, rather than starting an item

priv fn ends_item(c: U8): Bool //< whether an item of a list can end with the byte
    return c.is_alnum() || c == '"' || c == '\'' || c == ')' || c == ']' || c == '}'

priv fn is_closer(c: U8): Bool //< whether the byte closes a bracket
    return c == ')' || c == ']' || c == '}'

priv fn append_place(msg: Str_builder$@, src: U8[], at: Sz) //<
    //< It writes `line L, column C` for a position, counted as the diagnostic's heading counts
    //<
    //< `get_line_info` in `../base/core.kspl` does the count.
    info: = src.get_line_info(at, src.line_starts(base_core.arena))
    msg.s("line \{info.line\}, column \{info.disp_col\}")

priv fn text_step(src: U8[], i: Sz): Sz //<
    //< Where a walk over the text continues after `i`
    //<
    //< That is past a literal or a line comment starting there, or one byte further.
    c: = src[i]
    if c == '"' || c == '\''
        return literal_end(src, i)
    if src.starts_with("//", i)
        return line_end(src, i)
    return i + 1

priv fn append_expected(msg: Str_builder$@, e: Expected, laid_out: Bool, in_laid_block: Bool) //<
    //< It writes one expected item
    //<
    //< A name goes in quotes and a kind in a readable phrasing. **Do not quote a kind**:
    //< `'Primitive_type'` reads as text to type, not the name of what can come there.
    //< **The indentation notation writes no statement's `;` and no block's `}`.** They are named
    //< the end of the line, or in a block the indentation opened (`in_laid_block`), of the block.
    //< Caution: **Do not make a table of phrasings.** The grammar (`ksplc/kspl.kspeg`) owns the
    //< rule's name, and a copy silently drifts when it is renamed.
    if !e.is_rule
        if laid_out && e.text.equals(";")
            msg.s("the end of the line")
        else if in_laid_block && e.text.equals("}")
            msg.s("the end of the block")
        else
            msg.s("'\{e.text\}'")
        return
    head: = e.text[0].to_lower()
    msg
        .s("an " if head == 'a' || head == 'i' || head == 'u' || head == 'e' || head == 'o'
        else "a ")
    for i in Range.asc(e.text.len)
        c: = e.text[i]
        msg.c(' ' if c == '_' else c.to_lower())

fn parse_error_at(src: U8[], pos: Sz): Sz //<
    //< Where the syntax error found at `pos` is reported
    //<
    //< That is `pos`, or **the opening quote of a string that runs to the end of the text**. The
    //< parser fails only where the text runs out, far below the quote the writer left open.
    at: = unclosed_string_at(src, pos)
    if at < 0
        return pos
    interp: = interpolation_open_at(src, at, src.len)
    return interp if interp >= 0 else at

priv fn unclosed_string_at(src: U8[], pos: Sz): Sz //<
    //< Where a string still open at the end of the text opens, or -1
    //<
    //< It is -1 too where that string opens after `pos`, so the failure is not inside it.
    //< **Only a string reaching the end counts.** An ordinary string can hold a line end. So one
    //< that a later quote closes is text the parser read, and its mistake shows where it ends.
    $i: Sz = 0
    for i < src.len
        if src[i] == '"'
            e: = literal_end(src, i)
            if e >= src.len && !closes_at_end(src, i)
                return i if i <= pos else -1
        i = text_step(src, i)
    return -1

priv fn closes_at_end(src: U8[], at: Sz): Bool //<
    //< Whether the string opening at `at` closes on the text's last byte
    //<
    //< literal_end runs both a string closed there and one never closed to the end.
    quote: = "\"\"\"" if src.starts_with("\"\"\"", at) else "\""
    return src.len - at >= 2 * quote.len && src.ends_with(quote)

fn build_parse_error_msg(target_parser: kspeg.Target$@, src: U8[], pos: Sz, laid_out: Bool):
    Str_builder //<
        //< It builds the message for the syntax error at `pos`
        //<
        //< Caution: **Take `laid_out`.** In the indentation notation a heading line holds no `{`.
        //< So the guess that "the ternary's `if` is not matched" would fire wrongly (on an empty
        //< level, or one holding only comments). This is the one place where the wording differs by
        //< notation.
    $msg: = Str_builder.new()
    // **The expected list would name the end of the text**, where the parser ran out. The mistake
    // is the open quote the message is placed on (`parse_error_at`).
    open_at: = unclosed_string_at(src, pos)
    if open_at >= 0 && interpolation_open_at(src, open_at, src.len) >= 0
        msg
            .s("this interpolation is never closed. No '\\}' follows its '\\{'. The rest of the \
                file was read as its code. Close it with '\\}' where its value ends")
        return msg
    if open_at >= 0
        msg
            .s("this string is never closed. No '\"' closes it. The rest of the file was read as \
                its text. Close it where its text ends")
        return msg
    msg.s("expected ")
    in_laid_block: = laid_out && opened_by_layout(src, innermost_open(src, pos))
    if target_parser.fail.expected_label_count > 0
        for i in Range.asc(target_parser.fail.expected_label_count)
            if i > 0
                if i == target_parser.fail.expected_label_count - 1
                    // **With two labels the separator needs the leading space too**, as `", or "`
                    // has, or it reads `a floator ')'`.
                    msg.s(" or " if target_parser.fail.expected_label_count == 2 else ", or ")
                else
                    msg.s(", ")
            append_expected(msg@, (target_parser.fail.expected_labels + i)$, laid_out,
                in_laid_block)
    else
        msg.s("valid syntax")
    odd: = odd_indent_name(src, pos)
    if odd.len > 0
        msg.s("\n  Note: this line is indented with ").s(odd)
            .s(". Only the plain space (U+0020) counts as a column. The line is read as starting at \
                column 0, outside its enclosing block. Indent with spaces.")
        return msg
    if append_non_ascii_hint(msg@, src, pos)
        return msg
    if append_unclosed_bracket_hint(msg@, src, pos)
        return msg
    if append_missing_comma_hint(msg@, src, pos)
        return msg
    if append_leading_zero_hint(msg@, src, pos)
        return msg
    if append_integer_exponent_hint(msg@, src, pos)
        return msg
    // **Narrow it to "a `{` was expected".** "The next line is not deeper" alone holds for nearly
    // every line, and would fire on unrelated errors. The expected set says if a level is needed.
    if laid_out && append_split_value_hint(msg@, src, pos)
        return msg
    wants_block: = msg.slice().find_str("'{'").is_some()
    if laid_out && wants_block && block_head_without_body(src, pos)
        msg
            .s("\n  Note: a block with no body cannot be written by indentation alone. There is no \
                deeper line to open it. Keep the braces for an empty block ('if cond {}'). A body \
                containing only comments also needs braces. Comment lines do not open a block.")
        return msg
    if append_trailing_defer_hint(msg@, src, pos)
        return msg
    if append_typedef_spelling_hint(msg@, src, pos)
        return msg
    if append_statement_word_hint(msg@, src, pos)
        return msg
    msg.s(forbidden_spelling_hint(src, pos))
    return msg

//< The notes for another language's habits in a line that does not parse
//< Each note writes the line as KSPL writes it: Python's `elif`, `and` and closing `:`, C's `i++`,
//< JavaScript's `let`, Rust's `->`, another language's `typedef` and loop words. **The words stay
//< names**: a note only explains an error the line already has.
import "ksplc/base/core" as base_core
import "ksplc/base/lines" { line_start }
import "ksplc/base/literal" { literal_end }
import "ksplc/parse/syntax_line" { code_line, is_word_byte, previous_code_line, starts_with_word,
    word_end, word_end_with_underscore, word_start }
import "std/chars"
import "std/ds" as _ds // `equals`
import "std/math"
import "std/str" { Str }
import "std/strfmt" as _strfmt // the `:c` of a hint

priv const OTHER_TYPEDEF_WORDS: U8[][4] = ::{ "alias", "type", "typealias", "using" } //<
    //< The words other languages use to give a type another name, where KSPL writes `typedef`
    //< They are D's; Rust's, Go's and Python's; Swift's and Kotlin's; C++'s.

fn append_typedef_spelling_hint(msg: Str$@, src: U8[], pos: Sz): Bool //<
    //< It writes the `typedef` line to use instead of another language's or C's type alias
    //< It does so where the failing line gives a type another name with another language's keyword
    //< or in C's order.
    //<
    //< `alias Id = I32` fails on the `Id`: the word reads as a variable's name needing a `:`. C's
    //< `typedef I32 Id` fails on the `I32`, and `typedef U8[] Bytes` on the `[`.
    if pos < 0 || pos > src.len
        return false
    code: = code_line(src, line_start(src, pos)).code
    $s: Sz = 0
    first: = code.sub(0, word_end(code, 0))
    if first.equals("pub") || first.equals("priv")
        s = word_start(code, first.len)
    e: = word_end(code, s)
    word: = code.sub(s, e - s)
    after: = code.sub_from(e).trim_spaces()
    if word.equals("typedef")
        $k: = after.len
        for k > 0 && after[k - 1].is_alnum()
            k -= 1
        if after.find_char('=').is_some() || k == 0 || k == after.len ||
            !after[k].is_alpha()
            return false
        msg.s("\n  Note: 'typedef' puts the new name first. Put the type after '=': '")
            .s(code.sub(0, s)).s("typedef ").s(after.sub_from(k)).s(" = ")
            .s(after.sub(0, k).trim_spaces()).s("'.")
        return true
    rest: = after.sub_from(word_end(after, 0)).trim_spaces()
    if word_end(after, 0) == 0 || !rest.starts_with("=") || rest.starts_with("==")
        return false
    for w in OTHER_TYPEDEF_WORDS
        if word.equals(w)
            msg.s("\n  Note: use 'typedef' to declare another name for a type: '")
                .s(code.sub(0, s)).s("typedef ").s(after).s("'.")
            return true
    return false

fn append_statement_word_hint(msg: Str$@, src: U8[], pos: Sz): Bool //<
    //< It writes KSPL's head where a statement opens with another language's word
    //< The words are `while`, `loop`, `match`, `let`, `var`, `def`, `function` and `func`. Each
    //< reads as a name followed by what no name takes, so the expectation list alone leads nowhere.
    //< **The words stay names**: the note only explains an error the line already has.
    if pos < 0 || pos > src.len
        return false
    code: = code_line(src, line_start(src, pos)).code
    e: = word_end(code, 0)
    word: = code.sub(0, e)
    rest: = code.sub_from(e).trim_spaces()
    // A name in use (`match(x)`, `loop: = 1`, `match.len`) is followed by no space or by a mark.
    if e == 0 || (e < code.len && code[e] != ' ') || rest.starts_with("=") ||
        rest.starts_with(":") || rest.starts_with(".")
        return false
    head: = rest.sub(0, rest.find_char('{').unwrap_or(rest.len)).trim_spaces()
    if word.equals("while") && head.len > 0
        msg
            .s("\n  Note: every loop is written with 'for'. A condition alone repeats the loop \
                while the condition holds: '").s(rewrite_habits(code).line).s("'.")
        return true
    if word.equals("loop") && head.len == 0
        msg
            .s("\n  Note: every loop is written with 'for'. A bare 'for' repeats until a 'break' \
                leaves it.")
        return true
    if word.equals("let") || word.equals("var")
        return append_declaration_word_hint(msg, word, rest)
    if word.equals("def") || word.equals("function") || word.equals("func")
        msg.s("\n  Note: KSPL declares a function with 'fn': 'fn ").s(fn_head_as_kspl(rest)).s("'.")
        return true
    if !word.equals("match") || head.len == 0
        return false
    msg
        .s("\n  Note: KSPL branches on a value with 'switch'. Start each case with 'case'. Do not \
            enclose all cases in braces: 'switch ").s(head)
        .s("" if head.find_str(" case ").is_some() else " case ...").s("'.")
    return true

priv fn append_declaration_word_hint(msg: Str$@, word: U8[], rest: U8[]): Bool //<
    //< It writes the declaration KSPL writes for `let x = 5` or `var x = 5`, or nothing
    //< Rust's `let mut x` is a name that changes, so it gets the `$` at once.
    $tail: = rest
    changes: = starts_with_word(tail, "mut")
    if changes
        tail = tail.sub_from(3).trim_spaces()
    e: = word_end_with_underscore(tail, 0)
    after: = tail.sub_from(e).trim_spaces()
    if e == 0 || !(after.starts_with("=") || after.starts_with(":")) || after.starts_with("==")
        return false
    decl: = base_core.arena.text().s("$" if changes else "").s(tail.sub(0, e))
    if after.starts_with("=")
        decl.s(": ")
    decl.s(after)
    shown: = decl.take()
    msg.s("\n  Note: KSPL declares a name with ':' and no '").s(word).s("': '").s(shown).s("'.")
    if !changes
        msg.s(" Write '$").s(shown).s("' for a value that changes later.")
    return true

priv fn fn_head_as_kspl(head: U8[]): U8[] //<
    //< A function's head from another language as KSPL writes it (`main() -> I32:` is `main(): I32`)
    $h: = head.trim_spaces()
    if h.ends_with(":") && !h.ends_with("::")
        h = h.sub(0, h.len - 1).trim_spaces()
    if arrow: = h.find_str("->")
        return base_core.arena.text().s(h.sub(0, arrow).trim_spaces()).s(": ")
            .s(h.sub_from(arrow + 2).trim_spaces()).take()
    return h

fn append_fn_head_hint(msg: Str$@, src: U8[], pos: Sz): Bool //<
    //< It writes KSPL's function head where one is written with `->` or ends with `:`
    //< `fn f() -> I32` fails on the `->`. Python's `fn main():` fails on the line after it: the
    //< `:` starts a return type, and the next line is no type.
    if pos < 0 || pos > src.len
        return false
    s: = line_start(src, pos)
    here: = code_line(src, s)
    $head: = here.code
    if pos <= s + here.indent && s > 0
        head = previous_code_line(src, s)
    else if !src.starts_with("->", pos)
        return false
    $w: = head
    if starts_with_word(w, "pub") || starts_with_word(w, "priv")
        w = w.sub_from(word_end(w, 0)).trim_spaces()
    if !starts_with_word(w, "fn") ||
        !(w.find_str("->").is_some() || w.ends_with("):"))
        return false
    msg.s("\n  Note: a function's return type follows ':', and its head ends with its line: '")
        .s(head.sub(0, head.len - w.len)).s("fn ").s(fn_head_as_kspl(w.sub_from(2))).s("'.")
    return true

fn append_step_hint(msg: Str$@, src: U8[], pos: Sz): Bool //<
    //< It writes `i += 1` where a statement is `i++`, `i--`, `++i` or `--i`, which KSPL has not
    if pos < 0 || pos > src.len
        return false
    code: = code_line(src, line_start(src, pos)).code
    if code.len < 3
        return false
    $place: U8[] = ""
    $op: U8[] = ""
    if code.ends_with("++") || code.ends_with("--")
        place = code.sub(0, code.len - 2).trim_spaces()
        op = code.sub_from(code.len - 2)
    else if code.starts_with("++") || code.starts_with("--")
        place = code.sub_from(2).trim_spaces()
        op = code.sub(0, 2)
    if place.len == 0 || !is_word_byte(place[0])
        return false
    for c in place
        if !(is_word_byte(c) || c == '.' || c == '[' || c == ']')
            return false
    msg.s("\n  Note: KSPL has no '").s(op).s("'. Write '").s(place).s(" \{op[0]:c\}= 1'.")
    return true

priv struct Habits //< a line rewritten from another language's habits into KSPL's
    line: U8[] //< the line as KSPL writes it
    first_at: Sz //< where the first change stands in the line as written; -1 where none
    block_colon: Bool //< a block's head ended with Python's `:`
    elif_word: Bool //< `elif` stood for `else if`
    logic_words: Bool //< `and`, `or` or `not` stood for `&&`, `||` or `!`

priv fn rewrite_habits(code: U8[]): Habits //<
    //< The line with Python's and JavaScript's spellings of a branch replaced by KSPL's
    //< It replaces `elif`, `and`, `or`, `not`, a head's closing `:` and the parentheses around a
    //< whole condition. A `while` head becomes `for`. Strings are kept as written.
    $h: = Habits::{ .line = code, .first_at = -1, .block_colon = false, .elif_word = false,
        .logic_words = false }
    first: = code.sub(0, word_end_with_underscore(code, 0))
    is_head: =
        first.equals("if") || first.equals("else") || first.equals("elif") ||
        first.equals("for") || first.equals("while")
    b: = base_core.arena.text()
    $i: Sz = 0
    if first.equals("elif") || first.equals("while")
        h.elif_word = first.equals("elif")
        b.s("else if" if h.elif_word else "for")
        if h.elif_word
            h.first_at = 0
        i = first.len
    $end: = code.len
    if is_head && end > 0 && code[end - 1] == ':' && !code.ends_with("::")
        end -= 1
        h.block_colon = true
    for i < end
        c: = code[i]
        if c == '"' || c == '\''
            e: = math.min(literal_end(code, i), end)
            b.s(code.sub(i, e - i))
            i = e
            continue
        if !is_word_byte(c) || (i > 0 && is_word_byte(code[i - 1]))
            b.c(c)
            i += 1
            continue
        e: = word_end_with_underscore(code, i)
        w: = code.sub(i, e - i)
        $to: U8[] = ""
        if w.equals("and")
            to = "&&"
        else if w.equals("or")
            to = "||"
        else if w.equals("not")
            to = "!"
        if to.len == 0
            b.s(w)
            i = e
            continue
        h.logic_words = true
        if h.first_at < 0
            h.first_at = i
        b.s(to)
        i = e
        // `not x` is `!x`: the space after it goes too.
        for to.equals("!") && i < end && code[i] == ' '
            i += 1
    if h.block_colon && h.first_at < 0
        h.first_at = end
    $line: = b.take().trim_spaces()
    // A condition in parentheses whole (`if (x > 2)`) needs none.
    if h.first_at >= 0 && is_head
        head_end: = word_end_with_underscore(line, 0)
        rest: = line.sub_from(head_end).trim_spaces()
        if rest.starts_with("(") && closes_at(rest, 0) == rest.len - 1
            line = base_core.arena.text().s(line.sub(0, head_end)).c(' ')
                .s(rest.sub(1, rest.len - 2).trim_spaces()).take()
    h.line = line
    return h

priv fn closes_at(text: U8[], open: Sz): Sz //< where the `(` at `open` closes, or -1
    $depth: Sz = 0
    for i in Range(open, text.len, 1)
        if text[i] == '('
            depth += 1
        else if text[i] == ')'
            depth -= 1
            if depth == 0
                return i
    return -1

fn append_habits_hint(msg: Str$@, src: U8[], pos: Sz): Bool //<
    //< It writes the failing line as KSPL writes it, where Python's or JavaScript's habits broke it
    //< **Only where the failure stands at or after the first such spelling**: a line that fails
    //< before it fails for another reason.
    if pos < 0 || pos > src.len
        return false
    s: = line_start(src, pos)
    here: = code_line(src, s)
    h: = rewrite_habits(here.code)
    if h.first_at < 0 || pos < s + here.indent + h.first_at
        return false
    msg.s("\n  Note: ")
    if h.block_colon
        msg.s("a block's head ends with its line, with no ':'. ")
    if h.elif_word
        msg.s("KSPL writes 'else if' for 'elif'. ")
    if h.logic_words
        msg.s("KSPL writes '&&' for 'and', '||' for 'or' and '!' for 'not'. ")
    msg.s("Write '").s(h.line).s("'.")
    return true

//< Folds a type's sugar postfixes into `std/lang`'s generics
//< `T[]` / `T$[]` become `Slice<|T|>` / `Slice<|$T|>`, `T?` becomes `Option<|T|>`, and `T!E`
//< becomes `Result<|T, E|>`.
//< It applies only to type expressions written in the source. **Each type has one origin.** The
//< instance built here and the code that looks it up directly end in the same instantiation
//< ("`T[]` is sugar for `Slice<|$T|>`" in `../../docs/DESIGN-programming-language.md`).
import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_ext" // `mark_sugar_made`, `is_sugar_made`
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "std/chars"
import "std/ds" { List }
import "std/str" { Str_builder }

priv fn wrap_type_expr(base: Ast_node$@, posts: List<|Ast_node$@|>$@, loc: base_ast.Loc):
    Ast_node$@ //<
        //< It wraps the base and the postfixes still attached to it into one `type_expr`
        //< Where there is no postfix, it returns the base unchanged.
    if posts.len == 0
        return base
    node: = Ast_node(.k_type_expr, "", loc)
    node.add_child(base)
    for p in posts
        node.add_child(p)
    node.text = base_core.arena.dup_str(spell_type_expr(node))
    return node

priv fn is_slice_postfix(p: Ast_node@): Bool //< whether it is a postfix to fold
    //< **A postfix holding a size is not folded**: a `[N]` is recognized by its child, and a `[_]`,
    //< which has none, by its text. A `[_]` comes from expanding `T[]::{ v1, … }`
    //< (desugar_slice_elems in `desugar.kspl`); if folded, its elements would read as the
    //< descriptor's fields.
    t: = p.text.strip_prefix("$")
    return t.starts_with("[") && !t.starts_with("[_") && p.children.len == 0

priv fn is_option_postfix(p: Ast_node@): Bool //< whether it is an optional's `?`
    return p.text.equals("?")

priv fn is_result_postfix(p: Ast_node@): Bool //< whether it is a result's `!E` (its child is `E`)
    return p.text.starts_with("!") && p.children.len > 0

priv fn make_generic_atom(ident: U8[], inner_raw: Ast_node$@, is_mut: Bool, loc: base_ast.Loc):
    Ast_node$@ //<
        //< It builds the `type_atom` for `<ident><|arg|>`
        //< With `is_mut`, it is `<ident><|$arg|>`.
    one: = base_ast.new_ast_node_list()
    one.push(inner_raw)
    return make_generic_atom_of(ident, one, is_mut, loc)

priv fn make_generic_atom_of(ident: U8[], args_raw: List<|Ast_node$@|>$@, first_mut: Bool,
    loc: base_ast.Loc): Ast_node$@ //<
        //< It builds the `type_atom` for `<ident><|arg, …|>`
        //< The first argument is `$`-marked if asked.
        //< Caution: **Set the `type_args` text here**: normalization (`normalize_type_args_text`)
        //< runs before desugar, and `get_full_path_str_to` (`../base/ast_spell.kspl`) reads it.
    args: = Ast_node(.k_type_args, "", loc)
    defer $t: = Str_builder()
    t.s("<|")
    for i in Range.asc(args_raw.len)
        // **Wrap a type argument in a `type_expr`.** strip_arg_mut_mark
        // (`../sema/decl/resolve.kspl`) looks for a `type_expr`'s child. With a bare
        // `type_atom`, the mark alone is resolved as a type named `$`.
        $inner: Ast_node$@ = args_raw.get(i)
        if inner.kind_id != .k_type_expr
            wrapped: = Ast_node(.k_type_expr, "", loc)
            wrapped.add_child(inner)
            wrapped.text = base_core.arena.dup_str(spell_type_expr(wrapped))
            inner = wrapped
        is_mut: = first_mut && i == 0
        $arg: Ast_node$@ = inner
        if is_mut
            arg = Ast_node(.k_type_arg, "type_arg", loc)
            arg.add_child(Ast_node(.k_literal, "$", loc))
            arg.add_child(inner)
        args.add_child(arg)
        if i > 0
            t.s(", ")
        if is_mut
            t.s("$")
        t.s(inner.text)
    t.s("|>")
    args.text = base_core.arena.dup_str(t.slice())
    path: = Ast_node(.k_type_path, "", loc)
    // Caution: Do not write the name inline (its canonical sources are `base_core.slice_ident`,
    // `base_core.option_ident` and `base_core.result_ident`).
    path.add_child(Ast_node(.k_identifier, ident, loc))
    path.add_child(args)
    path.mark_sugar_made()
    atom: = Ast_node(.k_type_atom, "", loc)
    atom.add_child(path)
    return atom

priv fn spell_type_expr(node: Ast_node@): U8[] //< a type expression's name
    //< **Just join the text of the base and the postfixes**: `extract_type_name` drops the
    //< mutability mark, turning `Slice<|$U8|>` into `Slice<|U8|>`.
    b: = base_core.arena.text()
    for c in node.children
        if c.kind_id == .k_type_atom || c.kind_id == .k_type_expr
            b.s(c.text if c.text.len > 0 else spell_atom(c))
        else
            b.s(c.text)
    return b.take()

fn spell_as_written(node: Ast_node$@): U8[] //< a type expression with its folds spelled as sugar
    //< **Source the compiler writes from a folded type uses this.** The long form
    //< (`Slice<|U8|>`, `Option<|I32|>`) is refused as a type wherever it is parsed
    //< (check_spelled_out_sugar in `../sema/decl/type_check.kspl`). So a fold is written back as
    //< `U8[]`, `U8$[]` or `I32?`, a result or a function type grouped first (`(I32!E)?`).
    if node == null
        return ""
    if node.kind_id == .k_type_atom && node.children.len > 0 &&
        node.get_child(0).is_sugar_made()
        path: = node.get_child(0)
        arg: = path.get_child(1).get_child(0)
        is_mut: = arg.kind_id == .k_type_arg
        inner: = arg.get_child(1) if is_mut else arg
        b: = base_core.arena.text()
        if needs_group(inner)
            b.c('(').s(spell_as_written(inner)).c(')')
        else
            b.s(spell_as_written(inner))
        ident: = path.get_child(0).text
        if ident.equals(base_core.result_ident())
            return b.c('!').s(spell_as_written(path.get_child(1).get_child(1))).take()
        if ident.equals(base_core.option_ident())
            b.c('?')
        else
            b.s("$[]" if is_mut else "[]")
        return b.take()
    if node.kind_id == .k_type_expr
        b: = base_core.arena.text()
        for c in node.children
            if c.kind_id == .k_type_atom || c.kind_id == .k_type_expr
                b.s(spell_as_written(c))
            else
                b.s(c.text)
        return b.take()
    // **A function type and a grouped type are spelled part by part.** Their atom's text is only
    // `fn` or the kind's name, and a closure lifted with it would not parse.
    if node.kind_id == .k_type_atom
        sig: = node.find_child(.k_type_fn_sig)
        if sig != null
            return base_core.arena.text().s("fn").s(spell_fn_sig(sig)).take()
        inner: = node.find_child(.k_type_expr)
        if inner != null
            return base_core.arena.text().c('(').s(spell_as_written(inner)).c(')').take()
    return node.text if node.text.len > 0 else spell_atom(node)

fn spell_before_postfix(node: Ast_node$@): U8[] //<
    //< A type spelled as written, in brackets where a postfix written after it would bind inside
    //< **A result and a function type take a postfix as their own part.** `I32!E@` reads as
    //< `I32!(E@)`, and `fn(a: I32): Bool@` as a function that returns a pointer. So these are
    //< grouped: `(I32!E)@`. The test reads the spelling: a `!` outside every bracket, or a leading
    //< `fn`.
    spelled: = spell_as_written(node)
    $depth: I32 = 0
    $bare: = spelled.starts_with("fn")
    for ch in spelled
        if ch == '(' || ch == '[' || ch == '<'
            depth += 1
        else if ch == ')' || ch == ']' || ch == '>'
            depth -= 1
        else if ch == '!' && depth == 0
            bare = true
    if !bare
        return spelled
    return base_core.arena.text().c('(').s(spelled).c(')').take()

fn is_fixed_array_type(node: Ast_node$@): Bool //<
    //< Whether a written type is a fixed-length array (`I32[3]`), by its last postfix
    //< A slice's `[]` is folded or has no size, so only a sized one is left.
    if node == null || node.kind_id != .k_type_expr || node.children.len < 2
        return false
    last: = node.get_child(node.children.len - 1)
    if last.kind_id == .k_type_atom || last.kind_id == .k_type_expr
        return false
    return last.text.strip_prefix("$").starts_with("[") && !is_slice_postfix(last)

fn spell_array_element(node: Ast_node$@): U8[] //<
    //< A fixed-length array type's element, spelled as written (`I32` for `I32[3]`)
    //< node is one is_fixed_array_type accepts.
    b: = base_core.arena.text()
    for i in Range.asc(node.children.len - 1)
        c: = node.get_child(i)
        if c.kind_id == .k_type_atom || c.kind_id == .k_type_expr
            b.s(spell_as_written(c))
        else
            b.s(c.text)
    return b.take()

priv fn spell_fn_sig(sig: Ast_node$@): U8[] //<
    //< A function type's `(a: I32, b: I32): Bool`, its parameters and return spelled as written
    //< Caution: **Write the `:` and the `,` here.** The tree no longer holds them as children.
    b: = base_core.arena.text()
    b.c('(')
    $first: = true
    list: = sig.find_child(.k_param_list)
    if list != null
        for p in list.children
            if p.kind_id == .k_fn_param
                b.s("" if first else ", ")
                mark: = p.find_child(.k_literal)
                if mark != null && mark.text.equals("$")
                    b.c('$')
                b.s(p.find_text(.k_identifier)).s(": ")
                    .s(spell_as_written(p.get_decl_type_node()))
                first = false
            else if p.is_literal("...")
                b.s("" if first else ", ").s("...")
                first = false
    b.c(')')
    ret: = sig.find_child(.k_type_expr)
    if ret != null
        b.s(": ").s(spell_as_written(ret))
    return b.take()

priv fn needs_group(inner: Ast_node$@): Bool //< whether a sugar's argument is put in brackets
    //< A result (`I32!E`) or a function type takes the postfix itself unless grouped.
    if inner.kind_id != .k_type_expr
        return inner.kind_id == .k_type_fn_sig || is_result_atom(inner)
    for c in inner.children
        if c.kind_id == .k_type_fn_sig || is_result_atom(c)
            return true
    return false

priv fn is_result_atom(node: Ast_node$@): Bool //< whether it is a `T!E` folded into `Result`
    return node.kind_id == .k_type_atom && node.children.len > 0 &&
        node.get_child(0).is_sugar_made() &&
        node.get_child(0).get_child(0).text.equals(base_core.result_ident())

priv fn spell_atom(node: Ast_node@): U8[] //< a `type_atom`'s name
    //< It reads the child path, for an atom whose text is empty.
    defer $b: = Str_builder()
    for c in node.children
        c.get_full_path_str_to(b)
    return base_core.arena.dup_str(b.slice())

impl Ast_node
    fn fold_sugar_under(r: Ast_node$@) //<
        //< It folds every type under r, outermost first, as the desugar walk does
        //< For a declaration made after that walk (a lifted closure, whose source spells its types
        //< with the sugar), which nothing else would fold.
        if r == null
            return
        if r.kind_id == .k_type_expr
            r.fold_sugar_postfixes()
        for c in r.children
            c.fold_sugar_under()

    fn fold_sugar_postfixes(r: Ast_node$@) //<
        //< It folds the postfixes `[]` / `$[]`, `?` and `!E` into `Slice`, `Option` and `Result`
        //< Caution: **Fold from the left in order.** Postfixes apply from the left (`U8$[][]` is an
        //< immutable-element slice of a mutable-element slice, `U8[]?` an optional slice, `I32?!E`
        //< a result of an optional); reversed, the meaning changes. An `@` stays a postfix.
        $has_sugar: = false
        for c in r.children
            if c.kind_id == .k_type_postfix &&
                (is_slice_postfix(c) || is_option_postfix(c) || is_result_postfix(c))
                has_sugar = true
        if !has_sugar
            return
        $base: Ast_node$@ = null
        kept: = base_ast.new_ast_node_list()
        for c in r.children
            if c.kind_id != .k_type_postfix
                base = c
                continue
            is_option: = is_option_postfix(c)
            is_result: = is_result_postfix(c)
            if !is_slice_postfix(c) && !is_option && !is_result
                kept.push(c)
                continue
            // The levels so far (the base and its postfixes) become the type argument.
            inner: = wrap_type_expr(base, kept, r.loc)
            if is_result
                // `T!E`: the error type is the postfix's child, folded itself when the walk
                // descends into it (`desugar_node`).
                pair: = base_ast.new_ast_node_list()
                pair.push(inner)
                pair.push(c.get_child(0))
                base =
                    make_generic_atom_of(base_core.result_ident(), pair, false, r.loc)
            else if is_option
                base = make_generic_atom(base_core.option_ident(), inner, false, r.loc)
            else
                base =
                    make_generic_atom(base_core.slice_ident(), inner, c.text.starts_with("$"),
                    r.loc)
            kept.clear()
        r.clear_children()
        r.add_child(base)
        for k in kept
            r.add_child(k)
        r.text = base_core.arena.dup_str(spell_type_expr(r))

//< LSP: renaming, and the checks that refuse a rename before it writes anything
//< The places come from the references' walk (`collect_spots` in `uses.kspl`). A rename is
//< refused with a message naming why, in these cases. ① The grammar does not read the new
//< name as an identifier (`Identifier` in `../kspl.kspeg`). ② A place lies in a file the
//< workspace walk does not list (`holds` in `workspace.kspl`). ③ The new name is already
//< declared where it would land. `prepareRename` asks ② of the declaration alone, so the
//< editor refuses before a name is typed.
import "kspeg/engine" as kspeg
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/core" as base_core
import "ksplc/base/locate" as base_locate
import "ksplc/lsp/msg" as lsp_msg
import "ksplc/lsp/state" { Doc_state }
import "ksplc/lsp/uses" as lsp_uses + { Spot, Target }
import "ksplc/lsp/workspace" as lsp_workspace
import "ksplc/parse/load" as parse_load
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/session/import_table" as _sema_session_import_table
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/chars"
import "std/ds" { List }
import "std/json" + { Json_builder }
import "std/mem" { Arena }
import "std/str" { Str_builder }

priv const NO_NAME: U8[] = "there is no name here to rename"

fn handle_prepare(state: Doc_state$@, params: json.Value, id_val: json.Value, arena: Arena$@) //<
    //< `textDocument/prepareRename`: the name's range and text, or why it cannot be renamed
    //< **Only where it is declared is asked**, from the document's own analysis: the uses need the
    //< workspace's, which the rename itself builds.
    switch lsp_uses.target_at(state, params)
    case .some(t)
        if state.sema == null
            lsp_msg.send_error_response(id_val, lsp_msg.REQUEST_FAILED, NO_NAME, arena)
            return
        name: = t.name.text.get_generic_base_name()
        def_file: = t.def.loc.file()
        if def_file.len > 0 && !in_workspace(def_file, arena)
            lsp_msg.send_error_response(id_val, lsp_msg.REQUEST_FAILED,
                read_only(name, def_file, true, arena), arena)
            return
        pos: = lsp_uses.position_of(state.sema, t.name)
        $b: = Json_builder.new(arena)
        range: = b.range(pos.line, pos.character, pos.line, pos.character + name.len)
        lsp_msg.send_response(id_val,
            b.obj().set("range", range).set("placeholder", b.str_val(name)).build(), arena)
    default
        lsp_msg.send_error_response(id_val, lsp_msg.REQUEST_FAILED, NO_NAME, arena)

fn handle_rename(ws_state: Doc_state$@, parser: kspeg.Target$@, params: json.Value,
    id_val: json.Value, arena: Arena$@) //<
        //< `textDocument/rename`: the uses as per-file edits, or why the rename is refused
        //< **Rewrite the declaration too**, or the workspace no longer compiles.
    new_name: = params.get("newName").as_str().unwrap_or("")
    if new_name.len == 0
        lsp_msg.send_error_response(id_val, lsp_msg.INVALID_PARAMS,
            "a rename names the new name in 'newName'", arena)
        return
    $t: = Target::{ .def = null, .name = null, .stands_for = null }
    switch lsp_uses.target_at(ws_state, params)
    case .some(got)
        t = got
    default
        lsp_msg.send_error_response(id_val, lsp_msg.REQUEST_FAILED, NO_NAME, arena)
        return
    old_name: = t.name.text.get_generic_base_name()
    $why: = name_refusal(new_name, parser, arena)
    uri: = params.get("textDocument").get("uri").as_str().unwrap_or("")
    spots: = lsp_uses.collect_spots(ws_state, t, base_locate.uri_style_of(uri), arena)
    if why.len == 0
        why = place_refusal(spots@, old_name, arena)
    if why.len == 0 && !new_name.equals(old_name) && ws_state.sema != null
        why = Clash::{ .c = ws_state.sema, .old_name = old_name, .new_name = new_name,
            .arena = arena }.refusal(spots@)
    if why.len > 0
        lsp_msg.send_error_response(id_val, lsp_msg.REQUEST_FAILED, why, arena)
        return
    send_edits(spots@, new_name, id_val, arena)

priv fn send_edits(spots: List<|Spot|>@, new_name: U8[], id_val: json.Value, arena: Arena$@) //<
    //< The rename's answer: the places as per-file edits, in the walk's order
    $b: = Json_builder.new(arena)
    $changes: = b.obj()
    $at: Sz = 0
    for at < spots.len
        uri: = spots.get(at).uri
        $edits: = b.arr()
        for at < spots.len && spots.get(at).uri.equals(uri)
            s: = spots.get(at)
            range: = b.range(s.line, s.character, s.line, s.character + s.len)
            edits = edits
                .push(b.obj().set("range", range).set("newText", b.str_val(new_name)).build())
            at += 1
        changes = changes.set(uri, edits.build())
    lsp_msg.send_response(id_val, b.obj().set("changes", changes.build()).build(), arena)

// ==========================================
// ① The new name is a name
// ==========================================

priv fn name_refusal(name: U8[], parser: kspeg.Target$@, arena: Arena$@): U8[] //<
    //< Why the grammar would not read `name` as an identifier; empty where it would
    //< **Asked of the grammar's own rules**, so a reserved word added there is refused here too.
    if parse_load.reads_whole(name, "Identifier", parser)
        return ""
    if parse_load.reads_whole(name, "_Keyword", parser)
        return arena.text().s("'\{name\}' is a keyword, so it cannot name anything").take()
    return arena.text()
        .s("'\{name\}' is not a name: a name is a letter or '_', then letters, digits and '_'")
        .take()

// ==========================================
// ② Every place is in the workspace
// ==========================================

priv fn disk_path(logical: U8[], arena: Arena$@): U8[] //<
    //< where the file of a logical name is read
    $out: = Str_builder.new()
    base_locate.append_file_path(logical, out@)
    return arena.dup_str(out.slice())

priv fn in_workspace(logical: U8[], arena: Arena$@): Bool //< whether a rename may write that file
    return lsp_workspace.holds(disk_path(logical, arena), arena)

priv fn read_only(name: U8[], logical: U8[], is_decl: Bool, arena: Arena$@): U8[] //<
    //< Why a name in a file outside the workspace is not renamed
    how: = "declared" if is_decl else "used"
    return arena.text().s("'\{name\}' is \{how\} in \{disk_path(logical, arena)\}, outside this ")
        .s("workspace, which the editor only reads (the standard library, or a package from ")
        .s("elsewhere)").take()

priv fn place_refusal(spots: List<|Spot|>@, name: U8[], arena: Arena$@): U8[] //<
    //< Why a place may not be written; empty where every one may
    //< **Every place is asked, not the declaration alone**: a use can lie in a package read from
    //< elsewhere too. The places come ordered by file, so each file is asked once.
    $last: U8[] = ""
    for i in Range.asc(spots.len)
        s: = spots.get(i)
        if s.file.equals(last)
            continue
        last = s.file
        if !in_workspace(s.file, arena)
            return read_only(name, s.file, s.is_decl, arena)
    return ""

// ==========================================
// ③ The new name is free where it lands
// ==========================================

priv const MAX_SCAN_DEPTH: Sz = 200 //< how deep a scope is searched for its declarations

priv fn is_scope(n: Ast_node$@): Bool //< whether a node opens a scope its declarations belong to
    switch n.kind_id
    case .k_file, .k_decl_fn, .k_decl_fn_proto, .k_stmt_block, .k_stmt_switch, .k_expr_fn_lit
        return true
    default
        return is_member_scope(n)

priv fn is_member_scope(n: Ast_node$@): Bool //<
    //< whether a scope holds members, reached after a `.`
    switch n.kind_id
    case .k_decl_struct, .k_decl_extern_struct, .k_decl_enum, .k_enum_variant, .k_decl_impl,
        .k_decl_trait
        return true
    default
        return false

priv fn decl_name(n: Ast_node$@): U8[] //< the name a node declares; empty where it declares none
    //< **What the compiler bound is read from its own record** (`sym_ptr`), so a binding written in
    //< any form is found. A field is no symbol, so it is read from the tree.
    if n.sym_ptr != null
        sym: = Sema_symbol$@::n.sym_ptr
        if sym.node == n
            return sym.name.get_generic_base_name().fqn_last()
    if n.kind_id == .k_struct_field || n.kind_id == .k_enum_field
        id: = n.find_child(.k_identifier)
        if id != null
            return id.text
    return ""

priv fn declared_in(scope: Ast_node$@, file: U8[], name: U8[], depth: Sz): Ast_node$@? //<
    //< The declaration of `name` that belongs to `scope` in `file`
    //< **A nested scope's declarations are not its own**, so the search stops at one: a name in an
    //< inner block is not visible outside it. **The files of a program hang under one top**, so a
    //< declaration of another file is passed over.
    for child in scope.children
        if child.loc.file().len > 0 && !child.loc.file().equals(file)
            continue
        if decl_name(child).equals(name)
            return .some(child)
        if !is_scope(child) && depth < MAX_SCAN_DEPTH
            if found: = declared_in(child, file, name, depth + 1)
                return .some(found)
    return .none

priv fn names_member(s: Spot): Bool //< whether a place is written after a `.`, or as a type's own
    if s.is_decl || s.path.len == 0
        return false
    parent: = s.path.get(s.path.len - 1)
    switch parent.kind_id
    case .k_expr_path, .k_type_path, .k_generic_path
        return parent.children.len > 0 && parent.children.get(0) != s.node
    case .k_expr_postfix, .k_method_access, .k_enum_init, .k_enum_init_call, .k_expr_field_init,
        .k_case_pattern, .k_generic_method, .k_expr_implicit_dot, .k_expr_offsetof
        return true
    default
        return false

priv struct Clash //< one rename's question: is the new name already taken where it lands
    c: Sema_ctx$@
    old_name: U8[]
    new_name: U8[]
    arena: Arena$@

impl Clash
    fn refusal(r: Self, spots: List<|Spot|>@): U8[] //<
        //< Why the new name would collide; empty where it would not
        //< A member (a field, a variant, a method) is compared with its type's other members. Any
        //< other name is compared with each scope around every place it is written bare. A name
        //< declared there would be hidden by it, hide it, or be declared twice.
        //< Caution: **A scope reached after a `.` is not searched for a bare name.** Otherwise a
        //< local is refused for sharing a name with some type's method.
        for i in Range.asc(spots.len)
            s: = spots.get(i)
            if s.is_decl
                if scope: = own_scope(s)
                    if is_member_scope(scope)
                        return r.member_refusal(s, scope)
        // **Every file's top hangs under one node**, searched per file. The places come ordered by
        // file, so a file's top is searched once, not once per place.
        $top_done: U8[] = ""
        for j in Range.asc(spots.len)
            s: = spots.get(j)
            if names_member(s)
                continue
            for i in Range.desc(s.path.len)
                n: = s.path.get(i)
                if !is_scope(n) || is_member_scope(n) || names_itself(n, s)
                    continue
                is_top: = n.kind_id == .k_file
                if is_top && s.file.equals(top_done)
                    continue
                if got: = declared_in(n, s.file, r.new_name, 0)
                    return r.taken(got, s)
                if is_top
                    why: = r.import_refusal(s)
                    if why.len > 0
                        return why
                    top_done = s.file
        return ""

    priv fn member_refusal(r: Self, s: Spot, scope: Ast_node$@): U8[] //<
        //< Why a member's new name is taken among its type's members; empty where it is not
        //< **A type's methods can be spread over several `impl`s.** So a method is looked up by
        //< its full name as well as in its own block.
        if got: = declared_in(scope, s.file, r.new_name, 0)
            return r.taken(got, s)
        decl: = s.path.get(s.path.len - 1) if s.path.len > 0 else s.node
        if decl.sym_ptr == null
            return ""
        sym: = Sema_symbol$@::decl.sym_ptr
        if !sym.flags.is_method
            return ""
        if dot: = sym.name.rfind_char('.')
            sibling: = r.arena.text().s(sym.name.sub(0, dot + 1)).s(r.new_name).take()
            if other: = r.c.symtab.resolve_fqn(sibling)
                return r.taken(other.node, s)
        return ""

    priv fn import_refusal(r: Self, s: Spot): U8[] //<
        //< Why the new name is taken by an import line of the place's file; empty where it is not
        alias: = r.c.peek_file_alias(s.file, r.new_name)
        if (alias != null && alias.decl_node != null) ||
            r.c.has_explicit_import_symbol(s.file, r.new_name)
            return r.arena.text()
                .s("'\{r.new_name\}' is already bound by an import in \{shown(s.file, r.arena)\}, ")
                .s("where '\{r.old_name\}' is written").take()
        return ""

    priv fn taken(r: Self, got: Ast_node$@, s: Spot): U8[] //< the message for a collision
        return r.arena.text()
            .s("'\{r.new_name\}' is already declared at \{r.where(got)\}, in scope where ")
            .s("'\{r.old_name\}' is written at \{shown(s.file, r.arena)\}:\{s.line + 1\}:")
            .s("\{s.character + 1\}").take()

    priv fn where(r: Self, n: Ast_node$@): U8[] //< a node's place as a diagnostic names it
        if n == null
            return "?"
        at: = n.find_deep_child(.k_identifier).unwrap_or(n)
        pos: = lsp_uses.position_of(r.c, at)
        return r.arena.text().s(shown(at.loc.file(), r.arena)).s(":\{pos.line + 1\}:")
            .s("\{pos.character + 1\}").take()

priv fn own_scope(s: Spot): Ast_node$@? //< the scope a declaration belongs to
    for i in Range.desc(s.path.len)
        n: = s.path.get(i)
        if is_scope(n) && !names_itself(n, s)
            return .some(n)
    return .none

priv fn names_itself(n: Ast_node$@, s: Spot): Bool //<
    //< whether `n` is what the place's name declares
    return s.is_decl && n.find_child(.k_identifier) == s.node

priv fn shown(logical: U8[], arena: Arena$@): U8[] //< a file as a diagnostic names it
    $out: = Str_builder.new()
    base_locate.recorded_name_to(logical, out@)
    return arena.dup_str(out.slice())

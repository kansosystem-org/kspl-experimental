//< LSP: finds where a name is used, the one list references and rename both answer from
//< **One function collects the places** (`collect_spots`); references turn the list into
//< `Location`s here, renaming into `changes` (`rename.kspl`). **Matching is by definition, not by
//< name.**
//< **The list must be in a fixed order.** The collection is a Map, so its plain order comes from
//< the hash. Then the same answer **looks shuffled on screen** from one request to the next.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as _base_ast_spell // `get_path_name`
import "ksplc/base/core" as base_core
import "ksplc/base/locate" as base_locate
import "ksplc/lsp/msg" as lsp_msg
import "ksplc/lsp/nav" as lsp_nav
import "ksplc/lsp/position" as lsp_position
import "ksplc/lsp/state" { Doc_state }
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/session/import_table" as _sema_session_import_table
import "ksplc/sema/type/query" as _sema_type_query // `get_real_type`, `strip_ptr`
import "std/chars"
import "std/ds" { List, Map }
import "std/json" + { Json_builder }
import "std/mem" { Arena }
import "std/seq"
import "std/str" { Str_builder }

struct Spot //< one place of use
    //< `is_decl` marks the declaration itself: **a references request says whether to count it**
    //< (`context.includeDeclaration`). `node` and `path` are what a rename checks a new name
    //< against (`rename.kspl`).
    uri: U8[]
    line: Sz
    character: Sz
    len: Sz
    is_decl: Bool
    file: U8[] //< the file's logical name
    node: Ast_node$@ //< the identifier
    path: List<|Ast_node$@|>$@ //< the nodes from its file's top down to its parent

struct Target //< what a position names: the definition, and the name written there
    def: Ast_node$@
    name: Ast_node$@

fn target_at(state: Doc_state$@, params: json.Value, arena: Arena$@): Target? //<
    //< The definition the name at the request's position stands for; none off a name
    defer path: = lsp_position.find_path_at_params(state, params, arena)
    if path.len <= 0
        return .none
    at: = path.get(path.len - 1)
    $name: Ast_node$@ = null
    switch name_node(at)
    case .some(n)
        name = n
    default
        return .none
    def: = lsp_nav.resolve_def_node(state.sema, path, at).def_node
    if def != null
        return .some(Target::{ .def = def, .name = name })
    // Where the name is unresolved (sema names no local binding, say), the identifier itself is
    // taken as the definition.
    return .some(Target::{ .def = name.def_node if name.def_node != null else name, .name = name })

fn filter_word(ctx: Sema_ctx$@, root: Ast_node$@, def: Ast_node$@): U8[] //<
    //< The word every file holding a place of `def` spells; empty where it is not known here
    //< Mostly the declaration's own name. **A method the syntax calls is spelled by its type
    //< instead**: a type call (`Vector(1, 2)`) selects `new`, and an operator or a `for` calls a
    //< method of a std/lang trait (`a + b` calls `add`). A file using either names the type.
    if ctx == null || def == null
        return ""
    id: = def.find_child(.k_identifier)
    name: = id.text if id != null else def.text
    if !def.is_fn_decl()
        return name
    block: = owner_block(root, def, 0) catch
        return name
    type_node: = block.get_decl_type_node()
    if block.kind_id != .k_decl_impl || type_node == null
        return name
    trait_id: = trait_with_method(ctx, type_node.type_id, name)
    if !name.equals("new") && !trait_fqn(ctx, trait_id).starts_with("std.lang.")
        return name
    return type_node.get_path_name().get_generic_base_name().fqn_last()

fn trait_with_method(ctx: Sema_ctx@, type_id: I32, name: U8[]): I32 //<
    //< A trait the type implements that declares a method `name`; 0 where none does
    //< **The trait and its implementation are matched by the name alone**, wherever the method
    //< stands: in the `impl` naming the trait or in another of the type's.
    if type_id <= 0 || type_id >= ctx.env.id_to_type.len
        return 0
    traits: = ctx.env.id_to_type.get(ctx.env.strip_ptr(type_id)).implemented_traits
    if traits == null
        return 0
    for trait_id in traits
        switch ctx.env.get_info(ctx.env.get_real_type(trait_id))
        case .trait_type(def)
            for m in def.methods_list
                if m.name.fqn_last().equals(name)
                    return trait_id
        default {}
    return 0

priv fn trait_fqn(ctx: Sema_ctx$@, trait_id: I32): U8[] //< a trait's full name; empty for 0
    //< An instance (`Add<|V2, V2|>`) is named by its generic's (`std.lang.Add`).
    if trait_id == 0
        return ""
    real: = ctx.env.get_real_type(trait_id)
    base: = ctx.env.instance_base(real)
    return base if base.len > 0 else ctx.env.get_str(real)

priv fn owner_block(node: Ast_node$@, def: Ast_node$@, depth: Sz): Ast_node$@? //<
    //< The `impl` or trait whose member `def` is, searched through the files' tops
    if node == null || depth > lsp_position.MAX_WALK_DEPTH
        return .none
    for child in node.children
        if child == def
            return .some(node)
        if child.kind_id == .k_file || child.kind_id == .k_decl_impl ||
            child.kind_id == .k_decl_trait
            if got: = owner_block(child, def, depth + 1)
                return .some(got)
    return .none

priv fn name_node(at: Ast_node$@): Ast_node$@? //< the identifier a picked node is, or holds
    if at.kind_id == .k_identifier
        return .some(at)
    id_child: = at.find_child(.k_identifier)
    if id_child != null
        return .some(id_child)
    last: = at.last_child()
    if at.children.len > 0 && last.kind_id == .k_identifier
        return .some(last)
    return .none

fn handle_references(ws_state: Doc_state$@, params: json.Value, id_val: json.Value,
    arena: Arena$@) //<
        //< `textDocument/references`: it returns the uses as a list of `Location`
        //< **Count the declaration only as asked** (`context.includeDeclaration`), or "only the
        //< uses" cannot be had (a common complaint).
    switch target_at(ws_state, params, arena)
    case .some(t)
        // Every place is returned in this request's URI style (`Uri_style` in
        // `../base/locate.kspl`), since a client spells every file the same way.
        uri: = params.get("textDocument").get("uri").as_str().unwrap_or("")
        spots: = collect_spots(ws_state, t, base_locate.uri_style_of(uri), arena)
        want_decl: = wants_decl(params)
        $b: = Json_builder(arena)
        $arr: = b.arr()
        for i in Range.asc(spots.len)
            s: = spots.get(i)
            if s.node.made_by_compiler() || (s.is_decl && !want_decl)
                continue
            range: = b.range(s.line, s.character, s.line, s.character + s.len)
            arr = arr
                .push(b.obj().set("uri", b.str_val(s.uri)).set("range", range).build())
        lsp_msg.send_response(id_val, arr.build(), arena)
    default
        lsp_msg.send_null_response(id_val, arena)

priv fn wants_decl(params: json.Value): Bool //< whether the references count the declaration itself
    //< Caution: **Where the option is absent, count it**, or a client that sends none loses the
    //< definition from the list. False only when exclusion is asked for.
    switch params.get("context").get("includeDeclaration")
    case .bool_val(b)
        return b
    default
        return true

fn collect_spots(ws_state: Doc_state$@, target: Target, style: base_locate.Uri_style,
    arena: Arena$@): List<|Spot|> //<
        //< It collects the places of the target's definition, across the whole workspace
        //< **A closure's capture is the outer name**: its places are collected with the outer
        //< local's, from either side (capture_source, linked_defs).
        //< Caution: **Walk the generics' templates too.** An instantiated tree cannot be reached
        //< from `root_file`, so skipping them silently misses the calls found only inside a
        //< generic.
    $out: = List<|Spot|>(arena)
    seen: = arena.create(Map<|U8[], I32|>(arena))
    $w: = Walk::{ .target_def = target.def, .ctx = ws_state.sema, .style = style, .seen = seen,
        .out = out@, .above = List<|Ast_node$@|>.create(arena), .arena = arena,
        .name = target.name.text.get_generic_base_name(), .gather = true,
        .named_ids = List<|Ast_node$@|>.create(arena),
        .named_decls = List<|Ast_node$@|>.create(arena) }
    w.walk_all(ws_state)
    // A capture's rebinding is the target: start again from the outer local it reads.
    for _ in Range.asc(MAX_CAPTURE_LINKS)
        outer: = w.capture_source() catch
            break
        w.restart(outer)
        w.walk_all(ws_state)
    w.gather = false
    done: = List<|Ast_node$@|>.create(arena)
    done.push(w.target_def)
    $from: Sz = 0
    for _ in Range.asc(MAX_CAPTURE_LINKS)
        linked: = w.linked_defs(from, done)
        from = out.len
        if linked.len == 0
            break
        for def in linked
            done.push(def)
            w.target_def = def
            w.walk_all(ws_state)
    w.seen.free()
    return out.order_by(fn(left: Spot@, right: Spot@; ): I32 {
        return spot_order(left, right);
    }, arena)

priv fn holds(nodes: List<|Ast_node$@|>@, want: Ast_node$@): Bool //< whether want is in nodes
    for n in nodes
        if n == want
            return true
    return false

priv const MAX_CAPTURE_LINKS: Sz = 64 //< how many closures deep a capture of a capture is followed

priv fn spot_order(left: Spot@, right: Spot@): I32 //< by name, then line, then column
    order: = left.uri.compare(right.uri)
    if order != 0
        return order
    if left.line != right.line
        return -1 if left.line < right.line else 1
    if left.character != right.character
        return -1 if left.character < right.character else 1
    return 0

// ==========================================
// Walking the tree and collecting
// ==========================================

priv fn is_same_loc(left: Ast_node@, right: Ast_node$@): Bool
    if left == null || right == null
        return false
    if left == right
        return true
    return left.loc.offset == right.loc.offset && left.loc.file().len > 0 &&
        left.loc.file().equals(right.loc.file())

priv fn is_def_match(n_def: Ast_node$@, t_def: Ast_node$@): Bool //<
    //< Whether the two definitions are the same one
    //< One definition can be several node instances (a template's re-instantiation, an identifier
    //< standing for its declaration). So besides sym_ptr several fallbacks are tried. One is
    //< enough.
    if n_def == null || t_def == null
        return false
    if n_def.sym_ptr != null && t_def.sym_ptr != null && n_def.sym_ptr == t_def.sym_ptr
        return true

    n_id: = n_def.find_child(.k_identifier)
    t_id: = t_def.find_child(.k_identifier)

    return is_same_loc(n_def, t_def) || is_same_loc(n_id, t_def) || is_same_loc(t_id, n_def) ||
        is_same_loc(n_id, t_id) || is_same_loc(n_def.def_node, t_def) ||
        is_same_loc(n_def, t_def.def_node) || is_same_loc(n_def.def_node, t_def.def_node)

priv fn is_the_decl(node: Ast_node@, target_def: Ast_node$@): Bool //<
    //< Whether that identifier is the declaration itself
    //< Caution: **Compare strictly**, or a real use passes for the declaration and is dropped where
    //< `includeDeclaration` is false.
    return node == target_def || node == target_def.find_child(.k_identifier)

priv struct Walk //< what one search for a definition's uses carries down the tree
    target_def: Ast_node$@ //< the definition whose uses are wanted
    ctx: Sema_ctx$@
    style: base_locate.Uri_style
    seen: Map<|U8[], I32|>$@ //< `<file>:<offset>` of each place added
    out: List<|Spot|>$@ //< the places found
    above: List<|Ast_node$@|>$@ //<
        //< the nodes from the walk's start down to the parent of the one visited
    arena: Arena$@
    name: U8[] //< the target's name, as written
    gather: Bool //< whether the walk records named_ids and named_decls
    named_ids: List<|Ast_node$@|>$@ //< every identifier spelled as the target's name
    named_decls: List<|Ast_node$@|>$@ //< every local's declaration of that name

impl Walk
    priv fn walk_all(r: Self$@, ws_state: Doc_state$@) //< the uses in every file and template
        if ws_state.root_file != null
            r.node(ws_state.root_file, 0)
        if ws_state.sema != null
            for entry in ws_state.sema.generics.templates.items()
                r.node(entry.value, 0)

    priv fn restart(r: Self$@, def: Ast_node$@) //< forgets the places found, to walk for def
        r.target_def = def
        r.out.clear()
        r.seen.free()
        r.seen = r.arena.create(Map<|U8[], I32|>(r.arena))
        r.named_ids.clear()
        r.named_decls.clear()

    priv fn capture_source(r: Self@): Ast_node$@? //<
        //< The outer local the target reads, where the target is a closure capture's rebinding
        //< The rebinding (`n: = env.n$`) and the argument that passes the outer `n` to the
        //< closure stand at the capture's name (place_capture_rebindings in
        //< `../parse/desugar_closure.kspl`). The argument names the outer local.
        def: = r.target_def
        if def == null || def.kind_id != .k_decl_var
            return .none
        id: = def.get_var_decl_id()
        for n in r.named_ids
            if n != id && is_same_loc(n, id) && n.def_node != null &&
                !is_def_match(n.def_node, def)
                return .some(n.def_node)
        return .none

    priv fn linked_defs(r: Self@, from: Sz, done: List<|Ast_node$@|>@): List<|Ast_node$@|> //<
        //< The rebindings of the closures that capture what the places from `from` on name
        //< A use at a capture's name is the argument that passes it, so the rebinding standing
        //< there carries it into the closure's body.
        $out: = List<|Ast_node$@|>(r.arena)
        for i in Range(from, r.out.len, 1)
            s: = r.out.get(i)
            if s.is_decl
                continue
            for d in r.named_decls
                id: = d.get_var_decl_id()
                if id != s.node && is_same_loc(id, s.node) && !holds(done, d) &&
                    !holds(out@, d)
                    out.push(d)
        return out

    priv fn node(r: Self$@, node: Ast_node$@, depth: Sz) //< the uses at node and under it
        target_def: = r.target_def
        // **Nodes the compiler generated are not uses** (`made_by_compiler` in
        // `../base/ast_ext.kspl`). Keep implicit member names for rename refusal,
        // but do not publish them as written references.
        if node == null || target_def == null || depth > lsp_position.MAX_WALK_DEPTH ||
            (node.made_by_compiler() && node.kind_id != .k_identifier)
            return
        // An import's or embed's name belongs to its file alone; unrelated imports elsewhere stay
        // as is.
        if target_def.kind_id == .k_decl_import || target_def.kind_id == .k_decl_embed
            if node.loc.file().len > 0 && target_def.loc.file().len > 0 &&
                !node.loc.file().equals(target_def.loc.file())
                return

        if r.gather
            r.note_named(node)
        if node.kind_id == .k_identifier && node.loc.file().len > 0 && r.refers(node) &&
            !r.in_trait_self(node)
            r.add_spot(node)

        r.above.push(node)
        for child in node.children
            r.node(child, depth + 1)
        r.above.truncate(r.above.len - 1)

    priv fn in_trait_self(r: Self@, node: Ast_node@): Bool //<
        //< Whether `node` is a `Self` inside a trait, which names whatever implements it
        //< **A trait's instance for one type links its `Self` to that type** (std's `Add` for a
        //< `Vec2`), yet the trait is written for every implementer, so it is no use of the type.
        if !node.text.equals("Self")
            return false
        for a in r.above
            if a.kind_id == .k_decl_trait
                return true
        return false

    priv fn note_named(r: Self$@, node: Ast_node$@) //<
        //< records node where it is an identifier or a local's declaration of the target's name
        if node.kind_id == .k_identifier && node.text.equals(r.name)
            r.named_ids.push(node)
        else if node.kind_id == .k_decl_var
            id: = node.get_var_decl_id()
            if id != null && id.text.equals(r.name)
                r.named_decls.push(node)

    priv fn refers(r: Self$@, node: Ast_node$@): Bool //<
        //< whether an identifier is a place of the target
        return is_def_match(node.def_node, r.target_def) || is_def_match(node, r.target_def)

    priv fn add_spot(r: Self$@, hit: Ast_node$@) //<
        //< It adds one place, dropping a duplicate by `<file>:<offset>`
        //< The duplicates come from root_file's walk and a template's.
        src: = base_core.source_of(r.ctx.source_map, hit.loc.file())
        if src.len == 0
            return
        offset: = src.clamp_offset(hit.loc.offset)
        // **Only what the source spells there is a place of use.** A generic's instance copies its
        // template's nodes, places and all, with the arguments put in: `Output` in `Index_place`
        // reads `col.Color` for an array of `Color`. Listed, it would point into std. A name the
        // syntax selects (`new` of a type call) is kept, for the rename to refuse.
        if !hit.made_by_compiler() &&
            !src.sub_from(offset).starts_with(hit.text.get_generic_base_name())
            return
        defer $key: = Str_builder()
        key.s(hit.loc.file()).c(':').s("\{offset\}")
        if r.seen.get(key.slice()).unwrap_or(0) != 0
            return
        r.seen.set(r.arena.dup_str(key.slice()), 1)

        pos: = position_of(r.ctx, hit)
        defer $safe: = hit.loc.file().with_forward_slashes()
        uri: = r.style.spell(safe.slice())
        r.out
            .push(Spot::{ .uri = r.arena.dup_str(uri), .line = pos.line,
            .character = pos.character, .len = hit.text.get_generic_base_name().len,
            .is_decl = is_the_decl(hit, r.target_def), .file = hit.loc.file(), .node = hit,
            .path = r.path_in_file() })

    priv fn path_in_file(r: Self$@): List<|Ast_node$@|>$@ //<
        //< The nodes above the one visited, from the top of its own file down
        //< **An imported file hangs under the file importing it**, so the walk's own path starts in
        //< another file. The part above the nearest file's top is cut off.
        $from: Sz = 0
        for i in Range.asc(r.above.len)
            if r.above.get(i).kind_id == .k_file
                from = i
        out: = List<|Ast_node$@|>.create(r.arena)
        for i in Range(from, r.above.len, 1)
            out.push(r.above.get(i))
        return out

fn position_of(ctx: Sema_ctx$@, node: Ast_node@): lsp_msg.Position //<
    //< Where a node stands in its file, as the LSP counts
    //< Caution: **Get the line-start table from `line_starts_for`**, which builds it once per file.
    //< Built per place, a name used a thousand times in one file walks that file a thousand times.
    src: = base_core.source_of(ctx.source_map, node.loc.file())
    return src.get_line_char(src.clamp_offset(node.loc.offset),
        ctx.line_starts_for(node.loc.file(), src))

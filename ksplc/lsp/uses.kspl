//< LSP: finds where a name is used, the one list references and rename both answer from
//< **One function collects the places** (`collect_spots`); references turn the list into
//< `Location`s here, renaming into `changes` (`rename.kspl`). **Matching is by definition, not by
//< name.**
//< **The list must be in a fixed order.** The collection is a Map, so its plain order comes from
//< the hash. Then the same answer **looks shuffled on screen** from one request to the next.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/core" as base_core
import "ksplc/base/locate" as base_locate
import "ksplc/lsp/msg" as lsp_msg
import "ksplc/lsp/nav" as lsp_nav
import "ksplc/lsp/position" as lsp_position
import "ksplc/lsp/state" { Doc_state }
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/session/import_table" as _sema_session_import_table
import "std/chars"
import "std/ds" { List, Map }
import "std/json" + { Json_builder }
import "std/mem" { Arena }
import "std/seq"
import "std/str" { Str_builder }

struct Spot //< one place of use
    //< `is_decl` marks the declaration itself: **a references request says whether to count it**
    //< (`context.includeDeclaration`). `node` and `path` are what a rename checks a new name
    //< against (`rename.kspl`).
    uri: U8[]
    line: Sz
    character: Sz
    len: Sz
    is_decl: Bool
    file: U8[] //< the file's logical name
    node: Ast_node$@ //< the identifier
    path: List<|Ast_node$@|>$@ //< the nodes from its file's top down to its parent

struct Target //< what a position names: the definition, and the name written there
    def: Ast_node$@
    name: Ast_node$@

fn target_at(state: Doc_state$@, params: json.Value): Target? //<
    //< The definition the name at the request's position stands for; none off a name
    defer path: = lsp_position.find_path_at_params(state, params)
    if path.len <= 0
        return .none
    at: = path.get(path.len - 1)
    $name: Ast_node$@ = null
    switch name_node(at)
    case .some(n)
        name = n
    default
        return .none
    def: = lsp_nav.resolve_def_node(state.sema, path, at).def_node
    if def != null
        return .some(Target::{ .def = def, .name = name })
    // Where the name is unresolved (sema names no local binding, say), the identifier itself is
    // taken as the definition.
    return .some(Target::{ .def = name.def_node if name.def_node != null else name, .name = name })

priv fn name_node(at: Ast_node$@): Ast_node$@? //< the identifier a picked node is, or holds
    if at.kind_id == .k_identifier
        return .some(at)
    id_child: = at.find_child(.k_identifier)
    if id_child != null
        return .some(id_child)
    last: = at.last_child()
    if at.children.len > 0 && last.kind_id == .k_identifier
        return .some(last)
    return .none

fn handle_references(ws_state: Doc_state$@, params: json.Value, id_val: json.Value,
    arena: Arena$@) //<
        //< `textDocument/references`: it returns the uses as a list of `Location`
        //< **Count the declaration only as asked** (`context.includeDeclaration`), or "only the
        //< uses" cannot be had (a common complaint).
    switch target_at(ws_state, params)
    case .some(t)
        // Every place is returned in this request's URI style (`Uri_style` in
        // `../base/locate.kspl`), since a client spells every file the same way.
        uri: = params.get("textDocument").get("uri").as_str().unwrap_or("")
        spots: = collect_spots(ws_state, t, base_locate.uri_style_of(uri), arena)
        want_decl: = wants_decl(params)
        $b: = Json_builder.new(arena)
        $arr: = b.arr()
        for i in Range.asc(spots.len)
            s: = spots.get(i)
            if s.node.made_by_compiler() || (s.is_decl && !want_decl)
                continue
            range: = b.range(s.line, s.character, s.line, s.character + s.len)
            arr = arr
                .push(b.obj().set("uri", b.str_val(s.uri)).set("range", range).build())
        lsp_msg.send_response(id_val, arr.build(), arena)
    default
        lsp_msg.send_null_response(id_val, arena)

priv fn wants_decl(params: json.Value): Bool //< whether the references count the declaration itself
    //< Caution: **Where the option is absent, count it**, or a client that sends none loses the
    //< definition from the list. False only when exclusion is asked for.
    switch params.get("context").get("includeDeclaration")
    case .bool_val(b)
        return b
    default
        return true

fn collect_spots(ws_state: Doc_state$@, t: Target, style: base_locate.Uri_style, arena: Arena$@):
    List<|Spot|> //<
        //< It collects the places of the target's definition, across the whole workspace.
        //< Caution: **Walk the generics' templates too.** An instantiated tree cannot be reached
        //< from `root_file`, so skipping them silently misses the calls found only inside a
        //< generic.
    $out: = List<|Spot|>.new(arena)
    seen: = arena.create(Map<|U8[], I32|>.new(arena))
    $w: = Walk::{ .target_def = t.def, .c = ws_state.sema, .style = style, .seen = seen,
        .out = out@, .above = List<|Ast_node$@|>.create(arena), .arena = arena }
    if ws_state.root_file != null
        w.node(ws_state.root_file, 0)
    if ws_state.sema != null
        for entry in ws_state.sema.generics.templates.items()
            w.node(entry.value, 0)
    seen.free()
    return out.order_by(fn(a: Spot@, b: Spot@; ): I32 {
        return spot_order(a, b);
    }, arena)

priv fn spot_order(a: Spot@, b: Spot@): I32 //< by name, then line, then column
    order: = a.uri.compare(b.uri)
    if order != 0
        return order
    if a.line != b.line
        return -1 if a.line < b.line else 1
    if a.character != b.character
        return -1 if a.character < b.character else 1
    return 0

// ==========================================
// Walking the tree and collecting
// ==========================================

priv fn is_same_loc(a: Ast_node$@, b: Ast_node$@): Bool
    if a == null || b == null
        return false
    if a == b
        return true
    return a.loc.offset == b.loc.offset && a.loc.file().len > 0 &&
        a.loc.file().equals(b.loc.file())

priv fn is_def_match(n_def: Ast_node$@, t_def: Ast_node$@): Bool //<
    //< Whether the two definitions are the same one
    //< One definition can be several node instances (a template's re-instantiation, an identifier
    //< standing for its declaration). So besides sym_ptr several fallbacks are tried. One is
    //< enough.
    if n_def == null || t_def == null
        return false
    if n_def.sym_ptr != null && t_def.sym_ptr != null && n_def.sym_ptr == t_def.sym_ptr
        return true

    n_id: = n_def.find_child(.k_identifier)
    t_id: = t_def.find_child(.k_identifier)

    return is_same_loc(n_def, t_def) || is_same_loc(n_id, t_def) || is_same_loc(t_id, n_def) ||
        (n_id != null && is_same_loc(n_id, t_id)) || is_same_loc(n_def.def_node, t_def) ||
        is_same_loc(n_def, t_def.def_node) ||
        (n_def.def_node != null && is_same_loc(n_def.def_node, t_def.def_node))

priv fn is_the_decl(n: Ast_node$@, target_def: Ast_node$@): Bool //<
    //< Whether that identifier is the declaration itself
    //< Caution: **Compare strictly**, or a real use passes for the declaration and is dropped where
    //< `includeDeclaration` is false.
    return n == target_def || n == target_def.find_child(.k_identifier)

priv struct Walk //< what one search for a definition's uses carries down the tree
    target_def: Ast_node$@ //< the definition whose uses are wanted
    c: Sema_ctx$@
    style: base_locate.Uri_style
    seen: Map<|U8[], I32|>$@ //< `<file>:<offset>` of each place added
    out: List<|Spot|>$@ //< the places found
    above: List<|Ast_node$@|>$@ //<
        //< the nodes from the walk's start down to the parent of the one visited
    arena: Arena$@

impl Walk
    priv fn node(w: Self$@, node: Ast_node$@, depth: Sz) //< the uses at node and under it
        target_def: = w.target_def
        // **Nodes the compiler generated are not uses** (`made_by_compiler` in
        // `../base/ast_ext.kspl`). Keep implicit member names for rename refusal,
        // but do not publish them as written references.
        if node == null || target_def == null || depth > lsp_position.MAX_WALK_DEPTH ||
            (node.made_by_compiler() && node.kind_id != .k_identifier)
            return
        // An import's or embed's name belongs to its file alone; unrelated imports elsewhere stay
        // as is.
        if target_def.kind_id == .k_decl_import || target_def.kind_id == .k_decl_embed
            if node.loc.file().len > 0 && target_def.loc.file().len > 0 &&
                !node.loc.file().equals(target_def.loc.file())
                return

        if node.kind_id == .k_identifier && node.loc.file().len > 0 && w.refers(node)
            w.add_spot(node)

        w.above.push(node)
        for child in node.children
            w.node(child, depth + 1)
        w.above.len -= 1

    priv fn refers(w: Self$@, n: Ast_node$@): Bool //<
        //< whether an identifier is a place of the target
        return is_def_match(n.def_node, w.target_def) || is_def_match(n, w.target_def)

    priv fn add_spot(w: Self$@, hit: Ast_node$@) //<
        //< It adds one place, dropping a duplicate by `<file>:<offset>`
        //< The duplicates come from root_file's walk and a template's.
        src: = base_core.source_of(w.c.source_map, hit.loc.file())
        if src.len == 0
            return
        offset: = src.clamp_offset(hit.loc.offset)
        defer $key: = Str_builder.new()
        key.s(hit.loc.file()).c(':').s("\{offset\}")
        if w.seen.get(key.slice()).unwrap_or(0) != 0
            return
        w.seen.set(w.arena.dup_str(key.slice()), 1)

        pos: = position_of(w.c, hit)
        defer $safe: = hit.loc.file().with_forward_slashes()
        uri: = w.style.spell(safe.slice())
        w.out
            .push(Spot::{ .uri = w.arena.dup_str(uri), .line = pos.line,
            .character = pos.character, .len = hit.text.get_generic_base_name().len,
            .is_decl = is_the_decl(hit, w.target_def), .file = hit.loc.file(), .node = hit,
            .path = w.path_in_file() })

    priv fn path_in_file(w: Self$@): List<|Ast_node$@|>$@ //<
        //< The nodes above the one visited, from the top of its own file down
        //< **An imported file hangs under the file importing it**, so the walk's own path starts in
        //< another file. The part above the nearest file's top is cut off.
        $from: Sz = 0
        for i in Range.asc(w.above.len)
            if w.above.get(i).kind_id == .k_file
                from = i
        out: = List<|Ast_node$@|>.create(w.arena)
        for i in Range.new(from, w.above.len, 1)
            out.push(w.above.get(i))
        return out

fn position_of(c: Sema_ctx$@, node: Ast_node$@): lsp_msg.Position //<
    //< Where a node stands in its file, as the LSP counts
    //< Caution: **Get the line-start table from `line_starts_for`**, which builds it once per file.
    //< Built per place, a name used a thousand times in one file walks that file a thousand times.
    src: = base_core.source_of(c.source_map, node.loc.file())
    return src.get_line_char(src.clamp_offset(node.loc.offset),
        c.line_starts_for(node.loc.file(), src))

//< The call hierarchy: `prepareCallHierarchy`, `incomingCalls` and `outgoingCalls`
//< **A function is named by its full name including its file** (`compute_def_fqn`). The editor
//< gets it as the item's opaque `data`, so two functions called `init` in different files are
//< never mixed up. Passing a function as a pointer is an edge too, marked `(as fn pointer)`: much
//< code is reachable only that way. A workspace not analysed far enough is answered with an error,
//< never with an empty list.
import "ksplc/base/ast" { Ast_node, is_anon_fn_name, is_anon_env_ctor_name }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/core" as base_core
import "ksplc/base/locate" as base_locate
import "ksplc/lsp/msg" as lsp_msg
import "ksplc/lsp/nav" as lsp_nav
import "ksplc/lsp/position" as lsp_position
import "ksplc/lsp/state" { Doc_state }
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/chars"
import "std/ds" { List, Map }
import "std/json" + { Json_builder }
import "std/mem" { Arena }
import "std/seq"
import "std/str" { Str }
import "std/sys"

priv fn is_fn_or_impl_decl(node: Ast_node$@): Bool //<
    //< Whether it is a function's or an impl's declaration node
    //< Such a node can be either end of a call hierarchy's edge.
    return node != null &&
        (node.kind_id == .k_decl_fn || node.kind_id == .k_decl_fn_proto ||
        node.kind_id == .k_decl_impl)

priv struct Call_hier_entry
    caller_def: Ast_node$@
    callee_def: Ast_node$@
    ranges: List<|Ast_node$@|>$@
    has_call: Bool //<
        //< Whether the counterpart is called on this edge
        //< A counterpart can be both called and passed as a function pointer. Kept apart from
        //< has_ref, the mark in the detail string (the LSP has no field for an edge's kind) stays
        //< on **pointers only**.
    has_ref: Bool

priv fn add_call_entry(idx: Fqn_lookup_idx$@, caller: Ast_node$@, callee: Ast_node$@,
    range_node: Ast_node$@, is_ref: Bool, map: Map<|U8[], Call_hier_entry$@|>$@)
    target: = caller if caller != null else callee
    fqn: = compute_def_fqn(idx, target)

    $entry: = map.get(fqn).unwrap_or(null)
    if entry == null
        // On the arena, rewound with the request: nothing frees the entries one by one.
        ranges: = base_core.arena.create(List<|Ast_node$@|>(base_core.arena))
        entry = base_core.arena
            .create(Call_hier_entry::{ .caller_def = caller, .callee_def = callee,
            .ranges = ranges })
        map.set(fqn, entry)
    if is_ref
        entry.has_ref = true
    else
        entry.has_call = true
    // **Each instance of a generic repeats its template's call at the same place.** Listed once
    // per instance, one call would show as several.
    for r in entry.ranges
        if r.loc.offset == range_node.loc.offset &&
            r.loc.file().equals(range_node.loc.file())
            return
    entry.ranges.push(range_node)

priv fn build_call_hier_item(target: Ast_node@, id_n: Ast_node@, name: U8[], fqn_slice: U8[],
    src_res: U8[], starts: List<|Sz|>$@, is_ref_only: Bool, style: base_locate.Uri_style,
    $builder: Json_builder): json.Value
    t_off: = id_n.loc.offset if id_n != null else target.loc.offset
    t_len: = id_n.text.len if id_n != null else 1
    r_val: = builder.range_in(src_res, t_off, t_len, starts)

    defer $safe_uri: = target.loc.file().with_forward_slashes()
    full_uri: = style.spell(safe_uri.slice())

    // The detail carries the defining file's name: a call hierarchy crosses files, and the function
    // name alone does not say which definition it is.
    defer $file_name: = Str()
    file_name.s(sys.get_file_name(target.loc.file()))
    file_name.ensure_kspl_ext()
    // Caution: **It must not look the same as a call.** A function pointer passed along may only be
    // stored; mixed in, it reads as "always called".
    if is_ref_only
        file_name.s(" (as fn pointer)")

    return builder.obj().set("name", builder.str_val(name))
        .set("kind", builder.int_val(lsp_msg.S_FUNCTION))
        .set("detail", builder.str_val(file_name.slice()))
        .set("uri", builder.str_val(full_uri)).set("range", r_val).set("selectionRange", r_val)
        .set("data", builder.str_val(fqn_slice)).build()

priv fn build_call_hier_json(ctx: Sema_ctx$@, idx: Fqn_lookup_idx$@, entry: Call_hier_entry$@,
    is_incoming: Bool, style: base_locate.Uri_style, $builder: Json_builder): json.Value
    target: = written_decl(idx, entry.caller_def if is_incoming else entry.callee_def)

    id_n: = target.find_child(.k_identifier)
    name: = id_n.text if id_n != null else target.text
    fqn: = compute_def_fqn(idx, target)

    t_file: = target.loc.file()
    t_src: = base_core.source_of(ctx.source_map, t_file)
    // Caution: Build the line-start table once per file (the reason is at get_line_info in
    // base/lines.kspl); `line_starts_for` keeps it across one file's entries.
    t_starts: = ctx.line_starts_for(t_file, t_src)
    item: =
        build_call_hier_item(target, id_n, name, fqn, t_src, t_starts,
        entry.has_ref && !entry.has_call, style, builder)

    // Caution: **Read each call's place in its own file**, the caller's. In outgoing calls the
    // item is the callee, which can stand in another file. Read with its lines, the place moved.
    $ranges_arr: = builder.arr()
    for r_node in entry.ranges
        r_file: = r_node.loc.file()
        r_src: = base_core.source_of(ctx.source_map, r_file)
        r_starts: = ctx.line_starts_for(r_file, r_src)
        ranges_arr = ranges_arr
            .push(builder.range_in(r_src, r_node.loc.offset, r_node.text.len, r_starts))

    return builder.obj().set("from" if is_incoming else "to", item)
        .set("fromRanges", ranges_arr.build()).build()

priv struct Call_target_info
    target_def: Ast_node$@
    range_node: Ast_node$@

impl Ast_node
    priv fn extract_call_target(r: Self$@): Call_target_info
        $res: = Call_target_info::{ .target_def = null, .range_node = null }
        if r == null
            return res
        // The call is the outer "(" node, whose receiver already holds def_node; checking the
        // receiver node separately would count the same call twice.
        if r.kind_id == .k_expr_postfix
            op: = r.get_postfix_op()
            if op != null && op.text.equals("(")
                recv: = r.get_postfix_receiver()
                if recv != null
                    res.target_def = recv.def_node
                    res.range_node = recv.called_name(recv.def_node, 0).unwrap_or(recv)
                return res
        else if r.kind_id == .k_enum_init_call && r.children.len > 0
            first: = r.get_child(0)
            res.target_def = first.def_node
            res.range_node = first
            return res
        // **An operator the compiler rewrites to a method call is a call** (`a + b` to `add`,
        // `xs[i]` to `at`). Sema links the operator's node to the method; the range is the mark.
        if is_fn_or_impl_decl(r.def_node)
            if mark: = r.operator_mark()
                res.target_def = r.def_node
                res.range_node = mark
        return res

    priv fn called_name(r: Self$@, target: Ast_node$@, depth: Sz): Ast_node$@? //<
        //< The last identifier under a call's callee that names `target`: the name written
        //< **The callee is often no name** (`s.get` is a member access). Its own text is the kind's
        //< (`postfix`), so a range as long as it covered unrelated text.
        if r == null || target == null || depth > lsp_position.MAX_WALK_DEPTH
            return .none
        for i in Range.desc(r.children.len)
            if found: = r.children.get(i).called_name(target, depth + 1)
                return .some(found)
        if r.kind_id == .k_identifier && r.def_node == target
            return .some(r)
        return .none

    priv fn operator_mark(r: Self$@): Ast_node$@? //<
        //< The operator's own node in an expression an operator trait can rewrite; none otherwise
        switch r.kind_id
        case .k_expr
            return .some(r.get_binary_op())
        case .k_expr_unary
            return .some(r.get_unary_op())
        case .k_expr_postfix
            op: = r.get_postfix_op()
            if op != null && op.text.equals("[")
                return .some(op)
        default {}
        return .none
priv struct Fqn_lookup_idx //< the indexes compute_def_fqn uses, built once per request
    //< The call hierarchy calls compute_def_fqn per call site. A generic function's template has
    //< no symbol, so its FQN is found by position; as a linear walk that would be O(N*M).
    fn_templates: Map<|Sz, U8[]|>$@ //<
        //< each instantiated function's template key, by its node (the analysis's own table)
    templates: Map<|U8[], Ast_node$@|>$@ //< the templates by key (the analysis's own table)
    template_locs: Map<|U8[], U8[]|>$@ //< a template's file#offset -> its registration key

priv fn node_loc_key(node: Ast_node@): U8[] //<
    //< A position key from a node's file and offset, kept in the request's arena
    //< No two declarations share a position, so the key (NUL-separated from the file name) is
    //< unique.
    return base_core.arena.text().s(node.loc.file()).c(0U8).s("\{node.loc.offset\}").take()

priv fn build_fqn_lookup_idx(ctx: Sema_ctx$@): Fqn_lookup_idx$@
    template_locs: = base_core.arena.create(Map<|U8[], U8[]|>(base_core.arena))
    for e in ctx.generics.templates.items()
        template_locs.set(node_loc_key(e.value), e.key)

    return base_core.arena
        .create(Fqn_lookup_idx::{ .fn_templates = ctx.env.fn_templates,
        .templates = ctx.generics.templates, .template_locs = template_locs })

priv fn find_template_fqn_indexed(idx: Fqn_lookup_idx@, node: Ast_node$@): U8[]
    return idx.template_locs.get(node_loc_key(node)).unwrap_or("")

priv fn qualified_sym_name(sym: Sema_symbol$@): U8[] //<
    //< A global symbol's full name ("ksos.drivers.ht16k33.init")
    //< **A top-level sym.name is the bare name.** As the identity, same-named functions in
    //< different files (`init`) would merge, and unrelated callers would be listed. It matches the
    //< FQN sema puts in symtab.by_fqn (make_fqn in sema/decl/resolve.kspl), so resolve_defs_by_fqn
    //< is O(1).
    if !sym.flags.is_global
        return sym.name
    defer $full: = Str()
    lsp_nav.write_full_name(sym.name, sym.get_defined_in(), full@)
    return base_core.arena.dup_str(full.slice())

priv fn compute_def_fqn(idx: Fqn_lookup_idx$@, def_node: Ast_node$@): U8[] //<
    //< The FQN that identifies a definition node
    //< That is the full name, or a generic's template key, for the template and each instance.
    //< Caution: **Name an instance by its template's key**, never by its own name. The analysis
    //< files an instance under two names (`Base<|args|>` and the C name), and neither is the
    //< template's. A caller of one instance then answered no caller of the template.
    if def_node.sym_ptr != null
        sym: = Sema_symbol$@::def_node.sym_ptr
        if sym.flags.is_generated_instance
            return idx.fn_templates.get(Sz::def_node).unwrap_or(sym.name)
        return qualified_sym_name(sym)
    return find_template_fqn_indexed(idx, def_node)

priv fn written_decl(idx: Fqn_lookup_idx$@, def_node: Ast_node$@): Ast_node$@ //<
    //< The declaration the source writes for def_node: an instance's template, else def_node
    //< **An instance's name is the C name** (`main_Stack_I32_push`), which no file spells. An
    //< item built from it shows that name, with a range as long as it.
    if def_node == null || def_node.sym_ptr == null
        return def_node
    if !(Sema_symbol$@::def_node.sym_ptr).flags.is_generated_instance
        return def_node
    key: = idx.fn_templates.get(Sz::def_node).unwrap_or("")
    return idx.templates.get(key).unwrap_or(def_node)

priv fn build_callee_id_set(root: Ast_node$@): Map<|U8[], I32|>$@ //<
    //< The call targets' identifiers, so a function used as a value is told apart from a call
    //< An identifier **using a function as a value without calling it** is recorded as an edge.
    //<
    //< Caution: **It is not a call and must not be treated as one.** It is still an edge because
    //< **much code is reachable only through a function pointer** (task entry points, bio
    //< callbacks). Shown with "no caller", it looks unused and is mistaken for removable.
    set: = base_core.arena.create(Map<|U8[], I32|>(base_core.arena))
    collect_callee_ids(root, set, 0)
    return set

priv fn collect_callee_ids(node: Ast_node$@, set: Map<|U8[], I32|>$@, depth: Sz)
    if node == null || depth > lsp_position.MAX_WALK_DEPTH
        return
    info: = node.extract_call_target()
    if info.range_node != null
        mark_fn_ids(info.range_node, set, 0)
    for child in node.children
        collect_callee_ids(child, set, depth + 1)

priv fn mark_fn_ids(node: Ast_node$@, set: Map<|U8[], I32|>$@, depth: Sz) //<
    //< It registers the function identifiers inside a call's callee (`foo` / `usb.send_frame`)
    if node == null || depth > lsp_position.MAX_WALK_DEPTH
        return
    if node.kind_id == .k_identifier && is_fn_or_impl_decl(node.def_node)
        set.set(node_loc_key(node), 1)
    for child in node.children
        mark_fn_ids(child, set, depth + 1)

priv fn is_fn_ref_use(node: Ast_node$@, callee_ids: Map<|U8[], I32|>@): Bool //<
    //< Whether this identifier passes a function as a function pointer
    //< The declaration's own name is excluded: its def_node points at itself, so otherwise **every
    //< function would be listed as its own caller**.
    if node.kind_id != .k_identifier || !is_fn_or_impl_decl(node.def_node)
        return false
    if node.def_node.find_child(.k_identifier) == node
        return false
    return callee_ids.get(node_loc_key(node)).unwrap_or(0) == 0

priv struct Call_search //< what both directions of a search carry down the tree unchanged
    idx: Fqn_lookup_idx$@
    callee_ids: Map<|U8[], I32|>$@ //< the calls' callees, which are not function-pointer uses
    map: Map<|U8[], Call_hier_entry$@|>$@ //< the edges found, by the other end's FQN

priv fn find_incoming_calls(search: Call_search, node: Ast_node$@, target_fqn: U8[],
    caller_def: Ast_node$@, depth: Sz)
    if node == null || depth > lsp_position.MAX_WALK_DEPTH
        return

    $current_caller: = caller_def
    if is_fn_or_impl_decl(node)
        current_caller = node

    info: = node.extract_call_target()
    if info.target_def != null && current_caller != null
        called_fqn: = compute_def_fqn(search.idx, info.target_def)
        if called_fqn.equals(target_fqn)
            add_call_entry(search.idx, current_caller, null, info.range_node, false, search.map)
    else if current_caller != null && is_fn_ref_use(node, search.callee_ids)
        ref_fqn: = compute_def_fqn(search.idx, node.def_node)
        if ref_fqn.equals(target_fqn)
            add_call_entry(search.idx, current_caller, null, node, true, search.map)

    for child in node.children
        find_incoming_calls(search, child, target_fqn, current_caller, depth + 1)

priv fn is_closure_lift(idx: Fqn_lookup_idx$@, def_node: Ast_node$@): Bool //<
    //< Whether it is a function the compiler made from a closure written in the caller
    //< That is the closure's own body, or the function that builds its captures. **The person
    //< wrote a closure there, not a call**, and no file spells these names (`_anon_env_new_1`).
    id_n: = written_decl(idx, def_node).find_child(.k_identifier)
    return id_n != null &&
        (is_anon_fn_name(id_n.text) || is_anon_env_ctor_name(id_n.text))

priv fn find_outgoing_calls(search: Call_search, node: Ast_node$@, depth: Sz) //<
    //< The calls and function-pointer uses under node, the caller's body
    if node == null || depth > lsp_position.MAX_WALK_DEPTH
        return

    info: = node.extract_call_target()
    if is_fn_or_impl_decl(info.target_def)
        if !is_closure_lift(search.idx, info.target_def)
            add_call_entry(search.idx, null, info.target_def, info.range_node, false, search.map)
    else if is_fn_ref_use(node, search.callee_ids)
        // The reverse direction is recorded for the same reason: without the edge, someone tracing
        // a task entry point has no lead.
        if !is_closure_lift(search.idx, node.def_node)
            add_call_entry(search.idx, null, node.def_node, node, true, search.map)

    for child in node.children
        find_outgoing_calls(search, child, depth + 1)
priv fn collect_defs_by_fqn(node: Ast_node$@, idx: Fqn_lookup_idx$@, target_fqn: U8[],
    out: List<|Ast_node$@|>$@, depth: Sz = 0) //<
        //< The definition nodes matching target_fqn in the whole AST
        //< Not Symbol_table.resolve(). That tries current_file (whichever was walked last) and then
        //< FQN keys. So a function in an unrelated file can fail to resolve.
        //< **A generic has several**: its template and each instance share the template's key.
    if node == null || depth > lsp_position.MAX_WALK_DEPTH
        return
    if is_fn_or_impl_decl(node) && compute_def_fqn(idx, node).equals(target_fqn)
        out.push(node)
        return
    for child in node.children
        collect_defs_by_fqn(child, idx, target_fqn, out, depth + 1)

priv fn resolve_defs_by_fqn(root: Ast_node$@, ctx: Sema_ctx$@, idx: Fqn_lookup_idx$@,
    target_fqn: U8[]): List<|Ast_node$@|>$@ //<
        //< target_fqn's definition nodes; empty where none is found
        //< It tries Symbol_table.resolve_fqn first, then the tree walk (collect_defs_by_fqn) for
        //< what symtab lacks, such as a generic's template and its instances.
    out: = base_core.arena.create(List<|Ast_node$@|>(base_core.arena))
    sym: = ctx.symtab.resolve_fqn(target_fqn).unwrap_or(null)
    if sym != null && sym.node != null
        out.push(sym.node)
        return out
    collect_defs_by_fqn(root, idx, target_fqn, out)
    return out
// ==========================================
// Interface APIs for Handlers
// ==========================================

fn prepare_call_hierarchy(state: Doc_state$@, params: json.Value, id_val: json.Value,
    arena: Arena$@)
    $b: = Json_builder(arena)
    defer path: = lsp_position.find_path_at_params(state, params, arena)

    if path.len > 0
        $def_node: Ast_node$@ = null
        // On the declaration's own name this is the declaration itself (`get_definition_node`).
        idx: = build_fqn_lookup_idx(state.sema)
        if d: = lsp_nav.get_definition_node(state.sema, path)
            def_node = written_decl(idx, d)

        if is_fn_or_impl_decl(def_node)
            id_node: = def_node.find_child(.k_identifier)
            name: = id_node.text if id_node != null else def_node.text
            fqn: = compute_def_fqn(idx, def_node)
            // **An error can stop the analysis before the functions are registered** (a method its
            // trait does not declare, say). The function then has no name to find it by, and an
            // item without one would answer "no callers".
            if fqn.len == 0
                lsp_msg.send_error_response(id_val, lsp_msg.REQUEST_FAILED, NOT_ANALYSED, arena)
                return

            def_file: = def_node.loc.file()
            src_res: = base_core.source_of(state.sema.source_map, def_file)
            // The starting point is no edge, so it gets no mark.
            starts_res: = state.sema.line_starts_for(def_file, src_res)
            item: =
                build_call_hier_item(def_node, id_node, name, fqn, src_res, starts_res, false,
                base_locate.uri_style_of(state.uri_perm), b)

            lsp_msg.send_response(id_val, b.arr().push(item).build(), arena)
            return
    lsp_msg.send_null_response(id_val, arena)

priv fn call_order(left: Call_hier_entry$@, right: Call_hier_entry$@, is_incoming: Bool): I32 //<
    //< By the counterpart's location: its file, then its position
    a_t: = left.caller_def if is_incoming else left.callee_def
    b_t: = right.caller_def if is_incoming else right.callee_def
    order: = a_t.loc.file().compare(b_t.loc.file())
    if order != 0
        return order
    if a_t.loc.offset != b_t.loc.offset
        return -1 if a_t.loc.offset < b_t.loc.offset else 1
    return 0

priv fn respond_with_call_hier_entries(calls_map: Map<|U8[], Call_hier_entry$@|>$@,
    ctx: Sema_ctx$@, idx: Fqn_lookup_idx$@, is_incoming: Bool, style: base_locate.Uri_style,
    $builder: Json_builder, id_val: json.Value, arena: Arena$@)
    $arr: = builder.arr()
    // **Only here is a list built** (sorting needs them all). Code that only iterates uses
    // `entries()` (the reason is at `entries` in `../../std/ds.kspl`).
    // Caution: **Do not answer in the Map's order.** That order comes from the hash. So the same
    // question gets a different order on every run. A client walking the list loses its place.
    defer $calls: = List<|Call_hier_entry$@|>(null)
    for entry in calls_map.items()
        calls.push(entry.value)
    sorted: = calls.order_by(fn(left: Call_hier_entry$@@, right: Call_hier_entry$@@; is_incoming:
        Bool): I32 {
        return call_order(left$, right$, is_incoming);
    }, arena)
    for call in sorted
        res_obj: = build_call_hier_json(ctx, idx, call, is_incoming, style, builder)
        arr = arr.push(res_obj)
    lsp_msg.send_response(id_val, arr.build(), arena)

priv fn answered_no_workspace(ws_state: Doc_state$@, id_val: json.Value, arena: Arena$@): Bool //<
    //< It answers an error where the workspace was not analysed far enough, and returns if it did
    //< **`build_workspace_state` hides the analysis's failure**, and `handle_calls` below reads
    //< `sema` directly.
    //< Caution: **Do not answer the empty array.** "It has no callers" is something the reader acts
    //< on, and a wrong one costs more than hearing the question could not be answered.
    if ws_state != null && ws_state.sema != null && ws_state.root_file != null
        return false
    lsp_msg.send_error_response(id_val, lsp_msg.REQUEST_FAILED,
        "the workspace could not be analysed, so the callers cannot be listed", arena)
    return true

priv const NOT_ANALYSED: U8[] = //< the answer where a function has no name the analysis knows
    "the function was not analysed, as an error stops the analysis before it. Fix the errors, then \
        ask again"

priv fn analysed_bodies(defs: List<|Ast_node$@|>$@): List<|Ast_node$@|>$@ //<
    //< The definitions whose bodies to search for calls: a generic's instances where it has any
    //< **A template's body is not analysed**, and it carries marks an instantiation left there.
    //< Only a generic nothing instantiates is searched in its template, for the names resolved in
    //< it. Only an instance has a symbol among a generic's definitions.
    out: = base_core.arena.create(List<|Ast_node$@|>(base_core.arena))
    for d in defs
        if d.sym_ptr != null
            out.push(d)
    return out if out.len > 0 else defs

fn item_fqn(params: json.Value): U8[] //<
    //< The FQN of the function a call hierarchy request asks about (the `data` prepare returned)
    return params.get("item").get("data").as_str().unwrap_or("")

fn handle_calls(ws_state: Doc_state$@, params: json.Value, id_val: json.Value, is_incoming: Bool,
    arena: Arena$@) //<
        //< It answers `callHierarchy/incomingCalls`, or `outgoingCalls` where not `is_incoming`
    if answered_no_workspace(ws_state, id_val, arena)
        return
    target_fqn: = item_fqn(params)
    idx: = build_fqn_lookup_idx(ws_state.sema)
    target_defs: = resolve_defs_by_fqn(ws_state.root_file, ws_state.sema, idx, target_fqn)
    // Caution: **Answer an error, not the empty array, where the function is not found.** An error
    // in another file can stop the workspace's analysis before it registers the function.
    if target_fqn.len == 0 || target_defs.len == 0
        lsp_msg.send_error_response(id_val, lsp_msg.REQUEST_FAILED, NOT_ANALYSED, arena)
        return
    defer calls_map: = base_core.arena
        .create(Map<|U8[], Call_hier_entry$@|>(base_core.arena))

    // The exclusion table is built from **the whole tree**; from the target alone a call's callee
    // would also be listed as passing a function pointer.
    search: = Call_search::{ .idx = idx, .callee_ids = build_callee_id_set(ws_state.root_file),
        .map = calls_map }
    if is_incoming
        find_incoming_calls(search, ws_state.root_file, target_fqn, null, 0)
    else
        for target_def in analysed_bodies(target_defs)
            find_outgoing_calls(search, target_def, 0)
    respond_with_call_hier_entries(calls_map, ws_state.sema, idx, is_incoming,
        base_locate.uri_style_of(ws_state.uri_perm), Json_builder(arena), id_val, arena)

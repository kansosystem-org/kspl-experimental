//< Reading and writing the language server's JSON-RPC messages, and the positions they carry
//< Every message comes in through `read_message` and goes out through `send_response` and its
//< siblings, in the worker and the supervisor alike. **A position is a 0-based line and a
//< character counted in UTF-16 units**, as the LSP counts; `get_line_char` and
//< `get_offset_from_pos` convert to and from a byte offset. The markers the worker sends the
//< supervisor (alive, done) are spelt here alone.
import "ksplc/base/core" as base_core
import "ksplc/base/diag" as base_diag
import "ksplc/base/locate" as base_locate
import "std/chars"
import "std/ds" { List }
import "std/io"
import "std/json" + { Json_builder }
import "std/jsonrpc"
import "std/math"
import "std/mem" { Arena }
import "std/str" { Str_builder }

enum Lsp_error
    io_error
    format_error
// ==========================================
// Types
// ==========================================
struct Position
    line: Sz
    character: Sz
// ==========================================
// Utility methods
// ==========================================
impl Json_builder
    fn position(r: Self$@, line: Sz, col: Sz): json.Value
        return r.obj().set("line", r.int_val(I32::line))
            .set("character", r.int_val(I32::col)).build()

    fn range(r: Self$@, sl: Sz, sc: Sz, el: Sz, ec: Sz): json.Value
        return r.obj().set("start", r.position(sl, sc)).set("end", r.position(el, ec)).build()

    fn range_in(r: Self$@, src: U8[], off: Sz, len: Sz, starts: List<|Sz|>$@): json.Value //<
        //< The LSP range of `len` bytes at `off` in `src`, cut short at its end
        at: = math.min(off, src.len)
        end: = at + len if at + len <= src.len else src.len
        s: = src.get_line_char(at, starts)
        e: = src.get_line_char(end, starts)
        return r.range(s.line, s.character, e.line, e.character)

    fn location(r: Self$@, uri: U8[], sl: Sz, sc: Sz, el: Sz, ec: Sz): json.Value
        defer $safe_uri: = uri.with_forward_slashes()

        return r.obj().set("uri", r.str_val(safe_uri.slice()))
            .set("range", r.range(sl, sc, el, ec)).build()

impl U8[]
    fn with_forward_slashes(r: U8[]): Str_builder //< the path with each `\` turned into `/`
        $res: = Str_builder.new()
        for i in Range.asc(r.len)
            c: = (r.ptr + i)$
            res.c('/' if c == '\\' else c)
        return res

    fn get_line_char(r: Self, target_offset: Sz, starts: List<|Sz|>$@): Position //<
        //< The LSP position of an offset: a 0-based line and a character in UTF-16 code units
        //< The internal line is 1-based. The character is already in UTF-16 units (get_line_info).
        //< **Where the same source is used many times, build the line-start table once.** Pass it
        //< in (the reason is at get_line_info in base/core.kspl).
        info: = r.get_line_info(target_offset, starts)
        return Position::{ .line = info.line - 1, .character = info.char_idx }
    fn get_offset_from_pos(r: U8[], target_line: Sz, target_col: Sz): Sz //<
        //< The byte offset of a 0-based line and a character in UTF-16 code units
        //< It is `get_line_char`'s inverse.
        //<
        //< A position past a line's end lands on that line's end (`offset_of_utf16` in
        //< base/core.kspl).
        return r.offset_of_utf16(target_line, target_col, r.line_starts(base_core.arena))

    fn clamp_offset(r: U8[], offset: Sz): Sz //<
        //< It clamps the offset to the source length's range [0, len-1] (shared across the LSP)
        if r.len == 0
            return 0
        return 0 if offset < 0 else (r.len - 1 if offset >= r.len else offset)

impl Str_builder
    fn ensure_kspl_ext(r: Self$@) //<
        //< It adds the default extension to a URI or path string lacking one (shared by the LSP)
        //< `SOURCE_EXT` in `base/core.kspl` is the one.
        if !r.slice().has_kspl_ext()
            r.s(base_core.SOURCE_EXT)
// ==========================================
// Reading a message, and writing one
// ==========================================

// The LSP's symbol kinds that are sent. The numbers are the protocol's (`SymbolKind`).
const S_NAMESPACE: I32 = 3I32
const S_METHOD: I32 = 6I32
const S_FIELD: I32 = 8I32
const S_ENUM: I32 = 10I32
const S_INTERFACE: I32 = 11I32
const S_FUNCTION: I32 = 12I32
const S_VARIABLE: I32 = 13I32
const S_CONSTANT: I32 = 14I32
const S_MEMBER: I32 = 22I32
const S_STRUCT: I32 = 23I32
const S_TYPE: I32 = 26I32

// The LSP's diagnostic tags (`DiagnosticTag`), and the document sync it asks for (`Full`).
const TAG_UNNECESSARY: I32 = 1I32
const SYNC_FULL: I32 = 1I32

// The error codes a refusal is answered with. `InvalidParams`: a parameter is missing or of the
// wrong kind. `RequestFailed`: well formed, refused for a reason the message gives the person.
const INVALID_PARAMS: I32 = -32602I32
const REQUEST_FAILED: I32 = -32803I32

const MAX_CONTENT_LENGTH: I32 = 128 * 1024 * 1024 //<
    //< The limit on a Content-Length, which prevents memory exhaustion and digit overflow
    //< It leaves ample room for an ordinary LSP message.
priv const MAX_HEADER_LINE_LEN: Sz = 8192 //< the limit on one header line
    //< A real header fits in a few dozen bytes; this stops line_buf growing without limit when a
    //< peer never sends a newline.

fn offset_at(src: U8[], params: json.Value): Sz //<
    //< The offset in `src` of the position a request names (`params.position`)
    pos: = params.get("position")
    return src.get_offset_from_pos(pos.get("line").as_int().unwrap_or(0),
        pos.get("character").as_int().unwrap_or(0))

fn read_message(out: Str_builder$@): Void!Lsp_error //<
    //< It reads one message from stdin, its header and then its body, into `out`
    //< **The worker and the supervisor both read through here.** A body the peer cut short is
    //< passed on as far as it arrived, and the JSON reader rejects it.
    len: = read_content_length()!
    out.len = 0
    out.reserve(len)
    for _i in Range.asc(len)
        c: = io.getchar() catch
            throw .io_error
        if got: = c
            out.c(got)
        else
            break

fn read_content_length(): I32!Lsp_error
    $len: I32 = -1
    defer $line_buf: = Str_builder.new()
    $prev_was_nl: = false

    for
        c: = io.getchar() catch
            throw .io_error
        $ch: U8 = 0
        if got: = c
            ch = got
        else
            throw .io_error
        if ch == '\r'
            continue

        if ch == '\n'
            if prev_was_nl
                if len >= 0
                    return len
                throw .format_error
            prev_was_nl = true
            declared: =
                jsonrpc.content_length(line_buf.slice(), MAX_CONTENT_LENGTH) catch
                throw .format_error
            if n: = declared
                len = I32::n
            line_buf.len = 0
            continue

        prev_was_nl = false
        if line_buf.len >= MAX_HEADER_LINE_LEN
            throw .format_error
        line_buf.c(ch)

priv fn build_jsonrpc_envelope($b: Json_builder, id_val: json.Value): json.Object_builder
    $obj: = b.obj().set("jsonrpc", b.str_val(jsonrpc.VERSION))
    switch id_val
    case .null_val
        obj = obj.set("id", b.null_val())
    default
        obj = obj.set("id", id_val)
    return obj

priv fn dump_and_send_val(val: json.Value)
    defer $body: = Str_builder.new()
    val.dump(body@)
    send_rpc_message(body.slice())

priv fn dump_and_send(obj: json.Object_builder)
    dump_and_send_val(obj.build())

fn send_response(id_val: json.Value, result: json.Value, arena: Arena$@)
    b: = Json_builder.new(arena)
    obj: = build_jsonrpc_envelope(b, id_val).set("result", result)
    dump_and_send(obj)

fn send_null_response(id_val: json.Value, arena: Arena$@)
    send_response(id_val, .null_val, arena)

fn send_error_response(id_val: json.Value, code: I32, msg: U8[], arena: Arena$@)
    $b: = Json_builder.new(arena)

    err_obj: = b.obj().set("code", b.int_val(code)).set("message", b.str_val(msg)).build()
    obj: = build_jsonrpc_envelope(b, id_val).set("error", err_obj)
    dump_and_send(obj)

fn send_diagnostics_list(uri: U8[], diags: List<|base_diag.Lsp_diagnostic|>$@)
    defer arena: = Arena.new(2 * 1024 * 1024)
    $b: = Json_builder.new(arena)

    defer $final_uri: = Str_builder.new()
    if !uri.has_kspl_ext()
        final_uri.s(uri).s(base_core.SOURCE_EXT)
    else
        final_uri.s(uri)

    $arr: = b.arr()
    local_uri: = final_uri.slice().strip_file_uri()

    if diags != null
        for d in diags
            // Caution: **Leave the same-file check to `base_locate`.** A diagnostic uses the file's
            // logical name and the LSP names a file by URI, so matching the names is not enough.
            if !base_locate.is_same_file(local_uri, d.file)
                continue

            sev: = d.severity.to_lsp_severity()
            $d_obj: = b.obj()
                .set("range", b.range(d.line, d.col, d.line, d.col + d.len))
                .set("severity", b.int_val(sev)).set("source", b.str_val("kspl"))
                .set("message", b.str_val(d.msg))

            is_unnecessary: =
                (d.severity == .hint &&
                (d.msg.starts_with("[H") || d.msg.starts_with("Unused "))) ||
                (d.severity == .warning &&
                (d.msg.starts_with("[W0207]") || d.msg.starts_with("[W0208]")))

            if is_unnecessary
                d_obj = d_obj.set("tags",
                    b.arr().push(b.int_val(TAG_UNNECESSARY)).build())

            arr = arr.push(d_obj.build())

    defer $safe_uri: = final_uri.slice().with_forward_slashes()

    params: = b.obj().set("uri", b.str_val(safe_uri.slice())).set("diagnostics", arr.build())
        .build()
    send_publish_diagnostics(b, params)
// ==========================================
// Private API
// ==========================================
priv fn send_publish_diagnostics($b: Json_builder, params: json.Value)
    msg_obj: = b.obj().set("jsonrpc", b.str_val(jsonrpc.VERSION))
        .set("method", b.str_val("textDocument/publishDiagnostics")).set("params", params).build()
    dump_and_send_val(msg_obj)

priv fn send_rpc_message(json_body: U8$[])
    defer $frame: = Str_builder.new()
    jsonrpc.frame_into(frame@, json_body)
    io.out().s(frame.slice())
    io.out().flush()
const WORKER_ALIVE_TAG: U8[] = "__KSPL_WORKER_ALIVE__" //< the tag of the liveness marker
const WORKER_DONE_TAG: U8[] = "__KSPL_WORKER_DONE__" //< the tag of the completion marker
const RESTORE_METHOD: U8[] = "$/ksplRestore" //<
    //< The notification a restarted worker gets each open document's text by, to hold unanalysed
    //< It passes between the supervisor and the worker only; no editor sends it. **Named here
    //< alone**, so the sender and the receiver cannot spell it apart.

fn send_worker_alive() //<
    //< It tells the supervisor the worker is alive, so long handling is not taken for a hang
    //< The supervisor's timeout is **per read** (worker_timeout_ms in server.kspl). Silent past
    //< it, even a live worker is killed, and the client gets a null. A real hang stops this output
    //< too.
    send_marker(WORKER_ALIVE_TAG)

fn send_worker_done() //<
    //< The marker an LSP worker sends to tell the supervisor it finished handling one message
    send_marker(WORKER_DONE_TAG)

fn marker_len(tag: U8[]): Sz //< how many bytes the marker for `tag` takes, its NULs included
    return tag.len + 2

fn marker_at(src: U8[], start: Sz, tag: U8[]): I32 //<
    //< Where the marker for `tag` (NUL, the tag, NUL) starts in `src`, from `start` on; -1 if none
    total: = marker_len(tag)
    for $i: Sz = start; i + total <= src.len; i += 1
        if src[i] == 0U8 && src[i + total - 1] == 0U8 &&
            src.sub(i + 1, tag.len).equals(tag)
            return I32::i
    return -1

priv fn send_marker(tag: U8[]) //< it writes the marker for `tag`
    //< NUL-separated, it never collides with the JSON output.
    defer $m: = Str_builder.new()
    m.c(0U8).s(tag).c(0U8)
    io.out().s(m.slice())
    io.out().flush()

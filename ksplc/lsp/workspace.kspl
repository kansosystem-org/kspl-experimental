//< LSP: walks the workspace and counts which sources belong to it
//<
//< **Every source file is collected** (`has_kspl_ext` in `../base/core.kspl`), or a file would
//< get no squiggles and no jumps though it is right there.
//< **It does not ask the client for the file list.** Other language servers find the files too
//< (rust-analyzer from `Cargo.toml`, clangd from `compile_commands.json`, gopls from `go list`).
//< A list from the client would only name candidates it reads anyway. **KSPL has no manifest
//< file** (an import resolves by a name from the root), so it walks.
//< **The root is the current working directory.**
import "ksplc/base/core" as base_core
import "ksplc/base/locate" as base_locate
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena, dealloc }
import "std/str"

const max_depth: Sz = 24 //< the limits on the walk's depth and file count
    //<
    //< **Both are needed**: a count limit alone never returns on a deep tree, a depth limit alone
    //< never on a wide one. They stop the walk before the supervisor's watchdog does.
const max_files: Sz = 20000

const ignore_file: U8[] = ".gitignore" //< the file naming the folders that are not source
    //<
    //< Caution: **Do not list the names to exclude here.** The build folder's name differs per
    //< project, so a list here would fit only this repository; `.gitignore` already names it.

fn workspace_kspl(arena: Arena$@): List<|U8[]|> //<
    //< It lists the sources under the root, by their paths relative to the root
    //<
    //< **It does not enter a folder whose name starts with a dot.** `.git` holds no source and is
    //< not in `.gitignore` either.
    $out: = List<|U8[]|>.new(arena)
    $skip: = read_ignored_dirs(arena)
    walk("", skip.slice(), 0, out@, arena)
    return out

fn holds(path: U8[], arena: Arena$@): Bool //<
    //< Whether the walk lists that file: a source under the root, in no folder the walk skips
    //<
    //< **It is where a rename may write** (`rename.kspl`): a file it does not list, such as an
    //< installed std or a package read from elsewhere, is a library the editor only reads.
    //< Caution: **Ask the walk's own rules** (`enters`, `takes`), or a rename writes into a folder
    //< the references never searched. The file-count limit alone is not asked.
    rest: = base_locate.rest_under(base_locate.canonical_path(path),
        base_locate.canonical_path(base_locate.cwd()))
    if rest.len == 0
        return false
    $skip: = read_ignored_dirs(arena)
    $at: Sz = 0
    $depth: Sz = 0
    for
        switch rest.sub_from(at).find_char('/')
        case .some(slash)
            if !enters(rest.sub(at, slash), rest.sub(0, at + slash), skip.slice())
                return false
            at += slash + 1
            depth += 1
        default
            return depth <= max_depth && takes(rest.sub_from(at))

priv fn takes(name: U8[]): Bool //< whether the walk lists a file of that name
    return name.len > 0 && name[0] != '.' && name.has_kspl_ext()

priv fn enters(name: U8[], dir: U8[], skip: U8[][]): Bool //<
    //< Whether the walk goes into the folder `dir`, named `name`
    //<
    //< Caution: **Do not descend through a link to a folder.** Two links to `.` make the walk visit
    //< 2^depth folders, and a link out of the workspace reads files nobody opened.
    return name.len > 0 && name[0] != '.' && !name.is_one_of(skip) && !fs.is_link(dir)

priv fn read_ignored_dirs(arena: Arena$@): List<|U8[]|> //<
    //< From `.gitignore`, it takes only the lines naming a folder
    //<
    //< Caution: **Do not read any other kind of line.** With negation, globs and per-folder
    //< overrides, a second resolver would **differ slightly from git's**. A file line (`*.exe`) is
    //< already dropped by the extension filter.
    $out: = List<|U8[]|>.new(arena)
    src: = io.read_file(ignore_file) catch U8$[]::{ .ptr = null, .len = 0 }
    if src.ptr == null
        return out
    defer dealloc(Void$@::src.ptr)
    text: U8[] = src
    for line in text.lines(arena)
        if name: = ignored_dir(line.trim_spaces())
            out.push(arena.dup_str(name))
    return out

priv fn ignored_dir(line: U8[]): U8[]? //< the folder the line names, if it names one
    $s: = line
    if s.len < 2 || s[0] == '#' || s[0] == '!'
        return .none
    if s[s.len - 1] != '/'
        return .none
    s = s.sub(0, s.len - 1)
    if s.len > 0 && s[0] == '/'
        s = s.sub_from(1)
    if s.len == 0 || s.find_char('/').is_some() || s.find_char('*').is_some() ||
        s.find_char('?').is_some() || s.find_char('[').is_some()
        return .none
    return .some(s)

priv fn walk(rel: U8[], skip: U8[][], depth: Sz, out: List<|U8[]|>$@, arena: Arena$@) //<
    //< It walks one level under `rel`
    //<
    //< **Do not stop on a folder that cannot be read** (vanished or forbidden); skip only that one.
    //< Caution: **Report progress for each entry.** One level can be slow on slow storage, and a
    //< silent walk gets killed by the supervisor's watchdog (`report_progress` rate-limits itself).
    if depth > max_depth
        return
    dir: = "." if rel.len == 0 else rel
    names: = fs.read_dir(dir, arena) catch _e
        return
    for name in names
        if out.len >= max_files
            return
        if name.len == 0 || name[0] == '.'
            continue
        base_core.report_progress()
        child: = name if rel.len == 0 else fs.join(rel, name, arena)
        info: = fs.stat(child) catch _e
            continue
        if info.kind == fs.File_kind.dir
            if enters(name, child, skip)
                walk(child, skip, depth + 1, out, arena)
        else if info.kind == fs.File_kind.file && takes(name)
            // A FIFO or a device by a source's name is not read: its read may never end.
            out.push(child)

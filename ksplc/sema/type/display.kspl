//< Turns a type into text to show a person
//< Caution: **Keep the knowledge of the surface notation in this file alone.** Mutability's marking
//< is reversed between the internal form (a postfix immut) and the surface (a `$` before the
//< sigil). So a stale copy shows a wrong type.
//< **A caller of these methods must import this file**, as with `sema/type/arc.kspl`.
import "ksplc/base/ast" as base_ast
import "ksplc/base/core" as base_core
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/chars"
import "std/str" { Str_builder }

priv const MAX_GENERIC_KEY_DEPTH: Sz = 8 //< the type-argument nesting written out in full
    //< A deeper argument is written `…`: a polymorphic recursion's instance nests far deeper, and
    //< its internal name would show past the limit. It also stops a key that reads back as
    //< containing itself.
priv const ELIDED_ARG: U8[] = "…" //< a type argument past max_generic_key_depth

impl sema_type_env.Env
    fn original_generic_name(r: Self$@, type_str: U8[]): U8[] //<
        //< Reads an internal type name from monomorphization back to its registration key
        //< For example `ds_List_I32` reads back as `List<|I32|>`.
        //< A full walk of the intern table, O(cap). **A caller that has the type id must not use
        //< it** — display_type_to reads the instance's record at O(1). This is for
        //< name-only callers (`display_str_named`, the LSP's completion).
        for entry in r.instantiated_nodes.items()
            if entry.value != null
                id_node: = entry.value.find_child(.k_identifier)
                if id_node != null && id_node.text.equals(type_str)
                    return entry.key
        return type_str

    priv fn expand_generic_key_to(r: Self$@, key: U8[], depth: Sz, w: Writer): Writer //<
        //< Writes an instance's registration key (`base<|actual arguments|>`) in source notation
        //< Caution: **The type arguments must not be copied as characters.** The key holds the
        //< internal form, and copying shows `List<|U8 immut[]|>` or
        //< `List<|std_ds_List_U8_Const_Slice|>`.
        $res: = w
        $i: Sz = 0
        for i < key.len
            if key.starts_with("<|", i)
                switch key.sub_from(i).find_generic_bounds()
                case .found(_start, _inner, inner_end, _end)
                    close: = i + inner_end
                    res = res.s("<|")
                    // The variance list is looked up by the base's name before the `<|`, **not by
                    // the name as written**, where `/` has become `.`.
                    mask: = r.variance_masks.get(key.sub(0, i)).unwrap_or(0)
                    res = r.display_generic_args_to(key.sub(i + 2, close - (i + 2)), mask, depth,
                        res)
                    res = res.s("|>")
                    i = close + 2
                case .not_found
                    res = res.c((key.ptr + i)$) // a broken key with no close; copied as characters
                    i += 1
                continue
            c: = (key.ptr + i)$
            res = res.c('.' if c == '/' || c == '\\' else c)
            i += 1
        return res

    priv fn display_generic_args_to(r: Self$@, args: U8[], mask: I32, depth: Sz, w: Writer): Writer //<
        //< Writes the actual arguments one at a time
        $res: = w
        for pos in Range.asc(args.count_type_args())
            if pos > 0
                res = res.s(", ")
            names_mut: = base_ast.variance_names_mut(mask, pos)
            res = r.display_generic_arg_to(args.nth_type_arg(pos), names_mut, depth, res)
        return res

    priv fn display_generic_arg_to(r: Self$@, arg: U8[], names_mut_pos: Bool, depth: Sz, w: Writer):
        Writer //<
            //< Writes one type argument in the surface notation.
            //< A registered type is sent to display_type_to.
            //< **At a position where the declaration declared mutability (`struct Box<|$T|>`),
            //< restore the mark here** (the surface reverses the internal marking).
        a: = arg.trim_spaces()
        id: = r.type_to_id.get(a).unwrap_or(0)
        $res: = w
        if names_mut_pos &&
            !(r.is_const(id) if id != 0 else a.ends_with(base_core.IMMUT_MARK))
            res = res.c('$')
        if depth >= MAX_GENERIC_KEY_DEPTH
            return res.s(ELIDED_ARG)
        if id != 0
            return r.display_type_to(id, depth + 1, res)
        return r.expand_generic_key_to(a, depth + 1, res)

    priv fn display_suffix_base_to(r: Self$@, id: I32, depth: Sz, w: Writer): Writer //<
        //< Writes the type a postfix applies to, a function type in brackets as it is written
        //< That is `(fn(I32):I32)@`, not a function returning `I32@`.
        switch r.get_info(id)
        case .fn_type
            return r.display_type_to(id, depth, w.c('(')).c(')')
        default
            return r.display_type_to(id, depth, w)

    priv fn display_type_to(r: Self$@, id: I32, depth: Sz, w: Writer): Writer //<
        //< Writes a type out in KSPL's surface notation
        //< Unmarked is immutable, a `$` before the sigil mutable (`U8[]` / `U8$[]` / `U8$@`). depth
        //< counts round trips through a generic key, not structural recursion.
        if id < 0 || id >= r.id_to_type.len
            return w.s(base_core.UNKNOWN_TYPE_NAME)
        $res: = w
        switch r.get_info(id)
        case .pointer(b)
            res = r.display_suffix_base_to(r.strip_const(b), depth, res)
            return res.s("@" if r.is_const(b) else "$@")
        case .array(b, s)
            res = r.display_suffix_base_to(r.strip_const(b), depth, res)
            if !r.is_const(b)
                res = res.s("$")
            return res.s("[\{s\}]") if s >= 0 else res.s("[_]")
        case .fn_type(sig)
            res = res.s("fn(")
            for i in Range.asc(sig.params.len)
                if i > 0
                    res = res.c(',')
                res = r.display_type_to(sig.params.get(i), depth, res)
            res = res.s("):")
            return r.display_type_to(sig.ret_id, depth, res)
        case .const_of(b)
            // An immutable view descriptor (what `U8$[]@` points at) or a bare immutable value:
            // both are unmarked, so the base is written as is (the enclosing `@` writes `$@`).
            return r.display_type_to(b, depth, res)
        default
            // An instance of `Slice<|T|>` was written `T[]`.
            // Caution: **Write it in the sugared form**, or the diagnostic shows a type name the
            // user did not write (`../../parse/desugar_slice.kspl`). The mark follows the
            // element's immutability, as in the `.slice(b)` arm above.
            slice_elem: = r.slice_struct_elem(id)
            if slice_elem != 0
                res = r.display_type_to(r.strip_const(slice_elem), depth, res)
                return res.s("[]" if r.is_const(slice_elem) else "$[]")
            // An instance of `Option<|T|>` was written `T?`; a result inside it is bracketed,
            // since `T!E?` reads as `T!(E?)`.
            real_id: = r.get_clean_real_type(id)
            if r.instance_base(real_id).equals(base_core.OPTION_FQN)
                inner: = r.instance_arg(real_id, 0)
                if r.is_result(inner)
                    return r.display_type_to(inner, depth, res.c('(')).s(")?")
                return r.display_suffix_base_to(inner, depth, res).s("?")
            // An instance of `Result<|T, E|>` was written `T!E`. **Always write the error type**
            // (there is no `T!` shorthand); a result on the value's side is bracketed, since
            // `A!B!E` reads as `A!(B!E)`.
            if r.is_result(real_id)
                ok_id: = r.instance_arg(real_id, 0)
                if r.is_result(ok_id)
                    res = r.display_type_to(ok_id, depth, res.c('(')).c(')')
                else
                    res = r.display_suffix_base_to(ok_id, depth, res)
                return r.display_type_to(r.instance_arg(real_id, 1), depth, res.c('!'))
            // An instantiated type is written from its record, found by type_id (not the O(cap)
            // walk by name).
            // Caution: **Do not resolve an alias before writing.** An alias is exactly the name the
            // user wrote (the `Names` of `typedef Names = List<|U8[]|>;`).
            if inst: = r.instance_of(id)
                return r.display_instance_to(inst, depth, res)
            return r.expand_generic_key_to(r.get_str(id), depth, res)

    priv fn display_instance_to(r: Self$@, inst: sema_type_env.Instance, depth: Sz, w: Writer):
        Writer //<
            //< Writes an instance as its template and type arguments, in source notation
            //< Caution: **Write each type argument as a type**, not its internal name, or it shows
            //< `List<|U8 immut[]|>` or `List<|std_ds_List_U8_Const_Slice|>`.
        $res: = w.s(inst.template).s("<|")
        mask: = r.variance_masks.get(inst.template).unwrap_or(0)
        for pos in Range.asc(inst.args.len)
            if pos > 0
                res = res.s(", ")
            id: = inst.args[pos]
            if base_ast.variance_names_mut(mask, pos) && !r.is_const(id)
                res = res.c('$')
            if depth < MAX_GENERIC_KEY_DEPTH
                res = r.display_type_to(id, depth + 1, res)
            else
                res = res.s(ELIDED_ARG)
        return res.s("|>")

    fn display_str(r: Self$@, id: I32): Str_builder
        b: = Str_builder()
        r.display_type_to(id, 0, b)
        return b

    fn display(r: Self$@, id: I32): U8[] //< a type's display text, on the compilation's arena
        //< For a diagnostic, which needs nothing freed; `display_str` when the text is built on.
        b: = base_core.arena.text()
        r.display_type_to(id, 0, b)
        return b.take()

    fn display_key(r: Self$@, key: U8[]): U8[] //<
        //< A registration key in source notation, on the compilation's arena
        //< For a function instance's key (`app.f<|app.P|>`), which no type id stands for.
        b: = base_core.arena.text()
        r.expand_generic_key_to(key, 0, b)
        return b.take()

    fn display_str_named(r: Self$@, name: U8[]): Str_builder //<
        //< The display text from a name rather than a type id
        //< For callers holding no type id (a struct field's parent type name).
        //< Caution: Do not duplicate the notation logic here. Pass a found id to display_type_to.
        b: = Str_builder()
        id: = r.type_to_id.get(name).unwrap_or(0)
        if id != 0
            r.display_type_to(id, 0, b)
            return b
        // Not registered as a type: only what the read-back by name finds is corrected.
        r.expand_generic_key_to(r.original_generic_name(name), 0, b)
        return b

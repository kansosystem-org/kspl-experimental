//< The symbol table: from a name to what it declares, through the nested scopes
//<
//< A `Sema_symbol` is one declared name: its kind, its visibility, its flags and its declaration
//< node. A name is looked up in the local scopes from the innermost, then in the current file's own
//< declarations. Then it is looked up in the other files' `pub` ones. `resolve_fqn` finds one by
//< its FQN alone.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/core" as base_core
import "std/ds" { List, Map }

enum Sym_kind
    variable
    function(is_variadic: Bool)
    struct_def
    constant
    generic_struct
    generic_fn
    enum_def
    enum_variant(tag_value: I64)
    alias_def
    trait_def
    generic_trait
    generic_enum

enum Visibility: I32 //< the three levels of visibility
    //<
    //< **`internal` (the default) stays inside the package** (`base_locate.package_of`);
    //< `file_private` is `priv`, `public` is `pub`. The numbers are declaration order, not width
    //< (that is `vis_rank` in `sema/decl/access.kspl`).
    internal = 0
    file_private = 1
    public = 2

struct Sym_flags
    is_mut: Bool
    is_method: Bool
    is_inline: Bool
    is_deprecated: Bool
    is_ext: Bool
    is_generated_instance: Bool //< generated by a generic's monomorphization (not "is it generic")
    is_body_queued: Bool //<
        //< Whether the instantiated body was pushed onto the inference queue.
        //<
        //< **Push it twice and the return type breaks**: the first inference reshapes the body
        //< (`result_wrap`), and a second leaves no type (`auto` in the C). Both the call position
        //< and the method table push it, in no fixed order (queue_fn_body in sema/decl/mono.kspl).
    is_global: Bool
    holds_frame_pointer: Bool //<
        //< Whether a local was set from a slice or an interface value pointing into its frame
        //<
        //< note_frame_pointer in sema/body/stmt_escape.kspl sets it; returning the local, or
        //< storing it where it outlives the frame, is refused.
    holds_frame_address: Bool //<
        //< Whether a local was set from a written `@` of its frame's storage
        //<
        //< note_frame_pointer sets it too; returning or throwing the local is refused, storing it
        //< is not.
    is_used: Bool
    is_used_outside_unit: Bool //<
        //< Whether it was referenced from outside its own package.
        //<
        //< [I0402] (`pub` is used only inside the unit) looks at this.
        //< Caution: **Set it before the visibility check**; an exempt path skips the check, not the
        //< fact.
    is_export: Bool
    is_premangled: Bool //<
        //< Whether it is a symbol lower synthesized, already named in final form ("kspl_...")
        //<
        //< Such a symbol is a trait thunk, a vtable constant or an ARC drop glue. Do not reuse
        //< is_export: it also means "by the C ABI", and genllvm drops an aggregate's sret/byval on
        //< it. Principle 5 of docs/DESIGN-principles.md applies: one option with two meanings
        //< silently breaks one side.

struct Sema_symbol
    kind: Sym_kind
    name: U8[]
    node: Ast_node$@
    type_id: I32
    vis: Visibility
    flags: Sym_flags
    hidden_count: I32 //< how many locals of its name it hides, a parameter included
        //<
        //< define_symbol counts it. The ABI pass gives such a local a C name of its own
        //< (`hiding_local_name` in `ksplc/base/c_name.kspl`). In C, a declaration's own initializer
        //< already sees the new name, so `x: = x + 1` would read itself.

struct File_env
    file_name: U8[]
    symbols: Map<|U8[], Sema_symbol$@|>$@

struct Symbol_table
    global_scope: Map<|I32, Sema_symbol$@|>$@
    by_fqn: Map<|U8[], Sema_symbol$@|>$@ //<
        //< A table looked up directly by an FQN string, independent of current_file
        //<
        //< It serves tools like the LSP; global_scope is keyed by interned id and filtered by
        //< visibility.
    scope_stack: List<|Map<|I32, Sema_symbol$@|>$@|>$@
    current_file: File_env$@

impl Sym_kind
    fn is_type(r: Self$@): Bool
        switch r$
        case .struct_def, .generic_struct, .enum_def, .alias_def, .trait_def, .generic_trait,
            .generic_enum
            return true
        default
            return false
    fn is_generic_type(r: Self$@): Bool //<
        //< a generic type's template, named without type arguments
        switch r$
        case .generic_struct, .generic_trait, .generic_enum
            return true
        default
            return false
    fn is_value(r: Self$@): Bool
        switch r$
        case .variable, .constant
            return true
        case .function(_v)
            return true
        default
            return false
    fn is_var_or_const(r: Self$@): Bool
        switch r$
        case .variable, .constant
            return true
        default
            return false
    fn is_function(r: Self$@): Bool
        switch r$
        case .function(_v)
            return true
        default
            return false
    fn names_function(r: Self$@): Bool //< a function, or a generic function's template
        switch r$
        case .function(_v)
            return true
        case .generic_fn
            return true
        default
            return false
    fn is_enum(r: Self$@): Bool
        switch r$
        case .enum_def
            return true
        default
            return false
    fn is_alias(r: Self$@): Bool
        switch r$
        case .alias_def
            return true
        default
            return false

impl Symbol_table
    fn new(global_scope: Map<|I32, Sema_symbol$@|>$@): Symbol_table$@
        by_fqn: = base_core.arena
            .create(Map<|U8[], Sema_symbol$@|>.new(base_core.arena))
        scope_stack: = base_core.arena
            .create(List<|Map<|I32, Sema_symbol$@|>$@|>.new(null))
        return base_core.arena
            .create(Symbol_table::{ .global_scope = global_scope, .current_file = null,
            .by_fqn = by_fqn, .scope_stack = scope_stack })

    fn free(r: Self$@)
        for scope in r.scope_stack
            scope.free()
        r.scope_stack.free()

    fn resolve(r: Self$@, name: U8[]): Sema_symbol$@? //< what `name` names in scope, marked used
        if sym: = r.peek(name)
            sym.flags.is_used = true
            return .some(sym)
        return .none

    fn peek(r: Self$@, name: U8[]): Sema_symbol$@? //<
        //< What `name` names in scope, found as `resolve` finds it, **not setting the used flag**
        //<
        //< For a question asked before the analysis decides how a name is read: if marked, a name
        //< only asked about counts as used ([W0206], [W0207]).
        id: = base_core.pools.intern_name(name)
        if local: = r.peek_local(id)
            return .some(local)
        // On the same name, this file's own top-level declaration (any visibility) beats another
        // file's pub one: current_file holds them all unfiltered.
        if r.current_file != null
            own: = r.current_file.symbols.get(name).unwrap_or(null)
            if own != null
                return .some(own)
        global: = r.global_scope.get(id).unwrap_or(null)
        if global != null
            return .some(global)
        return .none

    priv fn peek_local(r: Self$@, id: I32): Sema_symbol$@? //< the innermost local named id
        for $i: = r.scope_stack.len; i > 0; i -= 1
            local: = r.scope_stack.get(i - 1).get(id).unwrap_or(null)
            if local != null
                return .some(local)
        return .none

    fn resolve_fqn(r: Self$@, fqn: U8[]): Sema_symbol$@? //<
        //< Looks up a symbol directly from an FQN string, regardless of current_file's state
        //<
        //< Unlike resolve() it does not filter by visibility (for compiler internals and LSP
        //< tools).
        return r.by_fqn.get(fqn)

    fn enter_scope(r: Self$@)
        new_scope: = Map<|I32, Sema_symbol$@|>.new(base_core.arena)
        r.scope_stack.push(base_core.arena.create(new_scope))

    fn exit_scope(r: Self$@)
        len: = r.scope_stack.len
        if len > 0
            r.scope_stack.get(len - 1).free()
            r.scope_stack.len = len - 1

    fn has_in_current_scope(r: Self$@, name: U8[]): Bool
        if r.scope_stack.len == 0
            return r.current_file != null && r.current_file.symbols.get(name).is_some()
        id: = base_core.pools.intern_name(name)
        scope: = r.scope_stack.get(r.scope_stack.len - 1)
        return scope.get(id).is_some()

    fn define_symbol(r: Self$@, name: U8[], sym: Sema_symbol$@, export_global: Bool)
        id: = base_core.pools.intern_name(name)
        if r.scope_stack.len == 0
            sym.flags.is_global = true
            if r.current_file != null
                r.current_file.symbols.set(name, sym)
            if export_global
                // With export_global true, name is always the symbol's true FQN.
                r.by_fqn.set(name, sym)
                if sym.vis != Visibility.file_private
                    r.global_scope.set(id, sym)
        else
            if outer: = r.peek_local(id)
                sym.hidden_count = outer.hidden_count + 1
            scope: = r.scope_stack.get(r.scope_stack.len - 1)
            scope.set(id, sym)
        if sym.node != null
            sym.node.sym_ptr = Void$@::sym

impl Sema_symbol
    fn new(kind: Sym_kind, name: U8[], node: Ast_node$@): Sema_symbol$@
        return base_core.arena
            .create(Sema_symbol::{
            .kind = kind,
            .name = name,
            .node = node,
            .vis = .internal, // kept short by omitting the zero initialization
            .flags = Sym_flags::{ .is_mut = true }
        })

    fn get_defined_in(r: Self$@): U8[]
        if r != null && r.node != null
            return r.node.loc.file()
        return ""

    fn uses_verbatim_c_name(r: Self$@): Bool //<
        //< Whether it is a symbol emitted into C's namespace under its own name, unmangled
        return r.flags.is_ext || r.flags.is_export || r.flags.is_premangled

    fn uses_c_abi(r: Self$@): Bool //<
        //< Whether the symbol passes arguments and return values by the C ABI
        //<
        //< That is a function called from C, or one calling C.
        //< Only when this is false may genllvm use the internal ABI (an aggregate's sret/byval).
        return r.flags.is_ext || r.flags.is_export

    fn has_program_unique_c_name(r: Self$@): Bool //<
        //< whether the C name is **unique program-wide**
        //<
        //< A method is unique by the type's FQN, which carries its file's path; sema rejects two
        //< files adding one method name to one type. An instantiation is unique by its arguments.
        //< The decision and other languages' approaches are in "Visibility and linkage are separate
        //< axes" in `../../../docs/DESIGN-programming-language.md`.
        return r != null && (r.flags.is_method || r.flags.is_generated_instance)
    fn apply_attributes(r: Self$@)
        if r == null || r.node == null
            return
        if r.node.has_attribute("inline")
            r.flags.is_inline = true
        if r.node.has_attribute("deprecated")
            r.flags.is_deprecated = true
        if r.node.has_attribute("export")
            r.flags.is_export = true

impl File_env
    fn new(file_name: U8[]): File_env$@
        symbols: = base_core.arena
            .create(Map<|U8[], Sema_symbol$@|>.new_with_cap(128, null))
        return base_core.arena.create(File_env::{ .file_name = file_name, .symbols = symbols })
    fn free(r: Self$@)
        r.symbols.free()

impl Ast_node
    fn get_visibility(r: Ast_node$@): Visibility
        if r == null
            return .internal
        if r.has_keyword("pub")
            return .public
        if r.has_keyword("priv")
            return .file_private

        attr_list: = r.find_child(.k_attribute_list)
        return (.public if attr_list != null && attr_list.has_keyword("pub")
            else .file_private if attr_list != null && attr_list.has_keyword("priv") else .internal)
    fn has_explicit_visibility(r: Ast_node$@): Bool //<
        //< whether the visibility is stated explicitly
        //<
        //< get_visibility returns `internal` when unspecified too; this tells whether one was
        //< written (for inheriting a trait's visibility onto its methods).
        if r == null
            return false
        if r.has_keyword("pub") || r.has_keyword("priv")
            return true
        attr_list: = r.find_child(.k_attribute_list)
        return attr_list != null &&
            (attr_list.has_keyword("pub") || attr_list.has_keyword("priv"))

// It releases what it owns with `free()`; see `Manual_free` in std/lang.kspl for why it conforms.
impl Symbol_table: Manual_free {}
impl File_env: Manual_free {}

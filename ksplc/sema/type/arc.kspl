//< Classifies shared ownership (ARC), release tracking and ownership moves
//< An extension to `Env` in `sema/type/env.kspl`; it does not hold the type table itself.
//< Caution: **The decision here (`type_has_arc_content` / `type_is_managed`) and the emission in
//< `lower/arc.kspl` (`emit_managed_op`) must always change together.** Fix only one and it breaks
//< silently: a retain without its release, or the reverse ("The rules for implementing ARC" in
//< `ksplc/docs/DESIGN-lower.md`). **A caller of these methods must import this file** (importing
//< `sema/type/env` alone does not add them to Env).
import "ksplc/base/core" as _base_core // `fqn_head` / `fqn_last`
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/ds" { List, Map }
import "std/io"
import "std/str"
import "std/sys"

// A walk's memo holds, per type, one of these; a type it holds nothing for is not decided yet.
priv const MEMO_NO: I32 = 1 //< decided: it does not
priv const MEMO_YES: I32 = 2 //< decided: it does

priv const MAX_MOVE_ONLY_DEPTH: Sz = 1000 //<
    //< The safety limit on the recursion depth of is_move_only's structural derivation
    //< Memoization collapses repeat visits, so the depth is the chain of *distinct* embedded types
    //< (struct S1{f:S2}, struct S2{f:S3}, ...). No node is available for a diagnostic, so, like
    //< max_mangle_depth, it stops with io.err() + sys.exit(1).

priv const ARC_TRAIT_FQN: U8[] = "std.lang.Ref_counted" //<
    //< The FQNs of the traits the compiler knows
    //< Each means this declaration alone, not a same-named other (see is_arc_type).
priv const MOVE_ONLY_TRAIT_FQN: U8[] = "std.lang.Move_only"
priv const MANUAL_FREE_TRAIT_FQN: U8[] = "std.lang.Manual_free"

fn shadowed_known_trait(trait_fqn: U8[]): U8[] //<
    //< The known trait (listed above) that trait_fqn only shares a name with, or empty
    //< Such a trait is a different declaration with the same name.
    //< Returns empty if there are none. **Only these three are looked at**: a same-named operator
    //< trait errors on its own, but these three, matched by FQN, would silently stop working.
    known: U8[][3] = ::{ ARC_TRAIT_FQN, MOVE_ONLY_TRAIT_FQN, MANUAL_FREE_TRAIT_FQN }
    own_simple: = trait_fqn.fqn_last()
    for k in known
        if trait_fqn.equals(k)
            continue
        if own_simple.equals(k.fqn_last())
            return k
    return ""

impl sema_type_env.Env
    fn is_raw_value(r: Self$@, type_id: I32): Bool //< the memory helpers' uninitialized storage
        return r.instance_base(r.get_clean_real_type(type_id)).equals("std.mem.Raw_value")

    fn is_arc_type(r: Self$@, type_id: I32): Bool //<
        //< Whether the type_id itself is ARC-managed
        //< That is a struct conforming to Ref_counted in std/mem.kspl.
        //< Decided strictly by the declaration's FQN. A match on the name's last part would let any
        //< trait named `Ref_counted` turn ARC on, doubling a hand-kept count into a use-after-free
        //< with no diagnostic.
        if type_id <= 0
            return false
        // Caution: Strip the immutable qualifier first. `const_of(Rc<|T|>)` (an immutable array's
        // element) is not seen as a struct, and no retain/release would be inserted.
        bare: = r.get_clean_real_type(type_id)
        $is_struct: = false
        switch r.get_info(bare)
        case .struct_type
            is_struct = true
        default {}
        if !is_struct
            return false
        return r.has_implemented_trait_fqn(bare, ARC_TRAIT_FQN)

    priv fn owned_parts(r: Self$@, real_id: I32, out: List<|I32|>$@) //<
        //< The types of the positions a value of real_id owns, one level down
        //< They are a struct's fields, every variant's payloads, and an array's element (a
        //< zero-length array owns none). They are also a Result's success payload (its error side
        //< is an error enum's tag). A pointer or a slice borrows. A scalar, a trait value or a
        //< function pointer holds no part.
        //< Caution: **ARC and Move_only both walk this one list.** A position only one knows is
        //< released without being copied safely, or copied without its release.
        if r.is_pointer(real_id) || r.is_slice(real_id)
            return
        switch r.get_info(real_id)
        case .struct_type(def)
            for f in def.fields_list
                out.push(f.type_id)
        case .enum_type(def)
            for v in def.variants_list
                for f in v.payload_fields
                    out.push(f.type_id)
        case .array(base_id, size)
            if size > 0
                out.push(base_id)
        default {}

    fn type_has_arc_content(r: Self$@, type_id: I32): Bool //<
        //< True if what the type owns as a value holds an ARC-managed type, directly or nested
        //< Only owning positions are walked (`owned_parts`). Miss one and lower/arc.kspl inserts
        //< no retain/release and the value leaks (the rules are named in this file's header).
        defer $resolving: = List<|I32|>(null)
        // Caution: **If the shared memo is set, always use it** (when it is set is described on the
        // declaration in sema/type/env.kspl). Lower asks per owning position, so rebuilding it per
        // call is quadratic in the chain's depth.
        if r.arc_content_memo != null
            return r.type_has_arc_content_impl(type_id, r.arc_content_memo, resolving@)
        defer $memo: = Map<|I32, I32|>(null)
        return r.type_has_arc_content_impl(type_id, memo@, resolving@)

    priv fn type_has_arc_content_impl(r: Self$@, type_id: I32, memo: Map<|I32, I32|>$@,
        resolving: List<|I32|>$@): Bool //<
            //< Whether type_id holds an ARC-managed type as a value field, at any depth
            //< Caution: **Do not remove the memoization** (type_id -> memo_no / memo_yes). One type
            //< is referenced from several fields, so cycle detection alone leaves fanout^d time.
            //< **Nor add a depth limit**, which would take away calc_type_layout's diagnostic on a
            //< legitimate chain.
        if type_id <= 0
            return false
        // The immutable qualifier is stripped for the same reason as in is_arc_type.
        real_id: = r.get_clean_real_type(type_id)
        if r.is_raw_value(real_id)
            return false
        cached: = memo.get(real_id).unwrap_or(0)
        if cached == MEMO_NO
            return false
        if cached == MEMO_YES
            return true
        for seen_id in resolving
            if seen_id == real_id
                return false
        resolving.push(real_id)
        $found: = false
        defer $parts: = List<|I32|>(null)
        r.owned_parts(real_id, parts@)
        for part in parts
            if r.owns_arc_content_impl(part, memo, resolving)
                found = true
                break
        resolving.len -= 1
        memo.set(real_id, MEMO_YES if found else MEMO_NO)
        return found

    priv fn owns_arc_content_impl(r: Self$@, type_id: I32, memo: Map<|I32, I32|>$@,
        resolving: List<|I32|>$@): Bool //<
            //< The decision for one owning position (managed itself, or holding one inside).
        return r.is_arc_type(type_id) ||
            r.type_has_arc_content_impl(type_id, memo, resolving)

    fn type_is_managed(r: Self$@, type_id: I32): Bool //<
        //< Whether it gets automatic retain/release
        //< That is an ARC-managed type itself, or an aggregate owning one by value.
        return r.is_arc_type(type_id) || r.type_has_arc_content(type_id)

    fn has_release_contract(r: Self$@, target_id: I32): Bool //<
        //< Whether target_id is a type that owns an instance and releases it with `free()`
        //< True where there is an explicit impl for `std.lang.Manual_free`. It is **not derived
        //< from fields**, as Move_only is: an owning part alone does not promise that the
        //< containing type has `free()` (`Sema_ctx` holds a `Str_builder`).
        return r.has_implemented_trait_fqn(r.strip_ptr_full(target_id), MANUAL_FREE_TRAIT_FQN)

    fn is_move_only(r: Self$@, target_id: I32): Bool //<
        //< Whether target_id is Move_only (implicit copying forbidden)
        //< True where there is an explicit impl for `std.lang.Move_only`. Where there is none it
        //< is derived from what the type owns (derives_move_only below).
        defer $memo: = Map<|I32, I32|>(null)
        defer $resolving: = List<|I32|>(null)
        return r.derives_move_only(target_id, memo@, resolving@, 0)

    priv fn derives_move_only(r: Self$@, target_id: I32, memo: Map<|I32, I32|>$@,
        resolving: List<|I32|>$@, depth: Sz): Bool //<
            //< Whether target_id is Move_only by its own impl or by what it owns
            //< The positions walked are `owned_parts`' ("Worked example: forbidding copies with
            //< `Move_only`" in docs/SPEC-programming-language.md). **Keep the memo and break cycles
            //< with resolving**, as type_has_arc_content_impl does.
        cached: = memo.get(target_id).unwrap_or(0)
        if cached == MEMO_NO
            return false
        if cached == MEMO_YES
            return true
        // A pointer or a slice is a borrowed view; copying it adds no release duty.
        if r.is_pointer(target_id) || r.is_slice(target_id)
            memo.set(target_id, MEMO_NO)
            return false
        if r.has_implemented_trait_fqn(target_id, MOVE_ONLY_TRAIT_FQN)
            memo.set(target_id, MEMO_YES)
            return true
        for seen_id in resolving
            if seen_id == target_id
                return false
        if depth >= MAX_MOVE_ONLY_DEPTH
            io.err()
                .s("\nfatal: value nesting too deep while deriving a structural marker. A recursive \
                    chain of embedded values may be unbounded.\n")
            sys.exit(1)
        resolving.push(target_id)

        $derived: = false
        defer $parts: = List<|I32|>(null)
        r.owned_parts(r.get_real_type(target_id), parts@)
        for part in parts
            if r.derives_move_only(part, memo, resolving, depth + 1)
                derived = true
                break
        resolving.len -= 1
        memo.set(target_id, MEMO_YES if derived else MEMO_NO)
        return derived

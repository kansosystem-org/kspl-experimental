import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/core" as base_core
import "std/ds" + { List, Map }

enum Sym_kind
  variable
  function(is_variadic: Bool)
  struct_def
  constant
  generic_struct
  generic_fn
  enum_def
  enum_variant(tag_value: I32)
  alias_def
  trait_def
  generic_trait
  generic_enum

enum Visibility: I32 //< the three levels of visibility
  //<
  //< **`internal` (the default) stays inside the package** (`base_locate.package_of`);
  //< `file_private` is `priv`, `public` is `pub`. The numbers are declaration order, not width
  //< (that is `vis_rank` in `sema/decl/access.kspls`).
  internal = 0
  file_private = 1
  public = 2

struct Sym_flags
  is_mut: Bool
  is_method: Bool
  is_inline: Bool
  is_deprecated: Bool
  is_ext: Bool
  is_generated_instance: Bool //< generated by a generic's monomorphization (not "is it generic")
  is_body_queued: Bool //<
    //< Whether the instantiated body was pushed onto the inference queue.
    //<
    //< **Push it twice and the return type breaks**: the first inference reshapes the body
    //< (`result_wrap`), and a second leaves no type (`auto` in the C). Both the call position and
    //< the method table push it, in no fixed order (queue_fn_body in sema/decl/mono.kspls).
  is_global: Bool
  is_used: Bool
  is_used_outside_unit: Bool //<
    //< Whether it was referenced from outside its own package.
    //<
    //< [I0402] (`pub` is used only inside the unit) looks at this.
    //< Caution: **Set it before the visibility check**; an exempt path skips the check, not the
    //< fact.
  is_export: Bool
  is_premangled: Bool //<
    //< Whether it is a symbol lower synthesized, already named in final form ("kspl_...")
    //<
    //< Such a symbol is a trait thunk, a vtable constant or an ARC drop glue. Do not reuse
    //< is_export: it also means "by the C ABI", and genllvm drops an aggregate's sret/byval on it
    //< (Principle 5 of docs/DESIGN.md: one option with two meanings silently breaks one side).

struct Sema_symbol
  kind: Sym_kind
  name: U8[]
  node: Ast_node$@
  type_id: I32
  vis: Visibility
  flags: Sym_flags

struct File_env
  file_name: U8[]
  symbols: Map<|U8[], Sema_symbol$@|>$@

struct Symbol_table
  global_scope: Map<|I32, Sema_symbol$@|>$@
  by_fqn: Map<|U8[], Sema_symbol$@|>$@ //<
    //< A table looked up directly by an FQN string, independent of current_file
    //<
    //< It serves tools like the LSP; global_scope is keyed by interned id and filtered by
    //< visibility.
  scope_stack: List<|Map<|I32, Sema_symbol$@|>$@|>$@
  current_file: File_env$@

impl Sym_kind
  fn is_type(r: Self$@): Bool
    switch r$ case .struct_def, .generic_struct, .enum_def, .alias_def, .trait_def, .generic_trait,
      .generic_enum
      return true
    default
      return false
  fn is_value(r: Self$@): Bool
    switch r$ case .variable, .constant
      return true
    case .function(_v)
      return true
    default
      return false
  fn is_var_or_const(r: Self$@): Bool
    switch r$ case .variable, .constant
      return true
    default
      return false
  fn is_function(r: Self$@): Bool
    switch r$ case .function(_v)
      return true
    default
      return false
  fn is_enum(r: Self$@): Bool
    switch r$ case .enum_def
      return true
    default
      return false
  fn is_alias(r: Self$@): Bool
    switch r$ case .alias_def
      return true
    default
      return false

impl Symbol_table
  fn new(global_scope: Map<|I32, Sema_symbol$@|>$@): Symbol_table$@
    by_fqn: = base_core.arena.create(Map<|U8[], Sema_symbol$@|>.new(base_core.arena))
    scope_stack: = base_core.arena.create(List<|Map<|I32, Sema_symbol$@|>$@|>.new())
    return base_core.arena
      .create(Symbol_table::{ .global_scope = global_scope, .current_file = null, .by_fqn = by_fqn,
      .scope_stack = scope_stack })

  fn free(r: Self$@)
    for scope in r.scope_stack
      scope.free()
    r.scope_stack.free()

  fn resolve(r: Self$@, name: U8[]): Sema_symbol$@?ds.Ds_error
    if sym: = r.peek(name)
      sym.flags.is_used = true
      return sym
    throw ds.Ds_error.key_not_found

  fn peek(r: Self$@, name: U8[]): Option<|Sema_symbol$@|> //<
    //< What `name` names in scope, found as `resolve` finds it, **without setting the used flag**
    //<
    //< For a question asked before the analysis decides how a name is read: if marked, a name only
    //< asked about counts as used ([W0206], [W0207]).
    id: = base_core.pools.intern_name(name)
    for $i: = r.scope_stack.len; i > 0; i -= 1
      local: = r.scope_stack.get(i - 1).get(id) catch null
      if local != null
        return Option<|Sema_symbol$@|>.some(local)
    // On the same name, this file's own top-level declaration (any visibility) beats another
    // file's pub one: current_file holds them all unfiltered.
    if r.current_file != null
      own: = r.current_file.symbols.get(name) catch null
      if own != null
        return Option<|Sema_symbol$@|>.some(own)
    global: = r.global_scope.get(id) catch null
    if global != null
      return Option<|Sema_symbol$@|>.some(global)
    return Option<|Sema_symbol$@|>.none

  fn resolve_fqn(r: Self$@, fqn: U8[]): Sema_symbol$@?ds.Ds_error //<
    //< Looks up a symbol directly from an FQN string, regardless of current_file's state
    //<
    //< Unlike resolve() it does not filter by visibility (for compiler internals and LSP tools).
    return r.by_fqn.get(fqn)

  fn enter_scope(r: Self$@)
    new_scope: = Map<|I32, Sema_symbol$@|>.new(base_core.arena)
    r.scope_stack.push(base_core.arena.create(new_scope))

  fn exit_scope(r: Self$@)
    len: = r.scope_stack.len
    if len > 0
      r.scope_stack.get(len - 1).free()
      r.scope_stack.len = len - 1

  fn has_in_current_scope(r: Self$@, name: U8[]): Bool
    if r.scope_stack.len == 0
      return r.current_file != null &&
        (r.current_file.symbols.get(name) catch null) != null
    id: = base_core.pools.intern_name(name)
    scope: = r.scope_stack.get(r.scope_stack.len - 1)
    return (scope.get(id) catch null) != null

  fn define_symbol(r: Self$@, name: U8[], sym: Sema_symbol$@, export_global: Bool)
    id: = base_core.pools.intern_name(name)
    if r.scope_stack.len == 0
      sym.flags.is_global = true
      if r.current_file != null
        r.current_file.symbols.set(name, sym)
      if export_global
        // With export_global true, name is always the symbol's true FQN.
        r.by_fqn.set(name, sym)
        if sym.vis != Visibility.file_private
          r.global_scope.set(id, sym)
    else
      scope: = r.scope_stack.get(r.scope_stack.len - 1)
      scope.set(id, sym)
    if sym.node != null
      sym.node.sym_ptr = Void$@::sym

impl Sema_symbol
  fn new(kind: Sym_kind, name: U8[], node: Ast_node$@): Sema_symbol$@
    return base_core.arena
      .create(Sema_symbol::{
      .kind = kind,
      .name = name,
      .node = node,
      .vis = Visibility.internal, // kept short by omitting the zero initialization
      .flags = Sym_flags::{ .is_mut = true }
    })

  fn get_defined_in(r: Self$@): U8[]
    if r != null && r.node != null
      return r.node.loc.file()
    return ""

  fn uses_verbatim_c_name(r: Self$@): Bool //<
    //< Whether it is a symbol emitted into C's namespace under its own name, unmangled
    return r.flags.is_ext || r.flags.is_export || r.flags.is_premangled

  fn uses_c_abi(r: Self$@): Bool //<
    //< Whether the symbol passes arguments and return values by the C ABI
    //<
    //< That is a function called from C, or one calling C.
    //< Only when this is false may genllvm use the internal ABI (an aggregate's sret/byval).
    return r.flags.is_ext || r.flags.is_export

  fn has_program_unique_c_name(r: Self$@): Bool //< whether the C name is **unique program-wide**
    //<
    //< A method is unique by the type's FQN (which carries its file's path; sema rejects two files
    //< adding one method name to one type), an instantiation by its arguments. The decision and
    //< other languages' approaches are in "Visibility and linkage are separate axes" in
    //< `../../../docs/DESIGN.md`.
    return r != null && (r.flags.is_method || r.flags.is_generated_instance)
  fn apply_attributes(r: Self$@)
    if r == null || r.node == null
      return
    if r.node.has_attribute("inline")
      r.flags.is_inline = true
    if r.node.has_attribute("deprecated")
      r.flags.is_deprecated = true
    if r.node.has_attribute("export")
      r.flags.is_export = true

impl File_env
  fn new(file_name: U8[]): File_env$@
    symbols: = base_core.arena
      .create(Map<|U8[], Sema_symbol$@|>.new_with_cap(128, null))
    return base_core.arena.create(File_env::{ .file_name = file_name, .symbols = symbols })
  fn free(r: Self$@)
    r.symbols.free()

impl Ast_node
  fn get_visibility(r: Ast_node$@): Visibility
    if r == null
      return Visibility.internal
    if r.has_keyword("pub")
      return Visibility.public
    if r.has_keyword("priv")
      return Visibility.file_private

    attr_list: = r.find_child(.k_attribute_list)
    return (Visibility.public if attr_list != null && attr_list.has_keyword("pub")
      else Visibility.file_private if attr_list != null && attr_list.has_keyword("priv")
      else Visibility.internal)
  fn has_explicit_visibility(r: Ast_node$@): Bool //< whether the visibility is stated explicitly
    //<
    //< get_visibility returns `internal` when unspecified too; this tells whether one was written
    //< (for inheriting a trait's visibility onto its methods).
    if r == null
      return false
    if r.has_keyword("pub") || r.has_keyword("priv")
      return true
    attr_list: = r.find_child(.k_attribute_list)
    return attr_list != null &&
      (attr_list.has_keyword("pub") || attr_list.has_keyword("priv"))

// It releases what it owns with `free()`; see `Owned` in std/lang.kspls for why it conforms.
impl Symbol_table: Owned {}
impl File_env: Owned {}

import "ksplc/base/ast" { Ast_node }
import "ksplc/base/core" as base_core
import "ksplc/base/mangle" as base_mangle
import "ksplc/sema/type/def" { Entry, Struct_def, Trait_def, Enum_def, Fn_sig }
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" as sema_type_scope + { Sema_symbol }
import "std/chars"
import "std/ds" { List, Map }
import "std/io"
import "std/str" { Str_builder }
import "std/strnum" // `to_i64` / `to_f64` / `parse_size`
import "std/sys"

const option_fqn: U8[] = "std.lang.Option" //< the FQN of `std/lang`'s `Option<|T|>`
  //<
  //< Caution: **Match an Option by this and instance_base**, never by its mangled name's shape.

priv const max_mangle_depth: Sz = 1000 //<
  //< The safety limit on how deep mangle_type_id_to walks a pointer, slice, array or Result type
  //<
  //< The parser does not count `@` / `[N]` postfixes as depth, so a long chain (`f: I32@@@...@;`)
  //< could exhaust the native stack. Not every caller has a Ctx, so exceeding it reports with
  //< io.err() and sys.exit(1).

enum Builtin_type_id
  unknown = 0
  void_type = 1
  void_ptr = 2
  bool_type = 3
  // --- Numerics (Contiguous for fast bounds checking) ---
  i8_type = 4
  u8_type = 5
  i16_type = 6
  u16_type = 7
  i32_type = 8
  u32_type = 9
  i64_type = 10
  u64_type = 11
  size_type = 12
  f32_type = 13
  f64_type = 14

fn is_unknown(id: I32): Bool //< the two that check whether a type ID is itself a sentinel
  //<
  //< Caution: **Do not mix them with the checks that walk Env (types_query's is_integer /
  //< is_pointer and so on).** Those strip aliases and pointers first. Write every such check as
  //< `is_unknown(x)`; a spelled-out expression cannot be recognized as the same check.
  return id == I32::Builtin_type_id.unknown

fn is_builtin(id: I32): Bool //< whether it is a built-in type's id
  //<
  //< Caution: **Do not write the limit as a number.** Add one built-in and a limit written as a
  //< number goes stale, and the type past it is treated as "a type in another file" — the same
  //< name, yet a diagnostic demanding an alias prefix.
  return id > I32::Builtin_type_id.unknown && id <= I32::Builtin_type_id.f64_type

fn is_void(id: I32): Bool
  return id == I32::Builtin_type_id.void_type

enum Info
  unknown
  void_type
  pointer(base_id: I32)
  array(base_id: I32, size: I32)
  result(base_id: I32, err_id: I32)
  const_of(base_id: I32) //<
    //< The immutable qualifier ("no marker" in KSPL's surface), a structural node
    //<
    //< Being a node keeps the pointee's or element's immutability separate from the view
    //< descriptor's. The canonical string puts immut_mark after (`U8 immut` / `U8[] immut`); as a
    //< prefix it would commute with `@` / `[]`, and slice(const_of(U8)) and const_of(slice(U8))
    //< would become one.
  named //< Entry.str_repr already holds the same string, so it is not held twice here
  alias_type(base_id: I32)
  fn_type(sig: Fn_sig$@) //<
    //< A function pointer.
    //<
    //< Its canonical string `fn(P1,P2):R` is rebuilt from the parts, and a composite built on one
    //< puts it in brackets, as the surface does (`(fn():I32)@`), so a pointer to a function
    //< pointer never shares a string with a function returning a pointer.
  struct_type(def: Struct_def$@)
  enum_type(def: Enum_def$@)
  trait_type(def: Trait_def$@)

priv fn close_of_group(s: U8[], open: Sz): I32 //<
  //< The position of the `)` closing the `(` at open; -1 if none
  $depth: I32 = 0
  for $i: = open; i < s.len; i += 1
    if s[i] == '('
      depth += 1
    else if s[i] == ')'
      depth -= 1
      if depth == 0
        return I32::i
  return -1

struct Env
  type_to_id: Map<|U8[], I32|>$@
  id_to_type: List<|Entry$@|>$@
  instantiated_nodes: Map<|U8[], Ast_node$@|>$@
  instantiated_nodes_list: List<|Ast_node$@|>$@
  inst_type_index: Map<|I32, U8[]|>$@ //<
    //< The index from an instance's type_id back to its registration key ("base<|args|>")
    //<
    //< It covers a struct's or enum's instantiation (instantiate_struct) once it is complete.
    //< Caution: **Do not walk all of instantiated_nodes linearly looking for a type_id match.**
    //< That is O(N^2) over N instantiations, and a file writing many of them hangs the compilation.
  variance_masks: Map<|U8[], I32|>$@ //<
    //< A generic base's name -> the bits for which type-argument positions declare mutability
    //<
    //< A bit is 1 for a `struct Slice<|$T|>`. Written by register_template_names in
    //< `../decl/declare.kspls`; read by the variance comparison (`query.kspls`) and variance_c_name
    //< below. Keyed by base name, since the answer is the same for every instance.
  complex_types: List<|I32|>$@
  files: Map<|U8[], sema_type_scope.File_env$@|>$@
  empty_trait_list: List<|I32|>$@ //<
    //< The shared empty list implemented_trait_list returns for "zero conformances"
    //<
    //< So callers need no null check.
  arc_content_memo: Map<|I32, I32|>$@ //<
    //< Where type_has_arc_content's (sema/type/arc.kspls) answer is remembered across types.
    //<
    //< Caution: **Set it only once no more types are added** (only run in lower/root.kspls sets
    //< it). Set before the declarations are filled, a struct whose fields are still empty is
    //< remembered as "holding no ARC", no retain/release is inserted, and the value silently leaks.
    //< While it is null the answer is computed per call.

impl Info
  fn is_pointer(r: Self): Bool
    switch r case .pointer(_b)
      return true
    default
      return false
  fn is_array(r: Self): Bool
    switch r case .array(_b, _s)
      return true
    default
      return false
  fn is_const_of(r: Self): Bool
    switch r case .const_of(_b)
      return true
    default
      return false
  fn is_result(r: Self): Bool
    switch r case .result(_b, _e)
      return true
    default
      return false

impl Env
  fn new(): Env$@
    type_to_id: = base_core.arena.create(Map<|U8[], I32|>.new_with_cap(4096, null))
    id_to_type: = base_core.arena.create(List<|Entry$@|>.new())
    instantiated_nodes: = base_core.arena
      .create(Map<|U8[], Ast_node$@|>.new_with_cap(1024, null))
    instantiated_nodes_list: = base_core.arena.create(List<|Ast_node$@|>.new())
    inst_type_index: = base_core.arena.create(Map<|I32, U8[]|>.new_with_cap(1024, null))
    variance_masks: = base_core.arena.create(Map<|U8[], I32|>.new_with_cap(64, null))
    complex_types: = base_core.arena.create(List<|I32|>.new())
    files: = base_core.arena
      .create(Map<|U8[], sema_type_scope.File_env$@|>.new_with_cap(128, null))
    empty_trait_list: = base_core.arena.create(List<|I32|>.new())
    ptr: = base_core.arena
      .create(Env::{ .type_to_id = type_to_id, .id_to_type = id_to_type,
      .instantiated_nodes = instantiated_nodes, .instantiated_nodes_list = instantiated_nodes_list,
      .inst_type_index = inst_type_index, .variance_masks = variance_masks,
      .complex_types = complex_types, .files = files, .empty_trait_list = empty_trait_list,
      .arc_content_memo = null })

    dummy: = Entry.new(Info.unknown, "Unknown")
    ptr.id_to_type.push(dummy)
    ptr.type_to_id.set("Unknown", 0)

    ptr.register("Void", I32::Builtin_type_id.void_type)
    ptr.register("Void@", I32::Builtin_type_id.void_ptr)
    ptr.register("Bool", I32::Builtin_type_id.bool_type)
    ptr.register("I8", I32::Builtin_type_id.i8_type)
    ptr.register("U8", I32::Builtin_type_id.u8_type)
    ptr.register("I16", I32::Builtin_type_id.i16_type)
    ptr.register("U16", I32::Builtin_type_id.u16_type)
    ptr.register("I32", I32::Builtin_type_id.i32_type)
    ptr.register("U32", I32::Builtin_type_id.u32_type)
    ptr.register("I64", I32::Builtin_type_id.i64_type)
    ptr.register("U64", I32::Builtin_type_id.u64_type)
    ptr.register("Sz", I32::Builtin_type_id.size_type)
    ptr.register("F32", I32::Builtin_type_id.f32_type)
    ptr.register("F64", I32::Builtin_type_id.f64_type)

    return ptr
  fn free(r: Self$@)
    r.type_to_id.free()
    r.id_to_type.free()
    r.instantiated_nodes.free()
    r.instantiated_nodes_list.free()
    r.inst_type_index.free()
    r.variance_masks.free()
    r.complex_types.free()
    // The list is allocated on the heap (this is mid-cleanup, so the arena is not grown).
    for entry in r.files.items()
      entry.value.free()
    r.files.free()
  fn find_main_symbol(r: Self$@): Option<|Sema_symbol$@|> //<
    //< Returns the first function symbol "main" in any file (shared by both backends)
    for m_entry in r.files.items()
      ms: = m_entry.value.symbols.get("main") catch null
      if ms != null && ms.kind.is_function()
        return Option<|Sema_symbol$@|>.some(ms)
    return Option<|Sema_symbol$@|>.none
  fn collect_main_symbols(r: Self$@, out: List<|Sema_symbol$@|>$@) //<
    //< Collects every function declaring `main`
    //<
    //< Caution: **Do not stop at the first one found.** With two or more, `find_main_symbol`'s pick
    //< depends on the table's walk order; the count lets `check_one_main` in
    //< `sema/body/analyze.kspls` reject that form.
    for m_entry in r.files.items()
      ms: = m_entry.value.symbols.get("main") catch null
      if ms != null && ms.kind.is_function()
        out.push(ms)
  fn find_backtrace_symbol(r: Self$@): Option<|Sema_symbol$@|> //<
    //< The function the start-up code calls to print the error trace when `main` returns a Result
    //<
    //< **This call is not in the tree.** The marking code (`mark_roots` in `lower/prune.kspls`) and
    //< the code emitting the call (the start-up code in `gen/c/root.kspls` and
    //< `gen/llvm/module.kspls`) must all go through here.
    file_env: = r.files.get("std/sys") catch null
    if file_env == null
      return Option<|Sema_symbol$@|>.none
    ms: = file_env.symbols.get("print_trace") catch null
    if ms != null && ms.kind.is_function()
      return Option<|Sema_symbol$@|>.some(ms)
    return Option<|Sema_symbol$@|>.none
  fn has_type_named(r: Self$@, name: U8[]): Bool //<
    //< Checks whether that name is already registered as a type
    //<
    //< Caution: **Do not confuse it with get_or_add.** That one registers an absent name, so asking
    //< it "is it a type" turns a typo into a type that is accepted from then on.
    return (r.type_to_id.get(name) catch 0) != 0

  priv fn lookup_entry_by_name(r: Self$@, name: U8[]): Option<|Entry$@|> //<
    //< Looks up the instance Entry from a type name (an alias resolved to the real type)
    id: = r.type_to_id.get(name) catch 0
    if id == 0
      return Option<|Entry$@|>.none
    entry: = r.id_to_type.get(r.get_real_type(id))
    if entry != null
      return Option<|Entry$@|>.some(entry)
    return Option<|Entry$@|>.none

  fn methods_of(r: Self$@, name: U8[]): Option<|Map<|U8[], Sema_symbol$@|>$@|> //<
    //< That type's method table
    //<
    //< **It can be absent** (the type is not registered yet, or it has no method). This one is for
    //< **enumerating** (completion lists every member); a lookup by name is `Entry.get_method`.
    if entry: = r.lookup_entry_by_name(name)
      if entry.methods != null
        return Option<|Map<|U8[], Sema_symbol$@|>$@|>.some(entry.methods)
    return Option<|Map<|U8[], Sema_symbol$@|>$@|>.none

  fn get_struct_def(r: Self$@, name: U8[]): Option<|Struct_def$@|>
    if entry: = r.lookup_entry_by_name(name)
      switch entry.info case .struct_type(def)
        return Option<|Struct_def$@|>.some(def)
      default {}
    return Option<|Struct_def$@|>.none

  fn get_enum_def(r: Self$@, name: U8[]): Option<|Enum_def$@|>
    if entry: = r.lookup_entry_by_name(name)
      switch entry.info case .enum_type(def)
        return Option<|Enum_def$@|>.some(def)
      default {}
    return Option<|Enum_def$@|>.none

  fn get_trait_def(r: Self$@, name: U8[]): Option<|Trait_def$@|>
    if entry: = r.lookup_entry_by_name(name)
      switch entry.info case .trait_type(def)
        return Option<|Trait_def$@|>.some(def)
      default {}
    return Option<|Trait_def$@|>.none

  fn file_env_for(r: Self$@, file_name: U8[]): sema_type_scope.File_env$@ //<
    //< The name table of a file, made on its first request
    file_env: = r.files.get(file_name) catch
      arena_fn: = base_core.arena.dup_str(file_name)
      made: = sema_type_scope.File_env.new(arena_fn)
      r.files.set(arena_fn, made)
      fallback made
    return file_env

  fn get_or_add(r: Self$@, type_str: U8[]): I32
    res: = r.type_to_id.get(type_str) catch -1
    if res != -1
      return res

    duped: = base_core.arena.dup_str(type_str)
    len: = duped.len
    $info: = Info.named
    $canonical_str_ptr: U8$[] = duped
    // A composite built on a function type puts it in brackets (`(fn():I32?E)@`), so a `?`
    // inside them is the function's own.
    group_close: = close_of_group(duped, 0) if duped.starts_with("(") else -1
    if group_close == I32::len - 1
      return r.get_or_add(duped.sub(1, len - 2))
    q_from: Sz = group_close + 1 if group_close >= 0 else 0
    q_rest: = duped.sub_from(q_from).find_char_out('?')
    q_idx: = I32::q_from + q_rest if q_rest >= 0 else -1
    // A function type's own parameter or result can be a slice, pointer, Result or array
    // ("fn():U8[]", "fn():T?E"), so its tail says nothing about the outer type; its parts are
    // read from the brackets instead.
    if duped.starts_with("fn(")
      if sig: = r.fn_sig_from_str(duped)
        info = Info.fn_type(sig)
        canonical_str_ptr = r.fn_type_str(sig)
    else
      // Check `?` before the tail branches below: a Result's error type follows the "?" as is, so
      // "I32?U8[]" is Result<I32,U8[]>, not a slice of "I32?U8".
      if duped.ends_with(base_core.immut_mark)
        // The immutable qualifier is postfix; a type name has no space, so it cannot collide
        // with the other tail checks.
        base_id: = r.get_or_add(duped.sub(0, len - base_core.immut_mark.len))
        return r.also_spelled(duped, r.make_const(base_id))
      if q_idx >= 0
        base_id: = r.get_or_add(duped.sub(0, q_idx))
        err_id: = r.get_or_add(duped.sub_from(q_idx + 1) if q_idx + 1 < len else "I32")
        return r.also_spelled(duped, r.make_result_with_err(base_id, err_id))
      if len >= 1 && (duped.ptr + len - 1)$ == '@'
        return r.also_spelled(duped, r.make_ptr(r.get_or_add(duped.sub(0, len - 1))))
      bracket_idx: = duped.rfind_char_out('[')
      if len >= 3 && (duped.ptr + len - 1)$ == ']' && (duped.ptr + len - 2)$ != '[' &&
        bracket_idx > 0
        num_str: = duped.sub(bracket_idx + 1, len - bracket_idx - 2)
        base_id: = r.get_or_add(duped.sub(0, bracket_idx))
        $size_val: I32 = -1
        if !num_str.equals("_")
          size_val = I32::(num_str.parse_size() catch 0)
        return r.also_spelled(duped, r.make_array(base_id, size_val))
      if duped.equals("Void")
        info = Info.void_type

    if !canonical_str_ptr.equals(duped)
      res2: = r.type_to_id.get(canonical_str_ptr) catch -1
      if res2 != -1
        r.type_to_id.set(duped, res2)
        return res2

    actual_new_id: = I32::r.id_to_type.len
    r.id_to_type.push(Entry.new(info, canonical_str_ptr))

    r.type_to_id.set(duped, actual_new_id)
    if !canonical_str_ptr.equals(duped)
      r.type_to_id.set(canonical_str_ptr, actual_new_id)

    r.note_if_complex(actual_new_id, info)
    return actual_new_id

  priv fn also_spelled(r: Self$@, spelling: U8[], id: I32): I32 //<
    //< Records `spelling` as another key for the composite id a `make_*` function registered
    //<
    //< Caution: **Build an immutable, Result, pointer or array type only through its `make_*`**
    //< (make_const, make_result_with_err, make_ptr, make_array): a second builder would drift
    //< from their canonical string, and make_result_with_err's re-association would be skipped.
    r.type_to_id.set(spelling, id)
    return id

  priv fn note_if_complex(r: Self$@, id: I32, info: Info) //<
    //< Records in `complex_types` the types the generator declares before their use
    //<
    //< They are a Result, an array and a function type.
    //<
    //< Caution: **Keep which shapes count as "composite" here only.** Three generators walk this
    //< list as it is (`../../gen/c/root.kspls`, `../../gen/c/decl.kspls`,
    //< `../../gen/llvm/types.kspls`), so a condition written per registering function emits C or
    //< LLVM where a type registered by only one of them has no forward declaration — **ksplc
    //< reports nothing and a later step fails**.
    switch info case .result(_b, _e)
      r.complex_types.push(id)
    case .array(_b, _s)
      r.complex_types.push(id)
    case .fn_type(_sig)
      r.complex_types.push(id)
    default {}

  fn get_info(r: Self$@, id: I32): Info
    if id < 0 || id >= r.id_to_type.len
      return Info.unknown
    return r.id_to_type.get(id).info

  fn get_str(r: Self$@, id: I32): U8$[]
    if id < 0 || id >= r.id_to_type.len
      return "Unknown"
    return r.id_to_type.get(id).str_repr

  priv fn register_type(r: Self$@, canonical_str: U8[], info: Info): I32 //<
    //< The low-level function that registers a composite type (pointer / slice / array / result)
    //<
    //< Unlike get_or_add, Info is not guessed from the string; the caller assembles it, and
    //< canonical_str is already the display, mangling and deduplication key.
    res: = r.type_to_id.get(canonical_str) catch -1
    if res != -1
      return res
    dup_str: = base_core.arena.dup_str(canonical_str)
    actual_new_id: = I32::r.id_to_type.len
    r.id_to_type.push(Entry.new(info, dup_str))
    r.type_to_id.set(dup_str, actual_new_id)
    r.note_if_complex(actual_new_id, info)
    return actual_new_id

  priv fn write_suffix_base(r: Self$@, out: Str_builder$@, base_id: I32) //<
    //< Writes the canonical string of the type a postfix applies to, a function type in brackets
    //<
    //< Caution: **Build every composite's string through here.** Unbracketed, a pointer to
    //< `fn():I32` spells `fn():I32@`, a function returning `I32@`, and the two share one id.
    switch r.get_info(base_id) case .fn_type(_sig)
      out.c('(').s(r.get_str(base_id)).c(')')
    default
      out.s(r.get_str(base_id))

  priv fn fn_sig_from_str(r: Self$@, s: U8[]): Option<|Fn_sig$@|> //<
    //< Reads a function type's parts out of its canonical string `fn(P1,P2):R`, registering each
    //<
    //< None where the string does not have that shape.
    close: = close_of_group(s, 2)
    if close < 0 || close + 1 >= s.len || s[close + 1] != ':'
      return Option<|Fn_sig$@|>.none
    params: = s.sub(3, close - 3)
    sig: = Fn_sig.new(r.get_or_add(s.sub_from(close + 2)))
    for pos in Range.asc(params.count_type_args())
      sig.params.push(r.get_or_add(params.nth_type_arg(pos)))
    return Option<|Fn_sig$@|>.some(sig)

  priv fn fn_type_str(r: Self$@, sig: Fn_sig$@): U8$[] //< a function type's canonical string
    $s: = Str_builder.new()
    defer s.free()
    s.s("fn(")
    for i in Range.asc(sig.params.len)
      if i > 0
        s.c(',')
      s.s(r.get_str(sig.params.get(i)))
    s.s("):").s(r.get_str(sig.ret_id))
    return base_core.arena.dup_str(s.slice())

  fn fn_sig_of(r: Self$@, id: I32): Option<|Fn_sig$@|> //<
    //< The parts of the function type id stands for, aliases and the immutable mark stripped
    //<
    //< None for any other type, and for generic_fn_value_type_id's mark, which holds no signature.
    switch r.get_info(r.get_clean_real_type(id)) case .fn_type(sig)
      return Option<|Fn_sig$@|>.some(sig)
    default
      return Option<|Fn_sig$@|>.none

  priv fn make_suffixed_ref(r: Self$@, base_id: I32, suffix: U8[], info: Info): I32 //<
    //< Registers a simple composite type whose string is base_id's canonical string plus suffix
    if is_unknown(base_id)
      return I32::Builtin_type_id.unknown
    $s: = Str_builder.new()
    defer s.free()
    r.write_suffix_base(s@, base_id)
    s.s(suffix)
    return r.register_type(s.slice(), info)

  fn make_ptr(r: Self$@, base_id: I32): I32
    return r.make_suffixed_ref(base_id, "@", Info.pointer(base_id))

  fn make_const(r: Self$@, base_id: I32): I32 //<
    //< Returns the type id with the immutable qualifier added to the base type
    //<
    //< The internal representation puts it after, as `base + immut_mark`.
    //< The immutable mark's string is built only here, so no two places disagree.
    if r.is_const(base_id)
      return base_id
    $b: = Str_builder.new()
    defer b.free()
    r.write_suffix_base(b@, base_id)
    b.s(base_core.immut_mark)
    return r.register_type(b.slice(), Info.const_of(base_id))

  fn make_array(r: Self$@, base_id: I32, size: I32): I32 //< an array
    //<
    //< size<0 means "unspecified" (decided later from the element count) and is "[_]" in the
    //< canonical string.
    if is_unknown(base_id)
      return I32::Builtin_type_id.unknown
    $s: = Str_builder.new()
    defer s.free()
    r.write_suffix_base(s@, base_id)
    if size >= 0
      s.s("[\{size\}]")
    else
      s.s("[_]")
    return r.register_type(s.slice(), Info.array(base_id, size))

  fn make_result(r: Self$@, base_id: I32): I32 //<
    //< The Result type of base_id with the default error type I32
    //<
    //< The default when a Result's error type is omitted (`T?`) is I32. The omitted form and an
    //< explicit `T?I32` are the same type, canonical string "{T}?".
    return r.make_result_with_err(base_id, I32::Builtin_type_id.i32_type)

  fn make_result_with_err(r: Self$@, base_id: I32, err_id: I32): I32
    if is_unknown(base_id)
      return I32::Builtin_type_id.unknown
    // "(T1?T2)?T3" and "T1?(T2?T3)" share the canonical string "T1?T2?T3". A base_id that is
    // already a Result is reassembled into the right-associative form Result<A, Result<B,E>>, so
    // the structure (strip_result's answer) does not depend on which was resolved first.
    switch r.get_info(r.get_real_type(base_id)) case .result(inner_base, inner_err)
      inner_result: = r.make_result_with_err(inner_err, err_id)
      return r.make_result_with_err(inner_base, inner_result)
    default {}
    $s: = Str_builder.new()
    defer s.free()
    r.write_suffix_base(s@, base_id)
    s.c('?')
    if err_id != (I32::Builtin_type_id.i32_type)
      s.s(r.get_str(err_id))
    return r.register_type(s.slice(), Info.result(base_id, err_id))

  fn generic_fn_value_type_id(r: Self$@): I32 //<
    //< The standard function pointer type ID for a function value with no expected type
    //<
    //< A function value is a function used as a plain identifier with no arguments.
    //< In a generic call (sema/body/call.kspls) T/U are not decided yet, so no signature is needed:
    //< this fixed string only tells is_fn_ptr "a function pointer, not a scalar". It deliberately
    //< differs from the "fn(...)" resolve_fn_sig_type assembles.
    return r.get_or_add("fn.type_fn_sig")

  fn add_implemented_trait(r: Self$@, target_id: I32, trait_id: I32)
    clean_id: = r.strip_ptr(target_id)
    if clean_id < 0 || clean_id >= r.id_to_type.len
      return
    entry: = r.id_to_type.get(clean_id)
    entry.add_trait(trait_id)

  fn implements_trait(r: Self$@, target_id: I32, trait_id: I32): Bool //<
    //< The immutable qualifier is ignored in the comparison
    //<
    //< "Can the value be rewritten" is independent of "which impl applies", and collect_impl_decl
    //< forbids an immutable impl target. Every type is immutable by default, so without this no
    //< trait implementation would ever match.
    clean_id: = r.strip_const_deep(r.get_clean_real_type(r.strip_ptr(target_id)))
    if clean_id < 0 || clean_id >= r.id_to_type.len
      return false
    return r.id_to_type.get(clean_id).has_trait(trait_id)

  priv fn implemented_trait_list(r: Self$@, target_id: I32): List<|I32|>$@ //<
    //< Returns, for iteration, the list of traits target_id conforms to
    //<
    //< Where there is none it returns the empty list, never null.
    clean_id: = r.strip_const_deep(target_id)
    if clean_id >= 0 && clean_id < r.id_to_type.len
      list: = r.id_to_type.get(clean_id).implemented_traits
      if list != null
        return list
    return r.empty_trait_list

  fn has_implemented_trait_fqn(r: Self$@, target_id: I32, trait_fqn: U8[]): Bool //<
    //< Whether target_id conforms to "a trait whose FQN is trait_fqn itself"
    //<
    //< It serves the non-generic compiler-known traits Ref_counted / Move_only.
    want_id: = r.type_to_id.get(trait_fqn) catch 0
    if want_id == 0
      // That trait is not in this compilation unit (= nobody conforms to it).
      return false
    want_real: = r.get_real_type(want_id)
    for i_id in r.implemented_trait_list(target_id)
      if r.get_real_type(i_id) == want_real
        return true
    return false

  fn has_implemented_operator_trait(r: Self$@, target_id: I32, trait_name: U8[]): Bool //<
    //< Whether target_id conforms to an std/lang operator trait (Add, Index_place, Cast and others)
    //<
    //< Never by a prefix or suffix match: `Index_` prefixes `Index_place_`, and a suffix match lets
    //< a trait `Add` in one's own file count as an operator. Every compiler-known trait is checked
    //< this way.
    $want: = Str_builder.new()
    defer want.free()
    want.s("std.lang.\{trait_name\}")

    for i_id in r.implemented_trait_list(target_id)
      // Where it is registered in a form carrying no generic actual arguments (a conformance to
      // the template itself).
      if r.get_str(r.get_real_type(i_id)).equals(want.slice())
        return true
    return r.implemented_trait_key_of(target_id, want.slice()).len > 0

  fn implemented_trait_key_of(r: Self$@, target_id: I32, base_fqn: U8[]): U8[] //<
    //< The registration key of the trait with base base_fqn that target_id conforms to
    //<
    //< An example of the key is `std.lang.Callable1<|I32, I64|>`.
    //< **It serves a form whose type arguments cannot be inferred from the actual argument.**
    //< Caution: The base's comparison must be an exact match on what precedes the `<|` (the same
    //< reason as above).
    for i_id in r.implemented_trait_list(target_id)
      key: = r.inst_type_index.get(r.get_real_type(i_id)) catch ""
      gen_at: = key.find_str("<|")
      if gen_at <= 0
        continue
      if key.sub(0, gen_at).equals(base_fqn)
        return key
    return ""

  fn register(r: Self$@, name: U8$[], expected_id: I32)
    id: = r.get_or_add(name)
    if id != expected_id
      io.err().s("Error: TypeID mismatch for \{name\}\n")

  fn mangle_type_id_to(r: Self$@, type_id: I32, w: Writer): Writer
    return r.mangle_type_id_to_impl(type_id, w, 0)

  priv fn mangle_type_id_to_impl(r: Self$@, type_id: I32, w: Writer, depth: Sz): Writer
    if depth >= max_mangle_depth
      io.err()
        .s("\nfatal: type expression nesting too deep (possible unbounded pointer/array/slice \
          chain).\n")
      sys.exit(1)
    if type_id <= 0 || is_unknown(type_id)
      return w.s("Unknown")
    info: = r.get_info(type_id)
    $res: = w

    $base_id: I32 = 0
    $suffix: U8[] = ""
    $arr_size: I32 = -1
    $err_id: I32 = 0

    switch info case .const_of(b)
      // **An immutable qualifier on the view descriptor itself** (`U8$[] immut`) as a
      // `Const_` prefix could collide with one on the element (the type argument), so on a view
      // type it is the suffix `_Const`. A slice is a struct, so it is recognized by name
      // (`slice_struct_elem`), not by the constructor.
      b_info: = r.get_info(b)
      is_view: =
        r.slice_struct_elem(b) != 0 || b_info.is_array() || b_info.is_pointer() ||
        b_info.is_result()
      if is_view
        res = r.mangle_type_id_to_impl(b, res, depth + 1)
        return res.s("_Const")
      res = res.s("Const_")
      return r.mangle_type_id_to_impl(b, res, depth + 1)
    case .pointer(b)
      base_id = b
      suffix = "_Ptr"
    case .array(b, s)
      base_id = b
      suffix = "_Array_"
      arr_size = s
    case .result(b, e)
      base_id = b
      suffix = "_Result"
      err_id = e
    default {}

    if base_id != 0
      res = r.mangle_type_id_to_impl(base_id, res, depth + 1)
      res = res.s(suffix)
      if arr_size != -1
        res = res.s("\{arr_size\}")
      if err_id != 0
        err_str: = r.get_str(err_id)
        if !err_str.equals("I32")
          res = res.s("_")
          res = r.mangle_type_id_to_impl(err_id, res, depth + 1)
      return res

    // The immutability at a position that declared variance is dropped from the C name
    // (variance_stripped_args above).
    $stripped: = r.variance_stripped_args(type_id)
    defer stripped.free()
    if stripped.slice().len > 0
      $plain: = Str_builder.new()
      defer plain.free()
      plain.s(r.instance_base(type_id)).s("_").s(stripped.slice())
      return plain.slice().mangle_type_name_to(res)
    base_str: = r.get_str(type_id)
    return base_str.mangle_type_name_to(res)

  fn variance_stripped_args(r: Self$@, type_id: I32): Str_builder //<
    //< An instance's actual arguments, **dropping immutability where the declaration declared it**
    //<
    //< Empty if there is nothing to drop. **The C name is written with this**, or `Box<|$I32|>` and
    //< `Box<|I32|>` become different C structs and C rejects the weakening KSPL allows. **The KSPL
    //< types stay two**: the `p` of `Box<|I32|>` stays `I32@` and KSPL rejects the write.
    mask: = r.variance_masks.get(r.instance_base(type_id)) catch 0
    if mask == 0
      return Str_builder.new()
    return r.instance_args(type_id).strip_variance_const(mask)

  fn c_repr_type_id(r: Self$@, type_id: I32): I32 //<
    //< The type id of what shares the C representation
    //<
    //< **Instances differing only in the immutability at a position that declared it are folded
    //< into one C struct** (variance_stripped_args above), so the generated C's reordering is
    //< matched on this id. Without it, a struct holding a `Slice<|U8 immut|>` is emitted before
    //< `Slice<|U8|>`'s definition and C fails with `field has incomplete type` (c_order_id in
    //< `../../gen/c/root.kspls`). If there is nothing to fold with, it is returned unchanged.
    $stripped: = r.variance_stripped_args(type_id)
    defer stripped.free()
    plain_args: = stripped.slice()
    if plain_args.len == 0
      return type_id
    // Caution: **Look up the key by the mangled name.** An instance is in the type table under
    // its mangled name, and `mangle_type_id_to` already drops the immutability.
    $key: = Str_builder.new()
    defer key.free()
    r.mangle_type_id_to(type_id, key)
    return r.type_to_id.get(key.slice()) catch type_id

  fn instance_base(r: Self$@, type_id: I32): U8[] //<
    //< The generic's FQN (`std.lang.Slice`) if type_id is an instance of one, else ""
    //<
    //< Caution: **Ask this rather than reading the mangled name's shape**, which breaks silently
    //< when the mangling rule changes; an instance's type cannot be told from a plain struct.
    //< type_id is taken as it is: strip an alias or an immutable qualifier first where it applies.
    return (r.inst_type_index.get(type_id) catch "").get_generic_base_name()

  fn instance_args(r: Self$@, type_id: I32): U8[] //<
    //< The actual arguments (`I32, U8[]`) if type_id is an instance of a generic, else ""
    return (r.inst_type_index.get(type_id) catch "").generic_args_str()

  fn slice_struct_elem(r: Self$@, type_id: I32): I32 //<
    //< The element's type id if it is a `Slice<|T|>` instance, else 0.
    // **Strip an immutable qualifier on the descriptor itself first** (`U8$[] immut`), or a
    // slice held by a read-only binding answers "not a slice".
    real_id: = r.get_clean_real_type(type_id)
    if !r.instance_base(real_id).equals(base_core.slice_fqn)
      return 0
    arg: = r.instance_args(real_id).nth_type_arg(0)
    return 0 if arg.len == 0 else r.get_or_add(arg)

// It releases what it owns with `free()`; see `Owned` in std/lang.kspls for why it conforms.
impl Env: Owned {}

struct Mangle_seen //< the record for emitting a composite type "once per mangled name"
  //<
  //< Caution: **Do not write how duplicates are skipped anywhere but here.** If any of the three
  //< generators that walk `complex_types` (`../../gen/c/root.kspls`, `../../gen/c/decl.kspls`,
  //< `../../gen/llvm/types.kspls`) drifts on a copied rule, two definitions of the same name are
  //< emitted and **clang fails while ksplc reports nothing**. **The key is the mangled name "at
  //< emission"**, not at registration (stripping a const can later give it the same name).
  priv env: Env$@
  priv seen: Map<|U8[], I32|>$@
  priv buf: Str_builder

// `free` returns the receiver; it declares `Owned` for the same reason as `Env` above.
impl Mangle_seen: Owned {}

impl Mangle_seen
  fn new(env: Env$@): Mangle_seen
    return Mangle_seen::{ .env = env,
      .seen = base_core.arena.create(Map<|U8[], I32|>.new()), .buf = Str_builder.new() }

  fn free(r: Self$@)
    r.seen.free()
    r.buf.free()

  fn admit(r: Self$@, type_id: I32): Bool //<
    //< A mangled name seen for the first time is noted and true; the second time, false.
    //<
    //< Caution: **Call it "after" the caller's filtering.** Filling a slot with a type that is not
    //< emitted makes the type of the same name that **should be emitted** go missing (noting a
    //< length-less array first in `gen/c/root.kspls` made `std_lang_Slice_U8_Array_24`'s typedef
    //< vanish and the self-host fail).
    r.buf.len = 0
    r.env.mangle_type_id_to(type_id, r.buf@)
    name: = r.buf.slice()
    if (r.seen.get(name) catch 0) != 0
      return false
    r.seen.set(base_core.arena.dup_str(name), 1)
    return true

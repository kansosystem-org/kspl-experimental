//< Type names in the generated code and in the instantiation cache
//< An extension on `Env` in `env.kspl`: it reads the type table and each instance's record.
//< `mangle_type_id_to` spells each output name once from Lower onward;
//< `instance_key_to` spells a cache key. `Mangle_seen` admits each output name only once.
//< **A caller of these methods must import this file**, as with `query.kspl`.
import "ksplc/base/ast" as base_ast
import "ksplc/base/core" as base_core
import "ksplc/base/mangle" as base_mangle
import "ksplc/sema/type/env" { Env, Instance, is_unknown }
import "std/ds" { Map }
import "std/io"
import "std/str" { Str_builder }
import "std/sys"

priv const MAX_MANGLE_DEPTH: Sz = 1000 //<
    //< The safety limit on how deep mangle_type_id_to walks a pointer, slice or array type
    //< The parser does not count `@` / `[N]` postfixes as depth, so a long chain (`f: I32@@@...@;`)
    //< could exhaust the native stack. Not every caller has a Ctx, so exceeding it reports with
    //< io.err() and sys.exit(1).

impl Env
    fn mangle_type_id_to(r: Self$@, type_id: I32, w: Writer): Writer //<
        //< Writes type_id's mangled name, the type's name in the generated C and LLVM IR
        //< **Once the names are settled (`c_names_final`), each type's is spelled once** and kept
        //< on its entry (`Entry.c_name`). Spelling walks the name a character at a time, and code
        //< generation asks for the same few thousand names tens of thousands of times.
        //< Caution: **Every name of a type in the output comes from here.** A second spelling
        //< drifts from this one on an instance whose immutability is dropped, and the C declares
        //< one name and uses another.
        if !r.c_names_final || type_id <= 0 || type_id >= r.id_to_type.len
            return r.mangle_type_id_to_impl(type_id, w, 0)
        entry: = r.id_to_type.get(type_id)
        if entry.c_name.len == 0
            defer $spelled: = Str_builder()
            r.mangle_type_id_to_impl(type_id, spelled, 0)
            entry.c_name = base_core.arena.dup_str(spelled.slice())
        return w.s(entry.c_name)

    priv fn mangle_type_id_to_impl(r: Self$@, type_id: I32, w: Writer, depth: Sz): Writer
        if depth >= MAX_MANGLE_DEPTH
            io.err()
                .s("\nfatal: type expression nesting too deep. The chain of pointer, array or slice \
                    types may be unbounded.\n")
            sys.exit(1)
        if type_id <= 0 || is_unknown(type_id)
            return w.s(base_core.UNKNOWN_TYPE_NAME)
        info: = r.get_info(type_id)
        $res: = w

        $base_id: I32 = 0
        $suffix: U8[] = ""
        $arr_size: I32 = -1

        switch info
        case .const_of(b)
            // **An immutable qualifier on the view descriptor itself** (`U8$[] immut`) as a
            // `Const_` prefix could collide with one on the element (the type argument). So on a
            // view type it is the suffix `_Const`. A slice is a struct, so it is recognized by name
            // (`slice_struct_elem`), not by the constructor.
            b_info: = r.get_info(b)
            is_view: =
                r.slice_struct_elem(b) != 0 || b_info.is_array() || b_info.is_pointer()
            if is_view
                res = r.mangle_type_id_to_impl(b, res, depth + 1)
                return res.s("_Const")
            res = res.s("Const_")
            return r.mangle_type_id_to_impl(b, res, depth + 1)
        case .pointer(b)
            base_id = b
            suffix = "_Ptr"
        case .array(b, s)
            base_id = b
            suffix = "_Array_"
            arr_size = s
        default {}

        if base_id != 0
            res = r.mangle_type_id_to_impl(base_id, res, depth + 1)
            res = res.s(suffix)
            if arr_size != -1
                res = res.s("\{arr_size\}")
            return res

        // The immutability at a position that declared variance is dropped from the C name
        // (variance_stripped in env.kspl).
        if plain: = r.variance_stripped(type_id)
            return r.instance_c_name_to(plain, res)
        base_str: = r.get_str(type_id)
        return base_str.mangle_type_name_to(res)

    fn mangled_into(r: Self$@, type_id: I32, b: Str_builder$@): U8$[] //<
        //< type_id's mangled name, written afresh into b: valid until b is used again
        b.clear()
        r.mangle_type_id_to(type_id, b)
        return b.slice()

    fn c_repr_type_id(r: Self$@, type_id: I32): I32 //<
        //< The type id of what shares the C representation
        //< **Instances differing only in the immutability at a position that declared it are folded
        //< into one C struct** (variance_stripped in env.kspl). So the generated C's reordering is
        //< matched on this id. Without it, a struct holding a `Slice<|U8 immut|>` is emitted before
        //< `Slice<|U8|>`'s definition. C then fails with `field has incomplete type` (c_order_id in
        //< `../../gen/c/root.kspl`). If there is nothing to fold with, it is returned unchanged.
        if _plain: = r.variance_stripped(type_id)
            // Caution: **Look up the key by the mangled name.** An instance is in the type table
            // under its mangled name, and `mangle_type_id_to` already drops the immutability.
            defer $key: = Str_builder()
            r.mangle_type_id_to(type_id, key)
            return r.type_to_id.get(key.slice()).unwrap_or(type_id)
        return type_id

    fn type_args_to(r: Self$@, args: I32[], w: Writer): Writer //<
        //< Writes a list of type arguments (`I32, U8[]`), each by its canonical string
        //< **The separator is `type_arg_sep`**, as every list of resolved type arguments has it.
        $res: = w
        for i in Range.asc(args.len)
            if i > 0
                res = res.s(base_ast.TYPE_ARG_SEP)
            res = res.s(r.get_str(args[i]))
        return res

    fn instance_key_to(r: Self$@, inst: Instance, w: Writer): Writer //<
        //< Writes the instance's registration key, `template<|args|>` (`std.ds.List<|I32|>`)
        //< It is how a person would write the instance (display_type_to in `display.kspl` shows
        //< it in the surface notation), and the instantiation cache's key.
        return r.type_args_to(inst.args, w.s(inst.template).s("<|")).s("|>")

    fn instance_key(r: Self$@, type_id: I32): U8[] //<
        //< type_id's registration key on the arena, or "" where it is no instance
        switch r.instance_of(type_id)
        case .some(inst)
            defer $key: = Str_builder()
            r.instance_key_to(inst, key)
            return base_core.arena.dup_str(key.slice())
        case .none
            return ""

    fn instance_c_name_to(r: Self$@, inst: Instance, w: Writer): Writer //<
        //< Writes the instance's mangled name, the one it has in the type table and in C
        //< Caution: **Name an instance through here only.** A second spelling of the rule makes
        //< two names for one instance, and C fails with `redefinition` or `unknown type name`.
        defer $full: = Str_builder()
        full.s(inst.template)
        if inst.args.len > 0
            r.type_args_to(inst.args, full.s("_"))
        return full.slice().mangle_type_name_to(w)

struct Mangle_seen //< the record for emitting a composite type "once per mangled name"
    //< Caution: **Do not write how duplicates are skipped anywhere but here.** Two generators walk
    //< `complex_types` (`../../gen/c/root.kspl`, `../../gen/c/decl.kspl`). If either drifts on a
    //< copied rule, two definitions of the same name are emitted, and **clang fails while ksplc
    //< reports nothing**. **The key is the mangled name "at emission"**, not at registration
    //< (stripping a const can later give it the same name).
    priv env: Env$@
    priv seen: Map<|U8[], I32|>$@
    priv buf: Str_builder

// It releases what it owns with `free()`; see `Manual_free` in std/lang.kspl for why it conforms.
impl Mangle_seen: Manual_free
    fn free(r: Self$@)
        r.seen.free()
        r.buf.free()

impl Mangle_seen
    fn new(env: Env$@): Mangle_seen
        return Mangle_seen::{ .env = env,
            .seen = base_core.arena.create(Map<|U8[], I32|>(null)), .buf = Str_builder() }

    fn admit(r: Self$@, type_id: I32): Bool //<
        //< A mangled name seen for the first time is noted and true; the second time, false.
        //< Caution: **Call it "after" the caller's filtering.** Filling a slot with a type that is
        //< not emitted makes the type of the same name that **should be emitted** go missing.
        //< Noting a length-less array first in `gen/c/root.kspl` made
        //< `std_lang_Slice_U8_Array_24`'s typedef vanish, and the self-host failed.
        r.buf.len = 0
        r.env.mangle_type_id_to(type_id, r.buf@)
        name: = r.buf.slice()
        if r.seen.get(name).unwrap_or(0) != 0
            return false
        r.seen.set(base_core.arena.dup_str(name), 1)
        return true

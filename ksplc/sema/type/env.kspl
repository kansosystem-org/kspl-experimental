//< The type table (`Env`): a type id for each type, and what each id stands for
//<
//< `get_or_add` and the `make_*` functions register a type under its canonical string; `get_info`
//< and `get_str` read an id back. It also keeps each generic instance's record (`Instance`), the
//< traits each type conforms to. Queries on an id are in `query.kspl`, output and cache names
//< in `naming.kspl`, and the shapes of a struct, trait or enum in `def.kspl`.
import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/base/diag" as base_diag
import "ksplc/base/locate" as base_locate
import "ksplc/base/mangle" as base_mangle
import "ksplc/sema/type/def" { Entry, Struct_def, Trait_def, Enum_def, Fn_sig }
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" as sema_type_scope + { Sema_symbol }
import "std/chars"
import "std/ds" { List, Map }
import "std/str" { Str_builder }
import "std/strnum" // `to_i64` / `to_f64` / `parse_size`

enum Builtin_type_id
    unknown = 0
    void_type = 1
    void_ptr = 2
    bool_type = 3
    // --- Numerics (Contiguous for fast bounds checking) ---
    i8_type = 4
    u8_type = 5
    i16_type = 6
    u16_type = 7
    i32_type = 8
    u32_type = 9
    i64_type = 10
    u64_type = 11
    size_type = 12
    f32_type = 13
    f64_type = 14

fn is_unknown(id: I32): Bool //< the two that check whether a type ID is itself a sentinel
    //<
    //< Caution: **Do not mix them with the checks that walk Env (sema/type/query.kspl's is_integer
    //< / is_pointer and so on).** Those strip aliases and pointers first. Write every such check as
    //< `is_unknown(x)`; a spelled-out expression cannot be recognized as the same check.
    return id == I32::Builtin_type_id.unknown

fn is_builtin(id: I32): Bool //< whether it is a built-in type's id
    //<
    //< Caution: **Do not write the limit as a number.** Add one built-in, and a limit written as a
    //< number goes stale. The type past it is then treated as "a type in another file": the same
    //< name, yet a diagnostic demanding an alias prefix.
    return id > I32::Builtin_type_id.unknown && id <= I32::Builtin_type_id.f64_type

fn is_void(id: I32): Bool
    return id == I32::Builtin_type_id.void_type

enum Info
    unknown
    void_type
    pointer(base_id: I32)
    array(base_id: I32, size: I32)
    const_of(base_id: I32) //<
        //< The immutable qualifier ("no marker" in KSPL's surface), a structural node
        //<
        //< Being a node keeps the pointee's or element's immutability separate from the view
        //< descriptor's. The canonical string puts immut_mark after (`U8 immut` / `U8[] immut`). As
        //< a prefix it would commute with `@` / `[]`, and slice(const_of(U8)) and
        //< const_of(slice(U8)) would become one.
    named //< Entry.str_repr already holds the same string, so it is not held twice here
    alias_type(base_id: I32)
    fn_type(sig: Fn_sig$@) //<
        //< A function pointer.
        //<
        //< Its canonical string `fn(P1,P2):R` is rebuilt from the parts. A composite built on one
        //< puts it in brackets, as the surface does (`(fn():I32)@`). So a pointer to a function
        //< pointer never shares a string with a function returning a pointer.
    struct_type(def: Struct_def$@)
    enum_type(def: Enum_def$@)
    trait_type(def: Trait_def$@)

priv fn close_of_group(s: U8[], open: Sz): I32 //<
    //< The position of the `)` closing the `(` at open; -1 if none
    $depth: I32 = 0
    for $i: = open; i < s.len; i += 1
        if s[i] == '('
            depth += 1
        else if s[i] == ')'
            depth -= 1
            if depth == 0
                return I32::i
    return -1

struct Instance //< one instance of a generic: the declaration it copies and what it binds
    //<
    //< **The names an instance goes by are derived from this, never read back from them.** They are
    //< its C name (instance_c_name_to) and its registration key (instance_key_to). Read back, a
    //< name could not tell `Box<|I32|>` declared in one file from a `Box` in another. Nor could it
    //< tell where the type's arguments end and a method's begin.
    template: U8[] //< the generic declaration's FQN (`std.ds.List`); never a short name
    args: I32[] //< the type ids bound to its type parameters, in the declaration's order

fn no_instance(): Instance //< the record of nothing: no template, no arguments
    return Instance::{ .template = "", .args = I32[]::{} }

struct Env
    type_to_id: Map<|U8[], I32|>$@
    id_to_type: List<|Entry$@|>$@
    instantiated_nodes: Map<|U8[], Ast_node$@|>$@
    instantiated_nodes_list: List<|Ast_node$@|>$@
    fn_templates: Map<|Sz, U8[]|>$@ //<
        //< each instantiated function's canonical template, by declaration
    instances: Map<|I32, Instance|>$@ //<
        //< What each instance's type id instantiates: the record instantiate_struct made it from
        //<
        //< It covers a struct's, enum's or trait's instantiation once it is complete.
        //< Caution: **Do not walk all of instantiated_nodes linearly looking for a type_id match.**
        //< That is O(N^2) over N instantiations, and a file writing many of them hangs the
        //< compilation.
    variance_masks: Map<|U8[], I32|>$@ //<
        //< A generic base's name -> the bits for which type-argument positions declare mutability
        //<
        //< A bit is 1 for a `struct Slice<|$T|>`. Written by register_template in
        //< `../decl/declare.kspl`; read by the variance comparison (`query.kspl`) and
        //< variance_stripped below. Keyed by base name, since the answer is the same for every
        //< instance.
    complex_types: List<|I32|>$@
    files: Map<|U8[], sema_type_scope.File_env$@|>$@
    empty_trait_list: List<|I32|>$@ //<
        //< The shared empty list implemented_trait_list returns for "zero conformances"
        //<
        //< So callers need no null check.
    arc_content_memo: Map<|I32, I32|>$@ //<
        //< Where type_has_arc_content's (sema/type/arc.kspl) answer is remembered across types.
        //<
        //< Caution: **Set it only once no more types are added** (only run in lower/root.kspl sets
        //< it). Set before the declarations are filled, it remembers a struct whose fields are
        //< still empty as "holding no ARC". Then no retain/release is inserted, and the value
        //< silently leaks. While it is null, the answer is computed per call.
    drop_content_memo: Map<|I32, I32|>$@ //<
        //< cached automatic-cleanup ownership once types are complete
    c_names_final: Bool //<
        //< Whether every type's name in the generated code is settled, so it is kept once spelled
        //<
        //< Caution: **Set it only once no more instances are recorded** (only run in
        //< lower/root.kspl sets it). Before that an instance's name can still change: the record
        //< that drops its immutability (variance_stripped below) arrives after its type id. A name
        //< kept from then gives one type two names, and C fails with `unknown type name`. A type
        //< lowering adds is complete before anything names it.

impl Info
    fn is_pointer(r: Self): Bool
        switch r
        case .pointer(_b)
            return true
        default
            return false
    fn is_array(r: Self): Bool
        switch r
        case .array(_b, _s)
            return true
        default
            return false
    fn is_const_of(r: Self): Bool
        switch r
        case .const_of(_b)
            return true
        default
            return false

impl Env
    fn source_fn_name(r: Self$@, node: Ast_node$@): U8[] //<
        //< a method's source name survives instantiation
        template: = r.fn_templates.get(Sz::node).unwrap_or("")
        return template.fqn_last() if template.len > 0 else node.get_decl_id_text()

    fn new(): Env$@
        type_to_id: = base_core.arena.create(Map<|U8[], I32|>.new_with_cap(4096, null))
        id_to_type: = base_core.arena.create(List<|Entry$@|>.new(null))
        instantiated_nodes: = base_core.arena
            .create(Map<|U8[], Ast_node$@|>.new_with_cap(1024, null))
        instantiated_nodes_list: = base_core.arena.create(List<|Ast_node$@|>.new(null))
        instances: = base_core.arena.create(Map<|I32, Instance|>.new_with_cap(1024, null))
        variance_masks: = base_core.arena
            .create(Map<|U8[], I32|>.new_with_cap(64, null))
        complex_types: = base_core.arena.create(List<|I32|>.new(null))
        files: = base_core.arena
            .create(Map<|U8[], sema_type_scope.File_env$@|>.new_with_cap(128, null))
        empty_trait_list: = base_core.arena.create(List<|I32|>.new(null))
        ptr: = base_core.arena
            .create(Env::{ .type_to_id = type_to_id, .id_to_type = id_to_type,
            .instantiated_nodes = instantiated_nodes,
            .instantiated_nodes_list = instantiated_nodes_list, .instances = instances,
            .fn_templates = base_core.arena.create(Map<|Sz, U8[]|>.new(null)),
            .variance_masks = variance_masks, .complex_types = complex_types, .files = files,
            .empty_trait_list = empty_trait_list, .arc_content_memo = null,
            .drop_content_memo = null, .c_names_final = false })

        dummy: = Entry.new(.unknown, base_core.arena.dup_str(base_core.UNKNOWN_TYPE_NAME))
        ptr.id_to_type.push(dummy)
        ptr.type_to_id.set(base_core.UNKNOWN_TYPE_NAME, 0)

        ptr.register("Void", I32::Builtin_type_id.void_type)
        ptr.register("Void@", I32::Builtin_type_id.void_ptr)
        ptr.register("Bool", I32::Builtin_type_id.bool_type)
        ptr.register("I8", I32::Builtin_type_id.i8_type)
        ptr.register("U8", I32::Builtin_type_id.u8_type)
        ptr.register("I16", I32::Builtin_type_id.i16_type)
        ptr.register("U16", I32::Builtin_type_id.u16_type)
        ptr.register("I32", I32::Builtin_type_id.i32_type)
        ptr.register("U32", I32::Builtin_type_id.u32_type)
        ptr.register("I64", I32::Builtin_type_id.i64_type)
        ptr.register("U64", I32::Builtin_type_id.u64_type)
        ptr.register("Sz", I32::Builtin_type_id.size_type)
        ptr.register("F32", I32::Builtin_type_id.f32_type)
        ptr.register("F64", I32::Builtin_type_id.f64_type)

        return ptr
    fn free(r: Self$@)
        r.type_to_id.free()
        r.id_to_type.free()
        r.instantiated_nodes.free()
        r.instantiated_nodes_list.free()
        r.fn_templates.free()
        r.instances.free()
        r.variance_masks.free()
        r.complex_types.free()
        // The list is allocated on the heap (this is mid-cleanup, so the arena is not grown).
        for entry in r.files.items()
            entry.value.free()
        r.files.free()
    fn find_main_symbol(r: Self$@): Sema_symbol$@? //<
        //< Returns the first function symbol "main" in any file (shared by both backends)
        $mains: = List<|Sema_symbol$@|>.new(base_core.arena)
        r.collect_main_symbols(mains@)
        return .some(mains.get(0)) if mains.len > 0 else .none
    fn collect_main_symbols(r: Self$@, out: List<|Sema_symbol$@|>$@) //<
        //< Collects every function declaring `main`, a generic one included
        //<
        //< Caution: **Do not stop at the first one found.** With two or more, `find_main_symbol`'s
        //< pick depends on the table's walk order; the count lets `check_one_main` in
        //< `sema/body/analyze.kspl` reject that form. A generic one is collected so that
        //< `check_main_signature` refuses it, rather than the linker finding no `main`.
        for m_entry in r.files.items()
            ms: = m_entry.value.symbols.get("main").unwrap_or(null)
            if ms != null && ms.kind.names_function()
                out.push(ms)
    fn find_backtrace_symbol(r: Self$@): Sema_symbol$@? //<
        //< The function start-up code calls to print the error trace when `main` returns a Result
        //<
        //< **This call is not in the tree.** The marking code (`mark_roots` in `lower/prune.kspl`)
        //< and the code emitting the call (the start-up code in `gen/c/root.kspl` and
        //< `gen/llvm/module.kspl`) must all go through here.
        file_env: = r.files.get(base_locate.LANG_FILE_PATH).unwrap_or(null)
        if file_env == null
            return .none
        ms: = file_env.symbols.get("print_trace").unwrap_or(null)
        if ms != null && ms.kind.is_function()
            return .some(ms)
        return .none
    fn has_type_named(r: Self$@, name: U8[]): Bool //<
        //< Checks whether that name is already registered as a type
        //<
        //< Caution: **Do not confuse it with get_or_add.** That one registers an absent name, so
        //< asking it "is it a type" turns a typo into a type that is accepted from then on.
        return r.type_to_id.get(name).unwrap_or(0) != 0

    priv fn lookup_entry_by_name(r: Self$@, name: U8[]): Entry$@? //<
        //< Looks up the instance Entry from a type name (an alias resolved to the real type)
        id: = r.type_to_id.get(name).unwrap_or(0)
        if id == 0
            return .none
        entry: = r.id_to_type.get(r.get_real_type(id))
        if entry != null
            return .some(entry)
        return .none

    fn methods_of(r: Self$@, name: U8[]): Map<|U8[], Sema_symbol$@|>$@? //<
        //< That type's method table
        //<
        //< **It can be absent** (the type is not registered yet, or it has no method). This one is
        //< for **enumerating** (completion lists every member); a lookup by name is
        //< `Entry.get_method`.
        if entry: = r.lookup_entry_by_name(name)
            if entry.methods != null
                return .some(entry.methods)
        return .none

    fn get_struct_def(r: Self$@, name: U8[]): Struct_def$@?
        if entry: = r.lookup_entry_by_name(name)
            switch entry.info
            case .struct_type(def)
                return .some(def)
            default {}
        return .none

    fn get_enum_def(r: Self$@, name: U8[]): Enum_def$@?
        if entry: = r.lookup_entry_by_name(name)
            switch entry.info
            case .enum_type(def)
                return .some(def)
            default {}
        return .none

    fn get_trait_def(r: Self$@, name: U8[]): Trait_def$@?
        if entry: = r.lookup_entry_by_name(name)
            switch entry.info
            case .trait_type(def)
                return .some(def)
            default {}
        return .none

    fn file_env_for(r: Self$@, file_name: U8[]): sema_type_scope.File_env$@ //<
        //< The name table of a file, made on its first request
        if file_env: = r.files.get(file_name)
            return file_env
        arena_fn: = base_core.arena.dup_str(file_name)
        made: = sema_type_scope.File_env.new(arena_fn)
        r.files.set(arena_fn, made)
        return made

    fn get_or_add(r: Self$@, type_str: U8[]): I32
        if res: = r.type_to_id.get(type_str)
            return res

        duped: = base_core.arena.dup_str(type_str)
        len: = duped.len
        $info: = Info.named
        $canonical_str_ptr: U8$[] = duped
        // A composite built on a function type puts it in brackets (`(fn():I32)@`).
        group_close: = close_of_group(duped, 0) if duped.starts_with("(") else -1
        if group_close == I32::len - 1
            return r.get_or_add(duped.sub(1, len - 2))
        // A function type's own parameter or result can be a slice, pointer or array ("fn():U8[]").
        // So its tail says nothing about the outer type, and its parts are read from the brackets
        // instead.
        if duped.starts_with("fn(")
            if sig: = r.fn_sig_from_str(duped)
                info = .fn_type(sig)
                canonical_str_ptr = r.fn_type_str(sig)
        else
            if duped.ends_with(base_core.IMMUT_MARK)
                // The immutable qualifier is postfix; a type name has no space, so it cannot
                // collide with the other tail checks.
                base_id: = r.get_or_add(duped.sub(0, len - base_core.IMMUT_MARK.len))
                return r.also_spelled(duped, r.make_const(base_id))
            if len >= 1 && (duped.ptr + len - 1)$ == '@'
                return r.also_spelled(duped,
                    r.make_ptr(r.get_or_add(duped.sub(0, len - 1))))
            bracket_idx: = duped.rfind_char_out('[')
            if len >= 3 && (duped.ptr + len - 1)$ == ']' && (duped.ptr + len - 2)$ != '[' &&
                bracket_idx > 0
                num_str: = duped.sub(bracket_idx + 1, len - bracket_idx - 2)
                base_id: = r.get_or_add(duped.sub(0, bracket_idx))
                $size_val: I32 = -1
                if !num_str.equals("_")
                    size_val = I32::(num_str.parse_size() catch 0)
                return r.also_spelled(duped, r.make_array(base_id, size_val))
            if duped.equals("Void")
                info = .void_type

        if !canonical_str_ptr.equals(duped)
            res2: = r.type_to_id.get(canonical_str_ptr).unwrap_or(-1)
            if res2 != -1
                r.type_to_id.set(duped, res2)
                return res2

        actual_new_id: = I32::r.id_to_type.len
        r.id_to_type.push(Entry.new(info, canonical_str_ptr))

        r.type_to_id.set(duped, actual_new_id)
        if !canonical_str_ptr.equals(duped)
            r.type_to_id.set(canonical_str_ptr, actual_new_id)

        r.note_if_complex(actual_new_id, info)
        return actual_new_id

    priv fn also_spelled(r: Self$@, spelling: U8[], id: I32): I32 //<
        //< Records `spelling` as another key for the composite id a `make_*` function registered
        //<
        //< Caution: **Build an immutable, pointer or array type only through its `make_*`**
        //< (make_const, make_ptr, make_array). A second builder would drift from their canonical
        //< string.
        r.type_to_id.set(spelling, id)
        return id

    priv fn note_if_complex(r: Self$@, id: I32, info: Info) //<
        //< Records in `complex_types` the types the generator declares before their use
        //<
        //< They are an array and a function type.
        //<
        //< Caution: **Keep which shapes count as "composite" here only.** Two generators walk this
        //< list as it is (`../../gen/c/root.kspl`, `../../gen/c/decl.kspl`). A condition written
        //< per registering function emits C where a type registered by only one of them has no
        //< forward declaration. Then **ksplc reports nothing and a later step fails**.
        switch info
        case .array(_b, _s)
            r.complex_types.push(id)
        case .fn_type(_sig)
            r.complex_types.push(id)
        default {}

    fn get_info(r: Self$@, id: I32): Info
        if id < 0 || id >= r.id_to_type.len
            return .unknown
        return r.id_to_type.get(id).info

    fn get_str(r: Self$@, id: I32): U8$[]
        known: = id >= 0 && id < r.id_to_type.len
        return r.id_to_type.get(id if known else I32::Builtin_type_id.unknown).str_repr

    priv fn register_type(r: Self$@, canonical_str: U8[], info: Info): I32 //<
        //< The low-level function registering a composite type (pointer / slice / array)
        //<
        //< Unlike get_or_add, Info is not guessed from the string: the caller assembles it.
        //< canonical_str is already the display, mangling and deduplication key.
        if res: = r.type_to_id.get(canonical_str)
            return res
        dup_str: = base_core.arena.dup_str(canonical_str)
        actual_new_id: = I32::r.id_to_type.len
        r.id_to_type.push(Entry.new(info, dup_str))
        r.type_to_id.set(dup_str, actual_new_id)
        r.note_if_complex(actual_new_id, info)
        return actual_new_id

    priv fn write_suffix_base(r: Self$@, out: Str_builder$@, base_id: I32) //<
        //< Writes the canonical string of the type a postfix applies to, a function type bracketed
        //<
        //< Caution: **Build every composite's string through here.** Unbracketed, a pointer to
        //< `fn():I32` spells `fn():I32@`, a function returning `I32@`, and the two share one id.
        switch r.get_info(base_id)
        case .fn_type(_sig)
            out.c('(').s(r.get_str(base_id)).c(')')
        default
            out.s(r.get_str(base_id))

    priv fn fn_sig_from_str(r: Self$@, s: U8[]): Fn_sig$@? //<
        //< Reads a function type's parts from its canonical string `fn(P1,P2):R`, registering each
        //<
        //< None where the string does not have that shape.
        close: = close_of_group(s, 2)
        if close < 0 || close + 1 >= s.len || s[close + 1] != ':'
            return .none
        params: = s.sub(3, close - 3)
        sig: = Fn_sig.new(r.get_or_add(s.sub_from(close + 2)))
        for pos in Range.asc(params.count_type_args())
            sig.params.push(r.get_or_add(params.nth_type_arg(pos)))
        return .some(sig)

    priv fn fn_type_str(r: Self$@, sig: Fn_sig$@): U8$[] //< a function type's canonical string
        $s: = Str_builder.new()
        s.s("fn(")
        for i in Range.asc(sig.params.len)
            if i > 0
                s.c(',')
            s.s(r.get_str(sig.params.get(i)))
        s.s("):").s(r.get_str(sig.ret_id))
        return base_core.arena.dup_str(s.slice())

    fn fn_sig_of(r: Self$@, id: I32): Fn_sig$@? //<
        //< The parts of the function type id stands for, aliases and the immutable mark stripped
        //<
        //< None for any other type, and for generic_fn_value_type_id's mark, which holds no
        //< signature.
        switch r.get_info(r.get_clean_real_type(id))
        case .fn_type(sig)
            return .some(sig)
        default
            return .none

    priv fn make_suffixed_ref(r: Self$@, base_id: I32, suffix: U8[], info: Info): I32 //<
        //< Registers a simple composite type whose string is base_id's canonical string plus suffix
        if is_unknown(base_id)
            return I32::Builtin_type_id.unknown
        $s: = Str_builder.new()
        r.write_suffix_base(s@, base_id)
        s.s(suffix)
        return r.register_type(s.slice(), info)

    fn make_ptr(r: Self$@, base_id: I32): I32
        return r.make_suffixed_ref(base_id, "@", .pointer(base_id))

    fn make_const(r: Self$@, base_id: I32): I32 //<
        //< Returns the type id with the immutable qualifier added to the base type
        //<
        //< The internal representation puts it after, as `base + immut_mark`.
        //< The immutable mark's string is built only here, so no two places disagree.
        if r.is_const(base_id)
            return base_id
        $b: = Str_builder.new()
        r.write_suffix_base(b@, base_id)
        b.s(base_core.IMMUT_MARK)
        return r.register_type(b.slice(), .const_of(base_id))

    fn make_array(r: Self$@, base_id: I32, size: I32): I32 //< an array
        //<
        //< size<0 means "unspecified" (decided later from the element count) and is "[_]" in the
        //< canonical string.
        if is_unknown(base_id)
            return I32::Builtin_type_id.unknown
        $s: = Str_builder.new()
        r.write_suffix_base(s@, base_id)
        if size >= 0
            s.s("[\{size\}]")
        else
            s.s("[_]")
        return r.register_type(s.slice(), .array(base_id, size))

    fn generic_fn_value_type_id(r: Self$@): I32 //<
        //< The mark a function's name used as a value takes where no type is expected
        //<
        //< A function's name takes its type from where it is written (fn_value_type_id in
        //< sema/body/resolve_path.kspl). That is a generic call's parameter
        //< (sema/body/call_args.kspl), or the other side of a comparison (sema/body/binary.kspl).
        //< With nothing expected, it is only "a function". This fixed string tells is_fn_ptr "a
        //< function pointer, not a scalar". It differs from the "fn(...)" that fn_signature_type_id
        //< in sema/decl/resolve.kspl builds.
        return r.get_or_add("fn.type_fn_sig")

    fn add_implemented_trait(r: Self$@, target_id: I32, trait_id: I32)
        clean_id: = r.strip_ptr(target_id)
        if clean_id < 0 || clean_id >= r.id_to_type.len
            return
        entry: = r.id_to_type.get(clean_id)
        entry.add_trait(trait_id)

    fn implements_trait(r: Self$@, target_id: I32, trait_id: I32): Bool //<
        //< The immutable qualifier is ignored in the comparison
        //<
        //< "Can the value be rewritten" is independent of "which impl applies", and
        //< collect_impl_decl forbids an immutable impl target. Every type is immutable by default,
        //< so without this no trait implementation would ever match.
        clean_id: = r.strip_const_deep(r.get_clean_real_type(r.strip_ptr(target_id)))
        if clean_id < 0 || clean_id >= r.id_to_type.len
            return false
        return r.id_to_type.get(clean_id).has_trait(trait_id)

    priv fn implemented_trait_list(r: Self$@, target_id: I32): List<|I32|>$@ //<
        //< Returns, for iteration, the list of traits target_id conforms to
        //<
        //< Where there is none it returns the empty list, never null.
        clean_id: = r.strip_const_deep(target_id)
        if clean_id >= 0 && clean_id < r.id_to_type.len
            list: = r.id_to_type.get(clean_id).implemented_traits
            if list != null
                return list
        return r.empty_trait_list

    fn has_implemented_trait_fqn(r: Self$@, target_id: I32, trait_fqn: U8[]): Bool //<
        //< Whether target_id conforms to "a trait whose FQN is trait_fqn itself"
        //<
        //< It serves the non-generic compiler-known traits Ref_counted / Move_only.
        want_id: = r.type_to_id.get(trait_fqn).unwrap_or(0)
        if want_id == 0
            // That trait is not in this compilation unit (= nobody conforms to it).
            return false
        want_real: = r.get_real_type(want_id)
        for i_id in r.implemented_trait_list(target_id)
            if r.get_real_type(i_id) == want_real
                return true
        return false

    fn has_implemented_operator_trait(r: Self$@, target_id: I32, trait_name: U8[]): Bool //<
        //< Whether target_id conforms to a std/lang operator trait (Add, Index_place, Cast, …)
        //<
        //< Never by a prefix or suffix match: `Index_` prefixes `Index_place_`, and a suffix match
        //< lets a trait `Add` in one's own file count as an operator. Every compiler-known trait is
        //< checked this way.
        $want: = Str_builder.new()
        want.s("std.lang.\{trait_name\}")

        for i_id in r.implemented_trait_list(target_id)
            // Where it is registered in a form carrying no generic actual arguments (a conformance
            // to the template itself).
            if r.get_str(r.get_real_type(i_id)).equals(want.slice())
                return true
        return r.implemented_trait_instance(target_id, want.slice()) != 0

    fn implemented_trait_instance(r: Self$@, target_id: I32, base_fqn: U8[]): I32 //<
        //< The instance of the generic trait base_fqn that target_id conforms to, or 0 for none
        //<
        //< An example is the `std.lang.Callable1<|I32, I64|>` a closure conforms to.
        //< **It serves a form whose type arguments cannot be inferred from the actual argument.**
        //< Caution: The template is matched exactly (the same reason as above).
        for i_id in r.implemented_trait_list(target_id)
            real: = r.get_real_type(i_id)
            if r.instance_base(real).equals(base_fqn)
                return real
        return 0

    fn register(r: Self$@, name: U8$[], expected_id: I32)
        // Caution: **A built-in landing on another ID is the compiler's own fault, and stops it.**
        // Printed and passed, every later use of that ID reads the wrong type.
        if r.get_or_add(name) == expected_id
            return
        $msg: = Str_builder.new()
        msg.s("built-in type '\{name\}' did not get its fixed ID")
        base_diag.ice_panic(msg.slice())

    fn variance_stripped(r: Self$@, type_id: I32): Instance? //<
        //< An instance with **the immutability dropped where the declaration declared it**
        //<
        //< None if there is nothing to drop. **The C name is written from this**, or `Box<|$I32|>`
        //< and `Box<|I32|>` become different C structs and C rejects the weakening KSPL allows.
        //< **The KSPL types stay two**: the `p` of `Box<|I32|>` stays `I32@` and KSPL rejects the
        //< write.
        switch r.instance_of(type_id)
        case .some(inst)
            return r.strip_variance(inst)
        case .none
            return .none

    fn strip_variance(r: Self$@, inst: Instance): Instance? //<
        //< inst with the **outer** immutability dropped at the positions its template declared
        //<
        //< None where none is dropped. Only the outer one: the element's or pointee's is the
        //< argument's own.
        mask: = r.variance_masks.get(inst.template).unwrap_or(0)
        if mask == 0
            return .none
        $args: = List<|I32|>.new(base_core.arena)
        $changed: = false
        for i in Range.asc(inst.args.len)
            a: = inst.args[i]
            if base_ast.variance_names_mut(mask, i) && r.is_const(a)
                args.push(r.strip_const(a))
                changed = true
            else
                args.push(a)
        if !changed
            return .none
        return .some(Instance::{ .template = inst.template, .args = args.slice() })

    fn note_instance(r: Self$@, type_id: I32, inst: Instance) //<
        //< Records what the instance type_id instantiates (its arguments copied into the arena)
        $args: = List<|I32|>.new(base_core.arena)
        for a in inst.args
            args.push(a)
        r.instances
            .set(type_id,
            Instance::{ .template = base_core.arena.dup_str(inst.template),
            .args = args.slice() })

    fn instance_of(r: Self$@, type_id: I32): Instance? //<
        //< What type_id instantiates, if it is an instance of a generic
        //<
        //< type_id is taken as it is: strip an alias or an immutable qualifier first where it
        //< applies.
        return r.instances.get(type_id)

    fn instance_base(r: Self$@, type_id: I32): U8[] //<
        //< The generic's FQN (`std.lang.Slice`) if type_id is an instance of one, else ""
        //<
        //< Caution: **Ask this rather than reading the mangled name's shape**, which breaks
        //< silently when the mangling rule changes. An instance's type cannot be told from a plain
        //< struct.
        switch r.instance_of(type_id)
        case .some(inst)
            return inst.template
        case .none
            return ""

    fn instance_arg(r: Self$@, type_id: I32, pos: Sz): I32 //<
        //< The type id bound to the pos-th type parameter if type_id is an instance, else 0
        switch r.instance_of(type_id)
        case .some(inst)
            return inst.args[pos] if pos < inst.args.len else 0
        case .none
            return 0

    fn instance_args(r: Self$@, type_id: I32): I32[] //<
        //< The type ids bound to type_id's type parameters if it is an instance, else empty
        switch r.instance_of(type_id)
        case .some(inst)
            return inst.args
        case .none
            return I32[]::{}

    fn slice_struct_elem(r: Self$@, type_id: I32): I32 //<
        //< The element's type id if it is a `Slice<|T|>` instance, else 0.
        // **Strip an immutable qualifier on the descriptor itself first** (`U8$[] immut`), or a
        // slice held by a read-only binding answers "not a slice".
        real_id: = r.get_clean_real_type(type_id)
        if !r.instance_base(real_id).equals(base_core.SLICE_FQN)
            return 0
        return r.instance_arg(real_id, 0)

// It releases what it owns with `free()`; see `Manual_free` in std/lang.kspl for why it conforms.
impl Env: Manual_free {}

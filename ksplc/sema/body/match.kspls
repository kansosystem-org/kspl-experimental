import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/sema/body/expr" as sema_body_expr
import "ksplc/sema/body/lint_stmt" as sema_body_lint_stmt
import "ksplc/sema/body/stmt" as sema_body_stmt
import "ksplc/sema/session/ctx" as sema_session_ctx + { Sema_ctx, Sema_error }
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" as sema_type_scope + { Sema_symbol }
import "std/ds" { List }
import "std/str"

priv struct Match_ctx
  target_id: I32
  enum_name: U8[]
  is_enum: Bool
  enum_def: sema_type_def.Enum_def$@
  matched_variants: List<|Ast_node$@|>$@
  bound_vars: List<|Sema_symbol$@|>$@
  success: Bool

impl Ast_node
  fn infer_match_stmt(r: Ast_node$@, ctx: Sema_ctx$@): Void?Sema_error
    label_node: = r.get_match_label()
    label_name: = label_node.text if label_node != null else ""
    ctx.jump_stack
      .push(sema_session_ctx.Jump_label::{ .name = label_name, .is_loop = false,
      .name_node = label_node, .stmt = r })
    defer ctx.jump_stack.len -= 1

    cond_node: = r.get_match_cond()
    r.ice_assert(cond_node != null, "switch statement is missing a condition expression")

    if base_core.config.run_lint_checks && cond_node.was_parenthesized()
      ctx.hint(cond_node, "[H0311] Unnecessary parentheses around 'switch' condition.")
    sema_body_lint_stmt.lint_multiline_call_subject(ctx, cond_node, "switch")

    target_id: = cond_node.infer_expr(ctx, I32::sema_type_env.Builtin_type_id.unknown)?
    enum_name: = ctx.env.get_str(target_id)
    $enum_def: sema_type_def.Enum_def$@ = null
    if d: = ctx.env.get_enum_def(enum_name)
      enum_def = d

    // A switch synthesized to unwrap an `Option` is accepted only where the subject is one;
    // **otherwise errors mention a `.some` / `.none` the user did not write.** Once expanded it
    // looks ordinary, so the mark identifies it (`synthesized_option_spelling` in
    // `../../base/ast_ext.kspls`). **Name what the user wrote**: the synthesis has several origins.
    spelling: = r.synthesized_option_spelling()
    // Caution: **Apply it to `Option` only**, which has exactly two variants; a user's enum can
    // grow, and then **a new variant silently goes unhandled**.
    // **Check the resolved name, not the written one**, or `typedef Opt = Option<|W|>` is rejected
    // while a `switch` on the same value passes. The message still names what the user wrote.
    subject_base: = ctx.env.instance_base(ctx.env.get_clean_real_type(target_id))
    if spelling.len > 0 && !subject_base.equals(sema_type_env.option_fqn)
      ctx.clear_scratch()
        .s("'\{spelling\}' binds an 'Option'; '\{enum_name\}' is not one. Use 'switch' and name \
          every variant, so that adding one later makes this place fail instead of passing silently")
      ctx.err(cond_node, ctx.scratch.slice())
      throw Sema_error.analysis_failed

    // Scalars only ("Branching" in docs/SPEC-language.md). **If not rejected, the C compiler
    // reports it**: a slice in C's `switch` is a **raw C error** ("Failing fast through an
    // exception or an ICE" in ksplc/docs/DESIGN.md). The rule exists because comparing a `U8[]` is
    // O(N), which `.equals()` and an `if` show rather than hide behind a branch.
    if enum_def == null && !ctx.env.is_integer(target_id) &&
      !sema_type_env.is_unknown(target_id)
      ctx.clear_scratch()
        .s("cannot 'switch' on '\{ctx.env.get_str(target_id)\}': only scalars (integers, 'Bool', \
          enums) can be matched. Comparing anything else hides an O(N) cost behind a branch; use \
          'if' with '.equals()' instead")
      ctx.err(cond_node, ctx.scratch.slice())
      throw Sema_error.analysis_failed

    $mctx: = Match_ctx::{ .target_id = target_id, .enum_name = enum_name,
      .is_enum = enum_def != null, .enum_def = enum_def,
      .matched_variants = base_ast.new_ast_node_list(),
      .bound_vars = List<|Sema_symbol$@|>.create(base_core.arena), .success = true }

    $has_default: = false

    for $j: Sz = 0; j < r.children.len; j += 1
      child: = r.get_child(j)
      if child.is_keyword("case")
        j = r.infer_match_case(ctx, mctx@, j + 1)?
      else if child.is_keyword("default")
        has_default = true
        r.infer_match_default(ctx, mctx@, j + 1)

    if !r.process_match_exhaustiveness(ctx, enum_name, enum_def, mctx.matched_variants, has_default)
      mctx.success = false
    else if base_core.config.run_lint_checks && has_default && enum_def != null
      r.check_redundant_default(ctx, mctx@)

    if !mctx.success
      throw Sema_error.analysis_failed
  priv fn infer_match_default(r: Ast_node$@, ctx: Sema_ctx$@, mctx: Match_ctx$@, start_idx: Sz)
    $def_block: Ast_node$@ = null
    for $k: = start_idx; k < r.children.len; k += 1
      if r.get_child(k).kind_id == .k_stmt_block
        def_block = r.get_child(k)
        break
    if def_block != null
      ctx.symtab.enter_scope()
      defer ctx.symtab.exit_scope()
      def_block.infer_stmts(ctx) catch
        mctx.success = false
  priv fn check_redundant_default(r: Ast_node$@, ctx: Sema_ctx$@, mctx: Match_ctx$@)
    if mctx.matched_variants.len == mctx.enum_def.variants_list.len
      for child in r.children
        if child.is_keyword("default")
          ctx.information(child,
            "[I0304] Redundant 'default' case: all variants of the enum are already covered.")
          break

  priv fn infer_match_case(r: Ast_node$@, c: Sema_ctx$@, mctx: Match_ctx$@, start_idx: Sz):
    Sz?Sema_error
    $pat_idx: = start_idx
    $target_block: Ast_node$@ = null
    $block_idx: I32 = -1

    for $k: = pat_idx; k < r.children.len; k += 1
      c_node: = r.get_child(k)
      if c_node.kind_id == .k_stmt_block
        target_block = c_node
        block_idx = I32::k
        break
      if c_node.is_keyword("case") || c_node.is_keyword("default")
        break

    mctx.bound_vars.len = 0
    c.symtab.enter_scope()
    defer c.symtab.exit_scope()
    $bound_payload: = false

    for pat_idx < r.children.len
      pat: = r.get_child(pat_idx)
      if pat.kind_id == .k_match_pattern
        bound_payload = pat.infer_match_pattern(c, mctx, bound_payload)?
        pat_idx += 1
      else if pat.is_literal(",")
        pat_idx += 1
      else
        if pat.kind_id == .k_stmt_block || pat.kind_id == .k_keyword
          break
        pat_type_id: = pat.infer_expr(c, mctx.target_id)?
        if !pat.check_match_pattern_type(c, pat_type_id, mctx.target_id)
          mctx.success = false
        pat_idx += 1

    if target_block != null
      target_block.infer_stmts(c) catch
        mctx.success = false

    return block_idx if block_idx != -1 else pat_idx - 1

  priv fn infer_match_pattern(r: Ast_node$@, c: Sema_ctx$@, mctx: Match_ctx$@, bound_payload: Bool):
    Bool?Sema_error
    r.ice_assert(r.children.len > 0, "infer_match_stmt: match_pattern is empty")
    first_child: = r.get_child(0)
    $processed_as_variant: = false
    $new_bound_payload: = bound_payload

    switch r.extract_match_variant() case .variant(v_name_node, p_start_idx)
      if mctx.is_enum
        new_bound_payload = r.process_enum_variant(c, mctx, v_name_node, p_start_idx,
          new_bound_payload)
        processed_as_variant = true
      else
        if first_child.is_literal(".")
          c.clear_scratch()
            .s("target condition '\{mctx.enum_name\}' is not an enum, variant pattern cannot be \
              used")
          c.err(first_child, c.scratch.slice())
          mctx.success = false
          processed_as_variant = true

      if !processed_as_variant
        r.process_non_enum_pattern(c, mctx, first_child, v_name_node)?
    case .not_variant
      r.process_non_enum_pattern(c, mctx, first_child, null)?
    return new_bound_payload

  priv fn process_enum_variant(r: Ast_node$@, c: Sema_ctx$@, mctx: Match_ctx$@,
    v_name_node: Ast_node$@, p_start_idx: Sz, bound_payload: Bool): Bool
    $new_bound: = bound_payload

    variant_name: = v_name_node.text if v_name_node != null else ""
    $variant_def: sema_type_def.Enum_variant$@ = null
    if variant_name.len > 0
      if d: = mctx.enum_def.get_variant(variant_name)
        variant_def = d

    if variant_def != null
      if v_name_node != null
        v_name_node.def_node = variant_def.node
        v_name_node.type_id = mctx.target_id
        sema_body_expr.mark_variant_used(c, mctx.enum_name, variant_name)

      // In an OR pattern (.A(x), .B(y)) the first binds; the rest are checked against
      // mctx.bound_vars.
      if !new_bound
        r.bind_variant_payload(c, mctx, variant_def, p_start_idx)
        new_bound = true
      else
        r.verify_variant_payload(c, mctx, variant_def, p_start_idx)

      if v_name_node != null
        record_matched_variant(c, mctx, variant_name, v_name_node)
    else if r.get_child(0).is_literal(".")
      c.clear_scratch().s("enum '\{mctx.enum_name\}' has no variant named '\{variant_name\}'")
      if v_name_node != null
        c.err(v_name_node, c.scratch.slice())
      else
        c.err(r, c.scratch.slice())
      mctx.success = false
    return new_bound

  priv fn bind_variant_payload(r: Ast_node$@, c: Sema_ctx$@, mctx: Match_ctx$@,
    variant_def: sema_type_def.Enum_variant$@, p_start_idx: Sz)
    $field_idx: Sz = 0
    for $k_b: = p_start_idx; k_b < r.children.len; k_b += 1
      bind_var: = r.get_child(k_b)
      if bind_var.kind_id == .k_identifier
        sym: = Sema_symbol.new(sema_type_scope.Sym_kind.variable, bind_var.text, bind_var)
        if field_idx < variant_def.payload_fields.len
          field_def: = variant_def.payload_fields.get(field_idx)
          sym.type_id = field_def.type_id
        else
          sym.type_id = c.env.get_or_add("I32")
        c.declare_symbol(bind_var.text, sym, false)
        mctx.bound_vars.push(sym)
        field_idx += 1

  priv fn verify_variant_payload(r: Ast_node$@, c: Sema_ctx$@, mctx: Match_ctx$@,
    variant_def: sema_type_def.Enum_variant$@, p_start_idx: Sz)
    $field_idx: Sz = 0
    $bound_count: Sz = 0

    for $k_b: = p_start_idx; k_b < r.children.len; k_b += 1
      bind_var: = r.get_child(k_b)
      if bind_var.kind_id == .k_identifier
        bound_count += 1
        if field_idx < mctx.bound_vars.len
          expected_sym: = mctx.bound_vars.get(field_idx)
          if !bind_var.text.equals(expected_sym.name)
            c.clear_scratch()
              .s("OR pattern variable name mismatch. Expected '\{expected_sym.name\}', but got \
                '\{bind_var.text\}'")
            c.err(bind_var, c.scratch.slice())
            mctx.success = false
          $actual_type_id: = c.env.get_or_add("I32")
          if field_idx < variant_def.payload_fields.len
            actual_type_id = variant_def.payload_fields.get(field_idx).type_id
          if actual_type_id != expected_sym.type_id
            $exp: = c.env.display_str(expected_sym.type_id)
            $act: = c.env.display_str(actual_type_id)
            defer
              exp.free()
              act.free()
            c.clear_scratch()
              .s("OR pattern variable '\{bind_var.text\}' type mismatch. Expected \
                '\{exp.slice()\}', but got '\{act.slice()\}'")
            c.err(bind_var, c.scratch.slice())
            mctx.success = false
          bind_var.sym_ptr = Void$@::expected_sym
          bind_var.def_node = expected_sym.node
        field_idx += 1
    // An OR pattern's later arms may omit the names; then only the payload's count and types are
    // checked against the first arm's.
    if bound_count == 0 && mctx.bound_vars.len > 0
      if variant_def.payload_fields.len != mctx.bound_vars.len
        c.clear_scratch()
          .s("variant '\{variant_def.name\}' payload count (\{variant_def.payload_fields.len\}) \
            does not match the captured variables (\{mctx.bound_vars.len\}) for smart capture")
        c.err(r, c.scratch.slice())
        mctx.success = false
      else
        for $i: = 0; i < mctx.bound_vars.len; i += 1
          expected_sym: = mctx.bound_vars.get(i)
          actual_type_id: = variant_def.payload_fields.get(i).type_id
          if actual_type_id != expected_sym.type_id
            c.clear_scratch()
              .s("variant '\{variant_def.name\}' payload type mismatch for smart capture")
            c.err(r, c.scratch.slice())
            mctx.success = false
    else if bound_count != mctx.bound_vars.len
      c.clear_scratch()
        .s("OR pattern variable count mismatch. Expected \{mctx.bound_vars.len\}, but got \
          \{bound_count\}")
      c.err(r, c.scratch.slice())
      mctx.success = false

  priv fn process_non_enum_pattern(r: Ast_node$@, c: Sema_ctx$@, mctx: Match_ctx$@,
    first_child: Ast_node$@, v_name_node: Ast_node$@): Void?Sema_error
    $pat_expr: Ast_node$@ = null
    switch r.first_expr() case .some(pe)
      pat_expr = pe
    case .none
      pat_expr = first_child
    pat_type_id: = pat_expr.infer_expr(c, mctx.target_id)?
    if !pat_expr.check_match_pattern_type(c, pat_type_id, mctx.target_id)
      mctx.success = false
    else if mctx.is_enum && v_name_node != null
      v_name: = v_name_node.text
      if v_name.len > 0
        record_matched_variant(c, mctx, v_name, v_name_node)

  fn check_match_pattern_type(r: Ast_node$@, c: Sema_ctx$@, pat_id: I32, cond_id: I32): Bool
    if pat_id != cond_id && !sema_type_env.is_unknown(pat_id) &&
      !sema_type_env.is_unknown(cond_id)
      c.report_type_mismatch(r, cond_id, pat_id)
      return false
    return true

  fn process_match_exhaustiveness(r: Ast_node$@, c: Sema_ctx$@, enum_name: U8$[],
    enum_def: sema_type_def.Enum_def$@, matched_variants: List<|Ast_node$@|>$@, has_default: Bool):
    Bool
    if has_default
      return true
    if enum_def == null
      c.err(r, "switch on non-enum type requires a 'default' case.")
      return false

    $unhandled: Sz = 0
    $first_unhandled: = ""

    for variant_def in enum_def.variants_list
      $is_matched: = false
      for matched_variant in matched_variants
        if matched_variant.text.equals(variant_def.name)
          is_matched = true
          break
      if !is_matched
        unhandled += 1
        if first_unhandled.len == 0
          first_unhandled = variant_def.name

    if unhandled > 0
      c.clear_scratch()
        .s("switch on enum '\{enum_name\}' does not cover all variants. Missing: \
          '\{first_unhandled\}'")
      if unhandled > 1
        c.scratch.s(" and others")
      c.err(r, c.scratch.slice())
      return false
    return true

priv fn record_matched_variant(c: Sema_ctx$@, mctx: Match_ctx$@, variant_name: U8[],
  v_name_node: Ast_node$@)
  $already_covered: = false
  for mv_node in mctx.matched_variants
    if mv_node.text.equals(variant_name)
      already_covered = true
      break
  if !already_covered
    mctx.matched_variants.push(v_name_node)
  else
    c.clear_scratch().s("switch pattern '\{variant_name\}' is already covered or duplicated.")
    c.err(v_name_node, c.scratch.slice())
    mctx.success = false

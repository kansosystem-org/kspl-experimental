//< Infers a generic call's type arguments from its actual arguments, where no `<|…|>` is written
//< Each parameter's written type is walked against its argument's type id, part by part. The parts
//< are a pointer's target, an array's element and a result's two sides. They are also a generic's
//< or a conformed trait's arguments, and a function type's parameters and result. A type parameter
//< binds where it stands bare. A `const` parameter binds where it stands as an array's length or as
//< a generic's value argument. One no argument binds is refused here, with the form to write.
import "ksplc/base/ast" { Ast_node, variance_names_mut }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as _base_ast_place // `is_const_gen_param`
import "ksplc/base/ast_spell" as _base_ast_spell // `get_decl_id_text`
import "ksplc/base/core" as base_core
import "ksplc/sema/body/literal" as sema_body_literal
import "ksplc/sema/decl/name" as _sema_decl_name
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/display" as _sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as _sema_type_query
import "std/chars"
import "std/ds" { List }

priv struct Pairing //< one formal parameter and the argument that fills it
    param: Ast_node$@
    arg: Ast_node$@
    arg_id: I32 //< the argument's own type (a function's name gives its function type)

priv struct Bindings //< what a call binds each of the callee's own type parameters to
    names: List<|U8[]|>$@ //< the parameters' names, in the declaration's order
    is_value: List<|Bool|>$@ //< whether that one is a `const` parameter
    ids: List<|I32|>$@ //< the type each is bound to; unknown while no argument has bound it
    bound_by: List<|Pairing|>$@ //< the pair whose argument bound each, for a conflict's report
    pair: Pairing //< the pair being walked
    callee: U8[] //< the called function's name, for a conflict's report
    is_refused: Bool //< whether two arguments fixed one `const` parameter to different values

priv fn bindings_of(gen_params: Ast_node@, callee: U8[]): Bindings //<
    //< One unbound slot per type parameter
    b: = Bindings::{ .callee = callee, .names = List<|U8[]|>.create(base_core.arena),
        .is_value = List<|Bool|>.create(base_core.arena),
        .ids = List<|I32|>.create(base_core.arena),
        .bound_by = List<|Pairing|>.create(base_core.arena) }
    for gp in gen_params.children
        name: = gp.gen_param_name()
        if name.len == 0
            continue
        b.names.push(name)
        b.is_value.push(gp.is_const_gen_param())
        b.ids.push(I32::sema_type_env.Builtin_type_id.unknown)
        b.bound_by.push(::{})
    return b

priv fn bind_name(ctx: Sema_ctx@, bindings: Bindings$@, name: U8[], arg_id: I32) //<
    //< Binds the type parameter called name to arg_id; the first argument to reach it wins
    //< **The type is taken with its immutability.** `pick(v@)` on an immutable `v` binds `T` of
    //< `a: T$@` to the immutable type. So the call is accepted, and a write through `a` is refused
    //< in the instance. With the immutability dropped, the same call would be refused at the call.
    //< **A later argument can only add that immutability**: after `xs: T[]` bound `T` to `I32`,
    //< an immutable `v@` for `a: T$@` makes it the immutable `I32`, as it would have coming first.
    for i in Range.asc(bindings.names.len)
        if !bindings.names.get(i).equals(name) || bindings.is_value.get(i)
            continue
        bound: = bindings.ids.get(i)
        if sema_type_env.is_unknown(bound) ||
            (ctx.env.is_const(arg_id) && ctx.env.strip_const(arg_id) == bound)
            bindings.ids.set(i, arg_id)

priv fn own_read_only(ctx: Sema_ctx@, part_id: I32, names_mut: Bool): I32 //<
    //< The type a parameter's part binds, given the target or element found in the argument
    //< **A read-only mark the parameter writes itself is not the type parameter's.** `xs: T[]`
    //< and `p: T@` say "read-only" in their own spelling, so an `I32[]` binds `T` to `I32`. Taken
    //< with the mark, `T` was the immutable `I32`, and a `Box<|T|>` beside it refused a
    //< `Box<|I32|>`. Where the parameter writes `$` (`T$@`, names_mut), the argument's own
    //< immutability is `T`'s (`bind_name`).
    return part_id if names_mut else ctx.env.strip_const(part_id)

priv fn bind_value(ctx: Sema_ctx$@, bindings: Bindings$@, written: Ast_node$@, value_id: I32) //<
    //< Binds the `const` parameter written names to the value the argument has there
    //< The value is an array's length or a generic's value argument, one type id per value (`8`).
    //< So an array of 8 and a `Buf<|8|>` fix it alike.
    //< **A second argument fixing it to another value refuses the call**, naming both. Otherwise
    //< the instance either one would choose refuses the other's argument, blaming only that one.
    name: = written.bare_written_name()
    if name.len == 0 || sema_type_env.is_unknown(value_id)
        return
    for i in Range.asc(bindings.names.len)
        if !bindings.names.get(i).equals(name) || !bindings.is_value.get(i)
            continue
        if sema_type_env.is_unknown(bindings.ids.get(i))
            bindings.ids.set(i, value_id)
            bindings.bound_by.set(i, bindings.pair)
        else if bindings.ids.get(i) != value_id && !bindings.is_refused
            bindings.is_refused = true
            first: = bindings.bound_by.get(i)
            ctx.clear_scratch()
                .s("cannot infer the const parameter '\{name\}' of '\{bindings.callee\}'. The \
                    argument for '\{first.param.get_decl_id_text()\}' (type \
                    '\{ctx.env.display(first.arg_id)\}') fixes it to \
                    \{ctx.env.display(bindings.ids.get(i))\}. The argument for \
                    '\{bindings.pair.param.get_decl_id_text()\}' (type \
                    '\{ctx.env.display(bindings.pair.arg_id)\}') fixes it to \
                    \{ctx.env.display(value_id)\}\n  Hint: pass arguments that agree on '\{name\}'")
            ctx.err(bindings.pair.arg, ctx.scratch.slice())

priv fn bind_type(ctx: Sema_ctx$@, bindings: Bindings$@, written: Ast_node$@, arg_id: I32) //<
    //< Walks a written parameter type against its argument's type, binding the names it meets
    //< Where the two shapes part, the walk stops. Then the arguments' check after the instantiation
    //< reports the mismatch, or no binding is left for the refusal of an unbound parameter.
    if written == null || sema_type_env.is_unknown(arg_id)
        return
    switch written.kind_id
    case .k_type_arg
        // `$T`: the mark is a literal before the type.
        bind_type(ctx, bindings, written.last_child(), arg_id)
    case .k_type_expr
        bind_type_expr(ctx, bindings, written, arg_id)
    case .k_type_atom
        // An atom holds one type, a function type's `fn` keyword or a group's `(` before it.
        for ch in written.children
            if ch.kind_id != .k_literal && ch.kind_id != .k_keyword
                bind_type(ctx, bindings, ch, arg_id)
                return
        bind_name(ctx, bindings, written.text, arg_id)
    case .k_type_path, .k_expr_path
        bind_path(ctx, bindings, written, arg_id)
    case .k_type_fn_sig
        bind_fn_sig(ctx, bindings, written, arg_id)
    case .k_identifier
        bind_name(ctx, bindings, written.text, arg_id)
    default {}

priv fn bind_type_expr(ctx: Sema_ctx$@, bindings: Bindings$@, written: Ast_node@, arg_id: I32) //<
    //< A type and its postfixes: each postfix, outermost first, peels one level off the argument
    $base: Ast_node$@ = null
    $posts: = List<|Ast_node$@|>(base_core.arena)
    for ch in written.children
        if ch.kind_id == .k_type_postfix
            posts.push(ch)
        else if base == null && ch.kind_id != .k_literal
            base = ch
    $cur: = arg_id
    for $i: = posts.len; i > 0; i -= 1
        p: = posts.get(i - 1)
        pt: = p.text.strip_prefix("$")
        switch ctx.env.get_info(ctx.env.get_clean_real_type(cur))
        case .pointer(pointee)
            if !pt.equals("@")
                return
            cur = own_read_only(ctx, pointee, p.text.starts_with("$"))
        case .array(elem, size)
            if !pt.starts_with("[")
                return
            if p.children.len > 0 && size >= 0
                bind_value(ctx, bindings, p.get_child(0),
                    ctx.env.get_or_add(ctx.clear_scratch().s("\{size\}").slice()))
            cur = elem
        default
            return
    if base == null
        bind_name(ctx, bindings, written.text, cur)
    else
        bind_type(ctx, bindings, base, cur)

priv fn bind_path(ctx: Sema_ctx$@, bindings: Bindings$@, path: Ast_node$@, arg_id: I32) //<
    //< A named type: a type parameter itself, or a generic whose arguments are walked in turn
    //< The argument's own instance answers when it is one of the same generic, else the instance
    //< of that generic trait it conforms to (a closure's `Callable1<|I32, I64|>`). The generic is
    //< named by `read_written_type`, so an import alias or a renamed import reads as its FQN.
    //< Where the generic's own parameter is `const`, the argument there is a value (`Buf<|8|>`).
    written: = ctx.read_written_type(path)
    if written.args == null
        if written.member == null && written.alias_file.len == 0
            bind_name(ctx, bindings, written.name, arg_id)
        return
    $fqn: = written.fqn
    if path.is_sugar_made()
        // `T?`, `T!E` and `T[]` are written as their generic's last word, with no file.
        if written.name.equals(base_core.option_ident())
            fqn = base_core.OPTION_FQN
        else if written.name.equals(base_core.result_ident())
            fqn = base_core.RESULT_FQN
        else
            fqn = base_core.SLICE_FQN
    real: = ctx.env.get_clean_real_type(arg_id)
    $args: = ctx.env.instance_args(real)
    if !ctx.env.instance_base(real).equals(fqn)
        conformed: = ctx.env.implemented_trait_instance(ctx.env.strip_const_deep(real), fqn)
        if conformed == 0
            return
        args = ctx.env.instance_args(conformed)
    tmpl: = ctx.generics.templates.get(fqn).unwrap_or(null)
    tmpl_params: = tmpl.find_child(.k_type_gen_params) if tmpl != null else null
    $own_params: = List<|Ast_node$@|>(base_core.arena)
    if tmpl_params != null
        for gp in tmpl_params.children
            if gp.gen_param_name().len > 0
                own_params.push(gp)
    mask: = ctx.env.variance_masks.get(fqn).unwrap_or(0)
    $pos: Sz = 0
    for w in written.args.children
        if w.kind_id == .k_literal || w.kind_id == .k_keyword || w.kind_id == .k_empty
            continue
        if pos >= args.len
            return
        if pos < own_params.len && own_params.get(pos).is_const_gen_param()
            bind_value(ctx, bindings, w, args[pos])
        else if variance_names_mut(mask, pos)
            // A position the generic marked (`Slice<|$T|>`): unmarked, it reads "immutable".
            names_mut: = w.kind_id == .k_type_arg && w.has_literal_child("$")
            bind_type(ctx, bindings, w, own_read_only(ctx, args[pos], names_mut))
        else
            bind_type(ctx, bindings, w, args[pos])
        pos += 1

priv fn bind_fn_sig(ctx: Sema_ctx$@, bindings: Bindings$@, sig_node: Ast_node$@, arg_id: I32) //<
    //< A function type: its parameters' types and its result's, against the argument's
    switch ctx.env.fn_sig_of(arg_id)
    case .some(sig)
        $pos: Sz = 0
        for p in base_ast_ext.Param_cursor(sig_node.get_fn_params(), false)
            if pos >= sig.params.len
                return
            bind_type(ctx, bindings, p.get_decl_type_node(), sig.params.get(pos))
            pos += 1
        bind_type(ctx, bindings, sig_node.get_decl_type_node(), sig.ret_id)
    case .none {}

priv fn mentions(written: Ast_node$@, name: U8[]): Bool //<
    //< Whether a written type names name anywhere in it, as a type of its own or inside one
    if written == null
        return false
    if (written.kind_id == .k_identifier ||
        (written.kind_id == .k_type_atom && written.children.len == 0)) &&
        written.text.equals(name)
        return true
    for ch in written.children
        if mentions(ch, name)
            return true
    return false

priv fn names_value(written: Ast_node$@, name: U8[]): Bool //<
    //< Whether a written type has name where a value stands anywhere in it
    //< An array's length (`I32[N]`) or a generic's argument (`Buf<|N|>`): a `const` parameter's
    //< name cannot stand there as a type.
    if written == null
        return false
    if written.kind_id == .k_type_postfix &&
        written.text.strip_prefix("$").starts_with("[") && written.children.len > 0 &&
        written.get_child(0).bare_written_name().equals(name)
        return true
    if written.kind_id == .k_type_args
        for ch in written.children
            if ch.bare_written_name().equals(name)
                return true
    for ch in written.children
        if names_value(ch, name)
            return true
    return false

priv fn arithmetic_on(written: Ast_node$@, name: U8[]): Ast_node$@? //<
    //< Where a written type has name inside arithmetic in a value's place (`I32[N + 1]`), if any
    //< An array's length or a generic's argument that mentions it without being it alone.
    if written == null
        return .none
    $value: Ast_node$@ = null
    if written.kind_id == .k_type_postfix &&
        written.text.strip_prefix("$").starts_with("[") && written.children.len > 0
        value = written.get_child(0)
    if value != null && value.bare_written_name().len == 0 && mentions(value, name)
        return .some(value)
    if written.kind_id == .k_type_args
        for ch in written.children
            if ch.bare_written_name().len == 0 && mentions(ch, name)
                return .some(ch)
    for ch in written.children
        if found: = arithmetic_on(ch, name)
            return .some(found)
    return .none

priv fn spell_value(ctx: Sema_ctx$@, node: Ast_node@) //<
    //< Appends a value written in a type (`N + 1`) to scratch, from its tokens
    //< An operator stands between spaces, a parenthesis against what it holds.
    for ch in node.children
        spell_value(ctx, ch)
    if node.children.len > 0 || node.text.len == 0
        return
    last: = ctx.scratch.slice()
    if !last.ends_with("'") && !last.ends_with("(") && !node.text.equals(")")
        ctx.scratch.c(' ')
    ctx.scratch.s(node.text)

fn write_gen_param_names(ctx: Sema_ctx$@, gen_params: Ast_node@) //<
    //< Appends the type parameters' names to scratch, quoted and joined by commas (`'A', 'B'`)
    if gen_params == null
        return
    $is_first: = true
    for gp in gen_params.children
        name: = gp.gen_param_name()
        if name.len == 0
            continue
        if !is_first
            ctx.scratch.s(", ")
        ctx.scratch.s("'\{name\}'")
        is_first = false

priv fn refuse_unbound(ctx: Sema_ctx$@, call: Ast_node$@, callee: U8[], gen_params: Ast_node$@,
    bindings: Bindings@, pairs: List<|Pairing|>@, at: Sz) //<
        //< Reports the type parameter at `at` that no argument bound, with the form to write
        //< A parameter's type can mention it (a `const` one: where a value stands). Then its
        //< argument did not have that type's shape, and the error stands on it. Otherwise nothing
        //< in the call could fix it.
    name: = bindings.names.get(at)
    $where: = call
    $has_value: = false
    for v in bindings.is_value
        has_value = has_value || v
    is_value: = bindings.is_value.get(at)
    ctx.clear_scratch()
        .s("cannot infer the \{"const parameter" if is_value else "type argument"\} '\{name\}' of \
            '\{callee\}'. ")
    $missed: = false
    for pair in pairs
        written: = pair.param.get_decl_type_node()
        if missed ||
            !(names_value(written, name) if is_value else mentions(written, name))
            continue
        missed = true
        where = pair.arg
        ctx.scratch
            .s("The argument for '\{pair.param.get_decl_id_text()\}' has type \
                '\{ctx.env.display(pair.arg_id)\}'. That type ")
        if is_value
            ctx.scratch
                .s("has no length or value fixed at translation time where that parameter's type \
                    has '\{name\}'")
        else
            ctx.scratch.s("does not have the shape of that parameter's type")
    if !missed && is_value
        for pair in pairs
            if missed
                break
            written: = pair.param.get_decl_type_node()
            if inside: = arithmetic_on(written, name)
                missed = true
                where = pair.arg
                ctx.scratch
                    .s("The parameter '\{pair.param.get_decl_id_text()\}' has '\{name\}' only \
                        inside arithmetic, '")
                spell_value(ctx, inside)
                ctx.scratch.s("'. The compiler does not solve this expression for '\{name\}'")
    if !missed && is_value
        ctx.scratch
            .s("No parameter's type has '\{name\}' as an array's length or a generic's value \
                argument. Inference reads const parameters from these positions")
    else if !missed
        ctx.scratch
            .s("No parameter's type mentions '\{name\}'. The type of the call's result does not fix \
                '\{name\}'")
    ctx.scratch.s("\n  Hint: call one specialization with '\{callee\}<|…|>(…)'. Write ")
    ctx.scratch.s("an argument" if has_value else "a type")
    ctx.scratch.s(" for each of ")
    write_gen_param_names(ctx, gen_params)
    ctx.err(where, ctx.scratch.slice())

priv fn as_received(ctx: Sema_ctx$@, written: Ast_node$@, arg_id: I32): I32 //<
    //< The type a parameter written as a bare name (`x: T`) receives: a copy of the argument
    //< **A copy drops the outermost immutability**, as `$a: = p$` does (`copy_value_type`). So
    //< `box(p$)` through a read-only `p` binds `T` to the writable type, and `box(p.f)` alike.
    //< What a pointer or a type argument carries is kept (`bind_name`).
    if written != null && written.bare_written_name().len > 0
        return ctx.env.copy_value_type(arg_id)
    return arg_id

fn inferred_type_args(ctx: Sema_ctx$@, call: Ast_node$@, callee: U8[], def_node: Ast_node$@,
    args_node: Ast_node@, is_method: Bool): I32[] //<
        //< The type arguments a generic call binds from its arguments, one per type parameter
        //< Empty where it is refused. That is a type parameter no argument binds (reported here),
        //< or an argument whose type is unknown (an error already reported for it). A method's
        //< receiver is not among the arguments: its instance has already bound the type's own
        //< parameters.
    gen_params: = def_node.find_child(.k_type_gen_params) if def_node != null else null
    if gen_params == null
        return I32[]::{}
    $b: = bindings_of(gen_params, callee)
    pairs: = List<|Pairing|>.create(base_core.arena)
    $saw_unknown: = false
    if args_node != null
        $params: = base_ast_ext.Param_cursor(def_node.get_fn_params(), is_method)
        for arg_node in args_node.children
            if arg_node.is_literal(",")
                continue
            param: = params.next() catch
                break
            arg_id: = ctx.own_type_of_name(arg_node)
            saw_unknown = saw_unknown || sema_type_env.is_unknown(arg_id)
            pairs.push(Pairing::{ .param = param, .arg = arg_node, .arg_id = arg_id })
    // The parameters' types are read in the declaring file, where their names resolve. **A
    // function's name binds last**: it takes its type from where it is written. So where the other
    // arguments fixed the parameter's type, the name is checked against it rather than fixing it.
    // **A bare number binds after the other arguments**, for the same reason: it takes the type
    // it is given, so `math.min(u, 64)` on a `U64` binds `T` to `U64`, not to the number's `I32`.
    old_file: = ctx.file_name
    if def_node.loc.file().len > 0
        ctx.set_current_file(def_node.loc.file())
    name_mark: = ctx.env.generic_fn_value_type_id()
    for bare in Range.asc(2)
        for pair in pairs
            if pair.arg.type_id != name_mark &&
                sema_body_literal.is_untyped_numeric_expr(pair.arg) == (bare == 1)
                b.pair = pair
                written: = pair.param.get_decl_type_node()
                bind_type(ctx, b@, written, as_received(ctx, written, pair.arg_id))
    for pair in pairs
        if pair.arg.type_id == name_mark
            b.pair = pair
            bind_type(ctx, b@, pair.param.get_decl_type_node(), pair.arg_id)
    ctx.set_current_file(old_file)
    if b.is_refused
        return I32[]::{}
    for i in Range.asc(b.ids.len)
        if sema_type_env.is_unknown(b.ids.get(i))
            if !saw_unknown
                refuse_unbound(ctx, call, callee, gen_params, b@, pairs, i)
            return I32[]::{}
    return b.ids.slice()

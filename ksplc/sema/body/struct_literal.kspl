//< Infers the type of `::{ … }`
//< It covers four things: matching fields (named and positional), the defaults of fields left out,
//< visibility, and deciding a `T[_]` array's element count.
//< **A field's visibility is checked from where it was written.**
//< Note: Called from `sema/body/expr.kspl`, which holds expression inference in general.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/sema/body/expr" as sema_body_expr
import "ksplc/sema/body/lint_stmt" as sema_body_lint_stmt
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error }
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/ds" { Map }

fn size_inferred_array_literal(node: Ast_node$@, c: Sema_ctx$@, type_node: Ast_node$@,
    actual_id: I32, base_struct_id: I32): I32 //<
        //< Decides the count of a `T[_]` literal and returns the sized type id; otherwise actual_id
        //< The count comes from the initializers and the largest [idx] written.
    $arr_base_id: I32 = 0
    $is_unsized: = false
    switch c.env.get_info(base_struct_id)
    case .array(b_id, size)
        is_unsized = (size == -1)
        arr_base_id = b_id
    default {}
    if !is_unsized
        return actual_id

    $max_index: I32 = -1
    $tmp_idx: I32 = 0
    for child in node.children
        if child != null && child.kind_id == .k_expr_field_init
            if idx_node: = child.get_field_init_index()
                eval_idx: = c.eval_constexpr_quiet(idx_node, -1)
                if eval_idx >= 0
                    tmp_idx = eval_idx
            if tmp_idx > max_index
                max_index = tmp_idx
            tmp_idx += 1
    sized_id: = c.env.make_array(arr_base_id, max_index + 1)
    node.type_id = sized_id
    if type_node != null
        type_node.type_id = sized_id
    return sized_id

priv fn has_named_field_init(node: Ast_node$@): Bool //<
    //< Whether any initializer names a field (`.f =`) or an index (`[i] =`)
    //< Such a literal is a slice's descriptor, not a list of elements.
    for child in node.children
        if child.kind_id != .k_expr_field_init
            continue
        if child.get_field_init_name().is_some() || child.get_field_init_index().is_some()
            return true
    return false

priv fn check_omitted_fields_visibility(node: Ast_node$@, c: Sema_ctx$@,
    struct_def: sema_type_def.Struct_def$@, written: Map<|Sz, Ast_node$@|>$@, shown: U8[]) //<
        //< Checks whether the fields not written are visible from this position.
        //< **Checking the written ones alone is not enough**: with zero filling, `S::{}` **would
        //< build a value with an invisible field from outside**. Written fields are reported at
        //< their own position (check_field_visibility); the rest as one item here.
    for f_idx in Range.asc(struct_def.fields_list.len)
        if written.get(f_idx).is_some()
            continue
        field: = struct_def.fields_list.get(f_idx)
        if c.is_field_visible_here(field)
            continue
        c.clear_scratch()
            .s("'\{shown\}' cannot be built here. Field '\{field.name\}' is not visible at this \
                point. Fields omitted from '::{ ... }' are filled with zeros. Build the value \
                through something the declaring file publishes")
        c.err(node, c.scratch.slice())
        return

priv fn has_field_init(node: Ast_node$@): Bool //< whether any field is written
    //< Caution: **Tell it apart from an empty `::{}`.** An empty literal writes nothing, so it
    //< means zero filling and passes even for a type with no fields. See "Initialization and
    //< construction" in `docs/SPEC-programming-language.md`.
    for child in node.children
        if child != null && child.kind_id == .k_expr_field_init
            return true
    return false

priv fn has_no_fields(c: Sema_ctx$@, id: I32): Bool //< whether this type has fields to fill
    //< A number, a boolean, an enumeration and a Result do not.
    if c.env.is_numeric(id) || c.env.is_bool(id) || c.env.is_result(id) ||
        sema_type_env.is_void(c.env.get_real_type(id))
        return true
    switch c.env.get_info(c.env.get_real_type(id))
    case .enum_type
        return true
    default {}
    return false

priv fn report_fieldless_literal(node: Ast_node$@, c: Sema_ctx$@, whole_id: I32)
    shown: = c.env.display(whole_id)
    c.clear_scratch().s("'").s(shown)
        .s("' has no fields to fill. It cannot be built with '::{ ... }'. Write the value itself")
    c.err(node, c.scratch.slice())

priv struct Init_walk //< what a walk over a literal's initializers carries from one to the next
    struct_def: sema_type_def.Struct_def$@ //< the struct, or null where the literal is no struct's
    check_visibility: Bool //< whether its fields' visibility is checked (a declared struct's)
    shown: U8[] //< the struct as a diagnostic names it, as written rather than by its full path
    by_name: Map<|U8[], Sz|>$@ //< each field's index by its name
    written: Map<|Sz, Ast_node$@|>$@ //< each field or index written so far, by what wrote it
    at: Sz //< where the next initializer without a name or an index lands

priv fn place_array_element(c: Sema_ctx$@, child: Ast_node$@, walk: Init_walk$@, arr_size: I32):
    Void!Sema_error //<
        //< It moves past one array element, reporting one beyond the declared length
        //< The elements must fit the declared length; **if not counted here, the C compiler reports
        //< it.** A `T[_]` is sized earlier (size_inferred_array_literal), so `arr_size < 0` means
        //< uncheckable, not "not known yet".
    if idx_node: = child.get_field_init_index()
        idx_node.infer_expr(c, I32::sema_type_env.Builtin_type_id.size_type)!
        if at: = c.try_eval_constexpr(idx_node)
            walk.at = at
    if arr_size >= 0 && walk.at >= Sz::arr_size
        c.clear_scratch()
            .s("too many initializers for an array of length \{arr_size\}. This initializer has \
                index \{walk.at\}")
        c.err(child, c.scratch.slice())
    else
        c.clear_scratch().s("index \{walk.at\}")
        mark_written(c, walk, walk.at, child)
    walk.at += 1

priv fn take_struct_field(c: Sema_ctx$@, child: Ast_node$@, walk: Init_walk$@): I32 //<
    //< The type of the field one initializer writes, by its name or else by its place
    //< Unknown where the literal is no struct's, the name is no field's, or the fields ran out.
    if walk.struct_def == null
        return I32::sema_type_env.Builtin_type_id.unknown
    $expected: = I32::sema_type_env.Builtin_type_id.unknown
    name_node: = child.get_field_init_name().unwrap_or(null)
    if name_node != null && name_node.kind_id == .k_identifier
        found_idx: = walk.by_name.get(name_node.text).unwrap_or(-1)
        if found_idx >= 0
            name_node.def_node = walk.struct_def.fields_list.get(found_idx).node
            expected = mark_field_written(c, walk, found_idx, child, name_node)
        else
            // Caution: **Reject an unknown field name here.** Otherwise C gets `.nope = 1` as
            // written, and the user gets a **raw C error**. See "Failing fast through an exception
            // or an ICE" in ksplc/docs/DESIGN-compiler.md.
            c.clear_scratch().s("'\{walk.shown\}' has no field named '\{name_node.text\}'")
            c.err(name_node, c.scratch.slice())
    else if walk.at < walk.struct_def.fields_list.len
        expected = mark_field_written(c, walk, walk.at, child, child)
    else
        c.clear_scratch()
            .s("too many initializers for '\{walk.shown\}'. The type has \
                \{walk.struct_def.fields_list.len\} field(s)")
        c.err(child, c.scratch.slice())
    walk.at += 1
    return expected

priv fn mark_field_written(c: Sema_ctx$@, walk: Init_walk$@, idx: Sz, child: Ast_node$@,
    shown_at: Ast_node$@): I32 //<
        //< It records field `idx` as written by `child`, checks it is visible, and returns its type
        //< The index stays in `child`'s `ival`, where genllvm reads which field to store.
    field_def: = walk.struct_def.fields_list.get(idx)
    child.def_node = field_def.node
    child.ival = I32::idx
    if walk.check_visibility
        c.check_field_visibility(field_def, shown_at)
    c.clear_scratch().s("field '\{field_def.name\}'")
    mark_written(c, walk, idx, child)
    walk.at = idx
    return field_def.type_id

priv fn mark_written(c: Sema_ctx$@, walk: Init_walk$@, at: Sz, child: Ast_node$@) //<
    //< It records place `at` as written by `child`, refusing a second write of it
    //< The caller leaves the place's name ("field 'x'", "index 0") in scratch. **Refused, not
    //< merged**: the later value would silently replace the earlier one, as C lets it.
    first: = walk.written.get(at).unwrap_or(null)
    if first == null
        walk.written.set(at, child)
        return
    $how: = "by position"
    if first.get_field_init_name().is_some()
        how = "by name"
    else if first.get_field_init_index().is_some()
        how = "by index"
    c.scratch
        .s(" is written twice in this literal: first \{how\} on line \{c.line_of(first.loc)\}, then \
            here. The later value would silently replace the earlier one. Write each field or index \
            once")
    c.err(child, c.scratch.slice())

fn infer_struct_literal_expr(node: Ast_node$@, c: Sema_ctx$@, expected_id: I32): I32!Sema_error
    $type_node: = node.get_struct_literal_type()
    if type_node != null && type_node.kind_id != .k_type_expr &&
        type_node.kind_id != .k_expr_path && type_node.kind_id != .k_type_path
        type_node = null

    $actual_id: = I32::sema_type_env.Builtin_type_id.unknown
    if type_node != null
        if type_node.kind_id == .k_type_expr
            actual_id = type_node.resolve_type(c)!
        else
            actual_id = type_node.infer_expr(c, I32::sema_type_env.Builtin_type_id.unknown)!
        type_node.type_id = actual_id
    else
        if sema_type_env.is_unknown(expected_id) || sema_type_env.is_void(expected_id)
            c.err(node,
                "cannot infer the struct type for an implicit literal. The context does not provide \
                    an expected type.")
            return expected_id

        if c.env.is_pointer(expected_id)
            c.err(node,
                "cannot assign a struct literal value directly to a pointer type. If you intend to \
                    write through the pointer, dereference it ('ptr$ = ::{...}')")
            return expected_id

        // An expected slice with no names written is a list of elements (`s: U8[] = ::{ 65, 66
        // };`).
        // Caution: **Treat a form that names fields as an ordinary struct literal** (`::{ .ptr = p,
        // .len = n }`).
        // `U8[]::{ … }` is folded earlier (`../../parse/desugar.kspl`).
        if c.env.is_slice(expected_id) && !has_named_field_init(node)
            actual_id = c.env.make_array(c.env.slice_elem(expected_id), -1)
        else
            actual_id = expected_id
        node.set_kind(.k_struct_literal)

    $base_struct_id: = c.env.strip_result(c.env.strip_ptr(actual_id))
    clean_name: = c.env.base_type_name(base_struct_id)

    struct_sym_ptr: = c.symtab.resolve(clean_name).unwrap_or(null)
    if struct_sym_ptr != null
        c.check_visibility_and_mark_used(struct_sym_ptr, node)

    struct_def: = c.env.get_struct_def(clean_name).unwrap_or(null)

    actual_id = size_inferred_array_literal(node, c, type_node, actual_id, base_struct_id)
    base_struct_id = c.env.strip_result(c.env.strip_ptr(actual_id))

    // **A `::{ ... }` for a type with no fields is rejected here**, or the C compiler reports it
    // (Principle 2). `n: I32 = ::{ 1, 2 };` would pass with a warning, the second value silently
    // lost.
    if has_field_init(node) && has_no_fields(c, base_struct_id)
        report_fieldless_literal(node, c, actual_id)
        return actual_id

    // A name-to-index map built once. A linear walk per named field is O(F^2), and one literal
    // naming every field of a wide struct would hang the compilation.
    $field_idx_map: = Map<|U8[], Sz|>.new(null)
    defer field_idx_map.free()
    if struct_def != null
        for f_idx in Range.asc(struct_def.fields_list.len)
            field_idx_map.set(struct_def.fields_list.get(f_idx).name, f_idx)
    // The written fields' indices, for the zero-filled rest's visibility.
    $written: = Map<|Sz, Ast_node$@|>.new(null)
    defer written.free()
    $walk: = Init_walk::{ .struct_def = struct_def, .check_visibility = struct_sym_ptr != null,
        .shown = c.env.display(base_struct_id), .by_name = field_idx_map@, .written = written@,
        .at = 0 }
    // The shape is computed from actual_id, not from base_struct_id, which has one slice level
    // stripped. From base_struct_id, the `.ptr` of `U8[]$[]` reads `U8@`, not `U8[]@`. A `U8$[]`
    // strips to a scalar, and **no field's type is checked at all**.
    // Caution: **Compute the shape with that same expression for the omitted fields' check.** For a
    // slice, struct_def is the stripped struct, so counting fields alone reads
    // `::{ .ptr = …, .len = … }` as a struct literal.
    $is_array: = false
    $elem_id: = I32::sema_type_env.Builtin_type_id.unknown
    $arr_size: I32 = -1
    $is_struct_shape: = struct_def != null
    switch c.env.get_info(c.env.strip_result(c.env.strip_ptr(actual_id)))
    case .array(arr_base_id, asz)
        is_array = true
        elem_id = arr_base_id
        arr_size = asz
        is_struct_shape = false
    default {}

    for child in node.children
        if child == null || child.kind_id != .k_expr_field_init || child.children.len == 0
            continue
        $field_expected_id: = I32::sema_type_env.Builtin_type_id.unknown
        if is_array
            place_array_element(c, child, walk@, arr_size)!
            field_expected_id = elem_id
        else
            field_expected_id = take_struct_field(c, child, walk@)
        val_node: = child.get_field_init_expr()
        if val_node != null
            val_node.def_node = child.def_node
            val_node.infer_expr(c, field_expected_id)!
            sema_body_lint_stmt.lint_type_given(c, val_node, field_expected_id,
                "The element's type already gives it." if is_array
                else "The field's type already gives it.")
    if is_struct_shape
        check_omitted_fields_visibility(node, c, struct_def, written@, walk.shown)
    return actual_id

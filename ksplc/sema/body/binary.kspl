//< Types the binary operators, and the checks that apply only to them
//< Covers numeric promotion, which pointer arithmetic is allowed, bare bit operations, and constant
//< divisors and shift amounts. Dispatch on an expression's kind stays in expr.kspl.
//< **This file and `expr.kspl` import each other.** expr.kspl dispatches into here, and an
//< operand's own inference calls back out to `infer_expr`, so the dependency cannot go one way
//< (as in `ksplc/gen/c/expr.kspl`).
//< The split is "a rule about one operator" versus "dispatch on an expression's kind".
import "ksplc/base/ast" { Ast_node, is_anon_fn_name }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell" // get_full_path_str_to, get_path_or_ident_name
import "ksplc/base/core" as base_core
import "ksplc/sema/body/coerce" as sema_body_coerce
import "ksplc/sema/body/expr" as sema_body_expr
import "ksplc/sema/body/fixed_answer" as sema_body_fixed_answer
import "ksplc/sema/body/lint_unchecked" as sema_body_lint_unchecked
import "ksplc/sema/body/literal" as sema_body_literal
import "ksplc/sema/body/resolve_path" as sema_body_resolve_path
import "ksplc/sema/decl/access" as _sema_decl_access // `refuse_writing_receiver`
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/decl/trait_check" as sema_decl_trait_check
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error }
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/chars" // `sub`
import "std/ds"

priv struct Op_traits //< the method and trait an operator calls on a user type
    op: U8[]
    method_name: U8[]
    trait_name: U8[]

priv const OP_TRAITS: Op_traits[10] = ::{ Op_traits::{ .op = "+", .method_name = "add",
    .trait_name = "Add" }, Op_traits::{ .op = "-", .method_name = "sub", .trait_name = "Sub" },
    Op_traits::{ .op = "*", .method_name = "mul", .trait_name = "Mul" },
    Op_traits::{ .op = "/", .method_name = "div", .trait_name = "Div" },
    Op_traits::{ .op = "==", .method_name = "eq", .trait_name = "Eq" },
    Op_traits::{ .op = "!=", .method_name = "ne", .trait_name = "Eq" },
    Op_traits::{ .op = "<", .method_name = "lt", .trait_name = "Ord" },
    Op_traits::{ .op = "<=", .method_name = "le", .trait_name = "Ord" },
    Op_traits::{ .op = ">", .method_name = "gt", .trait_name = "Ord" },
    Op_traits::{ .op = ">=", .method_name = "ge", .trait_name = "Ord" } }

priv struct Operands //< a binary expression's two sides, once both their types are known
    node: Ast_node$@ //< the whole expression, which a report points at
    op: U8[] //< the operator's text
    left: Ast_node$@
    left_id: I32
    right: Ast_node$@
    right_id: I32

priv fn get_op_traits(op: U8[]): Op_traits //< op's row in `OP_TRAITS`; empty names for none
    for row in OP_TRAITS
        if row.op.equals(op)
            return row
    return Op_traits::{ .op = op, .method_name = "", .trait_name = "" }

priv fn const_divisor(ctx: Sema_ctx$@, right_node: Ast_node$@): I32? //<
    //< The divisor's value if it is known at translation time, .none if not
    //< Caution: Keep it an Option. Collapsed to a default of 0, a divisor that really folds to 0
    //< cannot be told apart from a run-time value. A value too wide for I32 (`4294967296I64`)
    //< becomes .none (eval_constexpr's narrowing); that only sends a non-zero divisor to the
    //< run-time check.
    return .none if right_node == null else ctx.try_eval_constexpr(right_node)

priv fn check_const_divisor(ctx: Sema_ctx$@, left_type_id: I32, right_node: Ast_node$@) //<
    //< Checks whether the divisor is 0, for both `/` `%` and `/=` `%=`
    //< **This is an error, not a lint**, and carries no code. Dividing by 0 is undefined in both C
    //< and LLVM, and a project setting can silence a coded diagnostic (base/lint_codes.kspl).
    //< **Floating point is not checked**: IEEE 754 defines the result (`±inf` / `NaN`).
    if !ctx.env.is_integer(left_type_id)
        return
    if divisor: = const_divisor(ctx, right_node)
        if divisor == 0
            ctx.err(right_node, "division or modulo by zero")

fn divisor_is_static(ctx: Sema_ctx$@, right_node: Ast_node$@): Bool //<
    //< Whether the divisor is known at translation time and is not 0.
    //< **Only when this is true can the code generator omit the run-time check.**
    //< When it is true, the generator must not insert one. The generated C's top-level initializer
    //< must be a C constant expression, and a call turns it into
    //< `initializer element is not a compile-time constant`.
    divisor: = const_divisor(ctx, right_node) catch
        return false
    return divisor != 0

priv fn divisor_cannot_overflow(ctx: Sema_ctx$@, right_node: Ast_node$@): Bool //<
    //< Whether a signed division or remainder can be emitted as a plain instruction
    //< Caution: **Exclude `-1`.** A type's minimum divided by `-1` does not fit the type. C and
    //< LLVM leave that undefined, while the specification defines it as `mod 2^N`. So such a form
    //< must go to the run-time function that takes both operands. `0` is excluded as in
    //< divisor_is_static.
    divisor: = const_divisor(ctx, right_node) catch
        return false
    return divisor != 0 && divisor != -1

fn takes_signed_div(ctx: Sema_ctx$@, op: U8[], type_id: I32, divisor: Ast_node$@): Bool //<
    //< Whether `/` or `%` on type_id goes to the run-time `kspl_sdiv` / `kspl_smod`
    //< **Both backends ask this one function**, as `/=` `%=` do: a type's minimum divided by `-1`
    //< is undefined in C (x86 stops with SIGFPE) and poison in LLVM. The helpers check `0` too.
    return op.is_div_op() && ctx.env.is_integer(type_id) && !ctx.env.is_unsigned(type_id) &&
        !divisor_cannot_overflow(ctx, divisor)

priv fn shift_amount_in_range(ctx: Sema_ctx@, amount: I32, left_type_id: I32): Bool //<
    //< Whether the value is a valid shift amount
    //< Caution: **Keep this test in this one place.** The diagnostic (check_const_shift_amount) and
    //< the omission of the run-time check (shift_amount_is_static) must agree. With a copy, one
    //< goes stale when a width changes. The widths come from Env's single table
    //< (get_primitive_bit_size) for the same reason.
    return amount >= 0 && amount < ctx.env.get_portable_bit_size(left_type_id)

priv fn check_const_shift_amount(ctx: Sema_ctx$@, left_type_id: I32, right_node: Ast_node$@) //<
    //< Whether the shift amount is outside the left-hand side's width (`<<` `>>` and `<<=` `>>=`)
    //< **This is an error, not a lint**: clang reports `left shift count >= width of type` too.
    //< Without it, the error comes from clang, not ksplc. See "Failing fast through an exception or
    //< an ICE" in ksplc/docs/DESIGN-compiler.md. No code, as for the division above.
    if right_node == null || ctx.is_instantiating()
        return
    // Caution: Keep it an Option. With a default of -1, an amount that really folds to `-1` cannot
    // be told apart from a run-time value.
    if shift_val: = ctx.try_eval_constexpr(right_node)
        if !shift_amount_in_range(ctx, shift_val, left_type_id)
            max_bits: = ctx.env.get_portable_bit_size(left_type_id)
            type_name: = ctx.env.display(left_type_id)
            ctx.clear_scratch()
                .s("shift count \{shift_val\} is out of range for the left-hand side type \
                    '\{type_name\}' (must be 0..\{max_bits - 1\})")
            ctx.err(right_node, ctx.scratch.slice())

fn shift_amount_is_static(ctx: Sema_ctx$@, left_type_id: I32, right_node: Ast_node$@): Bool //<
    //< Whether the shift amount is known at translation time and within the width
    //< False in a generic's template body even for a constant amount, since the width changes with
    //< the type argument. When true, no run-time check may be inserted (as in divisor_is_static).
    if right_node == null
        return false
    shift_val: = ctx.try_eval_constexpr(right_node) catch
        return false
    return shift_amount_in_range(ctx, shift_val, left_type_id)

priv fn is_bare_bitwise(n: Ast_node$@): Bool //<
    //< Whether it is an unparenthesized `&` / `|` / `^` binary expression
    if n == null || n.kind_id != .k_expr || n.children.len != 3 || n.was_parenthesized()
        return false
    op: = n.get_binary_op()
    if op == null
        return false
    return op.text.equals("&") || op.text.equals("|") || op.text.equals("^")

priv fn reject_float_remainder(ctx: Sema_ctx$@, node: Ast_node$@, type_id: I32, op_text: U8[]): Bool //<
    //< Whether it reported a `%` (or `%=`) on a floating-point operand, which KSPL does not carry
    //< C has no `%` on a `double` (it refuses the generated code), and LLVM's `frem` would answer.
    //< So the two backends would part. A float remainder's sign also has two readings (C's `fmod`
    //< truncates, Python's `%` floors), so the one meant is written out.
    if !ctx.env.is_float(type_id) || (!op_text.equals("%") && !op_text.equals("%="))
        return false
    shown: = ctx.env.display(type_id)
    ctx.clear_scratch().s("operator '\{op_text\}' does not apply to '\{shown\}'; write the ")
        .s("remainder meant ('a - b * F64::(I64::(a / b))' rounds the quotient toward zero)")
    ctx.err(node, ctx.scratch.slice())
    return true

priv fn is_bool_arith_operand(ctx: Sema_ctx@, left_id: I32, right_id: I32, op_text: U8[],
    is_shift: Bool): Bool //<
        //< Whether arithmetic or a shift is about to be applied to a `Bool` operand.
        //< Caution: **List the operators explicitly.** Written as "not a comparison, logical or
        //< bitwise operator", it catches a new operator the day a compound assignment reaches here.
    is_arith: =
        op_text.equals("+") || op_text.equals("-") || op_text.equals("*") ||
        op_text.equals("/") || op_text.equals("%")
    if !is_arith && !is_shift
        return false
    return ctx.env.is_bool(left_id) || ctx.env.is_bool(right_id)

priv fn is_numeric_expected(ctx: Sema_ctx@, expected_id: I32): Bool //<
    //< Whether the outer expected type is a number, the case the operands' width governs
    //< Any other expected type still reaches the left (a struct literal before a user's `+`).
    return !sema_type_env.is_unknown(expected_id) && ctx.env.is_numeric(expected_id)

fn infer_binary_expr(node: Ast_node$@, ctx: Sema_ctx$@, expected_id: I32): I32!Sema_error
    node.ice_assert(node.children.len == 3, "Binary expression node must have exactly 3 children")

    left_node: = node.get_binary_left()
    op_node: = node.get_binary_op()
    op_text: = op_node.text
    right_node: = node.get_binary_right()

    is_cmp: = op_text.is_comparison_op()
    is_logical: = op_text.equals("&&") || op_text.equals("||")
    // `&` `|` `^` require the operands' types to match exactly (they do not promote).
    // Caution: **Do not include a shift here.** `a << b` has **the left-hand side's type alone**.
    // With shifts included, the `1` of `x: I64 = 1 << 40;` takes the default I32 and shifts to 0.
    // And `x: U64 = 1 << 20;` is rejected as "an implicit conversion between I32 and U64".
    is_strict_bitwise: = op_text.is_bitwise_op()
    is_shift: = op_text.is_shift_op()

    $pass_left_id: = expected_id
    // Caution: **Nor does an expected pointer reach the left.** `p + n` passed as a `Void$@` would
    // convert `p` first and step by bytes instead of by `p`'s element.
    if is_cmp || is_logical || is_strict_bitwise || ctx.env.is_pointer(expected_id)
        pass_left_id = I32::sema_type_env.Builtin_type_id.unknown
    // **The outer expected type does not reach a numeric operation's operands** ("Integer
    // arithmetic" in docs/SPEC-programming-language.md). They compute at their own width, and
    // infer_expr's last step widens the result. Passed down, `c: I32 = a + b` over two U8 gave 256,
    // not 0.
    $right_first_id: = I32::sema_type_env.Builtin_type_id.unknown
    $right_done: = false
    // Caution: **Literals alone have no width, so they take it**: on both sides (`x: I64 =
    // 4294967296 - 1`), or on a shift's left (`x: I64 = 1 << 40`). A literal before a value takes
    // it only when the value has that type too, so the value is inferred first there.
    if is_numeric_expected(ctx, expected_id) && !is_cmp && !is_logical && !is_strict_bitwise
        left_untyped: = sema_body_literal.is_untyped_numeric_expr(left_node)
        if !left_untyped
            pass_left_id = I32::sema_type_env.Builtin_type_id.unknown
        else if !is_shift && !sema_body_literal.is_untyped_numeric_expr(right_node)
            right_first_id = right_node.infer_expr(ctx,
                I32::sema_type_env.Builtin_type_id.unknown)!
            right_done = true
            right_clean: = ctx.env.get_clean_real_type(right_first_id)
            if right_clean != ctx.env.get_clean_real_type(expected_id)
                pass_left_id = I32::sema_type_env.Builtin_type_id.unknown
    left_type_id: = left_node.infer_expr(ctx, pass_left_id)!
    // An operand is a value, so a type's name is refused on either side, with nothing expected of
    // it too (`Box<|I32|> == f`).
    if sema_body_resolve_path.refuse_type_name(ctx, left_node)
        return I32::sema_type_env.Builtin_type_id.unknown
    if refuses_fn_operator(ctx, node, op_text, left_type_id)
        return I32::sema_type_env.Builtin_type_id.unknown
    if left_type_id == ctx.env.generic_fn_value_type_id()
        return infer_after_fn_name(node, ctx, left_node, right_node)!

    lint_bare_bitwise(ctx, node, left_node, right_node, is_cmp)

    op_traits: = get_op_traits(op_text)
    method_name: = op_traits.method_name
    trait_name: = op_traits.trait_name
    if method_name.len > 0
        resolved: = ctx.resolve_operator_call(left_type_id, trait_name, method_name, "Operator",
            op_text, node)
        switch resolved
        case .user(method_sym)
            node.def_node = method_sym.node
            ctx.refuse_writing_receiver(left_node, method_sym.node, op_text)
            if !right_done
                right_node.infer_expr(ctx, I32::sema_type_env.Builtin_type_id.unknown)!
            node.type_id = method_sym.type_id
            return method_sym.type_id
        case .failed
            return I32::sema_type_env.Builtin_type_id.unknown
        case .builtin {}
    if refuses_operator_operand(ctx, node, op_text, left_type_id, false)
        return I32::sema_type_env.Builtin_type_id.unknown

    $right_type_id: = right_first_id
    if !right_done
        pass_right_id: =
            right_expected_id(ctx, right_node, left_type_id, expected_id, op_text)
        right_type_id = right_node.infer_expr(ctx, pass_right_id)!
    if sema_body_resolve_path.refuse_type_name(ctx, right_node)
        return I32::sema_type_env.Builtin_type_id.unknown
    if refuses_fn_operator(ctx, node, op_text, right_type_id) ||
        refuses_operator_operand(ctx, node, op_text, right_type_id, false)
        return I32::sema_type_env.Builtin_type_id.unknown
    // A function's name against a value that is no function (`1 == twice`) is reported as a name
    // given a type it does not have.
    if right_type_id == ctx.env.generic_fn_value_type_id()
        right_type_id = right_node.infer_expr(ctx, left_type_id)!

    if refuses_operand_types(ctx, node, op_text, op_text, left_type_id, right_type_id, is_shift)
        return I32::sema_type_env.Builtin_type_id.unknown
    o: = Operands::{ .node = node, .op = op_text, .left = left_node, .left_id = left_type_id,
        .right = right_node, .right_id = right_type_id }

    // Caution: **Check the divisor and the shift amount after inferring the right-hand side.**
    // Folding takes the width and the sign from the operands' `type_id` (eval_binary in
    // sema/decl/eval.kspl). A compound assignment (sema/body/stmt.kspl) also calls here after it.
    if op_text.is_div_op()
        check_const_divisor(ctx, left_type_id, right_node)
    if is_shift
        check_const_shift_amount(ctx, left_type_id, right_node)

    // An integer literal with no fixed type must fit the type the operation is computed in.
    // Caution: Measure against **the type after promotion**. When the other side is such a literal
    // too, its type is the default I32, which would reject a correct `x: U64 = 4294967296 + 1;`.
    // report_diagnostic merges a repeated report.
    if !ctx.is_instantiating()
        operand_id: = operand_type(ctx, o)
        sema_body_literal.check_operand_literal_bounds(ctx, left_node, operand_id)
        sema_body_literal.check_operand_literal_bounds(ctx, right_node, operand_id)

    lint_bool_literal_operand(ctx, o)

    // Pointer arithmetic has three forms: `p + i` / `p - i` (a pointer that many elements further)
    // and `p - q` (the same pointee type; an `Sz` count of elements).
    // Caution: **Reject anything else**, or KSPL says nothing and the user gets the C compiler's
    // `invalid operands to binary expression`, or LLVM IR that does not build (Principle 5).
    if !is_cmp && !is_logical &&
        (ctx.env.is_pointer(left_type_id) || ctx.env.is_pointer(right_type_id)) &&
        !pointer_arith_ok(ctx, op_text, left_type_id, right_type_id)
        report_bad_pointer_arith(ctx, node, op_text, left_type_id, right_type_id)
        return I32::sema_type_env.Builtin_type_id.unknown
    if !is_cmp && !is_logical && ctx.env.is_pointer(left_type_id) &&
        !ctx.env.is_pointer(right_type_id) && refuses_step_from_null(ctx, node, left_node)
        return I32::sema_type_env.Builtin_type_id.unknown
    if !is_cmp && !is_logical
        sema_body_lint_unchecked.note_pointer_arith(ctx, node, left_type_id, right_type_id)

    $type_id: = left_type_id
    if ctx.env.is_numeric(left_type_id) && ctx.env.is_numeric(right_type_id)
        type_id = promote_operands(ctx, o)
        if sema_type_env.is_unknown(type_id)
            return type_id
        if is_cmp && !ctx.is_instantiating() && refuses_fixed_comparison(ctx, o, type_id)
            return I32::sema_type_env.Builtin_type_id.unknown
    if is_cmp || is_logical
        sema_body_fixed_answer.lint_fixed_comparison(ctx, node)
    if op_text.equals("^")
        lint_xor_as_power(ctx, o)
    if op_text.equals("-") && ctx.env.is_pointer(left_type_id) &&
        ctx.env.is_pointer(right_type_id)
        type_id = pointer_difference_type(ctx, node, left_type_id, right_type_id)
        if sema_type_env.is_unknown(type_id)
            return type_id

    if is_cmp || is_logical
        type_id = I32::sema_type_env.Builtin_type_id.bool_type
    return type_id

priv fn lint_bare_bitwise(ctx: Sema_ctx$@, node: Ast_node$@, left_node: Ast_node$@,
    right_node: Ast_node$@, is_cmp: Bool) //< [W0108] a bitwise operand compared bare
    if !base_core.config.run_lint_checks || !is_cmp
        return
    // KSPL ranks `&` `|` `^` with `*` ("The operator list and precedence" in
    // docs/SPEC-programming-language.md), C below comparison, so the same text parses differently.
    // **Neither types nor the run time catch it**: only the answer changes (`6 & 4 == 4` is true in
    // KSPL only).
    if is_bare_bitwise(left_node) || is_bare_bitwise(right_node)
        ctx.clear_scratch()
            .s("[W0108] '&', '|' and '^' bind tighter than comparison in KSPL (they sit with '*'), \
                so the bitwise operand groups first. C groups the same spelling the other way \
                round. Add parentheses to state the grouping in the source.")
        ctx.warn(node, ctx.scratch.slice())

priv fn right_expected_id(ctx: Sema_ctx$@, right_node: Ast_node$@, left_type_id: I32,
    expected_id: I32, op_text: U8[]): I32 //<
        //< The type the right-hand side is inferred against, given the left-hand side's
    is_cmp: = op_text.is_comparison_op()
    is_logical: = op_text.equals("&&") || op_text.equals("||")
    is_shift: = op_text.is_shift_op()
    $pass_right_id: = left_type_id
    $is_left_enum: = false
    left_real: = ctx.env.get_clean_real_type(left_type_id)

    if left_real != 0 && !sema_type_env.is_unknown(left_real)
        switch ctx.env.get_info(left_real)
        case .enum_type
            is_left_enum = true
        default {}

    if !is_left_enum && (ctx.env.is_numeric(left_type_id) || is_cmp)
        pass_right_id = I32::sema_type_env.Builtin_type_id.unknown
    if is_logical || ctx.env.is_pointer(left_type_id)
        pass_right_id = I32::sema_type_env.Builtin_type_id.unknown
    // A function's name on the right takes the left's function type, which checks its signature.
    if ctx.env.is_fn_ptr(left_type_id)
        pass_right_id = left_type_id

    // **Pass the left-hand side's type only to an integer literal with no fixed type**, and only
    // where the outer expected type equals it. The assignment above promotes other operands to the
    // wider side, but a literal has no type of its own to promote. **Compare without the read-only
    // mark**: an element of `c: U8[2] = ::{ a + 1, 0 }` expects a read-only `U8`, still a `U8`.
    // Caution: **Do not include a shift.** The amount's type is independent of the left-hand side's
    // ("Shifts are outside the exception" in docs/SPEC-programming-language.md).
    if ctx.env.is_integer(left_type_id) && !is_logical && !is_shift &&
        ctx.env.get_clean_real_type(expected_id) == ctx.env.get_clean_real_type(left_type_id) &&
        sema_body_literal.is_untyped_int_literal(right_node)
        pass_right_id = left_type_id
    return pass_right_id

priv fn refuses_operand_types(ctx: Sema_ctx$@, node: Ast_node$@, op_text: U8[], written: U8[],
    left_type_id: I32, right_type_id: I32, is_shift: Bool): Bool //<
        //< Whether it reported operand types the operator does not apply to
        //< `written` is the operator as the source spells it, which the message quotes: `+=` for a
        //< compound assignment whose `op_text` is `+`.
    if refuses_slice_operand(ctx, node, written, left_type_id) ||
        refuses_slice_operand(ctx, node, written, right_type_id)
        return true

    // Caution: **Do not let arithmetic or shifts on a `Bool` pass.** They become integer operations
    // on C's `_Bool` and silently give wrong answers. `b1 / b2` **crashes with SIGFPE** when the
    // divisor is false (`kspl_sdiv`'s zero check applies to numeric types only). Allowed are
    // `== != < > <= >=` (Rust has `bool: Ord` too) and `& | ^` (logic without short-circuiting).
    if is_bool_arith_operand(ctx, left_type_id, right_type_id, op_text, is_shift)
        bad_id: = left_type_id if ctx.env.is_bool(left_type_id) else right_type_id
        shown: = ctx.env.display(bad_id)
        ctx.clear_scratch().s("Operator '\{written\}' cannot be applied to '\{shown\}'. ")
            .s("For arithmetic and bit operations, convert it first ('I32::flag'). For logic, ")
            .s("use '&&' / '||', or '&' / '|' / '^' when both sides must be evaluated")
        ctx.err(node, ctx.scratch.slice())
        return true

    if is_number_op(op_text, is_shift)
        if refuses_enum_operand(ctx, node, written, left_type_id) ||
            refuses_enum_operand(ctx, node, written, right_type_id)
            return true

    if (ctx.env.is_float(left_type_id) || ctx.env.is_float(right_type_id)) &&
        reject_float_remainder(ctx, node,
        left_type_id if ctx.env.is_float(left_type_id) else right_type_id, written)
        return true
    return false

priv fn is_number_op(op_text: U8[], is_shift: Bool): Bool //<
    //< Whether the operator computes a number: arithmetic, a bit operation or a shift
    //< Caution: **List the operators explicitly**, for the reason `is_bool_arith_operand` gives.
    return is_shift || op_text.equals("+") || op_text.equals("-") || op_text.equals("*") ||
        op_text.equals("/") || op_text.equals("%") || op_text.equals("&") ||
        op_text.equals("|") || op_text.equals("^")

fn refuses_enum_operand(ctx: Sema_ctx$@, node: Ast_node$@, written: U8[], type_id: I32): Bool //<
    //< Whether it reported a simple enum given to an operator that computes a number
    //< Computed on, `E.big + E.one` makes a value that is no variant, and skips an integer's wrap
    //< and its stops on a zero divisor or a wide shift. The cast to the base type keeps the
    //< arithmetic ("3.4 Enums (`enum`)" in docs/SPEC-programming-language.md). The unary `-` and
    //< `~` ask it too (`sema/body/expr.kspl`).
    switch ctx.env.get_info(ctx.env.get_clean_real_type(type_id))
    case .enum_type(def)
        if !def.is_scalar()
            return false
        shown: = ctx.env.display(type_id)
        base: = ctx.env.display(def.base_type_id)
        ctx.clear_scratch()
            .s("Operator '\{written\}' cannot be applied to the enum '\{shown\}'. An enum value \
                names a variant, not a number, so only '==' '!=' '<' '<=' '>' '>=' apply to it. For \
                arithmetic, cast it to its base type first ('\{base\}::e'); a cast back \
                ('\{shown\}::n') checks that the result is a tag")
        ctx.err(node, ctx.scratch.slice())
        return true
    default
        return false

priv fn refuses_slice_operand(ctx: Sema_ctx$@, node: Ast_node$@, written: U8[], type_id: I32): Bool //<
    //< Whether it reported an operator on a slice
    //< Caution: **Do not let one pass.** The generated C would operate on the `ptr`+`len`
    //< structs, and the user would get the C compiler's `invalid operands` instead of KSPL's
    //< diagnostic (Principle 5). Pointers are excluded: `(p + i)$` and `q - p` are KSPL's.
    if !ctx.env.is_slice(type_id)
        return false
    // Caution: Show the sugar the user wrote, not the internal name (`U8 immut[]` /
    // `Slice_U8_Const`; `../type/display.kspl`).
    shown: = ctx.env.display(type_id)
    ctx.clear_scratch().s("Operator '\{written\}' cannot be applied to slice type '\{shown\}'; ")
        .s("slices have no arithmetic or ordering (compare contents with 'equals', read elements \
            with '[]')")
    ctx.err(node, ctx.scratch.slice())
    return true

priv const OP_METHODS: U8[][_] = ::{ "%", "rem", "&", "bit_and", "|", "bit_or", "^", "bit_xor",
    "<<", "shl", ">>", "shr", "~", "bit_not" } //<
        //< The method an operator with no trait is shown replaced by, in pairs
        //< Only a suggestion's spelling: no trait in std/lang declares these.

priv fn op_method_name(op: U8[], is_unary: Bool): U8[] //< the method a message suggests for op
    if is_unary
        return "neg" if op.equals("-") else "not" if op.equals("!") else "bit_not"
    traited: = get_op_traits(op).method_name
    if traited.len > 0
        return traited
    for $i: Sz = 0; i + 1 < OP_METHODS.len; i += 2
        if OP_METHODS[i].equals(op)
            return OP_METHODS[i + 1]
    return "apply"

priv fn op_trait_name(op: U8[], is_unary: Bool): U8[] //< the std/lang trait op desugars through
    if is_unary
        return "Neg" if op.equals("-") else "Not" if op.equals("!") else ""
    return get_op_traits(op).trait_name

fn refuses_operator_operand(ctx: Sema_ctx$@, node: Ast_node$@, op: U8[], type_id: I32,
    is_unary: Bool): Bool //<
        //< Whether it reported an operand no built-in operator takes, and the operator traits miss
        //< An operator applies to numbers, `Bool`, simple enums and pointers (a simple enum takes
        //< only the comparisons: `refuses_enum_operand`). A struct, a tagged union, an array or a
        //< trait value has no C operator, so letting one through gives the C compiler's `invalid
        //< operands` (Principle 5). The caller asks after an operator trait found no
        //< implementation, on each operand. A type parameter is not one of these kinds.
    if refuses_slice_operand(ctx, node, op, type_id)
        return true
    $is_array: = false
    $is_tagged: = false
    switch ctx.env.get_info(ctx.env.get_clean_real_type(type_id))
    case .struct_type, .trait_type {}
    case .array
        is_array = true
    case .enum_type(def)
        if def.is_scalar()
            return false
        is_tagged = true
    default
        return false
    shown: = ctx.env.display(type_id)
    ctx.clear_scratch()
        .s("operator '\{op\}' does not apply to '\{shown\}'. Operators apply to numbers, 'Bool', \
            simple enums and pointers")
    trait_name: = op_trait_name(op, is_unary)
    method: = op_method_name(op, is_unary)
    args: = "()" if is_unary else "(b)"
    if is_array
        ctx.scratch.s(". Apply it to the elements one at a time ('a[i]')")
    else if op.equals("&&") || op.equals("||")
        ctx.scratch
            .s(". '\{op\}' takes only 'Bool' values, so test the value first, such as with a method \
                that returns a 'Bool'")
    else if trait_name.len > 0
        side: = "an operand" if is_unary else "a left operand"
        ctx.scratch
            .s(", and to \{side\} whose type implements '\{trait_name\}' from std/lang. Call a \
                method instead, such as 'a.\{method\}\{args\}'")
    else
        ctx.scratch
            .s(". '\{op\}' has no operator trait, so call a method instead, such as \
                'a.\{method\}\{args\}'")
    if is_tagged
        ctx.scratch.s(", or take the value apart with 'switch'")
    ctx.err(node, ctx.scratch.slice())
    return true

fn compound_right_expected(ctx: Sema_ctx$@, right_node: Ast_node$@, left_type_id: I32,
    op_text: U8[]): I32 //<
        //< The type `a op= b`'s right-hand side is inferred against: what `a = a op b` gives `b`
        //< One written in literals alone has no width of its own and takes the place's, as an
        //< initializer does. See `f += 1.0` on an `F32`, and "6.5 Assignment and compound
        //< assignment" in docs/SPEC-programming-language.md. Caution: **Not a shift amount**, which
        //< keeps its own type, nor any other value. So `y <<= x` (`y: U8`, `x: I32`) passes, as `y
        //< = y << x` does.
    bin_op: = op_text.sub(0, op_text.len - 1)
    if !bin_op.is_shift_op() && ctx.env.is_numeric(left_type_id) &&
        sema_body_literal.is_untyped_numeric_expr(right_node)
        return left_type_id
    return right_expected_id(ctx, right_node, left_type_id, left_type_id, bin_op)

fn refuses_compound_operands(ctx: Sema_ctx$@, node: Ast_node$@, op_text: U8[],
    left_node: Ast_node$@, left_type_id: I32, right_node: Ast_node$@, right_type_id: I32): Bool //<
        //< Whether it reported a compound assignment (`a op= b`) its operands do not take
        //< It takes what `a = a op b` takes: the binary operator's operand rules and promotion. A
        //< pointer step (`p += i`) is checked before this, in `sema/body/stmt.kspl`.
        //< Caution: **Refuse one on a type of your own.** The operator traits rewrite `a + b`, but
        //< nothing rewrites `a += b`, so C's operator would land on a struct.
    bin_op: = op_text.sub(0, op_text.len - 1)
    is_shift: = bin_op.is_shift_op()
    if refuses_operand_types(ctx, node, bin_op, op_text, left_type_id, right_type_id, is_shift)
        return true
    if is_shift
        check_const_shift_amount(ctx, left_type_id, right_node)
    if bin_op.is_div_op()
        check_const_divisor(ctx, left_type_id, right_node)
    if sema_type_env.is_unknown(left_type_id) || sema_type_env.is_unknown(right_type_id)
        return false
    if ctx.env.is_numeric(left_type_id) && ctx.env.is_numeric(right_type_id)
        o: = Operands::{ .node = node, .op = bin_op, .left = left_node, .left_id = left_type_id,
            .right = right_node, .right_id = right_type_id }
        return refuses_compound_numbers(ctx, o, op_text)
    if ctx.env.is_numeric(left_type_id) || ctx.env.is_bool(left_type_id)
        return false
    // An array has no `a = a + b` form to point at, so it takes the operators' own message.
    if ctx.env.is_array(left_type_id)
        return refuses_operator_operand(ctx, node, op_text, left_type_id, false)
    shown: = ctx.env.display(left_type_id)
    ctx.clear_scratch()
        .s("compound assignment '\{op_text\}' applies to numbers and 'Bool', not to '\{shown\}'; ")
        .s("write 'a = a \{bin_op\} b' (an operator trait is called through that form)")
    ctx.err(node, ctx.scratch.slice())
    return true

priv fn refuses_compound_numbers(ctx: Sema_ctx$@, o: Operands, op_text: U8[]): Bool //<
    //< Promotes `a op= b`'s two numbers as `a op b`, and refuses a result the place cannot hold
    //< The place is never converted: where `a op b` would compute wider than `a`, storing it back
    //< narrows, which `a = a op b` refuses too.
    calc_type: = o.left_id if o.op.is_shift_op() else operand_type(ctx, o)
    if sema_type_env.is_unknown(calc_type)
        report_no_common_type(ctx, o)
        return true
    if ctx.env.get_real_type(calc_type) != ctx.env.get_real_type(o.left_id)
        shown: = ctx.env.display(o.left_id)
        calc_shown: = ctx.env.display(calc_type)
        ctx.clear_scratch()
            .s("implicit conversion between '\{calc_shown\}' and '\{shown\}' is forbidden to \
                prevent data loss. '\{op_text\}' computes in '\{calc_shown\}', as 'a = a \{o.op\} \
                b' does, and stores into '\{shown\}'. Use an explicit '::' cast")
        ctx.err(o.right, ctx.scratch.slice())
        return true
    if !ctx.is_instantiating()
        sema_body_literal.check_operand_literal_bounds(ctx, o.right, calc_type)
    promote_operands(ctx, o)
    return false

priv fn lint_bool_literal_operand(ctx: Sema_ctx$@, o: Operands) //<
    //< [I0302] a `Bool` compared with a literal, and [I0303] a logical operation on one
    if !base_core.config.run_lint_checks ||
        (o.left.kind_id != .k_bool && o.right.kind_id != .k_bool)
        return
    bool_id: = I32::sema_type_env.Builtin_type_id.bool_type
    if o.op.is_equality_op() && o.left_id == bool_id && o.right_id == bool_id
        ctx.information(o.node,
            "[I0302] Unnecessary boolean comparison. Use the boolean value directly or negate it \
                with '!'.")
    if o.op.equals("&&") || o.op.equals("||")
        ctx.information(o.node, "[I0303] Redundant logical operation with a boolean literal.")

priv fn lint_xor_as_power(ctx: Sema_ctx$@, o: Operands) //<
    //< [W0215] `^` between two written decimal numbers, the left one 2 or 10
    //< Elsewhere `2 ^ 8` and `10 ^ 3` are powers, so the writer likely meant 256 or 1000; `^` is
    //< exclusive or. A number in hexadecimal, a name or a variable says exclusive or was meant.
    if !base_core.config.run_lint_checks || ctx.is_instantiating()
        return
    left: = written_decimal(ctx, o.left)
    right: = written_decimal(ctx, o.right)
    if left.is_none() || right.is_none()
        return
    base: = left.unwrap_or(0)
    if base != 2 && base != 10
        return
    ctx.clear_scratch()
        .s("[W0215] '^' is exclusive or, not a power: here it gives \{base ^ right.unwrap_or(0)\}. \
            For a power, write its value, or '1 << n' for 2 to the n. For exclusive or, write a \
            number in hexadecimal.")
    ctx.warn(o.node, ctx.scratch.slice())

priv fn written_decimal(ctx: Sema_ctx$@, n: Ast_node$@): I64? //<
    //< The value of a number written in decimal (`10`, `2U8`, `-3`), none for another shape
    $at: = n.without_parens()
    if at != null && at.kind_id == .k_expr_unary && at.get_unary_op().text.equals("-")
        at = at.get_unary_target().without_parens()
    if at == null || at.kind_id != .k_integer || at.text.starts_with("0x") ||
        at.text.starts_with("0X") || at.text.starts_with("0b") || at.text.starts_with("0B")
        return .none
    return ctx.try_eval_constexpr_wide(n)

priv fn promote_operands(ctx: Sema_ctx$@, o: Operands): I32 //<
    //< The type two numbers are computed in, each operand converted to it
    //< Unknown after reporting that they have no common type.
    is_shift: = o.op.is_shift_op()
    calc_type: = o.left_id if is_shift else operand_type(ctx, o)
    if sema_type_env.is_unknown(calc_type)
        report_no_common_type(ctx, o)
        return calc_type

    // A literal with no fixed type directly under a unary minus is given the promoted type itself.
    // Caution: **Do not wrap it in a cast**: that negates at I32, then widens a truncated value
    // (settle_negated_literal in sema/body/literal.kspl). Shifts are left out: the amount's type
    // is independent, and a negative amount is rejected separately.
    $left_src: = o.left_id
    $right_src: = o.right_id
    if !is_shift
        if sema_body_literal.settle_negated_literal(ctx, o.left, calc_type) ||
            sema_body_literal.settle_untyped_literal(ctx, o.left, calc_type)
            left_src = calc_type
        if sema_body_literal.settle_negated_literal(ctx, o.right, calc_type) ||
            sema_body_literal.settle_untyped_literal(ctx, o.right, calc_type)
            right_src = calc_type

    calc_real: = ctx.env.get_real_type(calc_type)
    if ctx.env.get_real_type(left_src) != calc_real
        o.left.wrap_implicit_cast(ctx, left_src, calc_type)
    // A shift amount keeps its own type, because the run-time check reads it whole. Narrowed to the
    // left side's width first, `1 << m` with `m: U64 = 2^32` would shift by 0 unstopped.
    if ctx.env.get_real_type(right_src) != calc_real && !is_shift
        o.right.wrap_implicit_cast(ctx, right_src, calc_type)
    return calc_type

priv fn refuses_fixed_comparison(ctx: Sema_ctx$@, o: Operands, calc_id: I32): Bool //<
    //< Refuses an integer compared with a constant outside every value its own type holds
    //< **The answer is fixed at translation**, so the comparison does nothing (Principle 5).
    //< `x == -1` with `x: U8` computes at `I32` and is never true. The literal range check takes a
    //< constant outside the type the comparison computes in (`u == -1` with `u: U32`). This
    //< function reports one outside the other side's own type only.
    if !ctx.env.is_integer(o.left_id) || !ctx.env.is_integer(o.right_id)
        return false
    left_k: = ctx.try_eval_constexpr_wide(o.left)
    right_k: = ctx.try_eval_constexpr_wide(o.right)
    if left_k.is_some() == right_k.is_some()
        return false
    var_on_left: = right_k.is_some()
    k: = right_k.unwrap_or(0) if var_on_left else left_k.unwrap_or(0)
    var_id: = o.left_id if var_on_left else o.right_id
    calc: = ctx.env.int_bounds(calc_id)
    own: = ctx.env.int_bounds(var_id)
    if k < calc.lo || k > calc.hi || (k >= own.lo && k <= own.hi)
        return false
    // Read as `x op k`: a constant above the range is greater than every value, below it less.
    op: = sema_body_fixed_answer.turned(o.op, var_on_left)
    above: = k > own.hi
    always: =
        (op.equals("!=") || ((op.equals("<") || op.equals("<=")) && above) ||
        ((op.equals(">") || op.equals(">=")) && !above))
    shown: = ctx.env.display(var_id)
    verdict: = "true" if always else "false"
    ctx.clear_scratch()
        .s("this comparison is always \{verdict\}: a '\{shown\}' holds \{own.lo\} to \{own.hi\}, \
            and \{k\} is outside that. Compare with a value the type can hold, or cast to the \
            reading meant first")
    ctx.err(o.node, ctx.scratch.slice())
    return true

priv fn pointer_difference_type(ctx: Sema_ctx$@, node: Ast_node$@, left_type_id: I32,
    right_type_id: I32): I32 //<
        //< `q - p`'s type: `Sz`, a count of elements; unknown after reporting different pointees
        //< **Subtracting one pointer from another gives not a pointer** but a count of elements
        //< (C's `ptrdiff_t`). Typed as the left-hand side, the result could be stored in a pointer.
        //< The user would then get C's `incompatible integer to pointer conversion` (Principle 5).
        //< On LLVM it would give a `ptrtoint` of an integer, **IR that does not build**.
    if points_to_same(ctx, left_type_id, right_type_id)
        return I32::sema_type_env.Builtin_type_id.size_type
    l_shown: = ctx.env.display(left_type_id)
    r_shown: = ctx.env.display(right_type_id)
    ctx.clear_scratch().s("cannot subtract '\{r_shown\}' from '\{l_shown\}'. ")
        .s("Two pointers can be subtracted only when they point to the same type. ")
        .s("The answer counts elements, so the element size must be one")
    ctx.err(node, ctx.scratch.slice())
    return I32::sema_type_env.Builtin_type_id.unknown

fn refuses_fn_operator(ctx: Sema_ctx$@, node: Ast_node$@, op_text: U8[], type_id: I32): Bool //<
    //< Whether it reported an operator other than `==` and `!=` on a function value
    //< A function value is an address, which has no order and no arithmetic that means anything;
    //< C leaves ordering two functions' addresses undefined. A unary operator (`-f`, in
    //< expr.kspl) and a compound assignment (`f += g`, in stmt.kspl) are checked here too.
    if !ctx.env.is_fn_ptr(type_id) || op_text.is_equality_op()
        return false
    ctx.clear_scratch()
        .s("operator '\{op_text\}' does not apply to a function: functions are compared only with \
            '==' and '!='")
    ctx.err(node, ctx.scratch.slice())
    return true

priv fn infer_after_fn_name(node: Ast_node$@, ctx: Sema_ctx$@, left_node: Ast_node$@,
    right_node: Ast_node$@): I32!Sema_error //<
        //< Types a comparison whose left side is a function's name, the right side first
        //< **A function's name takes its type from where it is written** (value_of_fn in
        //< sema/body/resolve_path.kspl). So the right side's type is the expected type of the name,
        //< as the left's is the right's in `f == twice`. The order the two are written in changes
        //< nothing. Two names give no type to either, and are refused. Neither side is a
        //< declaration with no type, which takes the name's own (`f: = twice`).
    right_type_id: = right_node.infer_expr(ctx, I32::sema_type_env.Builtin_type_id.unknown)!
    if sema_type_env.is_unknown(right_type_id)
        return I32::sema_type_env.Builtin_type_id.unknown
    if right_type_id == ctx.env.generic_fn_value_type_id()
        ctx.clear_scratch().s("cannot compare ")
        write_fn_name(ctx, left_node)
        ctx.scratch.s(" with ")
        write_fn_name(ctx, right_node)
        ctx.scratch
            .s(": each takes its type from the other side, and neither gives one\n  Hint: bind one \
                side to a variable first ('f: = …' takes its function type), then compare 'f'")
        ctx.err(node, ctx.scratch.slice())
        return I32::sema_type_env.Builtin_type_id.unknown
    left_node.infer_expr(ctx, right_type_id)!
    return I32::sema_type_env.Builtin_type_id.bool_type

priv fn write_fn_name(ctx: Sema_ctx$@, name_node: Ast_node$@) //<
    //< Appends a function's name to scratch as the source spells it, quoted
    //< An anonymous function's synthesized name is not shown: the user did not write it.
    if is_anon_fn_name(name_node.get_path_or_ident_name())
        ctx.scratch.s("this anonymous function")
        return
    ctx.scratch.s("'")
    name_node.get_full_path_str_to(ctx.scratch)
    ctx.scratch.s("'")

priv fn operand_type(ctx: Sema_ctx$@, o: Operands): I32 //<
    //< The type a numeric binary operation computes in, or unknown where none is implicit
    //< An integer literal with no suffix takes the other side's integer type, as it takes an
    //< expected type. So `u < 1` with `u: U32` computes at `U32`, and `u < -1` is out of range.
    promoted: = ctx.env.get_promoted_numeric_type(o.left_id, o.right_id)
    if !sema_type_env.is_unknown(promoted)
        return promoted
    if ctx.env.is_integer(o.left_id) && sema_body_literal.is_untyped_int_literal(o.right)
        return o.left_id
    if ctx.env.is_integer(o.right_id) && sema_body_literal.is_untyped_int_literal(o.left)
        return o.right_id
    return I32::sema_type_env.Builtin_type_id.unknown

priv fn report_no_common_type(ctx: Sema_ctx$@, o: Operands) //<
    //< Rejects two numeric operands neither of which holds every value of the other
    //< An integer literal against a float is named as such: the fix is writing it as a float.
    op_text: = o.op
    l_shown: = ctx.env.display(o.left_id)
    r_shown: = ctx.env.display(o.right_id)
    ctx.clear_scratch()
        .s("implicit conversion between '\{l_shown\}' and '\{r_shown\}' is forbidden ")
        .s("to prevent data loss. Neither holds every value of the other, so '\{op_text\}' has no \
            type ").s("to compute in. Use an explicit '::' cast")
    has_lit: =
        sema_body_literal.is_untyped_int_literal(o.right) ||
        sema_body_literal.is_untyped_int_literal(o.left)
    if has_lit && (ctx.env.is_float(o.left_id) || ctx.env.is_float(o.right_id))
        ctx.scratch.s(", or write the integer literal as a float ('2.0', not '2')")
    ctx.err(o.node, ctx.scratch.slice())

priv fn refuses_step_from_null(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@): Bool //<
    //< Refuses `U8@::null + 4096` outside `#raw_address`, as a cast of the integer is refused
    //< **A step from `null` makes an address from a number**, the same made-up address
    //< `U8@::4096` gives. So it is allowed only where that cast is (check_pointer_cast_source in
    //< postfix.kspl). Only `null` written there counts: a pointer that holds null at run time is
    //< not known here.
    if ctx.fn_ctx.raw_address || !is_written_null(left)
        return false
    ctx.err(node,
        "a step from 'null' makes an address from a number, which only a function marked \
            '#raw_address' may do\n  Hint: for memory at a fixed address, mark the function \
            '#raw_address' and cast the number ('U8@::4096'). Write 'null' for no address")
    return true

priv fn is_written_null(n: Ast_node$@): Bool //<
    //< Whether n is `null`, in round brackets or cast to a pointer (`U8@::null`)
    $at: = n
    for at != null
        if at.kind_id == .k_null
            return true
        if at.kind_id == .k_expr_primary && at.children.len > 0
            at = at.get_primary_inner_expr()
        else if at.is_explicit_cast()
            at = at.get_postfix_receiver()
        else
            return false
    return false

priv fn pointer_arith_ok(ctx: Sema_ctx@, op_text: U8[], left_id: I32, right_id: I32): Bool //<
    //< Whether pointer arithmetic is in an allowed form
    //< **A form whose left side is not a pointer is not allowed**: C's `i + p` is a second spelling
    //< of one meaning (Principle 6).
    if !ctx.env.is_pointer(left_id)
        return false
    if op_text.equals("+")
        return !ctx.env.is_pointer(right_id) && ctx.env.is_integer(right_id)
    if op_text.equals("-")
        return ctx.env.is_pointer(right_id) || ctx.env.is_integer(right_id)
    return false

priv fn report_bad_pointer_arith(ctx: Sema_ctx$@, node: Ast_node$@, op_text: U8[], left_id: I32,
    right_id: I32) //<
        //< Rejects a disallowed form and lists the three allowed forms.
    l_shown: = ctx.env.display(left_id)
    r_shown: = ctx.env.display(right_id)
    ctx.clear_scratch().s("operator '\{op_text\}' cannot be applied to '\{l_shown\}' and ")
        .s("'\{r_shown\}'. Pointer arithmetic has three forms: 'p + i' and 'p - i' step by ")
        .s("elements and give a pointer, and 'p - q' (same pointee type) counts the elements \
            between ")
    ctx.scratch.s("them")
    ctx.err(node, ctx.scratch.slice())

priv fn points_to_same(ctx: Sema_ctx@, left_id: I32, right_id: I32): Bool //<
    //< Whether two pointers point at the same type
    //< Caution: **Compare with the immutable mark dropped.** Of two pointers into the same array,
    //< one alone can be a read-only view (`U8 immut@`).
    l: = ctx.env.get_clean_real_type(ctx.env.strip_ptr(left_id))
    r: = ctx.env.get_clean_real_type(ctx.env.strip_ptr(right_id))
    return l == r

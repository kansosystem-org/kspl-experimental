//< Expands `for item in collection { … }` according to the subject's type
//< The subject's type chooses the form, so parse cannot expand it ("Desugar: expanding the
//< syntactic sugar that needs no types" in `ksplc/docs/DESIGN-parse.md`).
//< Caution: **Keep the index form (a subject with `.len` and `[]`) the default.** Most subjects
//< are an array, a slice or a `List`, and the `next()` form adds an `Option` per element.
//< The temporary that holds the subject points at a place the index form reads
//< (`hold_for_in_subject`), so the loop reads the live place and moves nothing.

// ==========================================
//   the two forms: by index, and by `next()`
// ==========================================
import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/c_name" as base_c_name
import "ksplc/base/core" as base_core
import "ksplc/sema/body/coerce" as sema_body_coerce
import "ksplc/sema/body/expr" as sema_body_expr
import "ksplc/sema/body/postfix" as sema_body_postfix
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/layout" as sema_decl_layout
import "ksplc/sema/decl/mono" as sema_decl_mono
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error }
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/str" { Str_builder }

priv $for_in_counter: Sz = 0

priv const ITER_TRAIT_FQN: U8[] = "std.lang.Iter" //<
    //< The trait whose implementers `for x in` loops over with `next()`

impl Ast_node
    fn hold_for_in_subject(r: Self$@, c: Sema_ctx$@, subject_id: I32): I32!Sema_error //<
        //< Makes the subject's temporary point at the subject, where the subject is a place
        //< It returns the temporary's type. A place is a name or a `.field` chain of names. A fixed
        //< array is held as a slice over it, as no pointer to it carries its length. Anything else
        //< stays a copy, evaluated once. **An `Iter` is copied too**: `next()` writes its position,
        //< so each loop starts from the subject's own position, and the subject keeps it.
        subject: = r.get_var_decl_expr()
        if !is_named_place(subject) || sema_type_env.is_unknown(subject_id) ||
            drives_by_next(c, subject_id) || c.packed_place_align(subject) != 0
            return subject_id
        if c.env.is_array(subject_id)
            elem_id: = c.env.strip_array(subject_id)
            // An array of arrays stays a copy: no slice holds an array as its element.
            if c.env.is_array(elem_id)
                return subject_id
            view_id: = c.slice_type_of(c.env.make_const(elem_id))
            return subject.wrap_implicit_cast(c, subject_id, view_id)
        place: = subject.snapshot_for_morph(subject_id)
        subject.children = base_ast.new_ast_node_list()
        subject.morph(.k_expr_postfix, "postfix")
        subject.def_node = null
        subject.add_child(place).add_child(Ast_node(.k_literal, "@", subject.loc))
        $ptr_id: = sema_body_postfix.infer_address_postfix(c, subject, place, subject_id)!
        // **The pointer is read-only unless a read needs it writable**, so a spare `$` on the place
        // is still reported (df_decl_var in `../flow/track.kspl`).
        if !c.index_read_needs_writable(subject_id)
            ptr_id = c.env.make_ptr(c.env.make_const(subject_id))
        subject.type_id = ptr_id
        return ptr_id

    fn expand_for_in(r: Self$@, c: Sema_ctx$@): Void!Sema_error //<
        //< Expands the loop if it carries the mark (a bare identifier at the init position)
        item_id: = r.get_for_init()
        if item_id == null || item_id.kind_id != .k_identifier
            return
        coll_ref: = r.get_loop_cond()
        // **Infer here**: the temporary's declaration is the statement just before, so it is typed
        // now.
        coll_id: = coll_ref.infer_expr(c, 0)!
        // **Check `Iter` first**, or a type that supports both silently loses the `Iter` its writer
        // declared (Principle 5); the index form is for a subject that declares nothing.
        if drives_by_next(c, coll_id)
            r.build_step_loop(item_id, coll_ref)
            return
        r.build_index_loop(item_id, coll_ref, c.env.is_slice(c.env.strip_ptr(coll_id)))

    priv fn build_index_loop(r: Self$@, item_id: Ast_node$@, coll_ref: Ast_node$@, over_slice: Bool) //<
        //< The form that loops by index
        //< `for _%for_idxN: = 0; _%for_idxN < coll.len; _%for_idxN += 1 { … }`, leaving the
        //< indexing to sema's index path. **The index is an `Sz`** (`0Sz`): an untyped `0` is an
        //< `I32`, which wraps past 2^31 and reads outside a longer slice.
        //< **Over a slice the element is read as `(coll.ptr + idx)$`**: the condition already
        //< holds the index inside, so the index path's bounds check and call only cost. Any
        //< other subject keeps its own `[]`, which its type may define.
        loc: = r.loc
        idx_name: = base_c_name.made_name(next_temp_name("for_idx"))

        coll_len: = Ast_node.build_field_access(coll_ref.text, 0, "len", 0, loc)
        // The shape treeify_expr (parse/normalize_stmt.kspl) makes: [left, op, right].
        cond_expr: = Ast_node(.k_expr, "expr", loc)
            .add_child(Ast_node.build_ident(idx_name, 0, loc))
            .add_child(Ast_node(.k_literal, "<", loc)).add_child(coll_len)

        step_stmt: = Ast_node(.k_stmt_expr, "assign", loc)
            .add_child(Ast_node.build_ident(idx_name, 0, loc))
            .add_child(Ast_node(.k_assign_op, "+=", loc))
            .add_child(Ast_node.build_int_literal(1, loc))

        $idx_expr: = Ast_node(.k_expr_postfix, "postfix", loc)
            .add_child(Ast_node.build_ident(coll_ref.text, 0, loc))
            .add_child(Ast_node(.k_literal, "[", loc))
            .add_child(Ast_node.build_ident(idx_name, 0, loc))
        if over_slice
            at: = Ast_node(.k_expr, "expr", loc)
                .add_child(Ast_node.build_field_access(coll_ref.text, 0, "ptr", 0, loc))
                .add_child(Ast_node(.k_literal, "+", loc))
                .add_child(Ast_node.build_ident(idx_name, 0, loc))
            idx_expr = Ast_node(.k_expr_postfix, "postfix", loc).add_child(at)
                .add_child(Ast_node(.k_literal, "$", loc))

        idx_decl: = Ast_node.build_inferred_var_decl(Ast_node.build_ident(idx_name, 0, loc),
            Ast_node(.k_integer, "0Sz", loc), loc)
        // **The item's declaration stands where its name is written**, not at the `for` with the
        // temporaries. A reference is matched by position, so it would take theirs for its own.
        item_decl: = Ast_node.build_inferred_var_decl(item_id, idx_expr, item_id.loc)
        r.replace_loop_parts(idx_decl, cond_expr, step_stmt, item_decl)

    priv fn build_step_loop(r: Self$@, item_id: Ast_node$@, coll_ref: Ast_node$@) //<
        //< The form that loops by `next()`
        //< Caution: **Leave the condition and the step empty**: `next()` advances, so anything
        //< there advances twice. It folds like `if item: = coll.next()` (build_option_switch in
        //< `base/ast_ext.kspl`).
        loc: = r.loc
        call: = Ast_node.build_method_call(Ast_node.build_ident(coll_ref.text, 0, loc), "next", null,
            0, loc)
        none_block: = Ast_node.build_block(loc)
            .add_child(Ast_node(.k_stmt_break, "break", loc))
        step: = Ast_node.build_option_switch(call, item_id, r.get_loop_block(), none_block, null,
            base_ast_ext.FOR_IN_MARK, loc)

        loop_children: = base_ast.new_ast_node_list()
        loop_children
            .push(r.get_loop_label() if r.get_loop_label() != null
            else Ast_node.build_empty(loc))
        loop_children.push(Ast_node.build_empty(loc))
        loop_children.push(Ast_node.build_empty(loc))
        loop_children.push(Ast_node.build_empty(loc))
        loop_children.push(Ast_node.build_block(loc).add_child(step))
        r.children = loop_children

    priv fn replace_loop_parts(r: Self$@, init_node: Ast_node$@, cond_node: Ast_node$@,
        step_node: Ast_node$@, item_decl: Ast_node$@) //<
            //< Replaces the for's five children, putting item's declaration at the body's head.
            //< The five children are the label, init, condition, step and body.
        block_node: = r.get_loop_block()
        new_block_children: = base_ast.new_ast_node_list()
        new_block_children.push(item_decl)
        for i in Range.asc(block_node.children.len)
            new_block_children.push(block_node.get_child(i))
        block_node.children = new_block_children

        loop_children: = base_ast.new_ast_node_list()
        loop_children
            .push(r.get_loop_label() if r.get_loop_label() != null
            else Ast_node.build_empty(r.loc))
        loop_children.push(init_node)
        loop_children.push(cond_node)
        loop_children.push(step_node)
        loop_children.push(block_node)
        r.children = loop_children

fn drives_by_next(c: Sema_ctx$@, subject_id: I32): Bool //< whether `next()` drives the loop
    return c.env.implemented_trait_instance(subject_id, ITER_TRAIT_FQN) != 0

priv fn is_named_place(e: Ast_node$@): Bool //< whether it is a name or a `.field` chain of names
    //< A call, an index or a cast is not one: it is evaluated once into a copy.
    if e == null
        return false
    if e.is_path_or_ident()
        return true
    if e.kind_id != .k_expr_postfix || !e.postfix_op_text().equals(".") || e.children.len != 3
        return false
    return e.get_postfix_member().kind_id == .k_identifier &&
        is_named_place(e.get_postfix_receiver())

priv fn next_temp_name(prefix: U8[]): U8[] //< the temporary variable's name
    //< Numbered separately from parse's `for_coll`.
    for_in_counter += 1
    b: = base_core.arena.text()
    b.s(prefix).s("\{for_in_counter\}")
    return b.take()

fn enter_fn_serial(): Sz //< starts the numbering for one function body
    //< Pass the value it returns to `leave_fn_serial`.
    //< **Start from 0 per function.** With one running count, one added `for x in` shifts every
    //< later number. That bloats the generated C's diff ("Measuring where the desugaring goes" in
    //< `ksplc/docs/DESIGN-parse.md`). `for_in_counter` in `../../parse/desugar.kspl` does the same.
    saved: = for_in_counter
    for_in_counter = 0
    return saved

fn leave_fn_serial(saved: Sz) //< restores the count `enter_fn_serial` returned
    for_in_counter = saved

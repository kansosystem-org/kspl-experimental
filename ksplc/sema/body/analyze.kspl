//< The checks on the program as a whole, and on a function body once its types are known
//< On the program, it checks for one `main` with a signature the start-up code can call. It also
//< checks what `--library` refuses, and the unused names ([W0206], [I0402]).
//< On a body, it checks that control cannot fall off the end of a function returning a value. It
//< also checks definite initialization (`sema/flow/track.kspl`), and runs the lints on its return
//< and on the methods that release.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/base/locate" as base_locate
import "ksplc/sema/body/coerce" as sema_body_coerce
import "ksplc/sema/flow/release" as sema_flow_release
import "ksplc/sema/flow/track" as sema_flow_track
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/arc" as sema_type_arc
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" as sema_type_scope + { Sema_symbol }
import "std/chars" // testing and slicing single characters
import "std/ds" { List }
import "std/str"

impl Sema_ctx
    fn check_one_main(r: Self$@) //< checks that there is only one entry point
        //< Caution: **Do not let two or more go unreported.** `find_main_symbol` returns the first
        //< match, so an imported file that holds a `main` **silently builds a program whose own
        //< `main` never runs** (Principle 5). Report every one: if only one is marked, the user
        //< cannot tell which to delete.
        if r.suppress_errors
            return
        $mains: = List<|Sema_symbol$@|>.new(base_core.arena)
        r.env.collect_main_symbols(mains@)
        if mains.len <= 1
            return
        for m in mains
            r.clear_scratch()
                .s("this program defines main() \{mains.len\} times. A program must have exactly \
                    one entry point. Otherwise, file reading order would select one and silently \
                    ignore the others. Remove the extra main(), or move it out of the file being \
                    imported.")
            r.err(m.node, r.scratch.slice())

    fn is_entry_main(r: Self$@, decl: Ast_node$@): Bool //< whether decl is the program's `main`
        ms: = r.env.find_main_symbol().unwrap_or(null)
        return ms != null && ms.node == decl

    fn check_main_signature(r: Self$@) //<
        //< Limits main's shape, visibility and return type to what the entry can call and use
        //< The start-up code calls `main` with no arguments and no type arguments. A `priv` main
        //< is `static` in C, out of reach of the start-up code in another file. Only nothing, an
        //< integer (the exit code) or a Result of either converts meaningfully to C's `int main`.
        //< A freestanding build's return is not checked: the startup code decides what happens.
        if r.suppress_errors
            return
        main_sym: = r.env.find_main_symbol().unwrap_or(null)
        if main_sym == null
            r.check_main_present()
            return
        if !main_sym.kind.is_function()
            r.err(main_sym.node,
                "main() must not take type parameters. Startup calls it without type arguments, so \
                    no instance would be created. Remove the '<|…|>'.")
            return
        if base_ast_ext.Param_cursor.count(main_sym.node.get_fn_params()) > 0
            r.err(main_sym.node,
                "main() takes no parameters. Startup calls it without arguments. Read the command \
                    line with 'sys.args()' (import \"std/sys\").")
            return
        if main_sym.vis == sema_type_scope.Visibility.file_private
            r.err(main_sym.node,
                "main() must not be 'priv'. Startup calls it from outside its file, where private \
                    functions are not visible. Remove 'priv'.")
            return
        if base_core.config.is_freestanding
            return
        ret_id: = main_sym.type_id
        val_id: = r.env.strip_result(ret_id)
        if sema_type_env.is_void(val_id) || r.env.is_integer(val_id)
            return
        r.clear_scratch()
            .s("main() returns '\{r.env.display(ret_id)\}', which is not a supported return type. \
                Return nothing, an integer exit code, or a Result of either ('Void!E' / 'I32!E'). A \
                value of this type cannot become an exit code, so it would be silently discarded.")
        r.err(main_sym.node, r.scratch.slice())

    priv fn check_main_present(r: Self$@) //<
        //< Refuses a program with no `main`, where one is built (`--program`)
        //< `ksplc run` and `ksplc build` pass the option. A plain compile may hold none: its C may
        //< be linked with a `main` written elsewhere.
        if !base_core.config.is_program
            return
        for m_entry in r.env.files.items()
            ms: = m_entry.value.symbols.get("main").unwrap_or(null)
            if ms != null && ms.node != null
                r.err(ms.node,
                    "'main' must be a function. Startup calls it, but this declaration names \
                        something else. Declare 'fn main()' instead.")
                return
        r.report_diagnostic_at(r.main_file, base_core.source_of(r.source_map, r.main_file), 0, 0,
            .error,
            "this program has no main(). Execution starts at 'fn main()', so there is no entry \
                point. Add one, or build a library from '#export' functions with '--library'")

    fn check_library_shape(r: Self$@, root: Ast_node$@) //<
        //< Under `--library`, refuses what a library cannot hold
        //<   - A `main`: the program that links the library has its own.
        //<   - An `#export` variable or constant: a DLL's data needs a mark on its user's side that
        //<     no header can choose.
        //<   - An input exporting no function: the library would hold nothing a caller can reach.
        if r.suppress_errors || !base_core.is_library()
            return
        if main_sym: = r.env.find_main_symbol()
            r.err(main_sym.node,
                "main() must not be in a library ('--library'). The linking program provides main() \
                    and calls the library's '#export' functions. Remove main(), or build without \
                    '--library'")
        $exported: Sz = 0
        for raw in root.children
            n: = raw.unwrap_top_level()
            if !n.has_attribute("export")
                continue
            if n.kind_id == .k_decl_fn
                exported += 1
                continue
            r.err(n,
                "a library ('--library') must not export variables or constants. Windows DLL data \
                    requires a caller-side mark that one header cannot choose for every build. \
                    Export a function that returns it")
        if exported > 0
            return
        r.report_diagnostic_at(r.main_file, base_core.source_of(r.source_map, r.main_file), 0, 0,
            .error,
            "'--library' builds a library from its '#export' functions. This program exports none, \
                so callers could access nothing. Mark the functions its callers use '#export'")

    fn check_unused_symbols(r: Self$@) //<
        //< [W0206] checks **every file the compile read** for unused names
        //< A `priv` can be named only in its own file, and every file is read whole. So a lint of
        //< one entry point also finds a dead helper in a file it imports.
        //< Caution: **Mark the names an uninstantiated template writes first**
        //< (`mark_template_symbols_used`, called in `run` in `infer.kspl`). Unmarked, a helper that
        //< only a generic calls looks unused wherever the generic is not instantiated.
        if r.suppress_errors || !base_core.config.run_lint_checks
            return
        old_file: = r.file_name
        for entry in r.env.files.items()
            r.set_current_file(entry.key)
            r.check_unused_symbols_in(entry.value)
        r.set_current_file(old_file)

    fn check_unit_internal_pubs(r: Self$@) //<
        //< [I0402] A `pub` used only from inside the same package
        //< Off by default. **It checks only the entry's package.** Another unit (`std/` and so on)
        //< just has no outside user in this compilation, and in a library an unused `pub` is
        //< correct.
        if r.suppress_errors || !base_core.config.run_lint_checks
            return
        unit: = base_locate.package_of(r.main_file)
        for entry in r.env.files.items()
            if !base_locate.package_of(entry.key).equals(unit)
                continue
            for s in entry.value.symbols.items()
                sym: = s.value
                if sym.vis != sema_type_scope.Visibility.public ||
                    sym.flags.is_used_outside_unit
                    continue
                // Caution: **Check only declarations that state their own visibility**, or the user
                // cannot act on the report. An enum's variants inherit the enum's, and an import
                // has nowhere to write one. A `pub` sits under the declaration or in the attribute
                // list, so only `has_explicit_visibility` decides.
                if !sym.node.has_explicit_visibility()
                    continue
                // **Nor can the user drop `pub` from a synthesized symbol**: an enum's members
                // (`made_by_compiler`, from `parse/load.kspl`) and a lifted anonymous function
                // (`_anon_env_N.call`).
                if sym.node.made_by_compiler() || sym.name.find_str("._anon_").is_some()
                    continue
                // Nor from a generated instance; and a function called from C has users that the
                // unit's references do not show.
                if sym.flags.is_export || sym.flags.is_generated_instance ||
                    sym.flags.is_premangled || sym.name.starts_with("_") ||
                    sym.name.equals("main") || sym.name.equals("kspl_main")
                    continue
                r.clear_scratch()
                    .s("[I0402] Public symbol '\{sym.name\}' is only used inside its own package \
                        ('\{unit\}'). Remove 'pub' to keep it within the package. 'pub' declares an \
                        external contract.")
                r.information(sym.node, r.scratch.slice())

    priv fn check_unused_symbols_in(r: Self$@, file_env: sema_type_scope.File_env$@)
        for entry in file_env.symbols.items()
            sym: = entry.value
            // Caution: **Do not reject a `#export` on a `priv` here** (`sema/decl/attrs.kspl`
            // does). This runs only under lint, so a build would let it pass silently.
            if sym.vis != sema_type_scope.Visibility.file_private || sym.flags.is_used ||
                sym.flags.is_required
                continue

            if sym.name.starts_with("_") || sym.name.equals("main") ||
                sym.name.equals("kspl_main")
                continue

            $kind_str: U8$[] = "symbol"
            switch sym.kind
            case .function
                kind_str = "function"
            case .constant
                kind_str = "constant"
            case .variable
                kind_str = "variable"
            case .struct_def
                kind_str = "struct"
            case .enum_def
                kind_str = "enum"
            case .alias_def
                kind_str = "typedef"
            case .trait_def
                kind_str = "trait"
            default {}
            r.clear_scratch()
                .s("[W0206] Unused private \{kind_str\} '\{sym.name\}'. Prefix with '_' to ignore \
                    or remove it.")
            r.warn(sym.node, r.scratch.slice())

impl Ast_node
    fn analyze_function_body(r: Self$@, c: Sema_ctx$@, block: Ast_node$@): Bool
        if block == null
            return true

        $ok: = true
        $is_void_ok: = false
        base_ret_id: = c.env.strip_result(c.fn_ctx.ret_id)
        if sema_type_env.is_void(base_ret_id) || sema_type_env.is_unknown(base_ret_id)
            is_void_ok = true

        if !is_void_ok && !block.is_guaranteed_to_leave(false)
            ret_str: = c.env.display(c.fn_ctx.ret_id)
            fn_name: = c.fn_ctx.name
            c.clear_scratch()
                .s("function '\{fn_name\}' is expected to return '\{ret_str\}', but control may \
                    reach the end without returning")
            c.err(r, c.scratch.slice())
            ok = false

        if r.has_attribute("noreturn") && !r.keeps_noreturn(c, block)
            ok = false

        if !sema_flow_track.analyze_definite_initialization(c, r, block)
            ok = false

        if base_core.config.run_lint_checks && block.children.len > 0
            if is_void_ok
                last_stmt: = block.last_child()
                if last_stmt.kind_id == .k_stmt_return && last_stmt.get_return_expr() == null
                    c.information(last_stmt,
                        "[I0305] Redundant 'return' at the end of a Void function.")
            r.lint_nullable_pointer_return(c, block, base_ret_id)
            r.lint_release_method_spelling(c)
        return ok

    priv fn keeps_noreturn(r: Self$@, c: Sema_ctx$@, block: Ast_node$@): Bool //<
        //< Whether a `#noreturn` function's body hands control back by no path, reporting each one
        //< **C trusts the attribute and only warns** (`-Winvalid-noreturn`): a caller compiled on
        //< the promise runs on past the call into whatever follows it.
        $ok: = block.report_way_back(c)
        if !block.is_guaranteed_to_leave(true)
            c.clear_scratch()
                .s("function '\{c.fn_ctx.name\}' is declared '#noreturn', but control may reach the \
                    end of its body. End it with a call that does not return (such as 'sys.exit' or \
                    'panic') or an endless 'for'")
            c.err(r, c.scratch.slice())
            ok = false
        return ok

    priv fn report_way_back(r: Self$@, c: Sema_ctx$@): Bool //<
        //< Reports each `return`, `throw` and `!` under r, which return to the caller; false if any
        //< A function literal inside is a body of its own, so it is not looked into.
        if r == null || r.kind_id == .k_expr_fn_lit
            return true
        $ok: = true
        $way: = ""
        if r.kind_id == .k_stmt_return
            way = "return"
        else if r.kind_id == .k_stmt_throw
            way = "throw"
        else if r.kind_id == .k_expr_postfix && r.get_postfix_op().is_literal("!")
            way = "!"
        if way.len > 0
            c.clear_scratch()
                .s("'\{way\}' returns to the caller, but the function is declared '#noreturn'. This \
                    declaration promises that control never returns")
            c.err(r, c.scratch.slice())
            ok = false
        for ch in r.children
            if !ch.report_way_back(c)
                ok = false
        return ok

    priv fn lint_release_method_spelling(r: Self$@, c: Sema_ctx$@) //<
        //< [W0107] Warns at a declaration that releases through an untracked name or contract
        //< **Two routes are tracked. Warn only when neither applies.** Visibility and the arguments
        //< after the first are ignored (a `priv` can conform, and `free(r, arena)` releases too). A
        //< free function is checked as well, since a release can be written that way too.
        name: = r.get_decl_id_text()
        is_free: = name.equals("free")
        if !is_free && !sema_flow_release.is_untracked_release_name(name)
            return
        params: = r.get_fn_params()
        if params == null || params.children.len == 0
            return
        recv: = params.get_child(0)
        if recv == null || !c.env.is_pointer(recv.type_id) ||
            c.env.has_release_contract(recv.type_id)
            return
        if r.body_frees_param_directly(recv.get_decl_id_text(), c)
            return // tracked by route 2
        sb: = c.clear_scratch()
        if c.fn_ctx.impl_name.len > 0
            sb
                .s("[W0107] '\{name\}' releases the receiver, but its type does not conform to \
                    'Manual_free'. Use-after-free is therefore not tracked. Add 'impl \
                    \{c.fn_ctx.impl_name\}: Manual_free {}'")
                .s(" and spell the method 'free'." if !is_free else ".")
        else
            sb
                .s("[W0107] '\{name\}' releases its first parameter, but that type does not conform \
                    to 'Manual_free'. Use-after-free is therefore not tracked. Make it a 'free' \
                    method on the type and conform it to 'Manual_free'.")
        c.warn(r, c.scratch.slice())

    fn lint_nullable_pointer_return(r: Self$@, c: Sema_ctx$@, block: Ast_node$@, base_ret_id: I32) //<
        //< [H0701] Suggests `T?` where a function returns a raw pointer that can be null
        //< It is a Hint, not an Information. Existing code often returns null for "not found", and
        //< an Information would break CI's gate that requires zero items.
        //< **Only memory and C hand out a raw null** (`null_is_their_word` below).
        if null_is_their_word(r.loc.file()) || !c.env.is_pointer(base_ret_id)
            return
        $is_export: = false
        if r.sym_ptr != null
            sym: = Sema_symbol$@::r.sym_ptr
            is_export = sym.flags.is_export
        if is_export || !block.contains_return_null(block)
            return
        c.clear_scratch()
            .s("[H0701] Function '\{c.fn_ctx.name\}' can return a null pointer. This includes null \
                literals, conditional expressions with a null branch, and locals assigned null. \
                Return 'T?' to require callers to handle absence explicitly.")
        c.hint(r, c.scratch.slice())

    fn contains_return_null(r: Self$@, body: Ast_node$@): Bool //<
        //< Whether a `return` anywhere in the subtree can hand back null, nested blocks included
        //< What follows a call declared `#noreturn` in the same block is never reached, so the
        //< `return` a function needs after an internal-error stop does not count.
        if r == null
            return false
        if r.kind_id == .k_stmt_return
            return r.get_return_expr().may_be_null(body)
        for ch in r.children
            if ch.contains_return_null(body)
                return true
            if ch.kind_id == .k_stmt_expr && ch.children.len > 0 &&
                ch.get_child(0).is_noreturn_call()
                return false
        return false

    priv fn may_be_null(r: Self$@, body: Ast_node$@): Bool //<
        //< Whether a returned value can be null: `null`, an `if … else` with such a side, or a local
        //< **A local counts when the body assigns it null anywhere**, without following the flow. A
        //< list's head kept null until the first push is the case to catch. Shadowing is refused
        //< ([I0501]), so one name is one variable. A local whose address is lent (`p@`) does not
        //< count: what is written through the address goes unseen.
        if r == null
            return false
        switch r.kind_id
        case .k_null
            return true
        case .k_result_wrap
            return r.get_result_wrap_inner().may_be_null(body)
        case .k_expr_ternary
            return r.get_ternary_true().may_be_null(body) ||
                r.get_ternary_false().may_be_null(body)
        default
            name: = r.local_name()
            return name.len > 0 && body.assigns_null_to(name) && !body.lends_address_of(name)

    priv fn assigns_null_to(r: Self$@, name: U8[]): Bool //<
        //< Whether the subtree declares `name` with null, or assigns null to it with `=`
        if r == null
            return false
        $right: Ast_node$@ = null
        $left: Ast_node$@ = null
        if r.kind_id == .k_decl_var
            left = r.get_var_decl_id()
            right = r.get_var_decl_expr()
        else if r.kind_id == .k_stmt_expr && r.get_assign_op() != null &&
            r.get_assign_op().text.equals("=")
            left = r.get_assign_left()
            right = r.get_assign_right()
        if left.local_name().equals(name) && right.is_null_side()
            return true
        for ch in r.children
            if ch.assigns_null_to(name)
                return true
        return false

    priv fn lends_address_of(r: Self$@, name: U8[]): Bool //< whether the subtree takes `name@`
        if r == null
            return false
        if r.kind_id == .k_expr_postfix && r.postfix_op_text().equals("@") &&
            r.get_postfix_receiver().local_name().equals(name)
            return true
        for ch in r.children
            if ch.lends_address_of(name)
                return true
        return false

    priv fn local_name(r: Self$@): U8[] //< the name, when `r` is one name alone; empty otherwise
        if !r.is_path_or_ident()
            return ""
        name: = r.get_path_or_ident_name()
        return name if r.text.equals(name) else ""

    priv fn is_null_side(r: Self$@): Bool //< `null`, or an `if … else` with a `null` side
        if r == null
            return false
        if r.kind_id == .k_expr_ternary
            return r.get_ternary_true().is_null_side() ||
                r.get_ternary_false().is_null_side()
        return r.kind_id == .k_null

    fn is_guaranteed_to_leave(r: Self$@, any_exit: Bool): Bool //<
        //< Whether control cannot fall off the end of `r`
        //< **Two questions, two sets of exits.** Without `any_exit` (the missing-return check: does
        //< C get a `return`) only `return`, `throw` and an endless loop count. With it (a catch
        //< block, and [H0801] of an `if` branch: can control reach what follows) `fallback`,
        //< `break`, `continue` and a call declared not to return count too.
        // **Control continues after a statement a `break` leaves**, whatever its inside does:
        // `blk: { if c { break blk; } return 1; }` can still reach the end.
        if r == null || r.is_left_by_break()
            return false
        switch r.kind_id
        case .k_stmt_return, .k_stmt_throw
            return true
        case .k_stmt_fallback, .k_stmt_break, .k_stmt_continue
            return any_exit
        case .k_stmt_for
            // **Control never leaves a loop with no condition and no `break`** (`con.exit(); for
            // {}` is how a freestanding probe stops), in a function body as in a catch block.
            return r.is_endless_loop()
        case .k_stmt_expr
            // **A call declared not to return ends the block.** Only `any_exit` asks this; a
            // function body asks whether C gets a `return`.
            return any_exit && r.children.len > 0 && r.get_child(0).is_noreturn_call()
        case .k_stmt_block
            for child in r.children
                if child.is_guaranteed_to_leave(any_exit)
                    return true
            return false
        case .k_stmt_if
            then_block: = r.get_if_then_block()
            else_block: = r.get_if_else_block()
            return then_block != null && else_block != null &&
                then_block.is_guaranteed_to_leave(any_exit) &&
                else_block.is_guaranteed_to_leave(any_exit)
        case .k_stmt_switch
            return r.ret_stmt_switch(any_exit)
        case .k_stmt_labeled_block
            return r.children.len > 1 && r.get_child(1).is_guaranteed_to_leave(any_exit)
        default
            return false

    fn ret_stmt_switch(r: Self$@, any_exit: Bool): Bool //<
        //< Whether every case of the switch, its default included, is sure to leave.
        //< Note: has_default needs no check. sema/body/switch.kspl requires 'default' on a non-enum
        //< switch, or every variant covered without it (process_switch_exhaustiveness). So a switch
        //< here always enters a case or the default.
        $all_returns: = true
        $has_case: = false
        for i in Range.asc(r.children.len)
            if r.get_child(i).is_keyword("case") || r.get_child(i).is_keyword("default")
                has_case = true
                $has_ret: = false
                for $j: = i + 1; j < r.children.len; j += 1
                    c2: = r.get_child(j)
                    if c2.kind_id == .k_stmt_block
                        has_ret = c2.is_guaranteed_to_leave(any_exit)
                        break
                    if c2.is_keyword("case") || c2.is_keyword("default")
                        break
                if !has_ret
                    all_returns = false
        return has_case && all_returns

priv fn null_is_their_word(file: U8[]): Bool //<
    //< Whether a file's raw `null` return is its contract, so [H0701] does not ask about it
    //< **Memory (`std/mem`) and C (`std/libc`) speak in raw pointers**: an allocation that fails is
    //< a null, and so is C's "none". Everywhere else, std included, absence is a `T?`. A function
    //< carrying `#export` is the other C boundary, judged at the check.
    name: = file.strip_kspl_ext()
    return name.equals("std/mem") || name.equals("std/libc")

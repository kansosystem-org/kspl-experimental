//< Resolves what is to the right of a `.`
//< Three cases: a namespace, a built-in name, and a field or method.
//< **`[]` and `as` are not here** (`ksplc/sema/body/postfix.kspl`): in one file, branching on the
//< receiver's type would mix with branching on the name to the right. The enum-only rewrite of
//< `\{e\}` lives here too, **so `.` is resolved in one place**.
import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/base/locate" as base_locate
import "ksplc/sema/body/resolve_path" as sema_body_resolve_path
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/mono_name" as sema_decl_mono_name
import "ksplc/sema/decl/mono_queue" as sema_decl_mono_queue
import "ksplc/sema/decl/name" as sema_decl_name
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/decl/type_check" as sema_decl_type_check
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error }
import "ksplc/sema/session/import_table" // `is_file_imported`
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" as sema_type_scope + { Sema_symbol }
import "std/chars"
import "std/ds" { List }
import "std/math"
import "std/str" { Str_builder }

fn try_rewrite_enum_fmt(node: Ast_node$@, left: Ast_node$@, c: Sema_ctx$@): Bool!Sema_error //<
    //< Rewrites `\{e\}` on an enum into `w.s(e.variant_name())`
    //< A string interpolation `\{e\}` desugars into `put(w, e)`; it is rewritten only for an enum.
    //< No `fmt` is synthesized on an enum, since that would give every enum a `Formattable` vtable.
    //< Caution: **Do not rewrite if the user wrote `fmt`**, or their format is silently ignored.
    if left == null || (left.kind_id != .k_expr_path && left.kind_id != .k_identifier)
        return false
    args: = node.find_child(.k_expr_args)
    if args == null || args.children.len != 2
        return false
    // Caution: **Decide by the FQN the desugaring wrote** (`PUT_FQN` in `../../base/core.kspl`).
    // A user's own call to `put` that takes an enum would otherwise have its body silently
    // replaced.
    if left.kind_id == .k_expr_path && left.children.len > 1
        return false
    callee_name: = left.get_path_name() if left.kind_id == .k_expr_path else left.text
    if !callee_name.equals(base_core.PUT_FQN)
        return false
    named: = c.read_written_name(left)
    if named.template == null || !named.fqn.equals("std.lang.put")
        return false
    recv: = args.get_child(1)
    // **recv must not be inferred here**: every non-enum `put(w, X)` would be inferred twice,
    // breaking its method resolution. So only an identifier counts; for `\{x.field\}` write
    // `\{x.field.variant_name()\}`.
    if recv == null || (recv.kind_id != .k_expr_path && recv.kind_id != .k_identifier)
        return false
    sym: = c.read_written_name(recv).sym
    if sym == null || !sym.kind.is_var_or_const() || sym.type_id == 0
        return false
    base_id: = c.env.get_clean_real_type(c.env.receiver_base_id(sym.type_id))
    $is_enum: = false
    switch c.env.get_info(base_id)
    case .enum_type
        is_enum = true
    default {}
    if !is_enum
        return false
    t_entry: = c.env.id_to_type.get(base_id)
    if t_entry == null
        return false
    // Caution: **Finish building the method table before the lookup.** A generic enum first
    // instantiated in a method's signature has its table deferred (ensure_instance_methods in
    // mono_queue.kspl). Until it is built, the synthesized `variant_name` is invisible, and correct
    // code fails with "`Formattable` not implemented".
    c.ensure_instance_methods(base_id) catch {}
    if _user_fmt: = t_entry.get_method("fmt")
        return false // the fmt the user wrote is respected
    switch t_entry.get_method("variant_name")
    case .none
        return false // no variant_name was synthesized (for a const generic, for example)
    case .some {}

    writer: = args.get_child(0)
    name_call: = Ast_node.build_method_call(recv, "variant_name", null, 0, node.loc)
    rewritten: = Ast_node.build_method_call(writer, "s", name_call, 0, node.loc)
    node.morph(rewritten.kind_id, rewritten.text)
    node.children = rewritten.children
    node.type_id = 0
    return true

priv fn refuse_variant_list(c: Sema_ctx$@, node: Ast_node$@, enum_id: I32, member: U8[]): Bool //<
    //< Reports `variants` or `from_variant_name` asked of an enum whose variant carries data
    //< The compiler makes the two only for an enum whose variants carry no payload
    //< (`append_enum_members` in `../../parse/load.kspl`). Without this, the use reads as an
    //< undefined name, and its hint says the enum is not a type.
    if !member.equals("variants") && !member.equals("from_variant_name")
        return false
    enum_def: = c.env.get_enum_def(c.env.get_str(enum_id)).unwrap_or(null)
    if enum_def == null || enum_def.is_scalar()
        return false
    entry: = c.env.id_to_type.get(enum_id)
    if entry != null && entry.peek_method(member).is_some()
        return false // the file writes its own
    $carrier: U8[] = ""
    for v in enum_def.variants_list
        if v.payload_fields.len > 0
            carrier = v.name
            break
    shown: = c.env.display(enum_id)
    c.clear_scratch()
        .s("enum '\{shown\}' has no '\{member\}': its variant '\{carrier\}' carries data, and a \
            value with data cannot be listed or read back from a name. Only an enum whose variants \
            carry no payload gets 'variants()' and 'from_variant_name(name)'")
    c.err(node, c.scratch.slice())
    return true

fn infer_namespace_access(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@,
    sym_ptr: Sema_symbol$@, is_enum: Bool, expected_id: I32): I32!Sema_error
    member_node: = node.get_postfix_member()
    node.ice_assert(member_node != null, "Missing member identifier after namespace access")
    member_name: = member_node.text
    // The type left names, instantiated when it carries type arguments; 0 where left names none.
    $owner_id: = 0

    // A generic enum's variant (Option<|I32|>.some(v), mod.Option<|I32|>.some): left resolves to
    // the template. So is_enum stays false, and nothing is monomorphized. A left with type
    // arguments is therefore instantiated here (instantiate_struct handles enums too). A variant
    // found there is enum_init.
    // Caution: **Read the name as written** (`m.Box`, not the last segment `Box`). A bare name is
    // looked up as this file's, and can find another file's type of that name.
    if left.find_child(.k_type_args) != null
        written: = c.read_written_type(left)
        tmpl: = c.written_template(written)
        // A type that declares no type parameters takes none (`Plain<|I32|>.mk(3)`); the call goes
        // on through the type itself, as the refused arguments would bind nothing.
        if named: = c.written_type_symbol(written)
            if tmpl == null && named.kind.is_type()
                sema_decl_type_check.refuse_type_args_on_plain_type(c, written)
        if tmpl != null && written.args != null
            // Caution: **Suppress only the arguments' resolution.** The instance is cached, so an
            // error inside it, suppressed on a first use of this shape, is never reported.
            saved_sup: = c.suppress_errors
            c.suppress_errors = true
            args: = written.args.build_resolved_type_args(c, tmpl)
                catch sema_decl_resolve.unknown_args()
            c.suppress_errors = saved_sup
            $inst_name: = c.instance_written(written, args, node)
                catch sema_decl_mono_name.unknown_type_str()
            cid: = c.env.get_or_add(inst_name.slice())
            owner_id = cid
            inst_name.free()
            if inst_def: = c.env.get_enum_def(c.env.get_str(cid))
                switch inst_def.get_variant(member_name)
                case .some
                    node.set_kind(.k_enum_init)
                    node.type_id = cid
                    return cid
                case .none {}

    // An alias names the enum itself ("A typedef is only another name" in
    // docs/SPEC-programming-language.md), so `Tone.dark` is the enum's variant. It is typed by the
    // name as written, as `Pt::{…}` is, so a diagnostic spells it as the source does.
    if is_enum || (sym_ptr != null && sym_ptr.kind.is_alias())
        enum_name: = c.env.get_str(c.env.get_real_type(sym_ptr.type_id))
        $variant_def: sema_type_def.Enum_variant$@ = null
        if enum_def: = c.env.get_enum_def(enum_name)
            switch enum_def.get_variant(member_name)
            case .some(d)
                variant_def = d
            case .none {}

        if variant_def != null
            node.set_kind(.k_enum_init)
            node.type_id = sym_ptr.type_id
            return sym_ptr.type_id
        if refuse_variant_list(c, node, c.env.get_real_type(sym_ptr.type_id), member_name)
            if c.fn_ctx.callee == node
                throw .analysis_failed
            return I32::sema_type_env.Builtin_type_id.unknown
        // Not a variant: continue to the static-method resolution.
    type_args_node: = node.get_type_args()
    // **A method named as a value, not called**, is resolved here, where the type is known. The
    // flattened path below would lose the instance its written type arguments name.
    $owner_tmpl: Ast_node$@ = null
    if owner_id == 0
        if left.kind_id == .k_primitive_type
            owner_id = left.type_id
        else if sym_ptr != null && sym_ptr.kind.is_generic_type()
            owner_tmpl = sym_ptr.node
        else if sym_ptr != null && sym_ptr.kind.is_type()
            owner_id = c.env.get_real_type(sym_ptr.type_id)
        else if left.get_path_name().equals("Self") && c.fn_ctx.impl_name.len > 0
            owner_id = c.env.type_to_id.get(c.fn_ctx.impl_name).unwrap_or(0)
    is_value: = c.fn_ctx.callee != node

    $new_path: = Str_builder()
    new_path.s(left.text).s(".").s(member_name)
    if type_args_node != null
        new_path.s(type_args_node.text)

    node.set_kind(.k_expr_path)
    slice: = new_path.slice()
    node.text = base_core.arena.dup_str(slice)
    new_path.free()
    flat: = base_ast.new_ast_node_list()
    if left.kind_id == .k_identifier || left.kind_id == .k_primitive_type
        flat.push(left)
    else
        for child in left.children
            flat.push(child)

    flat.push(member_node)
    if type_args_node != null
        flat.push(type_args_node)
    node.children = flat
    if owner_tmpl != null
        sema_body_resolve_path.refuse_method_of_bare_generic(c, node, left, member_node, owner_tmpl,
            !is_value)
        // A call stops here: its own lookup would find the template's member and build it from
        // nothing, or report the name undefined a second time.
        if !is_value
            throw .analysis_failed
        return I32::sema_type_env.Builtin_type_id.unknown
    has_owner: = owner_id != 0 && !sema_type_env.is_unknown(owner_id)
    if is_value && has_owner
        return sema_body_resolve_path.infer_method_value(node, c, owner_id, left, member_node,
            type_args_node, expected_id)!
    // **A generic method called through its type** has no function until the call instantiates it.
    // The call does so from the type left names and the method's own type arguments
    // (sema/body/call.kspl). The type is recorded on the path's owner for that, since the flattened
    // path no longer holds what left resolved to.
    // So is any method of a generic type's instance: the call takes it from the instance's table
    // (instance_method in sema/decl/name.kspl).
    if has_owner
        owner_base: = c.env.receiver_base_id(owner_id)
        if _tmpl: = sema_decl_mono_name.lookup_method_template(c, owner_base, member_name)
            sema_decl_name.named_fn(node).owner.type_id = owner_id
            return I32::sema_type_env.Builtin_type_id.unknown
        if _sym: = c.instance_method(owner_id, member_name)
            sema_decl_name.named_fn(node).owner.type_id = owner_id
            return I32::sema_type_env.Builtin_type_id.unknown
        // An instance whose type arguments were refused has no methods, and that was the one
        // mistake (check_type_constraint reports it at the type's use).
        if c.has_failed_constraint(c.env.base_type_name(owner_id))
            sema_decl_name.named_fn(node).owner.type_id = owner_id
            return I32::sema_type_env.Builtin_type_id.unknown
    return sema_body_resolve_path.infer_path_expr(node, c, expected_id)!

fn check_builtin_dot_access(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, recv_id: I32,
    member_node: Ast_node$@): I32? //<
        //< Resolves a member of a built-in type: a slice's, a Result's or an array's; else none
        //< recv_id is the receiver type with pointers already stripped by the caller's
        //< receiver_base_id. This function ignores pointers entirely. The backend emits the
        //< dereference from the receiver's pointer depth (emit_postfix_dot in gen/c/expr.kspl,
        //< `.`'s lvalue path in gen/llvm/expr.kspl).
    member_name_raw: = member_node.text
    target_info: = c.env.get_info(recv_id)
    $is_slice: = false
    $is_array: = false
    $base_slice_id: = recv_id
    $arr_size: I32 = -1

    slice_base: = c.env.slice_struct_elem(recv_id)
    if slice_base != 0
        is_slice = true
        base_slice_id = slice_base
    switch target_info
    case .array(_b, s)
        is_array = true
        arr_size = s
    default {}

    // Caution: **Set the type on the member too.** The editor reads it from there; without it,
    // `.len` and `.ptr` would be the only members a hover shows nothing for.
    if is_slice && member_name_raw.equals("len")
        member_node.ival = 1
        member_node.type_id = I32::sema_type_env.Builtin_type_id.size_type
        return .some(member_node.type_id)
    if is_slice && member_name_raw.equals("ptr")
        member_node.ival = 0
        member_node.type_id = c.env.make_ptr(base_slice_id)
        return .some(member_node.type_id)
    if is_array && member_name_raw.equals("len")
        if arr_size >= 0
            if base_core.config.run_lint_checks && left != null && left.has_side_effect()
                c.warn(left,
                    "[W0102] Expression has side effects. Compile-time array length evaluation \
                        discards the expression.")
            defer $sb: = Str_builder()
            sb.s("\{arr_size\}")
            node.morph(.k_integer, sb.slice())
            return .some(I32::sema_type_env.Builtin_type_id.size_type)

        c.err(node, "cannot get the length of an array with unresolved size")
        return .some(I32::sema_type_env.Builtin_type_id.size_type)
    return .none

fn format_spec_item(method_name: U8[]): U8[] //<
    //< Returns the format spec item whose desugaring calls method_name, or empty if there is none
    //< The item is the SPEC of `\{value:SPEC\}`, as the user writes it.
    //<
    //< Caution: **Do not hard-code the method names.** Their canonical source is `fmt_method_*` in
    //< `ksplc/base/core.kspl`, which `ksplc/parse/format_spec.kspl` uses too.
    if method_name.equals(base_core.FMT_METHOD_PREC)
        return "'.N'"
    if method_name.equals(base_core.FMT_METHOD_HEX)
        return "'x' / 'X'"
    if method_name.equals(base_core.FMT_METHOD_CHAR)
        return "'c'"
    if method_name.equals(base_core.FMT_METHOD_SPEC)
        return "the width / '0' / ',' items"
    return ""

priv fn reject_unimported_spec(c: Sema_ctx$@, member_node: Ast_node$@, spec_item: U8[],
    method_name: U8[], file: U8[]) //<
        //< Reports that a format spec's method is defined in a file this one does not import
        //< Caution: **Name the item as written, not only the method.** `\{v:x\}` writes no
        //< `fmt_hex`, so a message naming only the method points at nothing in the source.
    c.clear_scratch()
        .s("format spec: writing \{spec_item\} calls '\{method_name\}' in '\{file\}'. This file \
            does not import '\{file\}'\n  Note: add 'import \"\{file\}\"' to this file")
    c.err(member_node, c.scratch.slice())

priv fn reject_slotless_trait_call(c: Sema_ctx$@, recv_id: I32, member_name_raw: U8[],
    target_id: I32, member_node: Ast_node$@) //<
        //< Rejects a call through an interface value to a method that has no vtable slot
        //< target_id is the type as the user wrote it (for the diagnostic). recv_id is the
        //< receiver type stripped of pointers and immutability (for the lookup).
        //< Caution: **Do not let a method with no slot pass.** A method with a default body is not
        //< in the vtable (has_vtable_slot in `../../base/ast_ext.kspl`). **Call this on both the
        //< found and the not-found path**; a trait value's method takes the found path.
    switch c.env.get_info(c.env.receiver_base_id(recv_id))
    case .trait_type(slot_def)
        for m_sym in slot_def.methods_list
            if m_sym.name.equals(member_name_raw) && !m_sym.node.has_vtable_slot()
                base_type_str: = c.env.display(target_id)
                c.clear_scratch()
                    .s("method '\{member_name_raw\}' of interface '\{base_type_str\}' has a default \
                        body. It has no vtable slot, so it cannot be called through an interface \
                        value. Call it on the concrete type, or through a type parameter bound by \
                        the interface. These calls reach the body that each implementation received \
                        directly. The interface dispatches only methods that it declares without a \
                        body")
                c.err(member_node, c.scratch.slice())
                break
    default {}

fn infer_dot_access(c: Sema_ctx$@, node: Ast_node$@, _left: Ast_node$@, target_id: I32,
    recv_id: I32, expected_id: I32): I32
    member_node: = node.get_postfix_member()
    node.ice_assert(member_node != null, "Missing member identifier after '.'")
    member_name_raw: = member_node.text
    // The method's own type arguments stay a child of the access, not part of its name.
    type_args_node: = node.get_type_args()

    if fast_out: = check_builtin_dot_access(c, node, _left, recv_id, member_node)
        return fast_out

    $found: = false
    $type_id: = I32::sema_type_env.Builtin_type_id.unknown
    defer $search_types: = List<|U8[]|>(null)

    // Two candidates suffice: with pointers stripped, only immutability differs.
    search_types.push(c.env.get_str(recv_id))
    // The type with immutability stripped at every level finds the mutable type's methods. It is
    // built through the type id: editing the string would confuse an immutable element with an
    // immutable view. The reverse is not needed; collect_impl_decl rejects an immutable impl
    // target.
    stripped_id: = c.env.strip_const_deep(recv_id)
    if stripped_id != recv_id
        search_types.push(c.env.get_str(stripped_id))

    for current_search_type in search_types
        s_id: = c.env.get_or_add(current_search_type)
        s_entry: = c.env.id_to_type.get(c.env.get_real_type(s_id))
        if s_entry != null
            if field_type: = find_field(c, node, member_node, s_entry, current_search_type)
                type_id = field_type
                found = true
                break
            // **Finish building the receiver's method table before the lookup.** The type may be
            // instantiated inside this expression (`deepen(s).tag()`), and an unbuilt table says
            // "no such method" (`ksplc/tests/generic_queue_test.kspl`).
            // Caution: **Do not build it before the fields**; they exist as soon as the instance
            // does.
            c.ensure_instance_methods(recv_id) catch {}
        hit: = find_method(c, s_entry, s_id, current_search_type, member_name_raw)
        if hit.def == null
            continue
        if c.fn_ctx.callee != node
            refuse_method_value_on_value(c, member_node, recv_id)
            return I32::sema_type_env.Builtin_type_id.unknown
        found = true
        member_node.def_node = hit.def
        node.def_node = hit.def
        if hit.sym != null
            hit.sym.flags.is_used = true
            check_method_import(c, member_node, hit.sym, recv_id)
            c.check_visibility_and_mark_used(hit.sym, node)
        type_id = hit.type_id
        reject_slotless_trait_call(c, recv_id, member_name_raw, target_id, member_node)
        node.set_kind(.k_method_access)
        member_node.type_id = c.env.get_or_add(current_search_type)
        break

    if !found
        if target_id != 0 && !sema_type_env.is_unknown(target_id)
            report_missing_member(c, member_node, recv_id, target_id, c.fn_ctx.callee == node)
        reject_slotless_trait_call(c, recv_id, member_name_raw, target_id, member_node)
        node.set_kind(.k_method_access)
        if !sema_type_env.is_unknown(expected_id)
            type_id = expected_id

    if node.kind_id == .k_method_access
        new_children: = base_ast.new_ast_node_list()
        new_children.push(node.get_postfix_receiver())
        new_children.push(member_node)
        if type_args_node != null
            new_children.push(type_args_node)
        node.children = new_children

    return type_id

priv fn find_field(c: Sema_ctx$@, node: Ast_node$@, member_node: Ast_node$@,
    s_entry: sema_type_def.Entry$@, search_type: U8[]): I32? //<
        //< The type of the field member_node names, where the receiver is a struct that has one
        //< It links the access to the field and checks the field's visibility.
    switch s_entry.info
    case .struct_type(struct_def)
        for f_idx in Range.asc(struct_def.fields_list.len)
            field: = struct_def.fields_list.get(f_idx)
            if !field.name.equals(member_node.text)
                continue
            member_node.def_node = field.node
            node.def_node = field.node
            member_node.ival = I32::f_idx
            if c.symtab.resolve(search_type).is_some()
                c.check_field_visibility(field, node)
            return .some(field.type_id)
    default {}
    return .none

priv struct Method_hit //< the method a `.name` finds
    def: Ast_node$@ //< its declaration, or null where none is found
    sym: Sema_symbol$@
    type_id: I32

priv fn find_method(c: Sema_ctx$@, s_entry: sema_type_def.Entry$@, s_id: I32, search_type: U8[],
    name: U8[]): Method_hit //<
        //< The method `name` of the type: from its method table, a generic template, or by its FQN
        //< A method whose return type is `Unknown` (a typo in a type argument) still counts.
        //< Treated as absent, it would add a false "no such method" after the real error. Unknown
        //< silences later errors.
    $hit: = Method_hit::{ .def = null, .sym = null,
        .type_id = I32::sema_type_env.Builtin_type_id.unknown }
    if s_entry != null
        if sym: = s_entry.get_method(name)
            hit = Method_hit::{ .def = sym.node, .sym = sym, .type_id = sym.type_id }
            if hit.def != null
                return hit
    defer $full_name: = Str_builder()
    full_m_name: = full_name.s(search_type).c('.').s(name).slice()
    if tmpl: = sema_decl_mono_name.lookup_method_template(c, s_id, name)
        if tmpl.node != null
            generic_fn_node: = tmpl.node
            hit.def = generic_fn_node
            // A generic method has no Sema_symbol until monomorphization (register_template in
            // declare.kspl).
            // Caution: Create one here, or the visibility and import checks are skipped entirely
            // (a `priv` generic method becomes callable from another file).
            hit.sym = Sema_symbol(.generic_fn, base_core.arena.dup_str(full_m_name),
                generic_fn_node)
            hit.sym.vis = generic_fn_node.get_visibility()
            hit.sym.flags.is_method = true
            hit.sym.apply_attributes()
            return hit
    sym: = c.symtab.resolve(full_m_name).unwrap_or(null)
    if sym != null && sym.type_id != 0
        return Method_hit::{ .def = sym.node, .sym = sym, .type_id = sym.type_id }
    return hit

priv fn check_method_import(c: Sema_ctx$@, member_node: Ast_node$@, found_sym: Sema_symbol$@,
    recv_id: I32) //<
        //< Refuses an extension method whose defining file this file does not import
    member_name_raw: = member_node.text
    clean_struct: = c.env.get_str(recv_id)
    struct_sym: = c.symtab.resolve(clean_struct).unwrap_or(null)
    $struct_file: U8[] = ""
    if struct_sym != null
        struct_file = struct_sym.get_defined_in()
    else
        g_node: = c.generics.templates.get(clean_struct).unwrap_or(null)
        if g_node != null
            struct_file = g_node.loc.file()

    // **A type that no declaration names counts as `std/lang`'s** (a scalar, a slice, an array, a
    // `Result`), which every file imports. A method another file adds to it needs that file
    // imported, as for any type. See "An extension method requires the import" in
    // `../../../docs/SPEC-programming-language.md`.
    // Caution: **Do not accept it because "some file loaded it".** The call would rest on what else
    // the program imports, and [I0401] would call the import unused.
    if c.env.is_slice(recv_id) || (struct_file.len == 0 && !is_declared_type(c, recv_id))
        struct_file = base_locate.LANG_FILE_PATH
    // **Not inside an instantiation**: the receiver's type can come from the type argument. A
    // generic cannot import every file serving its bound. See "No diagnostic that depends on a
    // generic's type argument" in `ksplc/docs/DESIGN-diagnostics.md`.
    // Caution: **Still check whether it is imported**: that marks the import used. Otherwise
    // [I0401] would tell the reader to delete a template's unmarked import.
    method_file: = found_sym.get_defined_in()
    if struct_file.len == 0 || method_file.len == 0 || struct_file.equals(method_file) ||
        c.is_file_imported(method_file) || c.is_instantiating()
        return
    spec_item: = format_spec_item(member_name_raw)
    if spec_item.len > 0
        reject_unimported_spec(c, member_node, spec_item, member_name_raw, method_file)
        return
    c.clear_scratch()
        .s("cannot call extension method '\{member_name_raw\}' because this file does not \
            explicitly import its defining file '\{method_file\}'.\n  Note: add 'import \
            \"\{method_file\}\"' to this file")
    c.err(member_node, c.scratch.slice())

priv fn report_missing_member(c: Sema_ctx$@, member_node: Ast_node$@, recv_id: I32, target_id: I32,
    is_call: Bool) //<
        //< Explains why the receiver's type has no member of that name, the one reason that applies
        //< is_call says whether the access is a call's callee; only a call can reach an extension
        //< method another file declares. target_id is the type as the user wrote it.
    member_name_raw: = member_node.text
    // Caution: **Show the sugar**: the registered name of `T[]` is `Slice<|T|>`, which the user did
    // not write (`../type/display.kspl`). It is built here, on the error path alone: the found path
    // runs at every member access.
    base_type_str: = c.env.display(target_id)
    // A trait's methods are looked up only through symtab.resolve, which filters by visibility, so
    // a `priv` one ends up here. Report the access violation, as for an impl's priv method, not a
    // false "no such method".
    switch c.env.get_info(recv_id)
    case .trait_type(trait_def)
        for m_sym in trait_def.methods_list
            if m_sym.name.equals(member_name_raw)
                c.check_visibility_and_mark_used(m_sym, member_node)
                return
    default {}

    spec_item: = format_spec_item(member_name_raw)
    if spec_item.len > 0
        // Caution: **Check the import before checking the type.** A file that does not import the
        // methods may not have loaded them at all, and then no type seems to accept anything.
        spec_file: = base_core.FMT_METHOD_FILE
        if !c.is_file_imported(spec_file)
            reject_unimported_spec(c, member_node, spec_item, member_name_raw, spec_file)
            return
        c.clear_scratch()
            .s("format spec: type '\{base_type_str\}' does not take \{spec_item\}\n  Note: the \
                width, '0' and ',' items apply to integers and floating point. '.N' applies only to \
                floating point. 'x' / 'X' apply only to integers. 'c' applies only to 'U8'.")
        c.err(member_node, c.scratch.slice())
        return

    // A fixed-length array has no slice methods by design. The answer is the cast, not the import
    // note. Rust and C convert implicitly, so readers expect it to work.
    if c.env.is_array(recv_id)
        at: = base_type_str.rfind_char('[').unwrap_or(base_type_str.len)
        elem: = base_type_str.sub(0, at)
        c.clear_scratch()
            .s("type '\{base_type_str\}' has no field or method named '\{member_name_raw\}'\n  \
                Note: a fixed-length array is not a slice. Slice methods are not available on it. \
                View it as a slice with an explicit cast: \
                '(\{elem\}[]::x).\{member_name_raw\}(…)', where x is the array. Use parentheses \
                so that the cast covers only the array.")
        c.err(member_node, c.scratch.slice())
        return

    // An instance whose type arguments were refused has no methods, and that was the one mistake.
    // check_const_arg / check_type_constraint report it at the type's use.
    recv_name: = c.env.get_str(c.env.get_clean_real_type(c.env.strip_ptr(recv_id)))
    if c.has_failed_constraint(recv_name)
        return
    // Likewise an instance the method-table chain was cut short of (mono_queue.kspl).
    if c.mono.chain_cut &&
        c.env.instance_of(c.env.get_clean_real_type(c.env.strip_ptr(recv_id))).is_some()
        return

    // Caution: **Put the guidance in the error message itself.** A `hint` appears only under lint,
    // so a plain compilation would say only "absent". The same holds for an `impl` on a built-in
    // type in another file, such as the `fmt` that `\{x\}` calls.
    c.clear_scratch()
        .s("type '\{base_type_str\}' has no field or method named '\{member_name_raw\}'")
    // **Without a call, only a field can stand there**, and no other file can add one. Name the
    // field a typo most likely meant, never the import of an extension method.
    if !is_call
        near: = nearest_field(c, recv_id, member_name_raw)
        if near.len > 0
            c.scratch.s("\n  Note: the field with the nearest name is '\{near\}'.")
    else
        c.scratch
            .s("\n  Note: an extension method is visible only where its defining file is imported. \
                If '\{member_name_raw\}' comes from another file, import that file. Check that the \
                import is not cyclic.")
    c.err(member_node, c.scratch.slice())

priv const MAX_NEAR_NAME: Sz = 64 //< the longest name nearest_field compares, in bytes

priv fn nearest_field(c: Sema_ctx$@, recv_id: I32, name: U8[]): U8[] //<
    //< The receiver's field whose name is nearest to `name`, or empty where none is near enough
    //< **Near is at most one edit per three characters** (`edit_distance`), so a short name
    //< allows one: more would offer an unrelated field as the meaning. On a tie the field
    //< declared first wins.
    entry: = c.env.id_to_type.get(c.env.get_clean_real_type(c.env.strip_ptr(recv_id)))
    if entry == null
        return ""
    $best: U8[] = ""
    $best_cost: = math.max(name.len, 3) / 3 + 1
    switch entry.info
    case .struct_type(def)
        for field in def.fields_list
            cost: = edit_distance(name, field.name)
            if cost < best_cost
                best = field.name
                best_cost = cost
    default {}
    return best

priv fn edit_distance(a: U8[], b: U8[]): Sz //<
    //< How many single-byte edits turn `a` into `b`
    //< An edit is an insertion, a deletion, a substitution or a swap of two neighbours (`totla`
    //< for `total` is one). A name longer than max_near_name counts as far from everything.
    if a.len > MAX_NEAR_NAME || b.len > MAX_NEAR_NAME
        return MAX_NEAR_NAME
    $before: Sz[MAX_NEAR_NAME + 1] = ::{} // the row for a's byte before the last
    $last: Sz[MAX_NEAR_NAME + 1] = ::{}
    $row: Sz[MAX_NEAR_NAME + 1] = ::{}
    for j in Range.asc(b.len + 1)
        row[j] = j
    for i in Range.asc(a.len)
        before = last
        last = row
        row[0] = i + 1
        for j in Range.asc(b.len)
            $cost: = last[j] + (0 if a[i] == b[j] else 1)
            if last[j + 1] + 1 < cost
                cost = last[j + 1] + 1
            if row[j] + 1 < cost
                cost = row[j] + 1
            if i > 0 && j > 0 && a[i] == b[j - 1] && a[i - 1] == b[j] && before[j - 1] + 1 < cost
                cost = before[j - 1] + 1
            row[j + 1] = cost
    return row[b.len]

priv fn refuse_method_value_on_value(c: Sema_ctx$@, member_node: Ast_node$@, recv_id: I32) //<
    //< Refuses a method named through a value without being called (`p.m`)
    //< A function value is an address alone, with no room for the receiver, so `p.m` has nothing to
    //< stand for. Named through its type, the method is a function taking the receiver first. See
    //< "A method as a value is named through its type" in docs/DESIGN-programming-language.md.
    owner: = c.env.display(recv_id)
    m: = member_node.text
    // The hint names the type as a file inside its package writes it: no package path before it.
    shown: = owner
    head: = shown.sub(0, shown.find_str("<|").unwrap_or(shown.len))
    $own_name: = shown
    if last_dot: = head.rfind_char('.')
        own_name = shown.sub_from(last_dot + 1)
    c.clear_scratch()
        .s("method '\{m\}' cannot be used as a value through a value of type '\{shown\}'. A \
            function value holds no receiver\n  Hint: call the method with '.\{m\}(…)', or name \
            it through its type with '\{own_name\}.\{m\}'. When naming it through its type, pass \
            the receiver as its first argument")
    c.err(member_node, c.scratch.slice())

priv fn is_declared_type(c: Sema_ctx$@, type_id: I32): Bool //<
    //< Whether a declaration names the type (struct, enum or trait), aliases and marks stripped
    switch c.env.get_info(c.env.get_clean_real_type(type_id))
    case .struct_type
        return true
    case .enum_type
        return true
    case .trait_type
        return true
    default {}
    return false

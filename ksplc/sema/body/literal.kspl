//< A literal's type, and whether a numeric literal's value fits in it
//<
//< An unannotated integer literal takes the expected type where one is passed down. Its range is
//< checked only where its type is known, and not while a generic is being instantiated.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/core" as base_core // is_comparison_op
import "ksplc/base/literal" as base_literal
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/chars" // testing and slicing single characters
import "std/str" { Str_builder }
import "std/strnum" // reading a floating-point literal's value

fn infer_literal_expr(node: Ast_node$@, c: Sema_ctx$@, expected_id: I32): I32
    type_id: = literal_type_id(node, c, expected_id)
    if node.kind_id == .k_integer
        check_integer_literal_width(c, node)
        // **Only literals whose type is known get the range check.** An unknown one defaults to I32
        // but can sit in U32 arithmetic (`v * 0x85ebca6b`), so correct code would fail. The
        // right-hand side gets no expected type: see pass_right_id in infer_binary_expr in
        // `binary.kspl`.
        type_is_known: =
            !sema_type_env.is_unknown(sema_decl_eval.int_suffix_type_id(node.text)) ||
            (!sema_type_env.is_unknown(expected_id) && c.env.is_integer(expected_id))
        // **Not while a generic is being instantiated**: the fit changes with the type argument. As
        // an error, it would forbid a template merely because T=U8 exists. See "No diagnostic that
        // depends on a generic's type argument" in ksplc/docs/DESIGN-diagnostics.md.
        if type_is_known && !c.is_instantiating()
            check_literal_bounds(c, node, type_id, c.fn_ctx.literal_negated)
    else if node.kind_id == .k_float && !c.is_instantiating()
        check_float_literal_range(c, node, type_id)
    return type_id

priv fn check_float_literal_range(c: Sema_ctx$@, node: Ast_node$@, type_id: I32) //<
    //< Refuses a floating-point literal that its type holds only as infinity, or as zero
    //<
    //< **An error, as for an integer** (check_literal_bounds): the value would change silently, and
    //< C only warns, for a `double` alone. Rounding to a nearby value and a subnormal pass: every
    //< decimal fraction rounds (`0.1`), and a subnormal is still the number, with fewer digits.
    $clean: = Str_builder.new()
    _stop: = node.text.append_clean_number(clean@, "F")
    v: = clean.slice().to_f64() catch
        return
    held: = F64::(F32::v) if c.env.get_primitive_bit_size(type_id) == 32 else v
    $becomes: = ""
    if held - held != 0.0
        becomes = "infinity"
    else if held == 0.0 && has_nonzero_digit(clean.slice())
        becomes = "zero"
    else
        return
    type_name: = c.env.display(type_id)
    c.clear_scratch()
        .s("literal '\{node.text\}' becomes \{becomes\} in type '\{type_name\}'. Its value would \
            change silently. Write a value inside the type's range, or use a wider type")
    c.err(node, c.scratch.slice())

priv fn has_nonzero_digit(number: U8[]): Bool //< whether a decimal's significand is not zero
    for ch in number
        if ch == 'e' || ch == 'E'
            return false
        if ch >= '1' && ch <= '9'
            return true
    return false

fn is_untyped_int_literal(node: Ast_node$@): Bool //<
    //< Whether it is an integer literal with no type suffix
    //<
    //< **Such a literal takes the expected type when one is passed down.**
    //< Caution: Decide the suffix through int_suffix_type_id (sema/decl/eval.kspl) alone. A copied
    //< suffix table goes stale when an integer type is added.
    lit: = literal_under_minus(node)
    return lit.node != null &&
        sema_type_env.is_unknown(sema_decl_eval.int_suffix_type_id(lit.node.text))

fn is_untyped_numeric_expr(node: Ast_node$@): Bool //<
    //< Whether it is built from numeric literals with no type suffix alone
    //<
    //< A literal, a unary `-` / `~` on one, or an arithmetic, bitwise or shift operation between
    //< two (`4294967296 + 1`, `1 << 40`). **Only such an expression has no width of its own**, so
    //< only it takes the outer expected type (`infer_binary_expr` in `binary.kspl`).
    if node == null
        return false
    switch node.kind_id
    case .k_integer
        return is_untyped_int_literal(node)
    case .k_float
        return !node.text.ends_with("F32") && !node.text.ends_with("F64")
    case .k_expr_unary
        op: = node.get_unary_op().text
        return (op.equals("-") || op.equals("~")) &&
            is_untyped_numeric_expr(node.get_unary_target())
    case .k_expr
        op: = node.get_binary_op().text
        if op.is_comparison_op() || op.equals("&&") || op.equals("||")
            return false
        return is_untyped_numeric_expr(node.get_binary_left()) &&
            is_untyped_numeric_expr(node.get_binary_right())
    default
        return false

priv fn literal_type_id(node: Ast_node$@, c: Sema_ctx$@, expected_id: I32): I32
    if node.kind_id == .k_bool
        return I32::sema_type_env.Builtin_type_id.bool_type
    if node.kind_id == .k_null
        return c.env.resolve_null_type(expected_id)

    txt: = node.text
    suffix_id: = sema_decl_eval.int_suffix_type_id(txt)
    if !sema_type_env.is_unknown(suffix_id)
        return suffix_id
    if txt.ends_with("F32")
        return I32::sema_type_env.Builtin_type_id.f32_type
    if txt.ends_with("F64")
        return I32::sema_type_env.Builtin_type_id.f64_type

    // Caution: **A float literal takes only a float type.** Given an integer one, `x: I32 = 2.5`
    // and a `catch 2.5` for an `I32` passed silently, C keeping 2 and LLVM emitting `i32 2.5`.
    if node.kind_id == .k_float
        if !sema_type_env.is_unknown(expected_id) && c.env.is_float(expected_id)
            return expected_id
        return I32::sema_type_env.Builtin_type_id.f64_type
    // Caution: **Nor does an integer literal take a float type**, the other half of "between
    // integers and reals it is forbidden both ways". Given one, LLVM emitted `store double 2`,
    // which does not build. `2.0` is the one spelling of that value.
    if !sema_type_env.is_unknown(expected_id) && c.env.is_numeric(expected_id) &&
        !c.env.is_float(expected_id)
        return expected_id
    return I32::sema_type_env.Builtin_type_id.i32_type

priv fn check_integer_literal_width(c: Sema_ctx$@, node: Ast_node$@) //<
    //< Reports an integer literal too long to fit any integer type
    //<
    //< **This is an error, not a lint.** The text goes to C / LLVM IR as written, and the C
    //< compiler's `integer literal is too large` is far from the KSPL source. See "Failing fast
    //< through an exception or an ICE" in ksplc/docs/DESIGN-compiler.md. It does not depend on the
    //< type, so it applies even while a generic is instantiated.
    if !node.text.parse_int_literal_u64().overflow
        return
    c.clear_scratch()
        .s("integer literal '\{node.text\}' is too large for any integer type. The widest integer \
            type is 64 bits")
    c.err(node, c.scratch.slice())

fn check_operand_literal_bounds(c: Sema_ctx$@, node: Ast_node$@, other_id: I32) //<
    //< Checks the range of an untyped integer literal on one side against the other side's type
    //<
    //< It applies to a binary operation.
    //< A suffixed literal is left to the ordinary type check (report_type_mismatch).
    lit: = literal_under_minus(node)
    if lit.node == null ||
        !sema_type_env.is_unknown(sema_decl_eval.int_suffix_type_id(lit.node.text))
        return
    check_literal_bounds(c, lit.node, other_id, lit.is_neg)

fn settle_untyped_literal(c: Sema_ctx$@, node: Ast_node$@, operand_id: I32): Bool //<
    //< Gives an untyped integer literal in a binary operation the type after promotion
    //<
    //< Caution: **Do not leave it at I32 under a cast.** `x + 4294967295` on a `U64` would then be
    //< a widening of an I32 whose bits read -1. A backend that extends the constant by its type
    //< then gets -1. Its range against that type is check_operand_literal_bounds's.
    if node == null || node.kind_id != .k_integer || !c.env.is_integer(operand_id) ||
        !sema_type_env.is_unknown(sema_decl_eval.int_suffix_type_id(node.text))
        return false
    node.type_id = operand_id
    return true

fn settle_negated_literal(c: Sema_ctx$@, node: Ast_node$@, operand_id: I32): Bool //<
    //< Gives a negated, untyped literal in a binary operation the type after promotion
    //<
    //< The literal is directly under a unary minus, on one side of the operation.
    //< Caution: **The width to negate at must be the promoted type.** Sometimes no expected type is
    //< passed down: both sides of a comparison, or arithmetic whose outer expected type differs
    //< from the left-hand side. There the literal is inferred at the default I32. But the generated
    //< code computes the unary minus at that node's type (emit_unary_expr in gen/c/expr.kspl).
    lit: = literal_under_minus(node)
    if lit.node == null || !lit.is_neg || !c.env.is_integer(operand_id) ||
        !sema_type_env.is_unknown(sema_decl_eval.int_suffix_type_id(lit.node.text))
        return false
    lit.node.type_id = operand_id
    node.type_id = operand_id
    return true

priv struct Signed_literal //<
    //< An integer literal, or an integer literal directly under a unary minus
    //<
    //< node is null where it is neither.
    node: Ast_node$@
    is_neg: Bool

priv fn literal_under_minus(node: Ast_node$@): Signed_literal
    $lit: = node
    $is_neg: = false
    if lit != null && lit.kind_id == .k_expr_unary && lit.get_unary_op().text.equals("-")
        is_neg = true
        lit = lit.get_unary_target()
    if lit == null || lit.kind_id != .k_integer
        return Signed_literal::{ .node = null, .is_neg = false }
    return Signed_literal::{ .node = lit, .is_neg = is_neg }

fn check_inferred_decl_literal(c: Sema_ctx$@, expr_node: Ast_node$@, final_id: I32) //<
    //< Checks the range of an integer literal initializing an unannotated declaration
    //<
    //< For example `x: = 2147483648;`. The range is checked against the final type.
    //< **Not at the literal itself**, where the default I32 might still widen (type_is_known in
    //< infer_literal_expr). An expression initializer (`x: = 2147483648 + 1;`) is not checked.
    if expr_node == null || c.is_instantiating()
        return
    lit: = literal_under_minus(expr_node)
    if lit.node == null
        return
    check_literal_bounds(c, lit.node, final_id, lit.is_neg)

priv fn check_literal_bounds(c: Sema_ctx$@, node: Ast_node$@, type_id: I32, is_neg: Bool) //<
    //< Checks that the literal fits the range of that type
    //<
    //< **This is an error, not a lint.** An out-of-range literal's value changes silently (`I32 =
    //< 2147483648` becomes -2147483648).
    //< Caution: **Take bit width and sign from Env's single source (get_primitive_bit_size /
    //< is_unsigned).** A per-type table here would let a forgotten width go unnoticed.
    if !c.env.is_integer(type_id)
        return
    lit: = node.text.parse_int_literal_u64()
    if lit.overflow
        return // a literal too long for any type is already an error (check_integer_literal_width)
    // The bits for the absolute value (a signed type spends one on the sign).
    value_bits: =
        c.env.get_portable_bit_size(type_id) - (0 if c.env.is_unsigned(type_id) else 1)
    $out_of_range: = false
    if is_neg
        // No negative fits an unsigned type; a signed one goes down to -(2^value_bits).
        out_of_range =
            c.env.is_unsigned(type_id) || lit.value > (U64::1 << U64::value_bits)
    else if value_bits < 64
        out_of_range = lit.value > ((U64::1 << U64::value_bits) - U64::1)
    if out_of_range
        sign: = "-" if is_neg else ""
        type_name: = c.env.display(type_id)
        c.clear_scratch()
            .s("literal '\{sign\}\{node.text\}' is out of range for type '\{type_name\}'. Its value \
                would change silently. Use a wider type, or cast explicitly \
                ('\{type_name\}::\{sign\}\{node.text\}') if the truncation is intended")
        c.err(node, c.scratch.slice())

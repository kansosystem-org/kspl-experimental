//< Infers a postfix expression: `.`, a call `(…)`, an index `[…]`, a cast `::`, `@`, `$` and `!`
//< It types the receiver, then hands `.` to `dot.kspl` and a call to `call.kspl`, and keeps the
//< index, the casts and the address and dereference operators here. **`[]` takes only what
//< carries its own length** (a slice, an array, an `Index` type); a raw pointer cannot be
//< bounds-checked.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell" as _base_ast_spell // `get_full_path_str_to`
import "ksplc/base/core" as base_core
import "ksplc/sema/body/call" as sema_body_call
import "ksplc/sema/body/dot" as sema_body_dot
import "ksplc/sema/body/expr" as sema_body_expr
import "ksplc/sema/body/type_call" as sema_body_type_call
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/decl/fold_float" as sema_decl_fold_float
import "ksplc/sema/decl/layout" as sema_decl_layout
import "ksplc/sema/decl/name" as _sema_decl_name
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/decl/trait_check" as sema_decl_trait_check
import "ksplc/sema/decl/type_check" as sema_decl_type_check
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error }
import "ksplc/sema/session/import_table" as sema_session_import_table
import "ksplc/sema/session/pointer" as sema_session_pointer
import "ksplc/sema/type/def" { Enum_def, Fn_sig }
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/str" { Str_builder }

priv fn lint_receiver_parens(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@) //<
    //< [H0301] Parentheses around a receiver that need none
    if base_core.config.run_lint_checks &&
        ((left.was_parenthesized() && left.is_postfix_safe_kind() &&
        !left.is_prefix_cast_result()) || left.has_redundant_extra_parens())
        c.hint(node, "[H0301] Unnecessary parentheses around receiver expression.")

fn infer_subscript_of(node: Ast_node$@, c: Sema_ctx$@, target_id: I32): I32!Sema_error //<
    //< Infers a subscript `a[i]` whose receiver `a` is inferred already, as `target_id`
    //< An assignment infers the receiver first to choose the route (`infer_index_write` in
    //< `stmt.kspl`). Caution: **Do not infer the receiver again.** A method call is rewritten by
    //< its first inference, so a second one reads 'Unknown'.
    lint_receiver_parens(c, node, node.get_postfix_receiver())
    unknown: = I32::sema_type_env.Builtin_type_id.unknown
    type_id: =
        infer_postfix_array(c, node, target_id, c.env.receiver_base_id(target_id), unknown)!
    return node.settle_expected(c, type_id, unknown)!

fn infer(node: Ast_node$@, c: Sema_ctx$@, expected_id: I32): I32!Sema_error
    node.ice_assert(node.children.len >= 2, "expr_postfix must have at least 2 children (expr, op)")
    left: = node.get_postfix_receiver()
    lint_receiver_parens(c, node, left)
    $op: = node.postfix_op_text()
    if op.equals("method_access") || op.equals("generic_method")
        op = "."
    else if op.equals("enum_init_call") || op.equals("enum_init")
        op = "("

    if base_core.config.run_lint_checks && op.equals(".") && left.kind_id == .k_expr_postfix &&
        left.get_postfix_op().is_literal("$")
        c.information(left,
            "[I0309] Unnecessary explicit '$' dereference; '.' already auto-dereferences pointers.")

    $as_target_id: = I32::sema_type_env.Builtin_type_id.unknown
    if op.equals("::") && node.children.len >= 3
        as_type_node: = node.get_postfix_member()
        // Caution: Check this before resolving the type. Resolving `io` as a type reports it
        // undefined.
        if read_as_path(c, node, left, as_type_node, node.get_postfix_op())
            return infer(node, c, expected_id)!
        as_target_id = as_type_node.resolve_type(c)!
        as_type_node.type_id = as_target_id

    // Try it **before** `left.infer_expr`, or `.fmt`'s resolution fails first with "no such
    // method".
    if op.equals("(") && sema_body_dot.try_rewrite_enum_fmt(node, left, c)!
        return infer(node, c, expected_id)!

    if op.equals("(")
        if constructor: = sema_body_type_call.self_callee(c, left)
            node.children.set(0, constructor)
            result: = infer(node, c, expected_id)!
            sema_body_type_call.check_receiver(c, constructor)
            return result

    // **A primitive type before a `.` is a namespace, not a value** (`Sz.width()`); asking for its
    // value is what `infer_primitive_type` rejects.
    $target_id: = I32::sema_type_env.Builtin_type_id.unknown
    if op.equals(".") && left.kind_id == .k_primitive_type
        target_id = c.env.get_or_add(left.text)
        left.type_id = target_id
    else
        outer_callee: = c.fn_ctx.callee
        c.fn_ctx.callee = left if op.equals("(") else null
        defer c.fn_ctx.callee = outer_callee
        // **A receiver's type is inferred without the enclosing expected type.** Passing it through
        // `x@` would turn `ro[0]`'s `U8 immut` into `U8` by value-copy conversion (coerce.kspl). It
        // would then make a mutable pointer, and a write to ROM would pass on both backends.
        target_id = left.infer_expr(c, I32::sema_type_env.Builtin_type_id.unknown)!
    if op.equals(".")
        return infer_dot_postfix(c, node, left, target_id, expected_id)
    if op.equals("(")
        // **A primitive type has no function to call.** Inferring it as a value already refused it
        // (`I32(3)`); a call lookup would report an empty name as a second error.
        if left.kind_id == .k_primitive_type
            return I32::sema_type_env.Builtin_type_id.unknown
        if constructor: = sema_body_type_call.callee(c, left)
            node.children.set(0, constructor)
            result: = infer(node, c, expected_id)!
            sema_body_type_call.check_receiver(c, constructor)
            return result
        result: = sema_body_call.infer(c, node, left, target_id, expected_id)!
        sema_body_type_call.refuse_written_new(c, left)
        return result
    if op.equals("[")
        recv_id: = c.env.receiver_base_id(target_id)
        return infer_postfix_array(c, node, target_id, recv_id, expected_id)!
    if op.equals("::")
        return infer_cast_postfix(c, node, target_id, as_target_id)
    if op.equals("@")
        return infer_address_postfix(c, node, left, target_id)!
    if op.equals("$")
        return infer_deref_postfix(c, node, target_id)
    if op.equals("!")
        return infer_propagate_postfix(c, node, target_id)
    if !sema_type_env.is_unknown(expected_id)
        return expected_id
    return I32::sema_type_env.Builtin_type_id.unknown

priv struct Dot_receiver //< what stands before a `.`: a namespace (a type, an enum…) or a value
    is_namespace: Bool
    is_enum: Bool
    is_function: Bool //< a function's name: a value with no members
    sym: Sema_symbol$@ //< the symbol it names, or null

priv fn read_dot_receiver(c: Sema_ctx$@, left: Ast_node$@): Dot_receiver //<
    //< Whether `left.` names a namespace or a value, and the symbol it names
    $out: = Dot_receiver::{ .is_namespace = false, .is_enum = false, .is_function = false,
        .sym = null }
    if left.kind_id == .k_primitive_type
        out.is_namespace = true
        return out
    is_path_kind: =
        left.kind_id == .k_expr_path || left.kind_id == .k_type_path ||
        left.kind_id == .k_generic_path
    if left.kind_id != .k_identifier && !is_path_kind
        return out
    // What left names, read as any value's name is (read_written_name in sema/decl/name.kspl). It
    // is read as a local first, then an import alias, then a declaration.
    named: = c.read_written_name(left)
    if named.sym != null && !named.sym.flags.is_global
        out.sym = named.sym
    else if named.parts.owner == null &&
        c.get_file_alias(c.file_name, named.parts.name.text)
        out.is_namespace = true
        return out
    if left.def_node != null && left.def_node.sym_ptr != null
        out.sym = Sema_symbol$@::left.def_node.sym_ptr
    else
        out.sym = named.sym
    if out.sym == null
        out.is_namespace = true
        return out
    out.sym.flags.is_used = true
    // **A function's name before a `.` is a value**, a function value with no members. Read as a
    // namespace, `P.make.qq(3)` would drop `.qq` and call `P.make`.
    out.is_function = out.sym.kind.names_function()
    out.is_namespace = !out.sym.kind.is_var_or_const() && !out.is_function
    out.is_enum = out.is_namespace && out.sym.kind.is_enum()
    return out

priv fn infer_dot_postfix(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, target_id: I32,
    expected_id: I32): I32!Sema_error //<
        //< `left.name`: a member of a namespace, or a field or method of a value
    recv: = read_dot_receiver(c, left)
    if recv.is_function
        member: = node.get_postfix_member()
        c.clear_scratch().s("'")
        left.get_full_path_str_to(c.scratch)
        c.scratch
            .s("' is a function, which has no member '\{member.text\}'. Call the function first to \
                reach a member of its result: '")
        left.get_full_path_str_to(c.scratch)
        c.scratch.s("(...).\{member.text\}'")
        c.err(member, c.scratch.slice())
        // Called, the name would be reported a second time as undefined.
        if c.fn_ctx.callee == node
            throw .analysis_failed
        return I32::sema_type_env.Builtin_type_id.unknown
    if recv.is_namespace
        return sema_body_dot.infer_namespace_access(c, node, left, recv.sym, recv.is_enum,
            expected_id)
    // The pointer is stripped only here, and only recv_id is passed on to `.` / `[]`. The
    // convention is at receiver_base_id in sema/type/env.kspl.
    recv_id: = c.env.receiver_base_id(target_id)
    return sema_body_dot.infer_dot_access(c, node, left, target_id, recv_id, expected_id)

priv fn infer_cast_postfix(c: Sema_ctx$@, node: Ast_node$@, target_id: I32, as_target_id: I32): I32 //<
    //< `T::value`: the cast, checked against what may be cast to what
    if c.env.is_result(target_id)
        c.err(node, "cannot directly cast a Result type. Unwrap it using '!' or 'catch' first.")
    if node.children.len < 3
        return I32::sema_type_env.Builtin_type_id.unknown
    // A source whose type is unknown was reported where it failed. Judged here, a slice target
    // reads as a struct, and the cast earns a second error that is not the writer's.
    // **A cast to the value's own type is a copy, nothing to check**, the value's immutability
    // aside. An immutable array's element (`P::ps[1]`) is as much a `P` as a variable's value.
    if c.env.get_clean_real_type(as_target_id) != c.env.get_clean_real_type(target_id) &&
        !sema_type_env.is_unknown(target_id)
        refuse_aggregate_cast(c, node, as_target_id, target_id)
        refuse_fn_type_cast(c, node, as_target_id, target_id)
        check_slice_cast_source(c, node, as_target_id, target_id)
        check_scalar_cast_source(c, node, as_target_id, target_id)
        check_enum_cast(c, node, as_target_id, target_id)
        check_float_cast(c, node, as_target_id)
    return as_target_id

priv fn check_float_cast(c: Sema_ctx$@, node: Ast_node$@, as_target_id: I32) //<
    //< Refuses a constant cast to an integer type that does not hold the value's whole part
    //< A value known only at run time saturates instead (NaN gives 0). A constant is checked now,
    //< as an integer constant's overflow is, at the width every target holds.
    switch node.float_cast_to(c, as_target_id, true)
    case .out_of_range(f)
        shown: = c.env.display(as_target_id)
        is_sz: =
            c.env.get_clean_real_type(as_target_id) == (I32::sema_type_env.Builtin_type_id.size_type)
        w: = c.clear_scratch().s("cannot cast \{f\} to '").s(shown).s("': ")
        if f != f
            w.s("NaN has no integer value")
        else
            w.s("'").s(shown).s("' does not hold its whole part")
                .s(" at 32 bits, the width every target gives it" if is_sz else "")
        w
            .s(". A constant that does not fit is refused, where a value known only at run time \
                would saturate")
        c.err(node, c.scratch.slice())
    default {}

priv fn tag_checked_enum(c: Sema_ctx$@, dst_id: I32, src_id: I32): Enum_def$@? //<
    //< The scalar enum a cast makes out of an integer or another enum, whose tag must be checked
    //< **An enum value is one of its tags**: an exhaustive `switch` takes no other, and nothing but
    //< this cast makes one from a number. None for any other cast, the same enum's included.
    dst: = c.env.get_clean_real_type(dst_id)
    src: = c.env.get_clean_real_type(src_id)
    if dst == src || sema_type_env.is_unknown(src)
        return .none
    switch c.env.get_info(dst)
    case .enum_type(def)
        if def.is_scalar() && (c.env.is_integer(src) || c.env.is_scalar_enum(src))
            return .some(def)
    default {}
    return .none

priv fn check_enum_cast(c: Sema_ctx$@, node: Ast_node$@, as_target_id: I32, src_id: I32) //<
    //< Refuses a cast that would make an enum value none of its variants
    //< Only an integer or another scalar enum casts to a scalar enum. A constant that is none of
    //< the tags is refused now, as a constant divisor of 0 is. A value known only at run time is
    //< checked there (`enum_cast_needs_check`).
    dst: = c.env.get_clean_real_type(as_target_id)
    src: = c.env.get_clean_real_type(src_id)
    if dst == src || sema_type_env.is_unknown(src)
        return
    // An enum whose variants carry data is an aggregate: refuse_aggregate_cast refuses it.
    $what: = ""
    switch c.env.get_info(dst)
    case .enum_type(def)
        if !def.is_scalar()
            return
        if !c.env.is_integer(src) && !c.env.is_scalar_enum(src)
            what = "only an integer or another enum converts to an enum"
    default
        return
    shown: = c.env.display(as_target_id)
    if what.len > 0
        c.clear_scratch().s("cannot cast '").s(c.env.display(src_id)).s("' to '").s(shown).s("': ")
            .s(what)
        c.err(node, c.scratch.slice())
        return
    def: = tag_checked_enum(c, as_target_id, src_id).unwrap_or(null)
    if def == null
        return
    if v: = c.try_eval_constexpr_wide(node.get_postfix_receiver())
        if def.has_tag(v)
            return
        c.clear_scratch().s("cannot cast \{v\} to '").s(shown).s("': no variant of '").s(shown)
            .s("' has that tag, and an enum holds only the values it lists")
        c.err(node, c.scratch.slice())

fn enum_cast_needs_check(c: Sema_ctx$@, node: Ast_node$@): Enum_def$@? //<
    //< The enum whose tag a cast must check at run time; none where the cast needs no check
    //< **Only when this says none can a backend omit the check.** An operand folding to one of the
    //< tags needs none, and then a backend must not insert one. A top-level initializer must stay a
    //< C constant expression.
    if node == null || node.kind_id != .k_expr_postfix || node.children.len < 3 ||
        !node.postfix_op_text().equals("::")
        return .none
    recv: = node.get_postfix_receiver()
    def: = tag_checked_enum(c, node.type_id, recv.type_id).unwrap_or(null)
    if def == null
        return .none
    if v: = c.try_eval_constexpr_wide(recv)
        if def.has_tag(v)
            return .none
    return .some(def)

priv fn refuse_aggregate_cast(c: Sema_ctx$@, node: Ast_node$@, as_target_id: I32, target_id: I32) //<
    //< Reports a cast to an aggregate type that no implementation of `std/lang`'s `Cast` provides
    //< A struct, a tagged union (`T?` too), a fixed-length array, a Result and a trait value are
    //< aggregates in C, where a cast `(T)value` is invalid. The cast is allowed only where the
    //< value already has that type (a no-op), and rejected here otherwise.
    //< gen/c/expr_postfix.kspl's emit_as_cast trusts this check and emits the cast as is.
    as_real_id: = c.env.get_real_type(as_target_id)
    src_real_id: = c.env.get_real_type(target_id)
    as_clean_id: = c.env.get_clean_real_type(as_target_id)
    // Caution: **Do not reject `Slice<|T|>` here.** `U8$[]::buf` is the legitimate "build a
    // descriptor" cast (check_slice_cast_source checks its shape and element size).
    if !is_aggregate_value(c, as_clean_id) ||
        (c.env.is_slice(as_real_id) &&
        (c.env.is_slice(target_id) || c.env.is_array(target_id)))
        return
    if c.env.has_implemented_operator_trait(src_real_id, "Cast")
        c.clear_scratch().s(c.env.base_type_name(src_real_id)).s(".cast")
        if method_sym: = c.resolve_type_method_fqn(c.scratch.slice())
            if c.env.get_real_type(method_sym.type_id) == as_real_id
                node.def_node = method_sym.node
                return
    // Caution: Show the name as written (`List<|I32|>`), not the instance's registered name
    // (`std_ds_List_I32`), which the writer never wrote.
    shown: = c.env.display(as_target_id)
    c.clear_scratch().s("cannot cast to ")
    switch c.env.get_info(as_clean_id)
    case .enum_type
        if c.env.instance_base(as_clean_id).equals(base_core.OPTION_FQN)
            c.scratch
                .s("optional type '\{shown\}'; an optional is built from its variant: '.some(v)' or \
                    '.none' where '\{shown\}' is expected")
        else if c.env.instance_base(as_clean_id).equals(base_core.RESULT_FQN)
            c.scratch
                .s("Result type '\{shown\}'; a Result is built from its variant ('.ok(v)' or \
                    '.err(e)'), by returning the value or by throwing the error")
        else
            c.scratch
                .s("enum type '\{shown\}' with payloads; such a value is built from one of its \
                    variants, not converted")
    case .array
        c.scratch
            .s("array type '\{shown\}'. An array is not converted as a whole. Convert it element by \
                element")
    case .trait_type
        c.scratch
            .s("trait type '\{shown\}'. A value becomes a trait value with no '::', where the trait \
                is the expected type (a declaration's, a parameter's, a field's)")
    default
        c.scratch
            .s("struct type '\{shown\}'. A value becomes a struct through '::' only where its type \
                implements 'Cast<|\{shown\}|>' (std/lang's trait: 'impl \
                \{c.env.display(target_id)\}: Cast<|\{shown\}|>'). Otherwise build the struct with \
                a literal ('\{shown\}::{ … }') or a constructor")
    c.err(node, c.scratch.slice())

fn infer_address_postfix(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, target_id: I32):
    I32!Sema_error //<
        //< `place@`: a pointer to the place, immutable where the place must not be written
    // `Index`'s `get` returns a **copy**, so `l[0]@` is a temporary's address, and a write through
    // it silently misses the container.
    if left.is_trait_index_access() && !c.env.is_place_index_node(left)
        c.err(node,
            "cannot take the address of an element accessed through the 'Index' interface; 'get' \
                returns a copy, so '@' would yield the address of a temporary")
        throw .analysis_failed
    // The general form: `@` on a non-place (a return value, a literal, a computed result) becomes
    // `&temporary` in C. The user then gets a **raw C compiler error** instead of KSPL's.
    if c.env.is_unaddressable_value(left)
        c.err(node,
            "cannot take the address of a call result, literal, or computed value; '@' would yield \
                the address of a temporary. Bind it first (`x: = ...;`) and take the address of \
                that.")
        throw .analysis_failed
    if c.refuse_packed_address(left, "'@'")
        throw .analysis_failed
    $pointee_id: = target_id
    if c.env.is_array(target_id)
        pointee_id = c.env.strip_array(target_id)
    // The pointer is immutable where the place must not be written: `hp.buf[0]@` on an `hp:
    // Holder@`, `b.imm[0].v@` past immutable elements, `cs.buf[0]@` on a `const CS: Holder` (ROM),
    // and `n@` on `n: Sz = 0;`, which an output argument would otherwise rewrite.
    if c.address_is_readonly(left)
        pointee_id = c.env.make_const(pointee_id)
    return c.env.make_ptr(pointee_id)

priv fn infer_deref_postfix(c: Sema_ctx$@, node: Ast_node$@, target_id: I32): I32 //<
    //< `pointer$`: what the pointer points at
    if !sema_type_env.is_unknown(target_id) && !c.env.is_pointer(target_id)
        c.clear_scratch().s("cannot dereference non-pointer type '\{c.env.display(target_id)\}'")
        c.err(node, c.scratch.slice())
    return c.env.strip_ptr(target_id)

priv fn infer_propagate_postfix(c: Sema_ctx$@, node: Ast_node$@, target_id: I32): I32 //<
    //< `result!`: the success value, the failure passed on to the caller
    if c.fn_ctx.in_defer
        c.err(node, "cannot use '!' operator (which may throw) inside a defer block")
    ret_id: = c.fn_ctx.ret_id
    if !sema_body_expr.require_result_operand(c, node, target_id, "!")
        return c.env.strip_result(target_id)
    if !sema_type_env.is_unknown(ret_id) && !c.env.is_result(ret_id)
        c.err(node, "cannot use '!' operator in a function that does not return a Result type")
    else if !sema_type_env.is_unknown(target_id) && !sema_type_env.is_unknown(ret_id)
        target_err_id: = c.env.get_real_type(c.env.get_result_err_id(target_id))
        ret_err_id: = c.env.get_real_type(c.env.get_result_err_id(ret_id))
        if target_err_id != ret_err_id && !sema_type_env.is_unknown(target_err_id) &&
            !sema_type_env.is_unknown(ret_err_id)
            t_err_str: = c.env.display(target_err_id)
            r_err_str: = c.env.display(ret_err_id)
            c.clear_scratch()
                .s("cannot propagate error of type '\{t_err_str\}' using '!' operator. The \
                    enclosing function expects error type '\{r_err_str\}'.")
            c.err(node, c.scratch.slice())
    return c.env.strip_result(target_id)

priv fn read_as_path(c: Sema_ctx$@, node: Ast_node$@, operand: Ast_node$@, type_node: Ast_node$@,
    op_node: Ast_node$@): Bool //<
        //< Reads `T::name…` as the path `T.name…` its writer meant, and reports the `::`
        //< **A writer from Rust or C++ uses `::` as a path separator** (`Arena::new(1024)`), but in
        //< KSPL it is the cast. Read as a cast, three errors follow and none names the fix. Read as
        //< the member, it gives one error, and the rest is checked as intended.
        //< Caution: **Not while errors are suppressed.** A trial pass would discard the report but
        //< keep the rewritten tree, which compiles.
    if c.suppress_errors || op_node == null
        return false
    owner: = type_node.bare_type_path().unwrap_or(null)
    if owner == null || owner.get_child(0).kind_id != .k_identifier
        return false
    is_module: =
        owner.children.len == 1 && c.names_module_only(owner.get_child(0).text)
    $parent: Ast_node$@ = null
    $head: = operand
    for head.kind_id == .k_expr_postfix && !head.get_postfix_op().is_literal("::")
        parent = head
        head = head.get_postfix_receiver()
    $name: = head
    if head.kind_id == .k_expr_path && head.children.len == 1
        name = head.get_child(0)
    if !path_meant(c, owner, is_module, operand, head, name)
        // `validate_all_type_exprs` in `../decl/type_check.kspl` leaves a cast on a module to be
        // reported here.
        if is_module
            sema_decl_type_check.report_type_existence_error(c, .not_found,
                owner.get_child(0).text, type_node)
        return false

    // **A call of a type's `new` is written as the type call** (`Arena(1024)`), so the advice
    // names that form, and the call goes on as one: `Arena.new(…)` would be refused too.
    is_type_call: =
        !is_module && parent != null && parent.get_postfix_op().is_literal("(") &&
        name.kind_id == .k_identifier && name.text.equals("new")
    c.clear_scratch().s("'::' is not a path separator in KSPL; write '\{owner.text\}")
    if is_type_call
        name.mark_implicit_name()
        c.scratch.s("(…)'")
    else
        c.scratch.s(".\{name.text\}'")
    c.scratch
        .s("\n  Note: a member of a type or a module is reached with '.'; '::' is the cast \
            ('I32::x') and the typed literal ('Point::{ .x = 1 }')")
    c.err(op_node, c.scratch.slice())
    dot: = Ast_node(.k_expr_postfix, "postfix", owner.loc).add_child(owner)
        .add_child(Ast_node(.k_literal, ".", op_node.loc)).add_child(name)
    if parent == null
        node.morph(dot.kind_id, dot.text)
        node.children = dot.children
    else
        parent.set_child(0, dot)
        node.morph(operand.kind_id, operand.text)
        node.children = operand.children
    node.type_id = 0
    return true

priv fn path_meant(c: Sema_ctx$@, owner: Ast_node$@, is_module: Bool, operand: Ast_node$@,
    head: Ast_node$@, name: Ast_node$@): Bool //<
        //< Whether `owner::name…` can only have meant the member `name` of `owner`
        //< A parenthesized operand is a value written on purpose (`io::(x)`). A local with the
        //< owner's name is what `owner.name` would read. A module is never a cast target. A type is
        //< read as a path only where it has `name` and `name` means nothing in scope, so
        //< `I32::count` stays a cast.
    if operand.was_parenthesized() || head.was_parenthesized() || name.kind_id != .k_identifier
        return false
    if local: = c.symtab.peek(owner.get_child(0).text)
        if !local.flags.is_global
            return false
    if is_module
        return true
    if _sym: = c.symtab.peek(name.text)
        return false
    switch sema_session_pointer.read_in_scope(c, c.file_name, name.text)
    case .not_a_pointer {}
    default
        return false
    defer $dotted: = Str_builder()
    for part in owner.children
        if part.kind_id == .k_identifier
            dotted.s(part.text).c('.')
    dotted.s(name.text)
    switch sema_session_pointer.read_in_scope(c, c.file_name, dotted.slice())
    case .found
        return true
    default
        return false

priv fn check_scalar_cast_source(c: Sema_ctx$@, node: Ast_node$@, as_target_id: I32, src_id: I32) //<
    //< Refuses a cast to `Bool` from anything else, and a cast to a number from an aggregate
    //< **There is no cast to `Bool`**: `x != 0` says it, and the backends would read `Bool::2`
    //< differently (C's `_Bool` makes it true, LLVM's truncation false). A struct, a slice or an
    //< array is no number, and C refuses the cast far from the KSPL source.
    if sema_type_env.is_unknown(src_id) || sema_type_env.is_unknown(as_target_id)
        return
    dst: = c.env.scalar_repr_id(as_target_id)
    src: = c.env.get_clean_real_type(src_id)
    $what: = ""
    if c.env.is_bool(dst) && !c.env.is_bool(src)
        what = "a cast to 'Bool' is not carried; compare instead ('x != 0', 'p != null')"
    else if c.env.is_numeric(dst) && is_aggregate_value(c, src)
        what =
            "only a number, a Bool, a scalar enum or a pointer converts to a number. Read the field \
                that holds the value"
    if what.len == 0
        return
    src_shown: = c.env.display(src_id)
    dst_shown: = c.env.display(as_target_id)
    c.clear_scratch().s("cannot cast '").s(src_shown).s("' to '").s(dst_shown).s("': ").s(what)
    c.err(node, c.scratch.slice())

priv fn refuse_fn_type_cast(c: Sema_ctx$@, node: Ast_node$@, as_target_id: I32, src_id: I32) //<
    //< Refuses a cast between function types whose signatures differ
    //< A call through the result hands the function its arguments, and takes its result, in the
    //< other signature's shape. That is undefined, and C compiles the cast without a word. An
    //< address that arrives as `Void@` (from C) still becomes a function type by a cast.
    switch c.env.fn_sig_of(as_target_id)
    case .some(dst)
        switch c.env.fn_sig_of(src_id)
        case .some(src)
            if same_signature(c, dst, src)
                return
            c.clear_scratch()
                .s("cannot cast '\{c.env.display(src_id)\}' to '\{c.env.display(as_target_id)\}': a \
                    function called through another signature receives its arguments and gives its \
                    result in the wrong shape\n  Hint: write a function of that signature which \
                    calls this one")
            c.err(node, c.scratch.slice())
        case .none {}
    case .none {}

priv fn same_signature(c: Sema_ctx$@, a: Fn_sig$@, b: Fn_sig$@): Bool //<
    //< Whether two function types take and give the same types
    //< The parameters' names, an alias and a value's own immutability do not count.
    if a.params.len != b.params.len ||
        c.env.get_clean_real_type(a.ret_id) != c.env.get_clean_real_type(b.ret_id)
        return false
    for i in Range.asc(a.params.len)
        if c.env.get_clean_real_type(a.params.get(i)) != c.env
            .get_clean_real_type(b.params.get(i))
            return false
    return true

priv fn is_aggregate_value(c: Sema_ctx$@, id: I32): Bool //<
    //< Whether a value of the type is an aggregate (a struct or slice, an array, a Result...)
    //< A tagged union and a trait value count; a scalar enum does not.
    switch c.env.get_info(id)
    case .struct_type
        return true
    case .trait_type
        return true
    case .array
        return true
    case .enum_type(def)
        return !def.is_scalar()
    default
        return false

priv fn check_slice_cast_source(c: Sema_ctx$@, node: Ast_node$@, as_target_id: I32, src_id: I32) //<
    //< Checks whether the **source** of a prefix cast to a slice (a view) has a descriptor
    //< Only a source with a descriptor is legitimate. That is slice to slice (making it immutable,
    //< `U8[]::s`), and a fixed-length array turned into a descriptor (`U8$[]::buf`).
    //< Caution: **Reject a cast from a scalar or a pointer here.** genc's emit_as_cast trusts this,
    //< so C like `(kspl_U8_Slice)4` gives a **raw C compiler error**. See "Failing fast through an
    //< exception or an ICE" in ksplc/docs/DESIGN-compiler.md.
    if !c.env.is_slice(as_target_id)
        return
    // An unresolved type is already reported.
    if src_id == 0 || sema_type_env.is_unknown(src_id) ||
        sema_type_env.is_unknown(as_target_id)
        return
    if c.env.is_slice(src_id) || c.env.is_array(src_id)
        check_slice_elem_size(c, node, as_target_id, src_id)
        check_slice_cast_writability(c, node, as_target_id)
        if c.env.is_array(src_id)
            c.refuse_packed_address(node.get_postfix_receiver(), "a slice cast")
        return
    src_shown: = c.env.display(src_id)
    dst_shown: = c.env.display(as_target_id)
    msg: = c.clear_scratch().s("cannot cast '").s(src_shown).s("' to slice type '").s(dst_shown)
        .s("'; only a slice or a fixed-size array carries the pointer and length a slice needs. \
            Note that a prefix cast swallows the whole postfix chain, so 'T[]::x.f()' means \
            'T[]::(x.f())' — write '(T[]::x).f()' if you meant to cast the receiver").slice()
    c.err(node, msg)

priv fn check_slice_cast_writability(c: Sema_ctx$@, node: Ast_node$@, as_target_id: I32) //<
    //< Checks whether the source of a prefix cast to a mutable slice is writable memory
    //< Caution: **Do not allow one from a `const` declaration or a string literal**; a write
    //< through it would modify `.rodata`. **Nor from an array whose binding has no `$`**: the C
    //< declaration carries `const` (cast_makes_mutable_view in sema/flow/track.kspl).
    if c.env.const_elem_of(as_target_id)
        return // an immutable slice is not writable
    src: = node.get_postfix_receiver()
    if src == null
        return
    // **An array that is not a place is a copy with no name**: a call's result, or a field of one.
    // A write through the view would change that copy, which nothing reads again (Principle 5).
    if c.env.is_array(src.type_id) && !c.env.is_place_expr(src)
        shown: = c.env.display(as_target_id)
        c.clear_scratch()
            .s("cannot cast a temporary array to the mutable slice type '\{shown\}'. The array is a \
                copy with no name, so a write through the slice changes only the copy. Bind the \
                array first (`$a: = ...;`) and cast the binding, or cast to the immutable slice \
                type")
        c.err(node, c.scratch.slice())
        return
    is_literal: = src.kind_id == .k_string
    if !is_literal && !c.root_binding_is_immutable(src, true)
        // **An array whose binding has no `$` is `const` in the C**, so a write through the view
        // is undefined there: an optimiser may read the array as it was initialized. A slice's
        // elements are separate memory, and its binding does not reach them.
        if c.env.is_array(src.type_id) && c.root_binding_is_immutable(src, false)
            shown: = c.env.display(as_target_id)
            c.clear_scratch()
                .s("cannot cast a read-only array to the mutable slice type '\{shown\}'. Its \
                    binding has no '$', so the array is read-only. Put '$' on the binding where it \
                    is declared ('$buf: U8[64]'), or cast to the immutable slice type")
            c.err(node, c.scratch.slice())
        return
    what: = "a string literal" if is_literal else "a 'const' declaration"
    shown: = c.env.display(as_target_id)
    msg: = c.clear_scratch().s("cannot cast ").s(what).s(" to the mutable slice type '").s(shown)
        .s("'. The descriptor carries a writable pointer, but read-only storage ends up in \
            '.rodata' (ROM on a freestanding target). Writing through it faults with no diagnostic. \
            Copy into storage you own, or cast to the immutable slice type").slice()
    c.err(node, msg)

priv fn check_slice_elem_size(c: Sema_ctx$@, node: Ast_node$@, as_target_id: I32, src_id: I32) //<
    //< Checks whether a cast from a slice or array to a slice changes the element size
    //< **The length is carried over unchanged**, so a new element size lets the bounds check pass
    //< the end (`I32[]::small` on `small: U8[8]` keeps len=8 and reads 32 bytes). The same size
    //< (`U8[]` ↔ `I8[]`, `U32[]` ↔ `I32[]`) keeps the check's meaning.
    dst_elem: = c.env.get_clean_real_type(c.env.slice_elem(as_target_id))
    $src_elem: = c.env.slice_elem(src_id)
    switch c.env.get_info(c.env.get_clean_real_type(src_id))
    case .array(base_id, _n)
        src_elem = base_id
    default {}
    src_elem = c.env.get_clean_real_type(src_elem)
    if dst_elem == src_elem
        return
    dst_size: = c.type_layout(dst_elem).size
    src_size: = c.type_layout(src_elem).size
    if dst_size == src_size
        // The cast stands on the two sizes being equal, so C checks both.
        c.record_folded(dst_elem, .size, dst_size, node)
        c.record_folded(src_elem, .size, src_size, node)
        return
    src_shown: = c.env.display(src_id)
    dst_shown: = c.env.display(as_target_id)
    msg: = c.clear_scratch().s("cannot cast '").s(src_shown).s("' to '").s(dst_shown)
        .s("': the element size changes (\{src_size\} -> \{dst_size\} bytes), but the length is \
            carried over unchanged. So the bounds check would allow reading past the end. Build the \
            descriptor yourself if you mean to reinterpret the bytes ('T$[]::{ .ptr = ..., .len = \
            ... }')").slice()
    c.err(node, msg)

priv fn const_index(c: Sema_ctx$@, index_node: Ast_node$@): I32? //<
    //< The index's value if it is known at translation time
    if index_node == null
        return .none
    return c.try_eval_constexpr(index_node)

fn index_is_static_in_range(c: Sema_ctx$@, index_node: Ast_node$@, size: I32): Bool //<
    //< Whether the index is known at translation time and within the array
    //< Caution: **Keep this test in this one place.** The diagnostic ([W0101]) and the backends'
    //< omission of the run-time check must agree. The reason is the same as at
    //< shift_amount_in_range in sema/body/binary.kspl. **Arrays only**: a slice's length is a
    //< run-time value, so its check stays even for a constant index.
    switch const_index(c, index_node)
    case .some(idx)
        return idx >= 0 && idx < size
    case .none
        return false

// target_id is the type as written (for the diagnostic), recv_id stripped by receiver_base_id.
// `[]` is allowed **only on what carries its own length**: a slice, an array, an Index /
// Index_place type. A raw pointer cannot be bounds-checked, so the user is pointed to `(p + i)$`.
priv fn lint_index_out_of_bounds(c: Sema_ctx$@, index: Ast_node$@, recv_id: I32) //<
    //< [W0101] A constant index outside a fixed-length array: past its end, or below 0
    //< The range is index_is_static_in_range's, so a warned index is never one whose run-time
    //< check the backends leave out.
    switch c.env.get_info(recv_id)
    case .array(_b, size)
        if idx_val: = const_index(c, index)
            if !index_is_static_in_range(c, index, size)
                c.clear_scratch()
                    .s("[W0101] Array index out of bounds. The array size is \{size\}, but the \
                        index is \{idx_val\}.")
                c.warn(index, c.scratch.slice())
    default {}

priv fn refuse_read_needing_writable(c: Sema_ctx$@, node: Ast_node$@, recv_id: I32, method: U8[],
    can_fall_back: Bool) //<
        //< Reports `a[i]` where the method that reads takes `Self$@` and `a` may not be written
        //< That is a temporary (a copy, as for any `Self$@` method) or a read-only location. "The
        //< type needs 'Index'" would name a fix that is not the cause. `can_fall_back` is true for
        //< an `at` with nothing else to read by, where an `Index_ref` would serve.
    shown: = c.env.display(c.env.strip_ptr(recv_id))
    c.clear_scratch()
    if c.env.receiver_needs_hoist(node.get_postfix_receiver())
        c.scratch
            .s("cannot read an element of a temporary object here. '[]' on '\{shown\}' reads \
                through '\{method\}', which takes its receiver as 'Self$@', and a temporary is a \
                copy that is then discarded. Bind the object first (`$x: = ...;`)")
    else
        c.scratch
            .s("cannot read an element through a read-only location. '[]' on '\{shown\}' reads \
                through '\{method\}', which takes its receiver as 'Self$@'. Make the binding \
                mutable ('$x')")
    if can_fall_back
        c.scratch.s(", or implement 'Index_ref' for '\{shown\}'")
    else
        c.scratch.s(", or take the receiver of '\{method\}' as 'Self@' if it does not write")
    c.err(node, c.scratch.slice())

priv fn refuses_index_receiver(c: Sema_ctx$@, node: Ast_node$@, recv_id: I32,
    method_sym: Sema_symbol$@, method: U8[]): Bool //<
        //< Refuses `a[i]` where the method it calls takes `Self$@` and `a` may not be written
        //< The same rule as for `a.m()` ("The same rule applies to method calls" in
        //< docs/SPEC-programming-language.md). An `a[i]` is a call too, so a `const` or an
        //< immutable binding is not rewritten through it.
    if !c.method_writes_receiver(method_sym)
        return false
    recv: = node.get_postfix_receiver()
    if !c.env.receiver_needs_hoist(recv) && !c.place_is_readonly(recv)
        return false
    refuse_read_needing_writable(c, node, recv_id, method, false)
    return true

priv fn infer_postfix_array(c: Sema_ctx$@, node: Ast_node$@, target_id: I32, recv_id: I32,
    expected_id: I32): I32!Sema_error
    // Only `index_route` decides the route (sema/decl/access.kspl); decided apart from the
    // assignment side, the two could resolve differently.
    route: = c.index_route(node.get_postfix_receiver(), recv_id)
    switch route
    case .by_value
        // Only an owning `at` reads, and the receiver may not be written.
        if c.env.has_implemented_operator_trait(c.env.strip_ptr(recv_id), "Index_place") &&
            !c.env.has_implemented_operator_trait(c.env.strip_ptr(recv_id), "Index")
            refuse_read_needing_writable(c, node, recv_id, "at", true)
            return I32::sema_type_env.Builtin_type_id.unknown
    default
        place_method: = route.index_route_method()
        next_op: = node.get_postfix_member()
        switch c.resolve_operator_method(recv_id, place_method)
        case .some(method_sym)
            if refuses_index_receiver(c, node, recv_id, method_sym, place_method)
                return I32::sema_type_env.Builtin_type_id.unknown
            node.def_node = method_sym.node
            c.refuse_packed_receiver(node.get_postfix_receiver(), method_sym.node, "[]")
            next_op.infer_expr(c, c.operator_index_param_id(method_sym))!
            // The node's type is the element, not the returned pointer; lower rebuilds the
            // dereference as `at(i)$` / `at_ref(i)$` (lower/expr.kspl). `at_ref` returns
            // `Output@`, so the element is immutable, which is what rejects a write.
            elem_id: = c.env.strip_ptr(method_sym.type_id)
            node.type_id = elem_id
            return elem_id
        case .none
            place_trait: = route.index_route_trait()
            c.report_operator_method_missing(recv_id, place_trait, place_method, node)
            return I32::sema_type_env.Builtin_type_id.unknown
    switch c.resolve_operator_call(recv_id, "Index", "get", "Index access", "[]", node)
    case .user(method_sym)
        if refuses_index_receiver(c, node, recv_id, method_sym, "get")
            return I32::sema_type_env.Builtin_type_id.unknown
        next_op: = node.get_postfix_member()
        node.def_node = method_sym.node
        c.refuse_packed_receiver(node.get_postfix_receiver(), method_sym.node, "[]")
        next_op.infer_expr(c, c.operator_index_param_id(method_sym))!
        node.type_id = method_sym.type_id
        return method_sym.type_id
    case .failed
        return I32::sema_type_env.Builtin_type_id.unknown
    case .builtin {}

    next_op: = node.get_postfix_member()
    if next_op != null
        next_op.infer_expr(c, I32::sema_type_env.Builtin_type_id.size_type)!

        if base_core.config.run_lint_checks
            lint_index_out_of_bounds(c, next_op, recv_id)

    $stripped: = c.env.slice_elem(recv_id)
    if stripped == recv_id
        stripped = c.env.strip_array(recv_id)

    if stripped == recv_id
        // The receiver has no length: a raw pointer, or a type that cannot be indexed.
        // Caution: Do not merge these two into one diagnostic. Only the former can be pointed to
        // `(p + i)$`; merged, the advice would offer a forbidden form as the fix.
        shown: = c.env.display(target_id)
        if c.env.is_pointer(c.env.get_real_type(target_id))
            c.clear_scratch()
                .s("cannot index '\{shown\}': it points at something that does not carry a length, \
                    so the index cannot be bounds-checked. Write '(p + i)$' to walk a raw pointer, \
                    or use a slice ('T$[]') which carries its length.")
            c.err(node, c.scratch.slice())
        else
            c.clear_scratch().s("type '\{shown\}' does not support indexing")
            c.err(node, c.scratch.slice())
        return I32::sema_type_env.Builtin_type_id.unknown

    $type_id: = stripped
    if sema_type_env.is_void(type_id) ||
        type_id == (I32::sema_type_env.Builtin_type_id.void_ptr) ||
        sema_type_env.is_unknown(type_id)
        if !sema_type_env.is_unknown(expected_id)
            type_id = expected_id
    return type_id

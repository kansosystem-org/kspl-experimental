//< The check that stops a frame's memory escaping outward
//<
//< It rejects a pointer the compiler synthesizes into the frame (a slice cast from a frame's
//< array, a trait upcast of a frame's value, a closure among them) leaving by `return` or `throw`,
//< or by a store into a global or behind a pointer, and a written `@` of the frame's storage
//< leaving by `return` or `throw`. **This asks a different question from type inference**: not
//< whether the types agree but whether the lifetime holds.
// ==========================================
// Caution: **Where it cannot be decided, lean to the safe side (false).** Wrongly deciding "not
// escaped" lets a use-after-free pass with zero diagnostics.
// ==========================================
import "ksplc/base/ast" { Ast_node, is_anon_env_type }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/sema/body/call" as sema_body_call
import "ksplc/sema/decl/name" as _sema_decl_name
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/query" as sema_type_query
import "std/chars"
import "std/str"

priv fn is_frame_binding(c: Sema_ctx$@, node: Ast_node$@): Bool //<
    //< Whether the name refers to **the current frame's memory**
    //<
    //< A global is in the static area, so false.
    //< Caution: **Do not copy this test.** Taking an address and returning an array both
    //< need the same answer; fix one copy and the two disagree on which names pass.
    sym: = c.read_written_name(node).sym
    if sym == null
        return false
    return !sym.flags.is_global && sym.kind.is_value()

fn is_frame_storage(c: Sema_ctx$@, node: Ast_node$@): Bool //<
    //< Whether node's storage lies in **the current frame**, so an address taken of it dies there
    //<
    //< A name uses is_frame_binding, a struct literal is a frame temporary, and a field or an
    //< array's element follows its receiver. Behind a pointer or a slice is not the frame: `r.buf`
    //< (`r: Self$@`) lives where `r` points ("Which pointers into a frame are stopped from
    //< leaving it" in docs/DESIGN-language.md); counted, `Panic_msg.slice()` is refused.
    if node == null
        return false
    if node.kind_id == .k_struct_literal
        return true
    if node.is_path_or_ident()
        return is_frame_binding(c, node)
    if node.kind_id == .k_expr_primary && node.children.len > 0
        return is_frame_storage(c, node.get_primary_inner_expr())
    op: = node.postfix_op_text() if node.kind_id == .k_expr_postfix else ""
    if node.kind_id == .k_method_access || op.equals(".") || op.starts_with("[")
        // An element follows its receiver only in a fixed-length array: a slice's lies behind it.
        recv: = node.get_postfix_receiver()
        if recv == null || c.env.is_pointer(recv.type_id) ||
            (op.starts_with("[") &&
            !c.env.is_array(c.env.get_real_type(recv.type_id)))
            return false
        return is_frame_storage(c, recv)
    return false

priv enum Frame_escape //< what a value leaving the frame carries of the frame's memory
    none
    slice(src: Ast_node$@) //< a slice cast from a frame's array, blamed on the array
    upcast(src: Ast_node$@) //< an interface value upcast from a frame's value
    local(name: Ast_node$@) //< a local binding set from one of these (holds_frame_pointer)
    address(at: Ast_node$@) //< a written `@` of the frame's storage
    local_address(name: Ast_node$@) //< a local binding set from one (holds_frame_address)

priv fn find_in_each(c: Sema_ctx$@, nodes: Ast_node$@, with_address: Bool): Frame_escape //<
    //< The first of find_frame_escape's finds among nodes' children, or none
    if nodes != null
        for child in nodes.children
            found: = find_frame_escape(c, child, with_address)
            switch found
            case .none {}
            default
                return found
    return .none

priv fn find_frame_escape(c: Sema_ctx$@, expr_node: Ast_node$@, with_address: Bool): Frame_escape //<
    //< What in expr_node points into the frame: a pointer the compiler synthesizes, or a `@`
    //<
    //< Two forms synthesize one, with no `@` in the source: a slice cast from a frame's array
    //< (`U8[]::a`, `U8[]::{ … }`) and a trait upcast of a frame's value (the pair {obj,
    //< vtable}, emit_upcast_expr in gen/c/expr.kspl). A local set from a form carries it on.
    //< A written `@` counts only with with_address, which `return` / `throw` pass
    //< (docs/DESIGN-principles.md, the section named at is_frame_storage).
    if expr_node == null
        return .none
    $target: = expr_node
    if target.kind_id == .k_expr_primary && target.children.len > 0
        target = target.get_primary_inner_expr()
    if target == null
        return .none
    if target.is_path_or_ident()
        sym: = c.read_written_name(target).sym
        if sym != null && sym.flags.holds_frame_pointer
            return .local(target)
        if sym != null && with_address && sym.flags.holds_frame_address
            return .local_address(target)
        return .none
    // A field's value is checked too. **Skipping it misses the case that matters most**: a returned
    // struct holding a closure, as a lazy chain does. An enum's payload is the same (`.view(s)`),
    // and so is a `T!Err` returned (result_wrap) and each branch of a ternary.
    switch target.kind_id
    case .k_struct_literal
        for child in target.children
            if child.kind_id == .k_expr_field_init && child.children.len > 0
                found: = find_frame_escape(c, child.last_child(), with_address)
                switch found
                case .none {}
                default
                    return found
        return .none
    case .k_enum_init_call
        return find_in_each(c, target.find_child(.k_expr_args), with_address)
    case .k_result_wrap
        return find_frame_escape(c, target.get_result_wrap_inner(), with_address)
    case .k_expr_ternary
        found: = find_frame_escape(c, target.get_ternary_true(), with_address)
        switch found
        case .none
            return find_frame_escape(c, target.get_ternary_false(), with_address)
        default
            return found
    case .k_expr
        // A pointer stepped by an integer (`a[0]@ + 1`) still points where its operand did.
        if !c.env.is_pointer(target.type_id) || target.children.len != 3
            return .none
        found: = find_frame_escape(c, target.get_binary_left(), with_address)
        switch found
        case .none
            return find_frame_escape(c, target.get_binary_right(), with_address)
        default
            return found
    default {}
    if with_address && target.kind_id == .k_expr_postfix &&
        target.postfix_op_text().equals("@") &&
        is_frame_storage(c, target.get_postfix_receiver())
        return .address(target)
    if target.kind_id == .k_expr_upcast
        inner: = target.get_upcast_inner()
        if inner == null || c.env.is_pointer(inner.type_id) ||
            c.env.is_slice(inner.type_id) || !is_frame_storage(c, inner)
            return .none
        return .upcast(inner)
    // Caution: Do not check a call's result (`b.slice()` / `arena.alloc()`). Where it points is
    // unknown, and rejecting it would forbid legitimately returning memory it allocated.
    if !target.is_explicit_cast() ||
        !(c.env.is_slice(target.type_id) || c.env.is_pointer(target.type_id))
        return .none
    src: = target.get_postfix_receiver()
    if src == null
        return .none
    // Only an array makes a new pointer; a cast between pointers or slices carries the source's on.
    if !c.env.is_slice(target.type_id) ||
        !c.env.is_array(c.env.get_real_type(src.type_id))
        return find_frame_escape(c, src, with_address)
    if !is_frame_storage(c, src)
        return .none
    return .slice(src)

fn note_frame_pointer(c: Sema_ctx$@, id_node: Ast_node$@, expr_node: Ast_node$@) //<
    //< Marks a local binding set from a value carrying a pointer into the frame
    //<
    //< A declaration's initializer and a plain `x = …` both set it, so `s: = I32[]::a; t: = s;
    //< return t` is refused. **The mark is never cleared**: `s = heap_slice` after it still refuses
    //< `return s`, the safe side of a check that follows names, not control flow.
    sym: = c.read_written_name(id_node).sym
    if sym == null || sym.flags.is_global
        return
    switch find_frame_escape(c, expr_node, false)
    case .none {}
    default
        sym.flags.holds_frame_pointer = true
    switch find_frame_escape(c, expr_node, true)
    case .none {}
    default
        sym.flags.holds_frame_address = true

fn check_frame_escape(c: Sema_ctx$@, expr_node: Ast_node$@, verb: U8[]) //<
    //< Rejects a pointer into the frame leaving by return / throw, a written `@` among them
    //<
    //< **A store of a written `@` is not refused** (check_frame_store): a local's address kept in a
    //< longer-lived place and taken back before the function returns is a pattern real code uses.
    report_frame_escape(c, find_frame_escape(c, expr_node, true), verb,
        "this function's frame dies here",
        "Return storage that outlives the call (an arena or a heap allocation), or take the \
            destination as a parameter.")

priv enum Store_place //< where an assignment's target lies, seen from the frame's lifetime
    frame //< in this frame, or not known to lie outside it
    global(name: Ast_node$@) //< in a global, or a field or element of one
    behind_pointer //< behind a pointer or a slice: a parameter's pointee, `p$`, `s[i]`

priv fn store_place(c: Sema_ctx$@, left: Ast_node$@): Store_place //<
    //< Whether an assignment's target can outlive the frame, following its fields and elements
    //<
    //< A field of a value, or an element of a fixed-length array, lies where its receiver lies. A
    //< step through a pointer or a slice leaves the frame's own storage: where it points is not
    //< known, so it is taken as outliving (a pointer to a local of this frame is refused too).
    if left == null
        return .frame
    if left.kind_id == .k_expr_primary && left.children.len > 0
        return store_place(c, left.get_primary_inner_expr())
    if left.is_path_or_ident()
        sym: = c.read_written_name(left).sym
        if sym != null && sym.flags.is_global
            return .global(left)
        return .frame
    $op: = ""
    if left.kind_id == .k_method_access
        op = "."
    else if left.kind_id == .k_expr_postfix
        op = left.postfix_op_text()
    if op.equals("$")
        return .behind_pointer
    if !op.equals(".") && !op.starts_with("[")
        return .frame
    recv: = left.get_postfix_receiver()
    if recv == null
        return .frame
    if c.env.is_pointer(recv.type_id) ||
        (op.starts_with("[") && c.env.is_slice(recv.type_id))
        return .behind_pointer
    return store_place(c, recv)

fn check_frame_store(c: Sema_ctx$@, left: Ast_node$@, right: Ast_node$@) //<
    //< Rejects a synthesized pointer into the frame stored where it outlives the frame
    //<
    //< The forms are find_frame_escape's synthesized ones, anywhere inside the stored value (a
    //< written `@` is the writer's: check_frame_escape says why); the places are a global and what
    //< lies behind a pointer or a slice (store_place). A store dangles there as a `return` does.
    found: = find_frame_escape(c, right, false)
    switch found
    case .none
        return
    default {}
    $fate: = ""
    switch store_place(c, left)
    case .frame
        return
    case .global(name)
        c.clear_scratch()
            .s("it would be stored into the global '\{name.get_path_or_ident_name()\}', which \
                outlives this function's frame")
        fate = base_core.arena.dup_str(c.scratch.slice())
    case .behind_pointer
        fate = "it would be stored behind a pointer, where it can outlive this function's frame"
    report_frame_escape(c, found, "store", fate,
        "Store a pointer to storage that outlives the call (an arena, a heap allocation or a \
            global) instead, or keep the value in a local and pass it down as an argument.")

priv fn report_frame_escape(c: Sema_ctx$@, found: Frame_escape, verb: U8[], fate: U8[], fix: U8[]) //<
    //< Reports what find_frame_escape found leaving the frame: by verb, and how (fate)
    switch found
    case .none {}
    case .upcast(inner)
        c.clear_scratch()
        if is_anon_env_type(c.env.get_str(c.env.strip_const_deep(inner.type_id)))
            c.scratch
                .s("cannot \{verb\} a closure: it keeps pointers to its captured variables, which \
                    live in this function's frame, and \{fate\}. A closure can only be passed down \
                    as an argument; to keep the values longer, put them in a struct and keep that.")
        else
            c.scratch
                .s("cannot \{verb\} an interface value built from local storage: the interface \
                    value keeps a pointer to it, and \{fate\} (the address is synthesized by the \
                    compiler, so no '@' appears). Upcast a pointer to storage that outlives the \
                    call instead.")
        c.err(inner, c.scratch.slice())
    case .slice(src)
        c.clear_scratch()
            .s("cannot \{verb\} a slice built from local storage: the descriptor's pointer is \
                synthesized by the compiler (no '@' appears in the source), and \{fate\}. \{fix\}")
        c.err(src, c.scratch.slice())
    case .local(name)
        c.clear_scratch()
            .s("cannot \{verb\} '\{name.get_path_or_ident_name()\}': it was set from a slice or an \
                interface value built from local storage, whose pointer (synthesized by the \
                compiler, so no '@' appears) points into this function's frame, and \{fate\}. \
                \{fix\}")
        c.err(name, c.scratch.slice())
    case .address(at)
        $root: = at.get_postfix_receiver()
        for root != null && !root.is_path_or_ident() && root.children.len > 0
            if root.kind_id == .k_expr_primary
                root = root.get_primary_inner_expr()
            else
                root = root.get_postfix_receiver()
        c.clear_scratch().s("cannot \{verb\} the address of local storage: ")
        if root != null && root.is_path_or_ident()
            c.scratch.s("'\{root.get_path_or_ident_name()\}'")
        else
            c.scratch.s("a temporary")
        c.scratch.s(" lives in this function's frame, and \{fate\}. \{fix\}")
        c.err(at, c.scratch.slice())
    case .local_address(name)
        c.clear_scratch()
            .s("cannot \{verb\} '\{name.get_path_or_ident_name()\}': it was set from the address of \
                local storage, which points into this function's frame, and \{fate\}. \{fix\}")
        c.err(name, c.scratch.slice())

fn check_fn_value_binding(c: Sema_ctx$@, id_node: Ast_node$@, expr_node: Ast_node$@): Bool //<
    //< Rejects binding a variadic function's name with no type annotation (`f: = log_all;`)
    //<
    //< **A declaration with no type takes the function type of the function a name names**
    //< (own_type_of_name in sema/decl/name.kspl); a variadic one has none, since no function type
    //< holds its `...`, and keeps the mark generic_fn_value_type_id, which no C type spells.
    // **Only a bare name counts**: `x: = f(1);` resolves to the same function, so without checking
    // the node's kind every call's result would be rejected.
    if expr_node == null || expr_node.type_id != c.env.generic_fn_value_type_id()
        return false
    is_bare_path: = expr_node.kind_id == .k_identifier || expr_node.kind_id == .k_expr_path
    if !is_bare_path || !sema_body_call.resolves_to_named_fn(expr_node)
        return false
    c.clear_scratch()
        .s("cannot infer the type of '\{id_node.text\}' from function \
            '\{expr_node.get_path_name()\}': it is variadic, and a function type holds no '...'\n  \
            Hint: call it where it is needed, or wrap the call in a function with fixed parameters \
            and bind that.")
    c.err(id_node, c.scratch.slice())
    return true

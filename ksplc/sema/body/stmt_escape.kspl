//< The check that stops a frame's memory escaping outward
//< It rejects a pointer the compiler synthesizes into the frame. The forms are a slice cast from a
//< frame's array and a trait upcast of a frame's value (a closure among them). Such a pointer must
//< not leave by `return` or `throw`, or by a store into a global, behind a pointer, or into a
//< local of a block outside the one that holds its storage. It also rejects a written `@` of the
//< frame's storage leaving by `return` or `throw`. **This asks a different question from type
//< inference**: not whether the types agree but whether the lifetime holds.
// ==========================================
// Caution: **Where it cannot be decided, lean to the safe side (false).** Wrongly deciding "not
// escaped" lets a use-after-free pass with zero diagnostics.
// ==========================================
import "ksplc/base/ast" { Ast_node, is_anon_env_type }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/sema/body/call" as sema_body_call
import "ksplc/sema/decl/name" as _sema_decl_name
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/display" as _sema_type_display
import "ksplc/sema/type/query" as sema_type_query
import "std/chars"
import "std/str"

priv fn is_frame_binding(c: Sema_ctx$@, node: Ast_node$@): Bool //<
    //< Whether the name refers to **the current frame's memory**
    //< A global is in the static area, so false.
    //< Caution: **Do not copy this test.** Taking an address and returning an array both
    //< need the same answer; fix one copy and the two disagree on which names pass.
    sym: = c.read_written_name(node).sym
    if sym == null
        return false
    return !sym.flags.is_global && sym.kind.is_value()

fn is_frame_storage(c: Sema_ctx$@, node: Ast_node$@): Bool //<
    //< Whether node's storage lies in **the current frame**, so an address taken of it dies there
    //< A name uses is_frame_binding, and a struct literal is a frame temporary. A field or an
    //< array's element follows its receiver. Behind a pointer or a slice is not the frame: `r.buf`
    //< (`r: Self$@`) lives where `r` points. See "Which pointers into a frame are stopped from
    //< leaving it" in docs/DESIGN-programming-language.md. Counted, `Panic_msg.slice()` is refused.
    if node == null
        return false
    if node.kind_id == .k_struct_literal
        return true
    if node.is_path_or_ident()
        return is_frame_binding(c, node)
    if node.kind_id == .k_expr_primary && node.children.len > 0
        return is_frame_storage(c, node.get_primary_inner_expr())
    op: = node.postfix_op_text() if node.kind_id == .k_expr_postfix else ""
    if node.kind_id == .k_method_access || op.equals(".") || op.starts_with("[")
        // An element follows its receiver only in a fixed-length array: a slice's lies behind it.
        recv: = node.get_postfix_receiver()
        if recv == null || c.env.is_pointer(recv.type_id) ||
            (op.starts_with("[") &&
            !c.env.is_array(c.env.get_real_type(recv.type_id)))
            return false
        return is_frame_storage(c, recv)
    return false

priv fn frame_depth(c: Sema_ctx@, depth: I32): I32 //<
    //< A scope depth, where every depth up to the function's own block counts as that block
    //< A parameter's scope and the function's block both live until the function returns
    //< (Fn_ctx.body_depth).
    return depth if depth > c.fn_ctx.body_depth else c.fn_ctx.body_depth

priv fn storage_depth(c: Sema_ctx$@, node: Ast_node$@): I32 //<
    //< The depth of the block whose end ends node's storage, where is_frame_storage holds
    //< A name's is its declaration's. A field or an element follows its receiver, as in
    //< is_frame_storage. Anything else, such as a struct literal or a closure, is a temporary
    //< of the block the statement stands in.
    $at: = node
    for at != null
        if at.is_path_or_ident()
            sym: = c.read_written_name(at).sym
            if sym == null || sym.flags.is_global
                break
            return frame_depth(c, sym.scope_depth)
        if at.kind_id == .k_expr_primary && at.children.len > 0
            at = at.get_primary_inner_expr()
            continue
        op: = at.postfix_op_text() if at.kind_id == .k_expr_postfix else ""
        if at.kind_id != .k_method_access && !op.equals(".") && !op.starts_with("[")
            break
        at = at.get_postfix_receiver()
    return frame_depth(c, I32::c.symtab.scope_stack.len)

priv enum Frame_escape //< what a value leaving the frame carries of the frame's memory
    none
    slice(src: Ast_node$@) //< a slice cast from a frame's array, blamed on the array
    upcast(src: Ast_node$@) //< an interface value upcast from a frame's value
    local(name: Ast_node$@) //< a local binding set from one of these (holds_frame_pointer)
    address(at: Ast_node$@) //< a written `@` of the frame's storage
    local_address(name: Ast_node$@) //< a local binding set from one (holds_frame_address)

priv fn find_in_each(c: Sema_ctx$@, nodes: Ast_node@, with_address: Bool, deeper_than: I32):
    Frame_escape //< the first of find_frame_escape's finds among nodes' children, or none
    if nodes != null
        for child in nodes.children
            found: = find_frame_escape(c, child, with_address, deeper_than)
            switch found
            case .none {}
            default
                return found
    return .none

priv fn find_frame_escape(c: Sema_ctx$@, expr_node: Ast_node$@, with_address: Bool,
    deeper_than: I32): Frame_escape //<
        //< What in expr_node points into a block deeper than deeper_than: a made pointer, or a `@`
        //< `return`, `throw` and a store that outlives the frame pass 0, so every block counts.
        //< Two forms synthesize one, with no `@` in the source. One is a slice cast from a frame's
        //< array (`U8[]::a`, `U8[]::{ … }`). The other is a trait upcast of a frame's value (the
        //< pair {obj, vtable}, emit_upcast_expr in gen/c/expr.kspl). A local set from a form
        //< carries it on. A written `@` counts only with with_address, which `return` / `throw`
        //< pass (docs/DESIGN-principles.md, the section named at is_frame_storage).
    if expr_node == null
        return .none
    $target: = expr_node
    if target.kind_id == .k_expr_primary && target.children.len > 0
        target = target.get_primary_inner_expr()
    if target == null
        return .none
    if target.is_path_or_ident()
        sym: = c.read_written_name(target).sym
        if sym != null && sym.flags.holds_frame_pointer && sym.frame_pointer_depth > deeper_than
            return .local(target)
        if sym != null && with_address && sym.flags.holds_frame_address
            return .local_address(target)
        return .none
    // A field's value is checked too. **Skipping it misses the case that matters most**: a returned
    // struct holding a closure, as a lazy chain does. An enum's payload is the same (`.view(s)`),
    // and so is a `T!Err` returned (result_wrap) and each branch of a ternary.
    switch target.kind_id
    case .k_struct_literal
        for child in target.children
            if child.kind_id == .k_expr_field_init && child.children.len > 0
                found: =
                    find_frame_escape(c, child.last_child(), with_address, deeper_than)
                switch found
                case .none {}
                default
                    return found
        return .none
    case .k_enum_init_call
        return find_in_each(c, target.find_child(.k_expr_args), with_address, deeper_than)
    case .k_result_wrap
        return find_frame_escape(c, target.get_result_wrap_inner(), with_address, deeper_than)
    case .k_expr_ternary
        found: =
            find_frame_escape(c, target.get_ternary_true(), with_address, deeper_than)
        switch found
        case .none
            return find_frame_escape(c, target.get_ternary_false(), with_address, deeper_than)
        default
            return found
    case .k_expr
        // A pointer stepped by an integer (`a[0]@ + 1`) still points where its operand did.
        if !c.env.is_pointer(target.type_id) || target.children.len != 3
            return .none
        found: = find_frame_escape(c, target.get_binary_left(), with_address, deeper_than)
        switch found
        case .none
            return find_frame_escape(c, target.get_binary_right(), with_address, deeper_than)
        default
            return found
    default {}
    if with_address && target.kind_id == .k_expr_postfix &&
        target.postfix_op_text().equals("@") &&
        is_frame_storage(c, target.get_postfix_receiver()) &&
        storage_depth(c, target.get_postfix_receiver()) > deeper_than
        return .address(target)
    if target.kind_id == .k_expr_upcast
        // **A slice's trait value keeps the descriptor's address**, as any value's does, not the
        // address its elements lie at. A descriptor that is no place (`"ab"`, a call's result) is
        // a temporary of the block the statement stands in.
        inner: = target.get_upcast_inner()
        if inner == null || c.env.is_pointer(inner.type_id)
            return .none
        held: =
            is_frame_storage(c, inner) ||
            (c.env.is_slice(inner.type_id) && !c.env.is_place_expr(inner))
        if !held || storage_depth(c, inner) <= deeper_than
            return .none
        return .upcast(inner)
    // Caution: Do not check a call's result (`b.slice()` / `arena.alloc()`). Where it points is
    // unknown, and rejecting it would forbid legitimately returning memory it allocated.
    if !target.is_explicit_cast() ||
        !(c.env.is_slice(target.type_id) || c.env.is_pointer(target.type_id))
        return .none
    src: = target.get_postfix_receiver()
    if src == null
        return .none
    // Only an array makes a new pointer; a cast between pointers or slices carries the source's on.
    if !c.env.is_slice(target.type_id) ||
        !c.env.is_array(c.env.get_real_type(src.type_id))
        return find_frame_escape(c, src, with_address, deeper_than)
    if !is_frame_storage(c, src) || storage_depth(c, src) <= deeper_than
        return .none
    return .slice(src)

fn note_frame_pointer(c: Sema_ctx$@, id_node: Ast_node$@, expr_node: Ast_node$@) //<
    //< Marks a local binding set from a value carrying a pointer into the frame
    //< A declaration's initializer and a plain `x = …` both set it, so `s: = I32[]::a; t: = s;
    //< return t` is refused. **The mark is never cleared**: `s = heap_slice` after it still refuses
    //< `return s`, the safe side of a check that follows names, not control flow.
    //< The local also keeps the deepest block its pointers reach (frame_pointer_depth), for a
    //< store of it into a local of an outer block.
    sym: = c.read_written_name(id_node).sym
    if sym == null || sym.flags.is_global
        return
    // Each round finds a pointer into a deeper block than the last, so it ends at the deepest.
    $depth: I32 = 0
    for
        found: = find_frame_escape(c, expr_node, false, depth)
        switch found
        case .none
            break
        default {}
        sym.flags.holds_frame_pointer = true
        depth = escape_depth(c, found)
        if depth > sym.frame_pointer_depth
            sym.frame_pointer_depth = depth
    switch find_frame_escape(c, expr_node, true, 0)
    case .none {}
    default
        sym.flags.holds_frame_address = true

fn check_frame_escape(c: Sema_ctx$@, expr_node: Ast_node$@, verb: U8[]) //<
    //< Rejects a pointer into the frame leaving by return / throw, a written `@` among them
    //< **A store of a written `@` is not refused** (check_frame_store). Real code keeps a local's
    //< address in a longer-lived place and takes it back before the function returns.
    report_frame_escape(c, find_frame_escape(c, expr_node, true, 0), verb,
        "This function's frame dies here.",
        "Return storage that outlives the call (an arena or a heap allocation), or take the \
            destination as a parameter.", "")

priv fn escape_depth(c: Sema_ctx$@, found: Frame_escape): I32 //<
    //< The depth of the block whose storage what find_frame_escape found points into
    switch found
    case .slice(src)
        return storage_depth(c, src)
    case .upcast(inner)
        return storage_depth(c, inner)
    case .address(at)
        return storage_depth(c, at.get_postfix_receiver())
    case .local(name)
        return c.read_written_name(name).sym.frame_pointer_depth
    default
        return frame_depth(c, I32::c.symtab.scope_stack.len)

priv enum Store_place //< where an assignment's target lies, seen from the frame's lifetime
    frame //< in this frame, or not known to lie outside it
    local(name: Ast_node$@) //< in a local of this frame, or a field or element of one
    global(name: Ast_node$@) //< in a global, or a field or element of one
    behind_pointer //< behind a pointer or a slice: a parameter's pointee, `p$`, `s[i]`

priv fn store_place(c: Sema_ctx$@, left: Ast_node$@): Store_place //<
    //< Whether an assignment's target can outlive the frame, following its fields and elements
    //< A field of a value, or an element of a fixed-length array, lies where its receiver lies. A
    //< step through a pointer or a slice leaves the frame's own storage. Where it points is not
    //< known, so it is taken as outliving (a pointer to a local of this frame is refused too).
    if left == null
        return .frame
    if left.kind_id == .k_expr_primary && left.children.len > 0
        return store_place(c, left.get_primary_inner_expr())
    if left.is_path_or_ident()
        sym: = c.read_written_name(left).sym
        if sym != null && sym.flags.is_global
            return .global(left)
        return .local(left) if sym != null else .frame
    $op: = ""
    if left.kind_id == .k_method_access
        op = "."
    else if left.kind_id == .k_expr_postfix
        op = left.postfix_op_text()
    if op.equals("$")
        return .behind_pointer
    if !op.equals(".") && !op.starts_with("[")
        return .frame
    recv: = left.get_postfix_receiver()
    if recv == null
        return .frame
    if c.env.is_pointer(recv.type_id) ||
        (op.starts_with("[") && c.env.is_slice(recv.type_id))
        return .behind_pointer
    return store_place(c, recv)

fn check_frame_store(c: Sema_ctx$@, left: Ast_node$@, right: Ast_node$@) //<
    //< Rejects a synthesized pointer into the frame stored where it outlives the frame
    //< The forms are find_frame_escape's synthesized ones, anywhere inside the stored value. A
    //< written `@` is the writer's (check_frame_escape says why). The places are a global, what
    //< lies behind a pointer or a slice (store_place), and a local of a block outside the one
    //< whose storage the pointer points into. A store dangles there as a `return` does.
    //< **A store into a local, or into its field or element, marks that local**
    //< (note_frame_pointer), so `h.s = U8[]::a; return h` is refused as `h: = …; return h` is.
    place: = store_place(c, left)
    switch place
    case .local(name)
        note_frame_pointer(c, name, right)
    default {}
    $found: = find_frame_escape(c, right, false, 0)
    switch found
    case .none
        return
    default {}
    $fate: = ""
    switch place
    case .frame
        return
    case .local(name)
        // A local of an outer block outlives the inner block, whose storage dies at its end.
        sym: = c.read_written_name(name).sym
        found = find_frame_escape(c, right, false, frame_depth(c, sym.scope_depth))
        switch found
        case .none
            return
        default {}
        local_name: = name.get_path_or_ident_name()
        c.clear_scratch()
            .s("It would be stored into '\{local_name\}', a local of an outer block, and outlive \
                the block whose end frees what it points at.")
        fate = base_core.arena.dup_str(c.scratch.slice())
        c.clear_scratch()
            .s("Declare '\{local_name\}' in that block, or make the value in the block that \
                declares '\{local_name\}'.")
        fix: = base_core.arena.dup_str(c.scratch.slice())
        report_frame_escape(c, found, "store", fate, fix, fix)
        return
    case .global(name)
        c.clear_scratch()
            .s("It would be stored into the global '\{name.get_path_or_ident_name()\}', which \
                outlives this function's frame.")
        fate = base_core.arena.dup_str(c.scratch.slice())
    case .behind_pointer
        fate = "It would be stored behind a pointer, where it can outlive this function's frame."
    report_frame_escape(c, found, "store", fate,
        "Store a pointer to storage that outlives the call instead (an arena, a heap allocation or \
            a global). Or keep the value in a local and pass it down as an argument.", "")

fn check_frame_kept_by_call(c: Sema_ctx$@, recv: Ast_node$@, def_node: Ast_node$@,
    args_node: Ast_node@) //<
        //< A trait value into the frame handed to a container's method that may keep it ([W0110])
        //< The method takes `Self$@`, and the argument's type is a trait the receiver's type holds
        //< as a type argument (`xs.push(sq)`, `xs: List<|Shape|>`): a store into the container. A
        //< container in a local of the storage's block or a deeper one marks that local, so
        //< returning it is refused. Elsewhere it is a warning, not a refusal: the signature does
        //< not say whether the method keeps what it is handed ("Which pointers into a frame are
        //< stopped from leaving it" in docs/DESIGN-programming-language.md).
    if recv == null || args_node == null
        return
    switch c.env.method_receiver_permission(def_node)
    case .some(need)
        if !need.mut_ptr
            return
    case .none
        return
    held: = c.env.instance_args(c.env.receiver_base_id(recv.type_id))
    if held.len == 0
        return
    for arg in args_node.children
        if arg.is_literal(",") || !holds_trait_type(c, held, arg.type_id)
            continue
        switch find_frame_escape(c, arg, false, 0)
        case .none
            continue
        default {}
        $place: = Store_place.behind_pointer
        if !c.env.is_pointer(recv.type_id)
            place = store_place(c, recv)
        $fate: = ""
        switch place
        case .frame
            continue
        case .local(name)
            sym: = c.read_written_name(name).sym
            switch find_frame_escape(c, arg, false, frame_depth(c, sym.scope_depth))
            case .none
                note_frame_pointer(c, name, arg)
                continue
            default {}
            c.clear_scratch()
                .s("'\{name.get_path_or_ident_name()\}', a local of an outer block, which outlives \
                    the block whose end frees it")
            fate = base_core.arena.dup_str(c.scratch.slice())
        case .global(name)
            c.clear_scratch()
                .s("the global '\{name.get_path_or_ident_name()\}', which outlives this function's \
                    frame")
            fate = base_core.arena.dup_str(c.scratch.slice())
        case .behind_pointer
            fate = "a container behind a pointer, which can outlive this function's frame"
        if !base_core.config.run_lint_checks
            continue
        c.clear_scratch()
            .s("[W0110] This call can keep a trait value made from local storage in \{fate\}. The \
                trait value keeps the address of the local; the compiler makes that address, so no \
                '@' appears. Keep the value as long as the container: make it in the container's \
                arena (`arena.create(…)`) and pass that pointer, or make the container hold the \
                concrete type in place of '\{c.env.display(arg.type_id)\}'.")
        c.warn(arg, c.scratch.slice())

priv fn holds_trait_type(c: Sema_ctx@, held: I32[], type_id: I32): Bool //<
    //< Whether type_id is a trait type found in held, the receiver type's type arguments
    clean: = c.env.get_clean_real_type(type_id)
    switch c.env.get_info(clean)
    case .trait_type
        for h in held
            if c.env.get_clean_real_type(h) == clean
                return true
    default {}
    return false

priv fn report_frame_escape(c: Sema_ctx$@, found: Frame_escape, verb: U8[], fate: U8[], fix: U8[],
    upcast_fix: U8[]) //< reports what find_frame_escape found leaving: by verb, and how (fate)
        //< An upcast (a closure among them) takes upcast_fix where it is not empty, and its own
        //< advice otherwise; the other forms take fix.
    switch found
    case .none {}
    case .upcast(inner)
        c.clear_scratch()
        $advice: = upcast_fix
        if is_anon_env_type(c.env.get_str(c.env.strip_const_deep(inner.type_id)))
            if advice.len == 0
                advice =
                    "A closure can only be passed down as an argument. To keep the values longer, \
                        put them in a struct and keep that."
            c.scratch
                .s("cannot \{verb\} a closure: it keeps pointers to its captured variables, which \
                    live in this function's frame. \{fate\} \{advice\}")
        else
            if advice.len == 0
                advice = "Upcast a pointer to storage that outlives the call instead."
            c.scratch
                .s("cannot \{verb\} an interface value built from local storage. The interface \
                    value keeps a pointer to it. The compiler makes that address, so no '@' \
                    appears. \{fate\} \{advice\}")
        c.err(inner, c.scratch.slice())
    case .slice(src)
        c.clear_scratch()
            .s("cannot \{verb\} a slice built from local storage. The compiler makes the \
                descriptor's pointer, so no '@' appears in the source. \{fate\} \{fix\}")
        c.err(src, c.scratch.slice())
    case .local(name)
        c.clear_scratch()
            .s("cannot \{verb\} '\{name.get_path_or_ident_name()\}': it was set from a slice or an \
                interface value built from local storage. Its pointer points into this function's \
                frame. The compiler makes that pointer, so no '@' appears. \{fate\} \{fix\}")
        c.err(name, c.scratch.slice())
    case .address(at)
        $root: = at.get_postfix_receiver()
        for root != null && !root.is_path_or_ident() && root.children.len > 0
            if root.kind_id == .k_expr_primary
                root = root.get_primary_inner_expr()
            else
                root = root.get_postfix_receiver()
        c.clear_scratch().s("cannot \{verb\} the address of local storage: ")
        if root != null && root.is_path_or_ident()
            c.scratch.s("'\{root.get_path_or_ident_name()\}'")
        else
            c.scratch.s("a temporary")
        c.scratch.s(" lives in this function's frame. \{fate\} \{fix\}")
        c.err(at, c.scratch.slice())
    case .local_address(name)
        c.clear_scratch()
            .s("cannot \{verb\} '\{name.get_path_or_ident_name()\}': it was set from the address of \
                local storage, which points into this function's frame. \{fate\} \{fix\}")
        c.err(name, c.scratch.slice())

fn check_fn_value_binding(c: Sema_ctx$@, id_node: Ast_node$@, expr_node: Ast_node$@): Bool //<
    //< Rejects binding a variadic function's name with no type annotation (`f: = log_all;`)
    //< **A declaration with no type takes the function type of the function a name names**
    //< (own_type_of_name in sema/decl/name.kspl). A variadic one has none, since no function type
    //< holds its `...`. It keeps the mark generic_fn_value_type_id, which no C type spells.
    // **Only a bare name counts**: `x: = f(1);` resolves to the same function, so without checking
    // the node's kind every call's result would be rejected.
    if expr_node == null || expr_node.type_id != c.env.generic_fn_value_type_id()
        return false
    is_bare_path: = expr_node.kind_id == .k_identifier || expr_node.kind_id == .k_expr_path
    if !is_bare_path || !sema_body_call.resolves_to_named_fn(expr_node)
        return false
    c.clear_scratch()
        .s("cannot infer the type of '\{id_node.text\}' from function \
            '\{expr_node.get_path_name()\}': it is variadic, and a function type holds no '...'\n  \
            Hint: call it where it is needed, or wrap the call in a function with fixed parameters \
            and bind that.")
    c.err(id_node, c.scratch.slice())
    return true

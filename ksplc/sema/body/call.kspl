//< Infers a call `f(…)`: the callee its name names, a generic's instance, and the result's type
//< It covers a function or method by name, an enum variant with a payload, and a call through a
//< function value. It also covers the intrinsics the compiler builds in (`__kspl_<name>`).
//< `call_args.kspl` matches the arguments against the parameters. `generic_infer.kspl` reads a
//< generic's type arguments off them. **`intrinsic_of` is the one test for an intrinsic**, which
//< Sema and both backends ask.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell"
import "ksplc/base/core" as base_core
import "ksplc/sema/body/call_args" { check_args_against_instance, infer_call_args,
    infer_value_call_args }
import "ksplc/sema/body/expr" as sema_body_expr
import "ksplc/sema/body/generic_infer" as sema_body_generic_infer
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/layout" as sema_decl_layout
import "ksplc/sema/decl/mono" as sema_decl_mono
import "ksplc/sema/decl/mono_name" as sema_decl_mono_name
import "ksplc/sema/decl/mono_queue" as sema_decl_mono_queue
import "ksplc/sema/decl/name" as sema_decl_name
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/session/ctx" as _sema_session_ctx + { Sema_ctx, Sema_error }
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/chars"
import "std/str" { Str_builder }

fn check_variant_call_arity(c: Sema_ctx$@, node: Ast_node$@, args_node: Ast_node$@,
    variant_def: sema_type_def.Enum_variant$@, has_call_syntax: Bool) //<
        //< Checks the argument count of a call to an enum variant, `()` on a payload-free one too
        //< `Enum.variant(...)`, `.variant(...)` and a bare `.variant` / `Enum.variant` all use it.
    if variant_def == null
        return
    expected_args: = I32::variant_def.payload_fields.len
    if expected_args == 0
        if has_call_syntax
            c.clear_scratch()
                .s("enum variant '\{variant_def.name\}' has no payload and cannot be called with \
                    '()'. Use '.\{variant_def.name\}' without parentheses")
            c.err(node, c.scratch.slice())
        return
    $actual_args: I32 = 0
    if args_node != null
        for arg_node in args_node.children
            if !arg_node.is_literal(",")
                actual_args += 1
    if actual_args != expected_args
        c.clear_scratch()
            .s("argument count mismatch for enum variant '\{variant_def.name\}'. Expected \
                \{expected_args\}, but got \{actual_args\}")
        if args_node != null
            c.err(args_node, c.scratch.slice())
        else
            c.err(node, c.scratch.slice())
priv fn infer_enum_init_call(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@): I32!Sema_error //<
    //< Infers a call that builds an enum variant with a payload (for example Shape.circle(7))
    node.set_kind(.k_enum_init_call)
    type_id: = left.type_id
    node.type_id = type_id

    $variant_name: U8[] = ""
    for $ci: I32 = (I32::left.children.len) - 1; ci >= 0; ci -= 1
        v_node: = left.get_child(ci)
        if v_node.kind_id == .k_identifier
            variant_name = v_node.text
            break
    // An alias's variant (`Form.circle(3)`) is typed by the alias; its payload is the enum's.
    enum_name: = c.env.get_str(c.env.get_real_type(type_id))
    $variant_def: sema_type_def.Enum_variant$@ = null
    if enum_def: = c.env.get_enum_def(enum_name)
        switch enum_def.get_variant(variant_name)
        case .some(d)
            variant_def = d
        case .none {}

    $args_node: Ast_node$@ = null
    if node.children.len > 2 && node.get_child(2).kind_id == .k_expr_args
        args_node = node.get_child(2)

    check_variant_call_arity(c, node, args_node, variant_def, true)

    if args_node != null
        args_node.infer_enum_payload_args(c, variant_def)!
    return type_id

priv fn check_method_receiver_lvalue(c: Sema_ctx$@, left: Ast_node$@, def_node: Ast_node$@) //<
    //< Checks that the receiver is an lvalue where the method demands `@`; an rvalue is an error
    recv_node: = left.get_postfix_receiver()
    member: = left.get_postfix_member()
    c.refuse_packed_receiver(recv_node, def_node, member.text if member != null else "")
    switch c.env.method_receiver_permission(def_node)
    case .some(need)
        requires_ptr: = need.ptr
        requires_mut_ptr: = need.mut_ptr

        if requires_ptr && recv_node != null
            // The receiver **implicitly has its address taken**. A call's or a computation's
            // result has no address, so it is stored in a temporary in the frame.
            // Caution: **Writing (`Self$@`) is rejected**: the temporary is a copy, so the
            // caller never sees the write (`make_point().set_n(5)`: "called, nothing
            // happened").
            needs_hoist: = c.env.receiver_needs_hoist(recv_node)
            if needs_hoist && requires_mut_ptr
                c.clear_scratch()
                    .s("cannot call a method that writes its receiver ('Self$@') on a temporary \
                        object. The write would affect a copy that is then discarded. Bind the \
                        object first (`$x: = ...;`), or take the receiver as 'Self@' if the method \
                        does not write.")
                c.err(recv_node, c.scratch.slice())
            // **A `Self$@` method must demand the same permission as an assignment**, or `v.n =
            // 9` is rejected while `v.bump()` passes (on `const` data, a write to ROM). A
            // temporary is rejected above; "a read-only location" does not describe it.
            if requires_mut_ptr && !needs_hoist && c.place_is_readonly(recv_node)
                c.clear_scratch()
                    .s("cannot call a method that takes a writable receiver ('Self$@') on a \
                        read-only location. Make the binding mutable ('$x'), take the receiver as \
                        'Self@', or cast explicitly ('T$@::(...)') if the write is intended.")
                c.err(recv_node, c.scratch.slice())
    case .none {} // not a declared function's signature (no first parameter to read)

priv fn owner_was_refused(c: Sema_ctx$@, parts: sema_decl_name.Named_fn): Bool //<
    //< Whether the callee is reached through an instance whose type arguments were refused
    if parts.owner == null || parts.owner.type_id <= 0
        return false
    return c.has_failed_constraint(c.env.base_type_name(parts.owner.type_id))

fn with_args(fn_tmpl: sema_decl_mono.Fn_instance, args: I32[]): sema_decl_mono.Fn_instance //<
    //< The instance of fn_tmpl's template binding args
    return sema_decl_mono.Fn_instance::{ .template = fn_tmpl.template, .owner = fn_tmpl.owner,
        .args = args }

fn refuse_type_args_on_plain_fn(c: Sema_ctx$@, fn_name: U8[], type_args: Ast_node$@) //<
    //< Reports type arguments written after a function that declares none
    //< They would bind nothing and change nothing (Principle 5), called or named as a value.
    c.clear_scratch()
        .s("function '\{fn_name\}' is not generic. Remove the type arguments '\{type_args.text\}'")
    c.err(type_args, c.scratch.slice())

priv fn callee_name(left: Ast_node$@): U8[] //< the name a generic call's callee is written by
    return (left.get_postfix_member().text if left.kind_id == .k_method_access
        else left.get_path_or_ident_name())

priv fn refuses_fn_name_binding(c: Sema_ctx$@, left: Ast_node$@, args_node: Ast_node$@,
    inferred: I32[]): Bool //<
        //< Rejects a type argument bound to a function's name that gives no function type
        //< A function's name gives a type parameter the function type of the one function it names
        //< (fn_value_type_id in sema/body/resolve_path.kspl). A variadic function has none, since
        //< no function type holds its `...`. So the binding is left with the mark
        //< generic_fn_value_type_id, which has no signature. An instance built on it could neither
        //< be called nor spelled in C.
    mark_id: = c.env.generic_fn_value_type_id()
    $bound: = false
    for arg in inferred
        if arg == mark_id
            bound = true
    if !bound || args_node == null
        return false
    callee: = callee_name(left)
    for arg_node in args_node.children
        if arg_node.type_id != mark_id
            continue
        c.clear_scratch().s("cannot infer the type arguments of '\{callee\}' from function '")
        arg_node.get_full_path_str_to(c.scratch)
        c.scratch.s("'")
        if arg_node.def_node != null && arg_node.def_node.has_variadic_param()
            c.scratch.s(". The function is variadic. A function type cannot contain '...'")
        else
            c.scratch.s(". The function has no declaration from which to read its type")
        c.scratch.s("\n  Hint: write the type arguments explicitly. Use ")
            .s("'typedef Op = fn(x: I32): I32' then '\{callee\}<|Op|>(…)'.")
        c.err(arg_node, c.scratch.slice())
        return true
    return false

priv fn instance_for_written_args(c: Sema_ctx$@, node: Ast_node$@,
    fn_tmpl: sema_decl_mono.Fn_instance, written: Ast_node$@, def_node: Ast_node$@):
    Ast_node$@?!Sema_error //<
        //< The instance a generic call names by its written type arguments, before its arguments
        //< None where they are to be inferred from the arguments. **Known first, they type the
        //< arguments** as any call's parameters do: `maxg<|U8|>(200, 100)` takes two `U8`s, and
        //< `Box<|P|>.make(::{ .x = 2 })` builds a `P` (an `I32` and an untyped literal before).
    if written == null
        return .none
    args: = written.build_resolved_type_args(c, def_node)!
    if args.len == 0 || !sema_decl_mono.written_generic_arity_matches(def_node, args.len)
        return .none
    prev_inst_site: = c.generics.inst_site
    c.generics.inst_site = node
    defer c.generics.inst_site = prev_inst_site
    defer $inst_name: = c.instantiate_fn(with_args(fn_tmpl, args), false)!
    inst_sym: = c.symtab.resolve(inst_name.slice()).unwrap_or(null)
    return .some(inst_sym.node) if inst_sym != null && inst_sym.node != null else .none

priv fn infer_generic_call_result(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@,
    fn_tmpl: sema_decl_mono.Fn_instance, written: Ast_node$@, is_method_access: Bool,
    def_node: Ast_node$@, args_node: Ast_node$@, cur_type_id: I32): I32!Sema_error //<
        //< Instantiates a generic call from its type arguments and returns the return type
        //< written is the `<|…|>` that names them at the call, or null where they are inferred from
        //< the arguments. It also rewrites def_node and the node's kind to the instance.
    $type_id: = cur_type_id
    $inst_args: = I32[]::{}
    if written != null
        inst_args = written.build_resolved_type_args(c, def_node)!
        // Checks the count the user wrote against the declaration, not an inferred list. The reason
        // is at check_written_generic_arity in sema/decl/mono.kspl.
        sema_decl_mono.check_written_generic_arity(c, def_node, inst_args.len, node)
    else
        inst_args = sema_body_generic_infer.inferred_type_args(c, node, callee_name(left), def_node,
            args_node, is_method_access)
        if inst_args.len == 0 || refuses_fn_name_binding(c, left, args_node, inst_args)
            return I32::sema_type_env.Builtin_type_id.unknown
    // The call position is recorded during the instantiation. So a bound violation
    // (`f<|T: some.Trait|>`) is reported here rather than on the template's line
    // (check_type_constraint in sema/decl/resolve.kspl). Instantiations nest, so it is restored.
    prev_inst_site: = c.generics.inst_site
    c.generics.inst_site = node
    defer c.generics.inst_site = prev_inst_site
    defer $inst_name: = c.instantiate_fn(with_args(fn_tmpl, inst_args), false)!

    inst_sym: = c.symtab.resolve(inst_name.slice()).unwrap_or(null)
    if inst_sym != null
        type_id = inst_sym.type_id
        node.def_node = inst_sym.node
        left.def_node = inst_sym.node
        $member_node: Ast_node$@ = null
        if left.kind_id == .k_expr_postfix || left.kind_id == .k_method_access
            member_node = left.get_postfix_member()
        if member_node != null
            member_node.def_node = inst_sym.node
        else if left.children.len > 0
            left.last_child().def_node = inst_sym.node

    check_args_against_instance(c, args_node, inst_sym.node if inst_sym != null else null,
        is_method_access)

    permanent_id: = c.env.get_or_add(inst_name.slice())
    if left.is_path_or_ident()
        left.type_id = permanent_id
        left.set_kind(.k_generic_path)
    else if left.kind_id == .k_method_access
        m_node: = left.get_postfix_member()
        if m_node != null
            m_node.type_id = permanent_id
            m_node.set_kind(.k_generic_method)
    return type_id
fn resolves_to_named_fn(left: Ast_node$@): Bool //<
    //< Whether the path expression resolved to a named function's declaration
    //< A method_access uses the member's. This one test serves both a call target
    //< (`is_indirect_fn_ptr_call` below) and an unannotated binding (`sema/body/stmt.kspl`).
    //< Caution: **A call's result is a value, whatever function made it.** The call node carries
    //< its callee's declaration, so `pick()(21)` would read as a call of `pick`.
    if left == null
        return false
    if left.kind_id == .k_expr_postfix && left.get_postfix_op().is_literal("(")
        return false
    $def: = left.def_node
    if left.kind_id == .k_method_access
        m: = left.get_postfix_member()
        if m != null && m.def_node != null
            def = m.def_node
    if def == null
        return false
    return def.kind_id == .k_decl_fn || def.kind_id == .k_decl_fn_proto

priv fn is_indirect_fn_ptr_call(c: Sema_ctx$@, left: Ast_node$@, target_id: I32): Bool //<
    //< Whether this call is an indirect call through a function pointer **value**
    //< Caution: **Do not decide by the target's type alone.** A named function's symbol holds **the
    //< return type** in type_id (resolve_ret_type_or_void in collect_fn_def). So `fn cb(): Cb` (Cb
    //< a function pointer alias) looks like a function pointer. `cb()` would be typed as Cb's
    //< return value, and an unannotated binding would emit invalid C with no KSPL diagnostic.
    return c.env.is_fn_ptr(target_id) && !resolves_to_named_fn(left)

priv fn holds_call_method(c: Sema_ctx$@, type_id: I32): Bool //<
    //< Whether a value of that type is called through a `call` method (a `Callable1`)
    //< A trait's methods live on the trait, not in the type table, so both are checked.
    base: = c.env.receiver_base_id(type_id)
    switch c.env.get_info(base)
    case .trait_type(trait_def)
        for m in trait_def.methods_list
            if m.name.equals("call")
                return true
    default {}
    c.ensure_instance_methods(base) catch {}
    entry: = c.env.id_to_type.get(c.env.get_real_type(base))
    if entry == null
        return false
    if _found: = entry.get_method("call")
        return true
    return false

priv fn report_field_called(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, field_id: I32) //<
    //< Reports a field written with `()` as though it were a method (`args.len()`)
    //< The advice is to drop the `()`, except for **a field holding a `Callable1`** (called through
    //< its `call`) and a pointer to a function pointer (dereferenced first).
    member: = left.get_postfix_member().text
    owner_id: = c.env.receiver_base_id(left.get_postfix_receiver().type_id)
    owner: = c.env.display(owner_id)
    held: = c.env.display(field_id)
    c.clear_scratch()
        .s("cannot call '\{member\}'. It is a field of '\{owner\}' with type '\{held\}', not a \
            method.")
    if holds_call_method(c, field_id)
        c.scratch.s(" Call the field's value through 'call': '.\{member\}.call(...)'")
    else if c.env.is_fn_ptr(c.env.strip_ptr(field_id))
        c.scratch.s(" Dereference it first: '.\{member\}$(...)'")
    else
        c.scratch.s(" Read it without the '()': '.\{member\}'")
    c.err(node, c.scratch.slice())

fn infer(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, target_id: I32, expected_id: I32):
    I32!Sema_error
    if left.kind_id == .k_enum_init
        return infer_enum_init_call(c, node, left)!

    is_method_access: = left.kind_id == .k_method_access
    is_fn_ptr: = is_indirect_fn_ptr_call(c, left, target_id)
    // A field called as a method (`args.len()`): past here, its pieces are joined into a name no
    // function has. It is then reported as an undefined 'a...len'.
    if !is_method_access && !is_fn_ptr && left.kind_id == .k_expr_postfix &&
        left.get_postfix_op().is_literal(".") && !sema_type_env.is_unknown(target_id)
        report_field_called(c, node, left, target_id)
        return I32::sema_type_env.Builtin_type_id.unknown
    // The name looked up, without any `<|…|>`, and the type arguments written for the function.
    parts: = sema_decl_name.named_fn(left)
    defer $base_fn_name: = Str_builder()
    $written: Ast_node$@ = null
    // What the callee's name names, read once (read_written_name in sema/decl/name.kspl).
    $named: = sema_decl_name.Written_name::{ .parts = parts, .spelled = "", .fqn = "",
        .head_file = "", .sym = null, .template = null,
        .fn_tmpl = sema_decl_mono.Fn_instance::{ .template = "", .owner = 0,
        .args = I32[]::{} }, .owner_id = 0, .reach = .nowhere }
    if is_method_access
        clean_type: = c.env.base_type_name(left.get_postfix_receiver().type_id)
        base_fn_name.s(clean_type).s(".").s(parts.name.text)
        written = parts.own
    else if !is_fn_ptr
        if left.is_callable_target()
            named = c.read_written_name(left)
            base_fn_name.s(named.spelled)
        else
            for i in Range.asc(left.children.len)
                if i > 0
                    base_fn_name.c('.')
                base_fn_name.s(left.get_child(i).text)
        written = parts.own if parts.own != null else parts.on_type

    lookup_name: = base_fn_name.slice()
    if !is_fn_ptr && !is_method_access
        intr_id: = check_and_infer_intrinsic(c, node, left, lookup_name) catch -1
        if intr_id != -1
            return intr_id

    $sym: Sema_symbol$@ = null
    fqn_lookup: = named.fqn if named.fqn.len > 0 else lookup_name
    is_through_type: = named.reach == .through_type
    // **A generic method reached through its type** (`Plain.gen(1)`, `Holder<|I32|>.gm<|U8|>(1)`)
    // is that type's, as a call through a value is the receiver's. The type's own `<|…|>` already
    // chose the instance (sema/body/dot.kspl records it on the owner). So only the method's are
    // written here, or inferred from the arguments. Any other method reached through an instance is
    // that instance's (instance_method in sema/decl/name.kspl).
    if is_through_type
        written = parts.own
    // What a generic call instantiates: the template and, for a method, the instance it is
    // reached through.
    $fn_tmpl: = named.fn_tmpl
    of_instance: = named.sym if is_through_type else null

    if !is_fn_ptr
        sym = callee_symbol(left, named.sym, is_method_access).unwrap_or(null)

    // Only the template table answers for a generic.
    // Caution: **Do not take "the resolved declaration has no `sym_ptr`" as a template's sign.** A
    // declaration whose `sym_ptr` was never set, such as a trait's prototype, would go to
    // monomorphization. The output would then call a slot that is not in the vtable.
    $generic_fn_ptr: Ast_node$@ = named.template if named.reach != .instance_type else null
    through_type: = generic_fn_ptr if is_through_type else null
    // **An instantiated receiver arrives as a mangled name.** The template of a method with its own
    // type arguments (`Holder<|T|>.to<|U|>`) is registered under the base's FQN. So it is looked up
    // there (lookup_method_template in sema/decl/mono_name.kspl); otherwise the rejection of stray
    // type arguments below fires.
    if generic_fn_ptr == null && is_method_access
        found_tmpl: = sema_decl_mono_name.lookup_method_template(c,
            c.env.receiver_base_id(left.get_postfix_receiver().type_id), parts.name.text)
        if tmpl: = found_tmpl
            generic_fn_ptr = tmpl.node
            fn_tmpl.template = tmpl.fqn
            fn_tmpl.owner = tmpl.owner
    // A template always takes the instantiation route.
    if generic_fn_ptr != null
        sym = null

    if sym != null
        sym.flags.is_used = true
        node.def_node = sym.node
        left.def_node = sym.node
        if left.children.len > 0
            left.last_child().def_node = sym.node
        // An instance's method is checked for visibility as a newly resolved name is; any other
        // name was checked where its path was inferred.
        if of_instance != null
            c.check_visibility_and_mark_used(sym, left)
        if named.reach == .by_fqn
            c.report_name_by_fqn(node, named)
    else if generic_fn_ptr == null && !is_fn_ptr && !is_method_access
        report_unresolved_callee(c, node, left, parts, fqn_lookup)

    stray_type_args: =
        refuses_stray_type_args(c, parts, base_fn_name.slice(), generic_fn_ptr != null,
        through_type != null, sym, is_method_access)
    if stray_type_args
        throw .analysis_failed
    is_generic_call: = generic_fn_ptr != null
    if is_generic_call && named.reach == .by_fqn
        c.report_name_by_fqn(node, named)

    // A call of something that cannot be called is caught here. A named function's symbol holds
    // **the return type** in type_id, so `type_id = target_id` below is right for it. For a plain
    // variable, it would emit `I32 y = x(1);` with no diagnostic and a raw C error.
    if !is_fn_ptr && !is_method_access && refuses_value_called(c, node, sym, target_id)
        return I32::sema_type_env.Builtin_type_id.unknown

    op_text: = node.text
    args_node: = node.get_postfix_member()
    // A call through a value reads the signature off the value's type, whatever declared it (a
    // local, a field of a generic, another call's result).
    if is_fn_ptr
        return infer_value_call(c, node, target_id, args_node)!

    $type_id: = I32::sema_type_env.Builtin_type_id.unknown
    // An instance's method was left untyped by its path (infer_namespace_access in dot.kspl). Its
    // symbol holds its return type, as a named function's does.
    if of_instance != null
        type_id = of_instance.type_id
    else if !sema_type_env.is_unknown(target_id)
        type_id = target_id
    else if !sema_type_env.is_unknown(expected_id)
        type_id = expected_id

    if args_node != null
        // The steps below take a declaration that may be missing as a null.
        def_node: = callee_decl(left, sym, generic_fn_ptr, is_method_access).unwrap_or(null)
        if is_method_access && def_node != null
            check_method_receiver_lvalue(c, left, def_node)

        inst_node: =
            (instance_for_written_args(c, node, fn_tmpl, written, def_node)! if is_generic_call
            else Option<|Ast_node$@|>.none)
        arg_def: = inst_node.unwrap_or(def_node)
        args_generic: = is_generic_call && inst_node.is_none()
        infer_call_args(c, args_node, arg_def, is_method_access, op_text, args_generic)!

        if is_generic_call
            type_id =
                infer_generic_call_result(c, node, left, fn_tmpl, written, is_method_access,
                def_node, args_node, type_id)!
    return type_id

priv fn callee_symbol(left: Ast_node$@, named_sym: Sema_symbol$@, is_method_access: Bool):
    Sema_symbol$@? //<
        //< The symbol a call names: a method's through its access, else the name's
    if is_method_access
        m_node: = left.get_postfix_member()
        if m_node != null && m_node.def_node != null && m_node.def_node.sym_ptr != null
            return .some(Sema_symbol$@::m_node.def_node.sym_ptr)
        return .none
    if named_sym == null && !left.is_callable_target() && left.def_node != null &&
        left.def_node.sym_ptr != null
        return .some(Sema_symbol$@::left.def_node.sym_ptr)
    return .some(named_sym) if named_sym != null else .none

priv fn report_unresolved_callee(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@,
    parts: sema_decl_name.Named_fn, fqn_lookup: U8[]) //<
        //< Reports a called name that names no function
        //< **Report a callee once**: where resolving its name already reported it, a second report
        //< is the same mistake counted twice. So is an instance whose type arguments were refused
        //< having no methods (check_type_constraint reports it at the type's use).
    if fqn_lookup.find_str("<|").is_some() || c.undefined_reported_at(left) ||
        owner_was_refused(c, parts)
        return
    head: = left.get_child(0).text if left.children.len > 0 else left.text
    if reach: = c.alias_reaching(head)
        c.report_without_alias(node, head, reach.path)
    else
        c.report_undefined_symbol(node, fqn_lookup)

priv fn refuses_stray_type_args(c: Sema_ctx$@, parts: sema_decl_name.Named_fn, fn_name: U8[],
    is_template: Bool, is_through_template: Bool, sym: Sema_symbol$@, is_method_access: Bool): Bool //<
        //< Whether it reported type arguments written where nothing binds them
        //< Caution: **Reject a type argument with nothing to bind to.** The type arguments of a
        //< generic type's method are **fixed by the receiver's instance**, so ones written at the
        //< call bind nothing. A method declaring **its own** (`fn m<|T|>(…)`) is a template and
        //< passes here.
    if parts.own == null
        return false
    if !is_template && is_method_access
        c.err(parts.own,
            "type arguments cannot be written here. This method's type parameters come from its \
                'impl'. The receiver's type already fixes them. Write the arguments on the type, as \
                in 'Plain<|I32|>'. Remove the '<|...|>' after the method name")
        return true
    if is_method_access
        return false
    // Both a type's and the function's own, on a function that declares none of its own
    // (`List<|I32|>.new<|U8|>`). The type's chose the instance, and the second binds nothing.
    if (!is_template && sym != null && sym.kind.is_function()) ||
        (!is_through_template && parts.on_type != null)
        refuse_type_args_on_plain_fn(c, fn_name, parts.own)
        return true
    return false

priv fn refuses_value_called(c: Sema_ctx$@, node: Ast_node$@, sym: Sema_symbol$@, target_id: I32):
    Bool //<
        //< Whether it reported a call of a value that is no function
        //< A named function's symbol holds **the return type** in type_id, so the call's type is
        //< right for it. For a plain variable, it would emit `I32 y = x(1);` with no diagnostic and
        //< a raw C error.
    if sym == null || !sym.kind.is_var_or_const() || sema_type_env.is_unknown(target_id)
        return false
    shown: = c.env.display(target_id)
    c.clear_scratch()
        .s("cannot call '\{sym.name\}'. It is a value of type '\{shown\}', not a function")
    // A pointer to a function pointer becomes callable once dereferenced, so say how.
    if c.env.is_fn_ptr(c.env.strip_ptr(target_id))
        c.scratch.s(". Dereference it first: '\{sym.name\}$(...)'")
    c.err(node, c.scratch.slice())
    return true

priv fn callee_decl(left: Ast_node$@, sym: Sema_symbol$@, template: Ast_node$@,
    is_method_access: Bool): Ast_node$@? //<
        //< The declaration whose parameters a call's arguments are checked against, or none
    $decl: = left.def_node
    if is_method_access
        m_node: = left.get_postfix_member()
        decl = m_node.def_node if m_node != null else null
    else if sym != null
        decl = sym.node
    else if template != null
        decl = template
    return .some(decl) if decl != null else .none

priv fn infer_value_call(c: Sema_ctx$@, node: Ast_node$@, callee_id: I32, args_node: Ast_node$@):
    I32!Sema_error //<
        //< Infers a call through a function value: its arguments by the value's type, its result
        //< It is rejected where the type has no signature. The marker type of a bare function name
        //< in a generic call (generic_fn_value_type_id) says only "a function".
    switch c.env.fn_sig_of(callee_id)
    case .some(sig)
        infer_value_call_args(c, node, args_node, sig)!
        return sig.ret_id
    case .none
        c.err(node,
            "cannot call this value. Its function type has no signature. Define a signature with \
                'typedef Op = fn(x: I32): I32'. Then use it in 'f: Op = …'")
        return I32::sema_type_env.Builtin_type_id.unknown

enum Intrinsic //< a call the compiler builds in: `__kspl_<name>(…)`, declared nowhere
    not_intrinsic //< any other name
    read_volatile //< `__kspl_read_volatile(p)`: a volatile load through p
    write_volatile //< `__kspl_write_volatile(p, v)`: a volatile store of v through p
    asm_volatile //< `__kspl_asm_volatile("…", …)`: inline assembly

fn intrinsic_of(name: U8[]): Intrinsic //< the intrinsic a callee's name calls
    //< **Sema and both backends tell an intrinsic by this alone.**
    if name.equals("__kspl_read_volatile")
        return .read_volatile
    if name.equals("__kspl_write_volatile")
        return .write_volatile
    if name.equals("__kspl_asm_volatile")
        return .asm_volatile
    return .not_intrinsic

priv fn finish_intrinsic(node: Ast_node$@, left: Ast_node$@, id: I32): I32 //<
    //< The shared tail of intrinsic resolution
    //< It sets the type on node and left, turns left into an identifier, and returns id.
    node.type_id = id
    left.type_id = id
    left.set_kind(.k_identifier)
    return id

priv fn check_asm_args(c: Sema_ctx$@, args_node: Ast_node$@, is_llvm: Bool): Void!Sema_error //<
    //< `__kspl_asm_volatile`'s arguments: a template string first, operands only on the C target
    first_arg: = args_node.get_child(0)
    if first_arg.kind_id != .k_string
        c.err(first_arg, "__kspl_asm_volatile requires a string literal as the first argument")
    for ch in args_node.children
        if ch.is_literal(",")
            continue
        ch.infer_expr(c, 0)!
        // LLVM cannot convert C's constrained operands mechanically.
        if is_llvm && ch.kind_id != .k_string
            c.err(ch,
                "__kspl_asm_volatile operands are only supported on the C target. Compile with \
                    --to=c, or write assembly without operands for LLVM")

priv fn check_and_infer_intrinsic(c: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@,
    lookup_name: U8[]): I32!Sema_error
    intr: = intrinsic_of(lookup_name)
    if intr == .not_intrinsic
        return -1

    args_node: = node.get_postfix_member()
    void_id: = I32::sema_type_env.Builtin_type_id.void_type

    is_llvm: = base_core.is_llvm_target()

    if intr == .asm_volatile
        if args_node != null && args_node.children.len > 0
            check_asm_args(c, args_node, is_llvm)!
        else
            c.err(node, "__kspl_asm_volatile requires at least one string argument")
        return finish_intrinsic(node, left, void_id)

    arg1: = args_node.get_arg_at(0).unwrap_or(null)
    arg2: = args_node.get_arg_at(1).unwrap_or(null)

    if intr == .read_volatile
        if arg1 != null
            arg0_id: = arg1.infer_expr(c, 0)!
            if !c.env.is_pointer(arg0_id)
                c.err(arg1, "__kspl_read_volatile requires a pointer type")
            val_id: = c.env.strip_ptr(arg0_id)
            return finish_intrinsic(node, left, val_id)
    else
        if arg1 != null && arg2 != null
            arg0_id: = arg1.infer_expr(c, 0)!
            if !c.env.is_pointer(arg0_id)
                c.err(arg1, "__kspl_write_volatile requires a pointer type for the first argument")
            val_id: = c.env.strip_ptr(arg0_id)
            arg2.infer_expr(c, val_id)!
            return finish_intrinsic(node, left, void_id)
    return -1

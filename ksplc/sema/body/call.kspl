//< Infers a call `f(…)`: the callee its name names, a generic's instance, and the result's type
//< It covers a function or method by name, an enum variant with a payload, and a call through a
//< function value. It also covers the intrinsics the compiler builds in (`__kspl_<name>`).
//< `call_args.kspl` matches the arguments against the parameters. `generic_infer.kspl` reads a
//< generic's type arguments off them. **`intrinsic_of` is the one test for an intrinsic**, which
//< Sema and both backends ask.
import "ksplc/base/ast" { Ast_node, is_anon_env_type }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell"
import "ksplc/base/core" as base_core
import "ksplc/sema/body/call_args" { check_args_against_instance, infer_call_args,
    infer_value_call_args }
import "ksplc/sema/body/expr" as sema_body_expr
import "ksplc/sema/body/generic_infer" as sema_body_generic_infer
import "ksplc/sema/body/lint_unchecked" as sema_body_lint_unchecked
import "ksplc/sema/body/postfix" as sema_body_postfix
import "ksplc/sema/body/stmt_escape" as sema_body_stmt_escape
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/mono" as sema_decl_mono
import "ksplc/sema/decl/mono_name" as sema_decl_mono_name
import "ksplc/sema/decl/mono_queue" as sema_decl_mono_queue
import "ksplc/sema/decl/name" as sema_decl_name
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/session/ctx" as _sema_session_ctx + { Sema_ctx, Sema_error, Spawn_arg }
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/chars"
import "std/ds"
import "std/str" { Str }

fn check_variant_call_arity(ctx: Sema_ctx$@, node: Ast_node$@, args_node: Ast_node$@,
    variant_def: sema_type_def.Enum_variant@, has_call_syntax: Bool) //<
        //< Checks the argument count of a call to an enum variant, `()` on a payload-free one too
        //< `Enum.variant(...)`, `.variant(...)` and a bare `.variant` / `Enum.variant` all use it.
    if variant_def == null
        return
    expected_args: = I32::variant_def.payload_fields.len
    if expected_args == 0
        if has_call_syntax
            ctx.clear_scratch()
                .s("enum variant '\{variant_def.name\}' has no payload and cannot be called with \
                    '()'. Use '.\{variant_def.name\}' without parentheses")
            ctx.err(node, ctx.scratch.slice())
        return
    $actual_args: I32 = 0
    if args_node != null
        for arg_node in args_node.children
            if !arg_node.is_literal(",")
                actual_args += 1
    if actual_args != expected_args
        ctx.clear_scratch()
            .s("argument count mismatch for enum variant '\{variant_def.name\}'. Expected \
                \{expected_args\}, but got \{actual_args\}")
        if args_node != null
            ctx.err(args_node, ctx.scratch.slice())
        else
            ctx.err(node, ctx.scratch.slice())
priv fn infer_enum_init_call(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@): I32!Sema_error //<
    //< Infers a call that builds an enum variant with a payload (for example Shape.circle(7))
    node.set_kind(.k_enum_init_call)
    type_id: = left.type_id
    node.type_id = type_id

    $variant_name: U8[] = ""
    for $ci: I32 = (I32::left.children.len) - 1; ci >= 0; ci -= 1
        v_node: = left.get_child(ci)
        if v_node.kind_id == .k_identifier
            variant_name = v_node.text
            break
    // An alias's variant (`Form.circle(3)`) is typed by the alias; its payload is the enum's.
    enum_name: = ctx.env.get_str(ctx.env.get_real_type(type_id))
    $variant_def: sema_type_def.Enum_variant$@ = null
    if enum_def: = ctx.env.get_enum_def(enum_name)
        switch enum_def.get_variant(variant_name)
        case .some(d)
            variant_def = d
        case .none {}

    $args_node: Ast_node$@ = null
    if node.children.len > 2 && node.get_child(2).kind_id == .k_expr_args
        args_node = node.get_child(2)

    check_variant_call_arity(ctx, node, args_node, variant_def, true)

    if args_node != null
        args_node.infer_enum_payload_args(ctx, variant_def)!
    return type_id

priv fn check_method_receiver_lvalue(ctx: Sema_ctx$@, left: Ast_node$@, def_node: Ast_node$@) //<
    //< Checks that the receiver is an lvalue where the method demands `@`; an rvalue is an error
    recv_node: = left.get_postfix_receiver()
    ctx.refuse_writing_receiver(recv_node, def_node, "")

priv fn owner_was_refused(ctx: Sema_ctx$@, parts: sema_decl_name.Named_fn): Bool //<
    //< Whether the callee is reached through an instance whose type arguments were refused
    if parts.owner == null || parts.owner.type_id <= 0
        return false
    return ctx.has_failed_constraint(ctx.env.base_type_name(parts.owner.type_id))

priv fn with_args(fn_tmpl: sema_decl_mono.Fn_instance, args: I32[]): sema_decl_mono.Fn_instance //<
    //< The instance of fn_tmpl's template binding args
    return sema_decl_mono.Fn_instance::{ .template = fn_tmpl.template, .owner = fn_tmpl.owner,
        .args = args }

fn instance_of_written_args(ctx: Sema_ctx$@, node: Ast_node$@,
    fn_tmpl: sema_decl_mono.Fn_instance, args: I32[]): Sema_symbol$@?!Sema_error //<
        //< The symbol of the instance that the type arguments written at node bind, made once
        //< As at a call, a bound violation is reported at node's line, not the template's.
    prev_inst_site: = ctx.generics.inst_site
    ctx.generics.inst_site = node
    defer ctx.generics.inst_site = prev_inst_site
    defer $inst_name: = ctx.instantiate_fn(with_args(fn_tmpl, args), false)!
    return ctx.symtab.resolve(inst_name.slice())

fn refuse_type_args_on_plain_fn(ctx: Sema_ctx$@, fn_name: U8[], type_args: Ast_node$@) //<
    //< Reports type arguments written after a function that declares none
    //< They would bind nothing and change nothing (Principle 5), called or named as a value.
    ctx.clear_scratch()
        .s("function '\{fn_name\}' is not generic. Remove the type arguments '\{type_args.text\}'")
    ctx.err(type_args, ctx.scratch.slice())

priv fn callee_name(left: Ast_node$@): U8[] //< the name a generic call's callee is written by
    return (left.get_postfix_member().text if left.kind_id == .k_method_access
        else left.get_path_or_ident_name())

priv fn refuses_fn_name_binding(ctx: Sema_ctx$@, left: Ast_node$@, args_node: Ast_node@,
    inferred: I32[]): Bool //<
        //< Rejects a type argument bound to a function's name that gives no function type
        //< A function's name gives a type parameter the function type of the one function it names
        //< (fn_value_type_id in sema/body/resolve_path.kspl). A variadic function has none, since
        //< no function type holds its `...`. So the binding is left with the mark
        //< generic_fn_value_type_id, which has no signature. An instance built on it could neither
        //< be called nor spelled in C.
    mark_id: = ctx.env.generic_fn_value_type_id()
    $bound: = false
    for arg in inferred
        if arg == mark_id
            bound = true
    if !bound || args_node == null
        return false
    callee: = callee_name(left)
    for arg_node in args_node.children
        if arg_node.type_id != mark_id
            continue
        ctx.clear_scratch().s("cannot infer the type arguments of '\{callee\}' from function '")
        arg_node.get_full_path_str_to(ctx.scratch)
        ctx.scratch.s("'")
        if arg_node.def_node != null && arg_node.def_node.has_variadic_param()
            ctx.scratch.s(". The function is variadic. A function type cannot contain '...'")
        else
            ctx.scratch.s(". The function has no declaration from which to read its type")
        ctx.scratch.s("\n  Hint: write the type arguments explicitly. Use ")
            .s("'typedef Op = fn(x: I32): I32' then '\{callee\}<|Op|>(…)'.")
        ctx.err(arg_node, ctx.scratch.slice())
        return true
    return false

priv const SPAWN_FQN: U8[] = "std.thread.Thread.spawn" //< starts a thread, handing it `arg: T$@`

priv fn refuses_spawn_arg(ctx: Sema_ctx$@, node: Ast_node$@, fn_tmpl: sema_decl_mono.Fn_instance,
    inst_args: I32[]): Bool //<
        //< Rejects `Thread.spawn<|T|>` where T reaches an `Rc` or a `Weak_rc`
        //< A global of such a type is refused at its declaration, by the same check
        //< (`refuses_one_thread_count` in sema/decl/access.kspl, which says what still passes).
        //< **A T that passes now is checked again once every body is** (`spawn_args`): it may
        //< reach a trait value, and a conversion to that trait can come in a later body.
    if !fn_tmpl.template.equals(SPAWN_FQN) || inst_args.len != 1
        return false
    if ctx.refuses_one_thread_count(inst_args[0], .spawn_arg, node)
        return true
    ctx.spawn_args.push(Spawn_arg::{ .type_id = inst_args[0], .site = node })
    return false

priv fn instance_for_written_args(ctx: Sema_ctx$@, node: Ast_node$@,
    fn_tmpl: sema_decl_mono.Fn_instance, written: Ast_node$@, def_node: Ast_node$@):
    Ast_node$@?!Sema_error //<
        //< The instance a generic call names by its written type arguments, before its arguments
        //< None where they are to be inferred from the arguments. **Known first, they type the
        //< arguments** as any call's parameters do: `maxg<|U8|>(200, 100)` takes two `U8`s, and
        //< `Box<|P|>.make(::{ .x = 2 })` builds a `P` (an `I32` and an untyped literal before).
    if written == null
        return .none
    args: = written.build_resolved_type_args(ctx, def_node)!
    if args.len == 0 || !sema_decl_mono.written_generic_arity_matches(def_node, args.len)
        return .none
    inst_sym: = instance_of_written_args(ctx, node, fn_tmpl, args)!.unwrap_or(null)
    return .some(inst_sym.node) if inst_sym != null && inst_sym.node != null else .none

priv fn infer_generic_call_result(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@,
    fn_tmpl: sema_decl_mono.Fn_instance, written: Ast_node@, is_method_access: Bool,
    def_node: Ast_node$@, args_node: Ast_node$@, cur_type_id: I32): I32!Sema_error //<
        //< Instantiates a generic call from its type arguments and returns the return type
        //< written is the `<|…|>` that names them at the call, or null where they are inferred from
        //< the arguments. It also rewrites def_node and the node's kind to the instance.
    $type_id: = cur_type_id
    $inst_args: = I32[]::{}
    if written != null
        inst_args = written.build_resolved_type_args(ctx, def_node)!
        // Checks the count the user wrote against the declaration, not an inferred list. The reason
        // is at check_written_generic_arity in sema/decl/mono.kspl.
        sema_decl_mono.check_written_generic_arity(ctx, def_node, inst_args.len, node)
    else
        inst_args = sema_body_generic_infer.inferred_type_args(ctx, node, callee_name(left),
            def_node, args_node, is_method_access)
        if inst_args.len == 0 || refuses_fn_name_binding(ctx, left, args_node, inst_args)
            return I32::sema_type_env.Builtin_type_id.unknown
    if refuses_spawn_arg(ctx, node, fn_tmpl, inst_args)
        return I32::sema_type_env.Builtin_type_id.unknown
    // The call position is recorded during the instantiation. So a bound violation
    // (`f<|T: some.Trait|>`) is reported here rather than on the template's line
    // (check_type_constraint in sema/decl/resolve.kspl). Instantiations nest, so it is restored.
    prev_inst_site: = ctx.generics.inst_site
    ctx.generics.inst_site = node
    defer ctx.generics.inst_site = prev_inst_site
    defer $inst_name: = ctx.instantiate_fn(with_args(fn_tmpl, inst_args), false)!

    inst_sym: = ctx.symtab.resolve(inst_name.slice()).unwrap_or(null)
    if inst_sym != null
        type_id = inst_sym.type_id
        node.def_node = inst_sym.node
        left.def_node = inst_sym.node
        $member_node: Ast_node$@ = null
        if left.kind_id == .k_expr_postfix || left.kind_id == .k_method_access
            member_node = left.get_postfix_member()
        if member_node != null
            member_node.def_node = inst_sym.node
        else if left.children.len > 0
            left.last_child().def_node = inst_sym.node

    check_args_against_instance(ctx, args_node, inst_sym.node if inst_sym != null else null,
        is_method_access)

    permanent_id: = ctx.env.get_or_add(inst_name.slice())
    if left.is_path_or_ident()
        left.type_id = permanent_id
        left.set_kind(.k_generic_path)
    else if left.kind_id == .k_method_access
        m_node: = left.get_postfix_member()
        if m_node != null
            m_node.type_id = permanent_id
            m_node.set_kind(.k_generic_method)
    return type_id
fn resolves_to_named_fn(left: Ast_node$@): Bool //<
    //< Whether the path expression resolved to a named function's declaration
    //< A method_access uses the member's. This one test serves both a call target
    //< (`is_indirect_fn_ptr_call` below) and an unannotated binding (`sema/body/stmt.kspl`).
    //< Caution: **A call's result is a value, whatever function made it.** The call node carries
    //< its callee's declaration, so `pick()(21)` would read as a call of `pick`.
    if left == null
        return false
    if left.kind_id == .k_expr_postfix && left.get_postfix_op().is_literal("(")
        return false
    $def: = left.def_node
    if left.kind_id == .k_method_access
        m: = left.get_postfix_member()
        if m != null && m.def_node != null
            def = m.def_node
    if def == null
        return false
    return def.kind_id == .k_decl_fn || def.kind_id == .k_decl_fn_proto

priv fn is_indirect_fn_ptr_call(ctx: Sema_ctx$@, left: Ast_node$@, target_id: I32): Bool //<
    //< Whether this call is an indirect call through a function pointer **value**
    //< Caution: **Do not decide by the target's type alone.** A named function's symbol holds **the
    //< return type** in type_id (resolve_ret_type_or_void in collect_fn_def). So `fn cb(): Cb` (Cb
    //< a function pointer alias) looks like a function pointer. `cb()` would be typed as Cb's
    //< return value, and an unannotated binding would emit invalid C with no KSPL diagnostic.
    return ctx.env.is_fn_ptr(target_id) && !resolves_to_named_fn(left)

priv fn holds_call_method(ctx: Sema_ctx$@, type_id: I32): Bool //<
    //< Whether a value of that type is called through a `call` method (a `Callable1`)
    //< A trait's methods live on the trait, not in the type table, so both are checked.
    base: = ctx.env.receiver_base_id(type_id)
    switch ctx.env.get_info(base)
    case .trait_type(trait_def)
        for m in trait_def.methods_list
            if m.name.equals("call")
                return true
    default {}
    ctx.ensure_instance_methods(base) catch {}
    entry: = ctx.env.id_to_type.get(ctx.env.get_real_type(base))
    if entry == null
        return false
    if _found: = entry.get_method("call")
        return true
    return false

priv fn report_field_called(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, field_id: I32) //<
    //< Reports a field written with `()` as though it were a method (`args.len()`)
    //< The advice is to drop the `()`, except for **a field holding a `Callable1`** (called through
    //< its `call`) and a pointer to a function pointer (dereferenced first).
    member: = left.get_postfix_member().text
    owner_id: = ctx.env.receiver_base_id(left.get_postfix_receiver().type_id)
    owner: = ctx.env.display(owner_id)
    held: = ctx.env.display(field_id)
    ctx.clear_scratch()
        .s("cannot call '\{member\}'. It is a field of '\{owner\}' with type '\{held\}', not a \
            method.")
    if holds_call_method(ctx, field_id)
        ctx.scratch.s(" Call the field's value through 'call': '.\{member\}.call(...)'")
    else if ctx.env.is_fn_ptr(ctx.env.strip_ptr(field_id))
        ctx.scratch.s(" Dereference it first: '.\{member\}$(...)'")
    else
        ctx.scratch.s(" Read it without the '()': '.\{member\}'")
    ctx.err(node, ctx.scratch.slice())

priv fn report_value_called(ctx: Sema_ctx$@, node: Ast_node$@, value_id: I32) //<
    //< Reports `(...)` after a value that is not a function (`twice(1)(5)`, `arr[0](1)`)
    //< Only a name, a method or a value of a function type is called. Let through, the call
    //< takes the callee of the expression before it, and the backends emit code that does not
    //< build. An unknown type was reported where it failed.
    if sema_type_env.is_unknown(value_id)
        return
    shown: = ctx.env.display(value_id)
    ctx.clear_scratch()
        .s("cannot call this value. It is a value of type '\{shown\}', not a function")
    if holds_call_method(ctx, value_id)
        ctx.scratch.s(". Call it through its 'call' method: '(...).call(...)'")
    ctx.err(node, ctx.scratch.slice())

fn infer(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, target_id: I32, expected_id: I32):
    I32!Sema_error //<
        //< A call's type, reached by what is called: an enum variant, a function pointer value, a
        //< method, or a function named by its path
        //< **Each kind of callee has its own function**, which resolves it into a `Callee`. The
        //< arguments are then checked once for every kind (`infer_call_args_of`).
    if left.kind_id == .k_enum_init
        return infer_enum_init_call(ctx, node, left)!
    if is_indirect_fn_ptr_call(ctx, left, target_id)
        return infer_fn_ptr_call(ctx, node, left, target_id)!
    if left.kind_id == .k_method_access
        return infer_method_call(ctx, node, left, target_id, expected_id)!
    return infer_named_call(ctx, node, left, target_id, expected_id)!

struct Callee //< what a called function resolved to, for checking the call's arguments
    sym: Sema_symbol$@ //< the function's symbol; null for a template, and where nothing resolved
    template: Ast_node$@ //< the generic function's or method's template; null for any other
    fn_tmpl: sema_decl_mono.Fn_instance //< the template's key, and the instance it is reached by
    written: Ast_node$@ //< the type arguments written for the function itself, or null
    of_instance: Sema_symbol$@ //< the instance's method a type reached it through, or null
    is_method: Bool //< whether it is called through a receiver

priv fn bind_callee(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, sym: Sema_symbol$@) //<
    //< Marks the symbol used and records its declaration on the call and on its name
    ctx.mark_used(sym)
    node.def_node = sym.node
    left.def_node = sym.node
    if left.children.len > 0
        left.last_child().def_node = sym.node

priv fn infer_fn_ptr_call(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, target_id: I32):
    I32!Sema_error //<
        //< A call through a function pointer value: the signature is read off the value's type
        //< whatever declared it (a local, a field of a generic, another call's result)
        //< **Type arguments written on it bind nothing**, and are refused as on any other callee.
    parts: = sema_decl_name.named_fn(left)
    is_method: = left.kind_id == .k_method_access
    defer $fn_name: = Str()
    $is_template: = false
    if is_method
        fn_name.s(ctx.env.base_type_name(left.get_postfix_receiver().type_id)).s(".")
            .s(parts.name.text)
        is_template = method_template_of(ctx, left, parts).is_some()
    if refuses_stray_type_args(ctx, parts, fn_name.slice(), is_template, false, null, is_method)
        throw .analysis_failed
    return infer_value_call(ctx, node, target_id, node.get_postfix_member())!

priv fn method_template_of(ctx: Sema_ctx$@, left: Ast_node$@, parts: sema_decl_name.Named_fn):
    sema_decl_mono_name.Method_template? //<
        //< The template of a method with its own type arguments, reached through its receiver
        //< **An instantiated receiver arrives as a mangled name.** The template of a method with
        //< its own type arguments (`Holder<|T|>.to<|U|>`) is registered under the base's FQN, so it
        //< is looked up there (lookup_method_template in sema/decl/mono_name.kspl). Otherwise the
        //< rejection of stray type arguments fires.
    return sema_decl_mono_name.lookup_method_template(ctx,
        ctx.env.receiver_base_id(left.get_postfix_receiver().type_id), parts.name.text)

priv fn infer_method_call(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, target_id: I32,
    expected_id: I32): I32!Sema_error //<
        //< A call of a method through a receiver (`list.push(x)`)
        //< **A template always takes the instantiation route**, so its symbol is dropped.
    parts: = sema_decl_name.named_fn(left)
    defer $fn_name: = Str()
    fn_name.s(ctx.env.base_type_name(left.get_postfix_receiver().type_id)).s(".")
        .s(parts.name.text)
    $callee: = Callee::{ .sym = callee_symbol(left, null, true).unwrap_or(null), .template = null,
        .fn_tmpl = sema_decl_mono.Fn_instance::{ .template = "", .owner = 0,
        .args = I32[]::{} }, .written = parts.own, .of_instance = null, .is_method = true }
    if tmpl: = method_template_of(ctx, left, parts)
        callee.template = tmpl.node
        callee.fn_tmpl.template = tmpl.fqn
        callee.fn_tmpl.owner = tmpl.owner
        callee.sym = null
    if callee.sym != null
        bind_callee(ctx, node, left, callee.sym)
    stray_type_args: =
        refuses_stray_type_args(ctx, parts, fn_name.slice(), callee.template != null, false,
        callee.sym, true)
    if stray_type_args
        throw .analysis_failed
    type_id: = expected_id if sema_type_env.is_unknown(target_id) else target_id
    return infer_call_args_of(ctx, node, left, callee, type_id)!

priv fn infer_named_call(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, target_id: I32,
    expected_id: I32): I32!Sema_error //<
        //< A call of a function named by its path: a plain or generic function, an intrinsic, or a
        //< method reached through its type (`Plain.gen(1)`)
    // A field called as a method (`args.len()`): past here, its pieces are joined into a name no
    // function has. It is then reported as an undefined 'a...len'.
    if left.kind_id == .k_expr_postfix && left.get_postfix_op().is_literal(".") &&
        !sema_type_env.is_unknown(target_id)
        report_field_called(ctx, node, left, target_id)
        return I32::sema_type_env.Builtin_type_id.unknown
    if left.kind_id == .k_expr_postfix && !left.get_postfix_op().is_literal(".")
        report_value_called(ctx, node, target_id)
        return I32::sema_type_env.Builtin_type_id.unknown
    // The name looked up, without any `<|…|>`, and the type arguments written for the function.
    parts: = sema_decl_name.named_fn(left)
    defer $base_fn_name: = Str()
    // What the callee's name names, read once (read_written_name in sema/decl/name.kspl).
    $named: = sema_decl_name.Written_name::{ .parts = parts, .spelled = "", .fqn = "",
        .head_file = "", .sym = null, .template = null,
        .fn_tmpl = sema_decl_mono.Fn_instance::{ .template = "", .owner = 0,
        .args = I32[]::{} }, .owner_id = 0, .reach = .nowhere }
    if left.is_path_or_ident()
        // In the file the name is written in: an impl's type argument stands before the `.` in a
        // copied default body (`T.make()`).
        prev_file: = ctx.enter_written_file(left)
        named = ctx.read_written_name(left)
        ctx.set_current_file(prev_file)
        base_fn_name.s(named.spelled)
    else
        for i in Range.asc(left.children.len)
            if i > 0
                base_fn_name.c('.')
            base_fn_name.s(left.get_child(i).text)

    lookup_name: = base_fn_name.slice()
    intr_id: = check_and_infer_intrinsic(ctx, node, left, lookup_name) catch -1
    if intr_id != -1
        return intr_id

    fqn_lookup: = named.fqn if named.fqn.len > 0 else lookup_name
    // **A generic method reached through its type** (`Plain.gen(1)`, `Holder<|I32|>.gm<|U8|>(1)`)
    // is that type's, as a call through a value is the receiver's. The type's own `<|…|>` already
    // chose the instance (sema/body/dot.kspl records it on the owner). So only the method's are
    // written here, or inferred from the arguments. Any other method reached through an instance is
    // that instance's (instance_method in sema/decl/name.kspl).
    is_through_type: = named.reach == .through_type
    // Only the template table answers for a generic.
    // Caution: **Do not take "the resolved declaration has no `sym_ptr`" as a template's sign.** A
    // declaration whose `sym_ptr` was never set, such as a trait's prototype, would go to
    // monomorphization. The output would then call a slot that is not in the vtable.
    $callee: = Callee::{ .sym = callee_symbol(left, named.sym, false).unwrap_or(null),
        .template = named.template if named.reach != .instance_type else null,
        .fn_tmpl = named.fn_tmpl,
        .written = (parts.own if is_through_type || parts.own != null else parts.on_type),
        .of_instance = named.sym if is_through_type else null, .is_method = false }
    // A template always takes the instantiation route.
    if callee.template != null
        callee.sym = null

    if callee.sym != null
        bind_callee(ctx, node, left, callee.sym)
        // An instance's method is checked for visibility as a newly resolved name is; any other
        // name was checked where its path was inferred.
        if callee.of_instance != null
            ctx.check_visibility_and_mark_used(callee.sym, left)
        if named.reach == .by_fqn
            ctx.report_name_by_fqn(node, named)
    else if callee.template == null
        report_unresolved_callee(ctx, node, left, parts, fqn_lookup)

    stray_type_args: =
        refuses_stray_type_args(ctx, parts, base_fn_name.slice(), callee.template != null,
        is_through_type && callee.template != null, callee.sym, false)
    if stray_type_args
        throw .analysis_failed
    if callee.template != null && named.reach == .by_fqn
        ctx.report_name_by_fqn(node, named)

    // A call of something that cannot be called is caught here. A named function's symbol holds
    // **the return type** in type_id, so `type_id = target_id` below is right for it. For a plain
    // variable, it would emit `I32 y = x(1);` with no diagnostic and a raw C error.
    if refuses_value_called(ctx, node, callee.sym, target_id)
        return I32::sema_type_env.Builtin_type_id.unknown

    $type_id: = I32::sema_type_env.Builtin_type_id.unknown
    // An instance's method was left untyped by its path (infer_namespace_access in dot.kspl). Its
    // symbol holds its return type, as a named function's does.
    if callee.of_instance != null
        type_id = callee.of_instance.type_id
    else if !sema_type_env.is_unknown(target_id)
        type_id = target_id
    else
        type_id = expected_id
    return infer_call_args_of(ctx, node, left, callee, type_id)!

priv fn infer_call_args_of(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@, callee: Callee,
    type_id: I32): I32!Sema_error //<
        //< Checks a resolved call's arguments, and gives the call's type: `type_id`, or a generic's
        //< result
    op_text: = node.text
    args_node: = node.get_postfix_member()
    if args_node == null
        return type_id
    is_generic_call: = callee.template != null
    // The steps below take a declaration that may be missing as a null.
    def_node: = callee_decl(left, callee.sym, callee.template, callee.is_method).unwrap_or(null)
    if callee.is_method && def_node != null
        check_method_receiver_lvalue(ctx, left, def_node)

    inst_node: =
        (instance_for_written_args(ctx, node, callee.fn_tmpl, callee.written, def_node)!
        if is_generic_call else Option<|Ast_node$@|>.none)
    arg_def: = inst_node.unwrap_or(def_node)
    args_generic: = is_generic_call && inst_node.is_none()
    infer_call_args(ctx, args_node, arg_def, callee.is_method, op_text, args_generic)!
    sema_body_lint_unchecked.note_call(ctx, node, callee.sym, args_node)

    // **Before the instance is made**: `put`'s body calls `fmt`, which an enum lacks.
    if !is_generic_call
        // The arguments are converted by now, so a trait value made from a local shows here.
        if callee.is_method && def_node != null
            sema_body_stmt_escape.check_frame_kept_by_call(ctx, left.get_postfix_receiver(),
                def_node, args_node)
        return type_id
    name_enum_put_value(ctx, node, left)!
    result_id: =
        infer_generic_call_result(ctx, node, left, callee.fn_tmpl, callee.written,
        callee.is_method, def_node, args_node, type_id)!
    if callee.is_method && def_node != null
        sema_body_stmt_escape.check_frame_kept_by_call(ctx, left.get_postfix_receiver(), def_node,
            args_node)
    return result_id

priv fn callee_symbol(left: Ast_node$@, named_sym: Sema_symbol$@, is_method_access: Bool):
    Sema_symbol$@? //<
        //< The symbol a call names: a method's through its access, else the name's
    if is_method_access
        m_node: = left.get_postfix_member()
        if m_node != null && m_node.def_node != null && m_node.def_node.sym_ptr != null
            return .some(Sema_symbol$@::m_node.def_node.sym_ptr)
        return .none
    if named_sym == null && !left.is_path_or_ident() && left.def_node != null &&
        left.def_node.sym_ptr != null
        return .some(Sema_symbol$@::left.def_node.sym_ptr)
    return .some(named_sym) if named_sym != null else .none

priv fn report_unresolved_callee(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@,
    parts: sema_decl_name.Named_fn, fqn_lookup: U8[]) //<
        //< Reports a called name that names no function
        //< **Report a callee once**: where resolving its name already reported it, a second report
        //< is the same mistake counted twice. So is an instance whose type arguments were refused
        //< having no methods (check_type_constraint reports it at the type's use). A name held back
        //< there as a likely repeat of an earlier error is noted too, so the rule is one.
    if fqn_lookup.find_str("<|").is_some() || ctx.undefined_reported_at(left) ||
        owner_was_refused(ctx, parts) || ctx.has_error_in_fn()
        return
    head: = left.get_child(0).text if left.children.len > 0 else left.text
    if reach: = ctx.alias_reaching(head)
        ctx.report_without_alias(node, head, reach.path)
    else
        ctx.report_undefined_symbol(node, fqn_lookup)

priv fn refuses_stray_type_args(ctx: Sema_ctx$@, parts: sema_decl_name.Named_fn, fn_name: U8[],
    is_template: Bool, is_through_template: Bool, sym: Sema_symbol$@, is_method_access: Bool): Bool //<
        //< Whether it reported type arguments written where nothing binds them
        //< Caution: **Reject a type argument with nothing to bind to.** The type arguments of a
        //< generic type's method are **fixed by the receiver's instance**, so ones written at the
        //< call bind nothing. A method declaring **its own** (`fn m<|T|>(…)`) is a template and
        //< passes here.
    if parts.own == null
        return false
    if !is_template && is_method_access
        ctx.err(parts.own,
            "type arguments cannot be written here. This method's type parameters come from its \
                'impl'. The receiver's type already fixes them. Write the arguments on the type, as \
                in 'Plain<|I32|>'. Remove the '<|...|>' after the method name")
        return true
    if is_method_access
        return false
    // Both a type's and the function's own, on a function that declares none of its own
    // (`List<|I32|>.new<|U8|>`). The type's chose the instance, and the second binds nothing.
    if (!is_template && sym != null && sym.kind.is_function()) ||
        (!is_through_template && parts.on_type != null)
        refuse_type_args_on_plain_fn(ctx, fn_name, parts.own)
        return true
    return false

priv fn refuses_value_called(ctx: Sema_ctx$@, node: Ast_node$@, sym: Sema_symbol$@, target_id: I32):
    Bool //<
        //< Whether it reported a call of a value that is no function
        //< A named function's symbol holds **the return type** in type_id, so the call's type is
        //< right for it. For a plain variable, it would emit `I32 y = x(1);` with no diagnostic and
        //< a raw C error.
    if sym == null || !sym.kind.is_var_or_const() || sema_type_env.is_unknown(target_id)
        return false
    closure: = closure_callable(ctx, target_id)
    ctx.clear_scratch().s("cannot call '\{sym.name\}'. ")
    if closure.len > 0
        ctx.scratch.s("It is a closure, which conforms to '\{closure\}', not a function")
    else
        ctx.scratch.s("It is a value of type '\{ctx.env.display(target_id)\}', not a function")
    // A pointer to a function pointer becomes callable once dereferenced, so say how.
    if ctx.env.is_fn_ptr(ctx.env.strip_ptr(target_id))
        ctx.scratch.s(". Dereference it first: '\{sym.name\}$(...)'")
    else if holds_call_method(ctx, target_id)
        ctx.scratch.s(". Call it through its 'call' method: '\{sym.name\}.call(...)'")
    ctx.err(node, ctx.scratch.slice())
    return true

priv fn closure_callable(ctx: Sema_ctx$@, type_id: I32): U8[] //<
    //< The `Callable` a closure's type conforms to, as a diagnostic shows it; "" for another type
    //< **A closure's type is the environment struct the compiler made** (`_anon_env_1`, in the
    //< module its file's path names), a name the writer never wrote. Its one trait is the
    //< `Callable` its signature spells.
    base: = ctx.env.strip_const_deep(ctx.env.strip_ptr(type_id))
    if !is_anon_env_type(ctx.env.get_str(base)) || base < 0 || base >= ctx.env.id_to_type.len
        return ""
    traits: = ctx.env.id_to_type.get(base).implemented_traits
    if traits == null || traits.len == 0
        return ""
    return ctx.env.display(traits.get(0))

priv fn callee_decl(left: Ast_node$@, sym: Sema_symbol$@, template: Ast_node$@,
    is_method_access: Bool): Ast_node$@? //<
        //< The declaration whose parameters a call's arguments are checked against, or none
    $decl: = left.def_node
    if is_method_access
        m_node: = left.get_postfix_member()
        decl = m_node.def_node if m_node != null else null
    else if sym != null
        decl = sym.node
    else if template != null
        decl = template
    return .some(decl) if decl != null else .none

priv fn infer_value_call(ctx: Sema_ctx$@, node: Ast_node$@, callee_id: I32, args_node: Ast_node$@):
    I32!Sema_error //<
        //< Infers a call through a function value: its arguments by the value's type, its result
        //< It is rejected where the type has no signature. The marker type of a bare function name
        //< in a generic call (generic_fn_value_type_id) says only "a function".
    sig: = ctx.env.fn_sig_of(callee_id) catch
        ctx.err(node,
            "cannot call this value. Its function type has no signature. Define a signature with \
                'typedef Op = fn(x: I32): I32'. Then use it in 'f: Op = …'")
        return I32::sema_type_env.Builtin_type_id.unknown
    infer_value_call_args(ctx, node, args_node, sig)!
    return sig.ret_id

enum Intrinsic //< a call the compiler builds in: `__kspl_<name>(…)`, declared nowhere
    not_intrinsic //< any other name
    read_volatile //< `__kspl_read_volatile(p)`: a volatile load through p
    write_volatile //< `__kspl_write_volatile(p, v)`: a volatile store of v through p
    asm_volatile //< `__kspl_asm_volatile("…", …)`: inline assembly

fn intrinsic_of(name: U8[]): Intrinsic //< the intrinsic a callee's name calls
    //< **Sema and both backends tell an intrinsic by this alone.**
    if name.equals("__kspl_read_volatile")
        return .read_volatile
    if name.equals("__kspl_write_volatile")
        return .write_volatile
    if name.equals("__kspl_asm_volatile")
        return .asm_volatile
    return .not_intrinsic

priv fn finish_intrinsic(node: Ast_node$@, left: Ast_node$@, id: I32): I32 //<
    //< The shared tail of intrinsic resolution
    //< It sets the type on node and left, turns left into an identifier, and returns id.
    node.type_id = id
    left.type_id = id
    left.set_kind(.k_identifier)
    return id

priv fn check_asm_args(ctx: Sema_ctx$@, args_node: Ast_node$@, is_llvm: Bool): Void!Sema_error //<
    //< `__kspl_asm_volatile`'s arguments: a template string first, operands only on the C target
    first_arg: = args_node.get_child(0)
    if first_arg.kind_id != .k_string
        ctx.err(first_arg, "__kspl_asm_volatile requires a string literal as the first argument")
    for ch in args_node.children
        if ch.is_literal(",")
            continue
        ch.infer_expr(ctx, 0)!
        // LLVM cannot convert C's constrained operands mechanically.
        if is_llvm && ch.kind_id != .k_string
            ctx.err(ch,
                "__kspl_asm_volatile operands are only supported on the C target. Compile with \
                    --to=c, or write assembly without operands for LLVM")

priv fn check_and_infer_intrinsic(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@,
    lookup_name: U8[]): I32!Sema_error
    intr: = intrinsic_of(lookup_name)
    if intr == .not_intrinsic
        return -1

    args_node: = node.get_postfix_member()
    void_id: = I32::sema_type_env.Builtin_type_id.void_type

    is_llvm: = base_core.is_llvm_target()

    if intr == .asm_volatile
        if args_node != null && args_node.children.len > 0
            check_asm_args(ctx, args_node, is_llvm)!
        else
            ctx.err(node, "__kspl_asm_volatile requires at least one string argument")
        return finish_intrinsic(node, left, void_id)

    arg1: = args_node.get_arg_at(0).unwrap_or(null)
    arg2: = args_node.get_arg_at(1).unwrap_or(null)

    if intr == .read_volatile
        if arg1 != null
            arg0_id: = arg1.infer_expr(ctx, 0)!
            if !ctx.env.is_pointer(arg0_id)
                ctx.err(arg1, "__kspl_read_volatile requires a pointer type")
            val_id: = ctx.env.strip_ptr(arg0_id)
            return finish_intrinsic(node, left, val_id)
    else
        if arg1 != null && arg2 != null
            arg0_id: = arg1.infer_expr(ctx, 0)!
            if !ctx.env.is_pointer(arg0_id)
                ctx.err(arg1, "__kspl_write_volatile requires a pointer type for the first argument")
            val_id: = ctx.env.strip_ptr(arg0_id)
            arg2.infer_expr(ctx, val_id)!
            return finish_intrinsic(node, left, void_id)
    return -1

priv fn name_enum_put_value(ctx: Sema_ctx$@, node: Ast_node$@, left: Ast_node$@): Void!Sema_error //<
    //< Makes an interpolation's `put(w, e)` on an enum write `e.variant_name()` in place of `e`
    //< A string interpolation `\{e\}` desugars into `put(w, e)`. Its arguments are typed by now, so
    //< `e` may be any expression (`\{h.c\}`, `\{arr[0]\}`, `\{Color.red\}`). No `fmt` is
    //< synthesized on an enum, since that would give every enum a `Formattable` vtable.
    //< Caution: **Do not rewrite if the user wrote `fmt`**, or their format is silently ignored.
    if left.kind_id != .k_expr_path && left.kind_id != .k_identifier
        return
    args: = node.find_child(.k_expr_args)
    if args == null || args.children.len != 2
        return
    // Caution: **Decide by the FQN the desugaring wrote** (`PUT_FQN` in `../../base/core.kspl`).
    // A user's own call to `put` that takes an enum would otherwise have its body silently
    // replaced.
    if left.kind_id == .k_expr_path && left.children.len > 1
        return
    written_name: = left.get_path_name() if left.kind_id == .k_expr_path else left.text
    if !written_name.equals(base_core.PUT_FQN)
        return
    named: = ctx.read_written_name(left)
    if named.template == null || !named.fqn.equals("std.lang.put")
        return
    value: = args.get_child(1)
    base_id: = ctx.env.get_clean_real_type(ctx.env.receiver_base_id(value.type_id))
    $is_enum: = false
    switch ctx.env.get_info(base_id)
    case .enum_type
        is_enum = true
    default {}
    if !is_enum
        return
    refuse_unopened_put(ctx, value, base_id)!
    t_entry: = ctx.env.id_to_type.get(base_id)
    if t_entry == null
        return
    // Caution: **Finish building the method table before the lookup.** A generic enum first
    // instantiated in a method's signature has its table deferred (ensure_instance_methods in
    // mono_queue.kspl). Until it is built, the synthesized `variant_name` is invisible, and correct
    // code fails with "`Formattable` not implemented".
    ctx.ensure_instance_methods(base_id) catch {}
    if _user_fmt: = t_entry.get_method("fmt")
        return // the fmt the user wrote is respected
    switch t_entry.get_method("variant_name")
    case .none
        return // no variant_name was synthesized (for a const generic, for example)
    case .some {}
    // Caution: **Only the new method call is typed, not the value inside it**
    // (infer_call_on_typed). The writer is left alone: a chain inferred twice
    // (`arena.text().s(…)`) is refused as a temporary.
    // **A variant written out (`Color.red`) is written as its name.** One with a payload cannot be
    // replaced by its name, since the payload may do work.
    if value.kind_id == .k_enum_init_call
        ctx.err(value,
            "an enum variant built with its payload cannot be interpolated. Bind it to a name \
                first, or write the variant's name as text")
        throw .analysis_failed
    $name_arg: Ast_node$@ = null
    if value.kind_id == .k_enum_init
        quoted: = base_core.arena.text().c('"').s(value.last_child().text).c('"').take()
        name_arg = Ast_node(.k_string, quoted, value.loc)
    else
        name_arg = Ast_node.build_method_call(value, "variant_name", null, 0, value.loc)
    args.children.set(1, name_arg)
    if value.kind_id == .k_enum_init
        name_arg.infer_expr(ctx, 0)!
    else
        sema_body_postfix.infer_call_on_typed(ctx, name_arg)!

priv fn refuse_unopened_put(ctx: Sema_ctx$@, value: Ast_node$@, base_id: I32): Void!Sema_error //<
    //< Refuses a Result or an Option written in `\{…\}` as it stands
    //< **Its variant's name is all an enum's interpolation writes**, so `ok`, `err` or `some` would
    //< stand where the value or the error belongs, and both would be lost without a word.
    $what: U8[] = ""
    if ctx.env.is_result(base_id)
        what =
            "a result: it holds a value, or an error where the call failed. Take the value out \
                first: 'x!' passes the error on to the caller, and 'x catch <value>' uses a value \
                in its place"
    else if ctx.env.is_option(base_id)
        what =
            "an optional: it may hold no value. Take the value out first: 'if v: = x' runs only \
                where x holds one, and 'x.unwrap_or(<value>)' uses a value in its place"
    if what.len == 0
        return
    ctx.clear_scratch()
        .s("'\{ctx.env.display(value.type_id)\}' cannot be written in '\\{…\\}' as it stands. It is \
            \{what\}")
    ctx.err(value, ctx.scratch.slice())
    throw .analysis_failed

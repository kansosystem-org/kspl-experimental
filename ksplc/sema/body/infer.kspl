//< The main walk over the bodies: every function and initializer, then the generics' instances
//< `run` types the top-level declarations in the files' order. Then it checks the body of each
//< queued instance and evaluates the assertion directives. Last, it runs the checks that need the
//< whole analysis (the imports, the unused names). `Sema_ctx.bodies` chooses which bodies are
//< checked. The declarations are registered before this, by `run` in `sema/decl/collect.kspl`.
import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/core" as base_core
import "ksplc/base/diag" as base_diag
import "ksplc/base/literal" as base_literal
import "ksplc/sema/body/analyze" as sema_body_analyze
import "ksplc/sema/body/coerce" as _sema_body_coerce
import "ksplc/sema/body/defer_decl" as sema_body_defer_decl
import "ksplc/sema/body/expr" as sema_body_expr
import "ksplc/sema/body/for_in" as sema_body_for_in
import "ksplc/sema/body/lint_free" as sema_body_lint_free
import "ksplc/sema/body/lint_stmt" as sema_body_lint_stmt
import "ksplc/sema/body/lint_written" as sema_body_lint_written
import "ksplc/sema/body/stmt" as sema_body_stmt
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/attrs" as sema_decl_attrs
import "ksplc/sema/decl/collect" as sema_decl_collect
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/decl/mono_queue" as sema_decl_mono_queue
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/decl/suite" as sema_decl_suite
import "ksplc/sema/decl/trait_check" as sema_decl_trait_check
import "ksplc/sema/decl/type_check" as sema_decl_type_check
import "ksplc/sema/session/c_boundary" as sema_session_c_boundary
import "ksplc/sema/session/ctx" as sema_session_ctx + { Sema_ctx, Sema_error }
import "ksplc/sema/session/import_table" as sema_session_import_table
import "ksplc/sema/session/imports" as sema_session_imports
import "ksplc/sema/session/prof" as sema_session_prof
import "ksplc/sema/session/state" { Pending_inst }
import "ksplc/sema/type/arc" as sema_type_arc
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/ds" { List, Map }
import "std/str" { Str_builder }

// ==========================================
// Which bodies a `Bodies.mentioning` analysis checks
// A site naming the name lives in a body that mentions it, or in an instance of a generic that
// does. An instance is made by a body naming that generic. So the names grow through the generics
// using them until none is added. A body naming none of them holds no such site.
// Caution: **An instance made without naming its generic is not followed** (an operator, a
// subscript, `for in`, a trait value). The workspace walk reads only the files that name the name,
// so it already stops there.
// ==========================================
priv const MAX_MENTION_DEPTH: Sz = 2000 //< as deep as `validate_layout` lets a tree go

priv fn names_any( //< whether an identifier under `n` is one of `names`
    n: Ast_node$@,
    names: Map<|U8[], Bool|>$@,
    own: Ast_node$@, //< a generic's own name, which says nothing about what it uses
    depth: Sz,
): Bool
    if n == null || depth > MAX_MENTION_DEPTH
        return false
    if n != own && n.kind_id == .k_identifier && names.get(n.text).unwrap_or(false)
        return true
    for k in n.children
        if names_any(k, names, own, depth + 1)
            return true
    return false

priv fn push_generic_fns(decl: Ast_node$@, out: List<|Ast_node$@|>$@) //<
    //< The functions of a top-level declaration that are made per instance
    if decl.kind_id == .k_decl_fn && decl.is_generic_template()
        out.push(decl)
    else if decl.kind_id == .k_decl_impl
        whole: = decl.is_generic_template()
        for m in decl.children
            if m.kind_id == .k_decl_fn && (whole || m.is_generic_template())
                out.push(m)

priv fn wanted_names(r: Ast_node$@, name: U8[]): Map<|U8[], Bool|>$@ //<
    //< `name`, and the names of the generic functions that use it, directly or through another
    names: = base_core.arena.create(Map<|U8[], Bool|>.new(base_core.arena))
    names.set(name, true)
    $fns: = List<|Ast_node$@|>.new(base_core.arena)
    for child_node in r.children
        push_generic_fns(child_node.unwrap_top_level(), fns@)
    $taken: = List<|Bool|>.new(base_core.arena)
    for _f in fns
        taken.push(false)
    $grew: = true
    for grew
        grew = false
        for i in Range.asc(fns.len)
            f: = fns.get(i)
            own: = f.find_child(.k_identifier)
            if !taken.get(i) && names_any(f, names, own, 0)
                taken.set(i, true)
                names.set(own.text if own != null else "", true)
                grew = true
    return names

priv fn wants_names(c: Sema_ctx$@, decl: Ast_node$@): Bool //<
    //< Whether the editor's final pass resolves the names in this declaration
    //< **Only `Bodies.mentioning` narrows it**: a declaration naming none of the names holds no
    //< site to find. The document view keeps every file's, which its hover reads.
    switch c.bodies
    case .mentioning
        return names_any(decl, c.body_names, null, 0)
    default
        return true

priv fn wants_body(c: Sema_ctx$@, decl: Ast_node$@): Bool //< whether `c.bodies` checks this body
    if decl.loc.file().equals(c.main_file)
        return true
    switch c.bodies
    case .main_file
        return false
    case .everywhere
        return true
    case .mentioning
        return names_any(decl, c.body_names, null, 0)

priv fn implicit_cleanup_method(c: Sema_ctx$@, node: Ast_node$@): Bool //<
    //< cleanup is a use without a source call
    $params: = base_ast_ext.Param_cursor.new(node.get_fn_params(), false)
    if p: = params.next()
        owner: = c.env.strip_ptr_full(p.param_type_id())
        name: = c.env.source_fn_name(node)
        return c.env.is_arc_type(owner) &&
            (name.equals("retain") || name.equals("release"))
    return false

priv fn infer_pending_bodies(c: Sema_ctx$@, checked: Map<|Sz, Bool|>$@): Bool //<
    //< It checks each queued instantiation's body, and returns whether one failed
    //< `checked` gets every body it checked. pending.len is re-read on every iteration: infer_fn
    //< appends new instantiations to c.generics.pending, and a fixed length would drop them.
    $has_err: = false
    $more: = true
    for more
        more = false
        $pending_at: Sz = 0
        for pending_at < c.generics.pending.len
            pending: = c.generics.pending.get(pending_at)
            pending_at += 1
            if checked.get(Sz::pending.node).unwrap_or(false)
                continue
            sym: = Sema_symbol$@::pending.node.sym_ptr
            if sym.flags.is_method && !sym.flags.is_used &&
                !implicit_cleanup_method(c, pending.node)
                continue
            checked.set(Sz::pending.node, true)
            more = true
            // Caution: **Drain the constraints before each body is checked.** Drained once outside
            // the loop, a violation by an instantiation made inside some body would be known only
            // after its method body is checked.
            // **Drain the instantiations first**: they fill the conformance table the check reads.
            c.drain_pending_instances() catch
                has_err = true
            c.drain_pending_constraints()
            // A constraint-violating instantiation's body is not checked (for the same reason).
            if c.has_failed_constraint(pending.impl_name)
                continue
            if !infer_instance_body(c, pending, sym, pending_at - 1)
                has_err = true
    return has_err

priv fn infer_instance_body(c: Sema_ctx$@, pending: Pending_inst, sym: Sema_symbol$@, at: Sz): Bool //<
    //< It checks one queued instantiation's body (`at` in the queue); false where it failed
    c.set_current_file(pending.node.loc.file())
    c.symtab.scope_stack.len = 0
    c.fn_ctx = sema_session_ctx.Fn_ctx::{ .name = "", .ret_id = 0, .impl_name = pending.impl_name,
        .fallback_type = 0, .catch_depth = 0, .in_fallback_value = false, .in_defer = false,
        .defer_boundary = 0 }

    base_diag.ice_assert(pending.node.sym_ptr != null,
        "infer: pending instantiation node missing sym_ptr")
    c.fn_ctx.name = sym.name

    // Restores the type-argument bindings as queued, then analyzes the body. Always restore the
    // previous ones afterwards (instantiations nest; see Pending_inst in sema/session/state.kspl).
    saved_args_len: = c.generics.args.len
    for j in Range.asc(pending.bound_args.len)
        c.generics.args.push(pending.bound_args.get(j))
    // This body's depth in the chain; an instantiation made inside it is one deeper
    // (inst_chain_depth in sema/session/state.kspl).
    c.generics.inst_chain_depth = pending.depth
    // What this body instantiates, and an error in it, name it (`Generic_state.analysing`).
    c.generics.analysing = at
    $ok: = true
    pending.node.infer_fn(c) catch
        ok = false
    c.generics.analysing = -1
    c.generics.inst_chain_depth = 0
    c.generics.args.len = saved_args_len
    return ok

fn run(r: Ast_node$@, c: Sema_ctx$@): Void!Sema_error
    base_diag.ice_assert(r != null, "infer: file_node is null")
    $has_err: = false
    switch c.bodies
    case .mentioning(name)
        c.body_names = wanted_names(r, name)
    default {}

    for child_node in r.children
        // Report progress once per declaration (report_progress in base/core.kspl). Otherwise the
        // LSP's supervisor takes a silent but live worker for a hung one and kills it.
        base_core.report_progress()
        // Instances the previous declaration queued are created here.
        c.drain_pending_instances() catch
            has_err = true
        child: = child_node.unwrap_top_level()
        c.set_current_file(child.loc.file())
        body_wanted: = wants_body(c, child)
        if child.kind_id == .k_decl_fn
            if !child.is_generic_template() && body_wanted
                child.infer_fn(c) catch
                    has_err = true
        else if child.kind_id == .k_decl_impl
            if !child.is_generic_template() && body_wanted
                child.infer_impl_decl(c) catch
                    has_err = true
        else if child.kind_id == .k_decl_var || child.kind_id == .k_decl_const
            child.infer_global(c)!

    // From here on the bodies are monomorphized templates.
    c.set_in_generic_instance(true)
    defer c.set_in_generic_instance(false)
    $checked: = Map<|Sz, Bool|>.new(base_core.arena)
    if infer_pending_bodies(c, checked@)
        has_err = true

    for child_node in r.children
        child: = child_node.unwrap_top_level()
        c.set_current_file(child.loc.file())
        // **Only an assertion directive is evaluated** (check_directive in sema/decl/attrs.kspl
        // rejects the others; `##lint` has nothing to fold).
        if sema_decl_attrs.is_assertion_directive(child)
            child.infer_compile_directive(c)

    // Caution: **Mark the written imports and names before discarding the template bodies.** An
    // uninstantiated body is never analyzed, so resolving never marks its imports, nor the `priv`
    // helpers it calls ([W0206]).
    if base_core.config.run_lint_checks
        for child_node in r.children
            child_node.mark_written_imports(c)
            child: = child_node.unwrap_top_level()
            if child.is_generic_template()
                c.set_current_file(child.loc.file())
                child.mark_template_symbols_used(c)
        sema_body_lint_written.lint_written(r, c)

    r.keep_checked_children(c, checked@)
    // --- Final Pass: Post-Resolution for LSP and Linter ---
    for child_node in r.children
        child: = child_node.unwrap_top_level()
        c.set_current_file(child.loc.file())
        if base_core.config.is_lsp && wants_names(c, child)
            // Caution: **Set the flag, then resolve.** These children include uninstantiated
            // templates, whose type arguments are unbound (Generic_state.resolving_template_types
            // in `../session/state.kspl`).
            c.generics.resolving_template_types = true
            child.resolve_all_types(c) catch {}
            c.generics.resolving_template_types = false
        child.mark_template_symbols_used(c)

    c.check_import_symbols()
    c.check_redundant_import_alias()
    c.check_unused_imports()
    c.check_unused_symbols()
    c.check_uncalled_in_suite_files()
    c.check_unit_internal_pubs()

    if c.has_error() || has_err
        throw .analysis_failed

impl Ast_node
    priv fn infer_global(r: Self$@, c: Sema_ctx$@): Void!Sema_error //<
        //< It checks a file-scope `var` or `const` and its initializer
        expr_node: = r.get_var_decl_expr()
        if expr_node == null || expr_node.kind_id == .k_empty
            return
        expected_id: = r.type_id
        expr_id: = expr_node.infer_expr(c, expected_id)!
        // A top-level declaration writes its type, so the initializer's is the one to go.
        sema_body_lint_stmt.lint_type_given(c, expr_node, expected_id,
            "The declared type already gives it.")

        type_node: = r.get_var_decl_type_node()
        r.type_id = r.resolve_inferred_array(c, expected_id, expr_id, type_node, r)
        // Caution: **Include `const` too.** Like `var`, it becomes a file-scope initializer in C,
        // which requires a constant expression.
        expr_node.check_static_initializer(c)

    priv fn keep_checked_children(r: Self$@, c: Sema_ctx$@, checked: Map<|Sz, Bool|>$@) //<
        //< It drops each template (except in the editor) and each instance whose body was unchecked
        clean_children: = base_ast.new_ast_node_list()
        for child in r.children
            u_child: = child.unwrap_top_level()
            if u_child.is_generic_template() && !base_core.config.is_lsp
                continue
            clean_children.push(child)

        for inst_node in c.env.instantiated_nodes_list
            if inst_node.kind_id == .k_decl_fn && inst_node.find_child(.k_stmt_block) != null &&
                !checked.get(Sz::inst_node).unwrap_or(false)
                continue
            clean_children.push(inst_node)
        c.env.instantiated_nodes_list.len = 0
        r.children = clean_children

    priv fn infer_fn(r: Self$@, c: Sema_ctx$@): Void!Sema_error
        // Restarts the temporary variables' numbering per body. **It nests, so restore it** (the
        // reason is at enter_fn_serial in sema/body/for_in.kspl).
        saved_for_in_serial: = sema_body_for_in.enter_fn_serial()
        defer sema_body_for_in.leave_fn_serial(saved_for_in_serial)
        name_node: = r.find_child(.k_identifier)
        fn_name: = name_node.text if name_node != null else ""
        if name_node != null
            name_node.def_node = r
        // Measures one body's elapsed time. **No body is inferred inside another** (`run` takes
        // them one after another), so the elapsed time is the body's own.
        prof_started: = sema_session_prof.prof.body_begin()
        defer sema_session_prof.prof.body_end(fn_name, r.loc, prof_started)

        // An instance's tree carries its template's file (prepare_inst_node in mono.kspl).
        def_file: = r.loc.file()
        prev_file: = c.file_name
        if def_file.len > 0
            c.set_current_file(def_file)

        type_node: = r.get_decl_type_node()
        param_list: = r.get_fn_params()

        if name_node != null
            c.fn_ctx.name = name_node.text
        saved_errors_before: = c.fn_ctx.errors_before
        c.fn_ctx.errors_before = c.error_mark()
        defer c.fn_ctx.errors_before = saved_errors_before
        c.fn_ctx.effective_vis = c.compute_effective_vis(r)

        $is_export: = false
        if r.sym_ptr != null
            sym: = Sema_symbol$@::r.sym_ptr
            if sym.flags.is_export
                is_export = true

        if type_node != null
            c.fn_ctx.ret_id = type_node.resolve_type(c)!
            if is_export
                c.check_ffi_safety(c.fn_ctx.ret_id, type_node)
        else
            c.fn_ctx.ret_id = I32::sema_type_env.Builtin_type_id.void_type
        // **`main`'s return reaches the start-up code alone**, which names no type, so a `priv`
        // error type leaks to no code (and `main` itself cannot be narrowed to `priv`).
        if !c.is_entry_main(r)
            c.check_type_vis_leak(type_node, c.fn_ctx.effective_vis, "return type", "function")

        c.symtab.enter_scope()
        defer
            c.symtab.exit_scope()
            if prev_file.len > 0
                c.set_current_file(prev_file)
        if param_list != null
            for item in base_ast_ext.Param_cursor.new(param_list, false)
                item.declare_param(c, is_export)!

        block: = r.find_child(.k_stmt_block)
        if base_core.config.run_lint_checks && block != null
            r.lint_fn_length(c)
            r.lint_nesting(block, c)
        if block != null && !r.infer_body(c, block)
            throw .analysis_failed

    priv fn declare_param(r: Self$@, c: Sema_ctx$@, is_export: Bool): Void!Sema_error //<
        //< It declares one parameter in the function's scope, with its written type
        p_name: = r.find_text(.k_identifier)
        r.ice_assert(p_name.len > 0, "Function parameter is missing an identifier")
        sym: = Sema_symbol.new(.variable, p_name, r)
        // A parameter without `$` cannot be reassigned, as with `x: = ...`; a field write on a
        // by-value receiver (`r: Self`) is rejected by enforce_mutability walking the `.`.
        if !r.has_mut_binding_marker()
            sym.flags.is_mut = false
        $t_id: = I32::sema_type_env.Builtin_type_id.void_type
        t_node: = r.find_child(.k_type_expr)
        // A type reported missing makes the parameter unknown (names_missing_type in
        // `../decl/type_check.kspl`), so nothing below repeats that report. **Not in an
        // instance**: its types are written in the internal form, which the check cannot read, and
        // the template's declaration was checked already.
        missing: =
            !c.is_instantiating() && sema_decl_type_check.names_missing_type(c, t_node)
        if t_node != null && !missing
            t_id = t_node.resolve_type(c)!
            if is_export
                c.check_ffi_safety(t_id, t_node)
        if missing
            t_id = I32::sema_type_env.Builtin_type_id.unknown
        else
            c.check_param_type(r, t_id)
        r.check_param_default(c, t_id)
        sym.type_id = t_id
        r.type_id = t_id
        c.declare_symbol(p_name, sym, false)
        id_node: = r.find_child(.k_identifier)
        if id_node != null
            id_node.def_node = r

    priv fn check_param_default(r: Self$@, c: Sema_ctx$@, t_id: I32) //<
        //< Checks a parameter's default against its type here, at the declaration
        //< **A call that leaves the argument out checks a copy of it the same way**
        //< (`call_defaults.kspl`); without this, `v: U8 = 300` passes until some call uses it. The
        //< two reports are one at the same position, and merged.
        d: = r.get_param_default()
        if d == null || d.caller_loc_kind().len > 0 || sema_type_env.is_unknown(t_id)
            return
        probe: = d.clone()
        a_id: = probe.infer_expr(c, t_id) catch I32::sema_type_env.Builtin_type_id.unknown
        if !sema_type_env.is_unknown(a_id)
            probe.apply_type_coercion(c, a_id, t_id)

    priv fn infer_body(r: Self$@, c: Sema_ctx$@, block: Ast_node$@): Bool //<
        //< It analyzes a function's body; false where it found an error
        //< A body whose function returns nothing gets the `return` its writer left out.
        block.infer_stmts(c) catch
            return false
        // A value that its `defer` frees, handed over all the same.
        sema_body_defer_decl.refuse_handover(c, block)
        // [W0105] A lock's borrow used outside the lock (lint only).
        sema_body_lint_stmt.lint_lock_escape(c, block)
        // [W0109] A value made here and left unfreed on some way out; [H0303] its two-line free.
        sema_body_lint_free.lint_unfreed(c, block)
        if r.has_attribute("naked") && !block.holds_only_asm(c)
            return false
        if c.has_error_in_fn()
            return true
        if !r.analyze_function_body(c, block)
            return false
        r.add_implicit_return(c, block)
        return true

    priv fn add_implicit_return(r: Self$@, c: Sema_ctx$@, block: Ast_node$@) //<
        //< It ends the body of a function returning nothing with `return`, where it does not end so
        //< Caution: **Do not add it to a function that declares `#noreturn`.** A `return;` under
        //< C's `__attribute__((noreturn))` triggers `-Winvalid-noreturn` (Principle 2). Nor to a
        //< `#naked` one: its assembly returns, and clang refuses any other statement.
        base_ret_id: = c.env.strip_result(c.fn_ctx.ret_id)
        if !sema_type_env.is_void(base_ret_id) && !sema_type_env.is_unknown(base_ret_id)
            return
        if r.has_attribute("noreturn") || r.has_attribute("naked")
            return
        if block.children.len > 0
            last: = block.last_child()
            if last.kind_id == .k_stmt_return || last.kind_id == .k_stmt_throw ||
                last.kind_id == .k_stmt_fallback
                return
        implicit_ret: = Ast_node.new(.k_stmt_return, "return", block.loc)
        implicit_ret.add_child(Ast_node.new(.k_keyword, "return", block.loc))
        block.add_child(implicit_ret)

    priv fn holds_only_asm(r: Self$@, c: Sema_ctx$@): Bool //<
        //< Whether a `#naked` function's body is `__kspl_asm_volatile(...)` statements alone
        //< It reports the first other statement.
        //< With no prologue there is no frame, so any other statement would use stack the function
        //< never set up. clang refuses it ("non-ASM statement in naked function").
        for stmt in r.children
            if stmt.kind_id == .k_empty
                continue
            call: = stmt.get_assign_left() if stmt.kind_id == .k_stmt_expr else null
            callee: =
                (call.get_postfix_receiver() if call != null && call.kind_id == .k_expr_postfix
                else null)
            if stmt.kind_id == .k_stmt_expr && stmt.get_assign_right() == null && callee != null &&
                callee.kind_id == .k_identifier && callee.text.equals("__kspl_asm_volatile")
                continue
            c.err(stmt,
                "a '#naked' function permits only '__kspl_asm_volatile(...)' statements. It has no \
                    prologue. Other statements would require a stack frame that does not exist")
            return false
        return true

    priv fn find_subtree_end_offset(r: Self$@): Sz //<
        //< The rightmost offset in the subtree, in place of the end offset Ast_node does not store
        //< A dropped punctuation token can make it a few lines short, which is close enough for the
        //< line guideline.
        $max_end: Sz = r.loc.offset + r.text.len
        for c in r.children
            child_end: = c.find_subtree_end_offset()
            if child_end > max_end
                max_end = child_end
        return max_end

    priv fn lint_fn_length(r: Self$@, c: Sema_ctx$@) //<
        //< [H0803] Reports a function over the guideline of 300 lines
        //< The guideline is Principle 3 of docs/DESIGN-principles.md; as a guideline, it is a Hint,
        //< not an error.
        src: = base_core.source_of(c.source_map, r.loc.file())
        if src.len == 0
            return
        starts: = c.line_starts_for(r.loc.file(), src)
        start_line: = base_core.line_for_offset(starts, r.loc.offset)
        end_offset: = r.find_subtree_end_offset()
        end_line: = base_core.line_for_offset(starts, end_offset)
        line_count: = end_line - start_line + 1
        max_fn_lines: Sz = 300
        if line_count > max_fn_lines
            c.clear_scratch()
                .s("[H0803] This function spans \{line_count\} lines, over the \
                    ~\{max_fn_lines\}-line guideline (Principle 3 in docs/DESIGN-principles.md). \
                    Split it into smaller functions, each with one purpose.")
            c.hint(r, c.scratch.slice())

    priv fn deepest_block(r: Self$@, depth: Sz): Sz //<
        //< How many blocks deep the subtree's deepest block sits, r's own counted as `depth`
        $best: = depth
        for ch in r.children
            d: = ch.deepest_block(depth + 1 if ch.kind_id == .k_stmt_block else depth)
            if d > best
                best = d
        return best

    priv fn lint_nesting(r: Self$@, body: Ast_node$@, c: Sema_ctx$@) //<
        //< [H0805] Reports a function whose blocks nest past the guideline of 8 levels
        //< The body's own block is level 0, so an `if` in it opens level 1. The guideline is
        //< Principle 3 of docs/DESIGN-principles.md; as a guideline, it is a Hint, as [H0803] is.
        if c.is_code_off(r, "H0805")
            return
        depth: = body.deepest_block(0)
        max_depth: Sz = 8
        if depth > max_depth
            c.clear_scratch()
                .s("[H0805] This function nests blocks \{depth\} levels deep, past the \
                    \{max_depth\}-level guideline (Principle 3 in docs/DESIGN-principles.md). Move \
                    the inner code into a helper, or return early to reduce nesting.")
            c.hint(r, c.scratch.slice())

    priv fn infer_impl_decl(r: Self$@, c: Sema_ctx$@): Void!Sema_error
        $has_err: = false
        target_node: = r.get_decl_type_node()
        trait_node: = r.get_impl_trait_node().unwrap_or(null)

        if !r.is_generic_template() && target_node != null
            t_id: = target_node.resolve_type(c)!
            target_type: = c.env.get_str(t_id)

            old_impl: = c.fn_ctx.impl_name
            c.fn_ctx.impl_name = target_type
            defer c.fn_ctx.impl_name = old_impl

            for m in r.children
                if m.kind_id == .k_decl_fn && !m.is_generic_template()
                    m.infer_fn(c) catch
                        has_err = true

            if trait_node != null
                trait_id: = trait_node.resolve_type(c)!
                if trait_id != 0 && !sema_type_env.is_unknown(trait_id)
                    if !c.verify_trait_implementation(t_id, trait_id, trait_node)
                        has_err = true
        if has_err
            throw .analysis_failed

    priv fn infer_compile_directive(r: Ast_node$@, c: Sema_ctx$@)
        $expr_node: Ast_node$@ = null
        $msg_node: Ast_node$@ = null
        for ch in r.children
            // Caution: **Do not take the directive name's child for the expression**, or folding
            // the name makes the assertion always hold.
            if ch.kind_id == .k_literal || ch.kind_id == .k_keyword ||
                ch.kind_id == .k_directive_prefix
                continue
            if expr_node == null
                expr_node = ch
            else if msg_node == null && ch.kind_id == .k_string
                msg_node = ch

        if expr_node != null
            // Caution: **A condition that does not fold is reported, not taken as false.** Folding
            // names why, and the file's own message would then claim a failure that did not happen.
            val: = expr_node.eval_constexpr(c) catch
                return
            if val == 0
                $msg_slice: U8[] = "Assertion failed"
                if msg_node != null
                    msg_slice = msg_node.text.literal_value(base_core.arena)
                // Caution: Send both through the same path as other diagnostics; printed directly,
                // they get no position and are missing from the final count. No code is assigned:
                // the words are the user's, and silencing them with `##lint` would void the
                // assertion.
                if sema_decl_attrs.directive_name(r).equals("error")
                    c.err(r, msg_slice)
                else
                    c.warn(r, msg_slice)

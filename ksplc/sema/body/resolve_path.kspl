//< Infers the meaning of a path expression
//<
//< An identifier, an alias prefix, or a type's static member. Kept apart from `resolve.kspl`.
import "ksplc/base/ast" { Ast_node, is_anon_fn_name }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as _base_ast_place
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/sema/body/call" as sema_body_call
import "ksplc/sema/body/generic_infer" as sema_body_generic_infer
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/mono" as sema_decl_mono
import "ksplc/sema/decl/mono_name" as sema_decl_mono_name
import "ksplc/sema/decl/name" as sema_decl_name
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error }
import "ksplc/sema/session/import_table" as sema_session_import_table
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/chars" // testing and slicing single characters
import "std/str" { Str_builder }

// The type of a function used as a value without being called (its bare name passed or assigned as
// a function pointer).
// Caution: Without this match, a mismatched signature passes ksplc. It surfaces only as clang's
// -Wincompatible-function-pointer-types ("Failing fast through an exception or an ICE" in
// ksplc/docs/DESIGN-compiler.md). **Exempt only the four cases below.** "Pass unless a function
// pointer is expected" lets a function pointer through where a `Callable1` is expected (a closure's
// forgotten `;`). The user then sees a clang error naming `_anon_fn_1`.
priv fn fn_value_type_id(node: Ast_node$@, c: Sema_ctx$@, sym: Sema_symbol$@, expected_id: I32,
    is_method: Bool): I32!Sema_error
    exp_real: = c.env.get_clean_real_type(expected_id)
    // Nothing to match against: (1) no declaration (2) no expected type (`x: = f;`) (3) a generic
    // call's opaque marker (4) variadic arguments.
    if sym.node == null || sema_type_env.is_unknown(exp_real) ||
        exp_real == c.env.generic_fn_value_type_id() || sym.node.has_variadic_param()
        return expected_id
    // `Void$@` is accepted for the FFI, where a function pointer is just an address.
    if exp_real == (I32::sema_type_env.Builtin_type_id.void_ptr)
        return expected_id

    actual_id: = sema_decl_resolve.own_fn_type_id(sym.node, c)!
    actual_str: = c.env.get_str(actual_id)
    // Stay silent where something is unresolved (another diagnostic names the cause).
    // An alias in a parameter is another name for its type (is_const_compatible's signatures).
    if actual_id == exp_real ||
        actual_str.find_str(base_core.unknown_type_name).is_some() ||
        c.env.is_const_compatible(actual_id, exp_real)
        return expected_id

    exp: = c.env.display(exp_real)
    act: = c.env.display(actual_id)
    c.clear_scratch()
    // Caution: Do not show a synthesized name (`_anon_fn_1`), which the user did not write. See "A
    // diagnostic points at 'the position the user wrote'" in ksplc/docs/DESIGN-diagnostics.md. Name
    // the anonymous function as the source spells it.
    if is_anon_fn_name(sym.name)
        c.scratch.s("this anonymous function")
    else if sym.flags.is_generated_instance || is_method
        // An instance's own name is mangled and a method's is qualified; show the path as written
        // (`same<|I32|>`, `Holder<|I32|>.get`).
        c.scratch.s("method '" if is_method else "function '")
        node.get_full_path_str_to(c.scratch)
        c.scratch.s("'")
    else
        c.scratch.s("function '\{sym.name\}'")
    c.scratch.s(" cannot be used as '\{exp\}'. Its type is '\{act\}'")
    c.append_missing_capture_list_note(exp_real)
    c.err(node, c.scratch.slice())
    return expected_id

priv fn refuse_unwritten_type_args(c: Sema_ctx$@, at: Ast_node$@, what: U8[], name: U8[],
    form: U8[], gen_params: Ast_node$@) //<
        //< Reports a generic named as a value without its type arguments, with the form to write
        //<
        //< `what` is "function" or "method"; `form` is the path to write, `<|…|>` included.
    c.clear_scratch()
        .s("generic \{what\} '\{name\}' cannot be used as a value without its type arguments. There \
            are no call arguments from which to infer them\n  Hint: name one specialization with \
            '\{form\}'. Write a type for each of ")
    sema_body_generic_infer.write_gen_param_names(c, gen_params)
    c.err(at, c.scratch.slice())

priv fn instantiate_written(node: Ast_node$@, c: Sema_ctx$@, fn_tmpl: sema_decl_mono.Fn_instance,
    tmpl: Ast_node$@, type_args: Ast_node$@): Sema_symbol$@?!Sema_error //<
        //< Builds the specialization of the template `tmpl` that `type_args` name
        //<
        //< None once reported. As at a call, a bound violation is reported at node's line, not the
        //< template's.
    args: = type_args.build_resolved_type_args(c, tmpl)!
    if !sema_decl_mono.written_generic_arity_matches(tmpl, args.len)
        sema_decl_mono.check_written_generic_arity(c, tmpl, args.len, node)
        return .none
    prev_inst_site: = c.generics.inst_site
    c.generics.inst_site = node
    defer c.generics.inst_site = prev_inst_site
    $inst_name: = c.instantiate_fn(sema_body_call.with_args(fn_tmpl, args), false)!
    defer inst_name.free()
    return c.symtab.resolve(inst_name.slice())

priv fn specialization_named(node: Ast_node$@, c: Sema_ctx$@, named: sema_decl_name.Written_name):
    Sema_symbol$@?!Sema_error //<
        //< What a function named as a value stands for: itself, or the specialization it names
        //<
        //< The written type arguments name the specialization, which is instantiated here. It gives
        //< none once it reports a generic function without them, or them on a non-generic one. See
        //< "A generic function used as a value names its specialization" in
        //< docs/DESIGN-language.md.
    sym: = named.sym
    type_args: = named.parts.own
    gen_params: = sym.node.find_child(.k_type_gen_params) if sym.node != null else null
    if gen_params == null || gen_params.children.len == 0
        if type_args == null
            return .some(sym)
        sema_body_call.refuse_type_args_on_plain_fn(c, sym.name, type_args)
        return .none
    if named.template != sym.node
        c.clear_scratch()
            .s("generic method '\{sym.name\}' cannot be used as a value\n  Hint: call the method \
                from a non-generic function. Use that function as the value")
        c.err(node, c.scratch.slice())
        return .none
    if type_args == null
        $form: = Str_builder.new()
        defer form.free()
        form.s(sym.name).s("<|…|>")
        refuse_unwritten_type_args(c, node, "function", sym.name, form.slice(), gen_params)
        return .none
    got: = instantiate_written(node, c, named.fn_tmpl, sym.node, type_args)!
    if inst: = got
        // The instance's declaration is what the backends name (`get_c_identifier_for_sym_to` in
        // lower/abi.kspl); the template has no code of its own.
        inst.flags.is_used = true
        node.def_node = inst.node
        node.get_child(node.children.len - 2).def_node = inst.node
    return got

priv fn fn_value_id(node: Ast_node$@, c: Sema_ctx$@, named: sema_decl_name.Written_name,
    expected_id: I32): I32!Sema_error //<
        //< The type of a function's name used as a value rather than called
        //<
        //< A generic function stands for the specialization written after it.
    if inst: = specialization_named(node, c, named)!
        return value_of_fn(node, c, inst, expected_id, false)!
    return I32::sema_type_env.Builtin_type_id.unknown

priv fn value_of_fn(node: Ast_node$@, c: Sema_ctx$@, sym: Sema_symbol$@, expected_id: I32,
    is_method: Bool): I32!Sema_error //<
        //< The type of the function sym, named at node as a value, checked against the expected
        //<
        //< **A function's name takes its type from where it is written.** With nothing expected, it
        //< is the mark generic_fn_value_type_id ("a function"). The position that receives it
        //< supplies the type later (a generic call's parameter, the other side of a `==`).
        //< Caution: Do not answer sym.type_id there. That is the function's return type, and
        //< genllvm would compare or pass the address as that scalar.
    if !sema_type_env.is_unknown(expected_id)
        return fn_value_type_id(node, c, sym, expected_id, is_method)!
    // An unresolved return type is reported at the declaration.
    if sema_type_env.is_unknown(sym.type_id)
        return I32::sema_type_env.Builtin_type_id.unknown
    return c.env.generic_fn_value_type_id()

fn infer_method_value(node: Ast_node$@, c: Sema_ctx$@, owner_id: I32, owner: Ast_node$@,
    member: Ast_node$@, own_args: Ast_node$@, expected_id: I32): I32!Sema_error //<
        //< The type of a method named through its type as a value
        //<
        //< It is the function whose first parameter is the receiver as declared (`Plain.m`,
        //< `Holder<|I32|>.get`, `Plain.gen<|I32|>`). owner_id is the type owner names, instantiated
        //< from its written type arguments. The method's own are own_args, and a generic one
        //< without them is refused. See "A method as a value is named through its type" in
        //< docs/DESIGN-language.md. Unknown once reported.
    owner_real: = c.env.get_real_type(owner_id)
    owner_name: = c.env.get_str(owner_real)
    // The path as written (`Holder<|I32|>.get`), for a diagnostic.
    $written: = Str_builder.new()
    defer written.free()
    owner.get_full_path_str_to(written)
    written.s(".").s(member.text)
    $fqn: = Str_builder.new()
    defer fqn.free()
    fqn.s(owner_name).s(".").s(member.text)
    // A trait's method is a slot each conforming type fills, with no function of its own.
    switch c.env.get_info(owner_real)
    case .trait_type(_def)
        c.clear_scratch()
            .s("trait method '\{written.slice()\}' cannot be used as a value. Each type conforming \
                to the trait has its own method\n  Hint: name the method on one conforming type, as \
                in 'Circle.\{member.text\}'")
        c.err(node, c.scratch.slice())
        return I32::sema_type_env.Builtin_type_id.unknown
    default {}
    $sym: Sema_symbol$@ = null
    if found: = c.resolve_type_method_fqn(fqn.slice())
        if own_args != null
            sema_body_call.refuse_type_args_on_plain_fn(c, written.slice(), own_args)
            return I32::sema_type_env.Builtin_type_id.unknown
        sym = found
    else
        $tmpl: Ast_node$@ = null
        $fn_tmpl: = sema_decl_mono.Fn_instance::{ .template = "", .owner = 0,
            .args = I32[]::{} }
        if found_tmpl: = sema_decl_mono_name.lookup_method_template(c, owner_real, member.text)
            tmpl = found_tmpl.node
            fn_tmpl.template = found_tmpl.fqn
            fn_tmpl.owner = found_tmpl.owner
        if tmpl == null
            shown: = c.env.display(owner_real)
            c.clear_scratch().s("type '\{shown\}' has no method named '\{member.text\}'")
            c.err(member, c.scratch.slice())
            return I32::sema_type_env.Builtin_type_id.unknown
        if own_args == null
            written.s("<|…|>")
            refuse_unwritten_type_args(c, node, "method", member.text, written.slice(),
                tmpl.find_child(.k_type_gen_params))
            return I32::sema_type_env.Builtin_type_id.unknown
        switch instantiate_written(node, c, fn_tmpl, tmpl, own_args)!
        case .some(inst)
            sym = inst
        case .none
            return I32::sema_type_env.Builtin_type_id.unknown
    // The method's own declaration (an instance's, for a generic) is what the backends name.
    sym.flags.is_used = true
    node.def_node = sym.node
    member.def_node = sym.node
    c.check_visibility_and_mark_used(sym, node)
    return value_of_fn(node, c, sym, expected_id, true)!

fn refuse_method_of_bare_generic(c: Sema_ctx$@, node: Ast_node$@, owner: Ast_node$@,
    member: Ast_node$@, owner_tmpl: Ast_node$@, is_call: Bool) //<
        //< Refuses a member of a generic type named with no type arguments, called or as a value
        //<
        //< `Holder.get`, `Holder.mk(1)`: each instance has its own copy of the method, and nothing
        //< here says which. A call's arguments do not choose it either: a generic type's are
        //< written on the type ("Structs (`struct`)" in docs/SPEC-language.md).
    $name: = Str_builder.new()
    defer name.free()
    owner.get_full_path_str_to(name)
    n: = name.slice()
    m: = member.text
    c.clear_scratch().s("generic type '\{n\}' needs its type arguments before ")
    if is_call
        c.scratch
            .s("'\{m\}' can be called through it. Each instance has its own '\{m\}'\n  Hint: call \
                the method on one instance with '\{n\}<|…|>.\{m\}(…)'. Write a type for each of \
                ")
    else
        c.scratch
            .s("one of its methods can be used as a value. Each instance has its own '\{m\}'\n  \
                Hint: name the method on one instance with '\{n\}<|…|>.\{m\}'. Write a type for \
                each of ")
    sema_body_generic_infer.write_gen_param_names(c, owner_tmpl.find_child(.k_type_gen_params))
    c.err(node, c.scratch.slice())

fn infer_path_expr(node: Ast_node$@, c: Sema_ctx$@, expected_id: I32): I32!Sema_error
    is_callee: = c.fn_ctx.callee == node
    if node.children.len <= 1
        name: = node.text if node.children.len == 0 else node.get_child(0).text
        if name.equals("true") || name.equals("false")
            return I32::sema_type_env.Builtin_type_id.bool_type
        if name.equals("null")
            return c.env.resolve_null_type(expected_id)
        // Built-in intrinsics handled in call.kspl, not declared as symbols: Unknown keeps them
        // from reading as undefined, and call.kspl decides the type.
        if sema_body_call.intrinsic_of(name) != .not_intrinsic
            return I32::sema_type_env.Builtin_type_id.unknown
    named: = c.read_written_name(node)
    sym: = named.sym
    if named.reach == .by_fqn
        c.report_name_by_fqn(node, named)
        return I32::sema_type_env.Builtin_type_id.unknown
    if sym == null
        switch named.reach
        case .instance_type
            // A generic type's instance written whole names a type, which refuse_type_name tells
            // from its template.
            node.def_node = named.template
        default
            report_unread_name(c, node, named)
        return I32::sema_type_env.Builtin_type_id.unknown

    sym.flags.is_used = true
    node.def_node = sym.node
    if named.parts.owner == null
        if node.children.len >= 1
            node.get_child(0).def_node = sym.node
    else
        last: = named.parts.name
        if last.kind_id == .k_identifier
            last.def_node = sym.node
    c.check_visibility_and_mark_used(sym, node)

    if sym.kind.names_function()
        if !is_callee
            return fn_value_id(node, c, named, expected_id)!
    // Caution: **A type's own name is not a value.** Returning its type makes `x: = Row` emit an
    // undefined C symbol, a C compiler error rather than a diagnostic (Principle 2). Unknown is
    // rejected at the declaration instead (refuse_type_name); the `.` path (`Row.new()`,
    // `infer_namespace_access`) discards the result, so it costs nothing.
    else if sym.kind.is_type()
        return I32::sema_type_env.Builtin_type_id.unknown
    if !sema_type_env.is_unknown(sym.type_id)
        return sym.type_id
    return I32::sema_type_env.Builtin_type_id.unknown

priv fn report_unread_name(c: Sema_ctx$@, node: Ast_node$@, named: sema_decl_name.Written_name) //<
    //< Reports a value's name that names nothing this file can see
    //<
    //< Caution: **Do not let a capitalized name through as "probably a type".** A mistyped
    //< `Str_builde` becomes a genc ICE in an inferred declaration, and elsewhere a **C compiler
    //< error** (Principle 2).
    if named.parts.owner == null
        name: = named.parts.name.text
        if !c.get_file_alias(c.file_name, name) && !c.is_type_name(name)
            report_undefined_path(c, node, name, false, "", name, false)
        return
    $full_name: = node.get_full_path_str()
    defer full_name.free()
    report_undefined_path(c, node, full_name.slice(), named.head_file.len > 0,
        node.get_child(0).text, node.get_path_name(), named.reach == .absent)

fn refuse_type_name(c: Sema_ctx$@, node: Ast_node$@): Bool //<
    //< Reports a value's expression that is a type's name (`Row`, `m.Row`, `Box<|I32|>`)
    //<
    //< infer_path_expr leaves such a name with no type, and its declaration as the node's. It does
    //< so because the left of a `.` (`Row.new()`) is inferred as a value too. What asks for a value
    //< refuses it here (settle_expected in expr.kspl, a comparison's side in binary.kspl).
    if !node.is_path_or_ident()
        return false
    // `Self` inside an `impl` names its target, and resolves to no declaration of its own.
    is_self: =
        node.get_path_or_ident_name().equals("Self") && c.fn_ctx.impl_name.len > 0
    if !is_self &&
        (node.def_node == null || node.def_node.sym_ptr == null ||
        !(Sema_symbol$@::node.def_node.sym_ptr).kind.is_type())
        return false
    $written: = node.get_full_path_str()
    defer written.free()
    c.clear_scratch()
        .s("'\{written.slice()\}' names a type. A type is not a value. Write the value itself, a \
            cast ('\{written.slice()\}::x'), or a member of the type \
            ('\{written.slice()\}.new(…)')")
    c.err(node, c.scratch.slice())
    return true

priv fn report_undefined_path(c: Sema_ctx$@, node: Ast_node$@, fqn_slice: U8[],
    is_file_access: Bool, prefix: U8[], target_name: U8[], certain: Bool)
    if c.has_error_in_fn() || (!certain && fqn_slice.find_str("<|").is_some())
        return
    // A name another file this one imports declares, written without the alias reaching it.
    if !is_file_access
        if reach: = c.alias_reaching(prefix if prefix.len > 0 else target_name)
            c.report_without_alias(node, prefix if prefix.len > 0 else target_name, reach.path)
            return
    c.clear_scratch().s("undefined path or identifier '\{fqn_slice\}'")
    // What could not be resolved is the head segment on a path, and the name itself on a bare name.
    // Advice pointing at `v` when `r.v`'s `r` is missing cannot be acted on.
    unresolved_name: = prefix if prefix.len > 0 else target_name
    // A name missing inside an anonymous function is nearly always a capture attempt, and that
    // advice replaces the general one. A file access (a name the file does not export) is checked
    // first.
    if is_file_access
        c.scratch
            .s("\n  Hint: '\{prefix\}' names a file. The file does not export '\{target_name\}'.")
    else if !c.append_anon_fn_capture_note(unresolved_name) &&
        !c.append_withheld_alias_note(unresolved_name)
        if prefix.len > 0
            if c.env.type_to_id.get(prefix).unwrap_or(0) != 0
                c.scratch
                    .s("\n  Hint: type '\{prefix\}' exists. It has no static member \
                        '\{target_name\}'.\n  Define static methods in 'impl' in the same file as \
                        the struct or enum.")
            else
                c.scratch
                    .s("\n  Hint: The prefix '\{prefix\}' is neither a known import alias nor a \
                        type in the current scope.")
        else
            c.scratch.s("\n  Hint: check for typos or missing imports.")
    c.err(node, c.scratch.slice())
    c.note_undefined_at(node)

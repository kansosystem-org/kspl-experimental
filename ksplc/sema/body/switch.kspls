//< Types a `switch`: its subject, each case's pattern and payload bindings, and exhaustiveness
//<
//< Only a scalar subject is matched (an integer, a `Bool` or an enum). An enum's cases name every
//< variant or end in a `default`, and a non-enum case value is a constant no earlier case names.
//< **A `switch` synthesized from `if v: =` is accepted only on an `Option`.**
import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/sema/body/expr" as sema_body_expr
import "ksplc/sema/body/lint_stmt" as sema_body_lint_stmt
import "ksplc/sema/body/stmt" as sema_body_stmt
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/session/ctx" as sema_session_ctx + { Sema_ctx, Sema_error }
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/ds" { List, Map }
import "std/str"

priv struct Switch_ctx
    target_id: I32
    enum_name: U8[]
    is_enum: Bool
    enum_def: sema_type_def.Enum_def$@
    covered_variants: List<|Ast_node$@|>$@
    bound_vars: List<|Sema_symbol$@|>$@
    seen_values: Map<|I64, Ast_node$@|>$@ //< a non-enum switch's case values so far, by value
    success: Bool

priv fn payload_type_at(variant_def: sema_type_def.Enum_variant$@, idx: Sz): I32 //<
    //< The type of the variant's payload field at idx, `I32` past the last
    if idx < variant_def.payload_fields.len
        return variant_def.payload_fields.get(idx).type_id
    return I32::sema_type_env.Builtin_type_id.i32_type

priv fn check_or_binding(c: Sema_ctx$@, mctx: Switch_ctx$@, bind_var: Ast_node$@,
    expected_sym: Sema_symbol$@, actual_type_id: I32) //<
        //< It binds a name a later OR-pattern arm writes to the first arm's, checking it agrees
        //<
        //< The names and types must match the first arm's, or the body would read a variable that
        //< holds something else depending on which arm matched.
    if !bind_var.text.equals(expected_sym.name)
        c.clear_scratch()
            .s("OR pattern variable name mismatch. Expected '\{expected_sym.name\}', but got \
                '\{bind_var.text\}'")
        c.err(bind_var, c.scratch.slice())
        mctx.success = false
    if actual_type_id != expected_sym.type_id
        exp: = c.env.display(expected_sym.type_id)
        act: = c.env.display(actual_type_id)
        c.clear_scratch()
            .s("OR pattern variable '\{bind_var.text\}' type mismatch. Expected '\{exp\}', but got \
                '\{act\}'")
        c.err(bind_var, c.scratch.slice())
        mctx.success = false
    bind_var.sym_ptr = Void$@::expected_sym
    bind_var.def_node = expected_sym.node
    bind_var.type_id = expected_sym.type_id

impl Ast_node
    fn infer_switch_stmt(r: Ast_node$@, ctx: Sema_ctx$@): Void!Sema_error
        label_node: = r.get_switch_label()
        label_name: = label_node.text if label_node != null else ""
        ctx.jump_stack
            .push(sema_session_ctx.Jump_label::{ .name = label_name, .is_loop = false,
            .name_node = label_node, .stmt = r })
        defer ctx.jump_stack.len -= 1

        cond_node: = r.get_switch_cond()
        r.ice_assert(cond_node != null, "switch statement is missing a condition expression")

        if base_core.config.run_lint_checks && cond_node.was_parenthesized()
            ctx.hint(cond_node, "[H0301] Unnecessary parentheses around 'switch' condition.")
        sema_body_lint_stmt.lint_multiline_call_subject(ctx, cond_node, "switch")

        target_id: = cond_node.infer_expr(ctx, I32::sema_type_env.Builtin_type_id.unknown)!
        // Caution: **Look the enum up with the immutability mark stripped**: `r$` of an `r: Self@`
        // and an immutable binding's copy carry it, and under it no enum is found.
        enum_name: = ctx.env.get_str(ctx.env.get_clean_real_type(target_id))
        enum_def: = ctx.env.get_enum_def(enum_name).unwrap_or(null)

        // A switch synthesized to unwrap an `Option` is accepted only where the subject is one;
        // **otherwise errors mention a `.some` / `.none` the user did not write.** Once expanded it
        // looks ordinary, so the mark identifies it (`synthesized_option_spelling` in
        // `../../base/ast_ext.kspls`). **Name what the user wrote**: the synthesis has several
        // origins.
        spelling: = r.synthesized_option_spelling()
        // Caution: **Apply it to `Option` only**, which has exactly two variants; a user's enum can
        // grow, and then **a new variant silently goes unhandled**.
        // **Check the resolved name, not the written one**, or `typedef Opt = W?` is
        // rejected while a `switch` on the same value passes. The message still names what the user
        // wrote.
        subject_base: = ctx.env.instance_base(ctx.env.get_clean_real_type(target_id))
        if spelling.len > 0 && !subject_base.equals(base_core.option_fqn)
            ctx.clear_scratch()
                .s("'\{spelling\}' binds an 'Option'; '\{enum_name\}' is not one. Use 'switch' and \
                    name every variant, so that adding one later makes this place fail instead of \
                    passing silently")
            ctx.err(cond_node, ctx.scratch.slice())
            throw .analysis_failed

        // Scalars only ("Branching" in docs/SPEC-language.md). **If not rejected, the C compiler
        // reports it**: a slice in C's `switch` is a **raw C error** ("Failing fast through an
        // exception or an ICE" in ksplc/docs/DESIGN.md). The rule exists because comparing a `U8[]`
        // is O(N), which `.equals()` and an `if` show rather than hide behind a branch.
        if enum_def == null && !ctx.env.is_integer(target_id) && !ctx.env.is_bool(target_id) &&
            !sema_type_env.is_unknown(target_id)
            // Show the type as written (`U8[]`), not its C spelling.
            shown: = ctx.env.display(target_id)
            ctx.clear_scratch().s("cannot 'switch' on '").s(shown)
                .s("': only scalars (integers, 'Bool', enums) can be matched. Comparing anything \
                    else hides an O(N) cost behind a branch; use 'if' with '.equals()' instead")
            ctx.err(cond_node, ctx.scratch.slice())
            throw .analysis_failed

        $seen_values: = Map<|I64, Ast_node$@|>.new(null)
        defer seen_values.free()
        $mctx: = Switch_ctx::{ .target_id = target_id, .enum_name = enum_name,
            .is_enum = enum_def != null, .enum_def = enum_def,
            .covered_variants = base_ast.new_ast_node_list(),
            .bound_vars = List<|Sema_symbol$@|>.create(base_core.arena),
            .seen_values = seen_values@, .success = true }

        $has_default: = false

        for $j: Sz = 0; j < r.children.len; j += 1
            child: = r.get_child(j)
            if child.is_keyword("case")
                j = r.infer_switch_case(ctx, mctx@, j + 1)!
            else if child.is_keyword("default")
                has_default = true
                r.infer_switch_default(ctx, mctx@, j + 1)

        if !r.process_switch_exhaustiveness(ctx, enum_name, enum_def, mctx.covered_variants,
            has_default)
            mctx.success = false
        else if base_core.config.run_lint_checks && has_default && enum_def != null
            r.check_redundant_default(ctx, mctx@)

        if !mctx.success
            throw .analysis_failed
    priv fn infer_switch_default(r: Ast_node$@, ctx: Sema_ctx$@, mctx: Switch_ctx$@, start_idx: Sz)
        $def_block: Ast_node$@ = null
        for $k: = start_idx; k < r.children.len; k += 1
            if r.get_child(k).kind_id == .k_stmt_block
                def_block = r.get_child(k)
                break
        if def_block != null
            ctx.symtab.enter_scope()
            defer ctx.symtab.exit_scope()
            def_block.infer_stmts(ctx) catch
                mctx.success = false
    priv fn check_redundant_default(r: Ast_node$@, ctx: Sema_ctx$@, mctx: Switch_ctx$@)
        if mctx.covered_variants.len == mctx.enum_def.variants_list.len
            for child in r.children
                if child.is_keyword("default")
                    ctx.information(child,
                        "[I0304] Redundant 'default' case: all variants of the enum are already \
                            covered.")
                    break

    priv fn infer_switch_case(r: Ast_node$@, c: Sema_ctx$@, mctx: Switch_ctx$@, start_idx: Sz):
        Sz!Sema_error
        $pat_idx: = start_idx
        $target_block: Ast_node$@ = null
        $block_idx: I32 = -1

        for $k: = pat_idx; k < r.children.len; k += 1
            c_node: = r.get_child(k)
            if c_node.kind_id == .k_stmt_block
                target_block = c_node
                block_idx = I32::k
                break
            if c_node.is_keyword("case") || c_node.is_keyword("default")
                break

        mctx.bound_vars.len = 0
        c.symtab.enter_scope()
        defer c.symtab.exit_scope()
        $bound_payload: = false

        for pat_idx < r.children.len
            pat: = r.get_child(pat_idx)
            if pat.kind_id == .k_case_pattern
                bound_payload = pat.infer_case_pattern(c, mctx, bound_payload)!
                pat_idx += 1
            else if pat.is_literal(",")
                pat_idx += 1
            else
                if pat.kind_id == .k_stmt_block || pat.kind_id == .k_keyword
                    break
                pat_type_id: = pat.infer_expr(c, mctx.target_id)!
                if !pat.check_case_pattern_type(c, pat_type_id, mctx.target_id) ||
                    !pat.record_case_value(c, mctx)
                    mctx.success = false
                pat_idx += 1

        if target_block != null
            target_block.infer_stmts(c) catch
                mctx.success = false

        return block_idx if block_idx != -1 else pat_idx - 1

    priv fn infer_case_pattern(r: Ast_node$@, c: Sema_ctx$@, mctx: Switch_ctx$@,
        bound_payload: Bool): Bool!Sema_error
        r.ice_assert(r.children.len > 0, "infer_switch_stmt: case_pattern is empty")
        first_child: = r.get_child(0)
        $processed_as_variant: = false
        $new_bound_payload: = bound_payload

        switch r.extract_case_variant()
        case .variant(v_name_node, p_start_idx)
            if mctx.is_enum
                new_bound_payload = r.process_enum_variant(c, mctx, v_name_node, p_start_idx,
                    new_bound_payload)
                processed_as_variant = true
            else
                if first_child.is_literal(".")
                    c.clear_scratch()
                        .s("target condition '\{mctx.enum_name\}' is not an enum, variant pattern \
                            cannot be used")
                    c.err(first_child, c.scratch.slice())
                    mctx.success = false
                    processed_as_variant = true

            if !processed_as_variant
                r.process_non_enum_pattern(c, mctx, first_child, v_name_node)!
        case .not_variant
            r.process_non_enum_pattern(c, mctx, first_child, null)!
        return new_bound_payload

    priv fn process_enum_variant(r: Ast_node$@, c: Sema_ctx$@, mctx: Switch_ctx$@,
        v_name_node: Ast_node$@, p_start_idx: Sz, bound_payload: Bool): Bool
        $new_bound: = bound_payload

        variant_name: = v_name_node.text if v_name_node != null else ""
        $variant_def: sema_type_def.Enum_variant$@ = null
        if variant_name.len > 0
            if d: = mctx.enum_def.get_variant(variant_name)
                variant_def = d

        if variant_def != null
            if v_name_node != null
                v_name_node.def_node = variant_def.node
                v_name_node.type_id = mctx.target_id
                sema_body_expr.mark_variant_used(c, mctx.enum_name, variant_name)

            // In an OR pattern (.A(x), .B(y)) the first binds; the rest are checked against
            // mctx.bound_vars.
            if !new_bound
                r.bind_variant_payload(c, mctx, variant_def, p_start_idx)
                new_bound = true
            else
                r.verify_variant_payload(c, mctx, variant_def, p_start_idx)

            if v_name_node != null
                record_covered_variant(c, mctx, variant_name, v_name_node)
        else if r.get_child(0).is_literal(".")
            c.clear_scratch().s("enum '\{mctx.enum_name\}' has no variant named '\{variant_name\}'")
            if v_name_node != null
                c.err(v_name_node, c.scratch.slice())
            else
                c.err(r, c.scratch.slice())
            mctx.success = false
        return new_bound

    priv fn bind_variant_payload(r: Ast_node$@, c: Sema_ctx$@, mctx: Switch_ctx$@,
        variant_def: sema_type_def.Enum_variant$@, p_start_idx: Sz)
        $field_idx: Sz = 0
        for $k_b: = p_start_idx; k_b < r.children.len; k_b += 1
            bind_var: = r.get_child(k_b)
            if bind_var.kind_id == .k_identifier
                sym: = Sema_symbol.new(.variable, bind_var.text, bind_var)
                if field_idx < variant_def.payload_fields.len
                    field_def: = variant_def.payload_fields.get(field_idx)
                    sym.type_id = field_def.type_id
                else
                    sym.type_id = I32::sema_type_env.Builtin_type_id.i32_type
                // **The binding carries its type**, or the editor has none to show where it is
                // written. Caution: **Not a `def_node` to itself**: the flow analysis reads that
                // as a use, and an unread binding's [W0207] goes silent.
                bind_var.type_id = sym.type_id
                c.declare_symbol(bind_var.text, sym, false)
                mctx.bound_vars.push(sym)
                field_idx += 1

    priv fn verify_variant_payload(r: Ast_node$@, c: Sema_ctx$@, mctx: Switch_ctx$@,
        variant_def: sema_type_def.Enum_variant$@, p_start_idx: Sz)
        $field_idx: Sz = 0
        $bound_count: Sz = 0

        for $k_b: = p_start_idx; k_b < r.children.len; k_b += 1
            bind_var: = r.get_child(k_b)
            if bind_var.kind_id != .k_identifier
                continue
            bound_count += 1
            if field_idx < mctx.bound_vars.len
                check_or_binding(c, mctx, bind_var, mctx.bound_vars.get(field_idx),
                    payload_type_at(variant_def, field_idx))
            field_idx += 1
        // An OR pattern's later arms may omit the names; then only the payload's count and types
        // are checked against the first arm's.
        if bound_count == 0 && mctx.bound_vars.len > 0
            if variant_def.payload_fields.len != mctx.bound_vars.len
                c.clear_scratch()
                    .s("variant '\{variant_def.name\}' payload count \
                        (\{variant_def.payload_fields.len\}) does not match the captured variables \
                        (\{mctx.bound_vars.len\}) for smart capture")
                c.err(r, c.scratch.slice())
                mctx.success = false
            else
                for $i: = 0; i < mctx.bound_vars.len; i += 1
                    expected_sym: = mctx.bound_vars.get(i)
                    actual_type_id: = variant_def.payload_fields.get(i).type_id
                    if actual_type_id != expected_sym.type_id
                        c.clear_scratch()
                            .s("variant '\{variant_def.name\}' payload type mismatch for smart \
                                capture")
                        c.err(r, c.scratch.slice())
                        mctx.success = false
        else if bound_count != mctx.bound_vars.len
            c.clear_scratch()
                .s("OR pattern variable count mismatch. Expected \{mctx.bound_vars.len\}, but got \
                    \{bound_count\}")
            c.err(r, c.scratch.slice())
            mctx.success = false

    priv fn process_non_enum_pattern(r: Ast_node$@, c: Sema_ctx$@, mctx: Switch_ctx$@,
        first_child: Ast_node$@, v_name_node: Ast_node$@): Void!Sema_error
        $pat_expr: Ast_node$@ = null
        switch r.first_expr()
        case .some(pe)
            pat_expr = pe
        case .none
            pat_expr = first_child
        pat_type_id: = pat_expr.infer_expr(c, mctx.target_id)!
        if !pat_expr.check_case_pattern_type(c, pat_type_id, mctx.target_id) ||
            !pat_expr.record_case_value(c, mctx)
            mctx.success = false
        else if mctx.is_enum && v_name_node != null
            v_name: = v_name_node.text
            if v_name.len > 0
                record_covered_variant(c, mctx, v_name, v_name_node)

    priv fn record_case_value(r: Ast_node$@, c: Sema_ctx$@, mctx: Switch_ctx$@): Bool //<
        //< Whether a non-enum case value is a constant no earlier case names; it reports where not
        //<
        //< Caution: **Compare the folded values, not the spellings**: `'a'` and `97` are one value,
        //< and C refuses the pair ("duplicate case value") where LLVM silently takes the first.
        if mctx.is_enum
            return true
        $v: I64 = 0
        switch c.try_eval_constexpr_wide(r)
        case .some(folded)
            v = folded
        case .none
            c.err(r, "a 'case' value must be a compile-time constant; compare with 'if' instead")
            return false
        earlier: = mctx.seen_values.get(v) catch null
        if earlier != null
            c.clear_scratch().s("the case value \{v\} is already matched by an earlier case")
            c.err(r, c.scratch.slice())
            return false
        mctx.seen_values.set(v, r)
        return true

    fn check_case_pattern_type(r: Ast_node$@, c: Sema_ctx$@, pat_id: I32, cond_id: I32): Bool
        if pat_id != cond_id && !sema_type_env.is_unknown(pat_id) &&
            !sema_type_env.is_unknown(cond_id)
            c.report_type_mismatch(r, cond_id, pat_id)
            return false
        return true

    priv fn matches_both_bools(r: Ast_node$@): Bool //< whether the cases name `true` and `false`
        $seen_true: = false
        $seen_false: = false
        for $i: Sz = 2; i < r.children.len; i += 1
            child: = r.get_child(i)
            if child.kind_id == .k_stmt_block || child.is_keyword("case") ||
                child.is_keyword("default")
                continue
            $pat: = child
            if child.kind_id == .k_case_pattern
                switch child.first_expr()
                case .some(e)
                    pat = e
                case .none
                    continue
            if pat.kind_id == .k_bool
                seen_true = seen_true || pat.text.equals("true")
                seen_false = seen_false || pat.text.equals("false")
        return seen_true && seen_false

    fn process_switch_exhaustiveness(r: Ast_node$@, c: Sema_ctx$@, enum_name: U8$[],
        enum_def: sema_type_def.Enum_def$@, covered_variants: List<|Ast_node$@|>$@,
        has_default: Bool): Bool
        if has_default
            return true
        // A `Bool` has two values, so naming both covers it as naming every variant does.
        if enum_def == null && c.env.is_bool(r.get_switch_cond().type_id) &&
            r.matches_both_bools()
            return true
        if enum_def == null
            c.err(r,
                "switch on non-enum type requires a 'default' case: its values cannot all be listed")
            return false

        $unhandled: Sz = 0
        $first_unhandled: = ""

        for variant_def in enum_def.variants_list
            $is_covered: = false
            for covered_variant in covered_variants
                if covered_variant.text.equals(variant_def.name)
                    is_covered = true
                    break
            if !is_covered
                unhandled += 1
                if first_unhandled.len == 0
                    first_unhandled = variant_def.name

        if unhandled > 0
            c.clear_scratch()
                .s("switch on enum '\{enum_name\}' does not cover all variants. Missing: \
                    '\{first_unhandled\}'")
            if unhandled > 1
                c.scratch.s(" and others")
            c.err(r, c.scratch.slice())
            return false
        return true

priv fn record_covered_variant(c: Sema_ctx$@, mctx: Switch_ctx$@, variant_name: U8[],
    v_name_node: Ast_node$@)
    $already_covered: = false
    for mv_node in mctx.covered_variants
        if mv_node.text.equals(variant_name)
            already_covered = true
            break
    if !already_covered
        mctx.covered_variants.push(v_name_node)
    else
        c.clear_scratch().s("switch pattern '\{variant_name\}' is already covered or duplicated")
        c.err(v_name_node, c.scratch.slice())
        mctx.success = false

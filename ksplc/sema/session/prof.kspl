//< A breakdown of the time sema takes
//< **It is a tool, not a diagnostic**: nothing passes or fails on it (CI's check watches peak
//< memory; `tests/tools/perf_guard.kspl`).
//< **The per-phase total alone is not enough**: it does not name the declaration to fix. So each
//< body is timed too (see "Profiling where Sema's time goes" in `ksplc/docs/DESIGN-sema.md`).
//< **Measure only under `--stats`**: bodies are many, and always-on timing adds every clock read.
import "ksplc/base/ast" as base_ast
import "ksplc/base/core" as base_core
import "ksplc/base/diag" as base_diag
import "ksplc/sema/session/ctx" { Sema_ctx }
import "std/ds" { List, Map }
import "std/io"
import "std/math"
import "std/seq"
import "std/str" { Str_builder }
import "std/strfmt"
import "std/sys"

struct Body_prof_entry //< the tally for one declaration
    //< **It is grouped by the position where it is written** (file plus offset). By name,
    //< **same-named methods of different types** (`new` / `free`) would merge into one line; by
    //< position, a generic's instantiations **share one line** and `calls` counts them.
    name: U8[]
    file: U8[] //< the file as a diagnostic names it, its extension included
    line: Sz //< the line it is written on, from 1, as a diagnostic counts it
    self_us: I64 //< its own time
    calls: I64

struct Sema_prof
    collect_us: I64
    infer_us: I64
    constraints_us: I64
    layouts_us: I64
    priv by_pos: Map<|U8[], Body_prof_entry$@|>
    priv bodies: List<|Body_prof_entry$@|>
    body_count: I64

$prof: Sema_prof = ::{}

priv fn timing_on(): Bool //< whether to measure
    //< **On a target without a usable clock, per-body timing is off** (`sys.timing_available`
    //< false makes every figure 0); the count is still meaningful and is kept separately.
    return base_core.config.enable_stats && sys.timing_available()

impl Sema_prof
    fn init(r: Self$@)
        // Caution: **Recreate both buffers; do not just reset a length to 0.** They live in
        // `base_core.arena`, which the LSP rewinds per request (`wind_back` in
        // ksplc/lsp/state.kspl). So an old buffer points into freed memory, and the first push
        // under `--stats` writes there.
        r$ = Sema_prof::{ .by_pos = Map<|U8[], Body_prof_entry$@|>(base_core.arena),
            .bodies = List<|Body_prof_entry$@|>(base_core.arena) }

    fn body_begin(r: Self$@): I64 //< starts timing one body
        //< Pass what it returns to `body_end` unchanged. Without `--stats` it returns 0.
        // The count is kept separate from the clock (see timing_on).
        if !base_core.config.enable_stats
            return 0
        r.body_count += 1
        if !sys.timing_available()
            return 0
        return sys.mono_us()

    fn body_end(r: Self$@, c: Sema_ctx$@, name: U8[], loc: base_ast.Loc, started_us: I64) //<
        //< adds one body's time to the tally of the declaration written at loc
        if !timing_on()
            return
        self_us: = sys.mono_us() - started_us
        if name.len == 0
            return
        key: = base_core.arena.text().s(loc.file()).c(':').s("\{loc.offset\}").take()
        hit: = r.by_pos.get(key).unwrap_or(null)
        if hit != null
            hit.self_us += self_us
            hit.calls += 1
            return
        e: = base_core.arena
            .create(Body_prof_entry::{ .name = name,
            .file = base_diag.shown_file(loc.file()), .line = c.line_of(loc), .self_us = self_us,
            .calls = 1 })
        r.by_pos.set(key, e)
        r.bodies.push(e)

    fn print_bodies(r: Self$@) //< lists the heaviest declarations first
        //< Caution: **Print `calls` alongside.** A body that is heavy once and a light body
        //< instantiated dozens of times need different fixes.
        //< **One table, ranked by self time, is enough.** A row's time is already the sum over all
        //< of a generic's instantiations (rows are grouped by position). So a generic explosion
        //< that costs time ranks high here, its `calls` large. A table ranked by `calls` alone
        //< added only rows that cost little in total, which are not worth tuning.
        if !timing_on() || r.bodies.len == 0
            return
        ranked: = r.bodies
            .order_by(fn(a: Body_prof_entry$@@, b: Body_prof_entry$@@; ): I32 {
            return base_core.by_descending(a.self_us, b.self_us);
        }, base_core.arena)
        defer $head: = Str_builder()
        head.s("\n[Sema Body] \{Sz::r.body_count:,\} bodies analyzed, ")
            .s("\{r.bodies.len:,\} distinct declarations (Top 20)\n")
        io.err().s(head.slice())
        r.print_rows(ranked, 20)

    priv fn print_rows(_r: Self$@, ranked: List<|Body_prof_entry$@|>, want: Sz) //<
        //< Prints the column header and then at most want of the ranked rows
        //< **The name is that of one instantiation.** Rows are grouped by position, so a line with
        //< `calls` of 2 or more shows one of them. The position is what identifies it.
        io.err().s("      self us      calls  declaration\n")
        limit: = math.min(want, ranked.len)
        for i in Range.asc(limit)
            e: = ranked.get(i)
            defer $sb: = Str_builder()
            sb
                .s("      \{Sz::e.self_us:7,\}\{Sz::e.calls:11,\}  \{e.name\}  \
                    (\{e.file\}:\{e.line\})\n")
            io.err().s(sb.slice())

//< The dataflow analysis of one function body: each local binding's state, through the expressions
//< `analyze_definite_initialization` walks the body once, keeping which locals are initialized and
//< which released, and whether each is read, mutated or reassigned. Branching and merging per
//< statement are in `sema/flow/stmt.kspl`; how a state is reported is in `sema/flow/report.kspl`.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/base/mangle" as base_mangle
import "ksplc/sema/flow/field" as sema_flow_field
import "ksplc/sema/flow/release" as sema_flow_release
import "ksplc/sema/flow/report" as sema_flow_report
import "ksplc/sema/flow/stmt" as sema_flow_stmt
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/arc" as sema_type_arc
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/chars" // testing and slicing single characters
import "std/ds" { List }
import "std/str"

struct Df_set //< the "set of local declaration nodes" the dataflow tracks
    //< One type for sets that differ only in merge direction, so the set operations are written
    //< once. **These structs and Df_ctx belong only to the dataflow's four files**; they are not
    //< priv only because of the file split. From elsewhere, add a function that returns the result
    //< rather than reading them directly.
    items: List<|Ast_node$@|> //< held by value, so a state is one allocation with its sets
    merge_is_intersect: Bool //<
        //< The merge's direction: true = intersection, false = union
        //< Intersection is must, as "initialized"; union is may, as "released or moved".

impl Df_set
    fn new(merge_is_intersect: Bool): Df_set
        return Df_set::{ .items = List<|Ast_node$@|>.new(base_core.arena),
            .merge_is_intersect = merge_is_intersect }

    fn contains(r: Self$@, v: Ast_node$@): Bool //< whether v is held (null never is)
        if v == null
            return false
        for item in r.items
            if item == v
                return true
        return false

    fn add(r: Self$@, v: Ast_node$@)
        if v != null && !r.contains(v)
            r.items.push(v)

    fn remove(r: Self$@, v: Ast_node$@)
        if v == null
            return
        for $i: = 0; i < r.items.len; i += 1
            if r.items.get(i) == v
                r.items.set(i, r.items.get(r.items.len - 1))
                r.items.len -= 1
                return

    fn copy_from(r: Self$@, other: Df_set$@)
        for v in other.items
            r.items.push(v)

    fn fill_merged(r: Self$@, a: Df_set$@, b: Df_set$@) //<
        //< Fills r, an empty set, with a and b merged in r's direction (intersection / union)
        //< Filled in place, so a merge allocates no set beside the new state's own.
        if r.merge_is_intersect
            for v in a.items
                if b.contains(v)
                    r.add(v)
            return
        r.copy_from(a)
        for v in b.items
            r.add(v)

struct Df_state
    init_vars: Df_set //< the initialized locals (must-be-initialized)
    freed_vars: Df_set //< the locals possibly released (may-be-freed, for use-after-free)
    gone_vars: Df_set //<
        //< The released locals possibly with nothing left to give back, not even to `dealloc`
        //< A pointer's `free()` releases what it points at and leaves the block, which only
        //< `dealloc` may name afterwards; every other release puts the local here too.
    moved_vars: Df_set //< the locals possibly moved (may-be-moved, for Move_only)
    carried_vars: Df_set //<
        //< The locals in freed_vars or moved_vars only by way of an earlier pass of a loop
        //< A report on one says so (sema/flow/report.kspl). The line that moved or freed it is
        //< below the use, and without the note the reader looks above it in vain.
    moved_fields: Df_set //<
        //< The field reads that possibly moved a `Move_only` field out of a local (`take(b.m)`)
        //< Each item is the `.` node of that read. Its path is worked out from the node when needed
        //< (field_path_root, field_path_text). That is rare, as few reads move a field.
    reachable: Bool

impl Df_state
    fn new(): Df_state$@
        return base_core.arena
            .create(Df_state::{ .init_vars = Df_set.new(true), .freed_vars = Df_set.new(false),
            .gone_vars = Df_set.new(false), .moved_vars = Df_set.new(false),
            .carried_vars = Df_set.new(false), .moved_fields = Df_set.new(false),
            .reachable = true })

    fn clone(r: Self$@): Df_state$@
        ns: = Df_state.new()
        ns.reachable = r.reachable
        ns.init_vars.copy_from(r.init_vars@)
        ns.freed_vars.copy_from(r.freed_vars@)
        ns.gone_vars.copy_from(r.gone_vars@)
        ns.moved_vars.copy_from(r.moved_vars@)
        ns.carried_vars.copy_from(r.carried_vars@)
        ns.moved_fields.copy_from(r.moved_fields@)
        return ns

    fn apply_merged_state(r: Self$@, merged: Df_state$@) //<
        //< Writes a branch merge's result back into itself
        r$ = merged$

    fn contains(r: Self$@, v: Ast_node$@): Bool
        return r.init_vars.contains(v)

    fn add(r: Self$@, v: Ast_node$@)
        r.init_vars.add(v)

    fn contains_freed(r: Self$@, v: Ast_node$@): Bool
        return r.freed_vars.contains(v)

    fn add_freed(r: Self$@, v: Ast_node$@) //< a release that leaves nothing to give back
        r.freed_vars.add(v)
        r.gone_vars.add(v)
        r.carried_vars.remove(v)

    fn add_contents_freed(r: Self$@, v: Ast_node$@) //< a pointer's `free()`: its block stays
        r.freed_vars.add(v)
        r.carried_vars.remove(v)

    fn remove_freed(r: Self$@, v: Ast_node$@) //<
        //< Clears the released flag once a reassignment (x = ...) has stored a new value
        r.freed_vars.remove(v)
        r.gone_vars.remove(v)
        r.carried_vars.remove(v)

    fn add_moved(r: Self$@, v: Ast_node$@) //< a move on this pass
        r.moved_vars.add(v)
        r.carried_vars.remove(v)

    fn remove_moved(r: Self$@, v: Ast_node$@) //< a new value: the binding is usable again
        r.moved_vars.remove(v)
        r.carried_vars.remove(v)

    fn bind(r: Self$@, v: Ast_node$@, has_value: Bool) //<
        //< A declaration starts a binding afresh: with a value or without, and nothing released
        //< **A loop walks a declaration in its body more than once** (df_stmt_for in
        //< sema/flow/stmt.kspl). So what the last pass did to the binding must not reach this one.
        if has_value
            r.init_vars.add(v)
        else
            r.init_vars.remove(v)
        r.remove_freed(v)
        r.remove_moved(v)
        r.forget_moved_fields(v, null)

    fn forget_moved_fields(r: Self$@, root: Ast_node$@, at: Ast_node$@) //<
        //< Clears the moved fields of `root` at the path `at` or below it, once it holds a value
        //< A null `at`, or a bare name, is the whole binding. The path's text is made only when
        //< something was moved, which is rare.
        if r.moved_fields.items.len == 0
            return
        path: = at.field_path_text() if at != null else ""
        for $i: = r.moved_fields.items.len; i > 0; i -= 1
            m: = r.moved_fields.items.get(i - 1)
            if m.field_path_root().unwrap_or(null) == root &&
                sema_flow_field.path_is_within(m.field_path_text(), path)
                r.moved_fields.remove(m)

struct Local_state
    node: Ast_node$@
    is_read: Bool
    // Mutability has two axes, one per field below ("The two axes of mutability" in
    // docs/SPEC-programming-language.md).
    is_reassigned: Bool //<
        //< The binding axis: the name is given a new value (`x = v` / `x += v`); it decides `$x`.
    is_mutated: Bool //<
        //< The value axis: what the name holds is changed in place
        //< It is also set by a receiver's method call or `@` / `[` / `$` (for W0208 and similar).
    pattern: Ast_node$@ //<
        //< The `case` pattern whose payload binds it, where the user wrote that payload; else null
        //< [I0313] reads it: a pattern none of whose bindings is read needs no payload.

struct Df_ctx
    sema: Sema_ctx$@
    locals: List<|Local_state|>$@
    has_error: Bool
    has_reported_unreachable: Bool
    suppress_move: Bool //<
        //< Set during a read that copies no value, so a Move_only binding's ownership does not move
        //< Such a read is a receiver, or the target of `@` / `$` / `[`.
    pending_defers: List<|Ast_node$@|>$@ //<
        //< The defer bodies the enclosing blocks registered, in the order they were registered
        //< A block analyzes its own at its end, and each early exit those it leaves
        //< (df_stmt_block_scope and df_check_defers_on_exit).
    exit_targets: List<|Df_exit_target|>$@ //<
        //< the statements a `break`, `continue` or `fallback` leaves
    exit_from: Ast_node$@ //< the early exit whose defer bodies are being analyzed, else null
    reported_in_defers: Df_set //< the reads in defer bodies already reported at an early exit
    in_field_path: Bool //<
        //< Set while walking the receivers inside a field path (`b.m.x`)
        //< The moved-field check is made once, for the whole path, at its outermost `.`; a
        //< receiver inside it is not a read of the whole binding.

struct Df_exit_target //< a statement a jump can leave, and the defers registered before it
    stmt: Ast_node$@ //< a `for`, `if`, `switch` or labelled block, or a `catch` for `fallback`
    defers_before: Sz //< pending_defers' length on entering it; leaving runs the bodies past it
    jump_state: Df_state$@ //<
        //< The states merged from the jumps that leave it (`break`, `fallback`), else null
        //< **What follows the statement starts from this as well as from its own end.** A binding
        //< set before every `break` is set after the loop, and one moved before any is moved.
        //< A `for` also merges its condition's exit here.
    continue_state: Df_state$@ //< the states merged from the `continue`s to it, else null

impl Ast_node
    fn get_assign_target_def(r: Self$@): Ast_node$@?
        $curr: = r
        for curr != null
            k: = curr.kind_id
            if k == .k_expr_path || k == .k_identifier || k == .k_type_path
                return .some(curr.def_node)
            if (k == .k_expr_postfix || k == .k_method_access) && curr.children.len > 0
                curr = curr.get_postfix_receiver()
                continue
            if k == .k_expr_primary && curr.children.len > 0
                curr = curr.get_primary_inner_expr()
                continue
            if curr.children.len == 1
                curr = curr.get_child(0)
                continue
            break
        return .none

    fn is_bare_name_target(r: Self$@): Bool //<
        //< Whether an assignment's left-hand side is a "bare name"
        //< `x` / `(x)` are true, `r.f` / `a[i]` / `p$` false: the binding axis versus the value
        //< axis, for [I0601] and the definite-initialization tracking.
        $curr: = r
        if curr != null && curr.kind_id == .k_expr_primary && curr.children.len > 0
            child: = curr.get_child(0)
            if child.is_path_or_ident()
                curr = child
        if curr == null
            return false
        // A path node can hold "a.b"; only a childless one is a bare name.
        return curr.kind_id == .k_identifier ||
            ((curr.kind_id == .k_expr_path || curr.kind_id == .k_type_path) &&
            curr.children.len <= 1)

    fn write_crosses_indirection(r: Self$@, c: Df_ctx$@): Bool //<
        //< Whether the path to the assignment destination crosses a pointer or a slice
        //< A value's field (`v.f = x`) or element does not cross: it writes the binding (the axes
        //< are at Local_state). An unresolved type does not cross either; the only cost is [I0601]
        //< missing a spare `$`.
        if r == null
            return false
        if r.kind_id == .k_expr_primary && r.children.len > 0
            return r.get_primary_inner_expr().write_crosses_indirection(c)
        if r.kind_id != .k_expr_postfix || r.children.len < 2
            return false
        op: = r.get_postfix_op()
        if op == null
            return false
        if op.text.equals("$")
            return true // an explicit dereference
        is_index: = op.text.starts_with("[")
        if !op.text.equals(".") && !is_index
            return false
        recv: = r.get_postfix_receiver()
        if recv == null
            return false
        env: = c.sema.env
        if env.is_pointer(recv.type_id)
            return true
        // An index crosses a slice (the elements are outside the descriptor); `s.ptr = p` writes
        // the descriptor, so it does not.
        if is_index && env.is_slice(recv.type_id)
            return true
        return recv.write_crosses_indirection(c)

    fn is_tracked_local(r: Self$@, c: Df_ctx$@): Bool
        if r == null
            return false
        d_kind: = r.kind_id
        if d_kind == .k_decl_var || d_kind == .k_decl_const || d_kind == .k_fn_param ||
            d_kind == .k_decl_var_item || d_kind == .k_identifier
            for local in c.locals
                if local.node == r
                    return true
        return false

    fn analyze_df_node(r: Self$@, c: Df_ctx$@, state: Df_state$@)
        if r == null
            return
        if !state.reachable
            r.report_unreachable(c)
            return

        switch r.kind_id
        case .k_decl_var, .k_decl_const
            r.df_decl_var(c, state)
        case .k_stmt_expr
            r.df_stmt_expr(c, state)
        case .k_identifier, .k_expr_path, .k_type_path
            r.df_identifier(c, state)
        case .k_expr_catch
            r.df_expr_catch(c, state)
        case .k_method_access
            r.df_method_access(c, state)
        case .k_expr_postfix
            r.df_expr_postfix(c, state)
        case .k_expr_upcast
            r.get_upcast_inner().analyze_as_borrow(c, state)
        case .k_stmt_if, .k_stmt_switch, .k_stmt_labeled_block
            c.enter_exit_target(r)
            if r.kind_id == .k_stmt_if
                r.df_stmt_if(c, state)
            else if r.kind_id == .k_stmt_switch
                r.df_stmt_switch(c, state)
            else if r.children.len > 1
                r.get_labeled_block_inner().analyze_df_node(c, state)
            c.leave_exit_target(state)
            // **A `break` to its label leaves it**, so what follows can run whatever its branches
            // do (`is_left_by_break`, which the missing-return check reads too).
            if r.is_left_by_break()
                state.reachable = true
        case .k_stmt_for
            c.enter_exit_target(r)
            r.df_stmt_for(c, state)
            c.exit_targets.len -= 1
        case .k_stmt_block
            r.df_stmt_block_scope(c, state)
        case .k_stmt_defer
            r.df_stmt_defer(c, state)
        case .k_stmt_return, .k_stmt_throw, .k_stmt_fallback, .k_stmt_break, .k_stmt_continue
            r.df_stmt_return_like(c, state)
        case .k_expr_ternary
            r.df_expr_ternary(c, state)
        default
            r.df_default_traverse(c, state)

    priv fn report_unreachable(r: Self$@, c: Df_ctx$@) //<
        //< [W0201] Warns of a statement nothing reaches, unless one is already reported
        //< Empty statements, blocks, labels and declarations are passed over. The mark points at
        //< the statement's keyword, else at a leading name or literal.
        if r.kind_id == .k_empty || r.kind_id == .k_stmt_block || r.kind_id == .k_stmt_label ||
            r.kind_id == .k_decl_var || r.kind_id == .k_decl_const || c.has_reported_unreachable
            return
        $target_node: = r
        kw: = r.find_child(.k_keyword)
        if kw != null
            target_node = kw
        else if r.children.len > 0
            first: = r.get_child(0)
            if first.kind_id == .k_identifier || first.kind_id == .k_literal
                target_node = first
        c.sema.warn(target_node, "[W0201] Unreachable code detected")
        c.has_reported_unreachable = true

    fn df_expr_ternary(r: Self$@, c: Df_ctx$@, state: Df_state$@)
        if r.children.len == 3
            cond: = r.get_ternary_cond()
            cond.analyze_df_node(c, state)

            state_then: = state.clone()
            r.get_ternary_true().analyze_df_node(c, state_then)

            state_else: = state.clone()
            r.get_ternary_false().analyze_df_node(c, state_else)

            state.apply_merged_state(intersect_states(state_then, state_else))
        else
            r.df_default_traverse(c, state)

    fn df_default_traverse(r: Self$@, c: Df_ctx$@, state: Df_state$@)
        for child in r.children
            child.analyze_df_node(c, state)

    fn df_decl_var(r: Self$@, c: Df_ctx$@, state: Df_state$@)
        id_node: = r.get_var_decl_id()
        expr_node: = r.get_var_decl_expr()
        if id_node != null
            c.add_local(r)
            r.get_var_decl_type_node().df_type_array_sizes(c, state)
            has_value: = expr_node != null && expr_node.kind_id != .k_empty
            if has_value
                expr_node.analyze_df_node(c, state)
            state.bind(r, has_value)

    fn df_type_array_sizes(r: Self$@, c: Df_ctx$@, state: Df_state$@) //<
        //< Walks the array-size expression written in a type annotation (the `n` of `a: I32[n]`)
        //< Without it, an in-function `const` used only as an array size gets a false [W0207]
        //< "unused".
        if r == null
            return
        // The `$` at the head of the postfix's text is stripped first (as in
        // sema/decl/resolve.kspl).
        if r.kind_id == .k_type_postfix && r.children.len > 0
            pt: = r.text.strip_prefix("$")
            if pt.starts_with("[")
                r.get_child(0).analyze_df_node(c, state)
        for child in r.children
            child.df_type_array_sizes(c, state)

    fn df_stmt_expr(r: Self$@, c: Df_ctx$@, state: Df_state$@)
        left: = r.get_assign_left()
        right: = r.get_assign_right()
        op: = r.get_assign_op()

        if right != null
            right.analyze_df_node(c, state)
        if right != null && op != null
            // The definite-initialization tracking only looks at `x = v`.
            is_simple: = left.is_bare_name_target() && op.text.equals("=")
            if def: = left.get_assign_target_def()
                if def != null && def.is_tracked_local(c)
                    // The binding axis is set only for a bare name: `r.f = v` writes the pointee,
                    // which `Self$@` permits (see Local_state), or [I0601] misses a spare `$` on
                    // `r`.
                    if left.write_crosses_indirection(c)
                        c.mark_mutated(def)
                    else
                        c.mark_reassigned(def)
                    if is_simple
                        state.add(def)
                        state.remove_freed(def) // a reassignment makes it a new value, so clear released
                        state.remove_moved(def) // and moved
                        state.forget_moved_fields(def, null)
                        return
            // `x$ = value` overwrites all of what x points at, so the released state up to then can
            // be cleared. x's own initialization state is separate, so init_vars is not touched.
            // Example: `pending_ast.free(); pending_ast$ = next_pending_ast;` in
            // ksplc/gen/c/root.kspl.
            if op.text.equals("=") && left != null && left.kind_id == .k_expr_postfix
                deref_op: = left.get_postfix_op()
                if deref_op != null && deref_op.text.equals("$")
                    deref_def: = left.get_postfix_receiver().get_direct_local_def().unwrap_or(null)
                    state.remove_freed(deref_def)
        if left == null
            return
        if right == null || op == null
            left.analyze_df_node(c, state) // an expression statement, not an assignment
            return
        // Storing a new value in a field makes it usable again, and anything below it.
        if op.text.equals("=")
            if root: = left.owned_field_root(c)
                state.forget_moved_fields(root, left)
        // A place written to is not read as a value, so nothing moves out of it.
        left.analyze_as_borrow(c, state)

    fn df_identifier(r: Self$@, c: Df_ctx$@, state: Df_state$@)
        def: = r.def_node
        if def != null && def.is_tracked_local(c)
            c.mark_read(def)
            sema_flow_report.report_uninit_if_needed(c, state, def, r)
            sema_flow_report.report_freed_if_needed(c, state, def, r)
            sema_flow_report.report_moved_if_needed(c, state, def, r)
            // Read as a whole, the binding must still hold every field (inside a field path, the
            // path's outermost `.` checks only what it reads).
            if !c.in_field_path
                sema_flow_report.report_moved_field_if_needed(c, state, def, r)
            // A Move_only binding read as a value moves, except the borrows under suppress_move
            // (listing the exceptions misses fewer cases than listing the copies).
            if !c.suppress_move && c.sema.env.is_move_only(def.type_id)
                state.add_moved(def)

    fn analyze_as_borrow(r: Self$@, c: Df_ctx$@, state: Df_state$@) //<
        //< Analyzes a child node as "a read that copies nothing", such as a receiver position
        if r == null
            return
        saved: = c.suppress_move
        c.suppress_move = true
        r.analyze_df_node(c, state)
        c.suppress_move = saved

    fn df_expr_catch(r: Self$@, c: Df_ctx$@, state: Df_state$@) //<
        //< Walks `expr catch …`: the expression on both paths, then the failure path apart
        //< What follows starts from the success path, the catch block's end and each `fallback`
        //< (record_jump). Caution: **Walk the expression before the paths part**: walked on the
        //< failure path alone, a move in it is lost wherever that path ends in `return`.
        r.get_catch_chain_expr().analyze_df_node(c, state)
        catch_state: = state.clone()
        $target_block: Ast_node$@ = null
        c.enter_exit_target(r) // the target of a `fallback`
        for i in Range.asc(r.children.len)
            ch: = r.get_child(i)
            if i == 0
                continue
            if ch.kind_id == .k_identifier
                c.add_local(ch)
                catch_state.bind(ch, true)
            else if ch.kind_id == .k_stmt_block
                target_block = ch
                ch.analyze_df_node(c, catch_state)
            else if !ch.is_keyword("catch") && ch.kind_id != .k_literal
                ch.analyze_df_node(c, catch_state)
        if target_block != null
            is_void: =
                sema_type_env.is_void(r.type_id) || sema_type_env.is_unknown(r.type_id)
            if !is_void && catch_state.reachable
                c.sema.err(r, "a 'catch' block must produce a value with 'fallback' or exit")
                c.has_error = true
        state.apply_merged_state(intersect_states(state, catch_state))
        c.leave_exit_target(state)

    fn mark_postfix_receiver_mutated(r: Self$@, c: Df_ctx$@)
        receiver: = r.get_postfix_receiver()
        if def: = receiver.get_assign_target_def()
            if def != null
                c.mark_mutated(def)

    fn mark_value_receiver_reassigned(r: Self$@, c: Df_ctx$@) //<
        //< Sets the binding axis on a method call whose receiver is **a value**
        //< A value is not a pointer or a slice, so a `Self$@` method amounts to writing the binding
        //< itself, as `v.f = x` does. Otherwise [I0601] says "`$` is not needed". A pointer or
        //< slice receiver, or one reached through them (`s[0].m()`, `p.f.m()`), writes the pointee.
        //< A `Self@` or `Self` method writes nothing.
        receiver: = r.get_postfix_receiver()
        if receiver == null
            return
        env: = c.sema.env
        if env.is_pointer(receiver.type_id) || env.is_slice(receiver.type_id) ||
            receiver.write_crosses_indirection(c)
            return
        // An unknown method (none resolved) is taken as writing, so no `$` is called spare.
        member: = r.get_postfix_member()
        if member != null
            switch env.method_receiver_permission(member.def_node)
            case .some(need)
                if !need.mut_ptr
                    return
            case .none {}
        if def: = receiver.get_assign_target_def()
            if def != null
                c.mark_reassigned(def)

    fn get_direct_local_def(r: Self$@): Ast_node$@? //<
        //< The receiver of `.free()` / `.dealloc()`, only where it is a bare identifier
        //< get_assign_target_def would take `r.list.free()` as releasing `r`.
        $curr: = r
        if curr != null && curr.kind_id == .k_expr_primary && curr.children.len > 0
            curr = curr.get_primary_inner_expr()
        if curr != null &&
            (curr.kind_id == .k_identifier || curr.kind_id == .k_expr_path ||
            curr.kind_id == .k_type_path)
            return .some(curr.def_node)
        return .none

    fn get_addressed_local_def(r: Self$@): Ast_node$@? //<
        //< The local's declaration node, where the argument is that bare local or its address
        //< The address is an explicit one, such as the `f@` of `close_it(f@)`.
        //< This lets passing a pointer be tracked across the call (mark_call_freed_args).
        if direct: = r.get_direct_local_def()
            return .some(direct)
        // `f@` and `Void$@::f` are stripped: a real `dealloc(Void$@::p)` almost always casts.
        if r != null && r.kind_id == .k_expr_postfix
            op: = r.get_postfix_op()
            if op != null && (op.text.equals("@") || op.text.equals("::"))
                return r.get_postfix_receiver().get_addressed_local_def()
        return .none

    fn mark_free_call_if_any(r: Self$@, c: Df_ctx$@, state: Df_state$@) //<
        //< Registers a bare local's `.free()` / `.dealloc()` in freed_vars
        //< `r.field.free()` is not tracked, avoiding false positives.
        $freed_expr: Ast_node$@ = null
        $frees_the_pointer: = false
        switch r.get_free_call_receiver(c.sema)
        case .some(rv)
            freed_expr = rv
        case .none
            // The free-function form (`dealloc(x)`).
            if arg: = r.get_free_fn_arg()
                freed_expr = arg
                frees_the_pointer = true
        $def: Ast_node$@ = null
        if freed_expr != null
            if c.sema.env.type_has_drop(freed_expr.type_id)
                if freed_expr.has_drop_parent(c)
                    c.sema
                        .err(freed_expr,
                        "cannot release an automatic field of a type with Drop; replace the field \
                            by assignment")
                    c.has_error = true
                else if freed_expr.owned_field_root(c).is_some()
                    state.moved_fields.add(freed_expr)
            if d: = freed_expr.get_addressed_local_def()
                def = d
        if def != null && def.is_tracked_local(c)
            // A pointer's `free()` releases what it points at; the block stays, for `dealloc`.
            if !frees_the_pointer && c.sema.env.is_pointer(def.type_id)
                state.add_contents_freed(def)
            else
                state.add_freed(def)
            if frees_the_pointer
                r.warn_if_arena_handout(def, c)

    priv fn release_kept_block_if_any(r: Self$@, state: Df_state$@) //<
        //< Lets a `dealloc` name a pointer whose `free()` left its block, before the call is walked
        //< **Giving the block back is not a use of what `free()` released**: `p.free()` then
        //< `dealloc(Void$@::p)` frees a list `create(null)` placed on the heap. The call's own
        //< registration then puts `p` in gone_vars, so any later use is refused, another `dealloc`
        //< included.
        if name: = r.get_dealloc_of_name()
            if d: = name.get_direct_local_def()
                if d != null && state.contains_freed(d) && !state.gone_vars.contains(d)
                    state.freed_vars.remove(d)

    priv fn warn_if_arena_handout(r: Self$@, def: Ast_node$@, c: Df_ctx$@) //<
        //< [W0104] Warns when a pointer an arena handed out is passed to a call that releases it
        //< **Only for the free-function form (`dealloc(x)`).** `x.free()` releases `x`'s
        //< **contents**, which is correct for an arena's container
        //< (`m: = arena.create(Map.new(null))` + `defer m.free()`).
        //< The origin is decided by type; by name alone, another type with that method would be
        //< caught.
        if def.kind_id != .k_decl_var
            return
        kw: = def.safe_get_child(1)
        if kw == null || kw.text.is_mut_binding_kw()
            return
        init: = def.get_var_decl_expr()
        if init == null || !init.is_arena_handout(c.sema)
            return
        c.sema.clear_scratch()
            .s("[W0104] This pointer was handed out by an arena, so it cannot be released here. \
                'Arena.free()' releases all arena memory at once. Releasing one allocation corrupts \
                the heap")
        c.sema.warn(r, c.sema.scratch.slice())

    fn mark_call_freed_args(r: Self$@, c: Df_ctx$@, state: Df_state$@) //<
        //< Marks a bare local argument released where the callee always releases that parameter
        //< The call is `foo(x)`, `obj.m(x)` or `T.m(x)`.
        //< **A method call shifts the parameters by one** (the receiver), or `a` is checked as
        //< self.
        callee: = r.get_postfix_receiver()
        fn_node: = callee.def_node if callee != null else null
        if fn_node == null || fn_node.kind_id != .k_decl_fn
            return
        args_node: = r.find_child(.k_expr_args)
        if args_node == null
            return
        param_list: = fn_node.get_fn_params()
        if param_list == null
            return
        is_method: = callee.kind_id == .k_method_access
        $param_idx: Sz = 0
        for p in base_ast_ext.Param_cursor.new(param_list, false)
            $arg: Ast_node$@ = null
            if given: = sema_flow_release.call_arg_for_param(callee, args_node, param_idx, is_method)
                arg = given
            else
                break
            if fn_node.body_frees_param_directly(p.get_decl_id_text(), c.sema)
                if def: = arg.get_addressed_local_def()
                    if def != null && def.is_tracked_local(c)
                        state.add_freed(def)
            param_idx += 1

    fn df_method_access(r: Self$@, c: Df_ctx$@, state: Df_state$@) //<
        //< Walks a field access's or method call's receiver without counting it as a use as a value
        //< `x.field` does not move x. It does, however, **run the already-released check**.
        //< Caution: **The freed check must not be suppressed along with it here**, even though some
        //< `.free()` only resets a buffer: `p.free(); p.v` / `p.get()` would go undiagnosed.
        if r.children.len > 0
            r.mark_postfix_receiver_mutated(c)
            r.mark_value_receiver_reassigned(c)
        for i in Range.asc(r.children.len)
            child: = r.get_child(i)
            if i == 0
                // Not a move, but still a use of something released (analyze_as_borrow).
                child.analyze_as_borrow(c, state)
            else
                child.analyze_df_node(c, state)
        r.mark_free_call_if_any(c, state)

    priv fn cast_makes_mutable_view(r: Self$@, c: Df_ctx$@): Bool //<
        //< Whether a prefix cast's destination is a writable indirection
        //< That is a mutable slice or a mutable pointer.
        //< **This also sets the binding axis**: without `$` the C declaration is `const`, and a
        //< write through `U8$[]::buf` hits read-only memory.
        ty: = r.get_postfix_member()
        if ty == null
            return false
        env: = c.sema.env
        tid: = ty.type_id
        if !env.is_slice(tid) && !env.is_pointer(tid)
            return false
        return !env.const_elem_of(tid)

    priv fn lends_binding_writable(r: Self$@, c: Df_ctx$@): Bool //<
        //< Whether this `@` / `[` / mutable-view cast hands out the root binding's storage writable
        //< Only the `$` before the name allows that (the binding axis).
        //< **Only a path that crosses no pointer or slice reaches that storage.** Fields and a
        //< fixed-length array's elements are part of the value (see Local_state). A read through
        //< `$`, a `T$@`'s target and a `T$[]`'s elements are written under the type's `$`, so they
        //< leave it out. df_stmt_expr sets a write itself.
        recv: = r.get_postfix_receiver()
        if recv == null || recv.write_crosses_indirection(c)
            return false
        op: = r.postfix_op_text()
        env: = c.sema.env
        // `x@` is a `T$@` only when `x` has the `$`, so the `$` decides what the pointer may do.
        if op.equals("@")
            return true
        // `U8$[]::buf` makes the array's storage writable (without the `$`, its C declaration is
        // `const`); a slice or a pointer cast only views memory elsewhere.
        if op.equals("::")
            return r.cast_makes_mutable_view(c) && !env.is_pointer(recv.type_id) &&
                !env.is_slice(recv.type_id)
        // A pointer's or a slice's element is not the binding's. A fixed-length array's is, and its
        // type follows the `$` even when only read. A trait-object element of an unmarked array
        // reads as immutable, which a `T` slot rejects. A value with its own subscript can run an
        // `at(r: Self$@, …)` on the binding.
        if op.equals("[")
            return !env.is_pointer(recv.type_id) && !env.is_slice(recv.type_id)
        return false

    fn df_expr_postfix(r: Self$@, c: Df_ctx$@, state: Df_state$@)
        op_node: = r.get_postfix_op()
        $op_text: = r.text
        if op_node != null
            op_text = op_node.text
        if op_text.equals("$") && !c.suppress_move && c.sema.env.type_has_drop(r.type_id)
            c.sema
                .err(r,
                "cannot move a Drop value through a borrowed pointer; use mem.take_at to transfer \
                    the slot")
            c.has_error = true
        if op_text.equals("[") && !c.suppress_move && c.sema.env.type_has_drop(r.type_id)
            receiver: = r.get_postfix_receiver()
            if receiver != null && !c.sema.env.is_pointer(receiver.type_id)
                c.sema
                    .err(r, "cannot move a Drop value through an index; borrow the element instead")
                c.has_error = true
        if op_text.equals("@") || op_text.equals("[") || op_text.equals("$") ||
            (op_text.equals("::") && r.cast_makes_mutable_view(c))
            r.mark_postfix_receiver_mutated(c)
            if r.lends_binding_writable(c)
                // Caution: Go back to the root to set it: `arr[0]@` is decided by `$arr`.
                if def: = r.get_postfix_receiver().get_assign_target_def()
                    if def != null
                        c.mark_reassigned(def)
        if op_text.equals(".") && r.children.len > 0
            r.df_field_read(c, state)
        else if op_text.equals("@") || op_text.equals("$") || op_text.equals("[")
            // Address-taking, dereferencing and indexing borrow.
            r.get_postfix_receiver().analyze_as_borrow(c, state)
            for $i: = 1; i < r.children.len; i += 1
                r.get_child(i).analyze_df_node(c, state)
        else
            if op_text.equals("(")
                r.release_kept_block_if_any(state)
            r.df_default_traverse(c, state)
            if op_text.equals("!")
                c.df_check_defers_on_exit(r, state, 0) // the error leaves the function
            if op_text.equals("(")
                // Registers `dealloc(x)` and an argument to a function wrapping a release (one
                // level).
                r.mark_free_call_if_any(c, state)
                r.mark_call_freed_args(c, state)
                r.check_raw_storage_arg(c)

    priv fn check_raw_storage_arg(r: Self$@, c: Df_ctx$@) //< raw storage has no local cleanup flag
        callee: = r.get_postfix_receiver()
        decl: = callee.def_node if callee != null else null
        if decl == null
            return
        name: = c.sema.env.fn_templates.get(Sz::decl).unwrap_or("")
        if !name.equals("std.mem.init_at") && !name.equals("std.mem.take_at") &&
            !name.equals("std.mem.drop_at")
            return
        args: = r.find_child(.k_expr_args)
        if args == null || args.children.len == 0
            return
        arg: = args.get_child(0)
        if arg.kind_id != .k_expr_postfix || !arg.postfix_op_text().equals("@")
            return
        place: = arg.get_postfix_receiver()
        if c.sema.env.type_has_drop(place.type_id) && !place.write_crosses_indirection(c)
            c.sema
                .err(arg,
                "raw-storage operations cannot end a local owner's lifetime; move or assign the \
                    local directly")
            c.has_error = true

fn intersect_states(s1: Df_state$@, s2: Df_state$@): Df_state$@
    if !s1.reachable
        return s2.clone()
    if !s2.reachable
        return s1.clone()
    ns: = Df_state.new()
    ns.reachable = true
    ns.init_vars.fill_merged(s1.init_vars@, s2.init_vars@)
    ns.freed_vars.fill_merged(s1.freed_vars@, s2.freed_vars@)
    ns.gone_vars.fill_merged(s1.gone_vars@, s2.gone_vars@)
    ns.moved_vars.fill_merged(s1.moved_vars@, s2.moved_vars@)
    ns.carried_vars.fill_merged(s1.carried_vars@, s2.carried_vars@)
    ns.moved_fields.fill_merged(s1.moved_fields@, s2.moved_fields@)
    return ns

impl Df_ctx
    fn add_local(r: Self$@, v: Ast_node$@) //<
        //< Starts tracking a local binding, once
        //< A defer body is analyzed at each exit that leaves it, so its declarations come here
        //< again. A second entry would never be marked read, and would be reported unused.
        r.add_bound_local(v, null)

    fn add_bound_local(r: Self$@, v: Ast_node$@, pattern: Ast_node$@) //<
        //< Starts tracking a local, once, which `pattern`'s payload binds where it is not null
        if r.find_local(v) < 0
            r.locals
                .push(Local_state::{ .node = v, .is_read = false, .is_reassigned = false,
                .is_mutated = false, .pattern = pattern })

    fn enter_exit_target(r: Self$@, stmt: Ast_node$@) //<
        //< the matching leave is leave_exit_target
        r.exit_targets
            .push(Df_exit_target::{ .stmt = stmt, .defers_before = r.pending_defers.len,
            .jump_state = null, .continue_state = null })

    fn find_local(r: Self$@, v: Ast_node$@): I32
        if v == null
            return -1
        for i in Range.asc(r.locals.len)
            if r.locals.get(i).node == v
                return I32::i
        return -1

    fn mark_read(r: Self$@, v: Ast_node$@)
        i: = r.find_local(v)
        if i >= 0
            $st: = r.locals.get(i)
            st.is_read = true
            r.locals.set(i, st)

    fn mark_mutated(r: Self$@, v: Ast_node$@) //<
        //< Sets only the value axis (a method call, an application of `@` / `[` / `$`)
        i: = r.find_local(v)
        if i >= 0
            $st: = r.locals.get(i)
            st.is_mutated = true
            r.locals.set(i, st)

    fn mark_reassigned(r: Self$@, v: Ast_node$@) //< sets the binding axis (and the value axis)
        i: = r.find_local(v)
        if i >= 0
            $st: = r.locals.get(i)
            st.is_reassigned = true
            st.is_mutated = true
            r.locals.set(i, st)

fn analyze_definite_initialization(c: Sema_ctx$@, fn_node: Ast_node$@, block: Ast_node$@): Bool
    $ctx: = Df_ctx::{ .sema = c, .locals = List<|Local_state|>.create(base_core.arena),
        .has_error = false, .has_reported_unreachable = false, .suppress_move = false,
        .pending_defers = List<|Ast_node$@|>.create(base_core.arena),
        .exit_targets = List<|Df_exit_target|>.create(base_core.arena), .exit_from = null,
        .reported_in_defers = Df_set.new(false), .in_field_path = false }
    state: = Df_state.new()

    param_list: = fn_node.get_fn_params()
    if param_list != null
        for p in base_ast_ext.Param_cursor.new(param_list, false)
            ctx.add_local(p)
            state.add(p)

    block.analyze_df_node(ctx@, state)

    if !c.suppress_errors
        for local in ctx.locals
            if local.pattern == null || ctx.reads_payload(local.pattern)
                sema_flow_report.check_local_usage(c, local)
            else if ctx.binds_first(local)
                sema_flow_report.report_unread_payload(c, local.pattern)
    return !ctx.has_error

impl Df_ctx
    fn reads_payload(r: Self$@, pattern: Ast_node$@): Bool //< whether any binding of it is read
        for local in r.locals
            if local.pattern == pattern && local.is_read
                return true
        return false

    fn binds_first(r: Self$@, st: Local_state): Bool //< whether `st` is its pattern's first binding
        for local in r.locals
            if local.pattern == st.pattern
                return local.node == st.node
        return false

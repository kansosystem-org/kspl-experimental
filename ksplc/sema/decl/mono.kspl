//< Monomorphization: makes a generic type's or function's instance, once per type arguments
//<
//< `instantiate_struct` and `instantiate_fn` take the template's FQN, copy its tree, bind the type
//< arguments and register the instance; an instance already made is returned as it is. The
//< instance's method table and trait conformance are queued (`sema/decl/mono_queue.kspl`), and
//< the copied tree is rewritten by `sema/decl/subst.kspl`.
import "ksplc/base/ast" { Ast_node, is_anon_env_type }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/base/mangle" as base_mangle
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/decl/mono_name" as sema_decl_mono_name
import "ksplc/sema/decl/mono_queue" as sema_decl_mono_queue
import "ksplc/sema/decl/mono_target" as sema_decl_mono_target
import "ksplc/sema/decl/name" as _sema_decl_name
import "ksplc/sema/decl/registry" as sema_decl_registry
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/decl/subst" as sema_decl_subst
import "ksplc/sema/decl/trait_check" as sema_decl_trait_check
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error, join_dotted_name }
import "ksplc/sema/session/state" as sema_session_state
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/naming" as sema_type_naming
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" as sema_type_scope + { Sema_symbol }
import "std/chars"
import "std/ds" { List }
import "std/str" { Str_builder }
import "std/strnum"

struct Mono_state_backup //<
    //< The shared state an instantiation rewrites, saved around a nested one
    //<
    //< Without restoring r.generics.args / r.file_name / r.fn_ctx.impl_name, an inner instantiation
    //< corrupts the outer one's.
    generic_args_depth: Sz
    file_name: U8[]
    current_impl: U8[]

priv const max_mono_depth: Sz = 128 //< the limit on instantiate_struct's recursive call depth
    //<
    //< A cycle hits instantiated_nodes' cache (register_inst_node); a non-cycling chain (A<|T|>
    //< embedding B<|T|>, B embedding C, ...) does not.
    //< Caution: **Set it to twice the depth the language guarantees** (`generic_nesting` in
    //< `tests/suite/limits_test.kspl`).

fn check_written_generic_arity(c: Sema_ctx$@, tmpl_node: Ast_node$@, arg_count: Sz,
    site: Ast_node$@) //<
        //< Checks the count of type arguments **written** as `<|...|>` against the declaration
        //<
        //< **Count only the written ones:** an inferred list can be longer than the declaration's
        //< (`f<|K|>` taking a `Map<|K, Symbol$@|>`). A short count reaches C as `unknown type name
        //< 'U'` ("Failing fast through an exception or an ICE" in ksplc/docs/DESIGN-compiler.md).
    if written_generic_arity_matches(tmpl_node, arg_count)
        return
    param_count: = count_generic_params(tmpl_node.find_child(.k_type_gen_params))
    name: = tmpl_node.get_decl_id_text()
    direction: = "too many" if arg_count > param_count else "too few"
    c.clear_scratch()
        .s("\{direction\} type arguments for generic '\{name\}': it declares \{param_count\}, but \
            \{arg_count\} given")
    c.err(site, c.scratch.slice())

fn written_generic_arity_matches(tmpl_node: Ast_node$@, arg_count: Sz): Bool //<
    //< Whether the written type arguments are as many as the declaration's (or it declares none)
    if tmpl_node == null
        return true
    params_node: = tmpl_node.find_child(.k_type_gen_params)
    if params_node == null
        return true
    return count_generic_params(params_node) == arg_count

priv fn count_generic_params(params_node: Ast_node$@): Sz //<
    //< The number of type parameters the template declared
    $n: Sz = 0
    for p in params_node.children
        if _id: = p.gen_param_id_node()
            n += 1
    return n

fn prepare_inst_node(c: Sema_ctx$@, tmpl_node: Ast_node$@, inst_name: U8[], args: I32[]):
    Ast_node$@
    inst_node: = tmpl_node.clone()
    if tmpl_node != null
        c.set_current_file(tmpl_node.loc.file())
        inst_node.propagate_loc_file(tmpl_node.loc.file())
    id_node: = inst_node.find_child(.k_identifier)
    params_node: = inst_node.find_child(.k_type_gen_params)

    // Which instantiation a constraint violation belongs to, while the bindings are in force
    // (constraint_failed in sema/session/state.kspl).
    prev_inst_name: = c.mono.current_inst_name
    c.mono.current_inst_name = base_core.arena.dup_str(inst_name)
    c.bind_generic_args(params_node, args, true)
    c.mono.current_inst_name = prev_inst_name
    if params_node != null
        params_node.morph(.k_empty, "")
    if id_node != null
        id_node.text = base_core.arena.dup_str(inst_name)
    inst_node.replace_type_vars(c)
    return inst_node

impl Sema_ctx
    // Finds a cached instance or clones the AST; on none, the caller returns inst_name unchanged.
    fn try_prepare_instance(r: Self$@, base_name: U8[], full_inst_name: U8[], inst_name: U8[],
        args: I32[]): Ast_node$@?
        // Caution: Look up the mangled-name key too. The literal text `Base<|args|>` varies with
        // qualification, and the same instance created twice fails in C with `redefinition of ...`.
        cached_inst: = r.env.instantiated_nodes.get(full_inst_name)
            catch (r.env.instantiated_nodes.get(inst_name) catch null)
        tmpl_node: = r.generics.templates.get(base_name) catch null
        if cached_inst != null || tmpl_node == null
            return .none
        inst: = prepare_inst_node(r, tmpl_node, inst_name, args)
        return .some(inst)

    priv fn declare_inst_trait_method(r: Self$@, inst_name: U8[], m_sym: Sema_symbol$@) //<
        //< Adds an instantiated trait's methods to the name table as `<instantiation>.<method>`
        //<
        //< **Named the same way as for a non-generic trait**
        //< Caution: declare_symbol_with_fqn cannot be used: during an expression's inference
        //< (scopes pushed) the entry is lost when the scope is left. A `priv` method is added too;
        //< hidden here, its return type is lost silently (check_visibility_and_mark_used handles
        //< visibility).
        full_name: = join_dotted_name(inst_name, m_sym.name)
        m_sym.flags.is_global = true
        r.symtab.by_fqn.set(full_name, m_sym)
        r.symtab.global_scope.set(base_core.pools.intern_name(full_name), m_sym)
        // Caution: Set the back-link from the declaration node to the symbol too (as define_symbol
        // in scope.kspl does). call.kspl reads "no sym_ptr" as a generic template, and the output
        // calls a slot `call_<type argument>` that is not in the vtable.
        m_sym.node.sym_ptr = Void$@::m_sym

    fn slice_type_of(r: Self$@, elem_id: I32): I32 //< makes one slice type
        //<
        //< Caution: **Code that synthesizes a slice type must go through here** (a string literal's
        //< type, the reflection table). **Return unknown if the instantiation fails** (it is
        //< reported).
        $inst: = r.instantiate_struct(base_core.slice_fqn, I32[]::{ elem_id }) catch
            return I32::sema_type_env.Builtin_type_id.unknown
        defer inst.free()
        return r.env.get_or_add(base_core.arena.dup_str(inst.slice()))

    fn instantiate_struct(r: Self$@, base_name: U8[], args: I32[]): Str_builder!Sema_error //<
        //< Makes the instance of the generic type base_name (an FQN) binding args, once
        //<
        //< It returns the instance's mangled name, derived from its record (`Instance` in
        //< `../type/env.kspl`), as is its registration key.
        inst_rec: = sema_type_env.Instance::{ .template = base_name, .args = args }
        $args_text: = Str_builder.new()
        defer args_text.free()
        r.env.type_args_to(args, args_text)
        if sema_decl_mono_name.contains_unknown(args_text.slice())
            return sema_decl_mono_name.unknown_type_str()
        // An instance with immutability at a position that declares variance **shares its C
        // representation with the plain instance**.
        // Caution: **Create the plain instance first**; this one uses its C name (see
        // variance_stripped in `../type/env.kspl`). It is not in the output (register_inst_node).
        $shares_c_repr: = false
        if plain_rec: = r.env.strip_variance(inst_rec)
            shares_c_repr = true
            $plain: = r.instantiate_struct(base_name, plain_rec.args)!
            plain.free()
        $inst_name: = Str_builder.new()
        r.env.instance_c_name_to(inst_rec, inst_name)
        $full_inst_name: = Str_builder.new()
        defer full_inst_name.free()
        r.env.instance_key_to(inst_rec, full_inst_name)

        $backup: = r.backup_mono_state()
        full_inst_name_str: = full_inst_name.slice()
        inst_name_str: = inst_name.slice()
        prepared: = r.try_prepare_instance(base_name, full_inst_name_str, inst_name_str, args)
        $inst_node: Ast_node$@ = null
        switch prepared
        case .some(in_node)
            inst_node = in_node
        case .none
            return inst_name

        r.mono.mono_depth += 1
        defer r.mono.mono_depth -= 1
        if r.mono.mono_depth > max_mono_depth
            r.err(inst_node,
                "generic type instantiation chain too deep (possible unbounded recursive generic \
                    type)")
            throw .analysis_failed

        arena_inst_name: = base_core.arena.dup_str(inst_name.slice())

        is_trait: = inst_node.kind_id == .k_decl_trait
        is_enum: = inst_node.kind_id == .k_decl_enum
        sym_kind: =
            (sema_type_scope.Sym_kind.trait_def if is_trait
            else (sema_type_scope.Sym_kind.enum_def if is_enum
            else sema_type_scope.Sym_kind.struct_def))

        sym: = Sema_symbol.new(sym_kind, arena_inst_name, inst_node)
        sym.vis = inst_node.get_visibility()
        sym.flags.is_generated_instance = true
        sym.flags.is_global = true
        inst_node.sym_ptr = Void$@::sym
        sym.type_id = r.env.get_or_add(arena_inst_name)
        inst_node.type_id = sym.type_id // bind the type ID onto the AST node to resolve dependencies
        inst_id: = base_core.pools.intern_name(arena_inst_name)
        r.symtab.global_scope.set(inst_id, sym)

        r.register_inst_node(full_inst_name.slice(), inst_name.slice(), inst_node, !shares_c_repr)
        // Recorded here, so what the instance is made of is read from its type id at O(1).
        r.env.note_instance(sym.type_id, inst_rec)

        if is_trait
            trait_def: = sema_type_def.Trait_def.new()
            entry: = r.env.id_to_type.get(sym.type_id)
            entry.info = .trait_type(trait_def)

            trait_vis: = sym.vis
            for m_node in inst_node.children
                // A method with a default body is handled the same way (as in registry.kspl).
                if m_node.kind_id == .k_decl_fn_proto || m_node.kind_id == .k_decl_fn
                    m_sym: = r.add_trait_method(m_node, trait_def, trait_vis)!
                    if m_sym != null
                        r.declare_inst_trait_method(arena_inst_name, m_sym)
        else if is_enum
            // A generic enum: the substituted clone's variants resolve under generics.args, as a
            // plain enum's do.
            enum_def: = sema_type_def.Enum_def
                .new(I32::sema_type_env.Builtin_type_id.i32_type)
            inst_node.fill_enum_variants(r, enum_def, sym.type_id, false)!
            entry: = r.env.id_to_type.get(sym.type_id)
            entry.info = .enum_type(enum_def)
            r.queue_instance_methods(sym.type_id, arena_inst_name)
        else
            struct_def: = sema_type_def.Struct_def.new()
            inst_node.fill_struct_fields(r, struct_def)!
            entry: = r.env.id_to_type.get(sym.type_id)
            entry.info = .struct_type(struct_def)
            r.queue_instance_methods(sym.type_id, arena_inst_name)

        r.restore_mono_state(backup@)
        return inst_name

    fn backup_mono_state(r: Self$@): Mono_state_backup
        return Mono_state_backup::{
            .generic_args_depth = r.generics.args.len,
            .file_name = r.file_name,
            .current_impl = r.fn_ctx.impl_name,
        }

    fn restore_mono_state(r: Self$@, b: Mono_state_backup$@)
        r.set_current_file(b.file_name)
        r.fn_ctx.impl_name = b.current_impl
        r.generics.args.len = b.generic_args_depth

    fn register_inst_node(r: Self$@, full_name: U8$[], mangled_name: U8$[], node: Ast_node$@,
        emit: Bool) //<
            //< Registers under both full_name (`Base<|args|>`) and the mangled name
            //<
            //< It pushes onto instantiated_nodes_list once: the backends emit a definition per
            //< entry. `emit` false: it **shares its C representation with another instance**
            //< (variance), so no definition is emitted.
        r.env.instantiated_nodes.set(base_core.arena.dup_str(full_name), node)
        if !mangled_name.equals(full_name)
            r.env.instantiated_nodes.set(base_core.arena.dup_str(mangled_name), node)
        if emit
            r.env.instantiated_nodes_list.push(node)

    fn bind_generic_args(r: Self$@, params_node: Ast_node$@, args: I32[], check_constraints: Bool) //<
        //< Binds the type arguments.
        //<
        //< check_constraints says whether this is **the instantiation's first binding**.
        //< Caution: **Pass false on a path that only rebinds**: the check's resolve_type caches
        //< its result in the node's type_id.
        if params_node == null
            return
        $p_idx: Sz = 0
        for p in params_node.children
            $param_id_node: Ast_node$@ = null
            switch p.gen_param_id_node()
            case .some(id_node)
                param_id_node = id_node
            case .none
                continue
            $constraint_node: Ast_node$@ = null
            is_const_param: = p.is_const_gen_param()

            if p.kind_id == .k_type_gen_param
                constraint_node = p.find_child(.k_type_constraint)

            if p_idx < args.len
                k_id: = r.env.get_or_add(param_id_node.text)
                a_id: = args[p_idx]
                r.generics.args
                    .push(sema_session_state.Generic_arg::{ .param_name_id = k_id,
                    .bound_type_id = a_id, .is_const = is_const_param })
                if is_const_param && check_constraints
                    r.check_const_arg(p, param_id_node.text, r.env.get_str(a_id))
                if constraint_node != null && check_constraints
                    // While suppressed, check_type_constraint does not decide but records and
                    // returns (Pending_constraint in sema/session/state.kspl).
                    constraint_node.check_type_constraint(r, a_id) catch {}
                p_idx += 1

    priv fn check_const_arg(r: Self$@, param: Ast_node$@, name: U8[], value: U8[]) //<
        //< Refuses a value type argument its `const` parameter's type does not hold, at the use
        //<
        //< Caution: **Check it here, at the instantiation's first binding**: inside the instance a
        //< diagnostic hanging on a type argument is not emitted, so `Ring<|3000000000|>` for
        //< `const n: I32` was truncated in silence, and `Ring<|true|>` was reported inside the
        //< body.
        type_node: = param.find_child(.k_type_expr)
        if type_node == null
            return
        t_id: = type_node.resolve_type(r) catch 0
        if t_id == 0 || sema_type_env.is_unknown(t_id)
            return
        is_bool_value: = value.equals("true") || value.equals("false")
        $fits: = r.env.is_bool(t_id) == is_bool_value
        if fits && !is_bool_value && r.env.is_integer(t_id)
            v: = value.to_i64() catch 0
            bits: = r.env.get_portable_bit_size(t_id)
            fits = sema_decl_eval.wrap_to(v, bits, r.env.is_unsigned(t_id)) == v
        if fits
            return
        shown: = r.env.display(t_id)
        r.clear_scratch()
            .s("type argument '\{value\}' does not fit 'const \{name\}: \{shown\}'; pass a value ")
            .s("of that type")
        site: = r.generics.inst_site if r.generics.inst_site != null else param
        r.err(site, r.scratch.slice())
        r.mark_constraint_failed()

    priv fn record_trait_inst(r: Self$@, target_id: I32, trait_id: I32, impl_node: Ast_node$@) //<
        //< Records an instantiated generic impl's trait conformance
        //<
        //< lower builds the thunks and the vtable from it (Trait_inst in sema/session/state.kspl).
        //< The key rejects a second pair (a vtable redefinition).
        key: = r.clear_scratch().s("\{target_id\}:\{trait_id\}").slice()
        if r.mono.trait_inst_seen.get(key) catch false
            return
        r.mono.trait_inst_seen.set(base_core.arena.dup_str(key), true)
        r.generics.trait_insts
            .push(sema_session_state.Trait_inst::{ .target_id = target_id, .trait_id = trait_id,
            .loc_node = impl_node })

    // Registers an `impl<|T|> Foo<|T|>: Trait` against the instantiated type target_id (inst_name
    // is its mangled name). Skipped where a constraint failed, so as not to bury the real
    // diagnostic.
    // Caution: **Do not defer it**: indexing, upcasting and constraints read it; deferred, `a[i]`
    // degrades to a plain array index and an `emit_postfix_array` ICE.
    fn register_generic_trait_impls(r: Self$@, target_id: I32, inst: sema_type_env.Instance,
        inst_name: U8[], with_table: Bool): Void!Sema_error
        // **Restore the current file on the way out**, or the caller's visibility is checked as if
        // in the impl's file.
        entry_file: = r.file_name
        defer r.set_current_file(entry_file)
        for generic_impl in r.generics.impls
            if r.has_failed_constraint(inst_name)
                break
            if !r.generic_impl_applies(generic_impl, inst)
                continue
            if trait_node: = generic_impl.get_impl_trait_node()
                inst_trait: = trait_node.clone()
                r.set_current_file(generic_impl.loc.file())
                inst_trait.propagate_loc_file(generic_impl.loc.file())
                inst_trait.replace_type_vars(r)
                trait_id: = inst_trait.resolve_type(r) catch 0
                if trait_id != 0 && !sema_type_env.is_unknown(trait_id)
                    r.env.add_implemented_trait(target_id, trait_id)
                    // Caution: **Record the thunks only once the table exists.** It is lower's
                    // only source for the vtable, which would name a function with no instance.
                    if with_table
                        r.verify_trait_implementation(target_id, trait_id, inst_trait)
                        r.record_trait_inst(target_id, trait_id, generic_impl)
                    // **`Index_place` promises a writable place**, confirmed per instance since
                    // a type argument can carry the immutability. The trait's record names its
                    // template.
                    trait_tmpl: = r.env.instance_base(r.env.get_real_type(trait_id))
                    if trait_tmpl.ends_with("Index_place")
                        r.reject_const_index_place(target_id, inst_trait)

    priv fn generic_impl_applies(r: Self$@, generic_impl: Ast_node$@,
        inst: sema_type_env.Instance): Bool //<
            //< Whether a generic impl covers the instance inst
            //<
            //< Its target must name inst's template and its marks accept inst's arguments
            //< (impl_target_rejects in mono_target.kspl), or a mutable-only impl's methods and
            //< trait reach the immutable instance.
        target_node: = generic_impl.get_decl_type_node()
        if target_node == null
            return false
        $raw_target_type: = target_node.extract_type_name()
        defer raw_target_type.free()
        // Resolve the FQN in the impl block's file, or another file's impl resolves without its
        // import table.
        prev_file: = r.file_name
        r.set_current_file(generic_impl.loc.file())
        target_fqn: = r.impl_target_fqn(generic_impl)
        r.set_current_file(prev_file)
        if !target_fqn.equals(inst.template)
            return false
        return !sema_decl_mono_target.impl_target_rejects(r, generic_impl,
            raw_target_type.slice(), inst.args, r.variance_mask_of(inst.template))

    fn instantiate_generic_methods(r: Self$@, type_id: I32, inst: sema_type_env.Instance,
        site: Ast_node$@): Void!Sema_error //<
            //< Instantiates the methods the generic impls give `inst`, and queues their bodies
            //<
            //< `site` is what the user wrote that made the instance, or null.
        inst_nodes: = List<|Ast_node$@|>.create(base_core.arena)
        inst_shown: = List<|U8[]|>.create(base_core.arena) // each one's name, for a diagnostic
        real_id: = r.env.get_real_type(type_id)
        t_entry: = r.env.id_to_type.get(real_id)
        // A defer fires on a continue too.
        for generic_impl in r.generics.impls
            if !r.generic_impl_applies(generic_impl, inst)
                continue
            impl_gen_params: = generic_impl.find_child(.k_type_gen_params)
            for m_node in generic_impl.children
                if m_node.kind_id != .k_decl_fn
                    continue
                m_name: = m_node.find_text(.k_identifier)
                if m_name.len == 0
                    continue
                // Caution: **Do not add a method with its own type parameters to the table.** Only
                // the call site decides `U` (instantiate_fn below, and "A type argument with
                // nothing to bind to is rejected" in docs/DESIGN-language.md).
                if sema_decl_mono_name.introduces_own_generic_param(m_node, impl_gen_params)
                    continue
                // skip_infer=true: the loop below queues the bodies on pending.
                $inst_m_name: = r.instantiate_fn(Fn_instance::{ .template =
                    join_dotted_name(inst.template, m_name), .owner = type_id,
                    .args = I32[]::{} }, true)!
                defer inst_m_name.free()
                arena_inst_m_name: = base_core.arena.dup_str(inst_m_name.slice())

                m_id: = base_core.pools.intern_name(arena_inst_m_name)
                m_sym_res: = r.symtab.global_scope.get(m_id) catch null
                if m_sym_res == null
                    continue
                arena_short: = base_core.arena.dup_str(m_name)
                if t_entry != null
                    t_entry.add_method(arena_short, m_sym_res)
                inst_nodes.push(m_sym_res.node)
                // **A closure's body is part of the function that writes it**: its environment's
                // name is the compiler's, so it names no instantiation (`instance_notes` in ctx).
                inst_shown
                    .push("" if is_anon_env_type(inst.template)
                    else base_core.arena.text().s(r.env.display(type_id)).c('.').s(m_name).take())

        impl_name: = r.env.get_str(type_id)

        // Queued on pending, not inferred here (the reason is at instantiate_fn below).
        // Caution: **Queue it at the same depth as the table** (not 0); what the body instantiates
        // is one level deeper (inst_chain_depth in sema/session/state.kspl).
        for i in Range.asc(inst_nodes.len)
            r.queue_fn_body(inst_nodes.get(i), base_core.arena.dup_str(impl_name),
                r.generics.inst_chain_depth, inst_shown.get(i), site)

    priv fn fn_instance_names(r: Self$@, fi: Fn_instance, owner: Fn_owner, key: Str_builder$@,
        c_name: Str_builder$@) //<
            //< Derives a function instance's registration key and mangled name from its record
            //<
            //< One name per shape: `app.gf<|U16|>` / `app_gf_U16` (a free function, a plain type's
            //< method), `app_Box_I64<|U16|>.gm` / `app_Box_I64_gm_U16` (an instance's method with
            //< its own), `app.Box<|I64|>.get` / `app_Box_I64_get` (an instance's method with none).
            //< Caution: **Name a function instance through here only**: two spellings, two copies.
        switch owner
        case .free
            key.s(fi.template).s("<|")
            r.env.type_args_to(fi.args, key)
            key.s("|>")
            r.env
                .instance_c_name_to(sema_type_env.Instance::{ .template = fi.template,
                .args = fi.args }, c_name)
        case .own_args(type_name)
            key.s(type_name).s("<|")
            r.env.type_args_to(fi.args, key)
            key.s("|>.").s(fn_method_name(fi))
            c_name.s(type_name).s("_")
            r.env
                .instance_c_name_to(sema_type_env.Instance::{ .template = fn_method_name(fi),
                .args = fi.args }, c_name)
        case .type_args(type_name, type_template, type_args)
            key.s(type_template).s("<|")
            r.env.type_args_to(type_args, key)
            key.s("|>.").s(fn_method_name(fi))
            c_name.s(type_name).s("_").s(fn_method_name(fi))

    priv fn fn_owner_of(r: Self$@, fi: Fn_instance): Fn_owner!Sema_error //<
        //< Which of fn_instance_names's shapes fi has, its type instantiated where it must be
        //<
        //< A method of a generic type's instance binds that instance's arguments: with its own
        //< type arguments as well, to the type's parameters; without, to the impl's, which its
        //< template carries (`collect_impl_decl` in collect.kspl copies them in).
        type_fqn: = fn_type_fqn(fi)
        type_tmpl: = r.generics.templates.get(type_fqn) catch null
        if type_tmpl == null
            return .free
        if fi.owner != 0
            if inst: = r.env.instance_of(fi.owner)
                type_name: = r.env.get_str(fi.owner)
                m_tmpl: = r.generics.templates.get(fi.template) catch null
                if m_tmpl != null &&
                    sema_decl_mono_name.introduces_own_generic_param(m_tmpl,
                    type_tmpl.find_child(.k_type_gen_params))
                    return .own_args(type_name)
                return .type_args(type_name, inst.template, inst.args)
        // Reached through the template's own name, the type arguments are the call's.
        $tmp_b: = r.instantiate_struct(type_fqn, fi.args)!
        type_name: = base_core.arena.dup_str(tmp_b.slice())
        tmp_b.free()
        return .type_args(type_name, type_fqn, fi.args)

    fn instantiate_fn(r: Self$@, fi: Fn_instance, skip_infer: Bool): Str_builder!Sema_error //<
        //< Makes the instance fi records of a generic function or method, once
        //<
        //< It returns the instance's mangled name (fn_instance_names derives it). The signature is
        //< resolved at once; the body joins the work list (`queue_fn_body`) unless skip_infer.
        $bound_text: = Str_builder.new()
        defer bound_text.free()
        r.env.type_args_to(fi.args, bound_text)
        if sema_decl_mono_name.contains_unknown(bound_text.slice())
            return sema_decl_mono_name.unknown_type_str()
        owner: = r.fn_owner_of(fi)!
        // The type arguments the template's own parameters bind: a table's method binds its
        // type's.
        $bound_args: I32[] = fi.args
        switch owner
        case .type_args(_n, _t, type_args)
            bound_args = type_args
        default {}
        $is_method: = false
        $struct_inst_name_str: U8[] = ""
        // Caution: **A dotted template counts as a method**, a free function's FQN too: its
        // signature is resolved with `Self` standing for what precedes the last dot, as every
        // function instance's always was.
        if fi.template.rfind_char_out('.') >= 0
            is_method = true
            struct_inst_name_str = fn_type_fqn(fi)
        switch owner
        case .own_args(type_name)
            struct_inst_name_str = type_name
        case .type_args(type_name, _t, _a)
            struct_inst_name_str = type_name
        default {}

        $inst_name: = Str_builder.new()
        $full_inst_name: = Str_builder.new()
        defer full_inst_name.free()
        r.fn_instance_names(fi, owner, full_inst_name@, inst_name@)

        $backup: = r.backup_mono_state()
        switch owner
        case .own_args(_n)
            // Bind the type's own parameters from the instance's record, for this call only (the
            // struct's instantiation left generics.args long ago); restore_mono_state undoes it.
            if inst: = r.env.instance_of(fi.owner)
                type_tmpl: = r.generics.templates.get(inst.template) catch null
                struct_gen_params: =
                    type_tmpl.find_child(.k_type_gen_params) if type_tmpl != null else null
                if struct_gen_params != null
                    r.bind_generic_args(struct_gen_params, inst.args, false)
        default {}
        fin_s: = full_inst_name.slice()
        in_s: = inst_name.slice()
        prepared: = r.try_prepare_instance(fi.template, fin_s, in_s, bound_args)
        $inst_node: Ast_node$@ = null
        switch prepared
        case .some(in_node)
            inst_node = in_node
        case .none
            return inst_name
        // The depth of the instantiation chain. The call depth (mono_depth) cannot catch this (the
        // reason is at inst_chain_depth in sema/session/state.kspl).
        chain_depth: = r.generics.inst_chain_depth + 1
        if chain_depth > max_mono_depth
            r.err(inst_node,
                "generic function instantiation chain too deep (possible unbounded recursive \
                    generic function)")
            throw .analysis_failed
        r.register_inst_node(full_inst_name.slice(), inst_name.slice(), inst_node, true)

        arena_inst_name: = base_core.arena.dup_str(inst_name.slice())

        sym_kind: = sema_type_scope.Sym_kind.function(false)
        sym: = Sema_symbol.new(sym_kind, arena_inst_name, inst_node)
        sym.vis = inst_node.get_visibility()
        sym.flags.is_method = is_method
        sym.flags.is_generated_instance = true
        sym.flags.is_global = true
        inst_node.sym_ptr = Void$@::sym

        // Caution: **Resolve the signature's types here**, where the bindings are in force, the
        // return type first. **Set `Self`'s target before either:** `Self` reads
        // `fn_ctx.impl_name` (`resolve.kspl`), and if it is unset `Self` stays in `type_id`,
        // **which the body and every caller read** (`fn make(): Self` returned a type named
        // `Self`).
        old_impl_name: = r.fn_ctx.impl_name
        if is_method
            r.fn_ctx.impl_name = r.env.get_str(r.env.get_or_add(struct_inst_name_str))
        $ret_type_node: = inst_node.find_child(.k_type_expr)
        if ret_type_node == null
            sig_node: = inst_node.find_child(.k_type_fn_sig)
            if sig_node != null
                ret_type_node = sig_node.find_child(.k_type_expr)
        if ret_type_node != null
            sym.type_id = ret_type_node.resolve_type(r) catch e
                r.fn_ctx.impl_name = old_impl_name
                throw e
        else
            sym.type_id = I32::sema_type_env.Builtin_type_id.void_type

        inst_id: = base_core.pools.intern_name(arena_inst_name)
        r.symtab.global_scope.set(inst_id, sym)

        inst_node.resolve_fn_signature_types(r) catch e
            r.fn_ctx.impl_name = old_impl_name
            throw e
        r.fn_ctx.impl_name = old_impl_name

        if !skip_infer
            $impl_name_val: U8$[] = ""
            if is_method
                impl_name_val = r.env.get_str(r.env.get_or_add(struct_inst_name_str))
            // Only queued on pending: inferring under the caller's symtab scopes and fn_ctx would
            // break, so infer.kspl's worklist loop infers it after resetting the scopes.
            r.queue_fn_body(inst_node, base_core.arena.dup_str(impl_name_val), chain_depth,
                r.env.display_key(full_inst_name.slice()), r.generics.inst_site)

        r.restore_mono_state(backup@)

        return inst_name

struct Fn_instance //< one instance of a generic function: what it instantiates and with what
    //<
    //< Its names are derived from it (fn_instance_names), never read back.
    template: U8[] //< the template's key in generics.templates (`app.gf`, `app.Box.gm`)
    owner: I32 //<
        //< The generic type's instance a method is reached through, or 0
        //<
        //< 0 for a free function and a plain type's method; also for a generic type's method named
        //< through the template itself, whose type arguments are then args.
    args: I32[] //< its own type arguments; a method of an instance declaring none has none

enum Fn_owner //< which of the three shapes a function instance has (fn_instance_names)
    free //< a free function or a plain type's method
    own_args(type_name: U8[]) //<
        //< a method of the instance type_name, with type arguments of its own
    type_args(type_name: U8[], type_template: U8[], type_args: I32[]) //<
        //< A method of the instance type_name, binding the type's arguments alone

priv fn fn_type_fqn(fi: Fn_instance): U8[] //< what precedes the template's last dot
    last_dot: = fi.template.rfind_char_out('.')
    return fi.template.sub(0, last_dot) if last_dot >= 0 else ""

priv fn fn_method_name(fi: Fn_instance): U8[] //< the template's name after its last dot
    last_dot: = fi.template.rfind_char_out('.')
    return fi.template.sub_from(last_dot + 1) if last_dot >= 0 else fi.template

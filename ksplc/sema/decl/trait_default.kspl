//< Copies what a trait's declaration provides into the impls of that trait
//< **A default value has one source, the trait's declaration** (an impl's own is rejected by
//< check_trait_method_sig in `trait_check.kspl`). Before it copies, it refuses a trait's method
//< that the type writes outside the block that names the trait.
//< **It runs in collect's Pass 1b, before generic instantiation** (the reason is at Pass 1b in
//< `collect.kspl`).
import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/name" as _sema_decl_name
import "ksplc/sema/decl/subst" as sema_decl_subst
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/scope" as sema_type_scope
import "std/ds" { List, Map }

const INHERITED_DEFAULT: I32 = 1 //< the flag for a copied default value
    //< Caution: **Store it in `ival`.** Non-zero means the impl did not write it, so the rejecting
    //< check (`trait_check.kspl`) skips it.

impl Sema_ctx
    fn propagate_trait_defaults(r: Self$@, root: Ast_node$@) //<
        //< Copies the trait declaration's default values to every impl of the trait
        impls: = r.impls_by_target(root)
        for top_node in root.children
            child: = top_node.unwrap_top_level()
            if child.kind_id != .k_decl_impl
                continue
            if t_node: = child.get_impl_trait_node()
                r.set_current_file(child.loc.file())
                r.copy_defaults_from_trait(child, t_node, impls)

    fn split_listed_traits(r: Self$@, root: Ast_node$@) //<
        //< Gives each trait after the first in `impl T: A, B` an empty block of its own
        //< The rule is in "5.2 Implementations (`impl`) and receivers" of
        //< docs/SPEC-programming-language.md. **A header names several traits only when none
        //< declares a method**, so the block's methods stay the type's own, and every trait that
        //< marks the type stands where a reader first looks. Each split block is made by the
        //< compiler and stands at its trait's name, so a diagnostic on it lands there.
        //< It runs after Pass 1, which registers the traits it looks up.
        $i: Sz = 0
        for i < root.children.len
            top_node: = root.children.get(i)
            i += 1
            child: = top_node.unwrap_top_level()
            if child.kind_id != .k_decl_impl
                continue
            listed: = listed_traits(child)
            if listed.len < 2
                continue
            r.set_current_file(child.loc.file())
            for t_node in listed
                decl: = r.trait_decl_of(t_node).unwrap_or(null)
                if decl != null && declares_methods(decl)
                    defer $named: = t_node.extract_type_name()
                    r.clear_scratch()
                        .s("'\{named.slice()\}' declares methods, so it is met in a block of its \
                            own, 'impl …: \{named.slice()\}'. A header names several traits only \
                            when none of them declares a method")
                    r.err(t_node, r.scratch.slice())
            // The first trait stays on the written block; each other one leaves it.
            first: = listed.get(0)
            stays: = base_ast.new_ast_node_list()
            for part in child.children
                if part == first || !is_trait_path(part)
                    stays.push(part)
            child.children = stays
            for k in Range(1, listed.len, 1)
                t_node: = listed.get(k)
                made: = child.clone()
                kept: = base_ast.new_ast_node_list()
                for part in made.children
                    if part.kind_id != .k_decl_fn && part.kind_id != .k_decl_fn_proto &&
                        !is_trait_path(part)
                        kept.push(part)
                made.children = kept
                made.add_child(t_node.clone())
                made.place_as_made(t_node.loc)
                root.insert_child(i, made)
                i += 1

    fn trait_decl_of(r: Self$@, trait_node: Ast_node$@): Ast_node$@? //<
        //< The declaration of the trait a written path names, or none where it names none
        //< A generic's actual arguments are dropped: the template holds the default values.
        //< **A generic trait is in the template table, not the symbol table**; if it is missed,
        //< `Index_ref`'s default values are silently not copied.
        //< It looks the symbol up by FQN, for the reason at copy_defaults_from_trait.
        written: = r.read_written_type(trait_node)
        $decl: Ast_node$@ = r.written_template(written)
        if decl == null
            if written.fqn.len == 0
                return .none
            t_sym: = r.symtab.resolve_fqn(written.fqn).unwrap_or(null)
            if t_sym != null
                decl = t_sym.node
        if decl == null || decl.kind_id != .k_decl_trait
            return .none
        return .some(decl)

    priv fn impls_by_target(r: Self$@, root: Ast_node$@):
        Map<|U8[], List<|Ast_node$@|>$@|>$@ //<
            //< Every impl of the program, grouped by the FQN of the type it names
        by_target: = base_core.arena
            .create(Map<|U8[], List<|Ast_node$@|>$@|>(base_core.arena))
        for top_node in root.children
            child: = top_node.unwrap_top_level()
            if child.kind_id != .k_decl_impl || child.get_decl_type_node() == null
                continue
            r.set_current_file(child.loc.file())
            fqn: = r.impl_target_fqn(child)
            if fqn.len == 0
                continue
            $list: = by_target.get(fqn).unwrap_or(null)
            if list == null
                list = base_core.arena.create(List<|Ast_node$@|>(base_core.arena))
                by_target.set(fqn, list)
            list.push(child)
        return by_target

    priv fn copy_defaults_from_trait(r: Self$@, impl_node: Ast_node$@, trait_node: Ast_node$@,
        impls: Map<|U8[], List<|Ast_node$@|>$@|>$@) //<
            //< Copies the default values, method by method, from the trait that impl names
            //< It looks up the trait's **declaration node** first.
            //<
            //< Caution: **Do not resolve it as a type.** `resolve_type` and
            //< `resolve_type_method_fqn` **create an instance at once**, an unneeded one in the
            //< output; look up the symbol by FQN.
        defer $spelled: = trait_node.extract_type_name()
        full: = spelled.slice()
        decl: = r.trait_decl_of(trait_node) catch
            return
        // Caution: **Get the implementing type's visibility first.** The copied body becomes that
        // type's method, so it must not be more visible than the type ("the visibility written on a
        // member" in `access.kspl`).
        $target_vis: = sema_type_scope.Visibility.public
        if t_sym: = sema_decl_access.impl_target_symbol(r, impl_node)
            target_vis = t_sym.vis
        // **Check before the copy**: a default copied into this block would hide a method the type
        // writes in another block, and the type would then hold two of that name.
        r.require_methods_in_block(impl_node, trait_node, decl, full, impls)
        r.refuse_foreign_methods(impl_node, decl, full)
        r.copy_default_bodies(impl_node, trait_node, decl, target_vis)
        for m in impl_node.children
            if m.kind_id != .k_decl_fn
                continue
            m_name: = m.get_decl_id_text()
            if m_name.len == 0
                continue
            if req: = find_trait_method(decl, m_name)
                copy_param_defaults(req, m)

    priv fn require_methods_in_block(r: Self$@, impl_node: Ast_node$@, trait_node: Ast_node$@,
        decl: Ast_node@, spelled: U8[], impls: Map<|U8[], List<|Ast_node$@|>$@|>@) //<
            //< Refuses a trait's method that the type writes in a block other than this conformance
            //< The rule is in "5.2 Implementations (`impl`) and receivers" of
            //< docs/SPEC-programming-language.md. A method the type writes nowhere is left to
            //< verify_trait_implementation in `trait_check.kspl`, which reports it missing.
        others: = impls.get(r.impl_target_fqn(impl_node)).unwrap_or(null)
        if others == null
            return
        for m in decl.children
            if m.kind_id != .k_decl_fn && m.kind_id != .k_decl_fn_proto
                continue
            name: = m.get_decl_id_text()
            if name.len == 0 || impl_defines(impl_node, name)
                continue
            for other in others
                if other == impl_node
                    continue
                if found: = method_named(other, name)
                    r.report_method_elsewhere(impl_node, trait_node, spelled, found)
                    break

    priv fn refuse_foreign_methods(r: Self$@, impl_node: Ast_node$@, decl: Ast_node$@,
        spelled: U8[]) //<
            //< Refuses a method in the block that the trait it names does not declare
            //< The rule is in "5.2 Implementations (`impl`) and receivers" of
            //< docs/SPEC-programming-language.md. **A misspelt method would otherwise pass**: the
            //< trait's default body would be copied in beside it, and run in its place. A trait
            //< that declares no method is left out: its block holds the type's own methods.
        if !declares_methods(decl)
            return
        for m in impl_node.children
            if m.kind_id != .k_decl_fn || m.made_by_compiler()
                continue
            name: = m.get_decl_id_text()
            if name.len == 0 || find_trait_method(decl, name).is_some()
                continue
            defer $target: = impl_node.get_decl_type_node().extract_type_name()
            r.clear_scratch()
                .s("'\{spelled\}' declares no method '\{name\}'. A block that names a trait holds \
                    only that trait's methods. Move 'fn \{name\}' into the type's plain block 'impl \
                    \{target.slice()\}', or spell it as the trait does")
            r.err(m, r.scratch.slice())

    priv fn report_method_elsewhere(r: Self$@, impl_node: Ast_node$@, trait_node: Ast_node$@,
        spelled: U8[], found: Ast_node$@) //<
            //< Reports where the trait's method stands now, and that it moves into this block
        name: = found.get_decl_id_text()
        defer $target: = impl_node.get_decl_type_node().extract_type_name()
        r.clear_scratch()
            .s("'\{target.slice()\}: \{spelled\}' requires '\{name\}'. Move 'fn \{name\}' (")
        if !found.loc.file().equals(impl_node.loc.file())
            r.scratch.s("\{found.loc.file()\}, ")
        r.scratch
            .s("line \{r.line_of(found.loc)\}) into this block. A trait's methods are written in \
                the block that names the trait, so that block shows how the type meets the trait")
        r.err(trait_node, r.scratch.slice())

    // Copies a trait's default bodies **into the impl's block** where the impl does not write them,
    // so `Self` and the impl's type arguments apply directly.
    // Caution: **Replace the declaration's type parameters with the impl's actual arguments.**
    // The `T` inside the body copied into `impl<|S, T, U|> Conversion<|S, T, U|>: Chain<|U|>` means
    // `U`.
    priv fn copy_default_bodies(r: Self$@, impl_node: Ast_node$@, trait_node: Ast_node$@,
        decl: Ast_node$@, target_vis: sema_type_scope.Visibility)
        params: = decl.find_child(.k_type_gen_params)
        args: = trait_node.find_child(.k_type_args)
        for m in decl.children
            // Only a method with a body is copied.
            if m.kind_id != .k_decl_fn || m.find_child(.k_stmt_block) == null
                continue
            name: = m.get_decl_id_text()
            if name.len == 0 || impl_defines(impl_node, name)
                continue
            fresh: = m.clone()
            r.keep_written_positions(fresh)
            if params != null && args != null
                r.write_impl_args(fresh, params, args)
                // Each type's text is written again from its parts, which now hold the arguments.
                fresh.replace_type_vars(r)
            adopt_as_impl_method(fresh, impl_node, target_vis)
            impl_node.children.push(fresh)

    priv fn keep_written_positions(r: Self$@, node: Ast_node$@) //<
        //< Records where each node of a copied default body is written
        //< That is in the trait, or in the impl's header for a type argument written into the
        //< copy. adopt_as_impl_method moves the copy to its impl. A warning is still reported
        //< here (`default_origin` in `../session/state.kspl`). **The node's names are read in
        //< this place's file too** (names_file in `../session/ctx.kspl`): the trait's file and the
        //< impl's hold other imports and other `priv` names.
        r.diags.default_origin.set(Sz::node, node.loc)
        for child in node.children
            r.keep_written_positions(child)

    priv fn write_impl_args(r: Self$@, node: Ast_node$@, params: Ast_node$@, args: Ast_node$@) //<
        //< Writes the impl's type arguments where a copied default body names the trait's parameters
        //< **The argument's tree is copied in, as the impl wrote it**, so any type can stand there
        //< (`Local[]`, `Box<|Local|>?`), and one of the impl's own parameters is bound with its
        //< instance. No type is resolved this early: the reason is at copy_defaults_from_trait.
        //< Each copy is read in the impl's file (keep_written_positions above), while the text
        //< around it is read in the trait's.
        for i in Range.asc(node.children.len)
            child: = node.children.get(i)
            k: = child.kind_id
            arg: = written_arg(params, args, child) catch
                r.write_impl_args(child, params, args)
                continue
            $made: = arg
            if k == .k_expr_path || k == .k_type_path
                // `T.make()` or a `const` parameter's value.
                made = value_form(arg)
            made = made.clone()
            r.keep_written_positions(made)
            if k == .k_type_atom
                // `T@`: the argument stands as a type in parentheses does, under the postfix.
                child.children = base_ast.new_ast_node_list()
                child.add_child(made)
            else
                node.set_child(i, made)
            // `T.make`: the member is one of the type the impl's file names.
            if i == 0 && node.kind_id == .k_expr_postfix
                r.diags.default_origin.set(Sz::node, arg.loc)

priv fn adopt_as_impl_method(fresh: Ast_node$@, impl_node: Ast_node@,
    target_vis: sema_type_scope.Visibility) //<
        //< Makes the copied body into that impl's method
        //< **Replace the position too, with the impl's**: an error can hold for that implementing
        //< type alone, and visibility follows the `loc`'s file (get_defined_in in
        //< `../type/scope.kspl`). A warning is about the body's own text, and is reported in the
        //< trait (keep_written_positions above).
        //< Caution: **Do not make it more visible than the implementing type** (check_one_member in
        //< `access.kspl`).
    fresh.retarget_loc(impl_node.loc)
    set_visibility_keyword(fresh,
        sema_decl_access.narrower_vis(target_vis, fresh.get_visibility()))
    // **Its parameter defaults are the trait's**, not ones the impl wrote, which are refused.
    params: = fresh.get_fn_params()
    if params == null
        return
    for p in base_ast_ext.Param_cursor(params, false)
        d: = p.get_param_default()
        if d != null
            d.ival = INHERITED_DEFAULT

priv fn set_visibility_keyword(decl: Ast_node$@, vis: sema_type_scope.Visibility) //<
    //< Sets the declaration's visibility keyword to exactly one
    //< **`internal` has no keyword**, so none is left.
    strip_visibility_keywords(decl)
    strip_visibility_keywords(decl.find_child(.k_attribute_list))
    if vis == sema_type_scope.Visibility.public
        decl.add_child(Ast_node(.k_keyword, "pub", decl.loc))
    else if vis == sema_type_scope.Visibility.file_private
        decl.add_child(Ast_node(.k_keyword, "priv", decl.loc))

priv fn strip_visibility_keywords(node: Ast_node$@) //<
    //< Removes the pub and priv keywords from a declaration
    //< Caution: **Remove it from both places**, directly under the declaration and in the
    //< attributes (get_visibility in `sema/type/scope.kspl`); one left behind stays in effect.
    if node == null
        return
    $i: Sz = 0
    for i < node.children.len
        c: = node.children.get(i)
        if c.kind_id == .k_keyword &&
            (c.text.equals("pub") || c.text.equals("priv"))
            node.children.remove_at(i)
            continue
        i += 1

priv fn is_trait_path(node: Ast_node@): Bool //< whether a child of an impl is a trait it names
    return node.kind_id == .k_expr_path || node.kind_id == .k_type_path ||
        node.kind_id == .k_identifier

priv fn listed_traits(impl_node: Ast_node$@): List<|Ast_node$@|> //<
    //< The traits an impl's header names, in order: the children after its target type
    $out: = List<|Ast_node$@|>(base_core.arena)
    target: = impl_node.get_decl_type_node()
    $after: = false
    for c in impl_node.children
        if c == target
            after = true
        else if after && is_trait_path(c)
            out.push(c)
        else if c.kind_id == .k_decl_fn
            break
    return out

fn declares_methods(decl: Ast_node@): Bool //<
    //< Whether that trait declares any method; a trait that declares none marks a type's property
    for m in decl.children
        if m.kind_id == .k_decl_fn || m.kind_id == .k_decl_fn_proto
            return true
    return false

priv fn impl_defines(impl_node: Ast_node$@, name: U8[]): Bool //<
    //< Whether that impl writes a method of that name itself
    return method_named(impl_node, name).is_some()

priv fn method_named(impl_node: Ast_node$@, name: U8[]): Ast_node$@? //<
    //< The method of that name that the impl's block writes, if any
    for m in impl_node.children
        if m.kind_id == .k_decl_fn && m.get_decl_id_text().equals(name)
            return .some(m)
    return .none

priv fn find_trait_method(trait_decl: Ast_node$@, name: U8[]): Ast_node$@? //<
    //< Finds, in the trait's declaration, the declaration of the method with that name
    for m in trait_decl.children
        if m.kind_id != .k_decl_fn && m.kind_id != .k_decl_fn_proto
            continue
        if m.get_decl_id_text().equals(name)
            return .some(m)
    return .none

priv fn copy_param_defaults(req_m: Ast_node$@, impl_m: Ast_node$@) //<
    //< Copies the parameter default values that only the trait's declaration has
    //< **A parameter the impl gives its own default is not touched**: overwritten, the rejection
    //< would vanish. It matches **by position**, since the names may differ (`index` / `_index`);
    //< the count is checked in `trait_check.kspl`.
    req_params: = req_m.get_fn_params()
    impl_params: = impl_m.get_fn_params()
    if req_params == null || impl_params == null
        return
    $impl_cur: = base_ast_ext.Param_cursor(impl_params, false)
    for rp in base_ast_ext.Param_cursor(req_params, false)
        ip: = impl_cur.next().unwrap_or(null)
        if ip == null
            return
        d: = rp.get_param_default()
        if d == null || ip.get_param_default() != null
            continue
        fresh: = d.clone()
        fresh.ival = INHERITED_DEFAULT
        // Caution: **Add the `=` too**: the value is read as the child after the `=`
        // (`../../parse/normalize.kspl`).
        ip.add_child(Ast_node(.k_literal, "=", ip.loc))
        ip.add_child(fresh)

priv fn written_arg(params: Ast_node$@, args: Ast_node$@, at: Ast_node$@): Ast_node$@? //<
    //< The argument `args` writes for the type parameter of `params` that `at` names alone
    //< None where `at` is not a type's or a value's name, or names no parameter.
    k: = at.kind_id
    if k != .k_type_expr && k != .k_type_atom && k != .k_expr_path && k != .k_type_path
        return .none
    name: = at.bare_written_name()
    if name.len == 0
        return .none
    $pos: Sz = 0
    for arg in args.children
        if arg.kind_id == .k_literal || arg.kind_id == .k_keyword || arg.kind_id == .k_empty
            continue
        p: = params.gen_param_at(pos)
        if p != null && p.gen_param_name().equals(name)
            return .some(arg)
        pos += 1
    return .none

priv fn value_form(arg: Ast_node$@): Ast_node$@ //<
    //< What stands for a type argument where an expression names it: a value, or a type's name
    //< A type that is more than a name (`Local@`, `fn(x: I32): I32`) stands as it is. No
    //< expression can begin with one, and the report names it as the impl wrote it
    //< (refuse_type_as_value in `../body/expr.kspl`).
    if arg.kind_id != .k_type_expr || arg.children.len != 1 ||
        arg.get_child(0).children.len != 1
        return arg
    return arg.get_child(0).get_child(0)

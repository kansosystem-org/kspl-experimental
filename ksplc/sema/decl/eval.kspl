//< Constant folding: the value of an integer expression known at translation time
//< It folds literals, the operators, `sizeof` / `offsetof`, casts and references to a `const`, at
//< the operands' width. **A signed result that does not fit is an error**, as is a division by
//< zero. The quiet forms (`try_eval_constexpr`) tell whether an expression folds, reporting
//< nothing. **A constant's value is kept once folded** (`Static_state` in
//< `../session/state.kspl`), so a chain of constants folds in linear time.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/core" as _base_core // the operator classes (`is_shift_op` ...)
import "ksplc/base/literal" as base_literal
import "ksplc/sema/decl/fold_float" as sema_decl_fold_float
import "ksplc/sema/decl/layout" as sema_decl_layout
import "ksplc/sema/decl/name" as sema_decl_name
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error }
import "ksplc/sema/session/state" { Const_fold, Const_fold_float }
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/chars" // testing and slicing single characters
import "std/checked_int" // the signed overflow checks shared with run-time arithmetic
import "std/ds" { List }
import "std/math"
import "std/str"

impl U8[]
    priv fn parse_int_literal(r: U8[], node: Ast_node$@, c: Sema_ctx$@, negated: Bool):
        I64!Sema_error //<
            //< Reads an integer literal, negated where `negated`, as I64; outside I64 is an error
            //< Wrapped silently, an array size or a generic bound reaches Lower/Gen as a smaller,
            //< wrong value. A per-type range (300 into a `U8`) is check_literal_bounds's job in
            //< sema/body/literal.kspl. A leading `-` comes from a substituted const generic.
        is_neg: = negated != (r.len > 0 && r.ptr$ == '-')
        lit: = (r.sub_from(1) if r.len > 0 && r.ptr$ == '-' else r).parse_int_literal_u64()
        // Set the upper limit by **the literal's type**: `0xFFFFFFFFFFFFFFFFU64` is correct past
        // I64::MAX and is carried as I64's bit pattern. A negated one reaches I64::MIN, whose
        // magnitude no I64 holds.
        is_u64: =
            c.env.get_primitive_bit_size(node.type_id) >= 64 &&
            c.env.is_unsigned(node.type_id)
        $limit: U64 = 18446744073709551615U64 if is_u64 else 9223372036854775807U64
        if is_neg && !is_u64
            limit = 9223372036854775808U64
        if lit.overflow || lit.value > limit
            if !c.suppress_errors
                c.err(node, "integer literal is too large for a compile-time constant expression")
            throw .invalid_argument
        return I64::(0U64 - lit.value) if is_neg else I64::lit.value

impl Sema_ctx
    fn promoted_fold_type(r: Self$@, a: I32, b: I32): I32 //<
        //< The type two operands fold at: the wider, an unsuffixed literal taking the other's
        if a == 0 || sema_type_env.is_unknown(a)
            return b
        if b == 0 || sema_type_env.is_unknown(b)
            return a
        ra: = r.env.scalar_repr_id(a)
        rb: = r.env.scalar_repr_id(b)
        return rb if r.env.get_portable_bit_size(rb) > r.env.get_portable_bit_size(ra) else ra

    fn fold_quietly(r: Self$@, node: Ast_node$@, narrow: Bool): I64!Sema_error //<
        //< Folds a constant expression, discarding its diagnostics, narrowed to I32 where `narrow`
        //< **Every quiet fold goes through here.** The suppression flag and the error count are put
        //< back on every way out, so a fold that fails leaves no trace.
        old_err: = r.diags.counts.errors
        old_sup: = r.suppress_errors
        r.suppress_errors = true
        defer
            r.diags.counts.errors = old_err
            r.suppress_errors = old_sup
        if narrow
            return I64::node.eval_constexpr(r)!
        return node.eval_constexpr_wide(r)!

    fn eval_constexpr_quiet(r: Self$@, node: Ast_node$@, dflt: I32): I32 //<
        //< Evaluates a constant expression with errors suppressed, returning dflt on failure
        return r.try_eval_constexpr(node).unwrap_or(dflt)

    fn eval_attribute_arg(r: Self$@, n: Ast_node$@, name: U8[]): I32 //<
        //< Folds and returns the N of `#name(N)`
        //< Returns 0 where the attribute is absent. The value's shape is checked only in
        //< `sema/decl/attrs.kspl`.
        if attr: = n.get_attribute(name)
            arg_node: = attr.safe_get_child(1)
            return r.eval_constexpr_quiet(arg_node, 0) if arg_node != null else 0
        return 0

    fn try_eval_constexpr(r: Self$@, node: Ast_node$@): I32? //<
        //< The same quiet evaluation, but **it tells whether it folded**
        //< Caution: Use this where the value becomes a name (a type argument's canonical name).
        //< eval_constexpr_quiet's default cannot be told apart from a fold that yields the same
        //< value.
        v: = r.fold_quietly(node, true) catch
            return .none
        return .some(I32::v)

    fn try_eval_constexpr_wide(r: Self$@, node: Ast_node$@): I64? //<
        //< The same quiet fold, not narrowed to I32
        //< **Code that needs a value at its full width uses it.** Examples are a reference to a
        //< `const` in a global's initializer, on either backend, and a constant compared against a
        //< type's range. So `1U32 << 31` survives.
        v: = r.fold_quietly(node, false) catch
            return .none
        return .some(v)

    fn kept_const_fold(r: Self$@, decl_key: Sz): Const_fold? //<
        //< The value kept for the constant declared at decl_key, if it is of the current epoch
        if r.statics.epoch == 0
            return .none
        if kept: = r.statics.ints.get(decl_key)
            if kept.epoch == r.statics.epoch
                return .some(kept)
        return .none

    fn keep_const_fold(r: Self$@, decl_key: Sz, value: I64, below: I32) //<
        //< Keeps a constant's folded value for the current epoch (none while the cache is off)
        if r.statics.epoch != 0
            r.statics.ints
                .set(decl_key,
                Const_fold::{ .value = value, .below = below, .epoch = r.statics.epoch })

    fn kept_float_fold(r: Self$@, decl_key: Sz): Const_fold_float? //<
        //< The floating-point value kept for the constant declared at decl_key, as kept_const_fold
        if r.statics.epoch == 0
            return .none
        if kept: = r.statics.floats.get(decl_key)
            if kept.epoch == r.statics.epoch
                return .some(kept)
        return .none

    fn keep_float_fold(r: Self$@, decl_key: Sz, value: F64, below: I32) //<
        //< Keeps a floating-point constant's folded value, as keep_const_fold
        if r.statics.epoch != 0
            r.statics.floats
                .set(decl_key,
                Const_fold_float::{ .value = value, .below = below, .epoch = r.statics.epoch })

    priv fn reuse_const_fold(r: Self$@, kept: Const_fold, decl_key: Sz, depth: I32):
        I64!Sema_error //<
            //< The kept value of a constant reached `depth` levels down, cut where a fold would be
            //< The constant's own fold went `kept.below` levels deeper. So the walk it saves
            //< reaches the same depth, and the same chains stay too deep.
        deepest: = depth + 1 + kept.below
        if deepest > MAX_CONSTEXPR_DEPTH
            cut_at_limit(r) catch e
                if r.resolving.cut_waiting
                    r.resolving.cut_path.push(decl_key)
                throw e
        r.statics.deepest = math.max(r.statics.deepest, deepest)
        return kept.value

priv const I64_MAX_VAL: I64 = 9223372036854775807I64 //< i64's boundaries
    //< The lower one is built as `-(2^63 - 1) - 1`: the literal 2^63 does not fit in I64. The `I64`
    //< suffix keeps it clear of the rule for a `-`'s left-hand literal in sema/body/binary.kspl.
priv const I64_MIN_VAL: I64 = -9223372036854775807I64 - 1

// Fits the folded result of an arithmetic operator or a left shift into the operands' width.
// **A signed result that does not fit is an error** (`I32`'s `2147483647 + 1` fits i64; in C it
// is undefined behaviour). A left shift counts too: `1 << 31` at `I32` is 2^31, which `I32` does
// not hold. A bit pattern is written unsigned and cast (`I32::(1U32 << 31)`).
priv fn fit_or_report(r: Ast_node$@, c: Sema_ctx$@, v: I64, bits: I32, is_uns: Bool):
    I64!Sema_error
    if is_uns
        return fit_result(v, bits, is_uns)
    if bits < 64
        limit: I64 = 1I64 << I64::(bits - 1)
        if v >= limit || v < -limit
            return r.report_overflow(c)!
    return v

priv fn fit_result(v: I64, bits: I32, is_uns: Bool): I64 //< fits a result into the operands' type
    //< Unsigned wraps mod 2^bits, as in the generated C; signed is returned unchanged (the caller
    //< rejects overflow); 64-bit is I64's bit pattern unchanged.
    if !is_uns || bits >= 64
        return v
    return I64::(U64::v & ((U64::1 << U64::bits) - 1))

fn int_suffix_type_id(txt: U8[]): I32 //<
    //< The type a numeric literal's suffix (the `U8` of `300U8`) names, or unknown
    //< It is unknown where there is no suffix.
    //<
    //< Caution: Keep this test in this one place, or the type check and the range check disagree
    //< on the suffix.
    // The integer types are the ids from `I8` to `Sz`. No suffix ends another, so order is free.
    first: = Sz::sema_type_env.Builtin_type_id.i8_type
    for id in Range(first, Sz::sema_type_env.Builtin_type_id.size_type + 1, 1)
        if txt.ends_with(sema_type_env.BUILTIN_TYPES[id].name)
            return I32::id
    return I32::sema_type_env.Builtin_type_id.unknown

fn wrap_to(v: I64, bits: I32, is_uns: Bool): I64 //< the value a cast to the width gives
    //< It keeps the low `bits` bits, as C's conversion does: zero-extended for an unsigned type,
    //< sign-extended for a signed one.
    if bits >= 64
        return v
    low: = U64::v & ((U64::1 << U64::bits) - 1)
    if is_uns || (low >> U64::(bits - 1)) == 0
        return I64::low
    return I64::low - (1I64 << I64::bits)

priv const GUARANTEED_CONST_CHAIN: I32 = 256 //<
    //< The constant-reference chain length the specification promises, named by the diagnostic
    //< The promise is in "Implementation limits" in docs/SPEC-programming-language.md.
    //< Caution: **Do not show max_constexpr_depth below**: it counts nodes, a larger number than
    //< the chain that can be written.

priv const MAX_CONSTEXPR_DEPTH: I32 = GUARANTEED_CONST_CHAIN * 4 //< the fold's recursion limit
    //< **The higher it is, the more a pathological input costs.** max_parse_tree_depth in
    //< ksplc/parse/normalize.kspl stops one expression's nesting. Only a chain across declarations
    //< (eval_ident_or_path) reaches here.

priv fn cut_at_limit(c: Sema_ctx$@): Void!Sema_error //<
    //< Stops a fold that went past the depth limit
    //< Caution: **Do not stop with `not_constant`.** Under suppression the report is dropped, and
    //< fold_static in ../body/static_init.kspl re-folds only what did not stop with
    //< `not_constant`, so the depth error would appear nowhere. **A quiet fold leaves no cut to
    //< report**; the loud fold that follows it does.
    if !c.suppress_errors
        c.resolving.cut_waiting = true
    throw .nesting_too_deep

impl Ast_node
    fn eval_constexpr(r: Self$@, c: Sema_ctx$@): I32!Sema_error //<
        //< Folds a constant expression as I32
        //< **Narrowing happens only here**; out of range is always an error.
        return r.check_i32_overflow(c, r.eval_constexpr_internal(c, 0)!)!

    fn eval_constexpr_wide(r: Self$@, c: Sema_ctx$@): I64!Sema_error //<
        //< Folds a constant expression, keeping I64
        //< **Only code that writes a value out uses it** (try_eval_constexpr_wide). It emits a
        //< value that is correct for its type but does not fit I32, like `1U32 << 31`, without the
        //< narrowing rejecting it.
        //< Used elsewhere, a value that does not fit I32 would go through unchecked.
        return r.eval_constexpr_internal(c, 0)!

    fn eval_constexpr_internal(r: Self$@, c: Sema_ctx$@, depth: I32): I64!Sema_error //<
        //< Folds from `depth`; a fold's head (depth 0) reports a chain cut below it
        if depth > 0
            return r.fold_step(c, depth)!
        v: = r.fold_step(c, 0) catch e
            r.report_cut_chain(c)
            throw e
        return v

    priv fn report_cut_chain(r: Self$@, c: Sema_ctx$@) //<
        //< Reports, at the fold's head, a chain the depth limit cut, once per chain
        //< **At the head, not where the walk stopped**: the cut lands at whatever constant lies
        //< max_constexpr_depth below the head. That line says nothing of where the chain starts.
        if !c.resolving.cut_waiting
            return
        c.resolving.cut_waiting = false
        $seen: = false
        for decl_key in c.resolving.cut_path
            seen = seen || c.resolving.cut_reported.get(decl_key).unwrap_or(false)
            c.resolving.cut_reported.set(decl_key, true)
        c.resolving.cut_path.len = 0
        if seen
            return
        r.report_chain_too_deep(c)

    fn report_float_cut(r: Self$@, c: Sema_ctx$@) //<
        //< Reports a floating-point fold the depth limit cut (fold_float.kspl), once per translation
        //< Every constant past the limit is cut again, and one report names the chain.
        if c.statics.float_cut_reported
            return
        c.statics.float_cut_reported = true
        r.report_chain_too_deep(c)

    priv fn report_chain_too_deep(r: Self$@, c: Sema_ctx$@) //< the one message for a cut chain
        c.clear_scratch()
            .s("constant expression nesting too deep. Folding follows more constants defined by \
                other constants than the compiler supports. The language guarantees \
                \{GUARANTEED_CONST_CHAIN\} levels of references between constants. Folding uses one \
                native stack frame per level. Deeper input would exhaust the stack")
        c.err(r, c.scratch.slice())

    priv fn fold_step(r: Self$@, c: Sema_ctx$@, depth: I32): I64!Sema_error //<
        //< Folds one node `depth` levels below the fold's head
        if r == null
            throw .not_constant
        if depth > MAX_CONSTEXPR_DEPTH
            cut_at_limit(c)!
        if depth > c.statics.deepest
            c.statics.deepest = depth

        switch r.kind_id
        case .k_integer
            return r.eval_integer(c, depth)!
        case .k_bool
            return r.eval_bool(c, depth)!
        case .k_char
            return r.eval_char(c, depth)!
        case .k_expr_unary
            return r.eval_unary(c, depth)!
        case .k_expr
            return r.eval_binary(c, depth)!
        case .k_expr_ternary
            return r.eval_ternary(c, depth)!
        case .k_expr_primary
            return r.eval_primary(c, depth)!
        case .k_expr_sizeof
            return r.eval_sizeof(c, depth)!
        case .k_expr_offsetof
            return r.eval_offsetof(c, depth)!
        case .k_identifier, .k_expr_path, .k_type_path, .k_expr_postfix, .k_method_access
            return r.eval_ident_or_path(c, depth)!
        case .k_enum_init, .k_implicit_enum, .k_expr_implicit_dot
            // A scalar enum's variant folds to its tag (valid in codegen after mangling too). It is
            // written in full (`Color.green`, a k_enum_init), or short where the place gives the
            // type (`.green`). Caution: **Look past the immutable mark** a const array's element
            // carries, or the short form names no enum.
            real_type_id: = c.env.get_clean_real_type(r.type_id)
            variant: =
                (r.last_child() if r.kind_id == .k_enum_init else r.get_implicit_enum_variant())
            // Caution: **A tagged union's variant is no integer**: folded to its tag, a backend
            // writes `0` where `{ tag, payload }` belongs.
            if e_def: = c.env.get_enum_def(c.env.get_str(real_type_id))
                if !e_def.is_scalar()
                    return r.eval_unknown(c, depth)!
                switch e_def.get_variant(variant.text if variant != null else "")
                case .some(v_def)
                    return v_def.tag_value
                case .none {}
            if !c.suppress_errors
                c.err(r, "enum value is not a compile-time constant")
            throw .not_constant
        default
            return r.eval_unknown(c, depth)!

    fn eval_ternary(r: Self$@, c: Sema_ctx$@, depth: I32): I64!Sema_error
        if r.children.len == 3
            cond_val: = r.get_ternary_cond().eval_constexpr_internal(c, depth + 1)!
            return (r.get_ternary_true().eval_constexpr_internal(c, depth + 1)! if cond_val != 0
                else r.get_ternary_false().eval_constexpr_internal(c, depth + 1)!)
        return r.eval_unknown(c, depth)!

    fn eval_unknown(r: Self$@, c: Sema_ctx$@, _depth: I32): I64!Sema_error
        if !c.suppress_errors
            c.err(r, "expression is not a valid compile-time constant.")
        throw .not_constant

    fn eval_integer(r: Self$@, c: Sema_ctx$@, _depth: I32): I64!Sema_error
        return r.text.parse_int_literal(r, c, false)!

    fn check_i32_overflow(r: Self$@, c: Sema_ctx$@, wide: I64): I32!Sema_error //<
        //< A value outside I32's range is an error, like division_by_zero
        //< The reason is at parse_int_literal.
        if wide > I64::2147483647 || wide < I64::(-2147483647 - 1)
            return I32::r.report_overflow(c)!
        return I32::wide

    priv fn report_overflow(r: Self$@, c: Sema_ctx$@): I64!Sema_error //<
        //< The single place that reports overflow (called from each arithmetic branch)
        if !c.suppress_errors
            c.err(r, "integer overflow in compile-time constant expression")
        throw .invalid_argument

    priv fn report_bad_shift(r: Self$@, c: Sema_ctx$@): I64!Sema_error //<
        //< The single place that reports a shift amount out of the operand's width
        if !c.suppress_errors
            c.err(r, "shift amount is out of range in compile-time constant expression")
        throw .invalid_argument

    fn eval_bool(r: Self$@, _c: Sema_ctx$@, _depth: I32): I64!Sema_error
        return 1 if r.text.equals("true") else 0

    fn eval_char(r: Self$@, _c: Sema_ctx$@, _depth: I32): I64!Sema_error
        if r.text.len < 3
            throw .invalid_argument
        return I64::base_literal.char_literal_byte(r.text)

    fn eval_unary(r: Self$@, c: Sema_ctx$@, depth: I32): I64!Sema_error
        if r.children.len >= 2
            op: = r.get_unary_op().text
            target: = r.get_unary_target()
            // A negated literal folds as one value, or I64's minimum could not be written.
            negated_literal: = op.equals("-") && target.kind_id == .k_integer
            val: =
                (target.text.parse_int_literal(target, c, true)! if negated_literal
                else target.eval_constexpr_internal(c, depth + 1)!)
            // Caution: **Fit the result to the operand's width**, as the binary operators do: at
            // I64's width `-(-128I8)` is 128, and `~0U8` is -1 rather than 255. A bare literal
            // has no width yet and folds at I64's.
            t: = r.get_unary_target().fold_type(c, depth + 1)
            known: = t != 0 && !sema_type_env.is_unknown(t)
            op_id: = c.env.scalar_repr_id(t) if known else 0
            bits: = c.env.get_portable_bit_size(op_id) if known else 64
            is_uns: = known && c.env.is_unsigned(op_id)
            if negated_literal
                return fit_or_report(r, c, val, bits, is_uns)!
            if op.equals("-")
                // Caution: Negating the minimum silently wraps to itself (as in checked_neg in
                // std/checked_int.kspl).
                if val == I64_MIN_VAL
                    if !c.suppress_errors
                        c.err(r,
                            "integer overflow (negation of the minimum value) in compile-time \
                                constant expression")
                    throw .invalid_argument
                return fit_or_report(r, c, -val, bits, is_uns)!
            if op.equals("!")
                return I64::(val == 0)
            return fit_result(~val, bits, is_uns) if op.equals("~") else val
        return r.eval_unknown(c, depth)!

    fn eval_binary(r: Self$@, c: Sema_ctx$@, depth: I32): I64!Sema_error
        // A comparison of floating-point values folds as fold_float.kspl folds its operands.
        if r.children.len >= 3 && c.env.is_float(r.get_binary_left().type_id)
            switch r.fold_float_compare(c)
            case .some(v)
                return v
            case .none
                return r.eval_unknown(c, depth)!
        if r.children.len >= 3
            left: = r.get_binary_left().eval_constexpr_internal(c, depth + 1)!
            op: = r.get_binary_op().text
            right: = r.get_binary_right().eval_constexpr_internal(c, depth + 1)!

            // Caution: Take the width and the sign from **the operands' types** (fold_type),
            // promoted to the wider. A comparison's own type is Bool, and a shift's width is the
            // left side's.
            is_shift: = op.is_shift_op()
            left_id: = r.get_binary_left().fold_type(c, depth + 1)
            $op_base: = left_id
            if !is_shift
                right_id: = r.get_binary_right().fold_type(c, depth + 1)
                op_base = c.promoted_fold_type(left_id, right_id)
            op_id: = c.env.scalar_repr_id(op_base)
            bits: = c.env.get_portable_bit_size(op_id)
            is_uns: = c.env.is_unsigned(op_id)
            // Division, remainder, right shift and ordering depend on the sign, so they read U64.
            ul: = U64::left
            ur: = U64::right

            if op.is_div_op()
                if right == 0
                    if !c.suppress_errors
                        c.err(r, "division or modulo by zero in constant expression")
                    throw .division_by_zero
            // Signed checks belong to std/checked_int. Unsigned constants wrap as at run time;
            // fit_or_report then applies the operands' narrower width.
            if op.equals("+")
                v: = left + right if is_uns else (left.checked_add(right)
                    catch r.report_overflow(c)!)
                return fit_or_report(r, c, v, bits, is_uns)!
            if op.equals("-")
                v: = left - right if is_uns else (left.checked_sub(right)
                    catch r.report_overflow(c)!)
                return fit_or_report(r, c, v, bits, is_uns)!
            if op.equals("*")
                v: = left * right if is_uns else (left.checked_mul(right)
                    catch r.report_overflow(c)!)
                return fit_or_report(r, c, v, bits, is_uns)!
            // Signed `/` and `%` follow kspl_sdiv / kspl_smod (ksplc/gen/runtime/core.h): the
            // minimum by -1 is an overflow the compiler can see for `/`, and 0 for `%`.
            if op.equals("/")
                if is_uns
                    return I64::(ul / ur)
                v: = left.checked_div(right) catch r.report_overflow(c)!
                return fit_or_report(r, c, v, bits, is_uns)!
            if op.equals("%")
                if is_uns
                    return I64::(ul % ur)
                return 0 if right == -1 else left % right
            // Caution: Make the upper limit the operand's width. A fixed one rejects `1U64 << 40`
            // or lets a narrow type shift by its width (undefined behaviour in C).
            if op.equals("<<")
                if right < 0 || right >= I64::bits
                    return r.report_bad_shift(c)!
                if !is_uns && left != 0 &&
                    (left > (I64_MAX_VAL >> right) || left < (I64_MIN_VAL >> right))
                    return r.report_overflow(c)!
                return fit_or_report(r, c, I64::(ul << ur) if is_uns else left << right, bits,
                    is_uns)!
            if op.equals(">>")
                if right < 0 || right >= I64::bits
                    return r.report_bad_shift(c)!
                return I64::(ul >> ur) if is_uns else left >> right
            if op.equals("|")
                return left | right
            if op.equals("&")
                return left & right
            if op.equals("^")
                return left ^ right
            if op.equals("==")
                return I64::(left == right)
            if op.equals("!=")
                return I64::(left != right)
            if op.equals("<")
                return I64::(ul < ur) if is_uns else I64::(left < right)
            if op.equals(">")
                return I64::(ul > ur) if is_uns else I64::(left > right)
            if op.equals("<=")
                return I64::(ul <= ur) if is_uns else I64::(left <= right)
            if op.equals(">=")
                return I64::(ul >= ur) if is_uns else I64::(left >= right)
            if op.equals("&&")
                return I64::(left != 0 && right != 0)
            if op.equals("||")
                return I64::(left != 0 || right != 0)
            throw .not_constant
        return r.eval_unknown(c, depth)!

    fn eval_primary(r: Self$@, c: Sema_ctx$@, depth: I32): I64!Sema_error
        if r.children.len > 0
            child: = r.get_primary_inner_expr()
            return child.eval_constexpr_internal(c, depth + 1)!
        return r.eval_unknown(c, depth)!

    fn sizeof_path_names(r: Self$@, out: List<|Ast_node$@|>$@) //<
        //< The names of a `sizeof` target that could read as a value: `x`, `x.a`, `x[i]`, `x@`
        //< The grammar tries a type first (`ksplc/kspl.kspeg`), so these arrive as type paths (an
        //< index as an array's length). Type arguments or another postfix make a type alone. out
        //< stays empty where the target is not such a path.
        if r == null || r.kind_id != .k_type_expr
            return
        for p in r.children
            if p.kind_id == .k_type_postfix && !p.text.equals("@") &&
                !(p.text.starts_with("[") && p.children.len > 0 &&
                !p.get_child(0).text.equals("_"))
                return
        atom: = r.find_child(.k_type_atom)
        if atom == null || atom.children.len != 1
            return
        head: = atom.get_child(0)
        if head.kind_id == .k_identifier
            out.push(head)
            return
        if head.kind_id != .k_type_path && head.kind_id != .k_expr_path
            return
        for part in head.children
            if part.kind_id != .k_identifier
                out.len = 0
                return
            out.push(part)

    fn sizeof_named_value(r: Self$@, c: Sema_ctx$@): Ast_node$@? //<
        //< The value a `sizeof` target parsed as a type names, as an expression to infer
        //< Where the first name is a variable or a constant in scope, the path reads as that value.
        //< C reads a name the same way when a local variable hides a typedef with it
        //< (sizeof_path_names has the shapes).
        defer $names: = List<|Ast_node$@|>(null)
        r.sizeof_path_names(names@)
        if names.len == 0
            return .none
        first: = names.get(0)
        sym: = c.read_written_name(first).sym
        if sym == null || !sym.kind.is_var_or_const()
            return .none
        $expr: = Ast_node.build_ident(first.text, 0, first.loc)
        for i in Range.asc(names.len - 1)
            member: = names.get(i + 1)
            expr = Ast_node.build_member_access(expr, member.text, 0, 0, member.loc)
        for p in r.children
            if p.kind_id != .k_type_postfix
                continue
            post: = Ast_node(.k_expr_postfix, p.text.sub(0, 1), p.loc).add_child(expr)
                .add_child(Ast_node(.k_literal, p.text.sub(0, 1), p.loc))
            if p.text.starts_with("[")
                post.add_child(p.get_child(0)).add_child(Ast_node(.k_literal, "]", p.loc))
            expr = post
        return .some(expr)

    fn eval_sizeof(r: Self$@, c: Sema_ctx$@, _depth: I32): I64!Sema_error
        target: = r.get_sizeof_target()
        if target != null
            $type_id: = target.type_id
            if type_id == 0
                prev_sup: = c.suppress_errors
                c.suppress_errors = true
                // A type is resolved here. An expression needs type inference (infer_expr_fn in
                // sema/session/ctx.kspl), and so does a value's name read as a type.
                value: = target.sizeof_named_value(c).unwrap_or(null)
                if value != null && c.infer_expr_fn != null
                    type_id = c.infer_expr_fn(value, c,
                        I32::sema_type_env.Builtin_type_id.unknown)!
                else if target.kind_id == .k_type_expr
                    type_id = target.resolve_type(c)!
                else if c.infer_expr_fn != null
                    type_id = c.infer_expr_fn(target, c,
                        I32::sema_type_env.Builtin_type_id.unknown)!
                c.suppress_errors = prev_sup
            if type_id == 0
                throw .not_constant
            // Caution: Request the declaration's layout first. The field list is complete only
            // after collect's Pass 3 (ensure_type_registry in sema/decl/layout.kspl).
            c.ensure_type_registry(type_id, r)!
            size: = c.type_layout(type_id).size
            c.record_folded(type_id, .size, size, r)
            return I64::size
        throw .not_constant

    fn eval_offsetof(r: Self$@, c: Sema_ctx$@, _depth: I32): I64!Sema_error //<
        //< folds `offsetof(T, f)`
        //< Caution: **Resolve the type the same way as `sizeof`** (`eval_sizeof`). The layout
        //< itself comes from `field_offset_of` in `sema/decl/layout.kspl`.
        target: = r.get_offsetof_type()
        field: = r.get_offsetof_field()
        if target == null || field == null
            throw .not_constant
        $type_id: = target.type_id
        if type_id == 0
            prev_sup: = c.suppress_errors
            c.suppress_errors = true
            type_id = target.resolve_type(c) catch 0
            c.suppress_errors = prev_sup
        if type_id == 0
            throw .not_constant
        offset: = c.field_offset_of(type_id, field.text, r)!
        c.record_folded(type_id, .field_offset(field.text), offset, r)
        return I64::offset

    fn eval_ident_or_path(r: Self$@, c: Sema_ctx$@, depth: I32): I64!Sema_error
        if r.kind_id == .k_expr_postfix
            op_node: = r.get_postfix_op()
            if op_node != null && op_node.text.equals("::")
                recv: = r.get_postfix_receiver()
                // A cast from a floating-point value folds as fold_float.kspl decides it, or the
                // two folds would disagree on `I32::2.9`.
                if recv != null && c.env.is_float(recv.type_id)
                    switch r.float_cast_of(c, false)
                    case .fits(v)
                        return v
                    case .out_of_range
                        // The cast's own check has reported it (sema/body/postfix.kspl).
                        throw .invalid_argument
                    case .not_constant
                        return r.eval_unknown(c, depth)!
                if recv != null
                    v: = recv.eval_constexpr_internal(c, depth + 1)!
                    return r.fold_cast(c, v, depth)
        named: = r.resolve_ref_symbol(c)
        if sym_ptr: = named
            switch sym_ptr.kind
            case .enum_variant(tag_value)
                return tag_value
            default {}
        if decl_node: = r.const_decl_of(named)
            expr_node: = decl_node.get_var_decl_expr()
            if expr_node != null && expr_node.kind_id != .k_empty
                // A cycle (`const A = B; const B = A;`) is stopped here rather than at the depth
                // limit.
                // Caution: Track the path with a Map (keyed by the declaration node's address); a
                // List costs the square of the chain's length.
                decl_key: = Sz::decl_node
                if kept: = c.kept_const_fold(decl_key)
                    return c.reuse_const_fold(kept, decl_key, depth)!
                if c.resolving.consts.get(decl_key).unwrap_or(false)
                    throw .not_constant
                c.resolving.consts.set(decl_key, true)
                defer c.resolving.consts.remove(decl_key)
                outer_deepest: = c.statics.deepest
                c.statics.deepest = depth + 1
                v: = expr_node.eval_constexpr_internal(c, depth + 1) catch e
                    c.statics.deepest = math.max(outer_deepest, c.statics.deepest)
                    // A cut below is waiting to be reported: it went through this constant.
                    if c.resolving.cut_waiting
                        c.resolving.cut_path.push(decl_key)
                    throw e
                c.keep_const_fold(decl_key, v, c.statics.deepest - (depth + 1))
                c.statics.deepest = math.max(outer_deepest, c.statics.deepest)
                return v
        // **Name what was written and what would fold**: "path" is the compiler's word for a
        // dotted name, not the writer's.
        if !c.suppress_errors
            c.clear_scratch()
                .s("'\{r.text\}' is not a compile-time constant (only a `const`, an enum variant or \
                    a literal is)")
            c.err(r, c.scratch.slice())
        throw .not_constant

    priv fn fold_cast(r: Self$@, c: Sema_ctx$@, v: I64, depth: I32): I64 //<
        //< The value `T::x` gives for x's folded value v, as the generated code converts it
        //< An integer keeps T's low bits (`U8::300` is 44, `I8::200` is -56). A pointer's or a
        //< float's cast is left to what reads it, and nothing but a `Bool` casts to `Bool`.
        //< Caution: **Wrap at the machine's width, not the portable one.** The LLVM backend emits
        //< the folded value, so `Sz::` at 32 bits made a 64-bit target's `Sz` constant wrong.
        target: = c.env.scalar_repr_id(r.fold_type(c, depth + 1))
        if !c.env.is_integer(target)
            return v
        return wrap_to(v, c.env.get_primitive_bit_size(target), c.env.is_unsigned(target))

    fn fold_type(r: Self$@, c: Sema_ctx$@, depth: I32): I32 //<
        //< The type a constant subexpression folds at, unknown where nothing says (a bare literal)
        //< Once the bodies are typed, it is the node's own type. **The declaration walk folds
        //< before anything is typed** (an array length, an enum tag). So there it is read from the
        //< spelling: a literal's suffix, a cast's target, a constant's declared type, a variant's
        //< base type.
        unknown: = I32::sema_type_env.Builtin_type_id.unknown
        if r == null || depth > MAX_CONSTEXPR_DEPTH
            return unknown
        if r.type_id != 0 && !sema_type_env.is_unknown(r.type_id)
            return r.type_id
        switch r.kind_id
        case .k_integer
            return int_suffix_type_id(r.text)
        case .k_char
            return I32::sema_type_env.Builtin_type_id.u8_type
        case .k_bool
            return I32::sema_type_env.Builtin_type_id.bool_type
        case .k_expr_sizeof, .k_expr_offsetof
            return I32::sema_type_env.Builtin_type_id.size_type
        case .k_expr_primary
            return r.get_primary_inner_expr().fold_type(c, depth + 1)
        case .k_expr_unary
            return r.get_unary_target().fold_type(c, depth + 1)
        case .k_expr
            op: = r.get_binary_op().text
            if op.equals("==") || op.equals("!=") || op.equals("<") || op.equals(">") ||
                op.equals("<=") || op.equals(">=") || op.equals("&&") || op.equals("||")
                return I32::sema_type_env.Builtin_type_id.bool_type
            left: = r.get_binary_left().fold_type(c, depth + 1)
            if op.is_shift_op()
                return left
            return c.promoted_fold_type(left, r.get_binary_right().fold_type(c, depth + 1))
        case .k_expr_postfix
            op_node: = r.get_postfix_op()
            if op_node != null && op_node.text.equals("::")
                type_node: = r.get_postfix_member()
                if type_node == null
                    return unknown
                if type_node.type_id != 0 && !sema_type_env.is_unknown(type_node.type_id)
                    return type_node.type_id
                prev_sup: = c.suppress_errors
                c.suppress_errors = true
                defer c.suppress_errors = prev_sup
                return type_node.resolve_type(c) catch unknown
        default {}
        if r.kind_id != .k_identifier && r.kind_id != .k_expr_path && r.kind_id != .k_type_path &&
            r.kind_id != .k_expr_postfix
            return unknown
        named: = r.resolve_ref_symbol(c)
        if sym_ptr: = named
            switch sym_ptr.kind
            case .enum_variant
                return sym_ptr.type_id
            default {}
        if decl_node: = r.const_decl_of(named)
            t_node: = decl_node.get_decl_type_node()
            if t_node != null && t_node.type_id != 0 &&
                !sema_type_env.is_unknown(t_node.type_id)
                return t_node.type_id
        return unknown

    priv fn resolve_ref_symbol(r: Self$@, c: Sema_ctx$@): Sema_symbol$@? //<
        //< The symbol this reference names, or none
        //< It is read as any value's name is (read_written_name in name.kspl). A copy of the
        //< reading drifts until one folds and another does not.
        if path: = sema_decl_name.name_path_of(r)
            sym: = c.read_written_name(path).sym
            if sym != null
                return .some(sym)
        return .none

    priv fn const_decl_of(r: Self$@, named: Sema_symbol$@?): Ast_node$@? //<
        //< The referenced constant's declaration node
        //< Found by name where the lookup succeeds; otherwise the `def_node` Sema linked. null
        //< where it does not point at a constant.
        //< Caution: **Do not rely on the name alone.** The ABI pass (lower/abi.kspl) rewrites a
        //< `priv` top-level identifier's text into a mangled name (`kspl_priv_<file>_<name>`). The
        //< lookup is called from codegen too (named_const_init in gen/llvm/decl.kspl). By then the
        //< tree is rewritten, so the name is not in symtab.
        $decl_node: Ast_node$@ = null
        if sym_ptr: = named
            switch sym_ptr.kind
            case .constant
                decl_node = sym_ptr.node
            default {}
        if decl_node == null && r.def_node != null && r.def_node.kind_id == .k_decl_const
            decl_node = r.def_node
        if decl_node == null
            return .none
        // Caution: Link a resolved declaration to def_node. An annotation's array size (`a:
        // I32[n]`) is resolved only here; unlinked, [W0207] "unused" fires wrongly and the LSP
        // cannot jump to it.
        if r.def_node == null && (r.kind_id == .k_identifier || r.kind_id == .k_expr_path)
            r.def_node = decl_node
        return .some(decl_node)

    fn const_init_expr(r: Self$@, c: Sema_ctx$@): Ast_node$@? //<
        //< The initializing expression of the `const` this reference points at
        //< null where it points at no constant, or there is no initializer.
        //< Note: Both backends write it in place of a reference inside a top-level initializer. C
        //< requires a constant expression there, and in C99 the name of an object is not one,
        //< `const` or not. To LLVM a name is no constant either.
        if decl_node: = r.referenced_const(c)
            return .some(decl_node.get_var_decl_expr())
        return .none

    fn referenced_const(r: Self$@, c: Sema_ctx$@): Ast_node$@? //<
        //< The declaration of the `const` this reference points at, where it has an initializer
        if decl_node: = r.const_decl_of(r.resolve_ref_symbol(c))
            expr_node: = decl_node.get_var_decl_expr()
            if expr_node != null && expr_node.kind_id != .k_empty
                return .some(decl_node)
        return .none

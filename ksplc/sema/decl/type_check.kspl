//< Rejects badly written type expressions
//< **This reads types for a different purpose than the resolver.** `ksplc/sema/decl/resolve.kspl`
//< turns a name into a type id; here "it did not resolve / it is miswritten" becomes a diagnostic.
//< Caution: **Do not silently make it Unknown.** The mistake would show only as a differently
//< shaped C argument list ("Failing fast through an exception or an ICE" in
//< ksplc/docs/DESIGN-compiler.md).
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/sema/decl/access" as _sema_decl_access
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/decl/name" as sema_decl_name
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/session/ctx" { Sema_ctx }
import "std/chars"
import "std/ds" { List }
import "std/str" { Str_builder }

fn report_type_existence_error(c: Sema_ctx$@, kind: sema_decl_name.Written_kind, base_name: U8[],
    err_node: Ast_node$@) //<
        //< Reports what a written type's name is instead of a type, where it is not one
        //< base_name is the path as written up to its type arguments, the whole path for a value's.
    switch kind
    case .unknown_alias
        prefix: = base_name.fqn_head()
        c.clear_scratch().s("unknown import alias '\{prefix\}'")
        c.err(err_node, c.scratch.slice())
    case .elsewhere
        head: = base_name.fqn_head()
        if reach: = c.alias_reaching(head)
            c.report_without_alias(err_node, head, reach.path)
    case .names_value(what)
        c.clear_scratch().s("'\{base_name\}' is \{what.word()\}, not a type")
        if what == .function
            c.scratch.s(". A pointer to one has a function type, such as 'fn(x: I32): I32'")
        c.err(err_node, c.scratch.slice())
    case .not_found
        if !base_name.starts_with("_")
            c.clear_scratch().s("undefined type '\{base_name\}'")
            c.err(err_node, c.scratch.slice())
    default {}

fn refuse_type_args_on_plain_type(c: Sema_ctx$@, w: sema_decl_name.Written_type): Bool //<
    //< Reports type arguments written after a type that declares none, and says whether it did
    //< They would bind nothing and change nothing (Principle 5), in a type position and before a
    //< member alike (`Plain<|I32|>`, `Plain<|I32|>.mk(3)`), as after a function that declares none.
    if w.args == null || c.written_template(w) != null
        return false
    c.clear_scratch()
        .s("type '\{w.spelled\}' is not generic. Remove the type arguments '\{w.args.text\}'")
    c.err(w.args, c.scratch.slice())
    return true

priv fn check_and_report_type(node: Ast_node$@, c: Sema_ctx$@,
    gen_params: List<|Ast_node$@|>$@, err_node: Ast_node$@)
    w: = c.read_written_type(node)
    if w.spelled.len == 0
        return
    kind: = c.type_kind_of(w, gen_params)
    switch kind
    case .found
        // **A type reached through an import alias is checked for visibility here**, at the use.
        // Nothing at the `import` line names it, as a selective import does.
        if w.alias_file.len > 0
            if sym: = c.written_type_symbol(w)
                c.check_visibility_and_mark_used(sym, err_node)
        if w.member == null
            refuse_type_args_on_plain_type(c, w)
    case .names_value
        defer $path_str: = Str_builder.new()
        node.get_full_path_str_to(path_str)
        report_type_existence_error(c, kind, path_str.slice(), err_node)
    default
        report_type_existence_error(c, kind, w.spelled, err_node)

priv fn atom_path(atom: Ast_node$@): Ast_node$@? //< the path a type atom names its type by
    if atom.children.len == 0
        return .none
    first: = atom.get_child(0)
    if first.kind_id == .k_identifier || first.kind_id == .k_type_path ||
        first.kind_id == .k_expr_path || first.kind_id == .k_generic_path
        return .some(first)
    return .none

fn names_missing_type(c: Sema_ctx$@, type_node: Ast_node$@): Bool //<
    //< Whether a written type names a type check_and_report_type refuses as missing
    //< The resolver still gives such a name an id of its own. So **a binding of it is typed unknown
    //< instead** (declare_param in `../body/infer.kspl`). Its uses then add nothing to the one
    //< report, an unread-parameter warning included.
    if type_node == null
        return false
    if type_node.kind_id == .k_type_atom
        if path: = atom_path(type_node)
            w: = c.read_written_type(path)
            if w.spelled.len > 0
                switch c.type_kind_of(w, null)
                case .found {}
                default
                    return true
    for child in type_node.children
        if names_missing_type(c, child)
            return true
    return false

priv fn refuse_sizeof_of_value_name(c: Sema_ctx$@, target: Ast_node$@,
    gen_params: List<|Ast_node$@|>$@): Bool //<
        //< Reports a `sizeof` of a function's name or a type's member, and says whether it did
        //< **A function's size has no one meaning** (`sizeof(twice)`, `sizeof(same<|I32|>)`): the
        //< pointer's, the machine code's or the result's would each be one reader's guess. The
        //< message names the form that gives a pointer's size. A target with a postfix (`twice@`)
        //< is a type, left to the type position's report.
    if target == null || target.kind_id != .k_type_expr || target.children.len != 1
        return false
    atom: = target.get_child(0)
    if atom.kind_id != .k_type_atom || atom.children.len != 1
        return false
    path: = atom.get_child(0)
    if path.kind_id != .k_identifier && path.kind_id != .k_type_path &&
        path.kind_id != .k_expr_path
        return false
    defer $path_str: = Str_builder.new()
    path.get_full_path_str_to(path_str)
    full: = path_str.slice()
    switch c.type_kind_of(c.read_written_type(path), gen_params)
    case .names_value(what)
        if what == .function
            c.clear_scratch()
                .s("'sizeof' cannot take the function '\{full\}'. A function's size has no single \
                    meaning. A function pointer has the size of a function type, such as \
                    'sizeof(fn(x: I32): I32)'")
        else if what == .type_member
            c.clear_scratch()
                .s("'sizeof' cannot take '\{full\}'. A member named through its type is neither a \
                    type nor a value. For a field, write its type. For a method, write a function \
                    type")
        else
            return false
        c.err(target, c.scratch.slice())
        return true
    default
        return false

priv fn sizeof_may_name_value(c: Sema_ctx$@, target: Ast_node$@, bound: List<|U8[]|>$@): Bool //<
    //< Whether a `sizeof` target's first name may be a value: one the function binds, or a global
    defer $names: = List<|Ast_node$@|>.new(null)
    target.sizeof_path_names(names@)
    if names.len == 0
        return false
    head: = names.get(0).text
    if bound != null
        for name in bound$
            if name.equals(head)
                return true
    return target.sizeof_named_value(c).is_some()

impl Ast_node
    priv fn collect_bound_names(r: Ast_node$@, out: List<|U8[]|>$@) //<
        //< The names r's subtree binds as values: parameters, variables and the other bindings
        if r == null
            return
        k: = r.kind_id
        if k == .k_decl_var || k == .k_decl_var_item || k == .k_fn_param || k == .k_if_bind ||
            k == .k_identifier_list || k == .k_expr_catch
            for child in r.children
                if child.kind_id == .k_identifier
                    out.push(child.text)
        for child in r.children
            child.collect_bound_names(out)

    priv fn report_untyped_fn_ptr_params(r: Ast_node$@, c: Sema_ctx$@) //<
        //< Reports a formal parameter of a function pointer type (`fn(…): R`) with no type written
        //< Caution: **It must not be silently made Unknown.** `fn(T): T` is a parameter named `T`
        //< with no type. **Decide by whether a type is written**: parse/normalize.kspl adds an
        //< empty `type_expr` anyway.
        param_list: = r.get_fn_params()
        if param_list == null
            return
        for p in base_ast_ext.Param_cursor.new(param_list, false)
            t_node: = p.find_child(.k_type_expr)
            if t_node != null && t_node.children.len > 0
                continue
            c.err(p,
                "a parameter of this function-pointer type has no type. Inside 'fn(...)', a bare \
                    name is the parameter's name, not its type. Write 'fn(name: Type): Ret'")

    priv fn report_bad_param_defaults(r: Ast_node$@, c: Sema_ctx$@,
        gen_params: List<|Ast_node$@|>$@, is_closure: Bool) //<
            //< Checks a parameter's default value at the declaration, once, not per instance
            //< **`k_type_fn_sig` is both a function's and a function pointer type's**; one
            //< rejection covers both.
        param_list: = r.find_child(.k_param_list)
        if param_list == null
            return
        $seen_default: = false
        for p in base_ast_ext.Param_cursor.new(param_list, false)
            d: = p.get_param_default()
            if d == null
                if seen_default
                    c.err(p,
                        "a parameter without a default cannot follow one that has a default. Move \
                            the defaults to the end of the list")
                continue
            seen_default = true
            if is_closure
                c.err(d, "a closure parameter cannot have a default value")
                continue
            if !d.is_const_param_default()
                c.err(d,
                    "a parameter default must be a literal (a number, 'true'/'false', a character, \
                        a string, or 'null')")
                continue
            t_node: = p.get_decl_type_node()
            if t_node != null && t_node.mentions_gen_param(gen_params)
                c.err(d,
                    "a parameter whose type mentions a type parameter cannot have a default value")

    fn check_spelled_out_sugar(r: Ast_node$@, c: Sema_ctx$@) //<
        //< Refuses each type under r that spells a slice, an optional or a result out
        //< It refuses an optional error type (`T!E?`) too.
        //< **One spelling per type** (Principle 6 in docs/DESIGN-principles.md): `T[]` / `T$[]`,
        //< `T?` and `T!E` stand everywhere a type does, an `impl`'s target included. An expression
        //< keeps the long form (`Option<|I32|>.none`), as no postfix can stand there. **Read from
        //< the tree as written**, once: an instance's copy would repeat it. A declaration the
        //< compiler made is skipped.
        if r == null || r.made_by_compiler()
            return
        if r.kind_id == .k_type_atom && r.children.len > 0
            path: = r.get_child(0)
            if path.is_sugar_made()
                w: = c.read_written_type(path)
                // `T!E?` folds `?` into the error type; an absent error would be a failure with
                // nothing to say.
                if w.fqn.equals(base_core.RESULT_FQN) && w.args != null &&
                    w.args.children.len > 1 && w.args.get_child(1).names_optional(c)
                    c.err(r,
                        "an error type cannot be optional. Write an optional result as '(T!E)?'. If \
                            only the result's value can be absent, write 'T?!E'")
            else if path.kind_id == .k_expr_path || path.kind_id == .k_type_path
                w: = c.read_written_type(path)
                if w.args != null && w.member == null
                    if w.fqn.equals(base_core.RESULT_FQN)
                        c.err(r,
                            "a result type is written 'T!E', not 'Result<|T, E|>'. The long form \
                                stands only in an expression, as in 'Result<|I32, E|>.ok(1)'")
                    else if w.fqn.equals(base_core.OPTION_FQN)
                        c.err(r,
                            "an optional type is written 'T?', not 'Option<|T|>'. Put a result or \
                                function type in parentheses first: '(T!E)?'. The long form stands \
                                only in an expression, as in 'Option<|I32|>.none'")
                    else if w.fqn.equals(base_core.SLICE_FQN)
                        c.err(r,
                            "a slice type is written 'T[]', or 'T$[]' for writable elements, not \
                                'Slice<|T|>' / 'Slice<|$T|>'")
        for child in r.children
            child.check_spelled_out_sugar(c)

    priv fn names_optional(r: Ast_node$@, c: Sema_ctx$@): Bool //<
        //< Whether the type argument r, as written, is an optional (`E?`)
        $at: = r
        for at != null && (at.kind_id == .k_type_expr || at.kind_id == .k_type_arg) &&
            at.children.len > 0
            at = at.last_child()
        if at == null || at.kind_id != .k_type_atom || at.children.len == 0
            return false
        path: = at.get_child(0)
        return path.is_sugar_made() &&
            c.read_written_type(path).fqn.equals(base_core.OPTION_FQN)

    priv fn mentions_gen_param(r: Ast_node$@, gen_params: List<|Ast_node$@|>$@): Bool //<
        //< Whether the type's name names one of the type parameters currently in scope
        //< Caution: **Walk the tree**; checking only the outermost name misses `List<|T|>` and
        //< `T$@`.
        if (r.kind_id == .k_identifier || r.kind_id == .k_type_path) &&
            sema_decl_name.gen_param_named(gen_params, r.text).is_some()
            return true
        for ch in r.children
            if ch.mentions_gen_param(gen_params)
                return true
        return false

    priv fn push_own_gen_params(r: Ast_node$@, gen_params: List<|Ast_node$@|>$@): I32 //<
        //< Pushes the type parameters r declares, and returns how many
        gen_node: = r.find_child(.k_type_gen_params)
        if gen_node == null
            return 0
        $added: = 0
        for p in gen_node.children
            if _id: = p.gen_param_id_node()
                gen_params.push(p)
                added += 1
        return added

    priv fn check_type_arg_kinds(r: Ast_node$@, c: Sema_ctx$@, tmpl: Ast_node$@,
        gen_params: List<|Ast_node$@|>$@, bound: List<|U8[]|>$@) //<
            //< Checks each argument of a `<|…|>` in a generic's declaration against its parameter
            //< **Only in a generic's declaration.** A template is resolved only as its instances,
            //< where its own parameters' names are already their arguments. Elsewhere each is
            //< judged where it is resolved (build_resolved_type_args in resolve.kspl). tmpl is null
            //< where the declarations do not tell whose. An argument computing a value is refused
            //< here too, once. An argument standing for a value is not read as a type.
        params: = tmpl.find_child(.k_type_gen_params) if tmpl != null else null
        $pos: Sz = 0
        for arg in r.children
            if arg.kind_id == .k_literal || arg.kind_id == .k_keyword || arg.kind_id == .k_empty
                continue
            own: = sema_decl_name.gen_param_named(gen_params, arg.bare_written_name())
                .unwrap_or(null)
            param: = params.gen_param_at(pos)
            pos += 1
            if sema_decl_resolve.refuses_arg_kind(c, arg, tmpl, param, own) ||
                (own == null && sema_decl_resolve.refuses_computed_arg(c, arg))
                continue
            is_value: =
                (own.is_const_gen_param() if own != null
                else sema_decl_resolve.written_arg_is_value(arg, c))
            if !is_value
                arg.validate_all_type_exprs(c, gen_params, bound)

    priv fn refuse_type_param_length(r: Ast_node$@, c: Sema_ctx$@,
        gen_params: List<|Ast_node$@|>$@) //<
            //< Reports an array's length that names a type parameter (`I32[T]` for `<|T|>`)
        if !r.text.strip_prefix("$").starts_with("[") || r.children.len == 0
            return
        length: = r.get_child(0)
        name: = length.bare_written_name()
        switch sema_decl_name.gen_param_named(gen_params, name)
        case .some(gp)
            if gp.is_const_gen_param()
                return
            c.clear_scratch()
                .s("'\{name\}' is a type parameter. An array's length is a value\n  Hint: declare \
                    it 'const \{name\}: Sz' to pass a value through it")
            c.err(length, c.scratch.slice())
        case .none {}

    fn validate_all_type_exprs(r: Ast_node$@, c: Sema_ctx$@,
        gen_params: List<|Ast_node$@|>$@, bound: List<|U8[]|>$@ = null) //<
            //< Reports each type expression under r naming no type
            //< bound lists the names a function binds (parameters and locals), once inside one.
        if r == null
            return
        // **A `sizeof` naming a value is the body's to read** (`sizeof(x)`, `sizeof(x.a)`). No
        // local is in scope yet here. So a name the function binds is left to infer_sizeof_expr in
        // `../body/expr.kspl`, which has the scope. A global's name reads the same way.
        if r.kind_id == .k_expr_sizeof &&
            (sizeof_may_name_value(c, r.get_sizeof_target(), bound) ||
            refuse_sizeof_of_value_name(c, r.get_sizeof_target(), gen_params))
            return
        defer $collected: = List<|U8[]|>.new(null)
        $inner_bound: = bound
        if r.kind_id == .k_decl_fn && bound == null
            r.collect_bound_names(collected@)
            inner_bound = collected@

        $added_params: = 0
        if r.kind_id == .k_decl_struct || r.kind_id == .k_decl_fn || r.kind_id == .k_decl_impl ||
            r.kind_id == .k_decl_trait || r.kind_id == .k_decl_enum
            added_params = r.push_own_gen_params(gen_params)
        if r.kind_id == .k_decl_impl
            if trait_node: = r.get_impl_trait_node()
                check_and_report_type(trait_node, c, gen_params, trait_node)
        if r.kind_id == .k_type_constraint
            for p_node in r.children
                if p_node.kind_id == .k_type_path || p_node.kind_id == .k_expr_path
                    check_and_report_type(p_node, c, gen_params, p_node)

        if r.kind_id == .k_type_fn_sig
            r.report_bad_param_defaults(c, gen_params, false)
        if r.kind_id == .k_expr_fn_lit_sig
            r.report_bad_param_defaults(c, gen_params, true)
        if r.kind_id == .k_type_atom
            if path_node: = atom_path(r)
                check_and_report_type(path_node, c, gen_params, r)

        // **A cast on a module (`io::out()`) is left to the body's analysis**, which reads the
        // `::` as the path its writer meant and reports it once (`read_as_path` in
        // `../body/postfix.kspl`). Reported here as well, one mistake would give two errors.
        $left_to_body: Ast_node$@ = null
        if r.kind_id == .k_expr_postfix && r.children.len >= 3 &&
            r.get_postfix_op().is_literal("::")
            if path: = r.get_postfix_member().bare_type_path()
                if path.children.len == 1 && c.names_module_only(path.get_child(0).text)
                    left_to_body = r.get_postfix_member()
        if r.kind_id == .k_type_postfix
            r.refuse_type_param_length(c, gen_params)
        for child in r.children
            // **A declared function's own signature is no function-pointer type.** The function's
            // check reports its untyped parameter and names the parameter (`check_param_type` in
            // `../session/ctx.kspl`). Read here too, one mistake gave two errors.
            if child.kind_id == .k_type_fn_sig && r.kind_id != .k_decl_fn
                child.report_untyped_fn_ptr_params(c)
            if child.kind_id == .k_type_args && gen_params.len > 0
                child.check_type_arg_kinds(c,
                    c.template_of_args(r, child).unwrap_or(null), gen_params, inner_bound)
            else if child != left_to_body
                child.validate_all_type_exprs(c, gen_params, inner_bound)
        if added_params > 0
            gen_params.len -= added_params

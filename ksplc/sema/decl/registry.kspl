//< The pass that registers struct / enum / trait **contents** in the type table
//< collect records what is declared; this resolves the contents, which need every name to exist,
//< so the order is always collect → registry.
//< Caution: **Do not register the same type twice.** Instantiations bring the same base name many
//< times; registered again, the fields and the layout double.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/sema/decl/access" as sema_decl_access
import "ksplc/sema/decl/declare" as sema_decl_declare
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/decl/trait_check" as sema_decl_trait_check
import "ksplc/sema/session/c_boundary" as sema_session_c_boundary
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error, join_dotted_name }
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" as sema_type_scope + { Sema_symbol }
import "std/chars"
import "std/ds" { Map }
import "std/str"

enum Reg_type_res //< the result of trying to register a type
    //< `invalid`: the name could not be registered (the caller reports it).
    ok(name: U8[], fqn: U8[], type_id: I32)
    invalid

impl Ast_node
    fn register_type_sym(r: Ast_node$@, c: Sema_ctx$@, top_vis: sema_type_scope.Visibility,
        sym_kind_normal: sema_type_scope.Sym_kind, sym_kind_gen: sema_type_scope.Sym_kind):
        Reg_type_res
        name_node: = r.find_child(.k_identifier)
        if name_node == null
            return .invalid

        name: = name_node.text
        name_node.def_node = r
        fqn: = c.make_fqn(name)
        has_gen: = (r.find_child(.k_type_gen_params) != null)

        if has_gen
            sema_decl_declare.register_template(c, fqn, r)

        $sym_kind: = sym_kind_normal
        if has_gen
            sym_kind = sym_kind_gen

        sym: = Sema_symbol(sym_kind, name, r)
        sym.vis = top_vis
        sym.type_id = c.env.get_or_add(fqn)
        r.type_id = sym.type_id
        sym.apply_attributes()
        c.declare_symbol_with_fqn(name, fqn, sym)

        if has_gen
            return .invalid
        return .ok(name, fqn, sym.type_id)

    fn get_registry_target(r: Ast_node$@, c: Sema_ctx$@): Reg_type_res
        if r.find_child(.k_type_gen_params) != null
            return .invalid
        name_node: = r.find_child(.k_identifier)
        if name_node == null
            return .invalid
        name: = name_node.text
        fqn: = c.make_fqn(name)
        return .ok(name, fqn, 0)

    fn build_trait_registry(r: Ast_node$@, c: Sema_ctx$@): Void!Sema_error
        switch r.get_registry_target(c)
        case .ok(target_name, target_fqn, _id)
            trait_def: sema_type_def.Trait_def$@ = c.env.get_trait_def(target_fqn) catch
                return

            trait_vis: = r.get_visibility()
            c.fn_ctx.impl_name = target_fqn

            for m_node in r.children
                // Caution: **Register a method with a default body the same way.** It is a
                // `decl_fn` (decl_trait in `kspl.kspeg`), and if missed it is not in the vtable.
                if m_node.kind_id == .k_decl_fn_proto || m_node.kind_id == .k_decl_fn
                    m_name_node: = m_node.find_child(.k_identifier)
                    if m_name_node != null
                        m_name: = m_name_node.text
                        c.check_snake_case(m_name, m_node, "Method")

                        m_sym: = c.add_trait_method(m_node, m_name, trait_def, trait_vis)!

                        local_full_name: = join_dotted_name(target_name, m_name)
                        fqn_full_name: = join_dotted_name(target_fqn, m_name)
                        c.declare_symbol_with_fqn(local_full_name, fqn_full_name, m_sym)
            c.fn_ctx.impl_name = ""
        default {}

    fn build_type_registry(r: Ast_node$@, c: Sema_ctx$@): Void!Sema_error //<
        //< Dispatches on the declaration's kind to fill it in
        //< Caution: **Code that needs a declaration filled in calls this**, so no caller misses a
        //< kind.
        switch r.kind_id
        case .k_decl_struct
            r.build_struct_registry(c)!
        case .k_decl_enum
            r.build_enum_registry(c)!
        default {}

    fn build_struct_registry(r: Ast_node$@, c: Sema_ctx$@): Void!Sema_error
        switch r.get_registry_target(c)
        case .ok(_name, target_fqn, _id)
            struct_def: sema_type_def.Struct_def$@ =
                c.env.get_struct_def(target_fqn) catch
                return
            // Caution: **Clear it before resolving the fields.** A field's type can request the
            // layout (`f: U8[sizeof(S)]`), and clearing it later fills the declaration in twice.
            if struct_def.pending_decl == null
                return // already filled in (when the layout was requested)
            struct_def.pending_decl = null
            // Caution: **Record "filling in" only here.** collect's Pass 3 calls this directly;
            // recorded by the caller instead, a `sizeof` cycle is missed
            // (Resolving_state.registries in sema/session/state.kspl).
            c.resolving.registries.push(c.env.get_or_add(target_fqn))
            defer c.resolving.registries.len -= 1
            // **Put the name back in a `defer`**: a `!` below leaves before the line after it.
            outer_impl: = c.fn_ctx.impl_name
            defer c.fn_ctx.impl_name = outer_impl
            c.fn_ctx.impl_name = target_fqn
            r.fill_struct_fields(c, struct_def)!
        default {}

    fn fill_struct_fields(r: Ast_node$@, c: Sema_ctx$@, struct_def: sema_type_def.Struct_def$@):
        Void!Sema_error //<
            //< Resolves a struct declaration's (self's) layout attributes and fields to struct_def
            //< build_struct_registry and a generic struct's instantiation (instantiate_struct in
            //< mono.kspl) both fill through here. So an instance is checked as a plain struct is.
        if r.has_attribute("packed")
            struct_def.is_packed = true
        // sema/decl/attrs.kspl checks the value's form; only usable values reach here.
        // Caution: **Do not copy that check here** (fix only one and the messages disagree).
        align_val: = c.eval_attribute_arg(r, "align")
        if align_val > 0
            struct_def.align_attr = align_val

        // This map finds duplicates: get_field per field is O(n^2) and hangs on a huge struct.
        defer $seen_fields: = Map<|U8[], Bool|>(null)

        struct_vis: = r.get_visibility()

        for c_node in r.children
            if c_node.kind_id != .k_struct_field
                continue
            f_vis: = c_node.get_visibility()
            f_id_node: = c_node.find_child(.k_identifier)
            f_name: = f_id_node.text if f_id_node != null else ""
            if f_id_node != null
                f_id_node.def_node = c_node
            f_type_node: = c_node.get_decl_type_node()

            if f_name.len == 0 || f_type_node == null
                continue
            c.check_snake_case(f_name, c_node, "Field")
            f_type_id: = f_type_node.resolve_type(c)!
            f_eff_vis: = sema_decl_access.narrower_vis(struct_vis, f_vis)
            c.check_type_vis_leak(f_type_node, f_eff_vis, "field type", "field")
            real_f_type: = c.env.get_real_type(f_type_id)
            if sema_type_env.is_void(real_f_type)
                c.err(f_type_node, "struct fields cannot be of type 'Void'")

            switch c.env.get_info(real_f_type)
            case .array(_b, s)
                if s == -1
                    c.err(f_type_node, "array size cannot be inferred for struct fields.")
            default {}

            // An array field's elements are made mutable: **the binding holding it**
            // decides writing, as for other fields ("The two axes of mutability" in
            // `docs/SPEC-programming-language.md`).
            // Caution: Write it back to the type node too; genc emits the type name from
            // there.
            eff_f_type: = c.binding_value_type(f_type_id, true)
            f_type_node.type_id = eff_f_type

            field_def: = sema_type_def.Struct_field(f_name, eff_f_type, f_vis, c_node)

            is_dup: = seen_fields.get(f_name).unwrap_or(false)
            if is_dup
                c.clear_scratch().s("field '\{f_name\}' is already defined in this struct")
                c.err(f_id_node, c.scratch.slice())
            else if !c.check_c_keyword_collision_field(f_name, f_id_node, seen_fields@)
                seen_fields.set(f_name, true)
                struct_def.fields_list.push(field_def)

    priv fn scan_payload_fields(r: Ast_node$@, c: Sema_ctx$@,
        variant_def: sema_type_def.Enum_variant$@, enum_vis: sema_type_scope.Visibility):
        Void!Sema_error //<
            //< Resolves an enum variant's (self's) payload fields, registering them in variant_def.
            //< enum_vis is the enum's own visibility: a payload field has none of its own (public
            //< below).
        for f_list in r.children
            if f_list.kind_id != .k_enum_payload
                continue
            for f_node in f_list.children
                if f_node.kind_id != .k_enum_field
                    continue
                f_name_node: = f_node.get_enum_field_name_node()
                f_name: = f_name_node.text if f_name_node != null else ""
                c.check_snake_case(f_name, f_node, "Field")
                // genc avoids a payload's field names too (the same treatment as a struct's
                // fields).
                f_type_node: = f_node.get_enum_field_type_node()
                resolved_id: = f_type_node.resolve_type(c)! if f_type_node != null else 0
                // The same leak as a struct's pub field: `switch e case .some(x)` binds it from
                // outside.
                c.check_type_vis_leak(f_type_node, enum_vis, "payload type", "variant")
                // An array's elements are made mutable, as a struct field's are
                // (fill_struct_fields). The binding holding the enum decides writing. A `const`
                // member would make C refuse to assign a whole value of the enum.
                f_type_id: = c.binding_value_type(resolved_id, true)
                if f_type_node != null
                    f_type_node.type_id = f_type_id
                f_node.type_id = f_type_id
                if f_name_node != null
                    f_name_node.def_node = f_node
                    f_name_node.type_id = f_type_id
                // **A `Void` field holds nothing**, so the variant does not carry it: `Result`'s
                // `ok(value: T)` under `Void!E` is built and matched with no value (`.ok()`).
                if c.env.get_clean_real_type(f_type_id) == I32::sema_type_env.Builtin_type_id
                    .void_type
                    continue
                field_def: = sema_type_def.Struct_field(f_name, f_type_id, .public, f_node)
                variant_def.payload_fields.push(field_def)

    fn build_enum_registry(r: Ast_node$@, c: Sema_ctx$@): Void!Sema_error
        switch r.get_registry_target(c)
        case .ok(_name, target_fqn, _id)
            enum_def: sema_type_def.Enum_def$@ = c.env.get_enum_def(target_fqn) catch
                return
            // For the same reason as at the matching point in build_struct_registry.
            if enum_def.pending_decl == null
                return // already filled in
            enum_def.pending_decl = null
            type_id: = c.env.get_or_add(target_fqn)
            c.resolving.registries.push(type_id)
            defer c.resolving.registries.len -= 1
            outer_impl: = c.fn_ctx.impl_name
            defer c.fn_ctx.impl_name = outer_impl
            c.fn_ctx.impl_name = target_fqn
            r.fill_enum_variants(c, enum_def, type_id, true)!
        default {}

    fn fill_enum_variants(r: Ast_node$@, c: Sema_ctx$@, enum_def: sema_type_def.Enum_def$@,
        type_id: I32, declare_syms: Bool): Void!Sema_error //<
            //< Resolves an enum declaration's (self's) base type and variants into enum_def
            //< The counterpart of fill_struct_fields. `declare_syms` adds each variant to the name
            //< table as `Enum.variant`; a generic enum's instance passes false and is reached
            //< through its type.
        $base_type_id: = I32::sema_type_env.Builtin_type_id.i32_type
        base_type_node: = r.get_decl_type_node()
        if base_type_node != null
            base_type_id = base_type_node.resolve_type(c)!
        enum_def.base_type_id = base_type_id
        $current_tag: I64 = 0
        enum_name: = r.get_decl_id_text()
        enum_vis: = r.get_visibility()
        enum_fqn: = c.make_fqn(enum_name) if declare_syms else ""

        // A local map, for the same reason as fill_struct_fields's.
        defer $seen_variants: = Map<|U8[], Bool|>(null)
        defer $seen_tags: = Map<|I64, U8[]|>(null)

        for v_node in r.children
            if v_node.kind_id != .k_enum_variant
                continue
            v_id_node: = v_node.find_child(.k_identifier)
            if v_id_node == null
                continue
            v_name: = v_id_node.text
            v_id_node.def_node = v_node
            v_node.type_id = type_id
            c.check_snake_case(v_name, v_id_node, "Enum variant")

            variant_def: = sema_type_def.Enum_variant(v_name, current_tag, v_node)
            tag_node: = v_node.get_enum_variant_tag()
            $foldable: = tag_node != null
            if bare: = r.bare_sibling_variant(c, tag_node)
                c.clear_scratch()
                    .s("'\{bare.text\}' is a variant of '\{enum_name\}'. Name the variant through \
                        its enum here too ('\{enum_name\}.\{bare.text\}')")
                c.err(bare, c.scratch.slice())
                foldable = false
            if foldable
                if tag: = c.fold_enum_tag(tag_node, base_type_id)
                    variant_def.tag_value = tag
            else
                c.check_enum_tag_range(v_id_node, current_tag, base_type_id)
            earlier: = seen_tags.get(variant_def.tag_value).unwrap_or("")
            if earlier.len > 0
                if !earlier.equals(v_name)
                    c.clear_scratch()
                        .s("variant '\{v_name\}' has the tag \{variant_def.tag_value\}. Variant \
                            '\{earlier\}' already has that tag. A 'switch' could not distinguish \
                            them. Give each variant a tag of its own")
                    c.err(v_id_node, c.scratch.slice())
            else
                seen_tags.set(variant_def.tag_value, v_name)
            current_tag = variant_def.tag_value + 1

            if declare_syms
                arena_full_name: = join_dotted_name(enum_name, v_name)
                v_kind: = sema_type_scope.Sym_kind.enum_variant(variant_def.tag_value)
                v_sym: = Sema_symbol(v_kind, arena_full_name, v_node)
                v_sym.type_id = type_id
                v_sym.vis = enum_vis
                c.declare_symbol_with_fqn(arena_full_name, join_dotted_name(enum_fqn, v_name), v_sym)

            v_node.scan_payload_fields(c, variant_def, enum_vis)!
            is_dup: = seen_variants.get(v_name).unwrap_or(false)
            if is_dup
                c.clear_scratch().s("variant '\{v_name\}' is already defined in this enum")
                c.err(v_id_node, c.scratch.slice())
            else
                seen_variants.set(v_name, true)
                enum_def.variants_list.push(variant_def)

    priv fn bare_sibling_variant(r: Ast_node$@, c: Sema_ctx$@, tag: Ast_node$@): Ast_node$@? //<
        //< A bare name in a tag expression that names a variant of this enum (self)
        //< **A tag names a sibling as `E.a`, as every other place does.** There is one spelling for
        //< a variant, and no scope where the enum's names stand bare beside the file's. A bare name
        //< that resolves (a `const a`) is that name, not the variant.
        if tag == null
            return .none
        if tag.is_path_or_ident() && tag.text.find_char('.').is_none()
            known: = c.symtab.resolve(tag.text).unwrap_or(null)
            if known != null
                return .none
            for v_node in r.children
                if v_node.kind_id == .k_enum_variant
                    id_node: = v_node.find_child(.k_identifier)
                    if id_node != null && id_node.text.equals(tag.text)
                        return .some(tag)
            return .none
        for child in tag.children
            if found: = r.bare_sibling_variant(c, child)
                return .some(found)
        return .none

impl Sema_ctx
    priv fn fold_enum_tag(r: Self$@, node: Ast_node$@, base_id: I32): I64? //<
        //< A written tag folded at 64 bits and checked against the base type, or none (reported)
        v: = node.eval_constexpr_wide(r) catch
            if !r.has_error()
                r.err(node, "an enum tag must be a compile-time constant")
            return .none
        if !r.check_enum_tag_range(node, v, base_id)
            return .none
        return .some(v)

    priv fn check_enum_tag_range(r: Self$@, node: Ast_node$@, v: I64, base_id: I32): Bool //<
        //< Whether the tag fits the enum's base type; where not, it reports and answers false
        //< The counter after the last written tag is checked as well: `b` after `a = 255` in a
        //< `U8`.
        bounds: = r.env.int_bounds(base_id)
        lo: = bounds.lo
        hi: = bounds.hi
        if v >= lo && v <= hi
            return true
        shown: = r.env.display(base_id)
        r.clear_scratch()
            .s("enum tag \{v\} does not fit the enum's base type '\{shown\}' (\{lo\} to \{hi\}). \
                Write a tag in range, or give the enum a wider base type ('enum E: I64')")
        r.err(node, r.scratch.slice())
        return false

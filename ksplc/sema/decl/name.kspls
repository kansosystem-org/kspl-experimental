//< What a name as written names: the one reader of a written type's, value's or function's name
//<
//< **Every route to a type the source names reads the name here** (read_written_type), and
//< **every route to a value or a function** too (read_written_name): a call's callee, a value's
//< path, a member reached through its type (`m.Box<|I64|>.get`). The head is read through this
//< file's scopes and imports (a local, a type parameter, `Self`, a selective import under its own
//< name or another, this file's own declaration), the segments after an import alias within the
//< file it names, and each `<|…|>` by where it stands. So a way of reaching a name holds on every
//< route, or on none.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as _base_ast_ext
import "ksplc/base/ast_place" as _base_ast_place
import "ksplc/base/ast_spell" as _base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/sema/decl/access" as _sema_decl_access
import "ksplc/sema/decl/mono" as sema_decl_mono
import "ksplc/sema/decl/mono_name" as sema_decl_mono_name
import "ksplc/sema/decl/resolve" as sema_decl_resolve
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error, join_dotted_name }
import "ksplc/sema/session/import_table" as sema_session_import_table
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as _sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/chars"
import "std/ds" { List }
import "std/str" { Str_builder }

enum Named_value //< what a name written where a type goes names instead
    function
    variable
    type_member //< `Point.x`, `Box<|I32|>.keep`
    value_member //< `g.x`, a global's member

impl Named_value
    fn word(r: Self$@): U8[] //< the noun the diagnostic uses
        switch r$ case .function
            return "a function"
        case .variable
            return "a variable"
        case .type_member
            return "a member of a type"
        case .value_member
            return "a member of a value"

enum Written_kind //< what the type a written path begins with is
    found //< a type this file reaches
    not_found //< no type of that name this file can see
    elsewhere //< another file's declaration, written without the import alias reaching it
    unknown_alias //< `x.T`, where x is no import alias and names no type
    names_value(what: Named_value) //< a value's name or a member's, not a type's

struct Written_type //< what a written path's leading type is called, read from its tree
    spelled: U8[] //< the path as written up to its first `<|…|>` (`m.Box`), for a diagnostic
    fqn: U8[] //< the FQN the type's name resolves to; its spelling where nothing answers
    alias_file: U8[] //< the file the import alias before the type's name names, or ""
    name: U8[] //< the type's own name as written (`Box` of `m.Box`)
    args: Ast_node$@ //< the `<|…|>` written right after the type's name, or null
    member: Ast_node$@ //< the first name after the type's own, or null

priv struct Path_parts //< a path's segments and `<|…|>`, in order, as the tree holds them
    //<
    //< A lone name is its own one segment. **A view of the tree, not a copy**: a type's name is
    //< read on every use of it, and a list per read is garbage on the arena.
    path: Ast_node$@ //< the path, or a lone name; null is no segment

impl Path_parts
    priv fn is_path(r: Self): Bool //< whether the segments are the path's children
        return r.path.kind_id == .k_expr_path || r.path.kind_id == .k_type_path ||
            r.path.kind_id == .k_generic_path

    fn len(r: Self): Sz //< how many segments and `<|…|>` there are
        if r.path == null
            return 0
        return r.path.children.len if r.is_path() else 1

    fn get(r: Self, at: Sz): Ast_node$@ //< the one at position at, which must be below len
        return r.path.get_child(at) if r.is_path() else r.path

priv fn spelled_before_args(parts: Path_parts): U8[] //<
    //< The segments up to the first `<|…|>`, joined by `.` (`m.Plain.gen` of `m.Plain.gen<|U16|>`)
    $b: = Str_builder.new()
    defer b.free()
    for i in Range.asc(parts.len())
        part: = parts.get(i)
        if part.kind_id == .k_type_args
            break
        if i > 0
            b.c('.')
        b.s(part.text)
    return base_core.pools.name_text(b.slice())

fn written_name_of(type_node: Ast_node$@): Option<|Ast_node$@|> //<
    //< The name a type expression is written as, where it is no more than a name
    //<
    //< A postfix (`U8[4]`, `Foo@`) or a function type makes it more.
    if type_node != null && type_node.kind_id == .k_type_expr &&
        type_node.find_child(.k_type_postfix) != null
        return .none
    return written_clause_of(type_node)

fn written_clause_of(type_node: Ast_node$@): Option<|Ast_node$@|> //<
    //< The name a type expression is built on (`ds.List<|I64|>` of `ds.List<|I64|>@`)
    //<
    //< A bare path, an identifier and an atom holding either are a name; a function type or a
    //< parenthesized type is none.
    if type_node == null
        return .none
    if type_node.kind_id == .k_type_path || type_node.kind_id == .k_expr_path ||
        type_node.kind_id == .k_identifier || type_node.kind_id == .k_generic_path
        return .some(type_node)
    if type_node.kind_id != .k_type_expr
        return .none
    $found: = type_node.find_child(.k_type_path)
    if found == null
        found = type_node.find_child(.k_expr_path)
    if found != null
        return .some(found)
    atom: = type_node.find_child(.k_type_atom)
    if atom == null || atom.find_child(.k_type_fn_sig) != null ||
        atom.find_child(.k_type_expr) != null
        return .none
    found = atom.find_child(.k_type_path)
    if found == null
        found = atom.find_child(.k_expr_path)
    if found != null
        return .some(found)
    if atom.children.len > 0 || atom.text.len > 0
        return .some(atom)
    return .none

struct Named_fn //<
    //< The expression naming a function, split by what each `<|…|>` on it belongs to
    owner: Ast_node$@ //<
        //< What the function is reached through, or null for a lone name
        //<
        //< On a path, the name before the last (`Holder` of `Holder<|I32|>.gm`); on a method call,
        //< the receiver.
    on_type: Ast_node$@ //<
        //< The `<|…|>` on the type a path goes through (`Holder<|I32|>.gm`, `ds.List<|I32|>.new`)
        //<
        //< null where there is none. They name the type's instance, not the function's.
    name: Ast_node$@ //< the function's own name (`gm`)
    own: Ast_node$@ //< the `<|…|>` after the function's name, its own type arguments, or null

fn named_fn(left: Ast_node$@): Named_fn //<
    //< Splits the expression naming a function by what each `<|…|>` on it belongs to
    //<
    //< A path can carry two groups (`Holder<|I32|>.gm<|U8|>`), so each is told by where it stands:
    //< after the last name, or after the name before it.
    //< Caution: **Read a callee's or a function value's type arguments through here, not by
    //< searching its text for a `<|…|>`.** Read as one name with one group,
    //< `Holder<|I32|>.gm<|U8|>` took the type's for the method's own, lost the method's, and
    //< reached C naming no function.
    $parts: = Named_fn::{ .owner = null, .on_type = null, .name = left, .own = null }
    if left == null || left.children.len == 0
        return parts
    if left.kind_id == .k_method_access
        parts.owner = left.get_postfix_receiver()
        parts.name = left.get_postfix_member()
        for child in left.children
            if child.kind_id == .k_type_args
                parts.own = child
        return parts
    $at: = left.children.len - 1
    if left.get_child(at).kind_id == .k_type_args && at > 0
        parts.own = left.get_child(at)
        at -= 1
    parts.name = left.get_child(at)
    if at > 0 && left.get_child(at - 1).kind_id == .k_type_args
        at -= 1
        parts.on_type = left.get_child(at)
    if at > 0
        parts.owner = left.get_child(at - 1)
    return parts

struct Alias_reach //< an import alias of this file, and the file it names
    alias: U8[]
    path: U8[]

enum Name_reach //< how a written value's or function's name was found, or why not
    nowhere //< nothing this file can see answers it
    here //< this file's scopes and declarations, or a name a selective import brought in
    alias //< within the file an import alias or a selectively imported type before it names
    absent //< that file holds no such head, so no later stage finds the name either
    through_type //< a member of the type the `.` before it recorded (Written_name.owner_id)
    by_fqn //< a declaration of another file, under its FQN written out through no import
    instance_type //< a generic type's instance written whole (`Box<|I32|>`): a type, not a value

struct Written_name //< what a written value's or function's name names, read from its tree
    parts: Named_fn //< the name split by what each `<|…|>` on it belongs to
    spelled: U8[] //< its segments as written, joined by `.`, without any `<|…|>` (`m.same`)
    fqn: U8[] //< what it is looked up under: an FQN, or spelled where nothing qualifies it
    head_file: U8[] //< the file the import alias or selective import heading it names, or ""
    sym: Sema_symbol$@ //< the declaration it names, or null
    template: Ast_node$@ //< the generic function's or method's template it names, or the type's
    fn_tmpl: sema_decl_mono.Fn_instance //<
        //< the template's key and the instance it is reached through
    owner_id: I32 //< the type a member is reached through, or 0
    reach: Name_reach

priv fn spelled_name(path: Ast_node$@): U8[] //< a path's segments joined by `.`, no `<|…|>`
    if path == null
        return ""
    if path.children.len == 0
        return path.text
    $b: = Str_builder.new()
    defer b.free()
    $is_first: = true
    for child in path.children
        if child.kind_id == .k_type_args
            continue
        if !is_first
            b.c('.')
        b.s(child.text)
        is_first = false
    return base_core.pools.name_text(b.slice())

fn name_path_of(node: Ast_node$@): Option<|Ast_node$@|> //<
    //< The path a value's name is written as, or none where node writes no name
    //<
    //< A `.` chain of names not yet inferred (`m.N` in an array's size, the target of an
    //< assignment) is that path, its segments in order.
    //< Caution: **Make one node for the whole chain**, not one per `.`: it is made on every read
    //< of an assignment's target, and a node per level is garbage on the arena.
    if node == null
        return .none
    if node.is_path_or_ident()
        return .some(node)
    $at: = node
    for !at.is_path_or_ident()
        if !names_member(at)
            return .none
        at = at.get_postfix_receiver()
        if at == null
            return .none
    path: = Ast_node.new(.k_expr_path, node.text, node.loc)
    add_chain(path, node)
    return .some(path)

priv fn names_member(node: Ast_node$@): Bool //< whether node is a `.` followed by a name
    if node.kind_id != .k_expr_postfix && node.kind_id != .k_method_access
        return false
    if node.kind_id == .k_expr_postfix && !node.get_postfix_op().is_literal(".")
        return false
    member: = node.get_postfix_member()
    return member != null && member.kind_id == .k_identifier

priv fn add_chain(path: Ast_node$@, node: Ast_node$@) //<
    //< Adds the segments of a `.` chain name_path_of accepted to path, the first first
    if !node.is_path_or_ident()
        add_chain(path, node.get_postfix_receiver())
        path.add_child(node.get_postfix_member())
    else if node.children.len == 0
        path.add_child(node)
    else
        for child in node.children
            path.add_child(child)

priv fn lookup_bare_name(c: Sema_ctx$@, name: U8[]): Sema_symbol$@ //<
    //< What one name stands for here, or null
    //<
    //< A local or argument first, then a top-level declaration, then a selective import's.
    //< Caution: Look up values here too, not only types, or `import "p" { twice };` passes and the
    //< use fails with `undefined path or identifier` (Principle 5 of docs/DESIGN.md).
    $sym: = c.symtab.resolve(name) catch null
    if sym == null
        imported_fqn: = c.imported_symbol_fqn(name)
        if imported_fqn.len > 0
            sym = c.symtab.resolve(imported_fqn) catch null
    return sym

priv fn template_named(c: Sema_ctx$@, name: U8[]): U8[] //<
    //< The FQN of the generic function a bare name names in this file, or "" for none
    //<
    //< This file's own declaration first, then a selective import's (std/lang's implicit ones
    //< too).
    //< Caution: **Do not look the bare name up in the template table.** A function's short name
    //< names it only inside its file, so it is not registered there (collect_fn_def in
    //< collect.kspls); another file's `priv fn same<|T|>` would answer for this file's call.
    own: = c.make_fqn(name)
    if (c.generics.templates.get(own) catch null) != null
        return own
    imported: = c.imported_symbol_fqn(name)
    if imported.len > 0 && (c.generics.templates.get(imported) catch null) != null
        return imported
    return ""

priv fn value_at(c: Sema_ctx$@, name: U8[]): Option<|Named_value|> //<
    //< What a name, short or an FQN, names if it is a function's or a variable's
    //<
    //< **A value's name is not a type** (`x: twice`, `sizeof(twice)`). Let through, it reaches C as
    //< a type of that name, which nothing declares.
    //< Caution: **A constant passes.** It stands where a type argument does (`Buf<|n|>`), and
    //< const_type_arg_value in resolve.kspls reads it there.
    sym: = c.symtab.resolve(name) catch null
    if sym == null
        return .none
    if sym.kind.names_function()
        return .some(.function)
    switch sym.kind case .variable
        return .some(.variable)
    default
        return .none

impl Sema_ctx
    fn read_written_type(r: Self$@, path: Ast_node$@): Written_type //<
        //< What a written path's leading type is called, and what follows it
        //<
        //< It reports nothing and instantiates nothing; what the type is, type_kind_of answers.
        parts: = Path_parts::{ .path = path }
        $w: = Written_type::{ .spelled = spelled_before_args(parts), .fqn = "", .alias_file = "",
            .name = "", .args = null, .member = null }
        if parts.len() == 0 || parts.get(0).kind_id == .k_type_args
            return w
        head: = parts.get(0).text
        w.name = head
        $at: Sz = 1
        if parts.len() > 1 && parts.get(1).kind_id != .k_type_args
            w.alias_file = r.get_file_alias_target(r.file_name, head)
        if w.alias_file.len > 0
            // `m.Box`: the name after an import alias is that file's.
            w.name = parts.get(1).text
            at = 2
            w.fqn = r.build_mod_fqn(w.alias_file, w.name)
        else
            w.fqn = r.resolve_fqn_for_type(head)
        if at < parts.len() && parts.get(at).kind_id == .k_type_args
            w.args = parts.get(at)
            at += 1
        if at < parts.len() && parts.get(at).kind_id != .k_type_args
            w.member = parts.get(at)
        return w

    fn type_kind_of(r: Self$@, w: Written_type, gen_params: List<|U8[]|>$@): Written_kind //<
        //< What the type w reads is: a type this file reaches, or why not
        //<
        //< gen_params lists the type parameters in scope that nothing binds yet (a template's own
        //< while its declaration is checked); null where there are none.
        if w.name.len == 0
            return .not_found
        kind: =
            (r.file_type_kind(w.alias_file, w.name, w.fqn) if w.alias_file.len > 0
            else r.bare_type_kind(w.name, gen_params))
        if w.member == null
            return kind
        // **A name after the type's is a member** (`Plain.dbl`, `Box<|I32|>.keep`): right after
        // the type's name, it is one of whatever the name before it names; after the type
        // arguments, one of the type.
        if w.args != null
            switch kind case .found
                return .names_value(.type_member)
            default
                return kind
        if w.alias_file.len > 0
            if r.file_has_type(w.alias_file, w.name)
                return .names_value(.type_member)
            return .not_found
        switch kind case .found
            return .names_value(.type_member)
        case .names_value(_w)
            return .names_value(.value_member)
        case .elsewhere
            return kind
        default
            return .unknown_alias

    priv fn file_type_kind(r: Self$@, target_file: U8[], name: U8[], fqn: U8[]): Written_kind //<
        //< What the name `name` of the file `target_file` (an import alias's) is, written as a type
        //<
        //< **What `m.gf` names is asked of its declaration**, as for this file's own names:
        //< file_has_type answers for a value's name too.
        if !r.file_has_type(target_file, name)
            return .not_found
        if what: = value_at(r, fqn)
            return .names_value(what)
        return .found

    priv fn bare_type_kind(r: Self$@, name: U8[], gen_params: List<|U8[]|>$@): Written_kind //<
        //< What a name written alone where a type goes is, from this file
        //<
        //< The order is "Name resolution with no namespace goes through one function" in
        //< ksplc/docs/DESIGN.md.
        if name.equals("Self")
            return .found
        if gen_params != null
            for gp_name in gen_params
                if gp_name.equals(name)
                    return .found
        if r.find_generic_arg(name).is_some()
            return .found
        // A name brought in with no namespace by `import "path" { A };`.
        // Caution: Look it up before a same-named one from outside the file (the reason is at
        // Ctx.imported_symbol_fqn), or it becomes `missing import alias prefix`.
        imported: = r.imported_symbol_fqn(name)
        if imported.len > 0
            if what: = value_at(r, imported)
                return .names_value(what)
            return .found
        if what: = value_at(r, name)
            return .names_value(what)
        if (r.generics.templates.get(r.make_fqn(name)) catch null) != null
            return .found
        sym: = r.symtab.resolve(name) catch null
        if sym != null &&
            (sym.get_defined_in().len == 0 || sym.get_defined_in().equals(r.file_name))
            return .found
        if sema_type_env.is_builtin(r.env.type_to_id.get(name) catch 0)
            return .found
        // Caution: **Ask this file's imports whether another file declares it**, not the type
        // table: a short key there is whichever file spelled the name first.
        if r.alias_reaching(name).is_some()
            return .elsewhere
        return .not_found

    fn alias_reaching(r: Self$@, name: U8[]): Option<|Alias_reach|> //<
        //< The import alias of this file whose file declares name where this file can see it
        //<
        //< It answers for a name written without the alias that reaches it (`twice` after `import
        //< "p" as _m`). An import nobody wrote (std/lang's) is not asked: its names come in bare.
        return r.alias_where(name, "")

    fn alias_naming(r: Self$@, path: U8[]): Option<|Alias_reach|> //<
        //< The import alias of this file that names the file at path, if one does
        return r.alias_where("", path)

    priv fn alias_where(r: Self$@, name: U8[], path: U8[]): Option<|Alias_reach|> //<
        //< The first written import alias of this file naming path, or declaring name where seen
        prefix: = base_core.arena.text().s(r.file_name).s("::").take()
        for i in Range.asc(r.aliases.files.cap)
            entry: = r.aliases.files.entries + i
            if !entry.is_active || entry.value.decl_node == null ||
                !entry.key.starts_with(prefix)
                continue
            target: = entry.value.target_path
            if path.len > 0
                if target.equals(path)
                    return .some(Alias_reach::{ .alias = entry.key.sub_from(prefix.len),
                        .path = target })
                continue
            file_env: = r.env.files.get(target) catch null
            if file_env == null
                continue
            sym: = file_env.symbols.get(name) catch null
            if sym != null && r.is_symbol_visible_here(sym)
                return .some(Alias_reach::{ .alias = entry.key.sub_from(prefix.len),
                    .path = target })
        return .none

    fn report_without_alias(r: Self$@, at: Ast_node$@, name: U8[], path: U8[]) //<
        //< Reports a name of the file at path written without the import alias that reaches it
        //<
        //< **One wording for a function, a value and a type alike**, saying what to write: the
        //< alias this file imports the file under, or, where it has none, the import to add.
        //< Caution: Keep it in this one place: a type position, a value and a call each meet the
        //< mistake, and a copy for one would tell the writer something else.
        r.clear_scratch().s("missing import alias prefix: '\{name\}' is declared in '\{path\}', ")
        if reach: = r.alias_naming(path)
            r.scratch
                .s("which this file imports as '\{reach.alias\}'; write '\{reach.alias\}.\{name\}'")
        else
            r.scratch
                .s("which this file imports under no alias; import it as one ('import \"\{path\}\" \
                    as m') and write 'm.\{name\}'")
        r.err(at, r.scratch.slice())
        r.note_undefined_at(at)

    fn report_name_by_fqn(r: Self$@, at: Ast_node$@, named: Written_name) //<
        //< Reports a name found under another file's FQN written out (`by_fqn`)
        //<
        //< The FQN is the file's path, which no import of this file names as an alias.
        file: =
            named.sym.get_defined_in() if named.sym != null else named.template.loc.file()
        $dotted: = Str_builder.new()
        defer dotted.free()
        dotted.s_path_as_dots(file).c('.')
        within: =
            (named.spelled.sub_from(dotted.slice().len)
            if named.spelled.starts_with(dotted.slice()) else named.spelled)
        r.report_without_alias(at, within, file)

    fn impl_target_fqn(r: Self$@, impl_node: Ast_node$@): U8[] //<
        //< The FQN of the type an impl's target names, read in the current file
        //<
        //< A target written as more than a name (`impl U8[4]`, the refused `impl Foo@`) is read
        //< from its spelling. It instantiates nothing: an impl is registered before any type is
        //< resolved (Pass 2a in ksplc/docs/DESIGN.md).
        target_node: = impl_node.get_decl_type_node()
        if written: = written_name_of(target_node)
            return r.read_written_type(written).fqn
        $spelled: = target_node.extract_type_name()
        defer spelled.free()
        return r.resolve_fqn_for_type(spelled.slice().get_generic_base_name())

    fn written_type_symbol(r: Self$@, w: Written_type): Sema_symbol$@ //<
        //< The declaration of the type w names, or null
        //<
        //< **Within the file an import alias names, every declaration answers**, `priv` ones too,
        //< so that the use is refused as one the file cannot see rather than passed as unknown.
        $sym: Sema_symbol$@ = null
        if w.alias_file.len > 0
            file_env: = r.env.files.get(w.alias_file) catch null
            if file_env != null
                sym = file_env.symbols.get(w.name) catch null
        else
            sym = r.symtab.resolve(w.fqn) catch null
        tmpl: = r.written_template(w)
        if sym == null && tmpl != null && tmpl.sym_ptr != null
            sym = Sema_symbol$@::tmpl.sym_ptr
        return sym

    fn written_template(r: Self$@, w: Written_type): Ast_node$@ //<
        //< The template of the generic type w names, or null where it names no generic type
        return r.generics.templates.get(w.fqn) catch null

    fn instance_written(r: Self$@, w: Written_type, args: I32[], site: Ast_node$@):
        Str_builder?Sema_error //<
            //< The instance of the generic type w names, binding args, made where site writes it
            //<
            //< A violated constraint is reported at site, the user's line, not the template's
            //< (check_type_constraint in resolve.kspls reads inst_site).
        prev_inst_site: = r.generics.inst_site
        r.generics.inst_site = site
        defer r.generics.inst_site = prev_inst_site
        return r.instantiate_struct(w.fqn, args)

    fn read_written_name(r: Self$@, path: Ast_node$@): Written_name //<
        //< What a written value's or function's name names, and what each `<|…|>` on it belongs to
        //<
        //< A member the `.` already found a type for is that type's; a bare name is read through
        //< this file's scopes and imports; a path's head through this file's import aliases and
        //< selective imports, the rest within the file the head names. It reports nothing.
        $w: = Written_name::{ .parts = named_fn(path), .spelled = spelled_name(path), .fqn = "",
            .head_file = "", .sym = null, .template = null,
            .fn_tmpl = sema_decl_mono.Fn_instance::{ .template = "", .owner = 0,
            .args = I32[]::{} }, .owner_id = 0, .reach = Name_reach.nowhere }
        w.fqn = w.spelled
        if path == null
            return w
        owner: = w.parts.owner
        if owner != null && owner.type_id > 0 && r.read_member_of_type(w@)
            return w
        if owner == null
            r.read_bare_name(w@)
        else
            r.read_path_name(path, w@)
        if w.sym == null && w.template == null
            r.read_instance_type(path, w@)
        return w

    priv fn read_member_of_type(r: Self$@, w: Written_name$@): Bool //<
        //< Reads a member of the type the `.` recorded on the name before it; false if it has none
        //<
        //< **A generic method reached through its type** is that type's template, its own type
        //< arguments instantiating it at the call; **any other method of an instance** is the
        //< instance's own (instance_method).
        owner_id: = w.parts.owner.type_id
        name: = w.parts.name.text
        found: = sema_decl_mono_name.lookup_method_template(r,
            r.env.receiver_base_id(owner_id), name)
        if tmpl: = found
            w.template = tmpl.node
            w.fn_tmpl.template = tmpl.fqn
            w.fn_tmpl.owner = tmpl.owner
        else if sym: = r.instance_method(owner_id, name)
            w.sym = sym
        else
            return false
        w.owner_id = owner_id
        w.fqn = join_dotted_name(r.env.base_type_name(owner_id), name)
        w.reach = .through_type
        return true

    priv fn read_bare_name(r: Self$@, w: Written_name$@) //<
        //< Reads a name written alone, or with its own `<|…|>`
        //<
        //< A generic function's template is looked up only where the name names a function, so a
        //< local hides one of the same name.
        name: = w.parts.name.text
        w.sym = lookup_bare_name(r, name)
        if w.sym == null || w.sym.kind.names_function()
            tmpl_fqn: = template_named(r, name)
            if tmpl_fqn.len > 0
                w.template = r.generics.templates.get(tmpl_fqn) catch null
                w.fn_tmpl.template = tmpl_fqn
                w.fqn = tmpl_fqn
        // `<|…|>` after a name that names no function binds nothing to it: a type's instance
        // written whole is read as one (read_instance_type), any other name as nothing.
        if w.parts.own != null && w.sym != null && !w.sym.kind.names_function()
            w.sym = null
        if w.sym != null || w.template != null
            w.reach = .here

    priv fn read_path_name(r: Self$@, path: Ast_node$@, w: Written_name$@) //<
        //< Reads a path of more than one name: its head through this file's imports, or here
        //<
        //< A head brought in by a selective import (`Plain.gen` after `import "p" { Plain }`) is
        //< read **the same way** as an access to that file, from its original name.
        //< Caution: Do not read it another way: the other path instantiates `Map<|U8[], I32|>`'s
        //< type arguments **as literal text**.
        head: = path.get_child(0).text
        $file: = r.get_file_alias_target(r.file_name, head)
        $seg_start: Sz = 1
        $first: = head
        if file.len == 0
            imported: = r.get_import_symbol_target(r.file_name, head)
            if imported.len > 0
                file = imported
                first = r.get_import_symbol_original_name(r.file_name, head)
                seg_start = 0
        if file.len > 0
            r.read_name_in_file(path, file, first, seg_start, w)
            return
        $full: = path.get_full_path_str()
        defer full.free()
        w.sym = r.symtab.resolve(full.slice()) catch null
        // **Found under its FQN written out** (`other.lib.twice`), a declaration of another file
        // is reached through no import of this one.
        $is_fqn: =
            w.sym != null && !w.sym.flags.is_generated_instance &&
            w.sym.get_defined_in().len > 0 &&
            !w.sym.get_defined_in().equals(r.file_name)
        if w.sym == null
            w.sym = r.member_through_type(path).unwrap_or(null)
        w.template = r.generics.templates.get(w.spelled) catch null
        if w.template != null
            w.fn_tmpl.template = w.spelled
            is_fqn = is_fqn || !w.template.loc.file().equals(r.file_name)
        if is_fqn
            w.reach = .by_fqn
        else if w.sym != null || w.template != null
            w.reach = .here

    priv fn read_name_in_file(r: Self$@, path: Ast_node$@, file: U8[], first: U8[], seg_start: Sz,
        w: Written_name$@) //<
            //< Reads the segments from seg_start within file, the first spelled first
            //<
            //< Caution: **Check the head segment alone** for whether the file holds the name. The
            //< `new` of `ds.List<|I32|>.new` is not in the table until monomorphization, so
            //< checking the whole path would reject a legitimate name; the head is known now.
        $b: = Str_builder.new()
        defer b.free()
        $head_name: U8[] = ""
        for $j: = seg_start; j < path.children.len; j += 1
            child: = path.get_child(j)
            if child.kind_id == .k_type_args
                continue
            seg: = first if j == 0 else child.text
            if head_name.len == 0
                head_name = seg
            else
                b.c('.')
            b.s(seg)
        within: = base_core.pools.name_text(b.slice())
        w.head_file = file
        w.fqn = r.build_mod_fqn(file, within)
        file_env: = r.env.files.get(file) catch null
        if file_env != null
            w.sym = file_env.symbols.get(within) catch null
            if w.sym == null
                w.sym = r.resolve_type_method_fqn(w.fqn).unwrap_or(null)
            if w.sym == null && head_name.len > 0 &&
                (file_env.symbols.get(head_name) catch null) == null &&
                !r.file_has_type(file, head_name)
                w.reach = .absent
                return
        w.template = r.generics.templates.get(w.fqn) catch null
        if w.template != null
            w.fn_tmpl.template = w.fqn
        if w.sym != null || w.template != null
            w.reach = .alias

    priv fn member_through_type(r: Self$@, path: Ast_node$@): Option<|Sema_symbol$@|> //<
        //< The member a path names through the type it begins with
        //<
        //< `Box<|I32|>.keep`, `Self.get`, `Ints.get` after `typedef Ints = Box<|I32|>`. The type is
        //< read from the tree, its instance made from the written type arguments: a path is read
        //< again where it is inferred twice (an operand of `==`), after the `.` flattened it.
        written: = r.read_written_type(path)
        if written.member == null
            return .none
        $owner: = written.fqn
        tmpl: = r.written_template(written)
        // Type arguments on a type that declares none bind nothing, and are refused where they
        // are written (refuse_type_args_on_plain_type in type_check.kspls): the member is the
        // type's own.
        if written.args != null && tmpl != null
            // Caution: **Suppress only the arguments' resolution**, as infer_namespace_access does.
            saved_sup: = r.suppress_errors
            r.suppress_errors = true
            args: = written.args.build_resolved_type_args(r, tmpl) catch sema_decl_resolve.unknown_args()
            r.suppress_errors = saved_sup
            $inst: = r.instance_written(written, args, path) catch
                return .none
            defer inst.free()
            owner = r.env.get_str(r.env.get_or_add(inst.slice()))
        return r.resolve_type_method_fqn(join_dotted_name(owner, written.member.text))

    priv fn read_instance_type(r: Self$@, path: Ast_node$@, w: Written_name$@) //<
        //< Reads a generic type's instance written whole (`Box<|I32|>`, `m.Box<|I32|>`)
        //<
        //< Its type arguments end the path: after them it would name a member.
        if path.children.len == 0 || path.last_child().kind_id != .k_type_args
            return
        written: = r.read_written_type(path)
        if written.args != path.last_child()
            return
        tmpl: = r.written_template(written)
        if tmpl != null && tmpl.sym_ptr != null &&
            (Sema_symbol$@::tmpl.sym_ptr).kind.is_type()
            w.template = tmpl
            w.reach = .instance_type

    fn own_type_of_name(r: Self$@, node: Ast_node$@): I32 //<
        //< The type a value's expression gives where nothing expects one: its own, or a function's
        //<
        //< **A name that stands for one function gives the function type of that function**
        //< (`twice`, `gf<|U16|>`, `Holder<|I32|>.keep` with its receiver first, an anonymous
        //< function), to a declaration with no type as to a generic parameter. Nothing being
        //< expected of it, it carries the mark generic_fn_value_type_id, and the declaration its
        //< name resolved to (an instance's, for a specialization) holds the type. A variadic one
        //< keeps the mark, no function type holding its `...`.
        decl: = node.def_node
        if node.type_id != r.env.generic_fn_value_type_id() || decl == null ||
            decl.has_variadic_param()
            return node.type_id
        return sema_decl_resolve.own_fn_type_id(decl, r) catch node.type_id

    fn instance_method(r: Self$@, owner_id: I32, name: U8[]): Option<|Sema_symbol$@|> //<
        //< The method an instance of a generic type holds under name, from its own table
        //<
        //< **A method reached through an instance** (`Box<|I64|>.mk`, `Ints.get` after `typedef
        //< Ints = Box<|I64|>`, `Self.get` in `impl Box<|I64|>`) is the instance's, as one reached
        //< through a value is the receiver's. Looked up as the template's (`Box.mk` with `<|I64|>`
        //< as its type arguments), it holds only where the impl's type parameters are the type's
        //< arguments in order: a method of `impl Box<|I64|>` declares none, and a renaming import
        //< or a typedef spells a name no template has.
        if !r.env.instance_of(r.env.receiver_base_id(owner_id)).is_some()
            return Option<|Sema_symbol$@|>.none
        return r
            .resolve_type_method_fqn(join_dotted_name(r.env.base_type_name(owner_id), name))

//< Resolves a written type to its type id, making a generic's instance on the way
//<
//< `resolve_type` reads a type expression (its name, its type arguments, its postfixes).
//< `resolve_all_types` walks a tree doing so. The name itself is read through
//< `sema/decl/name.kspl`. This file turns what it names into a type, checks a type argument's
//< constraint, and builds a function's own type (`fn_signature_type_id`).
import "ksplc/base/ast" { Ast_node, variance_names_mut }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as _base_ast_spell // `get_decl_id_text`
import "ksplc/base/core" as base_core
import "ksplc/base/mangle" as base_mangle
import "ksplc/sema/decl/eval" as sema_decl_eval
import "ksplc/sema/decl/mono" as sema_decl_mono
import "ksplc/sema/decl/mono_name" as sema_decl_mono_name
import "ksplc/sema/decl/mono_queue" as sema_decl_mono_queue
import "ksplc/sema/decl/name" as _sema_decl_name
import "ksplc/sema/decl/trait_check" as sema_decl_trait_check
import "ksplc/sema/session/ctx" { Sema_ctx, Sema_error, join_dotted_name }
import "ksplc/sema/session/import_table" as sema_session_import_table
import "ksplc/sema/type/def" as sema_type_def
import "ksplc/sema/type/display" as sema_type_display
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/naming" as sema_type_naming
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/chars"
import "std/ds" { List }
import "std/str" { Str_builder }
import "std/strnum" // `to_i64` / `to_f64` / `parse_size`
// ==========================================
// How the mutability mark on a type argument is accepted (the `$` of a `Slice<|$U8|>`). At a
// position the declaration names (`struct Slice<|$T|>`), **an unmarked actual argument is wrapped
// as immutable**. Immutable is the default, so the mutable side carries the mark. The reasoning is
// "Why the mutability marker on a type argument is prefix" in
// `../../../docs/DESIGN-programming-language.md`. The type comparison decides the one level of
// weakening such a position allows (generic_arg_weakens in `../type/query.kspl`), not this file.
// ==========================================
fn arg_names_mut(arg: Ast_node$@): Bool //<
    //< Whether the actual argument holds the mutability mark (the `$` of a `Slice<|$U8|>`)
    //<
    //< The parser wraps a marked argument in a `k_type_arg` with a Literal at the head.
    return arg != null && arg.kind_id == .k_type_arg && arg.has_literal_child("$")

fn strip_arg_mut_mark(arg: Ast_node$@): Ast_node$@ //< the argument with the mark stripped
    if !arg_names_mut(arg)
        return arg
    inner: = arg.find_child(.k_type_expr)
    return inner if inner != null else arg

impl Sema_ctx
    fn file_has_type(r: Self$@, file_path: U8[], name: U8[]): Bool //<
        //< Whether the file at `file_path` has a type named `name`
        //<
        //< A struct, an enum, an alias and a generic's template count.
        //<
        //< Caution: **Do not look up the name with its qualifier stripped.** A short name answers
        //< for whatever this file can see under it, so `io.List<|I32|>` would count as found.
        fqn: = r.build_mod_fqn(file_path, name)
        return r.symtab.resolve(fqn).is_some() ||
            r.generics.templates.get(fqn).is_some() ||
            r.env.type_to_id.get(fqn).unwrap_or(0) != 0

    fn is_type_name(r: Self$@, name: U8[]): Bool //< whether that name names a type
        //<
        //< It answers for a short name, for `Self`, and for an alias prefix alike.
        //< Caution: Do not replace this with "starts with a capital": a mistyped type name would
        //< pass unreported, even in a value position.
        return r.env.has_type_named(name) ||
            r.env.has_type_named(r.resolve_fqn_for_type(name))

    fn names_module_only(r: Self$@, name: U8[]): Bool //<
        //< Whether `name` names an imported module in this file and no type
        //<
        //< It checks without marking the import used.
        //<
        //< Caution: **Answer from the file alone, not from the open scopes.** The type walk asks
        //< with no function open and leaves reporting to the body analysis (`type_check.kspl`). So
        //< a local `io` must not change the answer between the two.
        return r.peek_file_alias(r.file_name, name) != null && !r.env.has_type_named(name) &&
            !r.env.has_type_named(r.make_fqn(name))

    fn resolve_fqn_for_type(r: Self$@, base_name: U8[]): U8[] //<
        //< Builds the FQN by prefixing the current file's logical name
        if base_name.equals("Self") && r.fn_ctx.impl_name.len > 0
            return r.fn_ctx.impl_name

        tid: = r.env.type_to_id.get(base_name).unwrap_or(0)
        if sema_type_env.is_builtin(tid)
            return base_name
        // A built-in type and what derives from one are not qualified, or an `impl U8[]` method
        // lands on a fictional "std.io.U8[]".
        if base_name.equals(base_core.UNKNOWN_TYPE_NAME) || base_name.equals("Void") ||
            base_name.ends_with("[]") || base_name.ends_with("@")
            return base_name

        if g_arg: = r.find_generic_arg(base_name)
            return r.env.get_str(g_arg.bound_type_id)

        first_dot: = base_name.find_char_out('.')
        if first_dot >= 0
            prefix: = base_name.sub(0, first_dot)
            target_file: = r.get_file_alias_target(r.file_name, prefix)
            if target_file.len > 0
                actual_base: = base_name.sub_from(first_dot + 1)
                return r.build_mod_fqn(target_file, actual_base)
        else
            // A name from `import "path" { A };` is mapped to the source's FQN.
            // Caution: Look it up before a name outside the file (Ctx.imported_symbol_fqn).
            imported_fqn: = r.imported_symbol_fqn(base_name)
            if imported_fqn.len > 0
                return imported_fqn
            // **Only a type's symbol answers.** A value's type_id is the value's type (a
            // function's, its return type), and taken here a value's name would read as a type.
            sym: = r.symtab.resolve(base_name).unwrap_or(null)
            if sym != null && sym.kind.is_type() && sym.type_id != 0
                return r.env.get_str(sym.type_id)
        return base_name

    fn resolve_type_method_fqn(r: Self$@, fqn: U8[]): Sema_symbol$@?
        last_dot: = fqn.rfind_char_out('.')
        if last_dot < 0
            return .none
        t_fqn: = fqn.sub(0, last_dot)
        m_name: = fqn.sub_from(last_dot + 1)

        t_id: = r.env.type_to_id.get(t_fqn).unwrap_or(0)
        if t_id == 0
            return .none
        // An impl target is never immutable (collect_impl_decl rejects one), so an immutable
        // type's methods live in its plain type's table.
        for id in I32[]::{ t_id, r.env.get_clean_real_type(t_id) }
            real: = r.env.get_real_type(id)
            // Caution: **Finish building the table before the lookup** (ensure_instance_methods in
            // mono_queue.kspl). A name that stands for an instance (`typedef Nums = List<|I32|>`)
            // reaches here with nothing on the way that builds it, so `Nums.new` would be
            // undefined.
            r.ensure_instance_methods(real) catch {}
            t_entry: = r.env.id_to_type.get(real)
            if t_entry == null
                continue
            if sym: = t_entry.get_method(m_name)
                return .some(sym)
        return .none

    // Looks up an operator's method (Type.method) after check_operator_trait decided it is
    // .user_defined. base_id applies the same strip_ptr only, so the checked and found types agree.
    fn resolve_operator_method(r: Self$@, recv_type_id: I32, method_name: U8[]): Sema_symbol$@?
        // Caution: **Finish building the receiver's table before the lookup**
        // (ensure_instance_methods in sema/decl/mono_queue.kspl). Otherwise it is "implemented, yet
        // the method cannot be found".
        r.ensure_instance_methods(recv_type_id) catch {}
        base_id: = r.env.strip_ptr(recv_type_id)
        r.clear_scratch().s("\{r.env.base_type_name(base_id)\}.\{method_name\}")
        return r.resolve_type_method_fqn(r.scratch.slice())

    fn resolve_alias_sym(r: Self$@, sym: Sema_symbol$@): I32!Sema_error
        if sym.type_id != 0
            return sym.type_id
        name: = sym.name
        // A name seen again among the aliases being resolved is a circular definition.
        // Caution: The pop below runs only on a normal return; a `!` leaves the name on the stack,
        // and it counts as circular from then on.
        for alias_name in r.resolving.aliases
            if alias_name.equals(name)
                r.err(sym.node,
                    base_core.arena.text().s("circular typedef: '\{name\}' leads back to itself")
                    .take())
                sym.type_id = 0
                return 0
        if r.resolving.aliases.len >= sema_type_query.MAX_ALIAS_CHAIN_DEPTH
            r.err(sym.node, too_deep(name))
            sym.type_id = 0
            return 0
        r.resolving.aliases.push(name)

        $type_node: = sym.node.find_child(.k_type_expr)
        if type_node == null
            if sig: = sym.node.get_type_fn_sig()
                type_node = sig

        $target_id: I32 = 0
        if type_node != null
            target_id = type_node.resolve_type(r)!
            type_node.resolve_all_types(r)!

        // Caution: **Check the depth here too.** The stack of aliases being resolved counts only a
        // forward chain (`A0 = A1; A1 = A2; …`). A backward one (`A1 = A0; A2 = A1; …`) does not
        // nest.
        // **A chain whose far end was refused is that refusal's chain.** The forward walk above
        // reported it where it was cut, and a second error here would name the same chain.
        if r.env.alias_chain_len(target_id) + 1 >= sema_type_query.MAX_ALIAS_CHAIN_DEPTH
            if !sema_type_env.is_unknown(r.env.get_real_type(target_id))
                r.err(sym.node, too_deep(name))
            sym.type_id = 0
            r.resolving.aliases.len -= 1
            return 0

        fqn: = r.make_fqn(name)
        fqn_dup: = base_core.arena.dup_str(fqn)
        alias_id: = I32::r.env.id_to_type.len
        entry: = sema_type_def.Entry.new(.alias_type(target_id), fqn_dup)
        r.env.id_to_type.push(entry)

        // Caution: **Register it under its FQN alone**, as a generic type's template is. The type
        // table is one for the whole build, while a short name names the alias only inside its
        // file. Under the short name, another file's `priv typedef Num` answered this file's `Num`.
        r.env.type_to_id.set(fqn_dup, alias_id)

        sym.type_id = alias_id
        sym.node.type_id = alias_id
        r.resolving.aliases.len -= 1
        return alias_id

    fn apply_arg_mut_mark(r: Self$@, decl: Ast_node$@, pos: Sz, arg: Ast_node$@, arg_id: I32): I32 //<
        //< Decides the argument type at that position from the declaration and the argument's mark
        //<
        //< Whether the declaration names the position is matched against the argument's mark.
        //< **A mark at a position the declaration does not name is rejected**, or `List<|$U8|>`
        //< would silently equal `List<|U8|>` while the writer believes the elements are mutable.
        marked: = arg_names_mut(arg)
        if !variance_names_mut(decl.gen_param_variance_mask(), pos)
            if marked
                r.err(arg,
                    "'$' on a type argument is only allowed where the declaration names it. Write \
                        'struct Name<|$T|>' to declare it. Without that declaration, the argument \
                        has no writability to weaken")
            return arg_id
        return arg_id if marked else r.env.make_const(arg_id)

impl Sema_ctx
    priv fn resolve_written_type(r: Self$@, type_node: Ast_node$@, written_at: Ast_node$@,
        path_node: Ast_node$@, atom: Ast_node$@): I32!Sema_error //<
            //< The type id a type position's name stands for, its instance made where it is generic
            //<
            //< written_at is the name as written (read_written_type in name.kspl reads it);
            //< type_node is the position, which a diagnostic points at. A member's name is no type,
            //< and is the unknown type: validate_all_type_exprs in type_check.kspl reports it.
        w: = r.read_written_type(written_at)
        if w.member != null
            return I32::sema_type_env.Builtin_type_id.unknown
        sym: = r.symtab.resolve(w.fqn).unwrap_or(null)
        if sym != null
            // **An alias declared later is resolved here**, and named by the id that gives it. Its
            // name was read before it had one, so w.fqn is the name as written, a key it is not
            // registered under.
            if sym.kind.is_alias() && sym.type_id == 0
                r.resolve_alias_sym(sym)!
                if w.args == null && sym.type_id != 0
                    type_node.def_node = sym.node
                    set_resolved_def_node(path_node, atom, sym.node)
                    return sym.type_id
                // **A refused alias (too deep, circular) is the unknown type**, reported once at
                // its declaration. Named as a type of its own, every use would add a mismatch
                // ("expected 'A999', but got 'I32'") that says nothing of the cause.
                if sym.type_id == 0
                    return I32::sema_type_env.Builtin_type_id.unknown
            type_node.def_node = sym.node
            set_resolved_def_node(path_node, atom, sym.node)
        tmpl: = r.written_template(w)
        if w.args == null
            // A generic type written with no type arguments reaches C as `unknown type name`
            // ("Failing fast through an exception or an ICE" in ksplc/docs/DESIGN-compiler.md).
            if tmpl != null
                r.clear_scratch()
                    .s("generic type '\{w.spelled\}' is used without type arguments. Write the \
                        arguments explicitly, for example '\{w.spelled\}<|I32|>'")
                r.err(type_node, r.scratch.slice())
            return r.env.get_or_add(w.fqn)
        if tmpl != null
            type_node.def_node = tmpl
            set_resolved_def_node(path_node, atom, tmpl)
        else
            // **Type arguments after a type that declares none name nothing**: it is that type. The
            // type check reports them (refuse_type_args_on_plain_type in type_check.kspl).
            if declared: = r.written_type_symbol(w)
                if declared.kind.is_type()
                    return r.env.get_or_add(w.fqn)
        args: = w.args.build_resolved_type_args(r, tmpl) catch unknown_args()
        $final_name: = Str_builder.new()
        defer final_name.free()
        if tmpl != null
            sema_decl_mono.check_written_generic_arity(r, tmpl, args.len, type_node)
            $inst_name: = r.instance_written(w, args, type_node)
                catch sema_decl_mono_name.unknown_type_str()
            defer inst_name.free()
            final_name.s(inst_name.slice())
        else
            r.env.type_args_to(args, final_name.s(w.fqn).s("<|"))
            final_name.s("|>")
        return r.env.get_or_add(final_name.slice())

priv fn lookup_def_node(c: Sema_ctx$@, path: Ast_node$@): Ast_node$@? //<
    //< Looks up the definition node for a written name, none if none
    //<
    //< Caution: **Look in this order:** the symbol table → a template by FQN → this file's aliases.
    //< In another order, a different thing with the same name is found.
    written: = c.read_written_type(path)
    name: = written.spelled
    sym: = c.symtab.resolve(name).unwrap_or(null)
    if sym != null
        sym.flags.is_used = true
        return .some(sym.node) if sym.node != null else .none
    // A member's template is keyed under its type's FQN (`app.Box.get`).
    fqn: =
        (written.fqn if written.member == null
        else join_dotted_name(written.fqn, written.member.text))
    gen: = c.generics.templates.get(fqn).unwrap_or(null)
    if gen != null
        return .some(gen)
    alias: = c.peek_file_alias(c.file_name, name)
    if alias != null && alias.decl_node != null
        return .some(alias.decl_node)
    return .none

impl Ast_node
    fn resolve_all_types(r: Self$@, c: Sema_ctx$@): Void!Sema_error
        if r == null
            return
        if r.kind_id == .k_type_expr || r.kind_id == .k_type_fn_sig
            r.type_id = r.resolve_type(c) catch r.type_id
        else if r.kind_id == .k_decl_impl
            target_node: = r.get_decl_type_node()
            if target_node != null
                target_node.resolve_type(c) catch 0
            if trait_node: = r.get_impl_trait_node()
                trait_node.resolve_type(c) catch 0
        else if r.kind_id == .k_identifier || r.kind_id == .k_expr_path ||
            r.kind_id == .k_type_path
            if r.def_node == null && (r.children.len > 0 || r.text.len > 0)
                if found: = lookup_def_node(c, r)
                    r.def_node = found
        // **A function's own name is not a reference**, so it is not looked up. By bare name, a
        // method `put` would resolve to the prelude's `std.lang.put`, and the editor would show
        // that.
        $own_name: Ast_node$@ = null
        if r.kind_id == .k_decl_fn || r.kind_id == .k_decl_fn_proto
            own_name = r.find_child(.k_identifier)
        for item in r.children
            if item != own_name
                item.resolve_all_types(c) catch {}

    fn check_type_constraint(r: Ast_node$@, c: Sema_ctx$@, target_id: I32): Void!Sema_error //<
        //< Checks a type argument's constraint
        //<
        //< While suppressed (inside a speculative inference) it records the constraint node and the
        //< type-argument bindings and returns without checking.
        //<
        //< Caution: Never check while suppressed. The diagnostic would be discarded and the cache
        //< would prevent a recheck, so **a constraint would hold on some paths only**. Record **a
        //< copy of the constraint node and the bindings**, not the resolution result.
        if r == null
            return
        // Caution: **Do not check while a template's types are resolved for the LSP** (the reason
        // is at Generic_state.resolving_template_types in `../session/state.kspl`).
        if c.generics.resolving_template_types
            return
        // **Defer it to the same boundary as the instantiation**, which fills the conformance table
        // (Pending_constraint in sema/session/state.kspl). Right now the table is empty.
        if c.put_off_constraint(r, target_id)
            return
        for path_node in r.children
            if path_node.kind_id == .k_literal || path_node.kind_id == .k_keyword
                continue
            trait_id: = path_node.resolve_type(c)!
            if trait_id == 0 || sema_type_env.is_unknown(trait_id)
                continue
            // The diagnostic points at the user's position that caused the instantiation, not
            // inside the standard library.
            site: = c.generics.inst_site if c.generics.inst_site != null else path_node
            if !c.check_trait_implementation(target_id, trait_id, site)
                c.mark_constraint_failed()
                throw .analysis_failed

    fn resolve_and_apply_type(r: Self$@, c: Sema_ctx$@): I32!Sema_error
        tid: = r.resolve_type(c)!
        r.type_id = tid
        r.resolve_all_types(c)!
        return tid

    fn resolve_fn_signature_types(r: Ast_node$@, c: Sema_ctx$@): Void!Sema_error //<
        //< Resolves only the types of a function declaration's **signature** (not the body)
        //<
        //< **Call it at instantiation** (`instantiate_fn`, `mono.kspl`), or the parameters resolve
        //< **only while the body is inferred**.
        //< Caution: **Do not emit diagnostics here**: there would be one per instance.
        if r == null
            return
        ret_node: = r.get_decl_type_node()
        if ret_node != null
            ret_node.resolve_type(c)!
        param_list: = r.get_fn_params()
        if param_list == null
            return
        for item in base_ast_ext.Param_cursor.new(param_list, false)
            t_node: = item.find_child(.k_type_expr)
            if t_node != null
                item.type_id = t_node.resolve_type(c)!

    fn resolve_type_in_own_file(r: Ast_node$@, c: Sema_ctx$@): I32!Sema_error //<
        //< r's type, resolved in the file r is written in, whose import aliases its names use
        //<
        //< A template's or a declaration's parameter is read where it is declared, not at the call.
        old_file: = c.file_name
        if r.loc.file().len > 0
            c.set_current_file(r.loc.file())
        id: = r.resolve_type(c) catch e
            c.set_current_file(old_file)
            throw e
        c.set_current_file(old_file)
        return id

    fn resolve_type(r: Ast_node$@, c: Sema_ctx$@): I32!Sema_error
        if r == null
            return 0
        if r.type_id != 0
            return r.type_id

        if r.kind_id == .k_type_arg && r.children.len > 0
            tid: = r.get_child(0).resolve_type(c)!
            r.type_id = tid
            return tid

        $base_tid: = 0
        from_atom:
            atom: = r.find_child(.k_type_atom)
            fn_sig_node: = atom.find_child(.k_type_fn_sig) if atom != null else null
            // Note: The grouping parentheses of type_atom = ... | "(" type_expr ")"
            // (ksplc/kspl.kspeg) are unwrapped. Without this branch the path_node search joins the
            // children into a broken dotted name.
            paren_expr_node: = atom.find_child(.k_type_expr) if atom != null else null
            if fn_sig_node != null
                base_tid = fn_signature_type_id(fn_sig_node, c)!
            else if paren_expr_node != null
                base_tid = paren_expr_node.resolve_type(c)!
            else
                $path_node: = r.find_child(.k_type_path)
                if path_node == null
                    path_node = r.find_child(.k_expr_path)
                if path_node == null && atom != null
                    path_node = atom.find_child(.k_type_path)
                    if path_node == null
                        path_node = atom.find_child(.k_expr_path)
                if path_node == null &&
                    (r.kind_id == .k_type_path || r.kind_id == .k_expr_path)
                    path_node = r

                if path_node != null && path_node.children.len == 1 &&
                    path_node.get_child(0).type_id != 0
                    base_tid = path_node.get_child(0).type_id
                else if atom != null && atom.children.len == 0 && atom.type_id != 0
                    base_tid = atom.type_id
                else
                    // Not immutability: apply_type_postfixes applies it per level. Applied here,
                    // `U8[]$@` and `U8$[]@` would collapse into one.
                    $written_at: Ast_node$@ = path_node
                    if written_at == null && atom != null &&
                        (atom.children.len > 0 || atom.text.len > 0)
                        written_at = atom
                    if written_at == null && r.text.len > 0 && r.kind_id != .k_type_postfix
                        written_at = r
                    base_tid = c.resolve_written_type(r, written_at, path_node, atom)!

        final_tid: = apply_type_postfixes(c, base_tid, r)!
        r.type_id = final_tid
        return final_tid

    fn build_resolved_type_args(r: Ast_node$@, c: Sema_ctx$@, decl: Ast_node$@):
        I32[]!Sema_error //<
            //< Resolves a generic's list of actual arguments, one type id per argument
            //<
            //< An argument that does not resolve is the unknown type's id.
            //< Caution: **Pass `decl`.** Where it declares a `$` (`struct Slice<|$T|>`), **an
            //< unmarked actual argument is wrapped as immutable** (`Slice<|U8|>` vs
            //< `Slice<|$U8|>`).
        $args: = List<|I32|>.new(base_core.arena)
        unknown: = I32::sema_type_env.Builtin_type_id.unknown
        params: = decl.find_child(.k_type_gen_params) if decl != null else null
        $pos: Sz = 0
        for arg in r.children
            if arg.kind_id == .k_literal || arg.kind_id == .k_keyword || arg.kind_id == .k_empty
                continue
            // **Inside an instance, the declaration's check has judged it** (check_type_arg_kinds
            // in type_check.kspl): its kind and any arithmetic. Judged again here, a `const`
            // parameter's name, now its value, would be reported again as a literal nobody wrote.
            if !c.is_instantiating() &&
                refuses_arg_kind(c, arg, decl, params.gen_param_at(pos), null)
                args.push(unknown)
                pos += 1
                continue
            if v: = const_type_arg_value(arg, c)
                $value: = Str_builder.new()
                defer value.free()
                value.s("\{v\}")
                args.push(c.env.get_or_add(value.slice()))
                pos += 1
                continue
            if holds_value_expr(arg)
                if !c.is_instantiating()
                    refuse_computed_arg(c, arg)
                args.push(unknown)
                pos += 1
                continue
            // **An actual argument whose name is not known is made Unknown rather than resolved.**
            // resolve_type registers an unknown name as a type, so `Box2<|t|>` would produce
            // `Box2_t`, follow-on errors, and, in a polymorphic recursion, no end.
            arg_id: =
                (0 if names_unknown_type(c, arg)
                else (strip_arg_mut_mark(arg).resolve_type(c) catch 0))
            if arg_id != 0 && !sema_type_env.is_unknown(arg_id)
                args.push(c.apply_arg_mut_mark(decl, pos, arg, arg_id))
            else
                args.push(unknown)
            pos += 1
        return args.slice()

fn unknown_args(): I32[] //< the arguments of a list that could not be read: one unknown type
    $args: = List<|I32|>.new(base_core.arena)
    args.push(I32::sema_type_env.Builtin_type_id.unknown)
    return args.slice()

priv fn names_unknown_type(c: Sema_ctx$@, arg: Ast_node$@): Bool //<
    //< Whether the head name of a type argument names no type at all
    //<
    //< Only the head name (`mod.Box2` of `mod.Box2<|t|>$@`). `Self` (unbound in a trait) and a
    //< leading `_` pass, as in report_type_existence_error in type_check.kspl.
    switch type_arg_head(arg)
    case .some(head)
        written: = c.read_written_type(head)
        name: = written.spelled
        if name.len == 0 || name.equals("Self") || name.starts_with("_")
            return false
        return !c.env.has_type_named(name) &&
            (written.member != null || !c.env.has_type_named(written.fqn))
    case .none
        return false

fn refuses_arg_kind(c: Sema_ctx$@, arg: Ast_node$@, decl: Ast_node$@, param: Ast_node$@,
    own: Ast_node$@): Bool //<
        //< Reports a written argument of the other kind than its parameter, and says whether it did
        //<
        //< own is the enclosing generic's parameter the argument names, or null: its kind is the
        //< argument's. A name that names nothing is left to the type check, which says so.
    if param == null
        return false
    is_value: = own.is_const_gen_param() if own != null else written_arg_is_value(arg, c)
    if is_value == param.is_const_gen_param() ||
        (own == null && !is_value && names_unknown_type(c, arg))
        return false
    refuse_arg_kind(c, arg, decl, param, own)
    return true

fn written_arg_is_value(arg: Ast_node$@, c: Sema_ctx$@): Bool //<
    //< Whether a written type argument is a value: a literal, a constant's name, or arithmetic
    //<
    //< Anything else stands for a type. A generic's own `const` parameter folds to nothing in its
    //< declaration, so the declaration's check asks the names in scope before this.
    return is_literal_arg(arg) || holds_value_expr(arg) ||
        const_type_arg_value(arg, c).is_some()

fn refuses_computed_arg(c: Sema_ctx$@, arg: Ast_node$@): Bool //<
    //< Reports a type argument that computes a value (`Buf<|(n + 1)|>`), and says whether it did
    if !holds_value_expr(arg)
        return false
    refuse_computed_arg(c, arg)
    return true

priv fn refuse_computed_arg(c: Sema_ctx$@, arg: Ast_node$@) //<
    //< A type argument's value is written as it names its type, so arithmetic cannot stand there
    c.err(arg,
        "a value passed as a type argument must be a literal, a negated literal or the name of a \
            const. Declare 'const N: I32 = ...'. Pass 'N' as the argument")

fn refuse_arg_kind(c: Sema_ctx$@, arg: Ast_node$@, generic: Ast_node$@, param: Ast_node$@,
    own: Ast_node$@) //<
        //< Reports a type argument of the other kind than its parameter's: value or type
        //<
        //< own is the enclosing generic's parameter the argument names, or null; the hint then
        //< says how to declare it instead. Any other argument is not quoted: sugar has rewritten
        //< its text (`U8[]` reads `Slice<|U8|>`), and the caret shows it.
    takes_value: = param.is_const_gen_param()
    type_node: = param.find_child(.k_type_expr)
    c.clear_scratch().s("'\{generic.get_decl_id_text()\}' takes a ")
    if takes_value
        c.scratch.s("value for its parameter 'const \{param.gen_param_name()\}")
        write_param_type(c, type_node)
        c.scratch.s("', but ")
    else
        c.scratch.s("type for its parameter '\{param.gen_param_name()\}', but ")
    if own == null
        c.scratch.s("this argument is \{"a type" if takes_value else "a value"\}")
    else if takes_value
        c.scratch
            .s("'\{own.gen_param_name()\}' is a type parameter\n  Hint: declare it 'const \
                \{own.gen_param_name()\}")
        write_param_type(c, type_node)
        c.scratch.s("' to pass a value through it")
    else
        c.scratch
            .s("'\{own.gen_param_name()\}' is a const parameter. It stands for a value\n  Hint: \
                declare it without 'const' to pass a type through it")
    c.err(arg, c.scratch.slice())

priv fn write_param_type(c: Sema_ctx$@, type_node: Ast_node$@) //<
    //< `: T` of `const N: T`, if written
    if type_node != null
        c.scratch.s(": \{type_node.text\}")

priv fn is_literal_arg(node: Ast_node$@): Bool //<
    //< Whether a type argument is a literal (`8`, `true`), under the nodes that wrap it alone
    if node == null
        return false
    switch node.kind_id
    case .k_integer, .k_float, .k_bool, .k_char, .k_string, .k_null
        return true
    default {}
    return node.children.len == 1 && is_literal_arg(node.get_child(0))

priv fn type_arg_head(node: Ast_node$@): Ast_node$@? //<
    //< The node holding a type argument's head name (a path or an identifier)
    //<
    //< none for a literal or `fn(…)`; the postfix and inner arguments are not entered.
    if node == null
        return .none
    if node.kind_id == .k_type_path || node.kind_id == .k_expr_path ||
        node.kind_id == .k_identifier || node.kind_id == .k_primitive_type
        return .some(node)
    if node.kind_id == .k_type_atom && node.children.len == 0
        return (.some(node) if node.text.len > 0 else .none)
    if node.kind_id == .k_integer || node.kind_id == .k_bool || node.kind_id == .k_literal ||
        node.kind_id == .k_keyword || node.kind_id == .k_type_fn_sig
        return .none
    for child in node.children
        if child.kind_id == .k_type_args || child.kind_id == .k_type_postfix
            continue
        if head: = type_arg_head(child)
            return .some(head)
    return .none

priv fn holds_value_expr(node: Ast_node$@): Bool //<
    //< Whether a type argument computes a value (`2 + 1`, `a ? b : c`, `-n`) instead of naming one
    //<
    //< Only what const_type_arg_value folds, or a plain literal, can stand there. Let through, the
    //< argument is read as a type, the instance takes the node's text for a name, and the C holds
    //< `return expr;` (Principle 2).
    //< Caution: Do not descend into a nested type argument or a postfix, as in
    //< const_type_arg_value.
    if node == null || node.kind_id == .k_type_args || node.kind_id == .k_type_postfix
        return false
    switch node.kind_id
    case .k_expr, .k_expr_ternary, .k_expr_catch_chain, .k_expr_catch, .k_expr_or, .k_expr_and,
        .k_expr_cmp, .k_expr_add, .k_expr_mul, .k_expr_cast, .k_expr_unary, .k_expr_fn_lit,
        .k_expr_compound
        return true
    default {}
    for child in node.children
        if holds_value_expr(child)
            return true
    return false

priv fn const_type_arg_value(node: Ast_node$@, c: Sema_ctx$@): I32? //<
    //< If the type argument is **a name** or **a negated literal** that folds, returns its value
    //<
    //< A plain literal (`Foo<|8|>` / `Foo<|true|>`) has no type path, so it gives none. A negated
    //< one (`Foo<|-3|>`) is a unary node whose text is the `-` alone, so it is folded here.
    //< Caution: Do not descend into a nested type argument (the `n` of `Foo<|Bar<|n|>|>`) or a
    //< postfix (the `n` of `Foo<|I32[n]|>`, a type). Do not descend past a name's node even if it
    //< does not fold: `mod.Foo`'s `Foo` can match another scope's const.
    if node == null || node.kind_id == .k_type_args || node.kind_id == .k_type_postfix
        return .none
    if node.kind_id == .k_type_path || node.kind_id == .k_expr_path ||
        node.kind_id == .k_identifier
        return c.try_eval_constexpr(node)
    if node.kind_id == .k_expr_unary && node.get_unary_op().text.equals("-") &&
        node.get_unary_target().kind_id == .k_integer
        return c.try_eval_constexpr(node)
    for child in node.children
        if v: = const_type_arg_value(child, c)
            return .some(v)
    return .none

priv fn set_resolved_def_node(path_node: Ast_node$@, atom: Ast_node$@, target_def: Ast_node$@)
    if path_node != null
        path_node.def_node = target_def
        if path_node.children.len > 0
            last_idx: = path_node.children.len - 1
            $last_child: = path_node.get_child(last_idx)
            if last_child.kind_id == .k_type_args && last_idx > 0
                last_child = path_node.get_child(last_idx - 1)
            if last_child.kind_id == .k_identifier
                last_child.def_node = target_def
    else if atom != null
        atom.def_node = target_def
        if atom.children.len > 0
            first: = atom.get_child(0)
            if first.kind_id == .k_identifier
                first.def_node = target_def

fn fn_signature_type_id(node: Ast_node$@, c: Sema_ctx$@): I32!Sema_error //<
    //< Builds the type ID of a function pointer's canonical type "fn(T1,T2):Ret"
    //<
    //< node is a k_type_fn_sig or a k_decl_fn. **Build both through this one function**, or the
    //< names drift and the comparison always fails (or always succeeds).
    $tname: = Str_builder.new()
    defer tname.free()
    tname.s("fn(")

    param_list: = node.get_fn_params()
    $is_first: = true
    if param_list != null
        for p in base_ast_ext.Param_cursor.new(param_list, false)
            if !is_first
                tname.s(",")
            is_first = false
            pt_node: = p.find_child(.k_type_expr)
            pt_id: =
                (pt_node.resolve_type(c)! if pt_node != null
                else (I32::sema_type_env.Builtin_type_id.unknown))
            tname.s(c.env.get_str(pt_id))
    tname.s(")")

    ret_node: = node.get_decl_type_node()
    ret_id: =
        (ret_node.resolve_type(c)! if ret_node != null
        else I32::sema_type_env.Builtin_type_id.void_type)
    tname.s(":").s(c.env.get_str(ret_id))

    return c.env.get_or_add(tname.slice())

fn own_fn_type_id(decl: Ast_node$@, c: Sema_ctx$@): I32!Sema_error //<
    //< The function type of the function decl declares, its types read in decl's own file
    //<
    //< The parameters' types use the declaring file's import aliases, so they resolve there, or
    //< they read as undefined. A method's receiver is its first parameter, as written.
    old_file: = c.file_name
    if decl.loc.file().len > 0
        c.set_current_file(decl.loc.file())
    type_id: = fn_signature_type_id(decl, c) catch e
        c.set_current_file(old_file)
        throw e
    c.set_current_file(old_file)
    return type_id

priv fn apply_type_postfixes(c: Sema_ctx$@, base_tid: I32, r: Ast_node$@): I32!Sema_error
    $current_tid: = base_tid
    for p in r.children
        if p.kind_id == .k_type_postfix
            current_tid = apply_type_postfix(c, current_tid, p)!
    return current_tid

priv fn apply_type_postfix(c: Sema_ctx$@, current_tid: I32, p: Ast_node$@): I32!Sema_error //<
    //< The type one postfix level (`@` or `[…]`) makes of `current_tid`
    //<
    //< `!E` is no level: the parse folds it into `Result` (fold_sugar_postfixes in
    //< `../../parse/desugar_slice.kspl`).
    // A `$` on the postfix makes that level's subject mutable, no mark immutable, per level, so
    // `U8$[]@` and `U8[]$@` differ. The marker is at the head of the postfix's text (the
    // k_type_expr normalization in parse/load.kspl).
    has_mut_mark: = p.text.starts_with("$")
    pt: = p.text.sub_from(1) if has_mut_mark else p.text
    qualified: = current_tid if has_mut_mark else c.env.make_const(current_tid)
    if pt.equals("@")
        return pointer_postfix(c, current_tid, qualified, p)
    if pt.starts_with("[")
        return array_postfix(c, current_tid, qualified, p, pt, has_mut_mark)
    if pt.starts_with("!")
        p.ice_panic("a '!E' postfix reached type resolution unfolded")
    return current_tid

priv fn pointer_postfix(c: Sema_ctx$@, current_tid: I32, qualified: I32, p: Ast_node$@): I32 //<
    //< `@`: a pointer to `qualified`
    // No expression produces a pointer to a fixed-length array (`a@` decays, as in C), so it is
    // rejected (Principle 5 of docs/DESIGN-principles.md).
    if c.env.is_array(current_tid) && !c.suppress_errors
        shown: = c.env.display(current_tid)
        c.clear_scratch()
            .s("cannot take a pointer to a fixed-size array ('\{shown\}@'). '@' on an array decays \
                to a pointer to its first element. No expression can produce a pointer to the array \
                itself. Use 'T$[]' (a slice, which carries its length) or 'T$@' (a pointer to the \
                first element).")
        c.err(p, c.scratch.slice())
    return c.env.make_ptr(qualified)

priv fn array_postfix(c: Sema_ctx$@, current_tid: I32, qualified: I32, p: Ast_node$@, pt: U8[],
    has_mut_mark: Bool): I32 //<
        //< `[N]`, `[_]` or `[]`: a fixed-length array of `qualified`, or a slice of it
    // **A `$` on the type side cannot be written on a fixed-length array's elements.** They are
    // part of the array's value, so the binding that holds it decides (unlike `T$[]`, `T$@`).
    if has_mut_mark && p.children.len > 0 && !c.suppress_errors
        shown_arr: = c.env.display(current_tid)
        c.clear_scratch()
            .s("a fixed-size array cannot carry '$' on its element type ('\{shown_arr\}[N]'). \
                Element writability comes from the binding, not the type. Write '$name: \
                \{shown_arr\}[N]' for a writable array. A struct field is writable when its \
                receiver is. Only slices ('T$[]') and pointers ('T$@') use '$' on the element \
                stage. They refer to a different object.")
        c.err(p, c.scratch.slice())
    if p.children.len > 0
        return c.env.make_array(qualified, array_size(c, p.get_child(0)))
    if pt.len > 2 && (pt.ptr + 1)$ != ']'
        // A resolved "[N]" / "[_]" text with no child (from copying a template): the size is
        // extracted here for make_array.
        inner: = pt.sub(1, pt.len - 2)
        parsed_size: I32 =
            -1 if inner.equals("_") else I32::(inner.parse_size() catch 0)
        return c.env.make_array(qualified, parsed_size)
    return c.slice_type_of(qualified)

priv fn array_size(c: Sema_ctx$@, size_node: Ast_node$@): I32 //<
    //< A written array size: -1 for `_`, else its constant value (1 after reporting a bad one)
    if size_node.text.equals("_")
        return -1
    $too_deep: = false
    size_val: = c.fold_quietly(size_node, true) catch e
        switch e
        case .nesting_too_deep
            too_deep = true
        default {}
        fallback -1I64
    if size_val > 0
        return I32::size_val
    // Stay silent if a `sizeof` cycle is recorded: this is its consequence (report_registry_cycle
    // in sema/decl/layout.kspl reports it).
    if c.suppress_errors || c.resolving.registry_cycle_at != null
        return 1
    // **A chain cut at the depth limit is named as such**, by folding again aloud (silent where
    // that chain was reported already). It is never named as a size that is not positive.
    if too_deep
        _loud: = size_node.eval_constexpr(c) catch 0
    else
        c.err(size_node, "array size must be a positive constant expression greater than 0")
    return 1

priv fn too_deep(name: U8[]): U8[] //<
    //< the refusal of an alias chain past the limit, naming its alias
    return base_core.arena.text()
        .s("typedef chain too deep. '\{name\}' is an alias of an alias more than \
            \{sema_type_query.MAX_ALIAS_CHAIN_DEPTH\} levels down").take()

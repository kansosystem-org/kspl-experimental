//< The ABI pass: gives every declaration and reference its C name
//< A method call becomes a plain call with its receiver as the first argument.
//< It runs after the walk and the thunks (`root.kspl`, `vtable.kspl`), so by then every name
//< the program uses, synthesized ones included, is in the tree.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/c_name" as base_c_name
import "ksplc/base/core" as base_core
import "ksplc/base/diag" as base_diag
import "ksplc/base/mangle" as base_mangle
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/display" as _sema_type_display // `display`, a type's KSPL spelling
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/naming" as sema_type_naming
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" as sema_type_scope + { Sema_symbol }
import "std/chars" // the one-character tests and cuts
import "std/ds" { Map }
import "std/str" { Str_builder }
fn run(r: Ast_node$@, c: Sema_ctx$@, runtime_names: U8[][]) //<
    //< The ABI conversion pass's entry point
    //< It overwrites names with their mangled forms in place, recursively over the whole tree.
    //< runtime_names: the names the C runtime spells (`c_names` in `../gen/runtime.kspl`). The
    //< pipeline hands them in, since this layer imports nothing of the generators.
    base_diag.ice_assert(r != null, "abi.apply: file_node is null")
    $names: = C_names::{ .globals = global_c_names(c),
        .declared = Map<|U8[], C_claim|>(null) }
    defer names.globals.free()
    defer names.declared.free()
    for n in runtime_names
        names.declared.set(n, C_claim::{ .name = "", .node = null, .type_id = 0 })
    names.claim_made_types(c)
    r.apply_abi_recursive(c, names@, 0)

priv struct C_claim //< what holds a C name: the C runtime, a type with no declaration, or a global
    name: U8[] //< the KSPL spelling; empty for a name of the C runtime
    node: Ast_node$@ //< the declaration, for its position; null where there is none
    type_id: I32 //< the type it names (a made type, or a type's declaration), or 0

priv struct C_names //< the C names the pass deals in, for the checks on them
    globals: Map<|U8[], Bool|> //< what a local must not spell (`global_c_names`)
    declared: Map<|U8[], C_claim|> //< each global C name, and what holds it

impl C_names
    priv fn claim_made_types(r: Self$@, c: Sema_ctx$@) //<
        //< Records the C names of the types C defines with no declaration: arrays and functions
        //< They are what genc defines from `complex_types` (`../gen/c/decl.kspl`). One name reached
        //< by two ids (a read-only one and the plain one) is one C type, so the first id holds it.
        defer $spelled: = Str_builder()
        for type_id in c.env.complex_types
            switch c.env.get_info(type_id)
            case .array(_b, size)
                if size == -1
                    continue
            default {}
            spelled.clear()
            c.env.mangle_type_id_to(type_id, spelled)
            if r.declared.get(spelled.slice()).is_none()
                r.declared
                    .set(base_core.arena.dup_str(spelled.slice()),
                    C_claim::{ .name = c.env.display(type_id), .node = null, .type_id = type_id })

    priv fn claim(r: Self$@, c: Sema_ctx$@, at: Ast_node$@, sym: Sema_symbol$@, c_name: U8[],
        type_id: I32) //<
            //< Records c_name (on the arena) as sym's, and reports it where something took it first
            //< type_id is the type a type's declaration names, or 0. **Two KSPL names can meet in
            //< C**: `a_b/c.Foo` and `a/b_c.Foo` are both `p_a_b_c_Foo`. So can the C runtime's
            //< (`check` in a file `bounds`) and a type with no declaration (`Foo[4]`). C would
            //< refuse the second, far from the source. A name written as it stands (`extern`,
            //< `#export`) is C's own and not checked.
        if other: = r.declared.get(c_name)
            $holder: = ""
            if other.name.len == 0
                holder = "the C runtime"
            else if other.node == null
                if type_id != 0 &&
                    c.env.get_real_type(type_id) == c.env.get_real_type(other.type_id)
                    return
                holder = base_core.arena.text().s("'\{other.name\}'").take()
            // A generic trait's default method has a clone per instance of the trait, each with
            // its symbol; a clone keeps its declaration's position.
            else if sym.node != null && !other.node.loc.same_as(sym.node.loc)
                file: = base_diag.shown_file(other.node.loc.file())
                line: = c.line_of(other.node.loc)
                holder = base_core.arena.text().s("'\{other.name\}' at \{file\}:\{line\}").take()
            if holder.len > 0
                c.clear_scratch()
                    .s("'\{sym.name\}' takes the name '\{c_name\}' in the generated C, and so does \
                        \{holder\}. Rename one of them, or the folder or file that holds it")
                c.err(at, c.scratch.slice())
            return
        r.declared
            .set(c_name,
            C_claim::{ .name = sym.name, .node = sym.node, .type_id = type_id })

priv fn global_c_names(c: Sema_ctx$@): Map<|U8[], Bool|> //<
    //< The C names of the program's globals that a local can spell: verbatim ones and types'
    //< A local of such a name takes a made one, as a local hiding a local does. C would read the
    //< local in place of the global from its declaration on: a local `Slice_U8` hides
    //< the slice type, and `libc.abs`'s `abs` is read as the local in its own initializer.
    //< Note: Every other global's C name opens with `kspl_` (`KSPL_PREFIX`), which
    //< `spells_global_c_name` tests without a list.
    $names: = Map<|U8[], Bool|>(null)
    for e in c.symtab.by_fqn.items()
        sym: = e.value
        if !sym.flags.is_method && sym.uses_verbatim_c_name()
            names.set(sym.name, true)
    defer $spelled: = Str_builder()
    for $type_id: = 1; type_id < c.env.id_to_type.len; type_id += 1
        // A pointer and a read-only type have no name in C: genc writes `T*` and `const T` around
        // their base (`map_c_type_to_impl`). Leave them out, or a chain too deep for C is spelled
        // here and stops the compiler before genc reports it at its line.
        info: = c.env.get_info(type_id)
        if info.is_pointer() || info.is_const_of()
            continue
        spelled.clear()
        c.env.mangle_type_id_to(type_id, spelled)
        if names.get(spelled.slice()).is_none()
            names.set(base_core.arena.dup_str(spelled.slice()), true)
    return names

impl Ast_node
    priv fn apply_abi_recursive(r: Ast_node$@, c: Sema_ctx$@, names: C_names$@, owner_id: I32) //<
        //< owner_id: the type of the `impl` whose direct child r is, or 0
        if r == null
            return
        kind: = r.kind_id
        if kind == .k_enum_init
            // An enum_init's children are a tag's labels, not C symbol references; genc uses them
            // unchanged, so rewriting would break the variant name.
            return

        target: = r.get_decl_type_node() if kind == .k_decl_impl else null
        child_owner_id: = target.type_id if target != null else 0
        for child in r.children
            child.apply_abi_recursive(c, names, child_owner_id)

        if kind == .k_identifier || kind == .k_expr_path
            r.name_hiding_local(names.globals@)
        switch kind
        case .k_decl_fn, .k_decl_var, .k_decl_const, .k_decl_embed, .k_decl_struct, .k_decl_enum,
            .k_decl_typedef, .k_decl_trait
            r.transform_decl_name(c, owner_id, names)
        case .k_expr_postfix
            op_node: = r.get_postfix_op()
            if op_node != null && op_node.text.equals("(")
                r.transform_postfix_call(c)
        case .k_method_access
            r.transform_method_access(c)
        case .k_expr_path, .k_type_path, .k_generic_path
            r.transform_path_access(c)
        default {}

    priv fn name_hiding_local(r: Ast_node$@, globals: Map<|U8[], Bool|>$@) //<
        //< Gives a local hiding another of its name a C name of its own (`hiding_local_name`)
        //< It renames the declared name and every reference alike. Both reach the declaration's
        //< symbol: a reference and a declared name through `def_node`, a `switch` arm's or a
        //< `catch`'s binding through its own `sym_ptr`. The name is made from the symbol alone, so
        //< a node Lower cloned takes the same one. A global's C name counts as hidden.
        $found: = hiding_local_of(r.def_node, globals)
        if found.is_none()
            found = hiding_local_of(r, globals)
        if sym: = found
            c_name: = base_c_name.hiding_local_name(sym.name, sym.hidden_count)
            r.flatten_to_identifier(c_name)

    priv fn transform_decl_name(r: Ast_node$@, c: Sema_ctx$@, owner_id: I32, names: C_names$@) //<
        //< Gives a declaration its final C name, which both backends write as it stands
        //< owner_id: the type of the `impl` r is a method of, or 0
        id_node: = r.find_child(.k_identifier)
        r.ice_assert(id_node != null, "transform_decl_name: declaration node missing identifier")

        sym: Sema_symbol$@ = get_global_symbol_by_def(r) catch
            return

        w: = c.clear_scratch()
        is_type_decl: =
            r.kind_id == .k_decl_struct || r.kind_id == .k_decl_enum ||
            r.kind_id == .k_decl_typedef || r.kind_id == .k_decl_trait
        if is_type_decl
            // Caution: **A type's declaration takes its type's own name** (`mangle_type_id_to`),
            // the one every use of the type is written with. A name spelled again here from the
            // file's path lost the dot of a folder like `.hidden`. The type's name kept it as `_`,
            // so the C declared one name and used another.
            c.env.mangle_type_id_to(sym.type_id, w)
        else if owner_id != 0
            // A method takes its type's name in front, spelled from the type as above.
            c.env.mangle_type_id_to(owner_id, w.s(base_mangle.KSPL_PREFIX)).s("_").s(id_node.text)
        else
            get_c_identifier_for_sym_to(sym, id_node.text, w)

        id_node.text = base_core.arena.dup_str(w.slice())
        // Caution: **Pass the arena's copy**: a report reuses the scratch the name was spelled in.
        if !sym.uses_verbatim_c_name()
            names.claim(c, id_node, sym, id_node.text, sym.type_id if is_type_decl else 0)

    fn receiver_wants_ptr(r: Ast_node$@, c: Sema_ctx$@): Bool //<
        //< Whether the method that the method access `r` calls takes its receiver by pointer
        //< With no definition to say, **it answers true** but for a slice: else a needed temporary
        //< is missed and the C breaks.
        //< Note: The code that makes the temporary (`lower/expr.kspl`) uses this, so it is not
        //< `priv`.
        if r == null
            return true
        member_node: = r.get_postfix_member()
        fn_def: = member_node.def_node if member_node != null else null
        if fn_def != null
            return fn_def.receiver_is_pointer(c)
        obj_node: = r.get_postfix_receiver()
        if obj_node != null && c.env.is_slice(obj_node.type_id)
            return false
        return true

    fn receiver_is_pointer(r: Ast_node$@, c: Sema_ctx$@): Bool //<
        //< Whether the function definition `r` takes its first argument (the receiver) by pointer
        //< True where the signature does not say, as receiver_wants_ptr answers.
        fn_sig: = r.find_child(.k_type_fn_sig)
        if fn_sig == null
            return true
        params: = fn_sig.find_child(.k_param_list)
        if params == null || params.children.len == 0
            return true
        first_param: = params.get_child(0)
        if first_param.kind_id != .k_fn_param
            return true
        return c.env.is_pointer(first_param.param_type_id())

    priv fn transform_postfix_call(r: Ast_node$@, c: Sema_ctx$@)
        expr_node: = r.get_postfix_receiver()
        r.ice_assert(expr_node != null, "transform_postfix_call: postfix node must have receiver")

        if expr_node.kind_id == .k_method_access || expr_node.kind_id == .k_generic_method
            obj_node: = expr_node.get_postfix_receiver()
            if c.env.trait_def_of_receiver(obj_node.type_id).is_none()
                requires_ptr: = expr_node.receiver_wants_ptr(c)
                // It adjusts the receiver's pointer depth (obj_depth) to the method's
                // (target_depth: 1 for Self@, 0 for Self). It adds one '@' where the depth is
                // short, and a '$' per extra level (Foo@@, say).
                target_depth: = 1 if requires_ptr else 0
                $obj_depth: = c.env.ptr_depth(obj_node.type_id)
                $passed_obj: = obj_node

                if obj_depth < target_depth
                    passed_obj = Ast_node(.k_expr_postfix, "@", r.loc)
                    at_literal: = Ast_node(.k_literal, "@", r.loc)
                    passed_obj.add_child(obj_node).add_child(at_literal)
                    passed_obj.type_id = c.env.make_ptr(obj_node.type_id)
                else
                    for obj_depth > target_depth
                        deref_node: = Ast_node(.k_expr_postfix, "$", r.loc)
                        deref_literal: = Ast_node(.k_literal, "$", r.loc)
                        deref_node.add_child(passed_obj).add_child(deref_literal)
                        deref_node.type_id = c.env.strip_ptr(passed_obj.type_id)
                        passed_obj = deref_node
                        obj_depth -= 1

                expr_node.transform_method_access(c)
                flattened_member: = expr_node.get_postfix_member()
                // The receiver is now the first argument, so the method_access becomes a plain
                // Identifier of the callee, an ordinary function call from here on.
                expr_node.morph(.k_identifier, flattened_member.text)

                $args_node: = r.safe_get_child(2)
                if args_node == null || args_node.kind_id != .k_expr_args
                    args_node = Ast_node.build_args(r.loc)
                    if r.children.len > 2
                        r.set_child(2, args_node)
                    else
                        r.add_child(args_node)

                if args_node.children.len > 0
                    args_node.insert_child(0, Ast_node(.k_literal, ",", r.loc))
                    args_node.insert_child(0, passed_obj)
                else
                    args_node.add_child(passed_obj)
                return

        if expr_node.flatten_if_generic(c)
            return

        if (expr_node.kind_id == .k_expr_path || expr_node.kind_id == .k_type_path) ||
            expr_node.kind_id == .k_identifier
            func_part: = expr_node.get_path_name()
            sym: = get_global_symbol_by_def(expr_node.def_node).unwrap_or(null)

            w: = c.clear_scratch()
            get_c_identifier_for_sym_to(sym, func_part, w)
            c_name: = w.slice()

            is_kspl: = func_part.has_kspl_prefix()
            if is_kspl && sym == null
                expr_node.flatten_to_identifier(func_part)
            else
                expr_node.flatten_to_identifier(c_name)

    priv fn transform_method_access(r: Ast_node$@, c: Sema_ctx$@)
        obj_node: = r.get_postfix_receiver()
        member_node: = r.get_postfix_member()
        r.ice_assert(obj_node != null && member_node != null,
            "method_access node must have receiver and member")

        if member_node.flatten_if_generic(c)
            return

        $base_id: = member_node.type_id
        if base_id == 0 || sema_type_env.is_unknown(base_id)
            base_id = obj_node.type_id
            for
                info: = c.env.get_info(base_id)
                switch info
                case .pointer(inner_id)
                    base_id = inner_id
                default
                    break

        info: = c.env.get_info(c.env.get_real_type(base_id))
        switch info
        case .trait_type
            return
        default {}

        target_def: = member_node.def_node if member_node.def_node != null else r.def_node

        sym: = get_global_symbol_by_def(target_def).unwrap_or(null)
        w: = c.clear_scratch()

        if sym != null
            get_c_identifier_for_sym_to(sym, member_node.text, w)
            member_node.flatten_to_identifier(w.slice())
            return

        $res: = w.s("kspl_")
        if base_id != 0
            c.env.mangle_type_id_to(base_id, w)
            res = w.s("_")

        res.s(member_node.text)
        member_node.flatten_to_identifier(w.slice())

    priv fn transform_path_access(r: Ast_node$@, c: Sema_ctx$@)
        if r.flatten_if_generic(c)
            return

        base_name: = r.get_path_name()
        switch get_global_symbol_by_def(r.def_node)
        case .some(sym)
            w: = c.clear_scratch()
            get_c_identifier_for_sym_to(sym, base_name, w)
            r.flatten_to_identifier(w.slice())
        case .none
            r.flatten_to_identifier(base_name)

    priv fn flatten_if_generic(r: Ast_node$@, c: Sema_ctx$@): Bool
        if r.kind_id == .k_generic_path || r.kind_id == .k_generic_method
            if r.type_id != 0
                flat_name: = c.env.get_str(r.type_id)
                w: = c.clear_scratch()
                flat_name.kspl_symbol_to(w)
                r.flatten_to_identifier(w.slice())
                return true
        return false

    priv fn is_generic_inst_node(r: Ast_node$@): Bool
        if r == null
            return false
        switch get_global_symbol_by_def(r)
        case .some(sym)
            return sym.flags.is_generated_instance
        case .none
            return false

fn get_c_identifier_for_sym_to(sym: Sema_symbol$@, base_name: U8[], w: Writer): Writer //<
    //< It writes the C name of what sym names (base_name where sym names no value or type)
    //< The entry point asks it for the functions it calls outside the tree (gen/entry.kspl).
    if sym == null || (!sym.kind.is_value() && !sym.kind.is_type())
        return w.s(base_name)

    is_method_name: = sym.flags.is_method || sym.name.find_char_out('.') >= 0

    // Caution: **A method must not take its name as written.** A method's name is `type.method`,
    // which is not a C identifier, and its declaration always takes its type's name in front
    // (transform_decl_name). A plain name here would leave the C, with no diagnostic, a call to a
    // function that is not defined. A method has this option only where an `#export` was
    // written, and `sema/decl/attrs.kspl` rejects that.
    if !is_method_name && sym.uses_verbatim_c_name()
        return w.s(sym.name)
    if sym.name.equals("main") || sym.name.equals("kspl_main")
        return w.s("kspl_main")
    if sym.node.is_generic_inst_node()
        return sym.name.kspl_symbol_to(w)

    if is_method_name
        last_dot: = sym.name.rfind_char_out('.')
        if last_dot >= 0
            t_name: = sym.name.sub(0, last_dot)
            m_name: = sym.name.sub_from(last_dot + 1)
            return t_name.mangle_c_type_name_to(w.s("kspl_")).s("_\{m_name\}")
        return sym.name.mangle_type_name_to(w.s("kspl_"))

    def_in: = sym.get_defined_in()

    if is_private_symbol(sym)
        return write_priv_prefix_to(def_in, w).s(sym.name)

    if def_in.len > 0
        def_in.mangle_type_name_to(w.s("kspl_")).s("_")
        return sym.name.mangle_type_name_to(w)

    return sym.name.mangle_type_name_to(w.s("kspl_"))

priv fn is_private_symbol(sym: Sema_symbol$@): Bool //<
    //< Whether sym is a file-private value whose C name needs the file's prefix
    //< A file_private symbol is unique only per file. So in C's flat global namespace it can
    //< collide with a same-named private symbol in another file.
    //< A prefix spelling the file path makes it unique (write_priv_prefix_to).
    //< Caution: **Do not list exceptions here.** Whether a symbol is already unique across the
    //< program is answered by `Sema_symbol.has_program_unique_c_name` (`sema/type/scope.kspl`).
    if sym == null || sym.vis != sema_type_scope.Visibility.file_private
        return false
    return sym.kind.is_value() && !sym.has_program_unique_c_name()

priv fn get_global_symbol_by_def(def_node: Ast_node$@): Sema_symbol$@? //<
    //< The symbol of a definition node, found through `sym_ptr` only
    //< Caution: **Do not search the table for it.** Every path that adds to the global table sets
    //< `sym.node.sym_ptr` (define_symbol in `sema/decl/scope.kspl`, `sema/session/ctx.kspl`,
    //< `sema/decl/mono.kspl`); a new path must too, or the name is emitted unmangled.
    if def_node == null || def_node.sym_ptr == null
        return .none
    sym: = Sema_symbol$@::def_node.sym_ptr
    if sym.flags.is_global || sym.flags.is_method
        return .some(sym)
    // A local variable is not mangled.
    return .none

priv fn hiding_local_of(decl: Ast_node$@, globals: Map<|U8[], Bool|>$@): Sema_symbol$@? //<
    //< The symbol decl declares, if it is a local hiding another of its name or a global's C name
    if decl == null || decl.sym_ptr == null
        return .none
    sym: = Sema_symbol$@::decl.sym_ptr
    // A helper Lower made (`is_premangled`) is a global under its C name, though not flagged one.
    if sym.flags.is_global || sym.flags.is_method || sym.flags.is_premangled ||
        !sym.kind.is_value()
        return .none
    if sym.hidden_count == 0 && !sym.name.spells_global_c_name(globals)
        return .none
    return .some(sym)

impl U8[]
    priv fn spells_global_c_name(r: U8[], globals: Map<|U8[], Bool|>$@): Bool //<
        //< Whether a local of this name would take a global's C name (`global_c_names`)
        return r.has_kspl_prefix() || globals.get(r).unwrap_or(false)

priv fn write_priv_prefix_to(fname: U8[], w: Writer): Writer
    $res: = w.s("kspl_priv_")

    // resolve_import_path joins "dir/import_str" without normalizing, so a relative import can
    // collect several "./" / ".\" ("././sibling"); it skips them until none is left.
    $start_idx: Sz = 0
    for start_idx + 1 < fname.len && (fname.ptr + start_idx)$ == '.' &&
        ((fname.ptr + start_idx + 1)$ == '/' || (fname.ptr + start_idx + 1)$ == '\\')
        start_idx += 2

    // The extension's '.' is looked for only after start_idx: counting a relative path's leading
    // '.' empties the range and turns every priv symbol's prefix into the same string.
    $end_idx: Sz = fname.len
    if dot_idx_rel: = fname.sub_from(start_idx).find_char('.')
        end_idx = start_idx + dot_idx_rel

    for $i: = start_idx; i < end_idx; i += 1
        ch: = (fname.ptr + i)$
        if ch.is_alnum()
            res = res.c(ch)
        else
            res = res.c('_')

    return res.s("_")

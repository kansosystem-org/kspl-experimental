//< The one lowering walk: the dispatch on each node's kind, and blocks, branches and loops
//< Every node is lowered through `lower` here. Three files add the kinds they own to the same walk.
//< `expr.kspl` adds expressions, `!`, a `catch` and its `fallback`. `defer.kspl` adds cleanups and
//< the ways out that run them, and `arc.kspl` adds retain and release. `ctx.kspl` holds the state.
import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_kinds" as base_ast_kinds
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/base/diag" as base_diag
import "ksplc/lower/arc" as lower_arc
import "ksplc/lower/ctx" { Fallback_ctx, Jump_ctx, Lowering_ctx }
import "ksplc/lower/defer" as lower_defer
import "ksplc/lower/expr" as lower_expr
import "ksplc/sema/session/ctx" { Sema_ctx }
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/ds" { List, Map }
import "std/io"
import "std/sys"

const MAX_LOWER_DEPTH: Sz = 2000 //<
    //< The depth limit for lower's recursion, and for the walks of lower/verify and lower/prune
    //< A postfix chain (`x$$$...$;`) is outside the parser's max_parse_depth; every recursion here
    //< goes through r.lower().
    //< Caution: **Do not make it small**: prune's walk cut off here drops a live function.

fn run(ctx: Sema_ctx$@, root: Ast_node$@)
    base_diag.ice_assert(root != null, "lower_root.run: root is null")
    lctx: = Lowering_ctx(ctx)
    // It caches the answer to "does this value own ARC memory" only during this stage. The reason
    // and the danger are at arc_content_memo in sema/type/env.kspl.
    // Caution: **Turn it on here and nowhere else.** Only here have the types stopped growing;
    // earlier it would cache answers from before the fields were complete.
    defer $arc_memo: = Map<|I32, I32|>(null)
    ctx.env.arc_content_memo = arc_memo@
    // Each type's name in the generated code is kept once spelled, from here on through code
    // generation. The reason and the danger are at c_names_final in sema/type/env.kspl.
    // Caution: **Turn it on here and nowhere else**, for arc_memo's reason: earlier, an instance's
    // record can still be arriving.
    ctx.env.c_names_final = true
    root.lower(lctx)
    // The ARC helpers (one per type, like Rust's and Swift's drop glue) are created during the walk
    // and added after it.
    for helper in lctx.arc_helper_decls
        root.add_child(helper)
    // Caution: Always turn it off when leaving the stage; arc_memo is freed right after.
    ctx.env.arc_content_memo = null

impl Ast_node
    fn lower(r: Self$@, lctx: Lowering_ctx$@)
        if r == null
            return
        lctx.lower_depth += 1
        if lctx.lower_depth >= MAX_LOWER_DEPTH
            io.err()
                .s("\nfatal: expression or statement nesting too deep during lowering. A chain of \
                    pointers, arrays or dereferences may be unbounded.\n")
            sys.exit(1)

        switch r.kind_id
        case .k_decl_fn
            r.lower_decl_fn(lctx)
        case .k_stmt_block, .k_file
            r.lower_block(lctx)
        case .k_stmt_labeled_block
            r.lower_stmt_labeled_block(lctx)
        case .k_stmt_return, .k_stmt_throw
            r.lower_return_or_throw_stmt(lctx)
        case .k_stmt_break, .k_stmt_continue
            r.lower_loop_jump(lctx)
        case .k_stmt_fallback
            r.lower_fallback_stmt(lctx)
        case .k_stmt_if
            r.lower_stmt_if(lctx)
        case .k_stmt_defer
            r.lower_cleanup_stmt(lctx)
        case .k_decl_var
            r.lower_arc_var_decl(lctx)
        case .k_struct_literal
            r.lower_arc_aggregate_literal(lctx)
        case .k_enum_init_call
            r.lower_arc_enum_init_call(lctx)
        case .k_result_wrap
            r.lower_result_wrap(lctx)
        case .k_stmt_for
            r.lower_stmt_for(lctx)
        case .k_stmt_switch
            r.lower_stmt_switch(lctx)
        case .k_expr
            r.lower_expr_node(lctx)
        case .k_expr_unary
            r.lower_expr_unary(lctx)
        case .k_expr_postfix
            r.lower_expr_postfix(lctx)
        case .k_expr_upcast
            r.lower_expr_upcast(lctx)
        case .k_stmt_expr
            r.lower_stmt_expr(lctx)
        case .k_expr_ternary
            r.lower_expr_ternary(lctx)
        case .k_expr_catch_chain
            r.lower_expr_catch_chain(lctx)
        default
            r.lower_default(lctx)
        lctx.lower_depth -= 1

    fn hoist_complex_expr(r: Ast_node$@, lctx: Lowering_ctx$@, force: Bool = false): Ast_node$@
        // `force` copies a receiver to a temporary. A literal or computed result has no side effect
        // but no address either, so it **must be put in a slot** (`&3` is not C).
        if r == null || (!force && !r.has_side_effect())
            return r

        // The temporary is numbered before the lower, not by hoist_to_tmp. The recursive lower can
        // use numbers too, and the order would differ between stage1 and stage2 when self-hosting.
        tmp_name: = lctx.gen_tmp_name()
        r.lower(lctx)
        lctx.pre_stmts.push(lctx.build_let_decl(tmp_name, r.type_id, r, r.loc))
        return Ast_node.build_ident(tmp_name, r.type_id, r.loc)

    fn lower_decl_fn(r: Ast_node$@, lctx: Lowering_ctx$@)
        saved_counter: = lctx.tmp_counter
        lctx.tmp_counter = 0
        old_fb: = lctx.fb
        old_cleanup_stack: = lctx.cleanup_stack
        old_jump_stack: = lctx.jump_stack
        old_in_fn_body: = lctx.in_fn_body
        lctx.in_fn_body = true

        lctx.fb = Fallback_ctx::{ .target = "", .label = "", .label_used = false, .depth = 0 }
        lctx.cleanup_stack = List<|List<|Ast_node$@|>$@|>.create(base_core.arena)
        lctx.jump_stack = List<|Jump_ctx|>.create(base_core.arena)

        // It pushes the release of an ARC-managed value argument onto the pending list (the body
        // block flushes it into its own scope).
        lctx.arc_scope_pending.len = 0
        lctx.register_arc_params(r)

        r.lower_default(lctx)

        lctx.tmp_counter = saved_counter
        lctx.fb = old_fb
        lctx.cleanup_stack = old_cleanup_stack
        lctx.jump_stack = old_jump_stack
        lctx.in_fn_body = old_in_fn_body

    fn lower_stmt_labeled_block(r: Self$@, lctx: Lowering_ctx$@)
        if r.children.len < 2
            return
        l_node: = r.get_labeled_block_label()
        label_node: = l_node.find_child(.k_identifier) if l_node != null else null
        block_node: = r.get_labeled_block_inner()
        user_label: = label_node.text if label_node != null else ""

        brk_label: = lctx.gen_label_name()
        lctx.push_jump_ctx("", brk_label, user_label, false)

        block_node.lower(lctx)

        is_brk_used: = lctx.pop_jump_ctx().break_used

        r.morph(.k_stmt_block, "stmt_block")
        r.clear_children()
        r.add_child(block_node)

        // The jump target label is emitted only where a break refers to it.
        if is_brk_used
            r.add_child(Ast_node.build_label_stmt(brk_label, r.loc))

    fn lower_block(r: Ast_node$@, lctx: Lowering_ctx$@)
        cleanup_scope: = base_ast.new_ast_node_list()
        lctx.cleanup_stack.push(cleanup_scope)
        outer_relocating: = lctx.relocating
        lctx.relocating = 0

        // It flushes the releases pushed for this scope. They are the arguments' for a function
        // body (the first block under decl_fn), and an arm's bindings for a switch arm.
        if lctx.arc_scope_pending.len > 0
            for pending_stmt in lctx.arc_scope_pending
                cleanup_scope.push(pending_stmt)
            lctx.arc_scope_pending.len = 0

        old_children: = r.children
        new_children: = base_ast.new_ast_node_list()

        for stmt in old_children
            start_pre: = lctx.pre_stmts.len
            start_decls: = lctx.stmt_decls.len

            stmt.lower(lctx)

            for $k: = start_decls; k < lctx.stmt_decls.len; k += 1
                new_children.push(lctx.stmt_decls.get(k))
            lctx.stmt_decls.len = start_decls
            lctx.flush_pre_stmts_to_list(start_pre, new_children)

            if stmt.kind_id != .k_empty
                new_children.push(stmt)
        scope_len: = cleanup_scope.len
        for $j: = scope_len; j > 0; j -= 1
            d_node: = lctx.lower_and_wrap_cleanup(cleanup_scope.get(j - 1))
            new_children.push(d_node)

        r.children = new_children
        lctx.cleanup_stack.len -= 1
        lctx.relocating = outer_relocating

    fn wrap_stmt_with_break_label(r: Ast_node$@, inner_kind: base_ast_kinds.Ast_kind,
        inner_text: U8[], loc: base_ast.Loc, brk_label: U8[], needs_label: Bool) //<
            //< It wraps a labelled statement a break refers to as `{ <the statement>; label: }`
            //< The wrapper is a stmt_block. lower_stmt_if, lower_stmt_for and lower_stmt_switch use
            //< it. **With no label to place, it wraps nothing**: the wrapper would be a scope
            //< holding only the statement (a loop's init is scoped by `emit_loop_stmt` itself).
        if !needs_label
            return
        inner: = Ast_node(inner_kind, inner_text, loc)
        inner.children = r.children
        r.children = base_ast.new_ast_node_list()
        r.morph(.k_stmt_block, "stmt_block")
        r.add_child(inner)
        r.add_child(Ast_node.build_label_stmt(brk_label, loc))

    fn lower_stmt_if(r: Ast_node$@, lctx: Lowering_ctx$@)
        label_node: = r.get_if_label()
        user_label: = label_node.text if label_node != null else ""
        is_jumpable: = user_label.len > 0
        brk_label: = lctx.gen_label_name() if is_jumpable else ""

        if is_jumpable
            lctx.push_jump_ctx("", brk_label, user_label, false)

        cond: = r.get_if_cond()
        cond.lower(lctx)
        r.get_if_then_block().lower(lctx)

        alt_node: = r.get_if_else_block()
        if alt_node != null
            if alt_node.kind_id == .k_stmt_if
                start_pre: = lctx.pre_stmts.len
                lctx.relocating += 1
                alt_node.lower(lctx)
                lctx.relocating -= 1

                if lctx.pre_stmts.len > start_pre
                    wrapper_block: = Ast_node.build_block(alt_node.loc)
                    lctx.flush_pre_stmts_to_node(start_pre, wrapper_block)
                    wrapper_block.add_child(alt_node)
                    r.set_child(3, wrapper_block)
            else
                alt_node.lower(lctx)

        if is_jumpable
            is_brk_used: = lctx.pop_jump_ctx().break_used
            if is_brk_used
                r.wrap_stmt_with_break_label(.k_stmt_if, "if", r.loc, brk_label, true)

    fn lower_stmt_for(r: Ast_node$@, lctx: Lowering_ctx$@)
        label_node: = r.get_loop_label()
        user_label: = label_node.text if label_node != null else ""

        init_node: = r.get_for_init()
        cond_node: = r.get_loop_cond()
        step_node: = r.get_for_step()
        body_block: = r.get_loop_block()
        loc: = r.loc

        if init_node.kind_id != .k_empty
            init_node.lower(lctx)

        cond_start_pre: = lctx.pre_stmts.len
        lctx.relocating += 1
        if cond_node.kind_id != .k_empty
            cond_node.lower(lctx)
        has_cond_pre: = lctx.pre_stmts.len > cond_start_pre
        cond_stmts: = base_ast.new_ast_node_list()
        lctx.flush_pre_stmts_to_list(cond_start_pre, cond_stmts)

        step_start_pre: = lctx.pre_stmts.len
        if step_node.kind_id != .k_empty
            step_node.lower(lctx)
        lctx.relocating -= 1
        has_step_pre: = lctx.pre_stmts.len > step_start_pre
        step_stmts: = base_ast.new_ast_node_list()
        lctx.flush_pre_stmts_to_list(step_start_pre, step_stmts)

        cont_label: = lctx.gen_label_name() // always generate a label, forcing continue into a goto
        brk_label: = lctx.gen_label_name()

        lctx.push_jump_ctx(cont_label, brk_label, user_label, true)

        if has_cond_pre
            // A condition with pre_stmts cannot go in C's for condition clause. So its evaluation
            // and the break move to the start of the body, and the loop becomes unconditional
            // (r.set_child(2, ...) below).
            bool_id: = I32::sema_type_env.Builtin_type_id.bool_type
            not_expr: = Ast_node.build_unary_expr("!", cond_node, bool_id, loc)
            goto_stmt: = Ast_node.build_goto_stmt(brk_label, loc)
            break_block: = Ast_node.build_block(loc)
            break_block.add_child(goto_stmt)
            node_if_brk: = Ast_node.build_if_stmt(not_expr, break_block, null, loc)
            body_block.lower(lctx)

            new_body_children: = base_ast.new_ast_node_list()
            for cond_stmt in cond_stmts
                new_body_children.push(cond_stmt)
            new_body_children.push(node_if_brk)

            for orig_child in body_block.children
                new_body_children.push(orig_child)

            body_block.children = new_body_children
            r.set_child(2, Ast_node.build_empty(loc))
        else
            body_block.lower(lctx)

        popped_jc: = lctx.pop_jump_ctx()
        is_cont_used: = popped_jc.continue_used
        is_brk_used: = popped_jc.break_used

        if has_step_pre || is_cont_used
            if is_cont_used
                body_block.add_child(Ast_node.build_label_stmt(cont_label, loc))

            for step_stmt in step_stmts
                body_block.add_child(step_stmt)

        r.wrap_stmt_with_break_label(.k_stmt_for, "for", loc, brk_label, is_brk_used || has_cond_pre)

    fn lower_stmt_switch(r: Ast_node$@, lctx: Lowering_ctx$@)
        label_node: = r.get_switch_label()
        user_label: = label_node.text if label_node != null else ""
        is_jumpable: = user_label.len > 0
        brk_label: = lctx.gen_label_name() if is_jumpable else ""

        lctx.push_jump_ctx("", brk_label, user_label, false)

        cond: = r.get_switch_cond()
        // A subject built in place (`switch Wrap.filled(mk(9))`) is owned by its temporary.
        owned: = lctx.can_own_temporaries() && cond.is_arc_fresh(lctx)
        cond.lower(lctx)
        if !cond.is_plain_name()
            tmp: = cond.hoist_to_tmp(lctx, cond.loc)
            if owned
                lctx.register_arc_release(tmp, cond.type_id)
            r.set_child(1, tmp)

        // The pattern whose bindings the arm's block sees: the first after its `case`.
        $arm_pattern: Ast_node$@ = null
        for $i: = 2; i < r.children.len; i += 1
            child: = r.get_child(i)
            if child.is_keyword("case") || child.is_keyword("default")
                arm_pattern = null
                continue

            if child.kind_id == .k_stmt_block
                retains: = lctx.register_arc_arm_bindings(arm_pattern)
                child.lower(lctx)
                for $k: = retains.len; k > 0; k -= 1
                    child.insert_child(0, retains.get(k - 1))
            else if child.kind_id == .k_case_pattern
                if arm_pattern == null
                    arm_pattern = child
                if expr_node: = child.first_expr()
                    expr_node.lower(lctx)

        r.group_switch_arms(lctx)
        is_brk_used: = lctx.pop_jump_ctx().break_used

        if is_jumpable && is_brk_used
            r.wrap_stmt_with_break_label(.k_stmt_switch, "switch", r.loc, brk_label, true)

    fn group_switch_arms(r: Ast_node$@, lctx: Lowering_ctx$@) //<
        //< Gathers a `switch`'s flat children into one `switch_arm` per `case` or `default`
        //< An arm holds its labels, then its block (`build_switch_arm` in `base/ast.kspl`). A label
        //< naming a variant of the subject's enum keeps its `case_pattern`, the variant's index in
        //< `ival`; any other label is its value. The first pattern's payload bindings become
        //< declarations at the head of the block. So the backends resolve nothing again.
        //< Caution: **Every `switch` that reaches a backend comes through here**, a synthesized
        //< one too (`emit_managed_enum_op` in `arc.kspl`): the backends read arms only.
        subject: = r.get_switch_cond()
        arms: = base_ast.new_ast_node_list()
        arms.push(r.get_child(0))
        arms.push(subject)
        $arm: Ast_node$@ = null
        $first_pattern: Ast_node$@ = null
        $is_first: = false
        for $i: Sz = 2; i < r.children.len; i += 1
            child: = r.get_child(i)
            child.ice_assert(child.kind_id != .k_switch_arm, "group_switch_arms: grouped twice")
            if child.is_keyword("case") || child.is_keyword("default")
                arm = Ast_node.build_switch_arm(child.is_keyword("default"), child.loc)
                arms.push(arm)
                first_pattern = null
                is_first = true
            else if child.kind_id == .k_stmt_block
                child.ice_assert(arm != null, "group_switch_arms: a block outside an arm")
                if first_pattern != null
                    first_pattern.declare_payload_bindings(lctx, subject, child)
                arm.add_child(child)
                arm = null
            else if !child.is_literal(",")
                child.ice_assert(arm != null, "group_switch_arms: a pattern outside an arm")
                label: = child.switch_label(lctx, subject.type_id)
                if is_first && label.kind_id == .k_case_pattern
                    first_pattern = label
                is_first = false
                arm.add_child(label)
        r.children = arms

    priv fn switch_label(r: Ast_node$@, lctx: Lowering_ctx$@, subject_id: I32): Ast_node$@ //<
        //< What a backend writes for the pattern r: its `case_pattern` naming a variant, else its value
        if r.kind_id != .k_case_pattern
            return r
        switch r.extract_case_variant()
        case .variant(v_name_node, _start)
            if v_name_node != null
                idx: = lctx.sema.env.variant_index(subject_id, v_name_node.text)
                if idx >= 0
                    r.ival = idx
                    return r
        default {}
        return r.first_expr().unwrap_or(r.get_child(0))

    priv fn declare_payload_bindings(r: Ast_node$@, lctx: Lowering_ctx$@, subject: Ast_node$@,
        block: Ast_node$@) //<
            //< Declares the bindings of the variant pattern r at the head of block, each read from
            //< its payload field
            //< A binding pairs with the payload's fields by position. Its declaration keeps the
            //< binding's identity (`def_node`), so every reference, and ARC's count for it
            //< (`register_arc_arm_bindings` in `arc.kspl`), names the same local.
        variant: = lctx.sema.env.variant_at(subject.type_id, r.ival) catch
            r.ice_panic("declare_payload_bindings: the pattern names no variant")
        $start: Sz = 0
        switch r.extract_case_variant()
        case .variant(_v, s)
            start = s
        default {}
        $field_idx: Sz = 0
        $at: Sz = 0
        for k in Range(start, r.children.len, 1)
            b: = r.get_child(k)
            if b.kind_id != .k_identifier
                continue
            if field_idx < variant.payload_fields.len
                f: = variant.payload_fields.get(field_idx)
                read: = Ast_node.build_payload_access(subject.clone(), r.ival, f.name,
                    I32::field_idx, f.type_id, b.loc)
                decl: = lctx.build_let_decl(b.text, f.type_id, read, b.loc)
                decl.get_var_decl_id().def_node = b
                block.insert_child(at, decl)
                at += 1
            field_idx += 1

    fn lower_default(r: Ast_node$@, lctx: Lowering_ctx$@)
        for child in r.children
            child.lower(lctx)

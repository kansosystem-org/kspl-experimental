//< Tracks which local still owns an automatic cleanup after a move or explicit release
//<
//< A live flag belongs to the local slot, not its resource. Moving clears the source flag;
//< assignment restores the destination flag. The cleanup stack tests it on every way out.
import "ksplc/base/ast" as base_ast + { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_spell" as base_ast_spell
import "ksplc/base/core" as base_core
import "ksplc/lower/ctx" { Lowering_ctx }
import "ksplc/sema/flow/release" as sema_flow_release
import "ksplc/sema/type/arc" as sema_type_arc
import "ksplc/sema/type/env" as sema_type_env
import "ksplc/sema/type/query" as sema_type_query
import "std/ds" { List }
import "std/str" { Str_builder }

priv fn owner_key(value: Ast_node$@): U8[] //< the declaration's identity, or a generated name
    $node: = value
    for node != null && node.kind_id == .k_expr_primary && node.children.len > 0
        node = node.get_primary_inner_expr()
    if node != null && node.kind_id == .k_expr_postfix &&
        node.postfix_op_text().equals(".")
        head: = owner_key(node.get_postfix_receiver())
        if head.len == 0
            return ""
        $field: = Str_builder.new()
        field.s(head).c('.').s(node.get_postfix_member().text)
        return base_core.arena.dup_str(field.slice())
    if node == null || !(node.kind_id == .k_identifier || node.kind_id == .k_expr_path)
        return ""
    if node.def_node == null
        return node.text
    $key: = Str_builder.new()
    key.s("owner:\{Sz::node.def_node\}")
    return base_core.arena.dup_str(key.slice())

fn live_flag(lctx: Lowering_ctx$@, value: Ast_node$@): U8[] //< the owner's live flag, if registered
    key: = owner_key(value)
    return lctx.drop_flags.get(key).unwrap_or("") if key.len > 0 else ""

fn bind_flag(lctx: Lowering_ctx$@, value: Ast_node$@, live_name: U8[]) //<
    //< registers a flag already made
    key: = owner_key(value)
    if key.len > 0
        lctx.drop_flags.set(key, live_name)

fn register_owner(lctx: Lowering_ctx$@, value: Ast_node$@, initialized: Bool,
    declarations: List<|Ast_node$@|>$@) //< makes the flag for one local or by-value parameter
    if !lctx.sema.env.type_has_drop(value.type_id)
        return
    if live_flag(lctx, value).len == 0
        name: = lctx.gen_tmp_name()
        bool_id: = I32::sema_type_env.Builtin_type_id.bool_type
        initial: = Ast_node.build_bool_literal(initialized, value.loc)
        declaration: = lctx.build_let_decl(name, bool_id, initial, value.loc)
        declarations.push(declaration)
        bind_flag(lctx, value, name)
    if lctx.sema.env.is_drop_type(value.type_id)
        return
    switch lctx.sema.env.get_info(lctx.sema.env.get_clean_real_type(value.type_id))
    case .struct_type(def)
        for i in Range.asc(def.fields_list.len)
            f: = def.fields_list.get(i)
            if lctx.sema.env.type_has_drop(f.type_id)
                child: = Ast_node.build_member_access(value.clone(), f.name, I32::i, f.type_id,
                    value.loc)
                register_owner(lctx, child, initialized, declarations)
    default {}

fn set_live(lctx: Lowering_ctx$@, value: Ast_node$@, live: Bool, out: List<|Ast_node$@|>$@)
    name: = live_flag(lctx, value)
    if name.len == 0
        return
    bool_id: = I32::sema_type_env.Builtin_type_id.bool_type
    flag: = Ast_node.build_ident(name, bool_id, value.loc)
    state: = Ast_node.build_bool_literal(live, value.loc)
    out.push(Ast_node.build_assign_stmt(flag, state, value.loc))
    if !live || lctx.sema.env.is_drop_type(value.type_id)
        return
    switch lctx.sema.env.get_info(lctx.sema.env.get_clean_real_type(value.type_id))
    case .struct_type(def)
        for i in Range.asc(def.fields_list.len)
            f: = def.fields_list.get(i)
            if lctx.sema.env.type_has_drop(f.type_id)
                child: = Ast_node.build_member_access(value.clone(), f.name, I32::i, f.type_id,
                    value.loc)
                set_live(lctx, child, true, out)
    default {}

fn guard_cleanup(lctx: Lowering_ctx$@, value: Ast_node$@, body: List<|Ast_node$@|>$@,
    out: List<|Ast_node$@|>$@) //< releases an initialized owner at most once
    name: = live_flag(lctx, value)
    block: = Ast_node.build_block(value.loc)
    reset: = base_ast.new_ast_node_list()
    set_live(lctx, value, false, reset)
    for stmt in reset
        block.add_child(stmt)
    for stmt in body
        block.add_child(stmt)
    bool_id: = I32::sema_type_env.Builtin_type_id.bool_type
    condition: = Ast_node.build_ident(name, bool_id, value.loc)
    out.push(Ast_node.build_if_stmt(condition, block, null, value.loc))

fn finish_explicit_release(lctx: Lowering_ctx$@, call: Ast_node$@) //<
    //< an explicit free cancels the drop
    callee: = call.get_postfix_receiver()
    if callee == null
        return
    resets: = base_ast.new_ast_node_list()
    if recv: = callee.get_free_call_receiver(lctx.sema)
        set_live(lctx, recv, false, resets)
    collect_released_args(lctx, call, resets)
    if resets.len == 0
        return
    is_void: = sema_type_env.is_void(lctx.sema.env.get_real_type(call.type_id))
    result_name: = lctx.gen_tmp_name() if !is_void else ""
    if is_void
        lctx.pre_stmts
            .push(Ast_node.new(.k_stmt_expr, "expr", call.loc).add_child(call.clone()))
    else
        lctx.pre_stmts
            .push(lctx.build_let_decl(result_name, call.type_id, call.clone(), call.loc))
    for reset in resets
        lctx.pre_stmts.push(reset)
    if is_void
        call.morph(.k_empty, "")
    else
        call.morph(.k_identifier, result_name)

fn collect_release_effects(lctx: Lowering_ctx$@, node: Ast_node$@, depth: Sz) //<
    //< snapshots the sema contract
    if node == null || depth >= 2000
        return
    if node.kind_id == .k_decl_fn
        effects: = List<|Bool|>.create(base_core.arena)
        for p in base_ast_ext.Param_cursor.new(node.get_fn_params(), false)
            effects
                .push(node.body_frees_param_directly(p.get_decl_id_text(), lctx.sema))
        lctx.release_params.set(Sz::node, effects)
    for child in node.children
        collect_release_effects(lctx, child, depth + 1)

priv fn collect_released_args(lctx: Lowering_ctx$@, call: Ast_node$@,
    out: List<|Ast_node$@|>$@)
    callee: = call.get_postfix_receiver()
    effects: = lctx.release_params.get(Sz::callee.def_node).unwrap_or(null)
    args: = call.find_child(.k_expr_args)
    if effects == null || args == null
        return
    for i in Range.asc(effects.len)
        if !effects.get(i)
            continue
        actual: = sema_flow_release.call_arg_for_param(callee, args, i,
            callee.kind_id == .k_method_access)
        if arg: = actual
            $place: = arg
            for place != null && place.kind_id == .k_expr_postfix &&
                (place.postfix_op_text().equals("@") ||
                place.postfix_op_text().equals("::"))
                place = place.get_postfix_receiver()
            set_live(lctx, place, false, out)

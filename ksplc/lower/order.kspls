//< Fixes the order in which an expression's operands run, where C would leave it open
//<
//< C evaluates a call's arguments, an operator's two sides and a compound literal's fields in an
//< order of its own choosing (gcc takes a call's arguments from the right, clang from the left).
//< KSPL evaluates them left to right ("Evaluation order" in docs/SPEC-language.md), so an operand
//< that a later operand could disturb is moved into a temporary ahead of the statement.
import "ksplc/base/ast" { Ast_node }
import "ksplc/base/ast_ext" as base_ast_ext
import "ksplc/base/ast_place" as base_ast_place
import "ksplc/lower/ctx" { Lowering_ctx }
import "ksplc/lower/root" as lower_root
import "ksplc/sema/type/query" as sema_type_query
import "ksplc/sema/type/scope" { Sema_symbol }
import "std/ds" { List }
import "std/str"

priv const max_order_depth: Sz = 200 //<
    //< How deep the classifying walk goes before it gives the cautious answer (`acts`)
    //<
    //< Past it an operand is only moved into a temporary when it need not be, which changes nothing
    //< but the generated code's length.

enum Order_class: I32 //< what running an operand earlier or later than written could change
    fixed = 0 //< nothing: a literal, a constant, an immutable binding, a fixed address
    reads = 1 //< what it reads: memory a call could write
    acts = 2 //< what happens: a call, a check that can stop the program, or work Lower hoists

impl Order_class
    fn max(r: Self, other: Order_class): Order_class //< the later of the two in the order above
        return r if I32::r >= I32::other else other

struct Operand_slot //< one operand, named by its parent and its position there
    parent: Ast_node$@
    idx: Sz
    by_address: Bool //< whether it is a place the consumer reads through its address

struct Operand_order //< the operands of one expression, in the order the source writes them
    slots: List<|Operand_slot|>

impl Operand_order: Owned {}

impl Operand_order
    fn new(): Operand_order
        return Operand_order::{ .slots = List<|Operand_slot|>.new(null) }
    fn free(r: Self$@)
        r.slots.free()

    fn add(r: Self$@, parent: Ast_node$@, idx: Sz, by_address: Bool)
        if parent != null && idx < parent.children.len
            r.slots
                .push(Operand_slot::{ .parent = parent, .idx = idx, .by_address = by_address })

    fn add_args(r: Self$@, args: Ast_node$@) //<
        //< every argument of an `expr_args`, the commas skipped
        if args == null || args.kind_id != .k_expr_args
            return
        for i in Range.asc(args.children.len)
            if !args.get_child(i).is_literal(",")
                r.add(args, i, false)

    fn apply(r: Self$@, lctx: Lowering_ctx$@) //<
        //< It moves into a temporary each operand that C could run on the wrong side of another
        //<
        //< That is an operand that is not `fixed`, with a later one that acts, or acting itself
        //< with a later one that is not `fixed`. It is lowered as it moves, so the statements it
        //< hoists keep their place in the order; the rest are lowered later by the caller, where
        //< they stand.
        if !lctx.in_fn_body || r.slots.len < 2
            return
        $classes: = List<|Order_class|>.new(null)
        defer classes.free()
        for s in r.slots
            classes.push(s.operand_class(lctx))
        $moves: = List<|Bool|>.new(null)
        defer moves.free()
        $acts_after: = false
        $varies_after: = false
        for $i: = r.slots.len; i > 0; i -= 1
            cls: = classes.get(i - 1)
            moves.push(cls != .fixed && (acts_after || (cls == .acts && varies_after)))
            acts_after = acts_after || cls == .acts
            varies_after = varies_after || cls != .fixed
        for i in Range.asc(r.slots.len)
            if !moves.get(r.slots.len - 1 - i)
                continue
            s: = r.slots.get(i)
            node: = s.parent.get_child(s.idx)
            moved: =
                (node.hoist_address(lctx) if s.reads_address(lctx)
                else node.hoist_complex_expr(lctx, true))
            s.parent.set_child(s.idx, moved)

impl Operand_slot
    fn reads_address(r: Self, lctx: Lowering_ctx$@): Bool //<
        //< Whether the operand is a place its consumer reaches through its address
        //<
        //< Then only the address is fixed early; what lies there is read when the consumer runs.
        node: = r.parent.get_child(r.idx)
        return r.by_address && node.is_place_expr() &&
            !lctx.sema.env.is_pointer(node.type_id)

    fn operand_class(r: Self, lctx: Lowering_ctx$@): Order_class
        node: = r.parent.get_child(r.idx)
        if r.reads_address(lctx) && node.has_fixed_address(lctx, 0)
            return .fixed
        return node.order_class(lctx, 0)

impl Ast_node
    fn order_class(r: Self$@, lctx: Lowering_ctx$@, depth: Sz): Order_class //<
        //< What running this expression at another point of its statement could change
        //<
        //< Caution: **Count everything Lower moves into statements as `acts`** (`&&`, a
        //< conditional, `catch`, `?`, a user operator): it already runs ahead of the expression
        //< around it.
        if r == null
            return .fixed
        if depth >= max_order_depth
            return .acts
        switch r.kind_id case .k_integer, .k_float, .k_bool, .k_char, .k_string, .k_null,
            .k_literal, .k_keyword, .k_empty, .k_type_expr, .k_type_path, .k_generic_path,
            .k_expr_sizeof, .k_expr_offsetof, .k_enum_init, .k_implicit_enum
            return .fixed
        case .k_identifier, .k_expr_path
            return r.binding_order_class()
        case .k_method_access, .k_generic_method, .k_enum_init_call, .k_expr_catch_chain,
            .k_expr_catch, .k_expr_ternary, .k_expr_fn_lit, .k_string_interp
            return .acts
        case .k_expr
            op: = r.safe_get_child(1)
            if r.def_node.is_fn_decl() || op == null || op.text.equals("&&") ||
                op.text.equals("||")
                return .acts
            // A divisor or a shift amount is checked at run time unless translation already did.
            checked: =
                op.text.equals("/") || op.text.equals("%") || op.text.equals("<<") ||
                op.text.equals(">>")
            if checked && !r.safe_get_child(2).is_translation_constant(depth + 1)
                return .acts
        case .k_expr_unary, .k_expr_cast
            if r.def_node.is_fn_decl()
                return .acts
        case .k_expr_postfix
            return r.postfix_order_class(lctx, depth)
        default {}
        if r.children.len == 0
            return .reads
        $cls: = Order_class.fixed
        for child in r.children
            cls = cls.max(child.order_class(lctx, depth + 1))
        return cls

    priv fn postfix_order_class(r: Self$@, lctx: Lowering_ctx$@, depth: Sz): Order_class
        op: = r.get_postfix_op()
        recv: = r.get_postfix_receiver()
        op_text: = op.text if op != null else ""
        // A call, a `?` and a subscript (its bounds check stops the program) act.
        if op_text.equals("(") || op_text.equals("?") || op_text.equals("[") ||
            r.def_node.is_fn_decl()
            return .acts
        if op_text.equals("@")
            if recv.has_fixed_address(lctx, depth + 1)
                return .fixed
            return recv.order_class(lctx, depth + 1)
        inner: = recv.order_class(lctx, depth + 1)
        // Through a pointer, the memory read is one a call can write, whatever the pointer's
        // binding.
        if op_text.equals("$") ||
            (op_text.equals(".") && lctx.sema.env.is_pointer(recv.type_id))
            return inner.max(.reads)
        return inner

    priv fn is_translation_constant(r: Self$@, depth: Sz): Bool //<
        //< Whether translation knows the value (and has refused a zero divisor or a wide shift)
        //<
        if r == null || depth >= max_order_depth
            return false
        switch r.kind_id case .k_integer, .k_char, .k_expr_sizeof, .k_expr_offsetof
            return true
        case .k_identifier, .k_expr_path
            d: = r.def_node
            return d != null && d.kind_id == .k_decl_const
        case .k_expr_primary
            return r.get_primary_inner_expr().is_translation_constant(depth + 1)
        case .k_expr_postfix
            op: = r.get_postfix_op()
            return op != null && op.text.equals("::") && !r.def_node.is_fn_decl() &&
                r.get_postfix_receiver().is_translation_constant(depth + 1)
        default
            return false

    priv fn binding_order_class(r: Self$@): Order_class //<
        //< A name: `fixed` for a constant, a function, a variant or an immutable binding
        d: = r.def_node
        if d == null || d.sym_ptr == null
            return .reads
        sym: = Sema_symbol$@::d.sym_ptr
        switch sym.kind case .variable
            return .reads if sym.flags.is_mut else .fixed
        default
            return .fixed

    fn names_variable(r: Self$@): Bool //<
        //< whether the name is a variable's (a callee held as a value)
        d: = r.def_node
        if d == null || d.sym_ptr == null
            return false
        sym: = Sema_symbol$@::d.sym_ptr
        switch sym.kind case .variable
            return true
        default
            return false

    fn has_fixed_address(r: Self$@, lctx: Lowering_ctx$@, depth: Sz): Bool //<
        //< Whether the place's address is the same wherever in the statement it is taken
        //<
        //< A name, and a field of a place with a fixed address reached without a pointer.
        if r == null || depth >= max_order_depth
            return false
        if r.is_path_or_ident()
            return true
        if r.kind_id == .k_expr_primary
            return r.get_primary_inner_expr().has_fixed_address(lctx, depth + 1)
        if r.kind_id == .k_expr_postfix
            op: = r.get_postfix_op()
            recv: = r.get_postfix_receiver()
            if op != null && op.text.equals(".") &&
                !lctx.sema.env.is_pointer(recv.type_id)
                return recv.has_fixed_address(lctx, depth + 1)
        return false

    priv fn hoist_address(r: Self$@, lctx: Lowering_ctx$@): Ast_node$@ //<
        //< It takes the place's address into a temporary and returns `<temporary>$` in its stead
        //<
        //< The place is still read or written where it stands; only the address is fixed earlier.
        loc: = r.loc
        ptr_id: = lctx.sema.env.make_ptr(r.type_id)
        addr: = Ast_node.new(.k_expr_postfix, "@", loc).with_type(ptr_id).add_child(r)
            .add_child(Ast_node.new(.k_literal, "@", loc))
        tmp: = addr.hoist_complex_expr(lctx, true)
        return Ast_node.new(.k_expr_postfix, "$", loc).with_type(r.type_id).add_child(tmp)
            .add_child(Ast_node.new(.k_literal, "$", loc))

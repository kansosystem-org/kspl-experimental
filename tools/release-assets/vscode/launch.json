{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶ Debug Current KSPL File",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "windows": {
                "program": "${fileDirname}/${fileBasenameNoExtension}.exe"
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "kanso-build-current-file",
            "initCommands": [
                "command script import ${workspaceFolder}/kspl_lldb.py"
            ]
        }
    ]
}

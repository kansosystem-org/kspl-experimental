// The build task that comes with the release zip (it does not depend on the Makefile), for
// opening the unpacked folder in VS Code as it stands and building and debugging with
// F5 / Ctrl+Shift+B.
//
// `ksplc build` writes the C and has clang (or the compiler `CC` names) compile and link it, with
// the libraries the platform and the program need, so none is written here. `-O0` keeps the
// program as written for the debugger; `-g` comes with ksplc's own flags.
// Caution: **The output is what launch.json's `program` starts**, or F5 starts the last one built.
//
// **ksplc prints a file's path as it was given**: relative for the file built here, absolute
// for a file of a `std/` elsewhere. So `autoDetect` reads each path against the folder, and an
// absolute one as it stands.
// Caution: **Capture `info`, not `information`.** VS Code knows only `error`, `warning`, `info`
// and `hint`, and turns any other word into an error. `[a-z]*` takes the rest of the word.
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kanso-build-current-file",
            "type": "shell",
            "command": "${workspaceFolder}/ksplc",
            "args": [
                "build",
                "--cflags=-O0",
                "${relativeFile}",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "windows": {
                "command": "${workspaceFolder}/ksplc.exe",
                "args": [
                    "build",
                    "--cflags=-O0",
                    "${relativeFile}",
                    "${fileDirname}/${fileBasenameNoExtension}.exe"
                ]
            },
            "problemMatcher": {
                "owner": "kspl",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning|info|hint)[a-z]*:\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}

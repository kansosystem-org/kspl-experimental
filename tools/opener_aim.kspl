//< The openers' rules: the URL, the page handing it on, the note, a workspace and its port
//< **There is no child process and no network here** (those are in `tools/opener.kspl` and the
//< openers, `tools/ksmd_open.kspl` and `tools/ksagent_chat.kspl`). Each opener names what it opens
//< in an `App`. So a test can confirm from the paths and the files written alone that
//< the right path is opened (`tools/tests/page_test.kspl`, `tools/tests/ksmd_aim_test.kspl`). It
//< can also confirm that the token stays off every command line. The reasons are "Opening a
//< `.ksmd` document" in `tools/docs/DESIGN-tools.md`.
//< Caution: **Do not add more places that know the URL's format**: the opener, its make targets
//< and the file associations go through these files.
import "std/chars"
import "std/fs"
import "std/mem" { Arena, dealloc }
import "std/str" { Str_builder }
import "std/strnum"
import "std/sys"
import "std/url" as url_text

struct App //< what one opener opens, and where its runs keep their files
    name: U8[] //< the application's name, in messages and the handed page's title
    files: U8[] //< how every file its runs leave in `tmp/` starts: the note, the lock, the logs
        //< **One per opener**, so each keeps its own note: a ksmd server and a chat server for one
        //< folder serve different pages, and neither may be reused for the other.
    built: U8[] //< the folder beside the server that the page is built into (`OUT=`)
    page: U8[] //< the built page, inside `built`
        //< Caution: **Do not copy the page into the served folder.** Requiring "under the root"
        //< would copy a page of megabytes into the user's folder. kssrv returns the file named by
        //< `--page` for `/` ("Where it listens" in `docs/SPEC-local-server.md`).
    tip: U8[] //< one line on using the page, printed once it opens

const KSMD: App = App::{ .name = "ksmd", .files = "ksmd_open", .built = "ksmd",
    .page = "web/ksmd.html", .tip = "Ctrl+S saves, and this browser keeps a draft until then" } //<
        //< ksmd's editing page, where ksmd's make writes it

const KSAGENT: App = App::{ .name = "ksagent", .files = "ksagent_chat", .built = "ksagent",
    .page = "chat.html",
    .tip = "Enter asks; an answer shows as it is written, and its sources once checked" } //<
        //< ksagent's chat page, which the root's make copies beside the server

fn trim_end_sep(dir: U8[]): U8[] //< a folder without the separators after its last name
    //< Caution: **Compare folders without them**: `devel/` and `devel` are one folder. The note
    //< matched on the string would start two servers for it, or find none to stop. A root (`/`,
    //< `C:\`) keeps its own.
    $at: = dir
    root: = sys.root_len(dir)
    for at.len > root && sys.is_path_sep(at[at.len - 1])
        at = at.sub(0, at.len - 1)
    return at

fn parent_of(dir: U8[]): U8[] //< the folder one above
    //< With nothing further up it returns itself, so the caller stops (above `ksmd` is `.`, above
    //< `.` is nothing).
    if dir.len == 0 || dir.equals(".")
        return ""
    parent: = sys.get_dir_name(dir)
    return "." if parent.len == 0 else parent

priv const MAX_CLIMB: Sz = 32 //< the cap on how many folders up `marked_above` looks
    //< Caution: **Do not climb without limit** (it must stop even at `/`).

fn marked_above(from: U8[], mark: U8[], arena: Arena$@): U8[] //<
    //< The nearest folder at or above `from` that holds `mark`, a file or a folder
    //< **Empty where there is none** within `MAX_CLIMB` folders. It climbs by the path's text, so
    //< `from` holds no `..`.
    $at: U8[] = from
    for _step in Range.asc(MAX_CLIMB)
        if at.len == 0
            break
        if fs.exists(fs.join(at, mark, arena))
            return at
        up: = parent_of(at)
        if up.equals(at)
            break
        at = up
    return ""

fn doc_under(root: U8[], path: U8[]): U8[] //< the document's path relative to the served folder
    //< Caution: **Drop the served folder's part**, or the server looks for one more folder of that
    //< name under the root (a 404). A path already relative to the root (`--root=.`) stays as it
    //< is.
    if root.len == 0 || root.equals(".") || !path.starts_with(root, 0)
        return path
    $rest: U8[] = path.sub_from(root.len)
    for rest.len > 0 && (rest[0] == '/' || rest[0] == '\\')
        rest = rest.sub_from(1)
    return path if rest.len == 0 else rest

fn url_in_log(log: U8[]): U8[] //< the URL from the line kssrv printed, empty where there is none
    // Caution: **The level sits in the middle** (`kssrv: I: open `). Without the `I: `, the marker
    // matches nothing. The opener then waits 30 seconds for a server that is already up
    // (`kssrv/main.kspl` warns of such a reader where it prints the line).
    mark: = "kssrv: I: open "
    if at: = log.find_str(mark)
        rest: = log.sub_from(at + mark.len)
        return rest.sub(0, rest.find_char('\n').unwrap_or(rest.len))
    return ""

fn token_in_url(url: U8[]): U8[] //<
    //< the token from the URL's fragment (`#t=…`), empty where there is none
    mark: = "#t="
    if at: = url.find_str(mark)
        return url.sub_from(at + mark.len)
    return ""

fn without_token(url: U8[]): U8[] //< the URL with its fragment, the part holding the token, cut off
    //< **What can be put out where others read it**: it names the page and opens no file.
    return url.sub(0, url.find_char('#').unwrap_or(url.len))

fn port_in_url(url: U8[]): U8[] //<
    //< the port to wait on, from the URL, empty where there is none
    //< Caution: **Look only after the `://` and before the first `/`** (`http:` and the fragment
    //< can hold a `:` too).
    mark: = "://"
    if at: = url.find_str(mark)
        rest: = url.sub_from(at + mark.len)
        host: = rest.sub(0, rest.find_char('/').unwrap_or(rest.len))
        if cut: = host.find_char(':')
            return host.sub_from(cut + 1)
    return ""

fn port_num(at: U8[]): I32 //< a port string as a number, 0 where it is not a valid port
    //< 0 cannot be waited on, so this refuses up front what would otherwise cost 30 seconds of
    //< waiting for a server that never comes up.
    n: = at.to_i64() catch
        return 0
    return 0 if n < 1I64 || n > 65535I64 else I32::n

fn url_for( //< the URL to open, with the document to open added
    //< **Put it before the fragment (`#`)**, or it becomes part of the token.
    //< Caution: **Escape every byte but the unreserved ones and the separator.** `?doc=` is a query
    //< the page decodes. So a name escaped only in part opens another file, and Save then
    //< overwrites it. `a+b` reads as `a b`, `notes%2Fx` as `notes/x`, `x&read=1` adds a setting.
    url: U8[], //< the URL kssrv printed, fragment included
    doc: U8[], //< the document to open, relative to the served folder
    win: Bool, //< only when this is set is `\` turned into `/`
    text: Str_builder$@, //< where the URL is built
): U8[]
    head: = without_token(url)
    tail: = url.sub_from(head.len) // with no fragment, the tail is empty
    text.s(head).s("?doc=")
    $start: Sz = 0
    for i in Range.asc(doc.len + 1)
        at_sep: = i < doc.len && (doc[i] == '/' || (doc[i] == '\\' && win))
        if i < doc.len && !at_sep
            continue
        piece: = url_text.encode(doc.sub(start, i - start), null)
        text.s(piece)
        dealloc(Void$@::piece.ptr)
        if at_sep
            text.c('/')
        start = i + 1
    text.s(tail)
    return text.slice()

priv const PAGE_EXT: U8[] = ".html" //< the end of a handed page's name

const PAGE_KEEP_S: I64 = 600 //< how long a handed page is kept [s]
    //< **Long enough for a cold browser to start and read it**; the next run removes it after that
    //< (`sweep_pages`).

fn page_text(open_url: U8[], app: App, text: Str_builder$@): U8[] //<
    //< The page handed to the browser in place of the URL, which moves on to the URL
    //< **The browser is handed this page's path, never the URL.** A command line is open to every
    //< user on the machine (`ps`), and the URL holds the token. The page moves on at once
    //< (`refresh`) and offers the link where a browser does not. The fragment goes along, so the
    //< page reads the token as it does from a URL typed by hand.
    text.s("<!doctype html>\n<meta charset=\"utf-8\">\n")
    text.s("<meta http-equiv=\"refresh\" content=\"0;url=")
    attr_into(text, open_url)
    text.s("\">\n<title>").s(app.name).s("</title>\n<a href=\"")
    attr_into(text, open_url)
    text.s("\">open ").s(app.name).s("</a>\n")
    return text.slice()

priv fn attr_into(text: Str_builder$@, s: U8[]) //< writes s as a quoted attribute's value
    for c in s
        if c == '&'
            text.s("&amp;")
        else if c == '"'
            text.s("&quot;")
        else if c == '<'
            text.s("&lt;")
        else if c == '>'
            text.s("&gt;")
        else
            text.c(c)

fn write_page( //< writes the page for the URL, readable by its owner alone, and returns its path
    //< **A name of its own each time** (`fs.write_unique`). Otherwise two documents opened at once
    //< (several chosen and opened together) would each hand the browser the other's page.
    open_url: U8[], //< the URL to move on to, token included
    app: App, //< what is opened: its name titles the page and starts the file's name
    dir: U8[], //< the folder it goes in
    arena: Arena$@, //< where the path goes
): U8[]!fs.Fs_error
    defer $text: = Str_builder()
    return fs.write_unique(dir, page_prefix(app, arena), PAGE_EXT,
        page_text(open_url, app, text@), arena)

priv fn page_prefix(app: App, arena: Arena$@): U8[] //< how a handed page's name starts
    return arena.text().s(app.files).c('-').take()

fn browser_argv( //< the command that starts the browser on a page
    //< **It takes the page's path, not the URL** (the reason is at `page_text`).
    //< **On Windows the separator becomes `\`**, the one `explorer.exe` reads as a path's;
    //< `fs.join` writes `/`.
    tool: U8[], //< the tool that starts the browser
    page: U8[], //< the path `write_page` returned
    win: Bool, //< only when this is set is `/` turned into `\`
    arena: Arena$@, //< where a turned path goes
): U8[][2]
    if !win
        return U8[][2]::{ tool, page }
    turned: = arena.text()
    for c in page
        turned.c('\\' if c == '/' else c)
    return U8[][2]::{ tool, turned.take() }

fn sweep_pages(dir: U8[], app: App, now: I64, arena: Arena$@) //<
    //< Removes the pages the opener handed long enough ago
    //< **A page is needed only until the browser has read it**, and nothing tells when that was:
    //< the opener exits once the browser is started. So each run removes the pages older than
    //< `PAGE_KEEP_S`. Only names this file gives are touched: another tool can share the folder.
    names: = fs.read_dir(dir, arena) catch
        return
    prefix: = page_prefix(app, arena)
    for name in names
        if !name.starts_with(prefix) || !name.ends_with(PAGE_EXT)
            continue
        path: = fs.join(dir, name, arena)
        info: = fs.stat(path) catch
            continue
        if now - info.mtime > PAGE_KEEP_S
            fs.remove_path(path) catch {}

fn write_owned(path: U8[], data: U8[]): Void!fs.Fs_error //<
    //< Replaces a file with one only its owner may read
    //< **The note and the log hold the token as the page does**, so they are written the same way.
    //< Caution: **Replace it, never write in place** (`fs.replace_file`). A file opened in place
    //< keeps the mode it had. A crash partway leaves a note no search can read.
    fs.replace_file(path, data, .owner_only)!

fn state_count(body: U8[]): Sz //< how many records the note holds
    //< A record is two lines, "the URL to open" then "the folder being served", newest first.
    //< **Do not keep only one**: each folder has its own server. The two lines need no other
    //< separator, so a folder name with a space in it does not split.
    $n: Sz = 0
    for state_line(body, n).len > 0
        n += 1
    return n / 2

fn state_record(body: U8[], i: Sz): U8[][2] //< the i-th record, both halves empty where none
    return U8[][2]::{ state_line(body, i * 2), state_line(body, i * 2 + 1) }

fn state_text( //< the note, rebuilt
    //< The new server goes first. An old record for the same folder is dropped, or the search
    //< connects to a dead server first. **Store the URL unchanged** (the format stays here).
    //< Caution: **Drop a record when its server stops answering, never at a count.** Cut at a
    //< count, the note drops a running server, which `--list` and `--stop-all` then cannot reach
    //< ("Reusing a server" in `tools/docs/DESIGN-tools.md`).
    url: U8[], //< the URL the new server printed
    root: U8[], //< the folder it serves
    had: U8[], //< the note as it stood
    answers: Callable1<|U8[], Bool|>, //< whether the server a record's URL names still answers
    text: Str_builder$@, //< where the note is built
): U8[]
    state_put(text, url, root)
    count: = state_count(had)
    for i in Range.asc(count)
        one: = state_record(had, i)
        if one[1].equals(root) || !on_loopback(one[0]) || !answers.call(one[0])
            continue
        state_put(text, one[0], one[1])
    return text.slice()

fn state_put(text: Str_builder$@, url: U8[], root: U8[]) //< adds one record to the end of a note
    //< **The one place that writes a record**, so `state_record` reads back what every writer
    //< wrote.
    //< Caution: **Write nothing for a value holding a line break** (`fits_note`): a folder named
    //< with one would add a record of its own choosing, a URL to some other server included.
    if !fits_note(url) || !fits_note(root)
        return
    text.s(url).c('\n').s(root).c('\n')

fn fits_note(value: U8[]): Bool //< whether a value can stand as one line of the note
    return value.find_char('\n').is_none() && value.find_char('\r').is_none()

fn on_loopback(url: U8[]): Bool //< whether the URL names a server on this machine, 127.0.0.1
    //< kssrv's URL always does; a record naming another host was not written by this tool.
    return url.starts_with("http://127.0.0.1:")

priv fn state_line(body: U8[], i: Sz): U8[] //< the note's i-th line
    //< **Empty where the note has fewer lines** (a note cut off partway can still be read).
    $from: Sz = 0
    for $n: Sz = 0; n <= i; n += 1
        switch body.sub_from(from).find_char('\n')
        case .none
            return body.sub_from(from) if n == i else ""
        case .some(end)
            if n == i
                return body.sub(from, end)
            from += end + 1
    return ""

// ==========================================
// The workspace a document opens in, and its port
// ==========================================

const MARK: U8[] = ".ksmd-workspace" //< the file that makes its folder a workspace
    //< **The nearest folder at or above the document that holds it is the workspace.** Without
    //< one, the document's own folder is. Its content is not read, so it can be empty.

const PORT_BASE: I32 = 20000 //< the lowest port a workspace gets
const PORT_SPAN: I32 = 10000 //< how many ports from `PORT_BASE` workspaces spread over
    //< **20000 to 29999 lies below the ports each OS hands out to outgoing connections** (from
    //< 32768 on Linux, 49152 on Windows and macOS), so a connection rarely holds one by chance.

fn home_port(root: U8[]): I32 //< the port a workspace's server starts from, the same every run
    //< FNV-1a over the folder's absolute path, spread over `PORT_SPAN` ports.
    //< Caution: **Do not change the formula.** The browser keeps drafts per address, port included,
    //< so a new formula hides every draft held before. `tools/tests/ksmd_aim_test.kspl` pins
    //< values.
    $h: U64 = 14695981039346656037U64
    for c in root
        h = h ^ U64::c
        h = h * 1099511628211U64
    return PORT_BASE + I32::(h % U64::PORT_SPAN)

fn is_ksmd(path: U8[]): Bool //< whether the file's name ends in `.ksmd`, in any case
    //< **Any case**: Windows and Linux's MIME globs both hand `NOTES.KSMD` to the association.
    ext: = ".ksmd"
    return path.len >= ext.len &&
        path.sub_from(path.len - ext.len).equals_ignore_case(ext)

fn plain(path: U8[], arena: Arena$@): U8[] //<
    //< An absolute path without `.` segments or doubled separators; empty where it holds a `..`
    //< **The workspace and its port are found from the text**, so one folder must have one
    //< spelling: `/a/./b` and `/a//b` are `/a/b`. Caution: **Do not fold a `..` away.** Behind a
    //< link, `a/link/..` is another folder than `a`, so the file opened would not be the one named.
    //< **A drive letter is upper-cased** (`c:\notes` is `C:\notes`): Windows ignores its case. Only
    //< Windows reads a drive as a root (`sys.root_len`), so elsewhere `c:` stays a name.
    root: = sys.root_len(path)
    out: = arena.text()
    if root >= 2 && path[1] == ':'
        drive: = path[0]
        out.c(drive - ('a' - 'A') if drive.is_lower() else drive).s(path.sub(1, root - 1))
    else
        out.s(path.sub(0, root))
    $kept: Sz = 0
    $at: Sz = root
    for at < path.len
        end: = sys.segment_end(path, at)
        piece: = path.sub(at, end - at)
        if piece.equals("..")
            return ""
        if piece.len > 0 && !piece.equals(".")
            if kept > 0
                out.c(path[at - 1]) // the separator as written before it
            out.s(piece)
            kept += 1
        at = end + 1
    return out.take()

fn under(root: U8[], path: U8[]): Bool //< whether `path` lies inside the folder `root`
    //< Both are `plain`. **A shared start is not enough**: `/ws2/a.ksmd` is not under `/ws`.
    if !path.starts_with(root) || path.len <= root.len
        return false
    return sys.is_path_sep(root[root.len - 1]) || sys.is_path_sep(path[root.len])

fn workspace_of(folder: U8[], arena: Arena$@): U8[] //< the workspace of a document in `folder`
    //< The nearest folder at or above it that holds `MARK`, else `folder` itself.
    marked: = marked_above(folder, MARK, arena)
    return folder if marked.len == 0 else marked

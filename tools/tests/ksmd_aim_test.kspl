//< ksmd's opener's rules: the workspace, its port, and which files and paths it takes
//< A mistake here breaks nothing visible at once. A port that moves between runs hides the drafts
//< held before; a workspace chosen too narrow refuses an include that climbs with `../`. So each
//< rule is checked alone (`tools/opener_aim.kspl`); `tools/tests/ksmd_launch.kspl` runs the
//< launcher. The rules a table can hold are rows of `tools/docs/SPEC-opener-aim.ksmd`, which
//< `tools/tests/aim_rows_test.kspl` checks; this file holds the rest.
import "std/ds"
import "std/fs"
import "std/mem" { Arena }
import "std/sys"
import "std/verdict"
import "tools/opener_aim" as aim

priv const SCRATCH: U8[] = "out/tmp/kspl_test_ksmd_aim" //< where the checks that write files work

fn test_a_drive_letter_is_upper_cased(arena: Arena$@) //< on Windows alone; elsewhere `c:` is a name
    //< The other rules of `aim.plain` are rows of `tools/docs/SPEC-opener-aim.ksmd`. This one
    //< answers by the OS the test runs on, which a row cannot name.
    verdict.start("[tools/opener_aim] a drive letter's case test...")
    // **Windows ignores a drive letter's case**, so `c:\notes` and `C:\notes` would start two
    // servers. Elsewhere `c:` is an ordinary name, kept as written.
    want: = "C:\\notes" if sys.is_windows() else "c:\\notes"
    assert(aim.plain("c:\\notes\\", arena).equals(want), "a drive letter is upper-cased on Windows")
    verdict.pass("a drive letter is upper-cased on Windows, and kept as written elsewhere.")

fn test_the_nearest_marked_folder_is_the_workspace(arena: Arena$@) //<
    //< A marked folder above wins over the document's own; with none, its own folder is chosen
    verdict.start("[tools/opener_aim] choosing the workspace test...")
    fs.mkdir_all(SCRATCH) catch panic("cannot create the scratch folder")
    here: = fs.mkdir_unique(SCRATCH, "ws_", arena) catch panic("cannot create the working folder")
    top: = fs.absolute(here, arena) catch panic("the working folder has a full path")
    deep: = fs.join(top, "notes/parts", arena)
    inner: = fs.join(top, "notes/parts/own", arena)
    fs.mkdir_all(inner) catch panic("cannot create the folders")
    // A document whose folders hold no mark is its own folder's. No mark stands above `out/tmp`.
    assert(aim.workspace_of(deep, arena).equals(deep), "with no mark, its folder is chosen")
    fs.write_tree(top, U8[][]::{ aim.MARK }, U8[][]::{ "" }, arena)
        catch panic("cannot write the mark")
    assert(aim.workspace_of(deep, arena).equals(top), "the marked folder above is chosen")
    // **The nearest mark wins**, so a folder can be a workspace inside a larger one.
    fs.write_tree(inner, U8[][]::{ aim.MARK }, U8[][]::{ "" }, arena)
        catch panic("cannot write the second mark")
    assert(aim.workspace_of(inner, arena).equals(inner), "the nearest mark is chosen")
    assert(aim.workspace_of(deep, arena).equals(top), "a mark below the document counts not")
    fs.remove_path(fs.join(inner, aim.MARK, arena)) catch {}
    fs.remove_path(fs.join(top, aim.MARK, arena)) catch {}
    for one in U8[][]::{ inner, deep, fs.join(top, "notes", arena), top }
        fs.remove_path(one) catch {}
    verdict.pass("the nearest folder holding .ksmd-workspace is chosen, else the document's own.")

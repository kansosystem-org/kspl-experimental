//< The repository statistics' file classification, and how the CI's sets are dealt out
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/sys"
import "std/verdict"
import "tools/ci_gates" + { Outcome }
import "tools/repo_stat_path" as path_kind + { Opening }

// ==========================================
// Tests the functions that classify files by their path alone (`tools/repo_stat_path.kspl`).
//
// It is tested because **a mistake here breaks nothing visible.** A wrong skip, generated-file
// test or comment mark each gives a plausible number. Nothing shows the misreading.
// Caution: Test each case that matches together with one that does not. With only one side,
// "always true" and "always false" both pass.
// ==========================================

fn test_the_files_listed(arena: Arena$@) //< git's two lists become one sorted list
    verdict.start("[tools/repo_stat] the files to count test...")
    got: = path_kind.listed("README.md\nksplc/main.kspl\nstd/io.kspl\n", "ksplc/usage.kspl\n\n",
        arena)
    assert(got.len == 4, "every listed path, and no empty line")
    // Caution: **An untracked file falls among its folder's files**, or its folder's subtotal is
    // written twice.
    assert(got.get(0).equals("README.md") && got.get(1).equals("ksplc/main.kspl") &&
        got.get(2).equals("ksplc/usage.kspl") && got.get(3).equals("std/io.kspl"), "sorted as one")
    assert(path_kind.listed("", "", arena).len == 0, "nothing listed counts nothing")
    verdict.pass("the tracked and the untracked are counted, sorted together.")

fn test_which_file_is_generated() //< the seed is the generated one
    verdict.start("[tools/repo_stat] telling a generated file apart test...")
    assert(path_kind.is_generated("ksplc/seed.c"), "the seed is generated")
    // Caution: **Do not catch hand-written C.** Judged by the extension or a partial match, the
    // hand-written `.c` files drop out of the count.
    assert(!path_kind.is_generated("ksplc/gen/c/root.kspl"),
        "hand-written code inside ksplc is not generated")
    assert(!path_kind.is_generated("ksplc/gen/runtime/core.c"), "another .c is not generated")
    assert(!path_kind.is_generated("seed.c"), "the same name in a different place is not generated")
    verdict.pass("the one thing taken for generated is `ksplc/seed.c`.")

fn test_the_comment_marker() //< the mark is per extension, empty where that one has none
    verdict.start("[tools/repo_stat] the line-comment mark test...")
    assert(path_kind.comment_marker("a/b.kspl").equals("//"), ".kspl is //")
    assert(path_kind.comment_marker("a/b.kspl").equals("//"), ".kspl is //")
    assert(path_kind.comment_marker("a/b.c").equals("//"), ".c is //")
    assert(path_kind.comment_marker("a/b.mjs").equals("//"), ".mjs is //")
    assert(path_kind.comment_marker("a/b.py").equals("#"), ".py is #")
    assert(path_kind.comment_marker("mk/test.mk").equals("#"), ".mk is #")
    assert(path_kind.comment_marker("Makefile").equals("#"), "Makefile is #")
    // Caution: **`.kspl` is not on the `#` side** (the reason is at `path_kind.comment_marker`).
    assert(!path_kind.comment_marker("a/b.kspl").equals("#"), ".kspl is not #")
    // An extension without a line mark gets an empty one (`.md` has no comments, `.ld` only `/*
    // */`).
    assert(path_kind.comment_marker("README.md").len == 0, ".md holds no mark")
    assert(path_kind.comment_marker("ksos/port/cortex_m/link.ld").len == 0, ".ld holds no mark")
    verdict.pass("the mark is chosen per extension, and one with none returns empty.")

fn test_the_block_marks() //< a block comment's ends are per extension, empty where it has none
    verdict.start("[tools/repo_stat] the block-comment ends test...")
    c: = path_kind.block_marks("a/b.c")
    assert(c.open.equals("/*") && c.close.equals("*/"), ".c's block is /* */")
    css: = path_kind.block_marks("ksmd/port/web/page.css")
    assert(css.open.equals("/*") && css.close.equals("*/"), ".css's block is /* */")
    html: = path_kind.block_marks("ksmd/port/web/page.html")
    assert(html.open.equals("<!--") && html.close.equals("-->"), ".html's block is <!-- -->")
    // **KSPL has no block comment** ("Comments" in `../../docs/SPEC-programming-language.md`).
    assert(path_kind.block_marks("a/b.kspl").open.len == 0, ".kspl holds no block")
    assert(path_kind.block_marks("Makefile").open.len == 0, "Makefile holds no block")
    verdict.pass("the block's ends are chosen per extension, and one with none returns empty.")

priv fn opened(path: U8[], line: U8[], open: Bool): Opening //< one line read by path's marks
    return path_kind.opening(line, path_kind.comment_marker(path), path_kind.block_marks(path), open)

fn test_where_a_comment_opens() //< where a line's comment text starts, per kind of file
    verdict.start("[tools/repo_stat] where a comment opens test...")
    // **A mark inside a string and a language's own use of the sign (`#cfg`) are the cases that
    // slip through**, so each is tested both ways.
    assert(opened("a.kspl", "  x = 1 // y", false).at == 10, "a comment's text follows its mark")
    assert(opened("a.kspl", ".s(\"// heading\")", false).at == -1,
        "a mark in a string is no comment")
    assert(opened("a.kspl", "#cfg(llvm)", false).at == -1, "KSPL's # is an attribute's sign")
    assert(opened("Makefile", "\t@# y", false).at == 3, "a recipe's shell comment opens at its #")
    assert(opened("a.mk", "X := 1 ## y", false).at == 9, "a doubled mark is passed whole")
    assert(opened("a.yml", "  run: echo '#' # y", false).at == 17, "a quoted # opens nothing")
    css: = opened("a.css", "/* y", false)
    assert(css.at == 2 && css.block && css.open, "a block left open runs on")
    shut: = opened("a.css", "   y */", true)
    assert(shut.at == 0 && !shut.open, "a block carried on from above shuts at its close")
    assert(opened("a.html", "<!-- y -->", false).at == 4, "an HTML comment's text follows <!--")
    c: = opened("a.c", "f(); /* y", false)
    assert(c.at == 7 && c.open, "a block opened after code runs on too")
    assert(opened("a.js", "g('**/out/**')", false).at == -1, "a glob in a string opens no block")
    verdict.pass("each kind's comment is read by its own marks, past what a string holds.")

fn test_the_extension_and_the_top_folder() //< the extension, and the top tier's folder name
    verdict.start("[tools/repo_stat] the extension and the top tier test...")
    assert(path_kind.ext_of("ksplc/base/core.kspl").equals(".kspl"),
        "the extension is from the dot on")
    assert(path_kind.ext_of("Makefile").equals("Makefile"), "with no dot it is the name itself")
    assert(path_kind.ext_of("a/b/Makefile").equals("Makefile"), "the same under a folder")
    // **Do not pick up a dot in a folder's name** (only after the last separator).
    assert(path_kind.ext_of("a.b/c").equals("c"), "a dot on the folder's side is not picked up")
    assert(path_kind.ext_of(".gitignore").equals(".gitignore"),
        "a leading dot is not made an extension")
    assert(path_kind.top_of("ksplc/base/core.kspl").equals("ksplc"),
        "the top tier is up to the first separator")
    assert(path_kind.top_of("Makefile").len == 0, "a file directly under the root is empty")
    verdict
        .pass("the extension is the dot after the last separator; the top tier runs to the first.")

fn test_the_role_of_a_file() //< functional, test, tooling or prose, from the path alone
    verdict.start("[tools/repo_stat] the role of a file test...")
    assert(path_kind.role_of("ksplc/sema/body/stmt.kspl") == .functional, "a compiler file ships")
    assert(path_kind.role_of("ksmd/port/web/page.css") == .functional,
        "a stylesheet with only a block mark ships")
    assert(path_kind.role_of("std/tests/io_test.kspl") == .test, "a file under tests/ is a test")
    assert(path_kind.role_of("tests/support/harness.kspl") == .test, "the top tests/ is a test")
    assert(path_kind.role_of("ksai/tests/tensor_test.kspl") == .test, "a *_test file is a test")
    // **Tests come before the folder**: `tools/tests/` checks the tools.
    assert(path_kind.role_of("tools/tests/repo_test.kspl") == .test, "tools/tests/ is a test")
    assert(path_kind.role_of("tools/ci.kspl") == .tooling, "tools/ is tooling")
    assert(path_kind.role_of("mk/test.mk") == .tooling, "a make file is tooling")
    assert(path_kind.role_of("ksos/Makefile") == .tooling, "a package's Makefile is tooling")
    assert(path_kind.role_of(".gitignore") == .tooling, "a file at the root is tooling")
    assert(path_kind.role_of("docs/SPEC-gates.md") == .prose, "a document is prose")
    assert(path_kind.role_of("ksmd/examples/notes.ksmd") == .prose, "data with no mark is prose")
    verdict.pass("each file's role is read from its path: tests first, then the folder.")

// ==========================================
// Tests how the CI's sets are named and dealt out, and the summary read back from a round
// (`tools/ci_gates.kspl`).
//
// It is tested because **a mistake here goes green.** A gate a set leaves out is never run. The
// summary is the only place a fallen or skipping gate is listed.
// ==========================================

priv fn named(name: U8[], arena: Arena$@): U8[] //< the set a name reads back as, or empty
    switch ci_gates.set_from(name, arena)
    case .some(s)
        return s.variant_name()
    case .none
        return ""

fn test_a_set_is_named_as_make_names_it(arena: Arena$@) //< `-` for `_`, and nothing else
    verdict.start("[tools/ci_gates] how a set is named test...")
    assert(named("ci-shard-core", arena).equals("ci_shard_core"), "a shard reads back")
    assert(named("ci", arena).equals("ci"), "a name with no dash reads back")
    // The variant's own spelling is not a target's, so it must not run a set.
    assert(named("ci_shard_core", arena).len == 0, "the variant's spelling is refused")
    assert(named("ci-shard-none", arena).len == 0, "a shard no job runs as a set is refused")
    for s in ci_gates.SET_ORDER
        back: = named(s.variant_name().replace("_", "-", arena), arena)
        assert(back.equals(s.variant_name()), "every set reads back from its own name")
    verdict.pass("a set is named as make names it, and only so.")

fn test_the_shards_part_ci() //< `ci` selects what the host runs natively
    verdict.start("[tools/ci_gates] how the gates are dealt out test...")
    for g in ci_gates.GATES
        core: = ci_gates.Set.ci_shard_core.runs(g)
        rest: = ci_gates.Set.ci_shard_rest.runs(g)
        linux: = ci_gates.Set.ci_shard_linux.runs(g)
        assert(ci_gates.Set.ci.runs(g) == (core || rest || linux),
            "Linux's ci runs the union of all three workflow sections")
        assert(!(core && rest) && !(core && linux) && !(rest && linux),
            "no gate is in more than one section")
        assert(ci_gates.Set.ci.runs(g, "win32") == (core || rest),
            "Windows' ci runs exactly the two shared sections")
        assert(ci_gates.Set.ci.runs(g, "darwin") == (core || rest),
            "macOS's ci runs exactly the two shared sections, with no container")
    verdict.pass("ci selects what each host runs natively: three sections on Linux, two elsewhere.")

// ==========================================
// Sample gate logs, each cut to a real round's shape, and the summary read back from them
// **What a reader needs is the line that failed the gate, last.** Each sample's cause sits among
// lines that look alike (expected SKIPs, a `pass` line saying "panic", make's other `***`).
// ==========================================

priv const WIN: U8[] = "win32" //< the platform the samples are judged for

priv const LOG_UNEXPECTED_SKIP: U8[] =
    """
pass extract-rest: kssrv builds and tests from a copy holding nothing else
SKIP extract-rest: kssrv's own tests: kssrv: a link inside the root cannot get outside: a link cannot be made with `ln -s` in this environment
SKIP extract-rest: kssrv's own tests: kssrv: a socket in the root is answered 404: Windows has no socket a path names
SKIP extract-ksplc: ksplc's own tests: broken-pipe: writing when nobody is left to read it: Windows has no SIGPIPE
RESULT: ALL PASS (3 skipped) -> kssrv's own tests, kssrv's own tests, ksplc's own tests
# TEST SUITES (half A) PASSED (5 suites)
"""

priv const LOG_LABEL: U8[] = //< a gate whose check's label names the word SKIP
    """
pass conventions: every SKIP reason the tree can print is held by a row
RESULT: ALL PASS
"""

priv const LOG_FAIL: U8[] =
    """
pass extract-ksplc: ksplc's suite cli passes from the copy
FAIL extract-ksplc: ksplc's suite spawn passes from the copy: FAIL spawn: a prompt to a terminal shows before the read: [harness] it could not start
pass spawn: panic: the output before the panic remains
pass conventions: every SKIP reason the tree can print is held by a row (68 reasons)
RESULT: SOME FAILED (1) -> ksplc's suite spawn passes from the copy
make[2]: *** [mk/test.mk:144: test-extract-ksplc] エラー 1
make[2]: *** 未完了のジョブを待っています....
"""

priv const LOG_PANIC: U8[] =
    """
FAIL extract-rest: std builds and tests from a copy holding nothing else: --- its last 4 lines ---
pass Sys: a crash is 139, a panic 134, exit(3) 3, and a child exiting -1 reads as finished.
pass Net: read_for ends at its timeout on a quiet peer, and reads what the peer sends.
panic: a write of 4 GiB should send a piece at std/tests/net_test:460
make: *** [Makefile:20: test] Error 134
"""

priv const LOG_UNREAD: U8[] =
    """
./out/ksplc_seed.exe ksplc/main.kspl out/stage1.c
clang -std=c99 -O0 -g -c out/stage1.c -o out/stage1.o
out/stage1.c:1234:5: error: use of undeclared identifier 'kspl_x'

1 error generated.
make: *** [Makefile:210: out/ksplc_stage1.exe] エラー 1
"""

priv const LOG_ARM: U8[] =
    """
#   SKIP: test-ksos-link arm-none-eabi-gcc was not found.
RESULT: SKIPPED (no ARM toolchain)
"""

priv fn gate_named(log: U8[]): ci_gates.Gate //< the table's row for a gate, by its log's name
    $at: Sz = 0
    for at < ci_gates.GATES.len && !ci_gates.GATES[at].log.equals(log)
        at += 1
    assert(at < ci_gates.GATES.len, "the samples name gates of the table")
    return ci_gates.GATES[at]

priv fn sample(log: U8[], text: U8[], ended: U8[], arena: Arena$@): Outcome //<
    //< What one sample gate left, judged for Windows
    j: = ci_gates.Judge::{ .platform = WIN, .relaxed = "" }
    return ci_gates.outcome_of(gate_named(log), text, ended, j@, arena)

priv fn summarised(outs: List<|Outcome|>@, arena: Arena$@): U8[] //< the screen's summary of them
    j: = ci_gates.Judge::{ .platform = WIN, .relaxed = "" }
    defer $b: = Str_builder()
    ci_gates.digest_plain(outs, 12I64, j@, b@)
    return arena.dup_str(b.slice())

priv fn after(text: U8[], first: U8[], then: U8[]): Bool //< whether `then` follows `first`
    switch text.find_str(first)
    case .some(at)
        return text.sub_from(at + first.len).find_str(then).is_some()
    case .none
        return false

fn test_a_green_round_stays_short(arena: Arena$@) //<
    //< a green round names no cause, counts its skips
    verdict.start("[tools/ci_gates] the summary of a green round test...")
    $outs: = List<|Outcome|>(arena)
    outs
        .push(sample("selfhost", "RESULT: ALL PASS (self-hosting, c backend)\n", "0 30\n", arena))
    outs.push(sample("link_abi", LOG_ARM, "0 5\n", arena))
    // A check's label may name the word: a line opening with `pass` is no skip.
    outs.push(sample("docs", LOG_LABEL, "0 1\n", arena))
    p: = summarised(outs@, arena)
    assert(p.find_str("#   selfhost       PASS 30s\n").is_some(), "a gate that passed is one line")
    assert(p.find_str("#   docs           PASS 1s\n").is_some(),
        "a pass line naming SKIP in its label counts as no skip")
    assert(p.find_str("#   link_abi       PASS 5s      2 SKIP lines\n").is_some(),
        "a skipping gate counts its SKIP lines on its own line")
    // Caution: **An expected SKIP line is not copied**: thirty of them bury the one that failed.
    assert(p.find_str("no ARM toolchain").is_none(), "an expected SKIP's text stays in its log")
    assert(p.find_str("why it failed").is_none() && p.find_str("UNEXPECTED").is_none(),
        "a green round names no cause")
    assert(p.ends_with("# gates invoked: 3 (0 FAIL, SKIP lines in 1), gate seconds: 36, -j12\n"),
        "the closing line counts them, and ends it")
    verdict.pass("a green round lists its gates and counts its skips, and names no cause.")

fn test_a_container_log_keeps_its_platform(arena: Arena$@) //<
    //< Linux-only logs copied back to Windows are judged for the platform that ran them
    text: = "SKIP case: Windows has no SIGPIPE\nRESULT: ALL PASS\n"
    native: = sample("suites_a", text, "0 3 win32\n", arena)
    linux: = sample("suites_a", text, "1 3 linux\n", arena)
    assert(native.ok && native.unexpected == 0, "Windows expects its own missing SIGPIPE")
    assert(!linux.ok && linux.unexpected == 1, "Linux cannot inherit Windows's allowed skips")
    assert(linux.sec == 3I64, "the recorded duration survives the platform field")
    verdict.pass("a copied container log is judged for its execution platform.")

fn test_an_unexpected_skip_is_named_last(arena: Arena$@) //<
    //< The SKIP that failed a gate is the summary's last word, marked apart from the expected ones
    verdict.start("[tools/ci_gates] a gate failing on a SKIP no row holds test...")
    $outs: = List<|Outcome|>(arena)
    outs.push(sample("suites_a", LOG_UNEXPECTED_SKIP, "1 270\n", arena))
    outs.push(sample("link_abi", LOG_ARM, "0 9\n", arena))
    p: = summarised(outs@, arena)
    assert(p.find_str("#   suites_a       FAIL 270s    3 SKIP lines, 1 UNEXPECTED\n").is_some(),
        "the gate's row counts the SKIP that failed it apart")
    named: =
        "# why it failed:\n#   suites_a: UNEXPECTED SKIP extract-rest: kssrv's own tests: kssrv: a \
            socket in the root is answered 404: Windows has no socket a path names\n"
    assert(after(p, "gates invoked:", named),
        "the SKIP no row holds is named after the list, marked UNEXPECTED")
    assert(p.find_str("Windows has no SIGPIPE").is_none(), "an expected SKIP is not")
    assert(after(p, "UNEXPECTED SKIP", "#   suites_a: its whole log is out/log/ci/suites_a.log\n"),
        "its whole log is named after its causes")
    assert(p.ends_with("bring its tool back, or add the row where this platform cannot have it\n"),
        "the last line says what to do about it")
    verdict.pass("the SKIP no row holds is named last, marked UNEXPECTED, with the gate's log.")

fn test_a_fail_line_is_named_last(arena: Arena$@) //<
    //< A FAIL line comes first among a gate's causes
    verdict.start("[tools/ci_gates] a gate failing on a FAIL line test...")
    $outs: = List<|Outcome|>(arena)
    outs.push(sample("suites_a", LOG_FAIL, "2 418\n", arena))
    p: = summarised(outs@, arena)
    first: =
        "#   suites_a: FAIL extract-ksplc: ksplc's suite spawn passes from the copy: FAIL spawn: a \
            prompt to a terminal shows before the read: [harness] it could not start\n#   suites_a: \
            RESULT: SOME FAILED (1)"
    assert(after(p, "# why it failed:\n", first), "the FAIL line comes first")
    // make's own words are the locale's: only `*** [` is read, so `エラー` is found as `Error` is.
    assert(p
        .find_str("#   suites_a: make[2]: *** [mk/test.mk:144: test-extract-ksplc] エラー 1\n")
        .is_some(), "make's line naming the target that stopped is read in any locale")
    assert(p.find_str("未完了").is_none(), "make's waiting for the other jobs is no cause")
    assert(p.find_str("the output before the panic").is_none(), "a pass line saying panic is none")
    assert(p.find_str("UNEXPECTED").is_none(), "a pass line naming SKIP in its label is no skip")
    verdict.pass("a FAIL line comes first, then the RESULT line and make's, in any locale.")

fn test_a_panic_is_named_last(arena: Arena$@) //< a panic inside a quoted tail is found
    verdict.start("[tools/ci_gates] a gate failing on a panic test...")
    $outs: = List<|Outcome|>(arena)
    outs.push(sample("suites_a", LOG_PANIC, "2 134\n", arena))
    p: = summarised(outs@, arena)
    first: =
        "#   suites_a: panic: a write of 4 GiB should send a piece at std/tests/net_test:460\n#   \
            suites_a: FAIL extract-rest"
    assert(after(p, "# why it failed:\n", first),
        "the panic comes first, before the FAIL line that quotes it")
    assert(p.find_str("a crash is 139").is_none(), "a pass line naming a panic is no cause")
    verdict.pass("a panic inside a quoted tail is named first.")

fn test_a_log_saying_nothing_shows_its_tail(arena: Arena$@) //<
    //< Where no line of the gate's own names a cause, its last lines stand in
    verdict.start("[tools/ci_gates] a gate failing with nothing recognisable test...")
    $outs: = List<|Outcome|>(arena)
    outs.push(sample("selfhost", LOG_UNREAD, "2 13\n", arena))
    outs.push(sample("lint", "", "", arena))
    p: = summarised(outs@, arena)
    first: =
        "#   selfhost: make: *** [Makefile:210: out/ksplc_stage1.exe] エラー 1\n#   selfhost: NO \
            VERDICT: it printed no `RESULT: ALL PASS` line\n"
    assert(after(p, "# why it failed:\n", first), "make's line and the missing verdict come first")
    quoted: = "#   selfhost: | out/stage1.c:1234:5: error: use of undeclared identifier 'kspl_x'\n"
    assert(p.find_str(quoted).is_some(),
        "the log's last lines are quoted, where the C compiler's error is")
    assert(p.find_str("#   selfhost: | \n").is_none(), "a blank line is not quoted")
    // A gate cut short leaves a log and no `.end`: it fell, and says so with nothing else.
    assert(p.find_str("#   lint: NO VERDICT").is_some(), "a gate cut short with an empty log fell")
    verdict.pass("where nothing names a cause, the log's last lines stand in.")

fn test_a_gate_past_its_cap_is_stopped_and_named(arena: Arena$@) //<
    //< A gate past its cap is stopped with what it started, and the cap is its first cause
    //< The fake gate's own child leaves a mark three seconds in: stopped with the gate at one, it
    //< leaves none. The stop may take the half second of grace a group is given to end.
    verdict.start("[tools/ci_gates] a gate that runs past its cap test...")
    if sys.is_windows()
        verdict.skip("it hands over shell command lines")
        return
    dir: = "out/tmp/kspl_ci_cap"
    fs.mkdir_all(dir) catch panic("the work directory must be creatable")
    log: = arena.text().s(dir).s("/fake.log").take()
    mark: = arena.text().s(dir).s("/mark").take()
    fs.remove_path(mark) catch {}
    io.write_file(log, "the gate's own line\n") catch panic("the log must be writable")
    gate: = arena.text().s("sh -c 'sleep 3; touch \"\{mark\}\"'; true").take()
    t0: = sys.mono_us()
    rc: = ci_gates.run_capped(U8[][]::{ "/bin/sh", "-c", gate }, "fake", log, 1I64, t0)
    took_ms: = (sys.mono_us() - t0) / 1000I64
    sys.sleep_ms(2500)
    assert(rc != 0, "a gate stopped at its cap fails")
    $m: = Panic_msg()
    assert(took_ms < 2800I64,
        m.s("it is stopped at its cap, before its child's end (took ").n(took_ms).s(" ms)").slice())
    assert(!fs.exists(mark), "the gate's own child is stopped with it")
    held: = io.read_file(log, arena) catch ""
    line: = "# gate fake ran over 1 s and was stopped"
    assert(held
        .equals(arena.text().s("the gate's own line\n").s(line).c('\n').take()),
        "the cap's line ends the gate's log")
    j: = ci_gates.Judge::{ .platform = "linux", .relaxed = "" }
    why: = ci_gates.causes(held, "fake", true, j@, arena)
    assert(why.len > 0 && why.get(0).kind == ci_gates.Cause_kind.over_cap &&
        why.get(0).line.equals(line), "the cap is the first cause named")
    // A gate's own tests print the line for their fake gate: it is no cause of that gate's.
    for c in ci_gates.causes(held, "debug_tools", true, j@, arena)
        assert(c.kind != ci_gates.Cause_kind.over_cap, "the cap's line counts for its gate alone")
    fs.remove_path(dir) catch {}
    verdict.pass("a gate past its cap was stopped with its child, and the cap was its first cause.")

fn test_the_stopping_order(arena: Arena$@) //<
    //< Without the switch the table's order; with it `stops` first, then `early`, each gate once
    verdict.start("[tools/ci_gates] the order a round runs its gates in test...")
    plain: = ci_gates.run_order(false, arena)
    assert(plain.len == ci_gates.GATES.len, "the table's order holds every gate")
    for i in Range.asc(plain.len)
        assert(plain.get(i).log.equals(ci_gates.GATES[i].log), "the default order is the table's")
    quick: = ci_gates.run_order(true, arena)
    assert(quick.len == ci_gates.GATES.len, "the stopping order holds every gate")
    $part: Sz = 0
    $early: Sz = 0
    for i in Range.asc(quick.len)
        g: = quick.get(i)
        $now: Sz = 2
        if g.stops
            now = 0
        else if g.early
            now = 1
            early += 1
        assert(now >= part, "the gates with `stops` come first, then the `early` ones")
        part = now
        // Each gate once, in the table's order within its part.
        for k in Range.asc(i)
            assert(!quick.get(k).log.equals(g.log), "no gate runs twice")
    assert(early > 0 && quick.get(0).log.equals("selfhost"), "the self-host still runs first")
    verdict.pass("the default order is the table's; the stopping order moves the early gates up.")

fn test_a_round_that_ended_early_says_so_last(arena: Arena$@) //<
    //< The gates not run are named as not run, and the last line says it is no full verdict
    verdict.start("[tools/ci_gates] the last lines of a round that ended early test...")
    $left: = List<|U8[]|>(arena)
    left.push("lint_cfg")
    left.push("suites_a")
    defer $b: = Str_builder()
    ci_gates.early_end("lint", true, left@, b@)
    by_switch: =
        "# not run (2): lint_cfg, suites_a\n# ended early at lint: STOP=1 ends the round at the \
            first gate that fails, so this round is not a full verdict\n"
    assert(b.slice().equals(by_switch), "the switch's round names what it left, then why it ended")
    defer $c: = Str_builder()
    ci_gates.early_end("selfhost", false, left@, c@)
    by_build: =
        "# ended early at selfhost: the gates after it build on what it builds, so this round is \
            not a full verdict\n"
    assert(c.slice().ends_with(by_build), "the self-host's fall gives its own reason")
    assert(c.slice().find_str("PASS").is_none(), "a gate not run is never called passed")
    verdict.pass("a round that ended early names what did not run, and says it is no verdict.")

fn test_the_page_lists_what_needs_attention(arena: Arena$@) //<
    //< The job's page marks a fall and lists a skipping gate, with no line of a log
    verdict.start("[tools/ci_gates] the summary page test...")
    $outs: = List<|Outcome|>(arena)
    outs.push(sample("selfhost", "RESULT: ALL PASS\n", "0 30\n", arena))
    outs.push(sample("link_abi", LOG_ARM, "0 5\n", arena))
    outs.push(sample("debug", LOG_FAIL, "1 7\n", arena))
    defer $md: = Str_builder()
    ci_gates.digest_md(outs@, 4I64, "linux ci-shard-core", md@)
    m: = md.slice()
    assert(m.starts_with("## linux ci-shard-core - 2 PASS / 1 FAIL   (42s, -j4)"),
        "the heading counts them")
    assert(m.find_str("| debug | **FAIL** | 7 |").is_some(), "a fallen gate is in bold")
    assert(m.find_str("\nSKIP:\n\n* `link_abi`\n").is_some(), "a skipping gate is listed by name")
    // Caution: **No log line goes in** (the reason is at `digest_md`).
    assert(m.find_str("no ARM toolchain").is_none(), "the page holds no line of a log")
    verdict.pass("the page marks a fall and lists a skip, with no line of a log.")

fn test_a_skip_is_held_by_its_platform_alone() //<
    //< A SKIP a platform's rows hold passes there, and fails where no row holds it
    verdict.start("[tools/ci_gates] the lines a platform may skip on test...")
    arm: = "RESULT: SKIPPED (no ARM toolchain)"
    assert(ci_gates.is_expected_skip(arm, "win32", ""), "Windows holds no ARM toolchain")
    assert(!ci_gates.is_expected_skip(arm, "linux", ""),
        "Linux's image holds one, so it may not skip")
    v6: = "SKIP Net: connecting over the IPv6 loopback: this machine has no IPv6 at all"
    for p in U8[][]::{ "linux", "darwin", "win32" }
        assert(ci_gates.is_expected_skip(v6, p, ""), "a host's kernel may lack IPv6 anywhere")
    assert(!ci_gates.is_expected_skip(v6, "solaris", ""), "a platform with no rows holds no SKIP")
    lo: = "SKIP Net: connecting over the IPv6 loopback: IPv6 is on, but the loopback holds no `::1`"
    assert(!ci_gates.is_expected_skip(lo, "linux", ""),
        "Linux's container has `::1`, so it may not skip")
    for p in U8[][]::{ "darwin", "win32" }
        assert(ci_gates.is_expected_skip(lo, p, ""), "elsewhere a loopback without `::1` may skip")
    verdict.pass("each platform holds its own reasons to skip, and nothing else passes in silence.")

fn test_a_switch_turned_off_lets_its_own_skips_through() //<
    //< On Linux a SKIP a switch makes a failure passes once that switch is off, and no other does
    verdict.start("[tools/ci_gates] the lines a switch turned off lets through test...")
    chown: =
        "SKIP cli: cache: ksplc run refuses a cache folder another user owns: neither `chown` nor \
            `sudo -n chown` can hand a folder to another user here"
    assert(!ci_gates.is_expected_skip(chown, "linux", ""), "Linux requires it by default")
    assert(ci_gates.is_expected_skip(chown, "linux", "KANSO_REQUIRE_CHOWN"),
        "turned off, its skip passes")
    assert(ci_gates.is_expected_skip(chown, "linux", "KANSO_REQUIRE_ASAN KANSO_REQUIRE_CHOWN"),
        "among others, too")
    assert(!ci_gates.is_expected_skip(chown, "linux", "KANSO_REQUIRE_ASAN"),
        "another switch lets it through nowhere")
    arm: = "RESULT: SKIPPED (no ARM toolchain)"
    assert(ci_gates.is_expected_skip(arm, "linux", "KSOS_REQUIRE_ARM"), "each switch its own")
    cross: =
        "SKIP ship: the Windows programs run under Wine: x86_64-w64-mingw32-gcc is not installed"
    assert(!ci_gates.is_expected_skip(cross, "linux", ""), "Linux's image holds the cross compiler")
    assert(ci_gates.is_expected_skip(cross, "linux", "KANSO_REQUIRE_MINGW"),
        "turned off, the cross half's skip passes")
    node: = "SKIP vscode: the extension's client side: node is not installed"
    assert(!ci_gates.is_expected_skip(node, "linux", "KANSO_REQUIRE_CHOWN KSOS_REQUIRE_ARM"),
        "a tool no switch covers stays required")
    defer a: = Arena(4096)
    assert(ci_gates.unknown_switch("KANSO_REQUIRE_CHOWN KSOS_REQUIRE_ARM", a).is_none(),
        "every switch `mk/test.mk` names has its rows")
    assert(ci_gates.unknown_switch("KANSO_REQUIRE_CHOWN KANSO_REQUIRE_NOPE", a).unwrap_or("")
        .equals("KANSO_REQUIRE_NOPE"), "a switch no row names is found, so the round refuses it")
    verdict.pass("a switch turned off lets its own skips through, and nothing else.")

// ==========================================
// Two gates side by side (`Gate.beside`)
// **A mistake here hides a fall or mixes two gates' answers.** A pair started one after the other
// costs only time; a partner's fall laid on the other gate, or left out of the digest, goes green.
// ==========================================

priv fn logs_of(st: ci_gates.Step, arena: Arena$@): U8[] //< a step's gates by name, joined by `+`
    b: = arena.text()
    for i in Range.asc(st.gates.len)
        b.s("" if i == 0 else "+").s(st.gates.get(i).log)
    return b.take()

priv fn pairs_in(s: ci_gates.Set, platform: U8[], serial: Bool, arena: Arena$@): U8[] //<
    //< The set's steps of more than one gate, each `a+b `; checks the steps hold each gate once
    order: = ci_gates.run_order(false, arena)
    $want: Sz = 0
    for g in order
        if s.runs(g, platform)
            want += 1
    $got: Sz = 0
    pairs: = arena.text()
    for st in ci_gates.steps(order@, s, platform, serial, arena)
        got += st.gates.len
        if st.gates.len > 1
            pairs.s(logs_of(st, arena)).c(' ')
    assert(got == want, "the steps hold every gate the set runs, each once")
    return pairs.take()

fn test_the_pair_starts_together_only_where_both_run(arena: Arena$@) //<
    //< Race and the shipped build share a step where the set runs both, and nowhere else
    verdict.start("[tools/ci_gates] which gates start side by side test...")
    assert(ci_gates.pair_fault(arena).is_none(), "each partner is the row next to it, named back")
    assert(pairs_in(.ci, "linux", false, arena).equals("race+selfhost_ship "),
        "Linux's whole round starts the pair together")
    assert(pairs_in(.ci_shard_linux, "linux", false, arena).equals("race+selfhost_ship "),
        "so does the Linux job's shard")
    for s in ci_gates.SET_ORDER
        assert(pairs_in(s, "linux", true, arena).len == 0, "the serial switch runs each gate alone")
    for p in U8[][]::{ "win32", "darwin" }
        assert(pairs_in(.ci, p, false, arena).len == 0, "a host that runs neither has no pair")
    for p in U8[][]::{ "linux", "win32", "darwin" }
        assert(pairs_in(.ci_shard_core, p, false, arena).len == 0, "the shared shards hold none")
        assert(pairs_in(.ci_shard_rest, p, false, arena).len == 0, "the shared shards hold none")
        assert(pairs_in(.ci_macos, p, false, arena).len == 0, "macOS's set holds none")
    verdict.pass("the pair starts together where its set runs both, and the switch parts it.")

priv fn fake_gate(dir: U8[], name: U8[], body: U8[], arena: Arena$@): ci_gates.Capped //<
    //< A gate whose command runs `body` in the shell, its output into its own log
    log: = arena.text().s(dir).c('/').s(name).s(".log").take()
    // The words outlive this call, so they go on the arena, not in a literal on its frame.
    $argv: = List<|U8[]|>(arena)
    argv.push("/bin/sh")
    argv.push("-c")
    argv
        .push(arena.text().s("{ ").s(body).s("; } > \"").s(log).s("\" 2>&1").take())
    return ci_gates.Capped::{ .argv = argv.slice(), .name = name, .log = log, .rc = 0,
        .took_us = 0I64 }

fn test_a_pair_runs_side_by_side_and_is_judged_apart(arena: Arena$@) //<
    //< Both start at once, each ends with its own code and time, and each is judged by its own log
    //< Each fake gate sleeps a second: one after the other they would take two.
    verdict.start("[tools/ci_gates] two gates side by side test...")
    if sys.is_windows()
        verdict.skip("it hands over shell command lines")
        return
    dir: = "out/tmp/kspl_ci_pair"
    fs.mkdir_all(dir) catch panic("the work directory must be creatable")
    $runs: = List<|ci_gates.Capped|>(arena)
    runs.push(fake_gate(dir, "race", "sleep 1; echo 'RESULT: ALL PASS'", arena))
    falls: = "sleep 1; echo 'FAIL ship: the shipped C differs'; exit 3"
    runs.push(fake_gate(dir, "selfhost_ship", falls, arena))
    t0: = sys.mono_us()
    ci_gates.run_capped_all(runs.slice(), 60I64, t0)
    took_ms: = (sys.mono_us() - t0) / 1000I64
    $m: = Panic_msg()
    assert(took_ms < 1800I64,
        m.s("both start together, so the pair takes one second (took ").n(took_ms).s(" ms)").slice())
    race: = runs.get(0)
    ship: = runs.get(1)
    assert(race.rc == 0 && ship.rc == 3, "each gate keeps its own exit code")
    assert(race.took_us >= 900000I64 && ship.took_us >= 900000I64,
        "each gate's time is its own, from the start to its end")
    $outs: = List<|Outcome|>(arena)
    for c in runs
        ended: = arena.text().s("\{c.rc\} \{c.took_us / 1000000I64\}\n").take()
        outs
            .push(sample(c.name, io.read_file(c.log, arena) catch "", ended, arena))
    assert(outs.get(0).ok && !outs.get(1).ok, "the partner of a fallen gate still passes")
    p: = summarised(outs@, arena)
    assert(p.find_str("#   race           PASS 1s").is_some(), "each gate has its own line")
    assert(p.find_str("#   selfhost_ship  FAIL 1s").is_some(), "the fallen one is marked so")
    assert(p.find_str("#   selfhost_ship: FAIL ship: the shipped C differs").is_some(),
        "the fall's cause is read from that gate's own log")
    assert(p.find_str("#   race:").is_none(), "no cause is laid on the gate that passed")
    fs.remove_path(dir) catch {}
    verdict.pass("two gates started together, and each was judged by its own code and log.")

fn test_a_partner_past_its_cap_is_stopped_alone(arena: Arena$@) //<
    //< Each gate has the cap to itself: the one past it is stopped, the other ends on its own
    verdict.start("[tools/ci_gates] a gate past its cap beside another test...")
    if sys.is_windows()
        verdict.skip("it hands over shell command lines")
        return
    dir: = "out/tmp/kspl_ci_pair_cap"
    fs.mkdir_all(dir) catch panic("the work directory must be creatable")
    $runs: = List<|ci_gates.Capped|>(arena)
    runs.push(fake_gate(dir, "race", "sleep 3", arena))
    runs.push(fake_gate(dir, "selfhost_ship", "echo 'RESULT: ALL PASS'", arena))
    t0: = sys.mono_us()
    ci_gates.run_capped_all(runs.slice(), 1I64, t0)
    took_ms: = (sys.mono_us() - t0) / 1000I64
    $m: = Panic_msg()
    assert(took_ms < 2800I64,
        m.s("the one past its cap is stopped there (took ").n(took_ms).s(" ms)").slice())
    assert(runs.get(0).rc == 1, "the gate past its cap fails")
    assert(runs.get(1).rc == 0 && runs.get(1).took_us < 900000I64,
        "its partner ended on its own, and its time is its own")
    held: = io.read_file(runs.get(0).log, arena) catch ""
    assert(held.ends_with("# gate race ran over 1 s and was stopped\n"),
        "the cap's line ends the stopped gate's log")
    assert((io.read_file(runs.get(1).log, arena) catch "").find_str("ran over").is_none(),
        "and not its partner's")
    fs.remove_path(dir) catch {}
    verdict.pass("the gate past its cap was stopped, and its partner ended as it would alone.")

fn test_a_failing_partner_with_stop_ends_the_round_after_both(arena: Arena$@) //<
    //< With `--stop-at-first`, a pair's fall ends the round once both have ended, naming the fallen
    verdict.start("[tools/ci_gates] a fallen gate of a pair with STOP=1 test...")
    order: = ci_gates.run_order(true, arena)
    $pair: ci_gates.Step? = .none
    for st in ci_gates.steps(order@, .ci, "linux", false, arena)
        if st.gates.len > 1
            pair = .some(st)
    switch pair
    case .some(st)
        $passed: = List<|Bool|>(arena)
        passed.push(true)
        passed.push(false)
        assert(ci_gates.ends_round(st@, passed@, true).unwrap_or(st.gates.get(0)).log
            .equals("selfhost_ship"), "the partner that fell ends the round, the other having run")
        assert(ci_gates.ends_round(st@, passed@, false).is_none(),
            "without the switch the round goes on")
        passed.set(0, false)
        assert(ci_gates.ends_round(st@, passed@, true).unwrap_or(st.gates.get(1)).log.equals("race"),
            "where both fell, the first in the table's order is named")
        passed.set(0, true)
        passed.set(1, true)
        assert(ci_gates.ends_round(st@, passed@, true).is_none(), "a pair that passed ends nothing")
    case .none
        assert(false, "the stopping order keeps the pair in one step")
    verdict.pass("a pair's fall ends a STOP=1 round after both ended, naming the gate that fell.")

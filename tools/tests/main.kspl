//< The tools' tests, run as a program of their own (`make debug-tools`)
//<
//< `all.kspl` holds them; this file only gives them a `main`. `tools/` has no `Makefile` of its
//< own, so the root's `debug-tools` builds this file.
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/verdict"
import "tools/tests/all"

fn main(): I32 //< the exit code is the checks' verdict (`verdict.finish`)
    // Flush line by line, so a run that crashes shows how far it got.
    io.set_line_buffered()
    // The tests that write files write under out/tmp; the one that cannot reports it by name.
    fs.mkdir_all("out/tmp") catch {}
    arena: = Arena.new(1024 * 1024)
    defer arena.free()
    all.run_tools(arena)
    return verdict.finish()

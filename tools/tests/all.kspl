//< The entry point that runs tools' tests together
//<
//< **This is the one `pub` in this package.** Inside `tools/` the tests reach what they test
//< without `pub` ([I0402] in ksplc.cfg); `tests/debug/main.kspl`, outside it, needs this one.
//< Caution: **Do not add another entry point for tests here**: each is one more contract outside
//< the package.
import "std/mem" { Arena }
import "tools/ai_assist/tests/ai_assist_test"
import "tools/tests/page_test"
import "tools/tests/repo_test"

pub fn run_tools(arena: Arena$@) //< runs every test in tools
    // The URL to open, the page handing it over and the note's paths (`tools/kspage_aim.kspl`).
    // **`make kspage` uses this build too.**
    page_test.test_the_url_keeps_the_token_last()
    page_test.test_what_the_server_printed()
    page_test.test_a_port_that_cannot_be_waited_on()
    page_test.test_the_note_lists_the_running_servers()
    page_test.test_a_note_that_was_cut_short()
    page_test.test_a_note_rebuilt_from_its_records()
    page_test.test_a_folder_named_with_a_separator_at_its_end()
    page_test.test_climbing_up_from_a_file()
    page_test.test_the_path_the_server_will_see()
    page_test.test_where_the_file_lives()
    page_test.test_the_browser_is_handed_a_page_not_the_url()
    page_test.test_a_page_handed_long_ago_is_removed()
    page_test.test_the_note_is_written_for_its_owner()
    // The CI's sets and the summary of a round (`tools/ci_gates.kspl`).
    repo_test.test_a_set_is_named_as_make_names_it(arena)
    repo_test.test_the_shards_part_ci()
    repo_test.test_a_green_round_stays_short(arena)
    repo_test.test_a_container_log_keeps_its_platform(arena)
    repo_test.test_an_unexpected_skip_is_named_last(arena)
    repo_test.test_a_fail_line_is_named_last(arena)
    repo_test.test_a_panic_is_named_last(arena)
    repo_test.test_a_log_saying_nothing_shows_its_tail(arena)
    repo_test.test_the_page_lists_what_needs_attention(arena)
    repo_test.test_a_skip_is_held_by_its_platform_alone()
    repo_test.test_a_switch_turned_off_lets_its_own_skips_through()
    // Counting the training material (`tools/ai_assist/corpus_count.kspl`).
    ai_assist_test.test_which_folder_is_left_out()
    ai_assist_test.test_counting_words()
    ai_assist_test.test_counting_lines()
    ai_assist_test.test_the_token_estimate()
    // Classifying files by their path alone (`tools/repo_stat_path.kspl`).
    repo_test.test_the_files_listed(arena)
    repo_test.test_which_file_is_generated()
    repo_test.test_the_comment_marker()
    repo_test.test_the_block_marks()
    repo_test.test_where_a_comment_opens()
    repo_test.test_the_extension_and_the_top_folder()
    // Reading and comparing the record of the published API (`tools/surface.kspl`).
    page_test.test_reading_the_record(arena)
    page_test.test_telling_the_difference(arena)
    page_test.test_a_drifted_twin_is_named(arena)
    page_test.test_an_entry_that_says_nothing(arena)
    page_test.test_taking_a_row_apart(arena)
    page_test.test_a_part_row_is_told_from_an_entry(arena)
    page_test.test_what_a_file_says_of_itself(arena)
    // Writing the language tour (`tools/tour_page.kspl`).
    page_test.test_a_step_per_described_declaration(arena)
    page_test.test_the_page_holds_the_steps(arena)
    ai_assist_test.test_compile_errors(arena)
    ai_assist_test.test_reading_the_closing_object(arena)
    ai_assist_test.test_load_jsonl(arena)

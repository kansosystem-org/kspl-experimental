//< The entry point that runs tools' tests together
//< **This is the one `pub` in this package.** Inside `tools/` the tests reach what they test
//< without `pub` ([I0402] in ksplc.cfg); `tests/debug/main.kspl`, outside it, needs this one.
//< Caution: **Do not add another entry point for tests here**: each is one more contract outside
//< the package.
import "std/mem" { Arena }
import "std/suite"
import "tools/ai_assist/tests/ai_assist_test"
import "tools/tests/page_test"
import "tools/tests/repo_test"

priv struct Tests //< what the tools' tests take
    arena: Arena$@

impl Tests: suite.Suite {}

pub fn run_tools(arena: Arena$@) //< runs every test in tools
    // **`make kspage` uses this build too**: the tests of `tools/kspage_aim.kspl` run in it.
    $t: = Tests::{ .arena = arena }
    t.run()

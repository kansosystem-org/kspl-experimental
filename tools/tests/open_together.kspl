//< Opens two documents from two folders at once, as choosing both and opening them together does
//<
//< Usage: `open_together <opener> <kssrv> <work folder>` (`make test-kspage-open`). It copies both
//< programs into the work folder with a page beside them. It starts two `--show` opens at once
//< naming one port. It checks that each got a server of its own, for its own folder, and that the
//< note records both. **Every server it started is stopped at the end** (`--stop-all`), whatever
//< the checks found.
import "std/chars"
import "std/fs"
import "std/http"
import "std/io"
import "std/mem" { Arena }
import "std/net"
import "std/str"
import "std/strfmt" as _strfmt
import "std/subproc"
import "std/sys"
import "std/verdict"
import "tools/kspage_aim" as aim

priv const SHARED_PORT: U8[] = "18640" //< the port both opens name, so they compete for it
priv const URL_WAIT_STEPS: Sz = 300 //< how many times, 100ms apart, the opens' output is read
priv const ANSWER_WAIT_MS: I32 = 10000 //< how long a server may take to answer one request
priv const TOOL_WAIT_MS: I32 = 60000 //< how long `--list` and `--stop-all` may take

priv fn url_of(out_path: U8[]): U8[] //< the URL an opener put out, "" until a whole line of it
    body: = io.read_file(out_path) catch
        return ""
    if at: = body.find_str("http://")
        rest: = body.sub_from(at)
        if end: = rest.find_char('\n')
            return rest.sub(0, end)
    return ""

priv fn status_of(url: U8[], target: U8[], arena: Arena$@): I32 //<
    //< The status the server behind `url` answers `GET target` with, with the URL's token
    //<
    //< 0 where nothing answered.
    stream: =
        net.Tcp_stream.connect("127.0.0.1", aim.port_num(aim.port_in_url(url))) catch
        return 0
    defer stream.free()
    bearer: = arena.text().s("Bearer ").s(aim.token_in_url(url)).take()
    head: = http.headers(arena).add("Host", "127.0.0.1").add("Authorization", bearer).build()
    http.write_request(stream, "GET", target, head, "") catch
        return 0
    answer: =
        http.read_response(stream, arena, http.DEFAULT_MAX_BODY_BYTES, ANSWER_WAIT_MS) catch
        return 0
    return answer.status

priv fn place(work: U8[], opener: U8[], server: U8[], arena: Arena$@): U8[]!fs.Fs_error //<
    //< Copies the opener and the server into `<work>/bin` with a page beside them
    //<
    //< Returns the opener's copy. **The page is only looked for**, never served here, so any text
    //< stands in for it.
    bin: = fs.join(work, "bin", arena)
    fs.write_tree(bin, U8[][]::{ "kspage_web/kspage.html" }, U8[][]::{ "a stand-in page\n" }, arena)!
    at: = fs.join(bin, "kspage_open.exe", arena)
    fs.copy_file(opener, at)!
    fs.copy_file(server, fs.join(bin, "kssrv.exe", arena))!
    return at

priv fn doc_in(work: U8[], folder: U8[], name: U8[], arena: Arena$@): U8[]!fs.Fs_error //<
    //< Writes a document named `name` into `<work>/<folder>`, and returns its path
    dir: = fs.join(work, folder, arena)
    fs.write_tree(dir, U8[][]::{ name }, U8[][]::{ "{}\n" }, arena)!
    return fs.join(dir, name, arena)

priv fn open_argv(opener: U8[], doc: U8[], arena: Arena$@): U8[][5] //<
    //< The command opening `doc` with its own folder served, on the shared port
    //<
    //< **The folder is named**: the work folder stands inside this repository, so left to itself
    //< the opener would serve the repository's root for both.
    return U8[][5]::{ opener, doc,
        arena.text().s("--root=").s(aim.parent_of(doc)).take(),
        arena.text().s("--port=").s(SHARED_PORT).take(), "--show" }

priv fn reap(kid: subproc.Child$@) //< waits for an open to end, and kills one that does not
    //<
    //< **A `--show` open ends once its server has**; one still running would hold the gate open.
    for _step in Range.asc(URL_WAIT_STEPS)
        if !kid.alive()
            _code: = kid.wait()
            return
        sys.sleep_ms(100)
    kid.kill()

fn main(): I32 //< the exit code is the checks' verdict (`verdict.finish`)
    verdict.begin("kspage_open")
    args: = sys.args()
    if args.len != 4
        io.err().s("usage: open_together <opener> <kssrv> <work folder>\n")
        return 2
    arena: = Arena.new(256 * 1024)
    defer arena.free()
    work: = fs.absolute(args[3], arena) catch
        return verdict.fatal("the work folder cannot be made absolute")
    opener: = place(work, args[1], args[2], arena) catch
        return verdict.fatal("the opener and the server cannot be copied into the work folder")
    doc_a: = doc_in(work, "dA", "a.kspage", arena) catch
        return verdict.fatal("the first document cannot be written")
    doc_b: = doc_in(work, "dB", "b.kspage", arena) catch
        return verdict.fatal("the second document cannot be written")
    out_a: = fs.join(work, "open_a.out", arena)
    out_b: = fs.join(work, "open_b.out", arena)

    // Caution: **Start both before waiting on either**: one after the other, the second finds the
    // first's server in the note and never meets the race.
    argv_a: = open_argv(opener, doc_a, arena)
    argv_b: = open_argv(opener, doc_b, arena)
    $first: = subproc.spawn_redirect(U8[][]::argv_a, "", out_a, out_a) catch
        return verdict.fatal("the first open cannot be started")
    $second: = subproc.spawn_redirect(U8[][]::argv_b, "", out_b, out_b) catch
        first.kill()
        return verdict.fatal("the second open cannot be started")
    $url_a: U8[] = ""
    $url_b: U8[] = ""
    for _step in Range.asc(URL_WAIT_STEPS)
        url_a = url_of(out_a)
        url_b = url_of(out_b)
        if url_a.len > 0 && url_b.len > 0 || !first.alive() && !second.alive()
            break
        sys.sleep_ms(100)
    came: = url_a.len > 0 && url_b.len > 0
    verdict.check("both opens put out a URL", came,
        arena.text().s("first: ").s(io.read_file(out_a) catch "(no output)").s("\nsecond: ")
        .s(io.read_file(out_b) catch "(no output)").take())
    if came
        port_a: = aim.port_in_url(url_a)
        port_b: = aim.port_in_url(url_b)
        verdict.check("each open has a server of its own", !port_a.equals(port_b),
            arena.text().s(url_a).c(' ').s(url_b).take())
        // **Each server serves its own document's folder**: one handed the other's server finds
        // no such name (404).
        verdict.check("the first server serves the first folder",
            status_of(url_a, "/api/stat?path=a.kspage", arena) == 200, url_a)
        verdict.check("the second server serves the second folder",
            status_of(url_b, "/api/stat?path=b.kspage", arena) == 200, url_b)
        listed: =
            subproc.run_capture(U8[][]::{ opener, "--list" }, "", TOOL_WAIT_MS, 64 * 1024, arena)
            catch panic("the opener must start")
        lines: = listed.stdout_data
        for one in U8[][]::{ port_a, port_b }
            folder: =
                aim.parent_of(doc_a) if one.equals(port_a) else aim.parent_of(doc_b)
            mark: = arena.text().s("127.0.0.1:").s(one).s("/").take()
            $found: = false
            for line in lines.lines(arena)
                found =
                    found || line.find_str(mark).is_some() && line.ends_with(folder)
            verdict.check(arena.text().s("the note records the server on ").s(one)
                .s(" for its folder").take(), found, lines)
    stopped: =
        subproc.run_capture(U8[][]::{ opener, "--stop-all" }, "", TOOL_WAIT_MS, 64 * 1024, arena)
        catch panic("the opener must start")
    verdict.check("--stop-all stops what was started", stopped.exited_with(0),
        stopped.text(arena))
    reap(first@)
    reap(second@)
    return verdict.finish()

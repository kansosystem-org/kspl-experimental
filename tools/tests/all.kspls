//< The entry point that runs tools' tests together
//<
//< **This is the one `pub` in this package.** Inside `tools/` the tests reach what they test
//< without `pub` ([I0402] in ksplc.cfg); `tests/debug/parts.kspls`, outside it, needs this one.
//< Caution: **Do not add another entry point for tests here**: each is one more contract outside
//< the package.
import "std/mem" { Arena }
import "tools/ai_assist/tests/corpus_count_test"
import "tools/ai_assist/tests/fix_names_test"
import "tools/ai_assist/tests/oracle_test"
import "tools/tests/aim_test"
import "tools/tests/code_rows_test"
import "tools/tests/lsp_place_test"
import "tools/tests/repo_stat_test"
import "tools/tests/surface_test"
import "tools/tests/tour_page_test"

pub fn run_tools(arena: Arena$@) //< runs every test in tools
  // The URL to open and the note's paths (`tools/kspage_aim.kspls`). **`make kspage` uses this
  // build too.**
  aim_test.test_the_url_keeps_the_token_last()
  aim_test.test_what_the_server_printed()
  aim_test.test_a_port_that_cannot_be_waited_on()
  aim_test.test_the_note_lists_the_running_servers()
  aim_test.test_a_note_that_was_cut_short()
  aim_test.test_a_note_rebuilt_from_its_records()
  aim_test.test_a_folder_named_with_a_separator_at_its_end()
  aim_test.test_climbing_up_from_a_file()
  aim_test.test_the_path_the_server_will_see()
  aim_test.test_where_the_file_lives()
  // The table of diagnostic codes (`tools/code_rows.kspls`).
  code_rows_test.test_the_rows_follow_the_sections(arena)
  code_rows_test.test_a_document_without_the_table(arena)
  // The names appearing in the training material (`tools/ai_assist/fix_names.kspls`).
  fix_names_test.test_the_temporary_file_names(arena)
  fix_names_test.test_the_dotted_name(arena)
  fix_names_test.test_which_line_is_code()
  // The position and the file passed to the language server (`tools/lsp_place.kspls`).
  lsp_place_test.test_reading_a_position()
  lsp_place_test.test_pointing_at_a_file(arena)
  // Counting the training material (`tools/ai_assist/corpus_count.kspls`).
  corpus_count_test.test_which_folder_is_left_out()
  corpus_count_test.test_counting_words()
  corpus_count_test.test_counting_lines()
  corpus_count_test.test_the_token_estimate()
  // Classifying files by their path alone (`tools/repo_stat_path.kspls`).
  repo_stat_test.test_the_files_listed(arena)
  repo_stat_test.test_which_file_is_generated()
  repo_stat_test.test_the_comment_marker()
  repo_stat_test.test_the_block_marks()
  repo_stat_test.test_where_a_comment_opens()
  repo_stat_test.test_the_extension_and_the_top_folder()
  // Reading and comparing the record of the published API (`tools/surface.kspls`).
  surface_test.test_reading_the_record(arena)
  surface_test.test_telling_the_difference(arena)
  surface_test.test_an_entry_that_says_nothing(arena)
  surface_test.test_taking_a_row_apart(arena)
  surface_test.test_a_part_row_is_told_from_an_entry(arena)
  surface_test.test_what_a_file_says_of_itself(arena)
  // Writing the language tour (`tools/tour_page.kspls`).
  tour_page_test.test_a_step_per_described_declaration(arena)
  tour_page_test.test_the_page_holds_the_three(arena)
  oracle_test.test_compile_errors(arena)
  oracle_test.test_load_jsonl(arena)

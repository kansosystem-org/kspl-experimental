//< Runs Linux-only CI gates in the devcontainer, with build outputs isolated from the host
import "std/chars"
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/subproc"
import "std/sys"
import "tools/ci_gates"

priv const image: U8[] = "kanso-ci-local"
priv const work: U8[] = "/workspaces/kanso-ci"

priv fn call(argv: U8[][]): Bool //< streams a Docker command's progress and preserves its status
    code: = subproc.spawn_wait(argv, "") catch
        io.err().s("ci: cannot start Docker; install and start Docker with Linux containers\n")
        return false
    return code == 0

fn run(jobs: I64, arena: Arena$@): Bool //<
    //< builds the image, runs the gates, and collects their logs
    io.out().s("# --- Linux-only gates: building the Linux devcontainer image ---\n").flush()
    if !call(U8[][]::{ "docker", "build", "--platform=linux/amd64", "--tag", image, "--file",
        ".devcontainer/Dockerfile", ".devcontainer" })
        return false
    $buf: U8[4096] = ::{}
    root: = sys.cwd(U8$[]::buf)
    if root.len == 0
        io.err().s("ci: cannot read the checkout's absolute path for Docker\n")
        return false
    // Docker's --mount is CSV, while argv itself passes straight to Docker, without a shell.
    mount: = arena.text().s("type=bind,\"source=").s(root.replace("\"", "\"\"", arena))
        .s("\",target=/source,readonly").take()
    command: = arena.text().s("mkdir -p ").s(work)
        .s(" && tar -C /source --exclude=./out -cf - . | tar -C ").s(work).s(" -xf - && cd ")
        .s(work).s(" && make LOGGING=1 TEST_JOBS=\{jobs\} ci-linux-only").take()
    made: = subproc.run_capture(U8[][]::{ "docker", "create", "--platform=linux/amd64",
        "--cap-add=SYS_PTRACE", "--security-opt=seccomp=unconfined", "--mount", mount, image, "bash",
        "-o", "pipefail", "-c", command }, "", 60000, 1024 * 1024, arena)
    if made.spawn_failed || made.timed_out || made.exit_code != 0
        io.err().s("ci: cannot create the Linux devcontainer\n").s(made.text(arena)).c('\n')
        return false
    id: = (U8[]::made.stdout_data).trim_spaces()
    // Copy only logs back: Linux executables must never replace the host's compiler or tests.
    ran: = call(U8[][]::{ "docker", "start", "--attach", id })
    logs: = fs.join(root, "out/log", arena)
    copied: =
        call(U8[][]::{ "docker", "cp",
        arena.text().s(id).s(":").s(work).s("/out/log/.").take(), logs })
    removed: = call(U8[][]::{ "docker", "rm", "--force", id })
    $complete: = true
    for g in ci_gates.gates
        if g.shard == ci_gates.Shard.linux &&
            (!fs.exists(ci_gates.log_path(g.log, arena)) ||
            !fs.exists(ci_gates.end_path(g.log, arena)))
            io.err().s("ci: the Linux devcontainer left no completed log for \{g.log\}\n")
            complete = false
    return ran && copied && removed && complete

//< What one explanation of a make target has read, and the settings the target takes
//< `tools/make_explain.kspl` prints the rest. This file holds the run of make, the report the
//< printing shares, and the part read for its own reason: who receives each setting, and what
//< leaving it out does. The reasons are "Explaining a make target" in `tools/docs/DESIGN-tools.md`.
import "std/chars"
import "std/ds" { List, Map }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/subproc"
import "std/sys"
import "tools/make_db" + { Assign, Db, Entry, Rule_line, Var }

priv const OUTPUT_CAP: Sz = 256 * 1024 * 1024 //< the bytes of make's output kept; a database is MBs
priv const MAKE_WAIT_MS: I32 = 120000 //< how long one run of make may take
priv const VALUE_CUT: Sz = 160 //< how many bytes of a value one line shows
struct Call //< how make is run: the program, the folder, the settings, the target
    make: U8[]
    dir: U8[] //< the folder whose make file is read; empty for the current one
    sets: List<|U8[]|> //< `NAME=value`, as given on the command line
    target: U8[]
    quiet: List<|U8[]|> //< names the caller sets for itself, not reported as settings

fn run_make(c: Call@, args: U8[][], with_sets: Bool, arena: Arena$@): subproc.Run_result //<
    //< Runs make with these arguments, the settings (unless `with_sets` is false) and nothing else
    //< **No recipe line runs**: make runs a line holding `$(MAKE)`, or starting with `+`, even
    //< under `-n` and `-q`, and it remakes an included make file. So every target's shell is one
    //< that does nothing. It is set per target, so a `$(shell)` read while make parses still runs
    //< as the build has it, and the values stay the build's. **It is `override`**: a `SHELL=` the
    //< person gives is handed on, and would otherwise beat a target's own value.
    $argv: = List<|U8[]|>(arena)
    argv.push(c.make)
    argv.push("--no-print-directory")
    argv.push("--eval=%: override SHELL := true")
    if c.dir.len > 0
        argv.push("-C")
        argv.push(c.dir)
    for a in args
        argv.push(a)
    for s in c.sets
        if with_sets || c.quiet.contains(set_name(s))
            argv.push(s)
    r: =
        subproc.run_capture(argv.slice(), "", MAKE_WAIT_MS, OUTPUT_CAP, arena) catch
        io.err().s("make_explain: \{c.make\} could not be started; pass --make=<make>\n")
        sys.exit(2)
    return r

fn set_name(s: U8[]): U8[] //< the name a `NAME=value` sets
    return s.sub(0, s.find_char('=').unwrap_or(s.len)).strip_suffix(":").strip_suffix("?")
        .strip_suffix("+")

struct Report //< what one explanation has read, for the printing to share
    c: Call@
    db: Db
    base: Db //< the database with none of the person's settings, for the defaults
    files: List<|U8[]|> //< the make files make read, in its order
    sources: Map<|U8[], List<|make_db.Source_line|>|> //< each make file's lines, by its path
    rules: List<|Rule_line|> //< every rule line of every make file
    assigns: List<|Assign|> //< every line of every make file that sets a variable
    now: Map<|U8[], U8[]|> //< what make expands a recursive variable to, where it is safe to ask
    now_names: List<|U8[]|> //< the names `now` holds, in the order they were asked

fn shown_path(r: Report@, file: U8[], arena: Arena$@): U8[] //< a make file's path, from here
    if r.c.dir.len == 0 || sys.is_absolute(file)
        return file
    return fs.join(r.c.dir, file, arena)

fn read_sources(r: Report$@, arena: Arena$@) //< reads every make file make read, and its rules
    list: = r.db.vars.get("MAKEFILE_LIST") catch
        return
    for file in make_db.words(list.value, arena)
        if r.sources.get(file).is_some()
            continue
        text: = io.read_file(shown_path(r, file, arena), arena) catch
            continue
        lines: = make_db.logical_lines(text, arena)
        r.files.push(file)
        r.sources.set(file, lines)
        for l in lines
            if rule: = make_db.rule_of(l, file)
                r.rules.push(rule)
        for a in make_db.assignments(lines@, file, arena)
            r.assigns.push(a)

fn pad(s: U8[], n: Sz, arena: Arena$@): U8[] //< the text, with spaces after it up to n bytes
    if s.len >= n
        return s
    return arena.text().s(s).s("                                        ".sub(0, n - s.len)).take()

fn var_of(r: Report@, name: U8[], e: Entry): Var? //< the variable, its own target's first
    for v in e.vars
        if v.name.equals(name)
            return .some(v)
    return r.db.vars.get(name)

fn collect(r: Report@, names: List<|U8[]|>, into: List<|U8[]|>$@, depth: Sz, arena: Arena$@) //<
    //< Every name reached from these, each once: through values, the lines that set them, and the
    //< conditionals around those lines (`LLVM` decides `BACKEND` through `ifeq ($(LLVM),1)`)
    if depth > 8
        return
    for n in names
        if into.contains(n)
            continue
        into.push(n)
        $value: U8[] = ""
        if v: = r.db.vars.get(n)
            value = v.value
        collect(r, made_of(r, n, value, arena), into, depth + 1, arena)

fn invocation(r: Report@, arena: Arena$@): U8[] //<
    //< how a person types it: `chat`, `-C ksmd test`
    if r.c.dir.len == 0
        return r.c.target
    return arena.text().s("-C ").s(r.c.dir).s(" ").s(r.c.target).take()

fn made_of(r: Report@, n: U8[], value: U8[], arena: Arena$@): List<|U8[]|> //<
    //< The names a variable's value reads, then what its lines write and their conditionals read
    //< **A simple variable's value is already expanded**, so the names it was made of are read
    //< from the lines that set it (`BOOT_CFLAGS := $(CFLAGS)`).
    $out: = make_db.refs(value, arena)
    for a in r.assigns
        if a.name.equals(n)
            for m in make_db.refs(a.value, arena)
                if !out.contains(m) && !m.equals(n)
                    out.push(m)
            for c in conds_shown(r, a, arena)
                for m in make_db.cond_refs(c.text, arena)
                    if !out.contains(m) && !m.equals(n)
                        out.push(m)
    return out

fn conds_shown(r: Report@, a: Assign, arena: Arena$@): List<|make_db.Cond|> //<
    //< The conditionals around a line that read a setting, leaving out those that read only the
    //< caller's own names (the root's `ifndef LOGGING`, which every line stands inside)
    $out: = List<|make_db.Cond|>(arena)
    for c in a.conds
        for m in make_db.cond_refs(c.text, arena)
            if !r.c.quiet.contains(m)
                out.push(c)
                break
    return out

priv fn reached(r: Report@, names: List<|U8[]|>@, arena: Arena$@): List<|U8[]|> //<
    //< Every name reached from these (`collect`)
    $all: = List<|U8[]|>(arena)
    collect(r, names$, all@, 0, arena)
    return all

fn written_op(r: Report@, file: U8[], line: Sz): U8[] //< the operator the file's line uses
    lines: = r.sources.get(file) catch
        return ""
    for l in lines
        if l.first == line
            return make_db.source_op(l.text)
        if l.first > line
            break
    return ""

fn cut(value: U8[], arena: Arena$@): U8[] //< the value as one line of at most `VALUE_CUT`
    $first: = value
    $more: U8[] = ""
    if nl: = value.find_char('\n')
        first = value.sub(0, nl)
        more = arena.text().s(" ... (\{value.count_str("\n") + 1\} lines)").take()
    if first.len > VALUE_CUT
        $end: = VALUE_CUT
        for end > 0 && (first[end] & 0xc0U8) == 0x80U8
            end -= 1
        more = arena.text().s(" ... (\{make_db.words(value, arena).len\} words)").take()
        first = first.sub(0, end)
    if first.len == 0 && more.len == 0
        return "(empty)"
    return arena.text().s(first).s(more).take()

// ==========================================
// The settings a person can give
// ==========================================

fn print_settings(r: Report@, e: Entry, names: List<|U8[]|>@, arena: Arena$@) //<
    //< The names it reads that the command line is meant to set: unset ones, `?=` defaults, and
    //< those given on the command line or taken from the environment
    all: = reached(r, names, arena)
    $settings: = List<|U8[]|>(arena)
    for n in all
        if !r.c.quiet.contains(n) && is_setting(r, n, e)
            settings.push(n)
    io.out().s("\nSettings (make ").s(invocation(r, arena)).s(" <NAME>=<value>)\n")
    if settings.len == 0
        io.out()
            .s("  none: nothing it reads is unset, set with ?=, given, or taken from the \
                environment\n")
    $programs: = List<|U8[]|>(arena)
    for n in settings
        print_setting(r, n, e, all@, programs@, arena)
    for prog in programs
        print_program(r, prog)
    for s in r.c.sets
        name: = set_name(s)
        if !r.c.quiet.contains(name) && !all.contains(name)
            io.out().s("  ").s(name).s(" is given, but ").s(r.c.target).s(" reads no ").s(name)
                .s(nearest_var(name, all@, arena)).s("\n")

priv fn is_setting(r: Report@, n: U8[], e: Entry): Bool //<
    //< whether the command line is meant to set it
    v: = var_of(r, n, e) catch
        return true
    if v.origin.equals("command line") || v.origin.starts_with("environment")
        return true
    return v.origin.equals("makefile") && written_op(r, v.file, v.line).equals("?=")

priv fn print_setting(r: Report@, n: U8[], e: Entry, all: List<|U8[]|>@,
    programs: List<|U8[]|>$@, arena: Arena$@) //<
        //< One setting: its value or default, what leaving it out does, and who reads it
    o: = io.out()
    o.s("  ").s(pad(n, 10, arena)).s("  ")
    given: = var_of(r, n, e)
    base: = r.base.vars.get(n)
    $said: = false
    if g: = given
        if g.origin.equals("command line")
            o.s("given: ").s(cut(g.value, arena)).s(". ")
            said = true
        else if g.origin.starts_with("environment")
            o.s("from the environment: ").s(cut(g.value, arena)).s(". ")
            said = true
    if !said
        o.s("not given. ")
    if b: = base
        if b.origin.equals("makefile")
            o.s("The default is ").s(cut(b.value, arena)).s(" (")
                .s(written_op(r, b.file, b.line)).s(" at ").s(shown_path(r, b.file, arena))
                .s(":\{b.line\}).")
        else if !b.origin.equals("command line")
            o.s("Left out, the environment's value holds.")
    else
        o.s("There is no default: left out, $(").s(n).s(") is empty")
            .s(empty_effect(r, n, arena)).s(".")
    o.s("\n")
    for prog in readers(r, n, e, arena)
        o.s("              read by ").s(prog).s("\n")
        if !prog.starts_with("the recipe's") && !programs.contains(prog)
            programs.push(prog)
    print_deciders(r, n, all, arena)

priv fn print_deciders(r: Report@, n: U8[], all: List<|U8[]|>@, arena: Arena$@) //<
    //< The conditionals that read it, and which of the variables reached they decide
    $at: = List<|U8[]|>(arena)
    $decides: = List<|U8[]|>(arena)
    for a in r.assigns
        if !all.contains(a.name)
            continue
        for c in a.conds
            if !make_db.cond_refs(c.text, arena).contains(n)
                continue
            key: = arena.text().s("`").s(c.text).s("` at ").s(shown_path(r, a.file, arena))
                .s(":\{c.line\}").take()
            $k: Sz = 0
            for k < at.len && !at.get(k).equals(key)
                k += 1
            if k == at.len
                at.push(key)
                decides.push(a.name)
            else
                $listed: = false
                for d in decides.get(k).split(',', arena)
                    listed = listed || d.trim_spaces().equals(a.name)
                if !listed
                    decides.set(k,
                        arena.text().s(decides.get(k)).s(", ").s(a.name).take())
    for k in Range.asc(at.len)
        io.out().s("              read by ").s(at.get(k)).s(", which decides ")
            .s(decides.get(k)).s("\n")

priv fn empty_effect(r: Report@, n: U8[], arena: Arena$@): U8[] //< what its being empty makes empty
    out: = arena.text()
    $count: Sz = 0
    for name in r.now_names
        v: = r.db.vars.get(name) catch
            continue
        now: = r.now.get(name).unwrap_or("x")
        if now.trim_spaces().len == 0 && make_db.refs(v.value, arena).contains(n)
            out.s(", so " if count == 0 else ", ").s(name)
            count += 1
    if count > 0
        out.s(" expands to nothing" if count == 1 else " expand to nothing")
    return out.take()

priv fn readers(r: Report@, n: U8[], e: Entry, arena: Arena$@): List<|U8[]|> //<
    //< Who receives it: the program each recipe line that reaches it starts, or its shell code
    $out: = List<|U8[]|>(arena)
    shell: = arena.text()
    $shell_lines: Sz = 0
    $line_no: Sz = 0
    for line in recipe_lines(e, arena)
        line_no += 1
        $reach: = List<|U8[]|>(arena)
        collect(r, make_db.refs(line, arena), reach@, 0, arena)
        if !reach.contains(n)
            continue
        prog: = program_of(r, line, 0, arena)
        if prog.len == 0
            shell.s(", " if shell_lines > 0 else "").s("\{line_no\}")
            shell_lines += 1
        else if !out.contains(prog)
            out.push(prog)
    if shell_lines > 0
        out.insert(0,
            arena.text().s("the recipe's shell code (line").s("s" if shell_lines > 1 else "").s(" ")
            .s(shell.take()).s(")").take())
    return out

priv fn recipe_lines(e: Entry, arena: Arena$@): List<|U8[]|> //< its recipe, continuations joined
    $out: = List<|U8[]|>(arena)
    $joined: = arena.text()
    $open: = false
    for l in e.recipe
        if l.ends_with("\\")
            joined.s(l.sub(0, l.len - 1)).c(' ')
            open = true
            continue
        joined.s(l)
        out.push(joined.take())
        joined = arena.text()
        open = false
    if open
        out.push(joined.take())
    return out

priv const SHELL_WORDS: U8[][] = U8[][]::{ "if", "then", "else", "elif", "fi", "for", "while",
    "until", "do", "done", "case", "esac", "[", "[[", "test", "echo", "printf", "exit", "set", "cd",
    "true", "false", ":", "command", "{", "}", "(", ")", "export", "unset", "read", "return",
    "shift", "trap", "eval", "exec", "source", ".", "local" } //<
        //< The shell's own words and builtins: a line starting with one runs no program of its own

priv fn program_of(r: Report@, line: U8[], depth: Sz, arena: Arena$@): U8[] //<
    //< The program a recipe line starts; empty where the line is the shell's own code
    $t: = line.trim_start()
    for t.len > 0 && (t[0] == '@' || t[0] == '-' || t[0] == '+')
        t = t.sub_from(1).trim_start()
    $first: U8[] = ""
    for w in shell_words(t, arena)
        // `NAME=value` in front of a command sets the shell's environment for it.
        eq: = w.find_char('=')
        if eq.is_some() && !w.starts_with("-") && !w.starts_with("$") && first.len == 0
            continue
        first = w
        break
    // A variable, or a function `$(call)`s, in the command's place: the command is in its value.
    $name: U8[] = ""
    if first.starts_with("$(call ")
        rest: = first.sub_from(7)
        name = rest.sub(0,
            rest.find_char(',').unwrap_or(rest.find_char(')').unwrap_or(0)))
    else if first.starts_with("$(") && first.ends_with(")")
        name = first.sub(2, first.len - 3)
    if name.equals("MAKE")
        return "a sub-make ($(MAKE))"
    if name.len > 0 && depth < 4
        if v: = r.db.vars.get(name)
            return program_of(r, r.now.get(name).unwrap_or(v.value), depth + 1, arena)
    $word: = first.strip_prefix("\"").strip_suffix("\"").strip_prefix("'").strip_suffix("'")
    if filled: = make_db.expand(word, r.db@, 0, arena)
        word = filled
    if SHELL_WORDS.contains(word)
        return ""
    return word

priv fn shell_words(text: U8[], arena: Arena$@): List<|U8[]|> //< a command line's words
    //< A space inside quotes or inside `$(…)` does not end a word.
    $out: = List<|U8[]|>(arena)
    $start: Sz = 0
    $depth: Sz = 0
    $quote: U8 = 0
    for i in Range.asc(text.len + 1)
        end: = i == text.len
        ch: U8 = 0 if end else text[i]
        if !end && quote != 0
            if ch == quote
                quote = 0
            continue
        if ch == '"' || ch == '\''
            quote = ch
        else if ch == '('
            depth += 1
        else if ch == ')'
            depth -= 1
        else if end || ch.is_space() && depth <= 0
            if i > start
                out.push(text.sub(start, i - start))
            start = i + 1
    return out

priv fn print_program(r: Report@, prog: U8[]) //< what builds a program, and its help
    o: = io.out()
    if prog.starts_with("a sub-make")
        o.s("  A sub-make is handed them on its command line: `make explain T=<folder>:<target>`")
            .s(" explains the target it makes.\n")
        return
    path: = prog.strip_prefix("./")
    o.s("  ").s(prog).s(" decides the rest: `").s(prog).s(" --help` tells what it does with them")
    if pe: = r.db.files.get(path)
        for p in pe.prereqs
            if src: = r.db.files.get(p)
                if src.recipe_line == 0 && !src.phony && !src.target
                    o.s("; make builds it from ").s(p)
                    break
    o.s(".\n")

priv fn nearest_var(name: U8[], read: List<|U8[]|>@, arena: Arena$@): U8[] //<
    //< That the setting changes nothing, and the name it reads nearest to the one given
    $best: U8[] = ""
    $best_d: Sz = 3
    for n in read$
        d: = make_db.distance(name, n, arena)
        if d < best_d
            best = n
            best_d = d
    if best.len == 0
        return ": the setting changes nothing here"
    return arena.text().s(": the setting changes nothing here (the nearest name it reads is ")
        .s(best).s(")").take()

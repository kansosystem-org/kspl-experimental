#!/usr/bin/env -S ksplc run
//< Opens one document in kspage
//<
//< It starts the local server, builds the URL to open, and passes it to the browser.
//< **This is a leaf**: neither `kspage` nor `kssrv` knows the other, so only this file may know
//< both ("Reference direction between documents" in `docs/SPEC-documents.md`).
//< Note: So the URL's format is known in one place, `make kspage` uses this tool too.
//< **The path is built in `tools/kspage_aim.kspl`**, which handles only paths so that a test can
//< check it. `--list`, `--stop=<folder>` and `--stop-all` tend the servers it left (`tend`).

// ==========================================
// Caution: **Do not pass the token on the command line**: `ps` shows it to every user. This tool
// reads it from the line kssrv prints once at start-up. It writes it to the note for the next run,
// and hands it to the browser inside a page (`aim.page_text`).
// ==========================================
// **The note, the log and the page are as sensitive as the token.** Each is written for its owner
// alone (`aim.write_owned`, `aim.write_page`).
// ==========================================
import "std/argparse"
import "std/chars"
import "std/fs"
import "std/http"
import "std/io"
import "std/mem" { Arena }
import "std/net"
import "std/str" { Str_builder }
import "std/strfmt" as _strfmt
import "std/subproc"
import "std/sys"
import "tools/kspage_aim" as aim

priv const SERVER_NAMES: U8[][] = U8[][]::{ "kssrv.exe", "kssrv" } //<
    //< The server names looked for next to this program
    //<
    //< Caution: **Look next to this program first**: from a double click, the working directory is
    //< home or `/`. Under `ksplc run` the program is built in a scratch folder, so `out/` under the
    //< working directory is checked too; make runs from the repository's root.
priv const SERVER_NEAR: U8[] = "out"

priv const PAGE_REL: U8[] = "kspage_web/kspage.html" //<
    //< Where the built page is (relative to the server's folder)
    //<
    //< Caution: **Do not copy it into the served folder.** The page and the documents are served
    //< from different places; requiring "under the root" would copy a 2MB page into the user's
    //< folder. kssrv returns the file named by `--page` for `/` (the agreement is "Where it
    //< listens" in `docs/SPEC-local-server.md`).

priv const TREE_MARK: U8[] = "std" //< the folder that marks a KSPL tree
    //<
    //< Caution: **Serve the tree's root when the document is inside a tree.** The server refuses
    //< anything outside its root (that is the boundary). So if only the document's folder is
    //< served, nothing else in the tree can be opened.

priv const MAX_CLIMB: Sz = 32 //< the cap on how many folders up to look for the tree's root
    //<
    //< Caution: **Do not climb without limit** (it must stop even at `/`).
priv const DEFAULT_PORT: U8[] = "8080" //< the default port to listen on
    //<
    //< **Keep it equal to `make kspage`'s `KSPAGE_SERVE_PORT`** (or make and a direct run start
    //< different servers).

priv const IDLE_HOLD: U8[] = "300" //< how long the server waits with no page holding it [s]
    //<
    //< **A page holds the server open while it is open.** So this covers only two gaps: before the
    //< first page (a cold browser start), and after the last, when the next document reuses it.

priv const TMP_REL: U8[] = "tmp" //< where the log, the note and the handed pages live
    //<
    //< **It is `tmp/` next to the server** (relative to the working directory, a double click would
    //< scatter them under home).
priv const LOG_PREFIX: U8[] = "kspage_open." //< a server's log is this, its port and `.log`
    //<
    //< **A log per server, named by its port**: one log shared by every run lets a run read the
    //< URL another run's server printed. A port is chosen free under the lock (`open_or_start`).
    //< Its server holds it from then on. So no two running servers share a name, and the logs
    //< number no more than the ports tried.
priv const LOG_EXT: U8[] = ".log"
priv const STATE_REL: U8[] = "tmp/kspage_open.state" //< the note of the running servers
    //<
    //< Its format is at `aim.state_count`.
priv const LOCK_REL: U8[] = "tmp/kspage_open.lock" //< the lock on the note (`open_or_start`)
priv const BROWSER_REL: U8[] = "tmp/kspage_open.browser.log" //<
    //< Where the browser's start-up output is kept
    //<
    //< Caution: **Do not throw it away** (when it cannot start, it says what is missing).
priv const WAIT_STEPS: Sz = 300
priv const PORT_TRIES: I32 = 16 //< how many ports, counting up from the one named, are tried
    //<
    //< **Do not give up after one** (the reason is at `free_port`).

priv const OPENERS: U8[][] = U8[][]::{ "xdg-open", "open" } //< the tools that start a browser
    //<
    //< Caution: **Try the ones that exist, in turn** (with only one, nothing happens, silently,
    //< where it is missing). macOS has `open`, the others `xdg-open`.
priv const OPENERS_WIN: U8[][] = U8[][]::{ "explorer" } //< the tool that starts one on Windows
    //<
    //< **Do not work around it by turning the quoting off** (the quoting blocks argument
    //< injection). `explorer.exe` is a real executable, so one URL is enough to reach the default
    //< browser. **Keep a separate list per environment.** A tool that starts counts as "passed on",
    //< so an earlier tool in the list that is there but opens nothing would end the search.

struct Where //< every path this run needs, found once
    //<
    //< **Find them once and pass them around** (looked up in two places, only one gets fixed).
    server: U8[] //< the path of the server to start
    tmp: U8[] //< the folder the pages handed to the browser and the servers' logs go in
    state: U8[] //< where the note of the running servers is kept
    lock: U8[] //< the lock held while the note is read and written
    browser: U8[] //< the path of the browser's start-up output
    page: U8[] //< the page returned for `/`; without it nothing opens (`make kspage-web` first)

priv fn where_from(argv0: U8[], arena: Arena$@): Where //<
    //< Finds the server and the paths next to it
    //<
    //< **Where it is not found, `server` is empty.**
    for dir in U8[][]::{ aim.parent_of(argv0), SERVER_NEAR }
        for one in SERVER_NAMES
            at: = fs.join(dir, one, arena)
            if fs.can_run(at)
                home: = aim.parent_of(at)
                return Where::{ .server = at, .tmp = fs.join(home, TMP_REL, arena),
                    .state = fs.join(home, STATE_REL, arena),
                    .lock = fs.join(home, LOCK_REL, arena),
                    .browser = fs.join(home, BROWSER_REL, arena),
                    .page = fs.join(home, PAGE_REL, arena) }
    return Where::{ .server = "", .tmp = "", .state = "", .lock = "", .browser = "", .page = "" }

priv fn full(p: U8[], arena: Arena$@): U8[] //<
    //< Turns a relative path into an absolute one, from the working directory
    //<
    //< **Compare the note by absolute paths**: `.` and `/home/me/devel` stored as given would start
    //< two servers for one folder.
    //< Caution: **Do not join a `.` unchanged** (`fs.join` makes `/home/me/devel/.`, yet another
    //< string).
    dir: = aim.trim_end_sep(p)
    if sys.is_absolute(dir)
        return dir
    $buf: U8[4096] = ::{}
    at: = sys.cwd(U8$[]::buf) catch
        return dir
    return arena.dup_str(at) if dir.equals(".") else fs.join(at, dir, arena)

priv fn tree_root(from: U8[], arena: Arena$@): U8[] //<
    //< The tree's root, when that document is inside a KSPL tree
    //<
    //< **Empty where there is none** (then the document's folder is served: it opens, but with no
    //< jump to a definition). The mark is `std/` (the reason is at `TREE_MARK`).
    //< Caution: **Do not decide it from the document's own path**: being a KSPL source is
    //< irrelevant.
    $at: U8[] = from
    for $step: Sz = 0; step < MAX_CLIMB; step += 1
        if at.len == 0
            break
        if fs.is_dir(fs.join(at, TREE_MARK, arena))
            return at
        up: = aim.parent_of(at)
        if up.equals(at)
            break
        at = up
    return ""

priv const ANSWER_WAIT_MS: I32 = 10000 //< how long a local server may take to answer one request

priv fn ask(at: I32, token: U8[], method: U8[], target: U8[]): I32 //<
    //< Sends one request with our token to the server on that port, and returns the status
    //<
    //< **0 where nothing answered** (nothing listens there, or it closed without an answer).
    arena: = Arena.new(16 * 1024)
    defer arena.free()
    stream: = net.Tcp_stream.connect("127.0.0.1", at) catch
        return 0
    defer stream.free()
    $bearer: = Str_builder.new()
    bearer.s("Bearer ").s(token)
    head: = http.headers(arena).add("Host", "127.0.0.1").add("Authorization", bearer.slice())
        .build()
    http.write_request(stream, method, target, head, "") catch
        return 0
    // **A server that takes the request and goes quiet is no answer**: bounded, not waited on.
    answer: =
        http.read_response(stream, arena, http.DEFAULT_MAX_BODY_BYTES, ANSWER_WAIT_MS) catch
        return 0
    return answer.status

priv fn server_answers(at: I32, token: U8[]): Bool //<
    //< Whether that server is alive and accepts our token
    //<
    //< Caution: **Check the token too.** An open port alone does not tell whether some other
    //< program listens there; `/api/status` needs a token in local use, so a 200 means kssrv.
    return ask(at, token, "GET", "/api/status") == 200

priv const GONE_STEPS: Sz = 50 //< how many times, 100ms apart, a stopped server is looked for

priv fn stop_server(at: I32, token: U8[]): Bool //<
    //< asks that server to stop, and waits until it has
    //<
    //< Caution: **Do not report a stop that was only answered.** The server answers before it stops
    //< ("Stopping it when asked" in `docs/SPEC-local-server.md`), so it is looked for until it is
    //< gone.
    if ask(at, token, "POST", "/api/stop") != 200
        return false
    for $step: Sz = 0; step < GONE_STEPS; step += 1
        if !server_answers(at, token)
            return true
        sys.sleep_ms(100)
    return false

priv fn tend(where: Where, stop_root: U8[], stop_all: Bool): I32 //<
    //< Lists the servers in the note that still answer, or stops the ones asked for
    //<
    //< **Only a server that answers with its token is running**: a record outliving its server is
    //< dropped from the note, never listed. **A server is picked by the folder it serves**, the key
    //< the reuse looks it up by. Its port is no key: it changes from run to run.
    //< Returns the exit code.
    // **Under the lock** (the reason is at `open_or_start`): a record written meanwhile would be
    // lost to this rewrite.
    $lock: = fs.File_lock.take(where.lock) catch
        io.err().s("\{sys.program_name()\}: cannot take the lock on the note: \{where.lock\}\n")
        return 1
    defer lock.free()
    body: = io.read_file(where.state) catch ""
    listing: = stop_root.len == 0 && !stop_all
    $kept: = Str_builder.new()
    $stopped: Sz = 0
    $failed: = false
    count: = aim.state_count(body)
    for $i: Sz = 0; i < count; i += 1
        one: = aim.state_record(body, i)
        at: = aim.port_num(aim.port_in_url(one[0]))
        token: = aim.token_in_url(one[0])
        if at == 0 || !server_answers(at, token)
            continue
        picked: = !listing && (stop_all || one[1].equals(stop_root))
        if !picked
            if listing
                io.out().s("\{one[0]\} \{one[1]\}\n")
            aim.state_put(kept@, one[0], one[1])
            continue
        if stop_server(at, token)
            io.out().s("\{sys.program_name()\}: stopped the server serving \{one[1]\}\n")
            stopped += 1
            continue
        io.err().s("\{sys.program_name()\}: the server serving \{one[1]\} did not stop\n")
        aim.state_put(kept@, one[0], one[1])
        failed = true
    if body.len > 0
        aim.write_owned(where.state, kept.slice()) catch
            io.err().s("\{sys.program_name()\}: cannot write the note: \{where.state\}\n")
    if failed
        return 1
    if stopped == 0 && !listing
        if stop_all
            io.err().s("\{sys.program_name()\}: no server is running\n")
            return 0
        // Caution: **A folder with no server is a failure**: a mistyped folder must not read as
        // done.
        io.err().s("\{sys.program_name()\}: no server is serving \{stop_root\}\n")
        return 1
    if listing && kept.len == 0
        io.err().s("\{sys.program_name()\}: no server is running\n")
    return 0

priv fn reusable(root: U8[], state_path: U8[]): U8[] //<
    //< Returns the URL of a server in the note that can reach this document
    //<
    //< **Only a server for the same folder** (kssrv refuses anything outside its root). **The port
    //< is not compared**; the port named is only where a new server starts looking (`free_port`).
    body: = io.read_file(state_path) catch
        return ""
    count: = aim.state_count(body)
    for $i: Sz = 0; i < count; i += 1
        one: = aim.state_record(body, i)
        if !one[1].equals(root)
            continue
        at: = aim.port_num(aim.port_in_url(one[0]))
        if at != 0 && server_answers(at, aim.token_in_url(one[0]))
            return one[0]
    return ""

priv fn free_port(from: I32, arena: Arena$@): U8[] //<
    //< looks for a port that can be listened on
    //<
    //< **Empty where there is none.**
    //< Caution: **Do not give up after one.** Something can already listen on the port named (our
    //< own server for another folder included). kssrv then fails silently, and 30 seconds are lost
    //< **each time a document from another folder opens**. So the next port is tried, as Jupyter
    //< and Vite do.
    for $step: I32 = 0; step < PORT_TRIES; step += 1
        at: = from + step
        // Caution: **Do not check it by connecting**: the question is "can we listen", and binding
        // as kssrv does asks exactly that.
        probe: = net.Tcp_listener.bind("127.0.0.1", at) catch
            continue
        probe.free()
        return arena.text().s("\{at\}").take()
    return ""

priv fn hand_to_browser(open_url: U8[], where: Where, arena: Arena$@): Bool //<
    //< Passes the URL to the browser, inside a page
    //<
    //< Caution: **Hand the browser the page, never the URL** (the reason is at `aim.page_text`).
    //< Caution: **Try the tools in turn, from the list for this environment** (the reasons are at
    //< `OPENERS` and `OPENERS_WIN`). Keep their output (the reason is at `BROWSER_REL`).
    aim.sweep_pages(where.tmp, sys.wall_seconds(), arena)
    // **Hand it an absolute path**: a browser already running reads a relative one from its own
    // working folder.
    dir: = fs.absolute(where.tmp, arena) catch where.tmp
    page: = aim.write_page(open_url, dir, arena) catch
        io.err()
            .s("\{sys.program_name()\}: cannot write the page for the browser in \{where.tmp\}\n")
        return false
    // A tool that is not there fails to start, on every OS, and the next one is tried.
    for tool in OPENERS_WIN if sys.is_windows() else OPENERS
        way: = aim.browser_argv(tool, page, sys.is_windows(), arena)
        _h: =
            subproc.spawn_redirect(U8[][]::way, "", where.browser, where.browser) catch
            continue
        return true
    return false

priv fn tell_how(doc: U8[], handed: U8[]) //< the instructions printed after it opens
    //<
    //< **Say to pass the URL on to its very end**: a page missing the token part looks open yet
    //< cannot read a single file.
    //< Caution: **Say how to open it by hand even when the browser was started** (`handed` not
    //< empty).
    io.out().s("\n")
    io.out().s("  * this page opens \{doc\} itself\n")
    io.out().s("  * Ctrl+S saves, Ctrl+F finds, and the ribbon's tabs hold the rest\n")
    io.out()
        .s("  * hand the URL over to its very end (drop the token part and the page cannot read a \
            file)\n")
    if handed.len > 0
        io.out()
            .s("  * where nothing shows, open the URL above yourself (what starting it said: \
                \{handed\})\n")

priv fn hand_and_tell(open_url: U8[], doc: U8[], show_only: Bool, where: Where, arena: Arena$@) //<
    //< Passes the URL to the browser and prints the instructions
    //<
    //< Caution: **Do not copy it into two places.** Both the "reused" and the "started" paths need
    //< it; copied, only one gets fixed. With `--show`, nothing is passed to the browser.
    $handed: U8[] = ""
    if !show_only
        if hand_to_browser(open_url, where, arena)
            handed = where.browser
        else
            io.err()
                .s("\{sys.program_name()\}: could not start a browser. Please open the URL above\n")
    tell_how(doc, handed)

priv fn wait_for_url(log: U8[], child: subproc.Child$@): U8[] //<
    //< The URL the server writes to its log once it is up, or "" after `wait_steps` tries
    //<
    //< **"" at once where the server has exited**: the lock is held meanwhile, so every other open
    //< would wait out the rest of the tries too.
    for _step in Range.asc(WAIT_STEPS)
        url: = aim.url_in_log(io.read_file(log) catch "")
        if url.len > 0
            return url
        if !child.alive()
            return ""
        sys.sleep_ms(100)
    return ""

priv fn relay_log(log: U8[], child: subproc.Child$@) //<
    //< It passes the server's log on to the output as it grows, until the server exits
    //<
    //< **`make kspage` watches this output**, so the server's output is passed through unchanged
    //< (otherwise the lines about who connected reach nobody).
    $sent: Sz = 0
    for
        seen: = io.read_file(log) catch
            sys.sleep_ms(200)
            continue
        if seen.len > sent
            io.out().s(seen.sub_from(sent))
            sent = seen.len
        if !child.alive()
            return
        sys.sleep_ms(200)

struct Opened //< the server a run opens its document on
    url: U8[] //< the URL it printed, token included; empty where none could be had
    log: U8[] //< its log; empty for a server reused
    child: subproc.Child? //< the server this run started; none for one reused

priv fn open_or_start( //< finds the server for `root` in the note, or starts one and notes it
    //<
    //< Caution: **Hold the lock from the search to the note's write.** Documents opened together
    //< would otherwise each start a server, and one record overwrite another: a server nobody can
    //< list, stop or reuse. **The OS lets the lock go however the process ends** (`fs.File_lock`),
    //< so none is left stale for a later run to clear.
    where: Where,
    root: U8[], //< the folder to serve, absolute
    at: U8[], //< the port named, where a new server starts looking (`free_port`)
    show_only: Bool, //< `--show`: the server gets no idle stop
    arena: Arena$@,
): Opened
    $lock: = fs.File_lock.take(where.lock) catch
        io.err().s("\{sys.program_name()\}: cannot take the lock on the note: \{where.lock\}\n")
        return Opened::{ .url = "", .log = "", .child = .none }
    defer lock.free()
    // A running server is reused; starting one without looking piles up a server per document,
    // their ports colliding (a common complaint about notebook servers).
    had: = reusable(root, where.state)
    if had.len > 0
        return Opened::{ .url = had, .log = "", .child = .none }
    serve_at: = free_port(aim.port_num(at), arena)
    if serve_at.len == 0
        io.err()
            .s("\{sys.program_name()\}: nothing free in the \{PORT_TRIES\} numbers from \{at\}\n")
        return Opened::{ .url = "", .log = "", .child = .none }
    // Caution: **Send the output to a file**: the token appears only on that one line. **Make it
    // for its owner alone first**; the server's output then goes into that file.
    log: = fs.join(where.tmp,
        arena.text().s(LOG_PREFIX).s(serve_at).s(LOG_EXT).take(), arena)
    aim.write_owned(log, "") catch
        io.err().s("\{sys.program_name()\}: cannot make the log: \{log\}\n")
        return Opened::{ .url = "", .log = "", .child = .none }
    // Caution: **Name the page from outside the root** (the reason is at `page_rel`).
    // **The idle stop is passed only when this tool exits** (with `--show`, Ctrl+C is right there;
    // `--idle` in `kssrv/main.kspl`).
    all: U8[][6] = ::{ where.server, serve_at, root, "--local",
        arena.text().s("--page=\{where.page\}").take(),
        arena.text().s("--idle=\{IDLE_HOLD\}").take() }
    told: = U8[][]::all
    argv: = told.sub(0, 5) if show_only else told
    $child: = subproc.spawn_redirect(argv, "", log, log) catch
        // **Say what to check.** Either the server or the log can be the cause. Naming one alone
        // leads to suspecting a file that is fine.
        io.err()
            .s("\{sys.program_name()\}: cannot start \{where.server\} (the log it points at: \
                \{log\})\n")
        return Opened::{ .url = "", .log = "", .child = .none }
    url: = wait_for_url(log, child@)
    if url.len == 0
        io.err().s("\{sys.program_name()\}: the server did not come up (\{log\})\n")
        return Opened::{ .url = "", .log = "", .child = .none }
    // Caution: **Write the note only after the server is up** (not for one that failed).
    // **Add to the existing records**; overwritten, an earlier server for another folder is lost,
    // holding its port with nobody able to reuse it.
    had_body: = io.read_file(where.state) catch ""
    $note: = Str_builder.new()
    aim.write_owned(where.state, aim.state_text(url, root, had_body, note@)) catch
        io.err().s("\{sys.program_name()\}: cannot write the note: \{where.state\}\n")
    return Opened::{ .url = url, .log = log, .child = .some(child) }

fn main(): I32 //< opens one document in kspage, starting the server and the browser as needed
    io.set_line_buffered()
    arena: = Arena.new(64 * 1024)
    defer arena.free()
    $show_only: = false
    $root_said: U8[] = ""
    $at: U8[] = DEFAULT_PORT
    // Caution: **Do not parse the arguments by hand.** `--root --show` would take the next item as
    // the value. The mistake would show 30 seconds later as "the server does not come up".
    p: = argparse.Parser
        .create(sys.program_name(), "open a document on a local server, or list and stop servers",
        arena)
    p.positional("<the document's path>")
    p.str_opt("--root", root_said@,
        "the folder to serve (default: the KSPL tree's root above that document, else its folder)")
    p.str_opt("--port", at@, "the number to wait on, or the next free one (default 8080)")
    p.flag("--show", show_only@, "put the URL out and wait (do not start a browser)")
    // **Listing and stopping take nothing else**: a document or an option beside them would do
    // nothing, and its writer would believe it had.
    $stop_said: U8[] = ""
    p.command_flag("--list", "put out each running server's URL and the folder it serves")
    p.str_opt("--stop", stop_said@, "stop the server serving that folder")
    p.command_flag("--stop-all", "stop every running server")
    p.parse_or_exit(sys.args(), arena)
    tending: = p.command.is_some() || p.saw("--stop")
    if tending &&
        (p.rest.len != 0 || p.saw("--root") || p.saw("--port") || p.saw("--show") ||
        p.command.is_some() && p.saw("--stop") || p.saw_empty("--stop"))
        io.err()
            .s("\{sys.program_name()\}: --list, --stop=<folder> and --stop-all each stand alone\n")
        return 1
    if !tending && p.rest.len != 1
        p.print_usage(io.err())
        return 1
    cmd: = sys.args()
    where: = where_from(cmd.get(0), arena)
    if where.server.len == 0
        io.err()
            .s("\{sys.program_name()\}: kssrv not found (`make kssrv` and `make kspage-web` \
                first)\n")
        return 1
    // **The writer creates the folder** (not every run goes through make); the lock stands there.
    fs.mkdir_all(where.tmp) catch {}
    if tending
        // Caution: **Make the folder absolute** (the reason is at `full`); the note holds it so.
        return tend(where, full(stop_said, arena) if stop_said.len > 0 else "",
            p.command.unwrap_or("").equals("--stop-all"))
    path: = p.rest.get(0)
    if aim.port_num(at) == 0
        io.err().s("\{sys.program_name()\}: that number cannot be waited on: \{at\}\n")
        return 1
    if !fs.exists(path)
        io.err().s("\{sys.program_name()\}: there is no such file: \{path\}\n")
        return 1
    if !fs.exists(where.page)
        io.err()
            .s("\{sys.program_name()\}: there is no page: \{where.page\} (`make kspage-web` \
                first)\n")
        return 1
    split: = aim.split_path(path)
    // If none is named, the served folder is the tree's root, or else the document's folder.
    // Caution: **Make it absolute** (the reason is at `full`).
    tree: = tree_root(split[0], arena)
    said: = root_said if root_said.len > 0 else split[0] if tree.len == 0 else tree
    root: = full(said, arena)
    // **Make it relative to the served folder** (the reason is at `aim.doc_under`).
    doc: = aim.doc_under(root, path)

    opened: = open_or_start(where, root, at, show_only, arena)
    if opened.url.len == 0
        return 1
    $text: = Str_builder.new()
    open_url: = aim.url_for(opened.url, doc, sys.is_windows(), text@)
    io.out().s("\{open_url\}\n")
    if c: = opened.child
        $started: = c
        hand_and_tell(open_url, doc, show_only, where, arena)
        // Caution: **Once the browser has the URL, exit here.** Waiting would leave one of these
        // behind per document for someone not watching a terminal (a double click).
        // **The server stays** for the next open (`reusable`).
        if !show_only
            io.out().s("  * the server stays (the next open uses this one)\n")
            io.out().s("  * it stops itself once every kspage tab has been closed\n")
            io.out()
                .s("  * --list shows the servers left running, --stop=\{root\} stops this one\n\n")
            return 0
        io.out().s("  * to stop it: Ctrl+C\n\n")
        relay_log(opened.log, started@)
        return started.wait().unwrap_or(1)
    io.out()
        .s("\{sys.program_name()\}: used a running server (serving \{root\} on \
            \{aim.port_in_url(opened.url)\})\n")
    hand_and_tell(open_url, doc, show_only, where, arena)
    return 0

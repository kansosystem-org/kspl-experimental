#!/usr/bin/env -S ksplc run
//< Runs a set of CI gates in order, one log each, and prints what they left
//< **The gates and which job runs each are `tools/ci_gates.kspl`'s table**; this file only runs
//< them. `make ci` and its siblings call it with their own name (`mk/ci.mk`), and `make ci-summary`
//< asks it for the summary the workflow shows.
//< **A fallen gate does not stop the set**, so one round names every gate that falls. Only a gate
//< the later ones build on (`Gate.stops`, the self-host) stops it: what fails after it is noise.
//< `--stop-at-first` (`make ci STOP=1`) stops it at any fallen gate, for a quicker answer.
//< **A pair the table marks (`Gate.beside`) starts at once**, each gate still judged alone;
//< `--serial` (`make ci CI_SERIAL=1`) runs the two one after the other.

// ==========================================
// Usage:
//     ksplc run tools/ci.kspl ci|ci-macos|ci-shard-<shard>
//         [--make=<make>] [--jobs=<n>] [--platform=<linux|darwin|win32>] [--relaxed=<switches>]
//         --cap=<seconds> [--stop-at-first] [--serial]
//     ksplc run tools/ci.kspl summary [--jobs=<n>] [--title=<text>]
// ==========================================
import "std/argparse"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/subproc"
import "std/sys"
import "tools/ci_gates" + { Gate, Set }

fn main(): I32
    defer arena: = Arena(1024 * 1024)
    $make: U8[] = "make"
    $jobs: I64 = 1I64
    $title: U8[] = "ci"
    $platform: U8[] = ""
    $relaxed: U8[] = ""
    $cap: I64 = 0I64
    $stop: = false
    $serial: = false
    p: = argparse.Parser
        .create(sys.program_name(), "run a set of CI gates, or print the summary", arena)
    p.positional("<set> | summary")
    p.str_opt("--make", make@, "the make to run each gate with (make passes its own)")
    p.int_opt("--jobs", jobs@, "how many jobs a gate run with -j takes")
    p.str_opt("--title", title@, "the summary's heading (the workflow names its job)")
    p.str_opt("--platform", platform@, "make's PLATFORM: a SKIP its rows do not expect fails")
    p.str_opt("--relaxed", relaxed@, "the switches turned off, space-separated: their SKIPs pass")
    p.int_opt("--cap", cap@, "the seconds a gate may run before it is stopped (`CI_GATE_CAP`)")
    p.flag("--stop-at-first", stop@, "end the set at the first gate that falls (`make ci STOP=1`)")
    p.flag("--serial", serial@, "run each gate alone, the pairs too (`make ci CI_SERIAL=1`)")
    p.parse_or_exit()
    if platform.len == 0
        if sys.is_windows()
            platform = "win32"
        else
            host: =
                subproc.run_capture(U8[][]::{ "uname", "-s" }, "", 10000, 4096, arena) catch
                io.err().s("ci: cannot determine the host OS; pass --platform\n")
                return 2
            if !host.exited_with(0)
                io.err().s("ci: cannot determine the host OS; pass --platform\n")
                return 2
            platform =
                "darwin" if (U8[]::host.stdout_data).trim_spaces().equals("Darwin") else "linux"
    if p.rest.len != 1 || jobs < 1I64
        p.print_usage(io.err())
        return 2
    name: = p.rest.get(0)
    if name.equals("summary")
        return summary(title, jobs,
            ci_gates.Judge::{ .platform = platform, .relaxed = relaxed }, arena)
    if odd: = ci_gates.unknown_switch(relaxed, arena)
        io.err().s("ci: no row of `switch_skips` names the switch '\{odd\}'\n")
        return 2
    // **No default cap here**: `CI_GATE_CAP` in `mk/ci.mk` is its one place.
    if cap < 1I64 || cap > CAP_MAX_S
        io.err().s("ci: a set needs --cap=<seconds>, from 1 to \{CAP_MAX_S\}\n")
        return 2
    switch ci_gates.set_from(name, arena)
    case .some(s)
        return run_set(name, s,
            Round::{ .make = make, .jobs = jobs, .platform = platform, .relaxed = relaxed,
            .cap_s = cap, .stop = stop, .serial = serial, .full = s == Set.ci_full }, arena)
    case .none
        io.err().s("ci: no set is named '\{name\}'\n")
        p.print_usage(io.err())
        return 2

priv struct Round //< how this round runs each gate: the command line's settings
    make: U8[]
    jobs: I64
    platform: U8[]
    relaxed: U8[] //< the switches turned off, space-separated (`--relaxed`)
    cap_s: I64 //< the seconds one gate may run before it is stopped (`--cap`)
    stop: Bool //< any fallen gate ends the set, not only one with `Gate.stops` (`--stop-at-first`)
    serial: Bool //< every gate runs alone, a pair with `Gate.beside` included (`--serial`)
    full: Bool //< `ci-full`: a SKIP passes, and the round lists each one last

priv const CAP_MAX_S: I64 = 2000000I64 //< the longest cap a child's limit in milliseconds holds

priv fn run_set(name: U8[], s: Set, r: Round, arena: Arena$@): I32 //<
    //< Runs every gate of the set in the table's order; 0 when all passed
    //< **Every set refuses a gate no set runs**: it would go green everywhere, run nowhere.
    fs.mkdir_all(ci_gates.LOG_DIR) catch {}
    if !ci_gates.reset_logs(arena)
        return 1
    // **What only Linux has its tools for runs on Linux alone**: elsewhere, open the repository in
    // its dev container, a Linux host.
    if s == Set.ci_shard_linux && !r.platform.equals("linux")
        io.err().s("ci: '\{name\}' runs on Linux alone; elsewhere run it in the dev container\n")
        return 1
    if r.platform.equals("darwin") && s != Set.ci_macos
        version: =
            subproc.run_capture(U8[][]::{ r.make, "--output-sync=target", "--version" }, "", 10000,
            4096, arena) catch
            io.err()
                .s("ci: the shared sections need GNU make 4; install it with brew install make\n")
            return 1
        if !version.exited_with(0)
            io.err()
                .s("ci: the shared sections need GNU make 4; install it with brew install make\n")
            return 1
    for g in ci_gates.GATES
        if !run_anywhere(g)
            io.err().s("ci: no set runs the gate '\{g.log\}'\n")
            return 1
        if g.macos && g.par == ci_gates.Par.synced
            io.err()
                .s("ci: macOS runs the gate '\{g.log\}', and its make 3.81 has no --output-sync\n")
            return 1
    if fault: = ci_gates.pair_fault(arena)
        io.err().s("ci: a pair of gates run side by side is wrong: ").s(fault).c('\n')
        return 1
    $count: Sz = 0
    $fallen: Sz = 0
    $ended_at: U8[]? = .none
    $by_switch: = false
    $not_run: = List<|U8[]|>(arena)
    order: = ci_gates.run_order(r.stop, arena)
    for st in ci_gates.steps(order@, s, r.platform, r.serial, arena)
        if ended_at.is_some()
            for g in st.gates
                not_run.push(g.log)
            continue
        count += st.gates.len
        passed: = run_step(st, r, arena)
        for ok in passed
            if !ok
                fallen += 1
        if g: = ci_gates.ends_round(st@, passed@, r.stop)
            ended_at = .some(g.log)
            by_switch = !g.stops
    // **A set that runs nothing has gone wrong**: a gate moved to a shard no job runs.
    if count == 0
        io.err().s("ci: the set '\{name\}' holds no gate\n")
        return 1
    print_digest(r, arena)
    if r.full
        print_skips(arena)
    // **A round with a switch off says so last**: green there is not CI's verdict.
    if r.relaxed.len > 0
        io.out().s("# turned off here: ").s(r.relaxed)
            .s(" (=0), so their gates may skip; CI's Linux job requires every one, and this round ")
            .s("is not its verdict\n")
    // **A round that ended early says so last**, naming what did not run: it is no full verdict.
    // A fall at the set's last gate left nothing out, so that round ended in full.
    if at: = ended_at
        if not_run.len == 0
            return 1
        defer $b: = Str_builder()
        ci_gates.early_end(at, by_switch, not_run@, b@)
        io.out().s(b.slice())
    if fallen > 0
        return 1
    io.out().s("# \{name\}: ALL GREEN\n")
    return 0

priv fn run_anywhere(g: Gate): Bool //< whether some set runs the gate
    for s in ci_gates.SET_ORDER
        if s.runs(g)
            return true
    return false

priv fn run_step(st: ci_gates.Step, r: Round, arena: Arena$@): List<|Bool|> //<
    //< Runs one step's gates through `make`, all started at once; whether each passed, in order
    //< **A gate alone writes to the screen and its log as it goes.** Gates side by side write
    //< only to their logs, so their lines never mix; each log is shown once both have ended.
    //< **`bash -o pipefail`**, or the pipe answers with `tee`'s status and a fallen gate passes.
    beside: = st.gates.len > 1
    $runs: = List<|ci_gates.Capped|>(arena)
    for g in st.gates
        log: = ci_gates.log_path(g.log, arena)
        cmd: = arena.text()
        cmd.c('\'').s(r.make).c('\'')
        if g.par != ci_gates.Par.serial
            cmd.s(" -j\{r.jobs\}")
        if g.par == ci_gates.Par.synced
            cmd.s(" --output-sync=target")
        cmd.c(' ').s(g.args).s(" > " if beside else " 2>&1 | tee ").s(log)
        if beside
            cmd.s(" 2>&1")
        io.out().s("# --- ").s(g.log).s(": make ").s(g.args)
        if beside
            other: = st.gates.get(1 if st.gates.get(0).log.equals(g.log) else 0).log
            io.out().s(", side by side with ").s(other).s("; its log follows when both end")
        io.out().s(" ---\n").flush()
        // 127, the shell's "not found", where bash itself cannot start. Caution: **The words go on
        // the arena**: a literal list would be one slot of this loop's frame, shared by both gates.
        $argv: = List<|U8[]|>(arena)
        for w in U8[][]::{ "bash", "-o", "pipefail", "-c", cmd.take() }
            argv.push(w)
        runs
            .push(ci_gates.Capped::{ .argv = argv.slice(), .name = g.log, .log = log, .rc = 0,
            .took_us = 0I64 })
    ci_gates.run_capped_all(runs.slice(), r.cap_s, sys.mono_us())
    $passed: = List<|Bool|>(arena)
    for i in Range.asc(st.gates.len)
        c: = runs.get(i)
        if beside
            io.out().s("# --- ").s(c.name).s("'s log, \{c.took_us / 1000000I64\}s ---\n")
                .s(io.read_file(c.log, arena) catch "")
            io.out().flush()
        passed
            .push(judge_gate(st.gates.get(i), r, c.rc, c.took_us / 1000000I64, arena))
    return passed

priv fn judge_gate(g: Gate, r: Round, exit: I32, sec: I64, arena: Arena$@): Bool //<
    //< Judges one gate that has ended by its exit code and its log, and writes its `.end`
    log: = ci_gates.log_path(g.log, arena)
    $rc: = exit
    said: = io.read_file(log, arena) catch ""
    j: = ci_gates.Judge::{ .platform = r.platform, .relaxed = r.relaxed, .any_skip = r.full }
    if rc == 0 && g.verdict && !ci_gates.said_verdict(said, arena)
        rc = 1
    if rc == 0
        if odd: = unexpected_skip(said, j@, arena)
            rc = 1
            io.out().s("# \{g.log\}: a SKIP no row of `expected_skips` holds for \{r.platform\}: ")
                .s(odd).c('\n')
    defer $end: = Str_builder()
    end.s("\{rc\} \{sec\} \{r.platform\}\n")
    io.write_file(ci_gates.end_path(g.log, arena), end.slice()) catch {}
    if rc != 0
        annotate(g, said, rc, j@, arena)
    return rc == 0

priv fn unexpected_skip(text: U8[], j: ci_gates.Judge@, arena: Arena$@): U8[]? //<
    //< The log's first SKIP line no row holds for the platform and the switches off, if any
    for line in ci_gates.skip_lines(text, arena)
        if j.unexpected(line)
            return .some(line)
    return .none

priv fn annotate(g: Gate, text: U8[], rc: I32, j: ci_gates.Judge@, arena: Arena$@) //<
    //< One error mark per fallen gate on GitHub's page (a step keeps ten): its first cause
    //< The cause is the summary's first for that gate (`ci_gates.causes`), else its exit code.
    if !sys.get_env("GITHUB_ACTIONS").is_some()
        return
    why: = ci_gates.causes(text, g.log, g.verdict, j, arena)
    defer $b: = Str_builder()
    if why.len > 0
        ci_gates.put_cause(why.get(0), b@)
    else
        b.s("exit \{rc\}")
    io.out().s("::error title=").s(g.log).s("::").s(b.slice()).c('\n')

priv fn print_digest(r: Round, arena: Arena$@) //<
    //< The gates that ran and why any fell, on the screen
    j: = ci_gates.Judge::{ .platform = r.platform, .relaxed = r.relaxed, .any_skip = r.full }
    outs: = ci_gates.outcomes(j@, arena)
    defer $b: = Str_builder()
    ci_gates.digest_plain(outs@, r.jobs, j@, b@)
    io.out().s(b.slice())

priv fn print_skips(arena: Arena$@) //<
    //< Every SKIP line of the round, by gate: what this machine did not check
    //< **A full round passes a SKIP, so it must name each one**, or green would hide a gate that
    //< checked nothing.
    $count: Sz = 0
    for g in ci_gates.GATES
        said: = io.read_file(ci_gates.log_path(g.log, arena), arena) catch ""
        for line in ci_gates.skip_lines(said, arena)
            if count == 0
                io.out().s("# not checked on this machine (a SKIP passes in ci-full):\n")
            io.out().s("#   ").s(g.log).s(": ").s(line.trim_spaces()).c('\n')
            count += 1
    if count == 0
        io.out().s("# every check ran on this machine\n")

priv fn summary(title: U8[], jobs: I64, j: ci_gates.Judge, arena: Arena$@): I32 //<
    //< The summary for the job's page, added to `$GITHUB_STEP_SUMMARY` (the screen when unset)
    //< Caution: **Return 0 with no log too, and say so**: the step runs after a fall, and the cause
    //< is the step above.
    outs: = ci_gates.outcomes(j@, arena)
    defer $b: = Str_builder()
    if outs.len == 0
        b.s("no gate log: the round fell before a gate ran (the cause is the step above)\n")
    else
        ci_gates.digest_md(outs@, jobs, title, b@)
    switch sys.get_env("GITHUB_STEP_SUMMARY")
    case .some(path)
        // The file may hold an earlier step's lines; they stay.
        defer $all: = Str_builder()
        all.s(io.read_file(path, arena) catch "").s(b.slice())
        io.write_file(path, all.slice()) catch
            io.err().s("ci: cannot write the summary to \{path\}\n")
            return 1
    case .none
        io.out().s(b.slice())
    return 0

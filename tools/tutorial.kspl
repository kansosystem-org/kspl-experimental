#!/usr/bin/env -S ksplc run
//< Writes and checks every tutorial written from a program (`TUTORIALS` in `tutorial_page.kspl`)
//< Each page is built from its program and a run of it.
//< **The pages are committed.** So a change to a program, or to what the compiler makes of it,
//< shows as a diff. `make tutorial` rewrites them, and `make test-docs` fails when one is out of
//< date.
//< **A page's KSPL code blocks, joined in order, must run and print what its program prints.** So
//< the page shows the whole program. Both subcommands refuse a page that does not.

// ==========================================
//     ksplc run tools/tutorial.kspl write   # rewrites every page
//     ksplc run tools/tutorial.kspl check   # checks every page against its program's output today
// ==========================================
import "std/argparse"
import "std/chars" // `strip_suffix`
import "std/ds"
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" // `text` and `lines`
import "std/subproc"
import "std/sys"
import "tools/tutorial_page" as page

priv const JOINED_DIR: U8[] = "out/tmp" //< the scratch folder a page's joined blocks are run from
priv const DEFAULT_KSPLC: U8[] = "out/ksplc_stage1.exe"
priv const RUN_TIMEOUT_MS: I32 = 300000
priv const CAPTURE_CAP: Sz = 1 << 16

priv enum Tutorial_error
    unreadable //< the source or the page could not be read
    did_not_run //< the program did not compile or did not exit cleanly
    not_written //< the page could not be written
    not_laid_out //< the program has a declaration the page could not place

priv fn joined_path(tut: page.Tutorial, arena: Arena$@): U8[] //<
    //< where a page's code blocks are joined to be run: named by the program, so no two meet
    stem: = sys.get_file_name(tut.src).strip_suffix(".kspl")
    return arena.text().s(JOINED_DIR).s("/").s(stem).s("_joined.kspl").take()

priv fn program_output(tut: page.Tutorial, ksplc: U8[], arena: Arena$@): U8[]!Tutorial_error //<
    //< what the program prints
    printed: =
        subproc.run(U8[][]::{ ksplc, "run", tut.src }, "", RUN_TIMEOUT_MS, CAPTURE_CAP, arena)
        catch e
            e.describe(arena.text().s("running ").s(tut.src).take(), ksplc)
            throw .did_not_run
    return arena.dup_str(printed)

priv fn built(tut: page.Tutorial, printed: U8[], arena: Arena$@): U8[]!Tutorial_error //<
    //< the page the program gives today
    laid: = io.read_file(tut.src, null) catch
        throw .unreadable
    return page.render(tut, laid, printed, arena) catch e
        switch e
        case .untitled
            io.err().s("\{tut.src\}: a declaration with no `//<` title comes before every titled ")
                .s("one, so no step can show it\n")
        case .title_missing
            io.err().s("\{tut.src\}: a declaration's `//<` has no title after it\n")
        case .fence_open
            io.err().s("\{tut.src\}: a fenced block in a `//<` run is not closed\n")
        case .kspl_fence
            io.err().s("\{tut.src\}: a fenced block in a `//<` run is KSPL. Write the KSPL as ")
                .s("code, so the program runs it\n")
        throw .not_laid_out

priv fn joined_code(text: U8[], arena: Arena$@): U8[] //< every ```` ```kspl ```` block, in order
    b: = arena.text()
    $inside: = false
    for line in text.lines(arena)
        if inside
            if line.equals("```")
                inside = false
            else
                b.s(line).c('\n')
        else if line.equals("```kspl")
            inside = true
    return b.take()

priv fn stands_alone( //< whether the page's code blocks, joined, are the program and print the same
    tut: page.Tutorial,
    text: U8[], //< the page
    printed: U8[], //< what the program prints
    ksplc: U8[],
    arena: Arena$@,
): Bool!Tutorial_error
    joined: = joined_path(tut, arena)
    fs.mkdir_all(JOINED_DIR) catch
        throw .not_written
    io.write_file(joined, joined_code(text, arena)) catch
        throw .not_written
    got: =
        subproc.run(U8[][]::{ ksplc, "run", joined }, "", RUN_TIMEOUT_MS, CAPTURE_CAP, arena) catch e
            e.describe(arena.text().s("running the page's code blocks, joined in ").s(joined).take(),
                ksplc)
            return false
    if got.equals(printed)
        return true
    io.err().s("\{tut.page\}: its code blocks, joined in \{joined\}, print something ")
        .s("other than \{tut.src\}\n")
    return false

priv fn do_write(tut: page.Tutorial, ksplc: U8[], arena: Arena$@): Bool!Tutorial_error //<
    //< whether the page was written
    printed: = program_output(tut, ksplc, arena)!
    text: = built(tut, printed, arena)!
    if !stands_alone(tut, text, printed, ksplc, arena)!
        io.err().s("\{tut.page\} is left as it was\n")
        return false
    io.write_file(tut.page, text) catch
        throw .not_written
    io.out().s("wrote \{tut.page\}\n")
    return true

priv fn do_check(tut: page.Tutorial, ksplc: U8[], arena: Arena$@): Bool!Tutorial_error //<
    //< whether the page is current
    had: = io.read_file(tut.page, null) catch
        io.err()
            .s("\{sys.program_name()\}: there is no \{tut.page\}. Make it with `make tutorial`\n")
        throw .unreadable
    printed: = program_output(tut, ksplc, arena)!
    whole: = stands_alone(tut, had, printed, ksplc, arena)!
    now: = built(tut, printed, arena)!
    // **The check shows it can fail**: one line more of output must change the page. A page that
    // carried no output would match any program.
    if built(tut, arena.text().s(printed).s("one line more\n").take(), arena)!.equals(now)
        io.err().s("\{tut.page\}: the page does not change with what its program prints\n")
        return false
    io.out().s("# \{tut.page\}: one line more of output changes the page\n")
    if !had.equals(now)
        io.err().s("\{tut.page\}: the tutorial differs from what its program gives today.\n")
            .s("Run `make tutorial` and commit the diff.\n")
        return false
    if !whole
        return false
    io.out()
        .s("\{tut.page\}: the tutorial is what its program gives today, and its blocks run as it\n")
    return true

fn main(): I32 //< writes or checks every tutorial written from a program
    defer arena: = Arena(16 * 1024 * 1024)
    $ksplc: U8[] = ""
    p: = argparse.Parser
        .create(sys.program_name(), "make / match the tutorials written from a program", arena)
    p.subcommand("write", "remake every page")
    p.subcommand("check", "match each page against its program today (exit 1 on a drift)")
    p.str_opt("--ksplc", ksplc@, "the compiler to use (default out/ksplc_stage1.exe)")
    p.parse_or_exit()
    if p.command.is_none()
        io.err().s("\{sys.program_name()\}: pass write or check\n")
        return 1
    exe: = ksplc if ksplc.len > 0 else DEFAULT_KSPLC
    writing: = p.command.unwrap_or("").equals("write")
    // **Every page is gone through**, so one run reports every drift, not the first alone.
    $all_ok: = true
    for tut in page.TUTORIALS
        ok: =
            (do_write(tut, exe, arena) if writing else do_check(tut, exe, arena)) catch e
                io.err().s("\{sys.program_name()\}: \{tut.page\}: failed: \{e\}\n")
                fallback false
        all_ok = all_ok && ok
    return 0 if all_ok else 1

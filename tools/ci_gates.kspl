//< The CI gates in one table: what each asks `make` for, which job runs it, and the summary
//< **The table is the one place a gate is named.** `tools/ci.kspl` runs it, `make ci` and its
//< siblings call that (`mk/ci.mk`), and `.github/workflows/ci.yml`'s matrices name the sets, held
//< to `Set` by `tests/support/conventions_ci.kspl`. What each platform runs is said for people
//< in "What each platform runs" in `docs/SPEC-gates.md`; change the two together.
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/strnum"
import "std/subproc"
import "std/sys"

enum Shard //< which job runs a gate on Linux and Windows
    //< **A shard's name is what `make ci-shard-<name>` and the workflow's matrix use.**
    //< Caution: **A shard costs a job's start-up** (checkout, MSYS2, stage1: about a shard's work,
    //< more on Windows). So measure before adding one ("Where CI's time goes" in
    //< `docs/DESIGN-repository.md`).
    a //<
        //< The first of the two shared jobs on Linux and Windows (`make ci-shard-a`)
        //< **The two hold no difference in importance**: their gates are dealt so they take
        //< about as long, as `suites_a` and `suites_b` deal the regression suites.
    b //< the second (`make ci-shard-b`)
    linux //<
        //< The Linux job alone (`make ci-shard-linux`)
        //< Either only its image holds the tool, or the answer cannot differ by platform, so a
        //< second platform would pay for the same answer. A gate of that kind can also stand in a
        //< shared job's Linux run (`Gate.linux_only`), so the three Linux jobs end together.
    none //< neither: macOS alone runs it (`Gate.macos`)

enum Par //< how `make` is asked to run one gate's targets
    serial //< one at a time
    parallel //< `-j<jobs>`, the output as the targets write it
    synced //<
        //< `-j<jobs> --output-sync=target`: each target's output kept together
        //< Caution: **Never in `ci-macos`.** Its system make is 3.81, which lacks
        //< `--output-sync`; `run_set` in `tools/ci.kspl` refuses that combination. The complete
        //< local `ci` on macOS selects GNU make for the shared sections.

struct Gate //< one gate: what `make` is asked for, and where it runs
    log: U8[] //< its log's name, `out/log/ci/<log>.log`
    args: U8[] //< what `make` is given, the words parted by one space
    par: Par //< whether `make` runs its targets side by side, and how their output is kept
    verdict: Bool //<
        //< It must also print `RESULT: ALL PASS`
        //< ("How a run is read" in `docs/SPEC-gates.md`). False for a gate that is several targets'
        //< worth, where one line would speak for the rest; `make` failing still fails it.
    shard: Shard
    macos: Bool //< the macOS job runs it too
    stops: Bool //< a fall stops the set, since the gates after it build on what it built
    early: Bool //<
        //< With `--stop-at-first`, it runs right after the gates with `stops` (`run_order`)
        //< **For a gate that falls often and quickly**, so a round that stops at it ends sooner.
    linux_only: Bool //<
        //< Of the shared jobs (`a`, `b`), only the Linux one runs it
        //< **For a gate that `Shard.linux` would also suit**, put in a shared job because the Linux
        //< job would otherwise end last. That job's start-up is paid already, so the move is free.
    not_on: U8[] //<
        //< The platforms `ci` leaves it out on, space-separated as `PLATFORM` spells them
        //< **Only for a gate that cannot give a true answer there**, never for a missing tool: the
        //< port it runs needs Linux, or its baseline was measured on Linux.
    local_when: U8[] //<
        //< A folder: a local `make ci` runs it only when the change reaches that folder
        //< **For a costly gate that finds faults only there.** GitHub's jobs always run it. Left
        //< out, the round names it with the reason last (`left_out` in `tools/ci.kspl`), so no
        //< green hides it. Empty for every other gate.
    fails: U8[] //<
        //< Its failure case, `<file>#<name>`: an input its check must reject
        //< **A gate that cannot fail stays green while what it checks breaks.** A row that runs a
        //< set of suites names none, as each suite names its own in its header. `make
        //< test-conventions` checks that the file holds the name and that something runs it.

// Caution: **The order is the order they run in.** A gate can use what one before it built (the
// self-host builds stage2, which perf-log measures again).
const GATES: Gate[_] = ::{
    Gate::{ .log = "selfhost", .args = "self-host", .par = .serial, .verdict = true, .shard = .a,
        .macos = true, .stops = true, .early = false, .fails = "ksplc/Makefile#compare-fires" },
    // **Only macOS runs every package's tests in one program**: Linux and Windows run each
    // package's own `make test` from a copy (`test-extract`, across both suite shares).
    Gate::{ .log = "debug", .args = "debug", .par = .serial, .verdict = true, .shard = .none,
        .macos = true, .stops = false, .early = false,
        .fails = "std/tests/verdict_test.kspl#FALLS_MAIN" },
    // tools/ has tests but no `Makefile`, so no copy runs them; `debug` holds them on macOS.
    // **Not on Windows**: `debug_llvm` runs the same tests there, on the same Windows calls. Only
    // the backend differs, and the C one is checked there on every package's copy.
    Gate::{ .log = "debug_tools", .args = "debug-tools", .par = .serial, .verdict = true,
        .shard = .b, .linux_only = true, .macos = false, .stops = false, .early = false,
        .fails = "std/tests/verdict_test.kspl#FALLS_MAIN" },
    // **Lint and the text suites run in job b's Linux run**: their answer cannot differ by
    // platform, and the Linux-only job would otherwise end last.
    Gate::{ .log = "lint", .args = "lint", .par = .parallel, .verdict = true, .shard = .b,
        .linux_only = true, .macos = false, .stops = false, .early = true,
        .fails = "tests/suite/lint_gate_test.kspl#TEN_ERRORS_PROBE" },
    // **Only this `-j` shrinks the suites' time**, and the order they start in settles it (`SUITES`
    // in `mk/test.mk`, longest first; the halves are cut at `SUITES_B` there). Caution: **keep
    // `--output-sync=target`**, or one suite's `RESULT:` lines scatter among another's.
    Gate::{ .log = "suites_a", .args = "test-suites-a", .par = .synced, .verdict = false,
        .shard = .a, .macos = false, .stops = false, .early = false },
    // The QEMU run covers the Cortex-M demos; the link check stays to notice a demo falling out of
    // QEMU's list. **One make for both**, so stage1's check is paid once (no verdict: one log).
    Gate::{ .log = "link_abi", .args = "test-ksos-link test-llvm-abi", .par = .synced,
        .verdict = false, .shard = .a, .macos = false, .stops = false, .early = false,
        .fails = "tests/tools/llvm_ir_abi_check.kspl#MISMATCHED_IR" },
    // On a fall, run `make self-host`, then `make commit-seed`, and commit `ksplc/seed.c` with
    // `ksplc/seed.sum`.
    Gate::{ .log = "seed_sum", .args = "test-seed-sum", .par = .serial, .verdict = true,
        .shard = .linux, .macos = false, .stops = false, .early = false,
        .fails = "tools/seed_sum.kspl#altered" },
    Gate::{ .log = "fm", .args = "test-freestanding-math", .par = .serial, .verdict = true,
        .shard = .a, .macos = true, .stops = false, .early = false,
        .fails = "tests/freestanding/harness.c#check_fires" },
    Gate::{ .log = "simd", .args = "test-simd", .par = .serial, .verdict = true, .shard = .a,
        .macos = true, .stops = false, .early = false, .fails = "mk/test.mk#simd_none" },
    // On a fall, remake the record with `make surface` and commit it with its diff.
    Gate::{ .log = "surface", .args = "test-surface", .par = .serial, .verdict = true,
        .shard = .linux, .macos = false, .stops = false, .early = true,
        .fails = "tools/tests/page_test.kspl#surface.classify" },
    // The tour is generated from its program; `make tutorial` remakes it.
    Gate::{ .log = "docs", .args = "test-docs", .par = .serial, .verdict = true, .shard = .linux,
        .macos = false, .stops = false, .early = false,
        .fails = "tools/tutorial.kspl#one line more" },
    Gate::{ .log = "suites_b", .args = "test-suites-b", .par = .synced, .verdict = false,
        .shard = .b, .macos = false, .stops = false, .early = false },
    // The suites that read or translate the tree's text (`SUITES_TEXT` in `mk/test.mk`).
    Gate::{ .log = "suites_text", .args = "test-suites-text", .par = .synced, .verdict = false,
        .shard = .b, .linux_only = true, .macos = false, .stops = false, .early = true },
    // **Only macOS runs it**: Linux and Windows reach the same training check through
    // `test-extract` (ksai's own `make test`), which macOS does not run.
    Gate::{ .log = "run", .args = "run", .par = .serial, .verdict = true, .shard = .none,
        .macos = true, .stops = false, .early = false,
        .fails = "tools/tests/repo_test.kspl#said_verdict" },
    Gate::{ .log = "selfhost_llvm", .args = "LLVM=1 self-host", .par = .serial, .verdict = true,
        .shard = .b, .macos = true, .stops = false, .early = false,
        .fails = "ksplc/Makefile#compare-fires" },
    // Caution: **Put the run-time tests through the LLVM backend too.** A self-host that passes
    // does not tread a shape ksplc itself never uses, so a broken genllvm goes unseen. Windows runs
    // it as well: only Win64 passes arguments on the stack, where a wrong argument type shows.
    Gate::{ .log = "debug_llvm", .args = "LLVM=1 debug", .par = .serial, .verdict = true,
        .shard = .b, .macos = true, .stops = false, .early = false,
        .fails = "std/tests/verdict_test.kspl#FALLS_MAIN" },
    // kssrv's and kstls's tests through LLVM, which `debug` holds neither of (`test-llvm-pkgs`).
    Gate::{ .log = "llvm_pkgs", .args = "test-llvm-pkgs", .par = .serial, .verdict = true,
        .shard = .linux, .macos = false, .stops = false, .early = false,
        .fails = "std/tests/verdict_test.kspl#FALLS_MAIN" },
    // Peak memory and the tree types' exact sizes settle it; the time is only recorded
    // (`tests/tools/perf_guard.kspl`).
    // **Linux alone**: the baseline is Linux's, so another platform's numbers say nothing.
    Gate::{ .log = "perf", .args = "perf-log", .par = .serial, .verdict = false, .shard = .linux,
        .macos = false, .stops = false, .early = false, .not_on = "win32 darwin",
        .fails = "tests/tools/perf_guard.kspl#limit_fires" },
    // macOS runs these compiler suites, which the shared jobs reach through both suite shares.
    // It leaves out `perf` (the baseline is Linux's) and what is platform-independent; it keeps
    // what meets Apple's toolchain only there (`fm`, `emit_runtime`).
    Gate::{ .log = "lsp", .args = "test-lsp", .par = .serial, .verdict = true, .shard = .none,
        .macos = true, .stops = false, .early = false,
        .fails = "ksplc/tests/suite/lsp_test.kspl#DANGLING_SRC" },
    Gate::{ .log = "negative", .args = "test-negative", .par = .serial, .verdict = true,
        .shard = .none, .macos = true, .stops = false, .early = false,
        .fails = "ksplc/tests/suite/negative_test.kspl#tests/negative" },
    Gate::{ .log = "equiv", .args = "test-equiv", .par = .serial, .verdict = true, .shard = .none,
        .macos = true, .stops = false, .early = false,
        .fails = "ksplc/tests/suite/equiv_test.kspl#TRAP_PROBE" },
    // **Linux alone**: it costs about a minute of four cores, and what it finds is in ksplc's C and
    // IR, the same on every system. A Windows minute counts double, a macOS one ten times.
    // Caution: **Keep it out of job a.** There it came just before the browser gates, and on a
    // two-core runner five served sections got no answer from the browser in 20 s.
    // **A local `make ci` runs it only for a change under `ksplc/`**: it found three compiler
    // faults when it came, and none since.
    Gate::{ .log = "random_equiv", .args = "test-random-equiv", .par = .serial, .verdict = true,
        .shard = .linux, .macos = false, .stops = false, .early = false, .local_when = "ksplc/",
        .fails = "ksplc/tests/suite/random_equiv_test.kspl#PLANTED" },
    Gate::{ .log = "emit_runtime", .args = "test-emit-runtime", .par = .serial, .verdict = true,
        .shard = .none, .macos = true, .stops = false, .early = false,
        .fails = "ksplc/tests/suite/emit_runtime_test.kspl#other_rt" },
    // Each needs a tool only the devcontainer image holds: `<ucontext.h>`, `qemu-system-arm`, node,
    // wasm-ld and a browser, `desktop-file-validate`, libopenblas, ThreadSanitizer, the address and
    // leak sanitizers. **A browser and the validator are required here**: the image bundles them,
    // so their absence is a fault, not the place. The browser's switch is `REQUIRE_SWITCHES` in
    // `mk/test.mk`; the validator's is set by its row, as `make ksmd` needs no validator.
    Gate::{ .log = "ksos_posix", .args = "test-ksos-posix", .par = .serial, .verdict = false,
        .shard = .linux, .macos = false, .stops = false, .early = false, .not_on = "win32",
        .fails = "lib/ksos/Makefile#test-ksos-cap" },
    Gate::{ .log = "ksos_qemu", .args = "test-ksos-qemu", .par = .serial, .verdict = false,
        .shard = .linux, .macos = false, .stops = false, .early = false,
        .fails = "lib/ksos/Makefile#test-ksos-cap" },
    // ksmd's page in Chromium, driven by real input events (`ksmd/tests/browser/main.mjs`).
    // **The browser gates run in job a's Linux run**, the shortest Linux job without them.
    // They stay together there, so the server and the page are built once.
    Gate::{ .log = "ksmd_browser", .args = "test-ksmd-browser", .par = .serial, .verdict = true,
        .shard = .a, .linux_only = true, .macos = false, .stops = false, .early = false,
        .fails = "ksmd/tests/browser/main.mjs#refused" },
    Gate::{ .log = "ksmd_desktop", .args = "test-ksmd-desktop KSMD_REQUIRE_DESKTOP=1",
        .par = .serial, .verdict = true, .shard = .linux, .macos = false, .stops = false,
        .early = false, .not_on = "win32 darwin", .fails = "mk/ksmd.mk#KSMD_BROKEN_ENTRY" },
    // ksmd's launcher run as a double-click runs it, two opens at once included
    // (`tools/tests/ksmd_launch.kspl`). **Linux alone**, so the launcher's lock on Windows goes
    // unchecked ("What each platform runs" in `docs/SPEC-gates.md`).
    Gate::{ .log = "ksmd_open", .args = "test-ksmd-open", .par = .serial, .verdict = true,
        .shard = .a, .linux_only = true, .macos = false, .stops = false, .early = false,
        .fails = "tools/tests/ksmd_launch.kspl#refused" },
    // The launcher's model server, then ksagent's chat page in Chromium, through kssrv, `ksagent
    // watch` and a stand-in model server (`tools/tests/chat_launch.mjs`, `chat_page.mjs`).
    // **Linux alone**, as the other browser gate.
    Gate::{ .log = "ksagent_chat", .args = "test-ksagent-chat", .par = .serial, .verdict = true,
        .shard = .a, .linux_only = true, .macos = false, .stops = false, .early = false,
        .fails = "tools/tests/chat_page.mjs#otherTab" },
    // Caution: **Build and run the BLAS backend for real.** `make lint` reads its branch, but only
    // a link shows whether the FFI is right.
    Gate::{ .log = "blas", .args = "test-blas", .par = .serial, .verdict = true, .shard = .linux,
        .macos = false, .stops = false, .early = false,
        .fails = "std/tests/verdict_test.kspl#FALLS_MAIN" },
    Gate::{ .log = "race", .args = "test-race", .par = .serial, .verdict = true, .shard = .linux,
        .macos = false, .stops = false, .early = false,
        .fails = "tests/suite/race_test.kspl#RACY_SOURCE" },
    // The packages' own tests build in seconds at `-O0`; std's run, which starts children and
    // waits on sockets, is the longest part.
    Gate::{ .log = "sanitize", .args = "test-sanitize", .par = .serial, .verdict = true,
        .shard = .linux, .macos = false, .stops = false, .early = false,
        .fails = "tests/suite/sanitize_test.kspl#PLANTED" },
    // The known holes: each probe's verdict today, under the sanitizers it needs
    // (`tests/suite/holes_test.kspl`). Many short builds, so it costs about half a minute.
    Gate::{ .log = "holes", .args = "test-holes", .par = .serial, .verdict = true, .shard = .linux,
        .macos = false, .stops = false, .early = false,
        .fails = "tests/support/holes_mem.kspl#p04e_arena_from_buffer" },
}

fn run_order(stop: Bool, arena: Arena$@): List<|Gate|> //<
    //< The gates in the order a round runs them: the table's, or the order for `--stop-at-first`
    //< **The stopping order puts the gates with `stops` first, then the `early` ones**, each part
    //< in the table's order. A gate the others build on so still runs before them. Each `early`
    //< gate falls often for the seconds it takes ("Ending a round at the first fall" in
    //< `docs/SPEC-gates.md`).
    $out: = List<|Gate|>(arena)
    for part in Range.asc(3)
        for g in GATES
            $at: Sz = 2
            if !stop || g.stops
                at = 0
            else if g.early
                at = 1
            if at == part
                out.push(g)
    return out

enum Set //< a set of gates one command runs, named as `make` names it
    ci //<
        //< `make ci`: every gate this host can answer, the Linux-only ones included
        //< **For a person checking all on one machine**, where CI spreads the gates over platforms
        //< so each answer is paid for once. A SKIP passes, and the round lists it
        //< (`Judge.any_skip`).
    ci_macos //< `make ci-macos`: the macOS job's set
    ci_shard_a //< `make ci-shard-a`
    ci_shard_b //< `make ci-shard-b`
    ci_shard_linux //< `make ci-shard-linux`: what Linux alone runs

const SET_ORDER: Set[_] = ::{ Set.ci, Set.ci_macos, Set.ci_shard_a, Set.ci_shard_b,
    Set.ci_shard_linux } //< every set, so a name can be read back

fn set_from(name: U8[], arena: Arena$@): Set? //< the set a name spells, if any
    //< **A name is the variant's with `_` written `-`** (`ci-shard-a`), so `make`, the workflow
    //< and this table spell it one way.
    for s in SET_ORDER
        if s.variant_name().replace("_", "-", arena).equals(name)
            return .some(s)
    return .none

impl Set
    fn runs(s: Self, g: Gate, platform: U8[] = "linux"): Bool //< selected gates for this host
        shared: = g.shard == Shard.a || g.shard == Shard.b
        here: = !g.linux_only || platform.equals("linux") //< a shared job on this host runs it
        switch s
        case .ci
            // `Shard.none` is macOS's stand-in for the copies `test-extract` builds, which this set
            // runs, so it would check the same thing twice.
            return (shared || g.shard == Shard.linux) && !lists(g.not_on, platform)
        case .ci_shard_linux
            return g.shard == Shard.linux
        case .ci_macos
            return g.macos
        case .ci_shard_a
            return g.shard == Shard.a && here
        case .ci_shard_b
            return g.shard == Shard.b && here

// ==========================================
// The SKIP lines a round expects. **A SKIP no row holds fails its gate**: a tool gone missing from
// a runner would otherwise pass in silence. A row names its platforms as make's `PLATFORM` spells
// them. It also names a piece of the reason's line ("Some gates need a tool or a library that not
// every machine has" in `docs/SPEC-gates.md`). **Linux is named least**: its image holds every
// tool but Wine, and its container has `::1`.
// ==========================================
struct Expected_skip //< one SKIP a platform's round may print
    on: U8[] //< the platforms it is expected on, space-separated: `linux`, `darwin`, `win32`
    says: U8[] //< a piece of the line that tells its reason apart

const EXPECTED_SKIPS: Expected_skip[_] = ::{
    Expected_skip::{ .on = "linux", .says = "this machine has no IPv6 at all" },
    Expected_skip::{ .on = "win32 darwin", .says = "the loopback holds no `::1`" },
    Expected_skip::{ .on = "win32 darwin", .says = "x86_64-w64-mingw32-gcc is not installed" },
    Expected_skip::{ .on = "darwin", .says = "no GNU make 4 runs here" },
    Expected_skip::{ .on = "linux darwin",
        .says = "a sanitizer's build does not keep time in step with the work" },
    Expected_skip::{ .on = "linux win32 darwin", .says = "Wine is not installed" },
    Expected_skip::{ .on = "win32", .says = "so none goes silent" },
    Expected_skip::{ .on = "win32", .says = "which Windows does not have" },
    Expected_skip::{ .on = "win32", .says = "Windows starts a browser without `xdg-open`" },
    Expected_skip::{ .on = "win32 darwin", .says = "taskset is not installed" },
    Expected_skip::{ .on = "win32 darwin", .says = "cannot grow a file past 2 GiB" },
    Expected_skip::{ .on = "win32 darwin", .says = "no tool that marks a file read-only" },
    Expected_skip::{ .on = "win32 darwin", .says = "which only Linux has" },
    Expected_skip::{ .on = "win32", .says = "marks every new file executable" },
    Expected_skip::{ .on = "win32", .says = "POSIX-specific executable paths" },
    Expected_skip::{ .on = "win32", .says = "it hands over shell command lines" },
    Expected_skip::{ .on = "win32", .says = "no POSIX mode" },
    Expected_skip::{ .on = "win32", .says = "Windows has no FIFO a path names" },
    Expected_skip::{ .on = "win32", .says = "Windows has no timer signal to stand in for one" },
    Expected_skip::{ .on = "win32", .says = "Windows has no terminal `script` can give" },
    Expected_skip::{ .on = "win32 darwin", .says = "holds no sanitizer runtime" },
    Expected_skip::{ .on = "win32", .says = "cannot be made with `ln -s`" },
    Expected_skip::{ .on = "win32", .says = "cannot be made with `mkfifo`" },
    Expected_skip::{ .on = "win32", .says = "a link cannot be made here" },
    Expected_skip::{ .on = "darwin", .says = "do not link here" },
    Expected_skip::{ .on = "darwin", .says = "the libraries kstls binds are not installed" },
    Expected_skip::{ .on = "win32", .says = "test-ksos-link" },
    Expected_skip::{ .on = "win32", .says = "no ARM toolchain" },
    Expected_skip::{ .on = "win32", .says = "this system cannot set one (ulimit -t)" },
    Expected_skip::{ .on = "win32", .says = "Windows has no SIGPIPE" },
    Expected_skip::{ .on = "win32", .says = "Windows has no signal that cuts a wait short" },
    Expected_skip::{ .on = "win32 darwin", .says = "/proc/self/status" },
    Expected_skip::{ .on = "darwin", .says = "this OS has no /dev/full" },
    Expected_skip::{ .on = "win32 darwin", .says = "nm is not installed" },
    Expected_skip::{ .on = "win32 darwin", .says = "only one of the two C compilers is installed" },
    Expected_skip::{ .on = "win32", .says = "Windows's permissions are an ACL" },
    Expected_skip::{ .on = "win32", .says = "cannot open the folder to everyone" },
    Expected_skip::{ .on = "win32 darwin", .says = "can hand a folder to another user" },
    Expected_skip::{ .on = "win32 darwin", .says = "wasm-ld is not installed" },
    Expected_skip::{ .on = "win32 darwin", .says = "clang's wasm32 builtins are not installed" },
    Expected_skip::{ .on = "win32 darwin", .says = "node is not installed" },
    Expected_skip::{ .on = "win32 darwin", .says = "does not take --target" },
    Expected_skip::{ .on = "win32", .says = "a drive is a root on Windows" },
    Expected_skip::{ .on = "win32", .says = "Windows's executable path resolves no link" },
    Expected_skip::{ .on = "win32 darwin",
        .says = "the section-cutting option is not handed here" },
    Expected_skip::{ .on = "win32 darwin", .says = "it is Linux only" },
    Expected_skip::{ .on = "win32", .says = "the hook cannot be" },
    Expected_skip::{ .on = "win32", .says = "which Windows does not start as a program" },
    Expected_skip::{ .on = "win32", .says = "cannot build with ThreadSanitizer" },
    Expected_skip::{ .on = "win32 darwin", .says = "the real-time clock is degraded" },
    Expected_skip::{ .on = "win32 darwin", .says = "clock cannot measure a silence" },
    Expected_skip::{ .on = "win32 darwin", .says = "it is not split" },
    Expected_skip::{ .on = "darwin", .says = "neither Windows's sharing check nor /proc" },
    Expected_skip::{ .on = "darwin", .says = "no util-linux `script`" },
}

fn skip_lines(text: U8[], arena: Arena$@): List<|U8[]|> //< a log's lines that say a check skipped
    //< **A line skips when it opens with the mark**, past any `#` and spaces before it: `SKIP …`,
    //< `#   SKIP: …` or `RESULT: SKIPPED …`. A line that only names the word, as a check's label
    //< can (`pass conventions: every SKIP reason …`), is no skip.
    $out: = List<|U8[]|>(arena)
    for line in text.lines(arena)
        if is_skip_line(line)
            out.push(line)
    return out

fn is_skip_line(line: U8[]): Bool //< whether a log's line says a check skipped (`skip_lines`)
    $i: Sz = 0
    for i < line.len && (line[i] == '#' || line[i] == ' ')
        i += 1
    rest: = line.sub_from(i)
    return rest.starts_with("SKIP") || rest.starts_with("RESULT: SKIPPED")

fn said_verdict(text: U8[], arena: Arena$@): Bool //<
    //< Whether a log holds the verdict a passing gate prints, at the head of a line (`Gate.verdict`)
    //< `RESULT: ALL PASS`, or `RESULT: SKIPPED` from a gate skipped whole for want of its tool.
    //< **The skipped one passes only where a row holds it**, as every SKIP line (`Judge`).
    for line in text.lines(arena)
        if line.starts_with("RESULT: ALL PASS") || line.starts_with("RESULT: SKIPPED")
            return true
    return false

// ==========================================
// The SKIP lines a switch turned off lets through. **On Linux a switch makes a missing tool fail**
// (`REQUIRE_SWITCHES` in `mk/test.mk`); a person whose machine lacks the tool turns it off, and the
// gate skips instead. Such a skip is the person's own choice, so the round expects it, and names
// the switch as it ends: it is not CI's verdict.
// ==========================================
struct Switch_skip //< one SKIP a gate prints where a switch is turned off and the tool is missing
    name: U8[] //< the switch, as `mk/test.mk` names it
    says: U8[] //< a piece of the line that tells its reason apart

const SWITCH_SKIPS: Switch_skip[_] = ::{
    Switch_skip::{ .name = "KANSO_REQUIRE_ASAN", .says = "holds no sanitizer runtime" },
    Switch_skip::{ .name = "KANSO_REQUIRE_ASAN",
        .says = "cannot build with the address and undefined-behaviour sanitizers" },
    Switch_skip::{ .name = "KANSO_REQUIRE_TSAN", .says = "cannot build with ThreadSanitizer" },
    Switch_skip::{ .name = "KANSO_REQUIRE_BOTH_CC",
        .says = "only one of the two C compilers is installed" },
    Switch_skip::{ .name = "KANSO_REQUIRE_CHOWN", .says = "can hand a folder to another user" },
    Switch_skip::{ .name = "KANSO_REQUIRE_MINGW",
        .says = "x86_64-w64-mingw32-gcc is not installed" },
    Switch_skip::{ .name = "KSTLS_REQUIRE_LIBS",
        .says = "the libraries kstls binds are not installed" },
    Switch_skip::{ .name = "KSTLS_REQUIRE_LIBS", .says = "do not link here" },
    Switch_skip::{ .name = "KSOS_REQUIRE_ARM", .says = "no ARM toolchain" },
    Switch_skip::{ .name = "KSOS_REQUIRE_ARM", .says = "test-ksos-link" },
    Switch_skip::{ .name = "KSMD_REQUIRE_BROWSER", .says = "no browser" },
}

fn is_expected_skip(line: U8[], platform: U8[], relaxed: U8[]): Bool //<
    //< Whether a row holds this SKIP line: one of the platform's, or one of a switch turned off
    //< `relaxed` holds the switches turned off, space-separated (`--relaxed` in `tools/ci.kspl`).
    for e in EXPECTED_SKIPS
        if lists(e.on, platform) && line.find_str(e.says).is_some()
            return true
    for w in SWITCH_SKIPS
        if lists(relaxed, w.name) && line.find_str(w.says).is_some()
            return true
    return false

fn unknown_switch(relaxed: U8[], arena: Arena$@): U8[]? //<
    //< A switch named in `relaxed` that no row of `SWITCH_SKIPS` names, if any
    //< **Refused rather than ignored**: its gates' skips would fail the round with no row to blame.
    for name in relaxed.split(' ', arena)
        if name.len == 0
            continue
        $known: = false
        for w in SWITCH_SKIPS
            if w.name.equals(name)
                known = true
        if !known
            return .some(name)
    return .none

priv fn lists(words: U8[], word: U8[]): Bool //< whether a space-separated list holds the word
    $at: Sz = 0
    for at < words.len
        $end: = at
        for end < words.len && words[end] != ' '
            end += 1
        if words.sub(at, end - at).equals(word)
            return true
        at = end + 1
    return false

// ==========================================
// What a run leaves, and the summary read back from it
// **One gate leaves two files**: its log, and `<log>.end` holding its exit code and seconds. So a
// later `make ci-summary` (another process, another workflow step) reads what this one saw.
// ==========================================

const LOG_DIR: U8[] = "out/log/ci" //< where the gates' logs go
const SUITE_LOG_DIR: U8[] = "out/log/suite" //< where each suite's own log goes (`SUITE_LOG_DIR`)
const LOG_DIRS: U8[][] = U8[][]::{ LOG_DIR, SUITE_LOG_DIR } //< every folder a round's logs go to
const END_EXT: U8[] = ".end" //< the file beside a log holding `<exit code> <seconds>`

struct Judge //< what a SKIP line is held against: the round's platform and the switches off
    platform: U8[] //< make's `PLATFORM`; empty where it names none, and then no SKIP is judged
    relaxed: U8[] //< the switches turned off, space-separated (`--relaxed` in `tools/ci.kspl`)
    any_skip: Bool //< every SKIP passes (`Set.ci`): a machine of one's own lacks what it lacks

impl Judge
    fn unexpected(j: Self@, line: U8[]): Bool //< whether a SKIP line fails its gate here
        return !j.any_skip && j.platform.len > 0 &&
            !is_expected_skip(line, j.platform, j.relaxed)

struct Outcome //< what one gate left
    log: U8[]
    ok: Bool
    sec: I64
    skips: Sz //< its lines carrying `SKIP`: checks passing without running, by their own account
    unexpected: Sz //< of those, the ones no row holds (`Judge.unexpected`)
    causes: List<|Cause|> //< why it fell, empty where it passed (`causes`)

fn log_path(log: U8[], arena: Arena$@): U8[] //< where a gate's log is
    return arena.text().s(LOG_DIR).c('/').s(log).s(".log").take()

fn end_path(log: U8[], arena: Arena$@): U8[] //< where a gate's exit code and seconds are
    return arena.text().s(LOG_DIR).c('/').s(log).s(END_EXT).take()

fn outcomes(j: Judge@, arena: Arena$@): List<|Outcome|> //<
    //< What the gates left, in the table's order
    //< **A gate with no log did not run** and is left out; one with a log and no `.end` was cut
    //< short, and counts as fallen.
    $out: = List<|Outcome|>(arena)
    for g in GATES
        log: = log_path(g.log, arena)
        if !fs.exists(log)
            continue
        ended: = io.read_file(end_path(g.log, arena), arena) catch ""
        out.push(outcome_of(g, io.read_file(log, arena) catch "", ended, j, arena))
    return out

fn outcome_of(g: Gate, text: U8[], ended: U8[], j: Judge@, arena: Arena$@): Outcome //<
    //< What one gate left (`.end`: exit code, seconds, and optionally its execution platform)
    $ok: = false
    $sec: I64 = 0I64
    words: = ended.trim_spaces().split(' ', arena)
    $judge: = j$
    if words.len == 2 || words.len == 3
        ok = (words.get(0).to_i64() catch 1I64) == 0I64
        sec = words.get(1).to_i64() catch 0I64
        if words.len == 3
            judge.platform = words.get(2)
    skips: = skip_lines(text, arena)
    $odd: Sz = 0
    for line in skips
        if judge.unexpected(line)
            odd += 1
    $why: = List<|Cause|>(arena)
    if !ok
        why = causes(text, g.log, g.verdict, judge@, arena)
    return Outcome::{ .log = g.log, .ok = ok, .sec = sec, .skips = skips.len, .unexpected = odd,
        .causes = why }

// ==========================================
// One gate run under its cap
// **A hung gate is stopped here, named**, not by the CI job's own limit. That limit cancels the
// whole job and leaves no word of which gate hung. Locally, nothing else would stop it at all.
// ==========================================

priv const NOTICE_US: I64 = 15000000I64 //< how often a gate still running is named on the screen
priv const OVER_CAP_HEAD: U8[] = "# gate " //< the cap's line, around the gate's log and the cap
priv const OVER_CAP_MID: U8[] = " ran over "
priv const OVER_CAP_TAIL: U8[] = " s and was stopped"

fn run_capped(argv: U8[][], name: U8[], log: U8[], cap_s: I64, started: I64): I32 //<
    //< Runs one gate's command to its end, naming it while it runs: its exit code, 127 unstarted
    //< **Its output reaches the screen as it comes**; the command itself copies it into `log`.
    //< **Past `cap_s`, it is stopped with all it started.** The line saying so goes to the
    //< screen and the end of `log`, where `causes` names it first. The gate then fails with 1.
    $child: = subproc.spawn_limited(argv, "", I32::(cap_s * 1000I64)) catch
        return 127
    $next: = started + NOTICE_US
    for
        // Waited on only until it comes back ended or timed out, it is never reaped before.
        switch child.wait(I32::((next - sys.mono_us() + 999I64) / 1000I64)).unwrap_or(.ended(1))
        case .ended(code)
            return code
        case .running
            now: = sys.mono_us()
            if now >= next
                io.out()
                    .s("# still running \{name\}: \{(now - started) / 1000000I64\}s (\{log\})\n")
                    .flush()
                next = now + NOTICE_US
        case .timed_out
            over_cap(name, log, cap_s)
            return 1

priv fn over_cap(name: U8[], log: U8[], cap_s: I64) //< says a gate was stopped at its cap
    defer $line: = Str_builder()
    line.s(OVER_CAP_HEAD).s(name).s(OVER_CAP_MID).s("\{cap_s\}").s(OVER_CAP_TAIL).c('\n')
    io.out().s(line.slice()).flush()
    defer $f: = io.open(log, "ab") catch
        return
    f.s(line.slice())

// ==========================================
// Why a fallen gate fell, read from its log
// **The summary ends with each cause.** So a round's last lines say why, with no search through
// thousands above ("How a run is read" in `docs/SPEC-gates.md`). The gate's own marks are read,
// and make's `*** [`, the one part of make's line no locale translates (`Error 1` is `エラー 1` in
// Japanese).
// ==========================================

enum Cause_kind //< what one line of a fallen gate's log says, in the order the summary lists them
    over_cap //< the runner's line saying the gate ran over its cap and was stopped (`run_capped`)
    panic //< `panic: ` at the line's head: a test stopped there
    fail //< `FAIL ` or `[FAIL]` at the line's head: a check that did not hold
    unexpected_skip //< a SKIP line no row holds for the platform and the switches off
    no_verdict //< no `RESULT: ALL PASS` from a gate that must print one (`Gate.verdict`)
    result //< `RESULT: SOME FAILED`
    make //< make's `*** [<target>]`: the target that stopped, not why
    tail //< one of the log's last lines, where no line of the gate's own names a cause

struct Cause //< one line of a fallen gate's log that says why it fell
    kind: Cause_kind
    line: U8[]

const CAUSE_ORDER: Cause_kind[_] = ::{ Cause_kind.over_cap, Cause_kind.panic, Cause_kind.fail,
    Cause_kind.unexpected_skip, Cause_kind.result, Cause_kind.make } //<
        //< The kinds read from the lines, most telling first
        //< `no_verdict` and `tail` are added after them, where the gate's own say nothing.

const CAUSES_SHOWN: Sz = 6 //<
    //< How many of a gate's causes the summary lists, the tail apart; its log holds the rest
const TAIL_SHOWN: Sz = 8 //< how many of a log's last lines stand in where nothing names a cause
const CAUSE_WIDTH: Sz = 400 //< the bytes of one line the summary keeps; its log holds it whole

priv fn kind_of(line: U8[], log: U8[], j: Judge@): Cause_kind? //< the cause a line names, if any
    //< Caution: **The cap's line counts for the gate it names alone.** A gate's own tests print
    //< one for a fake gate, which is no cause of theirs.
    t: = line.trim_spaces()
    if t.starts_with(OVER_CAP_HEAD) && t.sub_from(OVER_CAP_HEAD.len).starts_with(log) &&
        t.sub_from(OVER_CAP_HEAD.len + log.len).starts_with(OVER_CAP_MID) &&
        t.ends_with(OVER_CAP_TAIL)
        return .some(.over_cap)
    if t.starts_with("panic: ")
        return .some(.panic)
    if t.starts_with("FAIL ") || t.starts_with("[FAIL]")
        return .some(.fail)
    if t.starts_with("RESULT: SOME FAILED")
        return .some(.result)
    if t.find_str("*** [").is_some()
        return .some(.make)
    if is_skip_line(t) && j.unexpected(t)
        return .some(.unexpected_skip)
    return .none

impl Cause_kind
    fn own(k: Self): Bool //< whether a line of this kind is the gate's own word, not make's
        return k != Cause_kind.make && k != Cause_kind.no_verdict && k != Cause_kind.tail

fn causes(text: U8[], log: U8[], verdict: Bool, j: Judge@, arena: Arena$@): List<|Cause|> //<
    //< The lines of a fallen gate's log that say why, in `Cause_kind`'s order, each once
    //< **The log's last lines stand in where no line of the gate's own names a cause** (a C
    //< compiler's error, a crash). Make's line names only the target that stopped.
    lines: = text.lines(arena)
    $out: = List<|Cause|>(arena)
    $own: = false
    passed: = said_verdict(text, arena)
    for k in CAUSE_ORDER
        for line in lines
            if got: = kind_of(line, log, j)
                if got == k && !holds(out@, line.trim_spaces())
                    out.push(Cause::{ .kind = k, .line = line.trim_spaces() })
                    own = own || k.own()
    if own
        return out
    if verdict && !passed
        out
            .push(Cause::{ .kind = .no_verdict, .line = "it printed no `RESULT: ALL PASS` line" })
    $from: = lines.len
    $kept: Sz = 0
    for from > 0 && kept < TAIL_SHOWN
        from -= 1
        if lines.get(from).trim_spaces().len > 0
            kept += 1
    for i in Range(from, lines.len, 1)
        if lines.get(i).trim_spaces().len > 0 &&
            !holds(out@, lines.get(i).trim_spaces())
            out.push(Cause::{ .kind = .tail, .line = lines.get(i).trim_end() })
    return out

priv fn holds(found: List<|Cause|>@, line: U8[]): Bool //< whether a cause already says this line
    for i in Range.asc(found.len)
        if found.get(i).line.equals(line)
            return true
    return false

fn put_cause(c: Cause, b: Str_builder$@) //< one cause as the summary marks it
    //< **A line keeps its own mark** (`FAIL`, `panic:`, `RESULT:`, make's `***`). A SKIP line
    //< carries one no expected line does. A line of the tail is set off as quoted.
    if c.kind == Cause_kind.unexpected_skip
        b.s("UNEXPECTED ")
    if c.kind == Cause_kind.no_verdict
        b.s("NO VERDICT: ")
    if c.kind == Cause_kind.tail
        b.s("| ")
    shown: = c.line.utf8_head(CAUSE_WIDTH)
    b.s(shown)
    if shown.len < c.line.len
        b.s(" …")

priv struct Tally //< the counts both summaries open or close with
    failed: Sz
    skipping: Sz //< gates with one SKIP line or more
    unexpected: Sz //< SKIP lines no row holds, over every gate
    sec: I64

priv fn tally(outs: List<|Outcome|>@): Tally
    $t: = Tally::{ .failed = 0, .skipping = 0, .unexpected = 0, .sec = 0I64 }
    for i in Range.asc(outs.len)
        o: = outs.get(i)
        if !o.ok
            t.failed += 1
        if o.skips > 0
            t.skipping += 1
        t.unexpected += o.unexpected
        t.sec += o.sec
    return t

fn digest_plain(outs: List<|Outcome|>@, jobs: I64, j: Judge@, b: Str_builder$@) //<
    //< For the screen: the gates, then why each fallen one fell, last, where a reader looks first
    //< **A SKIP line is counted, not copied**: thirty expected ones would bury the line that failed
    //< the gate. Each is in the gate's log, and one no row holds is listed as a cause.
    t: = tally(outs)
    b.s("# the gates that ran (a SKIP line is a check that did not run; each gate's whole log is ")
        .s(LOG_DIR).s("/<gate>.log)\n")
    for i in Range.asc(outs.len)
        o: = outs.get(i)
        defer $row: = Str_builder()
        row.s("#   ").s(o.log)
        for $k: Sz = o.log.len; k < 15; k += 1
            row.c(' ')
        row.s("PASS" if o.ok else "FAIL").s(" \{o.sec\}s")
        if o.skips > 0
            for $k: = row.slice().len; k < 32; k += 1
                row.c(' ')
            row.s("\{o.skips\} SKIP line").s("" if o.skips == 1 else "s")
            if o.unexpected > 0
                row.s(", \{o.unexpected\} UNEXPECTED")
        b.s(row.slice()).c('\n')
    b
        .s("# gates invoked: \{outs.len\} (\{t.failed\} FAIL, SKIP lines in \{t.skipping\}), gate \
            seconds: \{t.sec\}, -j\{jobs\}\n")
    if t.failed == 0
        return
    b.s("# why it failed:\n")
    for i in Range.asc(outs.len)
        o: = outs.get(i)
        if o.ok
            continue
        $named: Sz = 0
        for k in Range.asc(o.causes.len)
            c: = o.causes.get(k)
            if c.kind != Cause_kind.tail
                named += 1
            if named > CAUSES_SHOWN
                continue
            b.s("#   ").s(o.log).s(": ")
            put_cause(c, b)
            b.c('\n')
        if named > CAUSES_SHOWN
            b.s("#   ").s(o.log).s(": … and \{named - CAUSES_SHOWN\} more in its log\n")
        b.s("#   ").s(o.log).s(": its whole log is ").s(LOG_DIR).c('/').s(o.log).s(".log\n")
    if t.unexpected > 0
        b.s("# UNEXPECTED: no row of `EXPECTED_SKIPS` in tools/ci_gates.kspl holds that SKIP for ")
            .s(j.platform).s("; bring its tool back, or add the row where this platform cannot ")
            .s("have it\n")

fn early_end(at: U8[], by_switch: Bool, not_run: List<|U8[]|>@, b: Str_builder$@) //<
    //< The round's last lines where a fallen gate ended it: what did not run, and why it ended
    //< **A gate not run is named as not run**, never left out: the list above holds only what ran.
    b.s("# not run (\{not_run.len\}):")
    for i in Range.asc(not_run.len)
        b.s(" " if i == 0 else ", ").s(not_run.get(i))
    b.c('\n')
    b.s("# ended early at ").s(at).s(": ")
    if by_switch
        b.s("STOP=1 ends the round at the first gate that fails")
    else
        b.s("the gates after it build on what it builds")
    b.s(", so this round is not a full verdict\n")

fn digest_md(outs: List<|Outcome|>@, jobs: I64, title: U8[], b: Str_builder$@) //<
    //< For the job's summary page
    //< Caution: **No log body goes in**: near 1 MiB a summary fails without a word; the logs are
    //< the round's artifacts.
    t: = tally(outs)
    b
        .s("## \{title\} - \{outs.len - t.failed\} PASS / \{t.failed\} FAIL   (\{t.sec\}s, \
            -j\{jobs\})\n\n")
    b.s("| gate | verdict | sec |\n| :-- | :-- | --: |\n")
    for i in Range.asc(outs.len)
        o: = outs.get(i)
        b.s("| ").s(o.log).s(" | ").s("PASS" if o.ok else "**FAIL**").s(" | \{o.sec\} |\n")
    if t.skipping > 0
        b.s("\nSKIP:\n\n")
        for i in Range.asc(outs.len)
            o: = outs.get(i)
            if o.skips > 0
                b.s("* `").s(o.log).s("`\n")
    b.s("\na fallen gate's reason is in the per-gate log among the same round's artifacts, log-*\n")

fn reset_logs( //< removes what an earlier round left, so it is not counted again
    //< Returns false where one stays.
    //< Caution: **Remove the suites' times too** (`out/log/suite/*.times`): `make test-suites`
    //< counts every one it finds.
    //< Caution: **Stop the round on a file that stays.** An old log left in place reads as this
    //< round's PASS for a gate that never ran. A folder that is not there holds nothing to remove.
    dirs: U8[][], //< the folders a round's logs go to: `LOG_DIRS`
    arena: Arena$@,
): Bool
    $all_gone: = true
    for dir in dirs
        // A folder that stands but cannot be listed is not empty: its old logs stay.
        names: = fs.read_dir(dir, arena) catch
            if fs.exists(dir)
                io.err().s("ci: an earlier round's \{dir\} cannot be listed\n")
                all_gone = false
            continue
        for name in names
            if name.ends_with(".log") || name.ends_with(END_EXT) || name.ends_with(".times")
                path: = fs.join(dir, name, arena)
                fs.remove_path(path) catch
                    io.err().s("ci: an earlier round's \{path\} cannot be removed\n")
                    all_gone = false
    return all_gone

//< The AI-assist tools' own logic: counting the corpus, and the oracle's answers
import "std/chars"
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/verdict"
import "tools/ai_assist/corpus_count" as count
import "tools/ai_assist/ksplc_oracle" as oracle

// ==========================================
// Tests the functions that count the training material (`tools/ai_assist/corpus_count.kspl`).
//
// It is tested because **a mistake here breaks nothing visible.** A wrong word boundary or an
// extra line gives a plausible number. That looks the same as the material growing.
// Caution: Test each case that matches together with one that does not.
// ==========================================

fn test_which_folder_is_left_out() //< `negative` is the only folder left out of the scan
    //< It keeps broken spellings out of the material.
    verdict.start("[tools/ai_assist] the folders left out of the material test...")
    assert(count.skip_dir("negative"), "negative is left out")
    // **Do not skip on a partial match** (a folder with a similar name would be skipped too).
    assert(!count.skip_dir("negatives"), "negatives is not left out")
    assert(!count.skip_dir("runtime"), "runtime is not left out")
    assert(!count.skip_dir(""), "an empty name is not left out")
    verdict.pass("only `negative` is left out; a merely similarly named folder stays.")

fn test_counting_words() //< words split on whitespace, a run of it being one boundary
    verdict.start("[tools/ai_assist] how words are counted test...")
    assert(count.count_words("") == 0, "an empty spelling is 0 words")
    assert(count.count_words("   ") == 0, "whitespace alone is 0 words")
    assert(count.count_words("abc") == 1, "one word")
    assert(count.count_words("a b c") == 3, "split on whitespace")
    // **Do not add a run of whitespace to the word count.**
    assert(count.count_words("a    b") == 2, "whitespace in a row does not add words")
    assert(count.count_words("  a b  ") == 2, "whitespace before and after is not a word")
    assert(count.count_words("a\nb\tc") == 3, "a newline and a tab are boundaries too")
    verdict
        .pass("words split on whitespace, and neither a run nor surrounding whitespace adds one.")

fn test_counting_lines() //< the lines are the newline count + 1, an empty text counting as one
    verdict.start("[tools/ai_assist] how lines are counted test...")
    // **Do not count from 0**: one line with no newline is 1 line.
    assert(count.count_lines("") == 1, "an empty spelling is 1 line too")
    assert(count.count_lines("abc") == 1, "with no newline it is 1 line")
    assert(count.count_lines("a\nb") == 2, "one newline makes 2 lines")
    // A trailing newline adds one more line (the empty last line counts).
    assert(count.count_lines("a\n") == 2, "a trailing newline counts as one too")
    assert(count.count_lines("a\nb\nc") == 3, "two newlines make 3 lines")
    verdict.pass("the lines are the newline count plus 1, and even an empty spelling is 1 line.")

fn test_the_token_estimate() //< the estimate is the larger of the length / 4 and the word count
    verdict.start("[tools/ai_assist] the token estimate test...")
    // With few, long words, the length wins.
    assert(count.approx_tokens("aaaaaaaaaaaaaaaa") == 4, "one long word is estimated by the length")
    // **Do not let it drop below the word count** (with short words, length / 4 is smaller).
    assert(count.approx_tokens("a b c d e f g h") == 8,
        "short words in a row are estimated by the word count")
    assert(count.approx_tokens("") == 0, "an empty spelling is 0")
    verdict.pass("the estimate is the larger of the length / 4 and the word count, below neither.")

// ==========================================
// tools/ai_assist/ksplc_oracle: checks the compiler oracle. The cases: 0 errors, a type error, a
// syntax error, an error after sema, the temporary file's removal, a stream with no closing object,
// JSONL. It really starts ksplc_stage1.exe (make debug depends on $(STAGE1_EXE), so it is built).
// ==========================================
fn test_compile_errors(arena: Arena$@) //< the count and the first error, from a real ksplc
    verdict.start("[Oracle] ksplc_oracle.compile_errors/compiles/first_error test...")

    good: = "fn main() {}\n"
    good_r: = oracle.compile_errors(good, "_oracle_test_good", arena)
    assert(good_r.error_count == 0, "valid source must compile with 0 errors")
    kspl_left: = fs.exists("tools/ai_assist/corpus/_oracle_test_good.kspl")
    c_left: = fs.exists("tools/ai_assist/corpus/_oracle_test_good.c")
    assert(!kspl_left && !c_left, "compile_errors must clean up its temp .kspl/.c files")
    assert(oracle.first_error(good_r.stderr_data, arena).len == 0, "a clean compile has no error")

    type_err: = "fn main()\n    x: I32 = \"not a number\"\n\n"
    type_r: = oracle.compile_errors(type_err, "_oracle_test_type_err", arena)
    assert(type_r.error_count == 1, "a type error is the closing object's one error")
    diag: = oracle.first_error(type_r.stderr_data, arena)
    assert(diag.ends_with(":2:14: expected 'I32', but got 'U8[]'"),
        "first_error gives the error's place and message, read from its JSON object")
    type_err_compiles: = oracle.compiles(type_err, "_oracle_test_type_err2", arena)
    assert(!type_err_compiles, "compiles() must be false when compile_errors' count is nonzero")

    // A syntax error is counted in the closing object like any other.
    garbage: = ")))garbage{{{***\n"
    garbage_r: = oracle.compile_errors(garbage, "_oracle_test_garbage", arena)
    assert(garbage_r.error_count == 1, "a parse-broken source is the closing object's one error")

    // A source that passes sema and fails in code generation.
    // Caution: **Always test this path.** A count taken right after sema misses later errors and
    // says 0, counting a failure as a pass. In C a fixed-length array takes two pairs of braces per
    // level, so 97 levels reach the limit on a zero initializer.
    $deep: = Str_builder.new()
    deep.s("fn main()\n    a: I32")
    for _i in Range.asc(97)
        deep.s("[1]")
    deep.s(" = ::{};\n}\n")
    late_r: = oracle.compile_errors(deep.slice(), "_oracle_test_late_err", arena)
    assert(late_r.error_count == 1, "an error raised after sema must still reach the count")
    late_compiles: = oracle.compiles(deep.slice(), "_oracle_test_late_err2", arena)
    assert(!late_compiles, "compiles() must be false for a source that fails in codegen")

    verdict
        .pass("a clean compile, a type, a syntax and a late error give the closing object's count, \
            and the temp file was cleared.")

priv fn closing(stream: U8[], arena: Arena$@): I32 //<
    //< the count read from a stream, or -1 for none
    return oracle.closing_errors(stream, arena).unwrap_or(-1I32)

fn test_reading_the_closing_object(arena: Arena$@) //< a count only from the closing object
    verdict.start("[Oracle] ksplc_oracle.closing_errors test...")
    diag: =
        "{\"severity\":\"error\",\"code\":null,\"kind\":null,\"message\":\"m\",\"file\":\"a.kspl\",\"line\":2,\"column\":3,\"end_column\":4}\n"
    failed: = "{\"result\":\"failed\",\"errors\":1,\"warnings\":0,\"informations\":0,\"hints\":0}\n"
    passed: =
        "{\"result\":\"succeeded\",\"errors\":0,\"warnings\":0,\"informations\":0,\"hints\":0}\n"
    assert(closing(arena.text().s(diag).s(failed).take(), arena) == 1, "a failed run's count")
    assert(closing(passed, arena) == 0, "a clean run's count")
    // **A run that ends before its verdict has no count**, however many errors it wrote.
    assert(closing(diag, arena) == -1, "diagnostics with no closing object give no count")
    assert(closing(arena.text().s(diag).s("fatal: nesting too deep\n").take(), arena) == -1,
        "a run ending on a line of text gives no count")
    assert(closing("", arena) == -1, "a run that wrote nothing gives no count")
    // **Only the last line closes**: a closing object with a diagnostic after it is not the end.
    assert(closing(arena.text().s(failed).s(diag).take(), arena) == -1,
        "a closing object that is not the last line gives no count")
    assert(closing("{\"result\":\"failed\",\"errors\":0}\n", arena) == -1,
        "a failed verdict with no error gives no count")
    assert(closing("{\"result\":\"succeeded\",\"errors\":2}\n", arena) == -1,
        "a passed verdict with errors gives no count")
    verdict.pass("only a closing object on the last line, agreeing with its count, gives a count.")

fn test_load_jsonl(arena: Arena$@) //< a JSONL file becomes one value per line
    verdict.start("[Oracle] ksplc_oracle.load_jsonl test...")

    // **The file goes in out/tmp**, not corpus/ (which is untracked and absent in a fresh tree);
    // The entry point (`tests/debug/main.kspl`, `tools/tests/main.kspl`) creates out/tmp.
    fixture: = "out/tmp/oracle_load_jsonl.jsonl"
    io.write_file(fixture,
        "{\"path\":\"a.kspl\",\"code\":\"x\"}\n\n{\"path\":\"b.kspl\",\"code\":\"y\"}\n")
        catch panic("failed to write load_jsonl test fixture")

    recs: = oracle.load_jsonl(fixture, arena)
        catch panic("load_jsonl must not fail to read a well-formed fixture")
    // out/tmp is remade on every build, so a failed delete does not carry over.
    fs.remove_path(fixture) catch {}

    assert(recs.len == 2, "blank lines must be skipped; exactly 2 records expected")
    assert(recs[0].get("path").as_str().unwrap_or("").equals("a.kspl"),
        "record 0's 'path' must round-trip")
    assert(recs[1].get("code").as_str().unwrap_or("").equals("y"),
        "record 1's 'code' must round-trip")

    verdict.pass("blank lines are skipped and each line's JSON is restored correctly.")

//< Reads what GNU make knows of a build: its database, and the make files' own lines
//< This file only reads text; its callers run make. **The targets and the values come from make's
//< own database** (`make -p`), so they cannot drift from the make files: the check of the make
//< names a document writes reads it (`tests/support/docref_make.kspl`). The make files' own lines
//< serve the checks that read what they write (`tests/suite/recipe_bytes_test.kspl`).
import "std/chars"
import "std/ds" { List, Map }
import "std/mem" { Arena }
import "std/str"
import "std/sys"

pub struct Var //< one variable as make's database records it
    name: U8[]
    pub value: U8[] //< expanded for a simple variable, as written for a recursive one

pub struct Entry //< one file the database records: a target, or a file a target names
    name: U8[]
    pub target: Bool //<
        //< a rule names it as its target (the database does not mark it `Not a target`)

pub struct Db //< make's database: every variable, every file and every pattern rule it recorded
    pub vars: Map<|U8[], Var|>
    pub files: Map<|U8[], Entry|>
    pub order: List<|U8[]|> //< the files' names in the order the database lists them
    pub patterns: List<|U8[]|> //< each pattern rule's targets, as its line writes them

priv const ORIGINS: U8[][] = U8[][]::{ "default", "environment", "environment under -e",
    "automatic", "command line", "override", "makefile", "'override' directive" } //<
        //< The origins `make -p` writes on the line above a variable

pub fn make_speaks_english() //<
    //< Sets this process's environment so the makes it starts write their database in English
    //< **make translates the database's comments** (`# Not a target:`, `(from '...', line N)`)
    //< under a Japanese locale, and they are what this file reads. Only the messages are set:
    //< under `LC_ALL=C` the character set is ASCII too, and the root make file warns of that.
    if all: = sys.get_env("LC_ALL")
        sys.set_env("LANG", all) catch {}
    sys.unset_env("LC_ALL") catch {}
    sys.set_env("LC_MESSAGES", "C") catch {}
    sys.unset_env("LANGUAGE") catch {}

pub fn last_db(out: U8[]): U8[] //< the main make's database, the last one printed
    //< **A recursive make prints its own database first**: with `-p` in `MAKEFLAGS`, every
    //< sub-make a recipe starts prints one, and the make asked prints its own when it ends.
    $at: Sz = 0
    $from: Sz = 0
    for
        found: = out.sub_from(at).find_str("# Make data base, printed on") catch
            break
        from = at + found
        at = from + 1
    return out.sub_from(from)

priv fn is_origin(line: U8[]): Bool //< whether it is a `# <origin>` line, which opens a variable
    if !line.starts_with("# ")
        return false
    rest: = line.sub_from(2)
    $word: = rest
    if open: = rest.find_str(" (from '")
        word = rest.sub(0, open)
        if rest.sub_from(open + 8).find_str("', line ").is_none()
            return false
    return ORIGINS.contains(word)

priv fn var_line(head: U8[]): Var? //< `NAME = value`, `NAME := value` or a target's own
    //< A target's own variable can also read `NAME += value`, appended to the value outside it, or
    //< `NAME ?= value`.
    text: = head.strip_prefix("override ")
    if text.starts_with("define ")
        return .some(Var::{ .name = text.sub_from(7).trim_spaces(), .value = "" })
    sp: = text.find_char(' ') catch
        return .none
    rest: = text.sub_from(sp + 1)
    end: = rest.find_char(' ').unwrap_or(rest.len)
    op: = rest.sub(0, end)
    if !(op.equals("=") || op.equals(":=") || op.equals("+=") || op.equals("?="))
        return .none
    return .some(Var::{ .name = text.sub(0, sp),
        .value = rest.sub_from(end + 1) if end < rest.len else "" })

pub fn parse_db(text: U8[], arena: Arena$@): Db //< reads one database, as `last_db` cut it
    $db: = Db::{ .vars = Map<|U8[], Var|>(arena), .files = Map<|U8[], Entry|>(arena),
        .order = List<|U8[]|>(arena), .patterns = List<|U8[]|>(arena) }
    lines: = text.lines(arena)
    $i: Sz = 0
    $section: U8[] = ""
    for i < lines.len
        line: = lines.get(i)
        if line.starts_with("# Variables") || line.starts_with("# Files") ||
            line.starts_with("# Implicit Rules") || line.starts_with("# Directories") ||
            line.starts_with("# Pattern-specific") || line.starts_with("# VPATH") ||
            line.starts_with("# files hash-table")
            section = line
            i += 1
            continue
        if section.starts_with("# Variables")
            i = read_var(lines, i, db.vars@, arena)
        else if section.starts_with("# Files")
            i = read_entry(lines, i, db@)
        else
            // A pattern rule's line is the one that opens with neither `#` nor a recipe's tab.
            if section.starts_with("# Implicit Rules") && line.len > 0 && line[0] != '#' &&
                line[0] != '\t'
                if colon: = header_colon(line)
                    db.patterns.push(line.sub(0, colon))
            i += 1
    return db

priv fn read_var(lines: List<|U8[]|>, at: Sz, into: Map<|U8[], Var|>$@, arena: Arena$@): Sz //<
    //< Reads the variable whose origin line is at `at`; where the next one starts
    //< **A value can take several lines**: a `define`, or `:=` of one. It runs to the next origin.
    if !is_origin(lines.get(at)) || at + 1 >= lines.len
        return at + 1
    head: = lines.get(at + 1)
    $v: = var_line(head) catch
        return at + 2
    $i: = at + 2
    body: = arena.text()
    body.s(v.value)
    is_define: = head.strip_prefix("override ").starts_with("define ")
    // A value on the head line goes on with a newline; a define's body starts on the next line.
    $newline: = !is_define
    for i < lines.len
        l: = lines.get(i)
        if is_origin(l) || l.starts_with("# variable set hash-table")
            break
        if is_define && l.equals("endef")
            i += 1
            break
        if newline
            body.c('\n')
        newline = true
        body.s(l)
        i += 1
    v.value = body.take().trim_end() if !is_define else body.take()
    into.set(v.name, v)
    return i

priv fn header_colon(line: U8[]): Sz? //< where an entry's `name:` ends, at a colon then a space
    for i in Range.asc(line.len)
        if line[i] == ':' &&
            (i + 1 == line.len || line[i + 1] == ' ' || line[i + 1] == ':')
            return .some(i)
    return .none

priv fn read_entry(lines: List<|U8[]|>, at: Sz, db: Db$@): Sz //<
    //< Reads one file's entry starting at `at`; where the next one starts
    //< The lines above its `name: prerequisites` can mark it `# Not a target:` or set variables
    //< for it alone (an origin line, then `name: VAR := value`), which are passed over.
    $i: = at
    $target: = true
    for i < lines.len && lines.get(i).len == 0
        i += 1
    for i < lines.len
        l: = lines.get(i)
        if l.equals("# Not a target:")
            target = false
            i += 1
            continue
        if is_origin(l)
            i = past_target_var(lines, i + 1)
            continue
        break
    if i >= lines.len || lines.get(i).starts_with("#")
        return i + 1
    head: = lines.get(i)
    colon: = header_colon(head) catch
        return i + 1
    e: = Entry::{ .name = head.sub(0, colon), .target = target }
    // Its body (the recipe, and make's notes on the file) runs to the next empty line.
    i += 1
    for i < lines.len && lines.get(i).len > 0
        i += 1
    if db.files.get(e.name).is_none()
        db.order.push(e.name)
    db.files.set(e.name, e)
    return i

priv fn past_target_var(lines: List<|U8[]|>, at: Sz): Sz //<
    //< Passes over `name: VAR := value` and the lines its value runs on; where the next line starts
    if at >= lines.len
        return at
    l: = lines.get(at)
    colon: = header_colon(l) catch
        return at + 1
    name: = l.sub(0, colon)
    if var_line(l.sub_from(colon + 1).trim_start()).is_none()
        return at + 1
    $i: = at + 1
    for i < lines.len
        n: = lines.get(i)
        if n.len == 0 || is_origin(n) ||
            n.starts_with(name) && n.sub_from(name.len).starts_with(":")
            break
        i += 1
    return i

// ==========================================
// The make files' own lines: where a rule is written, and what a line sets.
// ==========================================

pub struct Source_line //< one logical line of a make file: continuations joined, comment cut
    pub first: Sz //< its first physical line, from 1
    pub text: U8[]
    pub recipe: Bool //< it starts with a tab: a recipe line, not make's own syntax

pub fn joined_lines(text: U8[], arena: Arena$@): List<|Source_line|> //<
    //< The file's lines with each continued line joined on, and nothing cut
    //< A comment and a `define`'s body stay, for a check that reads what the make files write.
    $out: = List<|Source_line|>(arena)
    phys: = text.lines(arena)
    $i: Sz = 0
    for i < phys.len
        first: = i + 1
        joined: = arena.text()
        $l: = phys.get(i)
        for l.ends_with("\\") && i + 1 < phys.len
            joined.s(l.sub(0, l.len - 1).trim_end()).c(' ')
            i += 1
            l = phys.get(i).trim_start()
        joined.s(l)
        i += 1
        whole: = joined.take()
        out
            .push(Source_line::{ .first = first, .text = whole,
            .recipe = whole.starts_with("\t") })
    return out

pub fn cut_comment(line: U8[]): U8[] //< the line before its comment
    for i in Range.asc(line.len)
        if line[i] == '#' && (i == 0 || line[i - 1] != '\\')
            return line.sub(0, i)
    return line

pub struct Rule_line //< a rule as one line writes it
    file: U8[]
    line: Sz //< its first physical line
    pub targets: U8[] //< as written, before the colon
    pub prereqs: U8[] //< as written, after it, with `|` kept; empty for none
    double: Bool //< `::`, a rule of its own for each

pub fn rule_of(l: Source_line, file: U8[]): Rule_line? //<
    //< the rule the line writes, if it writes one
    //< **Not a rule**: a recipe, a directive, an assignment (an `=` before the colon, or `:=`),
    //< and a target's own variable (`t: VAR = x`), whose place the database gives.
    if l.recipe
        return .none
    t: = l.text.trim_start()
    for d in U8[][]::{ "include ", "-include ", "sinclude ", "ifeq", "ifneq", "ifdef ", "ifndef ",
        "else", "endif", "export ", "unexport ", "vpath", "undefine ", "define ", "override " }
        if t.starts_with(d)
            return .none
    $depth: Sz = 0
    for i in Range.asc(t.len)
        ch: = t[i]
        if ch == '(' || ch == '{'
            depth += 1
        else if ch == ')' || ch == '}'
            depth -= 1
        else if depth == 0 && ch == '='
            return .none
        if depth == 0 && ch == ':'
            rest: = t.sub_from(i + 1)
            if rest.starts_with("=") || rest.starts_with(":=") || rest.starts_with("::=")
                return .none
            double: = rest.starts_with(":")
            $after: = rest.strip_prefix(":")
            after = after.sub(0, after.find_char(';').unwrap_or(after.len))
            if top_level_has(after, '=')
                return .none
            return .some(Rule_line::{ .file = file, .line = l.first, .targets = t.sub(0, i),
                .prereqs = after.trim_spaces(), .double = double })
    return .none

priv fn top_level_has(text: U8[], want: U8): Bool //< the byte appears outside every `$(…)`
    $depth: Sz = 0
    for ch in text
        if ch == '(' || ch == '{'
            depth += 1
        else if ch == ')' || ch == '}'
            depth -= 1
        else if depth == 0 && ch == want
            return true
    return false

pub fn words(text: U8[], arena: Arena$@): List<|U8[]|> //< the words, cut at any whitespace
    $out: = List<|U8[]|>(arena)
    $start: Sz = 0
    $in_word: = false
    for i in Range.asc(text.len + 1)
        space: = i == text.len || text[i].is_space()
        if space && in_word
            out.push(text.sub(start, i - start))
            in_word = false
        else if !space && !in_word
            start = i
            in_word = true
    return out

fn source_op(line: U8[]): U8[] //< the operator a make file's line sets a variable with
    //< `?=`, `+=`, `!=`, `:=`, `::=`, `=` or `define`; empty where the line sets none
    //< (a value made by `$(eval)` names the line of the call).
    t: = line.trim_start().strip_prefix("override ").strip_prefix("export ")
        .strip_prefix("private ")
    if t.starts_with("define ")
        return "define"
    eq: = t.find_char('=') catch
        return ""
    if eq == 0
        return "="
    before: = t[eq - 1]
    if before == '?'
        return "?="
    if before == '+'
        return "+="
    if before == '!'
        return "!="
    if before == ':'
        return "::=" if eq >= 2 && t[eq - 2] == ':' else ":="
    return "="

pub fn help_of(l: U8[], file: Sz, line: Sz, arena: Arena$@): Help? //<
    //< What one `## <group>|<target>|<description>` line says; none where the line is not one
    if !l.starts_with("## ")
        return .none
    parts: = l.sub_from(3).split('|', arena)
    if parts.len < 3
        return .none
    return .some(Help::{ .file = file, .line = line, .group = parts.get(0).trim_spaces(),
        .spec = parts.get(1).trim_spaces(),
        .text = l.sub_from(3 + parts.get(0).len + 1 + parts.get(1).len + 1) })

pub struct Help //< one `##` line of `make help`
    file: Sz //< which of the texts given holds it
    line: Sz
    pub group: U8[]
    pub spec: U8[] //< the target, or a family's name ending in `*`
    text: U8[]

pub fn assigned_name(t: U8[]): U8[] //< the variable the line sets; empty where it sets none
    body: = t.strip_prefix("override ").strip_prefix("export ").strip_prefix("private ")
    if body.starts_with("define ")
        rest: = body.sub_from(7).trim_spaces()
        return rest.sub(0, rest.find_char(' ').unwrap_or(rest.len))
    if rule_of(Source_line::{ .first = 0, .text = body, .recipe = false }, "").is_some()
        return ""
    op: = source_op(body)
    if op.len == 0
        return ""
    eq: = body.find_char('=').unwrap_or(0)
    name: = body.sub(0, eq + 1 - op.len).trim_spaces()
    if name.len == 0 || name.find_char(' ').is_some() || name.find_char(':').is_some() ||
        name.find_char('$').is_some() || name.find_char('(').is_some()
        return ""
    return name

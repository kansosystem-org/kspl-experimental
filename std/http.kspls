//< Parses and builds HTTP/1.1 messages, both requests and responses
//<
//< Use it for a web server or client over `std/net`'s TCP sockets. **It supports only a body
//< delimited by `Content-Length`**: not `Transfer-Encoding: chunked`, a body read to the close,
//< `100-continue` or HTTP/2. The reader handles pipelining through `consumed`; it reads a response
//< as the answer to a request other than HEAD.

// ==========================================
// Caution: **Refuse any syntax where another implementation might find a different body boundary;
// never interpret it silently.** A boundary one byte off from the server in front (a reverse
// proxy) allows request smuggling.
// ==========================================
import "std/chars"
import "std/mem" { Arena }
import "std/net"
import "std/str" { Str_builder }
import "std/strnum" // `parse_size`
import "std/sys"

pub enum Http_error //< why a message could not be read, or cannot be trusted
    invalid_request_line //< the first line is not `METHOD target VERSION`
    invalid_status_line //< the first line is not `VERSION status reason`
    invalid_header //< a header line is not `name: value`
    unsupported_transfer_encoding //< the message has `Transfer-Encoding`, which is always refused.
        //<
        //< Ignoring it silently would let it disagree with Content-Length (request smuggling).
    length_mismatch //< what a head being built says of the body's length is not what is written
        //<
        //< A `Content-Length` naming another length or given twice, or a length or a body where the
        //< status allows none (1xx, 204, 304). A reader would cut the message somewhere else.
    unsupported_close_delimited //< a response that may carry a body names no `Content-Length`
        //<
        //< Its body runs to the close, which is not read here: cut off early, it cannot be told
        //< from a whole one, so it is refused rather than read as empty.
    invalid_line_break //< a bare CR or LF was in the headers; only CRLF ends a line
    unsupported_version //< the version is not `HTTP/` plus one digit, a dot and one digit
    incomplete //< the header or body has not all arrived yet
    head_too_large //< the first line and the headers went over `max_head_bytes` (HTTP's 431)
    body_too_large //< `Content-Length` names more than the caller's body limit (HTTP's 413)
    connection_closed //< the peer closed before the header or body was fully read
    io(err: net.Net_error) //< the socket itself failed

pub const max_head_bytes: Sz = 64 * 1024 //< the most a message's head may take, against DoS
    //<
    //< The head is the first line and the headers; every reader here refuses a longer one.
pub const default_max_body_bytes: Sz = 16 * 1024 * 1024 //< the body limit if the caller sets none

// ---------------------------------------------------------
// Checking the character sets (the parser and the builder use the same ones)
// ---------------------------------------------------------

priv fn is_token(s: U8[]): Bool //<
    //< Whether it is an RFC 9110 token, the character set of a header name and a method
    //<
    //< An empty string is not a token.
    //< Caution: **Check a header name with this.** If a space were allowed, `Content-Length : 5`,
    //< which the proxy in front passes on as "an unknown header", would be Content-Length only
    //< here: the body boundaries disagree, the same hole that Transfer-Encoding is refused for.
    if s.len == 0
        return false
    for i in Range.asc(s.len)
        if !s[i].is_alnum() && "!#$%&'*+-.^_`|~".find_char(s[i]).is_none()
            return false
    return true

priv fn is_field_value(s: U8[]): Bool //<
    //< Whether the text can appear in a header value or a reason phrase
    //<
    //< It refuses control characters other than HTAB, and DEL (0x80-0xFF is allowed). An empty
    //< string is allowed.
    for i in Range.asc(s.len)
        if s[i] != '\t' && (s[i] < ' ' || s[i] == 127)
            return false
    return true

priv fn check_version(v: U8[]): Void!Http_error //<
    //< HTTP-version is always 8 bytes: "HTTP/" + one digit + "." + one digit
    if v.len != 8 || !v.starts_with("HTTP/")
        throw .unsupported_version
    if !v[5].is_digit() || v[6] != '.' || !v[7].is_digit()
        throw .unsupported_version

priv const sz_max: Sz = Sz::((~0U64) >> U64::(65 - sizeof(Sz) * 8)) //< the largest `Sz`

priv fn parse_digits(s: U8[]): Sz!Http_error //< it accepts only `1*DIGIT`, up to what `Sz` holds
    //<
    //< Caution: **Do not use parse_size**, which reads `5abc` as 5 and accepts `+5`; accepting what
    //< the proxy in front refuses makes the body boundaries disagree.
    if n: = s.to_count(sz_max)
        return n
    throw .invalid_header

// ---------------------------------------------------------
// The headers (a linked list with case-insensitive names; the order is kept, and several headers
// with the same name are allowed)
// ---------------------------------------------------------
pub struct Header //< one header, linked to the next in the order they arrived
    pub name: U8$[] //< the name as it arrived; its case has no meaning
    pub value: U8$[] //< the value as it arrived, with surrounding whitespace trimmed
    pub next: Header$@ //< the header after this one, or null

impl Header
    pub fn find( //< the first value with that name, or nothing; case is ignored
        r: Self$@,
        name: U8[], //< the header name to look for
    ): U8[]?
        $node: = r
        for node != null
            if node.name.equals_ignore_case(name)
                return .some(node.value)
            node = node.next
        return .none

    priv fn has(r: Self$@, name: U8[]): Bool
        return r.find(name).is_some()

priv fn get_content_length(head: Header$@): Sz?!Http_error //<
    //< Parses the Content-Length header's value; none where it is absent
    //<
    //< Transfer-Encoding is refused, and so are two different Content-Length values:
    //< implementations disagree on which one to use, which opens the way to smuggling.
    $found: = false
    $length: Sz = 0
    $node: = head
    for node != null
        if node.name.equals_ignore_case("Transfer-Encoding")
            throw .unsupported_transfer_encoding
        if node.name.equals_ignore_case("Content-Length")
            v: = parse_digits(node.value)!
            if found && v != length
                throw .invalid_header
            found = true
            length = v
        node = node.next
    return .some(length) if found else .none

priv fn check_content_length(head: Header$@, max_body: Sz): Sz?!Http_error //<
    //< Refuses a Content-Length larger than max_body
    content_length: = get_content_length(head)!
    if n: = content_length
        if n > max_body
            throw .body_too_large
    return content_length

priv fn may_carry_body(status: I32): Bool //< whether a response with this status can have a body
    //<
    //< 1xx, 204 and 304 never do, whatever their head says (RFC 9112 §6.3).
    return status >= 200 && status != 204 && status != 304

pub struct Header_builder //< builds a header list, keeping the order the headers were added in
    //<
    //< The same "list builder that tracks head/tail by value" pattern as json.kspls's
    //< Obj_builder/Array_builder.
    pub arena: Arena$@ //< where the headers go
    pub head: Header$@ //< the first header added, or null
    pub tail: Header$@ //< the last header added, so the next one is appended without a walk

pub fn headers( //< an empty header builder
    arena: Arena$@, //< where the headers go
): Header_builder //< the builder; each add returns it again, for chaining
    return Header_builder::{ .arena = arena, .head = null, .tail = null }

impl Header_builder
    pub fn add( //< appends one header; the same name may be added again
        $r: Self,
        name: U8[], //< the header name
        value: U8[], //< its value
    ): Self
        hdr: Header = ::{ .name = r.arena.dup_str(name), .value = r.arena.dup_str(value),
            .next = null }
        h: = r.arena.create(hdr)
        if r.head == null
            r.head = h
        else
            r.tail.next = h
        r.tail = h
        return Header_builder::{ .arena = r.arena, .head = r.head, .tail = h }

    pub fn build(r: Self): Header$@ //< the list built so far, or null if none was added
        return r.head

// ---------------------------------------------------------
// Request / Response. The reader drops `consumed` bytes to reach the next message
// (Str_builder.drop_prefix).
// ---------------------------------------------------------
pub struct Request //< one received request, and how much of the buffer it used
    pub method: U8$[] //< the method as it arrived, such as `GET`
    pub target: U8$[] //< the raw target, including the query string, such as `/foo?x=1`
    pub version: U8$[] //< the version as it arrived, such as `HTTP/1.1`
    pub headers: Header$@ //< the headers in the order they arrived, or null
    pub body: U8$[] //< the body, of the length `Content-Length` gave
    pub consumed: Sz //< how many bytes of the buffer this message used; the rest is the next one

pub struct Response //< one received response, and how much of the buffer it used
    pub version: U8$[] //< the version as it arrived, such as `HTTP/1.1`
    pub status: I32 //< the status number
    pub reason: U8$[] //< the reason phrase, as the peer wrote it
    pub headers: Header$@ //< the headers in the order they arrived, or null
    pub body: U8$[] //< the body, of the length `Content-Length` gave
    pub consumed: Sz //< how many bytes of the buffer this message used; the rest is the next one

// ---------------------------------------------------------
// The shared core of buffer parsing (the state of one CRLF-delimited scan)
// ---------------------------------------------------------
priv struct Scan_ctx
    src: U8[]
    pos: Sz

priv fn read_line(ctx: Scan_ctx$@): U8[]!Http_error //<
    //< Cuts out one line ending in "\r\n", without the "\r\n", and moves pos past it
    //<
    //< If none is found it throws incomplete.
    //< Caution: **Accept a bare LF or a bare CR neither as a line end nor as content.** Many
    //< implementations split on an LF alone, so `Content-Length: 0\nContent-Length: 44` would be
    //< one header to one side and two to the other.
    start: = ctx.pos
    for ctx.pos < ctx.src.len
        if ctx.src[ctx.pos] == '\n'
            throw .invalid_line_break
        if ctx.src[ctx.pos] == '\r'
            if ctx.pos + 1 >= ctx.src.len
                break // maybe in the middle of a CRLF; do not decide yet
            if ctx.src[ctx.pos + 1] != '\n'
                throw .invalid_line_break
            line: = ctx.src.sub(start, ctx.pos - start)
            ctx.pos += 2
            return U8[]::line
        ctx.pos += 1
    throw .incomplete

priv fn parse_headers(ctx: Scan_ctx$@, arena: Arena$@): Header$@!Http_error //<
    //< Parses the "Name: Value" lines up to the empty line
    $b: = headers(arena)
    for
        line: = read_line(ctx)!
        if line.len == 0
            break
        switch line.find_char(':')
        case .none
            throw .invalid_header
        case .some(colon)
            // Caution: **Check the name as it is, without trimming** (see is_token); the value is
            // trimmed by convention.
            name: = line.sub(0, colon)
            value: = line.sub_from(colon + 1).trim_spaces()
            if !is_token(name) || !is_field_value(value)
                throw .invalid_header
            b = b.add(name, value)
    return b.build()

priv struct Request_line //< parses the request line ("METHOD SP target SP HTTP-version")
    method: U8[]
    target: U8[]
    version: U8[]

priv fn parse_request_line(line: U8[]): Request_line!Http_error
    if sp1: = line.find_char(' ')
        rest: = line.sub_from(sp1 + 1)
        if sp2: = rest.find_char(' ')
            method: = line.sub(0, sp1)
            target: = rest.sub(0, sp2)
            version: = rest.sub_from(sp2 + 1)
            // Caution: Do not accept an empty method or an empty target (`" / HTTP/1.1"`, `"GET
            // HTTP/1.1"`); every later branch would run on an empty string.
            if !is_token(method) || target.len == 0
                throw .invalid_request_line
            check_version(version)!
            return Request_line::{ .method = method, .target = target, .version = version }
    throw .invalid_request_line

priv struct Status_line //< parses the status line ("HTTP-version SP status SP reason")
    version: U8[]
    status: I32
    reason: U8[]

priv fn parse_status_line(line: U8[]): Status_line!Http_error
    if sp1: = line.find_char(' ')
        check_version(line.sub(0, sp1))!
        rest: = line.sub_from(sp1 + 1)
        $status_str: = rest
        $reason: U8[] = ""
        if sp2: = rest.find_char(' ')
            status_str = rest.sub(0, sp2)
            reason = rest.sub_from(sp2 + 1)
        // status-code is three digits; otherwise `I32::` truncates silently (`4294967496` becomes
        // 200).
        if status_str.len != 3 || !is_field_value(reason)
            throw .invalid_status_line
        status: = parse_digits(status_str) catch
            throw .invalid_status_line
        return Status_line::{ .version = line.sub(0, sp1), .status = I32::status,
            .reason = reason }
    throw .invalid_status_line

priv fn build_request(arena: Arena$@, line: Request_line, head: Header$@, body: U8[], consumed: Sz):
    Request$@ //<
        //< parse_request's result, its parts copied into the arena
    req: Request = ::{
        .method = arena.dup_str(line.method),
        .target = arena.dup_str(line.target),
        .version = arena.dup_str(line.version),
        .headers = head,
        .body = arena.dup_str(body),
        .consumed = consumed,
    }
    return arena.create(req)

priv fn build_response(arena: Arena$@, line: Status_line, head: Header$@, body: U8[], consumed: Sz):
    Response$@ //<
        //< Shared by parse_response/read_response.
    resp: Response = ::{
        .version = arena.dup_str(line.version),
        .status = line.status,
        .reason = arena.dup_str(line.reason),
        .headers = head,
        .body = arena.dup_str(body),
        .consumed = consumed,
    }
    return arena.create(resp)

priv struct Head_parts //< a message's head, read, and where its body starts
    //<
    //< A request and a response differ only in the first line and how the body's length follows
    //< from the head, so they share the scan.
    first_line: U8[] //< a view into the buffer; parse it before the buffer grows
    head: Header$@
    head_end: Sz //< where the body starts in the buffer
    length: Sz? //< `Content-Length`'s, within the caller's limit; none where it is absent

priv fn request_body_len(h: Head_parts): Sz //< a request without `Content-Length` has no body
    return h.length.unwrap_or(0)

priv fn response_body_len(h: Head_parts, status: I32): Sz!Http_error //<
    //< A response's body length: 0 for a status that has no body, else `Content-Length`'s
    //<
    //< Caution: **Do not read an absent length as 0**: the body then runs to the close, and an
    //< empty body returned as success silently drops it.
    if !may_carry_body(status)
        return 0
    if n: = h.length
        return n
    throw .unsupported_close_delimited

priv fn scan_head(src: U8[], max_body: Sz, arena: Arena$@): Head_parts!Http_error //<
    //< Reads the head at the start of src, and checks both limits
    //<
    //< **Every reader goes through this**, buffered or from a socket, so the limits hold alike. It
    //< throws incomplete until the head's empty line arrives, or `head_too_large` past the limit.
    $ctx: = Scan_ctx::{ .src = src, .pos = 0 }
    first_line: = read_line(ctx@) catch e
        throw e.past_head_limit(src)
    head: = parse_headers(ctx@, arena) catch e
        throw e.past_head_limit(src)
    if ctx.pos > max_head_bytes
        throw .head_too_large
    length: = check_content_length(head, max_body)!
    return Head_parts::{ .first_line = first_line, .head = head, .head_end = ctx.pos,
        .length = length }

impl Http_error
    priv fn past_head_limit(r: Self, src: U8[]): Http_error //<
        //< The error to throw for a head still arriving: `head_too_large` once src passes the limit
        switch r
        case .incomplete
            if src.len > max_head_bytes
                return .head_too_large
        default {}
        return r

priv fn body_in(src: U8[], h: Head_parts, body_len: Sz): U8[]!Http_error //<
    //< The body that follows the head in src; it throws incomplete until all of it has arrived
    //<
    //< Caution: **Check the body's length.** All the headers can be present while the body is only
    //< partly there, and cutting without the check returns a view that points outside the buffer.
    if src.len - h.head_end < body_len
        throw .incomplete
    return src.sub(h.head_end, body_len)

pub fn parse_request( //< the one request at the start of the buffer; fails if it is incomplete
    //<
    //< **A body over `max_body` fails as soon as the head says so**, before it arrives, and a head
    //< over `max_head_bytes` as soon as that much has arrived without its end.
    src: U8[], //< what has arrived so far
    max_body: Sz, //< the largest body accepted (`default_max_body_bytes` when the caller has none)
    arena: Arena$@, //< where the parts are allocated
): Request$@!Http_error //< the request; fails with incomplete while more bytes are due
    h: = scan_head(src, max_body, arena)!
    req_line: = parse_request_line(h.first_line)!
    body_len: = request_body_len(h)
    body: = body_in(src, h, body_len)!
    return build_request(arena, req_line, h.head, body, h.head_end + body_len)

pub fn request_length( //< how many bytes the request at the start of the buffer takes in all
    //<
    //< **For a reader that waits for the body without parsing again**: once the head has arrived,
    //< the rest is a count. It fails as `parse_request` does on the head, `incomplete` included
    //< until the head's empty line arrives.
    src: U8[], //< what has arrived so far
    max_body: Sz, //< the largest body accepted, as `parse_request` takes it
    arena: Arena$@, //< where the head's parts are allocated
): Sz!Http_error //< the head's length plus the body's
    h: = scan_head(src, max_body, arena)!
    return h.head_end + request_body_len(h)

pub fn parse_response( //< the one response at the start of the buffer; fails if it is incomplete
    //<
    //< The body limit is `default_max_body_bytes`; the head's is `max_head_bytes`.
    src: U8[], //< what has arrived so far
    arena: Arena$@, //< where the parts are allocated
): Response$@!Http_error //< the response; fails with incomplete while more bytes are due
    h: = scan_head(src, default_max_body_bytes, arena)!
    status_line: = parse_status_line(h.first_line)!
    body_len: = response_body_len(h, status_line.status)!
    body: = body_in(src, h, body_len)!
    return build_response(arena, status_line, h.head, body, h.head_end + body_len)

// ---------------------------------------------------------
// Reading from a socket (reading until the header and the Content-Length body are all present)
// ---------------------------------------------------------

priv fn read_chunk_into(stream: net.Tcp_stream$@, b: Str_builder$@, chunk: U8$[], deadline_us: I64):
    Void!Http_error //<
        //< Appends up to chunk.len bytes read from stream to b, waiting no later than the deadline
        //<
        //< 0 bytes means the peer closed (`connection_closed`); the deadline passing is
        //< `timed_out`.
    left_ms: = (deadline_us - sys.mono_us()) / 1000I64
    if left_ms <= 0I64
        throw .io(.timed_out)
    n: = stream.read_for(chunk, I32::left_ms) catch e
        throw .io(e)
    if n == 0
        throw .connection_closed
    b.s(U8$[]::{ .ptr = chunk.ptr, .len = n })

priv const read_chunk: Sz = 4096 //< how much one read from a connection takes

priv fn read_head(stream: net.Tcp_stream$@, b: Str_builder$@, arena: Arena$@, max_body: Sz,
    deadline_us: I64): Head_parts!Http_error //<
        //< Reads from stream to the head's empty line (or past `max_head_bytes`); reads the head
        //<
        //< Caution: **Parse the first line before `read_body`.** It is a view into b, which a
        //< further read may move. **Look for the empty line only where it can newly be**, from
        //< three bytes before what the last read added: searched from the start each time, a head
        //< arriving a byte at a time costs its length squared.
    chunk: U8[read_chunk] = ::{}
    $from: Sz = 0
    for b.slice().sub_from(from).find_str("\r\n\r\n").is_none() && b.len <= max_head_bytes
        from = b.len - 3 if b.len > 3 else 0
        read_chunk_into(stream, b, U8$[]::chunk, deadline_us)!
    return scan_head(b.slice(), max_body, arena)

priv fn read_body(stream: net.Tcp_stream$@, b: Str_builder$@, h: Head_parts, body_len: Sz,
    deadline_us: I64): U8[]!Http_error //<
        //< Reads from stream until the body after the head is all in b; returns it, a view into b
    chunk: U8[read_chunk] = ::{}
    for b.len - h.head_end < body_len
        read_chunk_into(stream, b, U8$[]::chunk, deadline_us)!
    return b.slice().sub(h.head_end, body_len)

pub fn read_response( //< reads one whole response from a connection and splits it into its parts
    stream: net.Tcp_stream$@, //< the connection to read from, which blocks
    arena: Arena$@, //< where the parts are allocated
    max_body: Sz, //< the largest body accepted; a larger one is refused, not read
    timeout_ms: I32, //< how long the whole response may take to arrive; past it `.io(.timed_out)`
): Response$@!Http_error //< the response, held in `arena`; fails if the connection closes first
    deadline: = sys.deadline_after_ms(timeout_ms)
    $b: = Str_builder.new()
    defer b.free()
    h: = read_head(stream, b@, arena, max_body, deadline)!
    status_line: = parse_status_line(h.first_line)!
    body_len: = response_body_len(h, status_line.status)!
    body: = read_body(stream, b@, h, body_len, deadline)!
    return build_response(arena, status_line, h.head, body, h.head_end + body_len)

// ---------------------------------------------------------
// Writing. **The builder refuses whatever the parser refuses** (is_token / is_field_value,
// `Transfer-Encoding`), and the length is the body's: the builder adds `Content-Length` itself.
// ---------------------------------------------------------
priv fn write_header_lines(b: Str_builder$@, head: Header$@): Void!Http_error
    $node: = head
    for node != null
        if !is_token(node.name) || !is_field_value(node.value)
            throw .invalid_header
        b.s(node.name).s(": ").s(node.value).s("\r\n")
        node = node.next

priv fn check_framing(head: Header$@, length: Sz, names_length: Bool): Void!Http_error //<
    //< Refuses a head whose framing a reader would read otherwise than the bytes written
    //<
    //< A `Content-Length` given must name `length`, once. Where no length may be named
    //< (`names_length` false: 1xx, 204, 304), none may be given and `length` must be 0.
    //< Caution: **Refuse `Transfer-Encoding` here too**: with it, a reader ignores
    //< `Content-Length`.
    if !names_length && length > 0
        throw .length_mismatch
    $found: = false
    $node: = head
    for node != null
        if node.name.equals_ignore_case("Transfer-Encoding")
            throw .unsupported_transfer_encoding
        if node.name.equals_ignore_case("Content-Length")
            if found || !names_length || parse_digits(node.value)! != length
                throw .length_mismatch
            found = true
        node = node.next

priv fn write_framed_head(b: Str_builder$@, head: Header$@, length: Sz, names_length: Bool):
    Void!Http_error //<
        //< Writes the headers, the `Content-Length` they lack, and the empty line ending the head
        //<
        //< `check_framing` must have passed.
    write_header_lines(b, head)!
    if names_length && !head.has("Content-Length")
        b.s("Content-Length: \{length\}\r\n")
    b.s("\r\n")

pub fn write_request( //< sends one whole request: the first line, the headers and the body
    stream: net.Tcp_stream$@, //< the connection to write to
    method: U8[], //< the method, such as `GET`
    target: U8[], //< the target, including the query string
    head: Header$@, //< the headers, or null
    body: U8[]): Void!Http_error
    // Caution: Do not allow a space or a tab in the target. The request line splits on spaces (a
    // lenient server on any whitespace), so either makes the rest the version, and a second request
    // can be packed into one line.
    if !is_token(method) || target.len == 0 || !is_field_value(target) ||
        target.find_char(' ').is_some() || target.find_char('\t').is_some()
        throw .invalid_request_line
    check_framing(head, body.len, true)!
    $b: = Str_builder.new()
    defer b.free()
    b.s(method).s(" ").s(target).s(" HTTP/1.1\r\n")
    write_framed_head(b@, head, body.len, true)!
    b.s(body)
    // Caution: write can stop partway and silently truncate the message. Use write_all (see the
    // note in std/net.kspls).
    stream.write_all(b.slice()) catch e
        throw .io(e)
pub fn reason_phrase( //< the standard phrase for a status number, so the two cannot disagree
    //<
    //< RFC 9110's "reason-phrase"; empty for a number it does not know. The builders below write it
    //< from the number, so no caller passes the number and the phrase as a pair (which could say
    //< `404 Bad Request`).
    //< Caution: **Do not fill in `"unknown"`**: a phrase from nowhere stays in the receiver's log.
    status: I32, //< the status number
): U8[] //< the phrase, a fixed string that needs no freeing
    switch status
    case 200
        return "OK"
    case 201
        return "Created"
    case 204
        return "No Content"
    case 206
        return "Partial Content"
    case 301
        return "Moved Permanently"
    case 302
        return "Found"
    case 304
        return "Not Modified"
    case 400
        return "Bad Request"
    case 401
        return "Unauthorized"
    case 403
        return "Forbidden"
    case 404
        return "Not Found"
    case 405
        return "Method Not Allowed"
    case 408
        return "Request Timeout"
    case 409
        return "Conflict"
    case 411
        return "Length Required"
    case 413
        // RFC 9110's name (RFC 7231's is "Payload Too Large").
        return "Content Too Large"
    case 414
        return "URI Too Long"
    case 415
        return "Unsupported Media Type"
    case 429
        return "Too Many Requests"
    case 431
        return "Request Header Fields Too Large"
    case 500
        return "Internal Server Error"
    case 501
        return "Not Implemented"
    case 503
        return "Service Unavailable"
    case 505
        return "HTTP Version Not Supported"
    default {}
    return ""

pub fn format_response( //< builds one whole response as bytes, for the caller to send
    //<
    //< Appends the status line, the headers, an empty line and the body to b, **leaving the bytes
    //< to the caller**: a non-blocking socket cannot always send it all at once (see write_all in
    //< std/net.kspls), so the sender must remember how far it got and continue once writable.
    //< **The length is the body's**: one given that differs is refused, as is any body or length
    //< for 1xx, 204 and 304, whose head names none. The answer to a HEAD is
    //< `format_response_to_head`.
    b: Str_builder$@, //< where the message is built
    status: I32, //< the status number; its phrase is `reason_phrase`'s
    head: Header$@, //< the headers, or null; `Content-Length` is added here
    body: U8[], //< the whole body
): Void!Http_error
    write_status_line(b, status)!
    names_length: = may_carry_body(status)
    check_framing(head, body.len, names_length)!
    write_framed_head(b, head, body.len, names_length)!
    b.s(body)

pub fn format_response_to_head( //< builds the answer to a HEAD request: a head with no body
    //<
    //< The head is the one a GET would get: its `Content-Length` names `length`, the length of the
    //< body a GET would carry, which is not sent (RFC 9110 §9.3.2). For 1xx, 204 and 304 no length
    //< is named, and `length` must be 0.
    b: Str_builder$@, //< where the head is built
    status: I32, //< the status number; its phrase is `reason_phrase`'s
    head: Header$@, //< the headers, or null; `Content-Length` is added here
    length: Sz, //< the length of the body a GET would carry
): Void!Http_error
    write_status_line(b, status)!
    names_length: = may_carry_body(status)
    check_framing(head, length, names_length)!
    write_framed_head(b, head, length, names_length)!

priv fn write_status_line(b: Str_builder$@, status: I32): Void!Http_error //<
    //< Writes `HTTP/1.1 <status> <phrase>` and its CRLF, the phrase from `reason_phrase`
    //<
    //< Caution: **Keep status to three digits**, or the unreadable "HTTP/1.1 1000 x" goes out.
    if status < 100 || status > 999
        throw .invalid_status_line
    b.s("HTTP/1.1 \{status\} ").s(reason_phrase(status)).s("\r\n")

pub fn format_response_head( //< builds only a response's head, for a body sent piece by piece
    //<
    //< Caution: **Do not add `Content-Length`.** That is why this function exists: a streamed
    //< body's length is not known in advance, and `format_response` adds it.
    //< **Always include `Connection: close`** (it fails without it), and a status that has a body.
    b: Str_builder$@, //< where the head is built
    status: I32, //< the status number; its phrase is `reason_phrase`'s
    head: Header$@, //< the headers; `Connection: close` must be among them
): Void!Http_error
    if head.has("Transfer-Encoding")
        throw .unsupported_transfer_encoding
    if !may_carry_body(status) || head.has("Content-Length")
        throw .length_mismatch
    if !closing(head)
        throw .invalid_header
    write_status_line(b, status)!
    write_header_lines(b, head)!
    b.s("\r\n")

priv fn closing(head: Header$@): Bool //< whether it says `Connection: close`
    if v: = head.find("Connection")
        return v.equals_ignore_case("close")
    return false

//< A lightweight regular-expression engine: compile a pattern, then match it against text
//<
//< A character matches itself; `\.` and `\*` write the ones that mean something else. **Matching
//< takes time linear in the text, whatever the pattern**: every way through the pattern runs side
//< by side, so no pattern or text can make a search hang. **Going past any limit is refused,
//< never silently truncated**: the group count, the counted repetition `{m,n}`, the nesting depth
//< and the compiled program's size each have their own error.

// ==========================================
// Caution: **Every notation must be either "carried" or "refused".** A notation in neither is
// swallowed as a literal and silently gives an answer that differs from other implementations.
// ==========================================
import "std/chars"
import "std/ds" { List }
import "std/mem" + { dealloc, Arena }
import "std/regex_node" { byte_count, max_groups, max_repeat_count, Slots, reset_slots, Rx_kind,
    Rx_node, new_node, new_group_node, new_class_node, set_range, free_rx_node, free_rx_alts, Inst,
    Emitter }
import "std/stack_limit" { Stack_limit }

pub enum Regex_error //< why a pattern could not be compiled, or `find` matched nothing
    unmatched_paren //< an opening parenthesis has no closing one, or the other way round
    unmatched_bracket //< a `[` has no `]`
    dangling_quantifier //< nothing quantifiable comes before `*`, `+`, `?` or `{`
    invalid_escape //< nothing follows `\`, or an escaped letter or digit is not in the list
    invalid_range //< a range's ends are reversed, or a set such as `\d` is at a range's end
    invalid_repeat //< `{` has no valid count, m > n, or the count exceeds `max_repeat_count`
    no_match //< nothing in the text matched
    too_deep //< the `(` nesting is deeper than its limit, or than the stack left can hold
    too_large //< the compiled program would hold more than `max_program_size` states
    too_many_groups //< there are more capturing groups than `max_groups`
    unsupported_backreference //< `\1`…`\9`, which refer to a captured string inside the pattern

priv const max_nesting_depth: Sz = 500 //<
    //< The deepest group nesting compile() accepts
    //<
    //< compile() walks group nesting recursively (parse_atom -> parse_alts -> parse_seq ->
    //< parse_atom_quant -> parse_atom). The limit exists for the same reason as json.kspls's
    //< max_nesting_depth (stack exhaustion).
priv const stack_margin: Sz = 64 * 1024 //<
    //< The stack kept free below where compiling stops
    //<
    //< **The counts are sized for the main thread.** A thread's stack may be far smaller (512KB by
    //< default on macOS), so a walk also asks where its stack ends ("A walk that must not exhaust
    //< its stack asks where the stack ends" in `std/docs/DESIGN.md`).

priv fn is_word_byte(c: U8): Bool //< whether the byte is a word character (`\w` and `\b`)
    //<
    //< A letter, a digit or `_` (`is_alnum` counts `_`).
    return c.is_alnum()

priv fn is_word_edge(text: U8[], ti: Sz): Bool //< whether position ti is a word boundary
    //<
    //< **It has no width.** Positions outside either end count as "not a word character".
    before: = ti > 0 && is_word_byte((text.ptr + ti - 1)$)
    after: = ti < text.len && is_word_byte((text.ptr + ti)$)
    return before != after

priv fn is_class_escape(c: U8): Bool //<
    //< Whether it is `\d` / `\w` / `\s` or one of their negated forms
    return c == 'd' || c == 'D' || c == 'w' || c == 'W' || c == 's' || c == 'S'

priv fn class_from_escape(c: U8): Rx_node$@ //<
    //< Expands `\d`/`\w`/`\s` and their negated forms into a character class
    n: = new_class_node()
    $lower: = c
    n.neg = c == 'D' || c == 'W' || c == 'S'
    if n.neg
        lower = c + ('a' - 'A')
    // **From the same predicates the matcher uses**, so `\w` and `\b` cannot disagree.
    for i in Range.asc(byte_count)
        b: = U8::i
        n.set[i] =
            (b.is_digit() if lower == 'd' else is_word_byte(b) if lower == 'w' else b.is_space())
    return n

priv fn add_class_escape(n: Rx_node$@, c: U8) //<
    //< Adds a `\d` or similar inside `[...]` to the class being built
    //<
    //< **A negated form adds the complement**; it does not negate the whole class. Touching `n.neg`
    //< would invert `[^\D]`.
    sub: = class_from_escape(c)
    for i in Range.asc(byte_count)
        if sub.set[i] != sub.neg
            n.set[i] = true
    free_rx_node(sub)

// ==================== Compiling (a pattern string -> an Rx_node tree) ====================
priv struct Compiler //<
    //< The state of one compile() call while it reads the pattern
    //<
    //< Caution: **Do not throw partway through the parse.** An error goes into err, and the tree is
    //< always returned complete; a throw partway would leak the nodes allocated so far. Freeing
    //< happens in one place, compile().
    pat: U8[]
    pos: Sz
    depth: Sz
    stack: Stack_limit //< where the group nesting stops short of the stack's end, beside `depth`
    err: Regex_error?
    groups: Sz //<
        //< The number of capturing groups assigned so far.
        //<
        //< Caution: **Number groups in the order their opening parentheses are read**, as other
        //< implementations do; in closing order, nested numbers swap.

priv fn quantify_group(g: Rx_node$@, min_count: I32, max_count: I32, lazy: Bool): Rx_node$@ //<
    //< Attaches a quantifier to a group
    //<
    //< **`?` is not a repetition**: an empty alternative expresses it (`{0,1}` gives the same
    //< tree). An empty alternative placed after gives the longest match; placed before, the
    //< shortest.
    if min_count == 0 && max_count == 1
        // Caution: **Do not add the empty alternative to the group itself.** Then `(ab)?c` matching
        // `c` would fill the group with an empty string, where other implementations answer "it did
        // not take part"; so it is wrapped **from outside** in a non-capturing group.
        $inner: = List<|Rx_node$@|>.new(null)
        inner.push(g)
        $alts: = List<|List<|Rx_node$@|>|>.new(null)
        if lazy
            alts.push(List<|Rx_node$@|>.new(null))
            alts.push(inner)
        else
            alts.push(inner)
            alts.push(List<|Rx_node$@|>.new(null))
        return new_group_node(alts, -1)
    n: = new_node(.group_repeat)
    n.sub = g
    n.lazy = lazy
    n.min_count = min_count
    n.max_count = max_count
    return n

impl Compiler
    fn fail(r: Self$@, e: Regex_error) //< remembers only the first error found
        //<
        //< Later errors follow from the first one.
        switch r.err
        case .none
            r.err = .some(e)
        default {}

    fn failed(r: Self$@): Bool //<
        //< Once an error is found, every loop checks this and stops at once
        //<
        //< Otherwise a loop spins at a position that does not advance, or recurses past the limit.
        return r.err.is_some()

    fn peek(r: Self$@): U8
        return 0 if r.pos >= r.pat.len else (r.pat.ptr + r.pos)$

    fn advance(r: Self$@): U8
        c: = r.peek()
        r.pos += 1
        return c

    fn escaped_char(r: Self$@): U8 //< reads the one character after `\` as a plain character
        //<
        //< Caution: **Refuse a letter or digit that is not in the list.** Swallowed as a literal,
        //< it silently fails to match (see the caution at the top of this file). A symbol is
        //< itself: `\.`, `\*` and `\[` must not be refused.
        e: = r.advance()
        if e == 't'
            return '\t'
        if e == 'n'
            return '\n'
        if e == 'r'
            return '\r'
        if e.is_alnum()
            r.fail(.invalid_escape)
            return 0U8
        return e

    fn parse_class(r: Self$@): Rx_node$@ //<
        //< Parses the contents of `[...]` and returns one character-class node
        n: = new_class_node()
        if r.peek() == '^'
            n.neg = true
            r.advance()
        $first: = true
        for r.peek() != ']' || first
            if r.pos >= r.pat.len
                r.fail(.unmatched_bracket)
                return n
            first = false
            $lo: = r.advance()
            if lo == '\\'
                // **A `\d` is a set inside a class too**; otherwise `[\d]` silently matches the
                // letter `d`.
                if is_class_escape(r.peek())
                    add_class_escape(n, r.advance())
                    // A `-` next to a set (`[\d-z]`) is neither a range nor clearly a literal
                    // (other implementations disagree), so it is refused.
                    if r.peek() == '-' && r.pos + 1 < r.pat.len &&
                        (r.pat.ptr + r.pos + 1)$ != ']'
                        r.fail(.invalid_range)
                        return n
                    continue
                lo = r.escaped_char()
            if r.peek() == '-' && r.pos + 1 < r.pat.len && (r.pat.ptr + r.pos + 1)$ != ']'
                r.advance() // consume the '-'
                $hi: = r.advance()
                if hi == '\\'
                    // Caution: **Resolve the escape at the upper end too.** Otherwise the upper end
                    // of `[a-\z]` is `\` (0x5C), which is below 'a', and the range is empty.
                    if is_class_escape(r.peek())
                        // A set cannot be a range's end (`[a-\d]` means nothing).
                        r.fail(.invalid_range)
                        return n
                    hi = r.escaped_char()
                // Caution: **Refuse a reversed range.** If allowed, it becomes a class that matches
                // nothing, with no error.
                if hi < lo
                    r.fail(.invalid_range)
                    return n
                set_range(n, lo, hi)
            else
                n.set[lo] = true
        r.advance() // consume the ']'
        return n

    fn parse_atom(r: Self$@): Rx_node$@ //<
        //< Parses one atom, without its quantifier
        //<
        //< An atom is a literal, `.`, a class, an escape, a group or an anchor.
        c: = r.advance()
        // Caution: **Do not swallow a quantifier's symbol (or `{`) as a literal.** `*a` and `a**`
        // would silently pass as **a different pattern** where others refuse with "nothing to
        // repeat". A literal is written `\*` or `[*]`.
        if c == '*' || c == '+' || c == '?' || c == '{'
            r.fail(.dangling_quantifier)
            return new_node(.lit)
        if c == '.'
            return new_node(.any)
        if c == '^'
            return new_node(.start_anchor)
        if c == '$'
            return new_node(.end_anchor)
        if c == '['
            return r.parse_class()
        if c == '\\'
            // Caution: **Do not accept a pattern that ends with nothing to escape.** `a\` would
            // become a literal 0, a pattern that matches nothing, with no error.
            if r.pos >= r.pat.len
                r.fail(.invalid_escape)
                return new_node(.lit)
            e: = r.advance()
            if is_class_escape(e)
                return class_from_escape(e)
            // Caution: **Refuse a digit after `\`.** Elsewhere it means a backreference (`\1`) or
            // an octal escape (`\0`), and this engine supports neither; read a capture with
            // Match.group.
            if e >= '0' && e <= '9'
                r.fail(.unsupported_backreference)
                return new_node(.lit)
            // A word boundary. **It has no width**, so no quantifier attaches (parse_atom_quant
            // refuses `\b*` for the same reason as an anchor).
            if e == 'b'
                return new_node(.word_boundary)
            if e == 'B'
                return new_node(.not_word_boundary)
            r.pos -= 1 // escaped_char advances one character itself
            n: = new_node(.lit)
            n.ch = r.escaped_char()
            return n
        if c == '('
            r.depth += 1
            if r.depth > max_nesting_depth || r.stack.near()
                // Caution: Stop recursing here; only recording the excess still exhausts the stack.
                r.fail(.too_deep)
                r.depth -= 1
                return new_group_node(List<|List<|Rx_node$@|>|>.new(null), -1)
            // `(?:…)` is a non-capturing group.
            // Caution: **Check for it before assigning a number.** Assigning and then discarding
            // shifts later groups by one (`(?:a)(b)`'s `b` becomes number 2).
            $gidx: I32 = -1
            if r.peek() == '?' && r.pos + 1 < r.pat.len && (r.pat.ptr + r.pos + 1)$ == ':'
                r.advance()
                r.advance()
            else if r.groups >= max_groups
                r.fail(.too_many_groups)
            else
                gidx = I32::r.groups
                r.groups += 1
            alts: = r.parse_alts()
            if r.peek() != ')'
                r.fail(.unmatched_paren)
            else
                r.advance()
            r.depth -= 1
            return new_group_node(alts, gidx)
        n: = new_node(.lit)
        n.ch = c
        return n

    fn parse_atom_quant(r: Self$@): Rx_node$@ //<
        //< Parses one atom plus the quantifier right after it (*+?)
        atom: = r.parse_atom()
        q: = r.peek()
        if q != '*' && q != '+' && q != '?' && q != '{'
            return atom
        if atom.kind != .group && atom.kind != .lit && atom.kind != .any && atom.kind != .class
            r.fail(.dangling_quantifier)
            return atom
        // The four notations become one pair of minimum and maximum counts (`-1` means no upper
        // bound).
        // Caution: **Do not treat `*`, `+` and `?` apart from `{m,n}`**: once `a{0,}` and `a*`
        // become different trees, a difference in results can split across two paths.
        r.advance()
        $min_count: I32 = 0
        $max_count: I32 = -1
        if q == '+'
            min_count = 1
        else if q == '?'
            max_count = 1
        else if q == '{'
            if !r.parse_repeat_bounds(min_count@, max_count@)
                return atom
        // A `?` right after a quantifier asks for the shortest match.
        // Caution: **Do not swallow it as a literal** (`a.*?b` would match nowhere). parse_atom
        // refuses `a*??` on the next round.
        $lazy: = false
        if r.peek() == '?'
            r.advance()
            lazy = true
        if atom.kind == .group
            return quantify_group(atom, min_count, max_count, lazy)
        n: = new_node(.repeat)
        n.sub = atom
        n.min_count = min_count
        n.max_count = max_count
        n.lazy = lazy
        return n

    fn parse_repeat_bounds(r: Self$@, min_out: I32$@, max_out: I32$@): Bool //<
        //< Reads the count after `{` (`{n}`, `{n,}`, `{n,m}`; the `{` is already read)
        //<
        //< false if the count is malformed; invalid_repeat is recorded.
        //< Caution: **Do not swallow a malformed `{` as a character.** `a{3` would silently match
        //< only the three characters `a{3` (see the caution at the top of this file).
        $lo: I32 = 0
        if !r.parse_repeat_number(lo@)
            r.fail(.invalid_repeat)
            return false
        $hi: I32 = lo
        if r.peek() == ','
            r.advance()
            hi = -1
            if r.peek() != '}' && !r.parse_repeat_number(hi@)
                r.fail(.invalid_repeat)
                return false
        if r.peek() != '}' || (hi >= 0 && hi < lo)
            r.fail(.invalid_repeat)
            return false
        r.advance() // '}'
        min_out$ = lo
        max_out$ = hi
        return true

    fn parse_repeat_number(r: Self$@, out: I32$@): Bool //< reads one decimal count
        //<
        //< false when there is no digit, or the count exceeds max_repeat_count.
        $v: Sz = 0
        $digits: Sz = 0
        for r.peek().is_digit()
            v = v * 10 + Sz::(r.advance() - '0')
            digits += 1
            if v > max_repeat_count
                return false
        out$ = I32::v
        return digits > 0

    fn parse_seq(r: Self$@): List<|Rx_node$@|> //<
        //< Parses one alternative's run of atoms, up to `|` or `)`
        $seq: = List<|Rx_node$@|>.new(null)
        for !r.failed() && r.pos < r.pat.len && r.peek() != '|' && r.peek() != ')'
            seq.push(r.parse_atom_quant())
        return seq

    fn parse_alts(r: Self$@): List<|List<|Rx_node$@|>|> //<
        //< Parses the list of alternatives parted by `|` (a group's contents, or the whole pattern)
        $alts: = List<|List<|Rx_node$@|>|>.new(null)
        alts.push(r.parse_seq())
        for !r.failed() && r.peek() == '|'
            r.advance()
            alts.push(r.parse_seq())
        return alts

// ==================== Matching (every way through the program at once) ====================
// Every way through the program runs side by side, a byte at a time (a Pike VM). **Two ways at the
// same state and byte go on alike**, so only the preferred one is kept: a byte costs at most one
// visit per state. Caution: **Do not match by trying one way and stepping back.** That is
// exponential in the text for `(a+)+$` or `(a|a)*b`, the shape that hangs a program.
priv fn atom_matches(atom: Rx_node$@, c: U8): Bool
    switch atom.kind
    case .lit
        return c == atom.ch
    case .any
        return c != '\n'
    case .class
        hit: = atom.set[c]
        return !hit if atom.neg else hit
    default
        return false // not reached (a byte step holds only lit/any/class)

priv fn holds(kind: Rx_kind, text: U8[], ti: Sz): Bool //< whether a zero-width test holds at ti
    switch kind
    case .start_anchor
        return ti == 0
    case .end_anchor
        return ti == text.len
    case .word_boundary
        return is_word_edge(text, ti)
    default
        return !is_word_edge(text, ti)

priv struct Threads //< the ways alive at one byte, in priority order, each with its slots
    //<
    //< A sparse set: `has` and `put` cost one look each, and emptying it is `len = 0`.
    len: Sz //< how many states are in it
    order: Sz$@ //< the states, highest priority first; only the first `len` mean anything
    place: Sz$@ //< per state, where it stands in `order` (stale entries fail `has`)
    slots: Sz$@ //< per state, the way's slots (`Vm.width` of them)

impl Threads
    fn has(r: Self@, s: Sz): Bool
        at: = (r.place + s)$
        return at < r.len && (r.order + at)$ == s

    fn put(r: Self$@, s: Sz)
        (r.place + s)$ = r.len
        (r.order + r.len)$ = s
        r.len += 1

priv struct Frame //< one entry of the walk through steps that read no byte
    restore: Bool //<
        //< true: put slot `pc` back to `v`; false: go on at step `pc` with `k` rounds open
    pc: Sz
    k: Sz
    v: Sz

priv struct Vm //< what one search needs besides the program, made once for find_all's every match
    //<
    //< **One block holds both generations, the walk and the slots**, so a search on a short line
    //< costs one allocation, not one per table.
    block: Sz$@
    width: Sz //<
        //< The slots a way holds: the match's start, its end, then each group's two
        //<
        //< 0 for `is_match`, which needs no position and stops at the first match it meets.
    now: Threads
    next: Threads
    walk: Frame$@ //< the walk's entries, newest last; a state put pushes at most one
    walk_len: Sz
    slots: Sz$@ //< the slots of the way being walked
    best: Sz$@ //< the slots of the match found so far
    end: Sz //< where the match found so far ends
    visits: Sz //< the states put into a generation so far: the search's work

priv fn new_vm(states: Sz, width: Sz): Vm
    part: = states * (2 + width)
    frame: = (sizeof(Frame) + sizeof(Sz) - 1) / sizeof(Sz)
    bytes: = (2 * part + 2 * width + frame * (states + 1)) * sizeof(Sz)
    // Zeroed, so a `place` no state has written yet reads as a number, failing `has` alike.
    base: = Sz$@::mem.alloc(bytes)
    mem.zero(Void$@::base, bytes)
    return Vm::{ .block = base, .width = width,
        .now = Threads::{ .len = 0, .order = base, .place = base + states,
        .slots = base + 2 * states },
        .next = Threads::{ .len = 0, .order = base + part, .place = base + part + states,
        .slots = base + part + 2 * states },
        .walk = Frame$@::(Void$@::(base + 2 * part + 2 * width)), .walk_len = 0,
        .slots = base + 2 * part, .best = base + 2 * part + width, .end = 0, .visits = 0 }

priv fn copy_slots(to: Sz$@, from: Sz$@, width: Sz) //< a way's slots, a handful, copied in place
    for $i: Sz = 0; i < width; i += 1
        (to + i)$ = (from + i)$

impl Vm
    fn free(r: Self$@)
        dealloc(Void$@::r.block)

    fn push(r: Self$@, f: Frame)
        (r.walk + r.walk_len)$ = f
        r.walk_len += 1

    fn add(r: Self$@, prog: List<|Inst|>$@, to: Threads$@, pc0: Sz, text: U8[], p: Sz) //<
        //< Adds the way at step pc0, with the slots in `r.slots`, and every way it reaches at p
        //<
        //< Through the steps that read no byte, by a list rather than recursion. A state already
        //< there is passed by: one of higher priority reached it first.
        $f: = Frame::{ .restore = false, .pc = pc0, .k = 0, .v = 0 }
        for
            if f.restore
                (r.slots + f.pc)$ = f.v
            else
                r.follow(prog, to, f.pc, f.k, text, p)
            if r.walk_len == 0
                return
            r.walk_len -= 1
            f = (r.walk + r.walk_len)$

    fn follow(r: Self$@, prog: List<|Inst|>$@, to: Threads$@, pc0: Sz, k0: Sz, text: U8[], p: Sz) //<
        //< Follows one way from step pc0 to a byte step, the end, or a state already put
        //<
        //< Each other way a split offers, and each slot to put back, goes on the walk for `add`.
        $pc: = pc0
        $k: = k0
        for
            step: = prog.ptr + pc
            s: = step.base + k
            if to.has(s)
                return
            to.put(s)
            r.visits += 1
            if step.op == .byte || step.op == .done
                copy_slots(to.slots + s * r.width, r.slots, r.width)
                return
            if step.op == .check && !holds(step.node.kind, text, p)
                return
            switch step.op
            case .jump
                pc = step.x
            case .split
                r.push(Frame::{ .restore = false, .pc = step.y, .k = k, .v = 0 })
                pc = step.x
            case .save
                if step.a < r.width
                    r
                        .push(Frame::{ .restore = true, .pc = step.a, .k = 0,
                        .v = (r.slots + step.a)$ })
                    (r.slots + step.a)$ = p
                pc += 1
            case .round_in
                k += 1
                pc += 1
            case .round_out
                if k > 0
                    k -= 1
                    pc = step.x
                else
                    pc += 1
            default
                pc += 1 // .check that holds

impl Vm: Owned {} //< it owns its block and frees it in `free()`.

priv fn first_bytes(prog: List<|Inst|>$@, first: Bool$[]): Bool //<
    //< Marks in `first` every byte a match can begin with; true when a match can be empty
    //<
    //< It follows every step that reads no byte, taking each test as passing: a byte left out
    //< would skip a start that matches, while one too many only costs a look.
    for i in Range.asc(byte_count)
        first[i] = false
    $seen: = List<|Bool|>.new_with_cap(prog.len, null)
    defer seen.free()
    seen.len = prog.len
    $todo: = List<|Sz|>.new(null)
    defer todo.free()
    todo.push(0)
    for todo.len > 0
        pc: = todo.get(todo.len - 1)
        todo.len -= 1
        if seen.get(pc)
            continue
        seen.set(pc, true)
        step: = prog.get(pc)
        switch step.op
        case .done
            return true
        case .byte
            for c in Range.asc(byte_count)
                if atom_matches(step.node, U8::c)
                    first[c] = true
        case .jump
            todo.push(step.x)
        case .split
            todo.push(step.y)
            todo.push(step.x)
        case .round_out
            todo.push(step.x)
            todo.push(pc + 1)
        default
            todo.push(pc + 1)
    return false

// ==================== The public API ====================
pub struct Match //< one matched span, and what its groups captured
    pub start: Sz //< where the match begins in the text
    pub end: Sz //< where it ends; the span is `[start, end)`
    priv caps: Slots

impl Match
    fn has_group( //< whether that group took part; an empty match still counts
        //<
        //< `group` returns empty both for a group that did not take part and for one that matched
        //< empty; this tells them apart. Group 0 (the whole match) is never one. Package-wide, so
        //< `std/tests` can check the engine through it.
        r: Self,
        n: Sz, //< which group, counting from 1 in the order of the `(`
    ): Bool
        return n >= 1 && n <= r.caps.count && r.caps.start[n - 1] >= 0

    pub fn group( //< what that group captured, or empty if it did not take part
        //<
        //< **The result is a view into text**, using the original text's indices.
        r: Self,
        n: Sz, //< which group, counting from 1 in the order of the `(`
        text: U8[], //< the same text passed to `find`; any other text gives garbage
    ): U8[]
        if !r.has_group(n)
            return ""
        lo: = r.caps.start[n - 1]
        hi: = r.caps.end[n - 1]
        return ("" if lo < 0 || hi < lo || hi > text.len
            else U8[]::{ .ptr = text.ptr + lo, .len = hi - lo })

pub struct Regex //< one compiled pattern, matched against any number of texts
    priv alts: List<|List<|Rx_node$@|>|> //< the tree, which the program's steps read
    priv prog: List<|Inst|> //< the program a match runs
    states: Sz //< how many states the program holds: the most ways alive at one byte
        //<
        //< Package-wide, so `std/tests` can hold a search to its bound.
    priv pc_of: List<|Sz|> //< per state, its step
    priv groups: Sz //<
        //< The number of capturing groups, **fixed at compile time**, not counted per find.
    priv anchored: Bool //<
        //< Whether every alternative starts with `^`, **fixed at compile time**.
    priv first: Bool[byte_count] //< the bytes a match can begin with
    priv may_be_empty: Bool //< whether a match can be empty, so no start may be skipped

priv fn alts_all_anchored(alts: List<|List<|Rx_node$@|>|>$@): Bool //<
    //< Whether every alternative starts with `^`
    //<
    //< Caution: **Make it false if even one does not start with it**; otherwise a match found by
    //< moving the start is missed. A `^` inside a group (`(^a|^b)c`) gives false: it errs toward
    //< skipping the optimization, which only costs speed.
    if alts.len == 0
        return false
    for i in Range.asc(alts.len)
        alt: = alts.get(i)
        if alt.len == 0 || alt.get(0).kind != .start_anchor
            return false
    return true

impl Regex
    pub fn compile( //< reads a pattern once, so it can be matched many times
        //<
        //< Caution: **On failure, free the tree before throwing.** The parse returns the whole tree
        //< even on an error (Compiler's description says why); this is the only place it is freed.
        pattern: U8[], //< the pattern's text
    ): Regex$@!Regex_error
        $c: = Compiler::{ .pat = pattern, .pos = 0, .depth = 0,
            .stack = Stack_limit.later(stack_margin), .err = .none, .groups = 0 }
        $alts: = c.parse_alts()
        if c.pos < c.pat.len
            // a ')' is left over == there was no matching '('
            c.fail(.unmatched_paren)
        if e: = c.err
            free_rx_alts(alts@)
            throw e
        $e: = Emitter::{ .prog = List<|Inst|>.new(null), .depth = 0, .states = 0 }
        e.alts(alts@)
        e.step(.done, null, 0)
        if e.full()
            e.prog.free()
            free_rx_alts(alts@)
            throw .too_large
        r: = mem.alloc_as<|Regex|>()
        r.alts = alts
        r.prog = e.prog
        r.states = e.states
        r.pc_of = List<|Sz|>.new_with_cap(r.states, null)
        for pc in Range.asc(r.prog.len)
            step: = r.prog.get(pc)
            next_base: =
                r.states if pc + 1 == r.prog.len else r.prog.get(pc + 1).base
            for _k in Range.asc(next_base - step.base)
                r.pc_of.push(pc)
        r.groups = c.groups
        r.anchored = alts_all_anchored(alts@)
        r.may_be_empty = first_bytes(r.prog@, Bool$[]::r.first)
        return r

    priv fn width(r: Self@): Sz //<
        //< the slots a way holds: the match's start and end, then the groups'
        return 2 + 2 * r.groups

    priv fn search(r: Self$@, text: U8[], from: Sz, vm: Vm$@): Bool //<
        //< Searches text from `from`, leaving the match in `vm.best` and `vm.end`
        //<
        //< **Every start runs in the same pass**, a later start with lower priority than the ways
        //< already alive: the match found is the leftmost, and among those the one the pattern's
        //< order prefers. With `vm.width` 0 it stops at the first match it meets.
        vm.now.len = 0
        $found: = false
        $p: = from
        for
            // **A pattern starting with `^` cannot match by moving the start**, nor can a start at
            // a byte no match begins with; with no way alive, those bytes are passed over at once.
            if !found && (p == from || !r.anchored)
                if vm.now.len == 0 && !r.may_be_empty && !r.anchored
                    for p < text.len && !r.first[(text.ptr + p)$]
                        p += 1
                if r.may_be_empty || p < text.len && r.first[(text.ptr + p)$]
                    for $i: Sz = 0; i < vm.width; i += 1
                        (vm.slots + i)$ = -1
                    if vm.width > 0
                        vm.slots$ = p
                    vm.add(r.prog@, vm.now@, 0, text, p)
            if vm.now.len == 0
                return found
            vm.next.len = 0
            for $i: Sz = 0; i < vm.now.len; i += 1
                s: = (vm.now.order + i)$
                pc: = (r.pc_of.ptr + s)$
                step: = r.prog.ptr + pc
                row: = vm.now.slots + s * vm.width
                if step.op == .done
                    // **The ways after this one have lower priority**, so they are dropped; the
                    // ones already carried to the next byte have higher, and may still match.
                    found = true
                    if vm.width == 0
                        return true
                    copy_slots(vm.best, row, vm.width)
                    vm.end = p
                    break
                if step.op == .byte && p < text.len &&
                    atom_matches(step.node, (text.ptr + p)$)
                    copy_slots(vm.slots, row, vm.width)
                    vm.add(r.prog@, vm.next@, pc + 1, text, p + 1)
            swapped: = vm.now
            vm.now = vm.next
            vm.next = swapped
            if p >= text.len
                return found
            p += 1

    priv fn found(r: Self@, vm: Vm@): Match //< the match `search` left in vm
        $m: = Match::{ .start = vm.best$, .end = vm.end, .caps = ::{} }
        reset_slots(m.caps@, r.groups)
        for g in Range.asc(r.groups)
            m.caps.start[g] = (vm.best + 2 + 2 * g)$
            m.caps.end[g] = (vm.best + 3 + 2 * g)$
        return m

    fn visits( //< how many states one search through the text visits: its work
        //<
        //< It is at most `states` for each byte, plus one; package-wide, so `std/tests` can hold
        //< a search to that bound and check that the work grows linearly with the text.
        r: Self$@,
        text: U8[], //< the text to search
    ): Sz
        $vm: = new_vm(r.states, r.width())
        defer vm.free()
        _found: = r.search(text, 0, vm@)
        return vm.visits

    pub fn find( //< the first matched span; fails when nothing matches
        r: Self$@,
        text: U8[], //< the text to search
    ): Match!Regex_error
        $vm: = new_vm(r.states, r.width())
        defer vm.free()
        if !r.search(text, 0, vm@)
            throw .no_match
        return r.found(vm@)

    pub fn find_all( //< every matched span; the search resumes past each one
        //<
        //< Front to back; **even an empty match advances one byte**, and no match is an empty list.
        //< An element holds a whole `Slots`. Why it is eager, and how it differs from Python's
        //< `findall`, is in "Every match is returned in a `List`. No lazy iterator is made" in
        //< `std/docs/DESIGN.md`.
        r: Self$@,
        text: U8[], //< the text to search
        arena: Arena$@, //< where the list goes; null means the heap and a `free()`
    ): List<|Match|>
        $out: = List<|Match|>.new(arena)
        $vm: = new_vm(r.states, r.width())
        defer vm.free()
        $from: Sz = 0
        for from <= text.len && r.search(text, from, vm@)
            m: = r.found(vm@)
            out.push(m)
            from = m.end if m.end > m.start else m.start + 1
        return out

    pub fn is_match( //< whether anything in the text matches
        r: Self$@,
        text: U8[], //< the text to search
    ): Bool
        $vm: = new_vm(r.states, 0)
        defer vm.free()
        return r.search(text, 0, vm@)

    pub fn free(r: Self$@) //< frees the compiled tree and its program
        r.prog.free() // the steps only point into the tree, which goes next, then the handle
        r.pc_of.free()
        free_rx_alts(r.alts@)
        dealloc(Void$@::r)

impl Regex: Owned {} //< it owns its resources and frees them in `free()`.

//< A lightweight regular-expression engine: compile a pattern, then match it against text
//<
//< A character matches itself; `\.` and `\*` write the ones that mean something else. **Going past
//< any limit is refused, never silently truncated**: the group count, the counted repetition
//< `{m,n}`, the nesting depth and the backtracking budget each have their own error, so
//< catastrophic backtracking returns `too_complex` instead of never returning. **Matching does not
//< recurse**: the pattern runs as a flat program whose backtracking points live in a list, so a
//< long text is refused only by the budget, never by its length.

// ==========================================
// Caution: **Every notation must be either "carried" or "refused".** A notation in neither is
// swallowed as a literal and silently gives an answer that differs from other implementations.
// ==========================================
import "std/chars"
import "std/ds" { List }
import "std/mem" + { dealloc, Arena }
import "std/regex_node" { max_groups, max_repeat_count, Slots, reset_slots, Rx_kind, Rx_node,
    new_node, new_group_node, new_class_node, set_range, free_rx_node, free_rx_alts }
import "std/stack_limit" { Stack_limit }

pub enum Regex_error //< why a pattern could not be compiled, or matched nothing
    unmatched_paren //< an opening parenthesis has no closing one, or the other way round
    unmatched_bracket //< a `[` has no `]`
    dangling_quantifier //< nothing quantifiable comes before `*`, `+`, `?` or `{`
    invalid_escape //< nothing follows `\`, or an escaped letter or digit is not in the list
    invalid_range //< a range's ends are reversed, or a set such as `\d` is at a range's end
    invalid_repeat //< `{` has no valid count, m > n, or the count exceeds `max_repeat_count`
    no_match //< nothing in the text matched
    too_deep //< the `(` nesting is deeper than its limit, or than the stack left can hold
    too_complex //< matching went over its attempt budget
    too_many_groups //< there are more capturing groups than `max_groups`
    unsupported_backreference //< `\1`…`\9`, which refer to a captured string inside the pattern

priv const max_nesting_depth: Sz = 500 //<
    //< The deepest group nesting compile() accepts
    //<
    //< compile() walks group nesting recursively (parse_atom -> parse_alts -> parse_seq ->
    //< parse_atom_quant -> parse_atom). The limit exists for the same reason as json.kspls's
    //< max_nesting_depth (stack exhaustion).
priv const max_match_steps: Sz = 2000000 //<
    //< The match attempts one whole find() may make on top of `steps_per_byte` for each byte
    //<
    //< Plain backtracking can take exponential time with some quantifier combinations (ReDoS). Past
    //< this limit, find() fails instead of hanging.
priv const steps_per_byte: Sz = 64 //<
    //< The attempts the budget grows by per byte of text, for the start positions a search tries
    //<
    //< Caution: **Let the budget grow with the text.** A fixed one counted across every start
    //< refused a plain search through a long text, each start failing in a few attempts; a share
    //< per byte keeps a pathological pattern bounded, linearly in the text.
priv const stack_margin: Sz = 64 * 1024 //<
    //< The stack kept free below where compiling stops
    //<
    //< **The counts are sized for the main thread.** A thread's stack may be far smaller (512KB by
    //< default on macOS), so a walk also asks where its stack ends ("A walk that must not exhaust
    //< its stack asks where the stack ends" in `std/docs/DESIGN.md`).
priv const stack_ask_depth: Sz = 64 //<
    //< The depth from which a walk asks where its stack ends
    //<
    //< **Asking is not cheap**, while most patterns nest this shallowly and so never pay for it.
    //< The levels above it need some 40KB unoptimised.

priv fn is_word_byte(c: U8): Bool //< whether the byte is a word character (`\w` and `\b`)
    //<
    //< A letter, a digit or `_` (`is_alnum` counts `_`).
    return c.is_alnum()

priv fn is_word_edge(text: U8[], ti: Sz): Bool //< whether position ti is a word boundary
    //<
    //< **It has no width.** Positions outside either end count as "not a word character".
    before: = ti > 0 && is_word_byte((text.ptr + ti - 1)$)
    after: = ti < text.len && is_word_byte((text.ptr + ti)$)
    return before != after

priv fn is_class_escape(c: U8): Bool //<
    //< Whether it is `\d` / `\w` / `\s` or one of their negated forms
    return c == 'd' || c == 'D' || c == 'w' || c == 'W' || c == 's' || c == 'S'

priv fn class_from_escape(c: U8): Rx_node$@ //<
    //< Expands `\d`/`\w`/`\s` and their negated forms into a character class
    n: = new_class_node()
    $lower: = c
    n.neg = c == 'D' || c == 'W' || c == 'S'
    if n.neg
        lower = c + ('a' - 'A')
    // **From the same predicates the matcher uses**, so `\w` and `\b` cannot disagree.
    for i in Range.asc(256)
        b: = U8::i
        n.set[i] =
            (b.is_digit() if lower == 'd' else is_word_byte(b) if lower == 'w' else b.is_space())
    return n

priv fn add_class_escape(n: Rx_node$@, c: U8) //<
    //< Adds a `\d` or similar inside `[...]` to the class being built
    //<
    //< **A negated form adds the complement**; it does not negate the whole class. Touching `n.neg`
    //< would invert `[^\D]`.
    sub: = class_from_escape(c)
    for i in Range.asc(256)
        if sub.set[i] != sub.neg
            n.set[i] = true
    free_rx_node(sub)

// ==================== Compiling (a pattern string -> an Rx_node tree) ====================
priv struct Compiler //<
    //< The state of one compile() call while it reads the pattern
    //<
    //< Caution: **Do not throw partway through the parse.** An error goes into err, and the tree is
    //< always returned complete; a throw partway would leak the nodes allocated so far. Freeing
    //< happens in one place, compile().
    pat: U8[]
    pos: Sz
    depth: Sz
    stack: Stack_limit //< where the group nesting stops short of the stack's end, beside `depth`
    err: Regex_error?
    groups: Sz //<
        //< The number of capturing groups assigned so far.
        //<
        //< Caution: **Number groups in the order their opening parentheses are read**, as other
        //< implementations do; in closing order, nested numbers swap.

priv fn quantify_group(g: Rx_node$@, min_count: I32, max_count: I32, lazy: Bool): Rx_node$@ //<
    //< Attaches a quantifier to a group
    //<
    //< **`?` is not a repetition**: an empty alternative expresses it (`{0,1}` gives the same
    //< tree). An empty alternative placed after gives the longest match; placed before, the
    //< shortest.
    if min_count == 0 && max_count == 1
        // Caution: **Do not add the empty alternative to the group itself.** Then `(ab)?c` matching
        // `c` would fill the group with an empty string, where other implementations answer "it did
        // not take part"; so it is wrapped **from outside** in a non-capturing group.
        $inner: = List<|Rx_node$@|>.new(null)
        inner.push(g)
        $alts: = List<|List<|Rx_node$@|>|>.new(null)
        if lazy
            alts.push(List<|Rx_node$@|>.new(null))
            alts.push(inner)
        else
            alts.push(inner)
            alts.push(List<|Rx_node$@|>.new(null))
        return new_group_node(alts, -1)
    n: = new_node(.group_repeat)
    n.sub = g
    n.lazy = lazy
    n.min_count = min_count
    n.max_count = max_count
    return n

impl Compiler
    fn fail(r: Self$@, e: Regex_error) //< remembers only the first error found
        //<
        //< Later errors follow from the first one.
        switch r.err
        case .none
            r.err = .some(e)
        default {}

    fn failed(r: Self$@): Bool //<
        //< Once an error is found, every loop checks this and stops at once
        //<
        //< Otherwise a loop spins at a position that does not advance, or recurses past the limit.
        return r.err.is_some()

    fn peek(r: Self$@): U8
        return 0 if r.pos >= r.pat.len else (r.pat.ptr + r.pos)$

    fn advance(r: Self$@): U8
        c: = r.peek()
        r.pos += 1
        return c

    fn escaped_char(r: Self$@): U8 //< reads the one character after `\` as a plain character
        //<
        //< Caution: **Refuse a letter or digit that is not in the list.** Swallowed as a literal,
        //< it silently fails to match (see the caution at the top of this file). A symbol is
        //< itself: `\.`, `\*` and `\[` must not be refused.
        e: = r.advance()
        if e == 't'
            return 9U8
        if e == 'n'
            return 10U8
        if e == 'r'
            return 13U8
        if e.is_alnum()
            r.fail(.invalid_escape)
            return 0U8
        return e

    fn parse_class(r: Self$@): Rx_node$@ //<
        //< Parses the contents of `[...]` and returns one character-class node
        n: = new_class_node()
        if r.peek() == '^'
            n.neg = true
            r.advance()
        $first: = true
        for r.peek() != ']' || first
            if r.pos >= r.pat.len
                r.fail(.unmatched_bracket)
                return n
            first = false
            $lo: = r.advance()
            if lo == '\\'
                // **A `\d` is a set inside a class too**; otherwise `[\d]` silently matches the
                // letter `d`.
                if is_class_escape(r.peek())
                    add_class_escape(n, r.advance())
                    // A `-` next to a set (`[\d-z]`) is neither a range nor clearly a literal
                    // (other implementations disagree), so it is refused.
                    if r.peek() == '-' && r.pos + 1 < r.pat.len &&
                        (r.pat.ptr + r.pos + 1)$ != ']'
                        r.fail(.invalid_range)
                        return n
                    continue
                lo = r.escaped_char()
            if r.peek() == '-' && r.pos + 1 < r.pat.len && (r.pat.ptr + r.pos + 1)$ != ']'
                r.advance() // consume the '-'
                $hi: = r.advance()
                if hi == '\\'
                    // Caution: **Resolve the escape at the upper end too.** Otherwise the upper end
                    // of `[a-\z]` is `\` (0x5C), which is below 'a', and the range is empty.
                    if is_class_escape(r.peek())
                        // A set cannot be a range's end (`[a-\d]` means nothing).
                        r.fail(.invalid_range)
                        return n
                    hi = r.escaped_char()
                // Caution: **Refuse a reversed range.** If allowed, it becomes a class that matches
                // nothing, with no error.
                if hi < lo
                    r.fail(.invalid_range)
                    return n
                set_range(n, lo, hi)
            else
                n.set[lo] = true
        r.advance() // consume the ']'
        return n

    fn parse_atom(r: Self$@): Rx_node$@ //<
        //< Parses one atom, without its quantifier
        //<
        //< An atom is a literal, `.`, a class, an escape, a group or an anchor.
        c: = r.advance()
        // Caution: **Do not swallow a quantifier's symbol (or `{`) as a literal.** `*a` and `a**`
        // would silently pass as **a different pattern** where others refuse with "nothing to
        // repeat". A literal is written `\*` or `[*]`.
        if c == '*' || c == '+' || c == '?' || c == '{'
            r.fail(.dangling_quantifier)
            return new_node(.lit)
        if c == '.'
            return new_node(.any)
        if c == '^'
            return new_node(.start_anchor)
        if c == '$'
            return new_node(.end_anchor)
        if c == '['
            return r.parse_class()
        if c == '\\'
            // Caution: **Do not accept a pattern that ends with nothing to escape.** `a\` would
            // become a literal 0, a pattern that matches nothing, with no error.
            if r.pos >= r.pat.len
                r.fail(.invalid_escape)
                return new_node(.lit)
            e: = r.advance()
            if is_class_escape(e)
                return class_from_escape(e)
            // Caution: **Refuse a digit after `\`.** Elsewhere it means a backreference (`\1`) or
            // an octal escape (`\0`), and this engine supports neither; read a capture with
            // Match.group.
            if e >= '0' && e <= '9'
                r.fail(.unsupported_backreference)
                return new_node(.lit)
            // A word boundary. **It has no width**, so no quantifier attaches (parse_atom_quant
            // refuses `\b*` for the same reason as an anchor).
            if e == 'b'
                return new_node(.word_boundary)
            if e == 'B'
                return new_node(.not_word_boundary)
            r.pos -= 1 // escaped_char advances one character itself
            n: = new_node(.lit)
            n.ch = r.escaped_char()
            return n
        if c == '('
            r.depth += 1
            if r.depth > max_nesting_depth || r.stack.near_at(r.depth)
                // Caution: Stop recursing here; only recording the excess still exhausts the stack.
                r.fail(.too_deep)
                r.depth -= 1
                return new_group_node(List<|List<|Rx_node$@|>|>.new(null), -1)
            // `(?:…)` is a non-capturing group.
            // Caution: **Check for it before assigning a number.** Assigning and then discarding
            // shifts later groups by one (`(?:a)(b)`'s `b` becomes number 2).
            $gidx: I32 = -1
            if r.peek() == '?' && r.pos + 1 < r.pat.len && (r.pat.ptr + r.pos + 1)$ == ':'
                r.advance()
                r.advance()
            else if r.groups >= max_groups
                r.fail(.too_many_groups)
            else
                gidx = I32::r.groups
                r.groups += 1
            alts: = r.parse_alts()
            if r.peek() != ')'
                r.fail(.unmatched_paren)
            else
                r.advance()
            r.depth -= 1
            return new_group_node(alts, gidx)
        n: = new_node(.lit)
        n.ch = c
        return n

    fn parse_atom_quant(r: Self$@): Rx_node$@ //<
        //< Parses one atom plus the quantifier right after it (*+?)
        atom: = r.parse_atom()
        q: = r.peek()
        if q != '*' && q != '+' && q != '?' && q != '{'
            return atom
        if atom.kind != .group && atom.kind != .lit && atom.kind != .any && atom.kind != .class
            r.fail(.dangling_quantifier)
            return atom
        // The four notations become one pair of minimum and maximum counts (`-1` means no upper
        // bound).
        // Caution: **Do not treat `*`, `+` and `?` apart from `{m,n}`**: once `a{0,}` and `a*`
        // become different trees, a difference in results can split across two paths.
        r.advance()
        $min_count: I32 = 0
        $max_count: I32 = -1
        if q == '+'
            min_count = 1
        else if q == '?'
            max_count = 1
        else if q == '{'
            if !r.parse_repeat_bounds(min_count@, max_count@)
                return atom
        // A `?` right after a quantifier asks for the shortest match.
        // Caution: **Do not swallow it as a literal** (`a.*?b` would match nowhere). parse_atom
        // refuses `a*??` on the next round.
        $lazy: = false
        if r.peek() == '?'
            r.advance()
            lazy = true
        if atom.kind == .group
            return quantify_group(atom, min_count, max_count, lazy)
        n: = new_node(.repeat)
        n.sub = atom
        n.min_count = min_count
        n.max_count = max_count
        n.lazy = lazy
        return n

    fn parse_repeat_bounds(r: Self$@, min_out: I32$@, max_out: I32$@): Bool //<
        //< Reads the count after `{` (`{n}`, `{n,}`, `{n,m}`; the `{` is already read)
        //<
        //< false if the count is malformed; invalid_repeat is recorded.
        //< Caution: **Do not swallow a malformed `{` as a character.** `a{3` would silently match
        //< only the three characters `a{3` (see the caution at the top of this file).
        $lo: I32 = 0
        if !r.parse_repeat_number(lo@)
            r.fail(.invalid_repeat)
            return false
        $hi: I32 = lo
        if r.peek() == ','
            r.advance()
            hi = -1
            if r.peek() != '}' && !r.parse_repeat_number(hi@)
                r.fail(.invalid_repeat)
                return false
        if r.peek() != '}' || (hi >= 0 && hi < lo)
            r.fail(.invalid_repeat)
            return false
        r.advance() // '}'
        min_out$ = lo
        max_out$ = hi
        return true

    fn parse_repeat_number(r: Self$@, out: I32$@): Bool //< reads one decimal count
        //<
        //< false when there is no digit, or the count exceeds max_repeat_count.
        $v: Sz = 0
        $digits: Sz = 0
        for r.peek().is_digit()
            v = v * 10 + Sz::(r.advance() - '0')
            digits += 1
            if v > max_repeat_count
                return false
        out$ = I32::v
        return digits > 0

    fn parse_seq(r: Self$@): List<|Rx_node$@|> //<
        //< Parses one alternative's run of atoms, up to `|` or `)`
        $seq: = List<|Rx_node$@|>.new(null)
        for !r.failed() && r.pos < r.pat.len && r.peek() != '|' && r.peek() != ')'
            seq.push(r.parse_atom_quant())
        return seq

    fn parse_alts(r: Self$@): List<|List<|Rx_node$@|>|> //<
        //< Parses the list of alternatives parted by `|` (a group's contents, or the whole pattern)
        $alts: = List<|List<|Rx_node$@|>|>.new(null)
        alts.push(r.parse_seq())
        for !r.failed() && r.peek() == '|'
            r.advance()
            alts.push(r.parse_seq())
        return alts

// ==================== Matching (a flat program, backtracked without recursion) ====================
// The tree compiles once into a program of steps, and a match runs it with its backtracking points
// in a list on the heap. Caution: **Do not match by recursing over the tree.** A round of `(ab)*`
// was one more native call, so a long text that plainly matches was refused at a depth limit or
// would have exhausted the stack; here a round costs one entry in the list, and only the attempt
// budget bounds a search.
priv enum Op //< what one step of the program does
    atom //< one byte against `node` (a literal, `.` or a class)
    atom_repeat //<
        //< `node`, a single atom repeated: its whole run at once, counts tried by backtracking
    check //< a zero-width test, `node`'s kind: `^`, `$`, `\b` or `\B`
    split //< go on at `x`, and keep `y` to try on failure
    jump //< go on at `x`
    save_start //< record where group `a` starts
    save_end //< record where group `a` ends
    enter //< a repeated group begins: its round count `a` to 0, its round start to none
    round //< the head of each round of repeated group `node` (register `a`); body `x`, exit `y`
    done //< the whole pattern matched

priv struct Inst //< one step of the program; `op` decides which fields mean something
    op: Op
    node: Rx_node$@ //< the tree node read (shared with the tree, never freed through this)
    x: Sz
    y: Sz
    a: Sz

priv struct Emitter //< the program being written, and the next free register of a repeated group
    prog: List<|Inst|>
    regs: Sz

impl Emitter
    fn step(r: Self$@, op: Op, node: Rx_node$@, a: Sz): Sz //< appends a step; returns its place
        //<
        //< Its targets (`x`, `y`) are patched once the steps they name are written.
        r.prog.push(Inst::{ .op = op, .node = node, .x = 0, .y = 0, .a = a })
        return r.prog.len - 1

    // The emitter walks the group nesting as the parse did, so it goes no deeper than
    // `max_nesting_depth`, which compile() already held against the stack.
    fn seq(r: Self$@, seq: List<|Rx_node$@|>$@) //< one alternative's atoms, in order
        for k in Range.asc(seq.len)
            r.node(seq.get(k))

    fn node(r: Self$@, n: Rx_node$@)
        switch n.kind
        case .lit, .any, .class
            r.step(.atom, n, 0)
        case .repeat
            r.step(.atom_repeat, n, 0)
        case .start_anchor, .end_anchor, .word_boundary, .not_word_boundary
            r.step(.check, n, 0)
        case .group
            r.group(n)
        case .group_repeat
            reg: = r.regs
            r.regs += 1
            r.step(.enter, n, reg)
            head: = r.step(.round, n, reg)
            r.prog.at(head).x = r.prog.len
            r.group(n.sub)
            back: = r.step(.jump, n, 0)
            r.prog.at(back).x = head
            r.prog.at(head).y = r.prog.len

    fn group(r: Self$@, g: Rx_node$@) //< a group: its start, its alternatives in order, its end
        if g.gidx >= 0
            r.step(.save_start, g, g.gidx)
        r.alts(g.alts@)
        if g.gidx >= 0
            r.step(.save_end, g, g.gidx)

    fn alts(r: Self$@, alts: List<|List<|Rx_node$@|>|>$@) //< alternatives, tried first to last
        $ends: = List<|Sz|>.new(null)
        defer ends.free()
        for i in Range.asc(alts.len)
            last: = i + 1 == alts.len
            $fork: Sz = 0
            if !last
                fork = r.step(.split, null, 0)
                r.prog.at(fork).x = r.prog.len
            $alt: = alts.get(i)
            r.seq(alt@)
            if !last
                ends.push(r.step(.jump, null, 0))
                r.prog.at(fork).y = r.prog.len
        for e in ends.slice()
            r.prog.at(e).x = r.prog.len

priv enum Back //< what a backtracking entry does when a failure reaches it
    resume //< go on at `pc` from `pos`
    count_down //< a greedy atom run: go on at `pc` from `v`, then from one byte less, down to `a`
    count_up //< a lazy atom run: go on at `pc` from `v`, then from one byte more, up to `a`
    round //< a lazy repeated group's next round: begin it at `pos`, the round step being `pc`
    undo_start //< put group `a`'s start back to `v`
    undo_end //< put group `a`'s end back to `v`
    undo_count //< put register `a`'s round count back to `v`
    undo_mark //< put register `a`'s round start back to `v`

priv struct Entry //< one backtracking entry; `kind` decides which fields mean something
    kind: Back
    pc: Sz
    pos: Sz
    a: Sz
    v: Sz

priv struct Match_run //<
    //< What one whole find() shares across its start positions
    //<
    //< Caution: **The budget ends the whole find() as `too_complex`.** Answering only that start
    //< with "no match" would let the search report a later match or none, a wrong answer rather
    //< than a refusal.
    text: U8[] //< the text being searched
    end: Sz //< where the last successful run stopped
    caps: Slots //< what the groups have captured on the path being tried
    steps: Sz //< the steps taken so far, against `limit`
    limit: Sz //< max_match_steps plus steps_per_byte for each byte of the text
    trail: List<|Entry|>$@ //< the backtracking entries, newest last
    counts: List<|Sz|>$@ //< each repeated group's rounds so far
    marks: List<|Sz|>$@ //< where each repeated group's current round started; -1 before the first

impl Match_run
    fn spent(r: Self@): Bool //< whether the budget is used up, so the whole find() gives up
        return r.steps > r.limit

    fn keep(r: Self$@, kind: Back, pc: Sz, pos: Sz, a: Sz, v: Sz) //< pushes one entry
        r.trail.push(Entry::{ .kind = kind, .pc = pc, .pos = pos, .a = a, .v = v })

    fn begin_round(r: Self$@, reg: Sz, pos: Sz) //< one more round of a repeated group, from pos
        //<
        //< The old values go on the trail first, so stepping back past this round restores them.
        r.keep(.undo_count, 0, 0, reg, r.counts.get(reg))
        r.keep(.undo_mark, 0, 0, reg, r.marks.get(reg))
        r.counts.set(reg, r.counts.get(reg) + 1)
        r.marks.set(reg, pos)

    fn back(r: Self$@, prog: List<|Inst|>$@, pc: Sz$@, pos: Sz$@): Bool //<
        //< Steps back to the newest entry that tries something, undoing what lies above it
        //<
        //< false when nothing is left to try at this start.
        for r.trail.len > 0
            e: = r.trail.get(r.trail.len - 1)
            r.trail.len -= 1
            switch e.kind
            case .undo_start
                r.caps.start[e.a] = e.v
            case .undo_end
                r.caps.end[e.a] = e.v
            case .undo_count
                r.counts.set(e.a, e.v)
            case .undo_mark
                r.marks.set(e.a, e.v)
            case .resume
                pc$ = e.pc
                pos$ = e.pos
                return true
            case .count_down
                if e.v > e.a
                    r.keep(.count_down, e.pc, 0, e.a, e.v - 1)
                pc$ = e.pc
                pos$ = e.v
                return true
            case .count_up
                if e.v < e.a
                    r.keep(.count_up, e.pc, 0, e.a, e.v + 1)
                pc$ = e.pc
                pos$ = e.v
                return true
            case .round
                step: = prog.get(e.pc)
                r.begin_round(step.a, e.pos)
                pc$ = step.x
                pos$ = e.pos
                return true
        return false

fn atom_matches(atom: Rx_node$@, c: U8): Bool
    switch atom.kind
    case .lit
        return c == atom.ch
    case .any
        return c != '\n'
    case .class
        hit: = atom.set[c]
        return !hit if atom.neg else hit
    default
        return false // not reached (a quantifier attaches only to lit/any/class)

priv fn holds(kind: Rx_kind, text: U8[], ti: Sz): Bool //< whether a zero-width test holds at ti
    switch kind
    case .start_anchor
        return ti == 0
    case .end_anchor
        return ti == text.len
    case .word_boundary
        return is_word_edge(text, ti)
    default
        return !is_word_edge(text, ti)

// One atom repeated: its whole run is read at once, then backtracking takes it back one byte at a
// time (the longest first) or gives one more (the shortest first).
// **The order in which counts are tried is all that separates longest from shortest match**: this
// changes **which match is found first** (`a.*?b` gives `axxb` from `axxbyyb`; `a.*b` gives the
// whole).
priv fn run_atom_repeat(n: Rx_node$@, pc: Sz, pos: Sz$@, run: Match_run$@): Bool
    text: = run.text
    from: = pos$
    $max_j: = from
    for max_j < text.len && (n.max_count < 0 || max_j - from < Sz::n.max_count) &&
        atom_matches(n.sub, (text.ptr + max_j)$)
        max_j += 1
    lo: = from + Sz::n.min_count
    if max_j < lo
        return false
    if n.lazy
        if lo < max_j
            run.keep(.count_up, pc + 1, 0, max_j, lo + 1)
        pos$ = lo
    else
        if max_j > lo
            run.keep(.count_down, pc + 1, 0, lo, max_j - 1)
        pos$ = max_j
    return true

// The head of every round of a repeated group (`(…)*`, `(…)+`, `(…){m,n}`).
// Caution: **A round that did not advance stops the repetition; it is not undone.** Undoing would
// make `(a?)*b`'s group "did not take part" where others answer an empty match, and going on would
// loop for good. Shortest match keeps "one more round" to try after the rest; longest match keeps
// "stop here" to try after one more round.
priv fn run_round(step: Inst, pc: Sz, pos: Sz, run: Match_run$@): Sz //< the step to go on at
    n: = step.node
    reg: = step.a
    count: = run.counts.get(reg)
    mark: = run.marks.get(reg)
    if mark >= 0 && pos == mark
        return step.y
    if n.max_count >= 0 && count >= Sz::n.max_count
        return step.y
    if count < Sz::n.min_count
        run.begin_round(reg, pos)
        return step.x
    if n.lazy
        run.keep(.round, pc, pos, 0, 0)
        return step.y
    run.keep(.resume, step.y, pos, 0, 0)
    run.begin_round(reg, pos)
    return step.x

priv fn run_at(prog: List<|Inst|>$@, start: Sz, run: Match_run$@): Bool //<
    //< Runs the program from `start`, leaving the end in run.end
    //<
    //< false when nothing matches here, or the budget ran out (run.spent() tells which).
    text: = run.text
    run.trail.len = 0
    $pc: Sz = 0
    $pos: = start
    for
        run.steps += 1
        if run.spent()
            return false
        step: = prog.get(pc)
        $ok: = true
        switch step.op
        case .atom
            ok = pos < text.len && atom_matches(step.node, (text.ptr + pos)$)
            if ok
                pos += 1
                pc += 1
        case .atom_repeat
            ok = run_atom_repeat(step.node, pc, pos@, run)
            pc += 1
        case .check
            ok = holds(step.node.kind, text, pos)
            pc += 1
        case .split
            run.keep(.resume, step.y, pos, 0, 0)
            pc = step.x
        case .jump
            pc = step.x
        case .save_start
            run.keep(.undo_start, 0, 0, step.a, run.caps.start[step.a])
            run.caps.start[step.a] = pos
            pc += 1
        case .save_end
            run.keep(.undo_end, 0, 0, step.a, run.caps.end[step.a])
            run.caps.end[step.a] = pos
            pc += 1
        case .enter
            run.keep(.undo_count, 0, 0, step.a, run.counts.get(step.a))
            run.keep(.undo_mark, 0, 0, step.a, run.marks.get(step.a))
            run.counts.set(step.a, 0)
            run.marks.set(step.a, -1)
            pc += 1
        case .round
            pc = run_round(step, pc, pos, run)
        case .done
            run.end = pos
            return true
        if !ok && !run.back(prog, pc@, pos@)
            return false

// ==================== The public API ====================
pub struct Match //< one matched span, and what its groups captured
    pub start: Sz //< where the match begins in the text
    pub end: Sz //< where it ends; the span is `[start, end)`
    priv caps: Slots

impl Match
    pub fn group_count(r: Self): Sz //< how many capturing groups the pattern has
        //<
        //< **It is not the number that took part** (`(a)|b` matching `b` still has one).
        return r.caps.count

    pub fn has_group( //< whether that group took part; an empty match still counts
        //<
        //< Caution: **Do not confuse a group that did not take part with one that matched empty.**
        //< For the first, `has_group` is false; for the second, it is true and `group` returns
        //< empty. Group 0, the whole match, is not handled here (`start` / `end` hold it).
        r: Self,
        n: Sz, //< which group, counting from 1 in the order of the `(`
    ): Bool
        return n >= 1 && n <= r.caps.count && r.caps.start[n - 1] >= 0

    pub fn group( //< what that group captured, or empty if it did not take part
        //<
        //< **The result is a view into text**, using the original text's indices.
        r: Self,
        n: Sz, //< which group, counting from 1 in the order of the `(`
        text: U8[], //< the same text passed to `find`; any other text gives garbage
    ): U8[]
        if !r.has_group(n)
            return ""
        lo: = r.caps.start[n - 1]
        hi: = r.caps.end[n - 1]
        return ("" if lo < 0 || hi < lo || hi > text.len
            else U8[]::{ .ptr = text.ptr + lo, .len = hi - lo })

pub struct Regex //< one compiled pattern, matched against any number of texts
    priv alts: List<|List<|Rx_node$@|>|> //< the tree, which the program's steps read
    priv prog: List<|Inst|> //< the program a match runs
    priv regs: Sz //< how many repeated groups the program counts rounds for
    priv groups: Sz //<
        //< The number of capturing groups, **fixed at compile time**, not counted per find.
    priv anchored: Bool //<
        //< Whether every alternative starts with `^`, **fixed at compile time**.

priv fn alts_all_anchored(alts: List<|List<|Rx_node$@|>|>$@): Bool //<
    //< Whether every alternative starts with `^`
    //<
    //< Caution: **Make it false if even one does not start with it**; otherwise a match found by
    //< moving the start is missed. A `^` inside a group (`(^a|^b)c`) gives false: it errs toward
    //< skipping the optimization, which only costs speed.
    if alts.len == 0
        return false
    for i in Range.asc(alts.len)
        alt: = alts.get(i)
        if alt.len == 0 || alt.get(0).kind != .start_anchor
            return false
    return true

impl Regex
    pub fn compile( //< reads a pattern once, so it can be matched many times
        //<
        //< Caution: **On failure, free the tree before throwing.** The parse returns the whole tree
        //< even on an error (Compiler's description says why); this is the only place it is freed.
        pattern: U8[], //< the pattern's text
    ): Regex$@!Regex_error
        $c: = Compiler::{ .pat = pattern, .pos = 0, .depth = 0,
            .stack = Stack_limit.later(stack_margin, stack_ask_depth), .err = .none, .groups = 0 }
        $alts: = c.parse_alts()
        if c.pos < c.pat.len
            // a ')' is left over == there was no matching '('
            c.fail(.unmatched_paren)
        if e: = c.err
            free_rx_alts(alts@)
            throw e
        r: = mem.alloc_as<|Regex|>()
        r.alts = alts
        r.groups = c.groups
        r.anchored = alts_all_anchored(alts@)
        $e: = Emitter::{ .prog = List<|Inst|>.new(null), .regs = 0 }
        e.alts(r.alts@)
        e.step(.done, null, 0)
        r.prog = e.prog
        r.regs = e.regs
        return r

    priv fn find_from(r: Self$@, text: U8[], from: Sz): Match!Regex_error //<
        //< Finds the first matched span in text, starting at `from`
        //<
        //< **The returned position counts from the start of text.**
        $trail: = List<|Entry|>.new(null)
        defer trail.free()
        $counts: = List<|Sz|>.new(null)
        defer counts.free()
        $marks: = List<|Sz|>.new(null)
        defer marks.free()
        for _i in Range.asc(r.regs)
            counts.push(0)
            marks.push(-1)
        $run: = Match_run::{ .text = text, .end = 0, .caps = ::{}, .steps = 0,
            .limit = max_match_steps + steps_per_byte * (text.len - from), .trail = trail@,
            .counts = counts@, .marks = marks@ }
        for $start: Sz = from; start <= text.len; start += 1
            // Caution: **Initialize per start.** Otherwise **a group from a failed attempt** leaks
            // into the next start's match, unnoticed, since the match itself is still correct.
            reset_slots(run.caps@, r.groups)
            if run_at(r.prog@, start, run@)
                return Match::{ .start = start, .end = run.end, .caps = run.caps }
            if run.spent()
                throw .too_complex
            // **A pattern starting with `^` cannot match by moving the start**; trying would waste
            // a line's length of attempts per line scanned.
            if r.anchored
                break
        throw .no_match

    pub fn find( //< the first matched span; fails when nothing matches
        r: Self$@,
        text: U8[], //< the text to search
    ): Match!Regex_error
        return r.find_from(text, 0)

    pub fn find_all( //< every matched span; the search resumes past each one
        //<
        //< Front to back; **even an empty match advances one byte.** The budget (max_match_steps)
        //< restarts per match. An element holds a whole `Slots`. Why it is eager, and how it
        //< differs from Python's `findall`, is in "Every match is returned in a `List`. No lazy
        //< iterator is made" in `std/docs/DESIGN.md`.
        r: Self$@,
        text: U8[], //< the text to search
        arena: Arena$@, //< the arena for the list
    ): List<|Match|>!Regex_error
        $out: = List<|Match|>.new(arena)
        $from: Sz = 0
        for from <= text.len
            m: = r.find_from(text, from) catch e
                switch e
                case .no_match
                    break
                default
                    out.free()
                    throw e
            out.push(m)
            from = m.end if m.end > m.start else m.start + 1
        return out

    pub fn is_match( //< whether anything in the text matches
        //<
        //< Caution: **Only `no_match` is "no".** `too_complex` is thrown, not read as false: the
        //< budget ran out before the whole text was tried, so a match may still stand in it.
        r: Self$@,
        text: U8[], //< the text to search
    ): Bool!Regex_error
        _m: = r.find(text) catch e
            switch e
            case .no_match
                return false
            default
                throw e
        return true

    pub fn free(r: Self$@) //< frees the compiled tree and its program
        r.prog.free() // the steps only point into the tree, which goes next, then the handle
        free_rx_alts(r.alts@)
        dealloc(Void$@::r)

impl Regex: Owned {} //< it owns its resources and frees them in `free()`.

//< The tree a regular-expression pattern compiles into, and the program written from the tree
//< **It is not meant for direct use**, apart from the limits `MAX_GROUPS`, `MAX_REPEAT_COUNT`
//< and `MAX_PROGRAM_SIZE`; compiling and matching are in `std/regex`.

// ==========================================
// **Both** compiling and matching (`regex.kspl`) build on this, so the tree lives below both:
// otherwise, splitting either one out would make it import `regex.kspl` back.
// ==========================================
import "std/ds" { List }
import "std/mem" + { dealloc }

pub const MAX_GROUPS: Sz = 9 //< how many capturing groups a pattern can have.
    //< Caution: **Refuse a pattern that exceeds it** (`too_many_groups`); otherwise the tenth group
    //< onward silently comes back empty. 9 matches `\1`…`\9` and sets the size a Match holds.

pub const MAX_PROGRAM_SIZE: Sz = 20000 //< the most states a compiled pattern can hold
    //< A search's memory and its time per byte grow with them, so a pattern past it is refused
    //< (`too_large`). A counted repetition is written out round by round, so `(a{1000}){1000}`
    //< would hold a million.

pub const MAX_REPEAT_COUNT: Sz = 1000 //< the largest `{m,n}` count accepted, as in RE2 and Go.
    //< Caution: **Refuse a count that exceeds it** (`invalid_repeat`), as a count no engine
    //< accepts would make a pattern that works here alone.

struct Slots //< what each capturing group caught; `-1` means it did not take part
    //< **`-1` is not 0**: an empty match has `start == end`.
    count: Sz
    start: Sz[MAX_GROUPS]
    end: Sz[MAX_GROUPS]

fn reset_slots( //< marks every group as not having taken part
    c: Slots$@, //< the slots to clear
    count: Sz, //< how many groups the pattern has
)
    c.count = count
    for i in Range.asc(MAX_GROUPS)
        c.start[i] = -1
        c.end[i] = -1

enum Rx_kind //< what one node of a compiled pattern stands for
    lit //< one literal byte
    any //< `.`
    class //< a `[...]` set
    group //< a `(...)`; its alternatives hang off it
    repeat //< one atom repeated; `*`, `+`, `?` and `{m,n}` are all this
    start_anchor //< `^`
    end_anchor //< `$`
    word_boundary //< `\b`
    not_word_boundary //< `\B`
    group_repeat //< a whole group repeated

struct Rx_node //< one node of a compiled pattern; `kind` decides which fields mean something
    kind: Rx_kind
    ch: U8 //< for .lit
    lazy: Bool //<
        //< For .repeat/.group_repeat: the shortest match (`*?` `+?` `??` `{m,n}?`)
    neg: Bool //< for .class: `[^...]`
    set: Bool[BYTE_COUNT] //< for .class: the membership table
    sub: Rx_node$@ //< for .repeat: the quantified atom; for .group_repeat: the repeated group
    alts: List<|List<|Rx_node$@|>|> //< for .group: one atom list per alternative
    gidx: I32 //<
        //< For .group: which capturing group; `-1` for a non-capturing group (`(?:…)`).
    min_count: I32 //<
        //< For .repeat/.group_repeat: the minimum count (0 for `*`, 1 for `+`, m for `{m,n}`).
    max_count: I32 //<
        //< For .repeat/.group_repeat: the maximum count (n for `{m,n}`, 1 for `?`)
        //< `-1` means no bound (`*` `+` `{m,}`).

impl Rx_kind
    fn new_node(r: Self): Rx_node$@ //<
        //< one new node of this kind, on the heap; free it with `free_rx_node`
        //< Caution: Make a .group only with new_group_node. Made here, its .alts stays
        //< uninitialized and free_rx_alts walks a garbage list.
        n: = mem.alloc_as<|Rx_node|>()
        n.kind = r
        n.ch = 0
        n.lazy = false
        n.neg = false
        n.sub = null
        n.gidx = -1
        n.min_count = 0
        n.max_count = -1
        return n

fn new_group_node( //< one new group node, with its alternatives
    alts: List<|List<|Rx_node$@|>|>, //< one atom list per alternative
    gidx: I32, //< which capturing group; `-1` for a non-capturing `(?:…)`
): Rx_node$@ //< the node; free it with `free_rx_node`
    n: = Rx_kind.group.new_node()
    n.alts = alts
    n.gidx = gidx
    return n

const BYTE_COUNT: Sz = 256 //< how many values one byte takes: a class's table has a slot each

fn new_class_node(): Rx_node$@ //< one new `[...]` node with an empty membership table
    n: = Rx_kind.class.new_node()
    for i in Range.asc(BYTE_COUNT)
        n.set[i] = false
    return n

fn set_range( //< adds every byte in a range to a `[...]` set
    n: Rx_node$@, //< the set node to write into
    lo: U8, //< the range's first byte
    hi: U8, //< the range's last byte
)
    for $c: Sz = lo; c <= Sz::hi; c += 1
        n.set[c] = true

fn free_rx_alts( //< frees a group's alternatives and every node under them
    //< It frees the Lists too. Walk .alts only for the .group kind (for others it is
    //< uninitialized).
    alts: List<|List<|Rx_node$@|>|>$@, //< the alternatives to free
)
    for i in Range.asc(alts.len)
        $seq: = alts.get(i)
        for k in Range.asc(seq.len)
            free_rx_node(seq.get(k))
        seq.free()
    alts.free()

fn free_rx_node( //< frees one node and everything under it
    n: Rx_node$@, //< the node to free
)
    if n == null
        return
    if n.sub != null
        free_rx_node(n.sub)
    // `.group_repeat`'s `sub` is the group itself, already freed above.
    if n.kind == .group
        free_rx_alts(n.alts@)
    dealloc(Void$@::n)

// ==================== The program (written from the tree) ====================
enum Op //< what one step of the program does
    byte //< one byte against `node` (a literal, `.` or a class), then the next step
    check //< a zero-width test, `node`'s kind: `^`, `$`, `\b` or `\B`
    split //< go on at `x`, and at `y` with lower priority
    jump //< go on at `x`
    save //< record the position in slot `a`
    round_in //< a round of a repetition whose body can match empty begins: one more open round
    round_out //<
        //< That round ends: if it read nothing, the repetition stops at `x`; else the next step
    done //< the whole pattern matched

struct Inst //< one step of the program; `op` decides which fields mean something
    op: Op
    node: Rx_node$@ //< the tree node read (shared with the tree, never freed through this)
    x: Sz
    y: Sz
    a: Sz
    base: Sz //< the step's first state; the state with `k` rounds open is `base + k`

struct Emitter //< the program being written, and the state count it has reached
    prog: List<|Inst|>
    depth: Sz //< the rounds of a repetition that can match empty around the next step
    states: Sz //< the states the steps so far hold, against max_program_size

fn can_be_empty(n: Rx_node$@): Bool //< whether the node can match without reading a byte
    //< The emitter walks the nesting, which compile() already held against the stack.
    switch n.kind
    case .lit, .any, .class
        return false
    case .repeat, .group_repeat
        return n.min_count == 0 || can_be_empty(n.sub)
    case .group
        for i in Range.asc(n.alts.len)
            alt: = n.alts.get(i)
            $all: = true
            for k in Range.asc(alt.len)
                if !can_be_empty(alt.get(k))
                    all = false
                    break
            if all
                return true
        return false
    default
        return true // a zero-width test

impl Emitter
    fn step(r: Self$@, op: Op, node: Rx_node$@, a: Sz): Sz //< appends a step; returns its place
        //< Its targets (`x`, `y`) are patched once the steps they name are written.
        r.prog
            .push(Inst::{ .op = op, .node = node, .x = 0, .y = 0, .a = a, .base = r.states })
        r.states += r.depth + 1
        return r.prog.len - 1

    fn full(r: Self@): Bool //<
        //< whether the program has passed its limit, so no more rounds are written
        //< Caution: **Stop writing the copies of a repetition once it is full.** `(a{1000}){1000}`
        //< would otherwise write a million steps before compile() refuses them.
        return r.states > MAX_PROGRAM_SIZE

    // The emitter walks the group nesting as the parse did, so it goes no deeper than
    // `max_nesting_depth`, which compile() already held against the stack.
    fn seq(r: Self$@, seq: List<|Rx_node$@|>$@) //< one alternative's atoms, in order
        for k in Range.asc(seq.len)
            r.node(seq.get(k))

    fn node(r: Self$@, n: Rx_node$@)
        switch n.kind
        case .lit, .any, .class
            r.step(.byte, n, 0)
        case .start_anchor, .end_anchor, .word_boundary, .not_word_boundary
            r.step(.check, n, 0)
        case .group
            r.group(n)
        case .repeat, .group_repeat
            r.repeat(n)

    fn group(r: Self$@, g: Rx_node$@) //< a group: its start, its alternatives in order, its end
        if g.gidx >= 0
            r.step(.save, g, 2 + 2 * Sz::g.gidx)
        r.alts(g.alts@)
        if g.gidx >= 0
            r.step(.save, g, 3 + 2 * Sz::g.gidx)

    fn alts(r: Self$@, alts: List<|List<|Rx_node$@|>|>$@) //< alternatives, tried first to last
        $ends: = List<|Sz|>.new(null)
        defer ends.free()
        for i in Range.asc(alts.len)
            last: = i + 1 == alts.len
            $fork: Sz = 0
            if !last
                fork = r.step(.split, null, 0)
                r.prog.at(fork).x = r.prog.len
            $alt: = alts.get(i)
            r.seq(alt@)
            if !last
                ends.push(r.step(.jump, null, 0))
                r.prog.at(fork).y = r.prog.len
        for e in ends.slice()
            r.prog.at(e).x = r.prog.len

    // Written out round by round: `x{2,4}` is `x x`, then two rounds each skippable past the whole
    // repetition (the longest match tries the round first). `x{2,}` is `x x`, then a loop.
    // Caution: **A round that read nothing stops the repetition. It is not undone.** Undoing it
    // would leave `(a?)*b`'s group out where Python's `re` and PCRE answer empty. Going on
    // would loop for good. So a body that can match empty sits between `round_in` and `round_out`.
    fn repeat(r: Self$@, n: Rx_node$@)
        empty_ok: = n.kind == .group_repeat && can_be_empty(n.sub)
        $forks: = List<|Sz|>.new(null)
        defer forks.free()
        $exits: = List<|Sz|>.new(null)
        defer exits.free()
        for _i in Range.asc(n.min_count)
            if r.full()
                break
            r.round(n, empty_ok, exits@)
        if n.max_count < 0
            head: = r.step(.split, n, 0)
            forks.push(head)
            r.round(n, empty_ok, exits@)
            back: = r.step(.jump, n, 0)
            r.prog.at(back).x = head
        else
            for _i in Range.asc(n.max_count - n.min_count)
                if r.full()
                    break
                forks.push(r.step(.split, n, 0))
                r.round(n, empty_ok, exits@)
        past: = r.prog.len
        for f in forks.slice()
            fork: = r.prog.at(f)
            fork.x = past if n.lazy else f + 1
            fork.y = f + 1 if n.lazy else past
        for e in exits.slice()
            r.prog.at(e).x = past

    fn round(r: Self$@, n: Rx_node$@, empty_ok: Bool, exits: List<|Sz|>$@) //<
        //< one round of the body
        if !empty_ok
            r.node(n.sub)
            return
        r.step(.round_in, n, 0)
        r.depth += 1
        r.node(n.sub)
        exits.push(r.step(.round_out, n, 0))
        r.depth -= 1

import "std/bytes"
import "std/chars"
import "std/mem"
import "std/str" { Str_builder }
import "std/strfmt"
import "std/verdict"

// ==========================================
// std/bytes: tests of converting between bytes and a fixed-width integer.
//
// Caution: **Check the byte order itself, byte by byte.** A round trip alone passes when both
// directions are wrong in the same way. The expected values come from Python's `struct.pack`.
// ==========================================

$bytes_buf: U8[16]

fn test_bytes_endian()
  verdict.start("[bytes] a fixed-width integer's big/little endian conversion test...")

  s: = U8$[]::bytes_buf
  v: = U8[]::bytes_buf

  // 16bit: struct.pack(">H", 0x1234) == b"\x12\x34" / "<H" == b"\x34\x12"
  s.put_u16_be(0, 0x1234)
  assert(v[0] == 0x12 && v[1] == 0x34, "put_u16_be puts the high byte first")
  s.put_u16_le(0, 0x1234)
  assert(v[0] == 0x34 && v[1] == 0x12, "put_u16_le puts the low byte first")
  assert(v.get_u16_le(0) == 0x1234, "get_u16_le returns the original value")
  s.put_u16_be(0, 0x1234)
  assert(v.get_u16_be(0) == 0x1234, "get_u16_be returns the original value")

  // 32bit: struct.pack(">I", 0xdeadbeef) == b"\xde\xad\xbe\xef"
  s.put_u32_be(0, 0xdeadbeef)
  assert(v[0] == 0xde && v[1] == 0xad && v[2] == 0xbe && v[3] == 0xef, "put_u32_be's byte order")
  assert(v.get_u32_be(0) == 0xdeadbeef, "get_u32_be returns the original value")
  s.put_u32_le(0, 0xdeadbeef)
  assert(v[0] == 0xef && v[1] == 0xbe && v[2] == 0xad && v[3] == 0xde, "put_u32_le's byte order")
  assert(v.get_u32_le(0) == 0xdeadbeef, "get_u32_le returns the original value")

  // 64bit: both ends of struct.pack(">Q", 0x0123456789abcdef)
  s.put_u64_be(0, 0x0123456789abcdef)
  assert(v[0] == 0x01 && v[7] == 0xef, "put_u64_be's two ends")
  assert(v.get_u64_be(0) == 0x0123456789abcdef, "get_u64_be returns the original value")
  s.put_u64_le(0, 0x0123456789abcdef)
  assert(v[0] == 0xef && v[7] == 0x01, "put_u64_le's two ends")
  assert(v.get_u64_le(0) == 0x0123456789abcdef, "get_u64_le returns the original value")

  // No sign extension from a high bit: a U8 widened through I32 turns negative, and the OR then
  // overwrites the high bits.
  s.put_u32_be(0, 0x80ff80ff)
  high32: = v.get_u32_be(0)
  assert(high32 == 0x80ff80ff, "no sign extension even with the top bit set")
  s.put_u16_be(4, 0xff80)
  assert(v.get_u16_be(4) == 0xff80, "no sign extension at 16 bits either")

  // The given offset is used (it is not fixed to the start).
  s.put_u32_le(8, 0x11223344)
  s.put_u32_le(12, 0x55667788)
  at8: = v.get_u32_le(8)
  at12: = v.get_u32_le(12)
  assert(at8 == 0x11223344 && at12 == 0x55667788, "each offset reads independently")

  verdict
    .pass("The 16/32/64-bit BE/LE conversions take the order struct.pack does, with no sign \
      extension and no offset mistaken.")

fn test_bytes_fill_copy()
  verdict.start("[bytes] fill/copy_from and hexadecimal output test...")

  s: = U8$[]::bytes_buf
  v: = U8[]::bytes_buf

  s.fill(0xaa)
  assert(v[0] == 0xaa && v[15] == 0xaa, "fill fills every element")

  n: = s.copy_from(2, "hello")
  assert(n == 5, "copy_from returns the number of bytes copied")
  got: = v.sub(2, 5)
  assert(got.equals("hello"), "copy_from's content and position")
  assert(v[1] == 0xaa && v[7] == 0xaa, "copy_from does not touch outside its range")

  // What does not fit is truncated (nothing is written past the end).
  m: = s.copy_from(13, "world")
  tail: = v.sub(13, 3)
  assert(m == 3 && tail.equals("wor"), "copy_from cuts at the buffer's end")
  assert(s.copy_from(16, "x") == 0, "an at out of range returns 0")

  // It copies correctly over an overlapping range (memcpy breaks here).
  s.fill(0)
  _k: = s.copy_from(0, "abcdef")
  _k2: = s.copy_from(2, v.sub(0, 6))
  fwd: = v.sub(0, 8)
  assert(fwd.equals("ababcdef"), "a copy shifted forward does not break when it overlaps")
  s.fill(0)
  _k3: = s.copy_from(2, "abcdef")
  _k4: = s.copy_from(0, v.sub(2, 6))
  back: = v.sub(0, 6)
  assert(back.equals("abcdef"), "a copy shifted backward does not break when it overlaps")

  // A length-0 copy or zeroing does nothing and returns, even with a null pointer.
  // Caution: **Always include the case that passes null.** libc's memcpy / memset declare
  // `nonnull`, so null is undefined behaviour even at length 0, and an empty slice's `.ptr` is
  // null. An empty array literal's ptr is not null (genc emits one element).
  null_view: = U8[]::{ .ptr = null, .len = 0 }
  assert(null_view.ptr == null && null_view.len == 0,
    "an empty slice with a null can be built from a descriptor literal")
  mem.copy(Void$@::null_view.ptr, Void$@::null_view.ptr, 0)
  mem.zero(Void$@::null_view.ptr, 0)
  s.fill(0x5a)
  mem.zero(Void$@::s.ptr, 0)
  assert(v[0] == 0x5a, "a 0-byte zero writes nothing")

  // Hexadecimal: strfmt.hex for a `0x` prefix, otherwise `:x`.
  $b: = Str_builder.new()
  defer b.free()
  b.s("\{strfmt.hex(0x10000144, 8)\}")
  assert(b.slice().equals("0x10000144"), "hex: 8 digits with the 0x")
  b.clear().s("\{strfmt.hex(255, 2)\}")
  assert(b.slice().equals("0xff"), "hex: 2 digits")
  b.clear().s("\{0xdead:04x\}")
  assert(b.slice().equals("dead"), ":04x: no prefix")
  // The digit count is a **minimum width**, as in C's `%x`; truncating would change the value.
  b.clear().s("\{strfmt.hex(0x1234, 2)\}")
  assert(b.slice().equals("0x1234"), "hex: a value beyond the digit count is not cut down")

  // The format specifier: `x` lower, `X` upper; `0N` pads with zeros, `N` with spaces.
  word: U32 = 0xDEADBEEF
  small: U8 = 0xAF
  neg: I32 = -1
  b.clear().s("\{word:x\}")
  assert(b.slice().equals("deadbeef"), "the format specifier x: lower case")
  b.clear().s("\{word:X\}")
  assert(b.slice().equals("DEADBEEF"), "the format specifier X: upper case")
  b.clear().s("\{word:012X\}")
  assert(b.slice().equals("0000DEADBEEF"), "the format specifier 012X: padded with zeros")
  b.clear().s("[\{small:6x\}]")
  assert(b.slice().equals("[    af]"), "the format specifier 6x: padded with spaces")
  b.clear().s("\{word:2x\}")
  assert(b.slice().equals("deadbeef"),
    "the format specifier: the width is a minimum, so nothing is cut down")
  // A signed value goes through **the unsigned type of the same width**; converted straight to
  // `U64` it sign-extends to 16 digits.
  b.clear().s("\{neg:x\}")
  assert(b.slice().equals("ffffffff"),
    "the format specifier x: I32 is 8 digits, as its type's width")

  verdict
    .pass("fill/copy_from keep to their range and stand up to an overlap, and hexadecimal does not \
      cut digits down.")

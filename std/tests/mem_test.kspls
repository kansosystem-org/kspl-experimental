//< Tests of `std/mem` and the counted references
//<
//< What an arena keeps across a reset, the marks it rewinds to, the heap's counters under threads,
//< and `Rc` / `Arc` balancing their counts.
import "std/mem" + { Arena, alloc, dealloc }
import "std/refcount" { Rc, Arc, Weak_rc, Weak_arc }
import "std/tests/sys_test"
import "std/thread"
import "std/verdict"

// ==========================================
// std/mem: what an arena keeps when it is reset for another round.
// ==========================================
priv const kib: Sz = 1024

priv fn one_round(a: Arena$@) //< three allocations, each bigger than the chunk before could hold
    a.alloc(100 * kib)
    a.alloc(300 * kib)
    a.alloc(700 * kib)

fn test_arena_reset_keeps_one_chunk()
    verdict.start("[Arena] reset keeps what a round used as one chunk, and the next round fits...")
    a: = Arena.new(1024 * kib)
    defer a.free()
    one_round(a)
    grown: = a.get_total_allocated()
    a.reset()
    kept: = a.get_total_allocated()
    assert(kept < grown, "Arena: what the chunks held unused is let go")
    assert(a.headroom().free == 1100 * kib,
        "Arena: one chunk holds what the round used, past the ceiling")
    one_round(a)
    assert(a.get_total_allocated() == kept, "Arena: the same round again takes no new chunk")
    verdict.pass("Arena.reset keeps one chunk, as big as the round, and the next round reuses it")

fn test_arena_reset_fixed_buffer()
    verdict.start("[Arena] reset on a fixed buffer hands the whole buffer out again...")
    buf: U8[4096] = ::{}
    $a: = Arena.from_buffer(Void$@::buf@, 4096)
    whole: = a.headroom().free
    a.alloc(whole)
    a.reset()
    assert(a.headroom().free == whole, "Arena: a fixed buffer is whole again after reset")
    a.alloc(whole)
    verdict.pass("Arena.reset on a fixed buffer frees nothing and hands it all out again")

// ==========================================
// std/mem: rewinding an arena to a mark, and the marks it refuses.
// ==========================================
fn test_arena_restore()
    verdict.start("[Arena] restore rewinds to a mark, across a chunk and more than once...")
    a: = Arena.new(4 * kib)
    defer a.free()
    a.alloc(100)
    mark: = a.save()
    first: = a.alloc(16)
    a.alloc(5 * kib) // past the chunk, so it takes one of its own
    grown: = a.get_total_allocated()
    a.restore(mark)
    assert(a.get_total_allocated() < grown, "Arena: the chunk taken after the mark is freed")
    assert(a.alloc(16) == first,
        "Arena: the next allocation lands where the first after the mark did")
    a.restore(mark)
    assert(a.alloc(16) == first, "Arena: the same mark rewinds again")
    verdict.pass("Arena.restore frees what came after the mark, and a mark serves more than once")

priv const restore_foreign_src: U8[] = //< a child that rewinds one arena to another's mark
    """import "std/mem" { Arena }

fn main()
  a: = Arena.new(4096)
  b: = Arena.new(4096)
  _x: = a.alloc(100)
  mark: = a.save()
  _y: = b.alloc(5000)
  b.restore(mark)
"""

priv const restore_before_reset_src: U8[] = //< a child that rewinds to a mark from before reset
    //<
    //< After the reset the one chunk is kept and holds more than the mark did, so only the count
    //< of resets tells the mark is stale.
    """import "std/mem" { Arena }

fn main()
  a: = Arena.new(4096)
  _x: = a.alloc(100)
  mark: = a.save()
  a.reset()
  _y: = a.alloc(200)
  a.restore(mark)
"""

priv const restore_rewound_past_src: U8[] = //< a child that rewinds to a mark it rewound past
    """import "std/mem" { Arena }

fn main()
  a: = Arena.new(4096)
  _x: = a.alloc(100)
  early: = a.save()
  _y: = a.alloc(100)
  late: = a.save()
  a.restore(early)
  a.restore(late)
"""

fn test_arena_restore_refuses_stale_marks(ksplc: U8[], arena: Arena$@) //< ksplc runs the children
    verdict.start("[Arena] restore to a mark it cannot place...")
    // Without the refusal the foreign mark frees every chunk and becomes the head, so the next
    // allocations overlap the other arena's data and only a double free at the end shows it.
    why: = "Arena.restore: the mark is not this arena's"
    assert(sys_test.child_stops_with(ksplc, "restore_foreign", restore_foreign_src, why, arena),
        "a mark from another arena must stop the program at restore, naming it")
    assert(sys_test.child_stops_with(ksplc, "restore_reset", restore_before_reset_src, why, arena),
        "a mark from before reset() must stop the program at restore")
    assert(sys_test.child_stops_with(ksplc, "restore_past", restore_rewound_past_src, why, arena),
        "a mark an earlier restore rewound past must stop the program at restore")
    verdict.pass("Arena.restore stops on a mark from another arena, before reset, or rewound past")

fn test_move_overlap()
    verdict.start("[Mem] move shifts bytes within one buffer, either way...")
    $buf: U8[8] = ::{ '0', '1', '2', '3', '4', '5', '6', '7' }
    p: = buf@
    mem.move(Void$@::(p + 2), Void$@::p, 5)
    assert(buf[2] == '0' && buf[6] == '4', "Mem: move toward the tail keeps the source's order")
    mem.move(Void$@::p, Void$@::(p + 2), 5)
    assert(buf[0] == '0' && buf[4] == '4', "Mem: move toward the head keeps the source's order")
    mem.move(Void$@::p, Void$@::p, 0)
    verdict.pass("mem.move copies overlapping ranges in both directions, and 0 bytes does nothing")

priv const arena_zero_src: U8[] = //< a child that asks for an arena whose chunks hold nothing
    """import "std/mem" { Arena }

fn main()
  a: = Arena.new(0)
  _p: = a.alloc(8)
  a.free()
"""

fn test_arena_new_refuses_zero(ksplc: U8[], arena: Arena$@) //< ksplc runs the child
    verdict.start("[Arena] Arena.new with a chunk size of 0...")
    // Without the refusal it is taken for a fixed buffer: the first alloc blames `from_buffer`.
    named: = sys_test.child_stops_with(ksplc, "arena_zero", arena_zero_src,
        "Arena.new: chunk_size must be above 0", arena)
    assert(named, "Arena.new(0) must stop the program, naming itself and the size")
    verdict.pass("Arena.new refuses a chunk size of 0 where it is called.")

// ==========================================
// std/mem: the heap's counters, when several threads allocate and free at once.
// ==========================================
priv const churn_threads: Sz = 4
priv const churn_rounds: I32 = 50000
priv const churn_bytes: Sz = 24

#export
fn heap_churn(rounds: I32$@): Void$@ //< allocates and frees one block, rounds times over
    for _i in Range.asc(rounds$)
        dealloc(alloc(churn_bytes))
    return null

fn test_heap_counters_across_threads()
    verdict.start("[Mem] the heap's counters lose no update when threads allocate at once...")
    used0: = mem.heap_used_bytes()
    total0: = mem.heap_requested_total_bytes()
    $rounds: = churn_rounds
    $ts: thread.Thread$@[churn_threads] = ::{}
    for i in Range.asc(churn_threads)
        ts[i] = thread.Thread.spawn<|I32|>(heap_churn, rounds@) catch panic("thread spawn failed")
    for i in Range.asc(churn_threads)
        ts[i].join_and_free()
    // Each thread's handle is on the heap too, freed by its join.
    want: = churn_threads * (Sz::churn_rounds * churn_bytes + sizeof(thread.Thread))
    assert(mem.heap_used_bytes() == used0, "Mem: the bytes in use return to where they started")
    assert(mem.heap_requested_total_bytes() - total0 == want,
        "Mem: the running total counts every byte each thread asked for")
    assert(mem.heap_peak_used_bytes() >= used0 + churn_bytes,
        "Mem: the peak holds at least one block live at once")
    verdict
        .pass("four threads allocating at once leave the in-use count, the total and the peak right")

// ==========================================
// Tests that `Rc`, `Arc`, `Weak_rc` and `Weak_arc` balance their counts with no manual release
// `heap_used_bytes()` must return to its starting value; `Arc` and `Weak_arc` also run on real
// OS threads. **Only the balance is tested here**: where the compiler inserts a `retain` or a
// `release` belongs to the compiler's tests.
// ==========================================
// ==========================================
// std/refcount: Rc<T> is shared by plain assignment and freed by the release inserted as the
// scope ends.
// ==========================================
priv fn rc_shared_body()
    $a: = Rc<|I32|>.new(42)
    $b: = a // plain assignment -> shared by an automatic retain (count 2)
    assert(a.get()$ == 42 && b.get()$ == 42, "both handles must read the shared value")
    b.get()$ = 100
    assert(a.get()$ == 100, "writing through one handle must be visible through the other")
    // Leaving the scope releases a and b; once the last owner is gone, the value is freed.

fn test_rc_refcount()
    verdict.start("[Rc] ARC automatic reference counting (shared by plain assignment) test...")
    heap_before: = mem.heap_used_bytes()
    rc_shared_body()
    heap_after: = mem.heap_used_bytes()
    assert(heap_after == heap_before,
        "Rc must be auto-freed once all owners leave scope (no leak, no double-free)")
    verdict.pass("It is shared by plain assignment and freed automatically as the scope is left.")
// ==========================================
// std/refcount: Arc<T>'s count stays atomic under concurrent copying and destruction on real OS
// threads; a clone inside the loop is released as each iteration ends.
// ==========================================
#export
fn arc_test_clone_storm(arg: Arc<|I32|>$@): Void$@
    for _i in Range.asc(5000)
        _c: = arg.clone() // atomic +1; c is released automatically (-1) as this iteration ends
    return null

priv fn arc_storm_body()
    $shared: = Arc<|I32|>.new(7)
    t1: = thread.Thread.spawn<|Arc<|I32|>|>(arc_test_clone_storm, shared@)
        catch panic("thread spawn failed")
    t2: = thread.Thread.spawn<|Arc<|I32|>|>(arc_test_clone_storm, shared@)
        catch panic("thread spawn failed")
    t3: = thread.Thread.spawn<|Arc<|I32|>|>(arc_test_clone_storm, shared@)
        catch panic("thread spawn failed")
    t4: = thread.Thread.spawn<|Arc<|I32|>|>(arc_test_clone_storm, shared@)
        catch panic("thread spawn failed")
    t1.join_and_free()
    t2.join_and_free()
    t3.join_and_free()
    t4.join_and_free()
    assert(shared.get()$ == 7, "value must survive the clone storm intact")
    // shared is released automatically as the scope ends -> 0 -> freed.

fn test_arc_refcount_concurrent()
    verdict.start("[Arc] ARC concurrent copy/destroy atomicity storm test (4 threads x 5000)...")
    heap_before: = mem.heap_used_bytes()
    arc_storm_body()
    heap_after: = mem.heap_used_bytes()
    assert(heap_after == heap_before,
        "refcount must return to the pre-test heap baseline (no leak, no double-free)")
    verdict
        .pass("The value survives simultaneous copying and automatic destruction on 4 threads, and \
            is freed exactly when every owner is gone.")
// ==========================================
// std/refcount: Weak_rc<T>. upgrade succeeds while a strong reference lives, fails once every Rc
// has left its scope, and everything is freed once the weak one is gone too.
// ==========================================
priv fn weak_alive_body()
    $rc: = Rc<|I32|>.new(42)
    $w: = rc.downgrade()
    $up: = w.upgrade() catch panic("upgrade() must succeed while a strong Rc<T> is still alive")
    assert(up.get()$ == 42, "upgraded handle must read the shared value")
    // up, w and rc are all released automatically as the scope ends.

priv fn make_dropped_weak(): Weak_rc<|I32|> //<
    //< Creates an rc inside the scope and returns a Weak_rc downgraded from it
    //<
    //< rc's release takes strong to 0, but the weak remains, so _Rc_ctrl is not freed.
    $rc: = Rc<|I32|>.new(42)
    w: = rc.downgrade()
    return w

priv fn weak_after_drop_body()
    $w: = make_dropped_weak() // strong=0, weak=1
    $upgrade_failed: = false
    $ph: = w.upgrade() catch
        upgrade_failed = true
        fallback Rc<|I32|>.new(0) // an unrelated stand-in, only to satisfy the type (auto-freed)
    assert(upgrade_failed, "upgrade() after the last strong owner is gone must fail")
    assert(ph.get()$ == 0, "fallback placeholder must be usable")
    // ph and w are released as the scope ends; everything is freed once weak reaches 0 too.

fn test_weak_upgrade()
    verdict.start("[Weak_rc] ARC downgrade/upgrade + avoiding a reference-cycle leak test...")
    heap_before: = mem.heap_used_bytes()
    weak_alive_body()
    weak_after_drop_body()
    heap_after: = mem.heap_used_bytes()
    assert(heap_after == heap_before,
        "heap must return to the baseline once both strong and weak reach zero")
    verdict
        .pass("upgrade succeeds while alive, fails once every strong is gone, and everything is \
            freed automatically.")
// ==========================================
// std/refcount: Weak_arc<T> under concurrent downgrade/upgrade on real OS threads. upgrade's CAS
// loop keeps a freed value from coming back to life.
// ==========================================
#export
fn arc_test_weak_storm(arg: Arc<|I32|>$@): Void$@
    for _i in Range.asc(5000)
        $w: = arg.downgrade() // weak atomic +1 (automatic -1 as the iteration ends)
        _up: = w.upgrade() catch // strong atomic +1 (CAS) (automatic -1 as the iteration ends)
            panic("upgrade() must succeed while the original Arc<T> is still alive")
    return null

priv fn weak_arc_storm_body()
    $shared: = Arc<|I32|>.new(7)
    t1: = thread.Thread.spawn<|Arc<|I32|>|>(arc_test_weak_storm, shared@)
        catch panic("thread spawn failed")
    t2: = thread.Thread.spawn<|Arc<|I32|>|>(arc_test_weak_storm, shared@)
        catch panic("thread spawn failed")
    t3: = thread.Thread.spawn<|Arc<|I32|>|>(arc_test_weak_storm, shared@)
        catch panic("thread spawn failed")
    t4: = thread.Thread.spawn<|Arc<|I32|>|>(arc_test_weak_storm, shared@)
        catch panic("thread spawn failed")
    t1.join_and_free()
    t2.join_and_free()
    t3.join_and_free()
    t4.join_and_free()
    assert(shared.get()$ == 7, "value must survive the downgrade/upgrade storm intact")

priv fn make_dropped_weak_arc(): Weak_arc<|I32|>
    $a: = Arc<|I32|>.new(7)
    w: = a.downgrade()
    return w

priv fn weak_arc_after_drop_body()
    $w: = make_dropped_weak_arc()
    $upgrade_failed: = false
    $ph: = w.upgrade() catch
        upgrade_failed = true
        fallback Arc<|I32|>.new(0)
    assert(upgrade_failed, "upgrade() after the last Arc<T> owner is gone must fail")
    assert(ph.get()$ == 0, "fallback placeholder must be usable")

fn test_weak_arc_concurrent()
    verdict
        .start("[Weak_arc] ARC concurrent downgrade/upgrade atomicity storm test (4 threads x \
            5000)...")
    heap_before: = mem.heap_used_bytes()
    weak_arc_storm_body()
    weak_arc_after_drop_body()
    heap_after: = mem.heap_used_bytes()
    assert(heap_after == heap_before,
        "heap must return to the baseline after the storm + after-drop scenario")
    verdict
        .pass("The value survives simultaneous downgrade/upgrade on 4 threads and is freed \
            automatically in the end, with no leak.")

//< Tests of writing, copying and walking a tree in a scratch folder (`std/fs`)
//< **Each check works in a folder that `mkdir_unique` creates for it**, so a run never sees what
//< an earlier run left. The check removes the folder best-effort at the end. The walk past links
//< makes them with `ln -s`, and skips where there is none.
import "std/chars"
import "std/fs"
import "std/io"
import "std/mem" + { Arena, dealloc }
import "std/str" // `arena.text()`
import "std/subproc"
import "std/sys"
import "std/tests/file_mode"
import "std/tests/fs_test"
import "std/tests/sys_test"
import "std/thread"
import "std/verdict"

priv const BASE: U8[] = "out/tmp/kspl_test_tree"

priv fn holds(path: U8[], want: U8[]): Bool //< whether the file at path contains exactly want
    got: = io.read_file(path, null) catch
        return false
    defer dealloc(Void$@::got.ptr)
    return got.equals(want)

fn test_fs_mkdir_unique()
    verdict.start("[Fs] making a directory nobody took test...")
    defer arena: = Arena.new(64 * 1024)
    a: = fs.mkdir_unique(BASE, "box_", arena) catch panic("mkdir_unique should make a directory")
    b: = fs.mkdir_unique(BASE, "box_", arena) catch panic("mkdir_unique should make a second one")
    assert(!a.equals(b), "two calls must not return the same directory")
    assert(fs.is_dir(a) && fs.is_dir(b), "both places must stand as directories")
    leaf: = a.sub_from(BASE.len + 1)
    assert(leaf.starts_with("box_") && leaf.len == 4 + 16,
        "the name is the prefix and 16 hex digits")
    // A base that cannot contain a directory is refused at once, without trying name after name.
    file: = fs.join(a, "a_file", arena)
    io.write_file(file, "x") catch panic("the probe file must be writable")
    _refused: = fs.mkdir_unique(file, "box_", arena) catch
        fs_test.clear_tree_best_effort(a, arena)
        fs_test.clear_tree_best_effort(b, arena)
        verdict.pass("Each call makes a place of its own, and a base holding a file is refused.")
        return
    panic("a base that is a file must be refused")

fn test_fs_write_unique()
    verdict.start("[Fs] writing a file nobody took, for its owner alone test...")
    defer arena: = Arena.new(64 * 1024)
    dir: = fs.mkdir_unique(BASE, "owned_", arena)
        catch panic("mkdir_unique should make a directory")
    a: = fs.write_unique(dir, "page_", ".html", "one", arena) catch
        panic("write_unique should write a file")
    b: = fs.write_unique(dir, "page_", ".html", "two", arena) catch
        panic("write_unique should write a second one")
    assert(!a.equals(b), "two calls must not return the same file")
    assert(holds(a, "one") && holds(b, "two"), "each holds what was written into it")
    leaf: = a.sub_from(dir.len + 1)
    assert(leaf.starts_with("page_") && leaf.ends_with(".html") && leaf.len == 5 + 16 + 5,
        "the name is the prefix, 16 hex digits and the suffix")
    // **A base holding a file is refused** at once, without trying name after name.
    $refused: = false
    fs.write_unique(a, "page_", ".html", "x", arena) catch
        refused = true
    assert(refused, "a base that is a file must be refused")
    shown: = file_mode.mode_shown(a, arena)
    if shown.len > 0
        assert(shown.equals("-rw-------"), "only its owner may read or write it")
    fs_test.clear_tree_best_effort(dir, arena)
    if shown.len == 0
        verdict.skip("this system shows no POSIX mode (Windows, or a filesystem without one)")
        return
    verdict.pass("Each call makes a file of its own, which only its owner may read.")

priv fn set_mode(path: U8[], mode: U8[], arena: Arena$@): Bool //< `chmod`, true where it ran
    if sys.is_windows()
        return false
    return sys_test.ran_to_zero(U8[][]::{ "/bin/chmod", mode, path }, arena)

fn test_fs_replace_file()
    verdict.start("[Fs] replacing a file whole, with its mode kept or narrowed test...")
    defer arena: = Arena.new(64 * 1024)
    dir: = fs.mkdir_unique(BASE, "replace_", arena)
        catch panic("mkdir_unique should make a directory")
    doc: = fs.join(dir, "doc.txt", arena)
    fs.replace_file(doc, "one", .kept) catch panic("a new file should be written")
    fs.replace_file(doc, "two", .kept) catch panic("the file should be replaced")
    assert(holds(doc, "two"), "the file holds what was written last")
    $last: U8[] = "two"
    // **The mode stays**: renamed over it, the part's own 0600 would become the file's.
    $shown: U8[] = ""
    if set_mode(doc, "640", arena)
        fs.replace_file(doc, "three", .kept) catch panic("the file should be replaced again")
        shown = file_mode.mode_shown(doc, arena)
        if shown.len > 0
            assert(shown.equals("-rw-r-----"), "kept: the replaced file's bits stay")
        fs.replace_file(doc, "four", .owner_only) catch panic("the file should be narrowed")
        if shown.len > 0
            assert(file_mode.mode_shown(doc, arena).equals("-rw-------"),
                "owner_only: its owner alone")
        last = "four"
    // A read-only file is replaced, as a rename over it is, and stays read-only.
    if set_mode(doc, "444", arena)
        fs.replace_file(doc, "five", .kept) catch panic("a read-only file should be replaced")
        if shown.len > 0
            assert(file_mode.mode_shown(doc, arena).equals("-r--r--r--"), "kept: read-only stays")
        last = "five"
    assert(holds(doc, last), "each replacement holds its own content")
    // A folder at the name is refused, and its part goes with the refusal.
    sub: = fs.join(dir, "sub", arena)
    fs.mkdir(sub) catch panic("the folder must be makeable")
    $refused: = false
    fs.replace_file(sub, "x", .kept) catch
        refused = true
    assert(refused, "a folder standing at the name is not replaced")
    $missing: = false
    fs.replace_file(fs.join(dir, "no/such.txt", arena), "x", .kept) catch
        missing = true
    assert(missing, "a missing folder fails the call")
    names: = fs.read_dir(dir, arena) catch panic("the folder must be readable")
    assert(names.len == 2, "no part is left beside the file")
    _writable: = set_mode(doc, "644", arena)
    fs_test.clear_tree_best_effort(dir, arena)
    if shown.len == 0
        verdict.skip("this system shows no POSIX mode (Windows, or a filesystem without one)")
        return
    verdict
        .pass("Each replacement held its content whole, kept or narrowed the mode, and left no \
            part.")

fn test_fs_write_tree()
    verdict.start("[Fs] writing a tree of files test...")
    defer arena: = Arena.new(64 * 1024)
    dir: = fs.mkdir_unique(BASE, "write_", arena)
        catch panic("mkdir_unique should make a directory")
    rels: = U8[][]::{ "top.txt", "a/b/deep.txt" }
    fs.write_tree(dir, rels, U8[][]::{ "top", "deep" }, arena)
        catch panic("write_tree should write")
    assert(holds(fs.join(dir, "top.txt", arena), "top"), "top.txt must hold what was written")
    assert(holds(fs.join(dir, "a/b/deep.txt", arena), "deep"),
        "the levels on the way must be made, and the file written")
    // A name that climbs out of the tree is refused before anything in the list is written.
    climbed: = U8[][]::{ "first.txt", "../escape.txt" }
    $refused: = false
    fs.write_tree(dir, climbed, U8[][]::{ "1", "2" }, arena) catch
        refused = true
    assert(refused, "a name climbing out must be refused")
    assert(!fs.exists(fs.join(dir, "first.txt", arena)), "nothing in a refused list is written")
    $uneven: = false
    fs.write_tree(dir, U8[][]::{ "one.txt" }, U8[][]::{ "1", "2" }, arena) catch
        uneven = true
    assert(uneven, "names and contents of different counts must be refused")
    fs_test.clear_tree_best_effort(dir, arena)
    verdict.pass("A tree is written with its levels made, and a name climbing out writes nothing.")

priv fn runnable(path: U8[], arena: Arena$@): Bool //< whether `test -x` says it can be started
    return sys_test.ran_to_zero(U8[][]::{ "test", "-x", path }, arena)

fn test_fs_copy_tree()
    verdict.start("[Fs] copying a tree to a place where nothing stands test...")
    defer arena: = Arena.new(64 * 1024)
    dir: = fs.mkdir_unique(BASE, "copy_", arena) catch panic("mkdir_unique should make a directory")
    from: = fs.join(dir, "from", arena)
    fs.write_tree(from, U8[][]::{ "a.txt", "sub/b.txt", "skipme/c.txt" },
        U8[][]::{ "a", "b", "c" }, arena) catch panic("the tree to copy must be writable")
    to: = fs.join(dir, "made/on/the/way/to", arena)
    fs.copy_tree(from, to, fs_test.skip_skipme, arena) catch panic("copy_tree should copy the tree")
    assert(holds(fs.join(to, "a.txt", arena), "a") &&
        holds(fs.join(to, "sub/b.txt", arena), "b"), "every file keeps its place and its contents")
    assert(!fs.exists(fs.join(to, "skipme", arena)), "a directory skip_dir names is not copied")
    $refused: = false
    fs.copy_tree(from, to, fs_test.skip_skipme, arena) catch
        refused = true
    assert(refused, "a destination that stands already must be refused")
    // The walk's paths drop the source's trailing separators; measured by the source as written,
    // `from//` would cut a letter off every name.
    again: = fs.join(dir, "again", arena)
    fs.copy_tree(arena.text().s(from).s("//").take(), again, fs_test.skip_skipme, arena) catch
        panic("copy_tree should copy from a path ending in separators")
    assert(holds(fs.join(again, "a.txt", arena), "a") &&
        holds(fs.join(again, "sub/b.txt", arena), "b"),
        "a source ending in separators keeps every name whole")
    // POSIX alone (Windows keeps no execute bit): the mode goes with the contents. Written fresh,
    // a script copied with its tree lost its execute bit.
    if !sys.is_windows()
        script: = fs.join(from, "run.sh", arena)
        io.write_file(script, "#!/bin/sh\n") catch panic("the script must be writable")
        subproc.run(U8[][]::{ "chmod", "755", script }, "", 10000, 1024, arena) catch
            panic("chmod must run")
        with_mode: = fs.join(dir, "with_mode", arena)
        fs.copy_tree(from, with_mode, fs_test.skip_skipme, arena) catch
            panic("copy_tree should copy a tree holding a script")
        assert(runnable(fs.join(with_mode, "run.sh", arena), arena),
            "a copied file keeps its execute bit")
        assert(!runnable(fs.join(with_mode, "a.txt", arena), arena),
            "a copied file without one gains none")
        check_mode_from_first_byte(dir, arena)
    fs_test.clear_tree_best_effort(dir, arena)
    verdict.pass("A tree is copied whole to a new place, and a place that stands is refused.")

struct Mode_watch //< what the thread watching a copy as it is written reads and reports
    path: U8[]
    stop: thread.Atomic_sz
    seen_bare: thread.Atomic_sz //< 1 once the copy stood without its source's execute bit

#export
fn tree_test_watch_mode(w: Mode_watch$@): Void$@ //< looks at the copy until told to stop
    for w.stop.load() == 0
        if fs.exists(w.path) && !fs.can_run(w.path)
            w.seen_bare.store(1)
    return null

priv fn check_mode_from_first_byte(dir: U8[], arena: Arena$@) //<
    //< A copy has its source's bits from its first byte, never the default mode while written
    //< The source is its owner's alone and executable (0700). A copy created with the default
    //< mode would stand without the execute bit until narrowed, for as long as its contents take.
    from: = fs.join(dir, "private", arena)
    key: = fs.join(from, "key", arena)
    fs.mkdir(from) catch panic("the private folder must be creatable")
    defer big: = Arena.new((16 << 20) + 4096)
    body: = U8[]::{ .ptr = U8@::big.alloc(16 << 20), .len = 16 << 20 }
    io.write_file(key, body) catch panic("the private file must be writable")
    subproc.run(U8[][]::{ "chmod", "700", key }, "", 10000, 1024, arena) catch
        panic("chmod must run")
    to: = fs.join(dir, "private_copy", arena)
    w: = mem.alloc_as<|Mode_watch|>()
    defer dealloc(Void$@::w)
    w.path = fs.join(to, "key", arena)
    w.stop = thread.Atomic_sz.new(0)
    w.seen_bare = thread.Atomic_sz.new(0)
    t: = thread.Thread.spawn<|Mode_watch|>(tree_test_watch_mode, w) catch
        panic("the watching thread must start")
    fs.copy_tree(from, to, fs.skip_none, arena) catch panic("the private file must copy")
    w.stop.store(1)
    t.join_and_free()
    assert(w.seen_bare.load() == 0, "the copy never stands with a mode its source does not have")
    assert(runnable(w.path, arena), "the copy ends with its source's mode")

priv fn trust_at_mode(dir: U8[], mode: U8[], arena: Arena$@): fs.Dir_trust //<
    //< `dir_trust`'s answer once `chmod` has given the folder that mode
    r: =
        subproc.run_capture(U8[][]::{ "chmod", mode, dir }, "", 60000, 1024, arena)
        catch panic("the child must start")
    assert(r.exited_with(0), "chmod must change the folder's mode")
    return fs.dir_trust(dir)

fn test_fs_dir_trust() //< dir_trust tells a folder others can write from one they cannot
    verdict.start("[Fs] dir_trust: a folder's owner alone, everyone, and nothing there test...")
    defer arena: = Arena.new(64 * 1024)
    dir: = fs.mkdir_unique(BASE, "trust_", arena)
        catch panic("mkdir_unique should make a directory")
    assert(fs.dir_trust(fs.join(dir, "absent", arena)) == fs.Dir_trust.missing,
        "a folder that is not there is missing")
    if sys.is_windows()
        assert(fs.dir_trust(dir) == fs.Dir_trust.unchecked, "Windows's ACL is not read")
        fs_test.clear_tree_best_effort(dir, arena)
        verdict.pass("A folder not there is missing, and Windows answers unchecked.")
        return
    // The umask decides the new folder's mode, so it is set on purpose before each look.
    assert(trust_at_mode(dir, "700", arena) == fs.Dir_trust.own, "its owner alone writes it")
    assert(trust_at_mode(dir, "777", arena) == fs.Dir_trust.shared, "everyone may write it")
    fs_test.clear_tree_best_effort(dir, arena)
    verdict
        .pass("A folder its owner alone writes is own, one everyone writes is shared, and one not \
            there is missing.")

// ==========================================
// Tests of `std/fs`'s walks past links, made with `ln -s` (where there is none, the test skips)
// ==========================================
priv fn made_link(target: U8[], at: U8[], arena: Arena$@): Bool //<
    //< `ln -s`; false where none is made
    return sys_test.ran_to_zero(U8[][]::{ "ln", "-s", target, at }, arena) && fs.is_link(at)

fn test_fs_walk_links() //<
    //< A walk does not enter a link to a directory, and a copy takes no link at all
    //< Two links to `.` would make it visit 2^depth directories, and a link out of the tree would
    //< hand `copy_tree` files from elsewhere.
    verdict.start("[Fs] a walk past links to directories...")
    defer arena: = Arena.new(64 * 1024)
    root: = fs.mkdir_unique("out/tmp", "kspl_test_walk_links_", arena) catch
        panic("the place for the walk cannot be made")
    io.write_file(fs.join(root, "a.txt", arena), "a\n") catch panic("a.txt cannot be written")
    outside: = fs.mkdir_unique("out/tmp", "kspl_test_walk_outside_", arena) catch
        panic("the place outside cannot be made")
    io.write_file(fs.join(outside, "secret.txt", arena), "s\n") catch
        panic("secret.txt cannot be written")
    // Absolute targets, so they resolve wherever the walk runs from.
    here: = fs.absolute(root, arena) catch panic("the root has no absolute path")
    away: = fs.absolute(outside, arena) catch panic("the outside has no absolute path")
    made: =
        made_link(here, fs.join(root, "self1", arena), arena) &&
        made_link(here, fs.join(root, "self2", arena), arena) &&
        made_link(away, fs.join(root, "away", arena), arena) &&
        made_link(fs.join(away, "secret.txt", arena), fs.join(root, "leak.txt", arena), arena)
    if !made
        verdict.skip("a link cannot be made with `ln -s` in this environment")
        return
    files: = fs.walk_files(root, fs.skip_none, arena) catch
        panic("a walk past links must succeed, not stop at too_deep")
    assert(files.len == 2, "the file and the link to a file are found, once each")
    copy: = fs.join(fs.join("out/tmp", "kspl_test_walk_copy", arena), sys_suffix(root), arena)
    fs.copy_tree(root, copy, fs.skip_none, arena) catch panic("the tree must copy")
    assert(holds(fs.join(copy, "a.txt", arena), "a\n"), "the file in the tree is copied")
    assert(!fs.exists(fs.join(copy, "away/secret.txt", arena)) &&
        !fs.exists(fs.join(copy, "leak.txt", arena)), "a copy takes nothing from outside the tree")
    verdict.pass("a walk and a copy stay inside the tree, and two links to `.` end at once.")

priv fn sys_suffix(path: U8[]): U8[] //< the last name of a path, to keep the copy's place apart
    $at: = path.len
    for at > 0 && path[at - 1] != '/' && path[at - 1] != '\\'
        at -= 1
    return path.sub_from(at)

fn test_fs_copy_file()
    verdict.start("[Fs] copying one file to a name where nothing stands test...")
    defer arena: = Arena.new(64 * 1024)
    dir: = fs.mkdir_unique(BASE, "copy1_", arena)
        catch panic("mkdir_unique should make a directory")
    from: = fs.join(dir, "from.txt", arena)
    io.write_file(from, "contents") catch panic("the file to copy must be writable")
    to: = fs.join(dir, "to.txt", arena)
    fs.copy_file(from, to) catch panic("copy_file should copy a file to a free name")
    assert(holds(to, "contents"), "the copy holds the source's contents")
    $stood: = false
    fs.copy_file(from, to) catch
        stood = true
    assert(stood && holds(to, "contents"), "a destination that stands is refused and left as it is")
    $missing: = false
    fs.copy_file(fs.join(dir, "absent.txt", arena), fs.join(dir, "x.txt", arena)) catch e
        switch e
        case .not_found
            missing = true
        default {}
    assert(missing, "a source that is not there fails as not_found")
    $dir_refused: = false
    fs.copy_file(dir, fs.join(dir, "y.txt", arena)) catch
        dir_refused = true
    assert(dir_refused && !fs.exists(fs.join(dir, "y.txt", arena)),
        "a directory is no regular file, and nothing is made for it")
    fs_test.clear_tree_best_effort(dir, arena)
    verdict
        .pass("copy_file copies to a free name, and refuses one that stands, a missing source and a \
            directory.")

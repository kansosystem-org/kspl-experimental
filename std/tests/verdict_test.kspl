//< Tests of `std/verdict`'s run of checks that continues past a failure
//<
//< **Each run is its own child process**: the tally lasts as long as the process, so a run in
//< this process would end this one. The test checks all of the child's output and its exit code.
//< Caution: **Test the failing path above all.** No suite would notice a `finish` that prints
//< `ALL PASS` after a failure.
import "std/chars"
import "std/fs"
import "std/io"
import "std/log" { Log }
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/subproc"
import "std/verdict"

priv const work_dir: U8[] = "out/tmp/kspl_test_verdict"

priv const child_head: U8[] =
    """
import "std/ds" { List }
import "std/mem" { Arena }
import "std/verdict"

fn main(): I32
"""

// A failed check and a skipped check both let the run continue; only the failure is named.
priv const falls_main: U8[] =
    """
  verdict.begin("probe")
  verdict.check("one holds", true, "")
  verdict.check("two fails", false, "what was found")
  verdict.skip_check("three is passed over", "this machine lacks it")
  verdict.check("four still runs", true, "")
  return verdict.finish()
"""
priv const falls_out: U8[] =
    """
pass probe: one holds
FAIL probe: two fails: what was found
SKIP probe: three is passed over: this machine lacks it
pass probe: four still runs
RESULT: SOME FAILED (1) -> two fails
"""

// Nothing failed, so it passes and names what it skipped; an empty label prints no separator.
priv const passes_main: U8[] =
    """
  verdict.begin("")
  verdict.check("one holds", true, "")
  verdict.skip_check("two is passed over", "why")
  return verdict.finish()
"""
priv const passes_out: U8[] =
    """
pass one holds
SKIP two is passed over: why
RESULT: ALL PASS (1 skipped) -> two is passed over
"""

priv const stops_main: U8[] =
    """
  verdict.begin("probe")
  verdict.check("one holds", true, "")
  return verdict.fatal("its material is not there")
"""
priv const stops_out: U8[] =
    """
pass probe: one holds
FAIL probe: its material is not there
RESULT: SOME FAILED (1)
"""

// A walk of no files fails, just as one that finds something does; the findings are indented below.
priv const walks_main: U8[] =
    """
  verdict.begin("")
  arena: = Arena.new(4096)
  defer arena.free()
  $found: = List<|U8[]|>.new(arena)
  verdict.check_list("a walk of one", 1, "files", found@, "")
  verdict.check_list("a walk of none", 0, "files", found@, "")
  found.push("x.kspl holds it")
  verdict.check_list("a walk finding one", 2, "files", found@, "mend it so")
  return verdict.finish()
"""
priv const walks_out: U8[] =
    """
pass a walk of one (1 files)
FAIL a walk of none (0 files): it walked no files at all, so it held nothing up against anything — the reading broke, or what it reads has moved
FAIL a walk finding one (2 files): x.kspl holds it
    mend it so
RESULT: SOME FAILED (2) -> a walk of none (0 files), a walk finding one (2 files)
"""

// More failures than the `RESULT:` line has room to name.
priv const overflows_main: U8[] =
    """
  for _i in Range.asc(300)
    verdict.check("a check whose name is long enough to fill the room", false, "")
  return verdict.finish()
"""

priv fn run_child( //< writes one child's program and runs it to the end
    ksplc: U8[], //< the compiler that runs the child
    name: U8[], //< the child's file name, which is also how a failure names it
    body: U8[], //< the child's `main`, indented
    arena: Arena$@,
): subproc.Run_result
    fs.mkdir_all(work_dir) catch panic("the work directory must be creatable")
    src: = arena.text().s(work_dir).c('/').s(name).s(".kspl").take()
    io.write_file(src, arena.text().s(child_head).s(body).take()) catch
        panic("the child's program must be writable")
    r: = subproc.run_capture(U8[][]::{ ksplc, "run", src }, "", 300000, 1 << 20, arena)
    assert(!r.spawn_failed && !r.timed_out, "the child must start and come to an end")
    return r

priv fn holds_to( //< runs one child and stops if its output or exit code is not what is wanted
    ksplc: U8[],
    name: U8[],
    body: U8[],
    want: U8[], //< all the output it should print
    want_code: I32, //< the exit code it should end with
    arena: Arena$@,
)
    r: = run_child(ksplc, name, body, arena)
    // A child's standard output is text mode on Windows, so its lines arrive as CRLF.
    got: = r.stdout_data.replace("\r\n", "\n", arena)
    if got.equals(want) && r.exit_code == want_code
        return
    panic(U8$[]::arena.text().s(name).s(" put out\n").s(got)
        .s("and ended on \{r.exit_code\}, where ").s("it should put out\n").s(want)
        .s("and end on \{want_code\}\n").s(r.stderr_data).take())

fn test_verdict_goes_on_past_a_failure(ksplc: U8[], arena: Arena$@)
    verdict.start("[Verdict] a run of checks going on past a failure test...")
    holds_to(ksplc, "falls", falls_main, falls_out, 1, arena)
    holds_to(ksplc, "passes", passes_main, passes_out, 0, arena)
    holds_to(ksplc, "stops", stops_main, stops_out, 1, arena)
    verdict
        .pass("A failed check does not stop the run, and the `RESULT:` line and the exit code say \
            it.")

fn test_verdict_walk_of_nothing_fails(ksplc: U8[], arena: Arena$@)
    verdict.start("[Verdict] a walk that walked nothing failing test...")
    holds_to(ksplc, "walks", walks_main, walks_out, 1, arena)
    verdict.pass("A walk that walked nothing fails, as one that found something does.")

fn test_verdict_names_what_fits(ksplc: U8[], arena: Arena$@)
    verdict.start("[Verdict] a `RESULT:` line naming more than its room holds test...")
    r: = run_child(ksplc, "overflows", overflows_main, arena)
    lines: = r.stdout_data.lines(arena)
    assert(r.exit_code == 1 && lines.len == 301,
        "each failure puts its line out, and the run ends on 1")
    last: = lines.get(lines.len - 1)
    assert(last.starts_with("RESULT: SOME FAILED (300) -> a check whose name"),
        "the count on the line stays whole")
    assert(last.ends_with(" …") && last.len < 4100, "the names are held to their room, and say so")
    verdict
        .pass("A `RESULT:` line naming more than its room holds keeps the count whole and says \
            `…`.")

fn test_verdict_names_an_unmade_work_folder(arena: Arena$@) //<
    //< `run_children` with a work folder that cannot be made says so in each run
    //<
    //< **Not "it could not start"**, which reads as a child that could not be found.
    verdict.start("[Verdict] run_children naming a work folder it cannot make test...")
    fs.mkdir_all("out/tmp") catch panic("out/tmp must be creatable")
    io.write_file("out/tmp/kspl_test_not_a_folder", "") catch panic("the file must be writable")
    job: = subproc.Job::{ .argv = U8[][]::{ "no-such-program" }, .cwd = "" }
    outs: = verdict.run_children(subproc.Job[]::{ job, job }, "out/tmp/kspl_test_not_a_folder/w",
        arena)
    assert(outs.len == 2, "every run gets its answer")
    assert(outs.get(0).code == -1 &&
        outs.get(0).out.find_str("work folder").is_some(),
        "the answer names the work folder, not a start that failed")
    verdict.pass("A work folder that cannot be made is named in each run's answer.")

// ==========================================
// Tests of the message a panic stops with (`Panic_msg` in `std/lang`)
// **The stop itself cannot run in the tests' own process**, so these check the message builder
// a failure uses. `Panic_msg` needs no other file: this test imports only `std/verdict` to report.
// ==========================================
priv fn said(m: Panic_msg$@, want: U8[]): Bool //< whether the message is exactly `want`
    got: = m.slice()
    if got.len != want.len
        return false
    for i in Range.asc(want.len)
        if got[i] != want[i]
            return false
    return true

fn test_panic_msg_numbers()
    verdict.start("[lang] the stop message writes numbers test...")
    $a: = Panic_msg.new()
    a.n(-9223372036854775807 - 1)
    assert(said(a@, "-9223372036854775808"), "an I64's minimum is written whole")
    $b: = Panic_msg.new()
    b.s("line ").n(0)
    assert(said(b@, "line 0"), "a zero is written as one digit after the text")
    verdict.pass("the stop message spells an integer, its minimum and zero.")

// ==========================================
// Tests of log lines that carry a severity level (`std/log`)
// **Every test writes into a `Str_builder` rather than a stream**, so the output reads as a
// string; the destination is only a `Writer`, as in a freestanding build.
// ==========================================
fn test_log_keeps_what_is_heavy_enough()
    verdict.start("[Log] a line lighter than the level set being dropped test...")

    $out: = Str_builder.new()
    defer out.free()
    $lg: = Log.new(out, .information, "t")
    lg.say(.error, "a")
    lg.say(.warning, "b")
    lg.say(.information, "c")
    lg.say(.hint, "d")
    lg.done()
    assert(out.slice().equals("t: E: a\nt: W: b\nt: I: c\n"),
        "Log: down to the level set comes out, and what is lighter does not")

    // **The most severe level keeps only its own lines.**
    $only: = Str_builder.new()
    defer only.free()
    $strict: = Log.new(only, .error, "t")
    strict.say(.error, "a")
    strict.say(.warning, "b")
    strict.done()
    assert(only.slice().equals("t: E: a\n"), "Log: at error, a warning does not come out")

    verdict.pass("a line at or above the level set comes out, and a lighter one does not.")

fn test_log_at_does_not_run_the_body_when_light()
    verdict.start("[Log] the body of a line that is not emitted not running test...")

    $out: = Str_builder.new()
    defer out.free()
    $lg: = Log.new(out, .information, "")
    // **This is the guarantee the whole design exists for**: if `ran` changed for the dropped line,
    // a body would be built and thrown away.
    $ran: Sz = 0
    if w: = lg.at(.information)
        ran += 1
        w.s("kept")
    if w2: = lg.at(.hint)
        ran += 1
        w2.s("dropped")
    lg.done()
    assert(ran == 1, "Log: the body runs for the line kept and not for the one dropped")
    assert(out.slice().equals("I: kept\n"), "Log: an empty tag puts out no name and no separator")

    verdict.pass("the body of a line too light to be emitted does not run at all.")

fn test_log_closes_the_line_it_opened()
    verdict.start("[Log] the line opened being closed by whatever comes next test...")

    // **The next line closes a line left open**, so a caller that writes the body never ends it.
    $out: = Str_builder.new()
    defer out.free()
    $lg: = Log.new(out, .hint, "t")
    if w: = lg.at(.information)
        w.s("first")
    if w2: = lg.at(.information)
        w2.s("second")
    assert(out.slice().equals("t: I: first\nt: I: second"),
        "Log: opening the next line closes the one before it")

    // **`done` closes the last one**, and calling it twice adds nothing.
    lg.done()
    lg.done()
    assert(out.slice().equals("t: I: first\nt: I: second\n"),
        "Log: done closes the last line, and a second done adds nothing")

    verdict.pass("a line is closed by the next one opening, and the last by done.")

fn test_log_says_where_it_was_called_from()
    verdict.start("[Log] the caller's place going onto the line test...")

    // Passed by name, file and line override the default. **The line number is not this call's**,
    // so the check holds however this file is edited.
    $out: = Str_builder.new()
    defer out.free()
    $lg: = Log.new(out, .hint, "t", ": ", true)
    lg.say(.error, "boom", "a/b.kspl", 42)
    assert(out.slice().equals("t: E: a/b.kspl: 42: boom\n"),
        "Log: the place goes in ahead of the body, parted by the separator")

    // With the default it names **this** file, not `std/log`: `say` passes both on to `at`.
    $here: = Str_builder.new()
    defer here.free()
    $lg2: = Log.new(here, .hint, "t", ": ", true)
    lg2.say(.error, "boom")
    assert(here.slice().find_str("verdict_test").is_some(),
        "Log: the caller's file is the one named")
    assert(here.slice().find_str("std/log").is_none(), "Log: the library is not the one named")

    // **The place is off unless the logger is created with it on**, so a plain logger is unchanged.
    $plain: = Str_builder.new()
    defer plain.free()
    $lg3: = Log.new(plain, .hint, "t")
    lg3.say(.error, "boom")
    assert(plain.slice().equals("t: E: boom\n"), "Log: with place off the line carries no place")

    verdict.pass("the caller's file and line go on the line, one step back and no further.")

fn test_log_parts_its_fields_with_the_separator_given()
    verdict.start("[Log] the separator handed over parting the fields test...")

    // **A comma separator gives rows a spreadsheet can filter**, each with the same field count.
    $out: = Str_builder.new()
    defer out.free()
    $csv: = Log.new(out, .hint, "srv", ",", true)
    csv.say(.error, "cannot listen", "a/b.kspl", 7)
    csv.say(.hint, "chasing it", "a/b.kspl", 9)
    csv.done()
    assert(out.slice().equals("srv,E,a/b.kspl,7,cannot listen\nsrv,H,a/b.kspl,9,chasing it\n"),
        "Log: every row carries the same fields, parted by the separator handed over")

    // **The body is written unchanged**, so a caller that wants extra columns writes them itself.
    $raw: = Str_builder.new()
    defer raw.free()
    $loose: = Log.new(raw, .hint, "t", ",")
    loose.say(.error, "row 1 value,row 2 value")
    loose.done()
    assert(raw.slice().equals("t,E,row 1 value,row 2 value\n"),
        "Log: a body holding the separator becomes columns of its own")

    verdict.pass("the separator parts every row alike, and a body may carry columns of its own.")

priv struct Tally //<
    //< A destination that counts how often it is told to flush
    //<
    //< **Nothing else shows the flushes**: a missing flush would look like a pass.
    text: Str_builder
    flushes: Sz

impl Tally: Writer
    fn s(r: Self$@, val: U8[]): Self$@
        r.text.s(val)
        return r

    fn c(r: Self$@, val: U8): Self$@
        r.text.c(val)
        return r

    fn flush(r: Self$@): Self$@
        r.flushes += 1
        return r

fn test_log_pushes_a_heavy_line_out_at_once()
    verdict.start("[Log] a heavy line not being left to pile up test...")

    // **A buffering destination loses its last lines when the run is killed**, and those are the
    // lines that say what went wrong. So the two most severe levels are flushed as each line
    // closes.
    $t: Tally = ::{ .text = Str_builder.new(), .flushes = 0 }
    defer t.text.free()
    $lg: = Log.new(t@, .hint, "t")
    lg.say(.information, "a")
    lg.say(.hint, "b")
    assert(t.flushes == 0, "Log: a light line is left to pile up")
    lg.say(.warning, "c")
    assert(t.flushes == 1, "Log: a warning goes over the moment it closes")
    lg.say(.error, "d")
    assert(t.flushes == 2, "Log: an error goes over the moment it closes")

    // **The line opened through `at` counts the same**: both paths close the same way.
    if ln: = lg.at(.error)
        ln.s("e")
    assert(t.flushes == 2, "Log: it is the close that pushes, not the open")
    lg.done()
    assert(t.flushes == 4, "Log: done closes the heavy line, and flushes on its own besides")
    assert(t.text.slice().equals("t: I: a\nt: H: b\nt: W: c\nt: E: d\nt: E: e\n"),
        "Log: what came out is unchanged by the pushing")

    verdict.pass("an error and a warning are handed over as they close, and a lighter line piles.")

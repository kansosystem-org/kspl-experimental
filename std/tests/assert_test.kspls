//< Tests of the messages `assert_eq` and `assert_near` stop with (`std/lang`)
//<
//< **The stop itself cannot run in the tests' own process**, so these check the message builder
//< (`Panic_msg`) a failure uses, and that a holding comparison passes. `Panic_msg` needs no other
//< file: this test imports only `std/verdict` to report.
import "std/verdict"

priv fn said(m: Panic_msg$@, want: U8[]): Bool //< whether the message is exactly `want`
    got: = m.slice()
    if got.len != want.len
        return false
    for i in Range.asc(want.len)
        if got[i] != want[i]
            return false
    return true

fn test_panic_msg_numbers()
    verdict.start("[lang] the stop message writes numbers test...")
    $a: = Panic_msg.new()
    a.n(-9223372036854775807 - 1)
    assert(said(a@, "-9223372036854775808"), "an I64's minimum is written whole")
    $b: = Panic_msg.new()
    b.f(-2.5)
    assert(said(b@, "-2.500000"), "a float gets six decimals")
    $c: = Panic_msg.new()
    c.f(0.0 / 0.0)
    assert(said(c@, "nan"), "a NaN is written as a word")
    $d: = Panic_msg.new()
    d.f(-1.0 / 0.0)
    assert(said(d@, "-inf"), "an infinity is written as a word")
    verdict.pass("the stop message spells integers, floats, NaN and infinity.")

fn test_holding_comparisons_pass()
    verdict.start("[lang] assert_eq and assert_near let a holding value through test...")
    n: Sz = 3
    u: U8 = 3
    assert_eq(n, 3, "an Sz widens to the I64 compared")
    assert_eq(u, n, "so does a U8")
    assert_near(0.1 + 0.2, 0.3, 1.0e-9, "a rounding error inside the tolerance passes")
    assert_near(1.0, 1.0, 0.0, "equal values pass a zero tolerance")
    verdict.pass("values that hold pass both.")

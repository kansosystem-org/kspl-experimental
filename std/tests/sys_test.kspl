//< Tests of `std/sys` and `std/subproc`: the environment, the clocks, children
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/subproc" + { Job }
import "std/sys"
import "std/tests/fs_test"
import "std/verdict"

// ==========================================
// std/sys: reading an environment variable that is not set.
// ==========================================
fn test_env_unset()
    verdict.start("[Sys] reading an environment variable that is not set...")
    if _v: = sys.get_env("KSPL_TEST_ENV_DOES_NOT_EXIST_XYZ")
        panic("get_env should return none for an unset variable")
    verdict.pass("get_env returned none for an unset variable.")

// ==========================================
// std/sys: setting and deleting an environment variable. **An empty value cannot be set** (the
// reason is at `set_env` in `std/sys.kspl`).
// ==========================================
fn test_env_set_unset()
    verdict.start("[Sys] setting and deleting an environment variable (set_env / unset_env)...")
    name: = "KSPL_TEST_ENV_SET_UNSET"

    sys.set_env(name, "value1") catch panic("set_env should succeed")
    switch sys.get_env(name)
    case .some(v)
        assert(v.equals("value1"), "get_env must return what set_env wrote")
    case .none
        panic("get_env must find the variable set_env wrote")

    // An empty value is refused, and **the previous value must remain**: the caller reads the
    // refusal as "nothing happened".
    $empty_refused: = false
    sys.set_env(name, "") catch e
        empty_refused = e == sys.Env_error.empty_value
    assert(empty_refused, "set_env must refuse an empty value as empty_value")
    switch sys.get_env(name)
    case .some(v)
        assert(v.equals("value1"), "a refused set_env must leave the old value alone")
    case .none
        panic("a refused set_env must not remove the variable")

    // A value past 4096 characters reads back whole: held in a fixed buffer, it would read as
    // unset.
    $long: = Str_builder.new()
    for _i in Range.asc(5000)
        long.c('v')
    sys.set_env(name, long.slice()) catch panic("set_env takes a value of 5000 characters")
    switch sys.get_env(name)
    case .some(v)
        assert(v.equals(long.slice()), "get_env returns a value of 5000 characters whole")
    case .none
        panic("get_env must find a value of 5000 characters")

    sys.unset_env(name) catch panic("unset_env should succeed")
    if _v: = sys.get_env(name)
        panic("unset_env must remove the variable")

    // A name holding `=` is refused alike on every OS: POSIX refuses it, and Windows would cut the
    // name there and set another variable.
    $eq_refused: = false
    sys.set_env("KSPL_TEST=ENV", "v") catch e
        eq_refused = e == sys.Env_error.bad_name
    assert(eq_refused, "set_env must refuse a name holding `=` as bad_name")

    // Deleting a name that was never there is a success too.
    sys.unset_env("KSPL_TEST_ENV_NEVER_SET_XYZ") catch panic("unset_env on a missing name succeeds")

    verdict
        .pass("an empty value was refused and nothing changed, and unset_env is the only route for \
            deleting.")

// Caution: **Do not rely on the absolute value** of the monotonic clock; it has no fixed origin.
// The test reads only "it does not go back" and "it advances once work is done". **Handle an
// environment with no clock separately** (`timing_available()`), or the test fails there.

// The child that says whether it can run on one CPU alone.
priv const CPU_PROBE_SRC: U8[] =
    """import "std/io"
import "std/sys"

fn main(): I32
  io.out().s("one cpu\n" if sys.cpu_count() == 1 else "more cpus\n")
  return 0

"""

fn test_cpu_count_affinity(ksplc: U8[], arena: Arena$@) //<
    //< That cpu_count follows the CPUs a process can run on, not the machine's count
    //< ksplc runs the probe (`run_std` passes it), pinned to one CPU by `taskset` where it is
    //< there.
    verdict.start("[Sys] cpu_count follows the CPUs the process may run on...")
    assert(sys.cpu_count() >= 1, "cpu_count is never 0")
    if sys.is_windows()
        verdict
            .skip("pinning a child to one CPU is checked with taskset, which Windows does not have")
        return
    src: = child_path("cpu_probe", CPU_PROBE_SRC, arena)
    r: =
        subproc.run_capture(U8[][]::{ "taskset", "-c", "0", ksplc, "run", src }, "", 120000, 4096,
        arena) catch
        verdict.skip("taskset is not installed")
        return
    assert(r.stdout_data.equals("one cpu\n"), "a process pinned to one CPU counts one")
    verdict.pass("A process pinned to one CPU counts one.")

fn test_mono_clock()
    verdict.start("[Time] monotonically increasing real time...")
    if !sys.timing_available()
        verdict.skip("the real-time clock is degraded")
        return
    t0: = sys.mono_us()
    assert(sys.mono_us() >= t0, "reading it again does not go back")
    // Seeing it advance takes waiting: over an interval shorter than one tick, the same value
    // returns. **Wait on the clock itself**: a loop of arithmetic is folded away when optimized.
    $advanced: = false
    for _i in Range.asc(100000000)
        if sys.mono_us() > t0
            advanced = true
            break
    assert(advanced, "it advances once work is done")
    verdict.pass("confirmed that it does not go back and that it advances once work is done.")

fn test_absolute_paths() //< telling an absolute path from a relative one
    //< Caution: **Test the round trip too**, including **the separator after the drive**
    //< (`C:name` is relative to that drive's current directory). **A drive is a root on Windows
    //< only**: on POSIX `C:\x` and `a:/b` are relative names.
    verdict.start("[Sys] deciding whether a path starts from the root...")
    win: = sys.is_windows()
    assert(sys.is_absolute("/home/me"), "starting with `/` means from the root")
    assert(sys.is_absolute("\\\\server"), "the shape starting with `\\` is from the root too")
    assert(sys.is_absolute("C:\\work") == win && sys.is_absolute("C:/work") == win,
        "a drive plus a separator means from the root on Windows, and nowhere else")
    assert(sys.is_absolute("a:/b") == win, "on POSIX `a:` is a folder's name")
    assert(!sys.is_absolute("C:name"), "no separator after the drive means not from the root")
    assert(!sys.is_absolute("C:"), "a drive alone is not from the root either")
    assert(!sys.is_absolute("sub/dir"), "a relative path is not from the root")
    assert(!sys.is_absolute(""), "empty is not from the root")
    verdict
        .pass("only `/`, `\\` and, on Windows, a drive with a separator are from the root; a drive \
            without one is relative.")

fn test_dir_name() //< the folder that contains a path
    //< Caution: **Test a file directly under the root, and the root itself.** The folder of
    //< either is the root; an empty result would name the working directory instead, which a bare
    //< name alone is in.
    verdict.start("[Sys] taking the folder part off a path...")
    paths: U8[][15] = ::{ "dir/a.kspl", "a.kspl", "/a", "/", "/a/b", "C:/a", "C:\\a", "C:/", "\\a",
        "dir/", "C:a", "C:\\x", "a:/b", "C:\\", "\\" }
    // On Windows a drive is part of the root; on POSIX `C:` and `a:` are folders' names.
    on_windows: U8[][15] = ::{ "dir", "", "/", "/", "/a", "C:/", "C:\\", "C:/", "\\", "dir", "",
        "C:\\", "a:/", "C:\\", "\\" }
    on_posix: U8[][15] = ::{ "dir", "", "/", "/", "/a", "C:", "C:", "C:", "\\", "dir", "", "C:",
        "a:", "C:", "\\" }
    win: = sys.is_windows()
    for i in Range.asc(paths.len)
        want: = on_windows[i] if win else on_posix[i]
        assert(sys.get_dir_name(paths[i]).equals(want), "get_dir_name's answer differs")
    verdict
        .pass("a file under the root is in the root, the root is its own folder, and a bare name is \
            in none.")

fn test_share_roots() //< a Windows share, and a path past `\\?\`, as a root
    //< Caution: **Test a file directly in a share.** Its folder is the share; a root cut at the
    //< first separator would make it the server, and a share's parent `\\`.
    verdict.start("[Sys] measuring the root of a share and of a path past `\\\\?\\`...")
    paths: U8[][9] = ::{ "\\\\srv\\sh\\x", "\\\\srv\\sh", "\\\\?\\C:\\x", "\\\\?\\UNC\\srv\\sh\\x",
        "\\\\.\\COM1", "//", "\\\\\\x", "C:\\x", "/x" }
    // On POSIX each opens with a separator, the root `/`, but `C:\x`, a relative name.
    on_windows: Sz[9] = ::{ 9, 8, 7, 15, 8, 1, 1, 3, 1 }
    on_posix: Sz[9] = ::{ 1, 1, 1, 1, 1, 1, 1, 0, 1 }
    win: = sys.is_windows()
    for i in Range.asc(paths.len)
        want: = on_windows[i] if win else on_posix[i]
        assert(sys.root_len(paths[i]) == want, "root_len's answer differs")
    assert(sys.is_absolute("\\\\srv\\sh"), "a share is from the root without a separator after it")
    in_share: U8[] = "\\\\srv\\sh\\" if win else "\\\\srv\\sh"
    assert(sys.get_dir_name("\\\\srv\\sh\\x").equals(in_share), "a file in a share is in the share")
    assert(sys.get_dir_name("\\\\srv\\sh\\").equals(in_share), "a share's root is its own folder")
    share: U8[] = "\\\\srv\\sh" if win else "\\\\srv"
    assert(sys.get_dir_name("\\\\srv\\sh").equals(share),
        "a share named with no separator after it is its own folder")
    arena: = Arena.new(1024)
    defer arena.free()
    assert(fs.join("\\\\srv\\sh", "x", arena).equals("\\\\srv\\sh/x"), "a share takes a separator")
    verdict
        .pass("on Windows a share and what follows `\\\\?\\` are roots; `\\\\` alone is not a \
            share.")

fn test_fs_absolute() //< a relative path joined onto the working directory, nothing collapsed
    verdict.start("[Fs] making a path absolute...")
    arena: = Arena.new(16 * 1024)
    defer arena.free()
    $buf: U8[4096] = ::{}
    here: = sys.cwd(U8$[]::buf) catch panic("the working directory should be readable")
    got: = fs.absolute("a/../b", arena) catch panic("absolute should answer for a relative path")
    assert(got.equals(fs.join(here, "a/../b", arena)), "a relative path is joined as spelled")
    same: = fs.absolute(here, arena) catch panic("absolute should answer for an absolute path")
    assert(same.equals(here), "a path from the root comes back as it was")
    dot: = fs.absolute(".", arena) catch panic("absolute should answer for `.`")
    assert(dot.equals(here), "`.` names the working place")
    // Caution: **Join onto a bare root too**, which is the working place at `/`. No `//` must come
    // of it. On Windows a drive with no separator stays relative to that drive.
    at_root: =
        fs.join("/", "etc", arena).equals("/etc") &&
        fs.join("//", "etc", arena).equals("/etc")
    assert(at_root, "a segment follows a bare root with no second separator")
    drive_want: U8[] = "C:x" if sys.is_windows() else "C:/x"
    drive: = fs.join("C:", "x", arena).equals(drive_want)
    assert(drive, "a drive alone is a root on Windows only, and joining keeps it drive-relative")
    rooted_want: U8[] = "C:\\x" if sys.is_windows() else "C:/x"
    rooted: = fs.join("C:\\", "x", arena).equals(rooted_want)
    assert(rooted, "a drive's root keeps its separator")
    verdict
        .pass("A relative path is joined onto the working place as spelled, `..` left in it, and a \
            bare root takes a segment with no separator added.")

fn test_path_ext()
    verdict.start("[Sys] carving an extension off a path...")
    paths: U8[][10] = ::{ "a.kspl", "dir/a.kspl", ".bashrc", "dir/.bashrc", "dir.v1/name",
        "a.tar.gz", "a.", "", "dir/", "out/prog.new.c" }
    stems: U8[][10] = ::{ "a", "dir/a", ".bashrc", "dir/.bashrc", "dir.v1/name", "a.tar", "a", "",
        "dir/", "out/prog.new" }
    exts: U8[][10] = ::{ ".kspl", ".kspl", "", "", "", ".gz", ".", "", "", ".c" }
    for i in Range.asc(paths.len)
        p: = paths[i]
        assert(sys.strip_last_ext(p).equals(stems[i]), "strip_last_ext's answer differs")
        assert(sys.last_ext(p).equals(exts[i]), "last_ext's answer differs")
        // The round trip: joining them returns to the original path
        round_len: = sys.strip_last_ext(p).len + sys.last_ext(p).len
        assert(round_len == p.len,
            "joining strip_last_ext and last_ext does not return to the original")
    // A double extension is removed by repeating the call (why there is no plural function)
    inner: = sys.strip_last_ext("a.tar.gz")
    assert(sys.last_ext(inner).equals(".tar"), "a double extension must be peelable by repeating")
    verdict
        .pass("a name's leading dot and a dot inside a directory name are not extensions, and it \
            round-trips.")

fn test_wall_clock()
    verdict.start("[Time] the wall clock reads a plausible epoch second...")
    // Only plausibility can be checked: 2020-01-01 to 2100-01-01.
    t: = sys.wall_seconds()
    assert(t >= 1577836800I64 && t < 4102444800I64, "now() should return a plausible epoch second")
    verdict.pass("the wall clock read a second between 2020 and 2100.")

priv fn mark_read_only(dir: U8[], name: U8[], arena: Arena$@): Bool //<
    //< marks a file in dir read-only with the OS's own tool; false where it cannot
    //< Run inside dir with the bare name: Windows's `attrib` reads a `/` as a switch.
    argv: =
        (U8[][]::{ "attrib", "+r", name } if sys.is_windows()
        else U8[][]::{ "chmod", "444", name })
    r: = subproc.run_capture(argv, dir, 20000, 4096, arena) catch
        return false
    return r.exited_with(0)

fn test_fs_read_only(arena: Arena$@) //<
    //< That a read-only file is removed, and replaced by a rename, as on POSIX
    //< POSIX looks at the folder's permission, not the file's; Windows refuses both while the file
    //< carries its read-only mark.
    verdict.start("[Fs] removing a read-only file, and renaming over one...")
    dir: = "out/tmp/kspl_test_fs_read_only"
    fs.mkdir_all(dir) catch panic("mkdir_all should succeed under out/tmp")
    gone: = "out/tmp/kspl_test_fs_read_only/gone.txt"
    kept: = "out/tmp/kspl_test_fs_read_only/kept.txt"
    incoming: = "out/tmp/kspl_test_fs_read_only/incoming.txt"
    io.write_file(gone, "old") catch panic("the file must be writable")
    io.write_file(kept, "old") catch panic("the file must be writable")
    io.write_file(incoming, "new") catch panic("the file must be writable")
    if !mark_read_only(dir, "gone.txt", arena) || !mark_read_only(dir, "kept.txt", arena)
        fs_test.clear_tree_best_effort(dir, arena)
        verdict.skip("this machine has no tool that marks a file read-only")
        return
    $removed: = true
    fs.remove_path(gone) catch
        removed = false
    $renamed: = true
    fs.rename_path(incoming, kept) catch
        renamed = false
    body: = io.read_file_capped(kept, 16, arena) catch
        fallback ""
    fs_test.clear_tree_best_effort(dir, arena)
    assert(removed, "a read-only file is removed")
    assert(renamed && body.equals("new"), "a rename replaces a read-only file")
    verdict.pass("A read-only file is removed, and a rename replaces one, as on POSIX.")

priv const ARGS_BELOW_SRC: U8[] = //< a child that reads the argument before the program's name
    """import "std/io"
import "std/sys"

fn main()
  i: Sz = -1
  io.out().s(sys.args()[i])
"""

fn child_stops_with( //< whether a program run as a child stopped and said why
    //< Caution: **Test a refusal that ends the process this way.** Run here, it would end the
    //< tests; and a crash ends a child too, so the reason must be in what it wrote.
    ksplc: U8[], //< the compiler that runs the child
    name: U8[], //< the child's file name, unique per test
    src: U8[], //< the child's whole program
    why: U8[], //< what its standard error must hold
    arena: Arena$@,
): Bool
    return stops_with(child_argv(ksplc, name, src, arena), why, arena)

fn stops_with( //< whether a child stopped and said why, its argv given whole
    //< A run under Wine passes a child built beforehand, as `ksplc run` needs a C compiler there.
    argv: U8[][], //< the child and its arguments
    why: U8[], //< what its standard error must hold
    arena: Arena$@,
): Bool
    r: = run_to_end(argv, arena)
    return !r.exited_with(0) && r.stderr_data.find_str(why).is_some()

fn run_to_end(argv: U8[][], arena: Arena$@): subproc.Run_result //<
    //< Runs a child and stops the test unless it started and came to an end
    r: = subproc.run_capture(argv, "", 300000, 1 << 20, arena) catch panic("the child must start")
    assert(r.exit_code.is_some(), "the child must start and come to an end")
    return r

fn expect_output( //< stops the test unless a child put out `want` and ended on `want_code`
    r: subproc.Run_result,
    what: U8[], //< names the child in the message
    want: U8[], //< all it should put out on standard output
    want_code: I32,
    arena: Arena$@,
)
    // A child's standard output is text mode on Windows, so its lines arrive as CRLF.
    got: = r.stdout_data.replace("\r\n", "\n", arena)
    if got.equals(want) && r.exited_with(want_code)
        return
    panic(U8$[]::arena.text().s(what).s(" put out\n").s(got)
        .s("and ended on \{r.exit_code.unwrap_or(-1)\}, where it should put out\n").s(want)
        .s("and end on \{want_code\}\n").s(r.stderr_data).take())

fn test_args_index_refused(ksplc: U8[], arena: Arena$@) //< ksplc runs the child
    verdict.start("[Sys] an argument read below index 0...")
    // Without the refusal the read lands before `argv`, and the child crashes with nothing said.
    named: =
        child_stops_with(ksplc, "args_below", ARGS_BELOW_SRC, "args: index out of bounds", arena)
    assert(named, "a negative index must stop the program with the reason, not crash it")
    verdict.pass("an index below 0 is refused as out of bounds, as one past the end is.")

fn test_can_run() //< that the answer to "can it be started" is correct per environment
    //< **Using `is_executable` for "can it be started" is always false on Windows.** Windows has no
    //< execute bit, so code that uses it unchanged can start nothing, on Windows only (a language
    //< server would never start there). This test pins that "decided by the extension" and "decided
    //< by the execute bit" agree in both environments.
    verdict.start("[Fs] the answer to whether it can be started is correct per environment...")
    dir: = "out/tmp/kspl_test_can_run"
    fs.remove_path("out/tmp/kspl_test_can_run/tool.exe") catch {}
    fs.remove_path("out/tmp/kspl_test_can_run/note.txt") catch {}
    fs.remove_path(dir) catch {}
    fs.mkdir(dir) catch panic("mkdir should succeed for a fresh path")
    exe: = "out/tmp/kspl_test_can_run/tool.exe"
    txt: = "out/tmp/kspl_test_can_run/note.txt"
    io.write_file(exe, "MZ") catch panic("write_file should succeed")
    io.write_file(txt, "hi") catch panic("write_file should succeed")
    // **An absent path and a folder cannot be started in either environment.**
    assert(!fs.can_run("out/tmp/kspl_test_can_run/nope.exe"), "an absent path cannot be started")
    assert(!fs.can_run(dir), "a folder cannot be started")
    // Caution: **If a file just written already has the bit, the filesystem set it, not this code**
    // (it was created 0666 under the umask). A Windows folder mounted into Docker, or any mount
    // without POSIX permissions, marks every file executable. So "without the bit" cannot be set
    // up.
    bitless: = sys.is_windows() || !fs.is_executable(exe)
    if sys.is_windows()
        // **The extension decides**; there is no execute bit.
        assert(fs.can_run(exe), "on Windows a .exe can be started")
        assert(!fs.can_run(txt), "on Windows a .txt cannot be started")
        assert(!fs.is_executable(exe), "Windows has no execute bit")
    else if bitless
        // **The bit decides**, not the extension.
        assert(!fs.can_run(exe), "on POSIX, even named .exe it cannot be started without the bit")
        assert(fs.can_run("/bin/sh") || !fs.exists("/bin/sh"),
            "on POSIX a path with the bit set can be started")
    fs.remove_path(exe) catch {}
    fs.remove_path(txt) catch {}
    fs.remove_path(dir) catch {}
    if !bitless
        verdict.skip("this filesystem marks every new file executable (no POSIX permissions)")
        return
    verdict
        .pass("whether it can be started is decided by the extension on Windows and by the execute \
            bit on POSIX.")

// ==========================================
// std/sys: run_capture's result for a clean exit, stdout apart from stderr, a non-zero exit code,
// a kill on timeout, and an absent executable.
// ==========================================
priv const FINISH_CAP_MS: I32 = 60000 //< the cap on a child that must finish of itself
    //< Generous, as only a stalled child reaches it; one that ends returns at once.

fn test_run_capture(arena: Arena$@)
    verdict.start("[Sys] running a subprocess (run_capture)...")
    // /bin/echo and the like exist only on POSIX, so Windows skips this (the windows-lsp job covers
    // kspl_proc_start there).
    if sys.is_windows()
        verdict
            .skip("it depends on POSIX-specific executable paths such as /bin/echo, so native \
                Windows is out of scope")
        return

    ok_argv: = U8[][]::{ "/bin/echo", "hello", "kspl" }
    ok: = subproc.run_capture(ok_argv, "", FINISH_CAP_MS, 65536, arena)
        catch panic("echo should spawn")
    assert(ok.exit_code.is_some(), "echo should spawn and finish normally")
    assert(ok.exited_with(0), "echo should exit with status 0")
    assert(ok.stdout_data.equals("hello kspl\n"), "echo stdout should be captured verbatim")
    assert(ok.stderr_data.len == 0, "echo should produce no stderr output")

    split_argv: = U8[][]::{ "/bin/sh", "-c", "echo out_line; echo err_line 1>&2; exit 3" }
    split: = subproc.run_capture(split_argv, "", FINISH_CAP_MS, 65536, arena)
        catch panic("the child must start")
    assert(split.exited_with(3), "nonzero exit code must be propagated verbatim")
    split_ok: =
        split.stdout_data.equals("out_line\n") && split.stderr_data.equals("err_line\n")
    assert(split_ok, "stdout/stderr must never be mixed up with each other")

    // /bin/pwd resolves symbolic links, and macOS's /tmp is one to /private/tmp, so the cwd is "/",
    // which is never a link.
    cwd_argv: = U8[][]::{ "/bin/pwd" }
    cwd_r: = subproc.run_capture(cwd_argv, "/", FINISH_CAP_MS, 65536, arena)
        catch panic("the child must start")
    cwd_ok: = cwd_r.stdout_data.equals("/\n")
    assert(cwd_ok, "cwd override must change the child's working directory")

    // What it wrote, as one text: standard output, then standard error, each `\r\n` folded to `\n`.
    mixed_argv: = U8[][]::{ "/bin/sh", "-c", "printf 'a\\r\\nb\\r'; printf 'e\\r\\n' 1>&2" }
    mixed: = subproc.run_capture(mixed_argv, "", FINISH_CAP_MS, 65536, arena)
        catch panic("the child must start")
    assert(mixed.text(arena).equals("a\nb\re\n"),
        "text folds each \\r\\n, keeps a lone \\r, and lays standard error after standard output")

    slow_argv: = U8[][]::{ "/bin/sh", "-c", "sleep 2" }
    slow: = subproc.run_capture(slow_argv, "", 150, 65536, arena)
        catch panic("the child must start")
    assert(slow.exit_code.is_none(), "a process exceeding timeout_ms must be reported as timed_out")

    // Caution: **Do not start a process when an argument contains a NUL.** The C side splits there,
    // adding an argument nobody wrote (`--INJECTED`) and losing the last (`should-be-last`).
    inject_argv: = U8[][]::{ "/bin/echo", "a\0--INJECTED", "should-be-last" }
    assert(subproc.run_capture(inject_argv, "", FINISH_CAP_MS, 4096, arena).is_err(),
        "an argument containing NUL must be refused, not silently split")
    // An empty argument is legitimate and goes through.
    empty_arg_argv: = U8[][]::{ "/bin/echo", "", "x" }
    empty_arg: =
        subproc.run_capture(empty_arg_argv, "", FINISH_CAP_MS, 65536, arena)
        catch panic("an empty argument must not stop the start")
    empty_ok: = empty_arg.stdout_data.equals(" x\n")
    assert(empty_ok, "an empty argument is legitimate and must still be passed through")

    verdict
        .pass("confirmed a clean exit, stream separation, a non-zero exit, a timeout, and the \
            refusal of a NUL mixed into an argument.")

// ==========================================
// std/sys: starting in parallel and gathering the output (run_many).
// Caution: **Check that the results are in input order.** The slow one is placed first.
// **Check that it really runs in parallel too**; one at a time gives the same output.
// ==========================================
fn test_run_many(arena: Arena$@)
    verdict.start("[Sys] starting in parallel and gathering the output (run_many)...")
    if sys.is_windows()
        verdict.skip("it hands over POSIX-specific executable paths")
        return
    work: = "out/tmp/kspl_test_run_many"
    fs.mkdir_all(work) catch {}
    // In finishing order, [0] would move to the back.
    jobs: = Job[]::{
        Job::{ .argv = U8[][]::{ "/bin/sh", "-c", "sleep 0.2; echo slow" }, .cwd = "" },
        Job::{ .argv = U8[][]::{ "/bin/echo", "quick" }, .cwd = "" },
        Job::{ .argv = U8[][]::{ "/bin/sh", "-c", "echo oops 1>&2; exit 3" }, .cwd = "" },
    }
    rs: = subproc.run_many(jobs, 3, verdict.DEFAULT_TIMEOUT_MS, 4096, work, arena)
    assert(rs.len == 3, "the count is the same as the input's")
    slow: = rs.get(0) catch panic("the slow job must start")
    quick: = rs.get(1) catch panic("the quick job must start")
    oops: = rs.get(2) catch panic("the failing job must start")
    assert(slow.stdout_data.trim_end().equals("slow"),
        "even for the slow one the order stays the input's")
    assert(quick.stdout_data.trim_end().equals("quick"), "the second item")
    assert(oops.exited_with(3), "the exit code can be obtained")
    assert(oops.stderr_data.trim_end().equals("oops"), "standard error is separate")
    assert(oops.stdout_data.len == 0, "they are not mixed")

    mixed: = Job[]::{
        Job::{ .argv = U8[][]::{ "kspl_test_missing_parallel_program" }, .cwd = "" },
        Job::{ .argv = U8[][]::{ "/bin/echo", "after" }, .cwd = "" },
    }
    recovered: = subproc.run_many(mixed, 0, verdict.DEFAULT_TIMEOUT_MS, 3, work, arena)
    $missing: = false
    _lost: = recovered.get(0) catch
        missing = true
    assert(recovered.len == 2 && missing, "a failed start keeps its result and consumes no slot")
    after: = recovered.get(1) catch panic("the job after a failed start must start")
    assert(after.exited_with(0) && after.stdout_data.equals("aft"),
        "a zero slot count runs serially and keeps the output cap after a failed start")
    empty: = subproc.run_many(Job[]::{}, 1, verdict.DEFAULT_TIMEOUT_MS, 16, work, arena)
    assert(empty.len == 0, "no jobs give no results")

    // Each child waits for all three arrival files. With fewer than three live children,
    // one must time out: elapsed-time ratios cannot decide this on a busy runner.
    barrier: = fs.mkdir_unique(work, "overlap_", arena) catch panic("make the barrier folder")
    script: =
        "touch \"$1/$2\" || exit 1; while ! { test -f \"$1/a\" && test -f \"$1/b\" && test -f \
            \"$1/c\"; }; do sleep 0.02; done"
    waits: = Job[]::{
        Job::{ .argv = U8[][]::{ "/bin/sh", "-c", script, "overlap", barrier, "a" }, .cwd = "" },
        Job::{ .argv = U8[][]::{ "/bin/sh", "-c", script, "overlap", barrier, "b" }, .cwd = "" },
        Job::{ .argv = U8[][]::{ "/bin/sh", "-c", script, "overlap", barrier, "c" }, .cwd = "" },
    }
    overlapping: = subproc.run_many(waits, 3, 30000, 16, work, arena)
    for name in U8[][]::{ "a", "b", "c" }
        fs.remove_path(fs.join(barrier, name, arena)) catch {}
    fs.remove_path(barrier) catch {}
    for i in Range.asc(3)
        child: = overlapping.get(i) catch panic("each barrier child must start")
        assert(child.exited_with(0), "all three jobs run before any waits for another to finish")

    // A job past its limit is killed with what it wrote by then, and the one behind it still
    // answers. Caution: **Keep the sleep far beyond the limit**, so waiting it out shows as time.
    stuck: = Job[]::{
        Job::{ .argv = U8[][]::{ "/bin/sh", "-c", "echo begun; exec sleep 30" }, .cwd = "" },
        Job::{ .argv = U8[][]::{ "/bin/echo", "after" }, .cwd = "" },
    }
    t2: = sys.mono_us()
    // Long enough for the shell to start and print on a slow runner; the job sleeps far longer.
    cut: = subproc.run_many(stuck, 1, 3000, 4096, work, arena)
    assert(sys.mono_us() - t2 < 10000000I64, "the stuck job is killed at its limit")
    stuck_run: = cut.get(0) catch panic("the stuck job must start")
    behind: = cut.get(1) catch panic("the job behind it must start")
    assert(stuck_run.exit_code.is_none(), "it comes back with no code, stopped at its limit")
    assert(stuck_run.stdout_data.trim_end().equals("begun"), "with what it wrote by then")
    assert(behind.exit_code.is_some() && behind.stdout_data.trim_end().equals("after"),
        "the job behind it still runs")
    verdict
        .pass("confirmed the order stays the input's, the streams are separate, three jobs overlap, \
            and a job past its limit is killed.")

// ==========================================
// std/sys: run returns standard output unchanged and throws each of the three failures as its own
// variant. **The output is not processed**: dropping the trailing newline would silently break
// output whose end carries meaning.
// ==========================================
fn test_run(arena: Arena$@)
    verdict.start("[Sys] running a subprocess (run)...")
    if sys.is_windows()
        verdict.skip("it depends on POSIX-specific executable paths")
        return

    ok_argv: = U8[][]::{ "/bin/echo", "hello" }
    out: = subproc.run(ok_argv, "", FINISH_CAP_MS, 65536, arena) catch
        fallback ""
    assert(out.equals("hello\n"), "run must return stdout verbatim, trailing newline included")

    fail_argv: = U8[][]::{ "/bin/sh", "-c", "echo why 1>&2; exit 7" }
    $code: I32 = 0
    $err: U8[] = ""
    subproc.run(fail_argv, "", FINISH_CAP_MS, 65536, arena) catch e
        switch e
        case .exited(c, m)
            code = c
            err = m
        default
            panic("a nonzero exit must arrive as Run_error.exited")
        fallback ""
    assert(code == 7, "Run_error.exited must carry the child's exit code")
    assert(err.equals("why\n"), "Run_error.exited must carry the child's stderr")

    slow_argv: = U8[][]::{ "/bin/sh", "-c", "sleep 2" }
    $timed: = false
    subproc.run(slow_argv, "", 150, 65536, arena) catch e
        switch e
        case .timed_out
            timed = true
        default {}
        fallback ""
    assert(timed, "exceeding timeout_ms must arrive as Run_error.timed_out")

    gone_argv: = U8[][]::{ "/bin/echo", "a\0--INJECTED" }
    $spawn_failed: = false
    subproc.run(gone_argv, "", FINISH_CAP_MS, 65536, arena) catch e
        switch e
        case .spawn_failed
            spawn_failed = true
        default {}
        fallback ""
    assert(spawn_failed, "a refused argv must arrive as Run_error.spawn_failed")

    verdict.pass("success gives the output as it stands, and a failure splits into three variants.")

// ==========================================
// std/subproc: a child that cannot start is a failed start on every OS, not an exit code. On POSIX
// the fork succeeds and the failure comes after it, so a 127 here would be indistinguishable from a
// program that exits 127.
// ==========================================
fn test_start_failures(ksplc: U8[], arena: Arena$@) //< ksplc is a program that exists
    verdict.start("[Sys] a child that cannot start is a failed start...")
    dir: = "out/tmp/kspl_test_start_failures"
    fs.mkdir_all(dir) catch panic("mkdir_all should succeed under out/tmp")
    unnamed: = U8[][]::{ "kspl_no_such_program" }
    assert(subproc.run_capture(unnamed, "", FINISH_CAP_MS, 4096, arena).is_err(),
        "a name PATH does not hold must be a failed start")
    absent: = fs.join(dir, "absent", arena)
    assert(subproc.run_capture(U8[][]::{ absent }, "", FINISH_CAP_MS, 4096, arena).is_err(),
        "a path naming no file must be a failed start")
    no_dir: = fs.join(dir, "no_such_dir", arena)
    in_no_dir: = U8[][]::{ ksplc, "info", "keywords" }
    assert(subproc.run_capture(in_no_dir, no_dir, FINISH_CAP_MS, 4096, arena).is_err(),
        "a working directory that does not exist must be a failed start")
    $thrown: = false
    _code: = subproc.spawn_wait(U8[][]::{ absent }, "") catch
        thrown = true
        fallback 0
    assert(thrown, "spawn_wait must throw spawn_failed for a program that is not there")
    verdict
        .pass("a missing program, a missing path and a missing working directory fail the start.")

// ==========================================
// std/subproc: a relative program path with a directory part is read from the child's working
// directory on every OS. The test's own directory is not ksplc's, so read from it the path names
// nothing and the start fails.
// ==========================================
fn test_relative_program_with_cwd(ksplc: U8[], arena: Arena$@) //< ksplc is the child
    verdict.start("[Sys] a relative program path is read from the working directory given...")
    full: = fs.absolute(ksplc, arena) catch panic("the compiler's path must be made absolute")
    dir: = sys.get_dir_name(full)
    $k: = dir.len
    for k < full.len && sys.is_path_sep(full[k])
        k += 1
    rel: = arena.text().s(".").c(full[dir.len]).s(full.sub_from(k)).take()
    r: =
        subproc.run_capture(U8[][]::{ rel, "info", "keywords" }, dir, 60000, 4096, arena) catch
        panic("a relative program path must be read from the working directory given")
    assert(r.exited_with(0) && r.stdout_data.len > 0, "the program found there must run")
    verdict.pass("./<program> with a working directory runs the program in that directory.")

// ==========================================
// std/subproc: how a child ended is one code on every OS. A crash and a panic are 128 + the
// signal POSIX raises (Windows reports them as its own codes). An exit(3) stays 3, though msvcrt's
// abort() also exits 3. Windows's exit(-1), once an "unfinished" sentinel, reads as finished.
// ==========================================
priv const CRASH_SRC: U8[] = //< a child that writes through a pointer to nothing it owns
    """fn main()
  p: I32$@ = I32$@::(Sz::16)
  p$ = 1
"""
priv const ABORT_SRC: U8[] = //< a child that panics, which ends in `abort()`
    """fn main()
  panic("the child stops here")
"""
priv const EXIT_THREE_SRC: U8[] = //< a child that exits 3 of its own accord
    """import "std/sys"

fn main()
  sys.exit(3)
"""
priv const EXIT_MINUS_ONE_SRC: U8[] = //< a child that exits -1
    """import "std/sys"

fn main()
  sys.exit(-1)
"""

fn ran_to_zero(argv: U8[][], arena: Arena$@): Bool //< whether the tool started and ended with 0
    r: = subproc.run_capture(argv, "", 60000, 4096, arena) catch
        return false
    return r.exited_with(0)

fn child_argv(ksplc: U8[], name: U8[], src: U8[], arena: Arena$@): U8[][] //<
    //< Writes a child's program and returns the argv that runs it with `ksplc run`
    argv: = List<|U8[]|>.create(arena)
    argv.push(ksplc)
    argv.push("run")
    argv.push(child_path(name, src, arena))
    return argv.slice()

fn child_path(name: U8[], src: U8[], arena: Arena$@): U8[] //<
    //< Writes a child's program and returns its path; `name` is unique per child
    dir: = "out/tmp/kspl_test_child"
    fs.mkdir_all(dir) catch panic("mkdir_all should succeed under out/tmp")
    path: = fs.join(dir, arena.text().s(name).s(".kspl").take(), arena)
    io.write_file(path, src) catch panic("the child must be writable")
    return path

fn expect_endings( //< runs the four children and checks how each one ended
    //< The argvs are given whole, so a run under Wine can pass children built beforehand.
    crash: U8[][],
    abort: U8[][],
    exit_three: U8[][],
    exit_minus_one: U8[][],
    arena: Arena$@,
)
    c: = subproc.run_capture(crash, "", 300000, 1 << 16, arena)
        catch panic("the crashing child must start")
    assert(c.exit_code.is_some(), "the crashing child must start and come to an end")
    assert(c.exited_with(139), "a crash must read as 128 + SIGSEGV on every OS")
    a: = subproc.run_capture(abort, "", 300000, 1 << 16, arena)
        catch panic("the aborting child must start")
    assert(a.exit_code.is_some(), "the aborting child must start and come to an end")
    assert(a.exited_with(134), "a panic must read as 128 + SIGABRT on every OS")
    three: = subproc.run_capture(exit_three, "", 300000, 1 << 16, arena)
        catch panic("the child exiting 3 must start")
    assert(three.exit_code.is_some(), "the child exiting 3 must start and end")
    assert(three.exited_with(3), "an exit(3) must read as 3 on every OS, not as an abort")
    $child: = subproc.spawn_piped(exit_minus_one, "") catch panic("the child must start")
    deadline: = sys.mono_us() + 300000000I64
    $code: I32 = 0
    $ended: = false
    for !ended && sys.mono_us() < deadline
        if got: = child.exit_code()
            code = got
            ended = true
        else
            sys.sleep_ms(10)
    child.kill()
    assert(ended, "a child that exits -1 must read as finished")
    assert(code == (-1 if sys.is_windows() else 255), "exit(-1) must keep the code the OS gives it")

fn test_exit_codes(ksplc: U8[], arena: Arena$@) //< ksplc runs the children
    verdict.start("[Sys] a crash, a panic, exit(3) and exit(-1) end with one code on every OS...")
    expect_endings(child_argv(ksplc, "crash", CRASH_SRC, arena),
        child_argv(ksplc, "abort", ABORT_SRC, arena),
        child_argv(ksplc, "exit_three", EXIT_THREE_SRC, arena),
        child_argv(ksplc, "exit_minus_one", EXIT_MINUS_ONE_SRC, arena), arena)
    verdict
        .pass("a crash is 139, a panic 134, exit(3) 3, and a child exiting -1 reads as finished.")

// ==========================================
// std/io: a file open when a child starts is not handed to it. Holding a copy, the child would keep
// the file open for as long as it runs (and on Windows, unremovable).
// ==========================================
fn test_child_holds_no_file(ksplc: U8[], arena: Arena$@) //<
    //< ksplc is the child on Windows (`ksplc lsp` lives until its standard input closes)
    verdict.start("[Sys] a child started while a file is open does not hold it...")
    fs.mkdir_all("out/tmp/kspl_test_child_file") catch panic("the work directory must be creatable")
    path: = "out/tmp/kspl_test_child_file/held.txt"
    $file: = io.open(path, "wb") catch panic("the file must open for writing")
    if sys.is_windows()
        // The CRT opens a file without FILE_SHARE_DELETE, so a handle the child held refuses this.
        $child: = subproc.spawn_piped(U8[][]::{ ksplc, "lsp" }, "")
            catch panic("the child must start")
        file.free()
        $removed: = true
        fs.remove_path(path) catch
            removed = false
        child.close_stdin()
        child.kill()
        assert(removed, "a file closed while a child started before runs can be removed")
    else if fs.exists("/proc/self/fd")
        listing: =
            subproc.run_capture(U8[][]::{ "/bin/sh", "-c", "ls -l /proc/self/fd" }, "", 5000, 65536,
            arena) catch panic("the child must start")
        file.free()
        assert(listing.exited_with(0), "the child must list its open files")
        assert(listing.stdout_data.find_str("held.txt").is_none(),
            "a child does not hold a file it was not handed")
    else
        file.free()
        verdict
            .skip("this OS has neither Windows's sharing check nor /proc to look into a child with")
        return
    verdict.pass("A child started while a file was open does not hold it.")

// ==========================================
// std/fs: a FIFO is told from a regular file. Here, not in `fs_test.kspl`, as making one starts
// a child (`mkfifo`).
// ==========================================
fn test_fs_stat_fifo() //<
    //< A FIFO's metadata reports neither a file nor a directory
    //< **Served or copied as a file, its read waits for a writer that can never come.**
    verdict.start("[Fs] stat tells a FIFO from a regular file...")
    if sys.is_windows()
        verdict.skip("Windows has no FIFO a path names")
        return
    fifo: = "out/tmp/kspl_test_fs_fifo"
    fs.remove_path(fifo) catch {}
    arena: = Arena.new(4096)
    defer arena.free()
    made: =
        subproc.run_capture(U8[][]::{ "mkfifo", fifo }, "", 10000, 4096, arena)
        catch panic("mkfifo must start")
    assert(made.exited_with(0), "mkfifo should make a FIFO under out/tmp")
    info: = fs.stat(fifo) catch panic("stat should succeed for a FIFO")
    assert(info.kind == fs.File_kind.other, "a FIFO's metadata should report neither kind")
    assert(!fs.is_dir(fifo), "a FIFO is no directory")
    fs.remove_path(fifo) catch panic("a FIFO should be removable")
    verdict.pass("stat reports a FIFO as neither a regular file nor a directory.")

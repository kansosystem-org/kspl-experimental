//< Every std function that takes an arena, called with `null`: it works on the heap instead
//<
//< **`make test-conventions` holds each such function to a call with `null` in std's tests**, most
//< of them here. Where the summary says how to free the result, the test checks the heap after
//< that free. The heap must come back to where it stood, so neither the result nor the work
//< behind it is lost.
import "std/argp"
import "std/base64"
import "std/ds" { List, Map }
import "std/fs"
import "std/fuzz"
import "std/http"
import "std/io"
import "std/json" + { Json_builder }
import "std/json_struct"
import "std/jsonrpc"
import "std/mem" + { Arena, dealloc }
import "std/rand"
import "std/reflect"
import "std/regex" { Regex }
import "std/seq"
import "std/str" + { Str_builder }
import "std/subproc"
import "std/sys"
import "std/url"
import "std/verdict"

// The arena here is null, so what it hands out is heap memory, which `dealloc` frees. [W0104]
// (a pointer an arena handed out reaching `dealloc`) cannot see that the arena is null.
##lint(W0104 = off)

priv struct Null_probe //< a struct `into_struct` fills from JSON
    name: U8[]
    count: I64

// The table is written out: a second file holding a table ksplc builds loses the first one's.
priv const probe_fields: reflect.Field_info[2] = ::{::{ .name = "name",
    .offset = offsetof(Null_probe, name), .kind = .str_field },
    ::{ .name = "count", .offset = offsetof(Null_probe, count), .kind = .int_field,
    .extra = ::{ .width = sizeof(I64) } } }

impl Null_probe: reflect.Reflectable
    fn fields(_r: Self): reflect.Field_info[]
        return reflect.Field_info[]::probe_fields

priv struct Name_list //< a struct whose one field is a list of strings
    names: List<|U8[]|>

priv const name_list_fields: reflect.Field_info[1] = ::{::{ .name = "names",
    .offset = offsetof(Name_list, names), .kind = .list_field,
    .extra = ::{ .elem = .str_field, .elem_size = sizeof(U8[]) } } }

impl Name_list: reflect.Reflectable
    fn fields(_r: Self): reflect.Field_info[]
        return reflect.Field_info[]::name_list_fields

priv fn freed(s: U8[]) //< gives back one block a null arena handed out
    dealloc(Void$@::s.ptr)

priv fn freed_all(xs: List<|U8[]|>$@) //< gives back a list of strings, each a block of its own
    for s in xs.slice()
        freed(s)
    xs.free()

priv fn back_to(before: Sz, what: U8$[]) //< checks that the heap came back to where it stood
    assert(mem.heap_used_bytes() == before, what)

fn test_null_arena_hands_out_heap() //< the arena's own handouts, the one place null is decided
    verdict.start("[mem] a null arena hands out heap memory test...")
    none: Arena$@ = null
    before: = mem.heap_used_bytes()
    p: = U8$@::none.alloc(16)
    p$ = 7U8
    dealloc(Void$@::p)
    copy: = none.dup_str("kept")
    assert(copy.equals("kept"), "dup_str copies onto the heap")
    freed(copy)
    built: = none.text().s("a").c('b').take()
    assert(built.equals("ab"), "text builds on the heap")
    freed(built)
    one: = none.create(7)
    assert(one$ == 7, "create writes the value on the heap")
    dealloc(Void$@::one)
    // A list `create` placed on the heap: `free()` gives back its elements, `dealloc` its block.
    xs: = List<|I32|>.create(null)
    xs.push(1)
    xs.free()
    dealloc(Void$@::xs)
    back_to(before, "alloc, dup_str, text and create hand back all they took")
    verdict.pass("A null arena takes from the heap, and what it handed out frees to nothing.")

fn test_null_arena_text_and_bytes() //< the functions that return one block of text or bytes
    verdict.start("[std] null as the arena for one string or byte run test...")
    before: = mem.heap_used_bytes()
    $parts: = "a,b".split(',', null)
    joined: = "-".join(parts, null)
    assert(joined.equals("a-b"), "join on the heap")
    freed(joined)
    parts.free()
    $lines: = "x\ny".lines(null)
    assert(lines.len == 2, "lines on the heap")
    lines.free()
    swapped: = "aXa".replace("X", "b", null)
    freed(swapped)
    plain: = "a\\tb".unescape_to_arena(null) catch panic("a good escape is read")
    assert(plain.equals("a\tb"), "unescape on the heap")
    freed(plain)
    _bad: = "a\\q".unescape_to_arena(null) catch "refused"
    enc: = base64.encode("hi", null)
    dec: = base64.decode(enc, null) catch panic("its own encoding decodes")
    assert(dec.equals("hi"), "base64 round trip on the heap")
    freed(enc)
    freed(dec)
    _bad64: = base64.decode("!!", null) catch "refused"
    u: = url.encode("a b", null)
    ud: = url.decode_component(u, null) catch panic("its own encoding decodes")
    assert(ud.equals("a b"), "url round trip on the heap")
    freed(u)
    freed(ud)
    noise: = rand.bytes(8, null) catch panic("the OS gives random bytes")
    freed(noise)
    path: = fs.join("a", "b", null)
    freed(path)
    full: = fs.absolute("x", null) catch panic("the working directory is readable")
    freed(full)
    back_to(before, "every one-block result frees with dealloc, a failure leaving nothing")
    verdict.pass("Text and bytes made with a null arena free with dealloc, and leave nothing else.")

fn test_null_arena_lists() //< the functions that return a list, which frees with `free()`
    verdict.start("[std] null as the arena for lists test...")
    before: = mem.heap_used_bytes()
    arr: = json.parse("[1,2]", null) catch panic("an array parses")
    $m: = Map<|I32, I32|>.new(null)
    m.set(1, 1)
    m.free()
    $m2: = Map<|I32, I32|>.new_with_cap(8, null)
    m2.free()
    $nums: = List<|I32|>.new_with_cap(4, null)
    for n in Range.asc(5)
        nums.push(I32::n)
    $odd: = nums.where(fn(n: I32@; ): Bool {
        return n$ % 2 == 1;
    }).to_list(null)
    $twice: = nums.select(fn(n: I32; ): I32 {
        return n * 2;
    }).to_list(null)
    $once: = nums.distinct(fn(a: I32@, b: I32@; ): Bool {
        return a$ == b$;
    }, null)
    $sorted: = nums.order_by(fn(a: I32@, b: I32@; ): I32 {
        return b$ - a$;
    }, null)
    $head: = nums.take(2, null)
    $tail: = nums.skip(2, null)
    assert(odd.len == 2 && twice.get(4) == 8 && once.len == 5 && sorted.get(0) == 4,
        "the chain's lists come out on the heap")
    assert(head.len == 2 && tail.len == 3, "take and skip on the heap")
    odd.free()
    twice.free()
    once.free()
    sorted.free()
    head.free()
    tail.free()
    nums.free()
    rx: = Regex.compile("b") catch panic("the pattern compiles")
    $hits: = rx.find_all("abcb", null)
    assert(hits.len == 2, "find_all on the heap")
    hits.free()
    rx.free()
    $items: = arr.val.arr_list(null)
    assert(items.len == 2, "arr_list on the heap")
    items.free()
    arr.free()
    back_to(before, "every list frees with free(), and the work behind it is gone")
    verdict.pass("Lists made with a null arena free with free(), and leave nothing else.")

fn test_null_arena_json() //< a JSON document, and a builder, free with their own `free()`
    verdict.start("[json] null as the arena for a value of many blocks test...")
    before: = mem.heap_used_bytes()
    doc: = json.parse("{\"a\":[1,\"x\",{\"b\":null}],\"c\":\"d\"}", null) catch
        panic("an object parses")
    assert(doc.val.get("a").get_at(1).as_str().unwrap_or("").equals("x") &&
        doc.val.get("c").as_str().unwrap_or("").equals("d"),
        "a document parsed with a null arena reads")
    doc.free()
    back_to(before, "a parsed document frees all of itself")
    top: = json.parse("\"s\"", null) catch panic("a lone string parses")
    assert(top.val.as_str().unwrap_or("").equals("s"), "a lone string on the heap")
    top.free()
    n: = json.parse("7", null) catch panic("a lone number parses")
    n.free()
    _cut: = json.parse("[1,{\"x\":[true", null) catch {}
    _extra: = json.parse("{\"a\":\"b\"} 2", null) catch {}
    back_to(before, "a lone string frees too, and a failed parse leaves nothing")

    $b: = Json_builder.new(null)
    obj: = b.obj().set("name", b.str_val("n")).set("count", b.int_val(2)).build()
    $probe: Null_probe = ::{ .name = "", .count = 0 }
    json_struct.into_struct(obj, probe@, null) catch panic("the object fits the struct")
    assert(probe.name.equals("n") && probe.count == 2I64, "into_struct with a null arena")
    freed(probe.name)
    b.free()
    back_to(before, "a builder given null frees every value it made")
    verdict.pass("A JSON document and a builder made with a null arena free all they made.")

fn test_json_doc_val_switch() //<
    //< a document's value is switched over with each variant's own field
    verdict.start("[json] a switch over a document's value test...")
    before: = mem.heap_used_bytes()
    $seen: = 0
    for text in U8[][]::{ "\"s\"", "[1]", "{\"k\":2}" }
        doc: = json.parse(text, null) catch panic("each kind parses")
        defer doc.free()
        switch doc.val
        case .str_val(s)
            seen += 1 if s.equals("s") else 0
        case .array_val(a)
            seen += (1
                if json.Val.array_val(a).get_at(0).as_int().unwrap_or(0) == 1 else 0)
        case .obj_val(o)
            seen += (1
                if json.Val.obj_val(o).get("k").as_int().unwrap_or(0) == 2 else 0)
        default {}
    assert(seen == 3, "each variant binds its one field")
    back_to(before, "each document frees at the end of its turn")
    verdict.pass("A switch over a document's value binds each variant's one field.")

fn test_null_arena_refused_list() //<
    //< a list refused part way frees with the cleanup `into_struct` documents
    verdict.start("[json] a list into_struct refused part way, freed as documented test...")
    before: = mem.heap_used_bytes()
    doc: = json.parse("{\"names\":[\"a\",1,\"c\"]}", null) catch panic("the fixture parses")
    $out: Name_list = ::{}
    $refused: = false
    json_struct.into_struct(doc.val, out@, null) catch
        refused = true
    assert(refused, "an element of another kind refuses the list")
    // **The elements past the refusal are not counted**: their memory holds nothing written.
    assert(out.names.len == 2 && out.names[0].equals("a") && out.names[1].len == 0,
        "a refused list counts what was written, the refused element zeroed")
    freed_all(out.names@)
    doc.free()
    back_to(before, "a refused list frees with each string, then the list")
    verdict.pass("A list refused part way holds only what was written, and frees as documented.")

priv fn query_refused(text: U8[]): Bool //< whether `parse_query` refuses text, freeing what it took
    $q: = url.parse_query(text, null) catch
        return true
    q.free()
    return false

fn test_null_arena_messages() //< a query, headers, a message and a parser free with `free()`
    verdict.start("[std] null as the arena for a query, headers, a message and a parser test...")
    before: = mem.heap_used_bytes()
    $q: = url.parse_query("a=1&b=2", null) catch panic("a query parses")
    assert(q.find("b").unwrap_or("").equals("2"), "parse_query with a null arena")
    q.free()
    assert(query_refused("a=1&b=%zz"), "a broken escape is refused")
    $none: = url.parse_query("", null) catch panic("an empty query parses")
    assert(none.is_empty(), "an empty query holds no pair")
    none.free()
    back_to(before, "a query frees with free(), and a refused one leaves nothing")
    $head_only: = http.headers(null).add("Host", "h").add("Accept", "*/*").build()
    assert(head_only.find("Host").unwrap_or("").equals("h"), "headers with a null arena")
    head_only.free()
    back_to(before, "headers built with null free with free()")
    src: = "GET / HTTP/1.1\r\nHost: h\r\nAccept: */*\r\n\r\n"
    req: = http.parse_request(src, 0, null) catch panic("a request parses")
    assert(req.method.equals("GET"), "parse_request with a null arena")
    req.headers.free() // a message's headers are the message's
    assert(req.headers.find("Accept").is_some(), "freeing a message's headers frees nothing")
    req.free()
    _part: = http.parse_request("GET / HTTP/1.1\r\nHost: h\r\n", 0, null) catch null
    two_hosts: = "GET / HTTP/1.1\r\nHost: h\r\nHost: i\r\n\r\n"
    _bad: = http.parse_request(two_hosts, 0, null) catch null
    resp: =
        http.parse_response("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", null) catch
        panic("a response parses")
    assert(resp.status == 200, "parse_response with a null arena")
    resp.free()
    short_body: = "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nab"
    _short: = http.parse_response(short_body, null) catch null
    back_to(before, "a message frees with free(), and a refused one leaves nothing")
    p: = argp.Parser.create("probe", "a null arena", null)
    p.positional("[anything]")
    $flag: = false
    p.flag("--on", flag@, "a flag")
    p.free()
    back_to(before, "a parser frees with free()")
    verdict.pass("A query, headers, a message and a parser made with a null arena free all of it.")

fn test_null_arena_work_is_freed() //< a function frees the work it does not return
    verdict.start("[std] null as the arena: the work behind a result is freed test...")
    src: = "GET / HTTP/1.1\r\nHost: h\r\n\r\n"
    // A parse adds the test's own arguments to the parser. So the first parse comes before the
    // count, and the second adds no more than the room the first made.
    p: = argp.Parser.create("probe", "a null arena", null)
    defer p.free()
    p.positional("[anything]")
    p.parse_or_exit(sys.args(), null)
    before: = mem.heap_used_bytes()
    n: = http.request_length(src, 0, null) catch panic("a whole request has a length")
    assert(n == src.len, "request_length with a null arena")
    p.parse(sys.args(), null) catch panic("the test's own arguments are read")
    $b: = Json_builder.new(null)
    body: = jsonrpc.encode("m", b.int_val(1), 3, null)
    freed(body)
    b.free()
    $acc: = Str_builder.new()
    acc.s("Content-Length: 2\r\n\r\nhi")
    taken: = jsonrpc.take_frame(acc@, 64, null) catch panic("a whole frame is taken")
    freed(taken.unwrap_or(""))
    acc.free()
    back_to(before, "request_length, parse, encode and take_frame free their own work")

    dir: = "out/tmp/kspl_test_null_arena"
    fs.mkdir_all(dir) catch panic("the work directory can be made")
    before_files: = mem.heap_used_bytes()
    made: = fs.mkdir_unique(dir, "d", null) catch panic("a new directory is made")
    file: = fs.write_unique(made, "f", ".txt", "x", null) catch panic("a new file is written")
    fs.write_tree(made, U8[][]::{ "t/a.txt" }, U8[][]::{ "a" }, null)
        catch panic("a tree is written")
    copy: = fs.join(made, "copy", null)
    fs.copy_tree(made, copy, fs.skip_none, null) catch panic("the tree is copied")
    $names: = fs.read_dir(made, null) catch panic("the directory is listed")
    assert(names.len == 3, "read_dir with a null arena")
    freed_all(names@)
    $all: = fs.walk_files(copy, fs.skip_none, null) catch panic("the copy is walked")
    assert(all.len == 2, "walk_files with a null arena")
    freed_all(all@)
    got: = io.read_file_capped(file, 16, null) catch panic("the file is read")
    assert(got.equals("x"), "read_file_capped with a null arena")
    freed(got)
    freed(file)
    freed(copy)
    freed(made)
    back_to(before_files, "the file functions free every path they made along the way")
    verdict.pass("Given null, a function frees its own work: only what it returns is the caller's.")

fn test_null_arena_children(ksplc: U8[]) //< the functions that run a child
    verdict.start("[std] null as the arena for a child's output test...")
    argv: = U8[][]::{ ksplc, "info", "std-dir" }
    before: = mem.heap_used_bytes()
    out: = subproc.run(argv, "", 60000, 4096, null) catch panic("the child runs")
    assert(out.len > 0, "run with a null arena")
    freed(out)
    r: = subproc.run_capture(argv, "", 60000, 4096, null) catch panic("the child must start")
    text: = r.text(null)
    assert(text.len > 0, "run_capture and text with a null arena")
    freed(text)
    freed(r.stdout_data)
    freed(r.stderr_data)
    $refused: = false
    _gone: =
        subproc.run_capture(U8[][]::{ "out/tmp/kspl_test_null_arena/no_such_program" }, "", 60000,
        4096, null) catch
        refused = true
    assert(refused, "a child that cannot start fails to start, and holds no output to free")
    one: = verdict.run_child(argv, "", 60000, null)
    assert(one.exited_with(0), "run_child with a null arena")
    freed(one.out)
    back_to(before, "a child's outputs free with dealloc, and the collecting leaves nothing")

    jobs: = subproc.Job[]::{ subproc.Job::{ .argv = argv, .cwd = "" },
        subproc.Job::{ .argv = U8[][]::{ "out/tmp/kspl_test_null_arena/no_such_program" },
        .cwd = "" } }
    work: = "out/tmp/kspl_test_null_arena/jobs"
    fs.mkdir_all(work) catch panic("the jobs' folder can be made")
    before_many: = mem.heap_used_bytes()
    $many: = subproc.run_many(jobs, 1, 60000, 4096, work, null)
    $started: Sz = 0
    for got in many
        ran: = got catch
            continue
        assert(ran.exited_with(0), "run_many with a null arena")
        started += 1
        freed(ran.stdout_data)
        freed(ran.stderr_data)
    assert(many.len == 2 && started == 1, "run_many with a null arena: the second fails to start")
    many.free()
    $outs: = verdict.run_children(jobs, work, null)
    assert(outs.len == 2 && outs.get(0).exited_with(0), "run_children with a null arena")
    for ran in outs
        freed(ran.out)
    outs.free()
    $lost: = verdict.run_children(jobs, "out/tmp/kspl_test_null_arena/f/w", null)
    assert(lost.len == 2 && lost.get(1).code.is_none(), "a work folder that cannot be made is said")
    for ran in lost
        freed(ran.out)
    lost.free()
    back_to(before_many, "each run's outputs free with dealloc, and the list with free()")
    verdict.pass("A child's outputs come back on the heap, run alone or among others.")

fn test_null_arena_fuzz() //< the fuzz driver's steps: a record frees with `free()`
    verdict.start("[fuzz] null as the arena test...")
    before: = mem.heap_used_bytes()
    line: = fuzz.again_with_asan(fuzz.Sanitized::{ .asan = true, .required = false }, "go", null)
    assert(line.equals("go --asan"), "again_with_asan with a null arena")
    freed(line)
    dir: = "out/tmp/kspl_test_null_arena/seeds"
    fs.mkdir_all(dir) catch panic("the seeds' folder can be made")
    io.write_file("out/tmp/kspl_test_null_arena/seeds/one.txt", "x")
        catch panic("a seed can be written")
    fuzz.check_dirs(U8[][]::{ dir }, null) catch panic("a standing folder passes")
    $missing: U8[] = ""
    fuzz.check_dirs(U8[][]::{ "out/tmp/kspl_test_null_arena/none" }, null) catch why
        missing = why
    assert(missing.len > 0, "check_dirs refuses a folder that does not stand")
    freed(missing)
    $seeds: = fuzz.gather(U8[][]::{ dir }, U8[][]::{ ".txt" }, 1024I64, null)
    assert(seeds.len > 0, "gather with a null arena")
    for one in seeds
        freed(one.name)
        freed(one.data)
    seeds.free()
    back_to(before, "the seeds free as gather's summary says, and the folders' work is gone")
    found: = fuzz.findings_new(null)
    t: = fuzz.Trial::{ .got = subproc.Run_result::{ .exit_code = .some(139), .stdout_data = "",
        .stderr_data = "", .output_lost = false }, .slow = false }
    fuzz.note(found, t@, 0, "seed", "data", dir, ".bin")
    assert(found.crashes.len == 1, "note into findings made with a null arena")
    found.free()
    back_to(before, "findings free with free(), every finding noted in them included")
    none: = fuzz.findings_new(null)
    fuzz.report_all(none, fuzz.Opts::{ .trials = 1I64, .seed = 1I64 },
        "a driver given a null arena", 100, "again", null)
    none.free()
    $o: = fuzz.Opts::{ .trials = 1I64, .seed = 1I64 }
    p: = argp.Parser.create("probe", "a null arena", null)
    $refused: = false
    _set: = fuzz.setup(p, o@, "probe", "<program>", false, null) catch why
        refused = true
        freed(why)
    assert(refused, "setup refuses a command line naming no work folder")
    p.free()
    back_to(before, "each step frees its work, and what it returns frees as its summary says")
    verdict.pass("The fuzz driver's steps run with a null arena, and leave nothing behind.")

//< Tests of the collections: the combinators (`std/seq`) and the byte ring buffer (`std/ring`)
import "std/ds" + { List, Map }
import "std/json"
import "std/mem" + { Arena }
import "std/ring"
import "std/seq"
import "std/str"
import "std/verdict"

struct Seq_person
    name: U8[]
    age: I32

fn test_seq_combinators(arena: Arena$@)
    verdict.start("[Seq] where/order_by/distinct/sum and the rest test...")

    // std/seq takes them as `Callable1` / `Callable2`.
    // Caution: Write the `;` even when nothing is captured; without it an anonymous function is a
    // function pointer and cannot be passed.
    is_adult: = fn(p: Seq_person; ): Bool
        return p.age >= 18
    cmp_age: = fn(a: Seq_person, b: Seq_person; ): I32
        return a.age - b.age

    $people: = List<|Seq_person|>.new(arena)
    people.push(Seq_person::{ .name = "Alice", .age = 30 })
    people.push(Seq_person::{ .name = "Bob", .age = 15 })
    people.push(Seq_person::{ .name = "Carol", .age = 25 })
    people.push(Seq_person::{ .name = "Dave", .age = 15 })
    people.push(Seq_person::{ .name = "Eve", .age = 42 })

    // `where` and `select` are lazy. There are three terminals: `to_list`, `count` and `for x in`.
    assert(people.where(is_adult).count() == 3, "where: expected 3 adults")
    adults: = people.where(is_adult).to_list(arena)
    assert(adults.len == 3, "where: to_list should keep the same 3")

    age_of: = fn(p: Seq_person; ): I32
        return p.age
    ages: = people.select(age_of).to_list(arena)
    assert(ages.len == 5, "select: expected 5 entries")
    assert(ages.get(0) == 30, "select: first age wrong")

    // A chain builds no intermediate list.
    $adult_ages: I32 = 0
    for a in people.where(is_adult).select(age_of)
        adult_ages += a
    assert(adult_ages == 30 + 25 + 42, "where+select: sum of adult ages")

    // **Iterating the same chain twice starts from the beginning both times**: the receiver is
    // taken by value (unlike a Python generator, it does not run empty).
    chain: = people.where(is_adult).select(age_of)
    assert(chain.count() == 3, "restartable: first pass")
    assert(chain.count() == 3, "restartable: second pass sees the same 3")

    sorted: = people.order_by(cmp_age, arena)
    assert(sorted.get(0).age == 15, "order_by: min should be 15")
    assert(sorted.get(4).age == 42, "order_by: max should be 42")
    assert(sorted.get(0).age <= sorted.get(1).age, "order_by: not sorted at 0/1")

    uniq_ages: = ages.distinct(fn(a: I32, b: I32; ): Bool {
        return a == b;
    }, arena)
    assert(uniq_ages.len == 4, "distinct: expected 4 unique ages (30,15,25,42)")

    first: = people.first() catch panic("first() should not throw on non-empty list")
    assert(first.name.equals("Alice"), "first() should be Alice")

    assert(people.any(is_adult), "any: should have an adult")
    assert(!people.all(is_adult), "all: not everyone is an adult")

    top2: = sorted.take(2, arena)
    assert(top2.len == 2 && top2.get(0).age == 15 && top2.get(1).age == 15, "take wrong")
    rest: = sorted.skip(2, arena)
    assert(rest.len == 3, "skip wrong")

    empty: = List<|Seq_person|>.new(arena)
    $empty_threw: = false
    empty.first() catch e
        empty_threw = e == seq.Seq_error.empty_sequence
    assert(empty_threw, "first() on empty list should throw empty_sequence")

    verdict.pass("The collection operations work as expected.")

fn test_seq_two_element_types(arena: Arena$@) //<
    //< That a chain of adapters works with two or more element types
    //<
    //< Caution: **Use two or more element types.** Each adapter of a chain (`Keep` / `Conv`) binds
    //< `T` once, so a lookup in the wrong direction finds the outer adapter's type
    //< (`find_generic_arg` in `ksplc/sema/session/ctx.kspls`); one type alone shows nothing.
    verdict.start("[Seq] a chain goes through with two or more element types test...")
    $words: = List<|U8[]|>.new(arena)
    words.push("a")
    words.push("bcd")
    long_ones: = words.where(fn(w: U8[]; ): Bool {
        return w.len > 1;
    }).count()
    $nums: = List<|I32|>.new(arena)
    nums.push(1)
    nums.push(9)
    lens: = words.select(fn(w: U8[]; ): Sz {
        return w.len;
    }).to_list(arena)
    big: = nums.where(fn(x: I32; ): Bool {
        return x > 4;
    }).count()
    assert(long_ones == 1, "the U8[] side")
    assert(big == 1, "the I32 side")
    assert(lens.len == 2 && lens.get(1) == 3, "select is instantiated per element type too")
    verdict
        .pass("Two chains of differing element types do not tread on each other's type arguments.")

struct Seq_tagged //< a key to sort by, and its position before sorting
    key: I32
    was: Sz

fn test_seq_order_by_stable(arena: Arena$@) //<
    //< That order_by sorts long lists and keeps equal keys in their original order
    //<
    //< Caution: **Go past the insertion-sort run length** (16). Below it no merge runs, so lengths
    //< up to 16 test no merging. The equal keys show whether a tie is reversed.
    verdict.start("[Seq] order_by sorts long lists and keeps equals in order test...")
    by_key: = fn(a: Seq_tagged, b: Seq_tagged; ): I32
        return a.key - b.key
    for n in U8[]::{ 0, 1, 16, 17, 33, 200 }
        $xs: = List<|Seq_tagged|>.new(arena)
        // Only 7 keys, so every length past 7 has equal keys whose order must be kept.
        for i in Range.asc(n)
            xs.push(Seq_tagged::{ .key = I32::((i * 5) % 7), .was = i })
        got: = xs.order_by(by_key, arena)
        assert(got.len == Sz::n, "order_by: the length changed")
        for $i: Sz = 1; i < got.len; i += 1
            prev: = got.get(i - 1)
            here: = got.get(i)
            assert(prev.key <= here.key, "order_by: out of order")
            assert(prev.key < here.key || prev.was < here.was, "order_by: equals turned around")
    // Caution: **Sort on the heap too** (`arena` null), past the run length so the merge's spare
    // list is made: only the list returned may stay behind.
    $on_heap: = List<|Seq_tagged|>.new(null)
    for i in Range.asc(40)
        on_heap.push(Seq_tagged::{ .key = I32::(40 - i), .was = i })
    heap_before: = mem.heap_used_bytes()
    $heap_sorted: = on_heap.order_by(by_key, null)
    heap_sorted.free()
    heap_after: = mem.heap_used_bytes()
    on_heap.free()
    assert(heap_after == heap_before, "order_by: nothing but the list returned stays on the heap")
    verdict.pass("order_by sorts past its insertion runs and keeps equal keys in their order.")

// ==========================================
// Tests of the byte ring buffer (`std/ring`)
// **Always make the data cross the wrap**, or the `% cap` is never tested.
// ==========================================
// The buffer, as long as the capacity, lives outside the Ring, which holds only its address.
$ring_buf: U8[8]

priv const named_cap: Sz = 4 //<
    //< The capacity written as a named const (the form a driver's buffer uses)
    //<
    //< Both the buffer's length and the const generic argument come from one constant.
$named_buf: U8[named_cap]

fn test_ring_basic()
    verdict.start("[Ring] write/read/full/empty test...")

    $r: = ring.Ring<|8|>.new(ring_buf[0]@)
    assert(r.is_empty(), "Ring: it starts out empty")
    assert(r.len() == 0, "Ring: len starts at 0")
    assert(r.free_space() == 8, "Ring: free_space starts at cap")
    assert(r.peek().len == 0, "Ring: an empty peek is length 0")

    n: = r.write("hello")
    assert(n == 5, "Ring: write returns the number of bytes written")
    assert(r.len() == 5 && r.free_space() == 3, "Ring: len/free_space after a write")

    out: U8[5] = ::{}
    m: = r.read(U8$[]::out)
    got: = U8[]::out
    assert(m == 5 && got.equals("hello"), "Ring: read returns in the order written")
    assert(r.is_empty(), "Ring: empty once everything is read")

    // It writes until full and discards the rest (a partial write).
    f: = r.write("0123456789")
    assert(f == 8 && r.free_space() == 0, "Ring: a partial write stops at cap")
    assert(r.write("z") == 0, "Ring: write is 0 when full")

    r.clear()
    assert(r.is_empty() && r.free_space() == 8, "Ring: clear goes back to empty")

    // Writing the capacity as a named const behaves the same as writing it as a literal.
    $named: = ring.Ring<|named_cap|>.new(named_buf[0]@)
    named_space: = named.free_space()
    assert(named_space == 4, "Ring<|named_cap|>: a named const takes effect as the capacity")
    assert(named.write("abcdef") == 4, "Ring<|named_cap|>: it stops at cap")
    assert(named.free_space() == 0, "Ring<|named_cap|>: it becomes full")

    // **Two spellings of the same value give the same type** ("What can be written where a value is
    // passed as a type argument" in `../../docs/SPEC-language.md`). A separate instantiation would
    // fail here with a type mismatch.
    same: ring.Ring<|4|> = ring.Ring<|named_cap|>.new(named_buf[0]@)
    assert(same.free_space() == 4, "Ring<|named_cap|> and Ring<|4|> are one and the same type")

    verdict
        .pass("write/read keep the order, a full buffer stops at a partial write, clear goes back \
            to empty, and a capacity written as a named const lands on the same type as a literal.")

fn test_ring_wraparound()
    verdict.start("[Ring] the wrap, peek and consume test...")

    $r: = ring.Ring<|8|>.new(ring_buf[0]@)
    r.clear()

    // Advances tail to 4, so that the write runs past the end.
    r.write("hello")
    drop: U8[4] = ::{}
    r.read(U8$[]::drop)
    assert(r.len() == 1, "Ring: one byte is left")

    // The free space is 7. The write wraps and puts 3 bytes at the start of the buffer.
    n: = r.write("world!")
    assert(n == 6 && r.len() == 7, "Ring: a write that crosses the wrap")

    // peek returns only the contiguous part up to the wrap; a second peek returns the rest.
    c1: = r.peek()
    assert(c1.len == 4 && c1.equals("owor"), "Ring: peek gives the contiguous part alone")
    r.consume(c1.len)
    c2: = r.peek()
    assert(c2.len == 3 && c2.equals("ld!"), "Ring: the second round's peek gives the rest")
    r.consume(c2.len)
    assert(r.is_empty(), "Ring: two rounds of peek/consume leave it empty")

    // Crossing the wrap one byte at a time works too.
    r.write("abcdefgh")
    for i in Range.asc(6)
        $one: U8[1] = ::{}
        got_one: = r.read(U8$[]::one)
        assert(got_one == 1 && one[0] == 'a' + U8::i,
            "Ring: a one-byte read is in the order written")
    assert(r.write("X") == 1, "Ring: a write succeeds once there is free space")
    assert(r.len() == 3, "Ring: len after the wrap")
    tailbuf: U8[3] = ::{}
    r.read(U8$[]::tailbuf)
    tail: = U8[]::tailbuf
    assert(tail.equals("ghX"), "Ring: a read that crossed the wrap")
    verdict
        .pass("A write/read that crosses the wrap goes through, peek gives the contiguous part \
            alone, and two rounds give the whole.")

// ==========================================
// Tests of going round std's lists with `for x in`, and of removing from a `Map` or a `List`
// ==========================================
// Tests that every std API allowed to allocate the whole result returns a list with `.len` and an
// index, which `for x in` iterates directly ("One mechanism per purpose" in docs/DESIGN.md); the
// `next()` form (a lazy chain) is `std/seq`'s.
// Caution: **Do not change it to a form that returns a listing** (the reason is at `items` in
// `std/ds.kspls`).
// ==========================================
fn test_iteration(arena: Arena$@)
    verdict
        .start("[iterate] every allocating API lines up as a list that goes round under for in \
            test...")

    // --- str.split: n separators means n+1 elements ---
    lines: = "a\nbb\n\nccc".split('\n', arena)
    assert(lines.len == 4, "split: 3 separators means 4 elements")
    assert(lines.get(0).equals("a") && lines.get(1).equals("bb"), "split: the first 2 elements")
    assert(lines.get(2).len == 0, "split: between two adjacent separators is length 0")
    assert(lines.get(3).equals("ccc"), "split: the last element")

    $total_len: Sz = 0
    for line in lines
        total_len += line.len
    assert(total_len == 6, "split's result goes round under for in")

    // Ending on a separator puts a length-0 element at the end.
    trailing: = "x,".split(',', arena)
    assert(trailing.len == 2 && trailing.get(1).len == 0, "split: a trailing separator")
    // An empty string is one element of length 0.
    assert("".split(',', arena).len == 1, "split: an empty string is one element")

    // --- Map.entries: only the entries in use, updatable through the pointer ---
    $m: = Map<|I32, I32|>.new(arena)
    m.set(1, 10)
    m.set(2, 20)
    m.set(3, 30)
    m.remove(2)

    $seen: Sz = 0
    $sum: I32 = 0
    for e in m.items()
        seen += 1
        sum += e.value
        e.value += 1
    assert(seen == 2, "entries: a slot already removed is not walked")
    assert(sum == 40, "entries: the sum of the values")
    v1: = m.get(1) catch 0
    v3: = m.get(3) catch 0
    assert(v1 == 11 && v3 == 31,
        "entries: an update through the returned pointer reaches the Map itself")

    // --- json.Val.arr_list ---
    v: = json.parse("[1, 2, 3, 4]", arena) catch panic("iterate_test: parsing the JSON failed")
    $j_sum: I64 = 0
    for item in v.arr_list(arena)
        j_sum += item.as_int(0)
    assert(j_sum == 10, "arr_list: the sum of the elements")
    // For a value that is not an array, it returns an empty list.
    scalar: = json.parse("42", arena) catch panic("iterate_test: parsing the JSON failed")
    assert(scalar.arr_list(arena).len == 0, "arr_list: empty when it is not an array")

    verdict.pass("split, entries and arr_list all went round under for in.")
// ==========================================
// Removal from `Map`. `Map` uses linear probing, so a wrong removal makes **another key**
// unreachable.
// ==========================================

fn test_map_removal() //<
    //< That after removal and re-insertion in a Map every key is found, and found once
    //<
    //< Caution: **Test with a pair of colliding keys**: a plain empty slot left behind ends the
    //< probe before the key that was pushed past it. **Test re-insertion too**: writing into the
    //< tombstone can duplicate a key that stands further along.
    verdict.start("[Map] removal and re-insertion test...")

    // Two keys in the same bucket (the low 5 bits of the initial capacity 32).
    $ka: I32 = 0
    $kb: I32 = 0
    $found: = false
    for $a: I32 = 1; a < 400 && !found; a += 1
        for $b: I32 = a + 1; b < 400 && !found; b += 1
            if (Sz::ds.fmix32(U32::a) & 31) == (Sz::ds.fmix32(U32::b) & 31)
                ka = a
                kb = b
                found = true
    assert(found, "a pair of colliding keys is found")

    $m: = Map<|I32, I32|>.new(null)
    defer m.free()
    m.set(ka, 100)
    m.set(kb, 200)
    assert(m.remove(ka), "the earlier key can be removed")
    assert(m.len == 1, "the count goes down by one")
    assert((m.get(kb) catch -1) == 200,
        "the key behind is still reachable after removing the earlier one")

    m.set(kb, 300)
    assert(m.len == 1, "the count does not go up when it is put back in")
    assert((m.get(kb) catch -1) == 300, "the value put back in is reachable")

    // Through repeated removal and insertion, only the remaining keys are reachable.
    $m2: = Map<|I32, I32|>.new(null)
    defer m2.free()
    for i in Range.asc(200)
        m2.set(I32::i, I32::(i * 10))
    for i in Range.asc(200)
        if i % 2 == 0
            m2.remove(I32::i)
    assert(m2.len == 100, "100 after removing half")
    $all_ok: = true
    for i in Range.asc(200)
        got: = m2.get(I32::i) catch -1
        want: I32 = -1 if i % 2 == 0 else I32::(i * 10)
        if got != want
            all_ok = false
    assert(all_ok, "only the removed keys are unreachable")
    $live: Sz = 0
    for _e in m2.items()
        live += 1
    assert(live == 100, "entries agrees with the count still alive")

    // **Test repeated set and remove**: if growth ignores the tombstones, they fill the table while
    // the count stays small.
    $m3: = Map<|I32, I32|>.new(null)
    defer m3.free()
    for _i in Range.asc(5000)
        m3.set(7, 1)
        m3.remove(7)
    m3.set(7, 42)
    assert((m3.get(7) catch -1) == 42, "it is reachable through repeated set and remove")

    verdict
        .pass("A colliding key is not lost to removal, and putting it back in does not double it.")

fn test_map_odd_cap() //< a capacity that is not a power of two
    verdict.start("[Map] new_with_cap with a count that is not a power of two test...")
    // Caution: **Check the slots before inserting.** Taken as it is, 3 leaves a slot no probe
    // reaches and the third `set` never returns, so the test would hang rather than fail.
    $m: = Map<|I32, I32|>.new_with_cap(3, null)
    defer m.free()
    assert(m.cap == 4, "the count is rounded up to the next power of two")
    for $k: I32 = 1; k <= 3; k += 1
        m.set(k, k * 10)
    assert(m.len == 3 && (m.get(3) catch -1) == 30, "every key put in is reachable")
    verdict.pass("A count that is not a power of two is rounded up, and the map works.")
fn test_list_remove_at() //< the counterpart of `List.insert`
    verdict.start("[ds] List.remove_at test...")
    arena: = Arena.new(8 * 1024)
    defer arena.free()
    xs: = List<|I32|>.create(arena)
    for $i: I32 = 0; i < 5; i += 1
        xs.push(i)
    xs.remove_at(2)
    assert(xs.len == 4, "it goes down by one")
    assert(xs.get(0) == 0 && xs.get(1) == 1, "what is in front stays as it is")
    assert(xs.get(2) == 3 && xs.get(3) == 4, "what is behind packs forward by one")
    xs.remove_at(0)
    assert(xs.len == 3 && xs.get(0) == 1, "the head can be taken out too")
    xs.remove_at(xs.len - 1)
    assert(xs.len == 2 && xs.get(1) == 3, "the tail can be taken out too")
    // remove_at undoes insert.
    xs.insert(1, 9)
    assert(xs.len == 3 && xs.get(1) == 9, "an insertion goes into the counterpart position")
    xs.remove_at(1)
    assert(xs.len == 2 && xs.get(1) == 3, "taking it out comes back to the original")
    verdict.pass("remove_at packs what is behind forward, as insert's counterpart.")

//< The entry point that runs std's tests together
//< **This is the one contract this package exports.** The tests live inside `std/`. So they reach
//< what they inspect without any marking: no `pub` is added only for testing ("A test of a
//< unit's inside goes inside that unit" in `../../docs/DESIGN-repository.md`).
//< Caution: **Do not add a function for inspection here.** Each one adds a contract outside
//< the unit.
//< **[I0402] does not apply in this unit.**
import "std/mem" { Arena }
import "std/suite"
import "std/tests/arena_null_test"
import "std/tests/argparse_test"
import "std/tests/bytes_test"
import "std/tests/checked_int_test"
import "std/tests/concurrency_test"
import "std/tests/encoding_test"
import "std/tests/fs_test"
import "std/tests/fuzz_test"
import "std/tests/http_body_test"
import "std/tests/http_test"
import "std/tests/io_test"
import "std/tests/mem_test"
import "std/tests/net_test"
import "std/tests/rand_test"
import "std/tests/reflect_test"
import "std/tests/regex_test"
import "std/tests/seq_test"
import "std/tests/str_test"
import "std/tests/subproc_test"
import "std/tests/sys_test"
import "std/tests/tree_test"
import "std/tests/verdict_test"

priv struct Tests //< what std's tests take, each by the name of its parameter
    ksplc: U8[] //< the compiler a test starts as a child (`verdict_test`, `fuzz_test`)
    arena: Arena$@

impl Tests: suite.Suite {}

pub fn run_std(ksplc: U8[], arena: Arena$@) //< runs every std test the imports above reach
    //< ksplc is the compiler a test starts as a child.
    $t: = Tests::{ .ksplc = ksplc, .arena = arena }
    t.run()

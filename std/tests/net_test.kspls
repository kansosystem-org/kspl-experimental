//< Tests of `std/net` over real loopback traffic, TCP and UDP
import "std/ds" { List }
import "std/io"
import "std/net"
import "std/reactor"
import "std/str"
import "std/subproc"
import "std/sys"
import "std/thread"
import "std/verdict"

// The TCP server accept()s on a separate thread and echoes what it receives.
#export
fn net_tcp_echo_server(listener: net.Tcp_listener$@): Void$@
    conn: = listener.accept() catch panic("accept should succeed once the client connects")
    // accept's peer is the client (the loopback, on an ephemeral port).
    $peer_host: U8[64] = ::{}
    p: = conn.peer(U8$[]::peer_host) catch panic("peer should succeed on an accepted stream")
    host: = U8[]::{ .ptr = peer_host[0]@, .len = p.host_len }
    assert(host.equals("127.0.0.1"), "accepted peer host must be the loopback")
    assert(p.port > 0, "accepted peer port must be the client's ephemeral port")
    $buf: U8[64] = ::{}
    n: = conn.read(U8$[]::buf) catch panic("server read should succeed")
    conn.write(U8$[]::{ .ptr = buf@, .len = n }) catch panic("server write should succeed")
    conn.free()
    return null

// Accepts one connection and closes it (test_tcp_echo checks the data sent back and forth).
#export
fn net_accept_once(listener: net.Tcp_listener$@): Void$@
    conn: = listener.accept() catch panic("accept should succeed once the client connects")
    conn.free()
    return null

// Reads until the client's end, then answers with how much came (test_tcp_half_close).
#export
fn net_count_then_answer(listener: net.Tcp_listener$@): Void$@
    conn: = listener.accept() catch panic("accept should succeed once the client connects")
    $buf: U8[64] = ::{}
    $total: Sz = 0
    for
        n: = conn.read(U8$[]::buf) catch panic("server read should succeed")
        if n == 0
            break
        total += n
    $said: = str.Str_builder.new()
    defer said.free()
    said.s("\{total\}")
    conn.write_all(said.slice()) catch panic("server write should succeed")
    conn.free()
    return null

// ==========================================
// Connecting by name, and the size of the buffer that receives an address.
// ==========================================

fn test_net_names() //<
    //< That connecting by name, resolving a name, and the address buffer's size all work
    //<
    //< Caution: **Do not test with an address string alone**: that passes even when name resolution
    //< is missing. **Do not assume which address `localhost` resolves to**; the listener binds the
    //< resolved address (the details are beside the bind below).
    verdict
        .start("[Net] connecting by name, resolving to an address, and the holder's width test...")
    $addr: U8[64] = ::{}
    n: = net.resolve_one("127.0.0.1", U8$[]::addr) catch panic("resolve_one should accept a literal")
    literal: = U8[]::{ .ptr = addr[0]@, .len = n }
    assert(literal.equals("127.0.0.1"), "an address string comes back as it stands")
    ln: = net.resolve_one("localhost", U8$[]::addr) catch panic("resolve_one should resolve \
        localhost")
    assert(ln > 0, "localhost resolves to an address")

    $bogus: = false
    _b: = net.resolve_one("no-such-host.invalid", U8$[]::addr) catch e
        bogus = e == net.Net_error.resolve_failed
        fallback 0
    assert(bogus, "a name that does not resolve is refused as resolve_failed")

    // **An empty string is not a name.** Linux reports "no such name" but Windows returns every
    // address the machine has, so it is refused here.
    $blank: = false
    _n: = net.resolve_one("", U8$[]::addr) catch e
        blank = e == net.Net_error.resolve_failed
        fallback 0
    assert(blank, "an empty string is not resolved as a name")

    // **A name too long to copy is refused, not truncated.** C reads this one as `127.0.0.1`, so a
    // truncated copy would resolve to the loopback.
    $long_name: U8[300] = ::{}
    loopback: = "127.0.0.1"
    for i in Range.asc(loopback.len)
        long_name[i] = loopback[i]
    $too_long: = false
    _l: = net.resolve_one(U8[]::long_name, U8$[]::addr) catch e
        too_long = e == net.Net_error.resolve_failed
        fallback 0
    assert(too_long, "a name longer than the resolver's holder is refused rather than truncated")
    // **A name holding a NUL is refused, not cut at it.** C would read this one as `127.0.0.1`.
    $nul_name: U8[11] = ::{}
    for i in Range.asc(loopback.len)
        nul_name[i] = loopback[i]
    nul_name[10] = 'x'
    $cut: = false
    _z: = net.resolve_one(U8[]::nul_name, U8$[]::addr) catch e
        cut = e == net.Net_error.resolve_failed
        fallback 0
    assert(cut, "a name holding a NUL is refused rather than cut at the NUL")

    $small: U8[8] = ::{}
    $narrow: = false
    _s: = net.resolve_one("127.0.0.1", U8$[]::small) catch e
        narrow = e == net.Net_error.addr_buffer_too_small
        fallback 0
    assert(narrow, "a holder short of addr_text_max is refused rather than truncated")

    // Caution: **Bind the listener to the address `localhost` resolves to.** If it is fixed to
    // `127.0.0.1` and `localhost` resolves to IPv6 first, the name reaches a different port.
    $home: U8[64] = ::{}
    hn: = net.resolve_one("localhost", U8$[]::home) catch panic("resolve_one should resolve \
        localhost")
    local: = U8[]::{ .ptr = home[0]@, .len = hn }
    listener: = net.Tcp_listener.bind(local, 0) catch panic("bind should succeed on a free port")
    port: = listener.port() catch panic("a bound socket knows its port")
    t: = thread.Thread.spawn<|net.Tcp_listener|>(net_accept_once, listener) catch panic("thread \
        spawn failed")
    client: = net.Tcp_stream.connect("localhost", port) catch panic("connect by name should reach \
        the loopback listener")
    $peer_host: U8[64] = ::{}
    p: = client.peer(U8$[]::peer_host) catch panic("peer should succeed on a connected stream")
    host: = U8[]::{ .ptr = peer_host[0]@, .len = p.host_len }
    // Caution: **Do not merge the two into one condition**, or the log does not say which differed.
    assert(host.equals(local), "the address a name connected to is the waiting port's address")
    assert(p.port == port, "the port a name connected to is the waiting port's port")
    $tight: U8[8] = ::{}
    $tight_refused: = false
    _p: = client.peer(U8$[]::tight) catch e
        tight_refused = e == net.Net_error.addr_buffer_too_small
        fallback net.Peer_addr::{ .host_len = 0, .port = 0 }
    assert(tight_refused, "peer refuses a holder that is short too")
    client.free()
    t.join_and_free()
    listener.free()

    $missing: = false
    _c: = net.Tcp_stream.connect("no-such-host.invalid", 80) catch e
        missing = e == net.Net_error.resolve_failed
        fallback null
    assert(missing,
        "a connect to a name that does not resolve is refused under a name other than \
            connect_failed")

    $empty: = false
    _e: = net.Tcp_stream.connect("", 80) catch e
        empty = e == net.Net_error.resolve_failed
        fallback null
    assert(empty, "trying to connect with an empty string is refused as resolving in no environment")

    u: = net.Udp_socket.bind("127.0.0.1", 0) catch panic("udp client bind should succeed")
    $named: = false
    _u: = u.send_to("x", "localhost", 17661) catch e
        named = e == net.Net_error.addr_not_numeric
        fallback 0
    assert(named,
        "writing a name as send_to's destination is refused (it will not look a name up per \
            message)")
    u.free()
    verdict
        .pass("It connects by both a name and an address string, and refuses a name that does not \
            resolve and a holder that is short, each by name.")

// ==========================================
// The IPv6 loopback. **It is skipped in an environment with no IPv6** (`socket(AF_INET6)` returns
// EAFNOSUPPORT).
// ==========================================
fn test_tcp_ipv6()
    verdict.start("[Net] connecting over the IPv6 loopback and peer() test...")
    listener: = net.Tcp_listener.bind("::1", 0) catch
        verdict.skip("this machine has no IPv6 loopback")
        return
    port: = listener.port() catch panic("a bound socket knows its port")
    t: = thread.Thread.spawn<|net.Tcp_listener|>(net_accept_once, listener) catch panic("thread \
        spawn failed")
    client: = net.Tcp_stream.connect("::1", port) catch panic("connect should succeed on the IPv6 \
        loopback")
    $peer_host: U8[64] = ::{}
    p: = client.peer(U8$[]::peer_host) catch panic("peer should succeed on a connected stream")
    host: = U8[]::{ .ptr = peer_host[0]@, .len = p.host_len }
    assert(host.equals("::1") && p.port == port, "an IPv6 address round-trips as text")
    client.free()
    t.join_and_free()
    listener.free()
    verdict.pass("It connects over the IPv6 loopback, and peer() returns `::1`.")

// ==========================================
// The overlapped attempts, over candidates where one refuses and one accepts. `connect_over` takes
// them as given, since what a name resolves to differs per machine.
// ==========================================
fn connect_peer(candidates: U8[][], port: I32, peer_host: U8$[]): U8[] //<
    //< Connects over the candidates and returns the address text of the one that won
    client: = net.connect_over(candidates, port, 30000I64) catch panic("connect_over should reach \
        the one candidate that accepts")
    p: = client.peer(peer_host) catch panic("peer should succeed on a connected stream")
    client.free()
    return U8[]::{ .ptr = peer_host.ptr, .len = p.host_len }

priv fn expect_winner(got: U8[], want: U8[]) //<
    //< names the candidate that won when it is not `want`
    //<
    //< The assert after it stops the run; this line says which one won, which the assert cannot.
    if !got.equals(want)
        io.err().s("[Net] the overlapped attempts: ").s(got).s(" won where ").s(want).s(" should\n")

fn port_nobody_holds(): I32 //< a port the OS just handed out and took back, so nothing listens
    l: = net.Tcp_listener.bind("127.0.0.1", 0) catch panic("bind should succeed on a free port")
    port: = l.port() catch panic("a bound socket knows its port")
    l.free()
    return port

fn test_tcp_overlapped()
    verdict
        .start("[Net] overlapped attempts: a refusing candidate does not keep the accepting one \
            from winning...")
    $peer_host: U8[64] = ::{}
    // Nothing listens on 127.0.0.2: it refuses on Linux, and on a machine whose loopback holds only
    // 127.0.0.1 it never answers, which the next attempt overtakes. Either way 127.0.0.1 wins.
    v4: = net.Tcp_listener.bind("127.0.0.1", 0) catch panic("bind should succeed on a free port")
    port: = v4.port() catch panic("a bound socket knows its port")
    t4: = thread.Thread.spawn<|net.Tcp_listener|>(net_accept_once, v4) catch panic("thread spawn \
        failed")
    won4: =
        connect_peer(U8[][]::{ "127.0.0.2", "127.0.0.1" }, port, U8$[]::peer_host)
    expect_winner(won4, "127.0.0.1")
    assert(won4.equals("127.0.0.1"), "the accepting candidate wins over a refusing one before it")
    t4.join_and_free()
    // The IPv6 loopback refuses, or cannot be opened where there is none: skipped, not a failure.
    t4b: = thread.Thread.spawn<|net.Tcp_listener|>(net_accept_once, v4) catch panic("thread spawn \
        failed")
    won4b: = connect_peer(U8[][]::{ "::1", "127.0.0.1" }, port, U8$[]::peer_host)
    expect_winner(won4b, "127.0.0.1")
    assert(won4b.equals("127.0.0.1"), "the IPv4 candidate wins over an IPv6 one that refuses")
    t4b.join_and_free()
    v4.free()

    $nobody: = false
    _n: =
        net.connect_over(U8[][]::{ "127.0.0.1" }, port_nobody_holds(), 30000I64) catch e
        nobody = e == net.Net_error.connect_failed
        fallback null
    assert(nobody, "candidates that all refuse fail as connect_failed")
    verdict
        .pass("A candidate that accepts wins over one that refuses or never answers before it, and \
            candidates that all refuse fail as connect_failed.")

fn test_tcp_connect_wait() //< a candidate that never answers ends the connect at its wait
    //<
    //< **A full backlog makes the silence**: past its accept queue, Linux and BSD drop a SYN
    //< without a word, so the next connect hears nothing, as from an address whose packets are
    //< dropped. Without the wait it would hang for the OS's minutes.
    verdict.start("[Net] connect gives up at its wait on a candidate that never answers...")
    if sys.is_windows()
        verdict.skip("Windows refuses a connection past a full backlog, so none goes silent")
        return
    l: = net.Tcp_listener.bind("127.0.0.1", 0) catch panic("bind should succeed on a free port")
    port: = l.port() catch panic("a bound socket knows its port")
    // More than the backlog (128), none accepted, so the queue stays full.
    $held: = List<|net.Tcp_stream$@|>.new(null)
    for _i in Range.asc(300)
        s: = net.Tcp_stream.connect_nonblocking("127.0.0.1", port) catch panic("a connect starts")
        held.push(s)
    t0: = sys.mono_us()
    $timed_out: = false
    _c: = net.connect_over(U8[][]::{ "127.0.0.1" }, port, 500I64) catch e
        timed_out = e == net.Net_error.timed_out
        fallback null
    took_ms: = (sys.mono_us() - t0) / 1000I64
    for s in held.slice()
        s.free()
    held.free()
    l.free()
    assert(timed_out, "a connect that hears nothing fails as timed_out")
    $m: = Panic_msg.new()
    assert(took_ms < 10000I64,
        m.s("it gives up near its wait, not at the OS's own limit (took ").n(took_ms).s(" ms)")
        .slice())
    verdict.pass("A connect that hears nothing gives up at its wait, as timed_out.")

fn test_tcp_overlapped_ipv6()
    verdict
        .start("[Net] overlapped attempts: an IPv6 candidate that accepts wins over a refusing IPv4 \
            one...")
    $peer_host: U8[64] = ::{}
    v6: = net.Tcp_listener.bind("::1", 0) catch
        verdict.skip("this machine has no IPv6 loopback")
        return
    port: = v6.port() catch panic("a bound socket knows its port")
    t6: = thread.Thread.spawn<|net.Tcp_listener|>(net_accept_once, v6) catch panic("thread spawn \
        failed")
    won6: = connect_peer(U8[][]::{ "127.0.0.1", "::1" }, port, U8$[]::peer_host)
    expect_winner(won6, "::1")
    assert(won6.equals("::1"),
        "the accepting IPv6 candidate wins over a refusing IPv4 one before it")
    t6.join_and_free()
    v6.free()
    verdict.pass("The IPv6 candidate that accepts wins over an IPv4 one that refuses before it.")

fn test_tcp_echo()
    verdict.start("[Net] TCP listener/accept/connect/read/write test (real loopback traffic)...")

    listener: = net.Tcp_listener.bind("127.0.0.1", 0) catch panic("bind should succeed on a free \
        port")
    port: = listener.port() catch panic("a bound socket knows its port")
    t: =
        thread.Thread.spawn<|net.Tcp_listener|>(net_tcp_echo_server, listener) catch panic("thread \
            spawn failed")

    client: = net.Tcp_stream.connect("127.0.0.1", port) catch panic("connect should succeed once \
        the listener is bound")
    // The client's peer is the server, at the address given to bind.
    $peer_host: U8[64] = ::{}
    p: = client.peer(U8$[]::peer_host) catch panic("peer should succeed on a connected stream")
    host: = U8[]::{ .ptr = peer_host[0]@, .len = p.host_len }
    assert(host.equals("127.0.0.1") && p.port == port,
        "connected peer must be the server we dialed")
    sent: = client.write("ping") catch panic("client write should succeed")
    assert(sent == 4, "client should send exactly 4 bytes")

    $recv_buf: U8[64] = ::{}
    got: = client.read(U8$[]::recv_buf) catch panic("client read should succeed")
    echoed: = U8$[]::{ .ptr = recv_buf@, .len = got }
    assert(got == 4 && echoed.equals("ping"), "server must echo back exactly what was sent")

    client.free()
    t.join_and_free()
    listener.free()
    verdict
        .pass("The echo round trip over a TCP loopback connection, and peer()'s address on both \
            sides, are confirmed.")

fn test_udp_echo()
    verdict.start("[Net] UDP bind/send_to/recv_from test (real loopback traffic)...")

    server: = net.Udp_socket.bind("127.0.0.1", 0) catch panic("udp bind should succeed on a free \
        port")
    port: = server.port() catch panic("a bound socket knows its port")
    client: = net.Udp_socket.bind("127.0.0.1", 0) catch panic("udp client bind (ephemeral port) \
        should succeed")

    sent: = client.send_to("hello-udp", "127.0.0.1", port) catch panic("udp send_to should succeed")
    assert(sent == 9, "should send exactly 9 bytes")

    $recv_buf: U8[64] = ::{}
    $from_host_buf: U8[64] = ::{}
    result: = server.recv_from(U8$[]::recv_buf, U8$[]::from_host_buf) catch panic("udp recv_from \
        should succeed")
    payload: = U8$[]::{ .ptr = recv_buf@, .len = result.len }
    from_host: = U8$[]::{ .ptr = from_host_buf@, .len = result.from_host_len }
    payload_matches: = payload.equals("hello-udp")
    assert(result.len == 9 && payload_matches, "received payload must match what was sent")
    assert(from_host.equals("127.0.0.1"), "sender address must be reported correctly")

    client.free()
    server.free()
    verdict
        .pass("Sending and receiving over UDP loopback traffic, and reporting the sender's address, \
            are confirmed.")

// ==========================================
// A datagram longer than the buffer fails by name on every OS. Linux would hand back the cut part
// as a success, Windows refuse it.
// ==========================================
fn test_udp_too_long()
    verdict
        .start("[Net] a datagram longer than the buffer is refused, and the next one still comes...")
    server: = net.Udp_socket.bind("127.0.0.1", 0) catch panic("udp bind should succeed on a free \
        port")
    port: = server.port() catch panic("a bound socket knows its port")
    client: = net.Udp_socket.bind("127.0.0.1", 0) catch panic("udp client bind should succeed")
    _l: = client.send_to("a datagram longer than ten bytes", "127.0.0.1", port) catch panic("udp \
        send_to should succeed")
    _s: = client.send_to("short", "127.0.0.1", port) catch panic("udp send_to should succeed")
    $buf: U8[10] = ::{}
    $from: U8[64] = ::{}
    $too_long: = false
    _r: = server.recv_from(U8$[]::buf, U8$[]::from) catch e
        too_long = e == net.Net_error.datagram_too_long
        fallback net.Udp_recv_result::{ .len = 0, .from_host_len = 0, .from_port = 0 }
    assert(too_long, "a datagram longer than the buffer fails as datagram_too_long")
    next: = server.recv_from(U8$[]::buf, U8$[]::from) catch panic("the next datagram should arrive")
    got: = U8[]::{ .ptr = buf[0]@, .len = next.len }
    assert(got.equals("short"), "the long datagram is consumed, and the next one arrives whole")
    client.free()
    server.free()
    verdict
        .pass("A datagram longer than the buffer fails as datagram_too_long, and the next one \
            arrives whole.")

// ==========================================
// A port outside 0..65535 is refused, never wrapped: C's 16-bit field would turn 83659 into 18123
// and -1 into 65535, binding or reaching another port in silence.
// ==========================================
priv fn refused_port(e: net.Net_error, seen: Sz$@): Sz //< counts a refusal named bad_port
    if e == net.Net_error.bad_port
        seen$ += 1
    return 0

fn test_port_range()
    verdict.start("[Net] a port outside 0..65535 is refused by name on every entry...")
    $seen: Sz = 0
    for port in I32[]::{ 65536 + 18123, -1 }
        _l: = net.Tcp_listener.bind("127.0.0.1", port) catch e
            refused_port(e, seen@)
            fallback null
        _u: = net.Udp_socket.bind("127.0.0.1", port) catch e
            refused_port(e, seen@)
            fallback null
        _c: = net.Tcp_stream.connect("127.0.0.1", port) catch e
            refused_port(e, seen@)
            fallback null
        _n: = net.Tcp_stream.connect_nonblocking("127.0.0.1", port) catch e
            refused_port(e, seen@)
            fallback null
    u: = net.Udp_socket.bind("127.0.0.1", 0) catch panic("udp bind should succeed on port 0")
    _s: = u.send_to("x", "127.0.0.1", 65536 + 17655) catch e
        fallback refused_port(e, seen@)
    u.free()
    assert(seen == 9, "every entry refuses a port outside 0..65535 as bad_port")
    verdict
        .pass("bind, connect and send_to refuse a port outside 0..65535 by name rather than wrap \
            it.")

// ==========================================
// A child started while sockets are open holds none of them. Holding a copy, it would keep the
// port bound and the connection open for as long as it runs.
// ==========================================
fn test_child_holds_no_socket(ksplc: U8[]) //<
    //< That closing a listener and a connection takes effect while a child started meanwhile runs
    //<
    //< ksplc is the child (`run_std` passes it): `ksplc lsp` waits on its standard input, so it
    //< lives until that closes.
    verdict
        .start("[Net] a child started meanwhile holds no socket: the port binds again, and the peer \
            sees the close...")
    listener: = net.Tcp_listener.bind("127.0.0.1", 0) catch panic("bind should succeed on a free \
        port")
    port: = listener.port() catch panic("a bound socket knows its port")
    client: = net.Tcp_stream.connect("127.0.0.1", port) catch panic("connect should succeed once \
        the listener is bound")
    conn: = listener.accept() catch panic("accept should succeed once the client connects")
    $child: = subproc.spawn_piped(U8[][]::{ ksplc, "lsp" }, "") catch panic("the child must start")
    listener.free()
    conn.free()

    $rebound: = true
    again: = net.Tcp_listener.bind("127.0.0.1", port) catch
        rebound = false
        fallback null
    assert(rebound, "a closed listener's port binds again while a child started before is running")
    if again != null
        again.free()

    // **Wait with a bound**: were the connection held by the child, a plain read would never
    // return.
    client.set_nonblocking() catch panic("set_nonblocking should succeed on a connected socket")
    $r: = reactor.Reactor.new()
    defer r.free()
    r.register(client.raw_handle(), reactor.readable, 0)
    $ready: = r.wait(5000) catch panic("wait should succeed")
    seen: = ready.len == 1
    ready.free()
    assert(seen, "the peer sees the close while a child started before is running")
    $buf: U8[8] = ::{}
    got: = client.read(U8$[]::buf) catch panic("the read after the close should return the end")
    assert(got == 0, "the read after the peer closed returns the end, 0 bytes")
    client.free()
    child.close_stdin()
    child.kill()
    verdict
        .pass("A child started while a listener and a connection were open holds neither: the port \
            binds again and the peer sees the close at once.")

fn test_tcp_half_close() //<
    //< shut_write ends what this side sends, and it still reads the answer; raw_fd names the socket
    verdict.start("[Net] closing only the sending half, and the socket's raw number test...")
    listener: = net.Tcp_listener.bind("127.0.0.1", 0) catch panic("bind should succeed on a free \
        port")
    port: = listener.port() catch panic("a bound socket knows its port")
    t: =
        thread.Thread.spawn<|net.Tcp_listener|>(net_count_then_answer, listener) catch panic("thread spawn failed")
    client: = net.Tcp_stream.connect("127.0.0.1", port) catch panic("connect should succeed once \
        the listener is bound")
    assert(client.raw_fd() >= 0, "a connected stream has a socket number")
    client.write_all("hello") catch panic("client write should succeed")
    client.shut_write() catch panic("shut_write should succeed on a connected stream")
    $buf: U8[16] = ::{}
    n: = client.read(U8$[]::buf) catch panic("the answer should still be readable")
    assert(U8[]::{ .ptr = buf[0]@, .len = n }.equals("5"),
        "the peer saw the end after five bytes, and its answer still arrives")
    client.free()
    t.join_and_free()
    listener.free()
    verdict.pass("After shut_write the peer reads the end, and its answer still comes back.")

fn test_tcp_read_for() //<
    //< a read with a time limit ends at it on a quiet peer, and reads what comes
    verdict.start("[Net] a read that waits at most its timeout test...")
    listener: = net.Tcp_listener.bind("127.0.0.1", 0) catch panic("bind should succeed on a free \
        port")
    port: = listener.port() catch panic("a bound socket knows its port")
    // The connection is made before any accept, and the peer then says nothing.
    client: = net.Tcp_stream.connect("127.0.0.1", port) catch panic("connect should succeed once \
        the listener is bound")
    conn: = listener.accept() catch panic("accept should succeed once the client connects")
    $buf: U8[16] = ::{}
    $timed_out: = false
    _n: = client.read_for(U8$[]::buf, 200) catch e
        timed_out = e == net.Net_error.timed_out
        fallback 0
    assert(timed_out, "a quiet peer makes read_for fail as timed_out")
    conn.write_all("hi") catch panic("server write should succeed")
    n: = client.read_for(U8$[]::buf, 60000) catch panic("what the peer sent should be read")
    assert(U8[]::{ .ptr = buf[0]@, .len = n }.equals("hi"), "read_for reads what arrives")
    conn.free()
    client.free()
    listener.free()
    verdict.pass("read_for ends at its timeout on a quiet peer, and reads what the peer sends.")

//< Tests of `std/url`'s percent-encoding, and of `std/http` reading and writing a message
import "std/chars"
import "std/http"
import "std/http_body"
import "std/json" + { Json_builder }
import "std/jsonrpc"
import "std/mem" + { Arena, dealloc }
import "std/net"
import "std/str" { Str_builder }
import "std/tests/mem_test" { back_to }
import "std/thread"
import "std/url"
import "std/verdict"

// ==========================================
// std/url: tests of the percent-encoding round trip and of parsing a query string.
// ==========================================
priv fn pairs_text(q: url.Query, arena: Arena$@): U8[] //< each pair as `name=value|`, in order
    out: = arena.text()
    for p in q.each()
        out.s(p.name).c('=').s(p.value).c('|')
    return out.take()

fn test_url_codec()
    verdict.start("[Url] percent-encode/decode + parsing a query string test...")

    enc: = url.encode("hello world/?#", null)
    defer dealloc(Void$@::enc.ptr)
    enc_ok: = enc.equals("hello%20world%2F%3F%23")
    assert(enc_ok, "encode must percent-escape reserved characters")

    dec: = url.decode_component(enc, null)
        catch panic("decode of freshly encoded data should succeed")
    defer dealloc(Void$@::dec.ptr)
    assert(dec.equals("hello world/?#"), "decode must round-trip encode's output")

    // In a path, "+" is just a "+" (a space written as "+" is a form convention); otherwise a file
    // whose name contains "+" cannot be reached.
    path_plus: = url.decode_component("a+b%20c", null)
        catch panic("decode_component should succeed")
    defer dealloc(Void$@::path_plus.ptr)
    path_plus_ok: = path_plus.equals("a+b c")
    assert(path_plus_ok, "decode_component must leave '+' alone and still decode '%20'")

    $bad_decode_ok: = true
    _bad: = url.decode_component("%zz", null) catch
        bad_decode_ok = false
    assert(!bad_decode_ok, "decode must reject a malformed percent-escape")

    defer arena: = Arena(4096)
    params: = url.parse_query("?a=1&b=hello%20world&c", arena)
        catch panic("parse_query should succeed for well-formed input")
    assert(pairs_text(params, arena).equals("a=1|b=hello world|c=|"),
        "the pairs, in order, decoded, a value-less one with an empty value")
    assert(params.find("b").unwrap_or("").equals("hello world") &&
        params.find("zz").is_none(),
        "find gives the first value of that name, and nothing for an absent name")
    plus: = url.parse_query("a+b=c+d", arena)
        catch panic("parse_query should succeed for '+'-as-space input")
    assert(pairs_text(plus, arena).equals("a b=c d|"),
        "'+' must decode to a space (application/x-www-form-urlencoded convention)")

    // The result is the same with or without a leading '?'.
    bare: = url.parse_query("a=1&b=2", arena)
        catch panic("parse_query should accept a query string without the leading '?'")
    assert(pairs_text(bare, arena).equals("a=1|b=2|"),
        "parse_query must not require the leading '?'")

    // **An empty query is a query with no pairs**, never a missing one.
    for text in U8[][]::{ "", "?", "&&" }
        empty: = url.parse_query(text, arena) catch panic("an empty query parses")
        assert(empty.is_empty() && empty.find("a").is_none(), "an empty query holds no pair")

    // **Do not leak while refusing a malformed query.** Decoding returns a heap buffer, so if
    // decoding the value fails after the name is decoded, the name's buffer is never freed. Anyone
    // outside can send malformed queries without limit (to a server's `?path=`, for example), so
    // one leak per request makes resident memory grow without end. That breaks "resident memory
    // stays constant".
    before: = mem.heap_used_bytes()
    for _i in Range.asc(200)
        _leak: = url.parse_query("name=%zz", arena) catch
            continue
        panic("parse_query must reject a malformed percent-escape in the value")
    back_to(before, "rejecting a malformed query must not leave anything on the heap")

    verdict.pass("The percent-encode round trip and parsing a query string are confirmed.")

// ==========================================
// std/http: parsing one buffered message, request and response, with no socket.
// ==========================================
fn test_http_parse_buffered()
    verdict.start("[Http] buffered parsing (parse_request/parse_response) test...")

    defer arena: = Arena(4096)

    req: =
        http.parse_request("POST /echo?x=1 HTTP/1.1\r\nHost: example.com\r\nContent-Length: \
            5\r\n\r\nhello", http.DEFAULT_MAX_BODY_BYTES, arena)
        catch panic("parse_request should succeed for a well-formed request")
    assert(req.method.equals("POST"), "method must be parsed correctly")
    assert(req.target.equals("/echo?x=1"), "target must include the raw query string")
    assert(req.version.equals("HTTP/1.1"), "version must be parsed correctly")
    assert(req.body.equals("hello"), "body must be sliced by Content-Length")

    switch req.headers.find("host")
    case .some(v)
        assert(v.equals("example.com"), "Host header lookup must be case-insensitive")
    case .none
        panic("Host header should be found")

    resp: =
        http.parse_response("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n", arena)
        catch panic("parse_response should succeed for a well-formed response")
    reason_ok: = resp.reason.equals("Not Found")
    assert(resp.status == 404 && reason_ok, "status/reason must be parsed correctly")
    assert(resp.body.len == 0, "body must be empty when Content-Length is 0")

    $incomplete_ok: = true
    _r: =
        http.parse_request("GET / HTTP/1.1\r\n", http.DEFAULT_MAX_BODY_BYTES, arena) catch
        incomplete_ok = false
    assert(!incomplete_ok, "parse_request must reject a headerless-but-truncated message")

    // The body can be only partly in; sliced without a check, the view points outside the buffer.
    short_body: = "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhi"
    assert(parse_error(short_body, http.DEFAULT_MAX_BODY_BYTES, arena).equals("incomplete"),
        "parse_request must report incomplete while the body is still short")

    // **Both limits hold before the bytes arrive**: waiting for them is what a flood wants.
    assert(parse_error("POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhi", 4, arena)
        .equals("body_too_large"), "a body over the limit is refused as soon as the head names it")
    long_head: = arena.text().s("GET / HTTP/1.1\r\nX: ")
    for _k in Range.asc(http.MAX_HEAD_BYTES)
        long_head.c('a')
    assert(parse_error(long_head.take(), 4, arena).equals("head_too_large"),
        "a head past the limit with no end yet is refused, not waited for")
    assert(parse_error("GET / HTTP/1.1\r\nX: a", 4, arena).equals("incomplete"),
        "a short head with no end yet is waited for")

    // consumed is "the number of bytes this message used", and what follows is the next message.
    two: = "GET /a HTTP/1.1\r\nHost: h\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\n"
    first: = http.parse_request(two, http.DEFAULT_MAX_BODY_BYTES, arena)
        catch panic("the first of two pipelined requests must parse")
    assert(first.target.equals("/a"), "the first message must be the one parsed")
    assert(first.consumed == 28, "consumed must cover exactly the first message")
    second: =
        http.parse_request(two.sub_from(first.consumed), http.DEFAULT_MAX_BODY_BYTES, arena)
        catch panic("the remainder after consumed must be the next request")
    assert(second.target.equals("/b"), "consumed must land on the start of the next message")

    // format_response builds the whole message, leaving the sending to the caller.
    defer $out: = Str_builder()
    head: = http.headers(arena).add("Content-Type", "text/plain").build()
    http.format_response(out@, 200, head, "hi")
        catch panic("format_response should succeed for well-formed arguments")
    formatted_ok: = out.slice()
        .equals("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\nhi")
    assert(formatted_ok,
        "format_response must emit the status line, headers, an auto Content-Length, and the body")

    verdict
        .pass("Buffered parsing of a request and a response, incomplete for a body not yet in, \
            where consumed puts the next message, and format_response's byte sequence are all \
            confirmed.")

priv fn parse_error(src: U8[], max_body: Sz, arena: Arena$@): U8[] //<
    //< How `parse_request` refuses src with that body limit: the error's name, or `accepted`
    _r: = http.parse_request(src, max_body, arena) catch e
        switch e
        case .incomplete
            return "incomplete"
        case .head_too_large
            return "head_too_large"
        case .body_too_large
            return "body_too_large"
        case .invalid_host
            return "invalid_host"
        default
            return "another error"
    return "accepted"

// ==========================================
// std/http: input whose body boundary another implementation could read differently is refused.
// Request smuggling needs only a boundary one byte off from what the front server (a reverse
// proxy) reads. So "it can be interpreted somehow" is itself the hole.
// ==========================================
priv fn reject(label: U8$[], src: U8[])
    defer arena: = Arena(1024)
    $accepted: = true
    _r: = http.parse_request(src, http.DEFAULT_MAX_BODY_BYTES, arena) catch
        accepted = false
    assert(!accepted, label)

fn test_http_headers_list() //<
    //< A list of headers is a value even when empty, keeps its order, and finds names ignoring case
    //< Caution: **Test the empty list and a message with no header.** That is the case the list
    //< type exists for: nothing is reached through a pointer that can be null.
    verdict.start("[HTTP] the header list test...")
    defer arena: = Arena(64 * 1024)
    none: = http.headers(arena).build()
    assert(none.is_empty(), "a list nothing was added to is empty")
    assert(none.find("Host").is_none(), "an empty list finds nothing")
    $walked: Sz = 0
    for _h in none.each()
        walked += 1
    assert(walked == 0, "an empty list walks no header")

    two: = http.headers(arena).add("Accept", "a").add("ACCEPT", "b").build()
    assert(!two.is_empty(), "a list with headers is not empty")
    assert(two.find("accept").unwrap_or("").equals("a"), "find gives the first, ignoring case")
    seen: = arena.text()
    for h in two.each()
        seen.s(h.value)
    assert(seen.take().equals("ab"), "each walks the headers in the order they were added")

    bare: = http.parse_request("GET / HTTP/1.0\r\n\r\n", 0, arena)
        catch panic("a request with no header parses")
    assert(bare.headers.is_empty() && bare.headers.find("Host").is_none(),
        "a message with no header has an empty list")
    verdict.pass("An empty header list answers like any other, and a full one keeps its order.")

fn test_http_reject_smuggling()
    verdict.start("[Http] refusing input whose boundary is read differently test...")

    // Many implementations end a line at a bare LF. The front server sees two Content-Lengths and a
    // 44-byte body; this parser sees one header and 0 bytes, and the 44 bytes start the next
    // request.
    reject("bare LF in a header line must be rejected",
        "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 0\nContent-Length: 44\r\n\r\n")
    reject("bare LF in the request line must be rejected", "GET / HTTP/1.1\nHost: evil\r\n\r\n")
    reject("bare CR inside a header value must be rejected", "GET / HTTP/1.1\r\nX: a\rb\r\n\r\n")

    // Whitespace before the colon, and a continuation line: the front server sees "an unknown
    // header", this parser sees Content-Length.
    reject("whitespace before the colon must be rejected",
        "POST / HTTP/1.1\r\nContent-Length : 5\r\n\r\nhello")
    reject("an obs-fold continuation line must be rejected",
        "POST / HTTP/1.1\r\nHost: a\r\n Content-Length: 5\r\n\r\nhello")
    reject("a header name that is not a token must be rejected", "GET / HTTP/1.1\r\nX Y: 1\r\n\r\n")
    reject("a control character in a header value must be rejected",
        "GET / HTTP/1.1\r\nX: a\0b\r\n\r\n")

    // parse_size scans, so given the raw value it reads `5abc` as 5 and also skips the sign of
    // `+5`.
    reject("Content-Length with trailing garbage must be rejected",
        "POST / HTTP/1.1\r\nContent-Length: 5abc\r\n\r\nhello")
    reject("a signed Content-Length must be rejected",
        "POST / HTTP/1.1\r\nContent-Length: +5\r\n\r\nhello")
    reject("an empty Content-Length must be rejected",
        "POST / HTTP/1.1\r\nContent-Length: \r\n\r\nhello")

    reject("an empty method must be rejected", " / HTTP/1.1\r\n\r\n")
    reject("an empty target must be rejected", "GET  HTTP/1.1\r\n\r\n")
    reject("a malformed version must be rejected", "GET / HTTP/1.1x\r\n\r\n")
    // `write_request` refuses these targets, so the reader must not take what the writer refuses.
    reject("a tab in the target must be rejected", "GET /a\tb HTTP/1.1\r\n\r\n")
    reject("a control byte in the target must be rejected", "GET /a\0b HTTP/1.1\r\n\r\n")

    // Caution: **Include a value that wraps to a negative.** Only parse_int_core's 18-digit limit
    // refuses it; one that wraps to a positive is caught by the body-length check even with no
    // limit.
    reject("a Content-Length that wraps to a negative Sz must be rejected",
        "POST / HTTP/1.1\r\nContent-Length: 10000000000000000000\r\n\r\n hi")
    // Empty input, and input with no line at all, must not crash.
    // **A request names its host once** (RFC 9112 §3.2). A proxy in front can take another `Host`
    // than the server. It then routes the request by a name the server never checked.
    defer arena_h: = Arena(1024)
    for twice in U8[][]::{ "GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: a\r\nhost: a\r\n\r\n",
        "GET / HTTP/1.0\r\nHost: a\r\nHost: b\r\n\r\n" }
        assert(parse_error(twice, http.DEFAULT_MAX_BODY_BYTES, arena_h).equals("invalid_host"),
            "a request naming Host twice must be refused as invalid_host")
        $head_ok: = true
        _h: =
            http.parse_request_head(twice, http.DEFAULT_MAX_BODY_BYTES, arena_h) catch
            head_ok = false
            fallback null
        assert(!head_ok, "parse_request_head must refuse what parse_request refuses")
    assert(parse_error("GET / HTTP/1.1\r\n\r\n", http.DEFAULT_MAX_BODY_BYTES, arena_h)
        .equals("invalid_host"), "an HTTP/1.1 request naming no Host must be refused")
    // Caution: **HTTP/1.0 can leave it out**, which a refusal of every missing Host would break.
    assert(parse_error("GET / HTTP/1.0\r\n\r\n", http.DEFAULT_MAX_BODY_BYTES, arena_h)
        .equals("accepted"), "an HTTP/1.0 request naming no Host must be read")

    reject("an empty request must be rejected", "")
    reject("a request line with no terminator must be rejected", "GET / HTTP/1.1")
    reject("an empty header name must be rejected", "GET / HTTP/1.1\r\n: v\r\n\r\n")

    // A status not 3 digits would be silently truncated by I32:: into a different number.
    defer arena: = Arena(1024)
    $status_ok: = true
    _resp: = http.parse_response("HTTP/1.1 4294967496 x\r\n\r\n", arena) catch
        status_ok = false
    assert(!status_ok, "a status code that is not 3 digits must be rejected")
    // A status below 100 would carry no body, so its body would be read as the next response.
    assert(!response_error("HTTP/1.1 099 x\r\nContent-Length: 2\r\n\r\nhi", arena)
        .equals("accepted"), "a status below 100 must be rejected")
    assert(!response_error("HTTP/1.1 600 x\r\nContent-Length: 0\r\n\r\n", arena).equals("accepted"),
        "a status above 599 must be rejected")

    // The builder goes through the same checks, so a value from outside cannot splice in a header.
    defer $out: = Str_builder()
    bad_head: = http.headers(arena).add("X", "a\r\nInjected: 1").build()
    $inject_ok: = true
    out.s("an answer queued before\n")
    http.format_response(out@, 200, bad_head, "") catch
        inject_ok = false
    assert(!inject_ok, "format_response must reject a CRLF-bearing header value")
    // **A refused build leaves nothing behind**: a half head would be sent before the next answer.
    http.format_response_to_head(out@, 200, bad_head, 3) catch {}
    http.format_response_head(out@, 200,
        http.headers(arena).add("Connection", "close").add("X", "a\r\nInjected: 1").build()) catch {}
    assert(out.slice().equals("an answer queued before\n"),
        "a refused build must leave the builder as it was")
    // **A value with a space or tab at either end is refused too.** The reader trims it, so the
    // value read back would not be the value written.
    for padded in U8[][]::{ " a", "a ", "a\t" }
        $response_kept: = true
        http.format_response(out@, 200, http.headers(arena).add("X", padded).build(), "") catch
            response_kept = false
        $request_kept: = true
        http.format_request(out@, "GET", "/",
            http.headers(arena).add("Host", "h").add("X", padded).build(), "") catch
            request_kept = false
        assert(!response_kept && !request_kept,
            "a header value with a space at either end must be refused when written")
    assert(out.slice().equals("an answer queued before\n"),
        "a refused build must leave the builder as it was")

    verdict
        .pass("A bare CR/LF, a header name that is not a token, a continuation line, a \
            Content-Length that is not 1*DIGIT, a status outside 100 to 599, a target with a tab or \
            a control byte, a Host given twice or missing on HTTP/1.1, and a CRLF or a space at a \
            value's end slipped in while building are all refused, the builder left as it was.")

// ==========================================
// std/http: a `Host` value is a host and an optional port, and nothing else (RFC 9112 §3.2).
// Two readers reading one value differently route one request to two hosts.
// ==========================================
fn test_http_host_value()
    verdict.start("[Http] the Host value test...")
    defer arena: = Arena(4096)
    for good in U8[][]::{ "example.com", "example.com:8080", "127.0.0.1:80", "[::1]:8080",
        "[v1.fe]", "ex%41mple", "a-b_c.~!$&'()*+,;=", "host:", "" }
        req: = arena.text().s("GET / HTTP/1.1\r\nHost: ").s(good).s("\r\n\r\n").take()
        assert(parse_error(req, http.DEFAULT_MAX_BODY_BYTES, arena).equals("accepted"),
            "a host, optionally with a port, must be read")
    for bad in U8[][]::{ "user@example.com", "example.com/x", "a b", "a\"b", "host:http",
        "host:65536", "host:1:2", "::1", "[::1", "[]", "[::1]x", "ex%4", "ex%zz" }
        req: = arena.text().s("GET / HTTP/1.0\r\nHost: ").s(bad).s("\r\n\r\n").take()
        assert(parse_error(req, http.DEFAULT_MAX_BODY_BYTES, arena).equals("invalid_host"),
            "a Host value that is not a host and a port must be refused, on HTTP/1.0 too")
        $head_ok: = true
        _h: = http.parse_request_head(req, http.DEFAULT_MAX_BODY_BYTES, arena) catch
            head_ok = false
            fallback null
        assert(!head_ok, "parse_request_head must refuse what parse_request refuses")
    // One answer to "HTTP/1.1 or later", which the Host rule and a connection's default share.
    assert(http.is_1_1_or_later("HTTP/1.1") && http.is_1_1_or_later("HTTP/2.0"),
        "1.1 and later versions are 1.1 or later")
    assert(!http.is_1_1_or_later("HTTP/1.0") && !http.is_1_1_or_later("HTTP/0.9"),
        "earlier versions are not")
    assert(!http.is_1_1_or_later("HTTP/11") && !http.is_1_1_or_later(""),
        "text that is not a version is not later")
    verdict
        .pass("A host with an optional port is read; userinfo, a path, a bad byte, a bad port and a \
            broken IP literal are refused.")

// ==========================================
// std/http: the builder writes no length its own reader would cut elsewhere.
// ==========================================
priv fn closes(head: U8[], arena: Arena$@): Bool //< whether the request with that head closes
    req: =
        http.parse_request(arena.text().s(head).s("Host: h\r\n\r\n").take(),
        http.DEFAULT_MAX_BODY_BYTES, arena) catch panic("the request head must parse")
    return req.wants_close()

fn test_http_connection_tokens() //< `Connection` is a list of tokens, possibly in several headers
    verdict.start("[Http] the tokens a Connection header lists test...")
    defer arena: = Arena(4096)
    assert(http.lists_token("close", "close") &&
        http.lists_token("keep-alive , CLOSE", "close"),
        "lists_token: a token is found among others, in any case and with spaces around it")
    assert(!http.lists_token("closed, x-close", "close") && !http.lists_token("", "close"),
        "lists_token: a longer word holding the token is not the token")
    assert(!closes("GET / HTTP/1.1\r\n", arena) && closes("GET / HTTP/1.0\r\n", arena),
        "wants_close: HTTP/1.1 stays open and HTTP/1.0 closes, when nothing is asked")
    assert(!closes("GET / HTTP/1.0\r\nConnection: Keep-Alive\r\n", arena),
        "wants_close: HTTP/1.0 stays open when it asks for keep-alive")
    assert(closes("GET / HTTP/1.1\r\nConnection: TE\r\nConnection: keep-alive, close\r\n", arena),
        "wants_close: a close in a later Connection header closes")
    // **The streamed head finds `close` the way a reader does**, among other tokens.
    defer $out: = Str_builder()
    listed: = http.headers(arena).add("Connection", "TE").add("Connection", "upgrade, close")
        .build()
    http.format_response_head(out@, 200, listed)
        catch panic("format_response_head should accept a close among the tokens")
    open_only: = http.headers(arena).add("Connection", "closed").build()
    assert(http.format_response_head(out@, 200, open_only).is_err(),
        "format_response_head: a token that only starts with close is not close")
    verdict.pass("A Connection header is read as a list, on both the reader and the writer.")

fn test_http_write_length()
    verdict.start("[Http] the length the builder writes test...")
    defer arena: = Arena(4096)

    // **A length the body does not have splits the message in two** for the reader. The rest of the
    // body is read as the next response.
    short: = http.headers(arena).add("Content-Length", "3").build()
    assert(build_error(200, short, "0123456789", arena).equals("length_mismatch"),
        "a Content-Length that is not the body's must be refused")
    chunked: = http.headers(arena).add("Transfer-Encoding", "chunked").build()
    assert(build_error(200, chunked, "hello", arena).equals("unsupported_transfer_encoding"),
        "Transfer-Encoding must be refused, as the reader refuses it")
    twice: = http.headers(arena).add("Content-Length", "2").add("Content-Length", "2").build()
    assert(build_error(200, twice, "hi", arena).equals("length_mismatch"),
        "a Content-Length given twice must be refused")
    right: = http.headers(arena).add("Content-Length", "2").build()
    assert(built(200, right, "hi", arena).equals("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi"),
        "the body's own length, given, is written once")

    // **1xx, 204 and 304 name no length** (RFC 9110 §8.6), and carry no body.
    no_content: = built(204, http.headers(arena).build(), "", arena)
    assert(no_content.equals("HTTP/1.1 204 No Content\r\n\r\n"), "a 204 names no length")
    back: = http.parse_response(no_content, arena)
        catch panic("the reader must read the 204 the builder wrote")
    assert(back.consumed == no_content.len, "the reader ends the 204 where the builder ended it")
    assert(build_error(204, http.headers(arena).build(), "x", arena).equals("length_mismatch"),
        "a body on a 204 must be refused")
    stated: = http.headers(arena).add("Content-Length", "5").build()
    assert(build_error(304, stated, "", arena).equals("length_mismatch"),
        "a length on a 304 must be refused")

    // **The answer to a HEAD names the length of a body it does not carry**, its own way in.
    defer $out: = Str_builder()
    http.format_response_to_head(out@, 200, http.headers(arena).build(), 10)
        catch panic("format_response_to_head should succeed for a 200")
    assert(out.slice().equals("HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\n"),
        "the answer to a HEAD names the length and carries no body")
    out.clear()
    closing: = http.headers(arena).add("Connection", "close").add("Transfer-Encoding", "chunked")
        .build()
    $streamed_ok: = true
    http.format_response_head(out@, 200, closing) catch
        streamed_ok = false
    assert(!streamed_ok, "a streamed head must refuse Transfer-Encoding too")
    // **A number with no standard phrase gets none**, not one made up, and the line stays readable.
    assert(http.reason_phrase(404).unwrap_or("").equals("Not Found") &&
        http.reason_phrase(299).is_none() && http.reason_phrase(-1).is_none(),
        "reason_phrase: the standard phrase, or none")
    out.clear()
    http.format_response_to_head(out@, 299, http.headers(arena).build(), 0)
        catch panic("format_response_to_head should succeed for a number with no phrase")
    assert(out.slice().starts_with("HTTP/1.1 299 \r\n"),
        "a number with no phrase writes the space before an empty phrase")
    verdict
        .pass("A length that is not the body's, Transfer-Encoding, a length given twice, and a \
            length or body on 204 and 304 are refused; a HEAD's answer names the length alone; a \
            number with no standard phrase gets none.")

priv fn built(status: I32, head: http.Headers, body: U8[], arena: Arena$@): U8[] //<
    //< The bytes `format_response` builds, or a panic where it refuses
    defer $out: = Str_builder()
    http.format_response(out@, status, head, body)
        catch panic("format_response should succeed here")
    return arena.dup_str(out.slice())

priv fn build_error(status: I32, head: http.Headers, body: U8[], arena: Arena$@): U8[] //<
    //< How `format_response` refuses: the error's name, or `accepted`
    defer $out: = Str_builder()
    http.format_response(out@, status, head, body) catch e
        switch e
        case .length_mismatch
            return "length_mismatch"
        case .unsupported_transfer_encoding
            return "unsupported_transfer_encoding"
        default
            return "another error"
    return arena.dup_str("accepted")

// ==========================================
// std/http: where a response's body ends, read from its status and its head (RFC 9112 §6.3).
// ==========================================
fn test_http_response_length()
    verdict.start("[Http] the length of a response's body test...")
    defer arena: = Arena(4096)

    // **A body that runs to the close is refused, not read as empty**: success with no body would
    // drop it silently. These are the bytes `format_response_head` builds, and a body after them.
    defer $streamed: = Str_builder()
    http.format_response_head(streamed@, 200,
        http.headers(arena).add("Connection", "close").build())
        catch panic("format_response_head should succeed with Connection: close")
    streamed.s("hello world")
    assert(response_error(streamed.slice(), arena).equals("unsupported_close_delimited"),
        "a response that may have a body but names no length must be refused")

    // A status that never has a body ends at the head, whatever the head says of a length.
    none: = http.parse_response("HTTP/1.1 204 No Content\r\n\r\n", arena)
        catch panic("a 204 with no length must parse")
    assert(none.body.len == 0 && none.consumed == 27, "a 204 has no body")
    two: = "HTTP/1.1 304 Not Modified\r\nContent-Length: 5\r\n\r\nHTTP/1.1 200 OK\r\n"
    not_mod: = http.parse_response(two, arena)
        catch panic("a 304 naming its representation's length must parse")
    assert(not_mod.body.len == 0 && not_mod.consumed == 48,
        "a 304's Content-Length names the representation, not a body that follows")
    verdict
        .pass("A response with no length that may have a body is refused, and 204 and 304 end at \
            their head.")

priv fn response_error(src: U8[], arena: Arena$@): U8[] //<
    //< How `parse_response` refuses src: the error's name, or `accepted`
    _r: = http.parse_response(src, arena) catch e
        switch e
        case .unsupported_close_delimited
            return "unsupported_close_delimited"
        case .incomplete
            return "incomplete"
        default
            return "another error"
    return "accepted"

// ==========================================
// std/http: the round trip of reading and writing a request and a response over a real TCP socket.
// ==========================================
#export
fn http_echo_server(listener: net.Tcp_listener$@): Void$@
    defer server_arena: = Arena(64 * 1024)
    conn: = listener.accept() catch panic("accept should succeed once the client connects")
    // A server parses what has arrived so far, and reads more while the request is incomplete.
    defer $got: = Str_builder()
    $req: http.Request$@ = null
    for req == null
        $chunk: U8[256] = ::{}
        n: = conn.read(U8$[]::chunk) catch panic("server read should succeed")
        assert(n > 0, "the client must not close before its request is whole")
        got.s(U8[]::{ .ptr = chunk[0]@, .len = n })
        req =
            http.parse_request(got.slice(), http.DEFAULT_MAX_BODY_BYTES, server_arena) catch e
            switch e
            case .incomplete {}
            default
                panic("server parse_request should succeed once the request is whole")
            fallback null
    req_ok: =
        req.method.equals("POST") && req.target.equals("/echo") && req.body.equals("ping")
    assert(req_ok, "server must parse the client's request correctly")

    resp_headers: = http.headers(server_arena).add("Content-Type", "text/plain").build()
    defer $out: = Str_builder()
    defer $body: = Str_builder()
    for _i in Range.asc(4096)
        body.s("pong")
    http.format_response(out@, 200, resp_headers, body.slice())
        catch panic("server format_response should succeed")
    conn.write_all(out.slice()) catch panic("server write_all should succeed")
    conn.free()
    return null

fn test_http_socket_roundtrip()
    verdict
        .start("[Http] parse_request/format_response/write_request/read_response test (real \
            loopback traffic)...")

    defer arena: = Arena(64 * 1024)
    listener: = net.Tcp_listener.bind("127.0.0.1", 0)
        catch panic("bind should succeed on a free port")
    port: = listener.port() catch panic("a bound socket knows its port")
    t: = thread.Thread.spawn<|net.Tcp_listener|>(http_echo_server, listener)
        catch panic("thread spawn failed")

    client: = net.Tcp_stream.connect("127.0.0.1", port)
        catch panic("connect should succeed once the listener is bound")
    // A tab splits the request line for a lenient server as a space does. So it is refused before
    // anything is written. The round trip below then shows the connection was left clean.
    for bad in U8[][]::{ "/a b", "/a\tb" }
        $refused: = false
        http.write_request(client, "GET", bad, http.headers(arena).build(), "", 60000) catch e
            switch e
            case .invalid_request_line
                refused = true
            default {}
        assert(refused, "write_request must refuse whitespace inside the target")
    // A request's length is the body's too, refused before anything is written.
    $mismatch: = false
    http.write_request(client, "POST", "/echo",
        http.headers(arena).add("Content-Length", "1").build(), "ping", 60000) catch e
        switch e
        case .length_mismatch
            mismatch = true
        default {}
    assert(mismatch, "write_request must refuse a Content-Length that is not the body's")
    // **The writer refuses what the reader refuses**: no `Host`, two, or one that is not a host.
    for bad_host in http.Headers[]::{ http.headers(arena).build(),
        http.headers(arena).add("Host", "a").add("Host", "b").build(),
        http.headers(arena).add("Host", "user@a").build() }
        $host_refused: = false
        http.write_request(client, "GET", "/", bad_host, "", 60000) catch e
            switch e
            case .invalid_host
                host_refused = true
            default {}
        assert(host_refused,
            "write_request must refuse a head naming Host other than once, or not as a host")
    req_headers: = http.headers(arena).add("Host", "example.com").build()
    http.write_request(client, "POST", "/echo", req_headers, "ping", 60000)
        catch panic("client write_request should succeed")
    defer resp: =
        http_body.read_response(client, null, http.DEFAULT_MAX_BODY_BYTES, 60000)
        catch panic("client read_response should succeed")
    resp_ok: =
        resp.status == 200 && resp.version.equals("HTTP/1.1") && resp.reason.equals("OK") &&
        resp.body.len == 16384 && resp.body.count_str("pong") == 4096
    assert(resp_ok, "client must parse the server's response correctly")
    switch resp.headers.find("content-type")
    case .some(v)
        assert(v.equals("text/plain"), "Content-Type header must round-trip correctly")
    case .none
        panic("Content-Type header should be found")

    client.free()
    t.join_and_free()
    listener.free()
    verdict.pass("The HTTP request/response round trip over a real socket is confirmed.")

// ==========================================
// Tests of extracting a JSON-RPC frame from a stream and of building one (`std/jsonrpc`)
// Caution: **Always include a case where a read's boundary and a frame's boundary differ.**
// Otherwise the tests pass without ever extracting from a backlog. **Check that the next frame is
// still readable after a broken header.** A broken header that is not discarded fails forever.
// ==========================================
priv fn taken_or(acc: Str_builder$@, arena: Arena$@): U8[]
    got: = jsonrpc.take_frame(acc, jsonrpc.MAX_BODY_BYTES, arena) catch
        return "(broken)"
    switch got
    case .some(body)
        return body
    case .none
        return "(none)"

priv fn length_or(head: U8[]): Sz //<
    //< The length `head` declares under a limit of 100
    //< -1 where it declares none, -2 where it is broken.
    got: = jsonrpc.content_length(head, 100) catch
        return -2
    return got.unwrap_or(-1)

fn test_jsonrpc_take_frame()
    verdict.start("[Jsonrpc] cutting a frame out test...")
    defer arena: = Arena(64 * 1024)
    defer $acc: = Str_builder()

    // With only the header in, no frame can be extracted.
    acc.s("Content-Length: 5\r\n\r\n")
    assert(taken_or(acc@, arena).equals("(none)"), "head only must not yield a frame")
    // No frame can be extracted while the body is still short either.
    acc.s("ab")
    assert(taken_or(acc@, arena).equals("(none)"), "short body must not yield a frame")
    // A frame is returned as soon as all of it is in.
    acc.s("cde")
    assert(taken_or(acc@, arena).equals("abcde"), "complete frame must be returned")
    assert(taken_or(acc@, arena).equals("(none)"), "the frame must be consumed")

    // One read brings two frames: the second must remain.
    acc.s("Content-Length: 2\r\n\r\nhiContent-Length: 3\r\n\r\nbye")
    assert(taken_or(acc@, arena).equals("hi"), "first of two frames")
    assert(taken_or(acc@, arena).equals("bye"), "second of two frames")
    assert(taken_or(acc@, arena).equals("(none)"), "both frames must be consumed")

    // The length can be read even with other headers mixed in.
    acc.s("Content-Type: application/json\r\nContent-Length: 2\r\n\r\nok")
    assert(taken_or(acc@, arena).equals("ok"), "length must be found among other headers")
    assert(length_or("Content-Length:  7\r\n") == 7, "spaces before the digits")
    assert(length_or("Content-Type: x\r\n") == -1, "no length is none")
    assert(length_or("Content-Type: x\r\ncontent-length: 3") == 3, "the name in any case")
    assert(length_or("X-Content-Length: 3") == -1, "the name only at a line's start")
    assert(length_or("Content-Length: 1x") == -2, "digits alone, or it is broken")
    assert(length_or("Content-Length: 100") == 100, "the limit itself")
    assert(length_or("Content-Length: 101") == -2, "past the limit is broken")
    // **Two lengths that differ are broken**: a reader taking the other one cuts the frame
    // elsewhere.
    assert(length_or("Content-Length: 2\r\nContent-Length: 4") == -2,
        "two lengths that differ are broken")
    assert(length_or("Content-Length: 2\r\ncontent-length: x") == -2,
        "a second length unreadable is broken")
    assert(length_or("Content-Length: 2\r\ncontent-length:  2") == 2, "the same length twice")
    verdict
        .pass("A frame that crosses a read's boundary, and two frames from one read, are both cut \
            out in order.")

fn test_jsonrpc_broken_frame()
    verdict.start("[Jsonrpc] a broken frame test...")
    defer arena: = Arena(64 * 1024)
    defer $acc: = Str_builder()

    // A header that gives no length is broken; the next frame must still be readable.
    acc.s("Content-Type: application/json\r\n\r\nContent-Length: 4\r\n\r\nnext")
    assert(taken_or(acc@, arena).equals("(broken)"), "a head without a length is broken")
    assert(taken_or(acc@, arena).equals("next"), "the next frame must still be readable")

    // A length above the cap is broken.
    defer $huge: = Str_builder()
    huge.s("Content-Length: \{jsonrpc.MAX_BODY_BYTES + 1\}\r\n\r\n")
    acc.s(huge.slice())
    assert(taken_or(acc@, arena).equals("(broken)"), "a length above the cap is broken")

    // **A head that never ends is broken too**, and dropped: kept, it grew for good.
    acc.len = 0
    for _i in Range.asc(jsonrpc.MAX_HEAD_BYTES / 8 + 1)
        acc.s("X: aaaa ")
    assert(taken_or(acc@, arena).equals("(broken)"), "a head past its cap without an end is broken")
    assert(acc.len == 0, "the head past its cap is dropped")
    acc.s("Content-Length: 2\r\n\r\nok")
    assert(taken_or(acc@, arena).equals("ok"), "the next frame must still be readable")
    // **The cap counts the head's bytes, not a read's.** A head that ends past it is broken when
    // it arrives whole too, as it is when its bytes arrive one by one. At the cap it is read.
    for over in Sz[]::{ 0, 1 }
        tail: U8[] = "\r\nContent-Length: 2\r\n\r\n"
        acc.len = 0
        acc.s("X: ")
        for _i in Range.asc(jsonrpc.MAX_HEAD_BYTES - 3 - tail.len + over)
            acc.c('a')
        acc.s(tail).s("ok")
        assert(taken_or(acc@, arena).equals("ok" if over == 0 else "(broken)"),
            "a head is read up to its cap, and past it is broken however it arrives")

    // **The reader's own limit decides.** A body past the default, under a reader's larger limit,
    // is taken whole. The frame after it is read where it starts.
    defer $wide: = Str_builder()
    wide.s("Content-Length: 150\r\n\r\n")
    for _i in Range.asc(150)
        wide.c('x')
    wide.s("Content-Length: 4\r\n\r\nnext")
    big: = jsonrpc.take_frame(wide@, 200, arena)
        catch panic("a body under the reader's limit is read")
    assert(big.unwrap_or("").len == 150, "the body is taken whole")
    after: = jsonrpc.take_frame(wide@, 200, arena) catch panic("the frame after it is read")
    assert(after.unwrap_or("").equals("next"), "the frame after it starts where it should")
    verdict
        .pass("A head that names no length, a length above the cap and a head that never ends come \
            back as broken, and reading carries on after; a reader's own limit is the one kept.")

fn test_jsonrpc_encode()
    verdict.start("[Jsonrpc] building a body test...")
    defer arena: = Arena(64 * 1024)
    $b: = Json_builder(arena)
    params: = b.obj().set("n", b.int_val(7I64)).build()

    // With an id (a request).
    req: = jsonrpc.encode("ping", params, 3, arena)
    assert(req.find_str("\"id\":3").is_some(), "a request must carry its id")
    assert(req.find_str("\"jsonrpc\":\"2.0\"").is_some(), "the version must be named")
    assert(req.find_str("\"method\":\"ping\"").is_some(), "the method must be named")

    // Without an id (a notification). A negative id means "do not write one".
    note: = jsonrpc.encode("ping", params, -1, arena)
    assert(note.find_str("\"id\"").is_none(), "a notification must not carry an id")

    // A built frame can be extracted again (the round trip).
    defer $out: = Str_builder()
    jsonrpc.frame_into(out@, req)
    body: = jsonrpc.take_frame(out@, jsonrpc.MAX_BODY_BYTES, arena)
        catch panic("a freshly framed body must be takeable")
    switch body
    case .some(text)
        doc: = json.parse(text, arena) catch panic("the framed body must parse as JSON")
        assert(doc.val.get("id").as_int().unwrap_or(-1) == 3, "the id must survive the round trip")
        assert(doc.val.get("params").get("n").as_int().unwrap_or(0) == 7,
            "the params must survive the round trip")
    case .none
        panic("a complete frame must be returned")
    verdict
        .pass("A notification and a round trip are written apart by whether there is an id, and a \
            body goes into a frame and back.")

fn test_http_request_head()
    verdict.start("[Http] request heads validate before the body arrives...")
    src: = "PUT /x HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5\r\n\r\n"
    defer r: = http.parse_request_head(src, 10, null) catch panic("valid head")
    assert(r.method.equals("PUT") && r.target.equals("/x"), "the head preserves its request line")
    assert(r.body.len == 0 && r.body_length == 5 && r.consumed == src.len,
        "the head reports the expected body without reading it")
    $incomplete: = false
    _full: = http.parse_request(src, 10, null) catch e
        switch e
        case .incomplete
            incomplete = true
        default
            panic("the complete reader must report incomplete")
        fallback null
    assert(incomplete, "a head is not a complete request")
    for bad in U8[][]::{ "PUT /x HTTP/1.1\r\nHost: localhost\r\nContent-Length: 11\r\n\r\n",
            "PUT /x HTTP/1.1\r\nHost: localhost\r\nHost: other\r\n\r\n",
            "PUT /x HTTP/1.1\r\nHost: localhost\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\n",
    }
        $refused: = false
        _bad: = http.parse_request_head(bad, 10, null) catch
            refused = true
            fallback null
        assert(refused, "a head enforces body limits and rejects ambiguous headers")
    verdict.pass("Request heads expose validated metadata without waiting for the body.")

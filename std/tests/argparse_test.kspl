//< Tests of `std/argparse` through `parse_list`
//<
//< `sys.Args` reads libc's argv and cannot be faked. The list holds no executable name (`parse`
//< drops it).
import "std/argparse"
import "std/chars" // `starts_with`
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/subproc"
import "std/tests/sys_test"
import "std/verdict"

priv fn argv_of(items: U8[][], arena: Arena$@): List<|U8[]|>$@
    l: = List<|U8[]|>.create(arena)
    for i in Range.asc(items.len)
        l.push(items[i])
    return l

fn test_argparse(arena: Arena$@)
    verdict.start("[argparse] parsing command line arguments test...")

    check_defaults_and_joined(arena)
    check_rest(arena)
    check_errors(arena)
    check_required_and_help(arena)
    check_usage_layout(arena)

    test_no_short_names(arena)
    test_repeatable(arena)
    test_commands(arena)
    test_trailing(arena)
    test_operands_marker(arena)

    verdict
        .pass("Defaults, the `=` shape and refusing the spaced one, rest, refusing a single dash, \
            each error, what is required, --help, refusing short forms, repetition, commands, the \
            uninterpreted remainder and `--` are all confirmed.")

priv fn check_usage_layout(arena: Arena$@) //<
    //< padding includes suffixes, with a space for long names
    $flag: = false
    $text: U8[] = ""
    $count: I64 = 0
    values: = List<|U8[]|>.create(arena)
    p: = argparse.Parser.create("t", "about", arena)
    p.positional("<file>")
    p.subcommand("build", "compile")
    p.subcommand_trailing("run", "execute", values)
    p.subcommand_hidden("worker") // listed nowhere below: the usage leaves it out
    p.flag("--quiet", flag@, "silent")
    p.flag("--a-name-longer-than-the-column", flag@, "long")
    p.str_required("--name", text@, "name")
    p.int_opt("--count", count@, "count")
    p.str_list_opt("--item", values, "repeat")
    p.command_flag("--version", "version")
    $out: = str.Str_builder.new()
    p.print_usage(out@)
    expected: U8[] =
        "Usage: t [command] [options] \
            <file>\n\nabout\n\nCommands:\n\u0020\u0020build                    \
            compile\n\u0020\u0020run <target> [args...]   \
            execute\n\nOptions:\n\u0020\u0020--quiet                  \
            silent\n\u0020\u0020--a-name-longer-than-the-column \
            long\n\u0020\u0020--name=<str>             name \
            (required)\n\u0020\u0020--count=<int>            \
            count\n\u0020\u0020--item=<str>             \
            repeat\n\u0020\u0020--version                \
            version\n\u0020\u0020--help                   show this usage\n"
    assert(out.slice().equals(expected), "argparse: help layout is exact for every declaration kind")
    // `print_options` is the usage from its first list on, with no heading.
    $options: = str.Str_builder.new()
    p.print_options(options@)
    from_lists: = expected.sub_from(expected.find_str("\nCommands:").unwrap_or(0))
    assert(options.slice().equals(from_lists), "argparse: print_options writes the lists alone")
    // `append_names` gives every declared name in order, and adds to what the list holds.
    names: = List<|U8[]|>.create(arena)
    names.push("kept")
    p.append_names(names)
    joined: = " ".join(names.slice(), arena)
    in_order: = joined
        .equals("kept --quiet --a-name-longer-than-the-column --name --count --item --version")
    assert(in_order,
        "argparse: append_names pushes each declared name, in order, after what was there")

priv fn check_defaults_and_joined(arena: Arena$@) //<
    //< A default is the variable's initial value itself, and a value is joined with `=`
    $out: U8[] = "default.jsonl"
    $count: I64 = 10
    $verbose: = false
    p: = argparse.Parser.create("t", "", arena)
    p.str_opt("--out", out@, "where to write")
    p.int_opt("--count", count@, "how many")
    p.flag("--verbose", verbose@, "in detail")

    p.parse_list(argv_of(U8[][]::{}, arena)) catch panic("argparse: an empty argument list failed")
    kept_defaults: = out.equals("default.jsonl") && count == 10 && !verbose
    assert(kept_defaults, "argparse: the default stays when nothing is handed over")

    // A value is joined with `=`.
    joined: = argv_of(U8[][]::{ "--out=a.txt", "--count=3", "--verbose" }, arena)
    p.parse_list(joined) catch panic("argparse: the --name=value shape failed")
    assert(out.equals("a.txt") && count == 3 && verbose, "argparse: --name=value")

    $out2: U8[] = ""
    $count2: I64 = 0
    q: = argparse.Parser.create("t", "", arena)
    q.str_opt("--out", out2@, "")
    q.int_opt("--count", count2@, "")
    q.parse_list(argv_of(U8[][]::{ "--out=b.txt", "--count=-7" }, arena))
        catch panic("argparse: the --name=value shape failed")
    assert(out2.equals("b.txt") && count2 == -7,
        "argparse: --name=value (a negative number reads too)")

priv fn check_rest(arena: Arena$@) //< an argument that is not an option goes into rest, in order
    $dummy: = false
    rp: = argparse.Parser.create("t", "", arena)
    rp.positional("<file>...")
    rp.flag("--v", dummy@, "")
    rp.parse_list(argv_of(U8[][]::{ "one", "--v", "two" }, arena))
        catch panic("argparse: collecting rest failed")
    rest_ok: =
        rp.rest.len == 2 && rp.rest.get(0).equals("one") && rp.rest.get(1).equals("two")
    assert(rest_ok, "argparse: an argument that is not an option goes to rest, in order")

    // A typo with one `-` is refused too, or `-out=X` silently runs with the default.
    $dash_out: U8[] = "DEFAULT"
    sp: = argparse.Parser.create("t", "", arena)
    sp.str_opt("--out", dash_out@, "")
    $saw_single_dash: = false
    sp.parse_list(argv_of(U8[][]::{ "-out=X" }, arena)) catch e
        switch e
        case .unknown_option(n)
            saw_single_dash = n.equals("-out=X")
        default {}
    assert(saw_single_dash,
        "argparse: a slip written with one `-` is refused, and the spelling handed over is reported")
    assert(dash_out.equals("DEFAULT"), "argparse: a refused argument does not reach where it writes")
    assert(sp.rest.len == 0, "argparse: a refused argument does not enter rest either")

    // The space-separated form is refused. The argument after it is not taken as the value,
    // whether it looks like a value (`--out a.txt`) or like an option (`--out --verbose`).
    $spaced: U8[] = "DEFAULT"
    $spaced_rest: = false
    wp: = argparse.Parser.create("t", "", arena)
    wp.positional("<file>")
    wp.str_opt("--out", spaced@, "")
    wp.parse_list(argv_of(U8[][]::{ "--out", "a.txt" }, arena)) catch e
        switch e
        case .missing_value(n)
            spaced_rest = n.equals("--out")
        default {}
    assert(spaced_rest && spaced.equals("DEFAULT"),
        "argparse: `--out a.txt` is refused, not read as --out=a.txt")
    $eaten: U8[] = "DEFAULT"
    $eaten_flag: = false
    vp: = argparse.Parser.create("t", "", arena)
    vp.str_opt("--out", eaten@, "")
    vp.flag("--verbose", eaten_flag@, "")
    $saw_missing: = false
    vp.parse_list(argv_of(U8[][]::{ "--out", "--verbose" }, arena)) catch e
        switch e
        case .missing_value(n)
            saw_missing = n.equals("--out")
        default {}
    assert(saw_missing,
        "argparse: an item in a value's position is refused as \"there is no value\"")
    assert(eaten.equals("DEFAULT"), "argparse: an item not eaten does not reach where it writes")
    assert(!eaten_flag, "argparse: on the round it refused, what follows is not interpreted either")

    // A value starting with `-` uses the `=` form (`--count=-7` above).
    $neg: U8[] = ""
    dashv: = argparse.Parser.create("t", "", arena)
    dashv.str_opt("--out", neg@, "")
    dashv.parse_list(argv_of(U8[][]::{ "--out=-weird" }, arena))
        catch panic("argparse: under `=`, a value starting with `-` goes through")
    assert(neg.equals("-weird"),
        "argparse: in the `=` shape, a value starting with `-` can be handed over too")

    // A `-` on its own is the convention for "standard input", so it is passed to the positionals.
    dp: = argparse.Parser.create("t", "", arena)
    dp.positional("<file>")
    dp.parse_list(argv_of(U8[][]::{ "-" }, arena))
        catch panic("argparse: a `-` on its own was refused")
    assert(dp.rest.len == 1 && dp.rest.get(0).equals("-"),
        "argparse: a `-` on its own is a positional")

    // A positional given to a CLI that has not declared `positional` is refused: a word-splitting
    // fragment arrives **looking like a positional**.
    xp: = argparse.Parser.create("t", "", arena)
    xp.subcommand("train", "")
    $saw_unexpected_arg: = false
    xp.parse_list(argv_of(U8[][]::{ "tran" }, arena)) catch e
        switch e
        case .unexpected_arg(n)
            saw_unexpected_arg = n.equals("tran")
        default {}
    assert(saw_unexpected_arg,
        "argparse: a positional is an error when `positional` has not been declared")
    assert(xp.rest.len == 0, "argparse: a refused positional does not enter rest either")
    assert(xp.command.is_none(), "argparse: a refused positional does not become a command either")

    // `-h` is not a spelling of `--help`: it is refused like any undeclared option.
    hp: = argparse.Parser.create("t", "", arena)
    $saw_short_help: = false
    hp.parse_list(argv_of(U8[][]::{ "-h" }, arena)) catch e
        switch e
        case .unknown_option(n)
            saw_short_help = n.equals("-h")
        default {}
    assert(saw_short_help, "argparse: -h is an unknown option, not --help")

priv fn check_errors(arena: Arena$@) //< an error is never ignored: the item at fault is reported
    // If an unknown --name were ignored, a typo or a word-splitting fragment would get through.
    $ignored: U8[] = ""
    ep: = argparse.Parser.create("t", "", arena)
    ep.str_opt("--known", ignored@, "")
    $saw_unknown: = false
    ep.parse_list(argv_of(U8[][]::{ "--nope" }, arena)) catch e
        switch e
        case .unknown_option(n)
            saw_unknown = n.equals("--nope")
        default {}
    assert(saw_unknown, "argparse: an unknown option is refused, and its name reported")

    $saw_missing_value: = false
    ep.parse_list(argv_of(U8[][]::{ "--known" }, arena)) catch e
        switch e
        case .missing_value(_n)
            saw_missing_value = true
        default {}
    assert(saw_missing_value, "argparse: an item that takes a value with no value is refused")

    $num: I64 = 0
    np: = argparse.Parser.create("t", "", arena)
    np.int_opt("--n", num@, "")
    $saw_bad: = false
    np.parse_list(argv_of(U8[][]::{ "--n=12abc" }, arena)) catch e
        switch e
        case .bad_value(_n)
            saw_bad = true
        default {}
    // "12abc" must not be silently taken as 12.
    assert(saw_bad, "argparse: a value that cannot be read as a number is refused")

    $flag_v: = false
    fp: = argparse.Parser.create("t", "", arena)
    fp.flag("--f", flag_v@, "")
    $saw_unexpected: = false
    fp.parse_list(argv_of(U8[][]::{ "--f=1" }, arena)) catch e
        switch e
        case .unexpected_value(_n)
            saw_unexpected = true
        default {}
    assert(saw_unexpected, "argparse: a value put on a flag is refused")

priv fn check_required_and_help(arena: Arena$@) //< what is required, and --help
    $req: U8[] = ""
    reqp: = argparse.Parser.create("t", "", arena)
    reqp.str_required("--must", req@, "")
    $saw_required: = false
    reqp.parse_list(argv_of(U8[][]::{}, arena)) catch e
        switch e
        case .missing_required(n)
            saw_required = n.equals("--must")
        default {}
    assert(saw_required, "argparse: what is required, not handed over, is refused")
    reqp.parse_list(argv_of(U8[][]::{ "--must=x" }, arena))
        catch panic("argparse: it failed although what is required was handed over")
    assert(req.equals("x"), "argparse: taking what is required")

    $saw_help: = false
    reqp.parse_list(argv_of(U8[][]::{ "--help" }, arena)) catch e
        switch e
        case .help_requested
            saw_help = true
        default {}
    // --help is not a failure but stops the run, so it returns before the required check.
    assert(saw_help, "argparse: --help returns before the check on what is required")

// ==========================================
// There are no short forms: a letter nobody declared is refused, joined to a value or not.
// ==========================================
priv fn test_no_short_names(arena: Arena$@)
    for arg in U8[][]::{ "-i", "-D", "-Dflag" }
        $in_place: = false
        defs: = List<|U8[]|>.create(arena)
        p: = argparse.Parser.create("t", "", arena)
        p.flag("--in-place", in_place@, "")
        p.str_list_opt("--define", defs, "")
        $refused: = false
        p.parse_list(argv_of(U8[][]::{ arg, "x" }, arena)) catch e
            switch e
            case .unknown_option(n)
                refused = n.equals(arg)
            default {}
        assert(refused && !in_place && defs.len == 0,
            "argparse: -i / -D / -Dflag are unknown options, not short forms")

    // The value is everything after the first `=`; a later `=` stays in it.
    defs: = List<|U8[]|>.create(arena)
    p: = argparse.Parser.create("t", "", arena)
    p.str_list_opt("--define", defs, "")
    p.parse_list(argv_of(U8[][]::{ "--define=a", "--define=b=c" }, arena)) catch
        panic("argparse: parsing --define failed")
    both: =
        defs.len == 2 && defs.get(0).equals("a") && defs.get(1).equals("b=c")
    assert(both, "argparse: --define=value reaches the item, a later `=` kept in the value")

    // An empty value is taken, and `saw_empty` tells it from a value and from nothing given.
    $emptied: U8[] = "DEFAULT"
    $kept: U8[] = "DEFAULT"
    $unset: U8[] = "DEFAULT"
    ep: = argparse.Parser.create("t", "", arena)
    ep.str_opt("--out", emptied@, "")
    ep.str_opt("--in", kept@, "")
    ep.str_opt("--log", unset@, "")
    ep.parse_list(argv_of(U8[][]::{ "--out=", "--in=a" }, arena)) catch
        panic("argparse: an empty value was refused")
    told_apart: =
        emptied.len == 0 && ep.saw_empty("--out") && !ep.saw_empty("--in") &&
        !ep.saw_empty("--log")
    assert(told_apart, "argparse: `--out=` is taken empty, and saw_empty names it alone")

// ==========================================
// An option that can be given repeatedly. It accumulates rather than overwrites.
// ==========================================
priv fn test_repeatable(arena: Arena$@)
    items: = List<|U8[]|>.create(arena)
    p: = argparse.Parser.create("t", "", arena)
    p.str_list_opt("--lint", items, "")
    p.parse_list(argv_of(U8[][]::{ "--lint=A=off", "--lint=B=error" }, arena))
        catch panic("argparse: parsing a repetition failed")
    // Both must stay; if overwritten, only the last setting would take effect (unlike str_opt).
    accumulated: =
        items.len == 2 && items.get(0).equals("A=off") && items.get(1).equals("B=error")
    assert(accumulated, "argparse: repeated values pile up in order rather than overwriting")

    // An item of one value given twice is refused: kept, `--out=safe` would undo `--out=/etc/x`.
    $out: U8[] = ""
    $n: I64 = 0
    $quiet: = false
    for twice in U8[][]::{ "--out=/etc/x --out=safe", "--n=1 --n=2", "--out= --out=" }
        one: = argparse.Parser.create("t", "", arena)
        one.str_opt("--out", out@, "")
        one.int_opt("--n", n@, "")
        $args: = twice.split(' ', arena)
        $refused: = false
        one.parse_list(args@) catch e
            switch e
            case .repeated(name)
                refused = twice.starts_with(name)
            default {}
        what: =
            U8$[]::arena.text().s("argparse: '").s(twice).s("' is refused as repeated").take()
        assert(refused, what)
    flags: = argparse.Parser.create("t", "", arena)
    flags.flag("--quiet", quiet@, "")
    flags.parse_list(argv_of(U8[][]::{ "--quiet", "--quiet" }, arena))
        catch panic("argparse: a flag given twice says the same thing twice, and is taken")

// ==========================================
// Commands. A positional's name (`fmt`) and an option's name (`--version`) both go into command
// once chosen, and a second one is refused.
// ==========================================
priv fn test_commands(arena: Arena$@)
    p: = argparse.Parser.create("t", "", arena)
    p.positional("<file>...")
    p.subcommand("fmt", "")
    p.subcommand("lint", "")
    p.command_flag("--version", "")
    p.parse_list(argv_of(U8[][]::{ "fmt", "a.kspl" }, arena))
        catch panic("argparse: parsing a command failed")
    assert(p.command.unwrap_or("").equals("fmt"),
        "argparse: a command is chosen by a positional's name")
    // Do not put a command's name into rest, or the input file count goes up by one.
    cmd_not_in_rest: = p.rest.len == 1 && p.rest.get(0).equals("a.kspl")
    assert(cmd_not_in_rest, "argparse: a command's name does not enter rest")

    // A hidden command is still chosen by its name, not read as an input.
    hp: = argparse.Parser.create("t", "", arena)
    hp.positional("<file>...")
    hp.subcommand_hidden("worker")
    hp.parse_list(argv_of(U8[][]::{ "worker" }, arena))
        catch panic("argparse: parsing a hidden command failed")
    assert(hp.command.unwrap_or("").equals("worker") && hp.rest.len == 0,
        "argparse: a hidden command is chosen by its name")

    // None when none is given; the caller chooses the default.
    np: = argparse.Parser.create("t", "", arena)
    np.positional("<file>")
    np.subcommand("fmt", "")
    np.parse_list(argv_of(U8[][]::{ "a.kspl" }, arena))
        catch panic("argparse: it failed with no command")
    assert(np.command.is_none(), "argparse: command is none when none is handed over")

    fp: = argparse.Parser.create("t", "", arena)
    fp.command_flag("--version", "")
    fp.parse_list(argv_of(U8[][]::{ "--version" }, arena))
        catch panic("argparse: a command named as an option failed")
    chose_by_flag: = fp.command.unwrap_or("").equals("--version")
    assert(chose_by_flag, "argparse: a command is chosen by an option's name too")

    // Giving two is refused, or the later one silently wins; for positionals and options alike.
    for pair in U8[][]::{ "fmt", "--version" }
        mp: = argparse.Parser.create("t", "", arena)
        mp.subcommand("fmt", "")
        mp.subcommand("lint", "")
        mp.command_flag("--version", "")
        $saw_multi: = false
        mp.parse_list(argv_of(U8[][]::{ "lint", pair }, arena)) catch e
            switch e
            case .multiple_commands(n)
                saw_multi = n.equals(pair)
            default {}
        assert(saw_multi, "argparse: giving two commands is refused")

// ==========================================
// A command that takes "one subject + an uninterpreted remainder".
// ==========================================
priv fn test_trailing(arena: Arena$@)
    $stats: = false
    rest_args: = List<|U8[]|>.create(arena)
    p: = argparse.Parser.create("t", "", arena)
    p.flag("--stats", stats@, "")
    p.subcommand_trailing("run", "", rest_args)
    // The `--stats` before the subject belongs to the command; the one after it, to the script.
    args: =
        argv_of(U8[][]::{ "run", "--stats", "s.kspl", "--stats", "--help", "x" }, arena)
    p.parse_list(args) catch panic("argparse: parsing the uninterpreted remainder failed")
    assert(p.command.unwrap_or("").equals("run"), "argparse: a trailing command enters command too")
    assert(stats, "argparse: an option before the subject is its own")
    assert(p.rest.len == 1 && p.rest.get(0).equals("s.kspl"),
        "argparse: only the one subject goes to rest")
    // `--help` must not be taken away, or the script can never print its own usage.
    passed_through: =
        rest_args.len == 3 && rest_args.get(0).equals("--stats") &&
        rest_args.get(1).equals("--help") && rest_args.get(2).equals("x")
    assert(passed_through,
        "argparse: what is after the subject is passed on uninterpreted, --help included")

// ==========================================
// `--`: what follows is positional, a name starting with `-`, `--help` and a command's name alike.
// ==========================================
priv fn test_operands_marker(arena: Arena$@)
    $verbose: = false
    p: = argparse.Parser.create("t", "", arena)
    p.positional("<file>...")
    p.flag("--verbose", verbose@, "")
    p.subcommand("fmt", "")
    args: = argv_of(U8[][]::{ "--verbose", "--", "-x", "--help", "fmt", "--" }, arena)
    p.parse_list(args) catch panic("argparse: the arguments after `--` were refused")
    taken: =
        p.rest.len == 4 && p.rest.get(0).equals("-x") && p.rest.get(1).equals("--help") &&
        p.rest.get(2).equals("fmt") && p.rest.get(3).equals("--")
    assert(taken && verbose && p.command.is_none(),
        "argparse: after `--` each argument is positional, even one naming an option or a command")
    // A CLI that takes no positional refuses one after `--` as well.
    np: = argparse.Parser.create("t", "", arena)
    $refused: = false
    np.parse_list(argv_of(U8[][]::{ "--", "-x" }, arena)) catch e
        switch e
        case .unexpected_arg(n)
            refused = n.equals("-x")
        default {}
    assert(refused, "argparse: `--` does not make a positional welcome where none is declared")

priv const USAGE_SRC: U8[] = //< a child that declares a little and prints its usage
    """import "std/argparse"
import "std/io"
import "std/mem" { Arena }
import "std/sys"

fn main()
  a: = Arena.new(1 << 16)
  $quiet: = false
  $name: U8[] = ""
  p: = argparse.Parser.create(sys.program_name(), "says hello", a)
  p.positional("<file>")
  p.flag("--quiet", quiet@, "say nothing")
  p.str_opt("--name", name@, "who to greet")
  p.print_usage(io.out())
  a.free()
"""

fn test_argparse_prints_usage(ksplc: U8[], arena: Arena$@) //< ksplc runs the child
    //<
    //< **What a person reads first**: the program's name, what it takes, and one line per option
    //< with the value it wants.
    verdict.start("[argparse] the usage printed from the declarations test...")
    r: =
        subproc.run_capture(sys_test.child_argv(ksplc, "usage_probe", USAGE_SRC, arena), "", 300000,
        4096, arena) catch panic("the child must start")
    out: = r.stdout_data
    assert(r.exited_with(0), "the child must print its usage and end")
    assert(out.starts_with("Usage: usage_probe [options] <file>\n"),
        "the first line names the program, its options and its positional")
    assert(out.find_str("says hello").is_some(), "the line saying what it is follows")
    assert(out.find_str("  --quiet ").is_some() && out.find_str("say nothing").is_some(),
        "a flag is listed with its help")
    assert(out.find_str("  --name=<str>").is_some(), "an option names the value it takes")
    verdict.pass("The usage names the program, the positional, and each option with its value.")

priv const REFUSE_SRC: U8[] = //< a child that reads its own arguments with parse_or_exit
    """import "std/argparse"
import "std/mem" { Arena }
import "std/sys"

fn main()
  a: = Arena.new(1 << 16)
  $quiet: = false
  p: = argparse.Parser.create("refuse_probe", "", a)
  p.flag("--quiet", quiet@, "say nothing")
  p.parse_or_exit(sys.args(), a)
  a.free()
"""

fn test_argparse_refusal_goes_to_stderr(ksplc: U8[], arena: Arena$@) //< ksplc runs the child
    //<
    //< Caution: **A refusal and its usage go to standard error, `--help` to standard output.** A
    //< caller that reads the output (`$(prog)`, a pipe) would otherwise take the usage for it.
    verdict.start("[argparse] where a refusal and --help are written test...")
    argv: = List<|U8[]|>.create(arena)
    for one in sys_test.child_argv(ksplc, "refuse_probe", REFUSE_SRC, arena)
        argv.push(one)
    argv.push("--bogus")
    r: = subproc.run_capture(argv.slice(), "", 300000, 4096, arena)
        catch panic("the child must start")
    assert(r.exited_with(2), "a refused command line ends with 2")
    assert(r.stdout_data.len == 0, "a refusal writes nothing to standard output")
    assert(r.stderr_data.find_str("unknown option '--bogus'").is_some() &&
        r.stderr_data.find_str("Usage: refuse_probe").is_some(),
        "the reason and the usage go to standard error")
    argv.set(argv.len - 1, "--help")
    h: = subproc.run_capture(argv.slice(), "", 300000, 4096, arena)
        catch panic("the child must start")
    assert(h.exited_with(0) && h.stdout_data.starts_with("Usage: refuse_probe"),
        "--help writes the usage to standard output and ends with 0")
    verdict.pass("A refusal and its usage go to standard error with 2; --help to standard output.")

priv const SAW_MISSPELT_SRC: U8[] = //< a child that asks whether an item declared nowhere was given
    """import "std/argparse"
import "std/mem" { Arena }

fn main()
  a: = Arena.new(1 << 16)
  $out: U8[] = ""
  p: = argparse.Parser.create("saw_probe", "", a)
  p.str_opt("--out", out@, "where it goes")
  _given: = p.saw("--outt")
  a.free()
"""

fn test_argparse_saw_refuses_an_undeclared_name(ksplc: U8[], arena: Arena$@) //<
    //< ksplc runs the child
    //<
    //< Answered false, a misspelt name reads as an item never given, and the check it guards
    //< passes for good.
    verdict.start("[argparse] asking whether an item declared nowhere was given test...")
    why: = "Parser.saw: '--outt' is declared nowhere"
    assert(sys_test.child_stops_with(ksplc, "saw_probe", SAW_MISSPELT_SRC, why, arena),
        "saw with a name declared nowhere must stop the program, naming it")
    verdict.pass("saw stops on a name declared nowhere, and names it.")

//< The entry point that runs std's tests together
//<
//< **This is the one contract this package exports.** The tests live inside `std/`, so they reach
//< what they inspect without any marking: no `pub` is added only for testing ("A test inspecting
//< the inside of a unit goes inside that unit" in `../../docs/DESIGN.md`).
//< Caution: **Do not add a function for inspection here.** Each one adds a contract outside
//< the unit.
//< **[I0402] does not apply in this unit.**
import "std/mem" { Arena }
import "std/tests/arc_count_test"
import "std/tests/argp_test"
import "std/tests/bytes_test"
import "std/tests/concurrency_test"
import "std/tests/db_test"
import "std/tests/encoding_test"
import "std/tests/fuzz_test"
import "std/tests/http_test"
import "std/tests/iterate_test"
import "std/tests/jsonrpc_test"
import "std/tests/lock_test"
import "std/tests/log_test"
import "std/tests/mem_test"
import "std/tests/net_test"
import "std/tests/rand_test"
import "std/tests/reactor_test"
import "std/tests/reflect_test"
import "std/tests/regex_test"
import "std/tests/ring_test"
import "std/tests/seq_test"
import "std/tests/stack_limit_test"
import "std/tests/str_test"
import "std/tests/sys_test"
import "std/tests/tls_test"
import "std/tests/tree_test"
import "std/tests/verdict_test"

pub fn run_std(ksplc: U8[], arena: Arena$@) //<
  //< ksplc is the compiler a test starts as a child (`jsonrpc_test`, `verdict_test`, `fuzz_test`)
  rand_test.test_rand()
  rand_test.test_prng_ranges()
  concurrency_test.test_thread_spawn_join()
  concurrency_test.test_atomic_and_cond_var()
  stack_limit_test.test_stack_limit_on_main()
  stack_limit_test.test_stack_limit_on_a_thread()
  arc_count_test.test_rc_refcount()
  arc_count_test.test_arc_refcount_concurrent()
  arc_count_test.test_weak_upgrade()
  arc_count_test.test_weak_arc_concurrent()
  regex_test.test_regex_match()
  regex_test.test_regex_groups()
  regex_test.test_regex_find_all()
  regex_test.test_regex_escapes()
  regex_test.test_regex_group_repeat()
  regex_test.test_regex_bounds()
  sys_test.test_env_and_signal()
  sys_test.test_time_conversion()
  sys_test.test_absolute_paths()
  sys_test.test_dir_name()
  sys_test.test_fs_absolute()
  sys_test.test_path_ext()
  sys_test.test_mono_clock()
  sys_test.test_fs_ops()
  sys_test.test_io_read_edges()
  sys_test.test_fs_wide_path()
  sys_test.test_fs_past_max_path()
  sys_test.test_can_run()
  sys_test.test_fs_walk()
  sys_test.test_fs_mkdir_all_race()
  sys_test.test_fs_path_guard()
  sys_test.test_fs_long_path()
  sys_test.test_fs_inner_nul()
  tree_test.test_fs_mkdir_unique()
  tree_test.test_fs_write_tree()
  tree_test.test_fs_copy_tree()
  lock_test.test_file_lock()
  fuzz_test.test_fuzz_mutate()
  fuzz_test.test_fuzz_pick()
  fuzz_test.test_fuzz_gather()
  sys_test.test_env_set_unset()
  sys_test.test_run_capture(arena)
  sys_test.test_run_many(arena)
  sys_test.test_run(arena)
  encoding_test.test_sha256_hmac()
  rand_test.test_secure_random()
  encoding_test.test_base64_codec()
  encoding_test.test_to_f64()
  encoding_test.test_json_numbers(arena)
  encoding_test.test_json_escapes(arena)
  encoding_test.test_json_string_escapes(arena)
  encoding_test.test_json_malformed_input(arena)
  encoding_test.test_json_duplicate_keys(arena)
  encoding_test.test_json_indent(arena)
  reflect_test.test_json_struct_roundtrip(arena)
  net_test.test_tcp_echo()
  net_test.test_udp_echo()
  net_test.test_net_names()
  net_test.test_tcp_ipv6()
  net_test.test_tcp_overlapped()
  net_test.test_tcp_overlapped_ipv6()
  http_test.test_url_codec()
  http_test.test_http_parse_buffered()
  http_test.test_http_reject_smuggling()
  http_test.test_http_socket_roundtrip()
  jsonrpc_test.test_jsonrpc_take_frame()
  jsonrpc_test.test_jsonrpc_broken_frame()
  jsonrpc_test.test_jsonrpc_encode()
  jsonrpc_test.test_jsonrpc_stderr_flood(ksplc)
  jsonrpc_test.test_jsonrpc_notification_burst(ksplc)
  verdict_test.test_verdict_goes_on_past_a_failure(ksplc, arena)
  verdict_test.test_verdict_walk_of_nothing_fails(ksplc, arena)
  verdict_test.test_verdict_names_what_fits(ksplc, arena)
  fuzz_test.test_fuzz_rounds(ksplc, arena)
  fuzz_test.test_fuzz_report(ksplc, arena)
  fuzz_test.test_fuzz_scatter(ksplc, arena)
  log_test.test_log_keeps_what_is_heavy_enough()
  log_test.test_log_at_does_not_run_the_body_when_light()
  log_test.test_log_closes_the_line_it_opened()
  log_test.test_log_says_where_it_was_called_from()
  log_test.test_log_parts_its_fields_with_the_separator_given()
  log_test.test_log_pushes_a_heavy_line_out_at_once()
  reactor_test.test_reactor_multi_connection()
  reactor_test.test_reactor_nonblocking_connect()
  tls_test.test_tls_handshake_failure_against_non_tls_peer()
  db_test.test_db_crud_roundtrip()
  db_test.test_db_row_roundtrip()
  seq_test.test_seq_combinators(arena)
  seq_test.test_seq_two_element_types(arena)
  seq_test.test_seq_order_by_stable(arena)
  iterate_test.test_iteration(arena)
  iterate_test.test_map_removal()
  iterate_test.test_list_remove_at()
  str_test.test_str_ops(arena)
  str_test.test_strnum_roundtrip()
  str_test.test_float_bits()
  str_test.test_unescape_and_dedent(arena)
  str_test.test_buf_writer()
  str_test.test_arena_text(arena)
  argp_test.test_argp(arena)
  mem_test.test_arena_reset_keeps_one_chunk()
  mem_test.test_arena_reset_fixed_buffer()
  mem_test.test_heap_counters_across_threads()
  ring_test.test_ring_basic()
  ring_test.test_ring_wraparound()
  bytes_test.test_bytes_endian()
  bytes_test.test_bytes_fill_copy()

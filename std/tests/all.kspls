    str_test.test_arena_text(arena)
    argp_test.test_argp(arena)
    argp_test.test_argp_prints_usage(ksplc, arena)
    argp_test.test_argp_refusal_goes_to_stderr(ksplc, arena)
    mem_test.test_arena_reset_keeps_one_chunk()
    mem_test.test_arena_reset_fixed_buffer()
    mem_test.test_move_overlap()
    mem_test.test_heap_counters_across_threads()
    mem_test.test_arena_new_refuses_zero(ksplc, arena)
    ring_test.test_ring_basic()
    ring_test.test_ring_wraparound()
    bytes_test.test_bytes_endian()
    bytes_test.test_bytes_fill_copy()
    bytes_test.test_bytes_crc32()

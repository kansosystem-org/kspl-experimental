//< Tests of std's string operations: `std/str`, `std/strnum` and the writers into memory
//< The number helpers beside them are here too: `std/bignat`, and `std/math`'s `round`, `abs`,
//< `min`, `max` and checked conversions from floating point.
import "std/bignat" + { Bignat }
import "std/buf" { Buf_writer }
import "std/chars"
import "std/io"
import "std/math"
import "std/mem" + { Arena }
import "std/str" + { Str_builder }
import "std/strfmt"
import "std/strnum" // `to_i64` / `to_f64` / `parse_size`
import "std/subproc"
import "std/sys"
import "std/tests/sys_test"
import "std/verdict"

// ==========================================
// Tests of std/str's string operations.
//
// Caution: Do not mix up what returns a view (trim_*), which cannot outlive the original, with
// what returns a copy (replace/join). Each boundary (empty, all spaces, no match) has one case.
// ==========================================
fn test_str_ops(arena: Arena$@)
    verdict.start("[str] replace/trim/join/lines test...")

    for i in Range.asc(16)
        digit: = U8::i
        assert(digit.to_hex_lower() == "0123456789abcdef"[i], "lowercase hex digit")
        assert(digit.to_hex_upper() == "0123456789ABCDEF"[i], "uppercase hex digit")

    // --- replace: replaces every occurrence ---
    assert("a.b.c".replace(".", "-", arena).equals("a-b-c"), "replace: replaces all")
    assert("aa".replace("a", "xy", arena).equals("xyxy"), "replace: the new text is longer")
    no_hit: = "abc".replace("z", "-", arena)
    assert(no_hit.equals("abc"), "replace: unchanged when there is no hit")
    assert("aaa".replace("aa", "b", arena).equals("ba"),
        "replace: overlapping candidates go left first")
    // An empty old does nothing (Python inserts at every character); this prevents an endless loop.
    assert("abc".replace("", "-", arena).equals("abc"), "replace: an empty old does nothing")
    assert("".replace("a", "b", arena).len == 0, "replace: an empty string")
    // A null arena is the global heap, as the parameter says.
    on_heap: = "a.b".replace(".", "--", null)
    assert(on_heap.equals("a--b"), "replace: a null arena puts the result on the heap")
    assert((on_heap.ptr + on_heap.len)$ == 0U8, "replace: the copy is NUL-terminated for C")
    mem.dealloc(Void$@::on_heap.ptr)

    // --- count_str: counts the places that replace would change ---
    assert("a.b.c".count_str(".") == 2, "count_str: every place")
    assert("aaaa".count_str("aa") == 2 && "aaa".count_str("aa") == 1,
        "count_str: a find steps past itself, so two never overlap")
    assert("abab".count_str("ab") == 2, "count_str: a place at the very end counts")
    assert("abc".count_str("z") == 0 && "ab".count_str("abc") == 0, "count_str: no hit is 0")
    assert("abc".count_str("") == 0 && "".count_str("") == 0,
        "count_str: an empty text counts as none, as replace swaps none")

    // --- trim: a view with the spaces dropped ---
    assert("  x  ".trim_start().equals("x  "), "trim_start")
    assert("  x  ".trim_end().equals("  x"), "trim_end")
    assert("  x  ".trim_spaces().equals("x"), "trim_spaces")
    assert("   ".trim_spaces().len == 0, "trim_spaces: empty when it is all spaces")
    assert("   ".trim_start().len == 0, "trim_start: empty when it is all spaces")
    assert("   ".trim_end().len == 0, "trim_end: empty when it is all spaces")
    assert("x".trim_spaces().equals("x"), "trim_spaces: there is nothing to drop")

    // --- join: round-trips with split ---
    $pieces: = "a,b,c".split(',', arena)
    assert(", ".join(pieces.slice(), arena).equals("a, b, c"), "join")
    assert(",".join(pieces.slice(), arena).equals("a,b,c"), "join: a round trip with split")
    one: = "-".join(U8[][]::{ "x" }, arena)
    assert(one.equals("x"), "join: no separator when there is one element")
    assert("".join(pieces.sub(0, 2), arena).equals("ab"), "join: an empty separator")
    assert("-".join(U8[][]::{}, arena).len == 0, "join: no pieces is empty")
    assert("-".join(U8[][]::{ "", "x", "" }, arena).equals("-x-"),
        "join: empty pieces keep their separators")
    $code_lines: = "first\nmiddle\nlast\n".split('\n', arena)
    prefix: = "\n".join(code_lines.sub(0, 1), arena)
    middle: = "\n".join(code_lines.sub(1, 1), arena)
    suffix: = "\n".join(code_lines.sub_from(2), arena)
    rebuilt: = arena.text().s(prefix).c('\n').s(middle).c('\n').s(suffix).take()
    assert(rebuilt.equals("first\nmiddle\nlast\n"),
        "join: borrowed line ranges preserve the trailing newline")

    // --- lines: drops a \r at a line's end and does not make an empty line from a trailing newline
    // ---
    l_lf: = "a\nb\n".lines(arena)
    assert(l_lf.len == 2, "lines: a trailing newline makes no empty line")
    assert(l_lf.get(0).equals("a") && l_lf.get(1).equals("b"), "lines: the content of each line")
    l_crlf: = "a\r\nb\r\n".lines(arena)
    assert(l_crlf.len == 2, "lines: the line count is the same under CRLF")
    assert(l_crlf.get(0).equals("a"), "lines: drops the \r at a line's end")
    assert("".lines(arena).len == 0, "lines: an empty string is 0 lines")
    assert("a".lines(arena).len == 1, "lines: 1 line when there is no newline")
    l_blank: = "a\n\nb".lines(arena)
    assert(l_blank.len == 3 && l_blank.get(1).len == 0, "lines: an empty line in the middle stays")

    // --- sub / sub_mut: a view's mutability ---
    // `sub`/`sub_from`/`split`/`lines` return an immutable view (`U8[]`).
    view: U8[] = "abcdef".sub(1, 3)
    assert(view.equals("bcd"), "sub: cuts out an immutable view")
    assert("abcdef".sub(4, 99).equals("ef"), "sub: len is clamped to the length left")
    assert("abcdef".sub(9, 1).len == 0, "sub: a start out of range is empty")
    assert("abcdef".sub(1, -1).len == 0, "sub: a negative len is empty")
    assert("abcdef".sub_from(4).equals("ef"), "sub_from: an immutable view")

    // strip_prefix/strip_suffix return the original where it is not there (Python's removeprefix).
    assert("--out=x".strip_prefix("--out=").equals("x"), "strip_prefix: drops the prefix")
    kept: = "--out=x".strip_prefix("--in=")
    assert(kept.equals("--out=x"), "strip_prefix: unchanged when it does not match")
    assert("abc".strip_prefix("abc").len == 0, "strip_prefix: a whole match becomes empty")
    assert("ab".strip_prefix("abc").equals("ab"), "strip_prefix: a prefix longer than the original")
    assert("a.kspl".strip_suffix(".kspl").equals("a"), "strip_suffix: drops the suffix")
    assert("a.kspl".strip_suffix(".c").equals("a.kspl"),
        "strip_suffix: unchanged when it does not match")
    assert("ab".strip_suffix("xab").equals("ab"), "strip_suffix: a suffix longer than the original")
    assert("abc".strip_prefix("").equals("abc"), "strip_prefix: an empty prefix leaves the original")

    // The mutable form writes back into the original buffer.
    buf: U8[4] = ::{ 'a', 'b', 'c', 'd' }
    whole: = U8$[]::buf
    tail: = whole.sub_mut(2, 2)
    (tail.ptr + 0)$ = 'X'
    assert(whole.equals("abXd"), "sub_mut: a write into the cut-out part reaches the original")
    assert(whole.sub_mut(9, 1).len == 0, "sub_mut: a start out of range is empty")

    // --- a method can be called through a pointer to an immutable view too (`.` auto-derefs) ---
    pv: U8[]@ = view@
    assert(pv.equals("bcd"), "auto-deref: a method can be called on a U8[]@")

    // --- drop_prefix: discards only the parsed prefix and moves the rest to the front ---
    defer $b: = Str_builder.new()
    b.s("msg1|msg2")
    b.drop_prefix(5)
    assert(b.slice().equals("msg2"), "drop_prefix: the rest is packed forward to the head")
    b.drop_prefix(0)
    assert(b.slice().equals("msg2"), "drop_prefix: 0 does nothing")
    b.drop_prefix(-3)
    assert(b.slice().equals("msg2"), "drop_prefix: a negative does nothing")
    b.drop_prefix(99)
    assert(b.len == 0, "drop_prefix: len or more throws everything away")
    b.s("again")
    assert(b.slice().equals("again"), "drop_prefix: more can be appended after throwing away")
    // The rest is longer than what is dropped, so the two ranges overlap.
    b.clear().s("ab0123456789")
    b.drop_prefix(2)
    assert(b.slice().equals("0123456789"), "drop_prefix: a rest overlapping the dropped part")

    // Caution: **Do not confuse the number of code points with the byte count** (a Japanese
    // character is 3 bytes).
    assert("abc".count_codepoints() == 3, "count_codepoints: ASCII is 1 byte per character")
    assert("あいう".count_codepoints() == 3,
        "count_codepoints: Japanese is counted per character too")
    assert("aあb".count_codepoints() == 3, "count_codepoints: mixed, it still counts characters")
    assert("".count_codepoints() == 0, "count_codepoints: empty is 0")
    // Caution: **Test a sequence cut off at the end.** Returning the lead byte's width unchecked
    // makes a loop on `i += step` run past the length.
    cut: U8[2] = ::{ 0xe3U8, 0x81U8 } // only the first 2 bytes of "あ" (e3 81 82)
    assert("あ".next_codepoint(0) == 3, "next_codepoint: a 3-byte character is 3")
    assert((U8[]::cut).next_codepoint(0) == 2,
        "next_codepoint: a sequence cut off at the end goes to the length left")
    assert("a".next_codepoint(1) == 0, "next_codepoint: a position past the end is 0")
    verdict
        .pass("Replacing, trimming, joining, splitting lines and sub-views work as expected, \
            boundaries included.")
// ==========================================
// std/str's unescape_to_arena and dedent.
// ==========================================

fn test_unescape_and_dedent(arena: Arena$@) //<
    //< **Refuse an unknown alphanumeric escape**, or `\x41` silently becomes `x41`
    //< An escaped symbol stands for itself (a grammar's `\[` and `\-` rely on that).
    //< **Turn a line of only spaces into an empty line.** Otherwise the dedented document gets
    //< trailing spaces that nobody can see.
    verdict.start("[str] unescape_to_arena's escapes and dedent test...")
    known: = "a\\nb\\tc\\u3042".unescape_to_arena(arena)
        catch panic("str: known escapes must decode")
    assert(known.equals("a\nb\tcあ"), "unescape: `\\n` `\\t` `\\uXXXX` are undone")
    symbols: = "\\[\\-\\/\\\"".unescape_to_arena(arena)
        catch panic("str: symbol escapes must decode")
    assert(symbols.equals("[-/\""), "unescape: an escaped symbol is that symbol itself")
    $rejected: = false
    _x: = "\\x41".unescape_to_arena(arena) catch
        rejected = true
        fallback ""
    assert(rejected, "unescape: the unknown alphanumeric escape `\\x` is refused")
    rejected = false
    _q: = "\\q".unescape_to_arena(arena) catch
        rejected = true
        fallback ""
    assert(rejected, "unescape: `\\q` is refused too")
    rejected = false
    _t: = "ab\\".unescape_to_arena(arena) catch
        rejected = true
        fallback ""
    assert(rejected, "unescape: a `\\` with nothing after it is refused, not kept")

    d: = "  a\n   \n  b\n".dedent(arena)
    assert(d.equals("a\n\nb\n"),
        "dedent: a line of nothing but spaces becomes empty and does not decide the smallest indent")
    d2: = "    x\n  \t\n      y".dedent(arena)
    assert(d2.equals("x\n\n  y"),
        "dedent: a line of nothing but spaces becomes empty even when longer than the smallest \
            indent")
    d3: = "  a\n  b  ".dedent(arena)
    assert(d3.equals("a\nb  "), "dedent: spaces behind a character stay")
    d4: = "  a\r\n   \r\n  b\r\n".dedent(arena)
    assert(d4.equals("a\r\n\r\nb\r\n"),
        "dedent: under CRLF, a line of nothing but spaces becomes `\\r\\n`")
    // The indentation is compared byte by byte: a tab and four spaces share none.
    d5: = "\ta\n    b\n".dedent(arena)
    assert(d5.equals("\ta\n    b\n"), "dedent: a tab and spaces are not one indentation")
    d6: = "\t\ta\n\t b\n".dedent(arena)
    assert(d6.equals("\ta\n b\n"), "dedent: only the bytes every line shares go")
    verdict
        .pass("An unknown escape is refused, a line of nothing but spaces is made empty, and only \
            the indentation every line shares byte for byte is removed.")

// ==========================================
// std/strnum's write-then-read round trip, and the strings that must be refused.
// ==========================================

fn test_strnum_roundtrip() //<
    //< That a number survives the round trip through text, and that bad text is refused
    //< **Use the boundary values**: if `to_i64` cannot read a value that `write_int` writes, a
    //< saved setting breaks only at the largest value.
    //< Caution: **Include the refusals too**, or a reader that accepts everything passes.
    verdict.start("[strnum] a number's round trip and refusal test...")
    defer $b: = Str_builder.new()

    vals: I64[_] = ::{ 0I64, 1I64, -1I64, 42I64, -42I64, 2147483647I64, -2147483648I64,
        9223372036854775807I64, -9223372036854775807I64 - 1I64 }
    for v in vals
        b.clear().s("\{v\}")
        got: = b.slice().to_i64() catch
            fallback 0I64
        assert(got == v, "the string written reads back")

    bads: U8[][_] = ::{ "", "   ", "abc", "12abc", "-", "+", "1.5", "0x10", "9223372036854775808",
        "-9223372036854775809", "99999999999999999999999" }
    for bad in bads
        $rejected: = false
        bad.to_i64() catch
            rejected = true
            fallback 0I64
        assert(rejected, "a string that is not a number, and one out of range, are refused")
    // **Out of range is its own reason** (`out_of_bounds`), apart from a shape that is not a
    // number.
    for big in U8[][]::{ "9223372036854775808", "-9223372036854775809", "99999999999999999999999" }
        $why_big: = ""
        big.to_i64() catch e
            switch e
            case .out_of_bounds
                why_big = "range"
            default
                why_big = "shape"
            fallback 0I64
        assert(why_big.equals("range"), "a number out of range is refused as out of bounds")
    $why_abc: = ""
    shape: U8[] = "12abc"
    shape.to_i64() catch e
        switch e
        case .invalid_format
            why_abc = "shape"
        default
            why_abc = "range"
        fallback 0I64
    assert(why_abc.equals("shape"), "a string that is not a number is refused as its shape")

    // Only surrounding spaces are allowed.
    spaced: = "  -7  ".to_i64() catch
        fallback 0I64
    assert(spaced == -7, "spaces around it are allowed")

    // Caution: **Test the round trip for a float too.** The writer's digits and the reader's
    // rounding are one contract; changing only one breaks the round trip. Tested at default and 17.
    fvals: F64[_] = ::{ 0.0, 1.0, -1.0, 0.5, 0.1, 0.3, -0.0025, 123456789.123456789, 1.0e10,
        1.0e-5 }
    for fv in fvals
        b.clear().s("\{fv:.17\}")
        fgot: = b.slice().to_f64() catch
            fallback -999.0
        assert(fgot == fv, "the float string written reads back")
        // The default format (the shortest form of `\{x\}`) round-trips too.
        b.clear().s("\{fv\}")
        sgot: = b.slice().to_f64() catch
            fallback -999.0
        assert(sgot == fv, "the default format reads back")

    verdict
        .pass("Integers round-trip to their smallest and largest, floats at 17 digits, and what is \
            out of range or not a number is refused.")

fn test_float_bits() //< reading an F32's bits is a copy, not a conversion
    //< **Include the patterns arithmetic would change**: -0 and infinity survive only if the bits
    //< are copied.
    verdict.start("[bignat] an F32's bits test...")
    assert(bignat.f32_to_bits(1.0F32) == 0x3F800000U32, "1.0 is 0x3F800000")
    assert(bignat.f32_to_bits(-2.0F32) == 0xC0000000U32, "-2.0 is 0xC0000000")
    assert(bignat.f32_to_bits(0.1F32) == 0x3DCCCCCDU32, "0.1 is 0x3DCCCCCD")
    assert(bignat.f32_to_bits(-0.0F32) == 0x80000000U32, "-0 keeps its sign bit")
    assert(bignat.f32_to_bits(F32::(1.0 / 0.0)) == 0x7F800000U32, "infinity is 0x7F800000")
    verdict.pass("Known values read as their bit patterns, -0 and infinity included.")

fn test_math_round() //< rounding goes to the nearest whole number, halves away from 0
    //< **Include the largest F64 below one half**: adding 0.5 to it rounds up to 1 in the addition.
    verdict.start("[math] round test...")
    below_half: = 0.49999999999999994
    assert(math.round(below_half) == 0.0, "the largest F64 below 0.5 rounds to 0")
    assert(math.round(-below_half) == 0.0, "the largest F64 above -0.5 rounds to 0")
    assert(math.round(0.5) == 1.0 && math.round(-0.5) == -1.0, "a half goes away from 0")
    assert(math.round(2.5) == 3.0 && math.round(-2.5) == -3.0, "an even half goes away from 0")
    assert(math.round(1.4) == 1.0 && math.round(-1.6) == -2.0, "the nearer whole number wins")
    // 2^52 - 0.5: the last half an F64 holds, which the cast must not lose.
    assert(math.round(4503599627370495.5) == 4503599627370496.0, "the last half rounds up")
    assert(math.round(1.0e300) == 1.0e300, "a value past I64 comes back as it is")
    verdict.pass("Halves go away from 0, and the largest F64 below one half stays below.")

priv const ABS_MIN_SRC: U8[] = //< a child that asks for the absolute value of `I32`'s minimum
    """import "std/io"
import "std/math"

fn main()
  lowest: I32 = -2147483647 - 1
  io.out().s("\{math.abs(lowest)\}")
"""

fn test_math_abs_min_max(ksplc: U8[], arena: Arena$@) //< one name each, for every number type
    verdict.start("[math] abs, min and max test...")
    assert(math.abs(-5) == 5 && math.abs(5) == 5 && math.abs(0) == 0, "abs on an I32")
    assert(math.abs(-2.5) == 2.5 && math.abs(I8::-127) == I8::127, "abs on an F64 and an I8")
    lowest: I64 = -9223372036854775807I64
    assert(math.abs(lowest) == 9223372036854775807I64, "abs: one above the minimum has a value")
    assert(math.min(3, -4) == -4 && math.max(3, -4) == 3, "min and max on an I32")
    small: Sz = 2
    assert(math.min(small, 7) == 2 && math.max(small, 7) == 7, "min and max on an Sz")
    assert(math.min(0.5, 1.5) == 0.5 && math.max(U8::200, U8::100) == U8::200,
        "min and max on an F64 and a U8")
    zero: = 0.0
    nan: = zero / zero
    assert(math.min(nan, 1.0) == 1.0 && math.max(nan, 1.0) == 1.0, "a NaN first gives the second")
    // **The minimum stops the program, naming why**: negated, it would wrap to itself.
    assert(sys_test.child_stops_with(ksplc, "abs_min", ABS_MIN_SRC, "math.abs: the minimum", arena),
        "abs of a signed integer's minimum must stop, not return a negative")
    verdict.pass("abs, min and max answer for each type, and abs refuses the minimum.")

priv fn wide_to_bignat(w: bignat.Wide): Bignat
    $v: = Bignat.from_u64(w.hi)
    v.shl(64)
    lo: = Bignat.from_u64(w.lo)
    v.add(lo@)
    return v

priv fn pow5_bignat(n: I32): Bignat
    $v: = Bignat.from_u64(1U64)
    for _i in Range.asc(n)
        v.mul_small(5U32)
    return v

priv fn pow10_entry_exact(q: I32): Bool //< whether pow10_128(q) is 10^q's top 128 bits, truncated
    //< With T the entry and e = 127 - (floor_log2_pow10(q) - q), T <= 5^q x 2^e < T + 1 must hold.
    //< 10^q is 5^q x 2^q, so the two share their bits.
    t: = bignat.pow10_128(q)
    if (t.hi >> 63U64) != 1U64
        return false
    e: = 127 - (bignat.floor_log2_pow10(q) - q)
    $low: = wide_to_bignat(t) // T, then T + 1, scaled to meet 5^q x 2^e
    $high: = low
    high.add_small(1U32)
    $value: = pow5_bignat(math.abs(q))
    if q < 0 // 2^e / 5^-q: multiply T and T + 1 by 5^-q instead
        low.mul(value@)
        high.mul(value@)
        value = Bignat.from_u64(1U64)
    if e >= 0
        value.shl(e)
    else
        low.shl(-e)
        high.shl(-e)
    return low.cmp(value@) <= 0 && value.cmp(high@) < 0

fn test_pow10_table() //< every power of ten the float conversions read is exact
    //< **Check every entry, rebuilt or held.** A wrong correction bit shows in one entry only. It
    //< moves a float's digits only where that power is used.
    //< `floor_log10_pow2` is checked over every exponent an F64 or an F32 has.
    verdict.start("[bignat] the 128-bit powers of ten test...")
    for q in Range.new(bignat.POW10_Q_MIN, bignat.POW10_Q_MAX + 1, 1)
        assert(pow10_entry_exact(I32::q), "pow10_128(q) must be 10^q's top 128 bits, truncated")
    for e in Range.new(-1100, 1101, 1)
        for three_quarters in Bool[]::{ false, true }
            k: = strfmt.floor_log10_pow2(I32::e, three_quarters)
            // 10^k <= v < 10^(k + 1), with v = 2^e or 3 x 2^(e - 2), all scaled to integers.
            $v: = Bignat.from_u64(3U64 if three_quarters else 4U64)
            $lo: = Bignat.from_u64(4U64)
            $hi: = Bignat.from_u64(40U64)
            if e >= 0
                v.shl(e)
            else
                lo.shl(-e)
                hi.shl(-e)
            if k >= 0
                lo.mul_pow10(k)
                hi.mul_pow10(k)
            else
                v.mul_pow10(-k)
            assert(lo.cmp(v@) <= 0 && v.cmp(hi@) < 0, "floor_log10_pow2 must be exact")
    verdict.pass("Every 10^q from 10^-342 to 10^324 and every floor(log10(2^e)) is exact.")

fn test_arena_text(arena: Arena$@) //< a writer that allocates and returns the result
    //< What is written lives as long as the arena, and take() releases the builder.
    //< Caution: **Test that it cannot cross arenas.** A builder that does not remember its arena
    //< copies into the wrong one.
    verdict.start("[str] a write target that allocates and returns (arena.text) test...")
    i: = 3
    name: = arena.text().s("layer.\{i\}.weight").take()
    assert(name.equals("layer.3.weight"),
        "a chain with interpolation in it becomes a string in one expression")
    // Building one text after another does not break the earlier one (the builder is not reused).
    a: = arena.text().s("a\{i\}").take()
    b: = arena.text().s("b\{i + 1\}").take()
    assert(a.equals("a3") && b.equals("b4"), "strings built one after another both stay")
    // The empty case works too.
    assert(arena.text().take().len == 0, "length 0 when nothing is written")
    verdict.pass("It stays for the arena's lifetime, and two of them do not break each other.")

priv const SELF_APPEND_SRC: U8[] = //< a child that writes builders from views of their own bytes
    //< Each source is past 1 KiB: glibc scribbles over a freed block only above that size.
    """import "std/chars"
import "std/io"
import "std/str" + { Str_builder }

fn main()
  $b: = Str_builder.new()
  $want: = Str_builder.new()
  for _i in Range.asc(256)
    b.s("abcdefgh")
  want.s(b.slice()).s(b.slice())
  b.s(b.slice())
  assert(b.slice().equals(want.slice()), "s: the builder written onto itself as it grows")
  v: = b.slice()
  want.clear().s("xyxy").s(v.sub_from(2))
  b.clear().s("xy").s(v)
  assert(b.slice().equals(want.slice()), "s: a view taken before clear(), as it grows")
  w: = b.slice()
  b.clear().s("--").s(w.sub(0, 6))
  assert(b.slice().equals("----xycd"), "s: a view overlapping where its bytes land")
  $e: = Str_builder.new()
  want.clear()
  for _i in Range.asc(512)
    e.s("a\"")
    want.s("a\"")
  for _i in Range.asc(512)
    want.s("a\\\"")
  e.escape_and_append(e.slice())
  assert(e.slice().equals(want.slice()), "escape_and_append: the builder escaped onto itself")
  io.out().s("ok")
"""

fn test_builder_writes_its_own_bytes(ksplc: U8[], arena: Arena$@) //< ksplc runs the child
    //< Caution: **Run it as a child with freed memory scribbled over** (`MALLOC_PERTURB_` on glibc,
    //< `MallocScribble` on macOS). Read after the free, a block's bytes are usually still there,
    //< so a test in this process passes without the fix. Windows has no such switch.
    verdict.start("[str] a builder written from a view of its own bytes...")
    sys.set_env("MALLOC_PERTURB_", "165") catch panic("set_env should succeed")
    sys.set_env("MallocScribble", "1") catch panic("set_env should succeed")
    r: =
        subproc.run_capture(sys_test.child_argv(ksplc, "self_append", SELF_APPEND_SRC, arena), "",
        300000, 1 << 20, arena) catch panic("the child must start")
    sys.unset_env("MALLOC_PERTURB_") catch panic("unset_env should succeed")
    sys.unset_env("MallocScribble") catch panic("unset_env should succeed")
    if !r.exited_with(0) || !r.stdout_data.equals("ok")
        io.err().s(r.stderr_data)
    assert(r.exited_with(0) && r.stdout_data.equals("ok"),
        "each write must read its source before the old buffer is freed")
    verdict.pass("Written onto itself, as it grows or not, a builder keeps every byte.")

// ==========================================
// A Writer that writes into the caller's memory.
// ==========================================

fn test_buf_writer() //<
    //< That Buf_writer, the writer that allocates nothing, works when full and when reused
    //< Caution: **Always test the overflow case**, or a writer that does not count drops passes.
    //< **Test reuse as well**: a clear() keeping the drop record reports "overflowing" from then
    //< on.
    verdict.start("[str] Buf_writer (a write target that does not allocate) test...")
    n: = 7
    // The buffer needs `$`; without it the C declaration gains a `const`, and the write goes to
    // read-only memory.
    $buf: U8[32] = ::{}
    $w: = Buf_writer.new(U8$[]::buf)
    written: = w.s("n=\{n\}").slice()
    assert(written.equals("n=7"),
        "slice() can be called at the end of a chain with interpolation in it")
    assert(!w.overflowed(), "nothing overflows when it all fits")
    assert(w.len == 3, "it advances by just what was written")

    // A string longer than the buffer writes what fits and drops the rest.
    $small: U8[4] = ::{}
    $v: = Buf_writer.new(U8$[]::small)
    assert(v.s("0123456789").slice().equals("0123"), "it writes what fits")
    assert(v.overflowed(), "it is known when something was dropped")
    // The one-byte-at-a-time method counts the same way.
    assert(!v.clear().overflowed(), "clear() wipes the record of what was dropped too")
    v.c('a').c('b').c('c').c('d').c('e')
    assert(v.slice().equals("abcd") && v.overflowed(), "c() counts an overflow too")
    // The source can be a view of bytes that this write is about to overwrite.
    $overlap: U8[8] = ::{ 97, 98, 99, 100, 101, 102, 103, 104 }
    $same: = Buf_writer.new(U8$[]::overlap)
    same.s("ab").s((U8[]::overlap).sub(0, 6))
    assert(same.slice().equals("ababcdef") && !same.overflowed(),
        "overlapping bytes must be copied before the destination overwrites them")
    verdict.pass("The case that fits, the case that overflows, and reuse are all confirmed.")

// ==========================================
// The text and number helpers that answer one small question each, at their edges.
// ==========================================
priv fn count_refused(text: U8[], limit: Sz, want: strnum.Strnum_error): Bool //<
    //< Whether `to_count` refuses the text **for that reason**
    _n: = text.to_count(limit) catch e
        return e == want
    return false

priv fn seq_len_of(a: U8, b: U8, c: U8, d: U8, n: Sz): Sz? //< utf8_seq_len of the first n bytes
    bytes: U8[4] = ::{ a, b, c, d }
    return U8[]::{ .ptr = bytes[0]@, .len = n }.utf8_seq_len(0)

fn test_text_edges()
    verdict.start("[str] the small text and number helpers at their edges...")
    sz_max: = Sz::9223372036854775807I64
    assert(("1000".to_count(1000) catch -1) == 1000 &&
        count_refused("1001", 1000, .out_of_bounds),
        "to_count: the limit is taken, one past it is not")
    assert(("9223372036854775807".to_count(sz_max) catch -1) == sz_max &&
        count_refused("9223372036854775808", sz_max, .out_of_bounds) &&
        count_refused("99999999999999999999", sz_max, .out_of_bounds),
        "to_count: the largest Sz is read, and one past it refused before it can overflow")
    for bad in U8[][]::{ "", "+1", " 1", "1 ", "-0", "1a" }
        assert(count_refused(bad, 1000, .invalid_format), "to_count: digits alone, nothing else")
    assert("00fF".hex4(0).unwrap_or(-1) == 255 && "x1234".hex4(1).unwrap_or(-1) == 0x1234 &&
        "FFFF".hex4(0).unwrap_or(-1) == 0xffff, "hex4: four digits of either case, at any offset")
    assert("zzzz".hex4(0).is_none() && "123".hex4(0).is_none() && "12345".hex4(2).is_none() &&
        "1234".hex4(-1).is_none() && "12g4".hex4(0).is_none(),
        "hex4: none for a non-digit, fewer than four, or an offset outside")
    for at in Sz[]::{ sz_max - 3, sz_max - 1, sz_max }
        assert("1234".hex4(at).is_none(), "hex4: a large offset is refused before it can overflow")
        assert(!"abc".starts_with("a", at),
            "starts_with: a large offset is refused before it can overflow")
    assert("abc".starts_with("", 3) && !"abc".starts_with("", 4) &&
        !"abc".starts_with("", -1), "starts_with: an empty prefix still checks its offset")
    assert('7'.hex_val().unwrap_or(-1) == 7 && 'f'.hex_val().unwrap_or(-1) == 15 &&
        'F'.hex_val().unwrap_or(-1) == 15 && 'g'.hex_val().is_none() &&
        '/'.hex_val().is_none(), "hex_val: a digit's value in either case, none for anything else")
    assert(seq_len_of('a', 0U8, 0U8, 0U8, 1).unwrap_or(0) == 1 &&
        seq_len_of(0xc3U8, 0xa9U8, 0U8, 0U8, 2).unwrap_or(0) == 2 &&
        seq_len_of(0xe2U8, 0x82U8, 0xacU8, 0U8, 3).unwrap_or(0) == 3 &&
        seq_len_of(0xf0U8, 0x9fU8, 0x98U8, 0x80U8, 4).unwrap_or(0) == 4,
        "utf8_seq_len: one to four bytes")
    assert(seq_len_of(0xc0U8, 0xafU8, 0U8, 0U8, 2).is_none() &&
        seq_len_of(0xedU8, 0xa0U8, 0x80U8, 0U8, 3).is_none() &&
        seq_len_of(0xf4U8, 0x90U8, 0x80U8, 0x80U8, 4).is_none() &&
        seq_len_of(0xe2U8, 0x82U8, 0U8, 0U8, 2).is_none() &&
        seq_len_of(0x80U8, 0U8, 0U8, 0U8, 1).is_none(),
        "utf8_seq_len: an overlong form, a surrogate, past 10FFFF, a cut and a lone tail are none")
    assert("a".utf8_seq_len(1).is_none() && "a".utf8_seq_len(-1).is_none(),
        "utf8_seq_len: an offset outside gives none")
    assert(chars.codepoint_len(0x7f) == 1 && chars.codepoint_len(0x80) == 2 &&
        chars.codepoint_len(0x7ff) == 2 && chars.codepoint_len(0x800) == 3 &&
        chars.codepoint_len(0xffff) == 3 && chars.codepoint_len(0x10000) == 4 &&
        chars.codepoint_len(0x10ffff) == 4, "codepoint_len: each width's first and last")
    assert(chars.codepoint_byte(0x20ac, 0) == 0xe2U8 &&
        chars.codepoint_byte(0x20ac, 1) == 0x82U8 && chars.codepoint_byte(0x20ac, 2) == 0xacU8 &&
        chars.codepoint_byte(0x41, 0) == 'A',
        "codepoint_byte: the bytes of U+20AC and of an ASCII letter")
    assert(chars.codepoint_byte(0x20ac, 5) == 0xacU8 &&
        chars.codepoint_byte(0x20ac, -1) == 0xe2U8,
        "codepoint_byte: past the end the last byte, below 0 the first")
    assert("a/b/c".rfind_char('/').unwrap_or(-1) == 3 &&
        "/".rfind_char('/').unwrap_or(-1) == 0 && "abc".rfind_char('/').is_none() &&
        "".rfind_char('/').is_none(), "rfind_char: the last place, or none")
    assert("Content-Length".equals_ignore_case("content-LENGTH") && "".equals_ignore_case(""),
        "equals_ignore_case: ASCII letters of either case")
    assert(!"a".equals_ignore_case("ab") && !"[".equals_ignore_case("{") &&
        !"ß".equals_ignore_case("SS"),
        "equals_ignore_case: another length, a non-letter a case apart, and no Unicode folding")
    verdict
        .pass("to_count, hex4, utf8_seq_len, codepoint_len/byte, rfind_char and equals_ignore_case \
            answer at their edges.")

fn test_builder_room_and_c_strings()
    verdict.start("[str] reserve, and a C string out and back...")
    defer $b: = Str_builder.new()
    b.reserve(100)
    assert(b.cap >= 100 && b.len == 0, "reserve: room for 100, nothing written")
    room: = b.cap
    b.s("kept")
    b.reserve(10)
    assert(b.cap == room && b.slice().equals("kept"), "reserve: less than there is does nothing")
    b.reserve(room * 4)
    assert(b.cap >= room * 4 && b.slice().equals("kept"), "reserve: growing keeps what is written")
    c: = "abc".to_cstr().unwrap_or(null)
    assert(c != null && (c + 3)$ == 0U8, "to_cstr: a copy with its NUL")
    back: = str.from_cstr(c)
    assert(back.equals("abc"), "from_cstr: the bytes before the NUL")
    mem.dealloc(Void$@::c)
    assert("a\u0000b".to_cstr().is_none(), "to_cstr: none for text holding a NUL")
    assert(str.from_cstr(null).len == 0, "from_cstr: a null pointer is empty")
    verdict.pass("reserve makes room and keeps the text; to_cstr and from_cstr round-trip.")

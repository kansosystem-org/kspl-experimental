//< Tests of threads, processes started side by side, and locks
//< `std/thread` over real OS threads, `std/subproc` started from two at once, a file lock, and a
//< `Mutex` locked again or unlocked by another thread.
import "std/ds" { List }
import "std/fs"
import "std/json"
import "std/mem" + { Arena, dealloc }
import "std/refcount" { Arc }
import "std/regex" { Regex }
import "std/stack_limit" { Stack_limit }
import "std/str" { Str_builder }
import "std/subproc"
import "std/sys"
import "std/tests/fs_test"
import "std/tests/sys_test"
import "std/thread"
import "std/verdict"

// ==========================================
// std/thread: an argument written by the thread is seen once free() waited for it, and a
// Mutex gives mutual exclusion.
// ==========================================
extern fn thread_test_double(arg: I32$@): Void$@ //< hands its result back through the argument
    arg$ *= 2
    return null

// thread.Mutex<|I32|> makes lock()'s return value the only way to reach the content.
extern fn thread_test_increment(arg: thread.Mutex<|I32|>$@): Void$@
    for _i in Range.asc(1000)
        counter: = arg.lock()
        counter$ += 1
        arg.unlock()
    return null

fn test_thread_spawn_join()
    verdict.start("[Thread] spawn/free argument round-trip + Mutex mutual exclusion test...")

    // 1. The argument reaches the thread, and what it writes there is seen once free() waited
    $marker: I32 = 42
    $t0: = thread.Thread.spawn<|I32|>(thread_test_double, marker@)
        catch panic("thread spawn failed")
    t0.free()
    assert(marker == 84, "free() must wait until the thread has written its result")

    // 2. Two threads each add 1000 times while protecting the counter with the same Mutex<I32>
    defer $mx: = thread.Mutex<|I32|>(0) catch panic("mutex create failed")
    $t1: =
        thread.Thread.spawn<|thread.Mutex<|I32|>|>(thread_test_increment, mx@)
        catch panic("thread spawn failed")
    $t2: =
        thread.Thread.spawn<|thread.Mutex<|I32|>|>(thread_test_increment, mx@)
        catch panic("thread spawn failed")
    t1.free()
    t2.free()

    final_val: = mx.lock()
    assert(final_val$ == 2000,
        "mutex-protected counter must equal 2000 after 2 threads x 1000 increments")
    mx.unlock()

    verdict
        .pass("The argument round trip and Mutex mutual exclusion under real parallelism \
            (2000/2000) are confirmed.")
// ==========================================
// std/thread with std/refcount: an `Arc`'s value is read-only, so threads change it through a
// `Mutex` or an `Atomic_sz` inside, whose methods take a read-only pointer.
// ==========================================
struct Arc_shared //< what the threads share through one `Arc`
    total: thread.Mutex<|I64|>
    hits: thread.Atomic_sz

extern fn arc_test_add(arg: Arc<|Arc_shared|>$@): Void$@
    mine: = arg.clone()
    for _i in Range.asc(1000)
        s: = mine.get()
        n: = s.total.lock()
        n$ += 1
        s.total.unlock()
        s.hits.fetch_add(1)
    return null

fn test_arc_shares_through_mutex_and_atomic()
    verdict.start("[Thread] an Arc shared by threads changes through a Mutex and an atomic...")
    total: = thread.Mutex<|I64|>(0) catch panic("mutex create failed")
    $shared: =
        Arc<|Arc_shared|>(Arc_shared::{ .total = total, .hits = thread.Atomic_sz(0) })
    $t1: = thread.Thread.spawn<|Arc<|Arc_shared|>|>(arc_test_add, shared@) catch panic("spawn")
    $t2: = thread.Thread.spawn<|Arc<|Arc_shared|>|>(arc_test_add, shared@) catch panic("spawn")
    t1.free()
    t2.free()
    s: = shared.get()
    n: = s.total.lock()
    counted: = n$
    s.total.unlock()
    assert(counted == 2000 && s.hits.load() == 2000, "no change through the Arc is lost")
    // The threads are joined, so this is the only owner, and the lock can be ended.
    whole: = shared.get_mut() catch
        panic("the only owner reaches the value")
    whole.total.free()
    verdict.pass("Two threads added 2000 times through one Arc, by its Mutex and its atomic.")

// ==========================================
// std/thread: the operations of Atomic_sz; two threads without a lock lose no addition; and
// Cond_var's wait wakes after a signal.
// ==========================================
struct Atomic_test_ctx
    counter: thread.Atomic_sz

extern fn atomic_test_worker(arg: Atomic_test_ctx$@): Void$@
    for _i in Range.asc(10000)
        arg.counter.fetch_add(1)
    return null

fn test_atomic_and_cond_var()
    verdict.start("[Thread] Atomic_sz (lock-free addition) + Cond_var (signal/wait) test...")

    // 1. Atomic_sz's basic operations
    a: = thread.Atomic_sz(5)
    assert(a.load() == 5, "Atomic_sz.load() must return the initial value")
    old: = a.fetch_add(3)
    assert(old == 5 && a.load() == 8, "fetch_add must return the pre-add value")
    a.store(100)
    assert(a.load() == 100, "store must overwrite the value")
    ok1: = a.compare_and_swap(100, 200)
    ok2: = a.compare_and_swap(100, 999)
    cas_final: = a.load()
    assert(ok1 && !ok2 && cas_final == 200,
        "compare_and_swap must only succeed when the current value matches expected")

    // 2. Two threads add 20000 times in total to the same counter, with no lock
    ctx: = mem.new(Atomic_test_ctx::{})
    ctx.counter = thread.Atomic_sz(0)
    $t1: = thread.Thread.spawn<|Atomic_test_ctx|>(atomic_test_worker, ctx)
        catch panic("thread spawn failed")
    $t2: = thread.Thread.spawn<|Atomic_test_ctx|>(atomic_test_worker, ctx)
        catch panic("thread spawn failed")
    t1.free()
    t2.free()
    counter_total: = ctx.counter.load()
    assert(counter_total == 20000, "lock-free concurrent fetch_add must not lose any increments")
    dealloc(Void$@::ctx)

    // 3. Cond_var: wait wakes after a signal (on a Mutex<|Sz|>; Raw_mutex is priv).
    defer $mx: = thread.Mutex<|Sz|>(0) catch panic("mutex create failed")
    defer $cv: = thread.Cond_var() catch panic("cond create failed")

    ready: = mx.lock()
    ready$ = 1
    cv.signal(mx@)
    mx.unlock()

    flag: = mx.lock()
    for flag$ == 0
        cv.wait(mx@)
    mx.unlock()

    verdict
        .pass("Lock-free addition (20000/20000) and Cond_var's signal/wait round trip are \
            confirmed.")

// ==========================================
// std/thread: Cond_var's broadcast wakes every waiter, and wait_for comes back at its limit.
// ==========================================
struct Gate //< what the waiters of a broadcast share, under one lock
    open: Bool //< set once, then broadcast
    waiting: Sz //< how many waiters have taken the lock to wait
    woken: Sz //< how many saw it open before their limit
    late: Sz //< how many reached their limit first

struct Gate_ctx
    mx: thread.Mutex<|Gate|>
    cv: thread.Cond_var

extern fn gate_waiter(arg: Gate_ctx$@): Void$@
    g: = arg.mx.lock()
    g.waiting += 1
    // A limit long past the test's, so a broadcast that wakes one leaves the others late.
    for !g.open
        if arg.cv.wait_for(arg.mx@, 60000) == .timed_out && !g.open
            g.late += 1
            break
    if g.open
        g.woken += 1
    arg.mx.unlock()
    return null

priv const GATE_WAITERS: Sz = 3

fn test_cond_var_broadcast_and_wait_for()
    verdict.start("[Thread] Cond_var's broadcast and wait_for test...")
    mx: = thread.Mutex<|Gate|>(Gate::{}) catch panic("mutex create failed")
    cv: = thread.Cond_var() catch panic("cond create failed")
    $ctx: = Gate_ctx::{ .mx = mx, .cv = cv }
    defer ctx.mx.free()
    defer ctx.cv.free()
    // A wait with nobody to wake it comes back at its limit, holding the lock again.
    // **`woken` can be spurious** (the contract at `wait_for`), so a wake is waited out again.
    // **Windows ends a wait up to one clock tick early** (15.6 ms by default), so the floor allows
    // one tick: 50 ms less 16 is 34.
    _held: = ctx.mx.lock()
    $alone: = thread.Cond_wait.woken
    $took_us: I64 = 0
    $tries: Sz = 0
    for alone == .woken && tries < 10
        t0: = sys.mono_us()
        alone = ctx.cv.wait_for(ctx.mx@, 50)
        took_us = sys.mono_us() - t0
        tries += 1
    at_once: = ctx.cv.wait_for(ctx.mx@, -1)
    ctx.mx.unlock()
    assert(alone == .timed_out, "wait_for with nobody to wake it times out")
    assert(took_us >= 34000I64, "wait_for with nobody to wake it waits its limit, less a clock tick")
    assert(at_once == .timed_out, "wait_for with a limit already up looks once")
    // Every waiter wakes on one broadcast.
    defer $ts: = List<|thread.Thread|>(null)
    for _i in Range.asc(GATE_WAITERS)
        ts.push(thread.Thread.spawn<|Gate_ctx|>(gate_waiter, ctx@) catch panic("spawn failed"))
    for
        w: = ctx.mx.lock()
        all_in: = w.waiting == GATE_WAITERS
        if all_in
            w.open = true
            ctx.cv.broadcast(ctx.mx@)
        ctx.mx.unlock()
        if all_in
            break
        sys.sleep_ms(1)
    for i in Range.asc(ts.len)
        ts[i].free()
    done: = ctx.mx.lock()
    woken: = done.woken
    late: = done.late
    ctx.mx.unlock()
    assert(woken == GATE_WAITERS && late == 0, "one broadcast wakes every waiter")
    verdict.pass("wait_for came back at its limit, and one broadcast woke all three waiters.")

// ==========================================
// std/subproc with std/thread: children started from two threads at once. A pipe end reaching a
// child the other thread started holds the end of output back until it ends: never, in this test.
// Caution: **Judge by the read running out, not by a time limit.** A machine running other builds
// beside the test (as CI does) makes a short child late with nothing held.
// ==========================================
priv const PAIRED_STARTS: Sz = 24 //< how many short children this thread reads to the end
priv const END_WAIT_MS: I32 = 10000 //< a read's wait; only an end held elsewhere runs it out

struct Lingering_ctx //< what the thread starting long-lived children reads
    ksplc: U8[]
    asked: thread.Atomic_sz //< how many starts the main thread has made or is making
    stop: thread.Atomic_sz

extern fn concurrency_start_lingering(arg: Lingering_ctx$@): Void$@
    // A start follows each of the main thread's at once, so the two overlap. `ksplc lsp` waits on
    // its standard input, so a child lives until it is killed, after the main thread's reads.
    $kids: subproc.Piped_child[PAIRED_STARTS] = ::{}
    $started: Sz = 0
    for arg.stop.load() == 0
        if started < arg.asked.load()
            kids[started] =
                subproc.spawn_piped(U8[][]::{ arg.ksplc, "lsp" }, "")
                catch panic("the lingering child must start")
            started += 1
        else
            sys.sleep_ms(1)
    for i in Range.asc(started)
        kids[i].kill()
    return null

fn test_spawn_from_threads(ksplc: U8[]) //<
    //< That a short child's end of output is not held by a child another thread starts meanwhile
    //< ksplc is both children (`run_std` passes it): `info keywords` prints and ends, `lsp`
    //< lingers.
    verdict
        .start("[Thread] children started from two threads at once: each end of output reaches its \
            own reader...")
    ctx: = mem.new(Lingering_ctx::{})
    ctx.ksplc = ksplc
    ctx.asked = thread.Atomic_sz(0)
    ctx.stop = thread.Atomic_sz(0)
    $t: =
        thread.Thread.spawn<|Lingering_ctx|>(concurrency_start_lingering, ctx)
        catch panic("thread spawn failed")
    $held: = false
    for i in Range.asc(PAIRED_STARTS)
        ctx.asked.store(i + 1)
        $child: =
            subproc.spawn_piped(U8[][]::{ ksplc, "info", "keywords" }, "")
            catch panic("the short child must start")
        $buf: U8[1024] = ::{}
        $open: = true
        for open
            _n: = child.read(U8$[]::buf, END_WAIT_MS) catch e
                assert(e != subproc.Read_end.failed,
                    "reading the short child's output must not fail")
                held = e == subproc.Read_end.timed_out
                open = false
                fallback 0
        child.kill()
        if held
            break
    ctx.stop.store(1)
    t.free()
    dealloc(Void$@::ctx)
    assert(!held, "no short child's end of output is held by a child started on another thread")
    verdict
        .pass("While another thread started children alongside, every short child's end of output \
            reached its reader.")

// ==========================================
// Tests of a file lock (`std/fs`), and of a `Mutex` locked again or unlocked by another thread
// ==========================================
// std/fs: a file lock, which a second holder waits for or is refused.
// **Each check works in a folder that `mkdir_unique` creates for it**, so a run never sees what an
// earlier run left.
// ==========================================

priv const BASE: U8[] = "out/tmp/kspl_test_lock"
priv const HOLD_MS: I32 = 300 //< how long the other thread holds the lock

priv struct Holder //< the thread that holds the lock, and what it tells the main thread
    path: U8[]
    holding: thread.Atomic_sz //< 1 once it has the lock
    let_go: thread.Atomic_sz //< 1 just before it releases the lock

priv fn held_elsewhere(path: U8[]): Bool //< whether try_take is refused because another holds it
    defer $_lock: = fs.File_lock.try_take(path) catch e
        switch e
        case .held_elsewhere
            return true
        default
            return false
    return false

extern fn lock_test_hold(h: Holder$@): Void$@ //<
    //< takes the lock, holds it a while, and releases it
    defer $_lock: = fs.File_lock.take(h.path) catch panic("the holder must get the free lock")
    h.holding.store(1)
    sys.sleep_ms(HOLD_MS)
    h.let_go.store(1)
    return null

fn test_file_lock()
    verdict.start("[Fs] a file lock refuses a second holder, and take waits for the first...")
    defer arena: = Arena(64 * 1024)
    dir: = fs.mkdir_unique(BASE, "lock_", arena) catch panic("cannot create the working directory")
    path: = fs.join(dir, "lock", arena)
    $first: = fs.File_lock.take(path) catch panic("a lock nobody holds must be taken")
    assert(held_elsewhere(path), "try_take must refuse, without waiting, a lock another holds")
    first.free()
    $again: = fs.File_lock.try_take(path) catch panic("a lock let go must be free again")
    again.free()
    $h: = Holder::{ .path = path, .holding = thread.Atomic_sz(0),
        .let_go = thread.Atomic_sz(0) }
    $t: = thread.Thread.spawn<|Holder|>(lock_test_hold, h@) catch panic("the holder must start")
    for h.holding.load() == 0
        sys.sleep_ms(5)
    $waited: = fs.File_lock.take(path) catch panic("take must get the lock once it is let go")
    assert(h.let_go.load() == 1, "take must wait until the holder lets the lock go")
    waited.free()
    t.free()
    fs_test.clear_tree_best_effort(dir, arena)
    verdict.pass("a second holder is refused or waits, and the lock is free once let go")

// ==========================================
// std/thread: a Mutex locked again on the thread holding it stops the program with the reason. So
// does one unlocked from a thread that does not hold it, and a thread that ends holding one.
// Without the check POSIX deadlocked and Windows let the second lock through, and the next lock
// after such an end waited for ever. So each runs as a child.
// ==========================================
priv const RELOCK_SRC: U8[] = //< a child that locks one mutex twice on one thread
    """import "std/io"
import "std/thread"

fn main()
  $m: = thread.Mutex<|I32|>(0) catch panic("the mutex must be created")
  _first: = m.lock()
  _second: = m.lock()
  io.out().s("the second lock returned\n")
  m.unlock()
"""
priv const FOREIGN_UNLOCK_SRC: U8[] = //< a child whose second thread unlocks the main one's mutex
    """import "std/thread"

extern fn foreign_unlock(m: thread.Mutex<|I32|>$@): Void$@
  m.unlock()
  return null

fn main()
  $m: = thread.Mutex<|I32|>(0) catch panic("the mutex must be created")
  _v: = m.lock()
  $t: = thread.Thread.spawn<|thread.Mutex<|I32|>|>(foreign_unlock, m@) catch panic("must start")
  t.free()
  m.unlock()
"""

priv const EXIT_HOLDING_SRC: U8[] = //< a child whose second thread ends while it holds the lock
    //< **Its main thread does not lock after the join**: without the check, that lock waits for
    //< ever, and the test would wait with it.
    """import "std/thread"

extern fn forget_unlock(m: thread.Mutex<|I32|>$@): Void$@
  _v: = m.lock()
  return null

fn main()
  $m: = thread.Mutex<|I32|>(0) catch panic("the mutex must be created")
  $t: = thread.Thread.spawn<|thread.Mutex<|I32|>|>(forget_unlock, m@) catch panic("must start")
  t.free()
"""

fn expect_lock_misuse( //< runs the three children and checks that each stopped with its reason
    //< The argvs are given whole, so a run under Wine can pass children built beforehand.
    relock: U8[][],
    foreign_unlock: U8[][],
    exit_holding: U8[][],
    arena: Arena$@,
)
    relocked: = sys_test.stops_with(relock, "Mutex.lock: this thread already holds the lock", arena)
    assert(relocked, "a second lock on the holding thread must stop the program with the reason")
    why: = "Mutex.unlock: this thread does not hold the lock"
    unlocked: = sys_test.stops_with(foreign_unlock, why, arena)
    assert(unlocked, "an unlock from a thread that does not hold the lock must stop the program")
    ended: = sys_test.stops_with(exit_holding, "Thread: the thread ended while it holds a Mutex",
        arena)
    assert(ended, "a thread that ends while it holds a lock must stop the program")

fn test_mutex_misuse(ksplc: U8[], arena: Arena$@) //< ksplc runs the children
    verdict.start("[Thread] a mutex misused (re-lock, foreign unlock, held at the end) stops...")
    expect_lock_misuse(sys_test.child_argv(ksplc, "mutex_relock", RELOCK_SRC, arena),
        sys_test.child_argv(ksplc, "mutex_foreign_unlock", FOREIGN_UNLOCK_SRC, arena),
        sys_test.child_argv(ksplc, "mutex_exit_holding", EXIT_HOLDING_SRC, arena), arena)
    verdict.pass("each misuse of a mutex stops the program and says why.")

// ==========================================
// std/thread: a signal or a broadcast from a thread that does not hold the lock stops the program
// with the reason. Given so, it can come between a waiter's check and its wait, and be lost.
// ==========================================
priv const FOREIGN_SIGNAL_SRC: U8[] = //< a child whose second thread signals while main holds
    """import "std/thread"

struct Pair
  m: thread.Mutex<|I32|>
  cv: thread.Cond_var

extern fn foreign_signal(p: Pair$@): Void$@
  p.cv.signal(p.m@)
  return null

fn main()
  m: = thread.Mutex<|I32|>(0) catch panic("the mutex must be created")
  cv: = thread.Cond_var() catch panic("the condition variable must be created")
  $p: = Pair::{ .m = m, .cv = cv }
  _v: = p.m.lock()
  $t: = thread.Thread.spawn<|Pair|>(foreign_signal, p@) catch panic("must start")
  t.free()
  p.m.unlock()
"""
priv const UNLOCKED_BROADCAST_SRC: U8[] = //< a child that broadcasts with the lock free
    """import "std/thread"

fn main()
  m: = thread.Mutex<|I32|>(0) catch panic("the mutex must be created")
  cv: = thread.Cond_var() catch panic("the condition variable must be created")
  cv.broadcast(m@)
"""

fn test_wakeup_without_lock(ksplc: U8[], arena: Arena$@) //< ksplc runs the children
    verdict.start("[Thread] a signal or a broadcast without the lock stops the program...")
    signal_argv: = sys_test.child_argv(ksplc, "cond_foreign_signal", FOREIGN_SIGNAL_SRC, arena)
    signalled: = sys_test.stops_with(signal_argv,
        "Cond_var.signal: this thread does not hold the lock", arena)
    assert(signalled, "a signal while another thread holds the lock must stop the program")
    broadcast_argv: = sys_test.child_argv(ksplc, "cond_unlocked_broadcast", UNLOCKED_BROADCAST_SRC,
        arena)
    broadcast: = sys_test.stops_with(broadcast_argv,
        "Cond_var.broadcast: this thread does not hold the lock", arena)
    assert(broadcast, "a broadcast with the lock free must stop the program")
    verdict.pass("a signal and a broadcast without the lock each stop the program and say why.")

// ==========================================
// Tests that a walk guarded by `std/stack_limit` stops before its stack runs out
// On the main thread, on a thread of its own, and in std's walks that read input.
// ==========================================
// std/stack_limit: a walk stops before its stack runs out, on the main thread and on a thread of
// its own. **Every build that `make debug` makes runs it.** A level's cost differs per build.
// ==========================================

priv const TEST_MARGIN: Sz = 64 * 1024 //< the room kept spare below where the walk stops

priv fn dig( //< how many levels deeper it goes before the limit comes near
    limit: Stack_limit$@, //< where it stops
    levels: Sz, //< the current depth
    above: U8$[], //< a buffer of the level above, which this level writes
): Sz
    // Caution: **The level above passes its buffer down and reads it after the call**, so the call
    // is never the last thing a level does. No compiler can then turn the walk into a loop that
    // uses no stack.
    $pad: U8[64] = ::{}
    above[0] = U8::(levels & 1)
    if limit.near()
        return levels
    deepest: = dig(limit, levels + 1, U8$[]::pad)
    return deepest if pad[0] <= 1U8 else -1

// **The walk must go deep.** A floor read too high stops the walk at once: it does not crash, but
// it refuses depth the stack could hold.
priv const FLOOR_LEVELS: Sz = 1000 //< the walk must get at least this deep

fn test_stack_limit_on_main()
    verdict.start("[Stack] a walk that looks stops before the main thread's stack runs out...")
    $limit: = Stack_limit(TEST_MARGIN)
    assert(!limit.near(), "at a test's head the stack is not near its end")
    $seed: U8[1] = ::{}
    levels: = dig(limit@, 0, U8$[]::seed)
    assert(levels > FLOOR_LEVELS, "the walk goes deeper than a thousand levels before it stops")
    verdict.pass("")

extern fn stack_test_walk(arg: Sz$@): Void$@
    $limit: = Stack_limit(TEST_MARGIN)
    $seed: U8[1] = ::{}
    arg$ = dig(limit@, 0, U8$[]::seed)
    return null

fn test_stack_limit_on_a_thread()
    verdict.start("[Stack] a walk that looks stops before a thread's own stack runs out...")
    $levels: Sz = 0
    $t: = thread.Thread.spawn<|Sz|>(stack_test_walk, levels@) catch panic("thread spawn failed")
    t.free()
    assert(levels > FLOOR_LEVELS, "on a thread too the walk goes deeper than a thousand levels")
    verdict.pass("")

// **The floor must be the stack's real end**, not where its reservation starts. Windows keeps the
// bottom back (16KB on 64 bits). So a margin smaller than that walks into it on a floor read from
// the bounds alone.
priv const CLOSE_MARGIN: Sz = 4 * 1024 //< a margin smaller than the pages Windows keeps back

fn test_stack_limit_close_to_the_end()
    verdict.start("[Stack] a walk with a margin of a page stops before the stack's real end...")
    $limit: = Stack_limit(CLOSE_MARGIN)
    $seed: U8[1] = ::{}
    levels: = dig(limit@, 0, U8$[]::seed)
    assert(levels > FLOOR_LEVELS, "a small margin still lets the walk go deep, and stops it alive")
    verdict.pass("")

fn test_stack_limit_later()
    verdict.start("[Stack] a limit that asks late stops the walk as one that asks at once does...")
    $limit: = Stack_limit.later(TEST_MARGIN)
    assert(!limit.near(), "where it was made, it answers without asking")
    $seed: U8[1] = ::{}
    levels: = dig(limit@, 0, U8$[]::seed)
    assert(levels > FLOOR_LEVELS, "asked late, the walk still goes deeper than a thousand levels")
    verdict.pass("")

// ==========================================
// The walks in std that read input stop before a short stack runs out. **The test leaves less
// stack than they keep free** (64KB), more than they walk before they ask where it ends. It gives
// them input their counts allow, so only the stack can stop them. Without the check they crash.
// ==========================================

priv const SHORT_ROOM: Sz = 60 * 1024 //< the stack left when the walk under test starts

priv fn on_short_stack( //< runs `job` with about `SHORT_ROOM` of the stack left
    limit: Stack_limit$@, //< made with `SHORT_ROOM` as its margin
    levels: Sz,
    above: U8$[],
    job: fn(arena: Arena$@): Bool, //< true where the walk refused as it should
    arena: Arena$@,
): Bool
    $pad: U8[64] = ::{}
    above[0] = U8::(levels & 1)
    if limit.near()
        return job(arena)
    ok: = on_short_stack(limit, levels + 1, U8$[]::pad, job, arena)
    return ok && pad[0] <= 1U8

priv fn json_refuses(arena: Arena$@): Bool //< 400 levels, within `max_nesting_depth`
    defer $doc: = Str_builder()
    for _i in Range.asc(400)
        doc.c('[')
    for _i in Range.asc(400)
        doc.c(']')
    $refused: = false
    json.parse(doc.slice(), arena) catch e
        switch e
        case .too_deep
            refused = true
        default {}
    return refused

priv fn regex_refuses(_arena: Arena$@): Bool //< 400 nested `(?:`, within `max_nesting_depth`
    //< **Compiling is the walk that recurses**, once per group level. Matching follows its ways
    //< through a list on the heap, so only the pattern's nesting can reach the stack.
    defer $pattern: = Str_builder()
    for _i in Range.asc(400)
        pattern.s("(?:")
    pattern.c('a')
    for _i in Range.asc(400)
        pattern.c(')')
    $refused: = false
    re: = Regex.compile(pattern.slice()) catch e
        switch e
        case .too_deep
            refused = true
        default {}
        return refused
    re.free()
    return false

fn test_walks_stop_on_a_short_stack(arena: Arena$@)
    verdict
        .start("[Stack] JSON and regex refuse, rather than crash, on a stack shorter than kept...")
    $limit: = Stack_limit(SHORT_ROOM)
    $seed: U8[1] = ::{}
    assert(on_short_stack(limit@, 0, U8$[]::seed, json_refuses, arena),
        "json.parse refuses nesting the stack left cannot hold, as too_deep")
    assert(on_short_stack(limit@, 0, U8$[]::seed, regex_refuses, arena),
        "Regex.compile refuses nesting the stack left cannot hold, as too_deep")
    verdict.pass("")

// ==========================================
// std/sys: the environment changes only while no thread `Thread.spawn` started still runs. The C
// library does not order a change against another thread reading it.
// ==========================================
priv const ENV_WITH_THREAD_SRC: U8[] = //< a child that changes the environment while a thread runs
    """import "std/sys"
import "std/thread"

extern fn env_test_idle(n: I32$@): Void$@
  n$ = 1
  return null

fn main()
  $n: I32 = 0
  defer $_t: = thread.Thread.spawn<|I32|>(env_test_idle, n@) catch panic("spawn")
  sys.set_env("KSPL_ENV_WITH_THREAD", "1") catch panic("set_env")
"""

extern fn env_test_idle(arg: I32$@): Void$@ //< a thread that ends at once
    arg$ = 1
    return null

fn test_env_waits_for_threads(ksplc: U8[], arena: Arena$@) //< ksplc runs the child
    verdict.start("[sys] set_env stops while a thread runs, and works once it was waited for...")
    child: = sys_test.child_argv(ksplc, "env_with_thread", ENV_WITH_THREAD_SRC, arena)
    stopped: = sys_test.stops_with(child, "a thread started with Thread.spawn still runs", arena)
    assert(stopped, "set_env while a spawned thread runs must stop the program with the reason")
    $n: I32 = 0
    $t: = thread.Thread.spawn<|I32|>(env_test_idle, n@) catch panic("spawn")
    t.free()
    sys.set_env("KSPL_ENV_AFTER_THREAD", "1") catch panic("set_env after free must succeed")
    sys.unset_env("KSPL_ENV_AFTER_THREAD") catch panic("unset_env after free must succeed")
    assert(n == 1, "the thread ran")
    verdict.pass("set_env stops while a thread runs, and works once free() waited for it.")

//< The process itself: its arguments, its environment, the clock and signals
//< The path helpers are here too (`get_dir_name`, `last_ext`, `is_absolute` and the rest). They
//< read a path as text and never touch the filesystem. Operations on the tree are in `std/fs`.
//< **`panic`, `assert` and the error trace are not here** but in `std/lang`. Here, `mem` and `ds`
//< would have to import `sys`, and a failing `main` could print no trace without it.
import "std/chars"
import "std/libc"
// **An import used on only one build carries the same `#cfg` on its import line**; without it,
// `dealloc` is reported as unused on the freestanding build ([I0401]).
#cfg(!freestanding)
import "std/mem" { dealloc }
import "std/str"
#cfg(!freestanding)
import "std/thread" { threads_running }

// ==========================================
// Managing the process and its arguments
// ==========================================

pub struct Args //< the arguments this process was started with; `[0]` is the program
    pub len: Sz //< how many there are, counting the program's own name

impl Args: Index<|Sz, U8[]|> //< so `args()[i]` can be written
    pub fn get(r: Self@, index: Sz): U8[] //<
        //< one argument; an index out of range stops the program
        assert(U64::index < U64::r.len, "args: index out of bounds")
        return (libc.argv + index).to_slice()

pub fn args(): Args //< the arguments this process was started with
    return ::{ .len = libc.argc }

#noreturn
pub fn exit( //< ends the process at once, without unwinding
    status: I32, //< what the parent sees; 0 means success
)
    libc.exit(status)

// ==========================================
// Environment variables
// ==========================================

// **The result stays valid across later reads**, so two values read one after the other can both
// be kept (`CC` in a link's argv, then `CC` again).
// Caution: **Setting or unsetting that variable can free it** (POSIX's `setenv` can); copy it to
// keep it past a change.
// **It exists only on the `#cfg(!freestanding)` side**, like `set_env` / `unset_env`.
#cfg(!freestanding)
pub fn get_env(name: U8[]): U8[]? //< an environment variable, or nothing when unset
    // The C side would cut a name at a NUL, so such a name gives .none (see str.to_cstr).
    name_buf: = name.to_cstr().unwrap_or(null)
    if name_buf == null
        return .none
    defer dealloc(Void$@::name_buf)
    // Caution: **Do not use `libc.getenv`.** Windows's narrow API returns the current code page.
    // Its result passed straight into a path mixes two encodings ("Paths are UTF-8, converted to
    // the wide API on Windows" in `std/docs/DESIGN-system.md`).
    val: = kspl_get_env(name_buf)
    if val == null
        return .none
    return .some(str.from_cstr(U8$@::val))

#cfg(!freestanding)
    extern fn kspl_set_env(name: U8@, value: U8@): Bool
    extern fn kspl_unset_env(name: U8@): Bool
    extern fn kspl_cpu_count(): I32
    extern fn kspl_cwd(buf: U8$@, cap: Sz): Sz
    extern fn kspl_exe_path(buf: U8$@, cap: Sz): Sz
    extern fn kspl_get_env(name: U8@): U8@

// **The separator is the OS's own** (`\` on Windows). **No trailing separator is added** (except
// for the root `/`). **When the path does not fit in buf, it fails**, rather than returning a
// truncated path that points somewhere else.
#cfg(!freestanding)
pub fn cwd( //< the working directory
    buf: U8$[], //< where the path is written; the result is a view into it
): U8[]!Cwd_error //< the path, as a view into `buf`
    n: = kspl_cwd(buf.ptr, buf.len)
    if n == 0
        throw .unreadable
    return U8[]::{ .ptr = buf.ptr, .len = n }

pub enum Cwd_error //< why the working directory could not be given
    unreadable //< the OS refused it, or it does not fit the buffer; the C side cannot tell which

// **Its links are resolved, and the separator is the OS's own**, as `cwd`'s.
// Caution: **Do not take it from argv[0] instead.** Started through PATH, argv[0] holds the bare
// name. Started through a link, it names the link's folder, not the one the program stands in.
#cfg(!freestanding)
pub fn exe_path( //< the path of this program's executable, to find files installed beside it
    buf: U8$[], //< where the path is written; the result is a view into it
): U8[]? //< the path, as a view into `buf`; nothing where the OS does not say or it does not fit
    //< Linux, macOS and Windows say it; another POSIX system gives nothing.
    n: = kspl_exe_path(buf.ptr, buf.len)
    if n == 0
        return .none
    return .some(U8[]::{ .ptr = buf.ptr, .len = n })

// For "how many to run in parallel": more than this is no faster, only more overhead.
#cfg(!freestanding)
pub fn cpu_count(): Sz //< how many CPUs this process can run on; 1 if unknown, never 0
    //< It follows the affinity (`taskset`, a job object) where the OS has one; a container's CPU
    //< quota is not read.
    n: = kspl_cpu_count()
    return 1 if n < 1 else n

pub const SCRIPT_ENV_NAME: U8[] = "KSPL_SCRIPT" //< how a launcher passes a script its own path.
    //< The value is "<the launched executable's path>\n<the script's path>" (see script_path).
    //< Caution: Changing the name on only one side makes script_path silently return .none.

#cfg(!freestanding)
pub enum Env_error //< why an environment variable was not set or deleted
    empty_value //< `set_env` was given an empty value; `unset_env` is what deletes
    bad_name //< the name is empty, or holds `=` or a NUL, which no environment can store
    bad_value //< the value holds a NUL, where C ends the text
    refused //< the OS did not take it (out of memory, say)

// Overwrites an existing value. **A value set here is inherited by child processes, and by
// grandchildren too**, so it does not apply to this launch only. **An empty value is refused.**
// Windows's CRT treats an empty assignment as "delete", so the same call would do different things
// per OS. To delete, call `unset_env`.
// Caution: **A failure is an error value, not a Bool.** A Bool left unread lets a test go on under
// the environment it meant to change. Its failure then shows somewhere else.
#cfg(!freestanding)
pub fn set_env( //< sets an environment variable, which children inherit
    //< **It stops the program while a thread `Thread.spawn` started still runs**: the C library
    //< does not order a change of the environment against another thread reading it. Set it
    //< before the threads start, or after `free` has waited for them.
    name: U8[], //< the variable's name
    value: U8[], //< the value; empty is refused, since `unset_env` is what deletes
): Void!Env_error
    refuse_with_threads("set_env")
    // **This is the only place that refuses.** Refusing in the per-OS layer would let one OS turn
    // it into "delete" as soon as only the other OS's layer was changed.
    if value.len == 0
        throw .empty_value
    name_buf: = env_name_cstr(name)!
    defer dealloc(Void$@::name_buf)
    val_buf: = value.to_cstr().unwrap_or(null)
    if val_buf == null
        throw .bad_value
    defer dealloc(Void$@::val_buf)
    if !kspl_set_env(name_buf, val_buf)
        throw .refused

// **This is the only way to delete** (see `set_env`). **A deletion is inherited by child
// processes, and by grandchildren too**: it cleans up a variable passed along temporarily. Deleting
// a name that is not set succeeds.
#cfg(!freestanding)
pub fn unset_env(name: U8[]): Void!Env_error //<
    //< deletes an environment variable, which children inherit
    //< It stops the program while a thread still runs, as `set_env` does.
    refuse_with_threads("unset_env")
    name_buf: = env_name_cstr(name)!
    defer dealloc(Void$@::name_buf)
    if !kspl_unset_env(name_buf)
        throw .refused

#cfg(!freestanding)
priv fn refuse_with_threads(what: U8[]) //< stops the program while another thread may read
    //< **A stop, not an error to catch**: the race is in the program's order, which a retry cannot
    //< mend.
    if threads_running() > 0
        defer $why: = str.Str_builder()
        why.s("sys.").s(what)
            .s(": a thread started with Thread.spawn still runs, and may read the ")
            .s("environment as it changes. Change it before the threads start, or after free() ")
            .s("has waited for them")
        panic(why.slice())

#cfg(!freestanding)
priv fn env_name_cstr(name: U8[]): U8$@!Env_error //< the name as C takes it; the caller frees it
    //< **Refused here, the same on every OS.** POSIX's `setenv` refuses `=`, but Windows's
    //< `_wputenv_s` reads it as the end of the name. So the two would store different variables.
    if name.len == 0 || name.find_char('=').is_some()
        throw .bad_name
    switch name.to_cstr()
    case .some(p)
        return p
    case .none
        throw .bad_name

// The equivalent of Python's `__file__`, so a script can find files beside it (with
// `get_dir_name`). **It decides by matching argv[0].** The environment variable is inherited by
// grandchildren too, so the value also carries the path of the executable the launcher started.
#cfg(!freestanding)
pub fn script_path(): U8[]? //< the script being run, if a launcher started this
    raw: U8[] = get_env(SCRIPT_ENV_NAME) catch
        return .none
    if sep: = raw.find_char('\n')
        a: = args()
        if a.len == 0 || !raw.sub(0, sep).equals(a.get(0))
            return .none
        return .some(raw.sub_from(sep + 1))
    return .none

// The running program's **path as typed** (without the folder).
// Caution: **Do not keep two paths.** argparse uses the same `prog` for the usage and for errors.
// Splitting them makes the wording differ within one tool.
// **Do not use `caller_file` instead**: it embeds the absolute path of the machine that built it.
#cfg(!freestanding)
pub fn program_name(): U8[] //< this program's name for messages, without folder or extension
    switch script_path()
    case .some(p)
        return strip_last_ext(get_file_name(p))
    case .none {}
    a: = args()
    if a.len == 0
        return ""
    return strip_last_ext(get_file_name(a.get(0)))

// ==========================================
// Signals
// ==========================================
pub typedef Signal_handler = fn(sig: I32): Void //< what `set_signal_handler` takes and returns.
    //< An unnamed function-pointer type in an extern declaration produces no valid C type name (the
    //< same holds for Thread_entry in std/thread.kspl).

#cfg(!freestanding)
extern fn kspl_signal(sig: I32, handler: Signal_handler): Signal_handler //<
    //< `sigaction` with `SA_RESTART` on POSIX; on Windows, `signal()` set again at each delivery

#cfg(!freestanding)
pub fn set_signal_handler(sig: I32, handler: Signal_handler): Signal_handler //<
    //< runs handler at each sig from now on; returns the handler before it
    //< **The handler stays set after a signal.** C's `signal()` under `-std=c99`, and on Windows,
    //< puts the default back at the first delivery. A second signal would then end the program.
    //< On POSIX, a read or write that the signal cuts short goes on (`SA_RESTART`).
    //< To put the earlier handler back, pass what this returned. The reasons are "A signal handler
    //< stays set" in std/docs/DESIGN-system.md.
    return kspl_signal(sig, handler)

pub fn raise_signal(sig: I32) //< sends a signal to this process itself
    //< For a test, or to resend a signal for its default behaviour after your own clean-up.
    libc.raise(sig)

// ==========================================
// The filesystem
// ==========================================

priv fn last_path_sep(path: U8[]): Sz? //< the position of the last separator in path, or none
    for $i: = path.len; i > 0; i -= 1
        if is_path_sep(path[i - 1])
            return .some(i - 1)
    return .none

pub fn is_absolute(path: U8[]): Bool //< whether it starts from the root; on Windows `C:\` counts
    //< Caution: **Check up to the separator after the drive.** On Windows `C:name` is relative to
    //< **that drive's current working directory**, not the root. A copy that skips the separator
    //< answers differently in just that case. On POSIX `C:\x` is a relative name.
    //< A root that opens with a separator is from the root whatever follows (`\\server\share`).
    return is_absolute_on(path, is_windows())

fn is_absolute_on(path: U8[], windows: Bool): Bool //< `is_absolute`, on Windows or on POSIX
    //< Each path helper that answers apart on Windows takes the OS as a parameter. So a test checks
    //< both answers on every OS, before any run on Windows.
    n: = root_len_on(path, windows)
    return n > 0 && (is_path_sep(path[0]) || is_path_sep(path[n - 1]))

pub fn is_path_sep(c: U8): Bool //< a path separator, `/` or `\`, on every OS; std/fs splits by it
    //< Caution: Check both `/` and `\`. A path from Windows can be mixed (MSYS2 rewrites a
    //< `/tmp/...` it passes to a child process as `D:/a/_temp/...`).
    return c == '/' || c == '\\'

pub fn root_len(path: U8[]): Sz //< the length of the root a path starts from; 0 if it has none
    //< A separator is one byte. **A drive is part of the root on Windows only**: `C:` is two and
    //< `C:\` three there. On POSIX `C:\x` is a relative name whose first folder is `C:`.
    //< On Windows a share is a root too, `\\server\share\`, and so is what follows `\\?\` or
    //< `\\.\` (`\\?\C:\`, `\\?\UNC\server\share\`). A share needs its server's name: `\\` alone, or
    //< a third separator, is the plain root `\`. std/fs measures the root by this too, so the two
    //< cannot disagree.
    return root_len_on(path, is_windows())

fn root_len_on(path: U8[], windows: Bool): Sz //< `root_len`, on Windows or on POSIX
    if windows && path.len >= 3 && is_path_sep(path[0]) && is_path_sep(path[1]) &&
        !is_path_sep(path[2])
        return windows_long_root_len(path)
    if path.len > 0 && is_path_sep(path[0])
        return 1
    if !windows
        return 0
    return drive_root_len(path)

priv fn drive_root_len(path: U8[]): Sz //< `C:` is two and `C:\` three; 0 for no drive
    if path.len < 2 || path[1] != ':'
        return 0
    return 3 if path.len >= 3 && is_path_sep(path[2]) else 2

priv fn windows_long_root_len(path: U8[]): Sz //< the root of a path opening with two separators
    //< Caution: **A share's root is its server and its share.** Cut at the first separator, every
    //< path on `\\server\share` would read as directly under `\\`, and its parent as the server.
    //< After `\\?\` the next name is the root's (`C:`, `Volume{...}`), save `UNC`, which a share
    //< follows.
    if path.len >= 4 && (path[2] == '?' || path[2] == '.') && is_path_sep(path[3])
        rest: = path.sub_from(4)
        if rest.len >= 4 && rest.sub(0, 3).equals_ignore_case("UNC") && is_path_sep(rest[3])
            return 8 + share_root_len(path.sub_from(8))
        return 4 + name_len(rest)
    return 2 + share_root_len(path.sub_from(2))

priv fn share_root_len(rest: U8[]): Sz //< `server\share\`'s length at the start of rest
    server: = name_len(rest)
    return server + name_len(rest.sub_from(server))

priv fn name_len(rest: U8[]): Sz //< the first name's length in rest, with the separator after it
    $i: Sz = 0
    for i < rest.len && !is_path_sep(rest[i])
        i += 1
    return i + 1 if i < rest.len else i

pub fn get_dir_name(path: U8[]): U8[] //<
    //< the folder part; empty for a bare name, the root for the root
    //< **A file directly under the root is in the root** (`/x` in `/`, on Windows `C:\x` in `C:\`
    //< and `\\srv\sh\x` in `\\srv\sh\`). **The root is its own folder**: `/`, `C:\` and
    //< `\\srv\sh\` give themselves. So a walk up ends where the answer stops changing.
    return get_dir_name_on(path, is_windows())

fn get_dir_name_on(path: U8[], windows: Bool): U8[] //< `get_dir_name`, on Windows or on POSIX
    if last_slash: = last_path_sep(path)
        // Caution: **Do not return empty for the root or a file under it.** Empty means the
        // current directory. So a search beside `/x` would search beside the working directory
        // instead. A file there would pick up the settings of wherever the compiler was
        // started.
        top: = root_len_on(path, windows)
        return path.sub(0, top if last_slash < top else last_slash)
    return ""

pub fn get_file_name(path: U8[]): U8[] //< the last segment, without the folder part
    if last_slash: = last_path_sep(path)
        return path.sub_from(last_slash + 1)
    return path

priv fn ext_dot(path: U8[]): Sz? //<
    //< The position of the extension's leading `.`, or none
    //< **A filename's leading `.` is not an extension** (`.bashrc` has none). **Nor is a last
    //< segment `..`**, which names the parent folder, as Python's and Rust's path functions say.
    $name_at: Sz = 0
    if last_slash: = last_path_sep(path)
        name_at = last_slash + 1
    if path.sub_from(name_at).equals("..")
        return .none
    if dot: = path.rfind_char('.')
        if dot > name_at
            return .some(dot)
    return .none

pub fn strip_last_ext(path: U8[]): U8[] //< the path without its last extension
    //< **Joined with `last_ext`, it restores the original path** (`strip_last_ext(p) + last_ext(p)
    //< == p`), so there is no "which side gets the dot" to remember.
    //< Caution: Do not change only one of them.
    if dot: = ext_dot(path)
        return path.sub(0, dot)
    return path

pub fn last_ext(path: U8[]): U8[] //< the last extension with its dot, or empty if none
    //< **The leading `.` is included.** For a double extension, call it again yourself
    //< (`last_ext(strip_last_ext("a.tar.gz"))` gives `".tar"`). **Do not add a plural such as
    //< `suffixes` in advance** (Principle 1 in `docs/DESIGN-principles.md`); adding one later only
    //< joins paths.
    if dot: = ext_dot(path)
        return path.sub_from(dot)
    return ""

// ==========================================
// Whether a path's text stays under a root
// ==========================================

pub enum Path_refusal //< why a path given from outside is refused (`fs.join_under`)
    absolute //< it starts at a root: `/x`, `\x`, a drive (`C:x`) or a share (`\\server\x`)
    climbs //< a `..` segment, or a `.` one, which names the folder it stands in
    empty_segment //< `a//b`, or a `/` at either end
    backslash //< a `\`: a separator on Windows, but a byte of a name on POSIX
    control //< a NUL, another byte below a space, or DEL
    colon //< a `:`, which starts a drive, or on Windows a stream (`x::$DATA` gives `x`)
    trailing_dot_or_space //< a segment that ends in `.` or a space, which Windows drops
    device //< a name Windows opens as a device at any level (`CON`, `NUL`, `COM1`, `LPT1.txt`)
    short_name //< a `~` before a digit, the form of a Windows short name (`GIT~1` for `.git`)
    wildcard //< `*`, `?`, `<`, `>`, `"` or `|`, which Windows reads as a pattern or refuses
    link //< a link or a junction stands on the way, which could lead out of the root
    hidden //< a name starts with a dot (`.git`, `.env`), and the caller keeps those back

impl Path_refusal
    pub fn text(r: Self): U8[] //<
        //< the reason as a phrase, for a message that a person or a model reads
        switch r
        case .absolute
            return "it starts at a root; give it relative to the folder"
        case .climbs
            return "a `..` or `.` step leaves or names the folder; give the path without one"
        case .empty_segment
            return "it has an empty step (`//`, or a `/` at an end)"
        case .backslash
            return "it holds a `\\`; separate the steps with `/`"
        case .control
            return "it holds a control character"
        case .colon
            return "it holds a `:`"
        case .trailing_dot_or_space
            return "a name ends in `.` or a space, which Windows drops"
        case .device
            return "a name is one Windows opens as a device (such as CON or COM1)"
        case .short_name
            return "a name has `~` before a digit, the form of a Windows short name"
        case .wildcard
            return "it holds a wildcard (`*`, `?`, `<`, `>`, `\"` or `|`)"
        case .link
            return "a link stands on the way, which could lead out of the folder"
        case .hidden
            return "a name starts with a dot, and such names are kept back"

pub fn outside_path_refusal( //< why a relative path from outside is refused by its text alone
    //< The text half of `fs.join_under`, **which is what a caller uses**: it adds the link check.
    //< It refuses what `is_safe_relative` refuses, and also a `\`, an empty segment, a short
    //< name's `~1` and a wildcard, **on every OS**: one test on Linux then holds for Windows. Why
    //< each is refused is "A path from outside goes through one door" in
    //< `std/docs/DESIGN-system.md`.
    path: U8[], //< the path from outside, `/` between its steps
): Path_refusal? //< none where the text may be joined under a root
    if path.len == 0
        return .some(.empty_segment)
    if is_path_sep(path[0]) ||
        path.len >= 2 && path[1] == ':' &&
        (path[0].is_upper() || path[0].is_lower())
        return .some(.absolute)
    if path.find_char('\\').is_some()
        return .some(.backslash)
    $start: Sz = 0
    for start <= path.len
        end: = segment_end(path, start)
        if why: = outside_segment_refusal(path.sub(start, end - start))
            return .some(why)
        start = end + 1
    return .none

priv fn outside_segment_refusal(seg: U8[]): Path_refusal? //< one segment's part of the above
    if seg.len == 0
        return .some(.empty_segment)
    if why: = segment_refusal(seg)
        return .some(why)
    for i in Range.asc(seg.len)
        c: = seg[i]
        if c == '*' || c == '?' || c == '<' || c == '>' || c == '"' || c == '|'
            return .some(.wildcard)
        if c == '~' && i + 1 < seg.len && seg[i + 1].is_digit()
            return .some(.short_name)
    return .none

pub fn is_safe_relative(path: U8[]): Bool //< whether the path's text alone cannot climb out
    //< Caution: **This alone does not keep a path under the root**: a link inside it leads out.
    //< It checks segment by segment (matching `..` as a substring would also refuse `..foo`). **A
    //< path from outside goes through `fs.join_under`**, which refuses more forms; this rule is
    //< for a path the program's user wrote, where a `\` may separate on Windows.
    //< **Do not make the answer depend on `is_windows()`**, or a path that is safe on Linux
    //< becomes a hole on Windows only.
    if path.len == 0
        return false
    if is_path_sep(path[0])
        return false
    $start: Sz = 0
    for start <= path.len
        end: = segment_end(path, start)
        // An empty segment is a repeated separator (`a//b`), which points at the same place.
        if end > start && segment_refusal(path.sub(start, end - start)).is_some()
            return false
        start = end + 1
    return true

pub fn segment_end(path: U8[], from: Sz): Sz //< where the path's segment starting at `from` ends
    //< The next separator at or after `from`, or the path's length; every walk over a path's
    //< segments steps by this, so all of them split alike.
    $i: = from
    for i < path.len && !is_path_sep(path[i])
        i += 1
    return i

priv fn is_dos_device(seg: U8[]): Bool //< whether it is a name Windows opens as a device
    //< It is a device even with an extension, and case does not matter.
    //< **It is a device at any level**: `www/CON` opens the console, and a read or write on an
    //< unconnected `COM1` never returns, stalling a single-loop server.
    //< Caution: **Windows trims spaces before the extension** (`CON .txt` is `CON`), and counts
    //< `CONIN$`, `CONOUT$` and the superscript `COM¹²³` / `LPT¹²³` among the names too.
    base: = seg.sub(0, seg.find_char('.').unwrap_or(seg.len)).trim_end()
    if base.equals_ignore_case("con") || base.equals_ignore_case("prn") ||
        base.equals_ignore_case("aux") || base.equals_ignore_case("nul") ||
        base.equals_ignore_case("conin$") || base.equals_ignore_case("conout$")
        return true
    port: =
        base.len >= 3 &&
        (base.sub(0, 3).equals_ignore_case("com") ||
        base.sub(0, 3).equals_ignore_case("lpt"))
    if !port
        return false
    if base.len == 4 && base[3].is_digit()
        return true
    // ¹ ² ³ in UTF-8.
    return base.len == 5 && base[3] == 0xC2U8 &&
        (base[4] == 0xB9U8 || base[4] == 0xB2U8 || base[4] == 0xB3U8)

priv fn segment_refusal(seg: U8[]): Path_refusal? //<
    //< Why one segment, not empty, is unsafe as a name under the root; both rules above share it
    //< Caution: **Do not let through a path the OS reinterprets.** Windows drops a trailing `.` and
    //< space (`secret.key.` is `secret.key`), and a `:` starts an NTFS stream name
    //< (`secret.key::$DATA` gives the contents).
    if seg.equals("..") || seg.equals(".")
        return .some(.climbs)
    if seg[seg.len - 1] == '.' || seg[seg.len - 1] == ' '
        return .some(.trailing_dot_or_space)
    for i in Range.asc(seg.len)
        // A control character breaks the display of a log or terminal; `:` marks a drive or a
        // stream.
        if seg[i] < ' ' || seg[i] == 0x7FU8
            return .some(.control)
        if seg[i] == ':'
            return .some(.colon)
    if is_dos_device(seg)
        return .some(.device)
    return .none

extern fn kspl_mono_us(): I64
extern fn kspl_is_windows(): Bool
extern fn kspl_sleep_ms(ms: I32)

pub fn mono_us(): I64 //< a clock that only goes forward, in microseconds
    //< **Only a difference has meaning**; the origin is not defined.
    //< Caution: **Do not measure elapsed time with the wall clock (`wall_seconds`).** NTP or the
    //< user can rewind it, so a difference can go negative. **It is not CPU time**: it advances
    //< while waiting.
    return kspl_mono_us()

pub fn deadline_after_ms(ms: I64): I64 //< the `mono_us` reading `ms` milliseconds from now
    //< **Each caller rounds what is left its own way** (a wait that must not end early rounds up).
    return mono_us() + ms * 1000I64

pub fn wall_seconds(): I64 //< the wall clock: the seconds elapsed since 1970-01-01T00:00:00Z
    //< **It is the date and time, not a stopwatch.** NTP or the user can set it back. So a
    //< difference between two readings can be negative. To measure how long something takes, use
    //< `mono_us`.
    return libc.time(null)

pub fn timing_available(): Bool //< whether this environment has a clock at all
    //< A working clock never returns 0, whatever its origin, so that is what is checked.
    return mono_us() != 0

pub fn is_windows(): Bool //< whether the OS running this is Windows
    //< Lets a test or tool that relies on a POSIX-only path such as `/bin/echo` skip itself.
    return kspl_is_windows()

// Caution: **Do not wait with a busy spin.** It uses a whole core for the entire wait and slows
// every other job. Where a read with a timeout (`Piped_child.read`) can do the waiting, prefer it.
#cfg(!freestanding)
pub fn sleep_ms(ms: I32) //< waits that many milliseconds, yielding the CPU
    kspl_sleep_ms(ms)

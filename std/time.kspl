//< The wall clock, as the seconds since the epoch
//<
//< **It is the date and time, not a stopwatch**: NTP or the user can set it back, so a difference
//< between two readings can be negative. To measure how long something takes, use `sys.mono_us`.
import "std/libc"

pub fn now(): I64 //< the seconds elapsed since 1970-01-01T00:00:00Z
    return libc.time(null)

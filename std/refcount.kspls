//< Shared ownership of one value by reference counting: `Rc<|T|>`, `Arc<|T|>` and their weak forms
//<
//< **Do not write `retain` and `release` by hand.** Both types conform to `Ref_counted`, so the
//< compiler inserts them on a copy and on leaving a scope. `Rc<|T|>` is for a single thread, and
//< `Arc<|T|>` counts atomically, so threads can share it.

// ==========================================
// `ksplc/lower/arc.kspls` inserts `retain` and `release`. It finds the types by the FQN of
// `Ref_counted` in `std/lang.kspls`, not by where this type lives. **`Arena` is in
// `std/mem.kspls`** (`ksplc` hard-codes the name `std.mem.Arena`).
// ==========================================
import "std/mem" { alloc_as, dealloc, zero }

priv fn release_value<|T|>(place: T$@) //<
    //< Releases every ARC value the value at `place` holds, leaving it the zero value
    //<
    //< Assigning the zero value makes the compiler release the value overwritten, chained through
    //< fields, payloads and elements as on leaving a scope; for a `T` holding no ARC it is a plain
    //< write. `List.free` gives its elements back the same way.
    $empty: T[1] = ::{}
    place$ = empty[0]

// ============================ Rc<T> ============================

priv struct Control<|T|> //< the storage shared by the single-thread and atomic wrappers
    strong: Sz
    weak: Sz //< explicit weak handles plus one held by all strong owners together
    value: T

priv fn new_control<|T|>(value: T@): Control<|T|>$@
    c: = alloc_as<|Control<|T|>|>()
    // Zero before assignment: ARC releases the overwritten value, so garbage would be followed.
    zero(Void$@::c.value@, sizeof(T))
    c.strong = 1
    c.weak = 1
    c.value = value$
    return c

pub struct Rc<|T|> //< a shared owner counted by the compiler, for one thread
    //<
    //< **The last release takes the value apart**: every ARC value `T` holds (an `Rc` field, an
    //< array of them) is released too, to any depth, as when `T` leaves a scope on the stack.
    //< Caution: **That release runs at the line where the last owner goes**, and a long chain
    //< (`next: Rc<|Node|>` a million deep) recurses once per node there. Walk such a chain in a
    //< loop first ("Release takes the value apart" in `std/docs/DESIGN.md`). A resource that is not
    //< ARC (a `List`, a file) still needs its `free()`.
    priv ctrl: Control<|T|>$@

pub struct Weak_rc<|T|> //< a handle that does not own the value, so a cycle does not leak
    //<
    //< downgrade() returns it. Two `Rc<|T|>` pointing at each other never reach 0 (there is no
    //< cycle-detecting GC); making one side a `Weak_rc` avoids the leak. The compiler counts it as
    //< it counts `Rc<|T|>`, but changes the weak count.
    priv ctrl: Control<|T|>$@

pub enum Weak_error //< why a weak handle could not become an owner again
    value_dropped //< every owner had already released the value

impl<|T|> Rc<|T|>
    pub fn new( //< moves a value onto the heap and returns the first owner
        value: T, //< the value to share; it is copied in once and never again
    ): Rc<|T|>
        return ::{ .ctrl = new_control<|T|>(value@) }
    pub fn empty(): Rc<|T|> //< a handle that owns nothing
        //<
        //< Caution: `get()` / `clone()` / `downgrade()` on an empty handle are undefined, like a
        //< null dereference. It equals `::{}`, an empty slot.
        return ::{ .ctrl = null }
    pub fn is_empty(r: Self$@): Bool //< whether this handle owns nothing
        return r.ctrl == null
    pub fn clone(r: Self$@): Rc<|T|> //< one more owner of the same value
        r.ctrl.strong += 1
        return ::{ .ctrl = r.ctrl }
    pub fn get(r: Self$@): T$@ //< the value itself, which stays alive while any owner does
        return r.ctrl.value@
    pub fn downgrade(r: Self$@): Weak_rc<|T|> //< a handle that watches without owning
        r.ctrl.weak += 1
        return ::{ .ctrl = r.ctrl }

impl<|T|> Rc<|T|>: Ref_counted //< the compiler counts it, so no call is written by hand
    //<
    //< priv, because only the compiler calls it.
    //< **The zero value (ctrl == null) is an empty handle that owns nothing, and retain/release do
    //< nothing on it.** A chained release walks zeroed memory (an array's empty slots), which would
    //< otherwise crash.
    priv fn retain(r: Self@) //< one more owner, inserted by the compiler on a copy
        if r.ctrl == null
            return
        r.ctrl.strong += 1
    priv fn release(r: Self@) //<
        //< Decrements strong; at 0 releases the value, and frees `Control` if weak is 0 too
        //<
        //< The implicit weak keeps the block alive while the value releases its own weak handles.
        if r.ctrl == null
            return
        r.ctrl.strong -= 1
        if r.ctrl.strong > 0
            return
        release_value<|T|>(r.ctrl.value@)
        r.ctrl.weak -= 1
        if r.ctrl.weak == 0
            dealloc(Void$@::r.ctrl)

impl<|T|> Weak_rc<|T|>
    pub fn clone(r: Self$@): Weak_rc<|T|> //< one more weak handle to the same value
        r.ctrl.weak += 1
        return ::{ .ctrl = r.ctrl }
    pub fn upgrade(r: Self$@): Rc<|T|>!Weak_error //< an owner again, if the value is still alive
        if r.ctrl.strong == 0
            throw .value_dropped
        r.ctrl.strong += 1
        return ::{ .ctrl = r.ctrl }

impl<|T|> Weak_rc<|T|>: Ref_counted //< the compiler counts it, so no call is written by hand
    priv fn retain(r: Self@) //<
        //< Increments the weak count on a copy (a zero value is empty; see the Rc impl)
        if r.ctrl == null
            return
        r.ctrl.weak += 1
    priv fn release(r: Self@) //<
        //< Decrements weak, and frees `Control` when the implicit weak has gone too
        if r.ctrl == null
            return
        r.ctrl.weak -= 1
        if r.ctrl.weak == 0
            dealloc(Void$@::r.ctrl)

// ============================ Arc<T> ============================ The reference-counting wrapper
// that threads can share (the equivalent of Rust's `Arc<T>`). The only difference from `Rc<|T|>`
// is that strong/weak change by atomic operations built on kspl_atomic_add/kspl_atomic_cas. These
// are the __atomic builtins in ksplc/gen/runtime/core.c on both backends (an LLVM artefact links
// that runtime).
extern "C"
    fn kspl_atomic_add(ptr: Sz$@, delta: Sz): Sz
    fn kspl_atomic_cas(ptr: Sz$@, expected: Sz, new_val: Sz): Sz

pub struct Arc<|T|> //< a shared owner counted atomically, so threads can share it
    //<
    //< The compiler counts it as it counts `Rc<|T|>`, but atomically. As with `Rc<|T|>`, the last
    //< release takes the value apart, at the line and **on the thread** where the last owner goes.
    //< Caution: **An `Rc` inside `T` is then released from that thread**; hold only `Arc` in a
    //< value threads share.
    priv ctrl: Control<|T|>$@

pub struct Weak_arc<|T|> //< the `Arc` version of `Weak_rc`, which threads can share
    //<
    //< As with `Weak_rc<|T|>`, making one side of a cycle a `Weak_arc` avoids the leak; the weak
    //< count changes atomically.
    priv ctrl: Control<|T|>$@

priv fn _drop_implicit_weak<|T|>(ctrl: Control<|T|>$@) //<
    //< Decrements weak atomically by one; only the thread that brings it to 0 frees `Control`
    //<
    //< Arc.release() and Weak_arc.release() both call it, so one atomic variable decides which
    //< decrement is the last, and the memory cannot be freed twice.
    prev_weak: = kspl_atomic_add(ctrl.weak@, -1)
    if prev_weak == 1
        dealloc(Void$@::ctrl)

impl<|T|> Arc<|T|>
    pub fn new( //< moves a value onto the heap and returns the first owner
        value: T, //< the value threads share; it is copied in once and never again
    ): Arc<|T|>
        return ::{ .ctrl = new_control<|T|>(value@) }
    pub fn empty(): Arc<|T|> //< a handle owning nothing
        //<
        //< Caution: As with `Rc<|T|>`, `get()` / `clone()` / `downgrade()` on an empty handle are
        //< undefined.
        return ::{ .ctrl = null }
    pub fn is_empty(r: Self$@): Bool //< whether this handle owns nothing
        return r.ctrl == null
    pub fn clone(r: Self$@): Arc<|T|> //< one more owner of the same value
        kspl_atomic_add(r.ctrl.strong@, 1)
        return ::{ .ctrl = r.ctrl }
    pub fn get(r: Self$@): T$@ //< the value itself, which stays alive while any owner does
        return r.ctrl.value@
    pub fn downgrade(r: Self$@): Weak_arc<|T|> //< a handle that watches without owning
        kspl_atomic_add(r.ctrl.weak@, 1)
        return ::{ .ctrl = r.ctrl }

impl<|T|> Arc<|T|>: Ref_counted //< the compiler counts it, so no call is written by hand
    priv fn retain(r: Self@) //<
        //< Increments the strong count atomically on a copy (a zero value is empty; see `Rc<|T|>`)
        if r.ctrl == null
            return
        kspl_atomic_add(r.ctrl.strong@, 1)
    priv fn release(r: Self@) //< decrements strong atomically by one
        //<
        //< kspl_atomic_add returns the old value, so 1 means this thread brought it to 0 and drops
        //< the implicit weak reference.
        if r.ctrl == null
            return
        prev_strong: = kspl_atomic_add(r.ctrl.strong@, -1)
        if prev_strong == 1
            // The implicit weak, still held, keeps the block alive while the value is released.
            release_value<|T|>(r.ctrl.value@)
            _drop_implicit_weak<|T|>(r.ctrl)

impl<|T|> Weak_arc<|T|>
    pub fn clone(r: Self$@): Weak_arc<|T|> //< one more weak handle to the same value
        kspl_atomic_add(r.ctrl.weak@, 1)
        return ::{ .ctrl = r.ctrl }
    pub fn upgrade(r: Self$@): Arc<|T|>!Weak_error //< an owner again, if the value is still alive
        //<
        //< A plain fetch-add could raise strong from 0 to 1, so a CAS increments only a non-zero
        //< value it read, and retries when another thread changed it first.
        for
            current: = kspl_atomic_add(r.ctrl.strong@, 0) // an atomic read
            if current == 0
                throw .value_dropped
            observed: = kspl_atomic_cas(r.ctrl.strong@, current, current + 1)
            if observed == current
                break
        return ::{ .ctrl = r.ctrl }

impl<|T|> Weak_arc<|T|>: Ref_counted //< the compiler counts it, so no call is written by hand
    priv fn retain(r: Self@) //<
        //< Increments the weak count atomically on a copy (a zero value is empty; see `Rc<|T|>`)
        if r.ctrl == null
            return
        kspl_atomic_add(r.ctrl.weak@, 1)
    priv fn release(r: Self@)
        if r.ctrl == null
            return
        _drop_implicit_weak<|T|>(r.ctrl)

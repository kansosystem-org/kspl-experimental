//< Strings that are built and grown: `Str_builder`, and the string functions that allocate
//< Reading and slicing a `U8[]` without allocating is in `std/chars`. A `Str_builder` receives
//< automatic cleanup. Where growth is not acceptable use `std/buf`'s `Buf_writer`; for text that
//< lives as long as an arena, use `Arena_text`.
import "std/chars" // classifying and converting characters, and code points as strings
import "std/ds" + { List }
import "std/mem" + { Arena, alloc, dealloc }
// Caution: **Keep this import even if nothing here seems to call it.** It brings each type's `fmt`,
// which `\{x\}` calls, into every program that uses this file. The call is made inside `put`, which
// needs no import. `to_hex_lower` is its only direct use.
import "std/strfmt"

pub enum Str_error //< why a string could not be parsed
    invalid_format //< an escape or a form the notation does not allow
    out_of_bounds //< a position or a value out of range

pub fn from_cstr(c_str: U8$@): U8$[] //<
    //< a C string as a slice of its bytes before the NUL, which it views and does not copy
    //< A null pointer gives an empty slice, so what a C function returns can be passed as it is.
    return c_str.to_slice()

pub struct Str_builder //< a growing buffer whose owner frees it with `free()`
    pub ptr: U8$@ //< the memory holding the written bytes
    pub len: Sz //< how many bytes have been written
    pub cap: Sz //< how many bytes fit before it has to grow

impl Str_builder
    pub fn new(): Str_builder //< an empty builder, which has allocated no memory yet
        return Str_builder::{ .ptr = null, .len = 0, .cap = 0 }
    #ends_views
    pub fn escape_and_append( //< writes a JSON string's contents; the caller writes the quotes
        //< Caution: **Escape everything below 0x20.** JSON allows no raw control character (RFC
        //< 8259); escaping only `\n`, `\r` and `\t` makes **JSON that no other parser accepts** for
        //< a string with `0x01`. U8[]'s unescape_to_arena decodes it; changing only one breaks the
        //< round trip. A byte that is not well-formed UTF-8 is written as U+FFFD.
        r: Self$@,
        src: U8[], //< the plain text, not yet escaped; it can be a view of this builder's bytes
    ): Self$@
        // Caution: **Escape from a copy when `src` lies in this builder's memory.** A write can
        // move the buffer out from under it, and what is written can land on bytes not yet read.
        if r.holds(src)
            copy: = U8$@::alloc(src.len)
            mem.copy(Void$@::copy, Void$@::src.ptr, src.len)
            r.escape_and_append(U8[]::{ .ptr = copy, .len = src.len })
            dealloc(Void$@::copy)
            return r
        $i: Sz = 0
        for i < src.len
            c: = (src.ptr + i)$
            // A run of bytes that need no escape goes out in one write, not a byte at a time.
            if plain_json_byte(c)
                $j: = i + 1
                for j < src.len && plain_json_byte((src.ptr + j)$)
                    j += 1
                r.s(src.sub(i, j - i))
                i = j
                continue
            // Caution: **Do not pass a byte that is not UTF-8 through.** JSON text is UTF-8 (RFC
            // 8259 §8.1), so std/json's parser refuses it, and the writer's output would not read
            // back.
            if c >= 0x80U8
                if n: = src.utf8_seq_len(i)
                    r.s(src.sub(i, n))
                    i += n
                else
                    r.s("\uFFFD")
                    i += 1
                continue
            switch c
            case '"'
                r.s("\\\"")
            case '\\'
                r.s("\\\\")
            case '\n'
                r.s("\\n")
            case '\r'
                r.s("\\r")
            case '\t'
                r.s("\\t")
            case 0x08U8
                r.s("\\b")
            case 0x0cU8
                r.s("\\f")
            default
                if c < 0x20U8
                    r.s("\\u00\{c:02x\}")
                else
                    r.c(c)
            i += 1
        return r
    #ends_views
    pub fn clear(r: Self$@): Self$@ //< empties it, keeping the memory already allocated
        r.len = 0
        return r
    #ends_views
    pub fn drop_prefix( //< drops the leading bytes and moves the rest to the start
        //< For removing a message already read from a receive buffer, which can hold the start of
        //< the next one. It frees no memory: a long-lived buffer stays at the size of the longest
        //< message.
        r: Self$@,
        n: Sz, //< how many bytes to drop; the length or more empties it, negative does nothing
    ): Self$@
        if n <= 0
            return r
        if n >= r.len
            r.len = 0
            return r
        rest: = r.len - n
        mem.move(Void$@::r.ptr, Void$@::(r.ptr + n), rest) // the two ranges overlap
        r.len = rest
        return r
    #ends_views
    pub fn reserve( //< makes room in advance, so a long write does not grow step by step
        r: Self$@,
        new_cap: Sz, //< how many bytes must fit; a smaller value does nothing
    )
        if block: = r.grow(new_cap)
            dealloc(Void$@::block)
    priv fn grow(r: Self$@, new_cap: Sz): U8$@? //<
        //< Makes room for new_cap bytes, and returns the old buffer for the caller to free
        //< None when nothing was replaced. The caller frees it only after reading what it needs
        //< from it.
        if r.cap >= new_cap
            return .none
        $cap: Sz = 8 if r.cap == 0 else r.cap
        for cap < new_cap
            doubled: = cap * 2
            if doubled <= cap
                // cap*2 wraps near Sz's upper bound (it can become 0), so use new_cap as it is. The
                // alloc that follows catches an absurdly large new_cap.
                cap = new_cap
                break
            cap = doubled

        new_ptr: = U8$@::alloc(cap)
        if r.len > 0
            mem.copy(Void$@::new_ptr, Void$@::r.ptr, r.len)
        // Caution: **Decide by cap, not by ptr or len.** `free()` leaves ptr behind with cap 0, and
        // an old buffer at len 0 still has to be freed.
        old: U8$@? = .some(r.ptr) if r.cap > 0 else .none
        r.ptr = new_ptr
        r.cap = cap
        return old
    priv fn holds(r: Self@, s: U8[]): Bool //< whether `s` overlaps the memory this builder holds
        at: = Sz::s.ptr
        base: = Sz::r.ptr
        return r.cap > 0 && s.len > 0 && at < base + r.cap && base < at + s.len
    #gives_view
    pub fn slice(r: Self$@): U8$[] //< a view of what has been written, valid until the next change
        return U8$[]::{ .ptr = r.ptr, .len = r.len }

impl Str_builder: Writer //< so it can be used anywhere a `Writer` is expected
    #ends_views
    #inline
    pub fn s(r: Self$@, s: U8[]): Self$@ //< writes a string, growing if needed
        //< `s` can be a view of this builder's own bytes (`b.s(b.slice())`).
        if s.len > 0
            // Caution: **Read `s` before the old buffer is freed, and with `move`.** It can be a
            // view of this buffer: growing frees it, and a view taken before `clear()` can overlap
            // where the bytes land.
            old: = r.grow(r.len + s.len)
            mem.move(Void$@::(r.ptr + r.len), Void$@::s.ptr, s.len)
            if block: = old
                dealloc(Void$@::block)
            r.len += s.len
        return r

    #ends_views
    #inline
    pub fn c(r: Self$@, c: U8): Self$@ //< writes one byte, growing if needed
        if r.len >= r.cap
            r.reserve(r.len + 1)
        dest: U8$@ = r.ptr + r.len
        dest$ = c
        r.len += 1
        return r

    pub fn flush(r: Self$@): Self$@ //< does nothing, and is here to complete `Writer`
        return r

impl Str_builder: Formattable //< so it can be used inside an interpolation
    pub fn fmt(r: Self$@, w: Writer): Writer //< writes its contents to `w`
        return w.s(r.slice())

#inline
priv fn plain_json_byte(c: U8): Bool //< whether a JSON string holds this byte as it is, unescaped
    return c >= 0x20U8 && c < 0x80U8 && c != '"' && c != '\\'

priv fn write_utf8(dst: U8$@, cp: I32): Sz //<
    //< Writes a code point in UTF-8 and returns the bytes written
    //< Caution: There must be room for 4 bytes.
    //< **std/chars holds the character tables**; a copy here could drift from `next_codepoint`.
    n: = chars.codepoint_len(cp)
    for i in Range.asc(n)
        (dst + i)$ = chars.codepoint_byte(cp, i)
    return n

impl U8[]
    pub fn to_cstr(r: U8[]): U8$@? //<
        //< a new NUL-terminated copy, or none if r holds a NUL
        //< Caution: The caller must `dealloc()` it. A KSPL string has a length, so it can hold a
        //< NUL, but C treats the first NUL as the end.
        if r.contains_nul()
            return .none
        buf: = U8$@::alloc(r.len + 1)
        mem.copy(Void$@::buf, Void$@::r.ptr, r.len)
        (buf + r.len)$ = 0U8
        return .some(buf)

    pub fn split( //< the pieces between the separators, as views into the original
        //< Not a lazy iterator: the only form of iteration is `for x in <something with .len and an
        //< index>` ("Loops" in docs/SPEC-programming-language.md).
        //< Caution: When arena is null it allocates on the global heap, so the caller frees it with
        //< a `defer` (the same convention as `List.new`).
        r: U8[],
        delimiter: U8, //< the separator byte
        arena: Arena$@, //< where the list goes; null uses the global heap and the caller frees it
    ): List<|U8[]|>
        $out: = List<|U8[]|>(arena)
        $start: Sz = 0
        for i in Range.asc(r.len)
            if (r.ptr + i)$ == delimiter
                out.push(r.sub(start, i - start))
                start = i + 1
        out.push(r.sub(start, r.len - start))
        return out

    pub fn replace( //< a new string with every occurrence replaced
        //< Unlike `trim_*`, it returns a copy: the result does not exist anywhere in the original.
        r: U8[],
        old: U8[], //< the text to find; empty does nothing
        new: U8[], //< the text to put in its place
        arena: Arena$@, //< where the new string goes; null uses the global heap, freed with `dealloc`
    ): U8[]
        defer $b: = Str_builder()
        $pos: Sz = 0
        for old.len > 0 && pos < r.len
            rest: = r.sub_from(pos)
            switch rest.find_str(old)
            case .some(idx)
                b.s(rest.sub(0, idx)).s(new)
                pos += idx + old.len
            case .none
                break
        b.s(r.sub_from(pos))
        return arena.dup_str(b.slice())

    pub fn to_lower_ascii( //< a copy with the ASCII letters made lower case
        //< ASCII only, as `equals_ignore_case`: every other byte, a UTF-8 one too, is copied as it
        //< is.
        r: U8[],
        arena: Arena$@, //< where the copy goes; null uses the global heap, freed with `dealloc`
    ): U8[]
        out: = arena.dup_str(r)
        for i in Range.asc(out.len)
            (out.ptr + i)$ = (out.ptr + i).to_lower()
        return out

    // Use this for a text file, not `split('\n', ...)`. Lines of a CRLF file from Windows would
    // keep the `\r` and not compare equal. And `"a\n"` would give two elements rather than one
    // line.
    pub fn lines( //< the lines, without trailing `\r` and with no empty line after the last newline
        r: U8[],
        arena: Arena$@, //< where the list goes; null uses the global heap and the caller frees it
    ): List<|U8[]|>
        $out: = List<|U8[]|>(arena)
        $start: Sz = 0
        // A trailing newline starts no new line, so the loop ends at the end of the text.
        for start < r.len
            rest: = U8[]::{ .ptr = r.ptr + start, .len = r.len - start }
            $e: = r.len
            if k: = rest.find_char('\n')
                e = start + k
            next: = e + 1
            if e > start && (r.ptr + e - 1)$ == '\r'
                e -= 1
            out.push(U8[]::{ .ptr = r.ptr + start, .len = e - start })
            start = next
        return out

    pub fn join( //< joins the pieces, with the receiver between each pair
        r: U8[],
        parts: U8[][], //< borrowed pieces, from an array, a list's slice or a subrange
        arena: Arena$@, //< where the joined string goes; null means the heap, freed with `dealloc`
    ): U8[]
        b: = arena.text()
        for i in Range.asc(parts.len)
            if i > 0
                b.s(r)
            b.s(parts[i])
        return b.take()

    pub fn unescape_to_arena( //< turns the text of a string literal back into the bytes it means
        //< **An unknown alphanumeric escape fails** (`\x` and `\q` are `invalid_format`). Only
        //< `\n`, `\r`, `\t`, `\b`, `\f` and `\uXXXX` are decoded, and an escaped symbol is the
        //< symbol itself; the caller lists which symbols are allowed (std/json's is_json_escape).
        //< The reason is in "After `\`, an alphanumeric is accepted only in a defined escape" in
        //< std/docs/DESIGN-core.md.
        r: U8[],
        arena: Arena$@, //< where the unescaped bytes go; null means the heap, freed with `dealloc`
    ): U8[]!Str_error
        // The output is never longer than the input, so r.len + 1 is enough.
        buf_ptr: = U8$@::arena.alloc(r.len + 1)
        // A refused text leaves the caller nothing: on the heap the buffer goes back.
        return r.unescape_into(buf_ptr) catch e
            if arena == null
                dealloc(Void$@::buf_ptr)
            throw e

    priv fn unescape_into(r: U8[], buf_ptr: U8$@): U8[]!Str_error //<
        //< Writes the bytes the literal text means to buf_ptr, which has room for r.len + 1
        $w: Sz = 0
        // Caution: **`Sz`, as the length is.** Left to the literal's `I32`, it wraps past 2 GiB of
        // input, and the reads go before the start while `w` writes past the buffer's end.
        $i: Sz = 0
        for i < r.len
            c: = (r.ptr + i)$
            // Caution: **A `\` with nothing after it is broken, not a backslash.** Kept, it would
            // read as one, and a literal cut off inside an escape would pass as whole.
            if c == '\\' && i + 1 >= r.len
                throw .invalid_format
            if c == '\\'
                i += 1
                ec: = (r.ptr + i)$
                if ec == 'u'
                    $code: I32 = 0
                    if cp: = r.hex4(i + 1)
                        code = cp
                    else
                        throw .invalid_format
                    $adv: I32 = 5
                    // Only a low surrogate right after a high one combines into one code point.
                    if code >= 0xD800 && code <= 0xDBFF && i + 6 < r.len &&
                        (r.ptr + i + 5)$ == '\\' && (r.ptr + i + 6)$ == 'u'
                        if lo: = r.hex4(i + 7)
                            if lo >= 0xDC00 && lo <= 0xDFFF
                                code = 0x10000 + ((code - 0xD800) * 0x400) + (lo - 0xDC00)
                                adv = 11
                    // Caution: **Do not let an unpaired surrogate through.** Copied to UTF-8 it
                    // makes an invalid three-byte sequence that looks readable and fails only
                    // at a later check or in another language's string type. It is treated the
                    // same as a broken `\u`.
                    if code >= 0xD800 && code <= 0xDFFF
                        throw .invalid_format
                    w += write_utf8(buf_ptr + w, code)
                    i += adv
                    continue
                if ec.is_alnum() && ec != 'n' && ec != 'r' && ec != 't' && ec != 'b' && ec != 'f'
                    throw .invalid_format
                (buf_ptr + w)$ =
                    ('\n' if ec == 'n'
                    else ('\r' if ec == 'r'
                    else ('\t' if ec == 't'
                    else (0x08U8 if ec == 'b' else (0x0cU8 if ec == 'f' else ec)))))
            else
                (buf_ptr + w)$ = c
            w += 1
            i += 1
        (buf_ptr + w)$ = 0U8
        return U8$[]::{ .ptr = buf_ptr, .len = w }

    pub fn dedent( //< the same lines with the common indentation removed
        r: U8[],
        arena: Arena$@, //< where the new string goes; null uses the global heap, freed with `dealloc`
    ): U8[]
        defer $res: = Str_builder()
        if r.len == 0
            return arena.dup_str("")
        // Pass 1: the leading whitespace every non-blank line shares, compared byte by byte, as
        // Python's textwrap.dedent does. Caution: **Do not count a tab as a space**: lines indented
        // `\t` and `    ` share no indentation, and stripping both would change what they mean.
        $prefix: U8[] = ""
        $have_prefix: = false
        $is_empty_line: = true
        $line_start: Sz = 0
        $i: Sz = 0

        for i < r.len
            c: = (r.ptr + i)$
            if c == '\n'
                is_empty_line = true
                line_start = i + 1
            else if is_empty_line && c != ' ' && c != '\t' && c != '\r'
                indent: = r.sub(line_start, i - line_start)
                $k: Sz = 0
                for k < indent.len && (indent[k] == ' ' || indent[k] == '\t') &&
                    (!have_prefix || (k < prefix.len && prefix[k] == indent[k]))
                    k += 1
                prefix = indent.sub(0, k)
                have_prefix = true
                is_empty_line = false
            i += 1

        min_indent: = prefix.len
        // Pass 2: emit each line without the minimum indent. **A whitespace-only line becomes
        // empty** (like Python's textwrap.dedent and Java's stripIndent), not invisible trailing
        // whitespace. Its newline is kept, so a whitespace-only CRLF line becomes `\r\n`.
        i = 0
        is_empty_line = true
        $skip_count: Sz = 0
        line_start = 0

        for i < r.len
            c: = (r.ptr + i)$
            if c == '\n' || c == '\r'
                if is_empty_line
                    res.len = line_start
                res.c(c)
                line_start = res.len
                if c == '\n'
                    is_empty_line = true
                    skip_count = 0
            else
                if is_empty_line && skip_count < min_indent && (c == ' ' || c == '\t')
                    skip_count += 1
                else
                    is_empty_line = is_empty_line && (c == ' ' || c == '\t')
                    res.c(c)
            i += 1
        if is_empty_line
            res.len = line_start
        return arena.dup_str(res.slice())

impl Str_builder: Manual_free //< it owns its buffer and frees it with `free()`
    pub fn free(r: Self$@) //< frees the memory and empties it
        if r.cap > 0
            dealloc(Void$@::r.ptr)
        r.len = 0
        r.cap = 0

// **The text grows inside the arena**, so an error thrown before `take()` leaks nothing. A block
// it grew out of stays there until the arena is freed: at most about as much again as the text.
// It remembers the arena, so the text cannot end up in the wrong place. Why it grows there, and
// how to choose among the three write targets, is in std/docs/DESIGN-core.md.
//   name: = arena.text().s("layer.\{i\}.weight").take();
pub struct Arena_text //< a short-lived builder that leaves the finished text in the arena
    priv ptr: U8$@ //< the text written so far, in the arena
    priv len: Sz //< how many bytes have been written
    priv cap: Sz //< the size of the block at `ptr`; 0 before the first write
    priv arena: Arena$@ //< where the text grows, or null for the heap

impl Arena_text: Writer //< so it can be used anywhere a `Writer` is expected
    pub fn s(r: Self$@, val: U8[]): Self$@ //< writes a string and returns the builder
        //< `val` can be a view of this builder's own bytes.
        if val.len > 0
            // Caution: **Copy from `val` before the old block is freed, and with `move`.** It can
            // be a view of this builder's text, which a growth in place leaves where it is.
            old: = r.grow(r.len + val.len)
            mem.move(Void$@::(r.ptr + r.len), Void$@::val.ptr, val.len)
            if block: = old
                dealloc(Void$@::block)
            r.len += val.len
        return r

    pub fn c(r: Self$@, val: U8): Self$@ //< writes one byte and returns the builder
        if r.len >= r.cap
            if block: = r.grow(r.len + 1)
                dealloc(Void$@::block)
        dest: U8$@ = r.ptr + r.len
        dest$ = val
        r.len += 1
        return r

    pub fn flush(r: Self$@): Self$@ //< does nothing, and is here to complete `Writer`
        return r

impl Arena_text
    priv fn grow(r: Self$@, need: Sz): U8$@? //<
        //< Makes room for `need` bytes, and returns a heap block for the caller to free
        //< **Where the text is the arena's newest block, it grows there**, with nothing copied.
        //< Otherwise it moves to a new block twice as large, and the old one stays in the arena.
        //< Only on the heap is the old block returned, since nothing else frees it.
        if r.cap >= need
            return .none
        $cap: Sz = 16 if r.cap == 0 else r.cap
        for cap < need
            doubled: = cap * 2
            if doubled <= cap
                // cap*2 wraps near Sz's upper bound, so use need as it is. The alloc that follows
                // catches an absurdly large need.
                cap = need
                break
            cap = doubled
        // Caution: **Grow nothing past a mark saved since `text()`.** In place or in a new block,
        // the text would lie past it, and `restore()` to it frees that while the builder still
        // writes there. Before this, the next allocation silently wrote over the text.
        kept: = r.arena.rewinds_past(Void@::r)
        if r.cap > 0 && !kept && r.arena.resize_in_place(Void$@::r.ptr, r.cap, cap)
            r.cap = cap
            return .none
        block: = r.arena.alloc_kept(cap) if kept else r.arena.alloc(cap)
        new_ptr: = U8$@::block
        if r.len > 0
            mem.copy(Void$@::new_ptr, Void$@::r.ptr, r.len)
        old: U8$@? = .some(r.ptr) if r.arena == null && r.cap > 0 else .none
        r.ptr = new_ptr
        r.cap = cap
        return old

    #gives_view
    pub fn take(r: Self$@): U8[] //< ends the text with a NUL and hands it out; the builder is empty
        //< On the heap, the text is the caller's to free with `dealloc(Void$@::t.ptr)`. In an
        //< arena, the room left past the NUL goes back to it where nothing came after.
        if block: = r.grow(r.len + 1)
            dealloc(Void$@::block)
        (r.ptr + r.len)$ = 0U8
        out: = U8[]::{ .ptr = r.ptr, .len = r.len }
        // On the heap the builder is a block of its own, which nothing else frees.
        if r.arena == null
            mem.dealloc(Void$@::r)
            return out
        // A mark saved since `text()` stays where it was: given back, the room would leave it past
        // what its chunk holds, and `restore()` would refuse it.
        if !r.arena.rewinds_past(Void@::r)
            _given_back: = r.arena.resize_in_place(Void$@::r.ptr, r.cap, r.len + 1)
        r.ptr = null
        r.len = 0
        r.cap = 0
        return out

impl Arena
    #gives_view
    pub fn text(r: Self$@): Arena_text$@ //< a builder for one string in this arena
        //< The builder is in the arena too, so `.s(…)` can chain (a method's receiver must be a
        //< place). With a null arena both are on the heap, and `take` frees the builder.
        return r.create(Arena_text::{ .ptr = null, .len = 0, .cap = 0, .arena = r })

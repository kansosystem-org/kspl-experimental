// ---------------------------------------------------------
// U64 (no wider type; see the file header)
// ---------------------------------------------------------
pub struct Cu64 //< a checked `U64`
  pub val: U64 //< the plain value

impl Cu64
  pub fn new(v: U64): Cu64 //< wraps a plain value
    return Cu64::{ .val = v }
  pub fn checked_add(r: Self, rhs: Cu64): Cu64?Checked_error //<
    //< the sum, or an error if it does not fit
    result: = r.val + rhs.val
    if result < r.val
      throw Checked_error.overflow
    return Cu64::{ .val = result }
  pub fn checked_sub(r: Self, rhs: Cu64): Cu64?Checked_error //<
    //< the difference, or an error if it does not fit
    if rhs.val > r.val
      throw Checked_error.overflow
    return Cu64::{ .val = r.val - rhs.val }
  pub fn checked_mul(r: Self, rhs: Cu64): Cu64?Checked_error //<
    //< the product, or an error if it does not fit
    if r.val == 0 || rhs.val == 0
      return Cu64::{ .val = 0 }
    // An unsigned multiplication wraps by definition, so computing first is safe; dividing back
    // tells whether it overflowed.
    result: = r.val * rhs.val
    if result / r.val != rhs.val
      throw Checked_error.overflow
    return Cu64::{ .val = result }
  pub fn checked_div(r: Self, rhs: Cu64): Cu64?Checked_error //<
    //< the quotient, or an error for a 0 divisor
    if rhs.val == 0
      throw Checked_error.div_by_zero
    return Cu64::{ .val = r.val / rhs.val }

impl Cu64: Add<|Cu64, Cu64|> //< so `+` can be written
  pub fn add(r: Self$@, rhs: Cu64): Cu64 //< the sum; overflow stops the program
    return r.checked_add(rhs) catch panic("Cu64 overflow (add)")
impl Cu64: Sub<|Cu64, Cu64|> //< so `-` can be written
  pub fn sub(r: Self$@, rhs: Cu64): Cu64 //<
    //< the difference; overflow stops the program
    return r.checked_sub(rhs) catch panic("Cu64 underflow (sub)")
impl Cu64: Mul<|Cu64, Cu64|> //< so `*` can be written
  pub fn mul(r: Self$@, rhs: Cu64): Cu64 //<
    //< the product; overflow stops the program
    return r.checked_mul(rhs) catch panic("Cu64 overflow (mul)")
impl Cu64: Div<|Cu64, Cu64|> //< so `/` can be written
  pub fn div(r: Self$@, rhs: Cu64): Cu64 //<
    //< the quotient; a 0 divisor stops the program
    return r.checked_div(rhs) catch panic("Cu64 division by zero (div)")
impl U64: Cast<|Cu64|> //< so `Cu64::v` turns a plain value into a checked one
  pub fn cast(r: Self$@): Cu64 //< the same value, now checked
    return Cu64.new(r$)

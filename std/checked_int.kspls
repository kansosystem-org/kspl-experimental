// U8 (native promotion: U16)
// ---------------------------------------------------------
pub struct Cu8 //< a checked `U8`
  pub val: U8 //< the plain value

impl Cu8
  pub fn new(v: U8): Cu8 //< wraps a plain value
    return Cu8::{ .val = v }
  pub fn checked_add(r: Self, rhs: Cu8): Cu8?Checked_error //<
    //< the sum, or an error if it does not fit
    wide: U16 = r.val + rhs.val
    if wide > U16::255
      throw Checked_error.overflow
    return Cu8::{ .val = U8::wide }
  pub fn checked_sub(r: Self, rhs: Cu8): Cu8?Checked_error //<
    //< the difference, or an error if it does not fit
    if rhs.val > r.val
      throw Checked_error.overflow
    return Cu8::{ .val = r.val - rhs.val }
  pub fn checked_mul(r: Self, rhs: Cu8): Cu8?Checked_error //<
    //< the product, or an error if it does not fit
    wide: U16 = r.val * rhs.val
    if wide > U16::255
      throw Checked_error.overflow
    return Cu8::{ .val = U8::wide }
  pub fn checked_div(r: Self, rhs: Cu8): Cu8?Checked_error //<
    //< the quotient, or an error for a 0 divisor
    if rhs.val == 0
      throw Checked_error.div_by_zero
    return Cu8::{ .val = r.val / rhs.val }

impl Cu8: Add<|Cu8, Cu8|> //< so `+` can be written
  pub fn add(r: Self$@, rhs: Cu8): Cu8 //< the sum; overflow stops the program
    return r.checked_add(rhs) catch panic("Cu8 overflow (add)")
impl Cu8: Sub<|Cu8, Cu8|> //< so `-` can be written
  pub fn sub(r: Self$@, rhs: Cu8): Cu8 //<
    //< the difference; overflow stops the program
    return r.checked_sub(rhs) catch panic("Cu8 underflow (sub)")
impl Cu8: Mul<|Cu8, Cu8|> //< so `*` can be written
  pub fn mul(r: Self$@, rhs: Cu8): Cu8 //< the product; overflow stops the program
    return r.checked_mul(rhs) catch panic("Cu8 overflow (mul)")
impl Cu8: Div<|Cu8, Cu8|> //< so `/` can be written
  pub fn div(r: Self$@, rhs: Cu8): Cu8 //<
    //< the quotient; a 0 divisor stops the program
    return r.checked_div(rhs) catch panic("Cu8 division by zero (div)")
impl U8: Cast<|Cu8|> //< so `Cu8::v` turns a plain value into a checked one
  pub fn cast(r: Self$@): Cu8 //< the same value, now checked
    return Cu8.new(r$)


//< Parsing, building and writing out JSON values
//<
//< The arena-backed `Json_builder` / `Array_builder` / `Obj_builder` build a head-and-tail chain
//< by value, so nothing is copied twice. Parsing limits the nesting depth. An integer stays an
//< integer, so one wider than 53 bits does not round on the way through.
import "std/bignat" // `f64_to_bits`
import "std/chars"
import "std/ds" { List, Map }
import "std/mem" + { Arena, Own_arena }
import "std/stack_limit" { Stack_limit }
import "std/str" { Str_builder }
import "std/strfmt"
import "std/strnum" // `to_f64`

pub enum Val //< one JSON value, of any of the seven kinds
    null_val //< JSON's `null`
    bool_val(b: Bool) //< `true` or `false`
    int_val(i: I64) //< a number written without a point or an exponent
    float_val(f: F64) //< a number with a point or an exponent, kept separate so nothing rounds
    str_val(s: U8[]) //< a string, already unescaped
    array_val(a: Arr) //< an array; read its elements through `arr_list` and `get_at`
    obj_val(o: Obj) //< an object; read its members through `get` and `find`

priv struct Node
    val: Val
    next: Node$@

pub struct Arr //< an array's elements, reachable only through `arr_list` and `get_at`
    //<
    //< `Val.array_val`'s payload. It hides the chain as `Obj` hides its members: a payload
    //< holding a `Node$@` would hand every `switch` a pointer that is null for `[]`.
    priv head: Node$@

priv struct Member
    key: U8[]
    val: Val
    next: Member$@

pub struct Obj //< an object's members, reachable only through `get` and `find`
    //<
    //< `Val.obj_val`'s payload.
    //< Caution: The payload must not hold a `Member$@` directly. Code outside can bind a `pub
    //< enum`'s payload (`switch v case .obj_val(head)`). The priv list would then leak out ("Why a
    //< narrow type cannot stand where visibility is wide" in docs/DESIGN-language.md).
    //< Reading an object goes through `get(key)` and `find(key)`.
    priv head: Member$@

priv fn append_node(head: Node$@$@, tail: Node$@$@, node: Node$@) //<
    //< The append shared by Array_builder.push and parse_array
    if head$ == null
        head$ = node
    else
        tail.next = node
    tail$ = node

priv fn append_member(head: Member$@$@, tail: Member$@$@, m: Member$@)
    if head$ == null
        head$ = m
    else
        tail.next = m
    tail$ = m
// ---------------------------------------------------------
// The Json_builder API (for building JSON safely)
// ---------------------------------------------------------
pub struct Json_builder //< makes values, and the two builders that assemble them
    pub arena: Arena$@ //< the arena every value it makes is allocated in
    priv own: Own_arena //< that arena, when the builder made it for itself; `free` lets it go

pub struct Array_builder //< builds an array in the order elements are pushed
    pub builder: Json_builder //< the builder that allocates the elements
    priv head: Node$@ //< the first element pushed; null for none yet
    priv tail: Node$@ //< the last element pushed, so the next one is appended without a walk

pub struct Obj_builder //< builds an object; setting a key again replaces it
    pub builder: Json_builder //< the builder that allocates the members
    priv head: Member$@
    priv tail: Member$@

impl Json_builder
    pub fn new( //< a builder that allocates everything it makes from that arena
        //<
        //< With `null` it makes an arena of its own, so `defer b.free()` frees every value it made.
        arena: Arena$@, //< where values go; null means an arena of the builder's own and a `free()`
    ): Json_builder
        work: = mem.scratch(arena)
        return Json_builder::{ .arena = work.arena, .own = work.own }
    pub fn free(r: Self$@) //< lets go every value it made, when it made its own arena
        //<
        //< Given an arena, it frees nothing: that arena does. A second `free()` frees nothing.
        r.own.free()
    pub fn null_val(_r: Self$@): Val //< JSON's `null`
        return .null_val
    pub fn bool_val(_r: Self$@, b: Bool): Val //< `true` or `false`
        return .bool_val(b)
    pub fn int_val(_r: Self$@, i: I64): Val //< a number with no point; wide enough for an offset
        //<
        //< Caution: Take an I64, like Val.int_val and as_int64; with an I32 here, values could be
        //< read but not written.
        return .int_val(i)
    pub fn float_val(_r: Self$@, f: F64): Val //< a number with a point
        return .float_val(f)
    pub fn str_val(r: Self$@, s: U8[]): Val //< a string, copied into the arena
        return .str_val(r.arena.dup_str(s) if s.len > 0 else "")
    pub fn arr(r: Self$@): Array_builder //< an empty array builder
        return Array_builder::{ .builder = r$, .head = null, .tail = null }
    pub fn obj(r: Self$@): Obj_builder //< an empty object builder
        return Obj_builder::{ .builder = r$, .head = null, .tail = null }

impl Json_builder: Owned {} //< `free()` lets go the arena it made for itself

impl Array_builder
    pub fn push( //< adds one element at the end
        $r: Self,
        val: Val, //< the element to add
    ): Array_builder
        n: = r.builder.arena.create(Node::{ .val = val })
        append_node(r.head@, r.tail@, n)
        return r

    pub fn build(r: Self): Val //< the array built so far
        return .array_val(Arr::{ .head = r.head })

impl Obj_builder
    pub fn set( //< adds a member; an existing key is replaced, not added again
        //<
        //< Caution: **Replace an existing key.** If appended, `{"a":1,"a":2}` makes `get` return
        //< the first while `dump` writes both, and another parser reads a different value. The scan
        //< costs the same as `get`.
        $r: Self,
        key: U8[], //< the member's name, copied into the arena
        val: Val, //< the value stored under it
    ): Obj_builder
        $m: = r.head
        for m != null
            if m.key.equals(key)
                m.val = val
                return r
            m = m.next
        k_str: U8$[] = r.builder.arena.dup_str(key) if key.len > 0 else ""
        fresh: = r.builder.arena.create(Member::{ .key = k_str, .val = val })
        append_member(r.head@, r.tail@, fresh)
        return r

    pub fn build(r: Self): Val //< the object built so far
        return .obj_val(Obj::{ .head = r.head })
// ---------------------------------------------------------
// Parsing & Dumping
// ---------------------------------------------------------
pub enum Json_error //< why a document could not be read, or cannot be trusted
    unexpected_eof //< it ended in the middle of a value
    invalid_character(ch: U8) //< a byte that is not allowed where it appears
    invalid_string //< a string's escape or its ending is not what JSON allows
    invalid_number //< the digits do not match JSON's number grammar, or exceed an F64's range
    expected_colon //< a member's name was not followed by `:`
    expected_comma_or_bracket //< an element was not followed by `,` or the closing mark
    trailing_comma //< `[1,]` or `{"a":1,}`; JSON requires an element after a comma
    too_deep //< deeper than `max_nesting_depth`, or than the stack left can hold
    too_large //< an array's elements need more bytes than this target's `Sz` can count
    trailing_input //< something other than whitespace follows the value
    duplicate_key(at: Sz) //<
        //< an object names the same member twice; `at` is where the second name starts in the text
        //<
        //< Caution: **A position, not the name.** The name was read into the parse's scratch, which
        //< a failed parse rewinds. The text is the caller's and outlives the error.
        //< **Refused, not read first or last wins.** Readers that pick differently would see two
        //< different documents in one (std/docs/DESIGN-core.md's "Known problems KSPL handles").
    missing_field(missing: U8[]) //< a field in the table is missing from the object.
        //<
        //< Only `into_struct` returns this one.
        //< Caution: **It and the next keep a default from being filled in silently.** Filled with 0
        //< or "", a sender's misspelt key would show only as "the value was 0" (see
        //< std/docs/DESIGN-core.md's "Known holes").
    field_type(mismatched: U8[]) //< the kinds differ, or the field cannot hold the integer.
        //<
        //< `"<root>"` when it is not at a field. Only `into_struct` and `from_struct` return it.

priv struct Parse_ctx
    src: U8[]
    pos: Sz
    arena: Arena$@
    depth: Sz
    stack: Stack_limit //< where the parse stops short of the stack's end, beside `depth`'s count

pub const max_nesting_depth: Sz = 500 //< the deepest nesting read; deeper fails with `too_deep`
    //<
    //< It guards against stack exhaustion, and is deep enough for ordinary JSON. `std/json_struct`
    //< holds a round trip to it too, so a document that parses does not stop part way.

priv const stack_margin: Sz = 64 * 1024 //<
    //< The stack kept free below where a parse stops
    //<
    //< **The count alone is sized for the main thread.** A thread's stack can be far smaller (512KB
    //< by default on macOS). So a parse on one also asks where its stack ends ("A deep walk asks
    //< where its stack ends" in `std/docs/DESIGN-system.md`). Below the
    //< check run one level's calls and the throw, which need far less than this.

priv fn enter_nesting(ctx: Parse_ctx$@): Void!Json_error
    ctx.depth += 1
    if ctx.depth > max_nesting_depth || ctx.stack.near()
        throw .too_deep

priv fn skip_ws(ctx: Parse_ctx$@)
    for ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos).is_space()
        ctx.pos += 1

priv fn match_str(ctx: Parse_ctx$@, s: U8$[]): Bool
    if ctx.src.starts_with(s, ctx.pos)
        ctx.pos += s.len
        return true
    return false

priv fn is_json_escape(ec: U8): Bool //< the escapes JSON accepts (RFC 8259 §7)
    //<
    //< **This list is the canonical source.**
    //< `unescape_to_arena` (std/str), which does the decoding, is a shared decoder. It passes a
    //< symbol escape (`\[` and `\-`, used in a grammar's character class) through **as the
    //< character itself**. So the caller decides which escapes are accepted. Without the refusal
    //< here, `"\-"` would silently pass as `-`. A notation JSON does not have would then be
    //< accepted.
    return ec == '"' || ec == '\\' || ec == '/' || ec == 'b' || ec == 'f' || ec == 'n' || ec == 'r'
        || ec == 't' || ec == 'u'

priv fn parse_string(ctx: Parse_ctx$@): U8[]!Json_error
    if ctx.pos >= ctx.src.len || (ctx.src.ptr + ctx.pos)$ != '"'
        throw .invalid_string
    ctx.pos += 1
    start: = ctx.pos
    for ctx.pos < ctx.src.len
        c: = (ctx.src.ptr + ctx.pos)$
        // **A raw control character is refused (RFC 8259 §7).** Passed through raw, it breaks a
        // peer that splits input by lines (JSON-RPC's framing, a per-line log).
        if c < 0x20U8
            throw .invalid_string
        if c == '\\'
            if ctx.pos + 1 >= ctx.src.len ||
                !is_json_escape((ctx.src.ptr + ctx.pos + 1)$)
                throw .invalid_string
            ctx.pos += 2
            continue
        if c == '"'
            raw_str: = U8[]::{ .ptr = ctx.src.ptr + start, .len = ctx.pos - start }
            ctx.pos += 1
            // A broken `\u` is not accepted as a string (the reason is in str.kspl's
            // unescape_to_arena).
            return raw_str.unescape_to_arena(ctx.arena) catch
                throw .invalid_string
        // **Bytes that are not UTF-8 are refused (RFC 8259 §8.1).** Passed through, they reach a
        // peer whose decoder refuses or replaces them, so the two read different strings.
        if step: = ctx.src.utf8_seq_len(ctx.pos)
            ctx.pos += step
        else
            throw .invalid_string
    throw .unexpected_eof

priv fn parse_number(ctx: Parse_ctx$@): Val!Json_error //< reads one number
    //<
    //< int_val for integer notation; float_val with a point or an exponent.
    //< Caution: **Do not store an integer as an F64.** An integer over 53 bits (safetensors'
    //< offsets) rounds silently.
    start_pos: = ctx.pos
    if ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos)$ == '-'
        ctx.pos += 1
    int_start: = ctx.pos
    for ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos).is_digit()
        ctx.pos += 1
    if ctx.pos == int_start
        throw .invalid_number
    // Caution: **Do not allow digits after a leading 0 (RFC 8259 §6).** Reading `01` as `1`
    // disagrees with a peer that reads it as octal.
    if ctx.pos - int_start > 1 && (ctx.src.ptr + int_start)$ == '0'
        throw .invalid_number
    // A fractional or exponent part makes it floating point.
    $is_float: = false
    if ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos)$ == '.'
        is_float = true
        ctx.pos += 1
        frac_start: = ctx.pos
        for ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos).is_digit()
            ctx.pos += 1
        if ctx.pos == frac_start
            throw .invalid_number // "1." is not a number in JSON
    if ctx.pos < ctx.src.len
        e: = (ctx.src.ptr + ctx.pos)$
        if e == 'e' || e == 'E'
            is_float = true
            ctx.pos += 1
            if ctx.pos < ctx.src.len
                sgn: = (ctx.src.ptr + ctx.pos)$
                if sgn == '+' || sgn == '-'
                    ctx.pos += 1
            exp_start: = ctx.pos
            for ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos).is_digit()
                ctx.pos += 1
            if ctx.pos == exp_start
                throw .invalid_number
    text: = ctx.src.sub(start_pos, ctx.pos - start_pos)
    if !is_float
        // An integer stays an I64.
        // Caution: **Do not accumulate the digits here.** The range check belongs to `std/strnum`'s
        // `to_i64`, and a copy would miss it at one end. The shape is already checked, so a refusal
        // here only means it does not fit in an I64.
        $fits: = true
        v: = text.to_i64() catch
            fits = false
            fallback 0I64
        if fits
            return .int_val(v)
    // A fraction, or an integer too big for an I64: the lost precision shows in the type, not as a
    // truncated value.
    f: = text.to_f64() catch
        throw .invalid_number
    // Caution: **Refuse a number past F64's range** (`1e400` reads as infinity): `dump` writes
    // null for it, so the document would not survive a round trip. `f - f` is 0 only when finite.
    if f - f != 0.0
        throw .invalid_number
    return .float_val(f)

priv fn check_comma_or_end(ctx: Parse_ctx$@, end_char: U8): Bool!Json_error
    skip_ws(ctx)
    if ctx.pos >= ctx.src.len
        throw .unexpected_eof
    c: = (ctx.src.ptr + ctx.pos)$
    if c == end_char
        ctx.pos += 1
        return true
    if c == ','
        ctx.pos += 1
        return false
    throw .expected_comma_or_bracket

priv fn parse_value(ctx: Parse_ctx$@): Val!Json_error
    skip_ws(ctx)
    if ctx.pos >= ctx.src.len
        throw .unexpected_eof
    c: = (ctx.src.ptr + ctx.pos)$
    switch c
    case '{'
        return parse_object(ctx)!
    case '['
        return parse_array(ctx)!
    case '"'
        s: = parse_string(ctx)!
        return .str_val(s)
    case 't'
        // A failed match leaves the switch and reaches the invalid_character below (shared by
        // t/f/n).
        if match_str(ctx, "true")
            return .bool_val(true)
    case 'f'
        if match_str(ctx, "false")
            return .bool_val(false)
    case 'n'
        if match_str(ctx, "null")
            return .null_val
    default
        if c == '-' || c.is_digit()
            return parse_number(ctx)!
    throw .invalid_character(c)

priv const key_scan_max: Sz = 16 //< how many keys an object compares one by one before using a set

priv fn parse_object(ctx: Parse_ctx$@): Val!Json_error
    enter_nesting(ctx)!
    defer ctx.depth -= 1
    ctx.pos += 1
    skip_ws(ctx)
    if ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos)$ == '}'
        ctx.pos += 1
        return .obj_val(Obj::{ .head = null })
    $head: Member$@ = null
    $tail: Member$@ = null
    // **A few keys are compared one by one; past that, a set of them.** One by one alone, an
    // object of a hundred thousand members costs billions of comparisons.
    $count: Sz = 0
    $seen: = Map<|U8[], Bool|>.new(ctx.arena)
    for
        skip_ws(ctx)
        // A close after a comma is refused as trailing_comma, not as an `invalid_string` key.
        if ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos)$ == '}'
            throw .trailing_comma
        key_at: = ctx.pos
        key: = parse_string(ctx)!
        if count < key_scan_max
            $m: = head
            for m != null
                if m.key.equals(key)
                    throw .duplicate_key(key_at)
                m = m.next
            if count + 1 == key_scan_max
                $f: = head
                for f != null
                    seen.set(f.key, true)
                    f = f.next
                seen.set(key, true)
        else
            before: = seen.len
            seen.set(key, true)
            if seen.len == before // set replaced rather than added: the key was there
                throw .duplicate_key(key_at)
        count += 1

        skip_ws(ctx)
        if ctx.pos >= ctx.src.len || (ctx.src.ptr + ctx.pos)$ != ':'
            throw .expected_colon
        ctx.pos += 1
        val: = parse_value(ctx)!

        node: = ctx.arena.create(Member::{ .key = key, .val = val })
        append_member(head@, tail@, node)

        if check_comma_or_end(ctx, '}')!
            break
    return .obj_val(Obj::{ .head = head })

priv fn parse_array(ctx: Parse_ctx$@): Val!Json_error
    enter_nesting(ctx)!
    defer ctx.depth -= 1
    ctx.pos += 1
    skip_ws(ctx)
    if ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos)$ == ']'
        ctx.pos += 1
        return .array_val(Arr::{ .head = null })
    $head: Node$@ = null
    $tail: Node$@ = null
    for
        skip_ws(ctx)
        if ctx.pos < ctx.src.len && (ctx.src.ptr + ctx.pos)$ == ']'
            throw .trailing_comma
        val: = parse_value(ctx)!

        node: = ctx.arena.create(Node::{ .val = val })
        append_node(head@, tail@, node)

        if check_comma_or_end(ctx, ']')!
            break
    return .array_val(Arr::{ .head = head })

pub struct Doc //< a parsed document: its value, and the arena `parse` built it in given null
    //<
    //< **Only the document frees anything.** Its `val`, and every part read out of that (`get`,
    //< `get_at`, `arr_list`), is a `Val`, which has no `free`: freeing a part cannot tear the
    //< whole.
    pub val: Val //< the document's value
    priv own: Own_arena //< the arena `parse` made for it given null, or empty; `free` lets it go

impl Doc
    pub fn free(r: Self) //< lets go all of the value, when `parse` was given null
        //<
        //< Parsed into the caller's arena, it frees nothing: that arena does.
        $own: = r.own
        own.free()
impl Doc: Owned {} //< `free()` lets go the arena `parse` made for the document

pub fn parse( //< the whole document; anything left over is refused
    //<
    //< Read its value as `doc.val`. With `null`, `defer doc.free()` frees all of it.
    //< Caution: **A document ends after one value.** Otherwise `1 2` **succeeds** as `1`, and two
    //< concatenated inputs silently pass as the first.
    src: U8[], //< the text to read
    arena: Arena$@, //< where the values go; null means the document's own arena and a `free()`
): Doc!Json_error //<
    //< the document; fails on bad syntax or on text after it, leaving nothing behind
    $work: = mem.scratch(arena)
    $ctx: = Parse_ctx::{ .src = src, .pos = 0, .arena = work.arena, .depth = 0,
        .stack = Stack_limit.later(stack_margin) }
    v: = parse_value(ctx@) catch e
        work.free()
        throw e
    skip_ws(ctx@)
    if ctx.pos < src.len
        work.free()
        throw .trailing_input
    return Doc::{ .val = v, .own = work.own }

priv fn write_break(out: Str_builder$@, indent: Sz, depth: Sz) //< a newline with indentation
    if indent <= 0
        return
    out.c('\n')
    for _i in Range.asc(indent * depth)
        out.c(' ')

impl Val
    pub fn arr_list( //< an array's elements as a list; the one way to walk an array
        //<
        //< A `Val` cannot be the subject of `for in` (a chain has no `.len`), so walk this list.
        //< Caution: When arena is null it allocates on the global heap, so the caller frees it with
        //< a `defer` (the same convention as `List.new`).
        r: Self,
        arena: Arena$@, //< the arena for the list; null means the global heap, freed by the caller
    ): List<|Val|>
        $out: = List<|Val|>.new(arena)
        switch r
        case .array_val(a)
            $curr: = a.head
            for curr != null
                out.push(curr.val)
                curr = curr.next
        default {}
        return out
    pub fn dump( //< writes the value as JSON text
        //<
        //< **Indentation is only for files a person reads.** For data exchange keep it at 0: the
        //< whitespace is waste to the peer.
        r: Self,
        out: Str_builder$@, //< where the text is built
        indent: Sz = 0, //< columns per level; 0 gives the exchange form, with no whitespace
    )
        r.dump_at(out, indent, 0)

    priv fn dump_at(r: Self, out: Str_builder$@, indent: Sz, depth: Sz)
        switch r
        case .null_val
            out.s("null")
        case .bool_val(b)
            out.s("\{b\}")
        case .int_val(i)
            out.s("\{i\}")
        case .float_val(f)
            // JSON has no NaN or Infinity; null is better than writing something that does not
            // parse. `f - f` is 0 only for a finite value, so the largest finite ones are still
            // written.
            if f - f != 0.0
                out.s("null")
            else
                // The shortest form that round-trips; an integral value gets a `.0`, and below
                // 10^-6 and from 10^21 up it is the `1e+21` form JSON allows (RFC 8259 §6).
                f.fmt(out)
        case .str_val(s)
            out.c('"').escape_and_append(s).c('"')
        case .array_val(a)
            out.c('[')
            $curr: = a.head
            for curr != null
                if curr != a.head
                    out.c(',')
                write_break(out, indent, depth + 1)
                curr.val.dump_at(out, indent, depth + 1)
                curr = curr.next
            // Caution: **Keep an empty sequence on one line**, as the `[]` other implementations
            // write.
            if a.head != null
                write_break(out, indent, depth)
            out.c(']')
        case .obj_val(o)
            out.c('{')
            $m: = o.head
            for m != null
                if m != o.head
                    out.c(',')
                write_break(out, indent, depth + 1)
                out.c('"').escape_and_append(m.key).s("\":")
                if indent > 0
                    out.c(' ')
                m.val.dump_at(out, indent, depth + 1)
                m = m.next
            if o.head != null
                write_break(out, indent, depth)
            out.c('}')
    pub fn get( //< an object's member, for reading a path; `null_val` where there is none
        //<
        //< **Absent reads as `null`**, so a path stays one line (`v.get("a").get("b").as_str()`);
        //< where absent and `null` differ, ask `find`. A key names one member.
        //< **It is a linear scan.** Calling it for a list of names the peer chose makes one request
        //< O(members x names).
        r: Self,
        key: U8[], //< the member's name
    ): Val
        return r.find(key).unwrap_or(.null_val)

    pub fn find( //< an object's member, or nothing where the object has none
        //<
        //< **A member holding `null` is found** (`.some(.null_val)`), so this tells an absent key
        //< from a `null` one. On a value that is not an object, nothing.
        r: Self,
        key: U8[], //< the member's name
    ): Val?
        switch r
        case .obj_val(o)
            $m: = o.head
            for m != null
                if m.key.equals(key)
                    return .some(m.val)
                m = m.next
        default {}
        return .none

    pub fn get_at( //< an array's element, for reading a path; `null_val` past the end
        //<
        //< Past the end reads as `null`, as an absent member does for `get`; `arr_list` gives the
        //< count.
        r: Self,
        index: Sz, //< which element, counting from 0
    ): Val
        switch r
        case .array_val(a)
            $curr: = a.head
            $i: Sz = 0
            for curr != null
                if i == index
                    return curr.val
                i += 1
                curr = curr.next
        default {}
        return .null_val

    pub fn as_str(r: Self): U8[]? //< the string it holds, or nothing for another kind
        //<
        //< An empty string is `.some("")`, apart from a number, `null` or an absent member.
        switch r
        case .str_val(s)
            return .some(s)
        default {}
        return .none

    pub fn as_bool(r: Self): Bool? //< the boolean it holds, or nothing for another kind
        switch r
        case .bool_val(b)
            return .some(b)
        default {}
        return .none

    pub fn as_int(r: Self): I32? //< the integer it holds, when an `I32` holds it; nothing otherwise
        //<
        //< Caution: **An integer past `I32` gives nothing, never its low bytes**: narrowed,
        //< 4294967297 would read as 1, and an id that large would match id 1.
        switch r
        case .int_val(i)
            if i >= -2147483648I64 && i <= 2147483647I64
                return .some(I32::i)
        default {}
        return .none

    pub fn as_int64(r: Self): I64? //< the integer it holds, at its full width; nothing otherwise
        //<
        //< For a value that can exceed 2GB, such as safetensors' `data_offsets`. A number written
        //< with a point is no integer, however whole.
        switch r
        case .int_val(i)
            return .some(i)
        default {}
        return .none

    pub fn as_f64(r: Self): F64? //< the number it holds, or nothing when it is not a number
        //<
        //< It accepts the integer kind too, so `3` and `3.0` need no branch.
        switch r
        case .float_val(f)
            return .some(f)
        case .int_val(i)
            return .some(F64::i)
        default {}
        return .none

    pub fn equals( //< whether the two hold the same JSON value
        //<
        //< **A number equals only one of its own kind** (`1` is not `1.0`: the reader keeps them
        //< apart). A decimal equals only the same F64, bit for bit, so `-0.0` is not `0.0`. Objects
        //< are equal when they hold the same members in any order, a repeated key counted each
        //< time.
        //< Caution: **It is quadratic in an object's members**, as `get` called for each key is.
        r: Self,
        o: Val, //< the value to compare with
    ): Bool
        if r.kind_rank() != o.kind_rank()
            return false
        // The kinds match, so each read below finds o's own value and its fallback is never taken.
        switch r
        case .null_val
            return true
        case .bool_val(b)
            return b == o.as_bool().unwrap_or(!b)
        case .int_val(i)
            return i == o.as_int64().unwrap_or(0I64)
        case .float_val(f)
            return bignat.f64_to_bits(f) == bignat.f64_to_bits(o.as_f64().unwrap_or(0.0))
        case .str_val(s)
            return s.equals(o.as_str().unwrap_or(""))
        case .array_val(own)
            switch o
            case .array_val(other)
                return same_elements(own.head, other.head)
            default {}
            return false
        case .obj_val(own)
            switch o
            case .obj_val(other)
                return same_members(own.head, other.head)
            default {}
            return false

    priv fn kind_rank(r: Self): I32 //< which of the seven kinds it is, as a number
        switch r
        case .null_val
            return 0
        case .bool_val
            return 1
        case .int_val
            return 2
        case .float_val
            return 3
        case .str_val
            return 4
        case .array_val
            return 5
        case .obj_val
            return 6

priv fn same_elements(a_head: Node$@, b_head: Node$@): Bool //< two arrays' elements, in order
    $a: = a_head
    $b: = b_head
    for a != null && b != null
        if !a.val.equals(b.val)
            return false
        a = a.next
        b = b.next
    return a == null && b == null

priv fn same_members(a_head: Member$@, b_head: Member$@): Bool //<
    //< Whether two objects hold the same members in any order, a repeated key counted each time
    if count_members(a_head, null) != count_members(b_head, null)
        return false
    $m: = a_head
    for m != null
        if count_members(a_head, m) != count_members(b_head, m)
            return false
        m = m.next
    return true

priv fn count_members(head: Member$@, like: Member$@): Sz //<
    //< How many members of the list hold the same key and value as `like`; null counts them all
    $n: Sz = 0
    $m: = head
    for m != null
        if like == null || (m.key.equals(like.key) && m.val.equals(like.val))
            n += 1
        m = m.next
    return n

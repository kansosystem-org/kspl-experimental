//< Language support that every file imports automatically
//<
//< **Explicit `import "std/lang"` is forbidden.** Every file already imports it automatically.
//< An explicit import would provide a second way to access the same names.
//< Local bindings, declarations in the file, and explicit imports take precedence over these names.
//< You can therefore redefine any of these names in your file.

// ==========================================
// Caution: **Import only `std/libc`.** Every program includes this file.
// Importing `io` would add the string and input/output libraries to every program.
// It would also create the cycle `lang -> io -> mem -> lang`.
// ==========================================
#cfg(!freestanding)
import "std/libc"

// ============================ Panic ============================

pub typedef Panic_hook = fn(msg: U8$[]): Void //<
    //< the callback for panic messages on a freestanding port
    //<
    //< A port with a console sets this callback. `lang` cannot detect the console itself.
    //< The default, `null`, stops execution without printing a message.
pub $panic_hook: Panic_hook = Panic_hook::null

priv const PANIC_MSG_CAP: Sz = 128 //<
    //< The maximum number of message bytes stored in a panic record
    //<
    //< The port's linker script reserves `.noinit_panic` as RAM that startup does not zero.
    //< After a warm reset without power loss, `take_panic_record()` can read the record.
    //< Recording a panic does not trigger a reset. The caller must arrange one, for example with a
    //< watchdog.
priv const PANIC_STACK_WORDS: Sz = 16
priv const PANIC_MAGIC: U32 = 0x4B505244 // ASCII "KPRD"

priv struct _Panic_record
    magic: U32
    msg_len: Sz
    msg: U8[PANIC_MSG_CAP]
    sp: Sz
    stack_len: Sz
    stack: Sz[PANIC_STACK_WORDS]
#cfg(freestanding)
#section(".noinit_panic")
priv $_panic_rec: _Panic_record = ::{}

// Caution: Keep `#cfg(freestanding)`. Every program includes `lang`.
// On a hosted target, this declaration would conflict with a runtime definition of the same name.
#cfg(freestanding)
extern "C"
    fn kspl_get_sp(): Sz
    fn kspl_panic_stack_words(sp: Sz, capacity: Sz): Sz

#cfg(freestanding)
priv fn record_panic(msg: U8$[])
    _panic_rec.msg_len = msg.len if msg.len < PANIC_MSG_CAP else PANIC_MSG_CAP
    msg_dst: = _panic_rec.msg[0]@
    for i in Range.asc(_panic_rec.msg_len)
        (msg_dst + i)$ = msg[i]
    sp: = kspl_get_sp()
    _panic_rec.sp = sp
    // The port reports readable words. Unknown bounds leave the fragment empty.
    words: = kspl_panic_stack_words(sp, PANIC_STACK_WORDS) if sp != 0 else 0
    _panic_rec.stack_len = words
    sp_ptr: = Sz$@::sp
    stack_dst: = _panic_rec.stack[0]@
    for i in Range.asc(words)
        (stack_dst + i)$ = (sp_ptr + i)$
    _panic_rec.magic = PANIC_MAGIC

pub struct Panic_info //< information about a panic from the previous run
    //<
    //< The stack fragment is separate because a fixed-length array cannot be returned by value.
    //< Read each word with `panic_stack_word()`, using `0 <= index < stack_len`.
    pub msg: U8$[] //< the panic's message
    pub sp: Sz //< the stack pointer when it happened
    pub stack_len: Sz //< how many words of the stack were kept, read with `panic_stack_word`

// Reading clears the record so the next startup does not report it again.
#cfg(freestanding)
pub fn take_panic_record(): Panic_info? //< the previous run's panic, if present
    if _panic_rec.magic != PANIC_MAGIC
        return .none
    info: = Panic_info::{ .msg = U8$[]::{ .ptr = _panic_rec.msg[0]@, .len = _panic_rec.msg_len },
        .sp = _panic_rec.sp, .stack_len = _panic_rec.stack_len }
    _panic_rec.magic = 0
    return .some(info)

#cfg(freestanding)
pub fn panic_stack_word( //< one word from the saved stack
    index: Sz, //< which word, below `Panic_info.stack_len`
): Sz //< the word; an `index` out of range is not caught
    base: = _panic_rec.stack[0]@
    return (base + index)$

// Caution: **Write output directly with libc.** Using `io` would add the whole library to `lang`.
// Interpolation requires `str`, so this function writes the caller's message without formatting it.
#cfg(!freestanding)
#noreturn
pub fn panic( //< stops the program and reports the location and reason
    msg: U8$[], //< the message to show, already built
    file: U8[] = caller_file, //< keep the default unless this is called from a wrapper
    line: Sz = caller_line, //< keep the default unless this is called from a wrapper
)
    // Caution: **Flush before `abort()`.** Piped standard output (`| tee`) uses full buffering.
    // Aborting without flushing loses buffered output, including the last messages before the
    // crash. `null` selects every stream.
    libc.fflush(null)
    err: = libc.get_stderr()
    libc.fwrite(Void$@::"panic: ".ptr, 1, 7, err)
    libc.fwrite(Void$@::msg.ptr, 1, msg.len, err)
    $at: = Panic_msg.new()
    at.at_caller(file, line)
    where: = at.slice()
    libc.fwrite(Void$@::where.ptr, 1, where.len, err)
    libc.fwrite(Void$@::"\n".ptr, 1, 1, err)
    libc.fflush(err)
    libc.abort()
    // abort() returns if SIGABRT is caught or ignored; control must not reach the caller.
    for
        libc.abort()
// The freestanding version stops without libc, including `fprintf` or `malloc`.
// `kspl_bounds_check` in `ksplc/gen/runtime/freestanding.h` also stops this way.
#cfg(freestanding)
#noreturn
pub fn panic( //< stops without libc and sends the message to the panic hook
    msg: U8$[], //< the message passed to the hook
    _file: U8[] = caller_file,
    _line: Sz = caller_line,
)
    // **The record excludes the source location.** A path would reduce message space within
    // `PANIC_MSG_CAP`. Without a console, the record is the only available report.
    // The location parameters let `assert` call either version.
    record_panic(msg)
    if panic_hook != null
        panic_hook(msg)
    for {}

pub fn assert( //< stops the program unless the condition holds
    cond: Bool, //< what must hold
    msg: U8$[], //< the message shown if it does not
    file: U8[] = caller_file, //< keep the default unless this is called from a wrapper
    line: Sz = caller_line, //< keep the default unless this is called from a wrapper
)
    if !cond
        panic(msg, file, line)

pub struct Panic_msg //< a fixed-size panic message buffer with no allocation
    //<
    //< This buffer requires no `io`. **String interpolation (`\{v\}`) is unavailable here.**
    //< Caution: The buffer silently discards bytes beyond `PANIC_MSG_CAP`.
    //< Reporting another failure during a panic would leave no recovery path.
    //< Do not use this buffer in place of `Str_builder`.
    priv buf: U8[PANIC_MSG_CAP]
    priv len: Sz

impl Panic_msg
    pub fn new(): Panic_msg //< an empty buffer
        return Panic_msg::{ .buf = ::{}, .len = 0 }

    priv fn put(r: Self$@, c: U8)
        if r.len < PANIC_MSG_CAP
            r.buf[r.len] = c
            r.len += 1

    pub fn s(r: Self$@, t: U8[]): Self$@ //< writes text; anything that does not fit is dropped
        for i in Range.asc(t.len)
            r.put(t[i])
        return r

    pub fn n(r: Self$@, v: I64): Self$@ //< writes a number as decimal, including the minimum
        //<
        //< Caution: **Calculate the absolute value as unsigned.** Negating the minimum signed value
        //< overflows, as in `Range.new`. `U64::0 - U64::v` gives its magnitude.
        $mag: U64 = U64::0 - U64::v if v < 0 else U64::v
        if v < 0
            r.put('-')
        if mag == 0U64
            r.put('0')
            return r
        $tmp: U8[24] = ::{}
        $i: Sz = 0
        for
            if mag == 0U64
                break
            tmp[i] = U8::(mag % 10U64) + '0'
            mag = mag / 10U64
            i += 1
        for j in Range.desc(i)
            r.put(tmp[j])
        return r

    pub fn slice(r: Self$@): U8$[] //< what has been written, to pass to `panic`
        return U8$[]::{ .ptr = r.buf[0]@, .len = r.len }

    priv fn at_caller( //< writes ` at <file>:<line>`, and returns the buffer
        //<
        //< Without a location, this method returns the buffer unchanged.
        //< **Use the same text as the built-in bounds check**, `kspl_bounds_check` in
        //< `ksplc/gen/runtime/hosted.h`.
        //< Caution: **Return the same `Self$@`, as `s` does.** Returning only the appended text
        //< would allow accidental duplication.
        //< The pointer return prevents calls such as `b.s(msg).s(b.at_caller(…))`.
        r: Self$@,
        file: U8[], //< the file to name
        line: Sz, //< the line to name
    ): Self$@
        if file.len == 0
            return r
        return r.s(" at ").s(file).s(":").n(line)

// ============================ The error trace ============================
// The runtime records the error trace at each `throw` and `!`.
// It belongs here because a failing `main` prints it regardless of the program's imports.
#cfg(!freestanding)
extern "C"
    pub fn kspl_error_trace_depth(): I32 //< the number of frames in the error trace
    pub fn kspl_get_trace_frame_info(index: I32, file: U8@$@, func: U8@$@, line: I32$@) //<
        //< the file, function, and line for the trace frame at `index`

#cfg(!freestanding)
priv struct Trace_text //< buffered text that flushes to standard error when full
    buf: U8[256]
    len: Sz

#cfg(!freestanding)
impl Trace_text
    fn c(r: Self$@, ch: U8): Self$@ //< writes one byte
        if r.len == r.buf.len
            r.flush()
        r.buf[r.len] = ch
        r.len += 1
        return r

    fn s(r: Self$@, t: U8[]): Self$@ //< writes text
        for ch in t
            r.c(ch)
        return r

    fn n(r: Self$@, v: I64): Self$@ //< writes a number as decimal
        $m: = Panic_msg.new()
        return r.s(m.n(v).slice())

    fn flush(r: Self$@) //< flushes buffered text to standard error
        err: = libc.get_stderr()
        libc.fwrite(Void$@::r.buf[0]@, 1, r.len, err)
        libc.fflush(err)
        r.len = 0

priv fn c_text(p: U8@): U8[] //<
    //< a C string without its terminating NUL, or an empty slice for a null pointer
    if p == null
        return ""
    $n: Sz = 0
    for (p + n)$ != 0
        n += 1
    return U8[]::{ .ptr = p, .len = n }

priv fn has_at(s: U8[], part: U8[], at: Sz): Bool //< whether `s` contains `part` at offset `at`
    if at + part.len > s.len
        return false
    for i in Range.asc(part.len)
        if s[at + i] != part[i]
            return false
    return true

priv fn trace_module(file: U8[]): U8[] //< the file path before its first `.kspl`
    for k in Range.asc(file.len)
        if has_at(file, ".kspl", k)
            return U8[]::{ .ptr = file.ptr, .len = k }
    return file

priv fn trace_fn_name(raw_func: U8[], module: U8[]): U8[] //<
    //< The function name extracted from its generated C symbol
    //<
    //< Symbols use `kspl_[priv_]<module>_<name>`, with module separators replaced by underscores.
    $at: Sz = 0
    if has_at(raw_func, "kspl_priv_", 0)
        at = 10
    else if has_at(raw_func, "kspl_", 0)
        at = 5
    $k: Sz = 0
    for k < module.len && at + k < raw_func.len
        c: = module[k]
        want: = '_' if c == '/' || c == '\\' || c == '.' else c
        if raw_func[at + k] != want
            break
        k += 1
    if k == module.len && has_at(raw_func, "_", at + k)
        at += k + 1
    return U8[]::{ .ptr = raw_func.ptr + at, .len = raw_func.len - at }

#cfg(!freestanding)
pub fn print_trace() //< writes this thread's latest error trace to standard error
    //<
    //< A failing `main` also calls this function.
    //< Caution: **Write with libc alone**, as `panic` does. Every program includes this file.
    //< Buffering lines reduces `fwrite` calls, making interleaved output less likely.
    depth: = kspl_error_trace_depth()
    if depth <= 0
        return
    $out: Trace_text = ::{}
    out.s("stack backtrace:\n")
    $frame_idx: I64 = 0
    for $i: = depth - 1; i >= 0; i -= 1
        $file_ptr: U8@ = null
        $func_ptr: U8@ = null
        $line: I32 = 0
        kspl_get_trace_frame_info(i, file_ptr@, func_ptr@, line@)
        raw_func: = c_text(func_ptr)
        raw_file: = c_text(file_ptr)
        out.s("   " if frame_idx < 10 else "  ").n(frame_idx).s(": ")
        frame_idx += 1
        if raw_func.len == 9 && has_at(raw_func, "kspl_main", 0)
            out.s("main")
        else
            module: = trace_module(raw_file)
            for c in module
                out.c('.' if c == '/' || c == '\\' else c)
            out.s(".").s(trace_fn_name(raw_func, module))
        out.s(" at ").s(raw_file).s(":").n(line).s("\n")
    out.flush()

// ============================ Option ============================
// The type records whether a value is present. Only `switch` can extract the value.
// Exhaustiveness checking rejects a missing case for an absent value.
// For shared ownership, use `Rc` or `Arc` from `std/refcount`. To propagate an error, use `!E`.
pub enum Option<|T|> //< an optional value whose `switch` must handle absence
    some(value: T) //< there is a value
    none //< there is no value

// ============================ Result ============================
// `T!E` names this type. `return` supplies a value; `throw` supplies an error.
// Use `!`, `catch`, or `switch` to handle the result.
pub enum Result<|T, E|> //< a value or an error that the caller must use
    ok(value: T) //< a successful value, omitted for `Void!E`
    err(error: E) //< the error from a failed operation

impl<|T|> T?
    pub fn is_some(r: Self): Bool //< whether there is a value
        switch r
        case .some(_)
            return true
        case .none
            return false

    pub fn is_none(r: Self): Bool //< whether there is no value
        return !r.is_some()

    pub fn unwrap_or( //< the value if present, otherwise the alternative
        //<
        //< The caller always evaluates the alternative before this call.
        r: Self,
        alt: T, //< what is returned if there is no value
    ): T
        switch r
        case .some(v)
            return v
        case .none
            return alt

    pub fn unwrap_or_else( //< the value if present, otherwise a computed alternative
        r: Self,
        alt: fn(): T, //< a function with no captures, called only when the value is absent
    ): T
        switch r
        case .some(v)
            return v
        case .none
            return alt()

pub fn map<|T, U|>( //< applies a function to the value, if there is one
    //<
    //< **Write both type arguments** for this free function: `map<|I32, Sz|>(o, f)`.
    //< A method with its own type parameter (`fn map<|U|>`) could also work, like `select` in
    //< `std/seq`.
    //< See "A name on the impl that the receiver leaves open" in
    //< `../docs/DESIGN-programming-language.md`.
    o: T?, //< the value that can be absent
    f: fn(x: T): U, //< the function applied to a present value
): U? //< `f`'s result, or none if `o` is none
    switch o
    case .some(v)
        return .some(f(v))
    case .none
        return .none

pub fn and_then<|T, U|>( //< applies a step that can also return an absent value
    o: T?, //< the value that can be absent
    f: fn(x: T): U?, //< the next step, which can also return an absent value
): U? //< what `f` returns, or none if `o` is none
    switch o
    case .some(v)
        return f(v)
    case .none
        return .none

// ============================ A subsequence's length ============================
pub fn sub_count( //< the number of requested elements available within the sequence
    //<
    //< The sequence contains `count` items. The request starts at `start` and asks for `len` items.
    //< **Check the lower bound of `start` too.** `Sz` is signed.
    //< Checking only the upper bound permits negative offsets that point before the sequence.
    //< Caution: **Do not compare with `start + len`.** A large `len` can overflow the addition and
    //< bypass the limit.
    count: Sz, //< the total item count
    start: Sz, //< the starting offset; a negative offset returns zero items
    len: Sz, //< the requested length, limited to the remaining items
): Sz //< the available item count, or zero if `start` is at or beyond the end
    if start < 0 || start >= count
        return 0
    remaining: = count - start
    safe_len: Sz = 0 if len < 0 else len
    return safe_len if safe_len < remaining else remaining

// ============================ Range ============================
pub struct Range //< an integer sequence with a fixed step for `for` iteration
    pub start: Sz //< the first value
    pub step: Sz //< the increment between values
    pub len: Sz //< the value count, fixed at construction

impl Range: Index<|Sz, Sz|> //< supports iteration with `for i in Range.asc(n)`
    pub fn get(r: Self$@, i: Sz): Sz //< the i-th value of the sequence
        return r.start + i * r.step

impl Range
    pub fn new( //< constructs a range with the specified step
        //<
        //< A zero step or a step in the wrong direction produces an empty range.
        start: Sz, //< the first value
        stop: Sz, //< the exclusive upper or lower bound
        step: Sz, //< the increment between values
    ): Range
        // Caution: **Subtract the endpoints as unsigned values.** At extreme values, signed `stop -
        // start` can overflow, causing undefined behavior. No wider integer is available. After
        // comparing the endpoints, unsigned subtraction gives their distance. Calculate `-step` as
        // unsigned too: negating the minimum `Sz` cannot fit in `Sz`.
        $len: Sz = 0
        if step > 0 && stop > start
            span: U64 = U64::stop - U64::start
            st: = U64::step
            len = Sz::((span + st - 1U64) / st)
        else if step < 0 && stop < start
            span: U64 = U64::start - U64::stop
            st: U64 = U64::0 - U64::step
            len = Sz::((span + st - 1U64) / st)
        return Range::{ .start = start, .step = step, .len = len }

    pub fn asc( //< 0 up to but not including `stop`
        stop: Sz, //< where it stops
    ): Range
        return Range.new(0, stop, 1)

    pub fn desc( //< `n - 1` down to 0
        n: Sz, //< one greater than the first value
    ): Range
        return Range.new(n - 1, -1, -1)

// ============================ The operator traits ============================
// The compiler matches `std.lang.<name>` exactly in `has_implemented_operator_trait` in
// `ksplc/sema/type/env.kspl`. A prefix match would confuse `Index_` with `Index_place_`.

pub trait Add<|Rhs, Output|> //< what `+` desugars to
    fn add(r: Self, rhs: Rhs): Output //< the sum

pub trait Sub<|Rhs, Output|> //< what `-` desugars to
    fn sub(r: Self, rhs: Rhs): Output //< the difference

pub trait Mul<|Rhs, Output|> //< what `*` desugars to
    fn mul(r: Self, rhs: Rhs): Output //< the product

pub trait Div<|Rhs, Output|> //< what `/` desugars to
    fn div(r: Self, rhs: Rhs): Output //< the quotient

pub trait Neg<|Output|> //< what a leading `-` desugars to
    fn neg(r: Self): Output //< the value with its sign flipped

pub trait Not<|Output|> //< what `!` desugars to
    fn not(r: Self): Output //< the negated value

pub trait Eq<|Other|> //< what `==` and `!=` desugar to
    fn eq(r: Self, other: Other): Bool //< whether the two are the same
    fn ne(r: Self, other: Other): Bool //< whether they differ

pub trait Ord<|Other|> //< what `<`, `<=`, `>` and `>=` desugar to
    fn lt(r: Self, other: Other): Bool //< whether it is less
    fn le(r: Self, other: Other): Bool //< whether it is less or equal
    fn gt(r: Self, other: Other): Bool //< whether it is greater
    fn ge(r: Self, other: Other): Bool //< whether it is greater or equal

pub trait Index<|Idx, Output|> //< what `x[i]` desugars to when it returns a copy
    fn get(r: Self, index: Idx): Output //< a copy of the element

pub trait Index_mut<|Idx, Val|> //< what `x[i] = v` desugars to
    fn set(r: Self, index: Idx, val: Val): Void //< writes the element

pub trait Index_place<|Idx, Output|> //< what `x[i] += v` and `x[i]@` desugar to
    //<
    //< This trait returns a mutable pointer to the element. It takes precedence over `Index` and
    //< `Index_mut`. `at` supports both reading and writing.
    fn at( //< the element's address, not a copy
        r: Self,
        index: Idx, //< which element
        file: U8[] = caller_file, //< the caller's position, for an out-of-range message
        line: Sz = caller_line, //< the caller's position, for an out-of-range message
    ): Output$@

pub trait Index_ref<|Idx, Output|> //< what `x[i]` desugars to through a read-only receiver
    //<
    //< **Immutable content requires this trait**, because `Index_place.at` returns a mutable
    //< `Output$@`. The compiler selects `Index_place` for writable receivers and `Index_ref` for
    //< read-only receivers. See "Indexing" in `../docs/SPEC-programming-language.md`.
    fn at_ref( //< the element's read-only address, so nothing is copied
        r: Self,
        index: Idx, //< which element
        file: U8[] = caller_file, //< the caller's position, for an out-of-range message
        line: Sz = caller_line, //< the caller's position, for an out-of-range message
    ): Output@

pub trait Iter<|T|> //< a sequence that only yields items in order, with no length or index
    //<
    //< A chain of filters or maps implements `Iter`. `for x in` iterates over it through
    //< `ksplc/sema/body/for_in.kspl`. The separate `Index` family requires access by position.
    //< Caution: **Declare the receiver as `Self`.** An implementation can take `Self$@` to advance
    //< its position. A generated adapter converts between the value and pointer receivers.
    fn next(r: Self): T? //< the next element, or nothing at the end

    pub fn count(r: Self): Sz //< how many elements it yields; it allocates nothing
        $n: Sz = 0
        for _v in r
            n += 1
        return n

// This function stays separate so `List.at` remains small enough to inline.
// See "Indexing costs one comparison; the stop is out of line" in `std/docs/DESIGN-core.md`.
#noinline
pub fn bounds_panic( //< the one message every container stops with when an index is out of range
    //<
    //< Every container uses this message, matching the built-in bounds check.
    //< See "Conditions that stop execution at run time" in `../docs/SPEC-programming-language.md`.
    //< Caution: **Pass the caller's location.** A default would report `std/lang`, making a
    //< caller's error appear to be a library bug.
    func_name: U8$[], //< the method that was called, so the container can be identified
    idx: Sz, //< the index that was requested
    len: Sz, //< how many elements there were
    file: U8[], //< the caller's position, which the container passes on
    line: Sz, //< the caller's position, which the container passes on
)
    $m: = Panic_msg.new()
    m.s("index out of bounds in ").s(func_name).s(" (idx: ").n(idx).s(", len: ").n(len).s(")")
    panic(m.slice(), file, line)

pub struct Slice<|$T|> //< a borrowed sequence: a pointer and a length, owning nothing
    //<
    //< The type argument controls element mutability. `U8$[]` has mutable elements; `U8[]` has
    //< immutable elements. One level of mutability weakening permits passing a mutable slice to an
    //< immutable parameter. Public `ptr` and `len` fields support construction from a raw pointer:
    //< `U8$[]::{ .ptr = p, .len = n }`.
    pub ptr: T$@ //< where the sequence begins
    pub len: Sz //< how many elements it holds

impl<|T|> T$[]: Index_place<|Sz, T|> //< so an element of a writable slice can be written
    //<
    //< This implementation applies only to mutable slices, as the `$` on the type specifies.
    //< The `Self@` receiver only reads the slice descriptor.
    //< Requiring `Self$@` would prevent writing elements through a slice stored in a read-only
    //< frame. See "The receiver shape an implementation declared" in
    //< `../docs/SPEC-programming-language.md`.
    #inline
    pub fn at(r: Self@, index: Sz, file: U8[], line: Sz): T$@ //< the element's address
        if index < 0 || index >= r.len
            bounds_panic("Slice.at", index, r.len, file, line)
        return r.ptr + index

impl<|T|> T[]: Index_ref<|Sz, T|> //< so an element can be read without copying
    //<
    //< This implementation supports both mutable and immutable slices because the implementing type
    //< has no `$`.
    #inline
    pub fn at_ref(r: Self@, index: Sz, file: U8[], line: Sz): T@ //<
        //< the element's read-only address
        if index < 0 || index >= r.len
            bounds_panic("Slice.at_ref", index, r.len, file, line)
        return r.ptr + index

pub trait Cast<|Output|> //< what `Output::value` desugars to where C would not allow the cast
    //<
    //< C rejects value casts to or from structures. Implementing this trait on the source type
    //< replaces the cast with `cast()`. See `ksplc/sema/body/postfix.kspl`.
    fn cast(r: Self): Output //< the value as the other type

// ============================ The marker traits ============================
pub trait Ref_counted //< the compiler counts copies and scope exits for this type
    //<
    //< See "Why ARC is expressed as a trait" in `docs/DESIGN-programming-language.md` for the
    //< reason to use a trait.
    //< Caution: **Keep these methods `priv`, including in implementations.** Manual calls duplicate
    //< compiler-generated calls and corrupt the count. **Use `r: Self@` in implementations.**
    //< Generated calls also pass addresses of immutable bindings. A `Self$@` receiver would make
    //< the generated C discard `const`.
    priv fn retain(r: Self) //< one more owner; only the compiler calls it
    priv fn release(r: Self) //< one owner fewer; only the compiler calls it

pub trait Move_only { //< a value that cannot be copied implicitly
    //<
    //< The compiler matches the fully qualified name `std.lang.Move_only` exactly.
    //< A structure containing a `Move_only` field by value is also `Move_only`.
}

pub trait Owned //< this type owns memory or a resource, and releases it with `free()`
    //<
    //< **Implement this trait for types that release resources.** A `free()` method alone does not
    //< enable ownership tracking. [W0107] identifies a missing implementation.
    //< **`free` cannot report failure.** It runs during exit or `defer`, when the caller cannot
    //< handle an error. Put cleanup that needs an error check in a separate method, such as
    //< `io.File_stream.sync()`.
    fn free(r: Self) //< releases it, reporting no failure

pub trait Writer //< a destination characters can be written to
    //<
    //< Only the declaration belongs here. Primitive formatting, such as `impl I32: Formattable`,
    //< belongs in `std/strfmt`. Placing it here would add the string library to every file.
    //< Caution: **Do not add methods for writing numbers or booleans.** `Formattable` already lets
    //< each value's type define its format.
    fn s(r: Self, val: U8[]): Self //< writes a string and returns the destination
    fn c(r: Self, val: U8): Self //< writes one byte and returns the destination
    fn flush(r: Self): Self //< passes on what has accumulated, reporting no failure

pub trait Formattable //< what `\{x\}` in a string calls
    //<
    //< `ksplc/parse/desugar.kspl` does the desugaring.
    fn fmt(r: Self, w: Writer): Writer //< writes the value into the destination

pub fn put<|W: Writer, T: Formattable|>( //< writes one value, keeping the destination's own type
    //<
    //< Caution: **Keep the destination's concrete type.** Accepting `Writer` would also make the
    //< return type `Writer`.
    //< Interpolating into a `Str_builder` would then hide its `.slice()` method.
    //< This function ignores the return value from `Formattable.fmt`.
    w: W, //< the destination, returned as its own type, not as a `Writer`
    v: T, //< the value to write
): W //< the same destination, for chaining
    v.fmt(w)
    return w

pub trait Callable1<|A, Ret|> //< a callable value that takes one argument, with its captures
    //<
    //< Caution: **Declare the receiver as `Self`.** An implementation can take `Self@`; a generated
    //< adapter converts between them. See "Why a trait's receiver is fixed to a bare `Self`" in
    //< `docs/DESIGN-programming-language.md`. An implementing value uses the trait representation
    //< `{obj, vtable}`. It cannot cross the C boundary or escape through `return`.
    pub fn call(r: Self, a: A): Ret //< calls it

pub trait Callable2<|A, B, Ret|> //< a callable value that takes two arguments, with its captures
    pub fn call(r: Self, a: A, b: B): Ret //< calls it

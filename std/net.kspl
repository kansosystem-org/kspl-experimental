//< TCP sockets that connect by name or by address, over both IPv4 and IPv6
//< **A client tries the candidate addresses in overlapping attempts; a server binds only one.**
//< How a name that resolves to both IPv4 and IPv6 is handled is in "Connecting by name tries the
//< candidates overlapped" in `std/docs/DESIGN-system.md`.

// ==========================================
// The socket calls are the POSIX (socket(2)) and Windows (Winsock2) code in
// `ksplc/gen/runtime/hosted_net.c`, which the LLVM builds link too; the overlapped connect is here.
// ==========================================
import "std/chars" // classifying and converting single characters
import "std/mem" + { dealloc }

extern "C"
    fn kspl_tcp_listen(host_ptr: U8@, host_len: Sz, port: I32, backlog: I32): I64
    fn kspl_tcp_accept(handle: I64): I64
    fn kspl_tcp_peer(handle: I64, host_out: U8$@, host_cap: Sz, host_len_out: Sz$@,
        port_out: I32$@): I32
    fn kspl_tcp_send(handle: I64, buf: U8@, len: Sz): I32
    fn kspl_tcp_recv(handle: I64, buf: U8$@, cap: Sz): I32
    fn kspl_tcp_close(handle: I64) //< closes a socket
    fn kspl_net_local_port(handle: I64): I32 //< the port a socket is bound to, or -1

    fn kspl_net_set_nonblocking(handle: I64): Bool //<
        //< Makes handle non-blocking, for std/reactor.kspl
        //< The definition and details are in the section on asynchronous-I/O reactor primitives in
        //< ksplc/gen/runtime/hosted_net.c.
    fn kspl_net_set_blocking(handle: I64): Bool //< puts handle back to blocking
    fn kspl_net_would_block(): Bool
    fn kspl_tcp_connect_nonblocking(host_ptr: U8@, host_len: Sz, port: I32): I64
    fn kspl_net_connect_result(handle: I64): I32
    fn kspl_net_shutdown_write(handle: I64): I32
    fn kspl_net_raw_fd(handle: I64): I32 //< the OS's socket number inside a handle, or -1 for none

    // Resolves a name to every candidate as address text; the count, -1 unresolved, -2 short.
    fn kspl_net_resolve_all(host_ptr: U8@, host_len: Sz, texts: U8$@, stride: Sz, lens: Sz$@,
        cap: Sz): I32
    // The same declaration as std/reactor's, held here so a connect does not bring the reactor in.
    fn kspl_net_poll(handles: I64$@, interest: U8$@, n: Sz, timeout_ms: I32, revents_out: U8$@): I32
    fn kspl_mono_us(): I64

pub const ADDR_TEXT_MAX: Sz = 46 //< a buffer size that any address in text form fits in.
    //< C's INET6_ADDRSTRLEN. **A buffer that is too small is refused, not truncated**: a truncated
    //< `2001:db8::1` reads as another address, `2001:db8:`, in logs and in matching.

pub enum Net_error //< why a socket operation failed
    bind_failed //< the listen or bind failed: the port is in use, permission is missing, and so on
    connect_failed //< the address resolved, but no candidate connected
    accept_failed //< the waiting connection could not be accepted
    io_failed //< the send or receive failed (a disconnection, for example)
    would_block //< in non-blocking mode, the socket is just not ready yet
    set_option_failed //< changing a socket option failed
    resolve_failed //< the host name did not resolve to an address.
        //< **Keep "it did not resolve" apart from "it did not connect".** Otherwise a wrong name
        //< and a missing peer look the same, and nobody can tell which to fix.
    addr_buffer_too_small //< the buffer for the address is shorter than `ADDR_TEXT_MAX`
    bad_port //< the port is outside 0 to 65535, which a socket address cannot hold
    timed_out //<
        //< the peer did not answer within the wait (`read_for`, a connect past `CONNECT_WAIT_MS`)

impl Net_error
    priv fn would_block_or(other: Self): Net_error //<
        //< would_block if the socket is just not ready yet; otherwise the real I/O error `other`
        return .would_block if kspl_net_would_block() else other

priv const DEFAULT_BACKLOG: I32 = 128

priv const PORT_MAX: I32 = 65535 //< the largest port: a socket address holds 16 bits

priv fn checked_port(port: I32): Void!Net_error //< refuses a port no socket address can hold
    //< Caution: **Refuse, never wrap.** C's 16-bit field would turn 83659 into 18123 and -1 into
    //< 65535, so the socket would bind or reach another port in silence.
    if port < 0 || port > PORT_MAX
        throw .bad_port

priv fn bound_port(handle: I64): I32!Net_error //< the port a socket is bound to
    p: = kspl_net_local_port(handle)
    if p < 0
        throw .io_failed
    return p

priv fn transferred(n: I32): Sz!Net_error //<
    //< Turns the return value of a C send or receive (negative on failure) into a byte count
    //< write and read both use this one check.
    if n < 0
        throw Net_error.io_failed.would_block_or()
    return Sz::n

// ============================ Tcp_listener ============================
priv fn handle_set_nonblocking(handle: I64): Void!Net_error //< makes a handle non-blocking
    //< Both socket types use it. **It can fail, so it returns `!Net_error`.** A discarded
    //< `Bool` passes without a word, but a dropped result is a compile error
    //< ("Absent or failed: one rule" in std/docs/DESIGN-core.md).
    if !kspl_net_set_nonblocking(handle)
        throw .set_option_failed

pub struct Tcp_listener //< a socket that waits for incoming connections
    priv handle: I64

impl Tcp_listener
    pub fn bind( //< starts listening on the address and port
        //< "0.0.0.0" listens on every IPv4 interface, "::" on every IPv6 one. **"::" does not
        //< accept IPv4 clients**, whatever the system default ("Connecting by name tries the
        //< candidates overlapped" in std/docs/DESIGN-system.md). To accept both, open two
        //< listeners.
        host: U8[], //< the address to listen on; empty means `"0.0.0.0"`
        port: I32, //< the port to listen on; 0 lets the OS choose a free one (see `port`)
    ): Tcp_listener$@!Net_error
        checked_port(port)!
        h: = kspl_tcp_listen(host.ptr, host.len, port, DEFAULT_BACKLOG)
        if h < 0
            throw .resolve_failed
        if h == 0
            throw .bind_failed
        l: = mem.alloc_as<|Tcp_listener|>()
        l.handle = h
        return l

    pub fn accept(r: Self$@): Tcp_stream$@!Net_error //< accepts the next waiting connection
        //< The stream it returns is blocking on every OS, whatever the listener's mode.
        h: = kspl_tcp_accept(r.handle)
        if h == 0
            throw Net_error.accept_failed.would_block_or()
        return Tcp_stream.connected_stream(h)

    pub fn port(r: Self@): I32!Net_error //< the port it listens on, the OS's choice for a 0
        return bound_port(r.handle)!

    pub fn free(r: Self$@) //< closes the listener and frees it
        kspl_tcp_close(r.handle)
        dealloc(Void$@::r)

    pub fn raw_handle(r: Self@): I64 //<
        //< the raw handle, the only thing `std/reactor` uses to register the socket
        //< Only for registering; send/recv/accept still go only through this type's methods.
        return r.handle

    pub fn set_nonblocking(r: Self$@): Void!Net_error //<
        //< makes it non-blocking, for use with `std/reactor`
        handle_set_nonblocking(r.handle)!

// ============================ Tcp_stream ============================
pub struct Tcp_stream //< one connection that can be written to and read from
    priv handle: I64

priv const ATTEMPT_DELAY_MS: I32 = 250 //<
    //< How long one attempt runs before the next starts beside it (RFC 8305's Attempt Delay)
priv const MAX_CANDIDATES: Sz = 8 //<
    //< How many candidates a connect holds: the runtime's `KSPL_ADDR_MAX`, its bound on one name
    //< Caution: **A holder shorter than the runtime's bound fails every connect**, refused there.
priv const CANDIDATE_TEXT_MAX: Sz = 112 //< the room for one candidate's text, with its scope
priv const CANDIDATE_HOLD: Sz = MAX_CANDIDATES * CANDIDATE_TEXT_MAX
priv const POLL_WRITABLE: U8 = 0x2 //< `std/reactor`'s `WRITABLE`, the mark kspl_net_poll takes
priv const POLL_READABLE: U8 = 0x1 //< `std/reactor`'s `READABLE`
priv const CONNECT_WAIT_MS: I64 = 30000I64 //< how long a connect waits for any candidate at all
    //< Caution: **Bound it here.** A candidate whose packets are dropped never refuses. The OS's
    //< own limit is minutes, so a connect to a dead address would hang its caller that long.

priv struct Round //< what one round of the attempts settled
    winner: I64 //< the attempt that connected (the others are closed), or 0
    left: Sz //< how many attempts are still in flight, packed at the front

priv fn wait_writable(live: I64$[], revents: U8$[]): Bool //<
    //< Waits up to one attempt delay for any of them to settle; false where the wait itself fails
    //< What the wait reported per attempt lands in `revents`, in `live`'s order.
    //< Caution: **Never wait without a bound.** Windows's `WSAPoll` does not report a failed
    //< connection, so only the round's own look at each socket can see it.
    $interest: U8[MAX_CANDIDATES] = ::{}
    for i in Range.asc(live.len)
        interest[i] = POLL_WRITABLE
        revents[i] = 0
    r: =
        kspl_net_poll(live.ptr, (U8$[]::interest).ptr, live.len, ATTEMPT_DELAY_MS, revents.ptr)
    return r >= 0

priv fn settle_round(live: I64$[], revents: U8$[]): Round //<
    //< Looks at each attempt: the first connected one wins, a refused one is closed
    //< A refusal is the socket's own answer (`kspl_net_connect_result`), which a wait on Windows
    //< never reports. **A win needs both the wait's writable and the socket's answer.** On Windows
    //< the socket alone can call an attempt still in flight connected. The first such attempt
    //< would then win over the one that did connect.
    //< Caution: **On a win, close only what is still open**: the kept ones already packed in front,
    //< and the ones not yet looked at. A refused one is closed, and its slot can hold another.
    $left: Sz = 0
    for i in Range.asc(live.len)
        state: = kspl_net_connect_result(live[i])
        if state == 1 && (revents[i] & POLL_WRITABLE) != 0
            for j in Range.asc(left)
                kspl_tcp_close(live[j])
            for j in Range.asc(live.len - i - 1)
                kspl_tcp_close(live[i + 1 + j])
            return Round::{ .winner = live[i], .left = 0 }
        if state < 0
            kspl_tcp_close(live[i])
            continue
        live[left] = live[i]
        left += 1
    return Round::{ .winner = 0, .left = left }

fn connect_over( //< the overlapped attempts `Tcp_stream.connect` makes over resolved candidates
    //< It starts one every attempt delay, in their order, and takes the first that connects; the
    //< one it returns is blocking. Package-wide, so `std/tests` can hand it candidates of its own.
    candidates: U8[][], //< address texts, at most `MAX_CANDIDATES`, in the order to try them
    port: I32, //< the port on each
    wait_ms: I64, //< how long to wait for any candidate at all (`connect` gives `CONNECT_WAIT_MS`)
): Tcp_stream$@!Net_error
    checked_port(port)!
    deadline: = kspl_mono_us() + wait_ms * 1000I64
    $live: I64[MAX_CANDIDATES] = ::{}
    flight: = I64$[]::live
    $seen: U8[MAX_CANDIDATES] = ::{}
    marks: = U8$[]::seen
    $in_flight: Sz = 0
    $next: Sz = 0
    for next < candidates.len || in_flight > 0
        if next < candidates.len && in_flight < MAX_CANDIDATES
            text: = candidates[next]
            next += 1
            h: = kspl_tcp_connect_nonblocking(text.ptr, text.len, port)
            if h > 0
                live[in_flight] = h
                in_flight += 1
        if in_flight == 0
            continue
        open: = I64$[]::{ .ptr = flight.ptr, .len = in_flight }
        got: = U8$[]::{ .ptr = marks.ptr, .len = in_flight }
        if !wait_writable(open, got)
            break
        won: = settle_round(open, got)
        if won.winner != 0
            if !kspl_net_set_blocking(won.winner)
                kspl_tcp_close(won.winner)
                throw .connect_failed
            return Tcp_stream.connected_stream(won.winner)
        in_flight = won.left
        if in_flight > 0 && next >= candidates.len && kspl_mono_us() >= deadline
            for i in Range.asc(in_flight)
                kspl_tcp_close(live[i])
            throw .timed_out
    for i in Range.asc(in_flight)
        kspl_tcp_close(live[i])
    throw .connect_failed

pub struct Peer_addr //< the address of the peer of a connection
    //< The result of peer(); the address text goes into the caller's host_out.
    pub host_len: Sz //< how many bytes of address text were written into the caller's buffer
    pub port: I32 //< the peer's port

impl Tcp_stream
    priv fn connected_stream(h: I64): Tcp_stream$@ //< wraps a successfully opened socket
        s: = mem.alloc_as<|Tcp_stream|>()
        s.handle = h
        return s

    pub fn connect( //< connects by name, trying the candidate addresses in overlapping attempts
        //< The connection it returns is blocking. Why the attempts overlap is "Connecting by name
        //< tries the candidates overlapped" in `std/docs/DESIGN-system.md`.
        host: U8[], //< the name or address to connect to
        port: I32, //< the port on that host
    ): Tcp_stream$@!Net_error
        $texts: U8[CANDIDATE_HOLD] = ::{}
        $lens: Sz[MAX_CANDIDATES] = ::{}
        hold: = U8$[]::texts
        got: =
            kspl_net_resolve_all(host.ptr, host.len, hold.ptr, CANDIDATE_TEXT_MAX,
            (Sz$[]::lens).ptr, MAX_CANDIDATES)
        if got == -1
            throw .resolve_failed
        if got < 0
            panic("std/net: the runtime keeps more candidates than Tcp_stream.connect holds")
        $candidates: U8[][MAX_CANDIDATES] = ::{}
        for i in Range.asc(got)
            candidates[i] = U8[]::{ .ptr = hold.ptr + i * CANDIDATE_TEXT_MAX, .len = lens[i] }
        return connect_over((U8[][]::candidates).sub(0, got), port, CONNECT_WAIT_MS)

    pub fn write( //< sends and returns how much was sent; a partial send is normal
        //< To send everything, use `write_all` (a separate name, as in Rust, because a missing loop
        //< silently truncates).
        r: Self$@,
        buf: U8[], //< the bytes to send
    ): Sz!Net_error
        return transferred(kspl_tcp_send(r.handle, buf.ptr, buf.len))

    pub fn write_all( //< sends every byte in a loop; a non-blocking socket can still fail
        //< On a non-blocking socket it throws would_block rather than spinning. The amount
        //< already sent is then lost. To resume a partial send, use write and track the progress
        //< yourself.
        r: Self$@,
        buf: U8[], //< the bytes sent
    ): Void!Net_error
        $sent: Sz = 0
        for sent < buf.len
            n: = r.write(buf.sub(sent, buf.len - sent))!
            if n == 0
                throw .io_failed // no progress is possible (the peer closed)
            sent += n

    pub fn read( //< receives and returns how much arrived; 0 means the peer closed
        r: Self$@,
        buf: U8$[], //< where the bytes go
    ): Sz!Net_error
        return transferred(kspl_tcp_recv(r.handle, buf.ptr, buf.len))

    pub fn read_for( //< receives as `read` does, waiting at most `timeout_ms` for the first byte
        //< For a blocking stream whose peer can go quiet: `read` would wait for it for good.
        r: Self$@,
        buf: U8$[], //< where the bytes go
        timeout_ms: I32, //< how long to wait for something to read; `timed_out` past it
    ): Sz!Net_error
        $h: I64[1] = ::{ r.handle }
        $want: U8[1] = ::{ POLL_READABLE }
        $got: U8[1] = ::{}
        ready: =
            kspl_net_poll((I64$[]::h).ptr, (U8$[]::want).ptr, 1, timeout_ms,
            (U8$[]::got).ptr)
        if ready < 0
            throw .io_failed
        if ready == 0
            throw .timed_out
        return r.read(buf)!

    pub fn peer( //< the address of the peer
        //< For a stream that `accept` returned, it is the client; for one that connected, the
        //< server.
        r: Self$@,
        host_out: U8$[], //< where the address text goes; at least `ADDR_TEXT_MAX` long
    ): Peer_addr!Net_error
        if host_out.len < ADDR_TEXT_MAX
            throw .addr_buffer_too_small
        $host_len: Sz = 0
        $port: I32 = 0
        if kspl_tcp_peer(r.handle, host_out.ptr, host_out.len, host_len@, port@) < 0
            throw .io_failed // the peer is already gone
        return Peer_addr::{ .host_len = host_len, .port = port }

    pub fn free(r: Self$@) //< closes the connection and frees it
        kspl_tcp_close(r.handle)
        dealloc(Void$@::r)

    pub fn raw_handle(r: Self@): I64 //<
        //< the raw handle, the only thing `std/reactor` uses to register the socket
        return r.handle

    pub fn raw_fd(r: Self@): I32 //<
        //< the OS's socket number, for a C library that reads and writes the socket itself
        //< Caution: **Do not also read or write through this type**: the bytes would interleave
        //< with that library's. `free()` still closes the socket.
        return kspl_net_raw_fd(r.handle)

    pub fn set_nonblocking(r: Self$@): Void!Net_error //<
        //< makes it non-blocking, for use with `std/reactor`
        handle_set_nonblocking(r.handle)!

    pub fn shut_write(r: Self$@): Void!Net_error //<
        //< closes only the sending half, to signal the end
        //< **This is not a disconnection.** The peer's `read` returns 0, while this side **can
        //< still read and wait for a response**.
        //< Caution: **Do not use it instead of closing** (only `free` releases the memory).
        if kspl_net_shutdown_write(r.handle) != 0
            throw .io_failed // the peer is already gone, or the socket is already closed

impl Tcp_listener: Manual_free {} //< it owns its resources and frees them with `free()`.
impl Tcp_stream: Manual_free {} //< it owns its socket and memory and frees them with `free()`

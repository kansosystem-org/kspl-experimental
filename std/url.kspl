//< Percent-encoding (RFC 3986), and the query-string form `application/x-www-form-urlencoded`
//<
//< For putting text safely into an HTTP path or a query parameter; decoding returns the original
//< text unchanged.
import "std/chars"
import "std/mem" + { Arena, Own_arena }

pub enum Url_error //< why a piece of a URL could not be decoded
    invalid_percent_encoding //< what follows a `%` is not two hex digits

priv fn is_unreserved(c: U8): Bool //<
    //< Whether c is an "unreserved" character (RFC 3986 §2.3)
    //<
    //< These are ALPHA, DIGIT, "-", ".", "_" and "~".
    return c.is_alnum() || c == '-' || c == '.' || c == '_' || c == '~'

pub fn encode( //< percent-encodes a piece of text so it can go inside a URL
    //<
    //< An unreserved character stays as it is; any other byte becomes the hex form `%XX`.
    s: U8[], //< the plain text, not yet escaped
    arena: Arena$@, //< where the result goes; null means the heap, freed with `dealloc`
): U8[] //< the escaped text, hex digits in uppercase
    $n: Sz = 0
    for c in s
        n += 1 if is_unreserved(c) else 3
    out: = U8$[]::{ .ptr = U8$@::arena.alloc(n), .len = n }
    $at: Sz = 0
    for c in s
        if is_unreserved(c)
            out[at] = c
            at += 1
        else
            out[at] = '%'
            out[at + 1] = chars.hex_digit(c >> 4, 'A')
            out[at + 2] = chars.hex_digit(U8::(c & 0xF), 'A')
            at += 3
    return out

pub fn decode_component( //< percent-decodes a path piece, leaving `+` as a `+`
    //<
    //< **"+" does not become a space.** Only application/x-www-form-urlencoded writes a space as
    //< "+"; in a URI path a "+" is just a "+" (RFC 3986). `parse_query` reads a query's "+" as a
    //< space.
    s: U8[], //< the escaped text as it arrived
    arena: Arena$@, //< where the result goes; null means the heap, freed with `dealloc`
): U8[]!Url_error //< the decoded text; a broken `%XX` fails, having allocated nothing
    return decode_impl(s, false, arena)

priv fn decode_impl(s: U8[], plus_is_space: Bool, arena: Arena$@): U8[]!Url_error //<
    //< Checks every `%XX` and counts the bytes first, so a failure has nothing to free
    $n: Sz = 0
    $i: Sz = 0
    for i < s.len
        if s[i] == '%'
            if i + 2 >= s.len || s[i + 1].hex_val() < 0 || s[i + 2].hex_val() < 0
                throw .invalid_percent_encoding
            i += 3
        else
            i += 1
        n += 1
    out: = U8$[]::{ .ptr = U8$@::arena.alloc(n), .len = n }
    $at: Sz = 0
    i = 0
    for i < s.len
        c: = s[i]
        if c == '%'
            out[at] = U8::(s[i + 1].hex_val() * 16 + s[i + 2].hex_val())
            i += 3
        else
            out[at] = ' ' if c == '+' && plus_is_space else c
            i += 1
        at += 1
    return out

// ---------------------------------------------------------
// Parsing a query string (the "a=1&b=2" form)
// ---------------------------------------------------------
pub struct Query_param //< one `name=value` pair of a query string
    pub name: U8$[] //< the name, already decoded and copied into the arena
    pub value: U8$[] //< the value; empty when the pair has no `=`
    pub next: Query_param$@ //< the next pair, in the order they appear
    priv own: Own_arena //< in the first pair `parse_query` returned given null, their arena

impl Query_param
    pub fn free(r: Self$@) //< lets go every pair, when `parse_query` was given null
        //<
        //< **Only the first pair of such a list frees anything.** One parsed into an arena owns
        //< nothing, and neither does a pair further down.
        if r != null
            $own: = r.own
            own.free()
impl Query_param: Owned {} //< `free()` lets go the arena a query parsed with null lives in

pub fn parse_query( //< splits a query string into a linked list of pairs
    //<
    //< Each name and value is percent-decoded, a `+` read as a space as a form writes it, and
    //< copied into the arena, in order.
    query: U8[], //< the text after the `?`; a leading `?` is dropped
    arena: Arena$@, //< where the pairs go; null means an arena of the pairs' own and a `free()`
): Query_param$@!Url_error //< the first pair, or null for an empty query; a broken `%XX` fails
    $work: = mem.scratch(arena)
    head: = pairs_of(query, work.arena) catch e
        work.free()
        throw e
    if head == null
        work.free()
    else
        head.own = work.own
    return head

priv fn pairs_of(query: U8[], arena: Arena$@): Query_param$@!Url_error //< parse_query's work
    $head: Query_param$@ = null
    $tail: Query_param$@ = null
    q: = query.strip_prefix("?")

    $start: Sz = 0
    for start <= q.len
        amp: = q.sub_from(start).find_char('&')
        end: = start + amp.unwrap_or(q.len - start)
        pair: = q.sub(start, end - start)
        if pair.len > 0
            $raw_name: U8[] = pair
            $raw_value: U8[] = ""
            if eq: = pair.find_char('=')
                raw_name = pair.sub(0, eq)
                raw_value = pair.sub_from(eq + 1)
            param: Query_param = ::{ .name = U8$[]::decode_impl(raw_name, true, arena)!,
                .value = U8$[]::decode_impl(raw_value, true, arena)!, .next = null }
            node: = arena.create(param)
            if head == null
                head = node
            else
                tail.next = node
            tail = node
        if amp.is_none()
            break
        start = end + 1
    return head

//< Parses and builds HTTP/1.1 messages, both requests and responses
//< Use it for a web server or client over `std/net`'s TCP sockets. **It supports only a body
//< delimited by `Content-Length`**: not `Transfer-Encoding: chunked`, a body read to the close,
//< `100-continue` or HTTP/2. The reader handles pipelining through `consumed`; it reads a response
//< as the answer to a request other than HEAD.

// ==========================================
// Caution: **Refuse any syntax where another implementation can find a different body boundary;
// never interpret it silently.** A boundary one byte off from the server in front (a reverse
// proxy) allows request smuggling.
// ==========================================
import "std/chars"
import "std/mem" + { Arena, Own_arena }
import "std/net"
import "std/str" { Str_builder }
import "std/strnum" // `parse_size`
import "std/sys"

pub enum Http_error //< why a message could not be read, or cannot be trusted
    invalid_request_line //< the first line is not `METHOD target VERSION`
    invalid_status_line //< the first line is not `VERSION status reason`
    invalid_header //< a header line is not `name: value`
    invalid_host //< `Host` is named twice, missing on HTTP/1.1 and later, or not a host and port
        //< RFC 9112 §3.2 asks a server to answer each with 400: two readers taking different ones,
        //< or reading one value differently, would send one request to two hosts.
    unsupported_transfer_encoding //< the message has `Transfer-Encoding`, which is always refused.
        //< Ignoring it silently would let it disagree with Content-Length (request smuggling).
    length_mismatch //< what a head being built says of the body's length is not what is written
        //< A `Content-Length` naming another length or given twice, or a length or a body where the
        //< status allows none (1xx, 204, 304). A reader would cut the message somewhere else.
    unsupported_close_delimited //< a response that can carry a body names no `Content-Length`
        //< Its body runs to the close, which is not read here. Cut off early, it cannot be told
        //< from a whole one. So it is refused rather than read as empty.
    invalid_line_break //< a bare CR or LF was in the headers; only CRLF ends a line
    unsupported_version //< the version is not `HTTP/` plus one digit, a dot and one digit
    incomplete //< the header or body has not all arrived yet
    head_too_large //< the first line and the headers went over `MAX_HEAD_BYTES` (HTTP's 431)
    body_too_large //< `Content-Length` names more than the caller's body limit (HTTP's 413)
    connection_closed //< the peer closed before the header or body was fully read
    io(err: net.Net_error) //< the socket itself failed

pub const MAX_HEAD_BYTES: Sz = 64 * 1024 //< the most a message's head can take, against DoS
    //< The head is the first line and the headers; every reader here refuses a longer one.
pub const DEFAULT_MAX_BODY_BYTES: Sz = 16 * 1024 * 1024 //< the body limit if the caller sets none

// ---------------------------------------------------------
// Checking the character sets (the parser and the builder use the same ones)
// ---------------------------------------------------------

priv fn is_token(s: U8[]): Bool //<
    //< Whether it is an RFC 9110 token, the character set of a header name and a method
    //< An empty string is not a token.
    //< Caution: **Check a header name with this.** If a space were allowed, `Content-Length : 5`
    //< would be Content-Length only here. The proxy in front passes it on as "an unknown header".
    //< The body boundaries then disagree, the same hole that Transfer-Encoding is refused for.
    if s.len == 0
        return false
    for i in Range.asc(s.len)
        if !s[i].is_alnum() && "!#$%&'*+-.^_`|~".find_char(s[i]).is_none()
            return false
    return true

priv fn is_field_value(s: U8[]): Bool //<
    //< Whether the text can appear in a header value or a reason phrase
    //< It refuses control characters other than HTAB, and DEL (0x80-0xFF is allowed). An empty
    //< string is allowed.
    for i in Range.asc(s.len)
        if s[i] != '\t' && (s[i] < ' ' || s[i] == 127)
            return false
    return true

priv fn is_request_target(s: U8[]): Bool //< whether a request line can carry it as its target
    //< Non-empty, with no control byte, space or tab. Caution: **Refuse a tab as a space.** A
    //< lenient reader splits the line on any whitespace, so either makes the rest the version.
    //< Then a second request can be packed into one line. Reading and writing share this one test.
    return s.len > 0 && is_field_value(s) && s.find_char(' ').is_none() &&
        s.find_char('\t').is_none()

priv fn check_version(v: U8[]): Void!Http_error //<
    //< HTTP-version is always 8 bytes: "HTTP/" + one digit + "." + one digit
    if v.len != 8 || !v.starts_with("HTTP/")
        throw .unsupported_version
    if !v[5].is_digit() || v[6] != '.' || !v[7].is_digit()
        throw .unsupported_version

pub fn is_1_1_or_later( //< whether a message's version is HTTP/1.1 or later
    //< **This is the one place that decides it**: on 1.1 and later a request must name `Host`,
    //< and a connection stays open unless `Connection: close` asks otherwise.
    version: U8[], //< `HTTP/d.d`, as `Request.version` holds it; any other text is not later
): Bool
    check_version(version) catch
        return false
    return version[5] > '1' || (version[5] == '1' && version[7] >= '1')

priv fn is_host_byte(c: U8): Bool //<
    //< Whether a reg-name holds the byte as it is: RFC 3986's unreserved and sub-delims
    return c.is_alnum() || "-.~!$&'()*+,;=".find_char(c).is_some()

priv fn is_host_value(v: U8[]): Bool //<
    //< Whether a `Host` value is `uri-host [":" port]` (RFC 9110 §7.2, RFC 3986 §3.2.2)
    //< The host is a bracketed IP literal or a name of host bytes and `%XX`; the port is digits up
    //< to 65535. Caution: **Refuse `@` and `/`**: a reader taking `a@b` as userinfo and host, or
    //< `a/b` as host and path, routes by another name than the one checked here.
    $at: Sz = 0
    if v.starts_with("[")
        close: = v.find_char(']').unwrap_or(0)
        if close < 2
            return false
        for i in Range.asc(close - 1)
            c: = v[i + 1]
            if !is_host_byte(c) && c != ':'
                return false
        at = close + 1
    else
        for at < v.len && v[at] != ':'
            if v[at] == '%'
                if at + 2 >= v.len || v[at + 1].hex_val().is_none() ||
                    v[at + 2].hex_val().is_none()
                    return false
                at += 3
            else if is_host_byte(v[at])
                at += 1
            else
                return false
    if at == v.len
        return true
    if v[at] != ':'
        return false
    port: = v.sub_from(at + 1)
    if port.len == 0
        return true
    _n: = port.to_count(65535) catch
        return false
    return port.len <= 5

priv fn parse_digits(s: U8[]): Sz!Http_error //< it accepts only `1*DIGIT`, up to what `Sz` holds
    //< Caution: **Do not use parse_size**, which reads `5abc` as 5 and accepts `+5`; accepting what
    //< the proxy in front refuses makes the body boundaries disagree.
    return s.to_count(mem.SZ_MAX) catch
        throw .invalid_header

// ---------------------------------------------------------
// The headers: in the order they arrived, names compared ignoring case, and one name allowed more
// than once
// ---------------------------------------------------------
pub struct Headers //< a message's headers, in the order they arrived; there can be none
    //< **The list owns its arena, not any one header**, so `free()` means one thing. It lets go the
    //< arena `headers(null)` made. It does nothing for a list read from a message or built in an
    //< arena. **A header is reached through it, never through a pointer that can be null.** So an
    //< empty list is a value like any other (`find`, `each`, `is_empty`).
    priv first: Header$@ //< the first header; null for none
    priv own: Own_arena //< the arena `headers(null)` made for the list; empty otherwise

pub struct Header //< one header, as `Headers.each` hands it out
    pub name: U8$[] //< the name as it arrived; its case has no meaning
    pub value: U8$[] //< the value as it arrived, with surrounding whitespace trimmed
    priv next: Header$@ //< the header after this one; null after the last

impl Headers
    pub fn free(r: Self$@) //< lets go the list's arena, when `headers(null)` built it
        $own: = r.own
        own.free()

    pub fn find( //< the first value with that name, or nothing; case is ignored
        r: Self,
        name: U8[], //< the header name to look for
    ): U8[]?
        for h in r.each()
            if h.name.equals_ignore_case(name)
                return .some(h.value)
        return .none

    pub fn each(r: Self): Header_seq //< walks the headers in order (`for h in head.each()`)
        return Header_seq::{ .at = r.first }

    pub fn is_empty(r: Self): Bool //< whether it holds no header
        return r.first == null

    priv fn has(r: Self, name: U8[]): Bool
        return r.find(name).is_some()

pub fn lists_token( //< whether a comma-separated header value holds the token, in any case
    //< `close, TE` holds `close`. Each item is compared with the spaces around it trimmed, so
    //< `x-close` and `closed` do not hold it (RFC 9110 §5.6.1).
    list: U8[], //< a header value, such as `Connection`'s
    want: U8[], //< the token to look for
): Bool
    $rest: = list
    for
        cut: = rest.find_char(',').unwrap_or(rest.len)
        if rest.sub(0, cut).trim_spaces().equals_ignore_case(want)
            return true
        if cut >= rest.len
            return false
        rest = rest.sub_from(cut + 1)

priv fn connection_lists(head: Headers, token: U8[]): Bool //<
    //< Whether any `Connection` header lists the token; the header can be sent more than once
    for h in head.each()
        if h.name.equals_ignore_case("Connection") && lists_token(h.value, token)
            return true
    return false
impl Headers: Manual_free {} //< `free()` lets go the arena a list from `headers(null)` lives in

pub struct Header_seq //< walks a list of headers one at a time, in order
    priv at: Header$@

impl Header_seq: Iter<|Header@|> //< so a `for` drives it
    pub fn next(r: Self$@): Header@? //< the next header, or nothing after the last
        h: = r.at
        if h == null
            return .none
        r.at = h.next
        return .some(h)

priv fn check_host(head: Headers, version: U8[]): Void!Http_error //<
    //< Refuses a `Host` named twice, missing on HTTP/1.1 and later, or not a host and port
    //< Caution: **Do not take the first `Host` and drop the rest.** A proxy in front that takes
    //< another one routes the request by a name the server never checked.
    $count: Sz = 0
    for h in head.each()
        if h.name.equals_ignore_case("Host")
            count += 1
            if !is_host_value(h.value)
                throw .invalid_host
    if count > 1 || (count == 0 && is_1_1_or_later(version))
        throw .invalid_host

priv fn get_content_length(head: Headers): Sz?!Http_error //<
    //< Parses the Content-Length header's value; none where it is absent
    //< Transfer-Encoding is refused, and so are two different Content-Length values:
    //< implementations disagree on which one to use, which opens the way to smuggling.
    $found: = false
    $length: Sz = 0
    for h in head.each()
        if h.name.equals_ignore_case("Transfer-Encoding")
            throw .unsupported_transfer_encoding
        if h.name.equals_ignore_case("Content-Length")
            v: = parse_digits(h.value)!
            if found && v != length
                throw .invalid_header
            found = true
            length = v
    return .some(length) if found else .none

priv fn valid_status(status: I32): Bool //< whether it lies in 100 to 599, RFC 9110's range
    //< Caution: **Refuse one below 100 on reading too.** `may_carry_body` gives it no body, so a
    //< body sent after it would be read as the next response.
    return status >= 100 && status <= 599

priv fn may_carry_body(status: I32): Bool //< whether a response with this status can have a body
    //< 1xx, 204 and 304 never do, whatever their head says (RFC 9112 §6.3).
    return status >= 200 && status != 204 && status != 304

pub struct Header_builder //< builds a header list, keeping the order the headers were added in
    //< The same "list builder that tracks head/tail by value" pattern as json.kspl's
    //< Object_builder/Array_builder.
    priv arena: Arena$@ //< where the headers go; null until `add` makes an arena of the list's own
    priv own: Own_arena //< that arena of its own, which the built list keeps
    priv head: Header$@ //< the first header added; null for none yet
    priv tail: Header$@ //< the last header added, so the next one is appended without a walk

pub fn headers( //< an empty header builder
    //< With `null`, the first `add` makes an arena the list keeps, and `defer h.free()` on what
    //< `build` returns frees it all.
    arena: Arena$@, //< where the headers go; null means an arena of the list's own and a `free()`
): Header_builder //< the builder; each add returns it again, for chaining
    return Header_builder::{ .arena = arena, .own = ::{}, .head = null, .tail = null }

impl Header_builder
    pub fn add( //< appends one header; the same name can be added again
        $r: Self,
        name: U8[], //< the header name
        value: U8[], //< its value
    ): Self
        if r.arena == null
            $work: = mem.scratch(null)
            r.arena = work.arena
            r.own = work.keep()
        hdr: Header = ::{ .name = r.arena.dup_str(name), .value = r.arena.dup_str(value),
            .next = null }
        h: = r.arena.create(hdr)
        if r.head == null
            r.head = h
        else
            r.tail.next = h
        r.tail = h
        return r

    pub fn build(r: Self): Headers //< the list built so far; empty if none was added
        return Headers::{ .first = r.head, .own = r.own }

// ---------------------------------------------------------
// Request / Response. The reader drops `consumed` bytes to reach the next message
// (Str_builder.drop_prefix).
// ---------------------------------------------------------
pub struct Request //< one received request, and how much of the buffer it used
    pub method: U8$[] //< the method as it arrived, such as `GET`
    pub target: U8$[] //< the raw target, including the query string, such as `/foo?x=1`
    pub version: U8$[] //< the version as it arrived, such as `HTTP/1.1`
    pub headers: Headers //< the headers in the order they arrived
    pub body: U8$[] //< the body, of the length `Content-Length` gave
    pub consumed: Sz //< how many bytes of the buffer this message used; the rest is the next one
    priv own: Own_arena //< the arena it lives in, when `parse_request` was given null

impl Request
    pub fn free(r: Self$@) //< lets go the request and all its parts, when made with a null arena
        //< Made in the caller's arena, it frees nothing: that arena does.
        $own: = r.own
        own.free()

    pub fn wants_close(r: Self@): Bool //< whether the connection closes after the answer to it
        //< `close` among the `Connection` tokens closes it (RFC 9112 §9.3). Otherwise HTTP/1.1
        //< stays open, and HTTP/1.0 only when it lists `keep-alive`. Caution: **Do not keep a 1.0
        //< client open unasked**: it reads the answer to the close, so it waits for the server.
        if connection_lists(r.headers, "close")
            return true
        return !is_1_1_or_later(r.version) && !connection_lists(r.headers, "keep-alive")
impl Request: Manual_free {} //< `free()` lets go the arena a request read with null lives in

pub struct Response //< one received response, and how much of the buffer it used
    pub version: U8$[] //< the version as it arrived, such as `HTTP/1.1`
    pub status: I32 //< the status number
    pub reason: U8$[] //< the reason phrase, as the peer wrote it
    pub headers: Headers //< the headers in the order they arrived
    pub body: U8$[] //< the body, of the length `Content-Length` gave
    pub consumed: Sz //< how many bytes of the buffer this message used; the rest is the next one
    priv own: Own_arena //< the arena it lives in, when it was read with a null arena

impl Response
    pub fn free(r: Self$@) //< lets go the response and all its parts, when read with a null arena
        //< Read into the caller's arena, it frees nothing: that arena does.
        $own: = r.own
        own.free()
impl Response: Manual_free {} //< `free()` lets go the arena a response read with null lives in

// ---------------------------------------------------------
// The shared core of buffer parsing (the state of one CRLF-delimited scan)
// ---------------------------------------------------------
priv struct Scan_ctx
    src: U8[]
    pos: Sz

priv fn read_line(ctx: Scan_ctx$@): U8[]!Http_error //<
    //< Cuts out one line ending in "\r\n", without the "\r\n", and moves pos past it
    //< If none is found it throws incomplete.
    //< Caution: **Accept a bare LF or a bare CR neither as a line end nor as content.** Many
    //< implementations split on an LF alone, so `Content-Length: 0\nContent-Length: 44` would be
    //< one header to one side and two to the other.
    start: = ctx.pos
    for ctx.pos < ctx.src.len
        if ctx.src[ctx.pos] == '\n'
            throw .invalid_line_break
        if ctx.src[ctx.pos] == '\r'
            if ctx.pos + 1 >= ctx.src.len
                break // maybe in the middle of a CRLF; do not decide yet
            if ctx.src[ctx.pos + 1] != '\n'
                throw .invalid_line_break
            line: = ctx.src.sub(start, ctx.pos - start)
            ctx.pos += 2
            return U8[]::line
        ctx.pos += 1
    throw .incomplete

priv fn parse_headers(ctx: Scan_ctx$@, arena: Arena$@): Headers!Http_error //<
    //< Parses the "Name: Value" lines up to the empty line
    $b: = headers(arena)
    for
        line: = read_line(ctx)!
        if line.len == 0
            break
        switch line.find_char(':')
        case .none
            throw .invalid_header
        case .some(colon)
            // Caution: **Check the name as it is, without trimming** (see is_token); the value is
            // trimmed by convention.
            name: = line.sub(0, colon)
            value: = line.sub_from(colon + 1).trim_spaces()
            if !is_token(name) || !is_field_value(value)
                throw .invalid_header
            b = b.add(name, value)
    return b.build()

priv struct Request_line //< parses the request line ("METHOD SP target SP HTTP-version")
    method: U8[]
    target: U8[]
    version: U8[]

priv fn parse_request_line(line: U8[]): Request_line!Http_error
    if sp1: = line.find_char(' ')
        rest: = line.sub_from(sp1 + 1)
        if sp2: = rest.find_char(' ')
            method: = line.sub(0, sp1)
            target: = rest.sub(0, sp2)
            version: = rest.sub_from(sp2 + 1)
            // Caution: Do not accept an empty method or an empty target (`" / HTTP/1.1"`, `"GET
            // HTTP/1.1"`); every later branch would run on an empty string.
            if !is_token(method) || !is_request_target(target)
                throw .invalid_request_line
            check_version(version)!
            return Request_line::{ .method = method, .target = target, .version = version }
    throw .invalid_request_line

priv struct Status_line //< an arena-owned status line, stable while the receive buffer grows
    version: U8$[]
    status: I32
    reason: U8$[]

priv fn parse_status_line(line: U8[], arena: Arena$@): Status_line!Http_error
    if sp1: = line.find_char(' ')
        check_version(line.sub(0, sp1))!
        rest: = line.sub_from(sp1 + 1)
        $status_str: = rest
        $reason: U8[] = ""
        if sp2: = rest.find_char(' ')
            status_str = rest.sub(0, sp2)
            reason = rest.sub_from(sp2 + 1)
        // status-code is three digits; otherwise `I32::` truncates silently (`4294967496` becomes
        // 200).
        if status_str.len != 3 || !is_field_value(reason)
            throw .invalid_status_line
        status: = parse_digits(status_str) catch
            throw .invalid_status_line
        if !valid_status(I32::status)
            throw .invalid_status_line
        return Status_line::{ .version = arena.dup_str(line.sub(0, sp1)), .status = I32::status,
            .reason = arena.dup_str(reason) }
    throw .invalid_status_line

priv fn build_response($work: mem.Scratch, line: Status_line, head: Headers, body: U8[],
    consumed: Sz): Response$@ //<
        //< Shared by parse_response/read_response; the response keeps the arena it is built in
    arena: = work.arena
    resp: Response = ::{
        .own = work.keep(),
        .version = line.version,
        .status = line.status,
        .reason = line.reason,
        .headers = head,
        .body = arena.dup_str(body),
        .consumed = consumed,
    }
    return arena.create(resp)

priv struct Head_parts //< a message's head, read, and where its body starts
    //< A request and a response differ only in the first line and how the body's length follows
    //< from the head, so they share the scan.
    first_line: U8[] //< a view into the buffer; parse it before the buffer grows
    head: Headers
    head_end: Sz //< where the body starts in the buffer
    length: Sz? //< `Content-Length`'s, within the caller's limit; none where it is absent

priv fn response_body_len(h: Head_parts, status: I32): Sz!Http_error //<
    //< A response's body length: 0 for a status that has no body, else `Content-Length`'s
    //< Caution: **Do not read an absent length as 0**: the body then runs to the close, and an
    //< empty body returned as success silently drops it.
    if !may_carry_body(status)
        return 0
    if n: = h.length
        return n
    throw .unsupported_close_delimited

priv struct Request_head //< a request's head, read and checked, with its first line parsed
    parts: Head_parts
    line: Request_line

priv fn scan_request_head(src: U8[], max_body: Sz, arena: Arena$@): Request_head!Http_error //<
    //< Reads a request's head as `scan_head` does, and checks its first line and its `Host`
    //< **Both request readers go through this**, so `request_length` refuses what `parse_request`
    //< does.
    h: = scan_head(src, max_body, arena)!
    line: = parse_request_line(h.first_line)!
    check_host(h.head, line.version)!
    return Request_head::{ .parts = h, .line = line }

priv fn scan_head(src: U8[], max_body: Sz, arena: Arena$@): Head_parts!Http_error //<
    //< Reads the head at the start of src, and checks both limits
    //< **Every reader goes through this**, buffered or from a socket, so the limits hold alike. It
    //< throws incomplete until the head's empty line arrives, or `head_too_large` past the limit.
    $ctx: = Scan_ctx::{ .src = src, .pos = 0 }
    first_line: = read_line(ctx@) catch e
        throw e.past_head_limit(src)
    head: = parse_headers(ctx@, arena) catch e
        throw e.past_head_limit(src)
    if ctx.pos > MAX_HEAD_BYTES
        throw .head_too_large
    length: = get_content_length(head)!
    if n: = length
        if n > max_body
            throw .body_too_large
    return Head_parts::{ .first_line = first_line, .head = head, .head_end = ctx.pos,
        .length = length }

impl Http_error
    priv fn past_head_limit(r: Self, src: U8[]): Http_error //<
        //< The error to throw for a head still arriving: `head_too_large` once src passes the limit
        switch r
        case .incomplete
            if src.len > MAX_HEAD_BYTES
                return .head_too_large
        default {}
        return r

priv fn body_in(src: U8[], h: Head_parts, body_len: Sz): U8[]!Http_error //<
    //< The body that follows the head in src; it throws incomplete until all of it has arrived
    //< Caution: **Check the body's length.** All the headers can be present while the body is only
    //< partly there. A cut without the check returns a view that points outside the buffer.
    if src.len - h.head_end < body_len
        throw .incomplete
    return src.sub(h.head_end, body_len)

pub fn parse_request( //< the one request at the start of the buffer; fails if it is incomplete
    //< **A body over `max_body` fails as soon as the head says so**, before it arrives. A head
    //< over `MAX_HEAD_BYTES` fails as soon as that much has arrived without its end.
    src: U8[], //< what has arrived so far
    max_body: Sz, //< the largest body accepted (`DEFAULT_MAX_BODY_BYTES` when the caller has none)
    arena: Arena$@, //< where the parts go; null means an arena of the request's own and a `free()`
): Request$@!Http_error //< the request; fails with incomplete while more bytes are due
    $work: = mem.scratch(arena)
    at: = work.arena
    r: = scan_request_head(src, max_body, at)!
    body_len: = r.parts.length.unwrap_or(0)
    body: = body_in(src, r.parts, body_len)!
    return at
        .create(Request::{
        .own = work.keep(),
        .method = at.dup_str(r.line.method),
        .target = at.dup_str(r.line.target),
        .version = at.dup_str(r.line.version),
        .headers = r.parts.head,
        .body = at.dup_str(body),
        .consumed = r.parts.head_end + body_len,
    })

pub fn request_length( //< how many bytes the request at the start of the buffer takes in all
    //< **For a reader that waits for the body without parsing again**: once the head has arrived,
    //< the rest is a count. It fails as `parse_request` does on the head, `incomplete` included
    //< until the head's empty line arrives.
    src: U8[], //< what has arrived so far
    max_body: Sz, //< the largest body accepted, as `parse_request` takes it
    arena: Arena$@, //< where the head's parts go while it reads them; null reads them on the heap
): Sz!Http_error //< the head's length plus the body's
    work: = mem.scratch(arena)
    r: = scan_request_head(src, max_body, work.arena)!
    return r.parts.head_end + r.parts.length.unwrap_or(0)

pub fn parse_response( //< the one response at the start of the buffer; fails if it is incomplete
    //< The body limit is `DEFAULT_MAX_BODY_BYTES`; the head's is `MAX_HEAD_BYTES`.
    src: U8[], //< what has arrived so far
    arena: Arena$@, //< where the parts go; null means an arena of the response's own and a `free()`
): Response$@!Http_error //< the response; fails with incomplete while more bytes are due
    return response_in(src, mem.scratch(arena))

priv fn response_in(src: U8[], work: mem.Scratch): Response$@!Http_error //< parse_response's work
    h: = scan_head(src, DEFAULT_MAX_BODY_BYTES, work.arena)!
    status_line: = parse_status_line(h.first_line, work.arena)!
    body_len: = response_body_len(h, status_line.status)!
    body: = body_in(src, h, body_len)!
    return build_response(work, status_line, h.head, body, h.head_end + body_len)

// ---------------------------------------------------------
// Reading from a socket (reading until the header and the Content-Length body are all present)
// ---------------------------------------------------------

priv fn read_chunk_into(stream: net.Tcp_stream$@, b: Str_builder$@, chunk: U8$[], deadline_us: I64):
    Void!Http_error //<
        //< Appends up to chunk.len bytes read from stream to b, waiting no later than the deadline
        //< 0 bytes means the peer closed (`connection_closed`); the deadline passing is
        //< `timed_out`.
    left_ms: = (deadline_us - sys.mono_us()) / 1000I64
    if left_ms <= 0I64
        throw .io(.timed_out)
    n: = stream.read_for(chunk, I32::left_ms) catch e
        throw .io(e)
    if n == 0
        throw .connection_closed
    b.s(U8$[]::{ .ptr = chunk.ptr, .len = n })

priv const READ_CHUNK: Sz = 4096 //< how much one read from a connection takes

priv fn read_head(stream: net.Tcp_stream$@, b: Str_builder$@, arena: Arena$@, max_body: Sz,
    deadline_us: I64, chunk: U8$[]): Head_parts!Http_error //<
        //< Reads from stream to the head's empty line (or past `MAX_HEAD_BYTES`); reads the head
        //< Caution: **Copy the first line's fields before reading the body.** They view b, which a
        //< further read can move. **Look for the empty line only where it can newly be**, from
        //< three bytes before what the last read added. Searched from the start each time, a head
        //< that arrives a byte at a time costs its length squared.
    $from: Sz = 0
    for b.slice().sub_from(from).find_str("\r\n\r\n").is_none() && b.len <= MAX_HEAD_BYTES
        from = b.len - 3 if b.len > 3 else 0
        read_chunk_into(stream, b, chunk, deadline_us)!
    return scan_head(b.slice(), max_body, arena)

pub fn read_response( //< reads one whole response from a connection and splits it into its parts
    stream: net.Tcp_stream$@, //< the connection to read from, which blocks
    arena: Arena$@, //< where the parts go; null means an arena of the response's own and a `free()`
    max_body: Sz, //< the largest body accepted; a larger one is refused, not read
    timeout_ms: I32, //< how long the whole response can take to arrive; past it `.io(.timed_out)`
): Response$@!Http_error //< the response, held in `arena`; fails if the connection closes first
    return response_from(stream, mem.scratch(arena), max_body, timeout_ms)

priv fn response_from(stream: net.Tcp_stream$@, work: mem.Scratch, max_body: Sz, timeout_ms: I32):
    Response$@!Http_error //<
        //< read_response's work, every part in `work`'s arena
    deadline: = sys.deadline_after_ms(timeout_ms)
    $b: = Str_builder.new()
    chunk: U8[READ_CHUNK] = ::{}
    h: = read_head(stream, b@, work.arena, max_body, deadline, U8$[]::chunk)!
    status_line: = parse_status_line(h.first_line, work.arena)!
    body_len: = response_body_len(h, status_line.status)!
    for b.len - h.head_end < body_len
        read_chunk_into(stream, b@, U8$[]::chunk, deadline)!
    body: = b.slice().sub(h.head_end, body_len)
    return build_response(work, status_line, h.head, body, h.head_end + body_len)

// ---------------------------------------------------------
// Writing. **The builder refuses whatever the parser refuses** (is_token / is_field_value,
// `Transfer-Encoding`), and the length is the body's: the builder adds `Content-Length` itself.
// ---------------------------------------------------------
priv fn write_header_lines(b: Str_builder$@, head: Headers): Void!Http_error //<
    //< Writes each header as `name: value`, refusing one that would not read back as itself
    //< Caution: **Refuse a value with a space or a tab at either end** (RFC 9110 §5.5 has none).
    //< The reader trims it, so it would read back as another value.
    for h in head.each()
        if !is_token(h.name) || !is_field_value(h.value) ||
            h.value.trim_spaces().len != h.value.len
            throw .invalid_header
        b.s(h.name).s(": ").s(h.value).s("\r\n")

priv fn check_framing(head: Headers, length: Sz, names_length: Bool): Void!Http_error //<
    //< Refuses a head whose framing a reader would read otherwise than the bytes written
    //< A `Content-Length` given must name `length`, once. Where no length can be named
    //< (`names_length` false: 1xx, 204, 304), none can be given and `length` must be 0.
    //< Caution: **Refuse `Transfer-Encoding` here too**: with it, a reader ignores
    //< `Content-Length`.
    if !names_length && length > 0
        throw .length_mismatch
    $found: = false
    for h in head.each()
        if h.name.equals_ignore_case("Transfer-Encoding")
            throw .unsupported_transfer_encoding
        if h.name.equals_ignore_case("Content-Length")
            if found || !names_length || parse_digits(h.value)! != length
                throw .length_mismatch
            found = true

priv fn write_framed_head(b: Str_builder$@, head: Headers, length: Sz, names_length: Bool):
    Void!Http_error //<
        //< Writes the headers, the `Content-Length` they lack, and the empty line ending the head
        //< `check_framing` must have passed.
    write_header_lines(b, head)!
    if names_length && !head.has("Content-Length")
        b.s("Content-Length: \{length\}\r\n")
    b.s("\r\n")

priv const WRITTEN_VERSION: U8[] = "HTTP/1.1" //< the version every request written here names

pub fn format_request( //< builds one whole request as bytes: the first line, the headers, the body
    //< The buffer form of `write_request`, as `parse_response` is of `read_response`: for a sender
    //< that cannot block. **It refuses what a reader refuses**, since a request it wrote would come
    //< back as a 400. **On failure b is left as it was.**
    b: Str_builder$@, //< where the message is built
    method: U8[], //< the method, such as `GET`
    target: U8[], //< the target, including the query string
    head: Headers, //< the headers, `Host` among them once; `Content-Length` is added here
    body: U8[], //< the whole body
): Void!Http_error
    if !is_token(method) || !is_request_target(target)
        throw .invalid_request_line
    check_framing(head, body.len, true)!
    check_host(head, WRITTEN_VERSION)!
    start: = b.len
    b.s(method).s(" ").s(target).c(' ').s(WRITTEN_VERSION).s("\r\n")
    write_framed_head(b, head, body.len, true) catch e
        b.len = start // as in `write_response_head`
        throw e
    b.s(body)

pub fn write_request( //< sends one whole request: the first line, the headers and the body
    //< It refuses what `format_request` refuses, before anything is written.
    stream: net.Tcp_stream$@, //< the connection to write to
    method: U8[], //< the method, such as `GET`
    target: U8[], //< the target, including the query string
    head: Headers, //< the headers, `Host` among them once
    body: U8[]): Void!Http_error
    $b: = Str_builder.new()
    format_request(b@, method, target, head, body)!
    // Caution: write can stop partway and silently truncate the message. Use write_all (see the
    // note in std/net.kspl).
    stream.write_all(b.slice()) catch e
        throw .io(e)

pub fn reason_phrase( //< the standard phrase for a status number, so the two cannot disagree
    //< RFC 9110's "reason-phrase"; none for a number it does not know. The builders below write it
    //< from the number, so no caller passes the number and the phrase as a pair (which could say
    //< `404 Bad Request`).
    //< Caution: **Do not fill in `"unknown"`**: a phrase from nowhere stays in the receiver's log.
    status: I32, //< the status number
): U8[]? //< the phrase, a fixed string that needs no freeing
    switch status
    case 200
        return .some("OK")
    case 201
        return .some("Created")
    case 204
        return .some("No Content")
    case 206
        return .some("Partial Content")
    case 301
        return .some("Moved Permanently")
    case 302
        return .some("Found")
    case 304
        return .some("Not Modified")
    case 400
        return .some("Bad Request")
    case 401
        return .some("Unauthorized")
    case 403
        return .some("Forbidden")
    case 404
        return .some("Not Found")
    case 405
        return .some("Method Not Allowed")
    case 408
        return .some("Request Timeout")
    case 409
        return .some("Conflict")
    case 411
        return .some("Length Required")
    case 413
        // RFC 9110's name (RFC 7231's is "Payload Too Large").
        return .some("Content Too Large")
    case 414
        return .some("URI Too Long")
    case 415
        return .some("Unsupported Media Type")
    case 429
        return .some("Too Many Requests")
    case 431
        return .some("Request Header Fields Too Large")
    case 500
        return .some("Internal Server Error")
    case 501
        return .some("Not Implemented")
    case 503
        return .some("Service Unavailable")
    case 505
        return .some("HTTP Version Not Supported")
    default {}
    return .none

pub fn format_response( //< builds one whole response as bytes, for the caller to send
    //< Appends the status line, the headers, an empty line and the body to b, **leaving the bytes
    //< to the caller**. A non-blocking socket cannot always send it all at once (see write_all in
    //< std/net.kspl). So the sender must remember how far it got and continue once writable.
    //< **The length is the body's**: one given that differs is refused. So is any body or length
    //< for 1xx, 204 and 304, whose head names none. The answer to a HEAD is
    //< `format_response_to_head`. **On failure b is left as it was.**
    b: Str_builder$@, //< where the message is built
    status: I32, //< the status number; its phrase is `reason_phrase`'s
    head: Headers, //< the headers; `Content-Length` is added here
    body: U8[], //< the whole body
): Void!Http_error
    write_response_head(b, status, head, body.len)!
    b.s(body)

pub fn format_response_to_head( //< builds the answer to a HEAD request: a head with no body
    //< The head is the one a GET would get: its `Content-Length` names `length`, the length of the
    //< body a GET would carry, which is not sent (RFC 9110 §9.3.2). For 1xx, 204 and 304 no length
    //< is named, and `length` must be 0. **On failure b is left as it was.**
    b: Str_builder$@, //< where the head is built
    status: I32, //< the status number; its phrase is `reason_phrase`'s
    head: Headers, //< the headers; `Content-Length` is added here
    length: Sz, //< the length of the body a GET would carry
): Void!Http_error
    write_response_head(b, status, head, length)!

priv fn write_response_head(b: Str_builder$@, status: I32, head: Headers, length: Sz):
    Void!Http_error //<
        //< The head naming `length`, or nothing at all where it is refused
        //< Caution: **Take back what was written on a failure.** A caller that queues answers in b
        //< would send the half head. The next answer would then read as its continuation.
    names_length: = may_carry_body(status)
    check_framing(head, length, names_length)!
    start: = b.len
    write_status_line(b, status)! // refuses before it writes
    write_framed_head(b, head, length, names_length) catch e
        b.len = start
        throw e

priv fn write_status_line(b: Str_builder$@, status: I32): Void!Http_error //<
    //< Writes `HTTP/1.1 <status> <phrase>` and its CRLF, the phrase from `reason_phrase`
    if !valid_status(status)
        throw .invalid_status_line
    // RFC 9110 lets the phrase be empty, so a number with none is written with none.
    b.s("HTTP/1.1 \{status\} ").s(reason_phrase(status).unwrap_or("")).s("\r\n")

pub fn format_response_head( //< builds only a response's head, for a body sent piece by piece
    //< Caution: **Do not add `Content-Length`.** That is why this function exists: a streamed
    //< body's length is not known in advance, and `format_response` adds it.
    //< **Always include `Connection: close`** (it fails without it), and a status that has a body.
    //< On failure b is left as it was.
    b: Str_builder$@, //< where the head is built
    status: I32, //< the status number; its phrase is `reason_phrase`'s
    head: Headers, //< the headers; `Connection: close` must be among them
): Void!Http_error
    if head.has("Transfer-Encoding")
        throw .unsupported_transfer_encoding
    if !may_carry_body(status) || head.has("Content-Length")
        throw .length_mismatch
    if !connection_lists(head, "close")
        throw .invalid_header
    start: = b.len
    write_status_line(b, status)!
    write_header_lines(b, head) catch e
        b.len = start // as in `write_response_head`
        throw e
    b.s("\r\n")

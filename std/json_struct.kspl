//< Round-trips a whole struct to and from JSON by walking `std/reflect`'s field table
//<
//< **The key names are written nowhere**: a key is the field's own name (the grounds are in
//< "a table-returning trait" in `../docs/DESIGN-programming-language.md`).

// ==========================================
// **Kept apart from `std/json`**, which is JSON itself, so a client that never round-trips does
// not import `std/reflect`.
// ==========================================
import "std/checked_int"
import "std/ds" { List }
import "std/json" { Json_builder, Value, Object_builder, Array_builder, Json_error,
    MAX_NESTING_DEPTH }
import "std/mem" + { Arena }
import "std/reflect"

priv const LIST_PTR_OFF: Sz = offsetof(List<|U8|>, ptr) //< the positions inside a `List<|T|>`
    //<
    //< **They do not depend on T**, so the ones for `U8` serve for all. The check is
    //< `tests/reflect_test.kspl`'s "reflect: a container's ptr position does not depend on the
    //< element's type", and the same for `len` (`make debug`).
priv const LIST_LEN_OFF: Sz = offsetof(List<|U8|>, len)
priv const LIST_CAP_OFF: Sz = offsetof(List<|U8|>, cap)
priv const LIST_ARENA_OFF: Sz = offsetof(List<|U8|>, arena)

priv fn element_field($f: reflect.Field_info): reflect.Field_info //<
    //< a container's value descriptor
    f.kind = f.extra.elem
    f.extra.width = f.extra.elem_size
    return f

pub fn from_struct<|T: reflect.Reflectable|>( //< copies a reflectable value into a JSON object
    //<
    //< `v` is a `T@`: passed by value, the field offsets would point into a temporary.
    //< **A `U64` past the largest `I64` is refused** (`field_type`), not written as a negative
    //< number: `I64` is the widest integer a `Value` holds.
    v: T@, //< the value to read; pointed at, not copied
    b: Json_builder$@, //< holds the object being built
): Value!Json_error //< the object
    return obj_of(U8@::v, v.fields(), b, 0)!

priv fn obj_of(base: U8@, tbl: reflect.Field_info[], b: Json_builder$@, depth: Sz):
    Value!Json_error //<
        //< Walks one table and builds one object
        //<
        //< **Nesting is handled by calling itself**; a nested struct arrives as bytes and a table,
        //< not as a type.
    if depth > MAX_NESTING_DEPTH
        throw .too_deep
    $ob: Object_builder = b.obj()
    for f in tbl
        $at: = base + f.offset
        $field: = f
        switch f.kind
        case .opt_field
            // **`.none` writes no key**, or "absent" would have two forms (see the file header).
            tag: = I32@::at
            if tag$ != f.extra.some_tag
                continue
            at += f.extra.payload_offset
            field = element_field(f)
        default {}
        ob = ob.set(f.name, value_of(at, field, b, depth + 1)!)
    return ob.build()

priv fn value_of(at: U8@, f: reflect.Field_info, b: Json_builder$@, depth: Sz): Value!Json_error //<
    //< Reads a field or container value through the same descriptor
    switch f.kind
    case .int_field
        return b.int_val(reflect.load_int(at, f.extra.width))
    case .uint_field
        // Caution: **Read an unsigned value through its own function**, or a `U32`'s `0xFFFFFFFF`
        // is written as `-1` (`../std/reflect.kspl`'s `load_uint`).
        got: = reflect.load_uint(at, f.extra.width)
        // **A `U64` past the largest `I64` comes back negative**, and would be written so.
        if !reflect.fits_int(f.kind, f.extra.width, got)
            throw .field_type(f.name)
        return b.int_val(got)
    case .float_field
        return b.float_val(reflect.load_float(at, f.extra.width))
    case .bool_field
        p: = Bool@::at
        return b.bool_val(p$)
    case .str_field
        p: U8[]@ = (U8[]@)::at
        return b.str_val(p$)
    case .struct_field
        return obj_of(at, f.nested, b, depth)!
    case .list_field
        if depth > MAX_NESTING_DEPTH
            throw .too_deep
        ptr_slot: Void@@ = (Void@@)::(at + LIST_PTR_OFF)
        len_slot: = Sz@::(at + LIST_LEN_OFF)
        elems: = U8@::ptr_slot$
        $ar: Array_builder = b.arr()
        elem: = element_field(f)
        for $i: Sz = 0; i < len_slot$; i += 1
            cell: = elems + i * f.extra.elem_size
            ar = ar.push(value_of(cell, elem, b, depth + 1)!)
        return ar.build()
    default {}
    return .null_val

pub fn into_struct<|T: reflect.Reflectable|>( //< copies a JSON object into a reflectable value
    //<
    //< **A field whose key is missing or of another kind is refused** (why is at `Json_error`). So
    //< is an integer the field cannot hold: 70000 into a `U16`. With `null`, free each string it
    //< wrote with `dealloc` and each list with `free()`. A refusal leaves those written before it.
    //< A list it stopped in holds the elements up to the refused one, zero where unwritten.
    //< Caution: **Copy the names into `arena`.** The names inside `v` point into the parse's arena.
    //< Freeing that first leaves the written value pointing at freed memory.
    v: Value, //< the object to read from
    out: T$@, //< the value to write into, field by field
    arena: Arena$@, //< where strings and lists go; null means the heap, freed as above
): Void!Json_error
    fill_from(U8$@::out, out.fields(), v, arena, 0)!

priv fn fill_from(base: U8$@, tbl: reflect.Field_info[], v: Value, arena: Arena$@, depth: Sz):
    Void!Json_error //<
        //< Walks one table and writes from one object; it calls itself for nesting.
    if depth > MAX_NESTING_DEPTH
        throw .too_deep
    switch v
    case .obj_val {}
    default
        throw .field_type("<root>")
    for f in tbl
        $at: = base + f.offset
        $field: = f
        // Only an absent optional becomes `.none`; an explicit null is refused, leaving the tag
        // untouched.
        $got: = Value.null_val
        switch v.find(f.name)
        case .some(member)
            got = member
        case .none
            switch f.kind
            case .opt_field
                tag: = I32$@::at
                tag$ = f.extra.none_tag
                continue
            default
                throw .missing_field(f.name)
        switch got
        case .null_val
            throw .field_type(f.name)
        default {}
        switch f.kind
        case .opt_field
            tag: = I32$@::at
            tag$ = f.extra.some_tag
            at += f.extra.payload_offset
            field = element_field(f)
        default {}
        fill_value(at, field, got, arena, depth + 1)!

priv fn fill_value(at: U8$@, f: reflect.Field_info, got: Value, arena: Arena$@, depth: Sz):
    Void!Json_error
    // **Signed and unsigned share one path** (`../std/reflect.kspl`'s `store_int`).
    switch f.kind
    case .int_field, .uint_field
        switch got
        case .int_val(n)
            // Caution: **Refuse a value the field cannot hold, never narrow it**: narrowed, 70000
            // reads as 4464 in a `U16`, and -1 as 255 in a `U8`.
            if !reflect.fits_int(f.kind, f.extra.width, n)
                throw .field_type(f.name)
            reflect.store_int(at, f.extra.width, n)
        default
            throw .field_type(f.name)
    case .float_field
        // Caution: Accept the integer variant too, or success depends on the sender's decimal
        // point.
        switch got
        case .float_val(fv)
            reflect.store_float(at, f.extra.width, fv)
        case .int_val(iv)
            reflect.store_float(at, f.extra.width, F64::iv)
        default
            throw .field_type(f.name)
    case .bool_field
        p: = Bool$@::at
        switch got
        case .bool_val(bv)
            p$ = bv
        default
            throw .field_type(f.name)
    case .str_field
        p: U8[]$@ = (U8[]$@)::at
        switch got
        case .str_val(sv)
            p$ = arena.dup_str(sv)
        default
            throw .field_type(f.name)
    case .list_field
        switch got
        case .array_val {}
        default
            throw .field_type(f.name)
        if depth > MAX_NESTING_DEPTH
            throw .too_deep
        $items: = got.arr_list(arena)
        defer items.free() // only work: the elements are copied into `room`
        count: = items.len
        // Check before allocating: a wrapped size would leave less room than the writes need.
        bytes: = count.checked_mul(f.extra.elem_size) catch
            throw .too_large
        room: = arena.alloc(bytes) if count > 0 else null
        // Caution: **Zero the room, and count an element only once its filling starts.** A refusal
        // leaves the list to the caller's cleanup, which frees each counted element. Counted
        // garbage is freed as a pointer, and an element left out leaks what it had written.
        mem.zero(room, bytes)
        ptr_slot: Void$@$@ = (Void$@$@)::(at + LIST_PTR_OFF)
        len_slot: = Sz$@::(at + LIST_LEN_OFF)
        cap_slot: = Sz$@::(at + LIST_CAP_OFF)
        arena_slot: Arena$@$@ = (Arena$@$@)::(at + LIST_ARENA_OFF)
        ptr_slot$ = room
        len_slot$ = 0
        cap_slot$ = count
        arena_slot$ = arena
        elem: = element_field(f)
        for e in items
            cell: = (U8$@::room) + len_slot$ * f.extra.elem_size
            len_slot$ += 1
            fill_value(cell, elem, e, arena, depth + 1)!
    case .struct_field
        switch got
        case .obj_val {}
        default
            throw .field_type(f.name)
        fill_from(at, f.nested, got, arena, depth)!
    default
        throw .field_type(f.name)

//< Tests of the SQLite client, against an in-memory database (`":memory:"`)
import "ksbind/db"
import "std/fs"
import "std/mem" { Arena }
import "std/reflect"
import "std/str" // `equals`
import "std/verdict"

fn test_db_crud_roundtrip()
    verdict.start("[Db] the whole prepare/bind/step/column flow test...")

    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")

    // **A path holding a NUL is refused, not cut at it.** C would read this one as `:memory:`.
    memory: = ":memory:"
    $nul_path: U8[10] = ::{}
    for i in Range.asc(memory.len)
        nul_path[i] = memory[i]
    nul_path[9] = 'x'
    $cut: = false
    _z: = db.Db.open(U8[]::nul_path) catch e
        switch e
        case .open_failed(_code, _said)
            cut = true
        default {}
        fallback null
    assert(cut, "a path holding a NUL is refused rather than cut at the NUL")

    conn.exec("CREATE TABLE person (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)")
        catch panic("create table should not fail")

    ins: = conn.prepare("INSERT INTO person (name, age) VALUES (?, ?)")
        catch panic("prepare insert should not fail")
    ins.bind_text(1, "Alice") catch panic("bind_text failed")
    ins.bind_i64(2, 30) catch panic("bind_i64 failed")
    ins.step() catch panic("insert step failed")
    ins.free()
    rowid: = conn.last_insert_rowid()
    assert(rowid == 1, "rowid should be 1 for the first insert")

    ins2: = conn.prepare("INSERT INTO person (name, age) VALUES (?, ?)")
        catch panic("prepare insert2 should not fail")
    ins2.bind_text(1, "Bob") catch panic("bind_text failed")
    ins2.bind_i64(2, 25) catch panic("bind_i64 failed")
    ins2.step() catch panic("insert2 step failed")
    ins2.free()

    // A NULL bound is read back as a NULL, not as 0 or empty text.
    ins3: = conn.prepare("INSERT INTO person (name, age) VALUES (?, ?)")
        catch panic("prepare insert3 should not fail")
    ins3.bind_text(1, "Carol") catch panic("bind_text failed")
    ins3.bind_null(2) catch panic("bind_null failed")
    ins3.step() catch panic("insert3 step failed")
    ins3.free()
    nul: = conn.prepare("SELECT age FROM person WHERE name = 'Carol'")
        catch panic("prepare select null should not fail")
    nul_row: = nul.step() catch panic("select null step failed")
    $saw_null: = false
    switch nul_row
    case .row
        switch nul.column_kind(0)
        case .null_value
            saw_null = true
        default {}
    default {}
    nul.free()
    assert(saw_null, "a bound NULL reads back as null_value")

    sel: =
        conn.prepare("SELECT name, age FROM person WHERE age IS NOT NULL ORDER BY age ASC")
        catch panic("prepare select should not fail")
    $count: Sz = 0
    $buf: U8[64] = ::{}
    for
        r: = sel.step() catch panic("select step failed")
        switch r
        case .row
            n: = sel.column_text(0, U8$[]::buf) catch panic("column_text failed")
            name: = U8$[]::{ .ptr = buf@, .len = n }
            age: = sel.column_i64(1)
            if count == 0
                assert(name.equals("Bob"), "first row (by age asc) should be Bob")
                assert(age == 25, "Bob's age should be 25")
            else
                assert(name.equals("Alice"), "second row should be Alice")
                assert(age == 30, "Alice's age should be 30")
            count += 1
        case .done
            break
    sel.free()
    assert(count == 2, "expected 2 rows")

    conn.free()
    verdict.pass("The whole CRUD flow works as expected.")

// ==========================================
// A round trip through std/reflect's field table (bind_row / read_row).
// ==========================================
priv struct Person
    name: U8[]
    age: I64
    height: F64
    active: Bool

impl Person: reflect.Reflectable {} //< the table is the declaration's, made by the compiler

fn test_db_row_roundtrip()
    verdict.start("[Db] walking the table to round-trip one row test...")
    arena: = Arena.new(8 * 1024)
    defer arena.free()

    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")
    conn.exec("CREATE TABLE p (name TEXT, age INTEGER, height REAL, active INTEGER)")
        catch panic("create table should not fail")

    // It binds by named parameters; no position is written.
    ins: =
        conn
        .prepare("INSERT INTO p (name, age, height, active) VALUES (:name, :age, :height, :active)")
        catch panic("prepare insert should not fail")
    src: Person = ::{ .name = "Alice", .age = 30, .height = 1.62, .active = true }
    ins.bind_row(src@) catch panic("bind_row failed")
    ins.step() catch panic("step insert failed")
    ins.free()

    // **The columns are in a different order from the declaration**; they are matched by name.
    sel: = conn.prepare("SELECT active, height, age, name FROM p")
        catch panic("prepare select should not fail")
    sel.step() catch panic("step select failed")
    $back: Person = ::{}
    sel.read_row(back@, arena) catch panic("read_row failed")
    assert(back.name.equals("Alice"), "a string round-trips")
    assert(back.age == 30I64, "an integer round-trips")
    assert(back.height > 1.61 && back.height < 1.63, "a fraction round-trips")
    assert(back.active, "a boolean round-trips")

    // If the table has no column for a field, it is refused with the field's name (not filled in
    // with a default).
    thin: = conn.prepare("SELECT name, age FROM p")
        catch panic("prepare thin select should not fail")
    thin.step() catch panic("step thin select failed")
    $partial: Person = ::{}
    $missing: U8[] = ""
    thin.read_row(partial@, arena) catch e
        switch e
        case .missing_column(which)
            missing = which
        default
            panic("expected missing_column")
    assert(missing.equals("height"), "a dropped column is named")
    thin.free()
    sel.free()
    conn.free()
    verdict
        .pass("It round-trips regardless of the columns' order, and refuses a dropped column by \
            name.")

fn test_db_one_statement_at_a_time()
    verdict.start("[Db] SQL holding a second statement being refused, not cut test...")
    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")

    // Run, the first would make `t` and the second would silently never make `u`.
    $refused: = false
    conn.exec("CREATE TABLE t (n INTEGER); CREATE TABLE u (n INTEGER)") catch e
        switch e
        case .several_statements
            refused = true
        default {}
    assert(refused, "SQL holding two statements is refused as several_statements")
    $none_ran: = false
    _t: = conn.prepare("SELECT n FROM t") catch e
        switch e
        case .prepare_failed(_code, _said)
            none_ran = true
        default {}
        fallback null
    assert(none_ran, "a refused SQL runs none of its statements")

    // What follows the one statement can be blank: spaces, semicolons and comments.
    conn.exec("CREATE TABLE v (n INTEGER);  -- the table\n/* done */ ;\n")
        catch panic("a statement followed only by semicolons and comments should run")
    conn.exec("INSERT INTO v (n) VALUES (1)") catch panic("the table it made should exist")

    // SQLite stops reading at a NUL, so the statement after one would be dropped unseen.
    $nul_refused: = false
    conn.exec("CREATE TABLE w (n INTEGER)\0; CREATE TABLE x (n INTEGER)") catch e
        switch e
        case .prepare_failed(code, _said)
            nul_refused = code == 1
        default {}
    assert(nul_refused, "SQL holding a NUL is refused as SQLITE_ERROR, not cut at it")
    $w_absent: = false
    _w: = conn.prepare("SELECT n FROM w") catch e
        switch e
        case .prepare_failed(_code, _said)
            w_absent = true
        default {}
        fallback null
    assert(w_absent, "SQL refused for a NUL runs nothing before it either")
    conn.free()
    verdict
        .pass("A second statement or a NUL is refused before anything runs, and a blank tail is not \
            one.")

// ==========================================
// An integer column read into a narrower field, and a field too wide for SQLite's integer.
// ==========================================
priv struct Bounded //< a field of each kind whose range is narrower than SQLite's integer
    small: I32
    byte: U8
    gap: Sz

impl Bounded: reflect.Reflectable {}

priv struct Unsigned_wide //< a field wider than SQLite's integer holds
    big: U64

impl Unsigned_wide: reflect.Reflectable {}

priv fn refused_field(conn: db.Db$@, select: U8[], arena: Arena$@): U8[] //<
    //< Reads the one row `select` gives into a `Bounded`, and names the field refused ("" for none)
    sel: = conn.prepare(select) catch panic("the select should prepare")
    defer sel.free()
    sel.step() catch panic("the select should step")
    $back: Bounded = ::{}
    $which: U8[] = ""
    sel.read_row(back@, arena) catch e
        switch e
        case .column_type(name)
            which = name
        default
            panic("expected column_type")
    return which

fn test_db_row_out_of_range()
    verdict.start("[Db] an integer a field cannot hold being refused, not cut test...")
    arena: = Arena.new(8 * 1024)
    defer arena.free()
    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")

    // Each field's edges read back as they are, a negative `Sz` among them.
    edges: = "SELECT -2147483648 AS small, 255 AS byte, -1 AS gap"
    sel: = conn.prepare(edges) catch panic("the select should prepare")
    sel.step() catch panic("the select should step")
    $back: Bounded = ::{}
    sel.read_row(back@, arena) catch panic("values the fields hold should be read")
    sel.free()
    assert(back.small == -2147483648 && back.byte == 255 && back.gap == -1,
        "each field's edge is read unchanged")

    // Cut to the field's width, these would read as 705032704, 44 and 255.
    too_big: = refused_field(conn, "SELECT 5000000000 AS small, 0 AS byte, 0 AS gap", arena)
    assert(too_big.equals("small"), "a value past an I32 is refused by the field's name")
    too_wide: = refused_field(conn, "SELECT 0 AS small, 300 AS byte, 0 AS gap", arena)
    assert(too_wide.equals("byte"), "a value past a U8 is refused by the field's name")
    negative: = refused_field(conn, "SELECT 0 AS small, -1 AS byte, 0 AS gap", arena)
    assert(negative.equals("byte"), "a negative value into a U8 is refused by the field's name")

    // **Writing refuses too** a `U64` past SQLite's signed 64-bit integer, which would be stored as
    // a negative number.
    conn.exec("CREATE TABLE w (big INTEGER)") catch panic("create table should not fail")
    ins: = conn.prepare("INSERT INTO w (big) VALUES (:big)")
        catch panic("prepare insert should not fail")
    huge: Unsigned_wide = ::{ .big = 0xFFFFFFFFFFFFFFFF }
    $unwritten: U8[] = ""
    ins.bind_row(huge@) catch e
        switch e
        case .column_type(name)
            unwritten = name
        default
            panic("expected column_type")
    assert(unwritten.equals("big"), "a U64 past I64's range is refused when bound, by its name")
    ins.free()
    conn.free()
    verdict
        .pass("A value a field cannot hold is refused by the field's name, on reading and writing.")

// ==========================================
// SQLite's result code, carried by the error, tells one cause from another.
// ==========================================
priv fn code_of(e: db.Db_error): I32 //< the SQLite code an error carries, or -1 for one with none
    switch e
    case .open_failed(code, _said)
        return code
    case .prepare_failed(code, _said)
        return code
    case .bind_failed(code, _said)
        return code
    case .step_failed(code, _said)
        return code
    case .column_failed(code, _said)
        return code
    default
        return -1

priv fn exec_code(conn: db.Db$@, sql: U8[]): I32 //< the code `exec` fails with, or 0 if it ran
    conn.exec(sql) catch e
        return code_of(e)
    return 0

priv const BUSY_PATH: U8[] = "out/ksbind_busy_test.db" //< the file two connections share

fn test_db_error_codes()
    verdict.start("[Db] an error carrying SQLite's result code test...")
    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")
    conn.exec("CREATE TABLE u (n INTEGER UNIQUE)") catch panic("create table should not fail")
    conn.exec("INSERT INTO u (n) VALUES (1)") catch panic("the first insert should run")
    assert(exec_code(conn, "INSERT INTO u (n) VALUES (1)") == 19,
        "a broken UNIQUE constraint carries SQLITE_CONSTRAINT (19)")
    assert(exec_code(conn, "SELEC 1") == 1, "a syntax error carries SQLITE_ERROR (1)")
    conn.free()

    // **A busy database is told from a broken constraint**: a second connection meets the lock.
    fs.mkdir_all("out") catch panic("the folder for the shared file should be made")
    fs.remove_path(BUSY_PATH) catch {}
    holder: = db.Db.open(BUSY_PATH) catch panic("the shared file should open")
    holder.exec("CREATE TABLE t (n INTEGER)") catch panic("create table should not fail")
    holder.exec("BEGIN EXCLUSIVE") catch panic("the exclusive lock should be taken")
    other: = db.Db.open(BUSY_PATH) catch panic("a second connection should open")
    busy: = exec_code(other, "INSERT INTO t (n) VALUES (1)")
    other.free()
    holder.free()
    fs.remove_path(BUSY_PATH) catch {}
    assert(busy == 5, "a write against another connection's lock carries SQLITE_BUSY (5)")
    verdict.pass("A broken constraint, a syntax error and a busy database carry their own codes.")

// ==========================================
// SQLite's text, carried by the error, names what the code cannot.
// ==========================================
priv fn said_of(e: db.Db_error): U8[] //< the text an error carries, empty for one with none
    switch e
    case .open_failed(_code, said)
        return said
    case .prepare_failed(_code, said)
        return said
    case .bind_failed(_code, said)
        return said
    case .step_failed(_code, said)
        return said
    case .column_failed(_code, said)
        return said
    default
        return ""

fn test_db_error_says_what_sqlite_said()
    verdict.start("[Db] an error carrying SQLite's own text test...")
    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")
    $mistyped: U8[] = ""
    _p: = conn.prepare("SELECT name FROM users") catch e
        mistyped = said_of(e)
        fallback null
    assert(mistyped.equals("no such table: users"), "a mistyped table is named by its name")
    $syntax: U8[] = ""
    conn.exec("SELEC 1") catch e
        syntax = said_of(e)
    assert(syntax.equals("near \"SELEC\": syntax error"), "a syntax error names where it is")
    // **A step's text outlives `exec`'s statement**, which is freed before the error arrives.
    conn.exec("CREATE TABLE u (n INTEGER UNIQUE)") catch panic("create table should not fail")
    conn.exec("INSERT INTO u (n) VALUES (1)") catch panic("the first insert should run")
    $broken: U8[] = ""
    conn.exec("INSERT INTO u (n) VALUES (1)") catch e
        broken = said_of(e)
    assert(broken.equals("UNIQUE constraint failed: u.n"),
        "a broken constraint through exec names the column")
    // A statement holds the text of its own failure.
    ins: = conn.prepare("INSERT INTO u (n) VALUES (:n)") catch panic("the insert should prepare")
    $unbound: U8[] = ""
    ins.bind_i64(2, 1) catch e
        unbound = said_of(e)
    assert(unbound.equals("column index out of range"), "a bind out of range says so")
    ins.bind_i64(1, 1) catch panic("the value should bind")
    $stepped: U8[] = ""
    ins.step() catch e
        stepped = said_of(e)
        fallback .done
    assert(stepped.equals("UNIQUE constraint failed: u.n"), "a step's failure names the column")
    ins.free()
    conn.free()
    // **A failed open says SQLite's text for its code**: no connection is left to say more.
    $unopened: U8[] = ""
    _o: = db.Db.open("out/tmp/ksbind_no_such_folder/x/t.db") catch e
        unopened = said_of(e)
        fallback null
    assert(unopened.equals("unable to open database file"), "a failed open says why")
    verdict
        .pass("A mistyped table, a syntax error, a constraint and a failed open say SQLite's text.")

fn test_db_exec_refuses_rows()
    verdict.start("[Db] exec refusing SQL that returns rows, before it runs test...")
    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")
    conn.exec("CREATE TABLE u (n INTEGER)") catch panic("create table should not fail")
    for sql in U8[][]::{ "SELECT 1", "SELECT n FROM u", "INSERT INTO u (n) VALUES (5) RETURNING n" }
        $refused: = false
        conn.exec(sql) catch e
            switch e
            case .returns_rows
                refused = true
            default {}
        assert(refused, "exec refuses SQL that returns rows, an empty SELECT included")
    // **Refused before it runs**: the `RETURNING` insert made no row.
    count: = conn.prepare("SELECT count(*) FROM u") catch panic("the count should prepare")
    count.step() catch panic("the count should step")
    assert(count.column_i64(0) == 0I64, "SQL refused for its rows has not run")
    count.free()
    conn.free()
    verdict.pass("exec refuses a SELECT and a RETURNING before either runs.")

priv const DB_BASE: U8[] = "out/tmp/ksbind_db" //< where a test that needs a database file makes it

fn test_db_free_with_a_statement_open()
    verdict.start("[Db] freeing the database while a statement is still open test...")
    arena: = Arena.new(4 * 1024)
    defer arena.free()
    dir: = fs.mkdir_unique(DB_BASE, "db_", arena) catch panic("the scratch folder should be made")
    path: = fs.join(dir, "t.db", arena)
    // **In WAL mode the `-wal` file stands while a connection is open.** The last one to close
    // removes it, so the file tells whether the connection closed.
    wal: = arena.text().s(path).s("-wal").take()
    conn: = db.Db.open(path) catch panic("a database file should open")
    // The pragma answers with the mode it set, a row, so it is stepped rather than `exec`ed.
    mode: = conn.prepare("PRAGMA journal_mode=WAL") catch panic("the pragma should prepare")
    mode.step() catch panic("WAL mode should be set")
    mode.free()
    conn.exec("CREATE TABLE t (n INTEGER)") catch panic("create table should not fail")
    conn.exec("INSERT INTO t (n) VALUES (7)") catch panic("insert should not fail")
    stmt: = conn.prepare("SELECT n FROM t") catch panic("prepare should not fail")
    conn.free()
    // **The statement works until it is freed**, so the frees can come in either order.
    row: = stmt.step() catch panic("a statement whose database was freed should still step")
    assert(row == db.Step_result.row && stmt.column_i64(0) == 7I64,
        "a statement whose database was freed should still read its row")
    assert(fs.exists(wal), "the connection should stay open while its statement is")
    stmt.free()
    // Caution: **Check that it closed**: left open, the connection keeps its file and its lock for
    // as long as the process runs.
    assert(!fs.exists(wal), "freeing the last statement should close the connection")
    fs.remove_path(path) catch {}
    fs.remove_path(dir) catch {}
    verdict.pass("A database freed with a statement open closes once that statement is freed.")

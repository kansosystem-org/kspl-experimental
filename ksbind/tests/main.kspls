//< ksbind's tests, run as a program of their own (`make test` in this package's folder)
//<
//< **This is the only way to run ksbind's tests.** They link OpenSSL and SQLite, so `make debug`,
//< which every environment runs, leaves them out; `all.kspls` holds them, and this file only gives
//< them a `main`.
import "ksbind/tests/all"
import "std/io"

fn main()
    // Flush line by line, so a run that crashes shows how far it got.
    io.set_line_buffered()
    all.run_ksbind()

//< Tests of the SQLite client, against an in-memory database (`":memory:"`)
import "ksbind/db"
import "std/mem" { Arena }
import "std/reflect"
import "std/str" // `equals`
import "std/verdict"

fn test_db_crud_roundtrip()
    verdict.start("[Db] the whole prepare/bind/step/column flow test...")

    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")

    // **A path holding a NUL is refused, not cut at it.** C would read this one as `:memory:`.
    memory: = ":memory:"
    $nul_path: U8[10] = ::{}
    for i in Range.asc(memory.len)
        nul_path[i] = memory[i]
    nul_path[9] = 'x'
    $cut: = false
    _z: = db.Db.open(U8[]::nul_path) catch e
        switch e
        case .open_failed
            cut = true
        default {}
        fallback null
    assert(cut, "a path holding a NUL is refused rather than cut at the NUL")

    conn.exec("CREATE TABLE person (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)")
        catch panic("create table should not fail")

    ins: = conn.prepare("INSERT INTO person (name, age) VALUES (?, ?)")
        catch panic("prepare insert should not fail")
    ins.bind_text(1, "Alice") catch panic("bind_text failed")
    ins.bind_i64(2, 30) catch panic("bind_i64 failed")
    ins.step() catch panic("insert step failed")
    ins.free()
    rowid: = conn.last_insert_rowid()
    assert(rowid == 1, "rowid should be 1 for the first insert")

    ins2: = conn.prepare("INSERT INTO person (name, age) VALUES (?, ?)")
        catch panic("prepare insert2 should not fail")
    ins2.bind_text(1, "Bob") catch panic("bind_text failed")
    ins2.bind_i64(2, 25) catch panic("bind_i64 failed")
    ins2.step() catch panic("insert2 step failed")
    ins2.free()

    // A NULL bound is read back as a NULL, not as 0 or empty text.
    ins3: = conn.prepare("INSERT INTO person (name, age) VALUES (?, ?)")
        catch panic("prepare insert3 should not fail")
    ins3.bind_text(1, "Carol") catch panic("bind_text failed")
    ins3.bind_null(2) catch panic("bind_null failed")
    ins3.step() catch panic("insert3 step failed")
    ins3.free()
    nul: = conn.prepare("SELECT age FROM person WHERE name = 'Carol'")
        catch panic("prepare select null should not fail")
    nul_row: = nul.step() catch panic("select null step failed")
    $saw_null: = false
    switch nul_row
    case .row
        switch nul.column_kind(0)
        case .null_value
            saw_null = true
        default {}
    default {}
    nul.free()
    assert(saw_null, "a bound NULL reads back as null_value")

    sel: =
        conn.prepare("SELECT name, age FROM person WHERE age IS NOT NULL ORDER BY age ASC")
        catch panic("prepare select should not fail")
    $count: Sz = 0
    $buf: U8[64] = ::{}
    for
        r: = sel.step() catch panic("select step failed")
        switch r
        case .row
            n: = sel.column_text(0, U8$[]::buf) catch panic("column_text failed")
            name: = U8$[]::{ .ptr = buf@, .len = n }
            age: = sel.column_i64(1)
            if count == 0
                assert(name.equals("Bob"), "first row (by age asc) should be Bob")
                assert(age == 25, "Bob's age should be 25")
            else
                assert(name.equals("Alice"), "second row should be Alice")
                assert(age == 30, "Alice's age should be 30")
            count += 1
        case .done
            break
    sel.free()
    assert(count == 2, "expected 2 rows")

    conn.free()
    verdict.pass("The whole CRUD flow works as expected.")

// ==========================================
// A round trip through std/reflect's field table (bind_row / read_row).
// ==========================================
priv struct Person
    name: U8[]
    age: I64
    height: F64
    active: Bool

impl Person: reflect.Reflectable {} //< the table is the declaration's, made by the compiler

fn test_db_row_roundtrip()
    verdict.start("[Db] walking the table to round-trip one row test...")
    arena: = Arena.new(8 * 1024)
    defer arena.free()

    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")
    conn.exec("CREATE TABLE p (name TEXT, age INTEGER, height REAL, active INTEGER)")
        catch panic("create table should not fail")

    // It binds by named parameters; no position is written.
    ins: =
        conn
        .prepare("INSERT INTO p (name, age, height, active) VALUES (:name, :age, :height, :active)")
        catch panic("prepare insert should not fail")
    src: Person = ::{ .name = "Alice", .age = 30, .height = 1.62, .active = true }
    ins.bind_row(src@) catch panic("bind_row failed")
    ins.step() catch panic("step insert failed")
    ins.free()

    // **The columns are in a different order from the declaration**; they are matched by name.
    sel: = conn.prepare("SELECT active, height, age, name FROM p")
        catch panic("prepare select should not fail")
    sel.step() catch panic("step select failed")
    $back: Person = ::{}
    sel.read_row(back@, arena) catch panic("read_row failed")
    assert(back.name.equals("Alice"), "a string round-trips")
    assert(back.age == 30I64, "an integer round-trips")
    assert(back.height > 1.61 && back.height < 1.63, "a fraction round-trips")
    assert(back.active, "a boolean round-trips")

    // If the table has no column for a field, it is refused with the field's name (not filled in
    // with a default).
    thin: = conn.prepare("SELECT name, age FROM p")
        catch panic("prepare thin select should not fail")
    thin.step() catch panic("step thin select failed")
    $partial: Person = ::{}
    $missing: U8[] = ""
    thin.read_row(partial@, arena) catch e
        switch e
        case .missing_column(which)
            missing = which
        default
            panic("expected missing_column")
    assert(missing.equals("height"), "a dropped column is named")
    thin.free()
    sel.free()
    conn.free()
    verdict
        .pass("It round-trips regardless of the columns' order, and refuses a dropped column by \
            name.")

fn test_db_one_statement_at_a_time()
    verdict.start("[Db] SQL holding a second statement being refused, not cut test...")
    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")

    // Run, the first would make `t` and the second would silently never make `u`.
    $refused: = false
    conn.exec("CREATE TABLE t (n INTEGER); CREATE TABLE u (n INTEGER)") catch e
        switch e
        case .several_statements
            refused = true
        default {}
    assert(refused, "SQL holding two statements is refused as several_statements")
    $none_ran: = false
    _t: = conn.prepare("SELECT n FROM t") catch e
        switch e
        case .prepare_failed
            none_ran = true
        default {}
        fallback null
    assert(none_ran, "a refused SQL runs none of its statements")

    // What follows the one statement may be blank: spaces, semicolons and comments.
    conn.exec("CREATE TABLE v (n INTEGER);  -- the table\n/* done */ ;\n")
        catch panic("a statement followed only by semicolons and comments should run")
    conn.exec("INSERT INTO v (n) VALUES (1)") catch panic("the table it made should exist")
    conn.free()
    verdict.pass("A second statement is refused before anything runs, and a blank tail is not one.")

// ==========================================
// An integer column read into a narrower field, and a field too wide for SQLite's integer.
// ==========================================
priv struct Bounded //< a field of each kind whose range is narrower than SQLite's integer
    small: I32
    byte: U8
    gap: Sz

impl Bounded: reflect.Reflectable {}

priv struct Unsigned_wide //< a field wider than SQLite's integer holds
    big: U64

impl Unsigned_wide: reflect.Reflectable {}

priv fn refused_field(conn: db.Db$@, select: U8[], arena: Arena$@): U8[] //<
    //< Reads the one row `select` gives into a `Bounded`, and names the field refused ("" for none)
    sel: = conn.prepare(select) catch panic("the select should prepare")
    defer sel.free()
    sel.step() catch panic("the select should step")
    $back: Bounded = ::{}
    $which: U8[] = ""
    sel.read_row(back@, arena) catch e
        switch e
        case .column_type(name)
            which = name
        default
            panic("expected column_type")
    return which

fn test_db_row_out_of_range()
    verdict.start("[Db] an integer a field cannot hold being refused, not cut test...")
    arena: = Arena.new(8 * 1024)
    defer arena.free()
    conn: = db.Db.open(":memory:") catch panic("open(:memory:) should not fail")

    // Each field's edges read back as they are, a negative `Sz` among them.
    edges: = "SELECT -2147483648 AS small, 255 AS byte, -1 AS gap"
    sel: = conn.prepare(edges) catch panic("the select should prepare")
    sel.step() catch panic("the select should step")
    $back: Bounded = ::{}
    sel.read_row(back@, arena) catch panic("values the fields hold should be read")
    sel.free()
    assert(back.small == -2147483648 && back.byte == 255 && back.gap == -1,
        "each field's edge is read unchanged")

    // Cut to the field's width, these would read as 705032704, 44 and 255.
    too_big: = refused_field(conn, "SELECT 5000000000 AS small, 0 AS byte, 0 AS gap", arena)
    assert(too_big.equals("small"), "a value past an I32 is refused by the field's name")
    too_wide: = refused_field(conn, "SELECT 0 AS small, 300 AS byte, 0 AS gap", arena)
    assert(too_wide.equals("byte"), "a value past a U8 is refused by the field's name")
    negative: = refused_field(conn, "SELECT 0 AS small, -1 AS byte, 0 AS gap", arena)
    assert(negative.equals("byte"), "a negative value into a U8 is refused by the field's name")

    // **Writing refuses too** a `U64` past SQLite's signed 64-bit integer, which would be stored as
    // a negative number.
    conn.exec("CREATE TABLE w (big INTEGER)") catch panic("create table should not fail")
    ins: = conn.prepare("INSERT INTO w (big) VALUES (:big)")
        catch panic("prepare insert should not fail")
    huge: Unsigned_wide = ::{ .big = 0xFFFFFFFFFFFFFFFF }
    $unwritten: U8[] = ""
    ins.bind_row(huge@) catch e
        switch e
        case .column_type(name)
            unwritten = name
        default
            panic("expected column_type")
    assert(unwritten.equals("big"), "a U64 past I64's range is refused when bound, by its name")
    ins.free()
    conn.free()
    verdict
        .pass("A value a field cannot hold is refused by the field's name, on reading and writing.")

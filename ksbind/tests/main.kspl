//< ksbind's tests, run as a program of their own (`make test` in this package's folder)
//< **This is the only way to run ksbind's tests.** They link OpenSSL, so `make debug`,
//< which every environment runs, leaves them out; `all.kspl` holds them, and this file only gives
//< them a `main`.
import "ksbind/tests/all"
import "std/io"
import "std/verdict"

fn main(): I32 //< the exit code is the checks' verdict (`verdict.finish`)
    // Flush line by line, so a run that crashes shows how far it got.
    io.set_line_buffered()
    all.run_ksbind()
    return verdict.finish()

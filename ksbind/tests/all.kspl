//< The entry point that runs ksbind's tests together
//< **This is the one contract this package exports.** The tests live inside `ksbind/`. So they
//< reach what they inspect without special marking ("A test of a unit's inside goes inside that
//< unit" in `../../docs/DESIGN-repository.md`).
//< **Do not add an inspecting entry point here**: each one is one more contract outside the unit.
//< **[I0402] does not fire in this unit**, for the same reason as in `std/`. A `pub` is a contract
//< with outside users, so the references visible in this compilation cannot decide it.
import "ksbind/tests/tls_server_test"
import "ksbind/tests/tls_test"
import "std/suite"

priv enum Tests //< ksbind's tests, which take nothing
    all

impl Tests: suite.Suite {}

pub fn run_ksbind() //< runs every ksbind test
    $t: = Tests.all
    t.run()

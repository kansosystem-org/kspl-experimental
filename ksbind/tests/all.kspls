//< The entry point that runs ksbind's tests together
//<
//< **This is the one contract this package exports.** The tests live inside `ksbind/`, so they
//< reach what they inspect without special marking ("A test inspecting the inside of a unit goes
//< inside that unit" in `../../docs/DESIGN.md`).
//< **Do not add an inspecting entry point here**: each one is one more contract outside the unit.
//< **[I0402] does not fire in this unit** (for the same reason as in `std/`: a `pub` is a contract
//< with outside users, so the references visible in this compilation cannot decide it).
import "ksbind/tests/db_test"
import "ksbind/tests/tls_test"

pub fn run_ksbind() //< runs every ksbind test
    db_test.test_db_crud_roundtrip()
    db_test.test_db_row_roundtrip()
    db_test.test_db_one_statement_at_a_time()
    db_test.test_db_row_out_of_range()
    db_test.test_db_error_codes()
    db_test.test_db_free_with_a_statement_open()
    tls_test.test_tls_handshake_failure_against_non_tls_peer()
    tls_test.test_tls_untrusted_certificate_is_refused()
    tls_test.test_tls_other_host_is_refused()
    tls_test.test_tls_round_trip_ends_at_close_notify()
    tls_test.test_tls_cut_connection_is_an_error()
    tls_test.test_tls_write_to_a_gone_peer_raises_no_sigpipe()

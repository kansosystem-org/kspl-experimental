//< ksdb's tests, run as a program of their own (`make test` in this package's folder)
//<
//< **This is the only way to run ksdb's tests on their own.** `all.kspl` holds them; this file
//< only gives them a `main`, so a copy of the package with nothing around it can run them.
import "ksdb/tests/all"
import "std/io"
import "std/verdict"

fn main(): I32 //< the exit code is the checks' verdict (`verdict.finish`)
    // Flush line by line, so a run that crashes shows how far it got.
    io.set_line_buffered()
    all.run_ksdb()
    return verdict.finish()

//< The entry point that runs ksdb's tests together
//<
//< **This is the one contract this package exports.** The tests live inside `ksdb/`, so they
//< reach what they inspect without special marking ("A test inspecting the inside of a unit goes
//< inside that unit" in `../../docs/DESIGN.md`).
//< **Do not add an inspecting entry point here**: each one is one more contract outside the unit.
//< **[I0402] does not fire in this unit** (for the same reason as in `std/`: a `pub` is a contract
//< with outside users, so the references visible in this compilation cannot decide it).
import "ksdb/tests/ksdb_test"

pub fn run_ksdb() //< runs every ksdb test
  ksdb_test.test_append_and_replay()
  ksdb_test.test_last_of_kind()
  ksdb_test.test_last_equals()
  ksdb_test.test_last_after_a_big_record()
  ksdb_test.test_torn_write_truncates()
  ksdb_test.test_torn_payload_still_appends()
  ksdb_test.test_corruption_is_detected()
  ksdb_test.test_a_corrupt_header_is_detected()
  ksdb_test.test_keeps_appending_after_a_power_loss()
  ksdb_test.test_every_power_cut_keeps_what_was_written()
  ksdb_test.test_a_scrambled_store_is_survivable()
  ksdb_test.test_full_is_reported_not_overwritten()
  ksdb_test.test_record_never_crosses_a_sector()
  ksdb_test.test_open_when_the_last_record_ends_near_the_end()
  ksdb_test.test_program_failure_is_surfaced()
  ksdb_test.test_append_does_not_erase()

//< The interface to a storage medium, shaped by flash's constraints
//<
//< Erasing sets every bit to 1 (`0xFF` reads back). **Writing can only turn a bit to 0**, so
//< `program` writes correctly only where the medium is erased. The erase unit is large and the
//< write unit small (`erase` works per sector, `program` per byte). Tests use `ksdb/ram_store`.

pub typedef Read_at = fn(at: Sz, dst: U8$[]) //< reads `dst.len` bytes from `at`; it cannot fail.
  //<
  //< Caution: **Do not pass a range past the end** (the caller checks it against `capacity`).
  //< Every medium can be read, so no failure is returned.

pub typedef Program_at = fn(at: Sz, src: U8[]): Bool //<
  //< writes `src` at `at`; false means it was not written.
  //<
  //< **Most media report no failure when writing where nothing was erased**: the bits just turn
  //< to 0, and reading back gives a garbled value. So true does not mean "written correctly";
  //< the layer above checks the erase (`ksdb/log.kspls`). false means "it was not written",
  //< not "try later"; retrying does not fix it.

pub typedef Erase_sector = fn(at: Sz): Bool //< erases the sector holding `at` to all 1 bits.
  //<
  //< Returns true if it erased. The address need not be the start of a sector. **The erase unit
  //< is `sector_size`**, so part of a sector cannot be erased on its own.

//   import "ksdb/ram_store" as ram;
//   $buf: U8[8192];
//   store: = ram.make(U8$[]::buf, 4096);   // a 4KB sector
pub struct Store //< the medium a log is kept on: its three operations and its sizes
  pub read_at: Read_at //< how this medium is read
  pub program_at: Program_at //< how bytes are written to an area that is already erased
  pub erase_sector: Erase_sector //< how one sector is erased back to all 1 bits
  pub capacity: Sz //< the medium's total size in bytes.
  pub sector_size: Sz //< the erase unit's size in bytes; it must divide `capacity`.
    //<
    //< Caution: **Otherwise the last sector ends partway**, and erasing it reaches into the region
    //< beyond.

impl Store
  pub fn sector_base(r: Store, at: Sz): Sz //< the start of the sector holding `at`
    return at - (at % r.sector_size)

  pub fn next_sector(r: Store, at: Sz): Sz //< the start of the sector after the one holding `at`
    //<
    //< On the last sector it returns `capacity`, which is past the end of the medium.
    return r.sector_base(at) + r.sector_size

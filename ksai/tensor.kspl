//< ksai's foundation: the multi-dimensional `Tensor<|T|>`, and the operations over it
//< matmul, rmsnorm, softmax, RoPE, the activation functions and the arithmetic operators. **The
//< matrix-product kernel is pure KSPL by default.** It has no dependencies and is written so that
//< Clang's auto-vectorization works. It hands off to BLAS only in a `--define=blas` build. Read
//< this file first.
#cfg(!blas)
import "ksai/parallel"
import "std/checked_int"
import "std/math"
import "std/mem" + { Arena }
import "std/prng"
import "std/str" { Str_builder }
import "std/strfmt"

pub enum Tensor_error //< why an operation could not run on the shapes it was given
    //< A shape mismatch can come from run-time data (a bad shape in weights read from a
    //< safetensors file). So it propagates as an error union (?E) for the caller to handle.
    rank_mismatch //< the number of dimensions is not what the operation expects
    shape_mismatch //< a dimension's size does not match, such as the inner-product dimension
    out_of_bounds //< a row number outside the tensor; a bad element index stops the program
pub const MAX_TENSOR_ELEMS: Sz = 2147483647 //< the most elements one tensor can hold.
    //< The cap `new` enforces: the largest I32, so a dimension reaches BLAS's I32 arguments whole.
    //< A real model needs more than 10^8: Qwen2.5-0.5B's embedding is 151936 x 896. The bytes
    //< are checked apart (`checked_mul`), so a 32-bit Sz still cannot overflow. It is pub so
    //< safetensors.get_tensor, which bypasses `new`, applies the same cap.

fn require_arena(arena: Arena$@) //< every tensor and adapter allocation has an explicit owner
    if arena == null
        panic("ksai: an explicit arena is required")

pub struct Tensor<|T|> //< a multi-dimensional array: the elements and their shape
    pub data: T$@ //< the elements, laid out with the last dimension varying fastest
    pub shape: Sz$[] //< each dimension's size; how many there are is `shape.len`
    pub size: Sz //< the total number of elements, kept because every loop bound needs it
    arena: Arena$@ //< the explicit arena used for results; only constructors set it

impl<|T|> Tensor<|T|>
    fn from_raw_parts(data_ptr: T$@, shape_ptr: Sz$@, ndim: Sz, size: Sz, arena: Arena$@):
        Tensor<|T|> //<
            //< Builds a tensor from raw parts whose shape_ptr, ndim and size the caller computed
            //< Both an ordinary allocation and a zero-copy read use it.
        return Tensor<|T|>::{
            .data = data_ptr,
            .shape = Sz$[]::{ .ptr = shape_ptr, .len = ndim },
            .size = size,
            .arena = arena,
        }
    pub fn new( //< a tensor of that shape, its elements not yet written
        shape: Sz[], //< each dimension's size, outermost first
        arena: Arena$@, //< the required arena for the shape and elements
    ): Tensor<|T|>
        require_arena(arena)
        ndim: = shape.len
        $size: Sz = 1

        shape_bytes: = ndim.checked_mul(sizeof(Sz)) catch panic("Tensor shape storage is too large")
        shape_ptr: = Sz$@::arena.alloc(shape_bytes)
        for $i: = I32::ndim - 1; i >= 0; i -= 1
            s: = shape[i]
            if s < 0
                panic("Tensor dimensions must be non-negative")
            (shape_ptr + i)$ = s
            // Caution: **Check before multiplying.** A multiply first and then a compare with
            // `MAX_TENSOR_ELEMS` lets through a product that overflowed Sz and wrapped below the
            // cap. The wrap can land on any multiple of 256. `new` cannot fail and is called from
            // many places, so it stops at once on what should never happen.
            if s > 0 && size > MAX_TENSOR_ELEMS / s
                // Always print which dimension held which value. Without the values, nobody can
                // tell the cause apart: a bug in the caller or in code generation. The intent is
                // that of "A program keeps its own output on an abnormal exit" in
                // std/docs/DESIGN-system.md.
                defer $b: = Str_builder()
                b
                    .s("Tensor shape product overflow (shape too large): ndim=\{ndim\} \
                        shape[\{i\}]=\{s\} product_before=\{size\} shape.ptr=")
                strfmt.write_ptr(b, Void$@::shape.ptr)
                strfmt.write_ptr(b.s(" dest="), Void$@::shape_ptr)
                // Print every dimension. One broken dimension alone cannot tell "the caller passed
                // a broken shape" from "the shape's memory was overwritten afterwards". An example
                // of the second: only the low 4 bytes of an 8-byte slot, from a calling-convention
                // mismatch.
                b.s("\n  dims:")
                for $k: = 0; k < I32::ndim && k < 16; k += 1
                    b.s(" [\{k\}]=\{shape[k]\}")
                // To identify the caller: a panic has no call history (only `!` builds a trace),
                // and several callers build the same shape. An arena's usage says which allocation
                // this is (near the start means the first call).
                arena_used: = arena.save().used
                b.s(" arena_used=\{arena_used\}")
                panic(b.slice())
            size *= s

        data_bytes: = size.checked_mul(sizeof(T)) catch panic("Tensor element storage is too large")
        data_ptr: = T$@::arena.alloc(data_bytes)
        return Tensor<|T|>.from_raw_parts(data_ptr, shape_ptr, ndim, size, arena)
    pub fn dup( //< a copy in another arena, flattened to one dimension
        //< It is for keeping a value alive after the caller's arena is gone.
        r: Self$@,
        arena: Arena$@, //< the arena the copy is allocated from
    ): Tensor<|T|>
        shape: Sz[1] = ::{ r.size }
        out: = Tensor<|T|>(Sz[]::shape, arena)
        for i in Range.asc(r.size)
            (out.data + i)$ = (r.data + i)$
        return out

    pub fn fill(r: Self@, val: T) //< writes the same value into every element
        for i in Range.asc(r.size)
            (r.data + i)$ = val
    pub fn fill_uniform( //< writes uniform random values into every element
        //< **A constant start makes every unit symmetric and training impossible** (every token
        //< would get the same embedding), so training from scratch begins here.
        r: Self$@,
        rng: prng.Prng$@, //< the random generator; its seed makes a run reproducible
        scale: F64, //< the values land in [-scale, scale)
    )
        for i in Range.asc(r.size)
            (r.data + i)$ = T::((rng.next_f64() * 2.0 - 1.0) * scale)

    pub fn matmul( //< the matrix product, in a newly allocated tensor
        r: Self$@,
        rhs: Tensor<|T|>, //< the right-hand matrix; its rows must match this one's columns
    ): Tensor<|T|>!Tensor_error
        // Check the shape before reserving result memory on the arena.
        r.check_matmul(rhs)!
        out_shape: Sz[2] = ::{ r.shape[0], rhs.shape[1] }
        out: = Tensor<|T|>(Sz[]::out_shape, r.arena)
        r.matmul_into(rhs, out)!
        return out
    priv fn check_matmul(r: Self$@, rhs: Tensor<|T|>): Void!Tensor_error //<
        //< Refuses operands whose product is not defined: not 2D, or inner dimensions that differ
        if r.shape.len != 2 || rhs.shape.len != 2
            throw .rank_mismatch
        k: = r.shape[1]
        if k != rhs.shape[0] || k <= 0 || r.shape[0] < 0 || rhs.shape[1] < 0
            throw .shape_mismatch
    fn holds_matrix(r: Self@, m: Sz, n: Sz): Bool //< whether it has exactly `m * n` elements
        //< Caution: **Divide rather than multiply.** Where `Sz` is 32 bits, `m * n` can wrap to a
        //< smaller size, and a kernel writing `[m, n]` would write past the end.
        if m < 0 || n < 0
            return false
        return r.size == 0 if n == 0 else r.size % n == 0 && r.size / n == m
    pub fn matmul_into( //< the matrix product, written into a tensor the caller owns
        //< It is for a hot loop that would otherwise allocate once per step.
        r: Self$@,
        rhs: Tensor<|T|>, //< the right-hand matrix; its rows must match this one's columns
        out: Tensor<|T|>, //< where the product goes; it must already be shaped `[m, n]`
    ): Void!Tensor_error
        r.check_matmul(rhs)!
        m: = r.shape[0]
        k: = r.shape[1]
        n: = rhs.shape[1]
        if !out.holds_matrix(m, n)
            throw .shape_mismatch
        matmul_kernel<|T|>(out.data, r.data, rhs.data, m, k, n)
    fn add_bias(r: Self$@, bias: Tensor<|T|>): Tensor<|T|>!Tensor_error //<
        //< Broadcast addition (for adding a bias)
        if r.shape.len < 2
            throw .rank_mismatch
        n: = r.shape[r.shape.len - 1]
        if bias.size != n
            throw .shape_mismatch

        out: = Tensor<|T|>(r.shape, r.arena)
        rows: = r.size / n
        // Nested per row, so the inner loop is a plain contiguous access with no division (i % n),
        // which favours auto-vectorization (as in matmul_cols).
        for row in Range.asc(rows)
            row_off: = row * n
            // `make test-simd` sees this loop vectorize.
            for j in Range.asc(n)
                (out.data + row_off + j)$ = (r.data + row_off + j)$ + (bias.data + j)$
        return out
    pub fn rmsnorm( //< root-mean-square normalization over the last dimension
        r: Self$@,
        weight: Tensor<|T|>, //< the per-element gain, as long as the last dimension
        eps: T, //< added under the square root, so a row of zeros does not divide by zero
    ): Tensor<|T|>!Tensor_error
        if r.shape.len < 2
            throw .rank_mismatch
        n: = r.shape[r.shape.len - 1]
        if n == 0 || weight.size != n
            throw .shape_mismatch

        out: = Tensor<|T|>(r.shape, r.arena)
        rows: = r.size / n

        for i in Range.asc(rows)
            // As llama.cpp's `rms_norm`: the squares summed in F64, the mean and its root in `T`.
            $ss: F64 = 0.0
            for j in Range.asc(n)
                val: = (r.data + i * n + j)$
                sq: = val * val
                ss = ss + F64::sq
            mean: = T::(ss / F64::n)
            variance: = mean + eps
            // The reciprocal is computed once, so the row's n divisions become multiplications
            // (division has lower per-lane throughput, and this favours auto-vectorization).
            root: = T::math.sqrt(F64::variance)
            inv_rms: = T::1.0 / root
            // `make test-simd` sees this loop vectorize.
            for j in Range.asc(n)
                (out.data + i * n + j)$ =
                    (r.data + i * n + j)$ * inv_rms * (weight.data + j)$
        return out
    pub fn scale( //< every element multiplied, in a newly allocated tensor
        r: Self$@,
        factor: T, //< what each element is multiplied by
    ): Tensor<|T|>
        out: = Tensor<|T|>(r.shape, r.arena)
        for i in Range.asc(r.size)
            (out.data + i)$ = (r.data + i)$ * factor
        return out
    fn matmul_transb(r: Self$@, rhs: Tensor<|T|>): Tensor<|T|>!Tensor_error //<
        //< The matrix product with the right side transposed (for Q * K^T; a zero-copy transpose)
        if r.shape.len != 2 || rhs.shape.len != 2
            throw .rank_mismatch
        m: = r.shape[0]
        k: = r.shape[1]
        n: = rhs.shape[0] // rhs is transposed, so its row count becomes n
        if k != rhs.shape[1]
            throw .shape_mismatch

        out_shape: Sz[2] = ::{ m, n }
        out: = Tensor<|T|>(Sz[]::out_shape, r.arena)
        transb_kernel<|T|>(out.data, r.data, rhs.data, m, k, n)
        return out
    pub fn softmax(r: Self$@): Tensor<|T|>!Tensor_error //<
        //< each row turned into weights that sum to 1
        //< The row's maximum is subtracted first, so a large value does not overflow.
        if r.shape.len < 2
            throw .rank_mismatch
        n: = r.shape[r.shape.len - 1]
        if n == 0
            throw .shape_mismatch
        rows: = r.size / n
        out: = Tensor<|T|>(r.shape, r.arena)

        for i in Range.asc(rows)
            $max_val: = (r.data + i * n)$
            for $j: Sz = 1; j < n; j += 1
                val: = (r.data + i * n + j)$
                if val > max_val
                    max_val = val
            $sum_exp: T = 0.0
            for j in Range.asc(n)
                ex: = T::math.exp(F64::(r.data + i * n + j)$ - max_val)
                (out.data + i * n + j)$ = ex
                sum_exp = sum_exp + ex
            // The sum's reciprocal is computed once (the same reason as rmsnorm).
            inv_sum: = T::1.0 / sum_exp
            // `make test-simd` sees this loop vectorize.
            for j in Range.asc(n)
                (out.data + i * n + j)$ = (out.data + i * n + j)$ * inv_sum
        return out
    pub fn apply_rope( //< rotates each pair of elements by its position, so the order is encoded
        r: Self$@,
        start_pos: Sz, //< the position of the first row, so a continued run keeps rotating from there
    ): Tensor<|T|>!Tensor_error
        if r.shape.len < 2
            throw .rank_mismatch
        if r.shape[r.shape.len - 2] == 0 || r.shape[r.shape.len - 1] == 0 ||
            r.shape[r.shape.len - 1] % 2 != 0
            throw .shape_mismatch
        return r.rope_rotate(start_pos, false)
    fn rope_rotate(r: Self$@, start_pos: Sz, invert: Bool): Tensor<|T|> //<
        //< Rotates each adjacent pair (2j, 2j+1) by the angle θ
        //< Caution: **Get the reverse rotation from here, with `invert`.** RoPE is orthogonal, so
        //< the backward pass is a rotation by -θ (`apply_rope_grad` in `ksai/grad.kspl`). **Do not
        //< copy the body with only the sign changed.** A fix to the frequency base or the indexing
        //< on one side alone silently puts the gradient out of step with the forward pass. The
        //< caller does the shape check (forward rejects with a diagnostic, reverse with an assert).
        seq_len: = r.shape[r.shape.len - 2]
        dim: = r.shape[r.shape.len - 1]

        out: = Tensor<|T|>(r.shape, r.arena)
        rows: = r.size / (seq_len * dim)

        for b in Range.asc(rows)
            for i in Range.asc(seq_len)
                pos: = F64::(start_pos + i)

                for $j: Sz = 0; j < dim / 2; j += 1
                    freq: = 1.0 / math.pow(10000.0, (F64::(j * 2)) / (F64::dim))
                    theta: = pos * freq
                    cos_val: = T::math.cos(theta)
                    raw_sin: = T::math.sin(theta)
                    sin_val: = -raw_sin if invert else raw_sin
                    base_idx: = b * (seq_len * dim) + i * dim
                    idx1: = base_idx + j * 2
                    idx2: = base_idx + j * 2 + 1

                    v1: = (r.data + idx1)$
                    v2: = (r.data + idx2)$
                    (out.data + idx1)$ = v1 * cos_val - v2 * sin_val
                    (out.data + idx2)$ = v1 * sin_val + v2 * cos_val
        return out
    fn apply_rope_neox(r: Self$@, start_pos: Sz, head_dim: Sz, rot: Sz, theta: F64):
        Tensor<|T|>!Tensor_error //<
            //< The RoPE of the NeoX/Llama/Qwen family: each head's first `rot` numbers turn, in pairs
            //< apply_rope is the interleaved style (pair 2j, 2j+1). HF Llama/Qwen pair j with
            //< j + rot/2 (rotate_half), per head of head_dim; numbers past `rot` stay as they are
            //< (Qwen3.5 turns 64 of 256). Each has its own base theta (1e6 for Qwen2.5). r's shape
            //< is [seq, n_heads*head_dim].
        if r.shape.len != 2
            throw .rank_mismatch
        seq: = r.shape[0]
        width: = r.shape[1]
        // Caution: **Refuse a head width of 0, or one that does not tile a row.** 0 never moves the
        // loop on. A last head cut short reads its second half past the row.
        if head_dim <= 0 || rot <= 0 || rot % 2 != 0 || rot > head_dim || width % head_dim != 0
            throw .shape_mismatch
        half: = rot / 2
        out: = Tensor<|T|>(r.shape, r.arena)
        if rot < head_dim
            mem.copy(Void$@::out.data, Void$@::r.data, r.size * sizeof(T))
        // **The angles are llama.cpp's** (`ggml_rope_cache_init`): in F32, pair j's angle is
        // pair j - 1's times `base^(-2 / rot)`, starting from the position. They depend on the
        // position and the pair, not on the head, so each is worked out once per row.
        step: = F32::math.pow(F64::F32::theta, F64::(-2.0F32 / F32::rot))
        for s in Range.asc(seq)
            $angle: = F32::(start_pos + s)
            for j in Range.asc(half)
                cos_val: = T::F32::math.cos(F64::angle)
                sin_val: = T::F32::math.sin(F64::angle)
                angle = angle * step
                for $base: Sz = 0; base < width; base += head_dim // per head boundary
                    idx1: = s * width + base + j // the first half
                    idx2: = s * width + base + j + half // the second half
                    x1: = (r.data + idx1)$
                    x2: = (r.data + idx2)$
                    (out.data + idx1)$ = x1 * cos_val - x2 * sin_val
                    (out.data + idx2)$ = x2 * cos_val + x1 * sin_val
        return out
    fn update_row(r: Self$@, row_idx: Sz, src: Tensor<|T|>): Void!Tensor_error //<
        //< Overwrites row `row_idx` with `src`, which is one row (for saving into the KV cache)
        //< Caution: **Refuse a `src` of several rows**: only its first would be copied, silently.
        if r.shape.len < 2 || src.shape.len < 2
            throw .rank_mismatch
        if src.size != src.shape[src.shape.len - 1]
            throw .shape_mismatch
        dim: = r.shape[r.shape.len - 1]
        if src.shape[src.shape.len - 1] != dim
            throw .shape_mismatch
        // In the KV cache (Self_attention/Gqa_attention.forward) row_idx is the generation
        // position. It goes past the allocated rows once the sequence outgrows max_seq_len. This
        // stops that.
        if row_idx >= r.shape[0]
            throw .out_of_bounds

        offset: = row_idx * dim
        for i in Range.asc(dim)
            (r.data + offset + i)$ = (src.data + i)$
    fn view_rows(r: Self$@, first: Sz, num_rows: Sz, arena: Arena$@): Tensor<|T|>!Tensor_error //<
        //< Builds a zero-copy view of `num_rows` rows from `first`
        //< It serves reading the KV cache so far, or a sequence's tail.
        if r.shape.len != 2
            throw .rank_mismatch
        if first + num_rows > r.shape[0]
            throw .out_of_bounds
        dim: = r.shape[1]

        require_arena(arena)
        shape_ptr: = Sz$@::arena.alloc(2 * sizeof(Sz))
        (shape_ptr + 0)$ = num_rows
        (shape_ptr + 1)$ = dim

        return Tensor<|T|>.from_raw_parts(r.data + first * dim, shape_ptr, 2, num_rows * dim, arena)

    // ---------------------------------------------------------
    // Operator overloading (+, -, *), the one way to add, subtract or multiply two tensors element
    // by element. An operator cannot return an error union under the trait's contract, so **a
    // shape mismatch stops the program**, as an index out of range does: the caller has both
    // shapes at hand. The bodies below are private, so no second, error-returning way stands
    // beside the operator.
    // ---------------------------------------------------------
    priv fn elementwise_out(r: Self$@, rhs: Tensor<|T|>): Tensor<|T|>!Tensor_error
        if r.size != rhs.size
            throw .shape_mismatch
        return Tensor<|T|>(r.shape, r.arena)

    priv fn checked_add( //< element-wise sum; rejects shapes that do not match
        //< **Do not merge the three loops below into one.** Passing the operation as a function
        //< pointer makes an indirect call per element. Then -O3's auto-vectorization stops working
        //< (the property the SIMD gate in `tests` checks).
        r: Self$@,
        rhs: Tensor<|T|>, //< the other tensor, which must be the same shape
    ): Tensor<|T|>!Tensor_error
        out: = r.elementwise_out(rhs)!
        for i in Range.asc(r.size)
            (out.data + i)$ = (r.data + i)$ + (rhs.data + i)$
        return out

    priv fn checked_sub( //< element-wise difference; rejects shapes that do not match
        r: Self$@,
        rhs: Tensor<|T|>, //< the other tensor, which must be the same shape
    ): Tensor<|T|>!Tensor_error
        out: = r.elementwise_out(rhs)!
        for i in Range.asc(r.size)
            (out.data + i)$ = (r.data + i)$ - (rhs.data + i)$
        return out

    priv fn checked_mul( //< element-wise product; rejects shapes that do not match
        r: Self$@,
        rhs: Tensor<|T|>, //< the other tensor, which must be the same shape
    ): Tensor<|T|>!Tensor_error
        out: = r.elementwise_out(rhs)!
        for i in Range.asc(r.size)
            (out.data + i)$ = (r.data + i)$ * (rhs.data + i)$
        return out

    // ---------------------------------------------------------
    // The activation functions
    // ---------------------------------------------------------

    pub fn silu(r: Self$@): Tensor<|T|> //< the SiLU (Swish) activation, element by element
        //< F32 elements take `exp_f32`, so the loop runs on vectors; F64 ones keep `math.exp`.
        out: = Tensor<|T|>(r.shape, r.arena)
        if sizeof(T) == 4
            // `make test-simd` sees this loop vectorize.
            for i in Range.asc(r.size)
                val: = F32::(r.data + i)$
                ex: = exp_f32(-val)
                (out.data + i)$ = T::(val / (1.0F32 + ex))
        else
            for i in Range.asc(r.size)
                val: = (r.data + i)$
                // math.exp takes F64
                ex: = math.exp(-(val))
                (out.data + i)$ = T::(val / (1.0 + ex))
        return out

// ---------------------------------------------------------
// The exponential of an F32, written so that a loop calling it runs on vectors. `math.exp` is a
// call into the C library on F64, which no loop around it can vectorize.
// ---------------------------------------------------------

priv const EXP_LOW: F32 = -87.0 //< below it the result would leave F32's normal range
priv const EXP_HIGH: F32 = 88.0 //< above it the result would overflow to infinity

fn exp_f32(x: F32): F32 //< e to the `x`, within 2 units in the last place for -87 ≤ x ≤ 88
    //< **ggml's `ggml_v_expf`, which llama.cpp's SiLU and softmax use.** `x = n ln 2 + b`, with
    //< `n` a whole number and |b| ≤ ln 2 / 2; `e^b - 1` is a polynomial in `b`, and `2^n` is
    //< made from `n`'s bits. Each product and sum stays its own statement, so no C compiler fuses
    //< two roundings into one and the bits are the same on every machine. Outside [-87, 88] it
    //< gives the value at the edge: about 1.6e-38 below, 1.7e38 above.
    $v: = x
    if v < EXP_LOW
        v = EXP_LOW
    if v > EXP_HIGH
        v = EXP_HIGH
    shift: = 12582912.0F32 // 1.5 × 2^23: adding it rounds to a whole number
    scaled: = v * 1.44269502F32
    z: = scaled + shift
    n: = z - shift
    hi: = n * 0.693145752F32
    t: = v - hi
    lo: = n * 1.42860677e-06F32
    b: = t - lo
    k: = f32_from_bits((f32_to_bits(z) << 23) + 0x3F800000U32)
    u: = b * b
    c5: = 0.00824739039F32 * b
    p1: = c5 + 0.0418997668F32
    c3: = 0.166683957F32 * b
    p2: = c3 + 0.499991268F32
    q1: = p1 * u
    q2: = q1 + p2
    q3: = q2 * u
    c1: = 0.999999404F32 * b
    j: = q3 + c1
    jk: = j * k
    return jk + k

priv fn f32_to_bits(v: F32): U32 //< an F32's bits read as an integer; no numeric conversion
    $x: = v
    $b: U32 = 0
    mem.copy(Void$@::b@, Void$@::x@, 4)
    return b

priv fn f32_from_bits(bits: U32): F32 //< the same bits read as an F32; no numeric conversion
    $b: = bits
    $v: F32 = 0.0
    mem.copy(Void$@::v@, Void$@::b@, 4)
    return v

impl<|T|> Tensor<|T|>: Index_place<|Sz, T|> //< so `t[i]` reads and writes one element
    //< Note: An index out of range panics, for the same reason as `std/ds.kspl`'s List. The caller
    //< can compute the range from `size`, so going outside it is a bug. Only a shape mismatch is a
    //< recoverable `Tensor_error` (the reason is at `Tensor_error`).
    #inline
    pub fn at(r: Self@, index: Sz, file: U8[], line: Sz): T$@ //< the element at a flat index
        if U64::index >= U64::r.size
            bounds_panic("Tensor.at", index, r.size, file, line)
        return r.data + index

impl<|T|> Tensor<|T|>: Add<|Tensor<|T|>, Tensor<|T|>|> //< so `a + b` can be written
    pub fn add(r: Self$@, rhs: Tensor<|T|>): Tensor<|T|> //< the sum; a shape mismatch panics
        return r.checked_add(rhs) catch panic("Tensor Add Error: shape mismatch")

impl<|T|> Tensor<|T|>: Sub<|Tensor<|T|>, Tensor<|T|>|> //< so `a - b` can be written
    pub fn sub(r: Self$@, rhs: Tensor<|T|>): Tensor<|T|> //< the difference; a mismatch panics
        return r.checked_sub(rhs) catch panic("Tensor Sub Error: shape mismatch")

impl<|T|> Tensor<|T|>: Mul<|Tensor<|T|>, Tensor<|T|>|> //< so `a * b` is element-wise, not matmul
    pub fn mul(r: Self$@, rhs: Tensor<|T|>): Tensor<|T|> //< the element-wise product
        return r.checked_mul(rhs) catch panic("Tensor Mul Error: shape mismatch")
// ---------------------------------------------------------
// The matrix-product kernel C[m,n] = A[m,k] @ B[k,n], called from matmul. By default (cfg !blas) it
// is pure KSPL (i-k-j, cache-efficient and auto-vectorizable); under --define=blas, BLAS's gemm.
// cfg leaves only one body in the AST. A large product splits its columns over the CPU's cores
// (`ksai/parallel`); every column keeps its order of additions, so any thread count gives the
// same bits.
// ---------------------------------------------------------
#cfg(!blas)
fn matmul_kernel<|T|>(c: T$@, a: T$@, b: T$@, m: Sz, k: Sz, n: Sz)
    matmul_split<|T|>(c, a, b, m, k, n, parallel.threads_for(m, k, n))

#cfg(!blas)
priv struct Matmul_job<|T|> //< one product C = A·B, as each of its threads reads it
    c: T$@
    a: T$@
    b: T$@
    m: Sz
    k: Sz
    n: Sz

#cfg(!blas)
fn matmul_split<|T|>(c: T$@, a: T$@, b: T$@, m: Sz, k: Sz, n: Sz, threads: Sz): Sz //<
    //< The product on up to `threads` threads, each taking whole columns; returns how many
    //< A piece starts on a multiple of 16 columns, so the vector loop stays whole.
    $job: = Matmul_job<|T|>::{ .c = c, .a = a, .b = b, .m = m, .k = k, .n = n }
    return parallel.split(matmul_cols<|T|>, Void$@::job@, n, 16, threads)

#cfg(!blas)
fn matmul_cols<|T|>(arg: Void$@, first: Sz, last: Sz) //< columns [first, last) of C = A·B
    //< The i-k-j loop: each element adds its terms in ascending k, whatever the columns around it.
    j: = Matmul_job<|T|>$@::arg
    width: = last - first
    for i in Range.asc(j.m)
        c_row: = j.c + i * j.n + first
        for x in Range.asc(width)
            (c_row + x)$ = 0.0
        for step in Range.asc(j.k)
            av: = (j.a + i * j.k + step)$
            b_row: = j.b + step * j.n + first
            // `make test-simd` sees this loop vectorize.
            for x in Range.asc(width)
                (c_row + x)$ = (c_row + x)$ + av * (b_row + x)$

#cfg(blas)
fn matmul_kernel<|T|>(c: T$@, a: T$@, b: T$@, m: Sz, k: Sz, n: Sz)
    blas_gemm<|T|>(CBLAS_NO_TRANS, CBLAS_NO_TRANS, m, n, k, a, k, b, n, c, n) // C = A@B

// C = A @ B^T (A:[m,k], B:[n,k] -> C:[m,n]): each output an inner product of two rows.
#cfg(!blas)
fn transb_kernel<|T|>(c: T$@, a: T$@, b: T$@, m: Sz, k: Sz, n: Sz) //<
    //< Four outputs at once, **each summed separately in ascending order**
    //< One running sum waits on its last addition at every step. Four independent ones overlap.
    //< Each still adds its terms in the same order, so the result is identical bit for bit. This
    //< is the third technique beside the two in "The kernels are spelt for the auto-vectorizer, not
    //< with intrinsics" in `ksai/docs/DESIGN-learning.md`.
    for i in Range.asc(m)
        a_row: = a + i * k
        c_row: = c + i * n
        $j: Sz = 0
        for j + 4 <= n
            b0: = b + j * k
            b1: = b0 + k
            b2: = b1 + k
            b3: = b2 + k
            $s0: T = 0.0
            $s1: T = 0.0
            $s2: T = 0.0
            $s3: T = 0.0
            for step in Range.asc(k)
                x: = (a_row + step)$
                s0 = s0 + x * (b0 + step)$
                s1 = s1 + x * (b1 + step)$
                s2 = s2 + x * (b2 + step)$
                s3 = s3 + x * (b3 + step)$
            (c_row + j)$ = s0
            (c_row + j + 1)$ = s1
            (c_row + j + 2)$ = s2
            (c_row + j + 3)$ = s3
            j += 4
        for j < n
            b_row: = b + j * k
            $s: T = 0.0
            for step in Range.asc(k)
                s = s + (a_row + step)$ * (b_row + step)$
            (c_row + j)$ = s
            j += 1

#cfg(blas)
fn transb_kernel<|T|>(c: T$@, a: T$@, b: T$@, m: Sz, k: Sz, n: Sz)
    blas_gemm<|T|>(CBLAS_NO_TRANS, CBLAS_TRANS, m, n, k, a, k, b, k, c, n) // C = A@B^T

// ---------------------------------------------------------
// An optional backend: only a `--define=blas` build calls BLAS's gemm by FFI. By default cfg(blas)
// discards these and matmul_kernel's BLAS version, so the generated C never mentions cblas. The
// library is declared with the block, so no build file names it.
// Caution: **`#cfg` holds only the one declaration after it.** Give each its own. Otherwise the
// ones after the first are kept in every build, and the block's `#link` asks every link for BLAS.
// ---------------------------------------------------------

// CBLAS's enum values, as `cblas.h` numbers them.
#cfg(blas)
const CBLAS_ROW_MAJOR: I32 = 101 //< CBLAS_ORDER: rows stored one after another
#cfg(blas)
const CBLAS_NO_TRANS: I32 = 111 //< CBLAS_TRANSPOSE: the matrix as it is
#cfg(blas)
const CBLAS_TRANS: I32 = 112 //< CBLAS_TRANSPOSE: the matrix transposed

#cfg(blas)
#link("openblas")
extern "C"
    fn cblas_sgemm(order: I32, ta: I32, tb: I32, m: I32, n: I32, k: I32, alpha: F32, a: F32$@,
        lda: I32, b: F32$@, ldb: I32, beta: F32, c: F32$@, ldc: I32)
    fn cblas_dgemm(order: I32, ta: I32, tb: I32, m: I32, n: I32, k: I32, alpha: F64, a: F64$@,
        lda: I32, b: F64$@, ldb: I32, beta: F64, c: F64$@, ldc: I32)

#cfg(blas)
fn blas_gemm<|T|>(ta: I32, tb: I32, m: Sz, n: Sz, k: Sz, a: T$@, lda: Sz, b: T$@, ldb: Sz, c: T$@,
    ldc: Sz) //<
        //< cfg(blas): the shared dispatch to BLAS gemm, C = op(A)@op(B) with alpha=1 and beta=0
        //< It is RowMajor and transposes by ta/tb (`CBLAS_NO_TRANS` / `CBLAS_TRANS`); it picks
        //< sgemm or dgemm by the element size (F32 or F64 only). matmul and grad.kspl's backward
        //< gemm share it.
    mi: = I32::m
    ni: = I32::n
    ki: = I32::k
    lda_i: = I32::lda
    ldb_i: = I32::ldb
    ldc_i: = I32::ldc
    if sizeof(T) == 4
        cblas_sgemm(CBLAS_ROW_MAJOR, ta, tb, mi, ni, ki, F32::1.0, F32$@::a, lda_i, F32$@::b, ldb_i,
            F32::0.0, F32$@::c, ldc_i)
    else
        cblas_dgemm(CBLAS_ROW_MAJOR, ta, tb, mi, ni, ki, F64::1.0, F64$@::a, lda_i, F64$@::b, ldb_i,
            F64::0.0, F64$@::c, ldc_i)

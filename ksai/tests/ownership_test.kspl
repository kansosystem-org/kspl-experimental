//< Arena lifetimes of tensors, file headers and borrowed weight views
import "ksai/lora_set" { Lora_widths, Mlp_lora, Qkv_lora }
import "ksai/safetensors" { Safetensors, Safetensors_writer }
import "ksai/tensor" { Tensor }
import "std/bytes" as _bytes
import "std/chars"
import "std/mem" + { Arena }
import "std/str" { Str_builder }
import "std/strfmt" as _strfmt
import "std/verdict"

priv fn tensors(arena: Arena$@)
    dims: Sz[2] = ::{ 2, 3 }
    $owner: = Tensor<|F32|>.new(Sz[]::dims, arena)
    owner.fill(F32::7.0)
    view: = owner.view_rows(1, 1, arena) catch panic("a row inside the tensor exists")
    assert((view.data + 0)$ == F32::7.0, "a view reads its owner's elements")

    (owner.data + 3)$ = F32::11.0
    assert((view.data + 0)$ == F32::11.0, "the owner and its view share their elements")

    empty_dims: Sz[2] = ::{ 0, 3 }
    empty: = Tensor<|F32|>.new(Sz[]::empty_dims, arena)
    assert(empty.size == 0 && empty.shape[1] == 3, "an empty tensor retains its shape")

    scalar_dims: Sz[] = ::{ .ptr = null, .len = 0 }
    scalar: = Tensor<|F32|>.new(scalar_dims, arena)
    assert(scalar.size == 1, "a scalar has one element")

priv fn weights(arena: Arena$@)
    dims: Sz[2] = ::{ 2, 3 }
    input: = Tensor<|F32|>.new(Sz[]::dims, arena)
    input.fill(F32::7.0)
    $writer: = Safetensors_writer.new()
    writer.add("w", input)
    $bytes: = writer.finish()

    $file: = Safetensors.load_from_bytes(bytes.slice(), arena)
        catch panic("the writer's file parses")

    view: = file.get_tensor<|F32|>("w", arena) catch panic("the written tensor exists")
    assert(U8@::view.data == bytes.slice().ptr + 8 + Sz::bytes.slice().get_u64_le(0),
        "aligned weights remain zero-copy")

    // Shifting the whole file by one byte makes its aligned payload misaligned.
    $shifted: = Str_builder.new()
    shifted.c(0U8).s(bytes.slice())
    $unaligned: =
        Safetensors.load_from_bytes(shifted.slice().sub_from(1), arena)
        catch panic("the shifted file parses")

    copy: = unaligned.get_tensor<|F32|>("w", arena) catch panic("a misaligned tensor is copied")
    assert(Sz::copy.data % sizeof(F32) == 0 && (copy.data + 5)$ == F32::7.0,
        "a misaligned weight has aligned, intact elements")

    wrong_dims: Sz[2] = ::{ 3, 2 }
    $dst: = Tensor<|F32|>.new(Sz[]::wrong_dims, arena)
    dst.fill(F32::9.0)
    $refused: = false
    file.map_into<|F32|>("w", dst@, arena) catch
        refused = true
    assert(refused && (dst.data + 0)$ == F32::9.0, "a refused replacement preserves its destination")

    $fit: = Tensor<|F32|>.new(Sz[]::dims, arena)
    file.map_into<|F32|>("w", fit@, arena) catch panic("the matching shape is accepted")
    assert((fit.data + 5)$ == F32::7.0, "an accepted replacement reads the file")

priv fn refused_header(header: U8[], arena: Arena$@)
    $bytes: = Str_builder.new()
    prefix: U8[8] = ::{}
    (U8$[]::prefix).put_u64_le(0, U64::header.len)
    bytes.s(U8[]::prefix).s(header).s("012345678901234567890123")
    $file: = Safetensors.load_from_bytes(bytes.slice(), arena)
        catch panic("the bad header is valid JSON")
    $refused: = false
    file.get_tensor<|F32|>("w", arena) catch
        refused = true
    assert(refused, "a bad dimension or data range is refused")

priv fn adapters(arena: Arena$@)
    dims: Sz[2] = ::{ 1, 1 }
    matrix: = Tensor<|F32|>.new(Sz[]::dims, arena)

    matrix.fill(F32::2.0)
    empty_dims: Sz[1] = ::{ 0 }
    empty: = Tensor<|F32|>.new(Sz[]::empty_dims, arena)

    for group in U8[][]::{ "attn", "mlp" }
        first: = "q" if group.equals("attn") else "fc1"
        for broken in Range.asc(3)
            $writer: = Safetensors_writer.new()
            $key: = Str_builder.new()
            for part in U8[][]::{ "a", "b", "scale" }
                if broken == 0 && !part.equals("a")
                    continue
                key.clear().s("blocks.0.\{group\}.\{first\}.lora_\{part\}")
                t: = empty if broken == 1 && part.equals("scale") else matrix
                writer.add(key.slice(), t)
            $bytes: = writer.finish()
            file: = Safetensors.load_from_bytes(bytes.slice(), arena)
                catch panic("the incomplete adapter has a valid file header")

            $refused: = false
            fits: = Lora_widths::{ .in_dim = 1, .out_dim = 1 }
            if group.equals("attn")
                Qkv_lora<|F32|>.load_set_from(file, 1, fits, fits, arena) catch
                    refused = true
            else
                Mlp_lora<|F32|>.load_set_from(file, 1, fits, fits, arena) catch
                    refused = true
            assert(refused, "missing B, an empty scale and a missing second adapter are refused")

fn test_ownership()
    verdict.start("[Ownership] tensors and headers share an explicit arena lifetime...")
    before: = mem.heap_used_bytes()
    arena: = Arena.new(4096)
    tensors(arena)
    weights(arena)
    adapters(arena)
    for header in U8[][]::{ "{\"w\":{\"dtype\":\"F32\",\"shape\":[-1],\"data_offsets\":[0,24]}}",
        "{\"w\":{\"dtype\":\"F32\",\"shape\":[2,3],\"data_offsets\":[0,8]}}",
        "{\"w\":{\"dtype\":\"F32\",\"shape\":[2,3],\"data_offsets\":[0,40]}}" }
        refused_header(header, arena)
    arena.free()
    assert(mem.heap_used_bytes() == before, "the arena releases all tensor and header storage")
    verdict.pass("empty tensors, borrowed and copied weights, refused reads and partial adapters")

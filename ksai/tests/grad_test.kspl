//< Training: gradients, the layers' first weights, the optimizers' pairing and their steps
import "ksai/attention_train" as ai_attn_train
import "ksai/block_train" as ai_block_train
import "ksai/grad" as ai_grad
import "ksai/nn" as ai_nn
import "ksai/nn_grad" as ai_nn_grad
import "ksai/optim" as ai_optim
import "ksai/sampler" as ai_sampler
import "ksai/tensor" { Tensor }
import "std/math"
import "std/mem" { Arena }
import "std/prng"
import "std/str"
import "std/verdict"

// ==========================================
// The sum of a tensor's elements, as the loss the gradient checks differentiate.
// ==========================================
fn tsum_f64(t: Tensor<|F64|>): F64
    $s: = 0.0
    for i in Range.asc(t.size)
        s += (t.data + i)$
    return s

fn max_gap<|T|>( //< the largest gap between an analytic gradient and a central finite difference
    //< Moves each element of `w` by ±eps, calls `loss` on each side, then restores the element.
    //< A NaN gap is kept as the largest, so a check `gap < tol` fails on it.
    w: Tensor<|T|>,
    g: Tensor<|T|>, //< the analytic gradient, the same shape as `w`
    eps: F64,
    loss: Callable1<|Sz, F64|>, //< the loss at the current `w`; its argument is not used
): F64
    $worst: = 0.0
    for k in Range.asc(w.size)
        saved: = (w.data + k)$
        (w.data + k)$ = saved + T::eps
        l_plus: = loss.call(0)
        (w.data + k)$ = saved - T::eps
        l_minus: = loss.call(0)
        (w.data + k)$ = saved
        d: = (l_plus - l_minus) / (2.0 * eps) - F64::(g.data + k)$
        ad: = math.abs(d)
        if ad > worst || ad != ad
            worst = ad
    return worst

priv fn make_logits(a: F32, b: F32, c: F32, d: F32, arena: Arena$@): Tensor<|F32|>
    shape: Sz[1] = ::{ 4 }
    t: = Tensor<|F32|>(Sz[]::shape, arena)
    (t.data + 0)$ = a
    (t.data + 1)$ = b
    (t.data + 2)$ = c
    (t.data + 3)$ = d
    return t
// ==========================================
// The cross-entropy loss's analytic gradient against a finite difference
// ==========================================
fn test_grad_numeric(arena: Arena$@)
    verdict.start("[Grad] numerical gradient check (cross-entropy)...")
    target: I32 = 2
    $base: = make_logits(F32::0.5, -(F32::1.0), F32::2.0, F32::0.3, arena)
    // the analytic gradient = softmax(logits) - onehot(target)
    g: = base.grad_softmax_cross_entropy(target)

    bp: = base@
    gap: =
        max_gap(base, g, 1.0e-3,
        fn(_i: Sz; bp: Tensor<|F32|>$@, target: I32): F64 {
        return bp.cross_entropy_loss(target);
    })
    assert(gap < 1.0e-2, "Grad: analytic gradient must match finite difference")
    verdict.pass("")
// ==========================================
// The numerical check of the sequence version's gradient.
// Caution: **The per-row mean, 1/rows, enters here**, so this one can be wrong where the
// single-position version is right. Drop the coefficient and **the gradient becomes rows times
// too large**. The loss keeps going down, and nobody notices.
// ==========================================
fn test_grad_numeric_seq(arena: Arena$@)
    verdict
        .start("[Grad] the sequence version's cross-entropy gradient matches a finite difference...")
    rows: Sz = 3
    n: Sz = 4
    shape: Sz[2] = ::{ rows, n }
    $logits: = Tensor<|F64|>(Sz[]::shape, arena)
    for i in Range.asc(logits.size)
        (logits.data + i)$ = 0.31 * (F64::((i * 5) % 7)) - 0.9
    targets: I32[3] = ::{ 2, 0, 3 }
    tv: = I32$[]::targets
    g: = logits.grad_softmax_cross_entropy_seq(tv)

    lp: = logits@
    gap: =
        max_gap(logits, g, 1.0e-6,
        fn(_i: Sz; lp: Tensor<|F64|>$@, tv: I32$[]): F64 {
        return lp.cross_entropy_loss_seq(tv);
    })
    assert(gap < 1.0e-6, "Grad: the sequence version's gradient has to match a finite difference")
    verdict.pass("")
// ==========================================
// End-to-end training: trains a one-layer linear classifier by SGD and checks the loss decreases
// ==========================================
fn test_grad_training(arena: Arena$@)
    verdict.start("[Grad] end-to-end training (linear + SGD)...")
    in_dim: Sz = 3
    vocab: Sz = 4
    target: I32 = 2
    x_shape: Sz[2] = ::{ 1, in_dim }
    $x: = Tensor<|F32|>(Sz[]::x_shape, arena)
    (x.data + 0)$ = F32::0.5
    (x.data + 1)$ = -(F32::0.2)
    (x.data + 2)$ = F32::0.8
    // initializes the weights W:[3,4] to 0 (deterministic)
    w_shape: Sz[2] = ::{ in_dim, vocab }
    $w: = Tensor<|F32|>(Sz[]::w_shape, arena)
    w.fill(F32::0.0)

    $loss0: = 0.0
    for step in Range.asc(100)
        $logits: = x.matmul(w) catch // the forward pass [1,4]
            panic("matmul shape mismatch")
        loss: = logits.cross_entropy_loss(target)
        if step == 0
            loss0 = loss
        // the backward pass: dlogits → dW, then the SGD update
        dlogits: = logits.grad_softmax_cross_entropy(target)
        dw: = x.grad_matmul_weight(dlogits)
        w.sgd_step(dw, 0.5)
    // the prediction after training matches target, and the loss has dropped far enough
    $final_logits: = x.matmul(w) catch panic("matmul shape mismatch")
    loss_final: = final_logits.cross_entropy_loss(target)
    pred: = ai_sampler.argmax(final_logits)
    assert(pred == target, "Grad: trained classifier must predict the target class")
    assert(loss_final < loss0 * 0.2, "Grad: training must significantly reduce the loss")
    verdict
        .pass(arena.text().s("linear + SGD training runs end to end and the loss falls ")
        .s("(loss \{loss0\} -> \{loss_final\})").take())
// ==========================================
// End-to-end training of the nn layers: trains an MLP classifier by SGD (checking nn_grad)
// ==========================================
fn test_nn_training(arena: Arena$@)
    verdict.start("[NN] end-to-end MLP training (fc1->silu->fc2 + backward)...")
    in_dim: Sz = 3
    hidden: Sz = 5
    out_dim: Sz = 4
    target: I32 = 3
    x_shape: Sz[2] = ::{ 1, in_dim }
    x: = Tensor<|F32|>(Sz[]::x_shape, arena)
    (x.data + 0)$ = F32::0.6
    (x.data + 1)$ = -(F32::0.4)
    (x.data + 2)$ = F32::0.9

    $mlp: = ai_nn.Mlp<|F32|>(in_dim, hidden, out_dim, arena)

    $loss0: = 0.0
    for step in Range.asc(200)
        $logits: = mlp.forward(x) // [1,4]
        loss: = logits.cross_entropy_loss(target)
        if step == 0
            loss0 = loss
        dlogits: = logits.grad_softmax_cross_entropy(target)
        mlp.backward(x, dlogits, 0.2) // the backward pass + the online SGD update
    $final_logits: = mlp.forward(x)
    loss_final: = final_logits.cross_entropy_loss(target)
    pred: = ai_sampler.argmax(final_logits)
    assert(pred == target, "NN: trained MLP must predict the target class")
    assert(loss_final < loss0 * 0.5, "NN: MLP training must reduce the loss")
    verdict
        .pass(arena.text()
        .s("an fc1->silu->fc2 MLP trains, backward pass included, and the loss falls ")
        .s("(loss \{loss0\} -> \{loss_final\})").take())
// ==========================================
// RMSNorm's backward pass: dX against a finite difference, with L = Σ y_i so dy = 1.
// ==========================================
priv fn rmsnorm_sum(rn: ai_nn.Rms_norm<|F32|>$@, x: Tensor<|F32|>): F64
    y: = rn.forward(x)
    $s: = 0.0
    for i in Range.asc(y.size)
        s += (y.data + i)$
    return s

fn test_rmsnorm_grad(arena: Arena$@)
    verdict.start("[NN] RMSNorm backward numerical gradient check...")
    n: Sz = 4
    $rn: = ai_nn.Rms_norm<|F32|>(n, F32::1.0e-5, arena)
    // Non-uniform weights make the test stricter
    (rn.weight.data + 0)$ = F32::1.0
    (rn.weight.data + 1)$ = F32::0.5
    (rn.weight.data + 2)$ = F32::1.5
    (rn.weight.data + 3)$ = F32::0.8
    x_shape: Sz[2] = ::{ 1, n }
    x: = Tensor<|F32|>(Sz[]::x_shape, arena)
    (x.data + 0)$ = F32::0.5
    (x.data + 1)$ = -(F32::1.2)
    (x.data + 2)$ = F32::0.9
    (x.data + 3)$ = F32::0.3
    // dy = 1 (L = Σ y)
    dy: = Tensor<|F32|>(Sz[]::x_shape, arena)
    dy.fill(F32::1.0)
    // lr=0 leaves the weights frozen and gives dX
    dx: = rn.backward(x, dy, 0.0)

    rp: = rn@
    gap: =
        max_gap(x, dx, 1.0e-3,
        fn(_i: Sz; rp: ai_nn.Rms_norm<|F32|>$@, x: Tensor<|F32|>): F64 {
        return rmsnorm_sum(rp, x);
    })
    assert(gap < 1.0e-2, "NN: RMSNorm dX must match finite difference")
    verdict.pass("")
// ==========================================
// The Adam optimizer: trains a linear classifier by Adam and checks that it converges
// ==========================================
fn test_adam(arena: Arena$@)
    verdict.start("[Optim] Adam optimizer training...")
    in_dim: Sz = 3
    vocab: Sz = 4
    target: I32 = 1
    x_shape: Sz[2] = ::{ 1, in_dim }
    $x: = Tensor<|F32|>(Sz[]::x_shape, arena)
    (x.data + 0)$ = F32::0.3
    (x.data + 1)$ = F32::0.9
    (x.data + 2)$ = -(F32::0.6)
    w_shape: Sz[2] = ::{ in_dim, vocab }
    w: = Tensor<|F32|>(Sz[]::w_shape, arena)
    w.fill(F32::0.0)

    $opt: = ai_optim.Adam<|F32|>.new_default(w)
    $loss0: = 0.0
    for step in Range.asc(100)
        $logits: = x.matmul(w) catch panic("matmul shape mismatch")
        loss: = logits.cross_entropy_loss(target)
        if step == 0
            loss0 = loss
        dlogits: = logits.grad_softmax_cross_entropy(target)
        dw: = x.grad_matmul_weight(dlogits)
        opt.step(w, dw, 0.1) // the Adam update
    $final_logits: = x.matmul(w) catch panic("matmul shape mismatch")
    loss_final: = final_logits.cross_entropy_loss(target)
    pred: = ai_sampler.argmax(final_logits)
    assert(pred == target, "Optim: Adam must reach the target class")
    assert(loss_final < loss0 * 0.2, "Optim: Adam must reduce the loss")
    verdict
        .pass(arena.text()
        .s("training runs under Adam and the loss falls (loss \{loss0\} -> \{loss_final\})").take())
// ==========================================
// Self-Attention's backward pass in F64: with L = Σ out (dout=1), the training forward's input
// gradient dX against a finite difference, then L decreasing under SGD.
// ==========================================
fn test_attention_grad(arena: Arena$@)
    verdict.start("[Attn] Self-Attention backward numerical gradient check (F64)...")
    seqn: Sz = 3
    d: Sz = 4
    $att: = ai_nn.Self_attention<|F64|>(d, seqn, arena)
    x_shape: Sz[2] = ::{ seqn, d }
    x: = Tensor<|F64|>(Sz[]::x_shape, arena)
    for i in Range.asc(x.size)
        (x.data + i)$ = 0.1 * (F64::i) - 0.5 // a deterministic input that varies
    // the analytic gradient (lr=0 freezes the weights)
    $c: = att.train_forward(x)
    dout: = Tensor<|F64|>(c.out.shape, arena)
    dout.fill(1.0)
    dx: = att.backward(c@, dout, 0.0)

    ap: = att@
    gap: =
        max_gap(x, dx, 1.0e-5,
        fn(_i: Sz; ap: ai_nn.Self_attention<|F64|>$@, x: Tensor<|F64|>): F64 {
        return tsum_f64(ap.train_forward(x).out);
    })
    assert(gap < 1.0e-4, "Attn: dX must match finite difference")
    // L=Σout decreases under gradient descent (backward pass and update together)
    before: = tsum_f64(att.train_forward(x).out)
    for _step in Range.asc(20)
        $cc: = att.train_forward(x)
        d1: = Tensor<|F64|>(cc.out.shape, arena)
        d1.fill(1.0)
        att.backward(cc@, d1, 0.01)
    after: = tsum_f64(att.train_forward(x).out)
    assert(after < before, "Attn: SGD must reduce the sum-of-outputs loss")
    verdict
        .pass(arena.text()
        .s("Self-Attention's backward pass matches numerical differentiation (F64) ")
        .s("(Σout \{before\} -> \{after\})").take())
// ==========================================
// Transformer_block's backward pass in F64: residual×2 + RMSNorm×2 + Attention + MLP composed,
// against a finite difference and under gradient descent.
// ==========================================
fn test_block_grad(arena: Arena$@)
    verdict.start("[Block] Transformer_block backward numerical gradient check (F64)...")
    seqn: Sz = 3
    d: Sz = 4
    hidden: Sz = 8
    $blk: = ai_nn.Transformer_block<|F64|>(d, hidden, seqn, 1.0e-5, arena)
    x_shape: Sz[2] = ::{ seqn, d }
    x: = Tensor<|F64|>(Sz[]::x_shape, arena)
    for i in Range.asc(x.size)
        (x.data + i)$ = 0.07 * (F64::i) - 0.4
    // the analytic gradient (lr=0 freezes every layer)
    $c: = blk.train_forward(x)
    dout: = Tensor<|F64|>(c.out.shape, arena)
    dout.fill(1.0)
    dx: = blk.backward(c@, dout, 0.0)

    bp: = blk@
    gap: =
        max_gap(x, dx, 1.0e-5,
        fn(_i: Sz; bp: ai_nn.Transformer_block<|F64|>$@, x: Tensor<|F64|>): F64 {
        return tsum_f64(bp.train_forward(x).out);
    })
    assert(gap < 1.0e-3, "Block: dX must match finite difference")
    // Σout decreases under gradient descent (the whole block's training)
    before: = tsum_f64(blk.train_forward(x).out)
    for _step in Range.asc(20)
        $cc: = blk.train_forward(x)
        d1: = Tensor<|F64|>(cc.out.shape, arena)
        d1.fill(1.0)
        blk.backward(cc@, d1, 0.01)
    after: = tsum_f64(blk.train_forward(x).out)
    assert(after < before, "Block: SGD must reduce the sum-of-outputs loss")
    verdict
        .pass(arena.text()
        .s("Transformer_block's backward pass matches numerical differentiation (F64) ")
        .s("(Σout \{before\} -> \{after\})").take())

// ==========================================
// Initializing a layer. **`nn.*.new`'s default is one value in every element.** Trained from
// there, every unit gets the same gradient and the units stay identical. Yet **the loss still
// goes down**. So the test holds `init_uniform` to **randomize every weight in the layer**, for
// the weights listed below (Principle 8).
// Caution: **A weight added to a layer is listed here in the same commit as in `init_uniform`.**
// ==========================================

priv fn all_same(t: Tensor<|F64|>): Bool //< is every element the same value?
    if t.size == 0
        return true
    first: = (t.data + 0)$
    for i in Range.asc(t.size)
        if (t.data + i)$ != first
            return false
    return true

fn test_init_breaks_symmetry()
    verdict.start("[NN] init_uniform spreads every last weight in a layer...")
    defer work: = Arena(1024 * 1024)
    $blk: = ai_nn.Transformer_block<|F64|>(4, 8, 2, 1.0e-5, work)
    // First pins that the default is one repeated value. If that breaks, the checks below pass
    // without proving anything.
    assert(all_same(blk.attention.wq.weights),
        "NN: new's default has to be the same value in every element")
    assert(all_same(blk.ffn.fc1.weights),
        "NN: new's default has to be the same value in every element")

    $rng: = prng.Prng(7U64)
    blk.init_uniform(rng@, 0.1)
    assert(!all_same(blk.attention.wq.weights), "NN: init_uniform has to spread wq")
    assert(!all_same(blk.attention.wk.weights), "NN: init_uniform has to spread wk")
    assert(!all_same(blk.attention.wv.weights), "NN: init_uniform has to spread wv")
    assert(!all_same(blk.attention.wo.weights), "NN: init_uniform has to spread wo")
    assert(!all_same(blk.ffn.fc1.weights), "NN: init_uniform has to spread fc1")
    assert(!all_same(blk.ffn.fc2.weights), "NN: init_uniform has to spread fc2")
    // **Do not randomize the normalization's weights.** Their initial value for training is 1.0
    // (randomizing them makes the scale right after normalizing vary from unit to unit).
    assert(all_same(blk.attention_norm.weight) &&
        (blk.attention_norm.weight.data + 0)$ == 1.0,
        "NN: init_uniform must not touch the normalization's weights")
    assert(all_same(blk.ffn_norm.weight) && (blk.ffn_norm.weight.data + 0)$ == 1.0,
        "NN: init_uniform must not touch the normalization's weights")

    $emb: = ai_nn.Embedding<|F64|>(6, 4, work)
    assert(all_same(emb.weight), "NN: Embedding's default is the same value in every element too")
    emb.init_uniform(rng@, 0.1)
    assert(!all_same(emb.weight), "NN: init_uniform has to spread the embedding")
    verdict.pass("")

// ==========================================
// The `Updater` against the optimizers it gives each weight. **What is tested is the pairing.**
// Under Adam, the n-th weight passed in a step keeps the n-th state across steps. So the weights
// end up where one `Adam` per weight would move them.
// ==========================================
priv fn filled(n: Sz, v: F32, arena: Arena$@): Tensor<|F32|> //< a vector of n, every element v
    shape: Sz[1] = ::{ n }
    t: = Tensor<|F32|>(Sz[]::shape, arena)
    t.fill(v)
    return t

priv fn same(a: Tensor<|F32|>, b: Tensor<|F32|>): Bool //< element for element, bit for bit
    for i in Range.asc(a.size)
        if (a.data + i)$ != (b.data + i)$
            return false
    return true

fn test_updater_pairs_states(arena: Arena$@) //<
    //< Two weights of different sizes, three steps, gradients differing by step and weight
    //< Caution: **Keep the gradients differing**: with one gradient for all, a weight moved by
    //< another's state still comes out right.
    verdict.start("[Optim] the Updater keeps each weight's own Adam state across steps")
    a: = filled(3, 1.0, arena)
    b: = filled(5, -1.0, arena)
    a_ref: = filled(3, 1.0, arena)
    b_ref: = filled(5, -1.0, arena)
    defer $u: = ai_optim.Updater<|F32|>.adam(0.1)
    $adam_a: = ai_optim.Adam<|F32|>.new_default(a_ref)
    $adam_b: = ai_optim.Adam<|F32|>.new_default(b_ref)
    for step in Range.asc(3)
        ga: = filled(3, F32::(F64::(step + 1) * 0.5), arena)
        gb: = filled(5, F32::(F64::(step + 1) * -0.25), arena)
        // **The rate changes every step**, as a schedule changes it: each step must use its own.
        u.lr = 0.1 / F64::(step + 1)
        u.begin_step()
        u.update(a, ga)
        u.update(b, gb)
        adam_a.step(a_ref, ga, u.lr)
        adam_b.step(b_ref, gb, u.lr)
    assert(same(a, a_ref) && same(b, b_ref),
        "the Updater's Adam must move each weight as its own, at the rate of that step")
    s: = filled(3, 1.0, arena)
    $s_ref: = filled(3, 1.0, arena)
    defer $sgd: = ai_optim.Updater<|F32|>.sgd(0.1)
    g: = filled(3, 0.5, arena)
    sgd.begin_step()
    sgd.update(s, g)
    s_ref.sgd_step(g, 0.1)
    assert(same(s, s_ref), "the Updater's SGD must be sgd_step")
    verdict
        .pass("each weight keeps its own Adam state across steps at each step's rate, and SGD is \
            sgd_step")

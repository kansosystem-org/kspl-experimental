//< ksai's own stops, one chosen per run: each misuse must stop the program, never go on
//< `ksplc run tests/stops.kspl <which>` runs one; [`stops_main.kspl`](stops_main.kspl) runs
//< each as a child and checks that it stops, says why, and never reaches the line after the stop.
//< One run is one stop: a stop ends the process, so the cases cannot share a run.
import "ksai/grad" as _grad // `grad_matmul_input_into` on Tensor
import "ksai/lora_set" { Lora_widths, Qkv_lora }
import "ksai/nn"
import "ksai/optim"
import "ksai/quant" as _quant
import "ksai/safetensors" { Safetensors }
import "ksai/sampler"
import "ksai/tensor" { Tensor }
import "std/io"
import "std/mem" { Arena }
import "std/str"
import "std/sys"

// ==========================================
// argmax-empty-logits: given logits whose last dimension is 0, it must stop instead of picking.
// A dimension of size 0 is legitimate for an empty tensor; why argmax and sample must still stop
// is at `sampler.argmax`.
// Caution: The shape must be **decided at run time**; a constant is folded and the run-time check
// never runs.
// ==========================================
fn argmax_empty_logits(arena: Arena$@)
    // The arguments are the executable's name and the stop's, so this is 0.
    $shape: Sz[1] = ::{ 0 }
    shape[0] = sys.args().len - 2
    t: = Tensor<|F32|>.new(Sz[]::shape, arena)
    io.out().s("about to pick from \{t.shape[0]\} candidates\n")
    picked: = sampler.argmax(t)
    io.out().s("must not get here: \{picked\}\n")

// ==========================================
// tensor-shape-product-overflow: a Tensor whose shape's product overflows Sz must not be created.
// **The wrapped product can land inside the cap** (1e8 * 28999941890838049 wraps past 2^64 to
// 256). So the cap is checked before multiplying (the caution inside `Tensor.new` in
// ksai/tensor.kspl). An Sz literal holds only 32 bits, so the factor is built at run time.
// ==========================================
fn tensor_shape_product_overflow(arena: Arena$@)
    wrapping: = Sz::(28999941I64 * 1000000000I64 + 890838049I64)
    $shape: Sz[2] = ::{ 0, 100000000 }
    shape[0] = wrapping
    io.out().s("about to build a tensor of shape[0]=\{shape[0]\}\n")
    t: = Tensor<|F32|>.new(Sz[]::shape, arena)
    io.out().s("must not get here: size=\{t.size\}\n")

// ==========================================
// updater-weight-count: a step that gives the Updater fewer weights than the first step must stop.
// **Otherwise the states shift**: the weights after the missing one would be moved by other
// weights' states, and training would go on, silently wrong.
// ==========================================
fn updater_weight_count(arena: Arena$@)
    shape: Sz[1] = ::{ 2 }
    w: = Tensor<|F32|>.new(Sz[]::shape, arena)
    g: = Tensor<|F32|>.new(Sz[]::shape, arena)
    w.fill(1.0)
    g.fill(0.5)
    $u: = optim.Updater<|F32|>.adam(0.1)
    defer u.free()
    u.begin_step()
    u.update(w, g)
    u.update(w, g)
    u.begin_step()
    u.update(w, g)
    u.begin_step() // one weight this step where the first had two
    io.out().s("must not get here\n")

// ==========================================
// gqa-uneven-heads / gqa-odd-head-dim / gqa-several-rows: grouped-query attention refuses heads
// that do not share out, a head RoPE cannot rotate, and more than one token per call. Taken, the
// first reads past the cache's row, and the last drops every row but the first.
// ==========================================
fn gqa_new(n_heads: Sz, n_kv_heads: Sz, head_dim: Sz, arena: Arena$@): nn.Gqa_attention<|F32|> //<
    //< An attention of those heads, 8 wide, with a cache of 4 positions
    io.out().s("about to make \{n_heads\} heads over \{n_kv_heads\}, \{head_dim\} wide\n")
    return nn.Gqa_attention<|F32|>.new(8, n_heads, n_kv_heads, head_dim, 4, 10000.0, arena)

fn gqa_several_rows(arena: Arena$@)
    $attn: = gqa_new(4, 2, 2, arena)
    shape: Sz[2] = ::{ 2, 8 }
    x: = Tensor<|F32|>.new(Sz[]::shape, arena)
    x.fill(0.5)
    _out: = attn.forward(x, 0)
    io.out().s("must not get here\n")

// ==========================================
// grad-small-out: a gradient written into an `out` smaller than its result must stop, not write
// past the end of a buffer reused from another step.
// ==========================================
fn grad_small_out(arena: Arena$@)
    dy_shape: Sz[2] = ::{ 2, 3 }
    w_shape: Sz[2] = ::{ 4, 3 }
    out_shape: Sz[2] = ::{ 1, 4 } // the result is [2, 4]
    $dy: = Tensor<|F32|>.new(Sz[]::dy_shape, arena)
    w: = Tensor<|F32|>.new(Sz[]::w_shape, arena)
    out: = Tensor<|F32|>.new(Sz[]::out_shape, arena)
    dy.grad_matmul_input_into(w, out)
    io.out().s("must not get here\n")

fn main(): I32
    argv: = sys.args()
    which: = argv.get(1) if argv.len == 2 else ""
    arena: = Arena.new(1024 * 1024)
    defer arena.free()
    if which.equals("tensor-null-arena")
        shape: Sz[2] = ::{ 1, 1 }
        _t: = Tensor<|F32|>.new(Sz[]::shape, null)
        io.out().s("must not get here\n")
    else if which.equals("header-null-arena")
        Safetensors.load_from_bytes("", null) catch {}
        io.out().s("must not get here\n")
    else if which.equals("adapters-null-arena")
        bytes: U8[10] = ::{ 2, 0, 0, 0, 0, 0, 0, 0, '{', '}' }
        sf: = Safetensors.load_from_bytes(U8[]::bytes, arena) catch panic("valid header")
        none: = Lora_widths::{ .in_dim = 0, .out_dim = 0 }
        Qkv_lora<|F32|>.load_set_from(sf, 0, none, none, null) catch {}
        io.out().s("must not get here\n")
    else if which.equals("view-null-arena") || which.equals("quant-null-arena")
        shape: Sz[2] = ::{ 1, 1 }
        $t: = Tensor<|F32|>.new(Sz[]::shape, arena)
        if which.equals("view-null-arena")
            t.view_rows(0, 1, null) catch {}
        else
            t.quantize(null) catch {}
        io.out().s("must not get here\n")
    else if which.equals("argmax-empty-logits")
        argmax_empty_logits(arena)
    else if which.equals("tensor-shape-product-overflow")
        tensor_shape_product_overflow(arena)
    else if which.equals("updater-weight-count")
        updater_weight_count(arena)
    else if which.equals("gqa-uneven-heads")
        _a: = gqa_new(3, 2, 2, arena)
        io.out().s("must not get here\n")
    else if which.equals("gqa-odd-head-dim")
        _a: = gqa_new(4, 2, 3, arena)
        io.out().s("must not get here\n")
    else if which.equals("gqa-several-rows")
        gqa_several_rows(arena)
    else if which.equals("grad-small-out")
        grad_small_out(arena)
    else
        // **An unknown name must not pass**: it says no reason, so its check fails.
        io.err().s("usage: stops <which>, one of: argmax-empty-logits\n")
            .s("  tensor-shape-product-overflow updater-weight-count gqa-uneven-heads\n")
            .s("  gqa-odd-head-dim gqa-several-rows grad-small-out\n")
        return 2
    return 0

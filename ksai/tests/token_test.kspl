//< Tokens in and out: the tokenizer's round trips, and the sampler's pick of the next token
import "ksai/sampler" as ai_sampler
import "ksai/tensor" { Tensor }
import "ksai/tokenizer" as ai_tokenizer
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/math"
import "std/mem" { Arena }
import "std/prng"
import "std/str"
import "std/sys"
import "std/verdict"

fn test_tokenizer_roundtrip(arena: Arena$@)
    verdict.start("[Tokenizer] decoding is symmetrical with encoding test...")
    $tok: = ai_tokenizer.Tokenizer(arena)

    tok.add_token("K", 1)
    tok.add_token("a", 2)
    tok.add_token("n", 3)
    tok.add_token("s", 4)
    tok.add_token("o", 5)
    tok.add_token(" ", 6)
    tok.add_token("an", 7)
    tok.add_token("so", 8)
    tok.add_token("Kan", 9)
    tok.add_token("Kanso", 10)
    tok.add_token("AI", 11)

    tok.add_merge(2, 3, 7) // a + n -> an
    tok.add_merge(4, 5, 8) // s + o -> so
    tok.add_merge(1, 7, 9) // K + an -> Kan
    tok.add_merge(9, 8, 10) // Kan + so -> Kanso
    text: = "Kanso AI"
    // Encodes with the space and AI split by hand (a real pre-pass splits at word boundaries first)
    tokens: = tok.encode("Kanso", arena)
    tokens.push(6) // Space
    tokens.push(11) // AI

    assert(tok.decode(tokens, arena).equals(text), "decode must invert encode")
    verdict
        .pass("decoding a sequence encoded through the merge table gives the original text back.")

fn test_tokenizer_cache_follows_additions(arena: Arena$@) //<
    //< A text encoded again after a rule is added uses the rule, and a repeat gives the same IDs
    //< Caution: **Encode before the addition too.** The first encoding fills the cache. So a
    //< cache kept past an addition would answer with the IDs from before it.
    verdict.start("[Tokenizer] the cache of merged chunks follows added rules")
    $tok: = ai_tokenizer.Tokenizer(arena)
    tok.add_token("a", 1)
    tok.add_token("b", 2)
    tok.add_token("ab", 3)
    before: = tok.encode("ab", arena)
    assert(before.len == 2, "with no rule, a and b stay apart")
    again: = tok.encode("ab", arena)
    assert(again.len == 2 && again[0] == 1 && again[1] == 2, "a repeat gives the same IDs")
    tok.add_merge(1, 2, 3)
    after: = tok.encode("ab", arena)
    assert(after.len == 1 && after[0] == 3, "the rule added after an encoding is taken")
    verdict.pass("a repeat is answered alike, and a rule added later is taken")

fn test_tokenizer_keeps_its_size() //<
    //< A tokenizer used for its lifetime grows only while its cache of chunks fills
    //< **Every result is on the caller's arena**, and a chunk past the cache's cap is merged in
    //< working lists freed before `encode` returns. A server keeps one tokenizer for its lifetime.
    //< So anything else it put on its own arena would grow without limit.
    verdict.start("[Tokenizer] encoding and decoding leave the tokenizer's arena as it was...")
    defer own: = Arena(1024 * 1024)
    $tok: = ai_tokenizer.Tokenizer(own)
    tok.add_token("a", 1)
    tok.add_token("b", 2)
    tok.add_token("ab", 3)
    tok.add_token(" ", 4)
    tok.add_merge(1, 2, 3)
    defer work: = Arena(64 * 1024)
    _warm: = tok.encode("ab ab", work)
    held: = own.get_total_used()
    for _i in Range.asc(1000)
        ids: = tok.encode("ab ab", work)
        assert(tok.decode(ids, work).equals("ab ab"), "the text decodes back")
        assert(tok.decode_one(3).equals("ab"), "one ID decodes to its word")
        work.reset()
    assert(own.get_total_used() == held, "a cached text adds nothing to the tokenizer")
    defer $long: = str.Str_builder()
    for _i in Range.asc(500)
        long.s("ab")
    _long: = tok.encode(long.slice(), work)
    work.reset()
    assert(own.get_total_used() == held, "a chunk too long for the cache adds nothing")
    // More distinct words than the cache holds, then new ones once it is full. Letters, since
    // each digit is a chunk of its own.
    defer $words: = str.Str_builder()
    for i in Range.asc(70000)
        words.c(' ')
        letters(i, words@)
    _full: = tok.encode(words.slice(), work)
    work.reset()
    full: = own.get_total_used()
    _past: = tok.encode(" zzzzza zzzzzb zzzzzc", work)
    assert(own.get_total_used() == full, "a word past the cache's cap adds nothing")
    verdict.pass("")

priv const LONG_WORD_BYTES: Sz = 256 * 1024 //< the long chunk's length: one word, one chunk
priv const LONG_WORD_WAIT_US: I64 = 10000000I64 //< how long its merging may take, generously
    //< A queue of pairs merges it in milliseconds, even under a sanitizer. Rescanning the chunk
    //< for each merge takes minutes, as the work grows with the square of the length.
priv const LONG_WORDS: U8[][_] = ::{ "a", "b", "c", "d", "aa", "ab", "cd", "abcd", "bc",
    "abcdabcd" } //< the long-chunk test's vocabulary; a word's ID is its place from 1

priv fn word_id(w: U8[]): I32 //< the ID `LONG_WORDS` gives a word; 0 for none
    for i in Range.asc(LONG_WORDS.len)
        if LONG_WORDS[i].equals(w)
            return I32::i + 1
    return 0

priv fn merged_as(tok: ai_tokenizer.Tokenizer$@, text: U8[], want: U8[], arena: Arena$@): Bool //<
    //< Whether the text encodes to the words `want` lists, separated by spaces
    got: = tok.encode(text, arena)
    words: = want.split(' ', arena)
    if got.len != words.len
        return false
    for i in Range.asc(got.len)
        if got[i] != word_id(words[i])
            return false
    return true

fn test_tokenizer_long_chunk(arena: Arena$@) //<
    //< One long word merges in time near its length, in the order a scan for the best pair gives
    //< A server tokenizes a whole request before it can refuse it, so a word of 256 KiB must not
    //< hold it. The short cases pin the order: the smallest rank first, the leftmost of one rank,
    //< and a pair that a merge forms taken by its own rank.
    verdict.start("[Tokenizer] a long chunk merges quickly, in the rank order")
    $tok: = ai_tokenizer.Tokenizer(arena)
    for w in LONG_WORDS
        tok.add_token(w, word_id(w))
    for rule in U8[][]::{ "a a aa", "a b ab", "c d cd", "ab cd abcd", "b c bc",
        "abcd abcd abcdabcd" }
        parts: = rule.split(' ', arena)
        tok.add_merge(word_id(parts[0]), word_id(parts[1]), word_id(parts[2]))
    assert(merged_as(tok@, "aaaaa", "aa aa a", arena), "the leftmost pair of a rank merges first")
    assert(merged_as(tok@, "bcd", "b cd", arena), "the smaller rank merges first")
    assert(merged_as(tok@, "abcdabcd", "abcdabcd", arena), "a pair a merge forms is merged too")
    defer $long: = str.Str_builder()
    for _i in Range.asc(LONG_WORD_BYTES / 4)
        long.s("abcd")
    started: = sys.mono_us()
    ids: = tok.encode(long.slice(), arena)
    took: = sys.mono_us() - started
    assert(took < LONG_WORD_WAIT_US, "merging a long chunk took longer than its bound")
    assert(ids.len == LONG_WORD_BYTES / 8, "each abcdabcd merges to one word")
    assert(tok.decode(ids, arena).equals(long.slice()), "the long chunk decodes back")
    verdict.pass("")

priv fn letters(n: Sz, out: str.Str_builder$@) //< a word of its own for each number, in a to p
    $v: = n
    for
        out.c('a' + U8::(v % 16))
        v /= 16
        if v == 0
            return

priv fn mapped(text: U8[], arena: Arena$@): U8[] //< the text in GPT-2's mapping of bytes
    //< By hand for the few bytes the samples hold: a space is `Ġ` and a newline `Ċ`.
    b: = arena.text()
    for c in text
        if c == ' '
            b.s("Ġ")
        else if c == '\n'
            b.s("Ċ")
        else
            b.c(c)
    return b.take()

priv const NORMAL: I32 = ai_tokenizer.TOKEN_NORMAL
priv const MARKER: I32 = ai_tokenizer.TOKEN_USER_DEFINED
priv const CONTROL: I32 = 3 //< GGUF's control token, such as `<|im_end|>`

fn test_tokenizer_load_lists(arena: Arena$@) //<
    //< `load_lists` reads a GGUF file's lists: GPT-2's mapping, the rules, the markers
    //< A user-defined marker becomes its ID even inside a text; a control token's text stays text.
    verdict.start("[Tokenizer] load_lists reads a GGUF vocabulary, markers included...")
    words: = U8[][]::{ "a", "b", "x", " ", "\n", "ab", " ab", "\n\n", "<think>", "<|x|>", "<", "|",
        ">" }
    $tokens: = List<|U8[]|>(arena)
    for w in words
        tokens.push(mapped(w, arena))
    tokens[8] = "<think>"
    tokens[9] = "<|x|>"
    types: = I32[]::{ NORMAL, NORMAL, NORMAL, NORMAL, NORMAL, NORMAL, NORMAL, NORMAL, MARKER,
        CONTROL, NORMAL, NORMAL, NORMAL }
    merges: = U8[][]::{ "a b", "Ġ ab", "Ċ Ċ" }
    $tok: = ai_tokenizer.Tokenizer(arena)
    tok.load_lists(tokens.slice(), types, merges) catch panic("a well-formed vocabulary must load")
    text: = " ab\n\nab<think>x<|x|>"
    ids: = tok.encode(text, arena)
    want: = I32[]::{ 6, 7, 5, 8, 2, 10, 11, 2, 11, 12 }
    assert(ids.len == want.len, "the text gives one ID per chunk and per marker")
    for i in Range.asc(want.len)
        assert(ids[i] == want[i],
            U8$[]::arena.text().s("ID \{i\} is \{ids[i]\}").take())
    assert(tok.decode(ids, arena).equals(text), "the IDs decode back to the text")
    assert(refused(tokens.slice(), I32[]::{ NORMAL }, merges).equals("types"), "a short type list")
    $raw: = List<|U8[]|>(arena)
    for t in tokens
        raw.push(t)
    raw[3] = " " // a space is not in GPT-2's mapping: the mapping writes it `Ġ`
    assert(refused(raw.slice(), types, merges).equals("tokens"), "a byte outside the mapping")
    raw[3] = "a"
    assert(refused(raw.slice(), types, merges).equals("tokens"), "two words with the same bytes")
    assert(refused(tokens.slice(), types, U8[][]::{ "b a" }).equals("merges"),
        "a merge into no word")
    assert(refused(tokens.slice(), types, U8[][]::{ "ab" }).equals("merges"),
        "a merge with no space")
    verdict.pass("words, rules and markers load; each damaged entry is named by its list.")

priv fn refused(tokens: U8[][], types: I32[], merges: U8[][]): U8[] //<
    //< The list `load_lists` names as damaged, or empty where it takes them
    defer scratch: = Arena(64 * 1024)
    $tok: = ai_tokenizer.Tokenizer(scratch)
    tok.load_lists(tokens, types, merges) catch e
        switch e
        case .broken(list, _entry)
            return list
        default
            return "io"
    return ""

priv fn broken_line(vocab: U8[], merges: U8[]): Sz //<
    //< The line `load` names as broken in the pair written out, or 0 where it takes them
    dir: = "out/tmp/ksai_tokenizer_load"
    fs.mkdir_all(dir) catch panic("the work directory must be creatable")
    io.write_file("out/tmp/ksai_tokenizer_load/vocab.txt", vocab) catch panic("vocab must write")
    io.write_file("out/tmp/ksai_tokenizer_load/merges.txt", merges) catch panic("merges must write")
    defer scratch: = Arena(1024 * 1024)
    $tok: = ai_tokenizer.Tokenizer(scratch)
    tok.load("out/tmp/ksai_tokenizer_load/vocab.txt", "out/tmp/ksai_tokenizer_load/merges.txt")
        catch e
        switch e
        case .broken(_path, line)
            return line
        default
            panic("the files written must be readable")
    return 0

fn test_tokenizer_load(arena: Arena$@) //<
    //< `load` reads what `train_bpe.kspl` writes, and refuses a damaged line by its number
    //< **A line skipped in silence** would make every text it touches encode to other IDs.
    verdict.start("[Tokenizer] load reads the two files, and names a damaged line...")
    vocab: = "0\t\n1\t61\n2\t62\n3\t6162\n"
    merges: = "1 2 3\n"
    dir: = "out/tmp/ksai_tokenizer_load"
    fs.mkdir_all(dir) catch panic("the work directory must be creatable")
    io.write_file("out/tmp/ksai_tokenizer_load/vocab.txt", vocab) catch panic("vocab must write")
    io.write_file("out/tmp/ksai_tokenizer_load/merges.txt", merges) catch panic("merges must write")
    $tok: = ai_tokenizer.Tokenizer(arena)
    tok.load("out/tmp/ksai_tokenizer_load/vocab.txt", "out/tmp/ksai_tokenizer_load/merges.txt")
        catch panic("the files train_bpe.kspl would write must load")
    ids: = tok.encode("ab", arena)
    assert(ids.len == 1 && ids[0] == 3, "the merge loaded joins a and b into 3")
    assert(tok.decode(ids, arena).equals("ab"), "the word loaded decodes back")
    assert(broken_line("0\t\n1\t6\n", merges) == 2, "an odd hex digit is refused")
    assert(broken_line("0\t\n1x\t61\n", merges) == 2, "an ID with a letter in it is refused")
    assert(broken_line("0\t\n1 61\n", merges) == 2, "a line with no tab is refused")
    assert(broken_line("1\t9999999999\n9999999999\t61\n", merges) == 2, "an ID past I32 is refused")
    assert(broken_line(vocab, "\n1 2\n") == 2, "a merge with two IDs is refused")
    assert(broken_line("0\t\r\n1\t61\r\n", "1 1 2\r\n") == 0, "CRLF line ends are taken")
    $bare: = ai_tokenizer.Tokenizer(arena)
    $named: U8[] = ""
    bare.load_text("0\t\n1\t61\n", "1 2\n") catch e
        switch e
        case .broken(path, _line)
            named = path
        default {}
    assert(named.equals("merges"), "load_text names the text a damaged line is in")
    verdict.pass("the two files load into working rules, and each damaged line is named.")

// ==========================================
// ksai/sampler: tests where the next token is picked.
//
// **The random numbers themselves are not tested here.** `std`'s tests check that a fixed seed
// repeats its sequence and that the OS's randomness can be read. Here the only question is whether,
// from the same logits, the settings pick the expected token.
// ==========================================
fn test_sampler(arena: Arena$@)
    verdict.start("[Sampler] argmax/temperature/top-k test...")
    // logits = [1.0, 3.0, 2.0, 0.5] → the largest is index 1
    shape: Sz[1] = ::{ 4 }
    logits: = Tensor<|F32|>(Sz[]::shape, arena)
    (logits.data + 0)$ = F32::1.0
    (logits.data + 1)$ = F32::3.0
    (logits.data + 2)$ = F32::2.0
    (logits.data + 3)$ = F32::0.5

    assert(ai_sampler.argmax(logits) == 1, "Sampler: argmax must pick the max index")

    $rng: = prng.Prng(7U64)
    // A temperature of 0 or below reduces to the greedy method (argmax)
    greedy: = ai_sampler.Sample_config.greedy()
    tok: = ai_sampler.sample(logits, greedy, rng@, arena)
    assert(tok == 1, "Sampler: temperature<=0 must fall back to argmax")
    // top_k=1 leaves only the largest value as a candidate → it always returns the argmax
    top1: = ai_sampler.Sample_config::{ .temperature = 1.0, .top_k = 1, .top_p = 1.0 }
    for _i in Range.asc(20)
        top1_tok: = ai_sampler.sample(logits, top1, rng@, arena)
        assert(top1_tok == 1, "Sampler: top_k=1 must always return the argmax token")
    verdict.pass("")
priv fn insertion_pick(logits: Tensor<|F32|>, cfg: ai_sampler.Sample_config, rng: prng.Prng$@,
    arena: Arena$@): I32 //<
        //< The pick by a stable insertion sort, the plain reading of `sample`'s rank order
        //< Each step's arithmetic is the same as `sample`'s, so the same seed has to give the
        //< same token: a difference is the order, ties included.
    n: = logits.size
    probs: = F64$@::arena.alloc(n * sizeof(F64))
    idx: = Sz$@::arena.alloc(n * sizeof(Sz))
    $max_logit: = (logits.data$) / cfg.temperature
    for i in Range.asc(n)
        v: = ((logits.data + i)$) / cfg.temperature
        if v > max_logit
            max_logit = v
    $sum_exp: = 0.0
    for i in Range.asc(n)
        (probs + i)$ = math.exp(((logits.data + i)$) / cfg.temperature - max_logit)
        (idx + i)$ = i
        sum_exp += (probs + i)$
    for i in Range.asc(n)
        (probs + i)$ = (probs + i)$ / sum_exp
    // With neither cut, the candidates are walked unranked, in ID order.
    ranked: Sz = n if cfg.top_k > 0 || cfg.top_p < 1.0 else 0
    for i in Range(1, ranked, 1)
        cur: = (idx + i)$
        $j: = i - 1
        for j >= 0 && (probs + (idx + j)$)$ < (probs + cur)$
            (idx + j + 1)$ = (idx + j)$
            j -= 1
        (idx + j + 1)$ = cur
    $keep: = cfg.top_k if cfg.top_k > 0 && cfg.top_k < n else n
    if cfg.top_p < 1.0
        $cum: = 0.0
        for i in Range.asc(keep)
            cum += (probs + (idx + i)$)$
            if cum >= cfg.top_p
                keep = i + 1
                break
    $total: = 0.0
    for i in Range.asc(keep)
        total += (probs + (idx + i)$)$
    u: = rng.next_f64() * total
    $acc: = 0.0
    for i in Range.asc(keep)
        acc += (probs + (idx + i)$)$
        if acc >= u
            return I32::(idx + i)$
    return I32::(idx + (keep - 1))$

fn test_sampler_keeps_the_rank_order() //<
    //< That top-k and top-p cut the candidates in rank order, a tie going to the lower ID
    //< **Logits drawn from five values tie often**, so a cut that keeps the wrong one of two equal
    //< candidates changes the pick. The large vocabulary is a real model's: ranked by a sort that
    //< costs O(n²), one token takes seconds.
    verdict.start("[Sampler] top-k / top-p pick as a stable sort would, on any vocabulary size...")
    defer arena: = Arena(1024 * 1024)
    $draw: = prng.Prng(11U64)
    for trial in Range.asc(300)
        mark: = arena.save()
        shape: Sz[1] = ::{ 1 + draw.below(40) }
        logits: = Tensor<|F32|>(Sz[]::shape, arena)
        for i in Range.asc(logits.size)
            (logits.data + i)$ = F32::draw.below(5) * F32::0.75
        cfg: = ai_sampler.Sample_config::{ .temperature = 0.5 + F64::(trial % 3),
            .top_k = draw.below(12), .top_p = 1.0 if trial % 2 == 0 else 0.6 }
        $want_rng: = prng.Prng(U64::trial)
        $got_rng: = prng.Prng(U64::trial)
        for _round in Range.asc(8)
            want: = insertion_pick(logits, cfg, want_rng@, arena)
            got: = ai_sampler.sample(logits, cfg, got_rng@, arena)
            assert(got == want, "Sampler: top-k / top-p must keep the stable rank order")
        arena.restore(mark)
    vocab_shape: Sz[1] = ::{ 151936 }
    vocab: = Tensor<|F32|>(Sz[]::vocab_shape, arena)
    for i in Range.asc(vocab.size)
        (vocab.data + i)$ = F32::draw.below(1000) * F32::0.01
    wide: = ai_sampler.Sample_config::{ .temperature = 0.8, .top_k = 40, .top_p = 0.95 }
    nucleus: = ai_sampler.Sample_config::{ .temperature = 0.8, .top_k = 0, .top_p = 0.95 }
    $rng: = prng.Prng(5U64)
    for _round in Range.asc(4)
        mark: = arena.save()
        top: = ai_sampler.sample(vocab, wide, rng@, arena)
        assert(top >= 0 && Sz::top < vocab.size, "Sampler: a large vocabulary still picks an ID")
        any: = ai_sampler.sample(vocab, nucleus, rng@, arena)
        assert(any >= 0 && Sz::any < vocab.size, "Sampler: top-p alone ranks it all")
        arena.restore(mark)
    verdict.pass("")

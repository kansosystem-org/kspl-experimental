//< Symmetric int8 quantization for weights, with its own scale per row
//<
//< **The aim is to save memory, not to speed up the arithmetic.** Right before a matrix product it
//< expands the weights back to `F32`/`F64` once. It then uses the existing matmul unchanged, so the
//< auto-vectorization and the numerics stay exactly as they are.

// ==========================================
// It is a separate, optional part, following ksai's rule (as with BLAS) of "no dependencies by
// default; add only the parts you need".
// ==========================================
import "ksai/tensor" + { Tensor }
import "std/math"
import "std/mem" { Arena }

pub struct Quantized_tensor //< a weight matrix stored one byte per element, with a scale per row
    //<
    //< dequantized[i][j] = data[i][j] * scales[i]. The quantization is symmetric, so it holds no
    //< zero point, and a quantized value is kept within [-127, 127].
    pub data: I8$@ //< the quantized values, rows*cols of them, row by row
    priv scales: F64$@ //< what each row's values are multiplied by to restore them, one per row
    pub rows: Sz //< how many rows, each with a scale of its own
    pub cols: Sz //< how many columns

impl<|T|> Tensor<|T|>
    pub fn quantize( //< the same matrix at one byte per element; a rank other than 2 is rejected
        //<
        //< **The caller chooses where to allocate.** Memory is saved only if the original is
        //< dropped after quantizing; on the original's arena, dropping it would drop the quantized
        //< copy too.
        r: Self$@,
        arena: Arena$@, //< the arena to allocate from, so the original can be discarded afterwards
    ): Quantized_tensor!tensor.Tensor_error
        tensor.require_arena(arena)
        if r.shape.len != 2
            throw .rank_mismatch
        rows: = r.shape[0]
        cols: = r.shape[1]
        data: = I8$@::arena.alloc(rows * cols * sizeof(I8))
        scales: = F64$@::arena.alloc(rows * sizeof(F64))

        for row in Range.asc(rows)
            row_off: = row * cols
            $max_abs: F64 = 0.0
            for j in Range.asc(cols)
                v: = F64::(r.data + row_off + j)$
                av: = -v if v < 0.0 else v
                if av > max_abs
                    max_abs = av
            // The scale is max_abs / 127; an all-zero row uses 1 (no division by zero, and its
            // values are 0 anyway).
            scale: = (max_abs / 127.0) if max_abs > 0.0 else 1.0
            (scales + row)$ = scale
            inv_scale: = 1.0 / scale
            // Rounds and clamps to [-127, 127] (symmetric; -128 is unused)
            for j in Range.asc(cols)
                v: = F64::(r.data + row_off + j)$
                q: = math.round(v * inv_scale)
                clamped: = 127.0 if q > 127.0 else (-127.0 if q < -127.0 else q)
                (data + row_off + j)$ = I8::clamped
        return Quantized_tensor::{
            .data = data,
            .scales = scales,
            .rows = rows,
            .cols = cols,
        }

impl Quantized_tensor
    pub fn dequantize<|T|>( //< the matrix restored to full width, ready for a normal matrix product
        //<
        //< After that, the existing matmul and the rest work unchanged.
        r: Self$@,
        arena: Arena$@, //< the arena to allocate from; usually a short-lived one, not the weights'
    ): Tensor<|T|>
        out_shape: Sz[2] = ::{ r.rows, r.cols }
        out: = Tensor<|T|>.new(Sz[]::out_shape, arena)
        for row in Range.asc(r.rows)
            row_off: = row * r.cols
            scale: = (r.scales + row)$
            for j in Range.asc(r.cols)
                qv: = F64::(r.data + row_off + j)$
                (out.data + row_off + j)$ = T::(qv * scale)
        return out

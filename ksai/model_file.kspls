//< Reads a ksai model from a file, and writes one back
//<
//< **This is the only place in `ksai` that imports `std/io`.** Both safetensors and lora take an
//< already parsed `Safetensors` and a writer to write into, so bare-metal code skips this file:
//< it passes `embed`ed bytes through `Safetensors.load_from_bytes`, and gets its bytes back from
//< `Safetensors_writer.finish()`.
import "ksai/lora_set"
import "ksai/safetensors" as st
import "std/io"
import "std/mem" { Arena }

pub fn load_safetensors( //< reads and parses a model file; the result owns the bytes it read
  //<
  //< The result **owns** the bytes it read (`free()` releases them). Ownership is the opposite of
  //< `load_from_bytes`, so confusing the two gives a double free or a leak.
  path: U8[], //< the file to read
  arena: Arena$@, //< the arena the name-to-tensor index is allocated from
): st.Safetensors?st.Safetensors_error //< the parsed file; fails if it cannot be read or parsed
  file_data: = io.read_file(path) catch
    throw st.Safetensors_error.read_failed
  $s: = st.Safetensors.load_from_bytes(file_data, arena)?
  s.owns_data = true
  return s

pub fn save_safetensors( //< writes what a writer has collected as a model file
  w: st.Safetensors_writer$@, //< the writer, closed by this call
  path: U8[], //< the file to write; it is created
): Void?st.Safetensors_error
  $out: = w.finish()
  defer out.free()
  io.write_file(path, out.slice()) catch
    throw st.Safetensors_error.write_failed

pub fn load_qkv_lora_set<|T|>( //< reads every block's attention adapters directly from a file
  //<
  //< The names read are "blocks.{i}.attn.{q,v}.lora_*".
  path: U8[], //< the adapter file to read
  n_layers: Sz, //< how many blocks to look for; a missing one is an error
  arena: Arena$@, //< the arena the array and every matrix in it are allocated from
): lora_set.Qkv_lora<|T|>$@?st.Safetensors_error //< one adapter per block, `n_layers` of them
  s: = load_safetensors(path, arena)?
  return lora_set.Qkv_lora<|T|>.load_set_from(s, n_layers, arena)?

pub fn save_qkv_lora_set<|T|>( //< the inverse of `load_qkv_lora_set`: writes adapters to a file
  adapters: lora_set.Qkv_lora<|T|>$@, //< the array to write, one per block
  n_layers: Sz, //< how many of them are written
  path: U8[], //< the file to write; it is created
  arena: Arena$@, //< the arena the one-element tensor holding `scale` is allocated from
): Void?st.Safetensors_error
  $w: = st.Safetensors_writer.new()
  lora_set.Qkv_lora<|T|>.save_set_into(adapters, n_layers, w@, arena)
  save_safetensors(w@, path)?

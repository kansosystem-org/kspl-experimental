//< A faithful native inference engine for the Qwen2.5 family, and the CLI that drives it
//< The model, and how it is read from the exported safetensors, are in `model.kspl` beside this
//< file. This file reads the input, runs the model and prints the answer.

// ==========================================
// **`ksai/tests/examples_qwen.kspl` tests mode 1's answer** (`make test` in this package).
// ==========================================
import "ksai/examples/qwen_infer/model" { Qwen_model }
import "ksai/lora_set"
import "ksai/sampler"
import "ksai/tensor" { Tensor }
import "ksai/tokenizer"
import "std/chars" // `is_digit`
import "std/ds" { List }
import "std/io"
import "std/math"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/sys"

priv const MAX_SEQ: Sz = 4096 // the cap on the KV cache taken (a practical cap for the demo, not a constraint of the model itself)
priv const GEN_MAX: Sz = 64 // the cap on generate mode's autoregressive steps (likewise)

fn read_tokens(arena: Arena$@): List<|I32|>$@ //<
    //< Reads non-negative integers from standard input into an I32 list; any other byte separates
    //< It is for mode 1. An ID past I32 is dropped with a warning, not cut into another valid ID.
    list: = List<|I32|>.create(arena)
    defer $word: = Str_builder()
    for
        // A failed read ends the list as the end of input does; the warning says which.
        c: = io.getchar() catch
            io.err().s("[warn] reading standard input failed; the IDs read so far are used\n")
            fallback .none
        if got: = c
            if got.is_digit()
                word.c(got)
                continue
        if word.len > 0
            if id: = tokenizer.parse_token_id(word.slice())
                list.push(id)
            else
                io.err().s("[warn] token ID overflowed I32 range, skipping\n")
            word.clear()
        if c.is_none()
            break
    return list

priv fn outside_vocab(ids: List<|I32|>$@, vocab: Sz): Bool //<
    //< Whether a token ID falls outside the model's table, said on standard error
    //< Caution: **Check before the first step**, not inside it. The embedding's own bound is a
    //< panic, which reads as a crash rather than as a bad input.
    for t in ids
        if t < 0 || Sz::t >= vocab
            io.err()
                .s("[Error] token ID \{t\} is outside the model's vocabulary of \{I32::vocab\}\n")
            return true
    return false

fn cmd_logits(a: sys.Args, arena: Arena$@): Bool //< prints the logits; false after an error
    model_path: = "out/qwen_kspl.safetensors" if a.len < 2 else a[1]
    $m: = Qwen_model<|F32|>.load(model_path, MAX_SEQ, arena) catch
        io.err().s("[Error] model load failed: \{model_path\}\n")
        return false
    io.err().s("[qwen] loaded: layers=\{I32::m.cfg.n_layers\} hidden=\{I32::m.cfg.hidden\} ")
    io.err()
        .s("heads=\{I32::m.cfg.n_heads\}/\{I32::m.cfg.n_kv_heads\} vocab=\{I32::m.cfg.vocab\}\n")

    $adapters: lora_set.Qkv_lora<|F32|>$@ = null
    if a.len >= 3
        adapters = m.load_lora_set(a[2], arena) catch
            io.err().s("[Error] LoRA load failed: \{a[2]\}\n")
            return false
        io.err().s("[qwen] LoRA adapter loaded: \{a[2]\}\n")

    tokens: = read_tokens(arena)
    if tokens.len == 0
        io.err().s("[Error] there is no token ID on standard input\n")
        return false
    if tokens.len > MAX_SEQ
        io.err()
            .s("[Error] input has \{I32::tokens.len\} tokens, exceeds max_seq=\{I32::MAX_SEQ\}\n")
        return false
    if outside_vocab(tokens, m.cfg.vocab)
        return false

    $logits: = Tensor<|F32|>(Sz$[]::{ .ptr = null, .len = 0 }, arena)
    for i in Range.asc(tokens.len)
        defer ca: = Arena(1024 * 1024 * 64)
        logits = m.forward(tokens[i], i, adapters, ca)
        if i == tokens.len - 1
            logits = logits.dup(arena) // copied so it survives ca being freed

    io.out().s("ARGMAX \{sampler.argmax(logits)\}\n")
    io.out().s("LOGITS[0:10]")
    n: = math.min(logits.size, 10)
    for i in Range.asc(n)
        io.out().s(" \{(logits.data + i)\}")
    io.out().s("\n")
    return true

fn cmd_generate(a: sys.Args, arena: Arena$@): Bool //<
    //< generates from a prompt; false after an error
    if a.len < 6
        io.err()
            .s("usage: qwen_infer generate <model.safetensors> <vocab.txt> <merges.txt> <eos_id> \
                [lora.safetensors]\n")
        return false
    model_path: = a[2]
    vocab_path: = a[3]
    merges_path: = a[4]
    // Caution: **Refuse an eos_id that is no token ID.** Read as 0, a typo would stop the
    // generation at the first token 0 rather than at the end of the text.
    $eos_id: I32 = 0
    if id: = tokenizer.parse_token_id(a[5])
        eos_id = id
    else
        io.err().s("[Error] eos_id is not a token ID: '\{a[5]\}'\n")
        return false

    $m: = Qwen_model<|F32|>.load(model_path, MAX_SEQ, arena) catch
        io.err().s("[Error] model load failed: \{model_path\}\n")
        return false
    if Sz::eos_id >= m.cfg.vocab
        io.err().s("[Error] eos_id \{eos_id\} is outside the model's vocabulary of ")
            .s("\{I32::m.cfg.vocab\}\n")
        return false
    $adapters: lora_set.Qkv_lora<|F32|>$@ = null
    if a.len >= 7
        adapters = m.load_lora_set(a[6], arena) catch
            io.err().s("[Error] LoRA load failed: \{a[6]\}\n")
            return false
        io.err().s("[qwen] LoRA adapter loaded: \{a[6]\}\n")

    $tok: = tokenizer.Tokenizer(arena)
    tok.load(vocab_path, merges_path) catch e
        switch e
        case .broken(path, line)
            io.err().s("[Error] the tokenizer's \{path\}:\{line\} is not an entry\n")
        default
            io.err().s("[Error] tokenizer load failed: \{vocab_path\}, \{merges_path\}\n")
        return false

    prompt: = io.read_stdin(arena) catch
        io.err().s("[Error] standard input could not be read\n")
        return false
    ids: = tok.encode(prompt, arena)
    if ids.len == 0
        io.err().s("[Error] an empty prompt\n")
        return false
    if ids.len > MAX_SEQ
        io.err().s("[Error] prompt has \{I32::ids.len\} tokens, exceeds max_seq=\{I32::MAX_SEQ\}\n")
        return false
    // A tokenizer that is not the model's gives IDs past its table.
    if outside_vocab(ids, m.cfg.vocab)
        return false
    io.err().s("[qwen] prompt tokens=\{I32::ids.len\}\n")

    // Up to here it is cmd_logits' main loop; from here on is the autoregressive generation
    // (argmax → the EOS check → feeding the next token).
    $pos: Sz = 0
    $logits: = Tensor<|F32|>(Sz$[]::{ .ptr = null, .len = 0 }, arena)
    for i in Range.asc(ids.len)
        defer ca: = Arena(1024 * 1024 * 64)
        logits = m.forward(ids[i], pos, adapters, ca)
        pos += 1
        if i == ids.len - 1
            logits = logits.dup(arena)

    gen: = List<|I32|>.create(arena)
    for _step in Range.asc(GEN_MAX)
        next: = sampler.argmax(logits)
        if next == eos_id || pos >= MAX_SEQ
            break
        gen.push(next)
        defer ca: = Arena(1024 * 1024 * 64)
        $step_logits: = m.forward(next, pos, adapters, ca)
        logits = step_logits.dup(arena)
        pos += 1

    io.out().s(tok.decode(gen, arena))
    io.out().s("\n")
    return true

fn main() //<
    //< Runs a small Qwen: prints the logits for token IDs, or generates text from a prompt
    //< `echo "3 1 4" | qwen_infer [out/qwen_kspl.safetensors [lora.safetensors]]` prints logits;
    //< `echo "let n = " | qwen_infer generate <model> <vocab.txt> <merges.txt> <eos_id> [lora]`
    //< generates (for Qwen2.5-Coder-0.5B, eos_id is 151643 = config.json's eos_token_id).
    a: = sys.args()
    arena: = Arena(1024 * 1024 * 64)
    // **An error ends the run with 1**, so a script or a test sees it; each command has said why.
    ok: =
        (cmd_generate(a, arena) if a.len >= 2 && a[1].equals("generate")
        else cmd_logits(a, arena))
    arena.free()
    if !ok
        sys.exit(1)

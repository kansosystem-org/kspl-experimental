//< Reads and writes the industry-standard safetensors format: a JSON header and raw bytes
//< **The read is zero-copy.** A `Tensor` is a view into the raw bytes. So inference can run
//< straight from weights embedded as bytes on a Cortex-M with no file system.

// ==========================================
// **The code that writes this format from a checkpoint lives elsewhere**: a separate
// implementation converts an HF/PyTorch checkpoint, a deliberate duplication.
// **Do not name a package that depends on this one here** (the reference direction is the table
// in docs/SPEC-documents.md).
// ==========================================
import "ksai/tensor" + { Tensor }
import "std/bytes" // `get_u64_le` / `put_u64_le`
import "std/json"
import "std/mem" + { Arena }
import "std/str" { Str_builder }

pub enum Safetensors_error //< why a weights file could not be read or written
    //< I/O, a broken header and a missing tensor are recoverable run-time conditions. So they
    //< propagate as an error union (?E) for the caller to handle.
    read_failed //< the file could not be read
    write_failed //< the file could not be written
    too_small //< the file is shorter than the 8-byte header length
    invalid_header //< the JSON header could not be parsed
    tensor_not_found(name: U8[]) //< the header has no tensor of that name
    dtype_mismatch(name: U8[]) //< the file's element width is not the one being read, naming it
    shape_mismatch(name: U8[]) //< the file's shape is not the one expected, naming the tensor

priv fn dtype_bytes(name: U8[]): Sz //<
    //< the size in bytes of one element of the named dtype
    //< Caution: **Do not let an unknown dtype through in the hope that it works.** The content is
    //< just bytes. A read at another width garbles the numbers with no error. F16 read as F32
    //< turns two elements into one meaningless value. Only the width is checked, so F32 and
    //< I32 are not told apart.
    if name.equals("F64") || name.equals("I64") || name.equals("U64")
        return 8
    if name.equals("F32") || name.equals("I32") || name.equals("U32")
        return 4
    if name.equals("F16") || name.equals("BF16") || name.equals("I16") || name.equals("U16")
        return 2
    if name.equals("I8") || name.equals("U8") || name.equals("BOOL")
        return 1
    return 0

pub struct Safetensors //< a parsed header and weights, borrowed for their arenas' lifetimes
    priv raw_data: U8[]
    priv header: json.Value
    priv data_offset: Sz

impl Safetensors
    pub fn load_from_bytes( //< reads the header of a file the caller already holds in memory
        //< **The function that opens a file lives elsewhere** (`ksai/model_file`): here it would
        //< need `std/io`, and code that only uses tensors would pay for file I/O. The bytes belong
        //< to the caller (typically `embed "model.safetensors" as model_bytes;`) and must outlive
        //< every tensor borrowing them.
        file_data: U8[], //< the whole file, borrowed from the caller
        arena: Arena$@, //< the arena the header's parts are allocated from
    ): Safetensors!Safetensors_error
        tensor.require_arena(arena)
        if file_data.len < 8
            throw .too_small
        // The JSON header's size is the leading 8 bytes (little endian).
        // Caution: Sz is 32-bit under cfg(freestanding), so **finish the range check while the
        // value is still U64, and convert to Sz after.** Converted first, header_len wraps on a
        // 32-bit target and slips past the bounds check.
        header_len_u64: = file_data.get_u64_le(0)
        // A broken or malicious header length must not read outside the file.
        if header_len_u64 > U64::(file_data.len - 8)
            throw .invalid_header
        header_len: = Sz::header_len_u64
        json_str: = U8[]::{ .ptr = file_data.ptr + 8, .len = header_len }
        metadata: = json.parse(json_str, arena) catch
            throw .invalid_header

        return Safetensors::{ .raw_data = file_data, .header = metadata.val,
            .data_offset = 8 + header_len }
    pub fn metadata(r: Self@): json.Value //< the header; its values live in the parsing arena
        return r.header

    pub fn get_tensor<|T|>( //< one tensor, borrowing aligned elements or copying misaligned ones
        //< Caution: **An aligned result borrows from the file.** Its elements are not copied, so
        //< the backing bytes must stay alive while the tensor is used. A misaligned result uses
        //< an aligned copy in the supplied arena instead.
        r: Self$@,
        name: U8[], //< the tensor's name as the header spells it
        arena: Arena$@, //< the arena for the shape; the elements stay in the file's bytes
    ): Tensor<|T|>!Safetensors_error
        tensor.require_arena(arena)
        t_info: = r.header.get(name)
        switch t_info
        case .null_val
            throw .tensor_not_found(name)
        default {}
        // **Check the dtype first** (the reason is at dtype_bytes).
        if dtype_bytes(t_info.get("dtype").as_str().unwrap_or("")) != sizeof(T)
            throw .dtype_mismatch(name)
        // The data offset (read with as_int64, since files can exceed 2GB)
        // An offset that is absent or no integer reads as -1, which the range checks refuse.
        offsets: = t_info.get("data_offsets")
        start_raw: = offsets.get_at(0).as_int64().unwrap_or(-1)
        // A negative offset, or one beyond the raw data's range, is rejected.
        // Caution: **Compare before converting to `Sz`** (for the same reason as the header
        // length). Converted first, a value past 2^32 wraps into range and slips past the bounds
        // check. Then **the neighbouring tensor's content silently comes out as this tensor's
        // values**.
        body_len: = r.raw_data.len - r.data_offset
        if start_raw < 0 || U64::start_raw > U64::body_len
            throw .invalid_header
        start: = Sz::start_raw
        $shape: = t_info.get("shape").arr_list(arena)
        defer shape.free()
        ndim: = shape.len
        // The file's remaining elements bound the product before it can overflow.
        avail: = (r.raw_data.len - r.data_offset - start) / sizeof(T)
        $size: Sz = 1
        for $i: = I32::ndim - 1; i >= 0; i -= 1
            // Caution: **Read it as 64 bits and compare before converting** (as the offsets are).
            // Read as I32, `4294967297` became 1, and the file was taken for a shape another reader
            // refuses.
            dim: = shape.get(i).as_int64().unwrap_or(-1)
            if dim < 0 || U64::dim > U64::tensor.MAX_TENSOR_ELEMS
                throw .invalid_header
            s: = Sz::dim
            if s > 0 && size > avail / s
                throw .invalid_header
            size *= s
        // avail bounds it only by the file's size. A huge but real file can hold a dimension past
        // I32's range. It is truncated where it reaches a BLAS FFI as an I32 (see tensor.kspl).
        // So `new`'s cap, tensor.max_tensor_elems, applies here too, and this path cannot bypass
        // it.
        if size > tensor.MAX_TENSOR_ELEMS
            throw .invalid_header
        // Caution: **Check `data_offsets`' end too.** A size from `shape` alone can read past the
        // declared range while staying inside the file. Then it passes the bounds check and returns
        // the neighbouring tensor's content (as above). In a valid file the two always agree.
        end_raw: = offsets.get_at(1).as_int64().unwrap_or(-1)
        if end_raw < start_raw || U64::end_raw > U64::body_len
            throw .invalid_header
        if Sz::end_raw - start != size * sizeof(T)
            throw .invalid_header
        shape_ptr: = Sz$@::arena.alloc(ndim * sizeof(Sz))
        for i in Range.asc(ndim)
            (shape_ptr + i)$ = Sz::shape.get(i).as_int64().unwrap_or(0)
        at: = r.raw_data.ptr + r.data_offset + start
        // Caution: **Copy a misaligned tensor, do not read it in place.** The format does not
        // require the header to pad the data to the element's width. A caller's bytes need not be
        // aligned either. A misaligned load is undefined in C and faults on Cortex-M. An aligned
        // one stays zero-copy.
        $data_ptr: = T$@::at
        if Sz::at % sizeof(T) != 0
            data_ptr = T$@::arena.alloc(size * sizeof(T))
            mem.copy(Void$@::data_ptr, Void$@::at, size * sizeof(T))

        return Tensor<|T|>.from_raw_parts(data_ptr, shape_ptr, ndim, size, arena)
    pub fn map_into<|T|>( //< maps one tensor from the file into `dst`, rejecting a different shape
        //< Caution: **Check the shape before swapping the weights in.** The model is built with its
        //< own dimensions. Weights that do not fit fail later in some matmul, with no hint of
        //< which tensor differs. Typically, a different checkpoint was passed.
        r: Self$@,
        name: U8[], //< the tensor's name as the header spells it
        dst: Tensor<|T|>$@, //< the tensor whose weights are replaced; the file's shape must match it
        arena: Arena$@, //< the arena the shape is allocated from
    ): Void!Safetensors_error
        want: = dst.shape
        got: = r.get_tensor<|T|>(name, arena)!
        if got.shape.len != want.len
            throw .shape_mismatch(name)
        for i in Range.asc(want.len)
            if got.shape[i] != want[i]
                throw .shape_mismatch(name)
        dst$ = got

pub struct Safetensors_writer //< collects tensors one at a time and writes one file at the end
    //< Writes trained weights (F32, row-major contiguous) out in the safetensors format. `add` puts
    //< the name into the header and the bytes into the data. `save` writes one file.
    //< data_offsets follows the order added, so it streams without holding on to the tensors.
    pub head: Str_builder //< the JSON header being built
    pub data: Str_builder //< the tensors' raw bytes, joined in the order added
    pub meta: Str_builder //< what goes under `__metadata__`; nothing is written when it is empty
    pub count: Sz //< how many tensors have been added

impl Safetensors_writer
    pub fn new(): Safetensors_writer //< an empty writer; `finish()` frees it
        //< **It takes no arena.** `finish()` frees head, data and meta, so they must live on the
        //< heap. An `_in` would misstate where the memory goes ("A constructor's name says
        //< where the returned thing goes" in `std/README.md`).
        $head: = Str_builder.new()
        head.s("{")
        return Safetensors_writer::{ .head = head, .data = Str_builder.new(),
            .meta = Str_builder.new(), .count = 0 }
    pub fn set_meta( //< one entry under `__metadata__`; the order of calls does not matter
        //< `__metadata__` is safetensors' standard optional table of strings, for what a reader
        //< needs in order to use the weights (a preprocessing constant, the format's version).
        //< finish writes them all at the end.
        //< Caution: **Do not pass a name containing `"` or `\`.** This does no JSON escaping (nor
        //< does add, which writes tensor names).
        r: Self$@,
        key: U8[], //< the entry's name
        value: U8[], //< its value, written as text
    )
        if r.meta.len > 0
            r.meta.s(",")
        r.meta.s("\"\{key\}\":\"\{value\}\"")
    pub fn add( //< appends one more tensor; its position in the file follows the order added
        r: Self$@,
        name: U8[], //< the tensor's name, written into the header
        t: Tensor<|F32|>, //< the tensor, whose bytes are copied in
    )
        start: = r.data.len
        nbytes: = t.size * sizeof(F32)
        if r.count > 0
            r.head.s(",")
        r.head.s("\"\{name\}\":{\"dtype\":\"F32\",\"shape\":[")
        for j in Range.asc(t.shape.len)
            if j > 0
                r.head.s(",")
            r.head.s("\{I32::t.shape[j]\}")
        // data_offsets can exceed 2GB, so it is written as I64 (an I32 overflows on a large model).
        r.head.s("],\"data_offsets\":[\{start\},\{start + nbytes\}]}")
        r.data.s(U8$[]::{ .ptr = U8$@::t.data, .len = nbytes })
        r.count += 1
    pub fn finish(r: Self$@): Str_builder //< the whole file as bytes, header and weights
        //< For a destination that is not a file (sending it over a network, reading it back in
        //< memory); it pairs with load / load_from_bytes.
        //< **Call it only once**: it releases the builder's three buffers, and the caller frees the
        //< result.
        if r.meta.len > 0
            if r.count > 0
                r.head.s(",")
            r.head.s("\"__metadata__\":{").s(r.meta.slice()).s("}")
        r.head.s("}")
        // Spaces pad the header so the data part starts on an 8-byte boundary (for
        // interoperability).
        for (r.head.len + 8) % 8 != 0
            r.head.s(" ")
        header: = r.head.slice()
        // It concatenates [8B LE header length][header][data].
        // Caution: Write the length **after widening it to U64**: Sz is 32-bit under
        // cfg(freestanding), and shifting 8 bytes out of it leaves the top 4 unfilled.
        $out: = Str_builder.new()
        len_bytes: U8[8] = ::{}
        len_slice: = U8$[]::len_bytes
        len_slice.put_u64_le(0, U64::header.len)
        out.s(U8$[]::len_bytes).s(header).s(r.data.slice())
        r.head.free()
        r.data.free()
        r.meta.free()
        return out

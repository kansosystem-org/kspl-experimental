//< A transformer block's forward and backward passes for training
//<
//< It composes the backward passes of its two RMSNorms, the self-attention and the MLP through the
//< two residual connections, which makes the block, and so the whole model, trainable.

// ==========================================
// forward: h = x + Attn(RMSNorm(x)) ; out = h + MLP(RMSNorm(h))
// backward: at each residual, the gradient is the direct path plus the path through the
// transform.
// ==========================================
import "ksai/attention_train" as attn_train // Self_attention's train_forward/backward
import "ksai/lora"
import "ksai/nn"
import "ksai/nn_grad" // Rms_norm's / Mlp's backward, and their gradients
import "ksai/optim"
import "ksai/tensor" { Tensor }

pub struct Block_grads<|T|> //< every weight gradient of one block
  pub attention_norm: nn_grad.Rms_norm_grads<|T|> //< the first norm's gradient
  pub attention: attn_train.Attention_grads<|T|> //< the attention's four projections' gradients
  pub ffn_norm: nn_grad.Rms_norm_grads<|T|> //< the second norm's gradient
  pub ffn: nn_grad.Mlp_grads<|T|> //< the gradients of the feed-forward part's two layers

impl<|T|> Block_grads<|T|>
  pub fn accumulate(r: Self$@, o: Self$@) //< adds another sequence's gradients in, in place
    r.attention_norm.accumulate(o.attention_norm@)
    r.attention.accumulate(o.attention@)
    r.ffn_norm.accumulate(o.ffn_norm@)
    r.ffn.accumulate(o.ffn@)

pub struct Block_train<|T|> //< what the forward pass keeps for the backward pass
  pub out: Tensor<|T|> //< the block's output, [S,d]
  pub x: Tensor<|T|> //< the input it was given, which is also the first norm's input
  pub attn: attn_train.Attention_train<|T|> //< what the attention kept, including its own output
  pub h: Tensor<|T|> //< the sum after the first residual, which is also the second norm's input
  pub norm_h: Tensor<|T|> //< the input the feed-forward part was given

impl<|T|> nn.Transformer_block<|T|>
  pub fn train_forward( //< runs the whole sequence at once, keeping what the backward pass needs
    r: Self$@,
    x: Tensor<|T|>, //< every position's input together, [S,d]
  ): Block_train<|T|>
    norm_x: = r.attention_norm.forward(x)
    attn: = r.attention.train_forward(norm_x)
    h: = x + attn.out // residual 1
    norm_h: = r.ffn_norm.forward(h)
    ffn_out: = r.ffn.forward(norm_h)
    out: = h + ffn_out // residual 2
    return Block_train<|T|>::{ .out = out, .x = x, .attn = attn, .h = h, .norm_h = norm_h }
  pub fn backward( //< one SGD step on every weight in the block; returns the input's gradient
    r: Self$@,
    c: Block_train<|T|>$@, //< what `train_forward` kept for this same input
    dout: Tensor<|T|>, //< the gradient of the block's output
    lr: F64, //< the learning rate
  ): Tensor<|T|>
    $g: Block_grads<|T|> = ::{}
    dx: = r.backward_grads(c, dout, g@)
    $u: = optim.Updater<|T|>.sgd(lr)
    defer u.free()
    r.apply_grads(g@, u@)
    return dx
  pub fn backward_grads( //< writes every weight's gradient into `g`; returns the input's gradient
    r: Self$@,
    c: Block_train<|T|>$@, //< what `train_forward` kept for this same input
    dout: Tensor<|T|>, //< the gradient of the block's output
    g: Block_grads<|T|>$@, //< where the gradients are written
  ): Tensor<|T|>
    // Residual 2 (out = h + ffn_out): the ffn_out route's gradient to h.
    dnorm_h: = r.ffn.backward_grads(c.norm_h, dout, g.ffn@) // the MLP's backward pass
    dh_ffn: = r.ffn_norm.backward_grads(c.h, dnorm_h, g.ffn_norm@) // RMSNorm's backward pass
    dh: = dout + dh_ffn // joins at h (direct + after the transform)
    // Residual 1 (h = x + attn_out): the attn_out route's gradient to x.
    dnorm_x: = r.attention.backward_grads(c.attn@, dh, g.attention@) // Attention's backward pass
    dx_attn: = r.attention_norm.backward_grads(c.x, dnorm_x, g.attention_norm@) // RMSNorm's
    dx: = dh + dx_attn // joins at x
    return dx
  pub fn apply_grads( //< moves every weight of the block by `g`
    r: Self$@,
    g: Block_grads<|T|>$@, //< the gradients `backward_grads` computed
    u: optim.Updater<|T|>$@, //< the optimizer that moves them
  )
    r.attention_norm.apply_grads(g.attention_norm@, u)
    r.attention.apply_grads(g.attention@, u)
    r.ffn_norm.apply_grads(g.ffn_norm@, u)
    r.ffn.apply_grads(g.ffn@, u)
  pub fn train_forward_lora( //< the same as `train_forward`, with the adapters' delta added
    //<
    //< It does not update the base (attention_norm, wq/wk/wv/wo, ffn_norm, fc1/fc2) at all, and
    //< folds only the adapters' deltas into the block's forward pass.
    r: Self$@,
    x: Tensor<|T|>, //< every position's input together, [S,d]
    q_lora: lora.Lora<|T|>$@, //< the adapter on the query side; null means none
    v_lora: lora.Lora<|T|>$@, //< the adapter on the value side; null means none
    fc1_lora: lora.Lora<|T|>$@, //< the adapter on the widening layer; null means none
    fc2_lora: lora.Lora<|T|>$@, //< the adapter on the narrowing layer; null means none
  ): Block_train<|T|>
    norm_x: = r.attention_norm.forward(x)
    attn: = r.attention.train_forward_lora(norm_x, q_lora, v_lora)
    h: = x + attn.out // residual 1
    norm_h: = r.ffn_norm.forward(h)
    ffn_out: = r.ffn.forward_lora(norm_h, fc1_lora, fc2_lora)
    out: = h + ffn_out // residual 2
    return Block_train<|T|>::{ .out = out, .x = x, .attn = attn, .h = h, .norm_h = norm_h }
  pub fn backward_lora( //< one step on the adapters only; every base weight stays frozen
    //<
    //< The base is frozen (a backward with lr=0 returns only the gradient). The returned gradient
    //< sums every path.
    r: Self$@,
    c: Block_train<|T|>$@, //< what `train_forward_lora` kept for this same input
    dout: Tensor<|T|>, //< the gradient of the block's output
    lr: F64, //< the learning rate
    q_lora: lora.Lora<|T|>$@, //< the adapter updated on the query side; null skips it
    v_lora: lora.Lora<|T|>$@, //< the adapter updated on the value side; null skips it
    fc1_lora: lora.Lora<|T|>$@, //< the adapter updated on the widening layer; null skips it
    fc2_lora: lora.Lora<|T|>$@, //< the adapter updated on the narrowing layer; null skips it
  ): Tensor<|T|>
    // Residual 2 (out = h + ffn_out): the ffn_out route's gradient to h.
    dnorm_h: = r.ffn.backward_lora(c.norm_h, dout, lr, fc1_lora, fc2_lora)
    dh_ffn: = r.ffn_norm.backward(c.h, dnorm_h, 0.0) // frozen (lr=0)
    dh: = dout + dh_ffn // joins at h
    // Residual 1 (h = x + attn_out): the attn_out route's gradient to x.
    dnorm_x: = r.attention.backward_lora(c.attn@, dh, lr, q_lora, v_lora)
    dx_attn: = r.attention_norm.backward(c.x, dnorm_x, 0.0) // frozen (lr=0)
    dx: = dh + dx_attn // joins at x
    return dx

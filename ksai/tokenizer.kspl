//< A byte-level BPE tokenizer: text to a token-ID sequence and back
//< `encode` and `decode` are the conversions. A vocabulary comes from `train_bpe.kspl`'s two files
//< (`load`, `load_text`) or from a GGUF file's lists (`load_lists`). **Training the tokenizer is
//< not here**: a separate tool produces the BPE merge rules, and this file only loads and uses
//< them. Text is split into chunks by Qwen's rules (`pretokenizer.kspl`) before merging.
import "ksai/pretokenizer" + { Split_rule }
import "std/chars"
import "std/ds" + { List, Map }
import "std/io"
import "std/mem" { Arena, dealloc }
import "std/str" { Str_builder }
import "std/strnum" // `to_count`

priv fn hex_bytes(text: U8[], out: Str_builder$@): Bool //< appends the bytes spelt in hex
    //< Restores vocab.txt's byte sequences; false, with part of them appended, when the text is
    //< not whole bytes written as hex digits. The digit decoding itself is `U8.hex_val`.
    if text.len % 2 != 0
        return false
    for $k: Sz = 0; k + 1 < text.len; k += 2
        if hi: = text[k].hex_val()
            if lo: = text[k + 1].hex_val()
                out.c(U8::((hi << 4) | lo))
                continue
        return false
    return true

priv const ID_MAX: Sz = 2147483647 //< the largest ID an `I32` holds
pub const UNK_ID: I32 = 0 //< `<unk>`, the ID a byte the vocabulary lacks is encoded as

pub fn parse_token_id(text: U8[]): I32? //< a decimal ID that fits an `I32`, or none
    n: = text.to_count(ID_MAX) catch
        return .none
    return .some(I32::n)

priv fn bare_line(line: U8[]): U8[] //< a line without the `\r` a CRLF file leaves on it
    return line.strip_suffix("\r")

pub enum Load_error //< why `Tokenizer.load` refused a vocabulary or its merges
    io(err: io.Io_error) //< a file could not be read
    broken(path: U8[], line: Sz) //< a line is not one `train_bpe.kspl` writes; the file and the
        //< line's number from 1 (`load_text` names `vocabulary` or `merges` for the file, and
        //< `load_lists` names `tokens`, `types` or `merges` with the entry's number from 1).
        //< **Refused, not skipped**: a word or a rule dropped in silence makes every text it
        //< touches encode to other IDs, which nothing downstream can notice.

priv struct Bpe_key
    val: U64

impl Bpe_key
    priv fn of(a: I32, b: I32): Bpe_key //< the key of the pair (a, b), a in the high half
        return Bpe_key::{ .val = ((U64::a) << 32) | (U64::b) }

impl Bpe_key: ds.Hashable<|Bpe_key|> //< so a pair of token IDs can stand as a map's key
    //< **Both IDs are mixed** (`ds.fmix32`). An XOR of the two stays below the vocabulary's size
    //< and gives (a, b) and (b, a) one value, so Qwen's 151,387 rules crowd into long probe runs.
    fn hash(r: Self@): U32
        v: = r.val
        return ds.fmix32(U32::(v >> 32) * 0x9E3779B1U32 + U32::(v & 0xFFFFFFFFU64))
    fn equals(r: Self@, other: Bpe_key): Bool
        return r.val == other.val

priv struct Token_key
    val: I32

impl Token_key: ds.Hashable<|Token_key|> //< so a token ID can stand as a map's key
    fn hash(r: Self@): U32
        return U32::r.val
    fn equals(r: Self$@, other: Token_key): Bool
        return r.val == other.val

pub const TOKEN_NORMAL: I32 = 1 //< a GGUF token type: a word of the BPE vocabulary
pub const TOKEN_USER_DEFINED: I32 = 4 //< a GGUF token type: a marker matched in any text
    //< Such as Qwen's `<think>` and `<tool_call>`. **Matched even inside a message**, as llama.cpp
    //< and Hugging Face's tokenizer do: the chat template writes them as text, and the model was
    //< trained on their single IDs. Every other type (a control token such as `<|im_end|>`) is
    //< never matched in text: a caller puts its ID in the list itself.

priv struct Marker //< a marker `encode` replaces by its ID wherever its text appears
    text: U8[]
    id: I32

priv const GPT2_SHIFTED: Sz = 68 //< how many bytes GPT-2's mapping writes as U+0100 and above

priv fn gpt2_printable(b: I32): Bool //< whether GPT-2's mapping writes the byte as itself
    return (b >= 0x21 && b <= 0x7E) || (b >= 0xA1 && b <= 0xAC) || (b >= 0xAE && b <= 0xFF)

priv fn gpt2_shifted(): U8[GPT2_SHIFTED] //< the bytes GPT-2's mapping writes as U+0100, U+0101..
    //< In ascending order: the bytes that are not printable, which the mapping numbers from 256.
    $out: U8[GPT2_SHIFTED] = ::{}
    $n: Sz = 0
    for b in Range.asc(256)
        if !gpt2_printable(I32::b)
            out[n] = U8::b
            n += 1
    return out

priv fn gpt2_bytes( //< appends the bytes a GGUF word's text stands for
    //< A byte-level vocabulary stores each byte as one printable character, GPT-2's mapping, so
    //< that a word is valid text. False when a character is outside the mapping.
    text: U8[],
    shifted: U8[],
    out: Str_builder$@,
): Bool
    $at: Sz = 0
    for at < text.len
        c: = pretokenizer.read_cpt(text, at)
        if c.cp >= 0 && c.cp < 256 && gpt2_printable(c.cp)
            out.c(U8::c.cp)
        else if c.cp >= 256 && c.cp < 256 + I32::GPT2_SHIFTED
            out.c(shifted[c.cp - 256])
        else
            return false
        at += c.len
    return true

priv struct Bpe_piece //< one piece of a chunk being merged, linked to its neighbours
    id: I32 //< its token
    prev: Sz //< the piece on its left; -1 for none
    next: Sz //< the piece on its right; the chunk's length for none
    gone: Bool //< whether it has merged into the piece on its left

priv struct Bpe_pair //< two adjacent pieces a rule merges, waiting in the queue
    rank: I32 //< the rule's rank
    left: Sz //< the left piece, whose place orders a pair among those of one rank
    right: Sz //< the right piece
    left_id: I32 //< the left piece's token when queued; a pair whose pieces changed is stale
    right_id: I32 //< the right piece's token when queued

priv fn merges_first(a: Bpe_pair, b: Bpe_pair): Bool //< whether `a` merges before `b`
    //< The smaller rank first, and the leftmost of one rank, as a scan of the chunk would pick.
    return a.rank < b.rank || (a.rank == b.rank && a.left < b.left)

priv fn queue_push(queue: List<|Bpe_pair|>$@, p: Bpe_pair) //< adds a pair to the binary heap
    queue.push(p)
    $at: = queue.len - 1
    for at > 0
        up: = (at - 1) / 2
        if !merges_first(p, queue[up])
            break
        queue[at] = queue[up]
        at = up
    queue[at] = p

priv fn queue_pop(queue: List<|Bpe_pair|>$@): Bpe_pair //< takes the pair that merges first
    //< The queue must not be empty.
    top: = queue[0]
    last: = queue[queue.len - 1]
    queue.len -= 1
    $at: Sz = 0
    for
        $child: = 2 * at + 1
        if child >= queue.len
            break
        if child + 1 < queue.len && merges_first(queue[child + 1], queue[child])
            child += 1
        if !merges_first(queue[child], last)
            break
        queue[at] = queue[child]
        at = child
    if queue.len > 0
        queue[at] = last
    return top

pub struct Tokenizer //< the vocabulary and merge rules that turn text into token IDs
    pub vocab: Map<|U8[], I32|>$@ //< each word's byte sequence -> its ID; keys from the model
    priv vocab_rev: Map<|Token_key, U8[]|>$@ //< an ID -> its byte sequence; keys from the model
    priv byte_ids: I32[256] //< each one-byte word's ID, where merging starts; `UNK_ID` if none
    priv merges: Map<|Bpe_key, I32|>$@ //< a pair -> the ID it merges into; keys from the model
    priv merge_rank: Map<|Bpe_key, I32|>$@ //< a pair -> its rank, 0 first; keys from the model
    priv markers: List<|Marker|>$@ //< the markers `encode` matches, longest first, then by ID
    pub next_rank: I32 //< the rank the next `add_merge` gets; the call order is the rank
    pub arena: Arena$@ //< the arena for every word and every rule
        //< **Nothing a call returns is put here** (`encode` and `decode` take the caller's arena),
        //< so a tokenizer kept for a server's lifetime does not grow.
    priv split: Split_rule //< the rule that splits a text into chunks; Qwen2's unless set

impl Tokenizer
    pub fn new( //< an empty tokenizer, to be filled by a `load` or by `add_token` / `add_merge`
        arena: Arena$@, //< the arena for its maps and lists and everything put into them
    ): Tokenizer
        vocab: = arena.create(Map<|U8[], I32|>(arena)) // keys from the model
        vocab_rev: = arena.create(Map<|Token_key, U8[]|>(arena)) // keys from the model
        merges: = arena.create(Map<|Bpe_key, I32|>(arena)) // keys from the model
        merge_rank: = arena.create(Map<|Bpe_key, I32|>(arena)) // keys from the model
        return Tokenizer::{ .vocab = vocab, .vocab_rev = vocab_rev, .merges = merges,
            .merge_rank = merge_rank, .markers = List<|Marker|>.create(arena), .next_rank = 0,
            .arena = arena, .split = .qwen2 }

    pub fn set_split( //< the rule that splits a text into chunks before merging
        //< It must be the rule the vocabulary was made with: GGUF's `tokenizer.ggml.pre` names it
        //< (`Split_rule.named`). Qwen2's rule is taken until this is called.
        r: Self$@,
        rule: Split_rule,
    )
        r.split = rule

    pub fn add_token( //< adds one word to the vocabulary, looked up in both directions from then on
        r: Self$@,
        token: U8[], //< the word's byte sequence; it is copied onto the arena
        id: I32, //< the ID it maps to
    )
        perm_token: = r.arena.dup_str(token)
        r.vocab.set(perm_token, id)
        r.vocab_rev.set(Token_key::{ .val = id }, perm_token)
        if token.len == 1
            r.byte_ids[token[0]] = id

    pub fn add_merge( //< adds one merge rule: this pair, when adjacent, becomes that one word
        //< Caution: **The call order is the rank**, so the rules must arrive in priority order
        //< (`load()` and `train_bpe.kspl`'s merges.txt already do). A pair given again keeps its
        //< first rank, as llama.cpp keeps it.
        r: Self$@,
        id1: I32, //< the left ID
        id2: I32, //< the right ID
        merged_id: I32, //< the ID the two merge into
    )
        key: = Bpe_key.of(id1, id2)
        if r.merge_rank.get(key).is_none()
            r.merges.set(key, merged_id)
            r.merge_rank.set(key, r.next_rank)
        r.next_rank += 1

    priv fn add_marker(r: Self$@, text: U8[], id: I32) //< a marker `encode` matches in any text
        //< Kept longest first, so a marker inside a longer one never splits it; equal lengths go
        //< by ID. That is llama.cpp's order.
        $at: Sz = 0
        for at < r.markers.len && r.markers[at].text.len >= text.len
            at += 1
        r.markers.insert(at, Marker::{ .text = r.arena.dup_str(text), .id = id })

    // One entry per line: vocab.txt "<id>\t<hex>" (the word's bytes; id 0's <unk> is empty) and
    // merges.txt "<id1> <id2> <merged_id>". They are loaded through `add_token`/`add_merge` into
    // encode/decode's representation (a 1-byte base + merges). An empty line is skipped.
    pub fn load( //< loads the vocabulary and merge rules that `train_bpe.kspl` wrote
        r: Self$@,
        vocab_path: U8[], //< the vocabulary file, one word per line
        merges_path: U8[], //< the merge rules, in priority order
    ): Void!Load_error //< a file that cannot be read, or the first line that is not an entry
        vocab_data: = io.read_file(vocab_path, null) catch e
            throw .io(e)
        defer dealloc(Void$@::vocab_data.ptr)
        merges_data: = io.read_file(merges_path, null) catch e
            throw .io(e)
        defer dealloc(Void$@::merges_data.ptr)
        r.add_vocab(vocab_data, vocab_path)!
        r.add_merges(merges_data, merges_path)!

    pub fn load_text( //< loads the two files' texts already in memory, with no file read
        //< For a program with no filesystem, or texts `embed`ded at build time. A broken line is
        //< named in `vocabulary` or `merges`, as a file's path would be.
        r: Self$@,
        vocab: U8[], //< what vocab.txt holds
        merges: U8[], //< what merges.txt holds
    ): Void!Load_error //< the first line that is not an entry
        r.add_vocab(vocab, "vocabulary")!
        r.add_merges(merges, "merges")!

    pub fn load_lists( //< loads a byte-level vocabulary given as a GGUF file holds it
        //< The three lists are `tokenizer.ggml.tokens`, `.token_type` and `.merges`, in a GGUF
        //< file's order; nothing is read from a file. A normal word is written in GPT-2's mapping
        //< of bytes to characters, and any other is its text as it stands.
        r: Self$@,
        tokens: U8[][], //< each word's text; its position is its ID
        types: I32[], //< each word's GGUF token type, `TOKEN_NORMAL` and the others
        merges: U8[][], //< the rules in priority order, each two words' texts and a space between
    ): Void!Load_error //< the first entry that cannot be taken, named `tokens`, `types` or `merges`
        if types.len != tokens.len
            throw .broken("types",
                (types.len if types.len < tokens.len else tokens.len) + 1)
        shifted: = gpt2_shifted()
        defer $b: = Str_builder()
        for i in Range.asc(tokens.len)
            b.clear()
            if types[i] == TOKEN_NORMAL
                if !gpt2_bytes(tokens[i], U8[]::shifted, b@)
                    throw .broken("tokens", i + 1)
            else
                b.s(tokens[i])
            // A second word with the same bytes would make the first unreachable; llama.cpp
            // refuses such a vocabulary too.
            if r.vocab.get(b.slice()).is_some()
                throw .broken("tokens", i + 1)
            r.add_token(b.slice(), I32::i)
            if types[i] == TOKEN_USER_DEFINED
                if tokens[i].len == 0
                    throw .broken("tokens", i + 1)
                r.add_marker(tokens[i], I32::i)
        defer $left: = Str_builder()
        defer $right: = Str_builder()
        for i in Range.asc(merges.len)
            rule: = merges[i]
            // Split at the first space after the first byte, as llama.cpp does.
            space: = rule.sub_from(1).find_char(' ').unwrap_or(-1)
            left.clear()
            right.clear()
            if space < 0 ||
                !gpt2_bytes(rule.sub(0, space + 1), U8[]::shifted, left@) ||
                !gpt2_bytes(rule.sub_from(space + 2), U8[]::shifted, right@)
                throw .broken("merges", i + 1)
            id1: = r.vocab.get(left.slice())
            id2: = r.vocab.get(right.slice())
            left.s(right.slice())
            merged: = r.vocab.get(left.slice())
            if id1.is_none() || id2.is_none() || merged.is_none()
                throw .broken("merges", i + 1)
            r.add_merge(id1.unwrap_or(0), id2.unwrap_or(0), merged.unwrap_or(0))

    priv fn add_vocab(r: Self$@, text: U8[], name: U8[]): Void!Load_error //< vocab.txt's words
        defer $lines: = text.lines(null)
        for i in Range.asc(lines.len)
            line: = bare_line(lines.get(i))
            if line.len == 0
                continue
            switch line.find_char('\t')
            case .none
                throw .broken(name, i + 1)
            case .some(tab)
                id: = parse_token_id(line.sub(0, tab))
                hex: = line.sub_from(tab + 1)
                defer $b: = Str_builder()
                if !hex_bytes(hex, b@)
                    throw .broken(name, i + 1)
                if got: = id
                    r.add_token(b.slice(), got)
                else
                    throw .broken(name, i + 1)

    priv fn add_merges(r: Self$@, text: U8[], name: U8[]): Void!Load_error //< merges.txt's rules
        defer $lines: = text.lines(null)
        for i in Range.asc(lines.len)
            line: = bare_line(lines.get(i))
            if line.len == 0
                continue
            if sp1: = line.find_char(' ')
                rest: = line.sub_from(sp1 + 1)
                if sp2: = rest.find_char(' ')
                    id1: = parse_token_id(line.sub(0, sp1))
                    id2: = parse_token_id(rest.sub(0, sp2))
                    id3: = parse_token_id(rest.sub_from(sp2 + 1))
                    if id1.is_none() || id2.is_none() || id3.is_none()
                        throw .broken(name, i + 1)
                    r.add_merge(id1.unwrap_or(0), id2.unwrap_or(0), id3.unwrap_or(0))
                    continue
            throw .broken(name, i + 1)

    pub fn encode( //< the token IDs for a text
        //< Each user-defined marker's text becomes its ID first. The rest is split into chunks
        //< (`pretokenizer.chunk_end`), and within each chunk the pair of the smallest rank merges
        //< every time; no merge crosses a chunk, as during training.
        r: Self$@,
        text: U8[], //< the text; any byte sequence works, a byte the vocabulary lacks as `UNK_ID`
        arena: Arena$@, //< the arena the list of IDs is allocated from; nothing else is
    ): List<|I32|>$@
        tokens: = List<|I32|>.create(arena)
        r.encode_part(text, 0, tokens)
        return tokens

    priv fn encode_part(r: Self$@, text: U8[], marker: Sz, out: List<|I32|>$@) //<
        //< Splits the text at each `markers[marker]`, and the parts between at the next markers
        //< The order (longest first) is llama.cpp's, so where two markers overlap the same one
        //< wins.
        if marker == r.markers.len
            $i: Sz = 0
            for i < text.len
                end: = pretokenizer.chunk_end(text, i, r.split)
                r.bpe_chunk(text.sub(i, end - i), out)
                i = end
            return
        mark: = r.markers[marker]
        $rest: = text
        for
            at: = rest.find_str(mark.text).unwrap_or(-1)
            if at < 0
                r.encode_part(rest, marker + 1, out)
                return
            r.encode_part(rest.sub(0, at), marker + 1, out)
            out.push(mark.id)
            rest = rest.sub_from(at + mark.text.len)

    priv fn bpe_chunk(r: Self$@, chunk: U8[], out: List<|I32|>$@) //<
        //< Merges one pre-split chunk by BPE, smallest rank first, and appends its token IDs to out
        //< **A queue holds every adjacent pair a rule merges**, smallest rank and then leftmost on
        //< top, as llama.cpp keeps it. So a chunk of n bytes takes time in n log n, and one long
        //< word cannot hold a server for minutes. The working lists live on the heap, freed here.
        n: = chunk.len
        defer $pieces: = List<|Bpe_piece|>.new_with_cap(n, null)
        for i in Range.asc(n)
            pieces
                .push(Bpe_piece::{ .id = r.byte_ids[chunk[i]], .prev = i - 1, .next = i + 1,
                .gone = false })
        defer $queue: = List<|Bpe_pair|>(null)
        for i in Range.asc(n - 1)
            r.queue_pair(queue@, pieces@, i)
        for queue.len > 0
            p: = queue_pop(queue@)
            left: = pieces[p.left]
            // A pair queued before one of its pieces changed is stale; its new pairs are queued.
            if left.gone || left.next != p.right || left.id != p.left_id ||
                pieces[p.right].id != p.right_id
                continue
            after: = pieces[p.right].next
            pieces[p.left].id = r.merges.get(Bpe_key.of(p.left_id, p.right_id)).unwrap_or(-1)
            pieces[p.left].next = after
            pieces[p.right].gone = true
            if after < n
                pieces[after].prev = p.left
            if left.prev >= 0
                r.queue_pair(queue@, pieces@, left.prev)
            r.queue_pair(queue@, pieces@, p.left)
        // The first piece is never merged away: only a right piece is.
        for $at: Sz = 0; at < n; at = pieces[at].next
            out.push(pieces[at].id)

    priv fn queue_pair( //< queues the pair piece `at` and the next piece form, if a rule merges it
        r: Self$@,
        queue: List<|Bpe_pair|>$@,
        pieces: List<|Bpe_piece|>@,
        at: Sz,
    )
        right: = pieces[at].next
        if right >= pieces.len
            return
        a: = pieces[at].id
        b: = pieces[right].id
        if rank: = r.merge_rank.get(Bpe_key.of(a, b))
            queue_push(queue,
                Bpe_pair::{ .rank = rank, .left = at, .right = right, .left_id = a, .right_id = b })

    pub fn decode( //< the text for the IDs
        r: Self$@,
        tokens: List<|I32|>$@, //< the IDs; an ID not in the vocabulary contributes nothing
        arena: Arena$@, //< the arena the text is allocated from; nothing else is
    ): U8[]
        text: = arena.text()
        for id in tokens
            text.s(r.decode_one(id))
        return text.take()

    pub fn decode_one( //< the text for one ID, for printing each generated token as it comes
        //< **It allocates nothing**: the result is the vocabulary's own bytes, which stay valid
        //< while
        //< the tokenizer's arena does. An ID not in the vocabulary gives an empty text.
        r: Self$@,
        id: I32, //< the single ID
    ): U8[]
        return r.vocab_rev.get(Token_key::{ .val = id }).unwrap_or("")

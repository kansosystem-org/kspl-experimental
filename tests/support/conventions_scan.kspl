//< The file-walking helpers the convention checks use
//< It is not a suite of its own; it is a part of conventions.
//<
//< Caution: **Do not put a judgment in here.** Mix "what is checked" into the tools, and fixing one
//< convention changes a tool, which silently changes the other judgments. Only what means the
//< same to every judgment belongs here.
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/verdict"

fn find_all(text: U8[], head: U8[], tail: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Picks up every text between head and tail, one at a time
    //< **Ignore whether the brackets pair**: only "is that text there" matters; parsing the syntax
    //< is ksplc's job.
    $out: = List<|U8[]|>.new(arena)
    $i: Sz = 0
    for i + head.len <= text.len
        if !text.sub(i, head.len).equals(head)
            i += 1
            continue
        $j: = i + head.len
        for j + tail.len <= text.len && !text.sub(j, tail.len).equals(tail)
            if text[j] == '\n'
                break
            j += 1
        if j + tail.len <= text.len && text.sub(j, tail.len).equals(tail)
            out.push(text.sub(i + head.len, j - i - head.len))
            i = j + tail.len
            continue
        i += head.len
    return out

fn push_unique(out: List<|U8[]|>$@, want: U8[])
    if !out.contains(want)
        out.push(want)

fn diff_into(a: List<|U8[]|>@, b: List<|U8[]|>@, a_name: U8[], b_name: U8[],
    out: List<|U8[]|>$@, arena: Arena$@) //<
        //< Lists what is in a and not in b.
    for i in Range.asc(a.len)
        if !b.contains(a.get(i))
            out
                .push(arena.text().s(a.get(i)).s(": in ").s(a_name).s(" and not in ").s(b_name)
                .take())

fn find_line_starts(text: U8[], head: U8[], tail: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Picks up the matches only at the start of a line (to count a table's rows and headings)
    $out: = List<|U8[]|>.new(arena)
    for line in text.lines(arena)
        if !line.starts_with(head)
            continue
        rest: = line.sub_from(head.len)
        if at: = rest.find_str(tail)
            out.push(rest.sub(0, at))
    return out

// ==========================================
// The lists of extensions, kept in this one place
// Kept per check, the same gap would open in several places.
// Caution: **Write both `*.kspl` and `*.ksplb`**: the parser's fixtures in `ksplc/tests/parse/` are
// written in braces (`.ksplb`), and with `*.kspl` alone they silently drop out of the checks.
// ==========================================

// The files walked: what Kanso writes in its own words, which the vocabulary and register checks
// read.
// Caution: **Do not add `.yml` or `.js` here**: their prose uses other products' words and would
// fail the vocabulary check wrongly. The history check (Principle 7) reads the wider `ALL_EXT`.
const TEXT_EXT: U8[][_] = ::{ "*.kspl", "*.ksplb", "*.md", "*.py", "*.mk", "*.kspeg", "*.cfg",
    "Makefile" }

// Every file a person writes: a history or a label can appear anywhere.
const ALL_EXT: U8[][_] = ::{ "*.kspl", "*.ksplb", "*.md", "*.py", "*.mk", "*.kspeg", "*.cfg",
    "Makefile", "*.yml", "*Dockerfile", "*.c", "*.h", "*.js", "*.mjs", "*.css", "*.html", "*.S",
    "*.ld", "*.gitignore", "*.gitattributes" }

// Of the files a person writes, the source and the build steps.
// **Do not drop `.yml`, Dockerfile or `.py`**: a workflow and an image are "how it is built" too,
// and gates are written in Python (`ksos/tests/*.py`).
// Caution: **Drop one extension and those files silently leave the checks.** When adding one,
// check every list.
const BUILD_EXT: U8[][_] = ::{ "*.kspl", "*.ksplb", "*.mk", "Makefile", "*.yml", "*Dockerfile",
    "*.c", "*.h", "*.js", "*.mjs", "*.py", "*.css", "*.html", "*.S", "*.ld" }

const KSPL_SPECS: U8[][_] = ::{ "*.kspl", "*.ksplb" } //<
    //< The path specs matching every KSPL source
    //< **Both are needed** (the reason is in this section's header).

fn kspl_specs_with(extra: U8[][], arena: Arena$@): U8[][] //<
    //< `KSPL_SPECS` followed by further path specs (an exclusion and so on)
    //< The list lives in the arena, so the returned slice stays valid for the caller.
    $out: = List<|U8[]|>.new(arena)
    for one in KSPL_SPECS
        out.push(one)
    for one in extra
        out.push(one)
    return out.slice()

fn strip_code(line: U8[], arena: Arena$@): U8[] //<
    //< Drops the string literals and the line comment from a line
    //< This keeps the brackets from being miscounted.
    b: = arena.text()
    $i: Sz = 0
    for i < line.len
        if i + 1 < line.len && line[i] == '/' && line[i + 1] == '/'
            break
        if line[i] != '"'
            b.c(line[i])
            i += 1
            continue
        b.s("\"\"")
        i += 1
        for i < line.len && line[i] != '"'
            i += 2 if line[i] == '\\' else 1
        i += 1
    return b.take()

fn count_char(line: U8[], c: U8): Sz
    $n: Sz = 0
    for b in line
        if b == c
            n += 1
    return n

// Whether the line after this one is inside a `"""` string. **Two on one line cancel out.**
// Caution: **A `"""` inside a comment opens nothing**; if counted, a comment naming the fence
// turns every line below into "inside a string", silently skipped.
fn flip_raw(line: U8[], now: Bool): Bool
    if !now && line.trim_start().starts_with("//")
        return false
    $at: Sz = 0
    $inside: = now
    for at + 3 <= line.len
        if found: = line.sub_from(at).find_str("\"\"\"")
            inside = !inside
            at = at + found + 3
        else
            break
    return inside

// ==========================================
// A check shows it can fire
// A convention's check is "green where the repository is clean", so **it is also green when the
// check is broken.** So a rule's judgment is a function that takes one text. The table of hits and
// misses lives **in the same file as the rule**. The decision, and how other products handle it,
// is Principle 5 in `docs/DESIGN-principles.md`.
// ==========================================

// Caution: **List both sides.** Only hits pass a judgment that always returns true; only misses,
// one that always returns false.
// **Do not put the samples in a separate file**: excluding that file then needs extra machinery,
// and where the exclusion leaks, the real check fails.
struct Sample
    text: U8[]
    hits: Bool

// Runs the judgment over the table and returns the samples it got wrong.
//
fn check_samples(title: U8[], samples: Sample[], table: U8[],
    decide: fn(text: U8[], arena: Arena$@): Bool, arena: Arena$@) //<
        //< One check that `decide` judges every sample of the table named `table` as it says
    $bad: = misjudged(samples, decide, arena)
    verdict.check_list(title, samples.len, "samples", bad@,
        arena.text().s("the table of what is hit and what is not is `\{table\}`").take())

// Caution: **`decide` must be a pure function of one text**: if it also reads a file, the samples
// can no longer be passed in.
fn misjudged(samples: Sample[], decide: fn(text: U8[], arena: Arena$@): Bool, arena: Arena$@):
    List<|U8[]|>
    $bad: = List<|U8[]|>.new(arena)
    for s in samples
        got: = decide(s.text, arena)
        if got != s.hits
            want: = "hit" if s.hits else "not hit"
            bad
                .push(arena.text().s("\"").s(s.text).s("\" should be ").s(want)
                .s(" and came out the other way").take())
    return bad

//< The known holes in memory safety: each program, and what happens to it today
//< `tests/suite/holes_test.kspl` runs every program here and in `holes_sync.kspl`, and checks
//< that its verdict holds. **A verdict that changes fails the suite, either way.** A refusal that
//< no longer comes is a regression. A hole that closes means the table, and the text of
//< `docs/SPEC-programming-language.md` that names it, must change with it.
//< Each program is one way to break memory that a probe found. Its name is the probe's.

enum Verdict //< what happens to one program today
    refused //< ksplc refuses it; `says` is a piece of the error
    reported //< it builds and runs, and the sanitizer reports it; `says` is a piece of the report
    stops //<
        //< Built without a sanitizer, it stops at run time; `says` is a piece of what it prints
        //< **The program's own check stops it, or the OS's.** A sanitizer would see the bad access
        //< that check makes first, so the plain build is what a user runs.
    hole //<
        //< It runs to its end, and the sanitizer reports nothing
        //< **Only a hole the specification names stands here**: `spec` is its heading, and `says`
        //< the words there that name the shape.

struct Hole //< one program, and its verdict today
    name: U8[] //< the probe's name
    what: U8[] //< what it does wrong, in a check's words
    source: U8[]
    verdict: Verdict
    says: U8[]
    spec: U8[] //< for a hole, the heading in `docs/SPEC-programming-language.md`; else empty

priv const P01_UAF_ALLOC: U8[] =
    """
import "std/io"
import "std/mem"
import "std/strfmt" as _strfmt
fn main()
    p: = I32$@::mem.alloc(16)
    p$ = 41
    mem.dealloc(Void$@::p)
    q: = p
    io.out().s("read after free: \{q$\}\n")
"""


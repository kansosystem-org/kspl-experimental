//< Builds a program through ksplc with a sanitizer, for the suites that run one
//< **The one place such a build is composed.** `race_test` (ThreadSanitizer) and `sanitize_test`
//< (the address and undefined-behaviour sanitizers) both build through it. So a backend added here
//< reaches both. The link is `harness_build`'s, as every suite's is.
import "ksplc/tests/support/harness" as ksplc_harness
import "ksplc/tests/support/harness_build"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" // `arena.text()` and `trim_spaces`
import "std/sys"
import "std/verdict"
import "tests/support/harness"

struct Built //< an executable, or why it was not built
    exe: U8[]
    why: U8[]
    deps: U8[] //< the sources it was compiled from, one whole path a line

fn build( //< Compiles entry (from the folder dir) through ksplc, and links it with cflags into exe
    //< **Both backends**: the C one, or `--to=llvm` where llvm is set, with the runtime `ksplc
    //< emit-runtime` writes linked beside the IR. The libraries the program names (`#link`) are
    //< linked too.
    dir: U8[], //< the folder ksplc runs in, as the package's own `make test` runs it
    entry: U8[], //< the program's source
    exe: U8[], //< the executable to write; the files it is made from go beside it
    cflags: U8[][], //< the sanitizer's options and the optimisation level
    llvm: Bool, //< through the LLVM backend
    marks: U8[], //<
        //< What `--sanitize=` names to the LLVM backend (`address`); empty names nothing
        //< **The IR is instrumented only where it is marked**: clang's `-fsanitize=` passes over
        //< an unmarked function. The C backend takes none, as its C compiler marks the C itself.
    arena: Arena$@,
): Built
    gen: = arena.text().s(exe).s(".ll" if llvm else ".c").take()
    libs: = arena.text().s(exe).s(".libs").take()
    deps: = arena.text().s(exe).s(".deps").take()
    $args: = List<|U8[]|>(arena)
    args.push(arena.text().s("--emit-libs=").s(libs).take())
    args.push(arena.text().s("--emit-deps=").s(deps).take())
    if llvm
        args.push("--to=llvm")
        if marks.len > 0
            args.push(arena.text().s("--sanitize=").s(marks).take())
    args.push(entry)
    args.push(gen)
    made: = ksplc_harness.run_in(harness.ksplc_argv_anywhere(args.slice()), dir)
    if !made.exited_with(0)
        return Built::{ .why = arena.text().s("ksplc cannot compile it:\n").s(made.out).take() }
    $flags: = List<|U8[]|>(arena)
    for f in cflags
        flags.push(f)
    flags.push("-std=c99")
    if llvm
        for f in harness_build.LLVM_CFLAGS
            flags.push(f)
    linked: = harness_build.build_listed_exe(gen, exe, flags.slice(), llvm, libs)
    if !linked.exited_with(0)
        return Built::{ .why = arena.text().s("it does not link:\n").s(linked.out).take() }
    listed: = io.read_file(deps, null) catch
        fallback ""
    // A package's own files are listed from its folder; each path is made whole here.
    whole: = arena.text()
    for line in listed.lines(arena)
        at: = line.find_char(' ').unwrap_or(0)
        if at > 0 // a space, with a name before it
            path: = line.sub_from(at + 1)
            whole.s(path if sys.is_absolute(path) else fs.join(dir, path, arena)).c('\n')
    return Built::{ .exe = exe, .deps = whole.take() }

fn runs_with( //<
    //< Empty where the C compiler builds and runs a program with cflags; else what it said
    //< **This is how a suite tells a missing sanitizer from a fault.** A C compiler or a platform
    //< without its runtime fails here, before any program is built.
    work: U8[], //< a folder of the suite's own
    cflags: U8[][], //< the sanitizer's options
    env: U8[][], //< `NAME=value` pairs the probe runs under, for an option the runtime may refuse
    arena: Arena$@,
): U8[]
    c: = fs.join(work, "probe.c", arena)
    exe: = fs.join(work, "probe.exe", arena)
    io.write_file(c, "int main(void) { return 0; }\n") catch
        return "cannot write the probe"
    $argv: = List<|U8[]|>(arena)
    argv.push(ksplc_harness.cc())
    for f in cflags
        argv.push(f)
    for w in U8[][]::{ c, "-o", exe }
        argv.push(w)
    built: = ksplc_harness.run(argv.slice())
    if !built.exited_with(0)
        return built.out
    $run: = List<|U8[]|>(arena)
    run.push("env")
    for e in env
        run.push(e)
    run.push(exe)
    ran: = ksplc_harness.run(run.slice())
    return ("" if ran.exited_with(0)
        else arena.text().s("it builds but does not run:\n").s(ran.out).take())

fn kept(words: U8[][], arena: Arena$@): U8[][] //< the words, copied onto the arena
    //< Caution: **A run keeps its words past the call that names them**, so a literal list (on that
    //< call's frame) is copied here first.
    $out: = List<|U8[]|>(arena)
    for w in words
        out.push(w)
    return out.slice()

fn pkg_env(arena: Arena$@): U8[][] //<
    //< What a package's tests that start a child compiler, or name another package, find them by
    return kept(U8[][]::{ arena.text().s("KSPLC_STD_DIR=").s(ksplc_harness.std_dir()).take(),
        arena.text().s("KSPLC_PKG_SRC_DIR=").s(harness.root()).take() }, arena)

// ==========================================
// Reading a sanitizer's logs
// ==========================================

struct Sample //< a sanitizer's log, and how many reports a reading must find in it
    text: U8[]
    reports: Sz

fn check_reading_fires( //< checks that a reading finds each sample's reports, as one check
    name: U8[], //< the check
    samples: Sample[],
    read: fn(text: U8[], arena: Arena$@): List<|U8[]|>, //< one line per report of one log
    arena: Arena$@,
)
    $bad: = List<|U8[]|>(arena)
    for s in samples
        if read(s.text, arena).len != s.reports
            bad.push(arena.text().s("misread: ").s(s.text).take())
    verdict.check_list(name, samples.len, "samples", bad@, "the table is `report_samples`")

fn reports_in( //< every report logged under log_dir, the root's prefix cut off its paths
    log_dir: U8[],
    prefix: U8[], //< the start of a log's file name (`tsan.`); empty reads every file
    read: fn(text: U8[], arena: Arena$@): List<|U8[]|>, //< one line per report of one log
    arena: Arena$@,
): List<|U8[]|>
    $out: = List<|U8[]|>(arena)
    names: = fs.read_dir(log_dir, arena) catch
        return out
    root: = arena.text().s(harness.root()).c('/').take()
    for name in names
        if !name.starts_with(prefix)
            continue
        text: = io.read_file(fs.join(log_dir, name, arena), null) catch
            fallback ""
        for r in read(text, arena)
            out.push(r.replace(root, "", arena))
    return out

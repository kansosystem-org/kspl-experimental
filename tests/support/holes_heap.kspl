//< The known holes in heap memory that the sanitizers do not see
//< `tests/suite/holes_test.kspl` runs each program here as it runs those in `holes_mem.kspl`,
//< which says what a verdict holds to. The address sanitizer finds a byte outside its block, not
//< one inside it that nothing wrote.
import "tests/support/holes_mem" { Hole }

priv const P08B_UNWRITTEN_HEAP: U8[] =
    """
import "std/io"
import "std/mem"
import "std/strfmt" as _strfmt
priv struct P
    a: I32
    b: I32
fn main()
    p: = P$@::mem.alloc(sizeof(P))
    io.out().s("unwritten heap: \{p.a\} \{p.b\}\n")
    mem.dealloc(Void$@::p)
"""

const HEAP: Hole[_] = ::{ //< the heap holes, with their verdicts
    Hole::{ .name = "p08b_unwritten_heap", .what = "raw heap bytes read before anything wrote them",
        .source = P08B_UNWRITTEN_HEAP, .verdict = .hole,
        .says = "A read of raw bytes that `mem.alloc` or `Arena.alloc` handed out",
        .spec = "### 14.2 Undefined - no answer is fixed" },
}

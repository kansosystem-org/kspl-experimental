//< Catches the C runtime and the KSPL side drifting apart (not the suite)
//< **Each side builds alone.** A bit, a name or a body the two hold apart compiles either way. It
//< breaks only on the platform or the path that reads it. Split from `conventions_match.kspl`,
//< which runs it.
import "std/chars" // `trim_spaces`
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/conventions_scan" as scan + { Sample }
import "tests/support/harness"

// ==========================================
// The machine table names the hosts as the runtime spells them `kspl_host_machine` (the runtime)
// builds the host's name from two macros. ksplc looks that name up in its table. A spelling
// changed on one side refuses every compile on that host until `--machine` is given.
// ==========================================
priv const HOST_C: U8[] = "ksplc/gen/runtime/hosted.c"
priv const MACHINE_TABLE: U8[] = "ksplc/base/target.kspl"

priv fn check_host_spellings(arena: Arena$@)
    c: = harness.read_under_root(HOST_C)
    archs: = scan.find_all(c, "#define KSPL_HOST_ARCH \"", "\"", arena)
    oses: = scan.find_all(c, "#define KSPL_HOST_OS \"", "\"", arena)
    $bad: = List<|U8[]|>(arena)
    $seen: Sz = 0
    if archs.len == 0 || oses.len == 0
        bad
            .push(arena.text().s("could not read the host's spellings out of ").s(HOST_C).take())
    for name in scan.find_all(harness.read_under_root(MACHINE_TABLE), ".name = \"", "\"", arena)
        for os in oses
            tail: = arena.text().c('-').s(os).take()
            if name.ends_with(tail) && !os.equals("unknown")
                seen += 1
                if !archs.contains(name.sub(0, name.len - tail.len))
                    bad.push(name)
    verdict.check_list("every hosted machine in the table is a name the runtime can build", seen,
        "machines", bad@,
        arena.text().s("spell the row as `KSPL_HOST_ARCH \"-\" KSPL_HOST_OS` in ").s(HOST_C).take())

// ==========================================
// The LLVM side holds no body for a `kspl_*` Only the C runtime (`ksplc emit-runtime`) holds an
// OS-touching `kspl_*`'s body; the IR `declare`s it from `std/`'s `extern "C"` (the start of
// "The backends (Genc / Genllvm) and the runtime ABI" in `../../ksplc/docs/DESIGN-backends.md`).
// ==========================================
priv const LLVM_MODULE: U8[] = "ksplc/gen/llvm/module.kspl"
priv const LLVM_CTX: U8[] = "ksplc/gen/llvm/ctx.kspl"

// The `kspl_*` the IR may hold its own translation unit's copy of.
// Caution: **To add one, the C side must be `static inline` too.**
priv const LLVM_INLINE_OK: U8[][_] = ::{ "kspl_bounds_check", "kspl_div_check", "kspl_sdiv",
    "kspl_smod", "kspl_sdiv32", "kspl_smod32", "kspl_shift_check", "kspl_tag_check" }

priv fn is_inline_ok(name: U8[]): Bool
    for e in LLVM_INLINE_OK
        if name.equals(e)
            return true
    return false

priv fn collect_declared(out: List<|U8[]|>$@, arena: Arena$@) //<
    //< The names of the `kspl_*` that an `extern "C"` in `std/` and the like declares
    //< A block is read in either notation: to its `}` after an `extern "C" {`, and to the first
    //< line indented no deeper than a bare `extern "C"` in `.kspl`. A block under a `#cfg(...)` is
    //< read too, since either backend may build it.
    specs: = scan.kspl_specs_with(U8[][]::{ ":!tests/" }, arena)
    for rel in harness.tracked_matching(specs)
        collect_declared_in(harness.read_under_root(rel).lines(arena), out)

priv fn collect_declared_in(lines: List<|U8[]|>, out: List<|U8[]|>$@) //<
    //< The `kspl_*` names one file's `extern "C"` blocks declare
    $in_block: = false
    $braced: = false
    $depth: Sz = 0
    for i in Range.asc(lines.len)
        raw: = lines.get(i)
        line: = raw.trim_spaces()
        if in_block
            $ends: = line.starts_with("}")
            if !braced
                ends = line.len > 0 && raw.len - raw.trim_start().len <= depth
            if !ends
                push_kspl_fn(line, out)
                continue
            in_block = false
            if braced
                continue
        if line.starts_with("extern \"C\"")
            in_block = true
            braced = line.ends_with("{")
            depth = raw.len - raw.trim_start().len

priv fn push_kspl_fn(line: U8[], out: List<|U8[]|>$@) //<
    //< adds the name a `fn kspl_*(` line declares
    sig: = line.strip_prefix("pub ")
    if !sig.starts_with("fn kspl_")
        return
    rest: = sig.sub_from(3)
    at: = rest.find_char('(').unwrap_or(0)
    if at > 0
        scan.push_unique(out, rest.sub(0, at))

priv fn collect_module_symbols(defined: List<|U8[]|>$@, declared: List<|U8[]|>$@, arena: Arena$@) //<
    //< The names of the symbols a `define` / `declare` at a line's start in `module.kspl` emits
    //< Each name is taken from after the `@`, up to the `(`. The `llvm.*` built-ins are not
    //< counted.
    for line in harness.read_under_root(LLVM_MODULE).lines(arena)
        t: = line.trim_spaces()
        is_def: = t.starts_with("define ")
        if !is_def && !t.starts_with("declare ")
            continue
        if at: = t.find_str("@")
            rest: = t.sub_from(at + 1)
            open: = rest.find_char('(').unwrap_or(0)
            if open == 0
                continue
            name: = rest.sub(0, open)
            if name.starts_with("llvm.")
                continue
            scan.push_unique(defined if is_def else declared, name)

priv const PREAMBLE_HEAD: U8[] = "const PREAMBLE_FNS:" //<
    //< The line that starts `ctx.kspl`'s table of what the preamble emits itself
    //< One entry per line follows it, up to a line holding only `}`.

priv fn collect_preamble(named: List<|U8[]|>$@, by_hand: List<|U8[]|>$@, arena: Arena$@): Bool //<
    //< The names the table holds, and among them those with no `.ret`
    //< Those are emitted by hand in `module.kspl`. It returns false where the table is not found.
    $in_table: = false
    $found: = false
    for line in harness.read_under_root(LLVM_CTX).lines(arena)
        t: = line.trim_spaces()
        if !in_table
            in_table = t.starts_with(PREAMBLE_HEAD)
            found = found || in_table
            continue
        if t.equals("}")
            break
        names: = scan.find_all(t, ".name = \"", "\"", arena)
        if names.len == 0
            continue
        named.push(names.get(0))
        if t.find_str(".ret = ").is_none()
            by_hand.push(names.get(0))
    return found && named.len > 0

priv fn push_unheld(put_out: List<|U8[]|>@, verb: U8[], std_declared: List<|U8[]|>@,
    by_hand: List<|U8[]|>@, bad: List<|U8[]|>$@, arena: Arena$@) //<
        //< Lists what `module.kspl` emits by hand under a name `std` declares
        //< It lists only a name the table does not leave to it.
    for n in put_out
        if std_declared.contains(n) && !by_hand.contains(n)
            bad
                .push(arena.text().s(n).s(": ").s(LLVM_MODULE).s(" ").s(verb).s(" it by hand and ")
                .s(LLVM_CTX).s("'s preamble_fns does not hold it without a .ret").take())

priv fn check_facade(arena: Arena$@)
    $std_declared: = List<|U8[]|>(arena)
    $defined: = List<|U8[]|>(arena)
    $declared: = List<|U8[]|>(arena)
    collect_declared(std_declared@, arena)
    collect_module_symbols(defined@, declared@, arena)

    // (1) The only `kspl_*` bodies in the IR are the ones that are `static inline` on the C side.
    $bad: = List<|U8[]|>(arena)
    for n in defined
        if n.starts_with("kspl_") && !is_inline_ok(n)
            bad
                .push(arena.text().s(n)
                .s(": there is a body in the IR (the C runtime alone holds a body)").take())
    verdict.check_list("there is no kspl_* body on the LLVM side", defined.len, "symbols", bad@,
        "put the body under ksplc/gen/runtime/ and leave the IR to std's extern \"C\" declare")

    // (2) What `module.kspl` emits by hand under a name `std` also declares is in the table with
    // no `.ret`, so `decl.kspl` skips `std`'s declare; and each such entry is emitted there. One
    // alone is an `invalid redefinition` or an unresolved symbol, **failing far from the cause**
    // (assembling the `.ll`, unseen until `make LLVM=1`). The table's own `declare`s and the
    // skipping come from one list and need no matching.
    $named: = List<|U8[]|>(arena)
    $by_hand: = List<|U8[]|>(arena)
    // Caution: **Fail where it is not found.** Continue with an empty list and the check goes green
    // having checked nothing.
    if !collect_preamble(named@, by_hand@, arena)
        verdict.check(arena.text().s("\{LLVM_CTX\}'s preamble_fns can be read").take(), false,
            "the table is not found")
        return
    $bad2: = List<|U8[]|>(arena)
    push_unheld(defined@, "defines", std_declared@, by_hand@, bad2@, arena)
    push_unheld(declared@, "declares", std_declared@, by_hand@, bad2@, arena)
    for n in by_hand
        if !defined.contains(n) && !declared.contains(n)
            bad2
                .push(arena.text().s(n).s(": ").s(LLVM_CTX).s("'s preamble_fns leaves it to ")
                .s(LLVM_MODULE).s(", which does not put it out (it becomes an unresolved symbol)")
                .take())
    verdict.check_list("what LLVM's preamble puts out by hand lines up with preamble_fns",
        named.len, "names", bad2@,
        "a function the preamble writes by hand must be in `preamble_fns`, and each listed one \
            written")

// ==========================================
// The reactor's token marks agree between the KSPL side and the C side **The marks are in two
// places.** The `pub const` in `std/reactor.kspl`, and the bits `kspl_net_poll` builds.
// `std/net.kspl` holds the one it asks for itself, so its marks are among the C side's too.
// ==========================================
priv const REACTOR_KSPL: U8[] = "std/reactor.kspl"
priv const REACTOR_USER: U8[] = "std/net.kspl"
priv const REACTOR_C: U8[] = "ksplc/gen/runtime/hosted_net.c"
priv const REACTOR_KSPL_MARK: U8[] = ": U8 = 0x"
priv const REACTOR_C_MARK: U8[] = "rv |= 0x"

priv fn bits_after(text: U8[], mark: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Pushes the one digit right after `mark`
    $out: = List<|U8[]|>(arena)
    for line in text.lines(arena)
        if at: = line.find_str(mark)
            rest: = line.sub_from(at + mark.len)
            if rest.len > 0 && rest.ptr.is_digit()
                out.push(rest.sub(0, 1))
    return out

priv fn check_reactor_bits(arena: Arena$@)
    $ours: = bits_after(harness.read_under_root(REACTOR_KSPL), REACTOR_KSPL_MARK, arena)
    $theirs: = bits_after(harness.read_under_root(REACTOR_C), REACTOR_C_MARK, arena)
    $bad: = List<|U8[]|>(arena)
    for b in ours.slice()
        if !theirs.contains(b)
            bad
                .push(arena.text().s("0x").s(b).s(" is not in ").s(REACTOR_C).take())
    for b in theirs.slice()
        if !ours.contains(b)
            bad
                .push(arena.text().s("0x").s(b).s(" is not in ").s(REACTOR_KSPL).take())
    $users: = bits_after(harness.read_under_root(REACTOR_USER), REACTOR_KSPL_MARK, arena)
    for b in users.slice()
        if !theirs.contains(b)
            bad
                .push(arena.text().s("0x").s(b).s(" in ").s(REACTOR_USER).s(" is not in ")
                .s(REACTOR_C).take())
    verdict.check_list("the reactor's token marks agree between the KSPL side and the C side",
        ours.len, "marks", bad@,
        "to add a mark, add it on both sides (the origin is the pub const in `std/reactor.kspl`)")

// ==========================================
// The child's stdio bits agree between the KSPL side and the C side `std/subproc.kspl` sums the
// `stdio_*` constants, and `kspl_proc_start` tests each by its number. A bit that one side moves
// pipes the wrong stream. Nothing fails until a child's output goes missing.
// ==========================================
priv const STDIO_KSPL: U8[] = "std/subproc.kspl"
priv const STDIO_C: U8[] = "ksplc/gen/runtime/hosted_spawn.c"

priv fn check_stdio_bits(arena: Arena$@)
    $ours: = List<|U8[]|>(arena)
    for line in harness.read_under_root(STDIO_KSPL).lines(arena)
        if line.starts_with("priv const STDIO_")
            if at: = line.find_str("= ")
                rest: = line.sub_from(at + 2)
                scan.push_unique(ours@,
                    rest.sub(0, rest.find_char(' ').unwrap_or(rest.len)))
    $theirs: = List<|U8[]|>(arena)
    for b in scan.find_all(harness.read_under_root(STDIO_C), "(stdio & ", ")", arena)
        scan.push_unique(theirs@, b)
    $bad: = List<|U8[]|>(arena)
    scan.diff_into(ours@, theirs@, STDIO_KSPL, STDIO_C, bad@, arena)
    scan.diff_into(theirs@, ours@, STDIO_C, STDIO_KSPL, bad@, arena)
    verdict.check_list("the child's stdio bits agree between the KSPL side and the C side",
        ours.len, "bits", bad@, "to add a bit, add it on both sides")

// ==========================================
// Windows's exit codes read as POSIX signals: the runtime's table and std's DESIGN-system.md
// ==========================================
priv const STATUS_C: U8[] = "ksplc/gen/runtime/hosted_proc.c"
priv const STATUS_DOC: U8[] = "std/docs/DESIGN-system.md"
priv const STATUS_C_HEAD: U8[] = "static int kspl_proc_status_code("
priv const STATUS_DOC_HEAD: U8[] = "### A child's end is one code on every OS"
priv const STATUS_SPLIT: U8[] = "@@@\n" //< parts a sample into its C half and its table half

priv fn c_status_rows(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< The `NAME=code` pairs of `kspl_proc_status_code`
    //< Each `case` line names an NTSTATUS in a `/* STATUS_... */` comment, and the next `return`
    //< gives the code of every name before it.
    $out: = List<|U8[]|>(arena)
    if at: = text.find_str(STATUS_C_HEAD)
        body: = text.sub_from(at)
        if end: = body.find_str("default:")
            $pending: = List<|U8[]|>(arena)
            for line in body.sub(0, end).lines(arena)
                names: = scan.find_all(line, "/* ", " */", arena)
                name: = names.get(0).trim_spaces() if names.len == 1 else ""
                if line.find_str("case ").is_some() && name.starts_with("STATUS_")
                    pending.push(name)
                codes: = scan.find_all(line, "return ", ";", arena)
                if codes.len == 1
                    for i in Range.asc(pending.len)
                        out
                            .push(arena.text().s(pending.get(i)).c('=')
                            .s(codes.get(0).trim_spaces()).take())
                    pending = List<|U8[]|>(arena)
    return out

priv fn doc_status_rows(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< The `NAME=code` pairs of the DESIGN-system.md table
    //< Every `` `STATUS_...` `` in a row's first cell is paired with the row's last cell.
    $out: = List<|U8[]|>(arena)
    if at: = text.find_str(STATUS_DOC_HEAD)
        after: = text.sub_from(at + STATUS_DOC_HEAD.len)
        section: = after.sub(0, after.find_str("\n### ").unwrap_or(after.len))
        for line in section.lines(arena)
            if !line.starts_with("| `STATUS_")
                continue
            cells: = line.trim_spaces().split('|', arena)
            if cells.len < 4
                continue
            code: = cells.get(cells.len - 2).trim_spaces()
            for name in scan.find_all(cells.get(1), "`", "`", arena)
                if name.starts_with("STATUS_")
                    out.push(arena.text().s(name).c('=').s(code).take())
    return out

priv fn status_tables_disagree(text: U8[], arena: Arena$@): Bool //<
    //< Whether a sample's C half and table half fail to agree (an empty half counts as failing)
    switch text.find_str(STATUS_SPLIT)
    case .none
        return true
    case .some(at)
        c: = c_status_rows(text.sub(0, at), arena)
        doc: = doc_status_rows(text.sub_from(at + STATUS_SPLIT.len), arena)
        if c.len == 0 || c.len != doc.len
            return true
        for i in Range.asc(c.len)
            if !doc.contains(c.get(i))
                return true
        return false

// The samples for the judgment above: the agreeing pair, and one break of each kind.
// Caution: **Keep a sample for each way the two can part.** These are a code changed, a name
// missing on either side, and a half that parses to nothing.
priv const STATUS_SAMPLES: Sample[_] = ::{
    Sample::{ .text =
        "static int kspl_proc_status_code(DWORD st) {\ncase 0xC0000005u: /* STATUS_ACCESS_VIOLATION \
            */\ncase 0xC00000FDu: /* STATUS_STACK_OVERFLOW */\nreturn 139; /* SIGSEGV */\ncase \
            0xC000013Au: /* STATUS_CONTROL_C_EXIT */\nreturn 130;\ndefault:\n}\n@@@\n### A child's \
            end is one code on every OS\n| `STATUS_ACCESS_VIOLATION`, `STATUS_STACK_OVERFLOW` | \
            `SIGSEGV` | 139 |\n| `STATUS_CONTROL_C_EXIT` | `SIGINT` | 130 |\n", .hits = false },
    Sample::{ .text =
        "static int kspl_proc_status_code(DWORD st) {\ncase 0xC0000005u: /* STATUS_ACCESS_VIOLATION \
            */\ncase 0xC00000FDu: /* STATUS_STACK_OVERFLOW */\nreturn 139; /* SIGSEGV */\ncase \
            0xC000013Au: /* STATUS_CONTROL_C_EXIT */\nreturn 130;\ndefault:\n}\n@@@\n### A child's \
            end is one code on every OS\n| `STATUS_ACCESS_VIOLATION`, `STATUS_STACK_OVERFLOW` | \
            `SIGSEGV` | 134 |\n| `STATUS_CONTROL_C_EXIT` | `SIGINT` | 130 |\n", .hits = true },
    Sample::{ .text =
        "static int kspl_proc_status_code(DWORD st) {\ncase 0xC0000005u: /* STATUS_ACCESS_VIOLATION \
            */\ncase 0xC00000FDu: /* STATUS_STACK_OVERFLOW */\nreturn 139; /* SIGSEGV */\ncase \
            0xC000013Au: /* STATUS_CONTROL_C_EXIT */\nreturn 130;\ndefault:\n}\n@@@\n### A child's \
            end is one code on every OS\n| `STATUS_ACCESS_VIOLATION` | `SIGSEGV` | 139 |\n| \
            `STATUS_CONTROL_C_EXIT` | `SIGINT` | 130 |\n", .hits = true },
    Sample::{ .text =
        "static int kspl_proc_status_code(DWORD st) {\ncase 0xC0000005u: /* STATUS_ACCESS_VIOLATION \
            */\nreturn 139;\ndefault:\n}\n@@@\n### A child's end is one code on every OS\n| \
            `STATUS_ACCESS_VIOLATION`, `STATUS_STACK_OVERFLOW` | `SIGSEGV` | 139 |\n| \
            `STATUS_CONTROL_C_EXIT` | `SIGINT` | 130 |\n", .hits = true },
    Sample::{ .text =
        "int other(void) {\ndefault:\n}\n@@@\n### A child's end is one code on every OS\n| \
            `STATUS_ACCESS_VIOLATION`, `STATUS_STACK_OVERFLOW` | `SIGSEGV` | 139 |\n| \
            `STATUS_CONTROL_C_EXIT` | `SIGINT` | 130 |\n", .hits = true },
    Sample::{ .text =
        "static int kspl_proc_status_code(DWORD st) {\ncase 0xC0000005u: /* STATUS_ACCESS_VIOLATION \
            */\ncase 0xC00000FDu: /* STATUS_STACK_OVERFLOW */\nreturn 139; /* SIGSEGV */\ncase \
            0xC000013Au: /* STATUS_CONTROL_C_EXIT */\nreturn 130;\ndefault:\n}\n@@@\n### Another \
            section\n", .hits = true },
}

priv fn check_status_table(arena: Arena$@)
    scan.check_samples("the judgment of the NTSTATUS tables' agreement can fire",
        Sample[]::STATUS_SAMPLES, "status_samples", status_tables_disagree, arena)
    c: = c_status_rows(harness.read_under_root(STATUS_C), arena)
    doc: = doc_status_rows(harness.read_under_root(STATUS_DOC), arena)
    $gaps: = List<|U8[]|>(arena)
    if c.len == 0
        gaps
            .push(arena.text().s(STATUS_C).s(": no `case` rows found in kspl_proc_status_code")
            .take())
    scan.diff_into(c@, doc@, STATUS_C, STATUS_DOC, gaps@, arena)
    scan.diff_into(doc@, c@, STATUS_DOC, STATUS_C, gaps@, arena)
    verdict.check_list("Windows's NTSTATUS codes read as the same signals in the runtime and the \
        doc", c.len, "codes", gaps@, "fix the side that is wrong (a row is `NAME=code`)")

fn run(arena: Arena$@) //< runs every check that the runtime and the KSPL side agree
    //< Caution: **Call it from `conventions_match.kspl`'s `run`** (there is one suite).
    check_reactor_bits(arena)
    check_stdio_bits(arena)
    check_status_table(arena)
    check_host_spellings(arena)
    check_facade(arena)

//< Keeps the boundaries of packages and folders from widening unnoticed
//< It is not a suite of its own; it is a part of conventions.
//< **Each of these builds either way**: an upward import, an entry point nobody calls, a list that
//< dropped a file. So the check reads the text to check the boundaries.
//< `tests/support/conventions_match.kspl` checks the implementation against the documents, the
//< grammar and the colouring.
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/sys"
import "std/verdict"
import "tests/support/conventions_scan" as scan
import "tests/support/harness"

// ==========================================
// The dependencies that cross sema's layers sema is layered, from the bottom, type / session /
// {decl, flow} / body. **The language only guards against cycles**: a sideways flow within one
// layer is not a cycle.
// ==========================================
priv const SEMA_CTX: U8[] = "ksplc/sema/session/ctx.kspl"

priv fn hook_name(line: U8[]): U8[] //< whether the field has the form `name: fn(`
    //< Caution: **Do not check the visibility** (a member cannot be wider than what encloses it).
    //< A filter by the modifier counts zero and goes silent the day the text changes.
    t: = line.trim_spaces().strip_prefix("pub ").strip_prefix("priv ")
    if at: = t.find_str(": fn(")
        name: = t.sub(0, at)
        for c in name
            if !(c.is_alnum() || c == '_')
                return ""
        return name
    return ""

priv fn import_paths(rel: U8[], arena: Arena$@): List<|U8[]|> //< the paths rel's imports name
    $out: = List<|U8[]|>(arena)
    for line in harness.read_under_root(rel).lines(arena)
        t: = line.trim_start()
        if !t.starts_with("import \"")
            continue
        path: = t.sub_from(8)
        if end: = path.find_char('"')
            out.push(path.sub(0, end))
    return out

priv fn imports_from(rel: U8[], prefix: U8[], out: List<|U8[]|>$@, arena: Arena$@) //<
    //< Whether rel writes an import starting with prefix (where so, it returns the line's text)
    for p in import_paths(rel, arena)
        if p.starts_with(prefix)
            out.push(arena.text().s(rel).s(" -> ").s(p).take())

priv const SIDEWAYS_ALLOWED: U8[][_] = ::{ "ksplc/sema/flow/stmt.kspl -> ksplc/sema/decl/eval" } //<
    //< The sideways flows allowed
    //< **Add to them and decl and flow merge into one layer.** The one here lets flow count the
    //< branches of a condition folded to a constant.

priv fn check_sema_layers(arena: Arena$@)
    $hooks: = List<|U8[]|>(arena)
    for line in harness.read_under_root(SEMA_CTX).lines(arena)
        h: = hook_name(line)
        if h.len > 0
            hooks.push(h)
    ok: = hooks.len == 1 && hooks.get(0).equals("infer_expr_fn")
    why: = arena.text().s("the hooks found:")
    for i in Range.asc(hooks.len)
        why.s(" ").s(hooks.get(i))
    verdict.check(arena.text()
        .s("the way round from decl to body is infer_expr_fn alone (\{SEMA_CTX\})").take(), ok,
        why.take())

    $up: = List<|U8[]|>(arena)
    $seen: Sz = 0
    for rel in harness.tracked_matching(U8[][]::{ "ksplc/sema/decl/*.kspl" })
        seen += 1
        imports_from(rel, "ksplc/sema/body/", up@, arena)
    verdict.check_list("ksplc/sema/decl does not import ksplc/sema/body", seen, "files", up@,
        "move what decl needs from body down into decl, or into a folder both use")

    // session is the base that decl / flow / body all depend on, so even one upward import merges
    // the three layers into one.
    $up_ctx: = List<|U8[]|>(arena)
    $ctx_seen: Sz = 0
    for rel in harness.tracked_matching(U8[][]::{ "ksplc/sema/session/*.kspl" })
        ctx_seen += 1
        for pre in U8[][]::{ "ksplc/sema/decl/", "ksplc/sema/flow/", "ksplc/sema/body/" }
            imports_from(rel, pre, up_ctx@, arena)
    verdict.check_list("ksplc/sema/session does not import decl / flow / body", ctx_seen, "files",
        up_ctx@, "session sits below decl / flow / body: move the shared part down into session")

    $sideways: = List<|U8[]|>(arena)
    for pair in U8[][]::{ "decl flow", "flow decl" }
        group: = pair.sub(0, 4)
        other: = pair.sub_from(5)
        pat: = arena.text().s("ksplc/sema/").s(group).s("/*.kspl").take()
        pre: = arena.text().s("ksplc/sema/").s(other).s("/").take()
        for rel in harness.tracked_matching(U8[][]::{ pat })
            imports_from(rel, pre, sideways@, arena)
    $bad: = List<|U8[]|>(arena)
    for i in Range.asc(sideways.len)
        $allowed: = false
        for a in SIDEWAYS_ALLOWED
            if sideways.get(i).equals(a)
                allowed = true
        if !allowed
            bad
                .push(arena.text().s("a sideways flow not in the list: ").s(sideways.get(i)).take())
    for a in SIDEWAYS_ALLOWED
        if !sideways.contains(a)
            bad
                .push(arena.text().s("a sideways flow that has gone (delete it from the list): ")
                .s(a).take())
    verdict.check_list("the sideways flows between decl and flow are only the ones let through",
        SIDEWAYS_ALLOWED.len, "flows", bad@,
        "cut the new edge, or add it to `sideways_allowed` with the reason")

// ==========================================
// ksos's folders import only those below them **The compiler does not see an upward edge** that
// closes no cycle: a driver importing a board builds, and then serves that board alone.
// ==========================================

// Each folder, then the folders it may import, itself included (the run is in ksos/README.md).
// **`tests` is left out**: a test reaches whatever it checks.
priv const KSOS_LAYERS: U8[][_] = ::{ "kernel", "kernel", "net", "net", "drivers", "kernel drivers",
    "boards", "kernel drivers boards", "demo", "kernel net drivers boards demo", "port", "" }

priv fn check_ksos_layers(arena: Arena$@)
    $bad: = List<|U8[]|>(arena)
    $seen: Sz = 0
    for i in Range(0, KSOS_LAYERS.len, 2)
        folder: = arena.text().s("ksos/").s(KSOS_LAYERS[i]).s("/").take()
        allowed: = KSOS_LAYERS[i + 1].split(' ', arena)
        for rel in harness
            .tracked_matching(U8[][]::{ arena.text().s(folder).s("*.kspl").take() })
            seen += 1
            for p in import_paths(rel, arena)
                if !p.starts_with("ksos/")
                    continue
                rest: = p.sub_from(5)
                top: = rest.sub(0, rest.find_char('/').unwrap_or(rest.len))
                $ok: = false
                for a in allowed
                    if a.equals(top)
                        ok = true
                if !ok
                    bad.push(arena.text().s(rel).s(" -> ").s(p).take())
    verdict.check_list("a ksos folder imports only those below it", seen, "files", bad@,
        "the run is in \"What is here\" in ksos/README.md")

// ==========================================
// The reference-direction table matches the list the check holds. **The canonical source is the
// table in `docs/SPEC-documents.md`**.
// Only the directions between implementations are compared.
// ==========================================
priv const DIR_CANON: U8[] = "docs/SPEC-documents.md"
priv const DIR_COPY: U8[] = "tests/suite/docref_test.kspl"

priv fn units_of(md: U8[], row: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Picks up the packages' names (`` `x/` ``) in that tier's row of the table
    //< **Other rows start with the same words** (a tier's name heads another table's column too).
    //< So the answer is **the row in which at least one package can be picked up**.
    $out: = List<|U8[]|>(arena)
    for line in md.lines(arena)
        if !line.starts_with(row)
            continue
        for w in scan.find_all(line, "`", "/`", arena)
            scan.push_unique(out@, w)
        if out.len > 0
            return out
    return out

priv fn arrows_of(md: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Picks up the allowed directions (`` `A→B` ``) in the whole document
    //< It may be in the table's row or the note below it. **A direction the tiers decide is not
    //< written as an arrow**; only "is it somewhere in the document" is checked.
    //< Caution: **Do not read it as guaranteeing "it is in the table".**
    $out: = List<|U8[]|>(arena)
    for w in scan.find_all(md, "`", "`", arena)
        if w.find_str("→").unwrap_or(0) > 0
            scan.push_unique(out@, w)
    return out

priv fn copy_targets(src: U8[], unit: U8[], arena: Arena$@): List<|U8[]|> //<
    //< The targets of one `layer_to` line the check holds, without its first word
    //< The line has the form `"ksplc docs std root"`.
    $out: = List<|U8[]|>(arena)
    head: = arena.text().s("\"").s(unit).s(" ").take()
    if at: = src.find_str(head)
        rest: = src.sub_from(at + head.len)
        if end: = rest.find_str("\"")
            for w in rest.sub(0, end).split(' ', arena)
                if w.len > 0
                    scan.push_unique(out@, w)
    return out

priv fn check_reference_arrows(arena: Arena$@)
    md: = harness.read_under_root(DIR_CANON)
    copy: = harness.read_under_root(DIR_COPY)
    units: = units_of(md, "| implementation ", arena)
    leaves: = units_of(md, "| leaf ", arena)
    arrows: = arrows_of(md, arena)
    $bad: = List<|U8[]|>(arena)
    if units.len <= 0 || leaves.len <= 0 || arrows.len <= 0
        bad.push("the table's tier rows cannot be read")
    for from in units
        targets: = copy_targets(copy, from, arena)
        if targets.len <= 0
            bad
                .push(arena.text().s(from).s(": there is no list of destinations in ").s(DIR_COPY)
                .take())
            continue
        // Of the directions the check allows, whether the ones the tiers do not decide are in the
        // table.
        // Caution: **Check the edges pointing from an implementation to a leaf too.** The table
        // decides only "between implementations" and "a leaf points upward", so such an edge **fits
        // neither**; require an arrow for it.
        for k in Range.asc(targets.len)
            to: = targets.get(k)
            if to.equals(from) || (!units.contains(to) && !leaves.contains(to))
                continue
            want: = arena.text().s(from).s("→").s(to).take()
            if !arrows.contains(want)
                bad
                    .push(arena.text().s(want).s(": ").s(DIR_COPY).s(" lets it through and ")
                    .s(DIR_CANON).s("'s table does not hold it").take())
        // Whether the check allows the directions the table holds.
        for k in Range.asc(arrows.len)
            a: = arrows.get(k)
            cut: = a.find_str("→").unwrap_or(0)
            if cut == 0 || !a.sub(0, cut).equals(from)
                continue
            to: = a.sub_from(cut + 3)
            if !targets.contains(to)
                bad
                    .push(arena.text().s(a).s(": it is in ").s(DIR_CANON).s("'s table and ")
                    .s(DIR_COPY).s(" does not let it through").take())
    verdict.check_list("the reference-direction table and the check line up", arrows.len,
        "directions", bad@,
        "drifting makes the shape \"the documents forbid it and the check lets it through\"")

// ==========================================
// No `pub` builds up under an entry point **[I0402] cannot check it.** It uses the setting found
// from the entry point's file. So at a demo's entry point it names the kernel's and drivers' `pub`
// too (those stay, as a promise to their users).
// ==========================================
priv const ENTRY_TREES: U8[][_] = ::{ "ksos/demo" }

priv fn check_no_pub_in_entries(arena: Arena$@)
    $bad: = List<|U8[]|>(arena)
    $seen: Sz = 0
    for i in Range.asc(ENTRY_TREES.len)
        $pats: = List<|U8[]|>(arena)
        pats.push(arena.text().s(ENTRY_TREES[i]).s("/*.kspl").take())
        pats.push(arena.text().s(ENTRY_TREES[i]).s("/*/*.kspl").take())
        pats.push(arena.text().s(ENTRY_TREES[i]).s("/*/*/*.kspl").take())
        for rel in harness.tracked_matching(pats.slice())
            seen += 1
            $no: Sz = 0
            for line in harness.read_under_root(rel).lines(arena)
                no += 1
                if line.trim_start().starts_with("pub ")
                    bad.push(arena.text().s(rel).s(":\{no\}").take())
    verdict.check_list("there is no pub under an entry point", seen, "files", bad@,
        "no package imports a demo, so a pub widens no destination it reaches")

// ==========================================
// The wasm's boundary (the text's `#export` and the JS's calls)
// Caution: **Both directions break silently.** The link passes though the JS calls a name that is
// not in the text, and "there is no such function" first shows up in the browser.
// ==========================================
priv const WEB_PREFIX: U8[] = "ksmd_web_"
priv const WEB_KSPL: U8[] = "ksmd/port/web/*.kspl"
priv const WEB_JS: U8[] = "ksmd/port/web/*.js"

priv fn web_names_in(src: U8[], out: List<|U8[]|>$@) //<
    //< Picks up the names starting with `ksmd_web_`
    //< Caution: **Read to the end of the name**, or a name mentioned mid-sentence picks up
    //< everything after it.
    $rest: U8[] = src
    for rest.len > 0
        if at: = rest.find_str(WEB_PREFIX)
            rest = rest.sub_from(at + WEB_PREFIX.len)
            $i: Sz = 0
            for i < rest.len && (rest[i].is_alnum() || rest[i] == '_')
                i += 1
            if i > 0
                scan.push_unique(out, rest.sub(0, i))
        else
            return

priv fn web_exports(arena: Arena$@): List<|U8[]|> //< the exported entry points
    //< Caution: **Check only a `fn` at the start of a line** (count the places that mention a name
    //< mid-sentence and the entry points multiply).
    $out: = List<|U8[]|>(arena)
    $marks: Sz = 0
    for rel in harness.tracked_matching(U8[][]::{ WEB_KSPL })
        for line in harness.read_under_root(rel).lines(arena)
            if line.equals("#export")
                marks += 1
            if line.starts_with("fn ksmd_web_")
                rest: = line.sub_from(3 + WEB_PREFIX.len)
                at: = rest.find_str("(").unwrap_or(0)
                if at > 0
                    scan.push_unique(out@, rest.sub(0, at))
    // Caution: **Check the count too.** An entry point not starting with `ksmd_web_` widens the
    // boundary unseen by the walk above. **Two counts of 0 are not an agreement** (the case
    // `verdict.check_list`'s floor refuses; this passes a verdict itself).
    verdict.check("every wasm entry point that goes out begins ksmd_web_",
        marks == out.len && out.len > 0,
        arena.text().s("\{marks\} #export, \{out.len\} fn beginning ksmd_web_").take())
    return out

priv fn check_wasm_boundary(arena: Arena$@)
    $out: = web_exports(arena)
    $used: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::{ WEB_JS })
        web_names_in(harness.read_under_root(rel), used@)
    $bad: = List<|U8[]|>(arena)
    scan.diff_into(out@, used@, "the text's #export", WEB_JS, bad@, arena)
    scan.diff_into(used@, out@, WEB_JS, "the text's #export", bad@, arena)
    verdict.check_list("the wasm's boundary agrees on both sides", out.len, "entry points", bad@,
        "leave no entry point nobody calls (Principle 5). Calling an absent one fails in the \
            browser")

// ==========================================
// A list written by hand has not dropped one of the folder's real files
// The compiler's README names each layer folder's files, and each package's README its documents.
// Each list's own header says why it cannot include a whole folder at once.
// ==========================================

// An entry is the list's heading, the file holding it, the files it must name, and a folder to
// skip. **The holder itself is not required to be listed**: a README would have to name itself.
// The folder to skip leaves out one whose own guide holds its list (`tools/ai_assist/`), since a
// `*` crosses a `/`.
priv const SKIP_NONE: U8[] = ""
priv const HAND_LISTS: U8[][_] = ::{ "the parse layer's guide", "ksplc/README.md",
    "ksplc/parse/*.kspl", SKIP_NONE, "the lower layer's guide", "ksplc/README.md",
    "ksplc/lower/*.kspl", SKIP_NONE, "the guide to what the backends share", "ksplc/README.md",
    "ksplc/gen/*.kspl", SKIP_NONE, "the gen/c layer's guide", "ksplc/README.md",
    "ksplc/gen/c/*.kspl", SKIP_NONE, "the gen/llvm layer's guide", "ksplc/README.md",
    "ksplc/gen/llvm/*.kspl", SKIP_NONE, "the lsp layer's guide", "ksplc/README.md",
    "ksplc/lsp/*.kspl", SKIP_NONE, "the formatter's guide", "ksplc/README.md", "ksplc/fmt/*.kspl",
    SKIP_NONE, "the tools layer's guide", "ksplc/README.md", "ksplc/tools/*.kspl", SKIP_NONE,
    "the base layer's guide", "ksplc/README.md", "ksplc/base/*.kspl", SKIP_NONE, "the tools' guide",
    "tools/README.md", "tools/*.kspl", "tools/ai_assist/", "ksos's table of documents",
    "ksos/README.md", "ksos/docs/*.md", SKIP_NONE, "std's table of documents", "std/README.md",
    "std/docs/*.md", SKIP_NONE, "ksplc's table of documents", "ksplc/README.md", "ksplc/docs/*.md",
    SKIP_NONE, "kspeg's table of documents", "kspeg/README.md", "kspeg/docs/*.md", SKIP_NONE,
    "ksai's table of documents", "ksai/README.md", "ksai/docs/*.md", SKIP_NONE,
    "ksdb's table of documents", "ksdb/README.md", "ksdb/docs/*.md", SKIP_NONE,
    "ksbind's table of documents", "ksbind/README.md", "ksbind/docs/*.md", SKIP_NONE,
    "kssrv's table of documents", "kssrv/README.md", "kssrv/docs/*.md", SKIP_NONE,
    "ksmd's table of documents", "ksmd/README.md", "ksmd/docs/*.md", SKIP_NONE,
    "tools's table of documents", "tools/README.md", "tools/*.md", SKIP_NONE,
    "tests's table of documents", "tests/README.md", "tests/*.md", SKIP_NONE,
    "tests/docs's table of documents", "tests/README.md", "tests/docs/*.md", SKIP_NONE,
    "ai_assist's guide", "tools/ai_assist/README.md", "tools/ai_assist/*.kspl", SKIP_NONE,
    "docs's table of documents", "docs/README.md", "docs/*.md", SKIP_NONE,
    "tools/docs's table of documents", "tools/README.md", "tools/docs/*.md", SKIP_NONE }

priv fn check_hand_lists(arena: Arena$@) //<
    //< Whether the body of the file holding the list names that folder's real files one by one
    //< Caution: **Check only whether it is in the body.** The lists are written differently (a
    //< table row, a link, a name in backquotes). A check that relies on the format goes silent the
    //< day a list is rewritten.
    $bad: = List<|U8[]|>(arena)
    $seen: Sz = 0
    for i in Range.asc(HAND_LISTS.len)
        if i % 4 != 0
            continue
        what: = HAND_LISTS[i]
        holder: = harness.read_under_root(HAND_LISTS[i + 1])
        skip: = HAND_LISTS[i + 3]
        for rel in harness.tracked_matching(U8[][]::{ HAND_LISTS[i + 2] })
            said: = sys.get_file_name(rel)
            if said.equals(sys.get_file_name(HAND_LISTS[i + 1])) ||
                skip.len > 0 && rel.starts_with(skip)
                continue
            seen += 1
            if holder.find_str(said).is_none()
                bad
                    .push(arena.text().s(what).s(" (").s(HAND_LISTS[i + 1]).s(") does not name ")
                    .s(rel).take())
    verdict.check_list("a hand-written list has dropped none of the folder's real files", seen,
        "files", bad@,
        "add it on the list's side (a drop goes on green, so this is the only place to notice)")

fn run(arena: Arena$@)
    check_sema_layers(arena)
    check_reference_arrows(arena)
    check_ksos_layers(arena)
    check_no_pub_in_entries(arena)
    check_wasm_boundary(arena)
    check_hand_lists(arena)

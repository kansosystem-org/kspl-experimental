//< The repository's side of the base every tests/*_test.kspl uses
//< **It starts ksplc's harness (`../../ksplc/tests/support/harness.kspl`) on the repository's
//< paths.** A suite ends, runs a child and runs the compiler under test through that one
//< (`ksplc_harness.*`). It finds here what knows the repository: its root, `make` from
//< it, the files git knows. Caution: **Do not rewrite either in a suite.** In a copy, CI's log
//< stops being readable, and the Makefile's reading of the `RESULT:` line stops matching. The
//< compiler under test is `out/ksplc_stage1.exe` (replaceable by `KANSO_CC_EXE`). **It is separate
//< from the one that builds this suite**, which the Makefile pins to the seed (`../README.md`).
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/ds" { List, Map }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/sys"
import "std/verdict"

priv $root_dir: U8[] = "" //< `root`'s answer, settled by `begin`

fn begin(chunk_size: Sz): Arena$@ //< starts a suite on the repository's paths
    //< They go to `ksplc_harness.begin_at`, whose `finish` / `fatal` end the suite;
    //< children start in the root. Caution: **Call it once, at the start of `main`.** **Do not
    //< free what it returns with a `defer`** (a double free).
    defer found: = Arena.new(64 * 1024)
    top: = find_root(found)
    arena: = ksplc_harness.begin_at(chunk_size, compiler_under_test(top, found),
        fs.join(top, "std", found), fs.join(top, "out/tmp", found), top)
    root_dir = arena.dup_str(top)
    return arena

// ==========================================
// The paths
// ==========================================

priv fn absolute(path: U8[], arena: Arena$@): U8[] //<
    //< the path from the root, joined onto the working directory
    //< Caution: **Always return the root as an absolute path.** A child started in another cwd
    //< (`run_in`) reads a relative root **from its own cwd** and fails to start.
    return fs.absolute(path, arena) catch
        fallback arena.dup_str(path)

fn root(): U8[] //< the repository's root, absolute
    return root_dir

priv fn find_root(arena: Arena$@): U8[] //< the repository's root, as `begin` settles it
    //< `KANSO_ROOT` has the highest priority; without it, the search goes up from the running
    //< script.
    //< Caution: **Do not count the levels**: a script may be at any depth under the root. **Do not
    //< keep `get_env`'s return value as it is**: it views libc's static buffer, which changes the
    //< moment an environment variable is next touched.
    explicit: = sys.get_env("KANSO_ROOT").unwrap_or("")
    if explicit.len > 0
        return absolute(explicit, arena)
    script: = sys.script_path().unwrap_or("")
    if script.len == 0
        return absolute("", arena)
    $dir: = absolute(sys.get_dir_name(script), arena)
    for dir.len > 0
        if is_root_dir(dir, arena)
            return dir
        up: = sys.get_dir_name(dir)
        if up.len >= dir.len
            break
        dir = arena.dup_str(up)
    return absolute("", arena)

priv fn is_root_dir(dir: U8[], arena: Arena$@): Bool //<
    //< whether it is a folder holding the landmark files
    //< Caution: **Check for two.** `Makefile` alone matches a package's folder too.
    return fs.exists(fs.join(dir, "Makefile", arena)) &&
        fs.is_dir(fs.join(dir, "ksplc", arena))

priv const STAGE1_REL: U8[] = "out/ksplc_stage1.exe" //<
    //< the compiler make builds first, from the root

priv fn compiler_under_test(top: U8[], arena: Arena$@): U8[] //<
    //< `out/ksplc_stage1.exe`, which CI replaces with `KANSO_CC_EXE`
    explicit: = sys.get_env("KANSO_CC_EXE").unwrap_or("")
    if explicit.len > 0
        return absolute(explicit, arena)
    return fs.join(top, STAGE1_REL, arena)

fn ksplc_argv_anywhere(args: U8[][]): U8[][] //<
    //< `ksplc_harness.ksplc_argv` with `--pkg-src-dir=` the root, for a run in another folder
    //< From the root a package is found by its folder; elsewhere, only by the option.
    arena: = ksplc_harness.arena()
    $all: = List<|U8[]|>.new(arena)
    all.push(arena.text().s("--pkg-src-dir=").s(root_dir).take())
    for a in args
        all.push(a)
    return ksplc_harness.ksplc_argv(all.slice())

fn private_docs(): List<|U8[]|> //< the documents a clone carries beyond the published copy
    //< Entries split at spaces from `KANSO_PRIVATE_DOCS`, which only such a clone sets; unset, the
    //< list is empty. An entry is a file name, or a folder from the top ending in `/`. A check that
    //< names documents takes these as the clone's own (`is_private_doc`).
    arena: = ksplc_harness.arena()
    $out: = List<|U8[]|>.new(arena)
    given: = arena.dup_str(sys.get_env("KANSO_PRIVATE_DOCS").unwrap_or(""))
    for w in given.split(' ', arena)
        if w.len > 0
            out.push(w)
    return out

fn is_private_doc(rel: U8[], own: List<|U8[]|>@): Bool //<
    //< Whether a tracked path is one of the clone's own documents (`private_docs`)
    //< **A folder's entry takes everything under it**; any other matches the file's name.
    for o in own
        if o.ends_with("/") && rel.starts_with(o) || sys.get_file_name(rel).equals(o)
            return true
    return false

// ==========================================
// `make` from the root
// ==========================================

fn make(args: U8[][]): verdict.Run_out //< runs `make` once (`make_argv`)
    return ksplc_harness.run(make_argv(args))

fn make_argv(args: U8[][]): U8[][] //<
    //< The argv that runs `make` with these arguments, for one run or for a `subproc.Job`
    //< **Do not let it rebuild stage1 (`-o`)**: under `make -j test-ci` another suite may be
    //< running it, and on Windows a running exe cannot be replaced. **Do not call `make` by name
    //< (`KANSO_MAKE`)**: PATH may give a different make.
    arena: = ksplc_harness.arena()
    // Caution: Drop the job server's setting. This process is not make's child and holds no token.
    // On Windows the named semaphore cannot open, and a warning is printed.
    sys.unset_env("MAKEFLAGS") catch panic("MAKEFLAGS could not be unset")
    sys.unset_env("MFLAGS") catch panic("MFLAGS could not be unset")
    sys.unset_env("MAKELEVEL") catch panic("MAKELEVEL could not be unset")
    $argv: = List<|U8[]|>.new(arena)
    argv.push(arena.dup_str(sys.get_env("KANSO_MAKE").unwrap_or("make")))
    argv.push("-o")
    argv.push(arena.dup_str(STAGE1_REL))
    for a in args
        argv.push(a)
    return argv.slice()

// ==========================================
// The temporary directory
// ==========================================

fn sandbox(name: U8[]): U8[] //<
    //< Makes a workspace for this suite only and returns it (`out/tmp/<name>_<mark>`)
    //< A suite that cannot make one stops (`ksplc_harness.sandbox`).
    //< It deletes the previous run's `<name>_…` folders first: no Makefile empties `out/tmp`.
    //< Caution: **Do not delete a fixed folder and then create it.** Where it cannot be deleted (a
    //< sync client or virus scanner holding a handle on Windows), no case runs from then on.
    arena: = ksplc_harness.arena()
    sweep_old_dirs(ksplc_harness.tmp_dir(), arena.text().s("\{name\}_").take(), arena)
    return ksplc_harness.sandbox(name)

priv fn sweep_old_dirs(base: U8[], prefix: U8[], arena: Arena$@) //<
    //< Deletes the `<prefix>…` folders directly under base
    //< Caution: **Do not report a failure to delete**: the cleanup would hide the real result, and
    //< this run's workspace has another name.
    entries: = fs.read_dir(base, arena) catch
        return
    for name in entries
        if !name.starts_with(prefix)
            continue
        full: = fs.join(base, name, arena)
        remove_tree(full)

fn remove_tree(dir: U8[]) //< deletes a whole tree
    //< Caution: **Pass it only paths inside the workspace.** A failure to delete is not reported
    //< (check with fs.exists). **It stays out of `std/fs`**: its check-then-descend race is
    //< harmless only over a tree that only this run made.
    clear_tree(dir, 0)
    fs.remove_path(dir) catch {}

priv const MAX_CLEAR_DEPTH: Sz = 32 //< how deep deleting a workspace this run made descends
    //< Caution: **Do not pass anything but a workspace here.** **Remove a link without following
    //< it**: followed, it deletes what it points at, even outside the workspace (`fs.is_link`
    //< first).

priv fn clear_tree(dir: U8[], depth: Sz)
    if depth >= MAX_CLEAR_DEPTH || !fs.is_dir(dir)
        return
    defer scratch: = Arena.new(1024 * 1024)
    entries: = fs.read_dir(dir, scratch) catch
        return
    for name in entries
        full: = fs.join(dir, name, scratch)
        if !fs.is_link(full)
            clear_tree(full, depth + 1)
        fs.remove_path(full) catch { // leave what cannot be erased.
            // Caution: Do not report here. The workspace's cleanup would hide the real result.
        }

// ==========================================
// The files git knows
// ==========================================

priv $listed: List<|U8[]|>$@ = null //< `tracked`'s answer, kept from its first call
priv $texts: Map<|U8[], U8[]|>$@ = null //< `read_under_root`'s answers, by the path from the root

fn tracked(): List<|U8[]|> //<
    //< The tracked files plus the untracked files that are not ignored, asked of git once a suite
    //< Caution: **Do not pass a wildcard to `git ls-files`** (the reason is at `tracked_matching`
    //< below); the caller narrows the list. **Do not list the tracked files alone**: a new file is
    //< absent until committed and slips past the check. **Every call shares one list**: change none
    //< of its elements, and write a case's own files in `sandbox` (a later file is not listed).
    //< Caution: **Where git cannot list them, the suite ends failed here.** Handed an empty list,
    //< every walk over it would find nothing wrong and pass, having read nothing.
    if listed == null
        arena: = ksplc_harness.arena()
        out: = List<|U8[]|>.create(arena)
        collect_ls_files(U8[][]::{ "git", "ls-files" }, out, arena) catch
            sys.exit(ksplc_harness.fatal("git cannot list the files it knows (git ls-files)"))
        collect_ls_files(U8[][]::{ "git", "ls-files", "--others", "--exclude-standard" }, out,
            arena) catch
            sys.exit(ksplc_harness.fatal("git cannot list the untracked files (git ls-files)"))
        listed = out
    return listed$

enum Run_error
    failed //< git cannot be started, or it exited non-zero

fn read_under_root(rel: U8[]): U8[] //<
    //< Reads a file under the root (length 0 where it cannot be read), once a suite
    //< The repository's files are LF by `.gitattributes`. Caution: **What is written under the root
    //< after the first read is not seen**: the text is the one read first.
    arena: = ksplc_harness.arena()
    if texts == null
        texts = arena.create(Map<|U8[], U8[]|>.new(arena))
    if known: = texts.get(rel)
        return known
    body: = io.read_file(fs.join(root_dir, rel, arena), arena) catch ""
    texts.set(arena.dup_str(rel), body)
    return body

fn copy_tracked(dir: U8[], to: U8[], keep_prefix: Bool): Bool //<
    //< Copies the files `tracked` lists under the folder dir into to; false where none is copied
    //< keep_prefix keeps `dir/` in each copy's path; otherwise each lands right under to.
    arena: = ksplc_harness.arena()
    $rels: = List<|U8[]|>.new(arena)
    $bodies: = List<|U8[]|>.new(arena)
    for rel in tracked_matching(U8[][]::{ dir })
        rels.push(rel if keep_prefix else rel.sub_from(dir.len + 1))
        bodies.push(read_under_root(rel))
    fs.write_tree(to, rels.slice(), bodies.slice(), arena) catch
        return false
    return rels.len > 0

priv fn spec_match(path: U8[], spec: U8[]): Bool //< whether it matches git's pathspec
    //< **A `*` crosses a `/`** (`*.md` matches at any level), unlike a shell's or fnmatch's; `**`
    //< is the same as `*`. A pattern with no wildcard names a folder too (as in git).
    if spec.find_char('*').is_none() && spec.find_char('?').is_none()
        return path.equals(spec) ||
            path.starts_with(spec.strip_suffix("/")) &&
            path.len > spec.strip_suffix("/").len &&
            path[spec.strip_suffix("/").len] == '/'
    return glob_at(path, 0, spec, 0)

priv fn glob_at(path: U8[], i: Sz, spec: U8[], j: Sz): Bool //<
    //< Whether `spec[j..]` matches the whole of `path[i..]` (checked with backtracking)
    if j >= spec.len
        return i >= path.len
    if spec[j] == '*'
        $k: = j
        for k < spec.len && spec[k] == '*'
            k += 1
        for $n: = i; n <= path.len; n += 1
            if glob_at(path, n, spec, k)
                return true
        return false
    if i >= path.len
        return false
    if spec[j] == '?' || spec[j] == path[i]
        return glob_at(path, i + 1, spec, j + 1)
    return false

fn tracked_matching(patterns: U8[][]): List<|U8[]|> //<
    //< the files git knows that match the pathspec
    //< Caution: **Do not walk the working tree**: it picks up artifacts and leftovers too. **Do not
    //< pass a pathspec to `git ls-files`.** On Windows a `git.exe` on MSYS2's runtime **expands the
    //< wildcards itself**. So `*.md` shrinks to the top level and goes green unseen.
    arena: = ksplc_harness.arena()
    $out: = List<|U8[]|>.new(arena)
    files: = tracked()
    for f in files
        $keep: = false
        $drop: = false
        for p in patterns
            if p.starts_with(":!")
                drop = drop || spec_match(f, p.sub_from(2))
            else
                keep = keep || spec_match(f, p)
        if keep && !drop
            out.push(f)
    // **An exclusion (`:!`) that matches nothing is normal**; only including patterns are checked.
    for p in patterns
        if p.starts_with(":!") || p.find_char('*').is_some() || p.find_char('?').is_some()
            continue
        $seen: = false
        for f in files
            if spec_match(f, p)
                seen = true
                break
        // Caution: **Do not use `fatal`**: it frees the suite's arena, so `files` and `out` would
        // be read freed. A slip in the check itself stops it here.
        if !seen
            panic(U8$[]::arena.text().s("there is a pattern matching not one tracked file: \{p\}")
                .take())
    return out

priv fn collect_ls_files(argv: U8[][], out: List<|U8[]|>$@, arena: Arena$@): Void!Run_error
    r: = ksplc_harness.run(argv)
    if !r.exited_with(0)
        _ok: = verdict.check("git ls-files ran", false, r.out)
        throw .failed
    for ln in r.out.lines(arena)
        path: = ln.trim_spaces()
        if path.len > 0
            out.push(path)

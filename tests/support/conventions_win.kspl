//< Forbids code that is **green locally but breaks only on Windows**
//<
//< It is not a suite of its own; it is a part of conventions.
//< **Each of them runs correctly on Linux and macOS.** So they pass for whoever wrote them and show
//< up first in CI's Windows job or on a user's machine. The symptom is not "it fails" but **"the
//< covered range silently shrinks", "an invisible byte gets mixed in", "that one entry point can
//< start nothing"**. So the log leads to no cause.
//< Note: Which Windows jobs run the gates is "What each platform runs" in `docs/SPEC-gates.md`.
import "std/chars" // `trim_spaces`
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/conventions_scan" as scan + { Sample }
import "tests/support/harness"

// ==========================================
// 8. A test does not cut a child's output into lines by hand **Only on Windows is a `\r` left at
// the end of the cut text**.
// Note: Two functions split lines (`line_after` in `tests/support/harness_text.kspl`, `lines`
// in `std/str`). Both drop a `\r` at a line's end.
// ==========================================

priv const HAND_CUT: U8[] = "find_char('\\n')"

priv fn cuts_by_hand(line: U8[], arena: Arena$@): Bool //< whether it cuts into lines by hand
    //<
    //< String literals and line comments are dropped first, so this section's own explanation is
    //< not hit.
    //< Caution: **Keep the judging in this one place.** The check and its samples both call it. So
    //< the samples show the very judgment the check runs ("a check shows it can fire" in
    //< `conventions_scan.kspl`).
    return scan.strip_code(line, arena).find_str(HAND_CUT).is_some()

priv fn check_line_cut(arena: Arena$@)
    $bad: = List<|U8[]|>.new(arena)
    $seen: Sz = 0
    for rel in harness.tracked_matching(U8[][]::{ "tests/*.kspl", "tests/*.ksplb" })
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            i += 1
            seen += 1
            if cuts_by_hand(line, arena)
                bad
                    .push(arena.text().s(rel).s(":\{i\}: it cuts into lines by hand").take())
    verdict.check_list("a test does not cut a child's output into lines by hand", seen, "lines",
        bad@,
        "go through harness's line_after or std/str's lines (a \\r is left at the cut text's end)")

// ==========================================
// `fs.is_executable` is not used for the check before starting **`is_executable` is always false on
// Windows** (no execute bit there); `fs.can_run` answers that.
// ==========================================
priv const SPAWN_CALLS: U8[][_] = ::{ "spawn_piped", "spawn_redirect", "spawn_wait", "spawn_async",
    "run_capture" }

priv fn gates_on_exec(body: U8[], _arena: Arena$@): Bool //<
    //< Whether a file that starts a child uses that predicate for the check before starting
    //<
    //< Caution: **Keep the judging in this one place** (the reason is at `cuts_by_hand`).
    if body.find_str("is_executable").is_none()
        return false
    for call in SPAWN_CALLS
        if body.find_str(call).is_some()
            return true
    return false

priv fn check_exec_gate(arena: Arena$@)
    $bad: = List<|U8[]|>.new(arena)
    $seen: Sz = 0
    for rel in harness.tracked_matching(U8[][]::scan.KSPL_SPECS)
        body: = harness.read_under_root(rel)
        seen += 1
        // **There are exactly three exemptions**: the predicate's definition, the test pinning it
        // to false on Windows, and this check.
        if rel.equals("std/fs.kspl") || rel.equals("std/tests/sys_test.kspl") ||
            rel.equals("tests/support/conventions_win.kspl")
            continue
        if gates_on_exec(body, arena)
            bad
                .push(arena.text().s(rel).s(": it starts a child and holds `is_executable`").take())
    verdict.check_list("`fs.is_executable` is not used for the check before starting", seen, "files",
        bad@, "use `fs.can_run` (`is_executable` is always false on Windows)")

// ==========================================
// 9. `/tmp` is not written straight into a place's text **There is no `/tmp` on Windows.**
// Opening it gives a `FileNotFoundError`, which shows up first there or in the Windows job.
// ==========================================

priv const TMP_LITERALS: U8[][_] = ::{ "\"/tmp/", "'/tmp/" } //<
    //< The forms of a string that starts with a `/tmp/` path
    //<
    //< **Only `"/tmp/` inside a string is checked**; a comment explaining `/tmp` is not hit.

priv fn opens_tmp(line: U8[], _arena: Arena$@): Bool //< whether a string starts with `/tmp/`
    //<
    //< Caution: **Keep the judging in this one place** (the reason is at `cuts_by_hand`).
    for lit in TMP_LITERALS
        if line.find_str(lit).is_some()
            return true
    return false

// Caution: **Include the explaining sentences.** A comment explaining `/tmp` must not hit, so
// without them a broken quote-mark test goes unnoticed.
priv const TMP_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "path = \"/tmp/x.safetensors\"", .hits = true },
    Sample::{ .text = "open('/tmp/out', 'wb')", .hits = true },
    Sample::{ .text = "SOCK := \"/tmp/uart.sock\"", .hits = true },
    Sample::{ .text = "// On macOS /tmp is a link to /private/tmp.", .hits = false },
    Sample::{ .text = "// MSYS2 rewrites the /tmp/… it hands to a child.", .hits = false },
    Sample::{ .text = "path = os.path.join(work, \"out\")", .hits = false },
    Sample::{ .text = "assert(!fs.is_safe_relative(\"C:/tmp/x\"))", .hits = false },
}

priv fn check_tmp_fires(arena: Arena$@)
    scan.check_samples("the judgment of `/tmp` can fire", Sample[]::TMP_SAMPLES, "tmp_samples",
        opens_tmp, arena)

priv fn check_tmp_literal(arena: Arena$@)
    $bad: = List<|U8[]|>.new(arena)
    $seen: Sz = 0
    for rel in harness.tracked_matching(U8[][]::scan.BUILD_EXT)
        // **This file is excluded because it holds its own samples** (`TMP_SAMPLES` above).
        if rel.equals("tests/support/conventions_win.kspl")
            continue
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            i += 1
            seen += 1
            if opens_tmp(line, arena)
                bad
                    .push(arena.text().s(rel).s(":\{i\}: \{line.trim_spaces()\}").take())
    verdict.check_list("`/tmp` is not written straight into a place's text", seen, "lines", bad@,
        "there is no `/tmp` on Windows. Let a tool answer with the place")

// ==========================================
// 10. A path git is looking at can be made on Windows
// ==========================================

// **Such a path cannot be checked out on Windows, and nothing here shows it.** What gets in is a
// typo (a `>` or `|` that lost its quoting becomes the name). So the check reads **the paths**, not
// any text, untracked files included (`harness.tracked` picks up `--others`).

priv const WIN_BAD_CHARS: U8[] = "<>:\"|?*"
priv const WIN_DEVICES: U8[][_] = ::{ "con", "prn", "aux", "nul" }

priv fn win_device(part: U8[]): Bool //<
    //< Whether it is a device's name
    //<
    //< The names are `CON` `PRN` `AUX` `NUL`, and `COM1` to `COM9`, `LPT1` to `LPT9`.
    //<
    //< Caution: **Check without the extension** (`nul.txt` is a device too), **and ignore case**
    //< (names there are case-insensitive).
    dot: = part.find_char('.').unwrap_or(0)
    stem: = part.sub(0, dot) if dot > 0 else part
    for d in WIN_DEVICES
        if stem.equals_ignore_case(d)
            return true
    if stem.len != 4
        return false
    head: = stem.sub(0, 3)
    if !head.equals_ignore_case("com") && !head.equals_ignore_case("lpt")
        return false
    return stem[3] >= '1' && stem[3] <= '9'

priv fn win_hostile(path: U8[], arena: Arena$@): Bool //<
    //< whether a path cannot be created on Windows
    //<
    //< Caution: **Check each element separately** (the separating `/` is of course allowed).
    for part in path.split('/', arena)
        if part.len == 0
            continue
        for $i: Sz = 0; i < part.len; i += 1
            if part[i] < ' ' || WIN_BAD_CHARS.find_char(part[i]).is_some()
                return true
        last: = part[part.len - 1]
        if last == '.' || last == ' ' || win_device(part)
            return true
    return false

priv fn check_win_paths(arena: Arena$@)
    $bad: = List<|U8[]|>.new(arena)
    files: = harness.tracked()
    for rel in files
        if win_hostile(rel, arena)
            bad.push(arena.dup_str(rel))
    verdict.check_list("a path git is looking at can be made on Windows", files.len, "paths", bad@,
        "`<>:\"|?*`, a control character, a trailing dot or space, a device's name: none come out")

// ==========================================
// The judgments above show they can fire **"no hits" cannot be told apart from green.**
// When the walk falls out of step with the implementation, the check passes while it hits
// nothing.
// ==========================================

// The misses rely on `cuts_by_hand` dropping string literals and line comments.
priv const LINE_CUT_SAMPLES: Sample[_] = ::{ Sample::{ .text = "  at: = out.find_char('\\n');",
    .hits = true }, Sample::{ .text = "  // do not cut with find_char('\\n')", .hits = false },
    Sample::{ .text = "  want: = \"find_char('\\n')\";", .hits = false },
    Sample::{ .text = "  for line in out.lines(arena) {", .hits = false } }

// **The only test is whether both appear in the same file.** One alone is not a hit.
priv const EXEC_GATE_SAMPLES: Sample[_] = ::{ Sample::{ .text =
    "if fs.is_executable(p) { subproc.spawn_piped(argv, \"\"); }", .hits = true },
    Sample::{ .text = "if fs.is_executable(p) { subproc.run_capture(argv); }", .hits = true },
    Sample::{ .text = "if fs.is_executable(p) { return true; }", .hits = false },
    Sample::{ .text = "if fs.can_run(p) { subproc.spawn_piped(argv, \"\"); }", .hits = false } }

// **It checks each element**, so the separating `/` alone is not hit. The first row is text that
// lost its quoting and became a file name.
priv const WIN_PATH_SAMPLES: Sample[_] = ::{ Sample::{ .text =
    "indow.app;|const app = window.kspage;|", .hits = true },
    Sample::{ .text = "out/tmp/a>b.txt", .hits = true },
    Sample::{ .text = "out/tmp/x:1.txt", .hits = true },
    Sample::{ .text = "out/tmp/nul.js", .hits = true },
    Sample::{ .text = "out/tmp/com1", .hits = true },
    Sample::{ .text = "out/tmp/note./x.txt", .hits = true },
    Sample::{ .text = "out/tmp/note /x.txt", .hits = true },
    Sample::{ .text = "std/str.kspl", .hits = false },
    Sample::{ .text = "kspage/port/web/page.html", .hits = false },
    Sample::{ .text = "tests/support/conventions_win.kspl", .hits = false } }

priv fn check_win_fires(arena: Arena$@)
    scan.check_samples("the judgment of a path Windows cannot make can fire",
        Sample[]::WIN_PATH_SAMPLES, "win_path_samples", win_hostile, arena)
    scan.check_samples("the judgment of cutting into lines by hand can fire",
        Sample[]::LINE_CUT_SAMPLES, "line_cut_samples", cuts_by_hand, arena)
    scan.check_samples("the judgment of the check before starting can fire",
        Sample[]::EXEC_GATE_SAMPLES, "exec_gate_samples", gates_on_exec, arena)

fn run(arena: Arena$@)
    check_win_fires(arena)
    check_win_paths(arena)
    check_tmp_fires(arena)
    check_line_cut(arena)
    check_exec_gate(arena)
    check_tmp_literal(arena)

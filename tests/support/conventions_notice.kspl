//< Checks that what a recipient is owed is written down: every notice, and each binary's origin
//<
//< Note: The rules are the header of `THIRD-PARTY-NOTICES.md`, the notices' canonical source; this
//< file **only turns them into a check**, run by `make test-conventions`.
import "std/chars" // `to_lower`
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" + { Str_builder }
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/conventions_scan" as scan + { Sample }
import "tests/support/harness"

priv const NOTICES: U8[] = "THIRD-PARTY-NOTICES.md"

priv const NO_NOTICE_HEADS: U8[][_] = ::{ "## Public-domain origins", "## Binary files" } //<
    //< The sections whose files owe no notice: a public-domain origin, and a binary's origin
    //<
    //< A borrowed binary also states its origin under its license's own section.

priv const BINARY_HEAD: U8[] = "## Binary files" //< the section every binary file is listed in

priv const LICENSE_WORDS: U8[][_] = ::{ "spdx-license-identifier:", "copyright (c)", "copyright ©",
    "licensed under", "all rights reserved", "permission is hereby granted",
    "redistribution and use" } //<
        //< A license's own words, folded to lower case: what code copied with its header carries
        //<
        //< Caution: **List only words a license itself uses**, not ones a sentence about licenses
        //< uses ("the licence travels with the files"), or every document about licenses fires.

priv const OWN_WORDS: U8[][_] = ::{ "LICENSE.md", "THIRD-PARTY-NOTICES.md",
    "tests/support/conventions_notice.kspl" } //< the files whose license words are their own

priv const RELEASED: U8[][_] = ::{ "ksplc/", "std/", "tools/release-assets/", "tools/kspl_lldb.py",
    ".vscode/" } //<
        //< What the release carries
        //<
        //< That is the compiler built from `ksplc/`, and what "Collect the bundled files" and the
        //< extensions step pack in `.github/workflows/release.yml`.
        //< Caution: **Add a path here together with the step that bundles it** (they are two halves
        //< of one change). Otherwise a file that owes a notice goes out in a zip that carries none.

priv struct Listed //< one file `THIRD-PARTY-NOTICES.md` names in a table's first column
    path: U8[]
    owes: Bool //< whether its section owes a notice
    binary: Bool //< whether it is listed under `BINARY_HEAD`

priv fn listed_in(text: U8[], arena: Arena$@): List<|Listed|>$@ //<
    //< The files a notices text names, each with its section's status
    //<
    //< **Only a row starting with a backticked name counts**: "What is not bundled" names a project
    //< by its plain name, and owes nothing checked here.
    out: = List<|Listed|>.create(arena)
    $head: U8[] = ""
    for line in text.lines(arena)
        if line.starts_with("## ")
            head = line.trim_end()
        if !line.starts_with("| `")
            continue
        close: = line.sub_from(3).find_char('`').unwrap_or(0)
        if close == 0
            continue
        $owes: = true
        for h in NO_NOTICE_HEADS
            owes = owes && !head.equals(h)
        out
            .push(Listed::{ .path = line.sub(3, close), .owes = owes,
            .binary = head.equals(BINARY_HEAD) })
    return out

fn carries_license_words(text: U8[], arena: Arena$@): Bool //< whether it holds a license's words
    b: = arena.text()
    for c in text
        b.c(c.to_lower())
    low: = b.take()
    for w in LICENSE_WORDS
        if low.find_str(w).is_some()
            return true
    return false

fn is_binary(body: U8[], _arena: Arena$@): Bool //< whether it holds a NUL in its first 8000 bytes
    //<
    //< **git's own test**, so the check calls binary what `git diff` does.
    for i in Range.asc(body.len if body.len < 8000 else 8000)
        if body[i] == 0
            return true
    return false

fn is_released(path: U8[], _arena: Arena$@): Bool //< whether the release carries it
    for r in RELEASED
        if path.equals(r) || r.ends_with("/") && path.starts_with(r)
            return true
    return false

priv fn is_listed(path: U8[], listed: List<|Listed|>$@, binary_only: Bool): Bool
    for l in listed.slice()
        if l.path.equals(path) && (!binary_only || l.binary)
            return true
    return false

priv const WORD_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "// SPDX-License-Identifier: BSD-3-Clause", .hits = true },
    Sample::{ .text = "/* Copyright (c) 2020 Someone Else */", .hits = true },
    Sample::{ .text = "Licensed under the Apache License, Version 2.0", .hits = true },
    // **A sentence about licenses is not a license**, so a document explaining them stays quiet.
    Sample::{ .text = "The licence travels with the files it covers", .hits = false },
    Sample::{ .text = "the copyright holder is named in the notice", .hits = false },
    Sample::{ .text = "a converted artifact inherits the original license", .hits = false },
    // **Naming the header is not writing one**: a header always carries its colon.
    Sample::{ .text = "an `SPDX-License-Identifier` line at the head of every file",
        .hits = false },
}

priv const BINARY_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "weights\0\0\0", .hits = true },
    Sample::{ .text = "plain text, no NUL", .hits = false },
    Sample::{ .text = "", .hits = false },
}

priv const RELEASED_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "std/ds.kspl", .hits = true },
    Sample::{ .text = "ksplc/seed.c", .hits = true },
    Sample::{ .text = "tools/kspl_lldb.py", .hits = true },
    Sample::{ .text = "ksos/port/rp2040/boot2_generic_03h.S", .hits = false },
    // **A file beside a bundled one is not bundled**: `tools/release-assets/` goes, not `tools/`.
    Sample::{ .text = "tools/surface.kspl", .hits = false },
}

priv const SAMPLE_NOTICES: U8[] =
    """
## Someone's kit (BSD-3-Clause)

| File | What it originates from |
| :-- | :-- |
| `ksos/drivers/rp2040/adc.kspl` | the register values |

## Public-domain origins

| File | What it originates from | Origin |
| :-- | :-- | :-- |
| `std/ds.kspl` | a hash finalizer | a page |

## What is not bundled

| Name | Where it appears | What is not included |
| :-- | :-- | :-- |
| Model | `ksai/` | the weights |

## Binary files

| File | Where it comes from | License |
| :-- | :-- | :-- |
| `ksos/demo/cortex_m/pilot_policy.safetensors` | made here | this repository's |
""" //< a notices text holding one row of each kind

priv fn check_notice_fires(arena: Arena$@)
    scan.check_samples("the judgment of a license's words can fire", Sample[]::WORD_SAMPLES,
        "word_samples", carries_license_words, arena)
    scan.check_samples("the judgment of a binary file can fire", Sample[]::BINARY_SAMPLES,
        "binary_samples", is_binary, arena)
    scan.check_samples("the judgment of what the release carries can fire",
        Sample[]::RELEASED_SAMPLES, "released_samples", is_released, arena)
    rows: = listed_in(SAMPLE_NOTICES, arena)
    got: = rows.slice()
    verdict.check("the notices' rows are read with their section's standing",
        got.len == 3 && got[0].path.equals("ksos/drivers/rp2040/adc.kspl") && got[0].owes &&
        !got[1].owes && got[2].path.equals("ksos/demo/cortex_m/pilot_policy.safetensors") &&
        got[2].binary && !got[2].owes, arena.text().s("\{got.len\} rows").take())

priv fn check_notices(arena: Arena$@)
    listed: = listed_in(harness.read_under_root(NOTICES), arena)
    $tracked: = harness.tracked()
    $gone: = List<|U8[]|>.new(arena)
    $unlisted: = List<|U8[]|>.new(arena)
    $shipped: = List<|U8[]|>.new(arena)
    $untold: = List<|U8[]|>.new(arena)
    $seen: Sz = 0
    for l in listed.slice()
        $there: = false
        for rel in tracked.slice()
            there = there || rel.equals(l.path)
        if !there
            gone.push(l.path)
        if l.owes && is_released(l.path, arena)
            shipped.push(l.path)
    for rel in tracked.slice()
        $own: = false
        for o in OWN_WORDS
            own = own || rel.equals(o)
        if own
            continue
        seen += 1
        body: = harness.read_under_root(rel)
        if is_binary(body, arena)
            if !is_listed(rel, listed, true)
                untold.push(rel)
        else if carries_license_words(body, arena) && !is_listed(rel, listed, false)
            unlisted.push(rel)
    verdict.check_list("every file THIRD-PARTY-NOTICES.md lists exists", listed.len, "rows", gone@,
        "move or drop the row with the file")
    verdict.check_list("a file carrying a license's words is listed in THIRD-PARTY-NOTICES.md", seen,
        "files", unlisted@, "add its origin and license text there (the file's header says how)")
    verdict.check_list("a file owing a notice stands outside what the release carries", listed.len,
        "rows", shipped@,
        "the release's zip leaves the notices behind: bundle them there first (`released` here)")
    verdict.check_list("every binary file is listed with where it comes from", seen, "files",
        untold@,
        "add a row with its origin and license to THIRD-PARTY-NOTICES.md (its header says where)")

fn run_notices(arena: Arena$@) //< this section's entry point
    //<
    //< Caution: **Call it from `suite/conventions_test.kspl`'s `main`** (there is one suite).
    check_notice_fires(arena)
    check_notices(arena)

// ==========================================
// Holds the release zip's README to the documents it copies
// **The zip's README stands alone.** Nothing else the zip carries can be read. So it repeats the
// first steps instead of pointing at them. Every fenced block in it must stand, whole and
// unchanged, in one of the documents it copies. Then a command changed there cannot go stale in
// the zip. The verdict is held to the samples below (Principle 5).
// ==========================================
priv const COPY_REL: U8[] = "tools/release-assets/README.md" //< the README the release zip carries

priv const SOURCE_RELS: U8[][_] = ::{ "docs/HOWTO-set-up-a-project.md", "README.md" } //<
    //< The documents it copies: the set-up how-to first, then the root README's quick start
    //<
    //< The program `hello.kspl` stands only in the root README, so the how-to alone cannot hold
    //< it.

priv const FENCE: U8[] = "```" //< what opens and closes a fenced block

priv fn fenced_blocks(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Every fenced block of a Markdown text: its opening line's language, a newline, and its body
    //<
    //< **The opening fence's indentation is taken off every body line**, so a block inside a list
    //< item reads the same as one at the margin. The language is part of the block: the same lines
    //< under another language are another block.
    $out: = List<|U8[]|>.new(arena)
    $body: = Str_builder.new()
    $inside: = false
    $col: Sz = 0
    for raw in text.lines(arena)
        t: = raw.trim_spaces()
        if !inside
            if t.starts_with(FENCE)
                inside = true
                col = raw.len - raw.trim_start().len
                body.clear()
                body.s(t.sub_from(FENCE.len)).c('\n')
            continue
        if t.equals(FENCE)
            inside = false
            out.push(arena.dup_str(body.slice()))
            continue
        body.s(raw.sub_from(col) if raw.len >= col else raw.trim_start()).c('\n')
    return out

priv fn held_in(block: U8[], text: U8[], arena: Arena$@): Bool //<
    //< Whether one fenced block of the text is that block
    for b in fenced_blocks(text, arena)
        if b.equals(block)
            return true
    return false

priv fn held(copy: U8[], source: U8[], arena: Arena$@): Bool //<
    //< Whether every fenced block of the copy stands, whole, as a fenced block of the source
    for b in fenced_blocks(copy, arena)
        if !held_in(b, source, arena)
            return false
    return true

priv struct Copy_sample //< a copy, a source, and whether every block of the copy is in it
    copy: U8[]
    source: U8[]
    hits: Bool

priv const SAMPLES: Copy_sample[_] = ::{
    Copy_sample::{ .copy = "Run it:\n\n```sh\n./ksplc run a.kspl\n```\n",
        .source = "Text.\n\n```sh\n./ksplc run a.kspl\n```\n", .hits = true },
    // **A block inside a list item** carries the item's indentation in the source.
    Copy_sample::{ .copy = "```sh\nmake\n\nmake test\n```\n",
        .source = "1. **Build**\n\n  ```sh\n  make\n\n  make test\n  ```\n", .hits = true },
    // **One character off** is a drift.
    Copy_sample::{ .copy = "```sh\n./ksplc run a.kspl\n```\n",
        .source = "```sh\n./ksplc run b.kspl\n```\n", .hits = false },
    // **The same lines under another language** are another block.
    Copy_sample::{ .copy = "```sh\nclang a.c\n```\n", .source = "```powershell\nclang a.c\n```\n",
        .hits = false },
    // **A part of a longer block** is not the block: the line left out may be the one that matters.
    Copy_sample::{ .copy = "```sh\nmake\n```\n", .source = "```sh\nmake\nmake install\n```\n",
        .hits = false },
    // **The same line in prose** is not a block.
    Copy_sample::{ .copy = "```sh\nmake\n```\n", .source = "Type `make`, then:\n\n    make\n",
        .hits = false },
}

priv fn check_fires(arena: Arena$@)
    $bad: = List<|U8[]|>.new(arena)
    $i: Sz = 0
    for s in SAMPLES
        if held(s.copy, s.source, arena) != s.hits
            bad.push(arena.text().s("sample \{i\} came out the other way").take())
        i += 1
    verdict.check_list("the verdict on a copied block can fire", SAMPLES.len, "samples", bad@,
        "the table is `samples`")

priv fn first_line(block: U8[], arena: Arena$@): U8[] //< the block's first body line, to name it
    ls: = block.lines(arena)
    return ls.get(1) if ls.len > 1 else ls.get(0)

priv fn check_copy(arena: Arena$@)
    // A copy with no block fails too: `check_list` refuses a walk that looked at nothing.
    blocks: = fenced_blocks(harness.read_under_root(COPY_REL), arena)
    $sources: = List<|U8[]|>.new(arena)
    for rel in SOURCE_RELS
        sources.push(harness.read_under_root(rel))
    $bad: = List<|U8[]|>.new(arena)
    for b in blocks
        $found: = false
        for text in sources
            if held_in(b, text, arena)
                found = true
                break
        if !found
            bad
                .push(arena.text().s("the block opening with \"").s(first_line(b, arena)).s("\"")
                .take())
    verdict.check_list("every block of the zip's README stands in the documents it copies",
        blocks.len, "blocks", bad@,
        "copy the block from docs/HOWTO-set-up-a-project.md or the root README, whichever changed")

fn run_zip(arena: Arena$@)
    check_fires(arena)
    check_copy(arena)

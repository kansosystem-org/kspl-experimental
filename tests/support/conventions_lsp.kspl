//< Checks that the editor's client and the language server fit together (not the suite)
//<
//< **Nothing fails when this drifts.** **Nobody reads the VS Code extension**, the only client
//< ("kspage starts no program" in `kspage/docs/DESIGN-application.md`). Two things
//< are checked: ① the entry points declared and the ones that can answer agree. ② The server can
//< handle the names the client sends.
//< Caution: **Do not put a table of copied names in here.** The canonical source is the
//< implementation, and this file **only compares the two**.
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/conventions_scan" as scan
import "tests/support/harness"
import "tests/support/harness_text" as htext

priv const CAPS_FILE: U8[] = "ksplc/lsp/worker.kspl"
priv const VSCODE_CLIENT: U8[] = ".vscode/extensions/kspl/extension.js"

// A declaration, and the method it promises.
// Caution: **Fail where a declaration not listed here appears**, or a newly added one silently
// escapes the check ("an entry point that does nothing when pressed").
// `prepareProvider` is an option of `renameProvider`, and promises `prepareRename`.
priv const CAP_NAMES: U8[][_] = ::{ "hoverProvider", "definitionProvider", "renameProvider",
    "prepareProvider", "referencesProvider", "callHierarchyProvider", "semanticTokensProvider",
    "codeActionProvider", "inlayHintProvider", "completionProvider", "documentSymbolProvider" }
priv const CAP_METHODS: U8[][_] = ::{ "textDocument/hover", "textDocument/definition",
    "textDocument/rename", "textDocument/prepareRename", "textDocument/references",
    "textDocument/prepareCallHierarchy", "textDocument/semanticTokens/full",
    "textDocument/codeAction", "textDocument/inlayHint", "textDocument/completion",
    "textDocument/documentSymbol" }

priv fn served(arena: Arena$@): List<|U8[]|> //< the methods the server handles
    //<
    //< **The ones starting with `$/` are not counted**: only the tests send them, and a real client
    //< sends none (the test hooks in `run_lsp_worker`, `ksplc/lsp/worker.kspl`).
    $out: = List<|U8[]|>.new(arena)
    for rel in harness.tracked_matching(U8[][]::{ "ksplc/lsp/*.kspl" })
        for m in scan.find_all(harness.read_under_root(rel), "method.equals(\"", "\")", arena)
            if !m.starts_with("$/")
                scan.push_unique(out@, m)
    return out

priv fn cap_says(src: U8[], name: U8[], arena: Arena$@): Bool? //<
    //< Whether the declaration is true or false
    //<
    //< Where there is none, none.
    for got in scan.find_all(src,
        arena.text().s(".set(\"").s(name).s("\", b.bool_val(").take(), "))", arena)
        return .some(got.equals("true"))
    // A declaration with a body (an object like `semanticTokensProvider`) counts as true.
    if src.find_str(arena.text().s(".set(\"").s(name).s("\", ").take()).is_some()
        return .some(true)
    return .none

// Samples that hit and miss, showing the declaration reader really reads: **a failed read looks
// like "there is none"**, and only this says **why** it failed.
priv const CAP_SAYS_SAMPLES: U8[][_] = ::{ ".set(\"hoverProvider\", b.bool_val(true))",
    ".set(\"hoverProvider\", b.bool_val(false))", ".set(\"hoverProvider\", provider(b@))",
    ".set(\"hoverProviderX\", b.bool_val(true))", ".set(\"otherProvider\", b.bool_val(true))" }
priv const CAP_SAYS_WANT: I32[_] = ::{ 1, 0, 1, -1, -1 } //<
    //< The expected answer for each sample
    //<
    //< In order: true / false / true (the form with a body) / none (another name) / none (another
    //< declaration)

priv fn check_cap_says_fires(arena: Arena$@)
    $bad: = List<|U8[]|>.new(arena)
    for i in Range.asc(CAP_SAYS_SAMPLES.len)
        $got: I32 = -1
        switch cap_says(CAP_SAYS_SAMPLES[i], "hoverProvider", arena)
        case .some(v)
            got = 1 if v else 0
        default {}
        if got != CAP_SAYS_WANT[i]
            bad
                .push(arena.text().s("read \"").s(CAP_SAYS_SAMPLES[i])
                .s("\" as \{got\} (it should be \{CAP_SAYS_WANT[i]\})").take())
    verdict.check_list("the place reading a declaration tells true, false and none apart",
        CAP_SAYS_SAMPLES.len, "samples", bad@,
        "the judgment misreads its own samples: mend the judgment, not the table")

priv fn check_caps(arena: Arena$@) //<
    //< ① The entry points declared and the ones that can answer agree
    src: = harness.read_under_root(CAPS_FILE)
    $can: = served(arena)
    $asked: = asked_by_any(arena)
    $bad: = List<|U8[]|>.new(arena)

    // Caution: **Do not let a declaration missing from the table pass.**
    for got in scan.find_all(src, ".set(\"", "\"", arena)
        if !got.ends_with("Provider")
            continue
        if !named_in(U8[][]::CAP_NAMES, got)
            bad
                .push(arena.text().s(got).s(": ").s(CAPS_FILE)
                .s(" declares it, and it is not in this check's table").take())

    for i in Range.asc(CAP_NAMES.len)
        name: = CAP_NAMES[i]
        method: = CAP_METHODS[i]
        $told: = false
        $has_cap: = false
        switch cap_says(src, name, arena)
        case .some(v)
            told = v
            has_cap = true
        default {}
        // Caution: **Fail where it is not found.** Break the reading and every one becomes "there
        // is none", going green having compared nothing.
        if !has_cap
            bad
                .push(arena.text().s(name).s(": there is no declaration in ").s(CAPS_FILE)
                .s(" (either the reading place broke, or the declaration was deleted)").take())
            continue
        answers: = htext.has(can@, method)
        if told && !answers
            bad
                .push(arena.text().s(name).s(": it declares true and there is no place handling `")
                .s(method).s("`").take())
        if !told && answers
            bad
                .push(arena.text().s(name).s(": it declares false and handles `").s(method)
                .s("` anyway").take())
        // Caution: **A declaration nobody asks for is the half-built feature.** Where no client
        // sends the name, the entry point is dead on the screen while every check above goes green.
        if told && !htext.has(asked@, method)
            bad
                .push(arena.text().s(name).s(": it declares true and no client sends `").s(method)
                .s("` (").s(VSCODE_CLIENT).s(")").take())
    verdict.check_list("the LSP declarations and the entry points handled agree", CAP_NAMES.len,
        "declarations", bad@,
        "declare the handler where the server lists them, and handle each declared one")

priv fn named_in(list: U8[][], want: U8[]): Bool
    for w in list
        if w.equals(want)
            return true
    return false

priv fn sent_by(rel: U8[], heads: U8[][], arena: Arena$@): List<|U8[]|> //<
    //< The methods a client sends
    //<
    //< Caution: **Read a client added later through here too**, or a wrong name in it passes. Each
    //< client writes its requests its own way (the extension's `sendRequest("…"`), so `heads` names
    //< the form.
    $out: = List<|U8[]|>.new(arena)
    src: = harness.read_under_root(rel)
    for head in heads
        for m in scan.find_all(src, head, "\"", arena)
            if m.find_char('/').is_some() || m.equals("initialize") || m.equals("initialized") ||
                m.equals("shutdown")
                scan.push_unique(out@, m)
    return out

priv fn ignorable(m: U8[]): Bool //< the names this check skips
    //<
    //< **Exactly one**: to add another, write out why the server need not handle it.
    //< `initialized` only says "it is ready", and LSP allows it to be ignored.
    return m.equals("initialized")

priv fn asked_by_any(arena: Arena$@): List<|U8[]|> //< the names the client sends
    //<
    //< **There is one client now** (this file's header).
    $out: = List<|U8[]|>.new(arena)
    vs: =
        sent_by(VSCODE_CLIENT, U8[][]::{ "sendRequest(\"", "sendNotification(\"" }, arena)
    for i in Range.asc(vs.len)
        scan.push_unique(out@, vs.get(i))
    return out

priv fn check_sent(arena: Arena$@) //< ② The server can handle the names a client sends
    $can: = served(arena)
    $bad: = List<|U8[]|>.new(arena)
    vs: =
        sent_by(VSCODE_CLIENT, U8[][]::{ "sendRequest(\"", "sendNotification(\"" }, arena)
    for i in Range.asc(vs.len)
        if !ignorable(vs.get(i)) && !htext.has(can@, vs.get(i))
            bad
                .push(arena.text().s(vs.get(i)).s(": ").s(VSCODE_CLIENT)
                .s(" sends it, and the language server has no place handling it").take())
    verdict.check_list("the server handles the LSP names a client sends", vs.len, "names", bad@,
        "a method a client sends needs a handler, or an explicit refusal")

// ==========================================
// The document view checks one document's bodies; the workspace view every body naming the word
// **Narrow the workspace view further and references, renaming and the call hierarchy come back
// empty** (a call site lives in a body). Widen the document view and each keystroke checks
// thousands of bodies for one hover ("A `didOpen` checks one document's bodies" in
// `ksplc/docs/DESIGN-tools.md`).
// ==========================================
priv const SERVER_FILE: U8[] = "ksplc/lsp/worker.kspl"
priv const DOC_VIEW: U8[] =
    "run_semantic_analysis(doc_path(ptr.uri_perm), true, quiet, .main_file)"
priv const WS_VIEW: U8[] = "Bodies.mentioning(old_name)"

priv fn check_body_views(arena: Arena$@) //<
    //< Checks that the document view narrows the bodies and the workspace view does not
    //<
    //< Caution: **Read both lines, not one.** If only the narrow one is checked, the day the wide
    //< one is narrowed too the editor goes quiet with nothing saying why.
    src: = harness.read_under_root(SERVER_FILE)
    $bad: = List<|U8[]|>.new(arena)
    if src.find_str(DOC_VIEW).is_none()
        bad
            .push(arena.text().s(SERVER_FILE)
            .s(": the document view does not narrow the bodies to the one document (looked for `")
            .s(DOC_VIEW).c('`').take())
    if src.find_str(WS_VIEW).is_none()
        bad
            .push(arena.text().s(SERVER_FILE)
            .s(": the workspace view does not check every body naming the word (looked for `")
            .s(WS_VIEW).c('`').take())
    verdict.check_list("the document view narrows the bodies and the workspace view does not", 2,
        "views", bad@,
        "the editor's document view checks one document's bodies; the workspace view must not \
            narrow")

// ==========================================
// The recovering branches are turned on by the editor and by nobody else
// **Turned on anywhere else the compiler can reach, it accepts input it must reject**
// ("Only the editor's parse recovers from a syntax error" in `ksplc/docs/DESIGN-tools.md`).
// ==========================================
priv const WAKE_LINE: U8[] = "base_core.config.recover_syntax = true" //<
    //< The line of code that turns on the recovering branches
    //<
    //< **No terminator**: the default notation writes none, so a needle with a `;` matches no line.
priv const WAKE_FILE: U8[] = "ksplc/lsp/worker.kspl"

priv fn check_recovery_wake(arena: Arena$@) //<
    //< Checks that the recovering branches are turned on from one place only
    //<
    //< Caution: **Count them across the whole of `ksplc/`, not in one file**, or a second one
    //< elsewhere goes unseen.
    $bad: = List<|U8[]|>.new(arena)
    $seen: Sz = 0
    for rel in harness.tracked_matching(U8[][]::{ "ksplc/*.kspl" })
        for line in harness.read_under_root(rel).lines(arena)
            if line.trim_spaces().starts_with("//") || line.find_str(WAKE_LINE).is_none()
                continue
            seen += 1
            if !rel.equals(WAKE_FILE)
                bad
                    .push(arena.text().s(rel)
                    .s(": it wakes the recovering branches. The one place is ").s(WAKE_FILE).take())
    if seen != 1
        bad
            .push(arena.text().s("`").s(WAKE_LINE)
            .s("` stands on \{seen\} lines of code; it is to stand").s(" on one").take())
    verdict.check_list("the recovering branches are woken from the editor's entry point alone", seen,
        "places", bad@,
        "a recovering branch woken from anywhere but the editor's entry would recover in a build")

// ==========================================
// What the extension leaves out matches what `.gitignore` says **The name of the build output
// folder is written in two places**: `.gitignore` and the extension's `**/<name>/**`.
// Note: The canonical source is `.gitignore` (the language server reads it too:
// `ksplc/lsp/workspace.kspl`).
// ==========================================
priv const IGNORE_FILE: U8[] = ".gitignore"

priv fn ignored_dirs(arena: Arena$@): List<|U8[]|> //<
    //< The names `.gitignore` names as a folder (`out/` -> `out`)
    $out: = List<|U8[]|>.new(arena)
    for line in harness.read_under_root(IGNORE_FILE).lines(arena)
        $t: = line.trim_spaces()
        if t.len < 2 || t[0] == '#' || t[0] == '!' || t[t.len - 1] != '/'
            continue
        t = t.sub(0, t.len - 1)
        if t.len > 0 && t[0] == '/'
            t = t.sub_from(1)
        if t.len > 0 && t.find_char('/').is_none() && t.find_char('*').is_none()
            scan.push_unique(out@, t)
    return out

priv fn check_exclude(arena: Arena$@)
    $told: = ignored_dirs(arena)
    $bad: = List<|U8[]|>.new(arena)
    $seen: Sz = 0
    for got in scan.find_all(harness.read_under_root(VSCODE_CLIENT), "findFiles(", ")", arena)
        // Caution: **Check the second argument.** The first is the pattern searched for
        // (`'**/<import path>.kspl'`), not the pattern left out.
        if at: = got.find_str(", '**/")
            seen += 1
            rest: = got.sub_from(at + 6)
            if end: = rest.find_str("/**'")
                name: = rest.sub(0, end)
                if !htext.has(told@, name)
                    bad
                        .push(arena.text().s(VSCODE_CLIENT).s(": it leaves `").s(name)
                        .s("` out, and ").s(IGNORE_FILE).s(" does not name that folder").take())
    verdict.check_list("`.gitignore` names the folders the extension leaves out", seen, "exclusions",
        bad@, "the origin for where things are built into is `.gitignore`")

// ==========================================
// Everything on the arena is discarded when the LSP rewinds it **The arena is rewound per
// request, but a `$` global is not.** A table from `base_core.arena` kept in a global dangles.
// ==========================================

priv const WIND_FILE: U8[] = "ksplc/lsp/state.kspl" //< the file for two checks
    //<
    //< ① the arena is rewound from one place only. ② every `$` global in ksplc is either discarded
    //< there, or listed below as one that does not live on that arena.
    //< Caution: **Review a new global before you add its row.** The row
    //< records the review.
priv const WIND_HEAD: U8[] = "fn wind_back("
priv const WIND_CALL: U8[] = "base_core.arena.restore("
priv const GLOBAL_SPECS: U8[][_] = ::{ "ksplc/*.kspl", ":!ksplc/tests/" } //<
    //< The sources whose `$` globals are counted
    //<
    //< **`ksplc/tests/` is left out on purpose**: its globals are feature-test fixtures in static
    //< storage the LSP never touches.

// The containers that live on base_core.arena: `<path>:<name> | <how wind_back discards it>`.
// Caution: **Fail where `wind_back` stops naming one.** Delete a line there and every later request
// reads freed memory with no test saying so, crashing on another request in an unrelated place.
priv const ON_ARENA: U8[][_] = ::{ "ksplc/base/as_written.kspl:as_written | forget_as_written()",
    "ksplc/base/as_written.kspl:shebangs | forget_as_written()",
    "ksplc/base/diag.kspl:lsp_diags | lsp_diags.clear()",
    "ksplc/base/cfg_inactive.kspl:cfg_inactive | base_cfg_inactive.clear()",
    "ksplc/parse/load.kspl:layout_notes | forget_layout_notes()",
    "ksplc/parse/load.kspl:took_recovery | forget_layout_notes()" }

// The `$` globals that do not live on the arena the LSP rewinds: `<path>:<name> | <why not>`.
// Caution: **Write each reason out.** A row added without review is the next crash. The reason
// shows that the review happened, so an empty one fails. It is part of the row: a second array
// keyed by position slips when a row is inserted.
priv const OFF_ARENA: U8[][_] = ::{ "ksplc/base/ast.kspl:shared | the shared empty child list, \
    built by base_setup.init() — below every mark the LSP takes",
    "ksplc/base/cache.kspl:root_warned | a flag that the AST cache's refusal was said once",
    "ksplc/base/config_file.kspl:files_absent | taken from perm_arena (`List.create(perm_arena)`)",
    "ksplc/base/config_file.kspl:files_seen | taken from perm_arena (`List.create(perm_arena)`)",
    "ksplc/base/config_file.kspl:in_force_cache | taken from perm_arena, with this very hazard \
        named in the caution beside it",
    "ksplc/base/config_file.kspl:no_settings | taken from perm_arena (`List.create(perm_arena)`)",
    "ksplc/base/config_file.kspl:own_cache | taken from perm_arena, with this very hazard named in \
        the caution beside it",
    "ksplc/base/core.kspl:arena | the arena that is itself the subject of the wind-back",
    "ksplc/base/core.kspl:config | its strings come from perm_arena, and `defines` is built by \
        Mode.new at CLI parse time",
    "ksplc/base/core.kspl:perm_arena | the arena that is never wound back (the heading beside it)",
    "ksplc/base/core.kspl:pools | heap all through: String_pool.new and intern take from alloc",
    "ksplc/base/core.kspl:progress_hook | a function pointer",
    "ksplc/base/core.kspl:progress_last_us | a count of microseconds",
    "ksplc/base/diag.kspl:json_written | counts of the JSON objects written, by severity",
    "ksplc/base/lint_codes.kspl:global_settings | taken from perm_arena, with this very hazard \
        named in the caution beside it",
    "ksplc/base/locate.kspl:declared_roots | the records and strings are taken from perm_arena",
    "ksplc/base/locate.kspl:embedded_paths | taken from perm_arena (`List.create(perm_arena)`)",
    "ksplc/base/locate.kspl:package_bases | the records and strings are taken from perm_arena",
    "ksplc/base/package.kspl:read_decls | taken from perm_arena, with this very hazard named in the \
        caution beside it", "ksplc/base/stats.kspl:last_used | a count of bytes",
    "ksplc/base/stats.kspl:stages | microsecond and byte counts per stage",
    "ksplc/base/target.kspl:host_answer | the name of the machine ksplc runs on, taken from \
        perm_arena",
    "ksplc/base/target.kspl:host_known | a flag that the machine's name was asked once",
    "ksplc/lower/prune.kspl:stats | counts of the declarations dropped",
    "ksplc/parse/ast_cache.kspl:nonce | the number that keeps a generated name apart",
    "ksplc/parse/ast_cache.kspl:stats | hit / miss / store counts",
    "ksplc/parse/desugar.kspl:for_in_counter | the number that keeps a desugared `for in`'s names \
        apart",
    "ksplc/parse/load.kspl:kspeg_arena | its own arena, wound back inside parse/load.kspl and freed \
        by parse_load.fin()",
    "ksplc/parse/load.kspl:prof | its map is arena-backed and built by parse_load.init(), below \
        every mark",
    "ksplc/sema/body/for_in.kspl:for_in_counter | the number that keeps a desugared `for in`'s \
        names apart",
    "ksplc/sema/session/prof.kspl:prof | both its containers are re-made by init() at the head of \
        every analysis round",
    "ksplc/fmt/kinds.kspl:rules | an inline array of flags, held in static storage",
    "ksplc/tools/run.kspl:target_answer | the optional answer about the build target, held in \
        static storage",
    "ksplc/usage.kspl:cli | the argparse Parser, built by Mode.new at CLI parse time — below \
        every mark the LSP takes" }

priv const ROW_BAR: U8[] = " | "

priv fn row_head(row: U8[]): U8[] //< the `<path>:<name>` half of a row
    //<
    //< Where there is no separator, the whole row (so a row written wrong is reported by name
    //< rather than silently matching nothing).
    return row.sub(0, row.find_str(ROW_BAR).unwrap_or(row.len))

priv fn row_tail(row: U8[]): U8[] //< the half after the separator
    //<
    //< Where there is none, empty — and an empty one fails below.
    if at: = row.find_str(ROW_BAR)
        return row.sub_from(at + ROW_BAR.len)
    return ""

priv const GLOBALS_FLOOR: Sz = 25 //<
    //< The fewest `$` globals the count may find
    //<
    //< Caution: **Fail where the count comes out short**: a broken reading of `$` empties the list
    //< and goes green having checked nothing.

priv fn wind_body(): U8[] //< the body of the one function that rewinds the arena
    //<
    //< Where it cannot be found, empty.
    src: = harness.read_under_root(WIND_FILE)
    if at: = src.find_str(WIND_HEAD)
        rest: = src.sub_from(at)
        return rest.sub(0, rest.find_str("\n}\n").unwrap_or(rest.len))
    return ""

priv fn ksplc_globals(arena: Arena$@): List<|U8[]|> //<
    //< The `$` globals ksplc declares, as `<path>:<name>`
    //<
    //< **A `$` at the start of a line, after any visibility word, is a global.** A mutable local is
    //< always indented, so no check of the body is needed.
    $out: = List<|U8[]|>.new(arena)
    for rel in harness.tracked_matching(U8[][]::GLOBAL_SPECS)
        for text in harness.read_under_root(rel).lines(arena)
            // Caution: **Strip the visibility prefix first**: `priv $dir_cache` is as much a global
            // as a bare `$`.
            $line: = text
            if line.starts_with("priv ")
                line = line.sub_from(5)
            if line.starts_with("pub ")
                line = line.sub_from(4)
            if !line.starts_with("$")
                continue
            end: = line.find_char(':').unwrap_or(0)
            if end < 2
                continue
            scan.push_unique(out@,
                arena.text().s(rel).c(':').s(line.sub(1, end - 1)).take())
    return out

priv fn row_named(list: U8[][], want: U8[]): Bool //< whether any row of list names this global
    for row in list
        if row_head(row).equals(want)
            return true
    return false

priv fn check_wind_back(arena: Arena$@)
    body: = wind_body()
    $seen: = ksplc_globals(arena)
    $bad: = List<|U8[]|>.new(arena)

    // ① The arena is rewound from one place.
    $calls: Sz = 0
    for rel in harness.tracked_matching(U8[][]::GLOBAL_SPECS)
        for line in harness.read_under_root(rel).lines(arena)
            if line.trim_spaces().starts_with("//") || line.find_str(WIND_CALL).is_none()
                continue
            calls += 1
            if !rel.equals(WIND_FILE)
                bad
                    .push(arena.text().s(rel)
                    .s(": it winds `base_core.arena` back itself. The one place is `wind_back` in ")
                    .s(WIND_FILE).take())
    if calls != 1
        bad
            .push(arena.text().s("`").s(WIND_CALL)
            .s("` stands on \{calls\} lines of code; it is to stand on one").take())
    if body.find_str(WIND_CALL).is_none()
        no_wind: = arena.text().s(WIND_FILE)
            .s(": `wind_back` does not wind the arena back (either the body reading broke, or the \
                line went)").take()
        bad.push(no_wind)

    // ② Every container on the arena is discarded there, and no row of either table is stale.
    for i in Range.asc(ON_ARENA.len)
        if body.find_str(row_tail(ON_ARENA[i])).is_none() || row_tail(ON_ARENA[i]).len == 0
            bad
                .push(arena.text().s(row_head(ON_ARENA[i])).s(": `wind_back` does not hold `")
                .s(row_tail(ON_ARENA[i])).c('`').take())
        if !htext.has(seen@, row_head(ON_ARENA[i]))
            bad
                .push(arena.text().s(ON_ARENA[i]).s(": no such global is declared").take())
    for i in Range.asc(OFF_ARENA.len)
        if !htext.has(seen@, row_head(OFF_ARENA[i]))
            bad
                .push(arena.text().s(OFF_ARENA[i]).s(": no such global is declared").take())
        if row_tail(OFF_ARENA[i]).len == 0
            bad
                .push(arena.text().s(OFF_ARENA[i]).s(": the row carries no why").take())
    for i in Range.asc(seen.len)
        got: = seen.get(i)
        if row_named(U8[][]::ON_ARENA, got) || row_named(U8[][]::OFF_ARENA, got)
            continue
        stray: = arena.text().s(got)
            .s(": a global neither table knows. Sitting on `base_core.arena`, throw it away in \
                `wind_back`; not sitting on it, write the row and the why in this check").take()
        bad.push(stray)
    if seen.len < GLOBALS_FLOOR
        short: = arena.text()
            .s("read \{seen.len\} globals (the floor is \{GLOBALS_FLOOR\}) — the reading of `$` \
                broke").take()
        bad.push(short)
    verdict.check_list("everything on the arena the LSP winds back is thrown away with it",
        seen.len, "globals", bad@,
        "take what lives as long as the process from perm_arena, not the arena the LSP rewinds")

// ==========================================
// The grammar colours the language's keywords, no more and no fewer **The canonical source is
// `ksplc info keywords`** (read from the compiler's grammar). The VS Code grammar is a JSON copy,
// which drifts silently: a removed word stays coloured, and a new one gets no colour.
// Caution: **Compare in both directions**; the two drifts are separate failures.
// ==========================================
priv const TM_GRAMMAR: U8[] = ".vscode/extensions/kspl/tmLanguage.json"

priv fn ksplc_keywords(arena: Arena$@): List<|U8[]|> //<
    //< The words `ksplc info keywords` lists (each on a line of its own, indented under a group)
    r: = ksplc_harness.ksplc_bare(U8[][]::{ "info", "keywords" })
    $out: = List<|U8[]|>.new(arena)
    for ln in r.out.lines(arena)
        if ln.starts_with("  ") && ln.trim_spaces().len > 0
            scan.push_unique(out@, ln.trim_spaces())
    return out

priv fn grammar_keywords(src: U8[], arena: Arena$@): List<|U8[]|> //<
    //< The words the grammar names in the form `\b(a|b|c)\b`
    //<
    //< **Only this form counts**, and only whole words: a numeric suffix or a run of symbols
    //< inside the brackets is no keyword.
    $out: = List<|U8[]|>.new(arena)
    for body in scan.find_all(src, "\\\\b(", ")\\\\b", arena)
        for w in body.split('|', arena)
            if w.len > 0 && word_only(w)
                scan.push_unique(out@, w)
    return out

priv fn as_word_in(src: U8[], want: U8[]): Bool //< whether `want` stands in `src` as a whole word
    $i: Sz = 0
    for i + want.len <= src.len
        if at: = src.sub_from(i).find_str(want)
            from: = i + at
            to: = from + want.len
            if (from == 0 || !word_char(src[from - 1])) &&
                (to >= src.len || !word_char(src[to]))
                return true
            i = from + 1
        else
            return false
    return false

priv fn word_char(c: U8): Bool
    return c.is_alpha() || c.is_digit() || c == '_'

priv fn word_only(w: U8[]): Bool //< whether it is made of letters, digits and `_` alone
    for c in w
        if !word_char(c)
            return false
    return true

priv fn check_keywords(arena: Arena$@)
    $mine: = ksplc_keywords(arena)
    src: = harness.read_under_root(TM_GRAMMAR)
    $told: = grammar_keywords(src, arena)
    $bad: = List<|U8[]|>.new(arena)
    for w in told.slice()
        if !htext.has(mine@, w)
            bad
                .push(arena.text().s(w).s(": the grammar colours it, and ksplc has no such word")
                .take())
    // **A keyword can be named outside the bracketed lists** (`\\bfn\\b` in a rule of its own).
    // So this direction asks only that the word stand somewhere in the grammar as a whole word.
    for w in mine.slice()
        if !as_word_in(src, w)
            bad
                .push(arena.text().s(w).s(": a keyword of ksplc's the grammar does not colour")
                .take())
    if mine.len == 0 || told.len == 0
        bad.push("could not read the keywords from `ksplc info keywords` or the grammar")
    verdict.check_list("the VS Code grammar colours ksplc's keywords, no more and no fewer",
        mine.len, "keywords", bad@,
        "add the keyword to .vscode/extensions/kspl/tmLanguage.json, or drop the one no grammar \
            rule makes")

fn run(arena: Arena$@)
    check_recovery_wake(arena)
    check_body_views(arena)
    check_exclude(arena)
    check_keywords(arena)
    check_wind_back(arena)
    check_cap_says_fires(arena)
    check_caps(arena)
    check_sent(arena)

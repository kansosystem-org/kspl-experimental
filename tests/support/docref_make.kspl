//< Checks that every `make <target>` a published document writes is a target make has
//< **make itself is asked** (`make -pRrq`, which prints the rules it read and runs nothing), at the
//< root and in every package with its own `Makefile`. A document inside such a package may name
//< that `Makefile`'s targets too, and `make -C <dir>` names that folder's. make's answer is read
//< by `tools/make_db.kspl`, as `make explain` reads it.
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/conventions_ci" as ci_layout
import "tests/support/conventions_scan" as scan
import "tests/support/harness"
import "tools/make_db"

priv const SUITE_FOUND: U8[] = "suite_found" //< the variable that holds a folder's suite names

priv struct Forward //< a pattern the root forwards to a package's `Makefile`
    pattern: U8[] //< as the root's dump writes it
    dir: U8[] //< the folder it forwards to
    suites: Bool //< the names are that `Makefile`'s `SUITE_FOUND`, not its targets

// Caution: **Add a pattern here when the root gains one**, or its names read as missing. The check
// below fails on a pattern that this table does not hold.
priv const FORWARDS: Forward[_] = ::{ Forward::{ .pattern = "test-%", .dir = "ksplc",
    .suites = true }, Forward::{ .pattern = "ksos-%", .dir = "lib/ksos", .suites = false },
    Forward::{ .pattern = "ci-shard-%", .dir = "", .suites = false } }

struct Rules //< what one `Makefile` defines
    targets: List<|U8[]|>$@
    patterns: List<|U8[]|>$@
    suites: List<|U8[]|>$@ //< the suite names its `SUITE_FOUND` holds

priv struct Mention //< one `make` line of a document
    rel: U8[]
    line: Sz
    dir: U8[] //< `-C`'s folder, or empty
    target: U8[]
    family: Bool //< written `<prefix>*` or `<prefix><…>`: any target of that prefix
    owned: Bool //< the prose names it a package's (`kstls's own`), so any package's targets count

fn rules_of(dir: U8[], arena: Arena$@): Rules //< what make reads in `dir` (empty: the root)
    out: = Rules::{ .targets = List<|U8[]|>.create(arena),
        .patterns = List<|U8[]|>.create(arena), .suites = List<|U8[]|>.create(arena) }
    $args: = List<|U8[]|>(arena)
    if dir.len > 0
        args.push("-C")
        args.push(dir)
    // Caution: **Pass `LOGGING=1`.** Without it the root reads only its `%:` wrapper, which takes
    // every name.
    args.push_all(U8[][]::{ "--no-print-directory", "-pRrq", "LOGGING=1", ":" })
    // **make speaks English here, whatever the locale** (why is `make_speaks_english`).
    make_db.make_speaks_english()
    db: = make_db.parse_db(make_db.last_db(harness.make(args.slice()).out), arena)
    if found: = db.vars.get(SUITE_FOUND)
        for name in make_db.words(found.value, arena)
            out.suites.push(name)
    for name in db.order
        if e: = db.files.get(name)
            if e.target && is_plain(name)
                out.targets.push(name)
    for name in db.patterns
        if is_plain(name)
            out.patterns.push(name)
    return out

priv fn is_plain(name: U8[]): Bool //<
    //< whether a document can name it: no special target, path or value
    return name.len > 0 && name[0] != '.' && name.find_char(' ').is_none() &&
        name.find_char('/').is_none() && name.find_char('$').is_none()

priv fn mention_of(text: U8[], arena: Arena$@): List<|Mention|> //<
    //< The targets a `make` command line names, `-C`'s folder with them; empty for no command
    $out: = List<|Mention|>(arena)
    t: = text.trim_spaces().strip_prefix("$ ")
    if !t.starts_with("make ")
        return out
    $dir: U8[] = ""
    $after_c: = false
    for w in t.sub_from(5).split(' ', arena)
        if w.len == 0
            continue
        if after_c
            dir = w
            after_c = false
            continue
        // A shell operator or a redirection ends the command.
        if w.equals("|") || w.equals("&&") || w.equals(";") || w.equals("||") || w.equals("#") ||
            w.find_char('>').is_some()
            break
        if w.equals("-C")
            after_c = true
            continue
        if w[0] == '-' || w.find_char('=').is_some() || !w[0].is_lower()
            continue
        $end: Sz = 0
        for end < w.len && (w[end].is_alnum() || w[end] == '-' || w[end] == '_')
            end += 1
        family: = end < w.len && (w[end] == '*' || w[end] == '<')
        if end < w.len && !family
            break
        out
            .push(Mention::{ .rel = "", .line = 0, .dir = dir, .target = w.sub(0, end),
            .family = family, .owned = false })
    return out

priv fn read_mentions(rel: U8[], text: U8[], out: List<|Mention|>$@, arena: Arena$@) //<
    //< Every `make` command of a document: a code span opening with it, or a fenced line
    $inside: = false
    $lineno: Sz = 0
    for ln in text.lines(arena)
        lineno += 1
        if ln.trim_spaces().starts_with("```")
            inside = !inside
            continue
        // The odd pieces are inside a span (a span of double backticks reads the same way). The
        // piece before each is the prose that can name its package.
        parts: = ln.split('`', arena)
        for i in Range.asc(parts.len)
            if !inside && i % 2 == 0
                continue
            owned: = i > 0 && !inside && is_owned(parts.get(i - 1))
            for m in mention_of(ln if inside else parts.get(i), arena)
                out
                    .push(Mention::{ .rel = rel, .line = lineno, .dir = m.dir, .target = m.target,
                    .family = m.family, .owned = owned })
            if inside
                break

priv fn is_owned(before: U8[]): Bool //< whether the prose before a span makes it a package's
    t: = before.trim_end().strip_suffix(" own")
    return t.ends_with("'s") || t.ends_with(" its")

priv fn names(list: List<|U8[]|>@, t: U8[], family: Bool): Bool
    for n in list
        hit: = n.starts_with(t) if family else n.equals(t)
        if hit
            return true
    return false

priv fn package_of(rel: U8[], dirs: List<|U8[]|>@): U8[] //<
    //< the package with a `Makefile` it is in
    for d in dirs
        if rel.starts_with(d) && rel.len > d.len && rel[d.len] == '/'
            return d
    return ""

priv fn shard_target(t: U8[], arena: Arena$@): Bool //<
    //< a section named by the CI's canonical table
    if !t.starts_with("ci-shard-")
        return false
    for v in ci_layout.set_variants(harness.read_under_root("tools/ci_gates.kspl"), arena)
        if v.starts_with("ci_shard_") && v.replace("_", "-", arena).equals(t)
            return true
    return false

priv fn makes(r: Rules@, t: U8[], family: Bool, arena: Arena$@): Bool //<
    //< whether these rules make the target
    if names(r.targets, t, family)
        return true
    if names(r.patterns, "ci-shard-%", false) && shard_target(t, arena)
        return true
    if !family
        return false
    for p in r.patterns
        if p.starts_with(t)
            return true
    return false

priv const MENTION_SAMPLES: scan.Sample[_] = ::{
    scan.Sample::{ .text = "make test-docref", .hits = true },
    scan.Sample::{ .text = "$ make -k lint test-docref 2>&1 | tail", .hits = true },
    scan.Sample::{ .text = "make LLVM=1 debug", .hits = true },
    scan.Sample::{ .text = "make debug-*", .hits = true },
    scan.Sample::{ .text = "make -C lib/ksos test", .hits = true },
    // A variable alone names no target, and a word that only begins with it is no command.
    scan.Sample::{ .text = "makefile", .hits = false },
    scan.Sample::{ .text = "make PREFIX=/usr/local", .hits = false },
    scan.Sample::{ .text = "the make help listing", .hits = false } //<
        //< What reads as a `make` command naming a target
}

priv fn names_a_target(text: U8[], arena: Arena$@): Bool
    return mention_of(text, arena).len > 0

fn check(arena: Arena$@) //< this check's entry point, called from `suite/docref_test.kspl`
    shard_samples: scan.Sample[_] = ::{
        scan.Sample::{ .text = "ci-shard-a", .hits = true },
        scan.Sample::{ .text = "ci-shard-b", .hits = true },
        scan.Sample::{ .text = "ci-shard-linux", .hits = true },
        scan.Sample::{ .text = "ci-shard-unknown", .hits = false },
        scan.Sample::{ .text = "ci-linux-only", .hits = false },
    }
    scan.check_samples("the reading of a CI section's target can fire",
        scan.Sample[]::shard_samples, "shard_samples", shard_target, arena)
    tracked: = harness.tracked()
    $dirs: = List<|U8[]|>(arena)
    for rel in tracked
        // A package's folder: one at the top, or a library's under `lib/`.
        depth: = rel.count_str("/")
        if rel.ends_with("/Makefile") &&
            (depth == 1 || depth == 2 && rel.starts_with("lib/"))
            dirs.push(rel.sub(0, rel.len - 9))
    root: = rules_of("", arena)
    $bad: = List<|U8[]|>(arena)
    for p in root.patterns
        $known: = false
        for f in FORWARDS
            known = known || f.pattern.equals(p)
        if !known
            bad
                .push(arena.text().s("Makefile: the pattern ").s(p)
                .s(" forwards to nothing `FORWARDS` in tests/support/docref_make.kspl holds").take())
    private: = harness.private_docs()
    $mentions: = List<|Mention|>(arena)
    for rel in tracked
        if rel.ends_with(".md") && !harness.is_private_doc(rel, private@)
            read_mentions(rel, harness.read_under_root(rel), mentions@, arena)
    $seen_dirs: = List<|U8[]|>(arena)
    $seen_rules: = List<|Rules|>(arena)
    for m in mentions
        $places: = List<|U8[]|>(arena)
        places.push(m.dir)
        own: = package_of(m.rel, dirs@)
        if m.dir.len == 0 && own.len > 0
            places.push(own)
        for f in FORWARDS
            if m.dir.len == 0 &&
                m.target.starts_with(f.pattern.sub(0, f.pattern.len - 1))
                places.push(f.dir)
        if m.owned
            places.push_all(dirs.slice())
        $ok: = false
        for place in places
            $k: Sz = seen_dirs.len
            for i in Range.asc(seen_dirs.len)
                if seen_dirs.get(i).equals(place)
                    k = i
            if k == seen_dirs.len
                seen_dirs.push(place)
                seen_rules.push(rules_of(place, arena))
            r: = seen_rules.get(k)
            ok = ok || makes(r@, m.target, m.family, arena)
            // A forwarded suite is one the folder it goes to finds (`SUITE_FOUND`).
            for f in FORWARDS
                if f.suites && f.dir.equals(place) && m.target.starts_with("test-")
                    ok = ok || names(r.suites, m.target.sub_from(5), m.family)
        if !ok
            bad
                .push(arena.text().s(m.rel).s(":\{m.line\}: `make ").s(m.target)
                .s("` is no target make has").take())
    verdict.check_list("every `make <target>` a document writes is a target make has",
        mentions.len, "mentions", bad@,
        "the targets are what `make help` lists, and a package's own")
    scan.check_samples("the reading of a `make` command can fire",
        scan.Sample[]::MENTION_SAMPLES, "mention_samples", names_a_target, arena)

//< Checks that every std function taking an arena is called with `null` in std's tests
//< "`null` arena means the heap" is a promise of all of them ("Words used in this document" in
//< `std/docs/DESIGN-core.md`), so each needs a call that would crash or leak where it breaks it.
//< The functions come from `std/SURFACE.txt`, so a new one fails here until such a call is written.
//< It is a part of conventions, not a suite of its own.
//< Caution: **It reads the calls' text**: a `null` passed through a variable is not seen as one.
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/verdict"
import "tests/support/conventions_scan" as scan + { Sample }
import "tests/support/harness"

priv const STD_RECORD: U8[] = "std/SURFACE.txt" //< where std's functions and their signatures are

priv const ARENA_TYPE: U8[] = "Arena$@" //< the type of a parameter that takes an arena

priv struct Arena_call //< how one function taking an arena is written at a call
    label: U8[] //< its file and key, as the record names it (`std/fs join`)
    name: U8[] //< the name after the `.` (`join`)
    before: U8[] //< the name right before the `.`: the module or the type; empty for a method
    at: Sz //< the arena's place among the arguments, the receiver not counted

priv fn is_open_at(text: U8[], i: Sz): Bool //< whether a bracket opens at i, `<|` included
    c: = text[i]
    return c == '(' || c == '[' || c == '{' ||
        (c == '<' && i + 1 < text.len && text[i + 1] == '|')

priv fn is_close_at(text: U8[], i: Sz): Bool //< whether a bracket closes at i, `|>` included
    c: = text[i]
    return c == ')' || c == ']' || c == '}' ||
        (c == '|' && i + 1 < text.len && text[i + 1] == '>')

priv fn args_at(text: U8[], open: Sz, arena: Arena$@): List<|U8[]|> //<
    //< The arguments of the call whose `(` stands at open, split at the commas outside brackets
    //< A quoted string or character is stepped over whole, so a comma or a bracket in it does not
    //< count. A call left open gives what it read.
    $out: = List<|U8[]|>.new(arena)
    $depth: Sz = 0
    $start: = open + 1
    $i: = open + 1
    for i < text.len
        c: = text[i]
        if c == '"' || c == '\''
            i += 1
            for i < text.len && text[i] != c
                i += 2 if text[i] == '\\' else 1
        else if is_open_at(text, i)
            depth += 1
            i += 1 if c == '<' else 0
        else if is_close_at(text, i)
            if depth == 0
                out.push(text.sub(start, i - start).trim_spaces())
                return out
            depth -= 1
            i += 1 if c == '|' else 0
        else if c == ',' && depth == 0
            out.push(text.sub(start, i - start).trim_spaces())
            start = i + 1
        i += 1
    return out

priv fn word_before(text: U8[], dot: Sz): U8[] //<
    //< The name right before the `.` at dot, past one `<|…|>`: `List` for `List<|I32|>.new`
    $e: = dot
    if e >= 2 && text[e - 1] == '>' && text[e - 2] == '|'
        $depth: Sz = 0
        for e >= 2
            if text[e - 1] == '>' && text[e - 2] == '|'
                depth += 1
                e -= 2
            else if text[e - 1] == '|' && text[e - 2] == '<'
                depth -= 1
                e -= 2
                if depth == 0
                    break
            else
                e -= 1
    $s: = e
    for s > 0 && text[s - 1].is_alnum()
        s -= 1
    return text.sub(s, e - s)

priv fn has_null_call(text: U8[], c: Arena_call, modules: U8[][], arena: Arena$@): Bool //<
    //< Whether text calls the function with `null` where the arena goes
    //< A method's receiver may be anything but a module, so `json.parse(…)` is not `Parser.parse`.
    want: = arena.text().c('.').s(c.name).c('(').take()
    $from: Sz = 0
    for
        switch text.sub_from(from).find_str(want)
        case .none
            return false
        case .some(off)
            dot: = from + off
            from = dot + 1
            who: = word_before(text, dot)
            $fits: = who.equals(c.before)
            if c.before.len == 0
                fits = true
                for m in modules
                    if who.equals(m)
                        fits = false
            if fits
                args: = args_at(text, dot + want.len - 1, arena)
                if c.at < args.len && args.get(c.at).equals("null")
                    return true

priv fn arena_call_of(file: U8[], key: U8[], sig: U8[], arena: Arena$@): Arena_call? //<
    //< How the record's function is called, where it takes an arena
    open: = sig.find_char('(').unwrap_or(sig.len)
    if open == sig.len
        return .none
    $at: Sz = 0
    $has_self: = false
    for p in args_at(sig, open, arena)
        colon: = p.find_char(':').unwrap_or(0)
        ty: = p.sub_from(colon + 1).trim_spaces()
        // The receiver is `r` (`U8[]`'s methods take it as `r: U8[]`, not as `Self`).
        if at == 0 && !has_self &&
            p.sub(0, colon).strip_prefix("$").strip_prefix("_").equals("r")
            has_self = true
            continue
        if ty.equals(ARENA_TYPE)
            bare: = key.sub(0, key.find_str(" #cfg").unwrap_or(key.len))
            dot: = bare.rfind_char('.')
            name: = bare.sub_from(dot.unwrap_or(0) + 1) if dot.is_some() else bare
            ty_part: = bare.sub(0, dot.unwrap_or(0))
            base: = ty_part.sub(0, ty_part.find_str("<|").unwrap_or(ty_part.len))
            module: = file.sub_from(file.rfind_char('/').unwrap_or(0) + 1)
            before: U8[] = (module if dot.is_none() else ("" if has_self else base))
            return .some(Arena_call::{ .label = arena.text().s(file).c(' ').s(bare).take(),
                .name = name, .before = before, .at = at })
        at += 1
    return .none

priv fn check_null_arena_calls(arena: Arena$@)
    $calls: = List<|Arena_call|>.new(arena)
    $modules: = List<|U8[]|>.new(arena)
    for line in harness.read_under_root(STD_RECORD).lines(arena)
        cols: = line.split('\t', arena)
        if cols.len < 3 || !cols.get(0).starts_with("std/") ||
            !cols.get(2).starts_with("pub fn ")
            continue
        scan.push_unique(modules@, cols.get(0).sub_from(4))
        if c: = arena_call_of(cols.get(0), cols.get(1), cols.get(2), arena)
            calls.push(c)
    defer $tests: = str.Str_builder.new()
    for rel in harness.tracked_matching(U8[][]::{ "std/tests/*.kspl" })
        tests.s(harness.read_under_root(rel)).c('\n')
    $bad: = List<|U8[]|>.new(arena)
    for c in calls
        if !has_null_call(tests.slice(), c, modules.slice(), arena)
            bad.push(c.label)
    verdict.check_list("every std function taking an arena is called with null in std's tests",
        calls.len, "functions", bad@,
        "call it with null where the arena goes (std/tests/arena_null_test.kspl), and free the \
            result as its summary says")

// Caution: **Keep both sides in each table**, or a judgment answering always true passes.
priv const FS_JOIN: Arena_call = ::{ .label = "std/fs join", .name = "join", .before = "fs",
    .at = 2 }
priv const TEXT_JOIN: Arena_call = ::{ .label = "std/str U8[].join", .name = "join", .before = "",
    .at = 1 }
priv const LIST_NEW: Arena_call = ::{ .label = "std/ds List<|T|>.new", .name = "new",
    .before = "List", .at = 0 }
priv const SAMPLE_MODULES: U8[][_] = ::{ "fs", "json" }

priv fn calls_fs_join(text: U8[], arena: Arena$@): Bool
    return has_null_call(text, FS_JOIN, U8[][]::SAMPLE_MODULES, arena)

priv fn calls_text_join(text: U8[], arena: Arena$@): Bool
    return has_null_call(text, TEXT_JOIN, U8[][]::SAMPLE_MODULES, arena)

priv fn calls_list_new(text: U8[], arena: Arena$@): Bool
    return has_null_call(text, LIST_NEW, U8[][]::SAMPLE_MODULES, arena)

priv const FS_JOIN_SAMPLES: Sample[_] = ::{ Sample::{ .text = "fs.join(\"a\", \"b\", null)",
    .hits = true }, Sample::{ .text = "fs.join(f(a, b), \"c\", null)", .hits = true },
    Sample::{ .text = "fs.join(\"a,)\", ',', null)", .hits = true },
    Sample::{ .text = "fs.join(\"a\", \"b\", arena)", .hits = false },
    Sample::{ .text = "fs.join(\"a\", null, arena)", .hits = false },
    Sample::{ .text = "dfs.join(\"a\", \"b\", null)", .hits = false } }
priv const TEXT_JOIN_SAMPLES: Sample[_] = ::{ Sample::{ .text = "\"-\".join(parts, null)",
    .hits = true }, Sample::{ .text = "fs.join(parts, null)", .hits = false },
    Sample::{ .text = "s.join(parts, arena)", .hits = false } }
priv const LIST_NEW_SAMPLES: Sample[_] = ::{ Sample::{ .text = "List<|I32|>.new(null)",
    .hits = true }, Sample::{ .text = "List<|Map<|I32, I32|>|>.new(null)", .hits = true },
    Sample::{ .text = "Map<|I32, I32|>.new(null)", .hits = false },
    Sample::{ .text = "List<|I32|>.new(arena)", .hits = false } }

priv fn check_null_arena_fires(arena: Arena$@)
    scan.check_samples("the reading of a module function's null arena can fire",
        Sample[]::FS_JOIN_SAMPLES, "fs_join_samples", calls_fs_join, arena)
    scan.check_samples("the reading of a method's null arena can fire",
        Sample[]::TEXT_JOIN_SAMPLES, "text_join_samples", calls_text_join, arena)
    scan.check_samples("the reading of a constructor's null arena can fire",
        Sample[]::LIST_NEW_SAMPLES, "list_new_samples", calls_list_new, arena)

fn run(arena: Arena$@) //< runs the check, after showing it can fire
    check_null_arena_fires(arena)
    check_null_arena_calls(arena)

//< Checks that the interfaces offered to the outside agree with the documents
//< The entry points are the CLI, make's targets, the lists, a place on real hardware. It is not a
//< suite of its own; it is a part of conventions.
//< **Each of these builds either way** (Principle 5 turned round); the canonical source is the
//< implementation. Disagreements inside ksplc (a diagnostic's code, a facade, sema's steps) are
//< checked by `conventions_match.kspl`.
import "std/chars"
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/conventions_scan" as scan
import "tests/support/docref_make" as make_targets
import "tests/support/harness"
import "tests/support/harness_text" as htext

priv const SPEC_TOOLS: U8[] = "ksplc/docs/SPEC-tools.md" //<
    //< The same specification the diagnostic codes' check reads

// ==========================================
// Each program's command line agrees between the implementation and its specification
// The canonical source is the implementation (the declarations passed to argparse). Each direction
// checks a different range. **One walk serves every program** (Principle 6), so a fix to how
// options are found reaches all of them.
// ==========================================
priv const KSPLC_CLI: U8[] = "ksplc/cli.kspl" //< where ksplc declares its command line

priv const ARGPARSE_BUILTIN: U8[][_] = ::{ "--help" } //<
    //< the entry point argparse provides by itself
    //< No program declares it, but the documents' tables list it.

priv const KSPLC_UNDOCUMENTED_OK: U8[][_] = ::{ "lsp-worker", "compile" } //<
    //< What may be in ksplc's implementation and not in its specification
    //< Caution: Do not add one whose reason cannot be written: this is the only record of "it is
    //< not written in the documents". `lsp-worker` is the inner process that lsp's supervisor
    //< starts. `compile` is the default subcommand's name, which is never typed.

priv const CLI_DOC_PLACEHOLDER: U8[][_] = ::{ "--name", "--foo", "--gc-sections", "--out-implib" } //<
    //< The forms that appear in the documents and are not ksplc's entry points
    //< This is not the place to silence a typo.

priv fn collect_impl_cli(code: U8[][], out: List<|U8[]|>$@, arena: Arena$@) //<
    //< The subcommands and options that the files in `code` declare to argparse
    for file in code
        src: = harness.read_under_root(file)
        // **A call is found by its method, not by the parser's name**, so renaming the parameter
        // that holds the parser hides no declaration.
        for head in U8[][]::{ ".subcommand(\"", ".subcommand_trailing(\"", ".command_flag(\"",
            ".flag(\"", ".str_opt(\"", ".int_opt(\"", ".str_list_opt(\"" }
            for w in scan.find_all(src, head, "\"", arena)
                scan.push_unique(out, w)
        // ksplc's subcommands are the variants of `enum Face`, each named with `_` written `-`.
        $in_faces: = false
        for line in src.lines(arena)
            if line.starts_with("enum Face ")
                in_faces = true
                continue
            if !in_faces || line.len == 0
                continue
            if !line.starts_with("    ")
                in_faces = false
                continue
            word: = line.trim_spaces()
            if !line.starts_with("     ") && word.len > 0 && word[0].is_lower()
                scan.push_unique(out, word.replace("_", "-", arena))
        // The short side of a `parser.short("--long", "-s")`.
        for line in src.lines(arena)
            if at: = line.find_str(".short(\"")
                rest: = line.sub_from(at)
                if second: = rest.find_str("\", \"")
                    tail: = rest.sub_from(second + 4)
                    end: = tail.find_char('"').unwrap_or(0)
                    if end > 0
                        scan.push_unique(out, tail.sub(0, end))

priv fn collect_dash_words(text: U8[], out: List<|U8[]|>$@) //<
    //< The forms `-x` / `--xxx` that appear in the documents
    //< Caution: **Do not pick them up between a pair of backquotes.** A code fence breaks the
    //< pairing, and a whole section is picked up as one form.
    $i: Sz = 0
    for i < text.len
        if text[i] != '-'
            i += 1
            continue
        if i > 0 && (htext.is_word_at(text, i - 1) || text[i - 1] == '-')
            i += 1
            continue
        $j: = i + 1
        if j < text.len && text[j] == '-'
            j += 1
        if j >= text.len || !text[j].is_alpha()
            i += 1
            continue
        $k: = j
        for k < text.len && (text[k].is_alnum() || text[k] == '_' || text[k] == '-')
            k += 1
        scan.push_unique(out, text.sub(i, k - i))
        i = k

priv fn is_builtin(opt: U8[]): Bool //< whether argparse provides `opt` by itself
    for b in ARGPARSE_BUILTIN
        if opt.equals(b)
            return true
    return false

priv fn is_option(word: U8[]): Bool //<
    //< whether `word` has an option's form: `-x` or `--xxx`, not a lone `-`
    return word.len >= 2 && word[0] == '-' &&
        (word[1].is_alpha() || (word.len >= 3 && word[1] == '-'))

priv fn check_cli( //< checks one program's command line against its specification, both ways
    //< **A subcommand counts as written** where the spec puts it after one of `names`, or in
    //< backquotes in a heading (`## `ask`, `watch` and `eval``). **An option counts as written**
    //< wherever the spec writes it. The other way, each option in a table row's first cell, or
    //< right after one of `names`, must be declared.
    program: U8[], //< the program's name, for the report
    spec_path: U8[], //< the document that sets the command line
    code: U8[][], //< the files that declare it to argparse
    names: U8[][], //< how the spec writes the program before an argument (`ksplc `)
    undocumented_ok: U8[][], //< what may be declared and not written, each with its reason
    arena: Arena$@,
): List<|U8[]|> //< what the implementation declares, for the checks that follow
    spec: = harness.read_under_root(spec_path)
    $impl_cli: = List<|U8[]|>(arena)
    collect_impl_cli(code, impl_cli@, arena)
    $mentioned: = List<|U8[]|>(arena)
    collect_dash_words(spec, mentioned@)
    $written: = List<|U8[]|>(arena) //< the options the spec gives the program
    for name in names
        for tail in U8[][]::{ " ", "`" }
            for w in scan.find_all(spec, name, tail, arena)
                scan.push_unique(mentioned@, w)
                if is_option(cut_at_any(w, "=<\"`"))
                    scan.push_unique(written@, cut_at_any(w, "=<\"`"))
    collect_command_options(spec, names, written@, arena)
    for line in spec.lines(arena)
        if line.starts_with("#")
            for w in scan.find_all(line, "`", "`", arena)
                scan.push_unique(mentioned@, w)
    for row in scan.find_line_starts(spec, "| `-", " |", arena)
        for w in scan.find_all(arena.text().s("`-\{row\}`").take(), "`", "`", arena)
            opt: = cut_at_any(w, "=<\"")
            if is_option(opt)
                scan.push_unique(written@, opt)
    $bad: = List<|U8[]|>(arena)
    for w in impl_cli
        if mentioned.contains(w)
            continue
        $ok: = false
        for u in undocumented_ok
            if w.equals(u)
                ok = true
        if !ok
            bad
                .push(arena.text().s("declared and no text in ").s(spec_path).s(": ").s(w).take())
    for opt in written
        if !impl_cli.contains(opt) && !is_builtin(opt)
            bad
                .push(arena.text().s("in ").s(spec_path).s(" and no declaration: ").s(opt).take())
    title: = arena.text().s(program).s("'s command line agrees between the code and its spec")
        .take()
    hint: = arena.text().s("each subcommand and option ").s(program)
        .s(" declares needs its text in ").s(spec_path).s(", and the spec names none it lacks")
        .take()
    verdict.check_list(title, impl_cli.len, "entry points", bad@, hint)
    return impl_cli

priv fn check_cli_all(arena: Arena$@) //< checks every program's command line, ksplc's documents too
    impl_cli: =
        check_cli("ksplc", SPEC_TOOLS, U8[][]::{ KSPLC_CLI }, U8[][]::{ "ksplc " },
        U8[][]::KSPLC_UNDOCUMENTED_OK, arena)
    check_cli("kssrv", "kssrv/README.md", U8[][]::{ "kssrv/main.kspl" },
        U8[][]::{ "kssrv.exe ", "kssrv " }, U8[][]::{}, arena)
    check_cli("ksmd", "docs/HOWTO-set-up-a-project.md",
        U8[][]::{ "tools/ksmd.kspl", "tools/opener.kspl" }, U8[][]::{ "ksmd.exe ", "ksmd " },
        U8[][]::{}, arena)
    check_cli("ksagent", "ksagent/docs/SPEC-commands.md",
        U8[][]::{ "ksagent/main.kspl", "tools/ksagent_chat.kspl", "tools/opener.kspl" },
        U8[][]::{ "ksagent.exe ", "ksagent ", "ksagent_chat.exe " }, U8[][]::{}, arena)

    // The above checks only the specifications. **An entry point written in a design document
    // must be usable too** (Principle 5 turned round). Only `ksplc/*.md` is checked; other folders
    // name the linker's and other tools' options.
    $doc_bad: = List<|U8[]|>(arena)
    $doc_seen: Sz = 0
    for rel in harness.tracked_matching(U8[][]::{ "ksplc/*.md" })
        $words: = List<|U8[]|>(arena)
        collect_dash_words(harness.read_under_root(rel), words@)
        for w in words
            doc_seen += 1
            if !w.starts_with("--") || impl_cli.contains(w) || is_builtin(w)
                continue
            $ok: = false
            for ph in CLI_DOC_PLACEHOLDER
                if w.equals(ph)
                    ok = true
            if !ok
                doc_bad.push(arena.text().s(rel).s(": ").s(w).take())
    verdict.check_list("every `--option` ksplc/'s documents write stands in the implementation",
        doc_seen, "shapes", doc_bad@,
        "the option is written in a document but not declared in ksplc/cli.kspl: mend the document, \
            or declare it")

priv fn collect_command_options( //<
    //< The options on each command line that starts the program
    //< **Every option on the line counts**, not only the one right after the name, so a service
    //< unit's `ExecStart=` or a sample command cannot name an option the program lacks. **The
    //< name must start the command**: at the line's start, after a `/` or after a backquote. Met
    //< as an argument (`install -o kssrv`), it starts nothing. The line ends at a comment, a
    //< backquote, a pipe, a `;`, a `&` or a bracket: past one, the words are another program's.
    spec: U8[],
    names: U8[][], //< how the spec writes the program before an argument (`kssrv `)
    written: List<|U8[]|>$@, //< where each option found is added
    arena: Arena$@,
)
    for line in spec.lines(arena)
        for name in names
            if at: = line.find_str(name)
                before: = line.sub(0, at)
                if before.trim_spaces().len > 0 && !before.ends_with("/") &&
                    !before.ends_with("`")
                    continue
                tail: = cut_at_any(line.sub_from(at + name.len), "#`|;&()")
                for word in tail.split(' ', arena)
                    opt: = cut_at_any(word, "=<\"")
                    if is_option(opt)
                        scan.push_unique(written, opt)

priv fn cut_at_any(text: U8[], seps: U8[]): U8[] //<
    //< The text before the first separator (the trailing spaces are dropped)
    $i: Sz = 0
    for i < text.len
        for c in seps
            if text[i] == c
                return text.sub(0, i).trim_end()
        i += 1
    return text.trim_end()

// ==========================================
// `--style`'s keys agree across the spec, the implementation and the reader
// Caution: **Compare all three**, or "a key in the table, accepted, doing nothing" slips in
// (Principle 5).
// ==========================================
priv const STYLE_SRC: U8[] = "ksplc/fmt/style.kspl" //<
    //< The file holding the style keys accepted
    //< **The accepted list and the reader are in two files.** `ksplc/fmt/style.kspl` holds the
    //< accepted spelling and `ksplc/fmt/printer.kspl` the field the formatter reads, so one name
    //< here would check only one of the two.
priv const READ_SRC: U8[] = "ksplc/fmt/printer.kspl"

priv const STYLE_KEYS: U8[][_] = ::{ "IndentWidth", "ColumnLimit" } //<
    //< The table's key name -> the field the formatter reads
    //< Caution: Add a field and add it in here too.
priv const STYLE_FIELDS: U8[][_] = ::{ "indent_width", "column_limit" }

priv fn check_style(arena: Arena$@)
    spec: = harness.read_under_root(SPEC_TOOLS)
    src: = harness.read_under_root(STYLE_SRC)
    read: = harness.read_under_root(READ_SRC)
    $spec_keys: = scan.find_all(spec, "| **`", "`** |", arena)
    $impl_keys: = scan.find_all(src, "_KEY: U8[] = \"", "\"", arena)
    $bad: = List<|U8[]|>(arena)
    scan.diff_into(spec_keys@, impl_keys@,
        arena.text().s("\{SPEC_TOOLS\}'s table").take(), STYLE_SRC, bad@, arena)
    scan.diff_into(impl_keys@, spec_keys@, STYLE_SRC,
        arena.text().s("\{SPEC_TOOLS\}'s table").take(), bad@, arena)
    for i in Range.asc(STYLE_KEYS.len)
        if !impl_keys.contains(STYLE_KEYS[i])
            bad
                .push(arena.text().s(STYLE_KEYS[i]).s(": in this test's pairing table and not in ")
                .s(STYLE_SRC).s("'s list").take())
            continue
        // "The reader", apart from the declaration and the default: `r.config.<field>`.
        want: = arena.text().s(".config.").s(STYLE_FIELDS[i]).take()
        if read.find_str(want).is_none()
            bad
                .push(arena.text().s(STYLE_KEYS[i]).s(" is accepted and ").s(READ_SRC)
                .s(" does not read `").s(want).s("`").take())
    verdict.check_list("`--style`'s keys agree across the spec, the code and the reader",
        STYLE_KEYS.len, "keys", bad@,
        "a `--style` key must stand in SPEC-tools.md, the formatter's table and its reader alike")

// ==========================================
// ksos's make targets can be walked to from the documents
// Caution: **Do not leave a target out of the documents.** ksos records hardware confirmations
// in the documents. With no path to the entry point that confirms, it cannot be tried again.
// The other direction, a document naming a target make lacks, is `docref_make.kspl`'s.
// ==========================================
priv const KSOS_MK: U8[] = "lib/ksos/Makefile"

priv const KSOS_HELPERS: U8[][_] = ::{ "ksos-linkcheck-", "ksos-qemugate-", "ksos-posixgate-",
    "ksos-capgate-" } //<
        //< The prefixes of the targets a gate starts, one per demo, which no person runs
        //< They come from `ksos_linkcheck_rule` and `ksos_gate_rule` in `lib/ksos/Makefile`. A new
        //< family of them fails this check until it is added here.

priv fn is_ksos_helper(target: U8[]): Bool
    for p in KSOS_HELPERS
        if target.starts_with(p)
            return true
    return false

priv fn check_ksos_targets(arena: Arena$@)
    $targets: = List<|U8[]|>(arena)
    for t in make_targets.rules_of("lib/ksos", arena).targets
        if t.starts_with("ksos") && !is_ksos_helper(t)
            scan.push_unique(targets@, t)
    $runnable: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::{ "*.md" })
        text: = harness.read_under_root(rel)
        $i: Sz = 0
        for i + 10 <= text.len
            if at: = text.sub_from(i).find_str("make ksos")
                p: = i + at + 5
                $k: = p
                for k < text.len &&
                    (text[k].is_alnum() || text[k] == '_' || text[k] == '-')
                    k += 1
                scan.push_unique(runnable@, text.sub(p, k - p))
                i = k
            else
                break
    $bad: = List<|U8[]|>(arena)
    if targets.len == 0
        bad
            .push(arena.text().s("make names no ksos target in ").s(KSOS_MK).take())
    scan.diff_into(targets@, runnable@, KSOS_MK, "a document in the `make ...` shape", bad@, arena)
    verdict.check_list("every ksos make target is named in a document", targets.len, "targets",
        bad@, "name it as `make <target>` in a document, or add a gate's prefix to `KSOS_HELPERS`")

// ==========================================
// Every std file publishes something. The other direction, a row for a file no longer there, is
// `make test-surface`'s: the record no longer matches what std publishes.
// ==========================================

priv const STD_RECORD: U8[] = "std/SURFACE.txt" //<
    //< The record of what std publishes, one row per declaration, the file's logical name first
    //< **A file that publishes nothing has no row**, and to std's users a file `ksplc doc std` does
    //< not list does not exist. `std/` is flat, so only the `.kspl` directly under it counts, and
    //< **`std/tests/` is not counted**: std's users do not choose from it.

priv fn check_std_list(arena: Arena$@)
    $files: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::{ "std/*.kspl" })
        if rel.starts_with("std/tests/")
            continue
        files.push(rel.sub_from(4).strip_suffix(".kspl"))
    $recorded: = List<|U8[]|>(arena)
    for line in harness.read_under_root(STD_RECORD).lines(arena)
        tab: = line.find_char('\t').unwrap_or(0)
        if line.starts_with("std/") && tab > 4
            scan.push_unique(recorded@, line.sub(4, tab - 4))
    $bad: = List<|U8[]|>(arena)
    scan.diff_into(files@, recorded@, "what is really there", STD_RECORD, bad@, arena)
    verdict.check_list("every std file publishes something", files.len, "files", bad@,
        "remake the record with `make surface`, or give the file something `pub`")

// ==========================================
// The Flash region reserved for the record agrees between the driver and the linker script
// ==========================================

priv const FLASH_DRV: U8[] = "lib/ksos/drivers/rp2040/flash.kspl" //<
    //< The driver that holds the Flash region reserved for the record
    //< **When they disagree, the link passes even where the image reaches the record's region.**
    //< The ASSERT sees only "the image does not come this far". So a change to the driver alone
    //< puts the record at **a place nobody looks at**.
priv const FLASH_LD: U8[] = "lib/ksos/port/rp2040/link.ld"

priv const DRV_HEAD: U8[] = "const REGION_BASE: Sz = " //<
    //< The marker in front of the number, on each side
    //< Caution: **Do not hard-code the marker's length**: the column drifts on an edit and fails as
    //< "not found", which reads like a differing value. **Do not put the visibility into the
    //< marker**: a `pub` comes and goes; it is stripped before reading.
priv const LD_HEAD: U8[] = "ASSERT(_flash_image_end <= ORIGIN(FLASH) + "

priv fn value_at(rest: U8[]): U8[] //< takes the number written at the start of `rest`
    //< **Both sides carry something behind the number** (a `//<` on the driver's, the ASSERT's rest
    //< on the linker script's). So a stop where the number stops serves both.
    $k: Sz = 0
    for k < rest.len && rest[k].is_alnum()
        k += 1
    return rest.sub(0, k)

priv fn check_flash(arena: Arena$@)
    $drv: U8[] = ""
    for line in harness.read_under_root(FLASH_DRV).lines(arena)
        bare: = line.strip_prefix("pub ").trim_spaces()
        if bare.starts_with(DRV_HEAD)
            drv = value_at(bare.sub_from(DRV_HEAD.len))
    $ld: U8[] = ""
    for line in harness.read_under_root(FLASH_LD).lines(arena)
        if at: = line.find_str(LD_HEAD)
            ld = value_at(line.sub_from(at + LD_HEAD.len))
    ok: = drv.len > 0 && ld.len > 0 && drv.equals(ld)
    why: = arena.text().s(FLASH_DRV).s(": ").s("(not found)" if drv.len == 0 else drv).s("\n")
        .s(FLASH_LD).s(": ").s("(not found)" if ld.len == 0 else ld).take()
    verdict.check("the Flash place for the record agrees between the driver and the linker script",
        ok, why)

fn run(arena: Arena$@) //< runs every check of the entry points offered to the outside
    check_cli_all(arena)
    check_style(arena)
    check_ksos_targets(arena)
    check_std_list(arena)
    check_flash(arena)

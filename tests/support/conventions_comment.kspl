//< Comments hold at most 30% of the hand-written source (not the suite)
//< The rule is in "Comment notation and limits" in `docs/SPEC-plain-language.md`; this file only
//< counts. The share is the repository's, so one file may hold more.
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/conventions_scan" as scan + { Sample }
import "tests/support/harness"
import "tools/repo_stat_path" as path_kind

priv const MAX_SHARE_PERCENT: Sz = 30

// **A line is counted by `count_lines` in `tools/repo_stat_path.kspl`**, the one rule the size
// report uses too. A blank line counts on neither side, so the share does not change with a
// writing habit.
priv struct Tally //< the comment lines and the code lines counted so far
    comment: Sz
    code: Sz

priv fn tally(text: U8[], path: U8[], total: Tally$@, arena: Arena$@) //< adds one file's lines
    n: = path_kind.count_lines(text, path, arena)
    total.comment += n.comment
    total.code += n.code

priv fn over_cap(count: Tally): Bool //< whether comments hold more than the cap
    return count.comment * 100 > MAX_SHARE_PERCENT * (count.comment + count.code)

priv fn kspl_over_cap(text: U8[], arena: Arena$@): Bool //< the judgment on a text read as KSPL
    $t: = Tally::{}
    tally(text, "sample.kspl", t@, arena)
    return over_cap(t)

priv fn c_over_cap(text: U8[], arena: Arena$@): Bool //< the judgment on a text read as C
    $t: = Tally::{}
    tally(text, "sample.c", t@, arena)
    return over_cap(t)

// The samples read as KSPL.
// Caution: **Keep a sample right at the cap**: 30% passes, as "at most" says.
priv const KSPL_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "a: = 1\n// one\nb: = 2\n", .hits = true },
    Sample::{ .text = "a: = 1\nb: = 2\n// one\nc: = 3\n", .hits = false },
    Sample::{ .text = "// 1\n// 2\n// 3\na\nb\nc\nd\ne\nf\ng\n", .hits = false },
    Sample::{ .text = "a: = 1\n\n\n\n//< one\nb: = 2\n", .hits = true },
    Sample::{ .text = "a: = 1 // one\nb: = 2 // two\nc: = 3\n// three\n", .hits = false },
}

// The samples read as C, where a block comment runs over lines.
priv const C_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "/* one\n   two\n   three */\nint a;\nint b;\nint c;\nint d;\n",
        .hits = true },
    Sample::{ .text = "char *s = \"/*\";\nint a;\nint b;\n// one\n", .hits = false },
}

priv fn check_share(arena: Arena$@) //< the share over every hand-written source file
    $total: = Tally::{}
    $files: Sz = 0
    for rel in harness.tracked_matching(U8[][]::scan.BUILD_EXT)
        // The seed is generated, so it is not hand-written source.
        if rel.equals("ksplc/seed.c")
            continue
        files += 1
        tally(harness.read_under_root(rel), rel, total@, arena)
    lines: = total.comment + total.code
    permille: = total.comment * 1000 / lines if lines > 0 else 0
    name: = arena.text()
        .s("comments hold \{permille / 10\}.\{permille % 10\}% of the hand-written source, ")
        .s("at most \{MAX_SHARE_PERCENT\}% (\{files\} files)").take()
    verdict.check(name, files > 0 && !over_cap(total),
        "shorten comments that repeat the code (\"Comment notation and limits\" in \
            docs/SPEC-plain-language.md)")

fn run(arena: Arena$@)
    scan.check_samples("the comment share read as KSPL can fire", Sample[]::KSPL_SAMPLES,
        "kspl_samples", kspl_over_cap, arena)
    scan.check_samples("the comment share read as C can fire", Sample[]::C_SAMPLES, "c_samples",
        c_over_cap, arena)
    check_share(arena)

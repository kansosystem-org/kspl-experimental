//< Comments hold at most 30% of the hand-written source (not the suite)
//< The rule is in "Comment notation and limits" in `docs/SPEC-plain-language.md`; this file only
//< counts. The share is the repository's, so one file may hold more.
import "std/chars" // `find_str`
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/conventions_scan" as scan + { Sample }
import "tests/support/harness"

priv const MAX_SHARE_PERCENT: Sz = 30

// ==========================================
// How a line is counted
// A blank line counts on neither side, so the share does not change with a writing habit. A line
// that opens with a comment mark, or lies inside a block comment, is a comment line. Every other
// line is code, a code line that ends in a comment included.
// ==========================================

priv struct Marks //< a kind of file's comment marks, each empty where the kind has none
    line: U8[] //< the mark that comments out the rest of a line
    open: U8[] //< a block comment's opening mark
    close: U8[] //< a block comment's closing mark

priv fn marks_of(path: U8[]): Marks //< the comment marks of the file's kind, read from its name
    //< Caution: **`.ksplb` takes `//`, not `#`.** `#` starts an attribute, so every `#cfg(…)` would
    //< count as a comment.
    $m: = Marks::{ .line = "", .open = "", .close = "" }
    if path.ends_with(".kspl") || path.ends_with(".ksplb") || path.ends_with(".c") ||
        path.ends_with(".h") || path.ends_with(".js") || path.ends_with(".mjs")
        m.line = "//"
    else if path.ends_with(".py") || path.ends_with(".mk") || path.ends_with(".yml") ||
        path.ends_with("Makefile") || path.ends_with("Dockerfile")
        m.line = "#"
    if path.ends_with(".c") || path.ends_with(".h") || path.ends_with(".js") ||
        path.ends_with(".mjs") || path.ends_with(".css") || path.ends_with(".S") ||
        path.ends_with(".ld")
        m.open = "/*"
        m.close = "*/"
    else if path.ends_with(".html")
        m.open = "<!--"
        m.close = "-->"
    return m

priv fn open_after(line: U8[], marks: Marks, open: Bool): Bool //<
    //< Whether a block comment is still open at the end of the line
    //< `open` says a block runs on from the line above.
    //< Caution: **Skip the strings first**: a `"/*"` in a string opens nothing.
    if open
        return line.find_str(marks.close).is_none()
    if marks.open.len == 0
        return false
    $i: Sz = 0
    $quote: U8 = 0
    for i < line.len
        c: = line[i]
        if quote != 0
            i += 2 if c == '\\' else 1
            if c == quote
                quote = 0
            continue
        if c == '"' || c == '\''
            quote = c
            i += 1
            continue
        rest: = line.sub_from(i)
        if marks.line.len > 0 && rest.starts_with(marks.line)
            return false
        if rest.starts_with(marks.open)
            return rest.sub_from(marks.open.len).find_str(marks.close).is_none()
        i += 1
    return false

priv struct Tally //< the comment lines and the code lines counted so far
    comment: Sz
    code: Sz

priv fn tally(text: U8[], marks: Marks, total: Tally$@, arena: Arena$@) //< adds one file's lines
    $open: = false
    for ln in text.lines(arena)
        t: = ln.trim_spaces()
        carried: = open
        open = open_after(ln, marks, open)
        if t.len == 0
            continue
        if carried || marks.line.len > 0 && t.starts_with(marks.line) ||
            marks.open.len > 0 && t.starts_with(marks.open)
            total.comment += 1
        else
            total.code += 1

priv fn over_cap(count: Tally): Bool //< whether comments hold more than the cap
    return count.comment * 100 > MAX_SHARE_PERCENT * (count.comment + count.code)

priv fn kspl_over_cap(text: U8[], arena: Arena$@): Bool //< the judgment on a text read as KSPL
    $t: = Tally::{}
    tally(text, marks_of("sample.kspl"), t@, arena)
    return over_cap(t)

priv fn c_over_cap(text: U8[], arena: Arena$@): Bool //< the judgment on a text read as C
    $t: = Tally::{}
    tally(text, marks_of("sample.c"), t@, arena)
    return over_cap(t)

// The samples read as KSPL.
// Caution: **Keep a sample right at the cap**: 30% passes, as "at most" says.
priv const KSPL_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "a: = 1\n// one\nb: = 2\n", .hits = true },
    Sample::{ .text = "a: = 1\nb: = 2\n// one\nc: = 3\n", .hits = false },
    Sample::{ .text = "// 1\n// 2\n// 3\na\nb\nc\nd\ne\nf\ng\n", .hits = false },
    Sample::{ .text = "a: = 1\n\n\n\n//< one\nb: = 2\n", .hits = true },
    Sample::{ .text = "a: = 1 // one\nb: = 2 // two\nc: = 3\n// three\n", .hits = false },
}

// The samples read as C, where a block comment runs over lines.
priv const C_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "/* one\n   two\n   three */\nint a;\nint b;\nint c;\nint d;\n",
        .hits = true },
    Sample::{ .text = "char *s = \"/*\";\nint a;\nint b;\n// one\n", .hits = false },
}

priv fn check_share(arena: Arena$@) //< the share over every hand-written source file
    $total: = Tally::{}
    $files: Sz = 0
    for rel in harness.tracked_matching(U8[][]::scan.BUILD_EXT)
        // The seed is generated, so it is not hand-written source.
        if rel.equals("ksplc/seed.c")
            continue
        files += 1
        tally(harness.read_under_root(rel), marks_of(rel), total@, arena)
    lines: = total.comment + total.code
    permille: = total.comment * 1000 / lines if lines > 0 else 0
    name: = arena.text()
        .s("comments hold \{permille / 10\}.\{permille % 10\}% of the hand-written source, ")
        .s("at most \{MAX_SHARE_PERCENT\}% (\{files\} files)").take()
    verdict.check(name, files > 0 && !over_cap(total),
        "shorten comments that repeat the code (\"Comment notation and limits\" in \
            docs/SPEC-plain-language.md)")

fn run(arena: Arena$@)
    scan.check_samples("the comment share read as KSPL can fire", Sample[]::KSPL_SAMPLES,
        "kspl_samples", kspl_over_cap, arena)
    scan.check_samples("the comment share read as C can fire", Sample[]::C_SAMPLES, "c_samples",
        c_over_cap, arena)
    check_share(arena)

//< How the repository's own checks and messages are written
//< It is not a suite of its own; it is a part of conventions.
//<
//< It finds a walk's verdict that gives no fix, and a compiler message that shows a type's
//< internal name. **The language's own rules on how source is written are `ksplc`'s lints**, which
//< `make lint` runs ("Static analysis and the linter" in `../../ksplc/docs/SPEC-tools.md`).
//< `tests/suite/conventions_test.kspl` checks how a document is written, and
//< `tests/support/conventions_match.kspl` checks where "two things written separately drift
//< silently".
import "std/chars"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/verdict"
import "tests/support/conventions_scan" as scan + { Sample }
import "tests/support/harness"

priv const LIST_CALL: U8[] = "verdict.check_list(" //< the call whose last argument is the fix

priv fn has_hintless_list(src: U8[], arena: Arena$@): Bool //<
    //< Whether a source calls `verdict.check_list` with an empty fix, outside a `\"\"\"` string
    //< **A failing walk then names what is wrong but not what to do**, and the reader has to find
    //< the check's source to learn it. The fix is the call's last argument.
    defer $code: = Str_builder()
    $raw: = false
    for line in src.lines(arena)
        if !raw
            code.s(line)
        code.c('\n')
        raw = scan.flip_raw(line, raw)
    text: = code.slice()
    $rest: U8[] = text
    for rest.len > 0
        if at: = rest.find_str(LIST_CALL)
            $i: = at + LIST_CALL.len
            $depth: Sz = 1
            for i < rest.len && depth > 0
                if rest[i] == '('
                    depth += 1
                else if rest[i] == ')'
                    depth -= 1
                i += 1
            // The call without its closing bracket. An empty fix leaves `""` standing alone at its
            // end, after a space or a comma (a hint ending in an escaped quote ends `\""`).
            call: = rest.sub(at, i - at - 1).trim_end()
            if call.ends_with("\"\"") && call.len > 2 &&
                (call[call.len - 3] == ' ' || call[call.len - 3] == ',' ||
                call[call.len - 3] == '\n')
                return true
            rest = rest.sub_from(i)
        else
            return false
    return false

// The samples for `has_hintless_list`.
// Caution: **Keep a call spread over lines and one inside a `\"\"\"` string.** The first is the
// usual shape. The second is a test's material, not a call.
priv const HINTLESS_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "    verdict.check_list(\"x\", n, \"files\", bad@, \"\")\n", .hits = true },
    Sample::{ .text = "    verdict.check_list(\"x (y)\", n, \"files\",\n        bad@, \"\")\n",
        .hits = true },
    Sample::{ .text = "    verdict.check_list(\"x\", n, \"files\", bad@, \"mend it\")\n",
        .hits = false },
    Sample::{ .text = "    verdict.check_list(\"x\", n, \"f\", bad@, \"say \\\"so\\\"\")\n",
        .hits = false },
    Sample::{ .text =
        "priv const S: U8[] =\n    \"\"\"\n  verdict.check_list(\"x\", 1, \"f\", b@, \
            \"\")\n\"\"\"\n", .hits = false },
}

priv fn check_hintless_lists(arena: Arena$@) //<
    //< Every walk's verdict says how to fix what it finds
    $bad: = scan.misjudged(Sample[]::HINTLESS_SAMPLES, has_hintless_list, arena)
    $seen: Sz = 0
    for rel in harness.tracked_matching(U8[][]::scan.KSPL_SPECS)
        src: = harness.read_under_root(rel)
        if src.find_str(LIST_CALL).is_none()
            continue
        seen += 1
        if has_hintless_list(src, arena)
            bad.push(rel)
    verdict.check_list("every walk's verdict says how to fix what it finds", seen, "files", bad@,
        "give the `verdict.check_list` call a last argument saying what to do")

// ==========================================
// A diagnostic names a type by its display text, never its internal name
// ==========================================

priv const INTERNAL_NAME_CALL: U8[] = "get_str(" //< the call that gives a type's internal name

priv fn interpolates_internal_name(line: U8[], _arena: Arena$@): Bool //<
    //< Whether a line puts a type's internal name into an interpolation (`\{…get_str(…)…\}`)
    //< **An interpolation writes text for a person**, and the internal name is C's spelling
    //< (`std_lang_Option_I32`, `U8 immut`); `display` (`ksplc/sema/type/display.kspl`) writes what
    //< the user wrote. A name bound first and interpolated later escapes this reading and still
    //< breaks the rule (Principle 8 in `../../docs/DESIGN-principles.md`).
    if line.trim_spaces().starts_with("//")
        return false
    $rest: = line
    for
        if at: = rest.find_str("\\{")
            after: = rest.sub_from(at + 2)
            end: = after.find_str("\\}").unwrap_or(after.len)
            if after.sub(0, end).find_str(INTERNAL_NAME_CALL).is_some()
                return true
            rest = after.sub_from(end)
        else
            return false

// The samples for `interpolates_internal_name`.
// Caution: **Include the side that must not hit**: a key built with `.s()`, `display` in the
// interpolation, a comment, and `get_str` after the interpolation closes.
priv const INTERNAL_NAME_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "    .s(\"between '\\{c.env.get_str(t)\\}' and\")", .hits = true },
    Sample::{ .text = "  c.err(n, \"x \\{a\\} and \\{r.env.get_str(b)\\}\")", .hits = true },
    Sample::{ .text = "    .s(\"between '\\{c.env.display(t)\\}' and\")", .hits = false },
    Sample::{ .text = "    key.s(r.env.get_str(owner)).c('.').s(name)", .hits = false },
    Sample::{ .text = "    // \"\\{c.env.get_str(t)\\}\" is the old shape", .hits = false },
    Sample::{ .text = "    .s(\"\\{n\\} of \").s(c.env.get_str(t))", .hits = false },
}

priv fn check_internal_names(arena: Arena$@) //<
    //< No message in the compiler interpolates a type's internal name
    $bad: = scan.misjudged(Sample[]::INTERNAL_NAME_SAMPLES, interpolates_internal_name, arena)
    $seen: Sz = 0
    for rel in harness.tracked_matching(U8[][]::scan.KSPL_SPECS)
        if !rel.starts_with("ksplc/") || rel.starts_with("ksplc/tests/")
            continue
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            i += 1
            seen += 1
            if interpolates_internal_name(line, arena)
                bad
                    .push(arena.text().s(rel).s(":\{i\}: ").s(line.trim_spaces()).take())
    verdict.check_list("a diagnostic names a type by its display text", seen, "lines", bad@,
        "write `env.display(id)` in place of `env.get_str(id)` in the message")

fn run(arena: Arena$@)
    check_hintless_lists(arena)
    check_internal_names(arena)

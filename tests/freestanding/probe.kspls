//< Exports the cfg(freestanding) half of std/math so that tests/freestanding/harness.c can call it
//<
//< That half is a software implementation with no dependencies, exported with `#export`.
//< Compiling with --freestanding selects it, since --freestanding also sets the flag freestanding
//< (in ksplc/main.kspls).
import "std/math"
import "std/mem"
import "std/str" + { Str_builder }
import "std/strfmt"
import "std/strnum"

#export
fn probe_sqrt(x: F64): F64
  return math.sqrt(x)
#export
fn probe_exp(x: F64): F64
  return math.exp(x)
#export
fn probe_log(x: F64): F64
  return math.log(x)
#export
fn probe_sin(x: F64): F64
  return math.sin(x)
#export
fn probe_cos(x: F64): F64
  return math.cos(x)
#export
fn probe_tan(x: F64): F64
  return math.tan(x)
#export
fn probe_pow(base: F64, exponent: F64): F64
  return math.pow(base, exponent)

// ==========================================
// std/strfmt's formatting (the equivalent of `%.*f` / `%p`). std builds a floating-point number's
// digits itself instead of calling libc, so harness.c compares them **as strings** against a real
// libc's snprintf ("The digits of a floating-point number are assembled here" in
// std/docs/DESIGN.md). `%p` exists only on the freestanding side.
// ==========================================

// Str_builder uses alloc. Under cfg(freestanding), alloc uses a free list on a static buffer that
// init_freestanding_heap() sets up, so the heap is set up once before the first formatting.
priv $fh_heap: U8[65536] = ::{}
priv $fh_heap_ready: Bool = false

priv fn ensure_heap()
  if !fh_heap_ready
    mem.init_freestanding_heap(U8$[]::fh_heap)
    fh_heap_ready = true

priv fn copy_out(sl: U8[], out: U8$@, cap: Sz): Sz //<
  //< Copies sl's content to out and returns the length
  //<
  //< It writes into the fixed buffer the harness prepared.
  n: = sl.len if sl.len < cap else cap
  for i in Range.asc(n)
    (out + i)$ = (sl.ptr + i)$
  return n

#export
fn probe_format_float(out: U8$@, cap: Sz, v: F64, precision: I32): Sz
  ensure_heap()
  $b: = Str_builder.new()
  defer b.free()
  bw: Str_builder$@ = b@
  strfmt.write_float(bw, v, precision, 0, ' ', false)
  return copy_out(b.slice(), out, cap)

#export
fn probe_format_ptr(out: U8$@, cap: Sz, val: Void$@): Sz
  ensure_heap()
  $b: = Str_builder.new()
  defer b.free()
  bw: Str_builder$@ = b@
  strfmt.write_ptr(bw, val)
  return copy_out(b.slice(), out, cap)

// Tells the harness how many digits are guaranteed to match libc exactly. The digits are computed
// exactly in multiple precision, so every digit up to `.N`'s cap matches.
#export
fn probe_exact_precision(): Sz
  return strfmt.float_max_precision

#!/usr/bin/env -S ksplc run
//< CI performance guard: checks whether memory use has grown markedly over the baseline
//< It reads the lines that ksplc prints to the log when self-hosting: "Compile time", "System Peak
//< Memory", "AST Arena headroom", "AST Node bytes" and "AST Kids bytes". The peak and the time are
//< compared against tests/tools/perf_baseline.json.
//< Caution: **The peak memory and the two exact type sizes decide. Do not remove either.** The
//< peak covers **everything coarsely**, in steps of one chunk. The sizes of the tree's two types
//< hold the node to the byte, and a node that grows can hide under the peak's 30% slack. The peak
//< is our own count, not RSS: the most bytes `std/mem.kspl` held from malloc at once.
import "std/argparse"
import "std/chars"
import "std/fs"
import "std/io"
import "std/json"
import "std/json_struct"
import "std/mem" { Arena, dealloc }
import "std/reflect"
import "std/regex"
import "std/str" { Str_builder }
import "std/strfmt"
import "std/sys"

priv const MEM_THRESHOLD: F64 = 1.3 //< the multiple allowed for the peak
    //< **It cannot be tighter than a step.** The AST's arena grows a chunk at a time (`Arena` in
    //< `std/mem.kspl`), so one step is a large fraction of the peak.
    //< Caution: **Where the peak fails, suspect a step first** — a rise of about one `arena carry`
    //< chunk is a step (then run `--update`). **Do not lower this
    //< baseline to today's value**: the slack is lost, and the next run in which a chunk grows
    //< fails.

priv const TIME_PATTERN: U8[] = "Compile time\\s*:\\s*([\\d,]+) ms" //<
    //< The patterns picked out of the log
    //< **The canonical source is the lines `ksplc/main.kspl` prints**; change them and change
    //< this. `[\d,]+` includes the grouping comma (`7,052`). `Compile time` is `N/A` on backends
    //< other than C and so is not picked up (`make perf-log` measures on C).
// **Capture the distance to the next step and the step's size in one pattern**; either alone
// cannot tell "where the peak goes if it takes the step".
priv const HEADROOM_PATTERN: U8[] =
    "AST Arena headroom:\\s*([\\d,]+) bytes before next chunk \\(\\+([\\d,]+) bytes\\)"
priv const PEAK_PATTERN: U8[] = "System Peak Memory:\\s*([\\d,]+) bytes" //<
    //< The pattern for the peak memory
    //< **The build time is not used for the verdict**; only its ratio against the baseline is
    //< recorded.
    //< On the same tree and machine, cold time varies by nearly a factor of two while the peak
    //< memory stays the same. Time measures the machine and its load, not the work. A loose bound
    //< buries a real regression; a tight one fails on noise. `--stats` adds the per-stage
    //< breakdown. To investigate time, compare the minimum of several runs on a quiet machine.

priv enum Guard_error //< the tool failed
    //< Caution: **Do not add variants.** The code that finds the problem prints the reason, and the
    //< caller returns exit code 2 for any; only "something went wrong" is carried.
    failed

priv struct Metrics
    compile_ms: I64
    peak_bytes: I64

priv struct Headroom //<
    //< the distance to the carry (the AST's arena growing by one more chunk)
    //< Caution: **Do not merge it into `Metrics`**, the baseline JSON's format: a new key makes
    //< every existing baseline unreadable. This is read from the log each time.
    free: I64
    step: I64

priv struct Shapes //< the sizes of the types the tree is built from
    //< Caution: **Do not merge it into `Metrics`.** That holds per-machine values, while this is
    //< **fixed, the same on any 64-bit machine** — there, `--update` would silently rewrite a fixed
    //< value.
    node: I64
    kids: I64

priv const WANT_NODE_BYTES: I64 = 64I64 //<
    //< The fixed sizes of the tree's two types (64-bit: `Sz` and a pointer are 8 bytes)
    //< Caution: **When it fails, do not change these numbers first.** 8 bytes more each is tens of
    //< MB over the tree, but the peak's `MEM_THRESHOLD` absorbs it. **The peak passes while the
    //< tree gains weight**.
priv const WANT_KIDS_BYTES: I64 = 32I64
priv const NODE_PATTERN: U8[] = "AST Node bytes\\s*:\\s*([\\d,]+)"
priv const KIDS_PATTERN: U8[] = "AST Kids bytes\\s*:\\s*([\\d,]+)"

priv struct Baseline //< holds cold and warm together
    //< Caution: **Do not allow a form that holds only one**; split, the missing side passes
    //< unchecked.
    cold: Metrics
    warm: Metrics

// The round trip with JSON. **A key is the field name itself**; ksplc builds the table and
// `fields()` from the declarations, nesting included ("The compiler writes the table only" in
// `../../docs/DESIGN-programming-language.md`).
impl Baseline: reflect.Reflectable {}

priv const VALUE_CEILING: I64 = 1_000_000_000_000_000I64 //< the cap on a readable value
    //< It is a petabyte, or thirty thousand years in ms; no indicator reaches it.
    //< Caution: **Never let an overflow pass silently.** An overflowed I64 becomes "a small
    //< positive number", so a regression passes as an "improvement"; the cap stops before the next
    //< digit.

priv fn digits_value(s: U8[]): I64 //< drops the grouping commas and returns an integer
    //< It returns -1 past the cap. The capture is `[\d,]+`, so the comma is the only non-digit.
    $v: I64 = 0
    for i in Range.asc(s.len)
        if !s[i].is_digit()
            continue
        v = v * 10I64 + I64::(s[i] - '0')
        if v > VALUE_CEILING
            return -1I64
    return v

priv fn max_capture(text: U8[], pattern: U8[], path: U8[], arena: Arena$@): I64!Guard_error //<
    //< The largest number the pattern captures across the whole log
    //< Caution: **Take the worst value.** One log holds stage1 and stage2; the first or the average
    //< dilutes the bad side. **Finding none is a failure too** — read as 0, an indicator that stops
    //< being printed records an "improvement".
    defer re: = regex.Regex.compile(pattern) catch
        io.err().s("[perf_guard] the pattern cannot be read: ").s(pattern).s("\n")
        throw .failed
    ms: = re.find_all(text, arena)
    if ms.len == 0
        io.err().s("[perf_guard] no metrics found in ").s(path).s("\n")
        throw .failed
    $best: I64 = 0
    for m in ms
        digits: = m.group(1, text).unwrap_or("")
        v: = digits_value(digits)
        if v < 0I64
            io.err().s("[perf_guard] the value is too large: ").s(digits).s("\n")
            throw .failed
        if v > best
            best = v
    return best

priv fn parse_headroom(text: U8[], path: U8[], arena: Arena$@): Headroom!Guard_error //<
    //< Reads the distance to the carry from the log
    //< Caution: **Take the value nearest the edge**; with several measurements, the far one reads
    //< as "there is still slack".
    defer re: = regex.Regex.compile(HEADROOM_PATTERN) catch
        io.err().s("[perf_guard] the pattern cannot be read: ").s(HEADROOM_PATTERN).s("\n")
        throw .failed
    ms: = re.find_all(text, arena)
    if ms.len == 0
        io.err().s("[perf_guard] no arena headroom found in ").s(path).s("\n")
        throw .failed
    $out: = Headroom::{ .free = VALUE_CEILING, .step = 0I64 }
    for m in ms
        free_digits: = m.group(1, text).unwrap_or("")
        free: = digits_value(free_digits)
        step: = digits_value(m.group(2, text).unwrap_or(""))
        if free < 0I64 || step < 0I64
            io.err().s("[perf_guard] the value is too large: ").s(free_digits).s("\n")
            throw .failed
        if free < out.free
            out = Headroom::{ .free = free, .step = step }
    return out

priv struct Reading //< everything read out of one log
    //< Caution: **Do not read a log twice**; read separately, one could come from an old log.
    metrics: Metrics
    head: Headroom
    shapes: Shapes

priv fn parse_log(path: U8[], arena: Arena$@): Reading!Guard_error //<
    //< Reads the indicators and the distance to the carry from one log
    text: = io.read_file(path, null) catch
        io.err().s("[perf_guard] the log cannot be read: ").s(path).s("\n")
        throw .failed
    defer dealloc(Void$@::text.ptr)
    return Reading::{ .metrics = Metrics::{ .compile_ms =
        max_capture(text, TIME_PATTERN, path, arena)!,
        .peak_bytes = max_capture(text, PEAK_PATTERN, path, arena)! },
        .head = parse_headroom(text, path, arena)!,
        .shapes = Shapes::{ .node = max_capture(text, NODE_PATTERN, path, arena)!,
        .kids = max_capture(text, KIDS_PATTERN, path, arena)! } }

priv fn baseline_path(arena: Arena$@): U8[] //< the baseline's path
    //< Caution: **Do not derive it from cwd.** It is called from outside `make` too, so it looks
    //< next to the script (`tests/`); only when the script path is unknown does it assume the root.
    script: = sys.script_path().unwrap_or("")
    if script.len == 0
        return "tests/tools/perf_baseline.json"
    return fs.join(sys.get_dir_name(script), "perf_baseline.json", arena)

priv fn write_baseline(path: U8[], cur: Baseline, arena: Arena$@): Bool //<
    //< Writes the baseline
    //< Caution: **Do not build the JSON by hand.** Write with `dump` in `std/json` (a second
    //< writer drifts in escaping and number form), two-space indent so `git diff` shows which value
    //< moved. `--update` rewrites every key; to add one key alone, write it by hand.
    $jb: = json.Json_builder(arena)
    // Keys are not listed here; the function that walks the table and its nesting builds them.
    defer $out: = Str_builder()
    doc: = json_struct.from_struct(cur@, jb@) catch
        io.err().s("[perf_guard] the baseline cannot be written as JSON\n")
        return false
    doc.dump(out@, 2)
    out.c('\n')
    io.write_file(path, out.slice()) catch
        io.err().s("[perf_guard] the baseline cannot be written: ").s(path).s("\n")
        return false
    return true

priv fn read_baseline(path: U8[], arena: Arena$@): Baseline!Guard_error //<
    //< Reads the baseline, which differs per machine
    //< The time varies with the machine and its load, and the peak memory moves when a `#cfg`
    //< branch changes.
    //<
    //< Taken on the Linux CI's devcontainer image (used as they are on macOS, they raise false
    //< alarms; "note 16" in `docs/SPEC-gates.md`). The peak memory repeats exactly for one
    //< source.
    text: = io.read_file(path, null) catch
        io.err().s("[perf_guard] the baseline cannot be read: ").s(path).s("\n")
        throw .failed
    defer dealloc(Void$@::text.ptr)
    root: = json.parse(text, arena) catch
        io.err().s("[perf_guard] the baseline does not resolve as JSON: ").s(path).s("\n")
        throw .failed
    // **A missing key or a wrong kind is refused, not filled with a default** (filled in, an old
    // baseline shows only as "the value was 0").
    // Caution: **Print the name the error carries as it is.** Folded into "something went wrong",
    // the only remedy is to measure again. With the name printed, the key to add is known.
    $out: Baseline = ::{}
    json_struct.into_struct(root.val, out@, arena) catch e
        io.err().s("[perf_guard] the baseline cannot be read: ")
        switch e
        case .missing_field(name)
            io.err().s("the key '\{name\}' is absent")
        case .field_type(name)
            // `<root>`: the content is not an object (Json_error in std/json.kspl).
            if name.equals("<root>")
                io.err().s("it is not an object")
            else
                io.err().s("the key '\{name\}' is of the wrong kind")
        default
            io.err().s("it does not resolve as JSON")
        io.err().s(". Add --update to `make perf-log`'s recipe and take the measurements again\n")
        throw .failed
    return out

priv fn ratio_text(base: I64, cur: I64, arena: Arena$@): U8[] //< the ratio against the baseline
    //< Where the baseline is 0 it cannot divide, so it returns `n/a`.
    return ("n/a" if base == 0I64
        else arena.text().s("x\{F64::cur / F64::base:.2\}").take())

priv fn report(kind: U8[], base: Metrics, cur: Reading, arena: Arena$@): Bool //<
    //< Prints one measurement and returns whether the peak memory is within its limit
    //< Caution: **Do not write `RECORDED` on the time's line.** Beside the baseline it **reads as
    //< though the baseline were rewritten** (only `--update` writes it); say it is not used for the
    //< verdict.
    ratio: = ratio_text(base.compile_ms, cur.metrics.compile_ms, arena)
    io.out().s("[perf_guard] ").s(kind).s(" compile time: \{cur.metrics.compile_ms:,\} (baseline ")
        .s("\{base.compile_ms:,\}, ").s(ratio).s(") -> NOT GATED\n")
    limit: = I64::(F64::base.peak_bytes * MEM_THRESHOLD)
    peak_ok: = cur.metrics.peak_bytes <= limit
    io.out().s("[perf_guard] ").s(kind).s(" peak memory: \{cur.metrics.peak_bytes:,\} (baseline ")
        .s("\{base.peak_bytes:,\}, limit \{limit:,\}) -> ").s("PASS" if peak_ok else "FAIL").s("\n")
    report_headroom(kind, limit, cur)
    return peak_ok

priv fn report_headroom(kind: U8[], limit: I64, cur: Reading) //<
    //< Prints the distance to the carry
    //< Caution: **Do not return a verdict.** Being near the edge is not a regression; the reader
    //< asks "if it takes the next step, does this guard still pass" against today's limit. `IT
    //< WOULD FAIL THIS GATE` means the slack is under one step — raise the baseline now, not after
    //< it fails.
    free: = cur.head.free
    next_peak: = cur.metrics.peak_bytes + cur.head.step
    share: =
        (0.0 if cur.metrics.peak_bytes == 0I64
        else 100.0 * F64::free / F64::cur.metrics.peak_bytes)
    io.out().s("[perf_guard] ").s(kind).s(" arena carry: \{free:,\} bytes (\{share:.1\}% of peak) ")
        .s("before the next chunk of \{cur.head.step:,\} bytes\n")
    io.out().s("[perf_guard] ").s(kind).s(" arena carry: peak would become \{next_peak:,\} ")
        .s("(limit \{limit:,\}) -> ")
        .s("BASELINE ABSORBS IT" if next_peak <= limit else "IT WOULD FAIL THIS GATE").s("\n")

priv fn report_shapes(cold: Shapes, warm: Shapes): Bool //<
    //< whether the types' sizes match the fixed values
    //< Caution: **Do not compare by ratio**: a size is fixed, so one byte off means a type changed.
    //< **Compare the two logs with each other** — the same executable printed them, so a difference
    //< means an old log is being read.
    fresh: = cold.node == warm.node && cold.kids == warm.kids
    node_ok: = fresh && cold.node == WANT_NODE_BYTES
    kids_ok: = fresh && cold.kids == WANT_KIDS_BYTES
    io.out().s("[perf_guard] Ast_node bytes: \{cold.node\} (want \{WANT_NODE_BYTES\}) -> ")
        .s("PASS" if node_ok else "FAIL").s("\n")
    io.out().s("[perf_guard] child list bytes: \{cold.kids\} (want \{WANT_KIDS_BYTES\}) -> ")
        .s("PASS" if kids_ok else "FAIL").s("\n")
    if !fresh
        io.out().s("[perf_guard] the types' sizes differ between cold and warm: cold ")
            .s("\{cold.node\}/\{cold.kids\} vs warm \{warm.node\}/\{warm.kids\}")
            .s(" (one of them is an old log)\n")
    return node_ok && kids_ok

fn main(): I32 //<
    //< Compares a build's cost against the baseline
    //< Usage: `make perf-log` (the proper entry point), or `ksplc run tests/tools/perf_guard.kspl
    //< --cold=<log> --warm=<log> [--update]`
    //<
    //< Caution: **Let `make perf-log` produce the logs.** It measures on an empty cache (cold) and
    //< again on the same cache (warm), **against separate baselines**. A hit in the AST disk cache
    //< (`ksplc/parse/ast_cache.kspl`) changes time and peak memory several-fold. So one
    //< baseline for both leaves one side unchecked.
    defer arena: = Arena(1024 * 1024)
    $update: = false
    $cold_log: U8[] = ""
    $warm_log: U8[] = ""
    p: = argparse.Parser
        .create("perf_guard", "compare a build's cost against the baseline", arena)
    p.str_required("--cold", cold_log@, "the log of the build on an empty cache")
    p.str_required("--warm", warm_log@, "the log of the build on the same cache again")
    p.flag("--update", update@, "rewrite the baseline with these measurements")
    p.parse_or_exit()
    cold: = parse_log(cold_log, arena) catch
        return 2
    warm: = parse_log(warm_log, arena) catch
        return 2
    cur: = Baseline::{ .cold = cold.metrics, .warm = warm.metrics }

    // Caution: **Run this check on a baseline rewrite too.** `--update` measures the values again,
    // but a type's size is fixed — let through on a rewrite, a change to a fixed value is recorded
    // nowhere.
    shapes_ok: = report_shapes(cold.shapes, warm.shapes)
    if !shapes_ok
        io.out()
            .s("RESULT: SOME FAILED (1) -> a tree type changed size (--update does not fix this; ")
            .s("if the growth is intended, change want_node_bytes / want_kids_bytes in this \
                script)\n")
        return 1

    path: = baseline_path(arena)
    // Caution: **Write only on `--update`.** Written where the file is missing, a run that lost it
    // takes its own figures as the baseline and passes, comparing nothing.
    if !update && !fs.exists(path)
        io.out().s("RESULT: SOME FAILED (1) -> there is no baseline at ").s(path)
            .s(" (take one with --update)\n")
        return 1
    if update
        if !write_baseline(path, cur, arena)
            return 2
        io.out().s("[perf_guard] baseline written: cold \{cur.cold.compile_ms:,\} ms / ")
            .s("\{cur.cold.peak_bytes:,\} peak, warm \{cur.warm.compile_ms:,\} ms / ")
            .s("\{cur.warm.peak_bytes:,\} peak\n")
        return 0
    base: = read_baseline(path, arena) catch
        return 2
    // Caution: **Always print both**; a short circuit on a cold failure leaves warm out of the log.
    cold_ok: = report("cold", base.cold, cold, arena)
    warm_ok: = report("warm", base.warm, warm, arena)
    if !cold_ok || !warm_ok
        io.out()
            .s("RESULT: SOME FAILED (1) -> memory regression (if this increase is intentional, ")
            .s("refresh the baseline by re-running this with --update)\n")
        return 1
    io.out().s("RESULT: ALL PASS\n")
    return 0

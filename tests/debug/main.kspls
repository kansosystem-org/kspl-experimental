import "tests/debug/parts"

// ==========================================
// The entry point for `make debug`. **This file only sets the order.**
// How each package is called is in [`parts.kspls`](parts.kspls). The entry points that run one
// package alone are in [`pkg/`](pkg) (`make debug-<name>`).
// ==========================================
fn main()
  arena: = parts.begin()
  defer arena.free()

  // Caution: **Put ksplc first.** Where its ABI check ("The gate checks the IR" in
  // [`../../ksplc/docs/DESIGN.md`](../../ksplc/docs/DESIGN.md)) disagrees, other tests' values
  // break silently, so it proves soundness before anything else.
  parts.ksplc(arena)
  parts.std(arena)
  parts.ksai(arena)
  parts.ksdb(arena)
  parts.kspeg(arena)
  parts.kspage(arena)
  parts.ksos(arena)
  parts.tools(arena)

  parts.done()

import "ksai/tests/all" as ksai_all
import "ksdb/tests/all" as ksdb_all
import "ksos/tests/all" as ksos_all
import "kspage/tests/all" as kspage_all
import "kspeg/tests/all" as kspeg_all
import "ksplc/tests/all" as ksplc_all
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/tests/all" as std_all
import "std/verdict"
import "tools/tests/all" as tools_all

// ==========================================
// How each package's tests are called. **This is the only place that knows how to call them**:
// [`main.kspls`](main.kspls) (`make debug`) runs all eight packages, and [`pkg/<name>.kspls`](pkg)
// (`make debug-<name>`) runs one package that has no `Makefile`.
// Caution: **Do not call `run_<name>` from the entry points**, or fixing one copy leaves the other
// in the old form. **Do not move the individual tests here**: they would need `pub` to inspect
// the inside of their unit.
// ==========================================

priv const stage1: U8[] = "out/ksplc_stage1.exe" //< the ksplc passed to tests that start one
    //<
    //< Note: `make debug` depends on $(STAGE1_EXE), so it is there by the time they run.

fn begin(): Arena$@ //< sets things up before the run starts
    //<
    //< **The caller frees the arena it returns** (`defer arena.free()`).
    // Line-buffered: in CI stdout is a fully buffered pipe, so a crash would lose the unflushed
    // output and the log's last line would not show where it crashed.
    io.set_line_buffered()

    // Caution: **Do not add a `mkdir` on the CI side instead**, or a second place knows out/'s
    // layout. **Do not stop on failure either**; the test that writes there reports it by name.
    fs.mkdir_all("out/tmp") catch {}

    return Arena.new(1024 * 1024)

fn done(): I32 //< the closing line, and the exit code
    //<
    //< **The verdict is the checks' own** (`verdict.finish`): a fixed `ALL PASS` would read green
    //< over a `FAIL` line, and the gate reads only this line ("How a run is read" in
    //< [`docs/SPEC-gates.md`](../../docs/SPEC-gates.md)).
    io.out().s("\n=========================================\n")
    return verdict.finish()

// --- One package's worth ---
fn ksplc(arena: Arena$@) //<
    //< Runs ksplc's tests
    //<
    //< Caution: **Keep the name equal to the package's folder name.** `pkg/<name>.kspls` and `make
    //< debug-<name>` use the same name (mk/test.mk's $(error) fails when they differ).
    ksplc_all.run_ksplc(arena)

fn std(arena: Arena$@)
    std_all.run_std(stage1, arena)

fn ksai(_arena: Arena$@)
    ksai_all.run_ksai()

fn ksdb(_arena: Arena$@)
    ksdb_all.run_ksdb()

fn kspeg(_arena: Arena$@)
    kspeg_all.run_kspeg()

fn kspage(_arena: Arena$@)
    kspage_all.run_kspage()

fn ksos(_arena: Arena$@)
    ksos_all.run_ksos()

fn tools(arena: Arena$@)
    tools_all.run_tools(arena)

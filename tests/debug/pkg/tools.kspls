import "tests/debug/parts"

// ==========================================
// The entry point for `make debug-tools`. **It builds and runs only the tools package's tests.**
//
// How each package is called is in [`../parts.kspls`](../parts.kspls); this file only chooses.
// ==========================================
fn main(): I32
    arena: = parts.begin()
    defer arena.free()
    parts.tools(arena)
    return parts.done()

#!/usr/bin/env -S ksplc run
//< Checks that what a document reference points at exists, in the direction the convention allows
//< A reference is an asset; the problem is **silent drift** (add one section and `§12` points
//< elsewhere with nobody noticing). So the drift is made detectable, rather than the count cut.
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strfmt" as _strfmt
import "std/sys"
import "std/verdict"
import "tests/support/docref_cite" as cite
import "tests/support/docref_make" as make_targets
import "tests/support/docref_names" as names
import "tests/support/docref_refs" as refs
import "tests/support/docref_samples" as samples
import "tests/support/docref_scan" as scan
import "tests/support/harness"
import "tests/support/harness_text" as htext

priv const MAX_SHOWN: Sz = 20 //< the cap on how many are listed in the report
    //< List all of them and CI's log becomes unreadable.

// ==========================================
// What may be referred to **Packages follow only the import direction.** `ksplc` and `ksos` use
// `std` but not the reverse, and between `ksplc` and `ksos` there is no dependency.
// `ksos` points at `ksdb` for its append-only record.
// ==========================================
priv const LAYER_FROM: U8[][_] = ::{ "docs", "root", "ksplc", "std", "ksai", "kspeg", "ksos",
    "kssrv", "ksdb", "ksbind", "ksmd", "ksagent", "tests", "tools" }

// Caution: **A leaf's row must be "everything upward".** What the table says to a leaf is "upward
// only", and it does not sort the destinations ("Reference direction between documents" in
// `docs/SPEC-documents.md`).
// `make test-conventions` matches only the implementations' directions against each other, so it
// does not catch this.
priv const LAYER_TO: U8[][_] = ::{ "docs root ksplc std ksai kspeg ksos kssrv ksdb ksbind ksmd \
    ksagent tests tools",
    "root docs ksplc std ksai kspeg ksos kssrv ksdb ksbind ksmd ksagent tests tools",
    "ksplc docs std kspeg root", "std docs root", "ksai docs std root", "kspeg docs std root",
    "ksos docs std ksai ksdb root", "kssrv docs std ksai root", "ksdb docs std root",
    "ksbind docs std root", "ksmd docs std root", "ksagent docs std root",
    "tests docs ksplc std ksai kspeg ksos kssrv ksdb ksbind ksmd ksagent tools root",
    "tools docs ksplc std ksai kspeg ksos kssrv ksdb ksbind ksmd ksagent root" }

priv const SPEC_MAY_REACH_UP: U8[][_] = ::{ "docs", "root" } //<
    //< The groups whose specifications another specification may point at

priv fn spec_may_refer(from: U8[], to: U8[]): Bool //< the additional restrictions on a SPEC
    if !sys.get_file_name(from).starts_with("SPEC-")
        return true
    base: = sys.get_file_name(to)
    if base.starts_with("DESIGN-") || base.equals("PLAN.md")
        return false
    if !base.starts_with("SPEC-") ||
        sys.get_dir_name(from).equals(sys.get_dir_name(to))
        return true
    for group in SPEC_MAY_REACH_UP
        if group_of(to).equals(group)
            return true
    return false

priv struct Spec_ref_sample
    source: U8[]
    target: U8[]
    allowed: Bool

priv fn check_spec_refs() //< both allowed references and forbidden ones exercise the same rule
    cases: = Spec_ref_sample[_]::{
        ::{ "docs/SPEC-programming-language.md", "docs/DESIGN-programming-language.md", false },
        ::{ "ksplc/docs/SPEC-tools.md", "ksplc/docs/DESIGN-compiler.md", false },
        ::{ "ksplc/docs/SPEC-tools.md", "docs/DESIGN-principles.md", false },
        ::{ "docs/SPEC-programming-language.md", "ksplc/docs/DESIGN-compiler.md", false },
        ::{ "docs/SPEC-programming-language.md", "docs/PLAN.md", false },
        ::{ "ksplc/docs/SPEC-tools.md", "docs/PLAN.md", false },
        ::{ "ksplc/docs/SPEC-tools.md", "docs/SPEC-programming-language.md", true },
        ::{ "ksplc/docs/SPEC-tools.md", "ksplc/docs/SPEC-diagnostics.md", true },
        ::{ "docs/SPEC-programming-language.md", "ksplc/docs/SPEC-tools.md", false },
        ::{ "ksos/docs/SPEC-board.md", "ksplc/docs/SPEC-tools.md", false },
        ::{ "docs/SPEC-programming-language.md", "docs/README.md", true },
        ::{ "docs/SPEC-programming-language.md", "docs/HOWTO-build.md", true },
        ::{ "docs/DESIGN-programming-language.md", "docs/SPEC-programming-language.md", true },
        ::{ "docs/DESIGN-programming-language.md", "docs/DESIGN-principles.md", true },
    }
    for sample in cases
        verdict.check("the SPEC reference rule accepts or rejects its sample",
            spec_may_refer(sample.source, sample.target) == sample.allowed, sample.target)

// ==========================================
// The directions the code crosses (`import` and `embed`)
// ==========================================

priv const REF_HEADS: U8[][_] = ::{ "import \"", "embed \"" } //<
    //< The line starts that name another file
    //< Caution: **Check both the form that imports a name and the form that embeds a file** (both
    //< cross packages). **`find_doc_paths` does not catch it**: it picks up only `.md` names, so an
    //< `embed`'s target is invisible. **Existence is not checked.**
priv const REF_NAMES: U8[][_] = ::{ "import", "embed" }

priv fn group_of(rel: U8[]): U8[]
    if at: = rel.find_char('/')
        top: = rel.sub(0, at)
        // Caution: **Do not hard-code the count.** A shorter count leaves the last rows unmatched,
        // `group_of` returns `root` (which may point anywhere), and **their references silently
        // skip the direction check**.
        for i in Range.asc(LAYER_FROM.len)
            if LAYER_FROM[i].equals(top)
                return LAYER_FROM[i]
    return "root"

priv fn unlisted_packages(arena: Arena$@): Finding //<
    //< The package folders (a `ksplc.cfg` at the top of one) with no row in layer_from
    //< **A folder with no row is read as `root`**, which may point anywhere, so a new package's
    //< references would pass every direction check in silence.
    $f: = new_finding(arena)
    for rel in harness.tracked_matching(U8[][]::{ "*/ksplc.cfg" })
        if at: = rel.find_char('/')
            if !rel.sub_from(at + 1).equals("ksplc.cfg")
                continue
            f.seen += 1
            if group_of(rel).equals("root")
                f.bad.push(rel.sub(0, at))
    return f

priv fn may_refer(from: U8[], to: U8[], arena: Arena$@): Bool //< whether from may refer to to
    for i in Range.asc(LAYER_FROM.len)
        if !LAYER_FROM[i].equals(from)
            continue
        for w in LAYER_TO[i].split(' ', arena)
            if w.equals(to)
                return true
        return false
    return false

priv fn unit_ref_defects(rel: U8[], text: U8[], out: List<|U8[]|>$@, arena: Arena$@): Sz //<
    //< Checks the directions one file crosses, returning the number of references seen
    //< Caution: **Match at a line's start**, so a line inside a raw string (`"""`) does not match.
    //< **A relative one from the same folder (`./`) is not checked** (it crosses no package).
    from: = group_of(rel)
    $seen: Sz = 0
    lines: = text.lines(arena)
    for i in Range.asc(lines.len)
        t: = lines.get(i).trim_spaces()
        for k in Range.asc(2)
            if !t.starts_with(REF_HEADS[k])
                continue
            rest: = t.sub_from(REF_HEADS[k].len)
            if end: = rest.find_char('"')
                target: = rest.sub(0, end)
                if target.starts_with(".")
                    continue
                seen += 1
                to: = group_of(target)
                if may_refer(from, to, arena)
                    continue
                out
                    .push(arena.text().s(rel).s(":\{i + 1\}: ").s(REF_NAMES[k]).s(" \"").s(target)
                    .s("\" is ").s(from).s("->").s(to).s(", a direction not in the table").take())
    return seen

priv fn doc_dirs(arena: Arena$@): U8[][] //<
    //< the names of the folders whose references are picked up
    //< Caution: **Build it from layer_from.** A copied list misses an added folder, and references
    //< naming it pass without being picked up.
    $out: = List<|U8[]|>(arena)
    for d in LAYER_FROM
        if !d.equals("root")
            out.push(d)
    return out.slice()

priv fn doc_bares(arena: Arena$@): U8[][] //<
    //< The names a document is cited by without a folder: every tracked `.md`'s file name, once
    //< Caution: **Build it from what git tracks.** A copied list misses a document added later, and
    //< its section numbers and quoted names pass without being read.
    $out: = List<|U8[]|>(arena)
    for f in harness.tracked()
        if !f.ends_with(".md")
            continue
        name: = sys.get_file_name(f)
        if !out.contains(name)
            out.push(name)
    return out.slice()

priv fn scanned_files(arena: Arena$@): List<|U8[]|> //< what is scanned
    //< Caution: **Check only what git knows**, or the count depends on whether it was built. The
    //< base layer decides which names are read (`is_scanned`).
    $out: = List<|U8[]|>(arena)
    files: = harness.tracked()
    for f in files
        if refs.is_scanned(f)
            out.push(f)
    return out

priv fn exists_at(rel: U8[], arena: Arena$@): Bool
    return fs.exists(fs.join(harness.root(), rel, arena))

priv fn is_file_at(rel: U8[], arena: Arena$@): Bool //< whether a file is there
    //< Caution: **Keep it separate from `exists_at`.** A Markdown link **can point at a folder**,
    //< but a symbol's home is a file. Folded into one, a symbol named by a folder (`ksos/net`)
    //< reads a folder and runs the arena out.
    full: = fs.join(harness.root(), rel, arena)
    return fs.exists(full) && !fs.is_dir(full)

// ==========================================
// Headings
// ==========================================

priv fn heading_anchors(rel: U8[], arena: Arena$@): List<|U8[]|>
    return scan.heading_anchors_of(harness.read_under_root(rel), arena)

priv fn heading_numbers(rel: U8[], arena: Arena$@): List<|U8[]|>
    return scan.heading_numbers_of(harness.read_under_root(rel), arena)

// ==========================================
// Resolving a name
// ==========================================

priv fn resolve_src(here: U8[], raw: U8[], arena: Arena$@): U8[] //<
    //< Resolves a named implementation/test file to a path that really exists
    //< The base layer (`src_places`) sets the locations and their order.
    places: = refs.src_places(here, raw, arena)
    $k: Sz = 0
    $p: = refs.src_place(places@, k, arena)
    for p.len > 0
        if is_file_at(p, arena)
            return p
        k += 1
        p = refs.src_place(places@, k, arena)
    return ""

priv fn src_here(rel: U8[], here: U8[], text: U8[], at: Sz, arena: Arena$@): U8[] //<
    //< Where a named file is read from: a workflow step's own folder, else the naming file's folder
    if !rel.starts_with(".github/workflows/")
        return here
    dir: = cite.step_dir(text, at, arena)
    return here if dir.len == 0 else dir

priv fn generated_dirs(arena: Arena$@): List<|U8[]|> //< the build output folders
    //< Caution: **Build it from `.gitignore`'s directory entries**, or after `.gitignore` grows,
    //< artefacts are reported as "a reference that does not exist".
    $out: = List<|U8[]|>(arena)
    files: = harness.tracked()
    for f in files
        if !f.ends_with(".gitignore")
            continue
        here: = f.sub(0, f.len - 10)
        for line in harness.read_under_root(f).lines(arena)
            t: = line.trim_spaces()
            if t.len > 1 && t.ends_with("/") && !t.starts_with("#")
                out.push(arena.text().s("\{here\}\{t\}").take())
    return out
// ==========================================
// A section number that names no document
// ==========================================

priv const BARE_EXEMPT: U8[][_] = ::{ "docs/SPEC-documents.md" } //<
    //< The documents exempt from the check for a bare section number
    //< Note: This suite itself is not exempt (write a sample number as `§N` and it is not a bare
    //< number).

// The names that identify a number's owner. Add a new standard when one is cited, or its
// references come out as "not in its own document".
// Caution: **Do not add a loose alias ("spec" and the like).** A loose word exempts paragraphs that
// name no document at all, which narrows the check.
priv const DOC_NAMES: U8[][_] = ::{ "README.md", "CONTRIBUTING.md", "DESIGN-", "PLAN.md",
    "Principle", "board material", "RFC", "POSIX", "IEEE", "ISO", "Unicode", "AAPCS", "C99", "ELF",
    "DWARF", "UEFI", "CBOR" }

priv fn names_a_doc(block: U8[]): Bool //<
    //< the `SPEC-…md` and `HOWTO-…md` forms are namings too
    for n in DOC_NAMES
        if block.find_str(n).is_some()
            return true
    if block.find_str("USB").is_some()
        return true
    for head in U8[][]::{ "SPEC", "HOWTO" }
        $i: Sz = 0
        for i + head.len <= block.len
            if !block.sub(i, head.len).equals(head)
                i += 1
                continue
            $j: = i + head.len
            for j < block.len && (htext.is_word_at(block, j) || block[j] == '-')
                j += htext.cp_len(block[j])
            if j + 3 <= block.len && block.sub(j, 3).equals(".md")
                return true
            i += 1
    return false

priv const BARE_LEADERS: U8[][_] = ::{ "section ", "sections ", "chapter ", "chapters " } //<
    //< The word that comes before a bare section number
    //< **The word comes first and the number after** (`section 1.2`). So a scan that looks only
    //< after the number picks up **none of them**, and stays green on the smaller count.

priv fn bare_leader_len(line: U8[], at: Sz): Sz //<
    //< Whether `at` starts with one of `BARE_LEADERS` (a leading capital too); its length if so
    for w in BARE_LEADERS
        if at + w.len > line.len
            continue
        seen: = line.sub(at, w.len)
        if seen.equals(w)
            return w.len
        if seen[0].to_lower() == w[0] && seen.sub_from(1).equals(w.sub_from(1))
            return w.len
    return 0

priv fn find_bare_sections(line: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Picks up the bare section numbers (`§12`, `section 1.2`) in one line
    $out: = List<|U8[]|>(arena)
    $i: Sz = 0
    for i < line.len
        lead: = bare_leader_len(line, i)
        if lead > 0
            num: = cite.read_section_number(line, i + lead, arena)
            if num.len > 0
                out.push(num)
                i += lead + num.len
                continue
        if i + 2 <= line.len && line.sub(i, 2).equals("§")
            num: = cite.read_section_number(line, i, arena)
            if num.len > 0
                out.push(num)
                i += 2 + num.len
                continue
        i += 1
    return out

// ==========================================
// The scan
// ==========================================

priv struct Finding //< where the findings are collected
    //< Every finding is counted, and the names are listed up to the cap.
    seen: Sz
    bad: List<|U8[]|>

priv fn new_finding(arena: Arena$@): Finding
    return Finding::{ .seen = 0, .bad = List<|U8[]|>(arena) }

priv fn report(name: U8[], count: Sz, f: Finding@, tail: U8[], arena: Arena$@)
    b: = arena.text()
    for i in Range.asc(f.bad.len)
        if i >= MAX_SHOWN
            break
        b.s("\n" if i > 0 else "").s(f.bad.get(i))
    if tail.len > 0 && f.bad.len > 0
        b.s("\n    ").s(tail)
    title: = arena.text().s(name)
    if count > 0
        title.s("(\{count\})")
    verdict.check(title.take(), f.bad.len == 0, b.take())

priv fn quote_needle(name: U8[], arena: Arena$@): U8[] //<
    //< Turns the name carried with a naming into the text to search for in that document
    //< Caution: **Fold both forms** (the repository uses both), or **a correct reference fails**. A
    //< check that fails wrongly gets removed, and the real stale references go unseen with it.
    $t: = name
    // For the form wrapped in a link, only what is between the `[` and the `]` is taken.
    if t.starts_with("[")
        if close: = t.find_str("](")
            if close > 1
                t = t.sub(1, close - 1)
    // It drops a trailing ellipsis.
    if t.ends_with("…")
        t = t.sub(0, t.len - 3)
    return arena.dup_str(t)

priv fn symbol_ref_defects(rel: U8[], here: U8[], text: U8[], dirs: U8[][],
    generated: List<|U8[]|>@, missing: Finding$@, stray: Finding$@, arena: Arena$@) //<
        //< Checks one file's symbol namings
        //< **A path that does not resolve is sent to the existence check (`missing`).**
        //< Caution: **Do not move this back into `main`.** With it, `main` goes over 300 lines
        //< (Principle 3).
    for s in scan.find_symbol_refs(text, dirs, arena)
        base: = scan.sym_base(s.extra)
        if base.len == 0
            continue // a name that does not look like a symbol is out of scope
        target: = resolve_src(here, s.text, arena)
        // Caution: **Do not silently skip an unresolved path.** `find_src_paths` **picks up only
        // paths starting from a folder**. So a path with a step dropped (`sema/type/env.kspl`)
        // leaves **both checks silent**. It goes to the existence check here.
        if target.len == 0
            $made: = false
            for g in generated
                if s.text.starts_with(g)
                    made = true // the build makes it. Not existing is right
            if !made
                missing.seen += 1
                missing.bad.push(arena.text().s("\{rel\}: \{s.text\}").take())
            continue
        stray.seen += 1
        body: = harness.read_under_root(target)
        member: = scan.sym_member(s.extra)
        $absent: U8[] = ""
        if !has_word(body, base)
            absent = base
        else if member.len > 0 && !has_word(body, member)
            absent = member
        if absent.len > 0
            stray.bad
                .push(arena.text().s(rel).s(": no `").s(absent).s("` in ").s(target).s("  [`")
                .s(s.text).s("`'s `").s(s.extra).s("`]").take())

priv fn has_word(body: U8[], word: U8[]): Bool //<
    //< whether word appears in body as a whole word
    $at: Sz = 0
    for at + word.len <= body.len
        if body.sub(at, word.len).equals(word) && !htext.is_word_before(body, at) &&
            !htext.is_word_at(body, at + word.len)
            return true
        at += 1
    return false

priv fn check_picks_and_names(arena: Arena$@) //<
    //< the link picks can fire; the names and targets cited stand
    misnamed_fires: = Finding::{ .seen = samples.MISNAMED_LINK_SAMPLES.len,
        .bad = samples.misnamed_link_defects(arena) }
    report("the check that a link's text names its target can fire",
        samples.MISNAMED_LINK_SAMPLES.len, misnamed_fires@,
        "the table is `MISNAMED_LINK_SAMPLES` in `support/docref_samples.kspl`", arena)
    md_link_fires: = Finding::{ .seen = samples.MD_LINK_SAMPLES.len,
        .bad = samples.md_link_defects(arena) }
    report("the pick of a document's links can fire", samples.MD_LINK_SAMPLES.len, md_link_fires@,
        "the table of what hits and what does not is `md_link_samples` in \
            `support/docref_samples.kspl`", arena)
    names.check(arena)
    make_targets.check(arena)

priv struct Doc_check //< the per-file checks' findings, one Finding per verdict
    dirs: U8[][]
    bares: U8[][]
    generated: List<|U8[]|>
    arena: Arena$@
    missing: Finding
    missing_src: Finding
    stale: Finding
    bad_anchor: Finding
    bad_link: Finding
    misnamed_link: Finding
    wrong_dir: Finding
    spec_ref: Finding
    bare_phase: Finding
    bad_numbering: Finding
    stray_sym: Finding
    bare_sec: Finding
    unit_ref: Finding
    stale_quote: Finding
    quoted_head: Finding

impl Doc_check
    fn new(arena: Arena$@): Doc_check
        return Doc_check::{ .dirs = doc_dirs(arena), .bares = doc_bares(arena),
            .generated = generated_dirs(arena), .arena = arena, .missing = new_finding(arena),
            .missing_src = new_finding(arena), .stale = new_finding(arena),
            .bad_anchor = new_finding(arena), .bad_link = new_finding(arena),
            .misnamed_link = new_finding(arena), .wrong_dir = new_finding(arena),
            .spec_ref = new_finding(arena), .bare_phase = new_finding(arena),
            .bad_numbering = new_finding(arena), .stray_sym = new_finding(arena),
            .bare_sec = new_finding(arena), .unit_ref = new_finding(arena),
            .stale_quote = new_finding(arena), .quoted_head = new_finding(arena) }

    fn is_generated(d: Self$@, path: U8[]): Bool //<
        //< whether the build makes it, so absence is right
        for g in d.generated
            if path.starts_with(g)
                return true
        return false

    fn check_file(d: Self$@, rel: U8[]) //< runs every check on one file
        arena: = d.arena
        text: = harness.read_under_root(rel)
        here: = sys.get_dir_name(rel)
        is_md: = rel.ends_with(".md")
        // The parser's brace fixtures (`.ksplb`, in `ksplc/tests/parse/`) are sources too.
        if rel.ends_with(".kspl") || rel.ends_with(".ksplb")
            d.unit_ref.seen += unit_ref_defects(rel, text, d.unit_ref.bad@, arena)
        if is_md
            d.check_links(rel, here, text)
        d.check_link_names(rel, text)
        // A heading number depends on Markdown syntax (what is read is the `#` line).
        if is_md
            scan.heading_number_defects(rel, text, d.bad_numbering.bad@, arena)
            d.check_heading_quotes(rel, text)
        // Caution: **Read symbol namings in every file, not only in Markdown.** A comment's stale
        // backticks mislead just as a document's do.
        symbol_ref_defects(rel, here, text, d.dirs, d.generated@, d.missing_src@, d.stray_sym@,
            arena)
        // **`Phase N` is used only by the root README.md**; elsewhere the same number would point
        // at different things. A document counts "stage N", and names README.md next to a Phase.
        if !rel.equals("README.md")
            d.check_bare_phase(rel, text)
        d.check_src_paths(rel, here, text)
        d.check_doc_paths(rel, here, text)
        d.check_doc_quotes(rel, here, text)
        d.check_sections(rel, here, text)
        d.check_bare_sections(rel, text, is_md)

    fn check_links(d: Self$@, rel: U8[], here: U8[], text: U8[]) //<
        //< That each link's destination exists, and a heading it names too
        //< Caution: A link to a heading is not caught by the number check. Rename the heading and
        //< the anchor alone goes stale, jumping to the document's start.
        arena: = d.arena
        for l in refs.find_links(text, arena)
            // That a link's target exists. **A Markdown link is relative to the file it is written
            // in**, unlike a bare name. `find_src_paths` and `find_doc_paths` pick up **only names
            // starting with a folder's name or `../`** (`doc_dirs`), so a path with a step dropped
            // (`port/web/...`) is checked here.
            if l.text.len > 0 && !refs.is_external(l.text)
                dest: = refs.normalize(arena.text().s("\{here\}/\{l.text\}").take(), arena)
                d.bad_link.seen += 1
                if !d.is_generated(dest) && !exists_at(dest, arena)
                    d.bad_link.bad
                        .push(arena.text().s(rel).s(": ").s(l.text).s("  (missing: ").s(dest).s(")")
                        .take())
            if l.extra.len == 0
                continue
            $target: = rel
            if l.text.len > 0
                target = refs.normalize(arena.text().s("\{here\}/\{l.text\}").take(), arena)
            if !target.ends_with(".md") || !exists_at(target, arena)
                continue // anything but `.md`, and absence, are looked at by other checks
            d.bad_anchor.seen += 1
            anchors: = heading_anchors(target, arena)
            if !anchors.contains(l.extra)
                d.bad_anchor.bad
                    .push(arena.text().s(rel).s(": there is no heading #").s(l.extra).s(" in ")
                    .s(target).take())

    fn check_link_names(d: Self$@, rel: U8[], text: U8[]) //<
        //< That a `` [`X`](Y) `` link's text names the file it points at
        //< In every file read, since a comment's link misleads as a document's does.
        arena: = d.arena
        for m in refs.find_misnamed_links(text, arena)
            $line: Sz = 1
            for k in Range.asc(m.at)
                if text[k] == '\n'
                    line += 1
            d.misnamed_link.bad
                .push(arena.text().s(rel).s(":\{line\}: [`").s(m.text).s("`](").s(m.extra).s(")")
                .take())

    fn check_heading_quotes(d: Self$@, rel: U8[], text: U8[]) //<
        //< That a heading holds no double quote outside a code span
        //< **A fence's `# ...` is a shell comment, not a heading.**
        $n: Sz = 0
        $fenced: = false
        for line in text.lines(d.arena)
            n += 1
            if line.trim_spaces().starts_with("```")
                fenced = !fenced
            else if !fenced && line.starts_with("#")
                d.quoted_head.seen += 1
                if scan.quotes_in_heading(line)
                    d.quoted_head.bad
                        .push(d.arena.text().s(rel).s(":\{n\}: ").s(line).take())

    fn check_bare_phase(d: Self$@, rel: U8[], text: U8[]) //<
        //< That a `Phase N` names README.md within two lines of it
        arena: = d.arena
        lines: = text.lines(arena)
        for i in Range.asc(lines.len)
            line: = lines.get(i)
            if at: = line.find_str("Phase")
                if cite.read_section_number(line, at + 5, arena).len == 0
                    continue
                near: = arena.text()
                lo: = 0 if i < 2 else i - 2
                hi: = lines.len if i + 3 > lines.len else i + 3
                for k in Range(lo, hi, 1)
                    near.s(lines.get(k)).s("\n")
                d.bare_phase.seen += 1
                if near.take().find_str("README.md").is_none()
                    d.bare_phase.bad
                        .push(arena.text().s(rel).s(":\{i + 1\}: ").s(line.trim_spaces()).take())

    fn check_src_paths(d: Self$@, rel: U8[], here: U8[], text: U8[]) //<
        //< That each implementation or test file named exists
        arena: = d.arena
        for p in refs.find_src_paths(text, d.dirs, arena)
            d.missing_src.seen += 1
            if !d.is_generated(p.text) &&
                resolve_src(src_here(rel, here, text, p.at, arena), p.text, arena).len == 0
                d.missing_src.bad.push(arena.text().s("\{rel\}: \{p.text\}").take())

    fn check_doc_paths(d: Self$@, rel: U8[], here: U8[], text: U8[]) //<
        //< That each document named exists, and is named in a direction the convention allows
        arena: = d.arena
        for p in refs.find_doc_paths(text, d.dirs, arena)
            target: = refs.hit_target(here, text, p, arena)
            d.missing.seen += 1
            if !exists_at(target, arena)
                d.missing.bad.push(arena.text().s("\{rel\}: \{p.text\}").take())
                continue
            g_from: = group_of(rel)
            g_to: = group_of(target)
            if !may_refer(g_from, g_to, arena)
                d.wrong_dir.bad
                    .push(arena.text().s(rel).s(" -> ").s(target).s("  (").s(g_from)
                    .s(" does not refer to ").s(g_to).s(")").take())
            if !spec_may_refer(rel, target)
                d.spec_ref.bad.push(arena.text().s("\{rel\} -> \{target\}").take())

    fn check_doc_quotes(d: Self$@, rel: U8[], here: U8[], text: U8[]) //<
        //< That a name quoted beside a document is one that document holds
        arena: = d.arena
        for q in cite.find_doc_quotes(text, d.dirs, d.bares, arena)
            target: = refs.hit_target(here, text, q, arena)
            if !exists_at(target, arena)
                // Caution: **Do not silently skip a bare name.** `find_doc_paths` picks up only a
                // name with a folder, so a bare `DESIGN-programming-language.md` from a subfolder
                // resolves to nothing and **is reported by nobody**. It is reported here;
                // check_doc_paths handles a name with a folder.
                if q.text.find_char('/').is_none()
                    d.stale_quote.seen += 1
                    d.stale_quote.bad
                        .push(arena.text().s(rel).s(": `").s(q.text).s("` points at no document (")
                        .s(target).s(")").take())
                continue
            d.stale_quote.seen += 1
            // **A document is searched for its own names; a source for the name anywhere.** A
            // check is cited by its verdict line, which a source holds as a string, not as a
            // heading.
            needle: = quote_needle(q.extra, arena)
            body: = harness.read_under_root(target)
            is_doc: = target.ends_with(".md")
            found: =
                (scan.holds_name(body, needle, arena) if is_doc
                else body.find_str(needle).is_some())
            if !found
                where: =
                    (" (not in a heading, a bold span, or at a cell's or an item's head)" if is_doc
                    else "")
                d.stale_quote.bad
                    .push(arena.text().s(rel).s(": there is no \"").s(q.extra).s("\" in ").s(target)
                    .s(where).take())

    fn check_sections(d: Self$@, rel: U8[], here: U8[], text: U8[]) //<
        //< That each section number cited beside a document is a heading there
        arena: = d.arena
        for s in cite.find_sections(text, d.dirs, d.bares, arena)
            // Caution: **A name with no folder resolves relative to the file it is written in.**
            // From the root, `docs/`'s `DESIGN-programming-language.md` names a root one that does
            // not exist, so **that section number passes unmatched**.
            target: = refs.hit_target(here, text, s, arena)
            if !exists_at(target, arena)
                // **A bare name that resolves nowhere is skipped here.** A number near a name is
                // too weak a sign (a `.md` in a source string, this scanner's own examples). **The
                // quoted-name check does report it**, since a quoted name next to a document is a
                // citation.
                continue
            // A document whose headings carry no number has no §N at all: its headings are cited
            // by name.
            nums: = heading_numbers(target, arena)
            if nums.len == 0 && !cite.is_marked(text, s, arena)
                continue // a plain number beside a document numbering nothing may be prose
            d.stale.seen += 1
            if nums.len == 0
                d.stale.bad
                    .push(arena.text().s(rel).s(": §").s(s.extra).s(" cites ").s(target)
                    .s(", whose headings carry no number: cite the heading by name").take())
            else if !nums.contains(s.extra)
                d.stale.bad
                    .push(arena.text().s(rel).s(": there is no §").s(s.extra).s(" in ").s(target)
                    .take())

    fn check_bare_sections(d: Self$@, rel: U8[], text: U8[], is_md: Bool) //<
        //< That a section number naming no document is a heading of its own document
        //< Per paragraph: a paragraph naming a document anywhere refers to that document.
        $exempt: = false
        for e in BARE_EXEMPT
            if rel.equals(e)
                exempt = true
        if !is_md && exempt
            return
        arena: = d.arena
        own: = heading_numbers(rel, arena)
        lines: = text.lines(arena)
        $start: Sz = 0
        for start < lines.len
            if lines.get(start).trim_spaces().len == 0
                start += 1
                continue
            $stop: = start
            block: = arena.text()
            for stop < lines.len && lines.get(stop).trim_spaces().len > 0
                block.s(lines.get(stop)).s(" ")
                stop += 1
            // Caution: **Search for the document name before masking.** It is written in
            // backticks (`ksplc/docs/DESIGN-compiler.md`), so dropping the code spans first loses
            // the naming.
            if !exempt && !names_a_doc(block.take())
                for k in Range(start, stop, 1)
                    d.check_bare_line(rel, lines.get(k), k, own@)
            start = stop + 1

    fn check_bare_line(d: Self$@, rel: U8[], line: U8[], k: Sz, own: List<|U8[]|>@) //<
        //< The bare section numbers of one line, against its own document's headings
        //< A number the convention quotes as a sample, in a code span, is not counted.
        arena: = d.arena
        masked: = refs.masked_code(line, arena)
        for num in find_bare_sections(masked, arena)
            d.bare_sec.seen += 1
            if !own.contains(num)
                d.bare_sec.bad
                    .push(arena.text().s(rel).s(":\{k + 1\}: ").s(num)
                    .s(" is not in its own document  ").s(line.trim_spaces()).take())

fn main(): I32
    arena: = harness.begin(512 * 1024 * 1024)
    check_spec_refs()
    files: = scanned_files(arena)
    $d: = Doc_check(arena)
    for rel in files
        d.check_file(rel)
    io.out().s("# references to documents: \{files.len\} files\n")
    report("every named .md really exists", d.missing.seen, d.missing@, "", arena)
    report("every named implementation/test file really exists", d.missing_src.seen,
        d.missing_src@, "", arena)
    head_fires: = Finding::{ .seen = samples.HEAD_SAMPLES.len,
        .bad = samples.head_defects(arena) }
    report("a cited path is taken to start at a word's edge alone", samples.HEAD_SAMPLES.len,
        head_fires@, "the table is `HEAD_SAMPLES` in `support/docref_samples.kspl`", arena)
    report("every reference with a section number points at a heading that exists", d.stale.seen,
        d.stale@, "", arena)
    sec_fires: = Finding::{ .seen = samples.SEC_SAMPLES.len,
        .bad = samples.section_defects(arena) }
    report("the verdict that picks a section-number naming up can fire", samples.SEC_SAMPLES.len,
        sec_fires@,
        "the table of writings that match and do not is `sec_samples` in \
            `support/docref_samples.kspl`", arena)
    report("every link to a heading points at a heading that exists", d.bad_anchor.seen,
        d.bad_anchor@, "", arena)
    report("a heading holds no double quote outside a code span", d.quoted_head.seen,
        d.quoted_head@, "a citation of it could not be checked; write the inner quote as '", arena)
    quoted_fires: = Finding::{ .seen = samples.QUOTED_HEAD_SAMPLES.len,
        .bad = samples.quoted_head_defects(arena) }
    report("the check on a heading's double quotes can fire", samples.QUOTED_HEAD_SAMPLES.len,
        quoted_fires@, "the table is `QUOTED_HEAD_SAMPLES` in `support/docref_samples.kspl`", arena)
    report("every link's destination really exists", d.bad_link.seen, d.bad_link@,
        "a markdown link is relative to the file it is written in", arena)
    report("a link's text names the file it points at", 0, d.misnamed_link@,
        "point the link at the file its text names, or name the file it points at", arena)
    report("the reference directions are as the convention says (no sideways or reverse flow)", 0,
        d.wrong_dir@, "", arena)
    report("import's and embed's directions are as the convention says too", d.unit_ref.seen,
        d.unit_ref@, "the source is the table in docs/SPEC-documents.md", arena)
    report("SPEC files cite no DESIGN or PLAN and no specification below or beside them", 0,
        d.spec_ref@, "keep the rules in SPEC and route design readers through README", arena)
    report("a \"Phase N\" outside README names README.md nearby", d.bare_phase.seen,
        d.bare_phase@, "", arena)
    report("numbered headings are unique and consecutive per document", 0, d.bad_numbering@, "",
        arena)
    report("every named symbol is in that file", d.stray_sym.seen, d.stray_sym@,
        "name the file the symbol lives in now; a comment's naming is read as a document's is",
        arena)
    sym_fires: = Finding::{ .seen = samples.SYM_SAMPLES.len,
        .bad = samples.symbol_defects(arena) }
    report("the verdict that picks a symbol naming up can fire", samples.SYM_SAMPLES.len,
        sym_fires@,
        "the table of writings that match and do not is `sym_samples` in \
            `support/docref_samples.kspl`", arena)
    word_fires: = Finding::{ .seen = samples.SYM_WORD_SAMPLES.len,
        .bad = samples.sym_word_defects(arena) }
    report("the words a symbol naming is looked for by breathe fire",
        samples.SYM_WORD_SAMPLES.len, word_fires@,
        "the table is `SYM_WORD_SAMPLES` in `support/docref_samples.kspl`", arena)
    report("the name accompanying a naming is one that document holds", d.stale_quote.seen,
        d.stale_quote@,
        "mend it to the name it moved to (a name reference has no number; nothing else complains)",
        arena)
    own_fires: = Finding::{ .seen = samples.OWN_SAMPLES.len,
        .bad = samples.own_defects(arena) }
    report("the verdict on whether a document holds a name can fire", samples.OWN_SAMPLES.len,
        own_fires@, "the table is `OWN_SAMPLES` in `support/docref_samples.kspl`", arena)
    step_fires: = Finding::{ .seen = samples.step_sample_count(),
        .bad = samples.step_defects(arena) }
    report("a workflow step's path is read from the folder the step runs from",
        samples.step_sample_count(), step_fires@,
        "the table is `STEP_SAMPLES` in `support/docref_samples.kspl`", arena)
    target_fires: = Finding::{ .seen = samples.target_sample_count(),
        .bad = samples.target_defects(arena) }
    report("a document reference resolves from the folder it is written in",
        samples.target_sample_count(), target_fires@,
        "the table of what resolves where is `TARGET_SAMPLES` in `support/docref_samples.kspl`",
        arena)
    quote_fires: = Finding::{ .seen = samples.QUOTE_SAMPLES.len,
        .bad = samples.quote_defects(arena) }
    report("the verdict that picks an accompanying name up can fire", samples.QUOTE_SAMPLES.len,
        quote_fires@,
        "the writings that match and do not are `QUOTE_SAMPLES` in `support/docref_samples.kspl`",
        arena)
    report("a section number that names no document points at its own document", d.bare_sec.seen,
        d.bare_sec@, "for another document's section, name the document in the same paragraph",
        arena)
    packages: = unlisted_packages(arena)
    report("every package folder has a row in the reference directions", packages.seen, packages@,
        "add it to `layer_from` and `layer_to`, as docs/SPEC-documents.md's table says", arena)
    check_picks_and_names(arena)
    return ksplc_harness.finish()

#!/usr/bin/env -S ksplc run
//< Checks that what the editor integration (`.vscode/tasks.json` / `launch.json`) points at exists
//<
//< **`tasks.json` / `launch.json` go through neither the build nor the tests.** So a missing make
//< target fails only for whoever presses it (Principle 5 in `docs/DESIGN-principles.md`). Two
//< drifts show nothing at all. A name out of step with `${fileBasenameNoExtension}.exe` makes F5
//< silently start the last executable. A release zip's build task that names another file does
//< the same. **The extension's client side is run too**, under node, against a recording fake
//< server (`../support/vscode_host.js`). What it tells the server about open documents is seen
//< nowhere else. A document it never closes makes every other file's answers stale.

import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/json"
import "std/mem" { Arena, dealloc }
import "std/str" { Str_builder }
import "std/verdict"
import "tests/support/harness"
import "tests/support/harness_text" as htext

priv const PROBE_STEM: U8[] = "probe file" //< the name used for `make debug-file`'s check
    //<
    //< Caution: **Include a space.** make's `$(notdir)` / `$(basename)` split on whitespace, so a
    //< naive recipe turns `probe file.kspl` into another name and F5 starts the last executable.
priv const PROBE_DIR: U8[] = "out/vscode_test src"

priv const PROBE_SRC: U8[] =
    "import \"std/io\"

fn main(): I32
    io.out().s(\"ok\\n\")
    return 0

"

priv fn strip_line_comments(text: U8[], arena: Arena$@): U8$[] //<
    //< VS Code's configuration allows JSON with line comments, so they are dropped before reading
    //<
    //< Caution: **Do not drop a `//` inside a string literal** (`problemMatcher`'s regex has one).
    $b: = Str_builder.new()
    defer b.free()
    for raw in text.lines(arena)
        $in_str: = false
        $cut: Sz = raw.len
        $i: Sz = 0
        for i < raw.len
            c: = raw[i]
            if in_str
                if c == '\\'
                    i += 2
                    continue
                if c == '"'
                    in_str = false
            else if c == '"'
                in_str = true
            else if c == '/' && i + 1 < raw.len && raw[i + 1] == '/'
                cut = i
                break
            i += 1
        b.s(raw.sub(0, cut)).c('\n')
    return arena.dup_str(b.slice())

priv fn is_obj(v: json.Value): Bool //< whether it is an object
    //<
    //< `get` returns `null_val` for a missing key too, so this tells "could not be read" apart.
    switch v
    case .obj_val
        return true
    default {}
    return false

priv fn load_jsonc(path: U8[], arena: Arena$@): json.Value
    text: = io.read_file(path) catch
        return .null_val
    defer dealloc(Void$@::text.ptr)
    doc: = json.parse(strip_line_comments(text, arena), arena) catch
        return .null_val
    return doc.val

priv struct Make_cmd //<
    //< The make target and the `VAR=` variable names read out of `command`'s literal text
    found: Bool
    target: U8[]
    vars: List<|U8[]|>

priv fn parse_make_cmd(cmd: U8[], arena: Arena$@): Make_cmd
    t: = cmd.trim_spaces()
    if !t.starts_with("make ")
        return Make_cmd::{ .found = false, .target = "",
            .vars = List<|U8[]|>.new(arena) }
    $vars: = List<|U8[]|>.new(arena)
    words: = t.sub_from(5).trim_spaces().split(' ', arena)
    $target: U8[] = ""
    for w in words
        if w.len == 0
            continue
        eq: = w.find_char('=').unwrap_or(0)
        if eq > 0 // an `=`, with a name before it
            vars.push(w.sub(0, eq))
        else if target.len == 0
            target = w
    return Make_cmd::{ .found = target.len > 0, .target = target, .vars = vars }

priv fn workspace_rel(text: U8[], from: Sz): U8[] //<
    //< Extracts `${workspaceFolder}/<relative path>` (ending at a space or a `"`).
    marker: = "${workspaceFolder}/"
    switch text.sub_from(from).find_str(marker)
    case .none
        return ""
    case .some(at)
        rest: = text.sub_from(from + at + marker.len)
        $end: Sz = rest.len
        for i in Range.asc(rest.len)
            c: = rest[i]
            if c == ' ' || c == '"' || c == '\t'
                end = i
                break
        return rest.sub(0, end)

priv fn labels_of(tasks: json.Value, arena: Arena$@): List<|U8[]|>
    $out: = List<|U8[]|>.new(arena)
    for t in tasks.get("tasks").arr_list(arena)
        out.push(t.get("label").as_str().unwrap_or(""))
    return out

priv fn arg_text(a: json.Value): U8[] //< one argument's text, written bare or quoted (`value`)
    return (a.as_str().unwrap_or("") if !is_obj(a)
        else a.get("value").as_str().unwrap_or(""))

priv const SUITE_LISTS: U8[][_] = ::{ "mk/test.mk", "ksplc/Makefile" } //<
    //< The files whose `SUITES` / `LINUX_SUITES` name what `make test-<name>` runs

priv fn typable(arena: Arena$@): List<|U8[]|> //<
    //< What can be typed after `make`: `make help`'s listing, and one suite's `test-<name>`
    //<
    //< **Not `make -n <target>`**: the catch-all rules (`%:`, `test-%`) answer 0 for any name.
    $out: = List<|U8[]|>.new(arena)
    help: = harness.make(U8[][]::{ "LOGGING=1", "--no-print-directory", "help" })
    for line in help.out.lines(arena)
        if !line.starts_with("  make ")
            continue
        rest: = line.sub_from(7)
        name: = rest.sub(0, rest.find_char(' ').unwrap_or(rest.len))
        if !name.ends_with("*")
            out.push(name)
    for rel in SUITE_LISTS
        text: = harness.read_under_root(rel)
        for head in U8[][]::{ "SUITES := ", "LINUX_SUITES := " }
            for s in htext.make_list(text, head, arena)
                out.push(arena.text().s("test-").s(s).take())
    return out

priv fn check_make_targets(tasks: json.Value, arena: Arena$@) //<
    //< Checks that each `make <target>` in `tasks.json` names a target that really exists
    $names: = typable(arena)
    for t in tasks.get("tasks").arr_list(arena)
        label: = t.get("label").as_str().unwrap_or("")
        cmd: = parse_make_cmd(t.get("command").as_str().unwrap_or(""), arena)
        if !cmd.found
            continue
        name: = arena.text().s("tasks.json[\{label\}]: 'make \{cmd.target\}' really exists").take()
        verdict.check(name, htext.has(names@, cmd.target),
            "neither `make help` lists it nor is it a suite's `test-<name>`")

priv fn check_launch(launch: json.Value, labels: List<|U8[]|>$@, root: U8[], arena: Arena$@) //<
    //< `launch.json`'s preLaunchTask and initCommands
    for c in launch.get("configurations").arr_list(arena)
        name: = c.get("name").as_str().unwrap_or("")
        pre: = c.get("preLaunchTask").as_str().unwrap_or("")
        if pre.len > 0
            title: = arena.text()
                .s("launch.json[\{name\}]: preLaunchTask '\{pre\}' is in tasks.json").take()
            verdict.check(title, htext.has(labels, pre), "")
        for cmd in c.get("initCommands").arr_list(arena)
            rel: = workspace_rel(cmd.as_str().unwrap_or(""), 0)
            if rel.len == 0
                continue
            title: = arena.text().s("launch.json[\{name\}]: '\{rel\}' really exists").take()
            verdict.check(title, fs.exists(fs.join(root, rel, arena)), "")

priv const ABSENT_FMT: U8[] = "C_FMT=kanso-absent-clang-format -i" //<
    //< A formatter no machine has, standing in for a machine without clang-format

priv fn check_debug_file(root: U8[], fmt: U8[], arena: Arena$@) //<
    //< That `make debug-file` makes `out/<name>.exe` and that it works, given `fmt` (or none)
    //<
    //< **Clang-Format is optional** ("Requirements" in `docs/HOWTO-build.md`): without it, F5 still
    //< builds, and one line says the C is left as generated.
    $name: U8[] =
        "debug-file: the output name matches ${fileBasenameNoExtension}.exe (with a space)"
    if fmt.len > 0
        name = "debug-file: without clang-format it builds, and says the C is untidied"
    src_dir: = fs.join(root, PROBE_DIR, arena)
    fs.mkdir_all(src_dir) catch
        verdict.check(name, false, "the material's place cannot be made")
        return
    rel: = arena.text().s("\{PROBE_DIR\}/\{PROBE_STEM\}.kspl").take()
    src: = fs.join(root, rel, arena)
    exe: = arena.text().s("\{root\}/out/\{PROBE_STEM\}.exe").take()
    gen: = arena.text().s("\{root\}/out/\{PROBE_STEM\}.c").take()
    io.write_file(src, PROBE_SRC) catch
        verdict.check(name, false, "cannot write the material")
        return
    fs.remove_path(exe) catch { // Not being there is fine.
    }
    defer
        fs.remove_path(src) catch {}
        fs.remove_path(src_dir) catch {}
        fs.remove_path(exe) catch {}
        fs.remove_path(gen) catch {}

    src_arg: = arena.text().s("SRC_KSPL=\{rel\}").take()
    $args: = List<|U8[]|>.new(arena)
    args.push("LOGGING=1")
    args.push("debug-file")
    args.push(src_arg)
    if fmt.len > 0
        args.push(fmt)
    r: = harness.make(args.slice())
    if !r.exited_with(0)
        verdict.check(name, false, r.out.trim_end())
        return
    if fmt.len > 0 && !r.out.find_str("is left as generated").is_some()
        verdict.check(name, false, "no line says the C is left untidied")
        return
    if !fs.exists(exe)
        why: = arena.text().s("the '\{exe\}' launch.json starts is not there").take()
        verdict.check(name, false, why)
        return
    out: = ksplc_harness.run(U8[][]::{ exe })
    why: = arena.text().s("the run's result differs from what was supposed: \{out.out\}").take()
    verdict.check(name, out.out.equals("ok\n"), why)

priv fn check_release_assets(root: U8[], arena: Arena$@) //<
    //< The simplified version shipped in the release zip
    //<
    //< The unpacked layout differs from this repository's (`.github/workflows/release.yml`), so
    //< only the labels agreeing and the executable built are checked.
    tasks: =
        load_jsonc(fs.join(root, "tools/release-assets/vscode/tasks.json", arena), arena)
    launch: =
        load_jsonc(fs.join(root, "tools/release-assets/vscode/launch.json", arena), arena)
    $labels: = labels_of(tasks, arena)
    for t in tasks.get("tasks").arr_list(arena)
        label: = t.get("label").as_str().unwrap_or("")
        for dep in t.get("dependsOn").arr_list(arena)
            d: = dep.as_str().unwrap_or("")
            title: = ksplc_harness.arena().text()
                .s("release-assets tasks.json[\{label\}]: dependsOn '\{d\}' is there").take()
            verdict.check(title, htext.has(labels@, d), "")
    for c in launch.get("configurations").arr_list(arena)
        pre: = c.get("preLaunchTask").as_str().unwrap_or("")
        if pre.len == 0
            continue
        cfg_name: = c.get("name").as_str().unwrap_or("")
        title: = ksplc_harness.arena().text()
            .s("release-assets launch.json[\{cfg_name\}]: preLaunchTask '\{pre\}' is there").take()
        verdict.check(title, htext.has(labels@, pre), "")
    check_build_task(tasks, launch, arena)

priv const BUILD_LABEL: U8[] = "kanso-build-current-file" //< the task F5 builds with

priv fn side_of(v: json.Value, key: U8[]): json.Value //<
    //< a platform's branch (`windows`), or v itself
    //<
    //< Empty is the default; a key with no branch of its own falls back to the default, as VS Code
    //< reads it.
    if key.len == 0 || !is_obj(v.get(key))
        return v
    return v.get(key)

priv fn check_build_task(tasks: json.Value, launch: json.Value, arena: Arena$@) //<
    //< The build task is `ksplc build`, writing what launch.json starts, on each platform
    //<
    //< **The link words are ksplc's**, so none is written in the task to drift. What can drift is
    //< the executable's name. A name out of step makes F5 start the last one built.
    $build: = json.Value.null_val
    $found: = false
    for t in tasks.get("tasks").arr_list(arena)
        if t.get("label").as_str().unwrap_or("").equals(BUILD_LABEL)
            build = t
            found = true
    if !verdict.check("release-assets tasks.json: the build task is there", found, "")
        return
    $program: = json.Value.null_val
    for c in launch.get("configurations").arr_list(arena)
        if c.get("preLaunchTask").as_str().unwrap_or("").equals(BUILD_LABEL)
            program = c
    for key in U8[][]::{ "", "windows" }
        side: = side_of(build, key)
        args: = side.get("args").arr_list(arena)
        cmd: = side.get("command").as_str().unwrap_or("")
        where: = "default" if key.len == 0 else key
        runs: =
            (cmd.ends_with("/ksplc") || cmd.ends_with("/ksplc.exe")) && args.len > 0 &&
            arg_text(args.get(0)).equals("build")
        verdict.check(arena.text().s("release-assets tasks.json[\{where\}]: it runs ksplc build")
            .take(), runs, cmd)
        if args.len == 0
            continue
        built: = arg_text(args.get(args.len - 1))
        started: = side_of(program, key).get("program").as_str().unwrap_or("")
        verdict.check(arena.text()
            .s("release-assets [\{where\}]: it builds what launch.json starts").take(),
            built.equals(started),
            arena.text().s("builds \{built\}, starts \{started\}").take())

// ==========================================
// The editor extension (`.vscode/extensions/kspl/`) opens `.kspl` as one language, whose colouring
// rules stand in one file.
// ==========================================

priv const EXT_DIR: U8[] = ".vscode/extensions/kspl"

priv fn check_extension(root: U8[], arena: Arena$@) //<
    //< Checks that the files the extension points at exist, and how `.kspl` is opened
    dir: = fs.join(root, EXT_DIR, arena)
    pkg: = load_jsonc(fs.join(dir, "package.json", arena), arena)
    if !verdict.check("extension: package.json can be read", is_obj(pkg), "")
        return
    $missing: = List<|U8[]|>.new(arena)
    langs: = pkg.get("contributes").get("languages").arr_list(arena)
    $opens_source: = false
    for one in langs
        if one.get("id").as_str().unwrap_or("").equals("kspl")
            $exts: = one.get("extensions").arr_list(arena)
            for e in exts.slice()
                if e.as_str().unwrap_or("").equals(".kspl")
                    opens_source = true
        note_missing(missing@, dir, one.get("configuration").as_str().unwrap_or(""), arena)
    for one in pkg.get("contributes").get("grammars").arr_list(arena)
        note_missing(missing@, dir, one.get("path").as_str().unwrap_or(""), arena)
    verdict.check_list("extension: the files package.json points at really exist", langs.len,
        "files", missing@, "package.json names a file that is not there: add it, or mend the path")
    // Caution: **Keep the id `kspl`.** `extension.js` sends only that languageId to the language
    // server; a `.kspl` file opened under another would get no squiggles.
    verdict.check("extension: a .kspl file opens as the language kspl",
        langs.len == 1 && opens_source,
        "package.json must define one language, kspl, taking the extension .kspl")

    // **The colouring rules stand in one file**, the one grammar the language names.
    grammars: = pkg.get("contributes").get("grammars").arr_list(arena)
    verdict.check("extension: the .kspl colouring is the one grammar, source.kspl",
        grammars.len == 1 &&
        grammars.get(0).get("scopeName").as_str().unwrap_or("").equals("source.kspl") &&
        grammars.get(0).get("language").as_str().unwrap_or("").equals("kspl"),
        "package.json must name one grammar, source.kspl, for the language kspl")

// ==========================================
// The extension's client side, run under node
// ==========================================

priv const HOST_JS: U8[] = "tests/support/vscode_host.js"

priv struct Sent //< one message the fake server read
    method: U8[]
    version: I32 //< -1 where the message carries none
    text: U8[]

priv fn sent_by_client(root: U8[], arena: Arena$@): json.Value //<
    //< What `vscode_host.js` printed: the messages, and how often the panel came forward
    out: = ksplc_harness
        .run(U8[][]::{ "node", fs.join(root, HOST_JS, arena),
        fs.join(fs.join(root, EXT_DIR, arena), "extension.js", arena) })
    if !out.exited_with(0)
        verdict.check("extension client: the session runs under node", false, out.out)
        return .null_val
    doc: = json.parse(arena.dup_str(out.out), arena) catch
        verdict.check("extension client: the session's record can be read", false, out.out)
        return .null_val
    return doc.val

priv fn check_client(root: U8[], arena: Arena$@) //<
    //< The lifecycle the extension tells the server, as the protocol orders it
    if !ksplc_harness.run(U8[][]::{ "node", "--version" }).exited_with(0)
        verdict.skip_check("extension client: the lifecycle it sends", "node is not installed")
        return
    got: = sent_by_client(root, arena)
    $msgs: = List<|Sent|>.new(arena)
    for m in got.get("sent").arr_list(arena)
        msgs
            .push(Sent::{ .method = m.get("method").as_str().unwrap_or(""),
            .version = m.get("version").as_int().unwrap_or(-1),
            .text = m.get("text").as_str().unwrap_or("") })
    said: = arena.text().s("sent:").s(listed(msgs@, arena)).take()
    verdict.check("extension client: `initialized` follows initialize before anything else",
        msgs.len > 1 && msgs.get(0).method.equals("initialize") &&
        msgs.get(1).method.equals("initialized"), said)
    $closed_at: Sz = -1
    $versions: = true
    $discarded: = false
    $reopened: = false
    for i in Range.asc(msgs.len)
        m: = msgs.get(i)
        if m.method.equals("textDocument/didOpen") ||
            m.method.equals("textDocument/didChange")
            versions = versions && m.version >= 0
        discarded = discarded || m.text.equals("unsaved")
        if m.method.equals("textDocument/didClose")
            closed_at = i
        if closed_at >= 0 && i > closed_at && m.method.equals("textDocument/didOpen")
            reopened = m.text.equals("from disk")
    verdict.check("extension client: each didOpen and didChange carries the document's version",
        versions, said)
    verdict.check("extension client: closing a document tells the server", closed_at >= 0, said)
    verdict.check("extension client: a change pending when its document closes is never sent",
        !discarded, said)
    verdict.check("extension client: a document opened again is announced again after its close",
        reopened, said)
    told: = got.get("refusal").as_str().unwrap_or("")
    verdict.check("extension client: a rename the server refuses reaches the editor with its reason",
        told.equals("refused by the fake server"),
        arena.text().s("told '\{told\}'").take())
    times: = got.get("shown").as_int().unwrap_or(-1)
    verdict.check("extension client: a start with the default settings keeps the output panel back",
        times == 0, arena.text().s("brought forward \{times\} times").take())

priv fn listed(msgs: List<|Sent|>@, arena: Arena$@): U8[] //< the messages, one word each
    b: = arena.text()
    for i in Range.asc(msgs.len)
        m: = msgs.get(i)
        b.s(" ").s(m.method.strip_prefix("textDocument/"))
        if m.text.len > 0
            b.s("(").s(m.text).s(")")
    return b.take()

priv fn note_missing(missing: List<|U8[]|>$@, dir: U8[], rel: U8[], arena: Arena$@)
    if rel.len == 0
        return
    path: = fs.join(dir, rel.strip_prefix("./"), arena)
    if !fs.exists(path)
        missing.push(arena.text().s(rel).take())

fn main(): I32
    arena: = harness.begin(32 * 1024 * 1024)
    root: = harness.root()
    vscode: = fs.join(root, ".vscode", arena)
    tasks: = load_jsonc(fs.join(vscode, "tasks.json", arena), arena)
    launch: = load_jsonc(fs.join(vscode, "launch.json", arena), arena)
    if !is_obj(tasks) || !is_obj(launch)
        return ksplc_harness.fatal(".vscode's tasks.json / launch.json cannot be read")

    check_make_targets(tasks, arena)
    $labels: = labels_of(tasks, arena)
    check_launch(launch, labels@, root, arena)
    check_debug_file(root, "", arena)
    check_debug_file(root, ABSENT_FMT, arena)
    check_release_assets(root, arena)
    check_extension(root, arena)
    check_client(root, arena)
    return ksplc_harness.finish()

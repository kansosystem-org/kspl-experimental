#!/usr/bin/env -S ksplc run
//< Checks what the make steps say about the machine they run on, where it lacks something
//<
//< **CI's machines hold every tool, so these answers are seen nowhere else**: a step that needs a
//< tool must say so, one that does not must go on without it, and `make install` must say which
//< `ksplc` the PATH really starts. Each case stands the missing piece in on purpose: a formatter
//< name nothing answers to, a PATH with another `ksplc` first, a switch set to what is lacking.
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/fs"
import "std/io"
import "std/mem" { Arena, dealloc }
import "std/str" // `arena.text()`
import "std/sys"
import "std/verdict"
import "tests/support/harness"

priv const absent_fmt: U8[] = "C_FMT=kanso-absent-clang-format -i" //<
    //< A formatter no machine has, standing in for a machine without clang-format

priv fn read_held(path: U8[], arena: Arena$@): U8[] //<
    //< a file's text on the arena, empty if unread
    text: = io.read_file(path) catch
        return ""
    held: = arena.dup_str(text)
    dealloc(Void$@::text.ptr)
    return held

priv fn check_seed_needs_fmt(arena: Arena$@) //<
    //< `make commit-seed` without clang-format stops, says it needs it, and leaves the seed alone
    //<
    //< The seed in git is tidied, so one written untidied would change every line of it.
    name: = "commit-seed: without clang-format it stops, says why, and leaves the seed as it was"
    seed: = fs.join(harness.root(), "ksplc/seed.c", arena)
    before: = read_held(seed, arena)
    r: = harness.make(U8[][]::{ "LOGGING=1", "commit-seed", absent_fmt })
    after: = read_held(seed, arena)
    if r.code == 0 || !r.out.find_str("needs clang-format").is_some()
        why: = arena.text().s("exit \{r.code\}, and no line says it needs clang-format\n")
            .s(r.out).take()
        verdict.check(name, false, why)
        return
    verdict.check(name, before.len > 0 && before.equals(after), "the seed changed")

priv fn fake_ksplc(dir: U8[], file: U8[], arena: Arena$@): Bool //< an executable `ksplc` stand-in
    fs.mkdir_all(dir) catch
        return false
    path: = fs.join(dir, file, arena)
    io.write_file(path, "#!/bin/sh\nexit 0\n") catch
        return false
    return ksplc_harness.run(U8[][]::{ "chmod", "+x", path }).code == 0

priv fn install_check(prefix: U8[], first: U8[], second: U8[], arena: Arena$@): verdict.Run_out //<
    //< `make install-check` under a PATH whose first two folders are given, the rest as it was
    sep: = ";" if sys.is_windows() else ":"
    was: = arena.dup_str(sys.get_env("PATH").unwrap_or(""))
    sys.set_env("PATH",
        arena.text().s(first).s(sep).s(second).s(sep).s(was).take())
        catch panic("PATH cannot be set")
    r: = harness
        .make(U8[][]::{ "LOGGING=1", "--no-print-directory", "install-check",
        arena.text().s("PREFIX=").s(prefix).take() })
    sys.set_env("PATH", was) catch panic("PATH cannot be put back")
    return r

priv fn check_install_names_first(arena: Arena$@) //<
    //< `make install-check` names another `ksplc` found first on PATH, and passes the one installed
    //<
    //< **An older `ksplc` earlier on PATH also answers to `ksplc`**, so finding one proves nothing:
    //< the step must compare files.
    name_other: =
        "install-check: an older ksplc first on PATH is named, with the line that fixes it"
    name_ok: = "install-check: the ksplc installed, first on PATH, gets the success line"
    dir: = harness.sandbox("install_check")
    prefix: = fs.join(dir, "prefix", arena)
    bin: = fs.join(prefix, "bin", arena)
    old: = fs.join(dir, "old", arena)
    installed: = "ksplc.exe" if sys.is_windows() else "ksplc"
    if !fake_ksplc(bin, installed, arena) || !fake_ksplc(old, "ksplc", arena)
        verdict.check(name_other, false, "the stand-ins cannot be made")
        return
    other: = install_check(prefix, old, bin, arena)
    verdict.check(name_other,
        other.code == 0 && other.out.find_str("another one").is_some() &&
        other.out.find_str("old").is_some() && !other.out.find_str("✅").is_some(), other.out)
    ok: = install_check(prefix, bin, old, arena)
    verdict.check(name_ok,
        ok.code == 0 && ok.out.find_str("✅").is_some() &&
        !ok.out.find_str("another one").is_some(), ok.out)

priv fn check_switch_values(arena: Arena$@) //<
    //< A switch that requires a tool reads 0 or 1 alone: another value stops make, naming it
    //<
    //< Read as "not 1", `yes` would turn the requirement off with nothing said.
    name: = "a switch requiring a tool refuses a value other than 0 or 1"
    r: = harness.make(U8[][]::{ "LOGGING=1", "KANSO_REQUIRE_CHOWN=yes", "help" })
    verdict.check(name,
        r.code != 0 && r.out.find_str("KANSO_REQUIRE_CHOWN=yes: only 0 or 1").is_some(),
        arena.text().s("exit \{r.code\}\n").s(r.out).take())

priv const switch_probe: U8[] = //<
    //< A suite of one check that lacks its tool, through the harness every suite uses
    "import \"ksplc/tests/support/harness\" as ksplc_harness
import \"std/sys\"

fn main(): I32
    args: = sys.args()
    _arena: = ksplc_harness.begin_at(65536, \"\", \"\", args.get(1), args.get(1))
    ksplc_harness.require_or_skip(\"the probe's check\", \"KANSO_REQUIRE_PROBE\", \"no probe tool\")
    return ksplc_harness.finish()
"

priv fn check_switch_message(arena: Arena$@) //<
    //< Where a switch requires a missing tool, the failure names the way to run without it
    //<
    //< CI's image holds every tool, so this failure is never seen there: a probe makes it.
    name_on: = "a switch at 1 fails a check lacking its tool, and says how to turn it off"
    name_off: = "a switch at 0 lets the same check skip"
    dir: = harness.sandbox("switch_probe")
    probe: = fs.join(dir, "probe.kspls", arena)
    io.write_file(probe, switch_probe) catch
        verdict.check(name_on, false, "the probe cannot be written")
        return
    sys.set_env("KANSO_REQUIRE_PROBE", "1") catch panic("the switch cannot be set")
    on: = ksplc_harness.ksplc(U8[][]::{ "run", probe, dir })
    sys.set_env("KANSO_REQUIRE_PROBE", "0") catch panic("the switch cannot be set")
    off: = ksplc_harness.ksplc(U8[][]::{ "run", probe, dir })
    sys.unset_env("KANSO_REQUIRE_PROBE") catch panic("the switch cannot be unset")
    verdict.check(name_on,
        on.code != 0 && on.out.find_str("FAIL").is_some() &&
        on.out.find_str("KANSO_REQUIRE_PROBE=0 makes this a SKIP").is_some(), on.out)
    verdict.check(name_off,
        off.code == 0 && off.out.find_str("SKIP").is_some() &&
        !off.out.find_str("FAIL").is_some(), off.out)

fn main(): I32
    arena: = harness.begin(16 * 1024 * 1024)
    check_seed_needs_fmt(arena)
    check_install_names_first(arena)
    check_switch_values(arena)
    check_switch_message(arena)
    return ksplc_harness.finish()

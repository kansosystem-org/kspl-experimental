#!/usr/bin/env -S ksplc run
//< Checks that the generated C is warning-free under a C compiler's `-Wall` and strict ISO C99
//< Nobody reads the generated C, so warnings pile up unnoticed. Held at zero, the check fails the
//< moment one is added. `-pedantic` holds it to ISO C99, so a compiler that folds no GNU extension
//< takes it too.
//< Caution: **Do not bring existing C files into the scope.** Only the C that ksplc writes is
//< checked, under `-fsyntax-only` (no linking).
//< **Both families are mandatory where `KANSO_REQUIRE_BOTH_CC=1`** (`mk/test.mk` sets it on Linux,
//< whose image holds gcc and clang). Elsewhere a missing one gives a `SKIP` line, never a silent
//< pass.
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/seq"
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/harness"

priv const CANDIDATES: U8[][_] = ::{ "clang", "gcc", "cc" } //<
    //< The compilers the generated C is put through
    //< Caution: **Do not check with one alone.** Each warns about code the other is silent on
    //< (gcc: an arithmetic or comparison operand of a bit operation); one installed alone decides.

priv const FAMILIES: U8[][_] = ::{ "clang", "gcc" } //< the families both of which must be found

// **Do not leave `-Wextra` and `-O2` out.** Without them -Wsign-compare and
// -Wstrict-aliasing (inactive without optimisation) are invisible, and both catch wrong answers.
// `-Wmissing-field-initializers` is left out: genc's `{0}` / `{{0}}` is correct, the rest zeroed.
// `-Wstrict-prototypes` is in neither: a `f()` declares no prototype, so a call goes unchecked.
// `-pedantic` holds it to ISO C99, `-Woverlength-strings` aside ("The generated C is ISO C99, not
// GNU C" in ksplc/docs/DESIGN-backends.md).
priv const CFLAGS: U8[][_] = ::{ "-std=c99", "-pedantic", "-Wall", "-Wextra",
    "-Wno-missing-field-initializers", "-Wno-overlength-strings", "-Wstrict-prototypes", "-O2",
    "-fsyntax-only" }

priv struct Target //< the inputs that produce the generated C
    //< Caution: **Compile freestanding with `-ffreestanding`.** Without it the compiler treats
    //< libc's functions as built-ins and reports what the real build does not (a redeclaration of
    //< malloc/memcpy).
    slot: U8[]
    src: U8[]
    ksplc_flags: U8[][]
    cc_flags: U8[][]

priv const FREESTANDING_KSPLC: U8[][_] = ::{ "--freestanding" } //<
    //< The ksplc options for the freestanding target
    //< Caution: **Keep the list of options in a const.** A `U8[][]::{ ... }` built in a function
    //< and put in a struct points at the stack frame. That frame is gone after the return, with no
    //< diagnostic ("Which pointers into a frame are stopped from leaving it" in
    //< `docs/DESIGN-programming-language.md`). It breaks far away, as a garbled argv length.
priv const FREESTANDING_CC: U8[][_] = ::{ "-ffreestanding" }

priv fn targets(arena: Arena$@): List<|Target|> //<
    //< The sources whose generated C is checked, each with its own flags
    //< Caution: **Do not remove any of these rows**; each alone shows one class of warning.
    //< `ksbind` holds the bindings `make debug` leaves out, `freestanding` genc's own extern
    //< declarations, `equiv` the code both backends accept.
    // An empty row is a descriptor (a length-0 array cannot be written) pointing at nothing.
    none: = U8[][]::{ .ptr = null, .len = 0 }
    $out: = List<|Target|>(arena)
    out
        .push(Target::{ .slot = "ksplc", .src = "ksplc/main.kspl", .ksplc_flags = none,
        .cc_flags = none })
    out
        .push(Target::{ .slot = "tests_debug", .src = "tests/debug/main.kspl", .ksplc_flags = none,
        .cc_flags = none })
    out
        .push(Target::{ .slot = "freestanding",
        .src = "ksos/demo/cortex_m/cortex_m_ai_train_probe.kspl",
        .ksplc_flags = U8[][]::FREESTANDING_KSPLC, .cc_flags = U8[][]::FREESTANDING_CC })
    out
        .push(Target::{ .slot = "ksbind", .src = "ksbind/tests/main.kspl", .ksplc_flags = none,
        .cc_flags = none })
    out
        .push(Target::{ .slot = "equiv", .src = "ksplc/tests/prog/equiv.kspl", .ksplc_flags = none,
        .cc_flags = none })
    return out

priv struct Cc //< one usable C compiler
    name: U8[] //< what it is started by
    family: U8[] //< one of `FAMILIES`
    id: U8[] //< its identity: target, version and family

priv fn identify(name: U8[], arena: Arena$@): Cc? //< that compiler, where it starts
    //< The same compiler gives the same identity. **Not by the name it reports** (`--version`'s
    //< first line): gcc prints the name it was called by, and macOS's `gcc` is clang.
    triple: = ksplc_harness.run(U8[][]::{ name, "-dumpmachine" })
    if !triple.exited_with(0)
        return .none
    version: = ksplc_harness.run(U8[][]::{ name, "-dumpversion" })
    banner: = ksplc_harness.run(U8[][]::{ name, "--version" })
    family: = "clang" if banner.out.find_str("clang").is_some() else "gcc"
    id: = arena.text().s("\{triple.out.trim_spaces()\}|\{version.out.trim_spaces()\}|\{family\}")
        .take()
    return .some(Cc::{ .name = name, .family = family, .id = id })

priv fn compilers(arena: Arena$@): List<|Cc|> //<
    //< Returns the usable compilers, keeping one of each identity
    //< Caution: **Drop the duplicates.** `cc` is usually a symlink to clang/gcc, and running it
    //< twice only doubles the failing lines. Whether it starts is tested by starting it (PATH is
    //< not read).
    $found: = List<|Cc|>(arena)
    for name in CANDIDATES
        switch identify(name, arena)
        case .none
            continue
        case .some(cc)
            if !found.any(fn(f: Cc@; cc: Cc): Bool {
                return f.id.equals(cc.id);
            })
                found.push(cc)
    return found

priv fn check_families(ccs: List<|Cc|>@, arena: Arena$@) //<
    //< Says which family no compiler found belongs to: a failure where both are required
    //< The `SKIP` reason is the one `tools/ci_gates.kspl` expects on a platform holding one alone.
    for fam in FAMILIES
        if ccs.any(fn(c: Cc@; fam: U8[]): Bool {
            return c.family.equals(fam);
        })
            continue
        name: = arena.text().s("the generated C under \{fam\}").take()
        why: = arena.text().s("only one of the two C compilers is installed (no \{fam\} starts)")
            .take()
        ksplc_harness.require_or_skip(name, "KANSO_REQUIRE_BOTH_CC", why)

priv fn warning_lines(out: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Collects only the warning lines
    lines: = out.lines(arena)
    return lines.where(fn(ln: U8[]@; ): Bool {
        return ln.find_str(": warning:").is_some();
    }).to_list(arena)

priv fn builtin_slice(gen: U8[]): U8[] //<
    //< The first name of the built-in slice type in the generated C (`kspl_I32_Slice`), or empty
    //< **A slice is `std/lang`'s `Slice<|$T|>`** (`std_lang_Slice_I32`). Only the runtime's own
    //< byte slice keeps a built-in name (`U8_Slice`). **One built-in constructor added back to the
    //< type table brings the second form back**, and nothing else fails. So the check looks for the
    //< name here, in C that every gate generates.
    $i: Sz = 0
    for i < gen.len
        switch gen.sub_from(i).find_str("_Slice")
        case .none
            return ""
        case .some(at)
            end: = i + at + 6
            i = end
            if end < gen.len && (gen[end].is_alnum() || gen[end] == '_')
                continue
            $from: Sz = end - 6
            for from > 0 && (gen[from - 1].is_alnum() || gen[from - 1] == '_')
                from -= 1
            name: = gen.sub(from, end - from)
            if !name.ends_with("U8_Slice")
                return name
    return ""

fn main(): I32
    arena: = harness.begin(64 * 1024 * 1024)
    ccs: = compilers(arena)
    if ccs.len == 0
        return ksplc_harness.fatal("no C compiler that can put the generated C through is found")
    check_families(ccs@, arena)
    dir: = harness.sandbox("c_warnings")
    verdict.check("the search for a built-in slice type can fire",
        builtin_slice("a kspl_I32_Slice b").equals("kspl_I32_Slice") &&
        builtin_slice("kspl_U8_Slice std_lang_Slice_I32 Const_U8_Slice").len == 0, "")
    io.out().s("# warnings in the generated C\n")
    for t in targets(arena)
        gen: = fs.join(dir, arena.text().s("\{t.slot\}.c").take(), arena)
        $args: = List<|U8[]|>(arena)
        for f in t.ksplc_flags
            args.push(f)
        args.push(t.src)
        args.push(gen)
        r: = ksplc_harness.ksplc(args.slice())
        if !r.exited_with(0)
            verdict.check(arena.text().s("\{t.slot\}: it can be generated").take(), false, r.out)
            continue
        stray: = builtin_slice(io.read_file(gen, null) catch "")
        verdict.check(arena.text().s("\{t.slot\}: no built-in slice type but the bytes'").take(),
            stray.len == 0, stray)
        for cc in ccs
            name: = arena.text().s("\{t.slot\}: \{cc.name\} is warning-free").take()
            // No `-I` is needed: ksplc embeds the runtime headers that the generated C `#include`s.
            $argv: = List<|U8[]|>(arena)
            argv.push(cc.name)
            for f in CFLAGS
                argv.push(f)
            for f in t.cc_flags
                argv.push(f)
            argv.push(gen)
            out: = ksplc_harness.run(argv.slice())
            warns: = warning_lines(out.out, arena)
            verdict.check(name, out.exited_with(0) && warns.len == 0,
                arena.text().s("\{warns.len\} found\n").s(out.out).take())
    return ksplc_harness.finish()

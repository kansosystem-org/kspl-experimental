#!/usr/bin/env -S ksplc run
//< The compiler stands alone and runs the first share of its suites from a copy
//<
//< Successive pairs go in opposite directions between here and `extract_ksplc_rest_test.kspls`.
//< Each copy rebuilds the compiler and checks that removing its package declaration breaks it.
import "tests/support/extract"

fn main(): I32
    return extract.run("ksplc", "", .core)

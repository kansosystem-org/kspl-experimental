#!/usr/bin/env -S ksplc run
//< Checks the documented conventions a machine can check
//< The conventions are "Development Principles" in `docs/DESIGN-principles.md` and the rules in
//< `docs/SPEC-documents.md`; `tests/suite/docref_test.kspl` checks reference directions and
//< section numbers.
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars" // judging a character's case
import "std/ds" { List }
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/strfmt" as _strfmt
import "std/strnum"
import "std/verdict"
import "tests/support/conventions_arena" as carena
import "tests/support/conventions_bound" as cbound
import "tests/support/conventions_doc" as cdoc
import "tests/support/conventions_iface" as ciface
import "tests/support/conventions_line" as cline
import "tests/support/conventions_match" as cmatch
import "tests/support/conventions_merge" as cmerge
import "tests/support/conventions_notice" as cnotice
import "tests/support/conventions_plain" as cplain
import "tests/support/conventions_scan" as scan + { Sample }
import "tests/support/conventions_size" as csize
import "tests/support/conventions_skip" as cskip
import "tests/support/conventions_spell" as cspell
import "tests/support/conventions_theme" as ctheme
import "tests/support/conventions_win" as cwin
import "tests/support/harness"
import "tests/support/harness_text" as htext

// ==========================================
// The language has `T[]::arr` ("Type conversion (`::`) and implicit casts" in
// `docs/SPEC-programming-language.md`).
// Only a hand-built descriptor over a whole array at its declared length is reported (the form
// stays for reinterpreting bytes).
priv const DESCRIPTOR_EXEMPT: U8[][_] = ::{ "ksplc/tests/negative/deep_const_weakening.kspl",
    "ksplc/tests/negative/pointer.kspl", "ksplc/tests/abi_win64_test.kspl",
    "ksplc/tests/prog/equiv.kspl" }

priv fn array_sizes(src: U8[], names: List<|U8[]|>$@, sizes: List<|Sz|>$@, arena: Arena$@) //<
    //< From a `name: type[count]` declaration, collects the size per name
    //< A name declared at two sizes is not judged (which one it points at is unknown).
    for raw in src.lines(arena)
        // Caution: **Check with the strings and the annotations dropped** (so as not to pick up a
        // declaration inside a table of samples).
        line: = scan.strip_code(raw, arena)
        $i: Sz = 0
        for i < line.len
            if line[i] != ':' || i == 0
                i += 1
                continue
            $s: = i
            for s > 0 && htext.is_word_at(line, s - 1)
                s -= 1
            name: = line.sub(s, i - s)
            i += 1
            if name.len == 0 || !(name[0].is_lower() || name[0] == '_')
                continue
            // The `[count]` inside the type on the same line.
            switch line.sub_from(i).find_char('[')
            case .none
                continue
            case .some(open)
                p: = i + open + 1
                $k: = p
                for k < line.len && line[k].is_digit()
                    k += 1
                if k == p || k >= line.len || line[k] != ']'
                    continue
                size: = Sz::(line.sub(p, k - p).to_i64() catch 0I64)
                $seen: Sz = 0
                for j in Range.asc(names.len)
                    if names.get(j).equals(name)
                        seen = j + 1
                if seen == 0
                    names.push(name)
                    sizes.push(size)
                else if sizes.get(seen - 1) != size
                    sizes.set(seen - 1, 0) // a name whose sizes do not agree is not judged

priv fn hand_descriptor(raw: U8[], names: List<|U8[]|>@, sizes: List<|Sz|>@, arena: Arena$@): Bool //<
    //< Whether a line's `[]::{ .ptr = <name>@, .len = <count> }` carries the declared length
    // Caution: **Check with the strings and the annotations dropped** (so as not to hit a string
    // inside a table of samples).
    line: = scan.strip_code(raw, arena)
    $i: Sz = 0
    for i + 5 <= line.len
        switch line.sub_from(i).find_str("[]::{")
        case .none
            return false
        case .some(at)
            p: = i + at
            i = p + 5
            rest: = line.sub_from(i).trim_start()
            if !rest.starts_with(".ptr")
                continue
            switch rest.find_char('=')
            case .none
                continue
            case .some(eq)
                $tail: = rest.sub_from(eq + 1).trim_start()
                $k: Sz = 0
                for k < tail.len && htext.is_word_at(tail, k)
                    k += 1
                name: = tail.sub(0, k)
                tail = tail.sub_from(k).strip_prefix("[0]")
                if !tail.starts_with("@")
                    continue
                switch tail.find_str(".len")
                case .none
                    continue
                case .some(len_at)
                    num: = tail.sub_from(len_at + 4).trim_start().strip_prefix("=").trim_start()
                    $d: Sz = 0
                    for d < num.len && num[d].is_digit()
                        d += 1
                    if d == 0
                        continue
                    want: = Sz::(num.sub(0, d).to_i64() catch 0I64)
                    for j in Range.asc(names.len)
                        if names.get(j).equals(name) && sizes.get(j) == want && want > 0
                            return true
    return false

// Caution: **Declare the same name twice at different sizes** (`mixed`). Nothing else exercises
// the branch that leaves such a name unjudged.
priv const DESCRIPTOR_SRC: U8[] =
    """fn probe()
  four: I32[4] = ::{ 0, 0, 0, 0 }
  two: I32[2] = ::{ 0, 0 }
  mixed: I32[4] = ::{ 0, 0, 0, 0 }


fn again()
  mixed: I32[8] = ::{ 0, 0, 0, 0, 0, 0, 0, 0 }

"""

// **Report only the declared length** (a shorter view is correct, and has no fix).
// `.len = 40` catches a read stopping at one digit.
priv const DESCRIPTOR_SAMPLES: U8[][_] = ::{ "  s: = I32[]::{ .ptr = four@, .len = 4 };",
    "  s: = I32[]::{ .ptr = four@, .len = 2 };", "  s: = I32[]::{ .ptr = four[0]@, .len = 4 };",
    "  s: = I32[]::{ .ptr = other@, .len = 4 };", "  s: = I32[]::{ .ptr = mixed@, .len = 4 };",
    "  s: = I32[]::{ .ptr = four@, .len = 40 };",
    "  a: = I32[]::{ .ptr = two@, .len = 1 }; b: = I32[]::{ .ptr = four@, .len = 4 };",
    "  a: = I32[]::{ 1, 2 }; b: = I32[]::{ .ptr = four@, .len = 4 };" }
priv const DESCRIPTOR_WANT: Bool[_] = ::{ true, false, true, false, false, false, true, true } //<
    //< The expected answer for each line of the descriptor samples
    //< In order: it hits / a shorter view / a form with a `[0]` in between / a name with no
    //< declaration / a name whose sizes do not agree / a form with the digits misread / two on one
    //< line where the second hits / a non-descriptor before it. The last two catch a read that
    //< stops at the first

priv fn check_descriptor_fires(arena: Arena$@)
    $names: = List<|U8[]|>(arena)
    $sizes: = List<|Sz|>(arena)
    array_sizes(DESCRIPTOR_SRC, names@, sizes@, arena)
    $bad: = List<|U8[]|>(arena)
    for i in Range.asc(DESCRIPTOR_SAMPLES.len)
        got: = hand_descriptor(DESCRIPTOR_SAMPLES[i], names@, sizes@, arena)
        if got != DESCRIPTOR_WANT[i]
            bad
                .push(arena.text().s("\"").s(DESCRIPTOR_SAMPLES[i].trim_spaces())
                .s("\" was read as \{got\}").take())
    verdict.check_list("the verdict on a hand-assembled descriptor can fire",
        DESCRIPTOR_SAMPLES.len, "samples", bad@,
        "the judgment misreads its own samples: mend the judgment, not the table")

priv fn check_descriptors(arena: Arena$@)
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::scan.KSPL_SPECS)
        seen += 1
        $skip: = false
        for e in DESCRIPTOR_EXEMPT
            if rel.equals(e)
                skip = true
        if skip
            continue
        src: = harness.read_under_root(rel)
        $names: = List<|U8[]|>(arena)
        $sizes: = List<|Sz|>(arena)
        array_sizes(src, names@, sizes@, arena)
        $i: Sz = 0
        for line in src.lines(arena)
            i += 1
            if hand_descriptor(line, names@, sizes@, arena)
                bad
                    .push(arena.text().s(rel).s(":\{i\}: ").s(line.trim_spaces()).take())
    verdict.check_list("no descriptor is hand-assembled for a slice over a whole fixed array", seen,
        "lines", bad@, "bring it to `T[]::arr` (the length enters from the type)")

// ==========================================
// 7. A folder taking keys from outside does not use `Map` (std/docs/DESIGN-core.md) `ds.Map` is open
// addressing plus linear probing, and has no way to pass a seed to `Hashable`'s `hash`.
// Note: If it fails, do not stop using `Map` — design the seed in the form
// `std/docs/DESIGN-core.md` decides.
// ==========================================
priv const UNTRUSTED_KEY_DIRS: U8[][_] = ::{ "kssrv/", "ksdb/", "ksmd/", "ksagent/" }

priv fn check_map_at_boundary(arena: Arena$@)
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::scan.KSPL_SPECS)
        $inside: = false
        for d in UNTRUSTED_KEY_DIRS
            if rel.starts_with(d)
                inside = true
        if !inside
            continue
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            seen += 1
            i += 1
            if at: = line.find_str("Map<|")
                if at == 0 || !htext.is_word_before(line, at)
                    bad
                        .push(arena.text().s(rel).s(":\{i\}: ").s(line.trim_spaces()).take())
    verdict.check_list("a folder taking keys from outside does not use Map \
        (kssrv/ksdb/ksmd/ksagent)", seen, "lines", bad@,
        "design the seed before putting it in (the Map line under std/docs/DESIGN-core.md's 'Known \
            holes')")

// ==========================================
// 10. The strings by which the compiler names std really exist ksplc finds std's declarations by
// **a fully-qualified-name string** such as `"std.lang.Move_only"`. Only "is that name in that
// file" is checked. What each is used for is in "Why compiler-known traits are confined to
// `std/lang`" in `docs/DESIGN-programming-language.md` (a copy would drift).
// ==========================================
priv fn check_compiler_named_std(arena: Arena$@)
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    // Only the compiler: its tests quote editor text (`std.lang.Manual_free.free`) naming no
    // declaration.
    for rel in harness.tracked_matching(U8[][]::{ "ksplc/*.kspl", ":!ksplc/tests/" })
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            seen += 1
            i += 1
            // Caution: **Do not read the comments.** A line explaining "write it this way and it
            // breaks" mentions an imaginary FQN (`"std.io.U8[]"` in `sema/decl/resolve.kspl`).
            code: = line.sub(0, line.find_str("//").unwrap_or(line.len))
            for fqn in std_fqns_in(code, arena)
                // `std.lang.Add` -> file `lang`, declaration `Add`.
                rest: = fqn.sub_from(4)
                switch rest.find_char('.')
                case .none
                    continue
                case .some(cut)
                    // A source's extension (`SOURCE_EXT` in `../../ksplc/base/core.kspl`).
                    file: = arena.text().s("std/").s(rest.sub(0, cut)).s(".kspl").take()
                    name: = rest.sub_from(cut + 1)
                    // Raw storage is a private compiler primitive; API names remain public.
                    private_storage: = fqn.equals("std.mem.Raw_value")
                    if !declares_name(harness.read_under_root(file), name, arena, private_storage)
                        bad
                            .push(arena.text().s(rel).s(":\{i\}: ").s(fqn).s(" is not in ").s(file)
                            .take())
    verdict.check_list("the letters by which the compiler names std really exist", seen, "lines",
        bad@, "rename and mend ksplc's letters too; why each is known is the note above this check")

priv fn std_fqns_in(line: U8[], arena: Arena$@): List<|U8[]|>$@ //<
    //< Picks up the `std.<lower>.<Upper-first>` strings in one line
    //< A generic (`std.lang.Add<|...|>`) is cut before the `<`.
    found: = arena.create(List<|U8[]|>(arena))
    $at: Sz = 0
    for at < line.len
        switch line.sub_from(at).find_str("\"std.")
        case .none
            break
        case .some(hit)
            start: = at + hit + 1
            $end: Sz = start
            for end < line.len &&
                (line[end].is_alpha() || line[end].is_digit() || line[end] == '_' ||
                line[end] == '.')
                end += 1
            word: = line.sub(start, end - start)
            // Only strings complete down to the name (not a prefix such as `"std.lang."`).
            if word.count_str(".") >= 2 && !word.ends_with(".")
                found.push(arena.dup_str(word))
            at = end
    return found

priv fn declares_name(src: U8[], name: U8[], arena: Arena$@, allow_private: Bool = false): Bool //<
    //< Whether that file declares `name`
    //< Caution: Check only the declaring lines (count the using lines and it answers "it is there"
    //< even when the name is gone).
    for line in src.lines(arena)
        trimmed: = line.trim_spaces()
        t: = trimmed.strip_prefix("priv ") if allow_private else trimmed
        for kw in U8[][]::{ "pub trait ", "pub struct ", "pub enum ", "pub typedef ", "pub fn ",
                "trait ", "struct ", "enum ", "typedef ", "fn ",
        }
            if !t.starts_with(kw)
                continue
            rest: = t.sub_from(kw.len)
            if !rest.starts_with(name)
                continue
            tail: = rest.sub_from(name.len)
            if tail.len == 0 ||
                !tail[0].is_alpha() && !tail[0].is_digit() && tail[0] != '_'
                return true
    return false

priv fn check_runtime_check_location(arena: Arena$@) //<
    //< That the position passed to a run-time check is the pair of a file name and a line number
    //< Caution: **Do not print `loc.offset` as the line number.** `Loc` holds a byte position;
    //< the one function that counts lines is `line_of` in `ksplc/sema/session/ctx.kspl`. **List
    //< the allowed forms**: searching for the printing code misses an offset stored in a variable
    //< first. An offset is correct only when passed to a diagnostic (`print_diagnostic` counts the
    //< lines).
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for rel in harness
        .tracked_matching(U8[][]::{ "ksplc/gen/c/*.kspl", "ksplc/gen/llvm/*.kspl" })
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            seen += 1
            i += 1
            if line.find_str("loc.offset").is_some() &&
                line.find_str("print_diagnostic").is_none()
                bad
                    .push(arena.text().s(rel)
                    .s(":\{i\}: it puts loc.offset where the line number goes").take())
    verdict.check_list("what is handed to a run-time check is the file and line number pair", seen,
        "lines", bad@, "loc.offset is not a line number (put it through sema's line_of)")

priv fn panic_off(line: U8[], _arena: Arena$@): Bool //<
    //< Whether the run-time stop message's prefix breaks the rule
    //< Caution: **Keep the verdict in this one place** (inside the runtime the sample table cannot
    //< reach it). Breaking it means a capital prefix, or a capital after `panic: `.
    if line.find_str("Panic: ").is_some()
        return true
    if at: = line.find_str("panic: ")
        return at + 7 < line.len && line[at + 7].is_upper()
    return false

priv fn check_panic_spelling(arena: Arena$@) //<
    //< Keeps the run-time stop message to one form
    //< The prefix is `panic: ` and what follows starts lower case (see
    //< "Every stop has one notation" in `../../docs/SPEC-programming-language.md`). **Split between
    //< the code generator and std, one event gets two strings to grep for.**
    //< `ksplc/tests/runtime/`'s EXPECT sees only checks that have a test, so a new check is caught
    //< here.
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for rel in harness
        .tracked_matching(U8[][]::{ "ksplc/gen/runtime/*", "ksplc/gen/llvm/*.kspl",
        "std/lang.kspl" })
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            seen += 1
            i += 1
            if panic_off(line, arena)
                bad
                    .push(arena.text().s(rel).s(":\{i\}: ").s(line.trim_spaces()).take())
    verdict.check_list("the letter when it stops at run time is one", seen, "lines", bad@,
        "the prefix is 'panic: ' and what follows is lower case (§13 of \
            docs/SPEC-programming-language.md)")

priv const RESULT_FORMS: U8[][] = U8[][]::{ "ALL PASS", "SOME FAILED", "SKIPPED" } //<
    //< The wordings a gate's closing verdict line may take
    //< **A wording per gate makes CI grep for each**, and a wrong one drifts silently: **it passes
    //< green even when a gate fails** (Principle 5). The source is `finish` in `std/verdict.kspl`.

priv fn result_form_ok(rest: U8[], _arena: Arena$@): Bool
    for i in Range.asc(RESULT_FORMS.len)
        if rest.starts_with(RESULT_FORMS[i])
            return true
    return false

priv fn result_line_off(line: U8[], arena: Arena$@): Bool //< a verdict marker with an unknown form
    if at: = line.find_str("RESULT: ")
        if at > 0 &&
            (line[at - 1].is_alnum() || line[at - 1] == '_' || (at >= 8 && line[at - 1] == '-'))
            return false
        prefix: = line.sub(0, at).trim_spaces()
        if prefix.equals("const") || prefix.ends_with(" const")
            return false
        return !result_form_ok(line.sub_from(at + 8), arena)
    return false

priv const RESULT_LINE_SAMPLES: Sample[_] = ::{ Sample::{ .text = "const ADC_RESULT: U32 = 0",
    .hits = false }, Sample::{ .text = "priv const RESULT: U32 = 0", .hits = false },
    Sample::{ .text = "io.out().s(\"RESULT: ALL PASS\\n\")", .hits = false },
    Sample::{ .text = "io.out().s(\"RESULT: success\\n\")", .hits = true },
    Sample::{ .text = "RESULT: bad", .hits = true },
    Sample::{ .text = "BROWSER-RESULT: 0 failures", .hits = false } }

// The samples showing that the verdict can fire (the pattern is "A check shows it can fire" in
// `../support/conventions_scan.kspl`).
// Caution: **Include all three forms, and the parenthesised one too.** Drop one and that form
// failing as "an unknown string" goes unnoticed.
priv const RESULT_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "ALL PASS", .hits = true },
    Sample::{ .text = "ALL PASS (12 files already formatted)", .hits = true },
    Sample::{ .text = "SOME FAILED (3)", .hits = true },
    Sample::{ .text = "SKIPPED (no ARM toolchain)", .hits = true },
    Sample::{ .text = "PASS", .hits = false },
    Sample::{ .text = "FAIL (echoed bytes did not switch)", .hits = false },
    Sample::{ .text = "ALL TESTS PASSED", .hits = false },
    Sample::{ .text = "3 FAILURES", .hits = false },
}

// **Both ways of breaking it are sampled** (the prefix's capital and the next word's); one alone
// lets the other pass. A miscounted `at + 7` hits `panic: ok`.
priv const PANIC_SAMPLES: Sample[_] = ::{
    Sample::{ .text = "io.err().s(\"Panic: out of memory\\n\");", .hits = true },
    Sample::{ .text = "io.err().s(\"panic: Out of memory\\n\");", .hits = true },
    Sample::{ .text = "io.err().s(\"panic: out of memory\\n\");", .hits = false },
    // Caution: **Keep the non-ASCII sample.** `is_upper()` is byte-wise, so a UTF-8 lead byte must
    // not be read as a capital.
    Sample::{ .text = "io.err().s(\"panic: 範囲の外\\n\");", .hits = false },
    Sample::{ .text = "// the panic: prefix is lower case", .hits = false },
    Sample::{ .text = "kspl_panic(msg);", .hits = false }
}

// **Pick up only an FQN inside a string**: after a double quote, two or more steps, no final dot.
priv const FQN_SAMPLES: U8[][_] = ::{ "want: = \"std.lang.Add\";", "want: = \"std.lang.\";",
    "want: = \"std.lang\";", "out: = std.io.out();",
    "two: = \"std.ds.List\" ; \"std.str.Str_builder\";", "// about std.lang.Add" }
priv const FQN_WANT: Sz[_] = ::{ 1, 0, 0, 0, 2, 0 } //<
    //< How many FQNs each of the samples holds
    //< In order: 1 / 0 (ends in a dot) / 0 (too few steps) / 0 (outside a string) / 2 / 0 (outside
    //< a string)

// **The name must match exactly** (by prefix `Add` hits `Adder`, and a rename slips past). **A
// `priv` does not hit**: ksplc names only what is public, so a hidden one would mask a lost `pub`.
priv const DECLARES_SRC: U8[] =
    """pub struct Adder


fn take(): I32
  return 0


priv fn hidden(): I32
  return 0


pub trait Add

"""
priv const DECLARES_NAMES: U8[][_] = ::{ "Add", "Adder", "take", "hidden", "Missing", "Adde" } //<
    //< The names looked up in `declares_src`
    //< **`Adde` does not hit**; without checking the name's end it hits the start of `Adder`, and
    //< **a name removed by a rename is answered as "there"**. `Adder` and `Add` check both hit.
priv const DECLARES_WANT: Bool[_] = ::{ true, true, true, false, false, false }

priv fn check_named_std_fires(arena: Arena$@)
    scan.check_samples("the verdict on the letter when it stops can fire",
        Sample[]::PANIC_SAMPLES, "panic_samples", panic_off, arena)

    $b: = List<|U8[]|>(arena)
    for i in Range.asc(FQN_SAMPLES.len)
        got: = std_fqns_in(FQN_SAMPLES[i], arena).len
        if got != FQN_WANT[i]
            b
                .push(arena.text().s("\"").s(FQN_SAMPLES[i])
                .s("\" gave \{got\} (should be \{FQN_WANT[i]\})").take())
    verdict.check_list("the place picking a std FQN out of a letter can fire", FQN_SAMPLES.len,
        "samples", b@, "the judgment misreads its own samples: mend the judgment, not the table")

    $c: = List<|U8[]|>(arena)
    for i in Range.asc(DECLARES_NAMES.len)
        got: = declares_name(DECLARES_SRC, DECLARES_NAMES[i], arena)
        if got != DECLARES_WANT[i]
            c
                .push(arena.text().s("\"").s(DECLARES_NAMES[i]).s("\" was read as \{got\}").take())
    verdict.check("private storage can be checked without exposing an API name",
        declares_name(DECLARES_SRC, "hidden", arena, true), "the private declaration was missed")
    verdict.check_list("the place hunting a declaration's name can fire", DECLARES_NAMES.len,
        "samples", c@, "the judgment misreads its own samples: mend the judgment, not the table")

// Whether the line opens a `"""` string, read from outside one (the walks that skip a string's
// lines rely on it).
priv fn opens_raw(text: U8[], arena: Arena$@): Bool
    _: = arena
    return scan.flip_raw(text, false)

// Caution: **Keep both sides in**, or a judgment answering always true (or always false) passes.
priv const RAW_SAMPLES: Sample[_] = ::{ Sample::{ .text = "  w = w.s(\"\"\"", .hits = true },
    Sample::{ .text = "priv const Q: U8[] = \"\"\"", .hits = true },
    Sample::{ .text = "// a raw string is fenced by `\"\"\"`", .hits = false },
    Sample::{ .text = "  // Note: the `\"\"\"` fence closes it", .hits = false },
    Sample::{ .text = "  let x = 1;", .hits = false },
    Sample::{ .text = "  w = w.s(\"\"\"one line\"\"\");", .hits = false } }

priv fn check_raw_fires(arena: Arena$@)
    scan.check_samples("the reading of where a `\"\"\"` text opens can fire",
        Sample[]::RAW_SAMPLES, "raw_samples", opens_raw, arena)

priv fn check_result_fires(arena: Arena$@)
    scan.check_samples("the verdict on the verdict line's letter can fire",
        Sample[]::RESULT_SAMPLES, "result_samples", result_form_ok, arena)
    scan.check_samples("a result marker is distinguished from a constant's name",
        Sample[]::RESULT_LINE_SAMPLES, "result_line_samples", result_line_off, arena)

priv fn check_result_line(arena: Arena$@)
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::scan.BUILD_EXT)
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            seen += 1
            i += 1
            // The files defining the forms and their examples carry incomplete markers.
            if rel.equals("tests/suite/conventions_test.kspl") ||
                rel.equals("std/verdict.kspl") || rel.equals("docs/SPEC-gates.md")
                continue
            if result_line_off(line, arena)
                bad
                    .push(arena.text().s(rel).s(":\{i\}: \{line.trim_spaces()\}").take())
    hint: = arena.text().s("after 'RESULT: ' comes ALL PASS / SOME FAILED / SKIPPED ")
        .s("(\"How a run is read\" in docs/SPEC-gates.md)").take()
    verdict.check_list("the letter of a gate's verdict line is one", seen, "lines", bad@, hint)

// That a single test's line is not written by hand (hand-written lines always diverge): none of
// `-> Passed!`, `-> Skipped` or the three-line `"\n[..."` comes back.
// Caution: **Having added a package, add it here too.**
priv const CASE_LINE_GLOBS: U8[][_] = ::{ "ksai/tests/*.kspl", "ksbind/tests/*.kspl",
    "ksdb/tests/*.kspl", "ksmd/tests/*.kspl", "kspeg/tests/*.kspl", "ksos/tests/*.kspl",
    "ksplc/tests/*.kspl", "kssrv/tests/*.kspl", "std/tests/*.kspl", "tools/ai_assist/tests/*.kspl",
    "tools/tests/*.kspl" }

priv fn check_case_line(arena: Arena$@)
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::CASE_LINE_GLOBS)
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            seen += 1
            i += 1
            if line.find_str("-> Passed!").is_some() ||
                line.find_str("-> Skipped").is_some() ||
                line.find_str("io.out().s(\"\\n[").is_some()
                bad
                    .push(arena.text().s(rel).s(":\{i\}: \{line.trim_spaces()\}").take())
    verdict.check_list("a package's tests do not write a single test's line by hand", seen, "lines",
        bad@, "go through verdict.start / verdict.pass / verdict.skip (see std/verdict.kspl)")

// That the slice's type name is not written directly.
// Caution: **Writing it directly rots silently**: a second copy drifts from core's with no sign.
// Only the source itself is left out (this check is in `tests/`, out of scope).
priv fn check_slice_name(arena: Arena$@)
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::{ "ksplc/*.kspl" })
        if rel.equals("ksplc/base/core.kspl")
            continue
        $i: Sz = 0
        for line in harness.read_under_root(rel).lines(arena)
            seen += 1
            i += 1
            if line.find_str("\"Slice\"").is_some() ||
                line.find_str("\"std.lang.Slice\"").is_some()
                bad
                    .push(arena.text().s(rel).s(":\{i\}: \{line.trim_spaces()\}").take())
    verdict.check_list("the slice's type name is not written directly", seen, "lines", bad@,
        "go through core.slice_fqn / core.slice_ident()")

priv const PLURAL_NAMES: U8[][_] = ::{ "test", "tool", "doc", "app", "board", "driver" } //<
    //< The singular names a folder holding many of a kind must not take
    //< ("A folder's name is plural where it names its contents" in `docs/SPEC-documents.md`.) A
    //< name that is not such a noun (`parse`, `sema`, `model`) names an aspect of its package, and
    //< stays.

priv fn names_a_kind(part: U8[]): Bool //< whether a folder's name is one of plural_names
    for one in U8[][]::PLURAL_NAMES
        if part.equals(one)
            return true
    return false

priv fn check_folder_names(arena: Arena$@) //<
    //< A folder holding many of a kind is named in the plural
    //< Caution: **It reads the folders git knows, not the disk**; `out/` holds names nobody wrote.
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    $said: = List<|U8[]|>(arena)
    files: = harness.tracked()
    for rel in files
        $at: Sz = 0
        for at < rel.len
            switch rel.sub_from(at).find_char('/')
            case .none
                break
            case .some(cut)
                part: = rel.sub(at, cut)
                at += cut + 1
                seen += 1
                where: = rel.sub(0, at - 1)
                if !names_a_kind(part) || said.contains(where)
                    continue
                said.push(arena.dup_str(where))
                bad
                    .push(arena.text().s(where).s(": name it `").s(part).s("s`").take())
    verdict.check_list("a folder holding many of a kind is named in the plural", seen,
        "folder names", bad@, "rename it, and mend what named it (`make test-docref` counts those)")

// ==========================================
// A file of tests is imported **A file nobody imports is never compiled**, so no suite runs its
// `test_…` functions, and the compiler never sees them to report it. [W0214] covers a file that is
// compiled. A file holding its own suite runs its own tests (`ksai/tests/examples_main.kspl`). The
// fixtures broken on purpose (`negative/`, `lint/`) are compiled one by one.
// ==========================================
priv const FIXTURE_FOLDERS: U8[][2] = ::{ "ksplc/tests/negative/", "ksplc/tests/lint/" } //<
    //< the folders whose files are compiled alone, never imported

priv fn check_test_files_imported(arena: Arena$@)
    files: = harness.tracked_matching(U8[][]::scan.KSPL_SPECS)
    $imported: = List<|U8[]|>(arena) // every path an import line names
    $marked: = List<|U8[]|>(arena) // every file holding a `test_…` function
    $own: = List<|U8[]|>(arena) // every file holding a suite, which runs its own tests
    for rel in files
        for line in harness.read_under_root(rel).lines(arena)
            if line.starts_with("impl ") && line.ends_with(": suite.Suite {}") ||
                line.ends_with(": suite.Suite")
                own.push(rel)
            if line.starts_with("import \"")
                rest: = line.sub_from(8)
                if close: = rest.find_char('"')
                    imported.push(rest.sub(0, close))
            else if (line.starts_with("fn test_") || line.starts_with("pub fn test_") ||
                line.starts_with("priv fn test_")) && !marked.contains(rel)
                marked.push(rel)
    $bad: = List<|U8[]|>(arena)
    for rel in marked
        $fixture: = false
        for folder in FIXTURE_FOLDERS
            fixture = fixture || rel.starts_with(folder)
        if !fixture && !own.contains(rel) &&
            !imported.contains(rel.strip_suffix(".kspl"))
            bad.push(rel)
    verdict.check_list("a file of tests is imported, so a suite can run them", marked.len,
        "files of tests", bad@, "import it from the file that holds its package's suite (all.kspl)")

fn main(): I32
    arena: = harness.begin(1024 * 1024 * 1024)
    cspell.run(arena)
    check_runtime_check_location(arena)
    check_panic_spelling(arena)
    check_named_std_fires(arena)
    check_raw_fires(arena)
    check_result_fires(arena)
    check_result_line(arena)
    check_case_line(arena)
    check_slice_name(arena)
    check_compiler_named_std(arena)
    csize.run(arena)
    ctheme.run(arena)
    check_folder_names(arena)
    check_test_files_imported(arena)
    cnotice.run_notices(arena)
    cline.run(arena)
    cdoc.run_rule(arena)
    cdoc.run_kind(arena)
    cmatch.run(arena)
    cbound.run(arena)
    ciface.run(arena)
    carena.run(arena)
    check_descriptors(arena)
    check_descriptor_fires(arena)
    cdoc.run_prose(arena)
    cplain.run(arena)
    check_map_at_boundary(arena)
    cmerge.run(arena)
    cwin.run(arena)
    cskip.run(arena)
    cnotice.run_zip(arena)
    return ksplc_harness.finish()

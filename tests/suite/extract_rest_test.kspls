#!/usr/bin/env -S ksplc run
//< Every package with its own `Makefile`, except the compiler, builds and tests from a copy alone
//<
//< **This makes moving a package out a mechanical step.** The package and the packages its
//< `[package]` uses are copied into an empty folder **with a different name**. Its own `make test`
//< (and `self-host`, `test-fuzz`) runs there with only the compiler and `std`, so a reach outside
//< the folder fails here, not on the day the package moves.
//< **`std` is found by its location, not by a name**, so its copy names nothing (see
//< "import syntax and path resolution" in `docs/SPEC-language.md`).
//< The compiler's copy is `extract_ksplc_test.kspls`, so CI runs the two side by side.
import "tests/support/extract"

fn main(): I32
  return extract.run("", "ksplc")

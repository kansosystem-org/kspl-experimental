#!/usr/bin/env -S ksplc run
//< The compiler builds, rebuilds itself and runs its suites from a copy of its folder alone
//<
//< The longest copy by far, so it is a suite of its own beside `extract_rest_test.kspls`, which
//< takes every other package the same way (the reasons are in `tests/support/extract.kspls`).
import "tests/support/extract"

fn main(): I32
  return extract.run("ksplc", "")

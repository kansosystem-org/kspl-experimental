#!/usr/bin/env -S ksplc run
//< Runs the self-test each tool written in Python holds
//< The tools that can only be written in Python (the pretty-printer loaded into LLDB, the
//< converters reading Hugging Face weights) each hold a self-test.
//< Caution: **Holding one does not make it work.** Called by nobody, it is a button that does
//< nothing when pressed. It stays green while the tool rots: the demangler in
//< `TOOLS/kspl_lldb.py` can go on looking for a name the compiler no longer emits.
//< **There is one way to start it**: every tool self-tests when run with no argument. Keep it the
//< same as tools are added, or this file comes to hold a branch per tool.
//< Caution: **Print a `SKIP` line when a module a tool needs is absent.** Skipped with no line, it
//< looks like a pass.
//< Its failure case: `tests/suite/pytools_test.kspl#NOT_RUN`, output in which no self-test ran.
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/ds" { List }
import "std/str"
import "std/strfmt" as _strfmt
import "std/verdict"
import "tests/support/harness"

priv const PYTHON: U8[] = "python3" //< the interpreter the tools run under, found on `PATH`

priv const MARK_OK: U8[] = "pass" //< the pass mark, read as a line's first word
    //< Its canonical source is the table in `tests/support/conventions_line.kspl`. Only the reader
    //< is here, so the day the mark changes, a stale copy fails with the false reason "not one
    //< ran".

priv const SELFTEST_TIMEOUT_MS: I32 = 300000 //< how long one tool's self-test may run

priv struct Tool //< one Python tool, and how it is started
    path: U8[] //< the file, from the repository's root
    needs: U8[] //< a module whose absence makes the check a `SKIP`; empty if none

priv const TOOLS: Tool[_] = ::{ Tool::{ .path = "tools/kspl_lldb.py", .needs = "" },
    Tool::{ .path = "lib/ksai/tools/export_qwen_tokenizer.py", .needs = "" },
    Tool::{ .path = "lib/ksai/examples/code_complete/lora_finetune_external.py", .needs = "" },
    Tool::{ .path = "lib/ksai/tools/gen_unicode_class.py", .needs = "" },
    Tool::{ .path = "lib/ksai/tools/check_qwen_tokenizer.py", .needs = "" },
    Tool::{ .path = "lib/ksai/tools/make_quant_fixtures.py", .needs = "numpy" },
    Tool::{ .path = "lib/ksai/tools/gguf_quant_check.py", .needs = "numpy" },
    Tool::{ .path = "lib/ksai/tools/make_qwen_fixtures.py", .needs = "numpy" },
    Tool::{ .path = "lib/ksai/tools/make_qwen35_fixtures.py", .needs = "numpy" },
    Tool::{ .path = "lib/ksai/tools/qwen_gguf_check.py", .needs = "numpy" },
    Tool::{ .path = "ksagent/tests/make_office_fixtures.py", .needs = "" } }

priv const LIBRARIES: U8[][_] = ::{ "lib/ksai/tools/safetensors_io.py" } //<
    //< The Python files under the tools' folders that are no tool: modules the tools import
    //< Each is exercised through the tools that import it.

priv fn importable(name: U8[]): Bool //< whether `python3` can import the module `name`
    arena: = ksplc_harness.arena()
    return ksplc_harness
        .run(U8[][]::{ PYTHON, "-c", arena.text().s("import ").s(name).take() }).exited_with(0)

priv const MARK_SELFTEST: U8[] = "[self-test]" //< the other opening a self-test's line may have

priv fn ran_one(out: U8[]): Bool //< whether a line of the output opens with a self-test's mark
    //< Caution: **Judge by the line's first word.** The mark is lower case. So a plain search also
    //< hits an English word in the output or Python's `pass` statement. It passes a round where
    //< not one self-test ran. The same holds for `[self-test]`: searched anywhere, a usage message
    //< naming the self-test passed.
    arena: = ksplc_harness.arena()
    for line in out.lines(arena)
        first: = line.sub(0, line.find_char(' ').unwrap_or(line.len))
        if first.equals(MARK_OK) || first.equals(MARK_SELFTEST)
            return true
    return false

priv const NOT_RUN: U8[] = "usage: tool.py [self-test]\nthe word pass inside a line\n" //<
    //< Output in which no self-test ran, though it holds both marks: the failure case

priv fn check_fires() //< output with no self-test's line is told from output with one
    verdict.check("output in which no self-test ran is told apart",
        !ran_one(NOT_RUN) && ran_one(MARK_OK), NOT_RUN)

priv fn check_listed() //< that every Python file of the tools and examples is run here or a library
    //< **A tool left off the list is never run**, and goes on passing while it rots.
    arena: = ksplc_harness.arena()
    $missing: = List<|U8[]|>(arena)
    found: = harness
        .tracked_matching(U8[][]::{ "tools/*.py", "lib/*/tools/*.py", "lib/*/examples/*.py" })
    for f in found
        $listed: = false
        for lib in LIBRARIES
            listed = listed || lib.equals(f)
        for i in Range.asc(TOOLS.len)
            listed = listed || TOOLS[i].path.equals(f)
        if !listed
            missing.push(f)
    verdict.check_list("every Python file of the tools and the examples is a tool run here or a \
        library", found.len, "files", missing@,
        "add it to `tools` (with a self-test run by no argument) or `libraries`")

priv fn check_tool(t: Tool@) //< runs one tool's self-test and reports it
    arena: = ksplc_harness.arena()
    name: = arena.text().s(t.path).s("'s self-test passes").take()
    if t.needs.len > 0 && !importable(t.needs)
        verdict.skip_check(name,
            arena.text().s(t.needs).s(" is absent (put it in this environment and it runs)").take())
        return
    argv: = U8[][]::{ PYTHON, t.path }
    r: = ksplc_harness.run_capped(argv, harness.root(), SELFTEST_TIMEOUT_MS)
    if !r.exited_with(0)
        verdict.check(name, false,
            arena.text().s("the self-test failed (exit code \{r.code.unwrap_or(-1)\})\n").s(r.out)
            .take())
        return
    // Caution: **The exit code alone is not enough.** It passes a run that returned 0 with not one
    // self-test run (a wrong entry point printing its usage, and the like).
    verdict.check(name, ran_one(r.out),
        arena.text().s("not one self-test ran\n").s(r.out).take())

fn main(): I32
    harness.begin(1 << 20)
    check_fires()
    check_listed()
    for i in Range.asc(TOOLS.len)
        check_tool(TOOLS[i]@)
    return ksplc_harness.finish()

#!/usr/bin/env -S ksplc run
//< The programs that start threads, built with ThreadSanitizer, run with no data race reported
//< **This stands where a type-system check does not** ("Why data races are not prevented by
//< the type system" in `docs/DESIGN-programming-language.md`). It finds the races the tests reach,
//< never the ones they miss. A report fails the gate, the runtime's and libc's included. Nothing is
//< suppressed. **Mandatory where `KANSO_REQUIRE_TSAN=1`** (`mk/test.mk` sets it on Linux, whose
//< image holds the sanitizer). Elsewhere a C compiler without it gives a `SKIP` line, never a
//< silent pass.
//< Caution: **A file that starts a thread is compiled into a program here or named in `LEFT_OUT`.**
//< So a new one cannot stay outside the gate unseen.
import "ksplc/tests/support/harness" as ksplc_harness
import "ksplc/tests/support/jsonrpc_client"
import "ksplc/tests/support/lsp_client"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/json" { Json_builder }
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/subproc"
import "std/sys"
import "std/verdict"
import "tests/support/harness"
import "tests/support/harness_sanitizer" + { Built, Sample }

// `-g` and the frame pointer keep a report's stack readable down to the `.kspl` line. The
// optimisation level is each build's (`build`).
priv const TSAN_CFLAGS: U8[][_] = ::{ "-g", "-fno-omit-frame-pointer", "-fsanitize=thread" }
priv const OPT_FOR_RUN: U8[] = "-O1" //< for a program whose run takes longer than its build
    //< ThreadSanitizer's advice, for its speed.
priv const OPT_FOR_BUILD: U8[] = "-O0" //< for one whose build takes longer than its run
    //< **ksplc is one**: its C takes 75 s to build at `-O1` and 9 s at `-O0`, for a session of a
    //< few seconds (measured). The sanitizer watches every access at `-O0` too.

priv const SELF_PATH: U8[] = "tests/suite/race_test.kspl"
priv const RACE_STACK_KIB: U8[] = "4096" //< the stack limit every raced run starts under, in KiB
    //< **The sanitizer, not the program, sets it.** Past about 8 MiB of the main thread's stack,
    //< ThreadSanitizer crashes inside itself in a third to half of runs (measured; 7 MiB never).
    //< std's stack test walks to the end of whatever limit it is given. The shell that starts the
    //< gate settles that limit (CI's container gives more than 8 MiB).
priv const REPORT_HEAD: U8[] = "WARNING: ThreadSanitizer:" //< the line that opens one report

struct Left_out //< a file that starts threads and that no program here runs, with why
    path: U8[]
    why: U8[]

priv const LEFT_OUT: Left_out[_] = ::{
    Left_out::{ .path = "tools/ai_assist/build_corpus.kspl", .why = "a tool no gate runs" },
    Left_out::{ .path = "ksplc/tests/negative/closure.kspl",
        .why = "compiled to be refused or accepted, never run" },
    Left_out::{ .path = "ksplc/tests/suite/emit_runtime_test.kspl",
        .why = "it only reads the runtime's text for the name" },
    Left_out::{ .path = "ksplc/tests/runtime/stops.kspl",
        .why = "its one thread runs its stack out, so the program crashes by design" },
}

// The race written on purpose: two threads add to one global with no lock.
priv const RACY_SOURCE: U8[] =
    """
import "std/thread"

priv $shared: I32 = 0

#export
fn bump(arg: I32$@): Void$@
  shared += arg$
  return null

fn main(): I32
  $one: I32 = 1
  t: = thread.Thread.spawn<|I32|>(bump, one@) catch
    return 2
  shared += 1
  t.join_and_free()
  return 0
"""

priv const SUMMARY_HEAD: U8[] = "SUMMARY: ThreadSanitizer: " //< the line that closes one
priv const GLOBAL_HEAD: U8[] = "  Location is global '" //< where the report names the variable

priv fn races_in(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< One line per report in a sanitizer's log: its summary, and the global it names
    //< **The global goes with it**: an error's trace records at a `!`, so a summary alone points
    //< at the `!` and not at what raced. **A pure function of one text** (`REPORT_SAMPLES`).
    $out: = List<|U8[]|>(arena)
    $open: = false
    $on: U8[] = ""
    for line in text.lines(arena)
        if line.starts_with(REPORT_HEAD)
            if open
                out.push(REPORT_HEAD)
            open = true
            on = ""
        else if open && line.starts_with(GLOBAL_HEAD)
            rest: = line.sub_from(GLOBAL_HEAD.len)
            if end: = rest.find_char('\'')
                on = rest.sub(0, end)
            else
                on = ""
        else if open && line.starts_with(SUMMARY_HEAD)
            what: = line.sub_from(SUMMARY_HEAD.len)
            out
                .push(what if on.len == 0
                else arena.text().s(what).s(" (on `").s(on).s("`)").take())
            open = false
    if open
        out.push(REPORT_HEAD)
    return out

priv fn tallied(races: List<|U8[]|>@, arena: Arena$@): U8[] //<
    //< Each distinct report once, with how many times it came
    $seen: = List<|U8[]|>(arena)
    $counts: = List<|Sz|>(arena)
    for k in Range.asc(races.len)
        short: = races.get(k)
        $at: Sz = -1
        for i in Range.asc(seen.len)
            if seen.get(i).equals(short)
                at = i
        if at < 0
            seen.push(short)
            counts.push(1)
        else
            counts.set(at, counts.get(at) + 1)
    out: = arena.text()
    for i in Range.asc(seen.len)
        out.s("\{counts.get(i)\}x ").s(seen.get(i)).c('\n')
    return out.take()

priv const REPORT_SAMPLES: Sample[_] = ::{
    Sample::{ .text =
        "==1==\nWARNING: ThreadSanitizer: data race (pid=1)\n  Write of size 4\n\n  Location is \
            global 'n' of size 4\nSUMMARY: ThreadSanitizer: data race a.kspl:3 in f\n",
        .reports = 1 },
    Sample::{ .text =
        "WARNING: ThreadSanitizer: data race\nWARNING: ThreadSanitizer: lock-order-inversion\n",
        .reports = 2 },
    // A forked child's leftover count, with no report of its own.
    Sample::{ .text = "ThreadSanitizer: reported 17 warnings\n", .reports = 0 },
    Sample::{ .text = "", .reports = 0 },
}

priv fn build(dir: U8[], entry: U8[], exe: U8[], opt: U8[], arena: Arena$@): Built //<
    //< Compiles entry (from the folder dir) to C and links it with the sanitizer into exe
    //< `opt` is `opt_for_run` or `opt_for_build`.
    $flags: = List<|U8[]|>(arena)
    for f in TSAN_CFLAGS
        flags.push(f)
    flags.push(opt)
    return harness_sanitizer.build(dir, entry, exe, flags.slice(), false, "", arena)

priv fn reports_in(log_dir: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Every race the sanitizer logged under log_dir, one process's log per `tsan.<pid>`
    return harness_sanitizer.reports_in(log_dir, "tsan.", races_in, arena)

struct Raced //< one sanitized run: the check it reports to, where it runs, and what
    name: U8[] //< the check; several runs may share one, and it fails if any of them does
    dir: U8[] //< the working directory
    argv: U8[][] //< the program and its arguments
    log_dir: U8[] //< the folder its processes' sanitizer logs go to, one per check
    env: U8[][] //< `NAME=value` pairs for this run alone

priv fn sanitized(log_dir: U8[], env: U8[][], argv: U8[][], arena: Arena$@): U8[][] //<
    //< argv as a raced run starts it: under `RACE_STACK_KIB`, its logs in log_dir, env set
    $out: = List<|U8[]|>(arena)
    for w in U8[][]::{ "sh", "-c", "ulimit -s \"$0\" && exec \"$@\"", RACE_STACK_KIB, "env" }
        out.push(w)
    out
        .push(arena.text().s("TSAN_OPTIONS=log_path=").s(fs.join(log_dir, "tsan", arena)).take())
    for e in env
        out.push(e)
    for a in argv
        out.push(a)
    return out.slice()

priv fn run_all_raced(runs: List<|Raced|>@, work: U8[], arena: Arena$@) //<
    //< Runs every run side by side, then reports one check per name, in the order first named
    //< **The parts run at once**: under the sanitizer a part takes many times its usual time.
    //< **Each process writes its own log** (`tsan.<pid>`), so a child the program starts is heard
    //< too. **Each check has its own log folder**, set
    //< per run through `env`, so a report lands on the check whose run made it. A run also fails on
    //< its exit code: the sanitizer exits 66 on a report.
    //< Caution: **Give each run that writes files a folder of its own**: they run at once.
    $jobs: = List<|subproc.Job|>(arena)
    for i in Range.asc(runs.len)
        r: = runs.get(i)
        fs.mkdir_all(r.log_dir) catch {}
        jobs
            .push(subproc.Job::{ .argv = sanitized(r.log_dir, r.env, r.argv, arena),
            .cwd = r.dir })
    outs: = verdict.run_children(jobs.slice(), fs.join(work, "jobs", arena), arena)
    for i in Range.asc(runs.len)
        name: = runs.get(i).name
        $first: = true
        for j in Range.asc(i)
            first = first && !runs.get(j).name.equals(name)
        if !first
            continue
        races: = reports_in(runs.get(i).log_dir, arena)
        why: = arena.text().s(tallied(races@, arena))
        $ended: = true
        for j in Range.asc(runs.len)
            if runs.get(j).name.equals(name) && !outs.get(j).exited_with(0)
                ended = false
                if races.len == 0
                    why.s("it did not end with 0, and left no report:\n").s(outs.get(j).out)
        if races.len > 0
            why.s("the whole reports are in ").s(runs.get(i).log_dir)
        verdict.check(name, races.len == 0 && ended, why.take())

priv fn check_fires(work: U8[], arena: Arena$@) //<
    //< The race written on purpose is reported, through the same build and run as the tests
    src: = fs.join(work, "racy.kspl", arena)
    io.write_file(src, RACY_SOURCE) catch
        verdict.check("a race written on purpose is reported", false, "cannot write it")
        return
    b: = build(work, src, fs.join(work, "racy.exe", arena), OPT_FOR_RUN, arena)
    if b.exe.len == 0
        verdict.check("a race written on purpose is reported", false, b.why)
        return
    log_dir: = fs.join(work, "racy_log", arena)
    fs.mkdir_all(log_dir) catch {}
    sys.set_env("TSAN_OPTIONS",
        arena.text().s("log_path=").s(fs.join(log_dir, "tsan", arena)).take()) catch
        panic("TSAN_OPTIONS could not be set")
    ksplc_harness.run_in(U8[][]::{ b.exe }, work)
    sys.unset_env("TSAN_OPTIONS") catch panic("TSAN_OPTIONS could not be unset")
    verdict.check("a race written on purpose is reported", reports_in(log_dir, arena).len > 0,
        "the program built with the sanitizer ran and nothing was reported")

priv fn race_tests(work: U8[], deps: Str_builder$@, runs: List<|Raced|>$@, arena: Arena$@) //<
    //< The packages whose own tests start threads: std's, and ksplc's
    //< **Only these**: the other packages' tests start none (`check_covered` holds it), so the
    //< sanitizer's time on them would watch one thread. Each runs from its folder, as its own
    //< `make test` runs it.
    std_name: = "std's own tests run with no data race"
    std_exes: =
        build_all(std_name, "std", U8[][]::{ "std/tests/main.kspl" }, work, deps, arena)
    if std_exes.len > 0
        under: = ksplc_harness.ksplc_exe()
        argv: = harness_sanitizer.kept(U8[][]::{ std_exes.get(0), under }, arena)
        runs
            .push(Raced::{ .name = std_name, .dir = ksplc_harness.std_dir(), .argv = argv,
            .log_dir = fs.join(work, "std_log", arena),
            .env = harness_sanitizer.pkg_env(arena) })
    ksplc_name: = "ksplc's own tests run with no data race"
    ksplc_exes: =
        build_all(ksplc_name, "ksplc", U8[][]::{ "ksplc/tests/main.kspl" }, work, deps, arena)
    if ksplc_exes.len > 0
        runs
            .push(Raced::{ .name = ksplc_name,
            .dir = fs.join(harness.root(), "ksplc", arena),
            .argv = harness_sanitizer.kept(U8[][]::{ ksplc_exes.get(0) }, arena),
            .log_dir = fs.join(work, "ksplc_log", arena),
            .env = harness_sanitizer.pkg_env(arena) })

priv fn build_all(name: U8[], pkg: U8[], entries: U8[][], work: U8[], deps: Str_builder$@,
    arena: Arena$@): List<|U8[]|> //<
        //< Builds each entry (named from the root) in the package's folder; empty where one fails
    $exes: = List<|U8[]|>(arena)
    dir: = fs.join(harness.root(), pkg, arena)
    for i in Range.asc(entries.len)
        stem: = arena.text().s(pkg).s("_\{i\}.exe").take()
        b: =
            build(dir, fs.join(harness.root(), entries[i], arena), fs.join(work, stem, arena),
            OPT_FOR_RUN, arena)
        if b.exe.len == 0
            verdict.check(name, false, b.why)
            return List<|U8[]|>(arena)
        deps.s(b.deps)
        exes.push(b.exe)
    return exes

priv fn race_ksai(work: U8[], deps: Str_builder$@, runs: List<|Raced|>$@, arena: Arena$@) //<
    //< ksai's examples and the tests that run them (`ksai/Makefile`'s `test`)
    //< fim_coder trains on two threads there.
    name: = "ksai's examples and their tests run with no data race"
    exes: =
        build_all(name, "ksai",
        U8[][]::{ "ksai/examples/llama_engine/main.kspl", "ksai/examples/qwen_infer/main.kspl",
        "ksai/examples/fim_coder/main.kspl", "ksai/tests/examples_main.kspl" }, work, deps, arena)
    if exes.len == 0
        return
    tmp: = fs.join(work, "ksai_work", arena)
    argv: = harness_sanitizer.kept(U8[][]::{ exes.get(3), exes.get(0), exes.get(1), exes.get(2),
        tmp }, arena)
    dir: = fs.join(harness.root(), "ksai", arena)
    log_dir: = fs.join(work, "ksai_log", arena)
    runs
        .push(Raced::{ .name = name, .dir = dir, .argv = argv, .log_dir = log_dir,
        .env = harness_sanitizer.pkg_env(arena) })

priv fn race_ksbind(work: U8[], deps: Str_builder$@, runs: List<|Raced|>$@, arena: Arena$@) //<
    //< ksbind's tests (`ksbind/Makefile`'s `test`), where the libraries it binds link
    //< The TLS test serves its handshake from a second thread.
    //< **Only a link that fails can skip, and only where `KSBIND_REQUIRE_LIBS` is not `1`**, as in
    //< ksbind's own `make test`. Linux's image holds OpenSSL and SQLite, so there it fails.
    name: = "ksbind's tests run with no data race"
    dir: = fs.join(harness.root(), "ksbind", arena)
    b: =
        build(dir, fs.join(harness.root(), "ksbind/tests/main.kspl", arena),
        fs.join(work, "ksbind.exe", arena), OPT_FOR_RUN, arena)
    if b.exe.len == 0
        if b.why.starts_with("it does not link")
            ksplc_harness.require_or_skip(name, "KSBIND_REQUIRE_LIBS",
                arena.text().s("the libraries ksbind binds do not link here: ").s(b.why).take())
        else
            verdict.check(name, false, b.why)
        return
    deps.s(b.deps)
    runs
        .push(Raced::{ .name = name, .dir = dir,
        .argv = harness_sanitizer.kept(U8[][]::{ b.exe }, arena),
        .log_dir = fs.join(work, "ksbind_log", arena),
        .env = harness_sanitizer.pkg_env(arena) })

// ==========================================
// The language server, raced through a session
// **Its supervisor reads the editor on a thread of its own** while the main loop pumps the worker,
// restarts it and hands it the documents. No test program reaches that. So ksplc itself is built
// with the sanitizer, and an editor's session is played to it. Its worker is the same build (the
// supervisor starts its own executable), so both sides are watched.
// ==========================================

priv const LSP_DOCS: Sz = 4 //< how many documents the session opens
priv const LSP_WAIT_MS: I32 = 60000 //< how long one answer may take under the sanitizer
priv const LSP_EXIT_MS: I64 = 30000I64 //< how long the server may take to end after `exit`

priv fn lsp_text(fn_name: U8[], k: Sz, arena: Arena$@): U8[] //<
    //< A document whose `main` calls a function named fn_name and k; the hovers ask at its call
    return arena.text().s("fn ").s(fn_name).s("\{k\}(a: I32, b: I32): I32 //< adds\n")
        .s("    return a + b\n\nfn main(): I32\n    return ").s(fn_name).s("\{k\}(1, 2)\n").take()

struct Lsp_session //< the client playing the editor, the workspace, and what went wrong
    c: jsonrpc_client.Client$@
    top: U8[]
    faults: List<|U8[]|>

impl Lsp_session
    priv fn uri(r: Self$@, k: Sz, arena: Arena$@): U8[]
        return lsp_client.uri_of(r.top, arena.text().s("d\{k\}.kspl").take(), arena)

    priv fn change(r: Self$@, k: Sz, fn_name: U8[], arena: Arena$@) //<
        //< a didChange of the whole text
        $b: = Json_builder(arena)
        td: = b.obj().set("uri", b.str_val(r.uri(k, arena))).set("version", b.int_val(2I64)).build()
        change: = b.obj().set("text", b.str_val(lsp_text(fn_name, k, arena))).build()
        params: = b.obj().set("textDocument", td)
            .set("contentChanges", b.arr().push(change).build()).build()
        r.c.notify("textDocument/didChange", params, lsp_client.SEND_MS, arena) catch {}

    priv fn hover(r: Self$@, k: Sz, fn_name: U8[], when: U8[], arena: Arena$@) //<
        //< A hover at document k's call, which must name fn_name and k
        at: = lsp_client.at_pos(r.uri(k, arena), 4, 12, arena)
        got: = lsp_client.answer(r.c, "textDocument/hover", at, LSP_WAIT_MS, arena)
        text: = lsp_client.hover_text(got)
        want: = arena.text().s(fn_name).s("\{k\}").take()
        if text.find_str(want).is_none()
            said: = arena.text().s("a hover on d\{k\} ").s(when).s(" did not name `").s(want)
                .s("`: '").s(text).s("'").take()
            r.faults.push(lsp_client.why(r.c, said, arena))

    priv fn crash(r: Self$@, arena: Arena$@) //< the worker's crash hook (`$/ksplTestCrash`)
        $b: = Json_builder(arena)
        r.c.notify("$/ksplTestCrash", b.obj().build(), lsp_client.SEND_MS, arena) catch {}

priv fn play_lsp_session(exe: U8[], log_dir: U8[], top: U8[], arena: Arena$@): List<|U8[]|> //<
    //< An editor's session with the server, returning what went wrong; empty where it all answered
    //< **Each step gives the reading thread something to do beside the main loop.** A crash comes
    //< with more messages at once, read while the worker is restarted and handed the documents.
    //< In a pause, the main loop analyses the documents nobody asked for while the thread waits on
    //< the input. On `exit` with the input still open, the thread
    //< must stop by itself.
    $faults: = List<|U8[]|>(arena)
    argv: =
        sanitized(log_dir,
        U8[][]::{ arena.text().s("KSPLC_STD_DIR=").s(ksplc_harness.std_dir()).take() },
        U8[][]::{ exe, "lsp" }, arena)
    defer $c: = jsonrpc_client.spawn(argv, top) catch
        faults.push("the server cannot be started")
        return faults
    $s: = Lsp_session::{ .c = c@, .top = top, .faults = faults }
    $b: = Json_builder(arena)
    _init: =
        s.c.request("initialize", b.obj().build(), LSP_WAIT_MS, arena) catch {}
    s.c.notify("initialized", b.obj().build(), lsp_client.SEND_MS, arena) catch {}
    for k in Range.asc(LSP_DOCS)
        s.c
            .notify("textDocument/didOpen",
            lsp_client.did_open(s.uri(k, arena), lsp_text("add", k, arena), arena),
            lsp_client.SEND_MS, arena) catch {}
    for k in Range.asc(LSP_DOCS)
        s.hover(k, "add", "before the crash", arena)
    // The first document's request comes while the worker is remade; the others are analysed
    // while the editor is silent.
    s.crash(arena)
    s.hover(0, "add", "right after the crash", arena)
    sys.sleep_ms(500)
    for k in Range.asc(LSP_DOCS)
        s.hover(k, "add", "after the pause", arena)
    // A burst while the worker is remade: edits and a request, read as they come.
    s.crash(arena)
    for k in Range.asc(LSP_DOCS)
        s.change(k, "sum", arena)
    for k in Range.asc(LSP_DOCS)
        s.hover(k, "sum", "after the edits", arena)
    _down: = s.c.request("shutdown", .null_val, LSP_WAIT_MS, arena) catch {}
    s.c.notify("exit", .null_val, lsp_client.SEND_MS, arena) catch {}
    deadline: = sys.mono_us() + LSP_EXIT_MS * 1000I64
    for s.c.alive() && sys.mono_us() < deadline
        sys.sleep_ms(20)
    if s.c.alive()
        said: = "the server did not end after `exit` with its input still open"
        s.faults.push(lsp_client.why(s.c, said, arena))
    return s.faults

priv fn race_lsp(work: U8[], deps: Str_builder$@, arena: Arena$@) //<
    //< The language server through one session, its supervisor's reading thread included
    name: = "the language server runs an editor's session with no data race"
    root: = harness.root()
    b: =
        build(root, fs.join(root, "ksplc/main.kspl", arena),
        fs.join(work, "ksplc.exe", arena), OPT_FOR_BUILD, arena)
    if b.exe.len == 0
        verdict.check(name, false, b.why)
        return
    deps.s(b.deps)
    log_dir: = fs.join(work, "lsp_log", arena)
    top: = fs.join(work, "lsp_ws", arena)
    fs.mkdir_all(log_dir) catch {}
    fs.mkdir_all(top) catch {}
    faults: = play_lsp_session(b.exe, log_dir, top, arena)
    races: = reports_in(log_dir, arena)
    why: = arena.text().s(tallied(races@, arena))
    for f in faults
        why.s(f).c('\n')
    if races.len > 0
        why.s("the whole reports are in ").s(log_dir)
    verdict.check(name, races.len == 0 && faults.len == 0, why.take())

priv fn check_covered(deps: U8[], arena: Arena$@) //<
    //< Every tracked source that starts a thread is compiled into a program above, or left out
    read: = deps.lines(arena)
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::{ "*.kspl" })
        text: = harness.read_under_root(rel)
        // This file's own spawn is the race written on purpose, raced by `check_fires`.
        if rel.equals(SELF_PATH) ||
            (text.find_str("Thread.spawn").is_none() &&
            text.find_str("kspl_thread_spawn").is_none())
            continue
        seen += 1
        full: = fs.join(harness.root(), rel, arena)
        $held: = false
        for p in read
            held = held || p.equals(full)
        for l in LEFT_OUT
            held = held || l.path.equals(rel)
        if !held
            bad.push(rel)
    verdict.check_list("every source that starts a thread is raced or named as left out", seen,
        "files", bad@, "compile it into a program in this suite, or add it to `left_out` with why")

fn main(): I32
    arena: = harness.begin(64 * 1024 * 1024)
    harness_sanitizer.check_reading_fires("a sanitizer's report is read as one race each",
        Sample[]::REPORT_SAMPLES, races_in, arena)
    work: = harness.sandbox("race")
    said: = harness_sanitizer.runs_with(work, U8[][]::{ "-fsanitize=thread" }, U8[][]::{}, arena)
    if said.len > 0
        lacks: = arena.text().s("the C compiler cannot build with ThreadSanitizer: ").s(said).take()
        ksplc_harness.require_or_skip("the programs that start threads, raced", "KANSO_REQUIRE_TSAN",
            lacks)
        return ksplc_harness.finish()
    check_fires(work, arena)
    defer $deps: = Str_builder()
    $runs: = List<|Raced|>(arena)
    race_tests(work, deps@, runs@, arena)
    race_ksai(work, deps@, runs@, arena)
    race_ksbind(work, deps@, runs@, arena)
    race_lsp(work, deps@, arena)
    run_all_raced(runs@, work, arena)
    check_covered(deps.slice(), arena)
    return ksplc_harness.finish()

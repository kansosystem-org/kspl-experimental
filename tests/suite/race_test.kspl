#!/usr/bin/env -S ksplc run
//< The programs that start threads, built with ThreadSanitizer, run with no data race reported
//< **This stands where a type-system check does not** ("Why data races are not prevented by
//< the type system" in `docs/DESIGN-programming-language.md`). Each test runs once, so it finds a
//< race only where that run's accesses meet with no order, never one the tests miss. It shuffles
//< no schedule and checks no liveness ("The notes" in `docs/SPEC-gates.md`). A report fails the
//< gate, the runtime's and libc's included. Nothing is suppressed.
//< **Mandatory where `KANSO_REQUIRE_TSAN=1`** (`mk/test.mk` sets it on Linux, whose image holds
//< the sanitizer). Elsewhere a C compiler without it gives a `SKIP` line, never a silent pass.
//< Caution: **A file that starts a thread is compiled into a program here or named in `LEFT_OUT`.**
//< So a new one cannot stay outside the gate unseen.
//< Its failure case: `tests/suite/race_test.kspl#RACY_SOURCE`, a race written on purpose.
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" { Str_builder }
import "std/subproc"
import "std/sys"
import "std/verdict"
import "tests/support/harness"
import "tests/support/harness_sanitizer" + { Built, Order, Sample }

// `-g` and the frame pointer keep a report's stack readable down to the `.kspl` line. The
// optimisation level is each build's (`build`).
priv const TSAN_CFLAGS: U8[][_] = ::{ "-g", "-fno-omit-frame-pointer", "-fsanitize=thread" }
priv const OPT_FOR_RUN: U8[] = "-O1" //< for a program whose run takes longer than its build
    //< ThreadSanitizer's advice, for its speed.
priv const OPT_FOR_BUILD: U8[] = "-O0" //< for one whose build takes longer than its run
    //< **ksplc is one**: its C takes 75 s to build at `-O1` and 9 s at `-O0`, for a session of a
    //< few seconds (measured). The sanitizer watches every access at `-O0` too.
priv const OPT_FOR_SPIN: U8[] = "-O0" //< for a program that races a loop spinning on a flag
    //< **At `-O1` the C compiler drops a loop that only reads a plain variable**, and the read
    //< with it. So a flag left plain by mistake has no read left to race.

priv const SELF_PATH: U8[] = "tests/suite/race_test.kspl"
priv const RACE_STACK_KIB: U8[] = "4096" //< the stack limit every raced run starts under, in KiB
    //< **The sanitizer, not the program, sets it.** Past about 8 MiB of the main thread's stack,
    //< ThreadSanitizer crashes inside itself in a third to half of runs (measured; 7 MiB never).
    //< std's stack test walks to the end of whatever limit it is given. The shell that starts the
    //< gate settles that limit (CI's container gives more than 8 MiB).
priv const MARK_AFTER_OPEN: U8[] = "-DKSPL_TEST_MARK_AFTER_OPEN" //<
    //< The C runtime's define that takes macOS's way to open a pipe or a socket on Linux too
    //< **macOS marks a pipe close-on-exec only after opening it**, so there a child's start takes a
    //< lock, from the first pipe to the fork. Linux opens it marked and takes none. Without this,
    //< no gate races that lock: the race gate runs on Linux alone.
priv const REPORT_HEAD: U8[] = "WARNING: ThreadSanitizer:" //< the line that opens one report
priv const RACE_LIMIT_MS: I32 = 180000 //< how long one raced program may run before it is killed
    //< **A hang is the failure a race often gives**, so it must end soon, naming the program. The
    //< longest run takes under half of it under the sanitizer, on a machine busy with the others.
    //< The language server's session has it too (`race_lsp`).

struct Left_out //< a file that starts threads and that no program here runs, with why
    path: U8[]
    why: U8[]

priv const LEFT_OUT: Left_out[_] = ::{
    Left_out::{ .path = "lib/ksai/examples/code_complete/build_corpus.kspl",
        .why = "a program of the coding example no gate runs" },
    Left_out::{ .path = "ksplc/tests/negative/closure.kspl",
        .why = "compiled to be refused or accepted, never run" },
    Left_out::{ .path = "ksplc/tests/negative/thread.kspl",
        .why = "compiled to be refused or accepted, never run" },
    Left_out::{ .path = "ksplc/tests/lint/resources.kspl", .why = "linted, never run" },
    Left_out::{ .path = "ksplc/tests/suite/emit_runtime_test.kspl",
        .why = "it only reads the runtime's text for the name" },
    Left_out::{ .path = "tests/support/holes_mem.kspl",
        .why = "a thread kept past its starter's frame on purpose, which `make test-holes` runs" },
    Left_out::{ .path = "tests/support/holes_sync.kspl",
        .why = "races written on purpose, which `make test-holes` runs" },
    Left_out::{ .path = "ksplc/tests/runtime/stops.kspl",
        .why = "its one thread runs its stack out, so the program crashes by design" },
}

// The race written on purpose: two threads add to one global with no lock.
priv const RACY_SOURCE: U8[] =
    """
import "std/thread"

priv $shared: I32 = 0

extern fn bump(arg: I32$@): Void$@
  shared += arg$
  return null

fn main(): I32
  $one: I32 = 1
  $t: = thread.Thread.spawn<|I32|>(bump, one@) catch
    return 2
  shared += 1
  t.free()
  return 0
"""

priv const SUMMARY_HEAD: U8[] = "SUMMARY: ThreadSanitizer: " //< the line that closes one
priv const GLOBAL_HEAD: U8[] = "  Location is global '" //< where the report names the variable

priv fn races_in(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< One line per report in a sanitizer's log: its summary, and the global it names
    //< **The global goes with it**: an error's trace records at a `!`, so a summary alone points
    //< at the `!` and not at what raced. **A pure function of one text** (`REPORT_SAMPLES`).
    $out: = List<|U8[]|>(arena)
    $open: = false
    $on: U8[] = ""
    for line in text.lines(arena)
        if line.starts_with(REPORT_HEAD)
            if open
                out.push(REPORT_HEAD)
            open = true
            on = ""
        else if open && line.starts_with(GLOBAL_HEAD)
            rest: = line.sub_from(GLOBAL_HEAD.len)
            if end: = rest.find_char('\'')
                on = rest.sub(0, end)
            else
                on = ""
        else if open && line.starts_with(SUMMARY_HEAD)
            what: = line.sub_from(SUMMARY_HEAD.len)
            out
                .push(what if on.len == 0
                else arena.text().s(what).s(" (on `").s(on).s("`)").take())
            open = false
    if open
        out.push(REPORT_HEAD)
    return out

priv fn tallied(races: List<|U8[]|>@, arena: Arena$@): U8[] //<
    //< Each distinct report once, with how many times it came
    $seen: = List<|U8[]|>(arena)
    $counts: = List<|Sz|>(arena)
    for k in Range.asc(races.len)
        short: = races.get(k)
        $at: Sz = -1
        for i in Range.asc(seen.len)
            if seen.get(i).equals(short)
                at = i
        if at < 0
            seen.push(short)
            counts.push(1)
        else
            counts.set(at, counts.get(at) + 1)
    out: = arena.text()
    for i in Range.asc(seen.len)
        out.s("\{counts.get(i)\}x ").s(seen.get(i)).c('\n')
    return out.take()

priv const REPORT_SAMPLES: Sample[_] = ::{
    Sample::{ .text =
        "==1==\nWARNING: ThreadSanitizer: data race (pid=1)\n  Write of size 4\n\n  Location is \
            global 'n' of size 4\nSUMMARY: ThreadSanitizer: data race a.kspl:3 in f\n",
        .reports = 1 },
    Sample::{ .text =
        "WARNING: ThreadSanitizer: data race\nWARNING: ThreadSanitizer: lock-order-inversion\n",
        .reports = 2 },
    // A forked child's leftover count, with no report of its own.
    Sample::{ .text = "ThreadSanitizer: reported 17 warnings\n", .reports = 0 },
    Sample::{ .text = "", .reports = 0 },
}

priv fn order(dir: U8[], entry: U8[], exe: U8[], opt: U8[], define: U8[], arena: Arena$@): Order //<
    //< The build of entry (from the folder dir) to C, linked with the sanitizer into exe
    //< `opt` is `opt_for_run`, `opt_for_build` or `opt_for_spin`; `define` is a `-D`, or empty.
    $flags: = List<|U8[]|>(arena)
    flags.push_all(U8[][]::TSAN_CFLAGS)
    flags.push(opt)
    if define.len > 0
        flags.push(define)
    return Order::{ .dir = dir, .entry = entry, .exe = exe, .cflags = flags.slice(), .llvm = false,
        .marks = "" }

priv fn aborts_in(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< A stopped run's stack, which the sanitizer logs on an abort (`handle_abort=1`), such as a
    //< panic's: without it a panic names one line, and not the thread or the calls that led there
    $out: = List<|U8[]|>(arena)
    at: = text.find_str("ERROR: ThreadSanitizer:") catch
        return out
    out.push(text.sub_from(at))
    return out

priv fn reports_in(log_dir: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Every race the sanitizer logged under log_dir, one process's log per `tsan.<pid>`
    return harness_sanitizer.reports_in(log_dir, "tsan.", races_in, arena)

struct Raced //< one sanitized run: the check it reports to, where it runs, and what
    name: U8[] //< the check; several runs may share one, and it fails if any of them does
    dir: U8[] //< the working directory
    argv: U8[][] //< the program and its arguments
    log_dir: U8[] //< the folder its processes' sanitizer logs go to, one per check
    env: U8[][] //< `NAME=value` pairs for this run alone

priv fn sanitized(log_dir: U8[], env: U8[][], argv: U8[][], arena: Arena$@): U8[][] //<
    //< argv as a raced run starts it: under `RACE_STACK_KIB`, its logs in log_dir, env set
    $out: = List<|U8[]|>(arena)
    out
        .push_all(U8[][]::{ "sh", "-c", "ulimit -s \"$0\" && exec \"$@\"", RACE_STACK_KIB, "env" })
    out
        .push(arena.text().s("TSAN_OPTIONS=log_path=").s(fs.join(log_dir, "tsan", arena))
        .s(":handle_abort=1").take())
    out.push_all(env)
    out.push_all(argv)
    return out.slice()

priv fn run_all_raced(runs: List<|Raced|>@, work: U8[], arena: Arena$@) //<
    //< Runs every run side by side, then reports one check per name, in the order first named
    //< **The parts run at once**: under the sanitizer a part takes many times its usual time.
    //< **Each process writes its own log** (`tsan.<pid>`), so a child the program starts is heard
    //< too. **Each check has its own log folder**, set
    //< per run through `env`, so a report lands on the check whose run made it. A run also fails on
    //< its exit code: the sanitizer exits 66 on a report.
    //< Caution: **Give each run that writes files a folder of its own**: they run at once.
    $jobs: = List<|subproc.Job|>(arena)
    for i in Range.asc(runs.len)
        r: = runs.get(i)
        fs.mkdir_all(r.log_dir) catch {}
        jobs
            .push(subproc.Job::{ .argv = sanitized(r.log_dir, r.env, r.argv, arena),
            .cwd = r.dir })
    outs: = verdict.run_children(jobs.slice(), fs.join(work, "jobs", arena), RACE_LIMIT_MS, arena)
    for i in Range.asc(runs.len)
        name: = runs.get(i).name
        $first: = true
        for j in Range.asc(i)
            first = first && !runs.get(j).name.equals(name)
        if !first
            continue
        races: = reports_in(runs.get(i).log_dir, arena)
        why: = arena.text().s(tallied(races@, arena))
        $ended: = true
        for j in Range.asc(runs.len)
            if runs.get(j).name.equals(name) && !outs.get(j).exited_with(0)
                ended = false
                exe: = sys.get_file_name(runs.get(j).argv[0])
                why.s("`").s(exe).s("` did not end with 0 (a run is killed after ")
                    .s("\{RACE_LIMIT_MS / 1000\} s)")
                if races.len == 0
                    why.s(", and left no report:\n").s(outs.get(j).out)
                why.c('\n')
        // **The stacks are read once per check**: the runs of one check share its log folder, so
        // a read per failed run would print each stack again.
        if !ended && races.len == 0
            for stack in harness_sanitizer.reports_in(runs.get(i).log_dir, "tsan.", aborts_in,
                arena)
                why.s("where it stopped, as the sanitizer logged it:\n").s(stack)
        if races.len > 0
            why.s("the whole reports are in ").s(runs.get(i).log_dir)
        verdict.check(name, races.len == 0 && ended, why.take())

priv fn check_fires(work: U8[], arena: Arena$@) //<
    //< The race written on purpose is reported, through the same build and run as the tests
    src: = fs.join(work, "racy.kspl", arena)
    io.write_file(src, RACY_SOURCE) catch
        verdict.check("a race written on purpose is reported", false, "cannot write it")
        return
    o: = order(work, src, fs.join(work, "racy.exe", arena), OPT_FOR_RUN, "", arena)
    b: = harness_sanitizer.build(o.dir, o.entry, o.exe, o.cflags, false, "", arena)
    if b.exe.len == 0
        verdict.check("a race written on purpose is reported", false, b.why)
        return
    log_dir: = fs.join(work, "racy_log", arena)
    fs.mkdir_all(log_dir) catch {}
    sys.set_env("TSAN_OPTIONS",
        arena.text().s("log_path=").s(fs.join(log_dir, "tsan", arena)).take()) catch
        panic("TSAN_OPTIONS could not be set")
    ksplc_harness.run_in(U8[][]::{ b.exe }, work)
    sys.unset_env("TSAN_OPTIONS") catch panic("TSAN_OPTIONS could not be unset")
    verdict.check("a race written on purpose is reported", reports_in(log_dir, arena).len > 0,
        "the program built with the sanitizer ran and nothing was reported")

// ==========================================
// The programs raced, built side by side before any runs
// **The builds take longer than the runs**, so they go at once (`harness_sanitizer.build_many`).
// Each check then takes its programs by name.
// ==========================================

struct Program //< one program the gate builds with the sanitizer
    stem: U8[] //< its executable's name in the work folder, without `.exe`
    pkg: U8[] //< the folder ksplc runs in, from the root; empty for the root itself
    entry: U8[] //< its source, from the root
    opt: U8[] //< `opt_for_run`, `opt_for_build` or `opt_for_spin`
    define: U8[] //< a `-D` for this build, or empty

// The longest builds stand first, so none of them starts last.
priv const PROGRAMS: Program[_] = ::{
    Program::{ .stem = "ksplc", .pkg = "", .entry = "ksplc/main.kspl", .opt = OPT_FOR_BUILD,
        .define = "" },
    Program::{ .stem = "ksai_6", .pkg = "lib/ksai", .entry = "lib/ksai/tests/main.kspl",
        .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "ksai_5", .pkg = "lib/ksai", .entry = "lib/ksai/tests/examples_main.kspl",
        .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "std_0", .pkg = "std", .entry = "std/tests/main.kspl", .opt = OPT_FOR_RUN,
        .define = MARK_AFTER_OPEN },
    Program::{ .stem = "ksagent", .pkg = "ksagent", .entry = "ksagent/tests/main.kspl",
        .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "ksai_4", .pkg = "lib/ksai",
        .entry = "lib/ksai/examples/chat_server/main.kspl", .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "ksplc_0", .pkg = "ksplc", .entry = "ksplc/tests/main.kspl",
        .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "ksai_2", .pkg = "lib/ksai",
        .entry = "lib/ksai/examples/code_complete/main.kspl", .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "ksai_0", .pkg = "lib/ksai",
        .entry = "lib/ksai/examples/llama_engine/main.kspl", .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "ksai_1", .pkg = "lib/ksai",
        .entry = "lib/ksai/examples/qwen_infer/main.kspl", .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "kstls", .pkg = "lib/kstls", .entry = "lib/kstls/tests/main.kspl",
        .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "ksai_3", .pkg = "lib/ksai",
        .entry = "lib/ksai/examples/car_pilot/main.kspl", .opt = OPT_FOR_RUN, .define = "" },
    Program::{ .stem = "ksai_pool", .pkg = "lib/ksai",
        .entry = "lib/ksai/tests/pool_stress_main.kspl", .opt = OPT_FOR_SPIN, .define = "" },
    Program::{ .stem = "lsp_session", .pkg = "", .entry = "tests/support/race_lsp_session.kspl",
        .opt = OPT_FOR_BUILD, .define = "" },
}

struct Builds //< every program of `PROGRAMS` built, in its order
    all: List<|Built|>

impl Builds
    priv fn of(r: Self@, stem: U8[]): Built //< the build of the program named stem
        for i in Range.asc(PROGRAMS.len)
            if PROGRAMS[i].stem.equals(stem)
                return r.all.get(i)
        panic("race_test: a check names a program that `PROGRAMS` does not hold")

    priv fn exes(r: Self@, name: U8[], stems: U8[][], arena: Arena$@): List<|U8[]|> //<
        //< The executables of the programs named stems; empty, with check name failed, where one
        //< did not build
        $exes: = List<|U8[]|>(arena)
        for stem in stems
            b: = r.of(stem)
            if b.exe.len == 0
                verdict.check(name, false, b.why)
                return List<|U8[]|>(arena)
            exes.push(b.exe)
        return exes

priv fn build_programs(work: U8[], deps: Str_builder$@, arena: Arena$@): Builds //<
    //< Builds every program of `PROGRAMS` at once; the sources of each that built go to deps
    root: = harness.root()
    $orders: = List<|Order|>(arena)
    for p in PROGRAMS
        exe: = fs.join(work, arena.text().s(p.stem).s(".exe").take(), arena)
        dir: = fs.join(root, p.pkg, arena) if p.pkg.len > 0 else root
        entry: = fs.join(root, p.entry, arena)
        orders.push(order(dir, entry, exe, p.opt, p.define, arena))
    all: = harness_sanitizer.build_many(orders.slice(), arena)
    for b in all
        deps.s(b.deps)
    return Builds::{ .all = all }

priv fn race_tests(work: U8[], builds: Builds@, runs: List<|Raced|>$@, arena: Arena$@) //<
    //< The packages whose own tests start threads: std's, and ksplc's
    //< **Only these**: the other packages' tests start none (`check_covered` holds it), so the
    //< sanitizer's time on them would watch one thread. Each runs from its folder, as its own
    //< `make test` runs it.
    //< **std's are built the way macOS opens a pipe** (`MARK_AFTER_OPEN`): its spawn lock is
    //< raced by them, and Linux's own way takes no lock.
    std_name: = "std's own tests run with no data race"
    std_exes: = builds.exes(std_name, U8[][]::{ "std_0" }, arena)
    if std_exes.len > 0
        under: = ksplc_harness.ksplc_exe()
        argv: = harness_sanitizer.kept(U8[][]::{ std_exes.get(0), under }, arena)
        runs
            .push(Raced::{ .name = std_name, .dir = ksplc_harness.std_dir(), .argv = argv,
            .log_dir = fs.join(work, "std_log", arena),
            .env = harness_sanitizer.pkg_env(arena) })
    ksplc_name: = "ksplc's own tests run with no data race"
    ksplc_exes: = builds.exes(ksplc_name, U8[][]::{ "ksplc_0" }, arena)
    if ksplc_exes.len > 0
        runs
            .push(Raced::{ .name = ksplc_name,
            .dir = fs.join(harness.root(), "ksplc", arena),
            .argv = harness_sanitizer.kept(U8[][]::{ ksplc_exes.get(0) }, arena),
            .log_dir = fs.join(work, "ksplc_log", arena),
            .env = harness_sanitizer.pkg_env(arena) })

priv fn race_ksai(work: U8[], builds: Builds@, runs: List<|Raced|>$@, arena: Arena$@) //<
    //< ksai's examples, the tests that run them, and its unit tests (`lib/ksai/Makefile`'s `test`)
    //< code_complete trains on two threads there. The unit tests split products over threads.
    name: = "ksai's examples and their tests run with no data race"
    exes: = builds.exes(name,
        U8[][]::{ "ksai_0", "ksai_1", "ksai_2", "ksai_3", "ksai_4", "ksai_5", "ksai_6" }, arena)
    if exes.len == 0
        return
    tmp: = fs.join(work, "ksai_work", arena)
    // The arguments are as `lib/ksai/Makefile`'s `test` passes them, in its order.
    argv: = harness_sanitizer.kept(U8[][]::{ exes.get(5), exes.get(0), exes.get(1), exes.get(2),
        exes.get(3), exes.get(4), ksplc_harness.ksplc_exe(), tmp }, arena)
    dir: = fs.join(harness.root(), "lib/ksai", arena)
    log_dir: = fs.join(work, "ksai_log", arena)
    runs
        .push(Raced::{ .name = name, .dir = dir, .argv = argv, .log_dir = log_dir,
        .env = harness_sanitizer.pkg_env(arena) })
    runs
        .push(Raced::{ .name = name, .dir = dir,
        .argv = harness_sanitizer.kept(U8[][]::{ exes.get(6) }, arena), .log_dir = log_dir,
        .env = harness_sanitizer.pkg_env(arena) })

priv fn race_ksai_pool(work: U8[], builds: Builds@, runs: List<|Raced|>$@, arena: Arena$@) //<
    //< ksai's thread pool, given rounds back to back (`lib/ksai/tests/pool_stress_main.kspl`)
    //< **The programs above post a round now and then**, so the workers sleep between rounds, and
    //< the hand-over while they spin is not raced. A lost wakeup fails there with a message.
    name: = "ksai's thread pool hands over thousands of rounds with no data race"
    exes: = builds.exes(name, U8[][]::{ "ksai_pool" }, arena)
    if exes.len == 0
        return
    runs
        .push(Raced::{ .name = name, .dir = fs.join(harness.root(), "lib/ksai", arena),
        .argv = harness_sanitizer.kept(U8[][]::{ exes.get(0) }, arena),
        .log_dir = fs.join(work, "ksai_pool_log", arena),
        .env = harness_sanitizer.pkg_env(arena) })

priv fn race_kstls(work: U8[], builds: Builds@, runs: List<|Raced|>$@, arena: Arena$@) //<
    //< kstls's tests (`lib/kstls/Makefile`'s `test`), where the libraries it binds link
    //< The TLS test serves its handshake from a second thread.
    //< **Only a link that fails can skip, and only where `KSTLS_REQUIRE_LIBS` is not `1`**, as in
    //< kstls's own `make test`. Linux's image holds OpenSSL, so there it fails.
    name: = "kstls's tests run with no data race"
    b: = builds.of("kstls")
    if b.exe.len == 0
        if b.why.starts_with("it does not link")
            ksplc_harness.require_or_skip(name, "KSTLS_REQUIRE_LIBS",
                arena.text().s("the libraries kstls binds do not link here: ").s(b.why).take())
        else
            verdict.check(name, false, b.why)
        return
    runs
        .push(Raced::{ .name = name, .dir = fs.join(harness.root(), "lib/kstls", arena),
        .argv = harness_sanitizer.kept(U8[][]::{ b.exe }, arena),
        .log_dir = fs.join(work, "kstls_log", arena),
        .env = harness_sanitizer.pkg_env(arena) })

priv fn race_ksagent(work: U8[], builds: Builds@, runs: List<|Raced|>$@, arena: Arena$@) //<
    //< ksagent's tests (`ksagent/Makefile`'s `test`)
    //< Their stand-in model server answers from a second thread while the loop asks it.
    name: = "ksagent's tests run with no data race"
    exes: = builds.exes(name, U8[][]::{ "ksagent" }, arena)
    if exes.len == 0
        return
    argv: = harness_sanitizer.kept(U8[][]::{ exes.get(0),
        fs.join(work, "ksagent_work", arena) }, arena)
    runs
        .push(Raced::{ .name = name, .dir = fs.join(harness.root(), "ksagent", arena), .argv = argv,
        .log_dir = fs.join(work, "ksagent_log", arena),
        .env = harness_sanitizer.pkg_env(arena) })

priv fn race_lsp(work: U8[], builds: Builds@, runs: List<|Raced|>$@, arena: Arena$@) //<
    //< The language server through one editor's session, its supervisor's reading thread included
    //< **ksplc itself is built with the sanitizer**, and `tests/support/race_lsp_session.kspl`
    //< plays the session to it. The session runs beside the other programs, under the same limit.
    //< Its worker is the same build (the supervisor starts its own executable), so both sides are
    //< watched.
    name: = "the language server runs an editor's session with no data race"
    exes: = builds.exes(name, U8[][]::{ "ksplc", "lsp_session" }, arena)
    if exes.len == 0
        return
    top: = fs.join(work, "lsp_ws", arena)
    fs.mkdir_all(top) catch {}
    argv: = harness_sanitizer.kept(U8[][]::{ exes.get(1), exes.get(0), top,
        arena.text().s("\{RACE_LIMIT_MS\}").take() }, arena)
    std_at: = arena.text().s("KSPLC_STD_DIR=").s(ksplc_harness.std_dir()).take()
    runs
        .push(Raced::{ .name = name, .dir = top, .argv = argv,
        .log_dir = fs.join(work, "lsp_log", arena),
        .env = harness_sanitizer.kept(U8[][]::{ std_at }, arena) })

priv fn check_covered(deps: U8[], arena: Arena$@) //<
    //< Every tracked source that starts a thread is compiled into a program above, or left out
    read: = deps.lines(arena)
    $seen: Sz = 0
    $bad: = List<|U8[]|>(arena)
    for rel in harness.tracked_matching(U8[][]::{ "*.kspl" })
        text: = harness.read_under_root(rel)
        // This file's own spawn is the race written on purpose, raced by `check_fires`.
        if rel.equals(SELF_PATH) ||
            (text.find_str("Thread.spawn").is_none() &&
            text.find_str("kspl_thread_spawn").is_none())
            continue
        seen += 1
        full: = fs.join(harness.root(), rel, arena)
        $held: = false
        for p in read
            held = held || p.equals(full)
        for l in LEFT_OUT
            held = held || l.path.equals(rel)
        if !held
            bad.push(rel)
    verdict.check_list("every source that starts a thread is raced or named as left out", seen,
        "files", bad@, "compile it into a program in this suite, or add it to `left_out` with why")

fn main(): I32
    arena: = harness.begin(64 * 1024 * 1024)
    harness_sanitizer.check_reading_fires("a sanitizer's report is read as one race each",
        Sample[]::REPORT_SAMPLES, races_in, arena)
    work: = harness.sandbox("race")
    said: = harness_sanitizer.runs_with(work, U8[][]::{ "-fsanitize=thread" }, U8[][]::{}, arena)
    if said.len > 0
        lacks: = arena.text().s("the C compiler cannot build with ThreadSanitizer: ").s(said).take()
        ksplc_harness.require_or_skip("the programs that start threads, raced", "KANSO_REQUIRE_TSAN",
            lacks)
        return ksplc_harness.finish()
    check_fires(work, arena)
    defer $deps: = Str_builder()
    $runs: = List<|Raced|>(arena)
    builds: = build_programs(work, deps@, arena)
    race_tests(work, builds@, runs@, arena)
    race_ksai(work, builds@, runs@, arena)
    race_ksai_pool(work, builds@, runs@, arena)
    race_kstls(work, builds@, runs@, arena)
    race_ksagent(work, builds@, runs@, arena)
    race_lsp(work, builds@, runs@, arena)
    run_all_raced(runs@, work, arena)
    check_covered(deps.slice(), arena)
    return ksplc_harness.finish()

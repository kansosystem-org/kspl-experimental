//< Checks that every tracked source is already formatted, and still reads formatted narrow
//< Every tracked source goes through `ksplc fmt` and must come out byte for byte: it is the tree's
//< formatting gate. At a narrow width its output must read back and come out of a second pass
//< unchanged. **It reads the whole tree**, so it lives here; ksplc's own `fmt` and `notation`
//< suites test the formatter and the notation themselves.
//< **The narrow pass runs only when the change reaches `ksplc/`**, and always in GitHub's jobs
//< (`change_reaches` in `tools/ci_gates.kspl`). It is two thirds of the suite's time, and only a
//< change to the formatter or the reader can break it. Left out, it is a `SKIP` line.
//< Caution: **Each `ksplc fmt` takes `FILES_PER_RUN` copies**, and the runs go side by side
//< (`ksplc_harness.run_all`). One process per file spent a quarter of the suite's time starting.
//< Its failure case: `tests/suite/fmt_tree_test.kspl#PARTINGS`, texts that part on a line.
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/math"
import "std/mem" { Arena }
import "std/str"
import "std/subproc"
import "std/verdict"
import "tests/support/harness"
import "tools/ci_gates"

priv const FILES_PER_RUN: Sz = 32 //< the copies one `ksplc fmt` formats, as `make fmt` hands them

priv struct Formatted //< one text after `ksplc fmt`: what it became, or why it did not format
    ok: Bool
    text: U8[] //< the formatted text where `ok`; otherwise the line that says why

priv const FAILED_HEAD: U8[] = "fmt failed on " //< the line before a run's list of failed files
priv const FAILED_ITEM: U8[] = "  -> " //< how that list names one file

priv fn fmt_texts(texts: List<|U8[]|>@, names: List<|U8[]|>@, style: U8[], name: U8[],
    arena: Arena$@): List<|Formatted|> //<
        //< Formats each text under `style` (`--style=`) unless it is empty; one result per text
        //< `names` says what to call each text, where a line says why it did not format.
        //< **Each text is a copy formatted in place**, `<k>.kspl` in a folder of its own, so one
        //< process takes many and the outputs stay apart. **A run that fails on one file formats
        //< the rest**, and lists the failed ones last (`ksplc/main.kspl`). Caution: **A run that
        //< ends with no such list fails every copy it held** (a crash, a timeout): a copy left
        //< unformatted would read as formatted.
    dir: = harness.sandbox(name)
    $copies: = List<|U8[]|>(arena)
    $why: = List<|U8[]|>(arena) // why the k-th text did not format; empty where it did
    for k in Range.asc(texts.len)
        copy: = fs.join(dir, arena.text().s("\{k\}.kspl").take(), arena)
        copies.push(copy)
        $said: U8[] = ""
        io.write_file(copy, texts.get(k)) catch
            said = arena.text().s("its copy cannot be written to ").s(copy).take()
        why.push(said)
    $jobs: = List<|subproc.Job|>(arena)
    for $at: Sz = 0; at < texts.len; at += FILES_PER_RUN
        $argv: = List<|U8[]|>(arena)
        argv.push(ksplc_harness.ksplc_exe())
        argv.push("fmt")
        argv.push("--in-place")
        if style.len > 0
            argv.push(arena.text().s("--style=").s(style).take())
        for k in Range(at, math.min(at + FILES_PER_RUN, texts.len), 1)
            argv.push(copies.get(k))
        jobs.push(subproc.Job::{ .argv = argv.slice(), .cwd = harness.root() })
    runs: = ksplc_harness.run_all(jobs.slice(), name)
    for n in Range.asc(runs.len)
        r: = runs.get(n)
        if r.exited_with(0)
            continue
        listed: = r.out.find_str(FAILED_HEAD).is_some()
        at: = n * FILES_PER_RUN
        for k in Range(at, math.min(at + FILES_PER_RUN, texts.len), 1)
            if why.get(k).len == 0 &&
                (!listed || failed_in(r.out, copies.get(k), arena))
                said: = naming_line(r.out, copies.get(k), arena)
                why.set(k, said.replace(copies.get(k), names.get(k), arena))
    $out: = List<|Formatted|>(arena)
    for k in Range.asc(texts.len)
        if why.get(k).len > 0
            out.push(Formatted::{ .ok = false, .text = why.get(k) })
            continue
        got: = io.read_file(copies.get(k), arena) catch
            out
                .push(Formatted::{ .ok = false,
                .text = arena.text().s("its copy cannot be read back from ").s(copies.get(k)).take() })
            continue
        out.push(Formatted::{ .ok = true, .text = got })
    return out

priv fn failed_in(out: U8[], copy: U8[], arena: Arena$@): Bool //<
    //< whether a run's list of failed files names this copy
    $after: = false
    for line in out.lines(arena)
        if line.find_str(FAILED_HEAD).is_some()
            after = true
        else if after && line.starts_with(FAILED_ITEM) &&
            line.sub_from(FAILED_ITEM.len).equals(copy)
            return true
    return false

priv fn naming_line(out: U8[], copy: U8[], arena: Arena$@): U8[] //<
    //< The first line of a run's output that names this copy, else its first line that is not empty
    for line in out.lines(arena)
        if line.find_str(copy).is_some()
            return line
    for line in out.lines(arena)
        if line.trim_spaces().len > 0
            return line
    return "it ended with no word"

priv fn first_difference(left: U8[], right: U8[]): Sz //<
    //< The first line (1-based) where two texts differ, or 0 where they are the same
    $line: Sz = 1
    for i in Range.asc(math.min(left.len, right.len))
        if left[i] != right[i]
            return line
        if left[i] == '\n'
            line += 1
    return 0 if left.len == right.len else line

priv fn line_of(text: U8[], number: Sz, arena: Arena$@): U8[] //<
    //< line `number` (1-based), empty past the end
    $k: Sz = 1
    for line in text.lines(arena)
        if k == number
            return line
        k += 1
    return ""

priv struct Parting //< a pair showing that the verdict on where two texts differ can fire
    a: U8[]
    b: U8[]
    line: Sz

// Caution: **List pairs that differ beside the pair that does not**, or a verdict answering "the
// same" to everything passes (Principle 5 in `../../docs/DESIGN-principles.md`). The third differs
// only in its last line end.
priv const PARTINGS: Parting[_] = ::{
    Parting::{ .a = "x: = 1\n", .b = "x: = 1\n", .line = 0 },
    Parting::{ .a = "a\n} // c\n", .b = "a // c\n}\n", .line = 1 },
    Parting::{ .a = "a\nb\n", .b = "a\nb", .line = 2 },
    Parting::{ .a = "a\nb\nc\n", .b = "a\nb\nd\n", .line = 3 },
}

priv fn check_parting(arena: Arena$@)
    $bad: = List<|U8[]|>(arena)
    for p in PARTINGS
        got: = first_difference(p.a, p.b)
        if got != p.line
            bad.push(arena.text().s("line \{got\} where \{p.line\} was wanted").take())
    verdict.check_list("the verdict on where two texts part can fire", PARTINGS.len, "pairs", bad@,
        "the judgment misreads its own samples: mend the judgment, not the table")

// ==========================================
// Every tracked source is a fixed point of the formatter
// ==========================================

priv const FMT_SPECS: U8[][_] = ::{ "*.kspl", ":!ksplc/tests/negative/", ":!ksplc/tests/lint/" } //<
    //< The sources formatted
    //< Caution: **Leave out the deliberately broken files** (`ksplc/tests/negative/` unreadable,
    //< `ksplc/tests/lint/` misaligned on purpose, which formatting **realigns**), as `make fmt`
    //< does in `mk/lint.mk`.

priv fn check_formatted(rels: List<|U8[]|>@, arena: Arena$@)
    $bad: = List<|U8[]|>(arena)
    $srcs: = List<|U8[]|>(arena)
    for rel in rels
        srcs.push(harness.read_under_root(rel))
    rs: = fmt_texts(srcs@, rels, "", "fmt_tree", arena)
    // Caution: **Compare with the source itself, not with a second formatting.** A wrong reading
    // is as stable as a right one. So a fixed point of the output passes a moved comment.
    for k in Range.asc(rels.len)
        rel: = rels.get(k)
        r: = rs.get(k)
        if !r.ok
            bad
                .push(arena.text().s(rel).s(": it does not format: ").s(r.text).take())
            continue
        at: = first_difference(srcs.get(k), r.text)
        if at > 0
            bad
                .push(arena.text().s(rel).s(":\{at\}: it formats as `")
                .s(line_of(r.text, at, arena)).s("`").take())
    verdict.check_list("a source is already formatted", rels.len, "sources", bad@,
        "a file not yet formatted: run `make fmt`. It formats with the seed and this check with the \
            compiler under test, so after a change to ksplc's formatter run `make commit-seed` \
            first")

// ==========================================
// At a narrow width every source still reads, and one formatting is final
// ==========================================

priv const NARROW_LIMITS: Sz[_] = ::{ 40, 50, 60 } //<
    //< The column limits the tree is also formatted at
    //< **A narrow width breaks lines where the default never does**: a declaration's head, an
    //< `import`'s list, a `for` heading. **Each source takes one of them in turn** (the `k`th the
    //< `k % 3`th), so the tree is formatted narrow once, not three times.

priv fn narrow_style(index: Sz, arena: Arena$@): U8[] //<
    //< the `--style` the `index`th source is formatted at
    return arena.text().s("ColumnLimit: \{NARROW_LIMITS[index % NARROW_LIMITS.len]\}").take()

priv fn narrow_name(rels: List<|U8[]|>@, index: Sz, arena: Arena$@): U8[] //<
    //< How a finding names the `index`th source: its path and the style it was formatted at
    return arena.text().s(rels.get(index)).s(" at `").s(narrow_style(index, arena)).s("`").take()

priv const NARROW_CHECK: U8[] = "a source formatted at a narrow width reads back, and stays put"

priv const NARROW_FOLDER: U8[] = "ksplc/" //< where a change can break the narrow pass

priv fn check_narrow(rels: List<|U8[]|>@, arena: Arena$@)
    if !ci_gates.change_reaches(NARROW_FOLDER, arena)
        verdict.skip_check(NARROW_CHECK,
            "the change reaches no file under `ksplc/`, where the formatter and the reader are; \
                GitHub's jobs always run it")
        return
    $bad: = List<|U8[]|>(arena)
    // **One width at a time**: a run takes one `--style`, and each source has its own width.
    for w in Range.asc(NARROW_LIMITS.len)
        $which: = List<|Sz|>(arena) // the sources formatted at this width
        $srcs: = List<|U8[]|>(arena)
        $names: = List<|U8[]|>(arena)
        for k in Range.asc(rels.len)
            if k % NARROW_LIMITS.len == w
                which.push(k)
                srcs.push(harness.read_under_root(rels.get(k)))
                names.push(rels.get(k))
        style: = narrow_style(w, arena)
        firsts: =
            fmt_texts(srcs@, names@, style, arena.text().s("fmt_narrow_\{w\}").take(), arena)
        // **The output is formatted again from a file**, which also reads it as a source. This
        // gate does not trust the formatter's own read-back check.
        $outs: = List<|U8[]|>(arena)
        $again_of: = List<|Sz|>(arena) // the place in `which` each second formatting started from
        $again_names: = List<|U8[]|>(arena)
        for n in Range.asc(which.len)
            said: = narrow_name(rels, which.get(n), arena)
            first: = firsts.get(n)
            if !first.ok
                bad
                    .push(arena.text().s(said).s(": it does not format: ").s(first.text).take())
                continue
            outs.push(first.text)
            again_of.push(n)
            again_names.push(rels.get(which.get(n)))
        seconds: =
            fmt_texts(outs@, again_names@, style,
            arena.text().s("fmt_narrow_again_\{w\}").take(), arena)
        for m in Range.asc(again_of.len)
            n: = again_of.get(m)
            said: = narrow_name(rels, which.get(n), arena)
            second: = seconds.get(m)
            if !second.ok
                bad
                    .push(arena.text().s(said).s(": its output does not format again: ")
                    .s(second.text).take())
                continue
            at: = first_difference(firsts.get(n).text, second.text)
            if at > 0
                bad
                    .push(arena.text().s(said).s(": formatting again changes line \{at\} to `")
                    .s(line_of(second.text, at, arena)).s("`").take())
    verdict.check_list(NARROW_CHECK, rels.len, "sources", bad@,
        "the formatter broke a line where the indentation reader does not join it, or its second \
            pass moves what the first wrote: mend `ksplc/fmt/` or `ksplc/parse/layout.kspl`, not \
            the source named")

fn main(): I32
    arena: = harness.begin(64 * 1024 * 1024)
    check_parting(arena)
    rels: = harness.tracked_matching(U8[][]::FMT_SPECS)
    check_formatted(rels@, arena)
    check_narrow(rels@, arena)
    return ksplc_harness.finish()

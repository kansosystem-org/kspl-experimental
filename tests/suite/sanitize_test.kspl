#!/usr/bin/env -S ksplc run
//< ksplc's and std's own tests, built with the memory and undefined-behaviour sanitizers, are clean
//<
//< **This sees what counting bytes cannot.** ksplc's ARC tests judge a balance by the bytes in use
//< (`heap_used_bytes`), which a use after free, a binding left pointing at freed memory or an
//< undefined operation in the generated C leave unchanged. So the language's and std's tests are
//< built through both backends with the sanitizers and run as their own `make test` runs them;
//< any report from any process fails the gate, leaks included, and nothing is suppressed.
//< **Mandatory where `KANSO_REQUIRE_ASAN=1`** (`mk/test.mk` sets it on Linux, whose image holds the
//< runtimes); elsewhere a C compiler or a platform without them gives a `SKIP` line, never a silent
//< pass.
import "ksplc/tests/support/harness" as ksplc_harness
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/mem" { Arena }
import "std/str" // `arena.text()`
import "std/subproc"
import "std/verdict"
import "tests/support/harness"
import "tests/support/sanitizer_build"

// `-g` and the frame pointer keep a report's stack readable down to the `.kspl` line. A report
// stops the program (`-fno-sanitize-recover`), so its exit code says so too. **`-O0`, as the build
// is the cost**: ksplc's tests build in 3 s there and 12 s at `-O1`, and run in about a second
// either way (measured). The sanitizers watch every access at `-O0`.
priv const san_cflags: U8[][_] = ::{ "-O0", "-g", "-fno-omit-frame-pointer",
    "-fsanitize=address,undefined", "-fno-sanitize-recover=all" }

// **What ksplc marks in the IR `--to=llvm` writes** (`--sanitize=`), without which clang's
// `-fsanitize=address` passes over it. Not `undefined`: its checks are clang's front end's, which
// IR does not pass through, so through LLVM they watch the runtime's C alone.
priv const san_marks: U8[] = "address"

// **LeakSanitizer is asked for by name**: where the platform has none (macOS), the runtime refuses
// to start, so the probe says `SKIP` rather than a leak passing unseen.
priv const asan_options: U8[] = "ASAN_OPTIONS=detect_leaks=1"

// ==========================================
// Reading a sanitizer's log
// ==========================================

priv const summary_head: U8[] = "SUMMARY: " //<
    //< the line that closes one report, of either sanitizer

priv fn opens_report(line: U8[]): Bool //< whether the line opens one report
    //<
    //< The address and leak sanitizers open with `==<pid>==ERROR: `, the undefined-behaviour one
    //< with `<file>:<line>:<col>: runtime error: `.
    return line.find_str("==ERROR: ").is_some() ||
        line.find_str(": runtime error: ").is_some()

priv fn reports_of(text: U8[], arena: Arena$@): List<|U8[]|> //<
    //< One line per report in a sanitizer's log: its summary, or its first line where none came
    //<
    //< **A report cut short still counts** (a process killed part way). **A pure function of one
    //< text** (`report_samples`).
    $out: = List<|U8[]|>.new(arena)
    $open: U8[] = ""
    for line in text.lines(arena)
        if opens_report(line)
            if open.len > 0
                out.push(open)
            open = line
        else if open.len > 0 && line.starts_with(summary_head)
            out.push(line.sub_from(summary_head.len))
            open = ""
    if open.len > 0
        out.push(open)
    return out

struct Sample
    text: U8[]
    reports: Sz

priv const report_samples: Sample[_] = ::{
    Sample::{ .text =
        "==1==ERROR: AddressSanitizer: heap-use-after-free on address 0x1\n    #0 0x1 in f \
            a.kspl:10:13\n\nSUMMARY: AddressSanitizer: heap-use-after-free a.kspl:10:13 in f\n",
        .reports = 1 },
    // Two leaks, one report.
    Sample::{ .text =
        "==1==ERROR: LeakSanitizer: detected memory leaks\n\nDirect leak of 4 byte(s)\n\nIndirect \
            leak of 40 byte(s)\n\nSUMMARY: AddressSanitizer: 44 byte(s) leaked in 2 \
            allocation(s).\n", .reports = 1 },
    Sample::{ .text =
        "a.kspl:6:8: runtime error: store to misaligned address\nSUMMARY: \
            UndefinedBehaviorSanitizer: undefined-behavior a.kspl:6:8\n", .reports = 1 },
    // A report cut off before its summary, and one after it.
    Sample::{ .text =
        "AddressSanitizer:DEADLYSIGNAL\n==1==ERROR: AddressSanitizer: SEGV\n==2==ERROR: \
            LeakSanitizer: detected memory leaks\nSUMMARY: AddressSanitizer: 4 byte(s) leaked\n",
        .reports = 2 },
    Sample::{ .text = "", .reports = 0 },
}

priv fn check_reading_fires(arena: Arena$@)
    $bad: = List<|U8[]|>.new(arena)
    for s in report_samples
        if reports_of(s.text, arena).len != s.reports
            bad.push(arena.text().s("misread: ").s(s.text).take())
    verdict.check_list("a sanitizer's log is read as one finding a report", report_samples.len,
        "samples", bad@, "the table is `report_samples`")

priv fn reports_in(log_dir: U8[], arena: Arena$@): List<|U8[]|> //<
    //< Every report the sanitizers logged under log_dir, each process's log a file of its own
    $out: = List<|U8[]|>.new(arena)
    names: = fs.read_dir(log_dir, arena) catch
        return out
    prefix: = arena.text().s(harness.root()).c('/').take()
    for name in names
        text: = io.read_file(fs.join(log_dir, name, arena)) catch
            fallback ""
        for r in reports_of(text, arena)
            out.push(r.replace(prefix, "", arena))
    return out

// ==========================================
// Running a sanitized program
// ==========================================

struct Sanitized //< one sanitized run: the check it reports to, where it runs, and what
    name: U8[] //< the check
    dir: U8[] //< the working directory
    argv: U8[][] //< the program and its arguments
    log_dir: U8[] //< the folder its processes' logs go to, one per run
    env: U8[][] //< `NAME=value` pairs for this run alone

priv fn sanitized_argv(run: Sanitized, arena: Arena$@): U8[][] //<
    //< argv as a sanitized run starts it: its logs in its own folder, `env` set
    //<
    //< **Each process writes its own log** (`asan.<pid>`, `ubsan.<pid>`), so a child the program
    //< starts is heard too.
    $out: = List<|U8[]|>.new(arena)
    out.push("env")
    out
        .push(arena.text().s(asan_options).s(":log_path=")
        .s(fs.join(run.log_dir, "asan", arena)).take())
    out
        .push(arena.text().s("UBSAN_OPTIONS=print_stacktrace=1:log_path=")
        .s(fs.join(run.log_dir, "ubsan", arena)).take())
    for e in run.env
        out.push(e)
    for a in run.argv
        out.push(a)
    return out.slice()

priv fn run_all(runs: List<|Sanitized|>@, work: U8[], arena: Arena$@): List<|verdict.Run_out|> //<
    //< Runs every run side by side, each logging into a fresh folder of its own
    $jobs: = List<|subproc.Job|>.new(arena)
    for r in runs
        fs.mkdir_all(r.log_dir) catch {}
        jobs.push(subproc.Job::{ .argv = sanitized_argv(r, arena), .cwd = r.dir })
    return verdict.run_children(jobs.slice(), fs.join(work, "jobs", arena), arena)

// ==========================================
// Proving it can fire: each fault written on purpose is reported as what it is
// ==========================================

struct Planted //< a program with one fault written on purpose, and what the report must say
    what: U8[] //< the fault, in the check's words
    source: U8[]
    says: U8[] //< a piece of the report's summary that names the fault
    llvm: Bool //< also through the LLVM backend, where its sanitizer sees this fault
        //<
        //< **The address and leak sanitizers' faults are seen there** (`san_marks`); the
        //< undefined-behaviour ones are not, as their checks are clang's front end's.
    unmarked: Bool //< also through LLVM without `san_marks`, where it must go unseen
        //<
        //< **This shows the marks are what watch the IR**: the fault is in KSPL code alone.

// A second way to the memory, through a global, which the compiler's own use-after-free check does
// not follow; written through the local, the compiler refuses it.
priv const use_after_free_source: U8[] =
    """
import "std/mem"

priv $kept: I32$@ = null

fn main(): I32
    p: = mem.alloc_as<|I32|>()
    p$ = 7
    kept = p
    mem.dealloc(Void$@::p)
    return kept$
"""

// **Many lost, not one**: the last pointer may linger in a register or on the stack, where the
// leak check finds it and counts the memory as still held (measured at `-O0`).
priv const leak_source: U8[] =
    """
import "std/mem"

fn main(): I32
    $p: = mem.alloc_as<|I32|>()
    for _i in Range.asc(100)
        p = mem.alloc_as<|I32|>()
    p$ = 7
    return p$ - 7
"""

// **Through a raw address, which nothing but the sanitizer watches**: an index would be stopped by
// KSPL's own bounds check first.
priv const overflow_source: U8[] =
    """
import "std/mem"

fn main(): I32
    p: = U8$@::mem.alloc(16)
    (p + 15)$ = 7
    r: = (p + 16)$
    mem.dealloc(Void$@::p)
    return I32::r
"""

priv const misaligned_source: U8[] =
    """
import "std/mem"

fn main(): I32
    p: = U8$@::mem.alloc(16)
    q: = I32$@::(p + 1)
    q$ = 7
    r: = q$ - 7
    mem.dealloc(Void$@::p)
    return r
"""

priv const planted: Planted[_] = ::{
    Planted::{ .what = "a use after free", .source = use_after_free_source,
        .says = "heap-use-after-free", .llvm = true, .unmarked = false },
    Planted::{ .what = "a read past the end of the heap", .source = overflow_source,
        .says = "heap-buffer-overflow", .llvm = true, .unmarked = true },
    Planted::{ .what = "a leak", .source = leak_source, .says = "leaked", .llvm = true,
        .unmarked = false },
    Planted::{ .what = "a misaligned store", .source = misaligned_source,
        .says = "undefined-behavior", .llvm = false, .unmarked = false },
}

priv fn backend_name(llvm: Bool): U8[] //< the backend, in a check's words
    return "the LLVM backend" if llvm else "the C backend"

priv fn check_fires(work: U8[], arena: Arena$@) //<
    //< Each fault written on purpose is reported, through the same build and run as the tests
    $runs: = List<|Sanitized|>.new(arena)
    $names: = List<|U8[]|>.new(arena)
    $wants: = List<|U8[]|>.new(arena)
    for k in Range.asc(planted.len)
        p: = planted[k]
        src: = fs.join(work, arena.text().s("planted\{k\}.kspl").take(), arena)
        io.write_file(src, p.source) catch
            verdict.check(p.what, false, "cannot write it")
            continue
        // The C backend, the LLVM one marked, and the LLVM one unmarked.
        for way in Range.asc(3)
            llvm: = way > 0
            bare: = way == 2
            if (llvm && !p.llvm) || (bare && !p.unmarked)
                continue
            name: = arena.text().s(p.what).s(" written on purpose, built through ")
                .s(backend_name(llvm))
                .s(" without --sanitize, is not reported" if bare else ", is reported as `")
                .s("" if bare else p.says).s("" if bare else "`").take()
            stem: = arena.text().s("planted\{k\}_\{way\}").take()
            b: = sanitizer_build.build(work, src, fs.join(work, stem, arena),
                U8[][]::san_cflags, llvm, "" if bare else san_marks, arena)
            if b.exe.len == 0
                verdict.check(name, false, b.why)
                continue
            runs
                .push(Sanitized::{ .name = name, .dir = work,
                .argv = sanitizer_build.kept(U8[][]::{ b.exe }, arena),
                .log_dir = fs.join(work, arena.text().s(stem).s("_log").take(), arena),
                .env = U8[][]::{} })
            names.push(name)
            wants.push("" if bare else p.says)
    outs: = run_all(runs@, work, arena)
    for i in Range.asc(runs.len)
        found: = reports_in(runs.get(i).log_dir, arena)
        $named: = false
        for r in found
            named = named || r.find_str(wants.get(i)).is_some()
        why: = arena.text().s("it ended with \{outs.get(i).code\}; the reports:\n")
        for r in found
            why.s(r).c('\n')
        // An unmarked build wants no report at all.
        ok: =
            (found.len == 0 if wants.get(i).len == 0 else named && outs.get(i).code != 0)
        verdict.check(names.get(i), ok, why.take())

// ==========================================
// The packages' own tests, through both backends
// ==========================================

struct Pkg_tests //< a package's own tests, as its own `make test` runs them
    pkg: U8[] //< its folder, from the root, which they run in
    entry: U8[] //< the program, from the root
    takes_ksplc: Bool //< whether they are handed the compiler, to start as a child
    own_folder: Bool //< whether each run takes a fresh folder of its own rather than the package's
        //<
        //< **For tests that write fixed names under the `out/tmp` they run beside**: two builds
        //< run side by side in one folder would write over each other's files.

// **ksplc's and std's**: the language and the library every program holds. The other packages'
// tests exercise what is built on these two.
priv const pkg_tests: Pkg_tests[_] = ::{
    Pkg_tests::{ .pkg = "ksplc", .entry = "ksplc/tests/main.kspl", .takes_ksplc = false,
        .own_folder = false },
    Pkg_tests::{ .pkg = "std", .entry = "std/tests/main.kspl", .takes_ksplc = true,
        .own_folder = true },
}

priv fn sanitize_pkg_tests(work: U8[], arena: Arena$@) //<
    //< Each package's own tests (`make test` in its folder), built through each backend
    $runs: = List<|Sanitized|>.new(arena)
    for t in pkg_tests
        dir: = fs.join(harness.root(), t.pkg, arena)
        entry: = fs.join(harness.root(), t.entry, arena)
        for llvm in Bool[]::{ false, true }
            name: = arena.text().s(t.pkg).s("'s own tests, built through ").s(backend_name(llvm))
                .s(", run with nothing the sanitizers report").take()
            stem: = arena.text().s(t.pkg).s("_llvm" if llvm else "_c").take()
            b: = sanitizer_build.build(dir, entry, fs.join(work, stem, arena),
                U8[][]::san_cflags, llvm, san_marks, arena)
            if b.exe.len == 0
                verdict.check(name, false, b.why)
                continue
            $argv: = List<|U8[]|>.new(arena)
            argv.push(b.exe)
            if t.takes_ksplc
                argv.push(ksplc_harness.ksplc_exe())
            $run_dir: = dir
            if t.own_folder
                run_dir = fs.join(work, arena.text().s(stem).s("_run").take(), arena)
                fs.mkdir_all(run_dir) catch {}
            runs
                .push(Sanitized::{ .name = name, .dir = run_dir, .argv = argv.slice(),
                .log_dir = fs.join(work, arena.text().s(stem).s("_log").take(), arena),
                .env = sanitizer_build.pkg_env(arena) })
    outs: = run_all(runs@, work, arena)
    for i in Range.asc(runs.len)
        found: = reports_in(runs.get(i).log_dir, arena)
        why: = arena.text()
        for r in found
            why.s(r).c('\n')
        code: = outs.get(i).code
        if found.len > 0
            why.s("the whole reports are in ").s(runs.get(i).log_dir)
        else if code != 0
            why.s("it ended with \{code\} and no report:\n").s(outs.get(i).out)
        verdict.check(runs.get(i).name, found.len == 0 && code == 0, why.take())

fn main(): I32
    arena: = harness.begin(16 * 1024 * 1024)
    check_reading_fires(arena)
    work: = harness.sandbox("sanitize")
    said: = sanitizer_build.runs_with(work, U8[][]::{ "-fsanitize=address,undefined" },
        U8[][]::{ asan_options }, arena)
    if said.len > 0
        lacks: = arena.text()
            .s("the C compiler cannot build with the address and undefined-behaviour sanitizers \
                here: ").s(said).take()
        ksplc_harness.require_or_skip("ksplc's and std's own tests, sanitized", "KANSO_REQUIRE_ASAN",
            lacks)
        return ksplc_harness.finish()
    check_fires(work, arena)
    sanitize_pkg_tests(work, arena)
    return ksplc_harness.finish()

#!/usr/bin/env -S ksplc run
//< std builds and tests from a copy alone, as `extract_rest_test.kspl` does every other package
//< **A suite of its own** so that it runs in the other half from the rest of the packages
//< (`SUITES_B` in `mk/test.mk`). Run one after another, the packages were the longest suite.
//< Its failure case: `tests/support/extract.kspl#lost`, a copy with no `lang.kspl`.
import "tests/support/extract"

fn main(): I32
    return extract.run("std", U8[][]::{}, .all)

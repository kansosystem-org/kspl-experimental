//< Feeds broken grammars and broken input to kspeg (`make test-fuzz`)
//< **A grammar and the text it parses both come from outside**: KSPL's own grammar is one, and a
//< program reads its input with it. The program under test ([`read_prog.kspl`](read_prog.kspl))
//< reads a grammar and runs it, or parses input with the JSON and scripting examples. The Makefile
//< builds it with the address sanitizer where the C compiler has its runtime, and says so
//< (`fuzz.Sanitized`). So an out-of-range read stops where it happens.
//< Usage: `ksplc run tests/fuzz_main.kspl <reader> <work folder> [--asan] [--require-asan]`,
//< with `--trials` and `--seed`.
import "std/ds" { List }
import "std/fuzz"
import "std/mem" { Arena }

priv const DEFAULT_SEED: I64 = 20261116
priv const DEFAULT_TRIALS: I64 = 300 //< how many rounds CI scatters, some 100 a kind
    //< **CI's depth**: the seed is fixed, so CI replays the same inputs and shows a regression.
    //< `make fuzz-long` runs deeper, with a fresh seed, to find what this seed never reaches.

priv const TRIAL_TIMEOUT_MS: I32 = 10000 //<
    //< How long to wait before treating a trial as a loop that never ends
    //< Shorter than ksplc's: the largest seed is a grammar of a few hundred lines.

priv const REACH_FLOOR_DIV: Sz = 20 //<
    //< The fewest broken-input trials that must load or parse, as trials / this
    //< **A check only that it does not crash can pass having tried nothing** (Principle 5 in
    //< `docs/DESIGN-principles.md`). **Do not raise it**: it only shows that fuzzing works; the
    //< proportion itself means nothing.

embed "kspeg/docs/kspeg.kspeg" as notation_grammar
embed "kspeg/docs/json.kspeg" as json_grammar
embed "kspeg/docs/script.kspeg" as script_grammar

priv const KINDS: fuzz.Input_kind[3] = ::{ //<
    //< The kinds of input that are fuzzed, and their files' endings
    //< **This is the canonical source**: the names the program under test accepts follow it.
    fuzz.Input_kind::{ .name = "grammar", .ext = ".kspeg" },
    fuzz.Input_kind::{ .name = "json", .ext = ".json" },
    fuzz.Input_kind::{ .name = "script", .ext = ".script" },
}

// Input the two example grammars take. Caution: **Keep each form of its grammar here**: an
// escape, a nested comment, an interpolation, each statement. Mutation cannot reach a form
// missing from the seeds.
priv const JSON_SEEDS: U8[][2] = ::{ "{ \"a\": [1, -2.5e3, 0, true, null], \"b\": \"\\u00e9\\n\", \
    \"c\": {} }\n", "[[], {\"k\": [false, 1E+2, \"\\\\\\/\\b\\f\\r\\t\"]}, -0.5]",
}
priv const SCRIPT_SEEDS: U8[][2] = ::{ "// totals\nlet letter = 1; /* outer /* nested */ still a \
    comment */\nif letter <= 2 && !false { letter = letter * (3 + 4); } else { print(\"$5\"); \
    }\nwhile nil == f(1, 2) { }\nlet s = \"sum: ${ letter /* inside */ + 1 }\\n\";\n",
        "let a = -b % 2 >= c || d != e; { a = g(h)(i, \"x\"); } if a { } else if b { }\n",
}

priv fn collect_seeds(_dirs: U8[][], arena: Arena$@): List<|fuzz.Sample|> //<
    //< The three example grammars, and input of each example; kspeg takes no seed folder
    //< **They must all be read**, as kspeg's own tests read them, so they count as built.
    $out: = List<|fuzz.Sample|>(arena)
    names: U8[][3] = ::{ "kspeg.kspeg", "json.kspeg", "script.kspeg" }
    grammars: U8[][3] = ::{ notation_grammar, json_grammar, script_grammar }
    for i in Range.asc(names.len)
        out
            .push(fuzz.Sample::{ .kind = "grammar", .name = names[i], .data = grammars[i],
            .built = true })
    for doc in JSON_SEEDS
        out
            .push(fuzz.Sample::{ .kind = "json", .name = "a JSON document", .data = doc,
            .built = true })
    for doc in SCRIPT_SEEDS
        out
            .push(fuzz.Sample::{ .kind = "script", .name = "a program", .data = doc,
            .built = true })
    return out

fn main(): I32
    return fuzz.run_main("kspeg", "scatters broken grammars and input at kspeg",
        fuzz.Options::{ .trials = DEFAULT_TRIALS, .seed = DEFAULT_SEED },
        fuzz.Input_kind[]::KINDS, TRIAL_TIMEOUT_MS, REACH_FLOOR_DIV, false, collect_seeds,
        64 * 1024 * 1024)

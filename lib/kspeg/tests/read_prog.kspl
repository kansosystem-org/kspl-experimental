//< Reads one outside text through kspeg, as a grammar or as input to a fixed grammar
//< `make test-fuzz` runs its mutated texts through this program.
//< **kspeg takes two texts from outside**: a grammar someone wrote, read by the hand-written
//< reader (`kspeg/notation`), and the input that grammar parses, read by the engine
//< (`kspeg/engine`). Both are fed here.
//< Caution: **Do not stop at reading a grammar.** A grammar that loads is run on three inputs, as
//< a program would run it, so a rule shape only a broken grammar holds reaches the engine.
//< **The exit code is the only answer**: 0 "read and used", 1 "refused". **A tree that breaks
//< its own contract stops with `assert`**, counted as an announced stop.
//< Usage: `read_prog <kind> <file>`, the kinds `tests/fuzz_main.kspl` names.
import "kspeg/engine" as kspeg
import "kspeg/notation" as kspeg_notation
import "kspeg/rule" { Kspeg_signal }
import "std/bytes" // `copy_from`
import "std/chars"
import "std/ds"
import "std/io"
import "std/mem" { Arena, alloc, dealloc }
import "std/strfmt" as _strfmt
import "std/sys"

embed "kspeg/docs/kspeg.kspeg" as notation_grammar //< the notation written in itself
embed "kspeg/docs/json.kspeg" as json_grammar
embed "kspeg/docs/script.kspeg" as script_grammar

// What a grammar that loads is run on: a JSON document and a program. Its own text is the third.
priv const JSON_DOC: U8[] = "{ \"a\": [1, -2.5e3, true, null], \"b\": \"\\u00e9\" }\n"
priv const SCRIPT_DOC: U8[] =
    "let x = 1; if x <= 2 { x = x * (3 + 4); } else { print(\"${ x }\"); }\n"

// The value that what was read is mixed into.
// Caution: **Do not just count the nodes**, or a mix-up in their text does not show.
priv $used: U64 = 0

priv const MIX: U64 = 0x100000001B3U64 //< the multiplier; it wraps on overflow, used only to mix

priv fn use_bytes(data: U8[])
    for b in data
        used = (used ^ U64::b) * MIX

priv fn use_len(len: Sz)
    used = (used ^ U64::len) * MIX

priv fn exact(raw: U8[]): U8[] //< a copy on the heap of exactly `raw.len` bytes
    //< **`io.read_file` keeps a byte of room after the text**, so a read one past its end would
    //< go unseen. Here the address sanitizer stops it.
    out: = U8$[]::{ .ptr = U8$@::alloc(raw.len), .len = raw.len }
    out.copy_from(0, raw)
    return out

priv fn is_leaf(kind: U8[]): Bool //< a node whose text is the source it matched
    //< A rule's node holds its rule's name instead (`Rule.parse` in `kspeg/engine`).
    return kind.equals("Literal") || kind.equals("Keyword") || kind.equals("Wildcard") ||
        kind.equals("Char_class") || kind.equals("Broken")

priv fn check_tree(node: kspeg.Node@, source: U8[]) //<
    //< Every node starts inside the source, and a leaf's text is the source where it starts
    assert(node.offset <= source.len, "kspeg: a node starts past the end of the source")
    use_bytes(node.kind)
    use_len(node.offset)
    if is_leaf(node.kind)
        assert(node.text.len <= source.len - node.offset,
            "kspeg: a leaf's text runs past the end of the source")
        assert(source.sub(node.offset, node.text.len).equals(node.text),
            "kspeg: a leaf's text is not the source where it starts")
        use_bytes(node.text)
    for kid in node.children
        check_tree(kid, source)

priv fn parse_with(grammar: kspeg.Target$@, rule: U8[], input: U8[], arena: Arena$@): Bool //<
    //< Parses `input` with a grammar already read, from `rule`; whether it parsed
    //< A refusal is used too: its message, or the place the parse stopped.
    $t: = kspeg.Target(input, arena)
    defer t.free_memo()
    t.share_grammar_from(grammar)
    got: = t.parse_rule(rule) catch e
        switch e
        case .fatal(msg)
            use_bytes(msg)
        case .mismatch
            use_len(t.fail.max_fail_pos)
            assert(t.fail.max_fail_pos <= input.len,
                "kspeg: a refusal names a place past the end of the input")
        return false
    if node: = got
        check_tree(node, input)
    return true

priv fn load(text: U8[], arena: Arena$@): kspeg.Target$@!Kspeg_signal //< a grammar read
    $meta: = kspeg_notation.Meta(text, arena)
    return meta.parse_grammar()!

priv fn read_grammar(text: U8[], arena: Arena$@): I32 //<
    //< Reads a grammar; one that loads is run from its first rule on three inputs
    grammar: = load(text, arena) catch e
        switch e
        case .fatal(msg)
            use_bytes(msg)
        case .mismatch {}
        return 1
    defer grammar.free_memo()
    // **What the reader takes, the notation's own grammar takes too**: it is the normative one
    // ("Appendix A" in `lib/kspeg/docs/SPEC-notation.md`).
    notation: = load(notation_grammar, arena) catch
        panic("kspeg: the notation's own grammar does not load")
    defer notation.free_memo()
    assert(parse_with(notation, "grammar", text, arena),
        "kspeg: the reader takes a grammar the notation's own grammar refuses")
    rules: = grammar.keywords_by_rule()
    assert(rules.len > 0, "kspeg: a grammar loaded with no rule")
    first: = rules.get(0).rule_name
    for r in rules
        use_bytes(r.rule_name)
        for kw in r.keywords
            use_bytes(kw)
    inputs: U8[][3] = ::{ text, JSON_DOC, SCRIPT_DOC }
    for input in inputs
        _parsed: = parse_with(grammar, first, input, arena)
    return 0

priv fn read_input(grammar_text: U8[], rule: U8[], input: U8[], arena: Arena$@): I32 //<
    //< Parses `input` with one of the example grammars, from `rule`
    grammar: = load(grammar_text, arena) catch
        panic("kspeg: an example grammar does not load")
    defer grammar.free_memo()
    return 0 if parse_with(grammar, rule, input, arena) else 1

fn main(): I32
    args: = sys.args()
    if args.len < 3
        io.err().s("usage: read_prog <grammar|json|script> <file>\n")
        return 2
    raw: = io.read_file(args[2], null) catch
        io.err().s("cannot read: \{args[2]\}\n")
        return 2
    src: = exact(raw)
    dealloc(Void$@::raw.ptr)
    // The address sanitizer's leak check counts a buffer still held at the exit as a finding.
    defer dealloc(Void$@::src.ptr)
    defer arena: = Arena(64 * 1024 * 1024)
    $code: I32 = 2
    if args[1].equals("grammar")
        code = read_grammar(src, arena)
    else if args[1].equals("json")
        code = read_input(json_grammar, "json", src, arena)
    else if args[1].equals("script")
        code = read_input(script_grammar, "program", src, arena)
    else
        io.err().s("unknown kind\n")
    // Caution: **Print the mixed value**, or the reading above could be optimized away entirely.
    io.out().s("used=\{used\}\n")
    return code

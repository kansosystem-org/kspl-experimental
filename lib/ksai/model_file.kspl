//< Reads a ksai model from a file, and writes one back
//< **This is the only place in `ksai` that imports `std/io` and `std/fs`.** Safetensors, GGUF and
//< lora take bytes already in memory, and a writer to write into. So bare-metal code skips this
//< file. It passes `embed`ed bytes through `Safetensors.load_from_bytes` or `Gguf.parse`, and gets
//< its bytes back from `Safetensors_writer.finish()`.
import "ksai/gguf" { Gguf, Gguf_error }
import "ksai/safetensors" as st
import "ksai/tensor"
import "std/fs"
import "std/io"
import "std/mem" { Arena, SZ_MAX }

pub fn load_safetensors( //< reads and parses a model file into the caller's arena
    //< The file and parsed header share the arena lifetime. Free or reset the arena after all
    //< tensors borrowing its weights are no longer used.
    path: U8[], //< the file to read
    arena: Arena$@, //< the arena the name-to-tensor index is allocated from
): st.Safetensors!st.Safetensors_error //< the parsed file; fails if it cannot be read or parsed
    tensor.require_arena(arena)
    // **Read straight into the arena**: read onto the heap and copied over, the file is held twice
    // at the peak. `read_file_capped` sizes its one buffer from the file.
    file_data: = io.read_file_capped(path, SZ_MAX, arena) catch
        throw .read_failed
    return st.Safetensors.load_from_bytes(file_data, arena)!

pub fn load_gguf( //< reads and parses a GGUF model file into the caller's arena
    //< **The file is read once, straight into the arena, and its tensors are used where they lie.**
    //< So the peak memory is the file's size, plus the lists of keys and tensors. Free or reset
    //< the arena after every matrix and value read from the file is no longer used.
    path: U8[], //< the file to read
    arena: Arena$@, //< where the file's bytes and the parsed lists go
): Gguf!Gguf_error //< the parsed file; fails if it cannot be read, or is refused as broken
    tensor.require_arena(arena)
    file_data: = io.read_file_capped(path, SZ_MAX, arena) catch
        throw .read_failed
    return Gguf.parse(file_data, arena)!

pub fn save_safetensors( //< writes what a writer has collected as a model file
    //< **A crash or a power cut midway leaves the old file or the new**, never a model cut short.
    //< `finish` builds the whole file in memory, then hands it to `fs.replace_file`.
    w: st.Safetensors_writer$@, //< the writer, closed by this call
    path: U8[], //< the file to write or replace; its folder must exist
): Void!st.Safetensors_error
    defer $out: = w.finish()
    fs.replace_file(path, out.slice(), .kept) catch
        throw .write_failed

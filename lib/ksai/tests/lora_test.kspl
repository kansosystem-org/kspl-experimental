//< LoRA adapters at inference
import "ksai/attention_train" as _attn_train // Self_attention's train_forward_lora
import "ksai/block_train" as _block_train // Transformer_block's train_forward_lora
import "ksai/lora" { Lora }
import "ksai/nn" as ai_nn
import "ksai/tensor" { Tensor }
import "std/math"
import "std/mem" { Arena }
import "std/prng"
import "std/verdict"

// ==========================================
// `forward_lora` with adapters given, matched against a path that adds them another way.
// Caution: **Give each adapter a B that is not zero.** A new adapter's B is zero, so its delta is
// zero, and an adapter that is never added gives the same output.
// ==========================================
priv fn spread(t: Tensor<|F64|>, seed: Sz) //< sets one weight to deterministic, varied values
    for i in Range.asc(t.size)
        k: = (i * 7 + seed * 13) % 11
        (t.data + i)$ = 0.09 * (F64::k) - 0.4

priv fn adapter(in_dim: Sz, out_dim: Sz, seed: Sz, rng: prng.Prng$@, arena: Arena$@): Lora<|F64|> //<
    //< An adapter whose B is not zero, so its delta changes the output
    l: = Lora<|F64|>(in_dim, out_dim, 2, 4.0, rng, arena)
    spread(l.b, seed)
    return l

priv fn sequence(rows: Sz, d: Sz, arena: Arena$@): Tensor<|F64|> //< an input that varies, [rows,d]
    shape: Sz[2] = ::{ rows, d }
    x: = Tensor<|F64|>(Sz[]::shape, arena)
    for i in Range.asc(x.size)
        (x.data + i)$ = 0.1 * (F64::i) - 0.5
    return x

priv fn row_of(x: Tensor<|F64|>, t: Sz, arena: Arena$@): Tensor<|F64|> //< row t of x, as [1,d]
    d: = x.shape[1]
    shape: Sz[2] = ::{ 1, d }
    r: = Tensor<|F64|>(Sz[]::shape, arena)
    for i in Range.asc(d)
        (r.data + i)$ = (x.data + t * d + i)$
    return r

priv fn row_gap(whole: Tensor<|F64|>, t: Sz, row: Tensor<|F64|>): F64 //<
    //< The largest difference between row t of `whole` and `row`
    $gap: = 0.0
    for i in Range.asc(row.size)
        gap = math.max(gap,
            math.abs((whole.data + t * row.size + i)$ - (row.data + i)$))
    return gap

priv fn largest_gap(a: Tensor<|F64|>, b: Tensor<|F64|>): F64 //< the largest elementwise difference
    assert(a.size == b.size, "largest_gap: the sizes differ")
    $gap: = 0.0
    for i in Range.asc(a.size)
        gap = math.max(gap, math.abs((a.data + i)$ - (b.data + i)$))
    return gap

fn test_attention_forward_lora_matches_training(arena: Arena$@) //<
    //< Inference's `Self_attention.forward_lora`, a row at a time, gives training's output
    verdict.start("[LoRA] Self_attention.forward_lora with adapters matches train_forward_lora...")
    seqn: Sz = 3
    d: Sz = 4
    $att: = ai_nn.Self_attention<|F64|>(d, seqn, arena)
    spread(att.wq.weights, 1)
    spread(att.wk.weights, 2)
    spread(att.wv.weights, 3)
    spread(att.wo.weights, 4)
    $rng: = prng.Prng(11U64)
    $q: = adapter(d, d, 5, rng@, arena)
    $v: = adapter(d, d, 6, rng@, arena)
    x: = sequence(seqn, d, arena)
    trained: = att.train_forward_lora(x, q@, v@).out
    assert(largest_gap(trained, att.train_forward(x).out) > 1.0e-3,
        "the adapters must change the output, or the test proves nothing")
    for t in Range.asc(seqn)
        got: = att.forward_lora(row_of(x, t, arena), t, q@, v@)
        assert(row_gap(trained, t, got) < 1.0e-9,
            "Self_attention.forward_lora must give train_forward_lora's row")
    verdict.pass("every row agrees, with the adapters on Q and V")

fn test_block_forward_lora_matches_training(arena: Arena$@) //<
    //< Inference's `Transformer_block.forward_lora`, a row at a time, gives training's output
    verdict.start("[LoRA] Transformer_block.forward_lora with adapters matches training...")
    seqn: Sz = 3
    d: Sz = 4
    $blk: = ai_nn.Transformer_block<|F64|>(d, 6, seqn, 1.0e-5, arena)
    spread(blk.attention.wq.weights, 1)
    spread(blk.attention.wk.weights, 2)
    spread(blk.attention.wv.weights, 3)
    spread(blk.attention.wo.weights, 4)
    spread(blk.ffn.fc1.weights, 5)
    spread(blk.ffn.fc2.weights, 6)
    $rng: = prng.Prng(13U64)
    $q: = adapter(d, d, 7, rng@, arena)
    $v: = adapter(d, d, 8, rng@, arena)
    x: = sequence(seqn, d, arena)
    // Inference's block carries no adapter on the feed-forward part, so training's gets none.
    trained: = blk.train_forward_lora(x, q@, v@, null, null).out
    assert(largest_gap(trained, blk.train_forward(x).out) > 1.0e-3,
        "the adapters must change the output, or the test proves nothing")
    for t in Range.asc(seqn)
        got: = blk.forward_lora(row_of(x, t, arena), t, q@, v@)
        assert(row_gap(trained, t, got) < 1.0e-9,
            "Transformer_block.forward_lora must give train_forward_lora's row")
    verdict.pass("every row agrees, with the adapters on Q and V")

priv fn merge(w: Tensor<|F64|>, l: Lora<|F64|>$@) //< adds the adapter's delta into the weights
    //< w[i,j] += scale * Σ_r A[i,r]·B[r,j], the weights an adapter is equal to once merged
    rank: = l.a.shape[1]
    out_dim: = w.shape[1]
    for i in Range.asc(w.shape[0])
        for j in Range.asc(out_dim)
            $s: = 0.0
            for k in Range.asc(rank)
                s += (l.a.data + i * rank + k)$ * (l.b.data + k * out_dim + j)$
            (w.data + i * out_dim + j)$ = (w.data + i * out_dim + j)$ + l.scale * s

priv fn gqa(arena: Arena$@): ai_nn.Gqa_attention<|F64|> //< two query heads sharing one key head
    g: = ai_nn.Gqa_attention<|F64|>(4, 2, 1, 2, 3, 10000.0, arena)
    spread(g.wq.weights, 1)
    spread(g.wk.weights, 2)
    spread(g.wv.weights, 3)
    spread(g.wo.weights, 4)
    return g

fn test_gqa_forward_lora_matches_merged_weights(arena: Arena$@) //<
    //< `Gqa_attention.forward_lora` gives what `forward` gives with the adapters merged in
    //< It has no training form, so the adapters are merged into a copy's weights instead.
    verdict.start("[LoRA] Gqa_attention.forward_lora with adapters matches merged weights...")
    $with_lora: = gqa(arena)
    $merged: = gqa(arena)
    $rng: = prng.Prng(17U64)
    $q: = adapter(4, 4, 5, rng@, arena)
    $v: = adapter(4, 2, 6, rng@, arena)
    merge(merged.wq.weights, q@)
    merge(merged.wv.weights, v@)
    x: = sequence(3, 4, arena)
    got: = with_lora.forward_lora(x, 0, q@, v@)
    want: = merged.forward(x, 0)
    $plain: = gqa(arena)
    assert(largest_gap(want, plain.forward(x, 0)) > 1.0e-3,
        "the adapters must change the output, or the test proves nothing")
    assert(largest_gap(got, want) < 1.0e-9,
        "Gqa_attention.forward_lora must give the output of the merged weights")
    verdict.pass("every row agrees, with the adapters on Q and V")

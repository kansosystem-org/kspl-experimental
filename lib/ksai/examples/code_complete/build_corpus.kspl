#!/usr/bin/env -S ksplc run
//< Stage 0 / ①: building the KSPL corpus
//< It collects every source under the folders named and can normalize them through ksplc fmt. It
//< drops duplicates by content hash, splits deterministically into train/val per file, and writes
//< JSONL. With no folder named, it takes the Kanso repository's, run from its root.

// ==========================================
// What it writes:
//   out/code_complete/corpus/{train,val}.jsonl   each line {"path":..., "code":...}
//   out/code_complete/corpus/stats.json
// ==========================================
// Usage:
//   ./out/build_corpus.exe [<folder>...]                 build from the raw sources
//   ./out/build_corpus.exe --fmt [--ksplc=<compiler>]    normalize through ksplc fmt, then build
// ==========================================
import "ksai/examples/code_complete/corpus_count" as count
import "ksai/examples/code_complete/ksplc_oracle" as oracle
import "std/argparse"
import "std/chars"
import "std/ds" { List }
import "std/fs"
import "std/io"
import "std/math"
import "std/mem" + { Arena, dealloc }
import "std/seq" // `order_by`
import "std/sha256"
import "std/str" { Str_builder }
import "std/subproc"
import "std/sys"
import "std/thread"

priv const STATS_PATH: U8[] = "out/code_complete/corpus/stats.json" //< the corpus's counts
priv const VAL_EVERY: Sz = 10 // one file in every ten goes to validation, deterministically
priv const FMT_TIMEOUT_MS: I32 = 60000
priv const OUTPUT_CAP: Sz = 4 * 1024 * 1024
priv const NUM_FMT_WORKERS: Sz = 8 //<
    //< How many workers normalize() runs under --fmt, each starting a ksplc child per file
    //< The work is mostly waiting on I/O, so it need not match the CPU core count. A fixed value
    //< avoids adding an OS-dependent way to read the core count.

priv struct Rec
    path: U8[]
    code: U8[]

priv struct Agg
    files: Sz
    bytes: Sz
    lines: Sz
    approx_tokens: Sz
// ==========================================
// ① Collecting the files: every source under the roots, recursively, except ksplc/tests/negative
// (invalid on purpose). The train/val split depends on the files' order, so the OS's listing order
// would change it between runs.
// ==========================================
priv const KANSO_ROOTS: U8[][_] = ::{ "ksos", "ksplc", "lib/ksai/examples", "std", "tests" } //<
    //< The folders taken when none is named: the Kanso repository's, from its root
    //< They are in lexicographic order, so the listing equals one sorted all at once; change it and
    //< the train/val split moves.

priv fn find_kspl_files(roots: U8[][], arena: Arena$@): List<|U8[]|>$@
    list: = List<|U8[]|>.create(arena)
    for i in Range.asc(roots.len)
        // **A missing folder stops the run**: a corpus quietly missing part is a smaller corpus
        // that looks like a whole one.
        files: = fs.walk_files(roots[i], count.skip_dir, arena) catch
            io.err().s("[error] cannot read the folder \{roots[i]\}\n")
            sys.exit(1)
        for path in files
            if path.ends_with(".kspl")
                list.push(path)
    return list

// ==========================================
// ② Normalizing (through ksplc fmt only with --fmt; on a failure it falls back to the raw source)
// ==========================================
priv fn normalize(rel_path: U8[], use_fmt: Bool, arena: Arena$@): U8$[]
    raw: = io.read_file(rel_path, null)
        catch panic("cannot read a file just found by the directory walk")
    defer dealloc(Void$@::raw.ptr)
    raw_copy: = arena.dup_str(raw)
    if !use_fmt
        return raw_copy

    argv: = U8[][]::{ oracle.ksplc(), "fmt", rel_path }
    out: = subproc.run(argv, "", FMT_TIMEOUT_MS, OUTPUT_CAP, arena) catch ""
    if out.len > 0
        return out
    io.err().s("  [warn] fmt failed on \{rel_path\}\n")
    return raw_copy
// ==========================================
// ②' Parallel fmt: ksplc fmt is independent per file, so a thread pool runs it. The workers take
// `files` round-robin: sorted paths put similar files side by side, so contiguous ranges could
// give one worker all the large ones.
// ==========================================
priv struct Fmt_worker_args
    files: List<|U8[]|>$@ //< shared read-only (disjoint indices, no contention)
    use_fmt: Bool
    worker_id: Sz
    num_workers: Sz
    worker_arena: Arena$@ //< this worker's own (no other thread touches it)
    results: Rec$@ //< shared, but written only at the indices assigned

extern fn fmt_worker_entry(arg: Fmt_worker_args$@): Void$@ //<
    //< one worker's share of the formatting
    n: = arg.files.len
    for $i: Sz = arg.worker_id; i < n; i += arg.num_workers
        rel: = arg.files[i]
        code: = normalize(rel, arg.use_fmt, arg.worker_arena)
        (arg.results + i)$ = Rec::{ .path = rel, .code = code }
    return null

priv fn normalize_all(files: List<|U8[]|>$@, use_fmt: Bool, arena: Arena$@): List<|Rec|>$@ //<
    //< Runs normalize() on every file in `files` (starting ksplc fmt with --fmt)
    //< Without --fmt it only reads files, so it runs in order (threads would cost more). The result
    //< keeps the `files` order (the caller's dedup and train/val split depend on it).
    result: = List<|Rec|>.create(arena)
    n: = files.len
    if !use_fmt || n == 0
        for rel in files
            code: = normalize(rel, use_fmt, arena)
            result.push(Rec::{ .path = rel, .code = code })
        return result

    num_workers: = math.min(NUM_FMT_WORKERS, n)
    results: = Rec$@::arena.alloc(n * sizeof(Rec))

    worker_arenas: = List<|Arena$@|>.create(arena)
    threads: = List<|thread.Thread|>.create(arena)
    for w in Range.asc(num_workers)
        wa: = mem.new(Fmt_worker_args::{})
        wa.files = files
        wa.use_fmt = use_fmt
        wa.worker_id = w
        wa.num_workers = num_workers
        wa.worker_arena = Arena(64 * 1024 * 1024)
        wa.results = results
        worker_arenas.push(wa.worker_arena)

        t: = thread.Thread.spawn<|Fmt_worker_args|>(fmt_worker_entry, wa)
            catch panic("failed to spawn fmt worker thread")
        threads.push(t)
    for i in Range.asc(threads.len)
        threads[i].free()

    // `code` lives in each worker's arena, so it is copied into the caller's arena before those are
    // freed (`path` already lives with `files`).
    for i in Range.asc(n)
        rec: = (results + i)$
        result.push(Rec::{ .path = rec.path, .code = arena.dup_str(rec.code) })
    for worker_arena in worker_arenas
        worker_arena.free()
    return result

priv fn write_records(path: U8[], recs: List<|Rec|>@)
    $f: = io.open(path, "w") catch panic("cannot open output file for writing")
    defer $b: = Str_builder()
    for rec in recs
        b.clear()
        b.s("{\"path\":\"").escape_and_append(rec.path).s("\",\"code\":\"")
            .escape_and_append(rec.code).s("\"}\n")
        f.s(b.slice())
    oracle.close_or_die(f@, path)

priv fn agg(recs: List<|Rec|>@): Agg
    $b: Sz = 0
    $ln: Sz = 0
    $tk: Sz = 0
    for rec in recs
        code: = rec.code
        b += code.len
        ln += count.count_lines(code)
        tk += count.approx_tokens(code)
    return Agg::{ .files = recs.len, .bytes = b, .lines = ln, .approx_tokens = tk }

priv fn write_agg(w: Writer, a: Agg): Writer
    return w
        .s("{\"files\":\{a.files\},\"bytes\":\{a.bytes\},\"lines\":\{a.lines\},\"approx_tokens\":\{a.approx_tokens\}}")

priv fn write_stats(use_fmt: Bool, dups: Sz, total: Agg, train: Agg, val: Agg)
    $f: = io.open(STATS_PATH, "w") catch panic("cannot open stats.json for writing")
    f
        .s("{\n  \"normalized_with_fmt\":\{use_fmt\},\n  \"duplicates_removed\":\{dups\},\n  \
            \"total\":")
    write_agg(f, total).s(",\n  \"train\":")
    write_agg(f, train).s(",\n  \"val\":")
    write_agg(f, val).s("\n}\n")
    oracle.close_or_die(f@, STATS_PATH)
// ==========================================
// ③ Dropping duplicates: **found by sorting the content digests, not in a `Map`**. The keys come
// from the files read, and keys from outside never reach a `Map`. The sort is stable, so the first
// of equal files stays, as in the files' order.
// ==========================================
priv struct Digest_at //< one file's content digest, and where the file stands in the list
    hex: U8[]
    at: Sz

priv fn repeats(recs: List<|Rec|>@, arena: Arena$@): List<|Bool|> //<
    //< For each file, whether an earlier one has the same content
    $keyed: = List<|Digest_at|>(arena)
    $out: = List<|Bool|>(arena)
    for i in Range.asc(recs.len)
        digest: = sha256.hash(recs[i].code)
        $hex: U8[sha256.HEX_LEN] = ::{}
        sha256.write_hex(digest, U8$[]::hex)
        keyed.push(Digest_at::{ .hex = arena.dup_str(U8$[]::hex), .at = i })
        out.push(false)
    sorted: = keyed.order_by(fn(a: Digest_at@, b: Digest_at@; ): I32 {
        return a.hex.compare(b.hex);
    }, arena)
    for k in Range(1, sorted.len, 1)
        if sorted.get(k).hex.equals(sorted.get(k - 1).hex)
            out.set(sorted.get(k).at, true)
    return out

// ==========================================
// main
// ==========================================
fn main() //< collects the sources under the folders named into the train/val corpus
    defer arena: = Arena(512 * 1024 * 1024)
    $use_fmt: = false
    $ksplc: U8[] = ""
    p: = argparse.Parser
        .create(sys.program_name(), "make a training corpus from the sources in the folders named",
        arena)
    p.flag("--fmt", use_fmt@, "normalize through ksplc fmt before building")
    p.str_opt("--ksplc", ksplc@, oracle.ksplc_option())
    p.positional("[<folder>...]")
    p.parse_or_exit()
    oracle.use_ksplc(ksplc)
    roots: =
        (U8[][]::KANSO_ROOTS if p.rest.len == 0 else U8[][]::p.rest.slice())
    if use_fmt
        _ran: =
            subproc.run(U8[][]::{ oracle.ksplc(), "info", "std-dir" }, "", FMT_TIMEOUT_MS,
            OUTPUT_CAP, arena) catch
                io.err()
                    .s("[error] --fmt needs a ksplc that runs: \{oracle.ksplc()\}. Name one with \
                        --ksplc=\n")
                sys.exit(1)

    // Creating a folder that already exists fails harmlessly, so the error is ignored.
    fs.mkdir_all(oracle.CORPUS_DIR) catch {}

    files: = find_kspl_files(roots, arena)
    normalized: = normalize_all(files, use_fmt, arena)

    repeated: = repeats(normalized, arena)
    records: = List<|Rec|>.create(arena)
    $dups: Sz = 0
    for i in Range.asc(normalized.len)
        if repeated.get(i)
            dups += 1
            continue
        records.push(normalized[i])

    train: = List<|Rec|>.create(arena)
    val: = List<|Rec|>.create(arena)
    for i in Range.asc(records.len)
        if i % VAL_EVERY == VAL_EVERY - 1
            val.push(records[i])
        else
            train.push(records[i])

    write_records("out/code_complete/corpus/train.jsonl", train)
    write_records("out/code_complete/corpus/val.jsonl", val)

    total_agg: = agg(records)
    train_agg: = agg(train)
    val_agg: = agg(val)
    write_stats(use_fmt, dups, total_agg, train_agg, val_agg)

    io.out()
        .s("corpus built (fmt=\{use_fmt\}): \{total_agg.files\} files, \{total_agg.lines\} lines, \
            \{total_agg.bytes\} bytes, ~\{total_agg.approx_tokens\} tokens (dedup removed \
            \{dups\})\n")
    io.out().s("  train: \{train_agg.files\} files / ~\{train_agg.approx_tokens\} tok\n")
    io.out().s("  val  : \{val_agg.files\} files / ~\{val_agg.approx_tokens\} tok\n")
    io.out().s("  -> out/code_complete/corpus/{train,val}.jsonl, stats.json\n")

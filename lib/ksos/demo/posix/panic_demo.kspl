//< The kernel's stops: each misuse panics instead of going on silently, one chosen per run
//< `panic_demo <which>` runs one: `stack-overflow`, `mutex-relock`, `mutex-foreign-unlock`,
//< `delete-holder`, `timeout-zero`, `event-no-bits`, `stop-outside`, `wait-masked`,
//< `delay-before-start` or `create-again`. **Success is the panic**, so
//< `ksos-<which>` greps the output for the kernel's own message (`ksos_posix_panic_needle_<which>`
//< in `../../Makefile`). One run is one stop: a panic ends the process, so the scenarios cannot
//< share a run.
import "ksos/kernel/sync"
import "ksos/kernel/task" + { Task }
import "std/ds"
import "std/io"
import "std/sys"

$g_mutex: sync.Mutex
$g_sem: sync.Sem
$g_event: sync.Event
$tcb: Task
$tcb_other: Task
$stack: U8[65536]
$stack_other: U8[65536]

// ==========================================
// stack-overflow: the canary that task_create plants. The demo does not overflow by deep
// recursion. The bytes one call uses depend on the optimization level, the ABI and the debug
// information. And recursing can step into unmapped memory and cause a real SEGV instead.
// ==========================================
fn overflow_task(_arg: Void$@): Void
    io.out().s("=== Kanso OS (POSIX) stack-overflow canary guard ===\n")
    io.out().s("[overflow] clobbering this task's stack-guard canary...\n")
    // Overwrite the canary that task_create wrote into stack[0..stack_guard_bytes) directly (the
    // same state a real overflow leaves when it reaches there).
    stack[0] = 0x00
    Task.yield() // schedule() checks this task's canary here and panics
    io.out().s("[overflow] UNEXPECTED: returned without triggering the guard\n")

// ==========================================
// mutex-relock: when the holder locks the mutex again, the kernel panics instead of waiting
// forever. Waiting silently, the task would wait for itself to let go: a hang with no diagnosis.
// ==========================================
fn relocker(_arg: Void$@): Void
    io.out().s("=== Kanso OS (POSIX) mutex re-lock by the holder ===\n")
    g_mutex.lock()
    io.out().s("[relock] holding; locking again must stop here\n")
    g_mutex.lock()
    io.out().s("[relock] returned from the second lock without a panic\n")

// ==========================================
// mutex-foreign-unlock: when a task that does not hold the mutex unlocks it, the kernel panics.
// Ignored, the caller would go on believing it had released the lock, and a stretch of code with
// no mutual exclusion would go undiagnosed.
// ==========================================
fn owner(_arg: Void$@): Void
    io.out().s("=== Kanso OS (POSIX) mutex unlock by a non-holder ===\n")
    g_mutex.lock()
    io.out().s("[owner] holding; handing the CPU to the other task\n")
    Task.yield()
    g_mutex.unlock()

fn other(_arg: Void$@): Void
    io.out().s("[other] unlocking a mutex I do not hold; this must stop here\n")
    g_mutex.unlock()
    io.out().s("[other] returned from unlock without a panic\n")

// ==========================================
// delete-holder: deleting a task that holds a mutex panics. Nobody could unlock the mutex again, so
// every later lock would wait forever, and after delete_dyn the mutex would name freed memory.
// ==========================================
fn holding(_arg: Void$@): Void
    io.out().s("=== Kanso OS (POSIX) deleting a mutex holder ===\n")
    g_mutex.lock()
    io.out().s("[holding] holding; handing the CPU to the deleter\n")
    Task.yield()
    g_mutex.unlock()

fn deleter(_arg: Void$@): Void
    io.out().s("[deleter] deleting the holder; this must stop here\n")
    tcb.delete()
    io.out().s("[deleter] returned from delete without a panic\n")

// ==========================================
// timeout-zero: a timeout of 0 panics instead of silently meaning `try_`. If 0 meant "do not
// wait", the same thing could be written two ways, `try_take` and `take_for(0)`.
// ==========================================
fn zero_waiter(_arg: Void$@): Void
    io.out().s("=== Kanso OS (POSIX) take_for with a zero deadline ===\n")
    io.out().s("[zero] take_for(0) must stop here\n")
    got: = g_sem.take_for(0)
    io.out().s("[zero] returned \{got\} from take_for(0) without a panic\n")

// ==========================================
// event-no-bits: waiting on no bits panics. With `.any` it would wait forever, as no bit of none
// can ever be set; with `.all` it would return at once, so neither means a wait.
// ==========================================
fn no_bits_waiter(_arg: Void$@): Void
    io.out().s("=== Kanso OS (POSIX) Event.wait on no bits ===\n")
    io.out().s("[no-bits] wait(0, .any) must stop here\n")
    got: = g_event.wait(0, .any, false)
    io.out().s("[no-bits] returned \{got\} from wait(0) without a panic\n")

// ==========================================
// stop-outside: stop_scheduler with no scheduler running panics. Ignored, it would leave the
// caller believing it had stopped something.
// ==========================================
fn stop_outside(): I32
    io.out().s("=== Kanso OS (POSIX) stop_scheduler with no scheduler running ===\n")
    task.stop_scheduler()
    io.out().s("[stop] returned from stop_scheduler without a panic\n")
    return 1

// ==========================================
// wait-masked: a waiting call inside the caller's own critical section panics, on every port. The
// switch away waits for interrupts to come on again, so on Cortex-M the call would go on as if
// another task ran. The giver is ready, so a wait that went through would not hang.
// ==========================================
fn masked_waiter(_arg: Void$@): Void
    io.out().s("=== Kanso OS (POSIX) Sem.take with interrupts off ===\n")
    io.out().s("[masked] take between irq_save and irq_restore must stop here\n")
    s: = task.irq_save()
    g_sem.take()
    task.irq_restore(s)
    io.out().s("[masked] returned from take without a panic\n")

fn masked_giver(_arg: Void$@): Void
    g_sem.give()

// ==========================================
// delay-before-start: Task.delay from main, before start_scheduler, panics. There is no running
// task to put to sleep, and the switch away would save main into no task.
// ==========================================
fn delay_before_start(): I32
    io.out().s("=== Kanso OS (POSIX) Task.delay before start_scheduler ===\n")
    Task.delay(1)
    io.out().s("[delay] returned from delay without a panic\n")
    return 1

// ==========================================
// create-again: Task.create on a task that is still in the task table panics. The task here has
// ended but was not deleted. Allowed, each round would use one more slot and port context, and
// the table would fill after a few rounds.
// ==========================================
fn ends_at_once(_arg: Void$@): Void
    io.out().s("[again] the first run ended\n")

fn create_again(): I32
    io.out().s("=== Kanso OS (POSIX) Task.create again without Task.delete ===\n")
    tcb.create(U8$[]::stack, ends_at_once, null, 1, "again")
    task.start_scheduler()
    io.out().s("[again] creating it again must stop here\n")
    tcb.create(U8$[]::stack, ends_at_once, null, 1, "again")
    io.out().s("[again] returned from the second create without a panic\n")
    return 1

fn main(): I32
    argv: = sys.args()
    which: = argv.get(1) if argv.len == 2 else ""
    if which.equals("stop-outside")
        return stop_outside() // no task: it stops before any scheduler
    if which.equals("delay-before-start")
        return delay_before_start()
    if which.equals("create-again")
        return create_again()
    if which.equals("stack-overflow")
        tcb.create(U8$[]::stack, overflow_task, null, 1, "overflow")
    else if which.equals("mutex-relock")
        g_mutex.init()
        tcb.create(U8$[]::stack, relocker, null, 1, "relock")
    else if which.equals("mutex-foreign-unlock")
        g_mutex.init()
        tcb.create(U8$[]::stack, owner, null, 1, "owner")
        tcb_other.create(U8$[]::stack_other, other, null, 1, "other")
    else if which.equals("delete-holder")
        g_mutex.init()
        tcb.create(U8$[]::stack, holding, null, 1, "holding")
        tcb_other.create(U8$[]::stack_other, deleter, null, 1, "deleter")
    else if which.equals("timeout-zero")
        g_sem.init(0)
        tcb.create(U8$[]::stack, zero_waiter, null, 1, "zero")
    else if which.equals("event-no-bits")
        g_event.init()
        tcb.create(U8$[]::stack, no_bits_waiter, null, 1, "no-bits")
    else if which.equals("wait-masked")
        g_sem.init(0)
        tcb.create(U8$[]::stack, masked_waiter, null, 2, "masked")
        tcb_other.create(U8$[]::stack_other, masked_giver, null, 1, "giver")
    else
        // **An unknown name must not pass**: it prints no needle, so its gate fails.
        io.err()
            .s("usage: panic_demo \
                stack-overflow|mutex-relock|mutex-foreign-unlock|delete-holder|timeout-zero|event-no-bits|stop-outside|wait-masked|delay-before-start|create-again\n")
        return 2
    task.start_scheduler()
    io.out().s("[panic_demo] UNEXPECTED: scheduler returned without a panic\n")
    return 1

//< The shared steps for opening the record in the device
//< It sets up the Flash region (`ksos/drivers/rp2040/flash`), opens the append-only record
//< (`ksdb/log`), and **claims the region with a marker record**.
//< **The marker is needed because several programs use the same region.**
//< **Flash comes erased from the factory, but not once it has been used for something else.**

// ==========================================
//   if !records.claim("car1") { … }        // a different marker per writer
//   records.append(kind_sample, …) catch { … };
// ==========================================
import "ksdb/log" as ksdblog
import "ksdb/store" { Store }
import "ksos/drivers/rp2040/flash"
import "ksos/drivers/rp2040/watchdog"

const KIND_MARKER: U16 = 0 //< the marker record's kind
    //< Caution: **Give each writer's kinds numbers of 1 or more** (0 is the marker).

const MARKER_MAX: Sz = 8 //< the maximum marker length
    //< Keep it short (it only claims the region and carries no meaning).

priv $lg: ksdblog.Log
priv $ready: Bool = false
priv $erased_on_open: Bool = false

// **The watchdog is fed once per record step**: per append (`append`) and per sector erase (here).
// Erasing while keeping the policy takes seconds, yet each erase is at most 400 ms, so the timeout
// covers one step. Before `watchdog.arm` the feed does nothing.
// Caution: **Do not feed on a read or a page write.** A loop that keeps reading the record would
// then keep the watchdog fed while the control loop does not run.
priv fn erase_fed(at: Sz): Bool
    watchdog.feed()
    return flash.erase_sector(at)

fn claim(marker: U8[]): Bool //< opens the record
    //< **true if it could be opened.** If the marker differs it erases the whole region. The caller
    //< can report that with `wiped()` (without a word about the erase, nobody would know why the
    //< previous record is gone).
    ready = false
    erased_on_open = false
    if marker.len == 0 || marker.len > MARKER_MAX
        return false
    flash.init() catch
        return false
    store: = Store::{
        .read_at = flash.read_at,
        .program_at = flash.program_at,
        .erase_sector = erase_fed,
        .capacity = flash.REGION_SIZE,
        .sector_size = flash.SECTOR_SIZE,
    }
    lg = ksdblog.Log.open(store)
    ready = true
    if lg.last_equals(KIND_MARKER, marker)
        return true
    lg.reset() catch
        ready = false
        return false
    append(KIND_MARKER, marker) catch
        ready = false
        return false
    erased_on_open = true
    return true

fn wiped(): Bool //< whether opening started by erasing the region
    //< Ask once, after `claim`.
    return erased_on_open

fn ok(): Bool //< whether it is open
    return ready

fn handle(): ksdblog.Log$@ //< the record itself
    //< Caution: **Use it only after `claim` returns true.** Append through `append`, which feeds
    //< the watchdog.
    return lg@

fn append(kind: U16, data: U8[]): Void!ksdblog.Ksdb_error //< adds one record, one record step
    //< It feeds the watchdog first. One append is a scan of at most the 64KB region and a few page
    //< writes of at most 3 ms each, so it ends well inside the timeout.
    //< Caution: **Use it only after `claim` returns true.**
    watchdog.feed()
    lg.append(kind, data)!

fn read_last(kind: U16, dst: U8$[]): Sz //< copies the newest record of kind into dst
    //< 0 if there is none (or if dst is too small). Swallowing the failure suits only this place,
    //< where the caller can take "0 means none". **These probes store no record with empty
    //< content.** If one did, 0 could not tell them apart, so change it to return `ksdb`'s
    //< `not_found` as it is.
    if !ready
        return 0
    return lg.last(kind, dst) catch 0

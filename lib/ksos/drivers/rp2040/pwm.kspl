//< The PWM driver for the real Raspberry Pi Pico / Pico W (RP2040) chip
//< The RP2040's PWM has 8 "slices" of 2 channels (A/B) each. **The period (DIV/TOP) is per slice
//< and the duty (CC) per channel**, so outputs with different periods need different slices.
//< Which slice and channel a pin uses is fixed (it cannot be chosen).

// ==========================================
// The register map, and how a pin maps to a slice and channel, are in "PWM (`pwm.kspl`)" in
// lib/ksos/docs/DESIGN-rtos.md.
// ==========================================

// The frequency is f = clk_sys / (DIV * (TOP+1)). DIV's integer part has only 8 bits. 500Hz at
// 125MHz **overflows** it, so use **a large TOP** (DIV=25 / TOP=9999 in
// lib/ksos/boards/freenove_4wd_pico/board.kspl). The duty is set as a fraction of TOP.

// QEMU has no RP2040 model: it is checked on a real Pico W (stage 3,
// lib/ksos/docs/TUTORIAL-bring-up.md).
import "ksos/drivers/mmio"
import "ksos/drivers/rp2040/gpio"
import "ksos/drivers/rp2040/resets"

const RESET_PWM: U32 = 1U32 << 14

const PWM_BASE: U32 = 0x40050000
const SLICE_STRIDE: U32 = 0x14
const CSR_EN: U32 = 1U32 << 0

const FUNCSEL_PWM: U32 = 4 //< the GPIO FUNCSEL value that selects PWM (F4)

fn slice_of(pin: U32): U32 //< the PWM slice number pin is connected to
    //< It is fixed per pin and cannot be chosen.
    return (pin / 2) % 8

fn is_channel_b(pin: U32): Bool //<
    //< Whether pin is on the slice's channel B (false if on channel A)
    return (pin % 2) == 1

fn init(): Void!mmio.Driver_error //< takes the PWM block out of reset
    //< Call it once before any other PWM operation (again is safe). The wait has a timeout.
    resets.unreset(RESET_PWM)!

fn config_slice(slice: U32, div_int: U32, div_frac: U32, top: U32) //<
    //< Sets the slice's period and starts it running
    //< div_int/div_frac is the divisor in 8.4 fixed point, and top the wrap value (period = TOP+1).
    //< CC keeps its previous value, so the output is undefined until set_percent writes one.
    base: = PWM_BASE + SLICE_STRIDE * slice
    mmio.write32(base, 0U32) // stop it first, then configure it
    div_addr: = base + 0x04
    mmio.write32(div_addr, ((div_int & 0xFF) << 4) | (div_frac & 0xF))
    top_addr: = base + 0x10
    mmio.write32(top_addr, top)
    ctr_addr: = base + 0x08
    mmio.write32(ctr_addr, 0U32)
    mmio.write32(base, CSR_EN)

fn init_pin(pin: U32) //<
    //< makes pin usable as a PWM output (switches the pin's function to PWM)
    //< config_slice sets the slice's period separately.
    gpio.select_function(pin, FUNCSEL_PWM)

fn cc_addr_of(pin: U32): U32 //< the address of pin's duty register (CC)
    //< **It exists for a path with a tight deadline** (WS2812 rewrites the duty every period); the
    //< caller gets the address here rather than copying `PWM_BASE`.
    return PWM_BASE + SLICE_STRIDE * slice_of(pin) + 0x0C

fn ctr_addr_of(pin: U32): U32 //< the address of the counter (CTR) of the slice pin belongs to
    //< Used like cc_addr_of; both channels of a slice give the same address.
    return PWM_BASE + SLICE_STRIDE * slice_of(pin) + 0x08

const CC_MAX: U32 = 0xFFFF //< the largest count a channel's half of CC holds (16 bits)

fn set_level(pin: U32, level: U32) //< sets pin's duty as a count
    //< **It is the one function that writes CC** (the one place that keeps the other channel's
    //< value). To set it as a percentage, use set_percent. A level past `CC_MAX` gives `CC_MAX`.
    addr: = cc_addr_of(pin)
    mmio.write32(addr, cc_with(mmio.read32(addr), is_channel_b(pin), level))

fn cc_with(cur: U32, channel_b: Bool, level: U32): U32 //<
    //< CC's new value: `level` in one channel's half, the other half kept from `cur`
    //< Caution: **Saturate, do not mask.** CC is 16 bits a channel, so a level of 65536 masked to
    //< 16 bits is 0, and full duty would become none.
    l: = level if level <= CC_MAX else CC_MAX
    if channel_b
        return (cur & 0x0000FFFF) | (l << 16)
    return (cur & 0xFFFF0000) | l

fn set_percent(pin: U32, percent: U32, top: U32) //< sets pin's duty as a percentage (0 to 100)
    //< top is the value configured on that slice, so a caller keeps working when TOP changes.
    set_level(pin, level_for(percent, top))

fn level_for(percent: U32, top: U32): U32 //< the CC count for a duty in percent under a TOP
    //< Over 100 counts as 100. 0 and 100 are exact, so rounding does not lose the endpoints.
    //< **100% is always high only while TOP is below 65535**: only CC > TOP gives that, and CC
    //< holds at most 65535. With TOP at 65535, 100% gives CC 65535: low for 1 count of 65536.
    //< A TOP past 16 bits counts as 65535, as the register holds no more.
    p: = percent if percent <= 100 else 100U32
    t: = top if top <= CC_MAX else CC_MAX
    if p >= 100
        return t + 1 if t < CC_MAX else CC_MAX
    return ((t + 1) * p) / 100

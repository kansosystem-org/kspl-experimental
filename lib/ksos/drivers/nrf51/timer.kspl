//< The nRF51's TIMER0 as a one-shot interrupt (the chip of the BBC micro:bit, which QEMU models)
//< ksos runs on the nRF51 only under QEMU (`-M microbit`), as a Cortex-M0 for the Armv6-M port.
//< This driver gives a demo an interrupt that arrives on its own, after a set time, with no peer
//< process. That interrupt wakes the scheduler's sleep on WFI. Only what that needs is written.

import "ksos/drivers/mmio"

// ==========================================
// TIMER0's registers. A task register acts when 1 is written. EVENTS_COMPARE[0] reads 1 once the
// counter reaches CC[0]. The interrupt stays raised until it is written back to 0.
// ==========================================

const IRQ: U32 = 8 //< TIMER0's NVIC line

const BASE: U32 = 0x40008000
const TASKS_START: U32 = BASE + 0x000
const TASKS_STOP: U32 = BASE + 0x004
const TASKS_CLEAR: U32 = BASE + 0x00c
const EVENTS_COMPARE0: U32 = BASE + 0x140
const SHORTS: U32 = BASE + 0x200
const INTENSET: U32 = BASE + 0x304
const MODE: U32 = BASE + 0x504
const BITMODE: U32 = BASE + 0x508
const PRESCALER: U32 = BASE + 0x510
const CC0: U32 = BASE + 0x540

const SHORTS_COMPARE0_CLEAR: U32 = 1U32 << 0
const SHORTS_COMPARE0_STOP: U32 = 1U32 << 8
const INTEN_COMPARE0: U32 = 1U32 << 16
const PRESCALER_1MHZ: U32 = 4 // 16 MHz >> 4

fn start_once(us: U32) //< raises TIMER0's interrupt once, `us` microseconds from now
    //< The counter stops and clears itself at the compare (SHORTS), so it raises nothing more
    //< until the next call. The handler must call `ack`.
    mmio.write32(TASKS_STOP, 1)
    mmio.write32(TASKS_CLEAR, 1)
    mmio.write32(MODE, 0)
    mmio.write32(BITMODE, 3)
    mmio.write32(PRESCALER, PRESCALER_1MHZ)
    mmio.write32(CC0, us)
    mmio.write32(SHORTS, SHORTS_COMPARE0_CLEAR | SHORTS_COMPARE0_STOP)
    mmio.write32(EVENTS_COMPARE0, 0)
    mmio.write32(INTENSET, INTEN_COMPARE0)
    mmio.write32(TASKS_START, 1)

fn ack() //< lowers the interrupt (clears COMPARE[0]'s event); its handler calls it first
    mmio.write32(EVENTS_COMPARE0, 0)

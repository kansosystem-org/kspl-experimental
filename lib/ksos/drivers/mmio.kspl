//< Reading and writing MMIO registers
//< Caution: **A driver must not call `__kspl_read_volatile` / `__kspl_write_volatile` directly.**
//< The raw intrinsics take a pointer, so the caller needs a `U32$@::` cast every time. **The
//< compiler holds this**: an integer becomes a pointer only in a function marked
//< `#raw_address`, and only the helpers here carry the mark.
//< **Do not add a version without volatile.** An MMIO value can change on every read, and a
//< write is itself a side effect.
//< The intrinsics themselves stay.

// ==========================================
// A 32-bit register. Most peripheral registers are this.
// ==========================================
#inline
#raw_address
fn read32(addr: U32): U32
    return __kspl_read_volatile(U32$@::addr)
#inline
#raw_address
fn write32(addr: U32, val: U32)
    __kspl_write_volatile(U32$@::addr, val)

// An 8-bit window, for a region that can only be accessed a byte at a time, such as USB's packet
// buffer.
#inline
#raw_address
fn read8(addr: U32): U8
    return __kspl_read_volatile(U8$@::addr)
#inline
#raw_address
fn write8(addr: U32, val: U8)
    __kspl_write_volatile(U8$@::addr, val)

// ==========================================
// The busy wait every driver shares: it gives up after poll_timeout_iters iterations, so hardware
// that does not answer cannot stall a driver forever. The limit leaves ample room for a wait that
// working hardware clears in a few to a few tens of microseconds.
// ==========================================
const POLL_TIMEOUT_ITERS: Sz = 1000000

enum Driver_error //< why a driver's call did not take effect
    //< **One type for every driver**, so a board or a demo passes a driver's failure on with `!`.
    //< It names the kind once, where it decides what to do.
    timed_out //< the hardware did not reach the state waited for within `POLL_TIMEOUT_ITERS`
    no_answer //< a device on a bus did not acknowledge (an I2C NACK)
    not_found //< what was looked up is absent (a ROM routine, a device)
    out_of_range //< an address or a length lies outside what the device holds or takes

fn wait(addr: U32, mask: U32, want_set: Bool): Void!Driver_error //<
    //< Waits until every bit of mask reads set (want_set=true) or every one reads clear (false)
    //< After poll_timeout_iters it gives up with `timed_out`.
    //< Caution: **Every bit, not any.** A mask of two blocks (`RESET_DONE`) must wait for both; a
    //< wait that ends at the first lets a write reach the other while it is still in reset.
    $i: Sz = 0
    for !reached(read32(addr), mask, want_set)
        i += 1
        if i >= POLL_TIMEOUT_ITERS
            throw .timed_out

fn reached(value: U32, mask: U32, want_set: Bool): Bool //< whether `wait` ends on value
    //< It is a function of its own so that a host test can check it without a register.
    if want_set
        return (value & mask) == mask
    return (value & mask) == 0

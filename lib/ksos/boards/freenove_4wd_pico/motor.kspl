//< The driving control for a Freenove 4WD mecanum car
//< A speed per wheel, and a mecanum's motion (forward-back, sideways, turning). The H bridge is
//< two PWMs per motor: the duty on one and 0 on the other, swapped for negative; both 0
//< freewheels. Each motor's pins are **the A/B channels of one PWM slice** (shared period,
//< separate duty; lib/ksos/drivers/rp2040/pwm.kspl).
import "ksos/boards/freenove_4wd_pico/board"
import "ksos/drivers/mmio"
import "ksos/drivers/rp2040/pwm"
import "ksos/drivers/rp2040/timer"
import "std/math"

const SPEED_MAX: I32 = 100 //< the limit on a requested speed (as an absolute value)
    //< The same scale as the duty percentage.

fn init(): Void!mmio.Driver_error //<
    //< Initializes the PWM block, makes the eight motor pins PWM outputs and sets the period
    //< On a failure the PWM block did not leave reset, and no command takes effect. Every wheel is
    //< left stopped (the duty is written 0 here, since config_slice does not set it).
    pwm.init()!
    for w in Range.asc(board.WHEEL_COUNT)
        a: = board.MOTOR_PIN_A[w]
        b: = board.MOTOR_PIN_B[w]
        pwm.init_pin(a)
        pwm.init_pin(b)
        // The two pins share a slice; one period setting covers both.
        pwm.config_slice(pwm.slice_of(a), board.MOTOR_PWM_DIV_INT, 0, board.MOTOR_PWM_TOP)
    stop()

struct Duty //< the duties on one motor's two pins [%]
    a: U32 //< pin A's, for turning forward
    b: U32 //< pin B's, for turning back

fn duty(wheel: Sz, speed: I32): Duty //< the duties that turn wheel `wheel` at speed `speed`
    //< It has no hardware access, so `lib/ksos/tests/stops_test.kspl` checks it on the host.
    //< board.WHEEL_POLARITY absorbs each wheel's actual direction of rotation.
    //< Caution: **Speed 0 must give 0 on both pins.** `stop`, and so the panic hook, relies on it.
    s: = speed * board.WHEEL_POLARITY[wheel]
    capped: = SPEED_MAX if s > SPEED_MAX else (-SPEED_MAX if s < -SPEED_MAX else s)
    // **Raise it to the duty at which the wheel starts turning** (the reason is at
    // `board.WHEEL_MIN_PERCENT`). 0 stays 0.
    $clamped: I32 = capped
    if capped > 0 && capped < board.WHEEL_MIN_PERCENT
        clamped = board.WHEEL_MIN_PERCENT
    else if capped < 0 && capped > 0 - board.WHEEL_MIN_PERCENT
        clamped = 0 - board.WHEEL_MIN_PERCENT
    if clamped >= 0
        return ::{ .a = U32::clamped, .b = 0 }
    return ::{ .a = 0, .b = U32::(-clamped) }

fn kick_duty(wheel: Sz, speed: I32): Duty //< the duties of the kick that starts wheel `wheel`
    //< **`board.KICK_GAIN` times `speed`, capped as `duty` caps it**; the reason is at the gain.
    //< It has no hardware access, so `lib/ksos/tests/motor_test.kspl` checks it on the host.
    return duty(wheel, speed * board.KICK_GAIN)

priv fn put(wheel: Sz, duties: Duty) //< writes `duties` to wheel `wheel`'s two pins
    top: = board.MOTOR_PWM_TOP
    pwm.set_percent(board.MOTOR_PIN_A[wheel], duties.a, top)
    pwm.set_percent(board.MOTOR_PIN_B[wheel], duties.b, top)

fn set_wheel(wheel: Sz, speed: I32) //< turns wheel `wheel` at speed `speed` (-100 to 100)
    //< It gives no kick: a wheel at `CAP` may not start from a standstill. `start_wheel` kicks.
    put(wheel, duty(wheel, speed))

// Whether the previous command left every wheel stopped.
// Caution: **`stop` must update this too**, or the kick is missed after a stop.
priv $was_stopped: Bool = true

fn stop()
    for w in Range.asc(board.WHEEL_COUNT)
        set_wheel(w, 0)
    was_stopped = true

priv fn command(speeds: I32[board.WHEEL_COUNT]) //< sends one speed to each wheel
    //< **It kicks only when starting from a standstill** (the reason is at `board.KICK_GAIN`).
    //< `drive` and `start_wheel` both go through here, so they kick alike.
    $moving: = false
    for each in speeds
        if each != 0
            moving = true
    if moving && was_stopped
        for w in Range.asc(board.WHEEL_COUNT)
            put(w, kick_duty(w, speeds[w]))
        timer.delay_ms(board.KICK_MS)
    was_stopped = !moving
    for w in Range.asc(board.WHEEL_COUNT)
        set_wheel(w, speeds[w])

fn start_wheel(wheel: Sz, speed: I32) //< turns wheel `wheel` alone at `speed`, with `drive`'s kick
    //< **The other three are stopped.** A single wheel at `CAP` stays still without the kick.
    $speeds: I32[board.WHEEL_COUNT] = ::{}
    speeds[wheel] = speed
    command(speeds)

priv fn spread(longitudinal: I32, lateral: I32, rotation: I32): I32[board.WHEEL_COUNT] //<
    //< Mixes the triple into the four wheels' speeds, in `board.WHEEL_*`'s order
    //< With `rotation` positive **the left two go forward and the right two back** (clockwise from
    //< above); reversed, line following turns **the wrong way**. **The sideways direction cannot be
    //< determined on paper** (the Arduino sample inverts its sign first).
    $speeds: I32[board.WHEEL_COUNT] = ::{}
    speeds[board.WHEEL_FRONT_LEFT] = longitudinal + lateral + rotation
    speeds[board.WHEEL_BACK_LEFT] = longitudinal - lateral + rotation
    speeds[board.WHEEL_BACK_RIGHT] = longitudinal + lateral - rotation
    speeds[board.WHEEL_FRONT_RIGHT] = longitudinal - lateral - rotation
    return speeds

fn drive(longitudinal: I32, lateral: I32, rotation: I32) //< combines a mecanum's motion
    //< longitudinal **positive = forward**, lateral **positive = right**, rotation **positive =
    //< clockwise**. A total over speed_max is clamped per wheel and the ratio is lost; normalize
    //< first to keep it.
    command(spread(longitudinal, lateral, rotation))

// ==========================================
// Scales the command sent to the wheels down to the speed cap
// The triple is forward-back, sideways and turning. **The cap holds per wheel**: `spread` gives
// each wheel `lon ± lat ± rot`, so the triple is scaled by the largest wheel's value.
// **Do not clamp each component separately.**
// `CAP` is returned even when no scaling is needed, so callers need no special case.
// ==========================================
// ==========================================
// How it is used:
//   d: = motor.divisor(lon, lat, rot);
//   out: = lon * motor.CAP / d;
// ==========================================

const CAP: I32 = 20 //< the cap in % on the command sent to each wheel
    //< **This is the only value that sets the car's speed** (the manoeuvre table sets only how
    //< sharp a turn is). Lower, the line stays longer under the sensors: more reads, less
    //< overshoot.
    //< Caution: **Keep it just above `board.WHEEL_MIN_PERCENT`**: at that floor a wheel stalls, and
    //< higher the car overshoots the line.

fn divisor(lon: I32, lat: I32, rot: I32): I32 //< the divisor that keeps every wheel within `CAP`
    //< **If no scaling is needed it returns `CAP`.**
    //< The largest of the four wheels' `lon ± lat ± rot` is always `|lon| + |lat| + |rot|`.
    //< Caution: **Do not use the largest component.** A wheel then got up to three times `CAP`.
    m: = math.abs(lon) + math.abs(lat) + math.abs(rot)
    return math.max(m, CAP)

//< kspeg's tests, run as a program of their own (`make test` in this package's folder)
//<
//< **This is the only way to run kspeg's tests on their own.** `all.kspls` holds them; this file
//< only gives them a `main`, so a copy of the package with nothing around it can run them.
import "kspeg/tests/all"
import "std/io"

fn main()
  // Flush line by line, so a run that crashes shows how far it got.
  io.set_line_buffered()
  all.run_kspeg()

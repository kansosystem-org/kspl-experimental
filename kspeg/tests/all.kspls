//< The entry point that runs kspeg's tests together
//<
//< **This is the one contract this package exports.** The tests live inside `kspeg/`, so they
//< reach what they inspect directly, and no `pub` is added just for a test ("A test inspecting
//< the inside of a unit goes inside that unit" in `../../docs/DESIGN.md`).
//< Caution: **Do not add an inspecting entry point here**: each one is one more contract outside.
import "kspeg/tests/engine_test"
import "kspeg/tests/memo_test"
import "std/mem" { Arena }

pub fn run_kspeg() //<
  //< Every test, with the arena they parse on set up here
  //<
  //< **It takes no arguments**, so its two callers (`make debug`'s and this package's own `main`)
  //< have no argument list that could drift apart.
  arena: = Arena.new(8 * 1024 * 1024)
  defer arena.free()
  engine_test.test_engine(arena)
  memo_test.test_memo(arena)
